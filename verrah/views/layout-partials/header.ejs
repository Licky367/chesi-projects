<!-- =========================================================
     HEADER
========================================================= -->

<header class="header">


    <!-- =====================================================
         MENU BUTTON — LEFT
    ====================================================== -->

    <button
        type="button"
        id="menuButton"
        class="menu-btn"
        aria-label="Open navigation menu"
        aria-expanded="false"
    >
        ☰
    </button>


    <!-- =====================================================
         VERAH COSMETICS LOGO — CENTER
    ====================================================== -->

    <a
        href="<%= homeLink %>"
        class="header-logo-link"
        aria-label="Home"
    >

        <img
            src="https://res.cloudinary.com/qmv1jbjy/image/upload/v1789195932/verrahCosmetics.png"
            alt="VERAH COSMETICS"
            class="header-logo"
        >

    </a>


    <!-- =====================================================
         PROFILE — RIGHT
         Profile UI is handled by profile.ejs
    ====================================================== -->

    <%- include("profile") %>


</header>