<!-- =========================================================
   SIDEBAR
======================================================== -->

<aside
    id="sidebar"

    class="sidebar"

    aria-label="Project navigation"

    aria-expanded="false"
>


    <!-- =====================================================
       SIDEBAR MENU
    ====================================================== -->

    <ul class="sidebar-menu">


        <!-- =================================================
           MENU BUTTON
        ================================================== -->

        <li class="sidebar-item">

            <button
                type="button"

                id="sidebarMenuButton"

                class="sidebar-menu-button"

                aria-label="Close navigation menu"

                aria-expanded="true"
            >

                <span
                    class="sidebar-menu-icon"

                    aria-hidden="true"
                >
                    ☰
                </span>

                <span class="sidebar-label">
                    Menu
                </span>

            </button>

        </li>


        <!-- =================================================
           DASHBOARD
        ================================================== -->

        <li class="sidebar-item">

            <a
                href="<%= homeLink %>"

                class="sidebar-link active"

                title="Dashboard"
            >

                <span
                    class="sidebar-icon"

                    aria-hidden="true"
                >
                    ⌂
                </span>

                <span class="sidebar-label">
                    Dashboard
                </span>

            </a>

        </li>


        <!-- =================================================
           MANAGEMENT ACTIVITIES
        ================================================== -->

        <li class="sidebar-item">

            <button
                type="button"

                id="dairyActivitiesButton"

                class="sidebar-section-button"

                aria-expanded="false"

                aria-controls="dairyActivitiesSubmenu"
            >

                <span
                    class="sidebar-icon"

                    aria-hidden="true"
                >
                    📒
                </span>

                <span class="sidebar-label">
                    MANAGEMENT
                </span>

                <span
                    class="sidebar-section-arrow"

                    aria-hidden="true"
                >
                    ▶
                </span>

            </button>


            <!-- =============================================
               MANAGEMENT ACTIVITIES SUBMENU
            ============================================== -->

            <ul
                id="dairyActivitiesSubmenu"

                class="sidebar-submenu"
            >


                <!-- Add Asset -->

                <li class="sidebar-item">

                    <a
                        href="/stock"

                        class="sidebar-link"

                        title="Stock Management"
                    >

                        <span
                            class="sidebar-icon"

                            aria-hidden="true"
                        >
                            📈
                        </span>

                        <span class="sidebar-label">
                            Stock Management
                        </span>

                    </a>

                </li>


                <!-- Substations/branches-->

                <li class="sidebar-item">

                    <a
                        href="/substations"

                        class="sidebar-link"

                        title="Substations"
                    >

                        <span
                            class="sidebar-icon"

                            aria-hidden="true"
                        >
                            🛃
                        </span>

                        <span class="sidebar-label">
                            Substations
                        </span>

                    </a>

                </li>


                <!-- Record Milk Sales -->
<!--
                <li class="sidebar-item">

                    <a
                        href="/milk/sales"

                        class="sidebar-link"

                        title="Record Milk Sales"
                    >

                        <span
                            class="sidebar-icon"

                            aria-hidden="true"
                        >
                            💰
                        </span>

                        <span class="sidebar-label">
                            Record Milk Sales
                        </span>

                    </a>

                </li>
-->

                <!-- Milk Statistics -->
<!--
                <li class="sidebar-item">

                    <a
                        href="/stats"

                        class="sidebar-link"

                        title="Milk Statistics"
                    >

                        <span
                            class="sidebar-icon"

                            aria-hidden="true"
                        >
                            📊
                        </span>

                        <span class="sidebar-label">
                            Milk Statistics
                        </span>

                    </a>

                </li>
-->

            </ul>

        </li>


        <!-- =================================================
           PRODUCTS
        ================================================== -->

        <li class="sidebar-item">

            <a
                href="/products"

                class="sidebar-link"

                title="View Assets"
            >

                <span
                    class="sidebar-icon"

                    aria-hidden="true"
                >
                    🛍️
                </span>

                <span class="sidebar-label">
                    Products
                </span>

            </a>

        </li>
        <!-- =================================================
           CARTS
        ================================================== -->

        <li class="sidebar-item">

            <a
                href="/carts"

                class="sidebar-link"

                title="Carts"
            >

                <span
                    class="sidebar-icon"

                    aria-hidden="true"
                >
                    🛒
                </span>

                <span class="sidebar-label">
                    Cart
                </span>

            </a>

        </li>


        <!-- =================================================
           FINANCIALS
        ================================================== -->

        <li class="sidebar-item">

            <a
                href="/financials/summary"

                class="sidebar-link"

                title="Financials"
            >

                <span
                    class="sidebar-icon"

                    aria-hidden="true"
                >
                    💱
                </span>

                <span class="sidebar-label">
                    Financials
                </span>

            </a>

        </li>


    </ul>


    <!-- =====================================================
       SIDEBAR FOOTER
    ====================================================== -->

    <div class="sidebar-footer">

        Verrah Cosmetics

    </div>


</aside>


<!-- =========================================================
   SIDEBAR OVERLAY
========================================================= -->

<div
    id="sidebarOverlay"

    class="overlay"

    aria-hidden="true"
></div>