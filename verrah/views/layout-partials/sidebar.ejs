<!-- =========================================================
   SIDEBAR
========================================================= -->

<aside
    id="sidebar"
    class="sidebar"
    aria-label="Project navigation"
    aria-expanded="false"
>


    <!-- =====================================================
       SIDEBAR MENU
    ====================================================== -->

    <ul class="sidebar-menu">


        <!-- =================================================
           MENU BUTTON
        ================================================== -->

        <li class="sidebar-item">

            <button
                type="button"
                id="sidebarMenuButton"
                class="sidebar-menu-button"
                aria-label="Close navigation menu"
                aria-expanded="true"
            >

                <span
                    class="sidebar-menu-icon"
                    aria-hidden="true"
                >
                    ☰
                </span>

                <span class="sidebar-label">
                    Menu
                </span>

            </button>

        </li>

  
<% if (isStaff) { %>

        <!-- =================================================
           STAFF LINKS
        ================================================== -->

        <%- include("sidebar/sidebarStaff") %>
<% } %>


 
<% if (isAdmin) { %>

        <!-- =================================================
           ADMIN LINKS
        ================================================== -->

        <%- include("sidebar/sidebarAdmin") %>
<% } %>


 
<% if (user && user.role === "client") { %>

        <!-- =================================================
           CLIENT LINKS
        ================================================== -->

        <%- include("sidebar/sidebarClient") %>
<% } %>

    </ul>


    <!-- =====================================================
       SIDEBAR FOOTER
    ====================================================== -->

    <div class="sidebar-footer">

        Verrah Cosmetics

    </div>


</aside>


<!-- =========================================================
   SIDEBAR OVERLAY
========================================================= -->

<div
    id="sidebarOverlay"
    class="overlay"
    aria-hidden="true"
></div>