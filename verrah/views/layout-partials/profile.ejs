<!-- =========================================================
   PROFILE
========================================================= -->

<div
    class="profile-box"
    id="profileBox"
>

    <div
        class="profile-trigger"
        onclick="toggleProfile(event)"
        role="button"
        tabindex="0"
        aria-label="Open profile menu"
    >

        <span
            class="profile-icon"
            aria-hidden="true"
        >
            👤
        </span>

        <span class="profile-name">
            Profile
        </span>

    </div>


    <div class="dropdown-profile">

        <% if (user) { %>

            <!-- =========================
                 LOGGED-IN USER
            ========================== -->

            <a href="/profile">
                👤 My Account
            </a>


            <% if (user.role === "admin") { %>

                <a href="/auth/users">
                    👥 People
                </a>

                <a href="/auth/users/invitation">
                    ➕ Create Invitation
                </a>

            <% } %>


            <a href="/auth/logout">
                🚪 Logout
            </a>


        <% } else { %>

            <!-- =========================
                 LOGGED-OUT USER
            ========================== -->

            <a href="/auth/register">
                📝 Sign Up
            </a>

            <a href="/auth/login">
                🔐 Login
            </a>

        <% } %>

    </div>

</div>