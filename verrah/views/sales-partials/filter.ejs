<%
/*
 * ==========================================================
 * SALES FILTER
 * ==========================================================
 *
 * Filters ONLY the currently selected tab.
 *
 * Controller supplies:
 *
 *     activeTab
 *     activeFilterDate
 *     activeFilterPeriod
 *     filterLabel
 *
 * Query names:
 *
 *     summary:
 *         summaryDate
 *         summaryPeriod
 *
 *     staff-sales:
 *         staffSalesDate
 *         staffSalesPeriod
 *
 *     products:
 *         productsDate
 *         productsPeriod
 *
 *     arrears:
 *         arrearsDate
 *         arrearsPeriod
 *
 *     daily-cash-sales:
 *         dailyCashSalesDate
 *         dailyCashSalesPeriod
 *
 * Admin users can additionally filter by substation.
 *
 * ==========================================================
 */

const filterKeys = {

    summary: {

        date:
            "summaryDate",

        period:
            "summaryPeriod"

    },


    "staff-sales": {

        date:
            "staffSalesDate",

        period:
            "staffSalesPeriod"

    },


    products: {

        date:
            "productsDate",

        period:
            "productsPeriod"

    },


    arrears: {

        date:
            "arrearsDate",

        period:
            "arrearsPeriod"

    },


    "daily-cash-sales": {

        date:
            "dailyCashSalesDate",

        period:
            "dailyCashSalesPeriod"

    }

};


const activeKeys =
    filterKeys[activeTab] ||
    filterKeys.summary;

%>


<button
    type="button"
    id="sales-filter-toggle"
    class="sales-filter-toggle"
    aria-expanded="false"
    aria-controls="sales-filter-form"
>
    Filter Date?
</button>


<form
    id="sales-filter-form"
    class="sales-filter"
    action="/sales"
    method="GET"
>


    <!-- ====================================================
         ACTIVE TAB
    ===================================================== -->

    <input
        type="hidden"
        name="tab"
        value="<%= activeTab %>"
    >


    <!-- ====================================================
         DATE
    ===================================================== -->

    <div class="sales-filter-field">

        <label for="sales-filter-date">
            Date
        </label>

        <input
            id="sales-filter-date"
            type="date"
            name="<%= activeKeys.date %>"
            value="<%= activeFilterDate %>"
            required
        >

    </div>


    <!-- ====================================================
         PERIOD
    ===================================================== -->

    <div class="sales-filter-field">

        <label for="sales-filter-period">
            Period
        </label>

        <select
            id="sales-filter-period"
            name="<%= activeKeys.period %>"
        >

            <option
                value="day"
                <%= activeFilterPeriod === "day"
                    ? "selected"
                    : "" %>
            >
                Day
            </option>


            <option
                value="month"
                <%= activeFilterPeriod === "month"
                    ? "selected"
                    : "" %>
            >
                Month
            </option>


            <option
                value="year"
                <%= activeFilterPeriod === "year"
                    ? "selected"
                    : "" %>
            >
                Year
            </option>

        </select>

    </div>


    <!-- ====================================================
         SUBSTATION
         ADMIN ONLY
    ===================================================== -->

    <% if (user && user.role === "admin") { %>

        <div class="sales-filter-field">

            <label for="sales-filter-substation">
                Substation
            </label>

            <select
                id="sales-filter-substation"
                name="substation"
            >

                <option value="">
                    All Substations
                </option>


                <% if (Array.isArray(substations)) { %>

                    <% substations.forEach(function (substation) { %>

                        <option
                            value="<%= substation._id %>"
                            <%= String(activeSubstationId || "") === String(substation._id)
                                ? "selected"
                                : "" %>
                        >
                            <%= substation.name %>
                        </option>

                    <% }); %>

                <% } %>

            </select>

        </div>

    <% } %>


    <!-- ====================================================
         APPLY
    ===================================================== -->

    <button
        type="submit"
        class="sales-filter-button"
    >
        Apply Filter
    </button>


    <!-- ====================================================
         RESET
    ===================================================== -->

    <a
        href="/sales?tab=<%= activeTab %>"
        class="sales-filter-clear"
    >
        Reset
    </a>


</form>


<!-- ========================================================
     SALES FILTER SCRIPT
========================================================= -->

<script>

document.addEventListener(
    "DOMContentLoaded",
    function () {

        const toggle =
            document.getElementById(
                "sales-filter-toggle"
            );

        const form =
            document.getElementById(
                "sales-filter-form"
            );


        if (
            !toggle ||
            !form
        ) {

            return;

        }


        toggle.addEventListener(
            "click",
            function () {

                const isOpen =
                    form.classList.toggle(
                        "active"
                    );


                toggle.setAttribute(
                    "aria-expanded",
                    isOpen
                        ? "true"
                        : "false"
                );

            }
        );

    }
);

</script>