<%
/*
 * ==========================================================
 * SALES FILTER
 * ==========================================================
 *
 * Filters ONLY the currently selected sales tab.
 *
 * Controller supplies:
 *
 *     activeTab
 *     activeFilterDate
 *     activeFilterPeriod
 *     filterLabel
 *
 * Query names:
 *
 *     summary:
 *         summaryDate
 *         summaryPeriod
 *
 *     staff-sales:
 *         staffSalesDate
 *         staffSalesPeriod
 *
 *     products:
 *         productsDate
 *         productsPeriod
 *
 *     arrears:
 *         arrearsDate
 *         arrearsPeriod
 *
 * These names must match TAB_CONFIG in:
 *
 *     services/salesService/filter.js
 *
 * ==========================================================
 */


const filterKeys = {

    summary: {

        date:
            "summaryDate",

        period:
            "summaryPeriod"

    },


    "staff-sales": {

        date:
            "staffSalesDate",

        period:
            "staffSalesPeriod"

    },


    products: {

        date:
            "productsDate",

        period:
            "productsPeriod"

    },


    arrears: {

        date:
            "arrearsDate",

        period:
            "arrearsPeriod"

    }

};


const activeKeys =
    filterKeys[activeTab] || filterKeys.summary;

%>


<!-- ========================================================
     FILTER TOGGLE
========================================================= -->

<div class="sales-filter-toggle-wrapper">

    <button
        type="button"
        id="sales-filter-toggle"
        class="sales-filter-toggle"
        aria-expanded="false"
        aria-controls="sales-filter-form"
    >
        filter date?
    </button>

</div>


<!-- ========================================================
     FILTER FORM
========================================================= -->

<form
    id="sales-filter-form"
    class="sales-filter"
    method="GET"
    action="/sales"
    hidden
>


    <!-- ====================================================
         ACTIVE TAB
    ===================================================== -->

    <input
        type="hidden"
        name="tab"
        value="<%= activeTab %>"
    >


    <!-- ====================================================
         DATE
    ===================================================== -->

    <div class="sales-filter-field">

        <label for="sales-filter-date">
            Date
        </label>

        <input
            id="sales-filter-date"
            type="date"
            name="<%= activeKeys.date %>"
            value="<%= activeFilterDate %>"
            required
        >

    </div>


    <!-- ====================================================
         PERIOD
    ===================================================== -->

    <div class="sales-filter-field">

        <label for="sales-filter-period">
            Period
        </label>

        <select
            id="sales-filter-period"
            name="<%= activeKeys.period %>"
        >

            <option
                value="day"
                <%= activeFilterPeriod === "day" ? "selected" : "" %>
            >
                Day
            </option>

            <option
                value="month"
                <%= activeFilterPeriod === "month" ? "selected" : "" %>
            >
                Month
            </option>

            <option
                value="year"
                <%= activeFilterPeriod === "year" ? "selected" : "" %>
            >
                Year
            </option>

        </select>

    </div>


    <!-- ====================================================
         APPLY
    ===================================================== -->

    <button
        type="submit"
        class="sales-filter-button"
    >
        Apply Filter
    </button>


    <!-- ====================================================
         RESET
    ===================================================== -->

    <a
        href="/sales?tab=<%= activeTab %>"
        class="sales-filter-clear"
    >
        Reset
    </a>


</form>


<!-- ========================================================
     FILTER TOGGLE SCRIPT
========================================================= -->

<script>

document.addEventListener(
    "DOMContentLoaded",
    function () {

        const toggle =
            document.getElementById(
                "sales-filter-toggle"
            );


        const filter =
            document.getElementById(
                "sales-filter-form"
            );


        if (
            !toggle ||
            !filter
        ) {

            return;

        }


        toggle.addEventListener(
            "click",
            function () {

                const isHidden =
                    filter.hidden;


                filter.hidden =
                    !isHidden;


                toggle.textContent =
                    isHidden
                        ? "hide filter"
                        : "filter date?";


                toggle.setAttribute(
                    "aria-expanded",
                    isHidden
                        ? "true"
                        : "false"
                );

            }
        );

    }
);

</script>