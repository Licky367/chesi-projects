<%
/*
 * This partial filters ONLY the currently selected tab.
 *
 * The controller supplies:
 * activeTab
 * activeFilterDate
 * activeFilterPeriod
 * filterLabel
 *
 * Query names are tab-specific:
 * summaryDate / summaryPeriod
 * staffSalesDate / staffSalesPeriod
 * productsDate / productsPeriod
 * arrearsDate / arrearsPeriod
 *
 * Therefore filtering one tab cannot modify another tab.
 */

const filterPrefix = {

    summary:
        "summary",

    "staff-sales":
        "staffSales",

    products:
        "products",

    arrears:
        "arrears"

}[activeTab] || "summary";


const dateKey =
    `${filterPrefix}Date`;


const periodKey =
    `${filterPrefix}Period`;

%>


<div class="sales-filter-toggle-wrapper">

    <button
        type="button"
        id="sales-filter-toggle"
        class="sales-filter-toggle"
        aria-expanded="false"
        aria-controls="sales-filter-form"
    >
        filter date?
    </button>

</div>


<form
    id="sales-filter-form"
    class="sales-filter"
    method="GET"
    action="/sales"
    hidden
>

    <input
        type="hidden"
        name="tab"
        value="<%= activeTab %>"
    >


    <div class="sales-filter-field">

        <label for="sales-filter-date">
            Date
        </label>

        <input
            id="sales-filter-date"
            type="date"
            name="<%= dateKey %>"
            value="<%= activeFilterDate %>"
            required
        >

    </div>


    <div class="sales-filter-field">

        <label for="sales-filter-period">
            Period
        </label>

        <select
            id="sales-filter-period"
            name="<%= periodKey %>"
        >

            <option
                value="day"
                <%= activeFilterPeriod === "day"
                    ? "selected"
                    : "" %>
            >
                Day
            </option>


            <option
                value="month"
                <%= activeFilterPeriod === "month"
                    ? "selected"
                    : "" %>
            >
                Month
            </option>


            <option
                value="year"
                <%= activeFilterPeriod === "year"
                    ? "selected"
                    : "" %>
            >
                Year
            </option>

        </select>

    </div>


    <button
        type="submit"
        class="sales-filter-button"
    >
        Apply Filter
    </button>


    <a
        href="/sales?tab=<%= activeTab %>"
        class="sales-filter-clear"
    >
        Reset
    </a>

</form>


<script>

document.addEventListener(
    "DOMContentLoaded",
    function () {

        const toggle =
            document.getElementById(
                "sales-filter-toggle"
            );


        const filter =
            document.getElementById(
                "sales-filter-form"
            );


        if (
            !toggle ||
            !filter
        ) {

            return;
        }


        toggle.addEventListener(
            "click",
            function () {

                const isHidden =
                    filter.hidden;


                filter.hidden =
                    !isHidden;


                toggle.textContent =
                    isHidden
                        ? "hide filter"
                        : "filter date?";


                toggle.setAttribute(
                    "aria-expanded",
                    isHidden
                        ? "true"
                        : "false"
                );

            }
        );

    }
);

</script>