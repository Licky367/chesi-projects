<%
function money(value) {
return Number(value || 0).toLocaleString("en-KE", {
minimumFractionDigits: 2,
maximumFractionDigits: 2
});
}
%>

<div class="sales-section"><div class="sales-section-heading">
    <div>
        <h2>Sales Summary</h2>
        <p>
            <%= filterLabel %>
        </p>
    </div>
</div>


<div class="sales-summary-grid">

    <!-- ==================================================
         CURRENT ASSET VALUE
    =================================================== -->

    <article class="sales-summary-card">
        <span class="sales-summary-label">
            Current Asset Value
        </span>

        <strong class="sales-summary-value">
            KSh <%= money(assetCost) %>
        </strong>
    </article>


    <!-- ==================================================
         TOTAL REVENUE COLLECTED
    =================================================== -->

    <article class="sales-summary-card">
        <span class="sales-summary-label">
            Total Revenue Collected
        </span>

        <strong class="sales-summary-value">
            KSh <%= money(totalRevenue) %>
        </strong>
    </article>


    <!-- ==================================================
         CUSTOMER ARREARS
    =================================================== -->

    <article class="sales-summary-card">
        <span class="sales-summary-label">
            Customer Arrears
        </span>

        <strong class="sales-summary-value">
            KSh <%= money(customerArrears) %>
        </strong>
    </article>


    <!-- ==================================================
         TOTAL EXPENSES
    =================================================== -->

    <article class="sales-summary-card">
        <span class="sales-summary-label">
            Total Expenses
        </span>

        <strong class="sales-summary-value">
            KSh <%= money(expenses) %>
        </strong>
    </article>


    <!-- ==================================================
         PROFIT
    =================================================== -->

    <article class="sales-summary-card">
        <span class="sales-summary-label">
            Profit From Product Sales
        </span>

        <strong class="sales-summary-value">
            KSh <%= money(profit) %>
        </strong>
    </article>


    <!-- ==================================================
         NET PROFIT
    =================================================== -->

    <article class="sales-summary-card">
        <span class="sales-summary-label">
            Net Profit
        </span>

        <strong class="sales-summary-value">
            KSh <%= money(netProfit) %>
        </strong>
    </article>

</div>

</div>