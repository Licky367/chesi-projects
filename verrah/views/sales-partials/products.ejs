<%
function number(value) {
    return Number(value || 0).toLocaleString("en-KE");
}

/*
 * ==========================================================
 * SELL INPUT VISIBILITY
 * ==========================================================
 */

const isAdmin =
    user &&
    user.role === "admin";

const hasSelectedSubstation =
    activeSubstationId &&
    String(activeSubstationId).trim() !== "";

const hideSellInput =
    isAdmin &&
    !hasSelectedSubstation;


/*
 * ==========================================================
 * MARKET AVAILABLE EDIT VISIBILITY
 * ==========================================================
 */

const canEditMarketAvailable =
    isAdmin &&
    hasSelectedSubstation;
%>


<div class="sales-section">


    <div class="sales-section-heading">

        <div>

            <h2>
                Product Analytics
            </h2>

            <p>
                <%= filterLabel %>
            </p>

        </div>

    </div>


    <!-- ======================================================
         ADD MANY PRODUCTS TO CART
    ======================================================= -->

    <% if (!hideSellInput) { %>

        <form
            action="/products/addManyToCart"
            method="POST"
            id="addManyToCartForm"
        >

            <!-- ==================================================
                 ADD TO CART BUTTON
                 Hidden until a Sell input contains a quantity.
            =================================================== -->

            <div
                id="addManyToCartActions"
                style="
                    display: none;
                    margin-bottom: 12px;
                "
            >

                <button
                    type="submit"
                    class="sales-filter-button"
                >

                    <i class="fas fa-cart-plus"></i>

                    Add Selected Products to Cart

                </button>

            </div>


    <% } %>


    <!-- ======================================================
         UPDATE MARKET AVAILABLE
    ======================================================= -->

    <% if (canEditMarketAvailable) { %>

        <form
            action="/substations/productsUpdate/<%= activeSubstationId %>"
            method="POST"
            id="updateMarketAvailableForm"
        >

            <input
                type="hidden"
                name="substationId"
                value="<%= activeSubstationId %>"
            >

            <!-- ==================================================
                 UPDATE BUTTON
                 Hidden until a Market Available value changes.
            =================================================== -->

            <div
                id="updateMarketAvailableActions"
                style="
                    display: none;
                    margin-bottom: 12px;
                "
            >

                <button
                    type="submit"
                    class="sales-filter-button"
                >

                    <i class="fas fa-save"></i>

                    Update Market Units

                </button>

            </div>


    <% } %>


    <!-- ======================================================
         PRODUCT TABLE
    ======================================================= -->

    <div class="sales-table-wrapper">


        <table class="sales-table">


            <thead>

                <tr>

                    <th>
                        #
                    </th>

                    <th>
                        Product Name
                    </th>

                    <th>
                        Items Available in Market
                    </th>

                    <th>
                        Items Available in Stock
                    </th>

                    <th>
                        Number of Sales
                    </th>

                </tr>

            </thead>


            <tbody>


                <% if (
                    Array.isArray(productAnalytics) &&
                    productAnalytics.length
                ) { %>


                    <% productAnalytics.forEach(
                        function(product, index)
                    { %>


                        <tr
                            class="sales-product-row"
                            onclick="
                                window.location.href =
                                '/substations/product/<%= product._id %>'
                            "
                            onkeydown="
                                if (
                                    event.key === 'Enter' ||
                                    event.key === ' '
                                ) {
                                    event.preventDefault();

                                    window.location.href =
                                    '/substations/product/<%= product._id %>';
                                }
                            "
                            tabindex="0"
                            role="link"
                        >


                            <td>

                                <%= index + 1 %>

                            </td>


                            <td>


                                <div
                                    style="
                                        display: flex;
                                        align-items: center;
                                        justify-content: space-between;
                                        gap: 15px;
                                    "
                                >


                                    <div>

                                        <strong>
                                            <%= product.name %>
                                        </strong>


                                        <small
                                            style="
                                                display: block;
                                                margin-top: 3px;
                                                font-size: 0.75rem;
                                                opacity: 0.7;
                                            "
                                        >

                                            KSh

                                            <%= number(
                                                product.unitSellPrice
                                            ) %>

                                        </small>

                                    </div>


                                    <% if (!hideSellInput) { %>

                                        <div
                                            onclick="
                                                event.stopPropagation();
                                            "
                                            onkeydown="
                                                event.stopPropagation();
                                            "
                                        >

                                            <input
                                                type="number"
                                                name="products[<%= index %>][qty]"
                                                min="1"
                                                max="<%= product.marketAvailable || 0 %>"
                                                step="1"
                                                placeholder="Sell"
                                                class="product-cart-qty"
                                                aria-label="Units for <%= product.name %>"
                                            >


                                            <input
                                                type="hidden"
                                                name="products[<%= index %>][productId]"
                                                value="<%= product._id %>"
                                            >

                                        </div>

                                    <% } %>


                                </div>


                            </td>


                            <!-- ==================================================
                                 MARKET AVAILABLE
                            =================================================== -->

                            <td
                                onclick="
                                    event.stopPropagation();
                                "
                                onkeydown="
                                    event.stopPropagation();
                                "
                            >

                                <% if (canEditMarketAvailable) { %>

                                    <input
                                        type="number"
                                        name="products[<%= index %>][units]"
                                        value="<%= product.marketAvailable || 0 %>"
                                        min="0"
                                        step="1"
                                        class="market-units-input"
                                        data-original-value="<%= product.marketAvailable || 0 %>"
                                        aria-label="Market units for <%= product.name %>"
                                    >


                                    <input
                                        type="hidden"
                                        name="products[<%= index %>][productId]"
                                        value="<%= product._id %>"
                                    >

                                <% } else { %>

                                    <%= number(
                                        product.marketAvailable
                                    ) %>

                                <% } %>

                            </td>


                            <!-- ==================================================
                                 STOCK AVAILABLE
                            =================================================== -->

                            <td>

                                <%= number(
                                    product.stockAvailable
                                ) %>

                            </td>


                            <!-- ==================================================
                                 SALES
                            =================================================== -->

                            <td>

                                <%= number(
                                    product.sales
                                ) %>

                            </td>


                        </tr>


                    <% }); %>


                <% } else { %>


                    <tr>

                        <td
                            colspan="5"
                            class="sales-empty"
                        >

                            No product analytics found
                            for this period.

                        </td>

                    </tr>


                <% } %>


            </tbody>


        </table>


    </div>


    <% if (canEditMarketAvailable) { %>

        </form>

    <% } %>


    <% if (!hideSellInput) { %>

        </form>

    <% } %>


</div>


<!-- ======================================================
     ADD MANY TO CART SCRIPT
======================================================= -->

<% if (!hideSellInput) { %>

<script>

document.addEventListener(
    "DOMContentLoaded",
    function () {

        const form =
            document.getElementById(
                "addManyToCartForm"
            );


        if (!form) {
            return;
        }


        const actions =
            document.getElementById(
                "addManyToCartActions"
            );


        const inputs =
            form.querySelectorAll(
                ".product-cart-qty"
            );


        if (!actions) {
            return;
        }


        function updateButton() {

            let hasQuantity =
                false;


            inputs.forEach(
                function (input) {

                    if (
                        Number(
                            input.value || 0
                        ) > 0
                    ) {

                        hasQuantity =
                            true;

                    }

                }
            );


            actions.style.display =
                hasQuantity
                    ? "block"
                    : "none";

        }


        inputs.forEach(
            function (input) {

                input.addEventListener(
                    "input",
                    updateButton
                );

            }
        );


        updateButton();

    }
);

</script>

<% } %>


<!-- ======================================================
     UPDATE MARKET AVAILABLE SCRIPT
======================================================= -->

<% if (canEditMarketAvailable) { %>

<script>

document.addEventListener(
    "DOMContentLoaded",
    function () {

        const form =
            document.getElementById(
                "updateMarketAvailableForm"
            );


        if (!form) {
            return;
        }


        const actions =
            document.getElementById(
                "updateMarketAvailableActions"
            );


        const inputs =
            form.querySelectorAll(
                ".market-units-input"
            );


        if (!actions) {
            return;
        }


        function updateButton() {

            let hasChanges =
                false;


            inputs.forEach(
                function (input) {

                    const originalValue =
                        Number(
                            input.dataset.originalValue || 0
                        );

                    const currentValue =
                        Number(
                            input.value || 0
                        );


                    if (
                        currentValue !==
                        originalValue
                    ) {

                        hasChanges =
                            true;

                    }

                }
            );


            actions.style.display =
                hasChanges
                    ? "block"
                    : "none";

        }


        inputs.forEach(
            function (input) {

                input.addEventListener(
                    "input",
                    updateButton
                );

                input.addEventListener(
                    "change",
                    updateButton
                );

            }
        );


        updateButton();

    }
);

</script>

<% } %>