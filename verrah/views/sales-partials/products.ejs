<%
function number(value) {
    return Number(value || 0).toLocaleString("en-KE");
}

/*

* ==========================================================
* SELL INPUT VISIBILITY
* ==========================================================
*
* Admin:
* No substation selected
* -> Hide Sell input
*
* Specific substation selected
* -> Show Sell input
*
* Non-admin:
* -> Always show Sell input
*
* ==========================================================
*/

const isAdmin =
    user &&
    user.role === "admin";

const isStaff =
    user &&
    user.role === "staff";

const hasSelectedSubstation =
    activeSubstationId &&
    String(activeSubstationId).trim() !== "";

const hideSellInput =
    isAdmin &&
    !hasSelectedSubstation;

/*

* ==========================================================
* ACTIVE SUBSTATION ID
* ==========================================================
*
* IMPORTANT:
*
* activeSubstationId is the actual MongoDB _id of the
* currently selected substation.
*
* It is passed directly to the cart service.
*
* DO NOT convert this value to the substation name.
*
* The cart service will store this ID as cartSubstation.
*
* ==========================================================
*/

const selectedSubstationId =
    hasSelectedSubstation
        ? String(activeSubstationId).trim()
        : "";

/*

* ==========================================================
* MARKET AVAILABLE EDIT VISIBILITY
* ==========================================================
*
* Admin + selected substation:
* -> Editable
*
* Otherwise:
* -> Normal displayed number
*
* ==========================================================
*/

const canEditMarketAvailable =
    isAdmin &&
    hasSelectedSubstation;
%>


<div class="sales-section">


    <!-- ======================================================
         SECTION HEADING
    ======================================================= -->

    <div class="sales-section-heading">

        <div>

            <h2>
                Product Analytics
            </h2>

            <p>
                <%= filterLabel %>
            </p>

        </div>

    </div>


    <!-- ======================================================
         ADD MANY PRODUCTS TO CART FORM
    ======================================================= -->

    <% if (!hideSellInput) { %>

        <form
            action="/products/addManyToCart"
            method="POST"
            id="addManyToCartForm"
        >

            <% if (hasSelectedSubstation) { %>

                <input
                    type="hidden"
                    name="activeSubstationId"
                    value="<%= selectedSubstationId %>"
                >

            <% } %>

        </form>


        <div
            id="addManyToCartActions"
            style="
                display: none;
                margin-bottom: 12px;
            "
        >

            <button
                type="submit"
                form="addManyToCartForm"
                class="sales-filter-button"
            >

                <i class="fas fa-cart-plus"></i>

                Add Selected Products to Cart

            </button>

        </div>

    <% } %>


    <!-- ======================================================
         UPDATE MARKET AVAILABLE FORM
    ======================================================= -->

    <% if (canEditMarketAvailable) { %>

        <form
            action="/substations/productsUpdate/<%= selectedSubstationId %>"
            method="POST"
            id="updateMarketAvailableForm"
        >

            <input
                type="hidden"
                name="substationId"
                value="<%= selectedSubstationId %>"
            >

        </form>


        <div
            id="updateMarketAvailableActions"
            style="
                display: none;
                margin-bottom: 12px;
            "
        >

            <button
                type="submit"
                form="updateMarketAvailableForm"
                class="sales-filter-button"
            >

                <i class="fas fa-save"></i>

                Update Market Units

            </button>

        </div>

    <% } %>


    <!-- ======================================================
         PRODUCT TABLE
    ======================================================= -->

    <div class="sales-table-wrapper">


        <table class="sales-table">


            <thead>

                <tr>

                    <th>
                        #
                    </th>

                    <th>
                        Product Name
                    </th>

                    <th>
                        Items Available in Market
                    </th>

                    <th>
                        Items Available in Stock
                    </th>

                    <th>
                        Number of Sales
                    </th>

                </tr>

            </thead>


            <tbody>


                <% if (
                    Array.isArray(productAnalytics) &&
                    productAnalytics.length
                ) { %>


                    <% productAnalytics.forEach(
                        function(product, index)
                    { %>


                        <!-- ==================================================
                             PRODUCT ROW
                        =================================================== -->
                        <!--
                            STAFF:
                                /stock/:stockProductId/batches

                            OTHER USERS:
                                /substations/product/:productId
                        -->

                        <tr
                            class="sales-product-row"

                            <% if (isStaff) { %>

                                <% if (product.stockProductId) { %>

                                    onclick="
                                        window.location.href =
                                        '/stock/<%= product.stockProductId %>/batches'
                                    "

                                    onkeydown="
                                        if (
                                            event.key === 'Enter' ||
                                            event.key === ' '
                                        ) {
                                            event.preventDefault();

                                            window.location.href =
                                            '/stock/<%= product.stockProductId %>/batches';
                                        }
                                    "

                                    tabindex="0"
                                    role="link"

                                <% } %>

                            <% } else { %>

                                onclick="
                                    window.location.href =
                                    '/substations/product/<%= product._id %>'
                                "

                                onkeydown="
                                    if (
                                        event.key === 'Enter' ||
                                        event.key === ' '
                                    ) {
                                        event.preventDefault();

                                        window.location.href =
                                        '/substations/product/<%= product._id %>';
                                    }
                                "

                                tabindex="0"
                                role="link"

                            <% } %>
                        >


                            <!-- ==================================================
                                 #
                            =================================================== -->

                            <td>

                                <%= index + 1 %>

                            </td>


                            <!-- ==================================================
                                 PRODUCT NAME
                            =================================================== -->

                            <td>

                                <div
                                    style="
                                        display: flex;
                                        align-items: center;
                                        justify-content: space-between;
                                        gap: 15px;
                                    "
                                >

                                    <div>

                                        <strong>
                                            <%= product.name %>
                                        </strong>


                                        <small
                                            style="
                                                display: block;
                                                margin-top: 3px;
                                                font-size: 0.75rem;
                                                opacity: 0.7;
                                            "
                                        >

                                            KSh

                                            <%= number(
                                                product.unitSellPrice
                                            ) %>

                                        </small>

                                    </div>


                                    <!-- ==================================================
                                         SELL INPUT
                                    =================================================== -->

                                    <% if (!hideSellInput) { %>

                                        <div
                                            onclick="
                                                event.stopPropagation();
                                            "
                                            onkeydown="
                                                event.stopPropagation();
                                            "
                                        >

                                            <input
                                                type="number"
                                                name="products[<%= index %>][qty]"
                                                form="addManyToCartForm"
                                                min="1"
                                                max="<%= product.marketAvailable || 0 %>"
                                                step="1"
                                                placeholder="Sell"
                                                class="product-cart-qty"
                                                aria-label="Units for <%= product.name %>"
                                            >


                                            <input
                                                type="hidden"
                                                name="products[<%= index %>][productId]"
                                                value="<%= product._id %>"
                                                form="addManyToCartForm"
                                            >

                                        </div>

                                    <% } %>


                                </div>

                            </td>


                            <!-- ==================================================
                                 MARKET AVAILABLE
                            =================================================== -->

                            <td
                                onclick="
                                    event.stopPropagation();
                                "
                                onkeydown="
                                    event.stopPropagation();
                                "
                            >

                                <% if (canEditMarketAvailable) { %>

                                    <div
                                        style="
                                            display: flex;
                                            align-items: center;
                                            justify-content: flex-end;
                                            gap: 8px;
                                            width: 100%;
                                        "
                                    >

                                        <input
                                            type="number"
                                            name="products[<%= index %>][units]"
                                            value="<%= product.marketAvailable || 0 %>"
                                            form="updateMarketAvailableForm"
                                            min="0"
                                            step="1"
                                            class="market-units-input"
                                            data-original-value="<%= product.marketAvailable || 0 %>"
                                            aria-label="Market units for <%= product.name %>"
                                        >


                                        <input
                                            type="hidden"
                                            name="products[<%= index %>][productId]"
                                            value="<%= product._id %>"
                                            form="updateMarketAvailableForm"
                                        >

                                    </div>

                                <% } else { %>

                                    <%= number(
                                        product.marketAvailable
                                    ) %>

                                <% } %>

                            </td>


                            <!-- ==================================================
                                 STOCK AVAILABLE
                            =================================================== -->

                            <td>

                                <%= number(
                                    product.stockAvailable
                                ) %>

                            </td>


                            <!-- ==================================================
                                 SALES
                            =================================================== -->

                            <td>

                                <%= number(
                                    product.sales
                                ) %>

                            </td>


                        </tr>


                    <% }); %>


                <% } else { %>


                    <tr>

                        <td
                            colspan="5"
                            class="sales-empty"
                        >

                            No product analytics found
                            for this period.

                        </td>

                    </tr>


                <% } %>


            </tbody>


        </table>


    </div>


</div>


<!-- ======================================================
     ADD MANY TO CART SCRIPT
======================================================= -->

<% if (!hideSellInput) { %>

<script>

document.addEventListener(
    "DOMContentLoaded",
    function () {

        const actions =
            document.getElementById(
                "addManyToCartActions"
            );


        const sellInputs =
            document.querySelectorAll(
                '[form="addManyToCartForm"].product-cart-qty'
            );


        if (
            !actions ||
            !sellInputs.length
        ) {

            return;

        }


        function isValidSellValue(
            value
        ) {

            const trimmed =
                value.trim();


            if (
                trimmed === ""
            ) {

                return false;

            }


            if (
                !/^\d+$/.test(
                    trimmed
                )
            ) {

                return false;

            }


            return (
                Number(trimmed) >= 1
            );

        }


        function updateCartButton() {

            let hasValidQuantity =
                false;


            sellInputs.forEach(
                function (input) {

                    if (
                        isValidSellValue(
                            input.value
                        )
                    ) {

                        hasValidQuantity =
                            true;

                    }

                }
            );


            actions.style.display =
                hasValidQuantity
                    ? "block"
                    : "none";

        }


        sellInputs.forEach(
            function (input) {

                input.addEventListener(
                    "input",
                    updateCartButton
                );


                input.addEventListener(
                    "change",
                    updateCartButton
                );

            }
        );


        updateCartButton();

    }
);

</script>

<% } %>


<!-- ======================================================
     UPDATE MARKET AVAILABLE SCRIPT
======================================================= -->

<% if (canEditMarketAvailable) { %>

<script>

document.addEventListener(
    "DOMContentLoaded",
    function () {

        const actions =
            document.getElementById(
                "updateMarketAvailableActions"
            );


        const marketInputs =
            document.querySelectorAll(
                '[form="updateMarketAvailableForm"].market-units-input'
            );


        if (
            !actions ||
            !marketInputs.length
        ) {

            return;

        }


        function isValidMarketValue(
            value
        ) {

            const trimmed =
                value.trim();


            if (
                trimmed === ""
            ) {

                return false;

            }


            if (
                !/^\d+$/.test(
                    trimmed
                )
            ) {

                return false;

            }


            return (
                Number(trimmed) >= 0
            );

        }


        function updateMarketButton() {

            let hasValidChange =
                false;


            marketInputs.forEach(
                function (input) {

                    if (
                        !isValidMarketValue(
                            input.value
                        )
                    ) {

                        return;

                    }


                    const currentValue =
                        Number(
                            input.value
                        );


                    const originalValue =
                        Number(
                            input.dataset.originalValue
                        );


                    if (
                        currentValue !==
                        originalValue
                    ) {

                        hasValidChange =
                            true;

                    }

                }
            );


            actions.style.display =
                hasValidChange
                    ? "block"
                    : "none";

        }


        marketInputs.forEach(
            function (input) {

                input.addEventListener(
                    "input",
                    updateMarketButton
                );


                input.addEventListener(
                    "change",
                    updateMarketButton
                );

            }
        );


        updateMarketButton();

    }
);

</script>

<% } %>