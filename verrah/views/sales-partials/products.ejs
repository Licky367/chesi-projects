<%
function number(value) {
  return Number(value || 0).toLocaleString("en-KE");
}
%>

<div class="sales-section-heading">
  <div>
    <h2>Product Analytics</h2>
    <p>
      <%= filterLabel %>
    </p>
  </div>
</div>

<div class="sales-table-wrapper">
  <table class="sales-table">
    <thead>
      <tr>
        <th>#</th>
        <th>Product Name</th>
        <th>Items Available in Stock</th>
        <th>Items Available in Market</th>
        <th>Number of Sales</th>
      </tr>
    </thead>
    <tbody>
      <% if (Array.isArray(productAnalytics) && productAnalytics.length) { %>
        <% productAnalytics.forEach(function(product, index) { %>
          <tr
            class="sales-product-row"
            onclick="window.location.href='/substations/product/<%= product._id %>'"
            onkeydown="if(event.key === 'Enter' || event.key === ' ') { event.preventDefault(); window.location.href='/substations/product/<%= product._id %>'; }"
            tabindex="0"
            role="link"
          >
            <td>
              <%= index + 1 %>
            </td>
            <td>
              <strong>
                <%= product.name %>
              </strong>
              <small style="display:block; margin-top:3px; font-size:0.75rem; opacity:0.7;">
                KSh <%= number(product.unitSellPrice) %>
              </small>
            </td>
            <td>
              <%= number(product.stockAvailable) %>
            </td>
            <td>
              <%= number(product.marketAvailable) %>
            </td>
            <td>
              <%= number(product.sales) %>
            </td>
          </tr>
        <% }); %>
      <% } else { %>
        <tr>
          <td colspan="5" class="sales-empty">
            No product analytics found for this period.
          </td>
        </tr>
      <% } %>
    </tbody>
  </table>
</div>