<%
function number(value) {
return Number(value || 0).toLocaleString("en-KE");
}

/*

SELL INPUT VISIBILITY

*/

const isAdmin =
user &&
user.role === "admin";

const isStaff =
user &&
user.role === "staff";

const hasSelectedSubstation =
activeSubstationId &&
String(activeSubstationId).trim() !== "";

const hideSellInput =
isAdmin &&
!hasSelectedSubstation;

/*

ACTIVE SUBSTATION ID

*/

const selectedSubstationId =
hasSelectedSubstation
? String(activeSubstationId).trim()
: "";

/*

MARKET AVAILABLE EDIT VISIBILITY

*/

const canEditMarketAvailable =
isAdmin &&
hasSelectedSubstation;

/*

CATEGORY LIST

*/

const availableCategories =
Array.isArray(categories)
? categories
: [];
%>

<!-- ======================================================
     SECTION HEADING
======================================================= --><div class="sales-section-heading"><div>

    <h2>
        Product Analytics

        <button
            type="button"
            id="menuIcon"
            aria-label="Filter products by category"
            title="Filter by category"
        >
            <i class="fas fa-bars"></i>
        </button>
    </h2>

    <p>
        <%= filterLabel %>
    </p>

</div>

</div><!-- ======================================================
     CATEGORY FILTER MODAL
======================================================= --><div
    id="categoryFilterModal"
    aria-hidden="true"
><div
    id="categoryFilterOverlay"
></div>

<div
    id="categoryFilterPopup"
    role="dialog"
    aria-modal="true"
    aria-labelledby="categoryFilterTitle"
>

    <div id="categoryFilterHeader">

        <h3 id="categoryFilterTitle">
            Product Categories
        </h3>

        <button
            type="button"
            id="closeCategoryFilter"
            aria-label="Close category filter"
        >
            <i class="fas fa-times"></i>
        </button>

    </div>


    <div id="categoryFilterOptions">

        <button
            type="button"
            class="category-filter-option active"
            data-category-id="all"
        >
            All Categories
        </button>


        <% availableCategories.forEach(function(category) { %>

            <button
                type="button"
                class="category-filter-option"
                data-category-id="<%= category._id %>"
            >
                <%= category.name %>
            </button>

        <% }); %>

    </div>

</div>

</div><!-- ======================================================
     ADD MANY PRODUCTS TO CART FORM
======================================================= --><% if (!hideSellInput) { %>

<form
    action="/products/addManyToCart"
    method="POST"
    id="addManyToCartForm"
>

    <% if (hasSelectedSubstation) { %>

        <input
            type="hidden"
            name="activeSubstationId"
            value="<%= selectedSubstationId %>"
        >

    <% } %>

</form>


<div
    id="addManyToCartActions"
    style="
        display: none;
        margin-bottom: 12px;
    "
>

    <button
        type="submit"
        form="addManyToCartForm"
        class="sales-filter-button"
    >

        <i class="fas fa-cart-plus"></i>

        Add Selected Products to Cart

    </button>

</div>

<% } %>

<!-- ======================================================
     UPDATE MARKET AVAILABLE FORM
======================================================= --><% if (canEditMarketAvailable) { %>

<form
    action="/substations/productsUpdate/<%= selectedSubstationId %>"
    method="POST"
    id="updateMarketAvailableForm"
>

    <input
        type="hidden"
        name="substationId"
        value="<%= selectedSubstationId %>"
    >

</form>


<div
    id="updateMarketAvailableActions"
    style="
        display: none;
        margin-bottom: 12px;
    "
>

    <button
        type="submit"
        form="updateMarketAvailableForm"
        class="sales-filter-button"
    >

        <i class="fas fa-save"></i>

        Update Market Units

    </button>

</div>

<% } %>

<!-- ======================================================
     PRODUCT TABLE
======================================================= --><div class="sales-table-wrapper"><table class="sales-table">

    <thead>

        <tr>

            <th>
                #
            </th>

            <th>
                Product Name
            </th>

            <th>
                Items Available in Market
            </th>

            <th>
                Items Available in Stock
            </th>

            <th>
                Number of Sales
            </th>

        </tr>

    </thead>


    <tbody>


        <% if (
            Array.isArray(productAnalytics) &&
            productAnalytics.length
        ) { %>


            <% productAnalytics.forEach(
                function(product, index)
            { %>


                <%
                let productCategoryId = "";

                if (
                    product.category &&
                    typeof product.category === "object" &&
                    product.category._id
                ) {
                    productCategoryId =
                        String(product.category._id);
                } else if (product.category) {
                    productCategoryId =
                        String(product.category);
                }
                %>


                <!-- ==================================================
                     PRODUCT ROW
                =================================================== -->

                <tr
                    class="sales-product-row"

                    data-category-id="<%= productCategoryId %>"

                    <% if (isStaff) { %>

                        <% if (product.stockProductId) { %>

                            onclick="
                                window.location.href =
                                '/stock/<%= product.stockProductId %>/batches'
                            "

                            onkeydown="
                                if (
                                    event.key === 'Enter' ||
                                    event.key === ' '
                                ) {
                                    event.preventDefault();

                                    window.location.href =
                                    '/stock/<%= product.stockProductId %>/batches';
                                }
                            "

                            tabindex="0"
                            role="link"

                        <% } %>

                    <% } else { %>

                        onclick="
                            window.location.href =
                            '/substations/product/<%= product._id %>'
                        "

                        onkeydown="
                            if (
                                event.key === 'Enter' ||
                                event.key === ' '
                            ) {
                                event.preventDefault();

                                window.location.href =
                                '/substations/product/<%= product._id %>';
                            }
                        "

                        tabindex="0"
                        role="link"

                    <% } %>
                >


                    <!-- ==================================================
                         #
                    =================================================== -->

                    <td>

                        <%= index + 1 %>

                    </td>


                    <!-- ==================================================
                         PRODUCT NAME
                    =================================================== -->

                    <td>

                        <div
                            style="
                                display: flex;
                                align-items: center;
                                justify-content: space-between;
                                gap: 15px;
                            "
                        >

                            <div>

                                <strong>
                                    <%= product.name %>
                                </strong>


                                <small
                                    style="
                                        display: block;
                                        margin-top: 3px;
                                        font-size: 0.75rem;
                                        opacity: 0.7;
                                    "
                                >

                                    KSh

                                    <%= number(
                                        product.unitSellPrice
                                    ) %>

                                </small>

                            </div>


                            <!-- ==================================================
                                 SELL INPUT
                            =================================================== -->

                            <% if (!hideSellInput) { %>

                                <div
                                    onclick="
                                        event.stopPropagation();
                                    "
                                    onkeydown="
                                        event.stopPropagation();
                                    "
                                >

                                    <input
                                        type="number"
                                        name="products[<%= index %>][qty]"
                                        form="addManyToCartForm"
                                        min="1"
                                        max="<%= product.marketAvailable || 0 %>"
                                        step="1"
                                        placeholder="Sell"
                                        class="product-cart-qty"
                                        aria-label="Units for <%= product.name %>"
                                    >


                                    <input
                                        type="hidden"
                                        name="products[<%= index %>][productId]"
                                        value="<%= product._id %>"
                                        form="addManyToCartForm"
                                    >

                                </div>

                            <% } %>


                        </div>

                    </td>


                    <!-- ==================================================
                         MARKET AVAILABLE
                    =================================================== -->

                    <td
                        onclick="
                            event.stopPropagation();
                        "
                        onkeydown="
                            event.stopPropagation();
                        "
                    >

                        <% if (canEditMarketAvailable) { %>

                            <div
                                style="
                                    display: flex;
                                    align-items: center;
                                    justify-content: flex-end;
                                    gap: 8px;
                                    width: 100%;
                                "
                            >

                                <input
                                    type="number"
                                    name="products[<%= index %>][units]"
                                    value="<%= product.marketAvailable || 0 %>"
                                    form="updateMarketAvailableForm"
                                    min="0"
                                    step="1"
                                    class="market-units-input"
                                    data-original-value="<%= product.marketAvailable || 0 %>"
                                    aria-label="Market units for <%= product.name %>"
                                >


                                <input
                                    type="hidden"
                                    name="products[<%= index %>][productId]"
                                    value="<%= product._id %>"
                                    form="updateMarketAvailableForm"
                                >

                            </div>

                        <% } else { %>

                            <%= number(
                                product.marketAvailable
                            ) %>

                        <% } %>

                    </td>


                    <!-- ==================================================
                         STOCK AVAILABLE
                    =================================================== -->

                    <td>

                        <%= number(
                            product.stockAvailable
                        ) %>

                    </td>


                    <!-- ==================================================
                         SALES
                    =================================================== -->

                    <td>

                        <%= number(
                            product.sales
                        ) %>

                    </td>


                </tr>


            <% }); %>


        <% } else { %>


            <tr>

                <td
                    colspan="5"
                    class="sales-empty"
                >

                    No product analytics found
                    for this period.

                </td>

            </tr>


        <% } %>


    </tbody>


</table>

</div><script>
(function () {

    const menuIcon =
        document.getElementById("menuIcon");

    const modal =
        document.getElementById("categoryFilterModal");

    const overlay =
        document.getElementById("categoryFilterOverlay");

    const closeButton =
        document.getElementById("closeCategoryFilter");

    const options =
        document.querySelectorAll(
            ".category-filter-option"
        );

    const rows =
        document.querySelectorAll(
            ".sales-product-row"
        );


    if (!menuIcon || !modal) {
        return;
    }


    function openCategoryFilter() {

        modal.classList.add("active");

        modal.setAttribute(
            "aria-hidden",
            "false"
        );

    }


    function closeCategoryFilter() {

        modal.classList.remove("active");

        modal.setAttribute(
            "aria-hidden",
            "true"
        );

    }


    function filterProducts(categoryId) {

        rows.forEach(function (row) {

            const rowCategoryId =
                row.getAttribute(
                    "data-category-id"
                );

            if (
                categoryId === "all" ||
                rowCategoryId === categoryId
            ) {

                row.style.display = "";

            } else {

                row.style.display = "none";

            }

        });


        options.forEach(function (option) {

            option.classList.toggle(
                "active",
                option.getAttribute(
                    "data-category-id"
                ) === categoryId
            );

        });


        closeCategoryFilter();

    }


    menuIcon.addEventListener(
        "click",
        function (event) {

            event.stopPropagation();

            openCategoryFilter();

        }
    );


    closeButton.addEventListener(
        "click",
        function () {

            closeCategoryFilter();

        }
    );


    overlay.addEventListener(
        "click",
        function () {

            closeCategoryFilter();

        }
    );


    options.forEach(function (option) {

        option.addEventListener(
            "click",
            function () {

                filterProducts(
                    option.getAttribute(
                        "data-category-id"
                    )
                );

            }
        );

    });


    document.addEventListener(
        "keydown",
        function (event) {

            if (
                event.key === "Escape" &&
                modal.classList.contains("active")
            ) {

                closeCategoryFilter();

            }

        }
    );

})();
</script>