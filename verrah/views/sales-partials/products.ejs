<%
function number(value) {
    return Number(value || 0).toLocaleString("en-KE");
}

const isAdmin =
    user &&
    user.role === "admin";

const isStaff =
    user &&
    user.role === "staff";

const hasSelectedSubstation =
    activeSubstationId &&
    String(activeSubstationId).trim() !== "";

const hideSellInput =
    isAdmin &&
    !hasSelectedSubstation;

const selectedSubstationId =
    hasSelectedSubstation
        ? String(activeSubstationId).trim()
        : "";

const canEditMarketAvailable =
    isAdmin &&
    hasSelectedSubstation;

const availableCategories =
    Array.isArray(categories)
        ? categories
        : [];

const selectedCategoryId =
    typeof categoryId !== "undefined" &&
    categoryId
        ? String(categoryId)
        : "";


/*
==========================================================
CATEGORY URL
==========================================================
*/

const categoryBasePath =
    currentPath || "/sales";

function categoryUrl(category) {

    const params =
        new URLSearchParams();

    if (
        hasSelectedSubstation
    ) {

        params.set(
            "substation",
            selectedSubstationId
        );

    }

    if (
        category
    ) {

        params.set(
            "category",
            String(
                category
            )
        );

    }

    const query =
        params.toString();

    return query
        ? `${categoryBasePath}?${query}`
        : categoryBasePath;
}
%>


<!-- ======================================================
PRODUCT ANALYTICS HEADER
====================================================== -->

<div class="sales-section-heading">

    <div>

        <h2>

            Product Analytics

            <button
                type="button"
                id="menuIcon"
                aria-label="Filter products by category"
                title="Filter by category"
            >

                <i class="fas fa-bars"></i>

            </button>

        </h2>

        <p>

            <%= filterLabel %>

        </p>

    </div>

</div>


<!-- ======================================================
CATEGORY FILTER MODAL
====================================================== -->

<div
    id="categoryFilterModal"
    aria-hidden="true"
>

    <div
        id="categoryFilterOverlay"
    ></div>


    <div
        id="categoryFilterPopup"
        role="dialog"
        aria-modal="true"
        aria-labelledby="categoryFilterTitle"
    >

        <div id="categoryFilterHeader">

            <h3 id="categoryFilterTitle">

                Product Categories

            </h3>


            <button
                type="button"
                id="closeCategoryFilter"
                aria-label="Close category filter"
            >

                <i class="fas fa-times"></i>

            </button>

        </div>


        <div id="categoryFilterOptions">

            <!-- ==========================================
            ALL CATEGORIES
            =========================================== -->

            <button
                type="button"
                class="category-filter-option <%= !selectedCategoryId ? 'active' : '' %>"
                data-category-id="all"
                onclick="
                    window.location.href =
                    '<%= categoryUrl("") %>'
                "
            >

                All Categories

            </button>


            <!-- ==========================================
            CATEGORY OPTIONS
            =========================================== -->

            <% availableCategories.forEach(function(category) { %>

                <button
                    type="button"
                    class="category-filter-option <%= selectedCategoryId === String(category._id) ? 'active' : '' %>"
                    data-category-id="<%= category._id %>"
                    onclick="
                        window.location.href =
                        '<%= categoryUrl(category._id) %>'
                    "
                >

                    <%= category.name %>

                </button>

            <% }); %>

        </div>

    </div>

</div>


<!-- ======================================================
ADD MANY PRODUCTS TO CART
====================================================== -->

<% if (!hideSellInput) { %>

<form
    action="/products/addManyToCart"
    method="POST"
    id="addManyToCartForm"
>

    <% if (hasSelectedSubstation) { %>

        <input
            type="hidden"
            name="activeSubstationId"
            value="<%= selectedSubstationId %>"
        >

    <% } %>

</form>


<div
    id="addManyToCartActions"
    style="
        display: none;
        position: fixed;
        left: 20px;
        bottom: 20px;
        z-index: 1000;
    "
>

    <button
        type="submit"
        form="addManyToCartForm"
        class="sales-filter-button"
    >

        <i class="fas fa-cart-plus"></i>

        Add Selected Products to Cart

    </button>

</div>

<% } %>


<!-- ======================================================
UPDATE MARKET AVAILABLE
====================================================== -->

<% if (canEditMarketAvailable) { %>

<form
    action="/substations/productsUpdate/<%= selectedSubstationId %>"
    method="POST"
    id="updateMarketAvailableForm"
>

    <input
        type="hidden"
        name="substationId"
        value="<%= selectedSubstationId %>"
    >

</form>


<div
    id="updateMarketAvailableActions"
    style="
        display: none;
        position: fixed;
        right: 20px;
        bottom: 20px;
        z-index: 1000;
    "
>

    <button
        type="submit"
        form="updateMarketAvailableForm"
        class="sales-filter-button"
    >

        <i class="fas fa-save"></i>

        Update Market Units

    </button>

</div>

<% } %>


<!-- ======================================================
PRODUCT TABLE
====================================================== -->

<div class="sales-table-wrapper">

    <table class="sales-table">

        <thead>

            <tr>

                <th>
                    #
                </th>

                <th>
                    Product Name
                </th>

                <th>
                    Items Available in Market
                </th>

                <th>
                    Items Available in Stock
                </th>

                <th>
                    Number of Sales
                </th>

            </tr>

        </thead>


        <tbody>

            <% if (
                Array.isArray(productAnalytics) &&
                productAnalytics.length
            ) { %>


                <% productAnalytics.forEach(
                    function(product, index)
                { %>


                    <!-- ==================================
                    PRODUCT ROW
                    =================================== -->

                    <tr
                        class="sales-product-row"

                        <% if (isStaff) { %>

                            <% if (product.stockProductId) { %>

                                onclick="
                                    window.location.href =
                                    '/stock/<%= product.stockProductId %>/batches'
                                "

                                onkeydown="
                                    if (
                                        event.key === 'Enter' ||
                                        event.key === ' '
                                    ) {

                                        event.preventDefault();

                                        window.location.href =
                                        '/stock/<%= product.stockProductId %>/batches';

                                    }
                                "

                                tabindex="0"
                                role="link"

                            <% } %>

                        <% } else { %>

                            onclick="
                                window.location.href =
                                '/substations/product/<%= product._id %>'
                            "

                            onkeydown="
                                if (
                                    event.key === 'Enter' ||
                                    event.key === ' '
                                ) {

                                    event.preventDefault();

                                    window.location.href =
                                    '/substations/product/<%= product._id %>';

                                }
                            "

                            tabindex="0"
                            role="link"

                        <% } %>

                    >


                        <!-- ==================================
                        NUMBER
                        =================================== -->

                        <td>

                            <%= index + 1 %>

                        </td>


                        <!-- ==================================
                        PRODUCT NAME
                        =================================== -->

                        <td>

                            <div
                                style="
                                    display: flex;
                                    align-items: center;
                                    justify-content: space-between;
                                    gap: 15px;
                                "
                            >

                                <div>

                                    <strong>

                                        <%= product.name %>

                                    </strong>


                                    <small
                                        style="
                                            display: block;
                                            margin-top: 3px;
                                            font-size: 0.75rem;
                                            opacity: 0.7;
                                        "
                                    >

                                        KSh

                                        <%= number(
                                            product.unitSellPrice
                                        ) %>

                                    </small>

                                </div>


                                <!-- ==================================
                                SELL INPUT
                                =================================== -->

                                <% if (!hideSellInput) { %>

                                    <div
                                        onclick="
                                            event.stopPropagation();
                                        "

                                        onkeydown="
                                            event.stopPropagation();
                                        "
                                    >

                                        <input
                                            type="number"
                                            name="products[<%= index %>][qty]"
                                            form="addManyToCartForm"
                                            min="1"
                                            max="<%= product.marketAvailable || 0 %>"
                                            step="1"
                                            placeholder="Sell"
                                            class="product-cart-qty"
                                            aria-label="Units for <%= product.name %>"
                                        >


                                        <input
                                            type="hidden"
                                            name="products[<%= index %>][productId]"
                                            value="<%= product._id %>"
                                            form="addManyToCartForm"
                                        >

                                    </div>

                                <% } %>

                            </div>

                        </td>


                        <!-- ==================================
                        MARKET AVAILABLE
                        =================================== -->

                        <td
                            onclick="
                                event.stopPropagation();
                            "

                            onkeydown="
                                event.stopPropagation();
                            "
                        >

                            <% if (canEditMarketAvailable) { %>

                                <input
                                    type="number"
                                    name="products[<%= index %>][units]"
                                    value="<%= Number(product.marketAvailable || 0) %>"
                                    min="0"
                                    step="1"
                                    form="updateMarketAvailableForm"
                                    class="product-market-input"
                                    aria-label="Market units for <%= product.name %>"
                                >


                                <input
                                    type="hidden"
                                    name="products[<%= index %>][productId]"
                                    value="<%= product._id %>"
                                    form="updateMarketAvailableForm"
                                >

                            <% } else { %>

                                <%= number(
                                    product.marketAvailable
                                ) %>

                            <% } %>

                        </td>


                        <!-- ==================================
                        STOCK AVAILABLE
                        =================================== -->

                        <td>

                            <%= number(
                                product.stockAvailable
                            ) %>

                        </td>


                        <!-- ==================================
                        SALES
                        =================================== -->

                        <td>

                            <%= number(
                                product.sales
                            ) %>

                        </td>


                    </tr>


                <% }); %>


            <% } else { %>


                <tr>

                    <td
                        colspan="5"
                        class="sales-empty"
                    >

                        No product analytics found
                        for this period.

                    </td>

                </tr>


            <% } %>

        </tbody>

    </table>

</div>


<!-- ======================================================
CATEGORY MODAL / CART SCRIPT
====================================================== -->

<script>

(function () {

    const menuIcon =
        document.getElementById(
            "menuIcon"
        );


    const modal =
        document.getElementById(
            "categoryFilterModal"
        );


    const overlay =
        document.getElementById(
            "categoryFilterOverlay"
        );


    const closeButton =
        document.getElementById(
            "closeCategoryFilter"
        );


    if (
        !menuIcon ||
        !modal
    ) {

        return;

    }


    function openCategoryFilter() {

        modal.classList.add(
            "active"
        );

        modal.setAttribute(
            "aria-hidden",
            "false"
        );

    }


    function closeCategoryFilter() {

        modal.classList.remove(
            "active"
        );

        modal.setAttribute(
            "aria-hidden",
            "true"
        );

    }


    menuIcon.addEventListener(

        "click",

        function (event) {

            event.stopPropagation();

            openCategoryFilter();

        }

    );


    if (
        closeButton
    ) {

        closeButton.addEventListener(

            "click",

            function () {

                closeCategoryFilter();

            }

        );

    }


    if (
        overlay
    ) {

        overlay.addEventListener(

            "click",

            function () {

                closeCategoryFilter();

            }

        );

    }


    document.addEventListener(

        "keydown",

        function (event) {

            if (
                event.key === "Escape" &&
                modal.classList.contains(
                    "active"
                )
            ) {

                closeCategoryFilter();

            }

        }

    );


    // ======================================================
    // SELL INPUT BUTTON
    // ======================================================

    const sellInputs =
        document.querySelectorAll(
            ".product-cart-qty"
        );


    const addManyToCartActions =
        document.getElementById(
            "addManyToCartActions"
        );


    function updateAddToCartButton() {

        if (
            !addManyToCartActions
        ) {

            return;

        }


        let hasQuantity =
            false;


        sellInputs.forEach(

            function (input) {

                const value =
                    Number(
                        input.value
                    );


                if (
                    input.value.trim() !== "" &&
                    Number.isFinite(value) &&
                    value > 0
                ) {

                    hasQuantity =
                        true;

                }

            }

        );


        addManyToCartActions.style.display =
            hasQuantity
                ? "block"
                : "none";

    }


    sellInputs.forEach(

        function (input) {

            input.addEventListener(
                "input",
                updateAddToCartButton
            );

            input.addEventListener(
                "change",
                updateAddToCartButton
            );

        }

    );


    // ======================================================
    // MARKET UPDATE BUTTON
    // ======================================================

    const marketInputs =
        document.querySelectorAll(
            ".product-market-input"
        );


    const updateMarketAvailableActions =
        document.getElementById(
            "updateMarketAvailableActions"
        );


    function updateMarketButton() {

        if (
            !updateMarketAvailableActions
        ) {

            return;

        }


        updateMarketAvailableActions.style.display =
            marketInputs.length
                ? "block"
                : "none";

    }


    marketInputs.forEach(

        function (input) {

            input.addEventListener(
                "input",
                updateMarketButton
            );

            input.addEventListener(
                "change",
                updateMarketButton
            );

        }

    );


})();

</script>