<%
function number(value) {
    return Number(value || 0).toLocaleString("en-KE");
}

const isAdmin =
    user &&
    user.role === "admin";

const isStaff =
    user &&
    user.role === "staff";

const hasSelectedSubstation =
    activeSubstationId &&
    String(activeSubstationId).trim() !== "";

const hideSellInput =
    isAdmin &&
    !hasSelectedSubstation;

const selectedSubstationId =
    hasSelectedSubstation
        ? String(activeSubstationId).trim()
        : "";

const canEditMarketAvailable =
    isAdmin &&
    hasSelectedSubstation;

const productCategories =
    Array.isArray(categories)
        ? categories
        : [];
%>


<!-- =========================================================
     PRODUCT ANALYTICS
========================================================== -->

<section class="sales-section">

    <!-- =====================================================
         SECTION HEADING
    ====================================================== -->

    <div class="sales-section-heading">

        <div>

            <h2>

                Product Analytics

                <i
                    id="menuIcon"
                    class="fas fa-bars"
                    role="button"
                    tabindex="0"
                    aria-label="Filter products by category"
                    title="Filter by category"
                ></i>

            </h2>

            <p>
                <%= filterLabel %>
            </p>

        </div>

    </div>


    <!-- =====================================================
         CATEGORY FILTER MODAL
    ====================================================== -->

    <div
        id="categoryFilterModal"
        hidden
    >

        <div
            id="categoryFilterOverlay"
        ></div>


        <div
            id="categoryFilterPopup"
            role="dialog"
            aria-modal="true"
            aria-labelledby="categoryFilterTitle"
        >

            <div
                id="categoryFilterHeader"
            >

                <h3
                    id="categoryFilterTitle"
                >
                    Product Categories
                </h3>


                <button
                    type="button"
                    id="closeCategoryFilter"
                    aria-label="Close category filter"
                >
                    <i class="fas fa-times"></i>
                </button>

            </div>


            <div
                id="categoryFilterOptions"
            >

                <!-- =========================================
                     ALL PRODUCTS
                ========================================== -->

                <button
                    type="button"
                    class="category-filter-option"
                    data-category-id=""
                    aria-selected="true"
                >
                    All Products
                </button>


                <!-- =========================================
                     CATEGORIES
                ========================================== -->

                <% productCategories.forEach(category => { %>

                    <button
                        type="button"
                        class="category-filter-option"
                        data-category-id="<%= category._id %>"
                        aria-selected="false"
                    >
                        <%= category.name %>
                    </button>

                <% }) %>

            </div>

        </div>

    </div>


    <!-- =====================================================
         PRODUCT TABLE
    ====================================================== -->

    <div class="sales-table-wrapper">

        <table class="sales-table">

            <thead>

                <tr>

                    <th>
                        #
                    </th>

                    <th>
                        Product Name
                    </th>

                    <th>
                        Items Available in Market
                    </th>

                    <th>
                        Items Available in Stock
                    </th>

                    <th>
                        Number of Sales
                    </th>

                </tr>

            </thead>


            <tbody id="productAnalyticsBody">

                <% if (
                    Array.isArray(productAnalytics) &&
                    productAnalytics.length
                ) { %>


                    <% productAnalytics.forEach((product, index) => { %>

                        <tr
                            class="sales-product-row"
                            data-category-id="<%= product.category && product.category._id ? product.category._id : '' %>"
                            tabindex="0"
                            data-href="<%= product.stockProductId ? '/stock/' + product.stockProductId + '/batches' : '/substations/product/' + product._id %>"
                        >

                            <td>
                                <%= index + 1 %>
                            </td>


                            <td>
                                <%= product.name %>
                            </td>


                            <td>

                                <% if (canEditMarketAvailable) { %>

                                    <form
                                        method="POST"
                                        action="/substations/productsUpdate/<%= selectedSubstationId %>"
                                    >

                                        <input
                                            type="hidden"
                                            name="productId"
                                            value="<%= product._id %>"
                                        >

                                        <input
                                            type="number"
                                            name="units"
                                            value="<%= product.marketAvailable || 0 %>"
                                            min="0"
                                        >

                                        <button
                                            type="submit"
                                        >
                                            <i class="fas fa-save"></i>
                                            Save
                                        </button>

                                    </form>

                                <% } else { %>

                                    <%= number(product.marketAvailable) %>

                                <% } %>

                            </td>


                            <td>
                                <%= number(product.stockAvailable) %>
                            </td>


                            <td>
                                <%= number(product.sales) %>
                            </td>

                        </tr>

                    <% }) %>


                <% } else { %>

                    <tr>

                        <td
                            colspan="5"
                            class="sales-empty"
                        >
                            No product analytics available.
                        </td>

                    </tr>

                <% } %>


                <!-- =========================================
                     CATEGORY FILTER EMPTY STATE
                ========================================== -->

                <tr
                    id="categoryFilterEmptyRow"
                    style="display: none;"
                >

                    <td
                        colspan="5"
                        class="sales-empty"
                    >
                        No products found in this category.
                    </td>

                </tr>

            </tbody>

        </table>

    </div>

</section>


<!-- =========================================================
     PRODUCT ANALYTICS JAVASCRIPT
========================================================== -->

<script>

(function () {

    const menuIcon =
        document.getElementById(
            "menuIcon"
        );

    const modal =
        document.getElementById(
            "categoryFilterModal"
        );

    const overlay =
        document.getElementById(
            "categoryFilterOverlay"
        );

    const closeButton =
        document.getElementById(
            "closeCategoryFilter"
        );

    const categoryOptions =
        document.querySelectorAll(
            ".category-filter-option"
        );

    const productRows =
        document.querySelectorAll(
            ".sales-product-row"
        );

    const emptyRow =
        document.getElementById(
            "categoryFilterEmptyRow"
        );


    if (!menuIcon || !modal) {
        return;
    }


    // =====================================================
    // OPEN MODAL
    // =====================================================

    function openCategoryFilter() {

        modal.hidden = false;

    }


    // =====================================================
    // CLOSE MODAL
    // =====================================================

    function closeCategoryFilter() {

        modal.hidden = true;

    }


    // =====================================================
    // FILTER PRODUCTS
    // =====================================================

    function filterProducts(categoryId) {

        let visibleCount = 0;


        productRows.forEach(function (row) {

            const rowCategoryId =
                row.getAttribute(
                    "data-category-id"
                ) || "";


            const showRow =
                !categoryId ||
                rowCategoryId === categoryId;


            row.style.display =
                showRow
                    ? ""
                    : "none";


            if (showRow) {

                visibleCount++;

            }

        });


        if (emptyRow) {

            emptyRow.style.display =
                visibleCount === 0
                    ? ""
                    : "none";

        }


        categoryOptions.forEach(
            function (option) {

                const optionCategoryId =
                    option.getAttribute(
                        "data-category-id"
                    ) || "";


                option.setAttribute(
                    "aria-selected",
                    optionCategoryId === categoryId
                        ? "true"
                        : "false"
                );

            }
        );

    }


    // =====================================================
    // MENU CLICK
    // =====================================================

    menuIcon.addEventListener(
        "click",
        openCategoryFilter
    );


    // =====================================================
    // MENU KEYBOARD
    // =====================================================

    menuIcon.addEventListener(
        "keydown",
        function (event) {

            if (
                event.key === "Enter" ||
                event.key === " "
            ) {

                event.preventDefault();

                openCategoryFilter();

            }

        }
    );


    // =====================================================
    // CLOSE BUTTON
    // =====================================================

    if (closeButton) {

        closeButton.addEventListener(
            "click",
            closeCategoryFilter
        );

    }


    // =====================================================
    // OVERLAY CLICK
    // =====================================================

    if (overlay) {

        overlay.addEventListener(
            "click",
            closeCategoryFilter
        );

    }


    // =====================================================
    // CATEGORY SELECTION
    // =====================================================

    categoryOptions.forEach(
        function (option) {

            option.addEventListener(
                "click",
                function () {

                    const categoryId =
                        option.getAttribute(
                            "data-category-id"
                        ) || "";


                    filterProducts(
                        categoryId
                    );


                    closeCategoryFilter();

                }
            );

        }
    );


    // =====================================================
    // ESCAPE KEY
    // =====================================================

    document.addEventListener(
        "keydown",
        function (event) {

            if (
                event.key === "Escape" &&
                !modal.hidden
            ) {

                closeCategoryFilter();

            }

        }
    );


    // =====================================================
    // PRODUCT ROW CLICK
    // PRESERVE EXISTING ROW BEHAVIOUR
    // =====================================================

    productRows.forEach(
        function (row) {

            row.addEventListener(
                "click",
                function (event) {

                    if (
                        event.target.closest(
                            "input, button, form, a"
                        )
                    ) {
                        return;
                    }


                    const href =
                        row.getAttribute(
                            "data-href"
                        );


                    if (href) {

                        window.location.href =
                            href;

                    }

                }
            );


            row.addEventListener(
                "keydown",
                function (event) {

                    if (
                        event.key !== "Enter" &&
                        event.key !== " "
                    ) {
                        return;
                    }


                    if (
                        event.target.closest(
                            "input, button, form, a"
                        )
                    ) {
                        return;
                    }


                    event.preventDefault();


                    const href =
                        row.getAttribute(
                            "data-href"
                        );


                    if (href) {

                        window.location.href =
                            href;

                    }

                }
            );

        }
    );


})();

</script>