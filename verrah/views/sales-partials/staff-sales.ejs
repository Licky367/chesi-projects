<!-- ==========================================================
     VERRAH COSMETICS
     STAFF SALES
========================================================== --><section class="sales-page"><!-- ======================================================
     PAGE HEADER
======================================================= -->

<div class="sales-header">

    <!-- ==================================================
         HEADER ICON
    =================================================== -->

    <div class="sales-header-icon">

        <i class="fa-solid fa-cash-register"></i>

    </div>


    <!-- ==================================================
         HEADER CONTENT
    =================================================== -->

    <div>

        <h1 class="sales-title">
            Staff Sales
        </h1>


        <!-- ==================================================
             FILTERED TOTAL
        =================================================== -->

        <p class="sales-subtitle">

            <% if (
                staffSalesFilter &&
                staffSalesFilter.period === "day"
            ) { %>

                Day:
                <strong>
                    KSh
                    <%= Number(
                        staffSalesTotals &&
                        staffSalesTotals.day || 0
                    ).toLocaleString("en-KE") %>
                </strong>

            <% } else if (
                staffSalesFilter &&
                staffSalesFilter.period === "year"
            ) { %>

                Year:
                <strong>
                    KSh
                    <%= Number(
                        staffSalesTotals &&
                        staffSalesTotals.year || 0
                    ).toLocaleString("en-KE") %>
                </strong>

            <% } else { %>

                Month:
                <strong>
                    KSh
                    <%= Number(
                        staffSalesTotals &&
                        staffSalesTotals.month || 0
                    ).toLocaleString("en-KE") %>
                </strong>

            <% } %>

        </p>

    </div>

</div>


<!-- ======================================================
     SALES CONTENT
======================================================= -->

<div class="sales-content">

    <section class="sales-panel">

        <div class="sales-section">

            <!-- ==================================================
                 SALES TABLE
            =================================================== -->

            <% if (staffSales && staffSales.length > 0) { %>

                <div class="sales-table-wrapper">

                    <table class="sales-table">

                        <thead>

                            <tr>

                                <th>
                                    Staff
                                </th>

                                <th>
                                    Items
                                </th>

                                <th>
                                    Total Amount
                                </th>

                                <th>
                                    Date
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            <% staffSales.forEach(function(sale) { %>

                                <tr>

                                    <!-- =================================
                                         STAFF WHO MADE THE SALE
                                    ================================== -->

                                    <td>

                                        <strong>

                                            <%= sale.soldBy
                                                ? (
                                                    sale.soldBy.name ||
                                                    sale.soldBy.fullName ||
                                                    sale.soldBy.username ||
                                                    "Unknown Staff"
                                                )
                                                : "Unknown Staff"
                                            %>

                                        </strong>

                                    </td>


                                    <!-- =================================
                                         PRODUCTS SOLD
                                    ================================== -->

                                    <td>

                                        <% if (
                                            sale.products &&
                                            sale.products.length
                                        ) { %>

                                            <div>

                                                <% sale.products.forEach(
                                                    function(product, index)
                                                { %>

                                                    <span>

                                                        <%= product.name || "Product" %>

                                                        ×

                                                        <%= product.qty || 0 %>

                                                    </span>


                                                    <% if (
                                                        index <
                                                        sale.products.length - 1
                                                    ) { %>

                                                        <span>, </span>

                                                    <% } %>

                                                <% }); %>

                                            </div>

                                        <% } else { %>

                                            <span class="sales-muted">
                                                No products
                                            </span>

                                        <% } %>

                                    </td>


                                    <!-- =================================
                                         TOTAL AMOUNT
                                    ================================== -->

                                    <td>

                                        <strong class="sales-arrears-value">

                                            KSh
                                            <%= Number(
                                                sale.totalAmount || 0
                                            ).toLocaleString("en-KE") %>

                                        </strong>

                                    </td>


                                    <!-- =================================
                                         SALE DATE
                                    ================================== -->

                                    <td>

                                        <% if (sale.createdAt) { %>

                                            <%= new Date(
                                                sale.createdAt
                                            ).toLocaleDateString(
                                                "en-KE",
                                                {
                                                    day: "2-digit",
                                                    month: "short",
                                                    year: "numeric"
                                                }
                                            ) %>

                                        <% } else { %>

                                            <span class="sales-muted">
                                                —
                                            </span>

                                        <% } %>

                                    </td>

                                </tr>

                            <% }); %>

                        </tbody>

                    </table>

                </div>

            <% } else %>


                <!-- ==================================================
                     EMPTY STATE
                =================================================== -->

                <div class="sales-table-wrapper">

                    <table class="sales-table">

                        <tbody>

                            <tr>

                                <td
                                    colspan="4"
                                    class="sales-empty"
                                >

                                    No staff sales have been recorded yet.

                                </td>

                            </tr>

                        </tbody>

                    </table>

                </div>

            <% } %>

        </div>

    </section>

</div>

</section>