<section class="verah-service-page"><div class="verah-service-detail-card">


    <!-- =================================================
         SERVICE IMAGE
    ================================================== -->

    <div class="verah-detail-image-box">

        <% if (service.image) { %>

            <img
                src="<%= service.image %>"
                alt="<%= service.name %>"
                class="verah-detail-image"
            >

        <% } else { %>

            <div class="verah-detail-image-placeholder">
                VERAH COSMETICS
            </div>

        <% } %>

    </div>


    <!-- =================================================
         DETAIL CONTENT
    ================================================== -->

    <div class="verah-detail-content">


        <!-- =============================================
             HEADER
        ============================================== -->

        <div class="verah-detail-header">

            <div>

                <span class="verah-service-page-label">
                    VERAH COSMETICS
                </span>

                <h1>
                    <%= service.name %>
                </h1>

            </div>


            <span
                class="verah-service-status <%= service.active
                    ? 'verah-status-active'
                    : 'verah-status-inactive'
                %>"
            >
                <%= service.active
                    ? "Active"
                    : "Inactive"
                %>
            </span>

        </div>


        <!-- =============================================
             DESCRIPTION
        ============================================== -->

        <div class="verah-detail-description-section">

            <h2>
                About this service
            </h2>

            <p class="verah-service-detail-description">
                <%= service.description %>
            </p>

        </div>


        <!-- =============================================
             SERVICE DETAILS
        ============================================== -->

        <div class="verah-detail-info-grid">


            <!-- PRICE -->

            <div class="verah-detail-info-card">

                <span class="verah-detail-info-label">
                    Price
                </span>

                <strong class="verah-detail-price">
                    KSh
                    <%= Number(
                        service.price
                    ).toLocaleString() %>
                </strong>

            </div>


            <!-- DURATION -->

            <div class="verah-detail-info-card">

                <span class="verah-detail-info-label">
                    Duration
                </span>

                <strong>
                    <%= service.duration || "Not specified" %>
                </strong>

            </div>


            <!-- STATUS -->

            <div class="verah-detail-info-card">

                <span class="verah-detail-info-label">
                    Status
                </span>

                <strong
                    class="<%= service.active
                        ? 'verah-status-active'
                        : 'verah-status-inactive'
                    %>"
                >
                    <%= service.active
                        ? "Available"
                        : "Unavailable"
                    %>
                </strong>

            </div>


        </div>


        <!-- =============================================
             BACK
        ============================================== -->

        <div class="verah-detail-actions">

            <a
                href="/"
                class="verah-secondary-button"
            >
                ← Back to Services
            </a>

        </div>


    </div>

</div>

</section>