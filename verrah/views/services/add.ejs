<section class="verah-service-page">

    <div class="verah-service-form-card">

        <div class="verah-service-page-header">

            <span class="verah-service-page-label">
                VERAH COSMETICS
            </span>

            <h1>Add Service</h1>

            <p>
                Add a service that will appear in the services section.
            </p>

        </div>


        <form
            action="/services/add"
            method="POST"
            class="verah-service-form"
        >

            <div class="verah-form-group">

                <label for="name">
                    Service Name
                </label>

                <input
                    type="text"
                    id="name"
                    name="name"
                    required
                >

            </div>


            <div class="verah-form-group">

                <label for="image">
                    Image URL
                </label>

                <input
                    type="url"
                    id="image"
                    name="image"
                    placeholder="https://example.com/image.jpg"
                >

            </div>


            <div class="verah-form-group">

                <label for="description">
                    Description
                </label>

                <textarea
                    id="description"
                    name="description"
                    rows="5"
                    required
                ></textarea>

            </div>


            <div class="verah-form-row">

                <div class="verah-form-group">

                    <label for="price">
                        Price
                    </label>

                    <input
                        type="number"
                        id="price"
                        name="price"
                        min="0"
                        step="0.01"
                        required
                    >

                </div>


                <div class="verah-form-group">

                    <label for="duration">
                        Duration
                    </label>

                    <input
                        type="text"
                        id="duration"
                        name="duration"
                        placeholder="e.g. 45 minutes"
                    >

                </div>

            </div>


            <div class="verah-form-group verah-checkbox-group">

                <label>

                    <input
                        type="checkbox"
                        name="active"
                        value="true"
                        checked
                    >

                    Active service

                </label>

            </div>


            <div class="verah-form-actions">

                <a
                    href="/"
                    class="verah-secondary-button"
                >
                    Cancel
                </a>

                <button
                    type="submit"
                    class="verah-primary-button"
                >
                    Save Service
                </button>

            </div>

        </form>

    </div>

</section>