<%
/* =========================================================
   VERAH COSMETICS — ADD / EDIT SERVICE
========================================================= */

const isEdit =
    typeof service !== "undefined" &&
    service &&
    service._id;

const serviceId =
    isEdit ? service._id : null;

const serviceName =
    isEdit
        ? (service.name || "")
        : (formData?.name || "");

const serviceImage =
    isEdit
        ? (service.image || "")
        : (formData?.image || "");

const serviceDescription =
    isEdit
        ? (service.description || "")
        : (formData?.description || "");

const servicePrice =
    isEdit
        ? (
            service.price !== undefined &&
            service.price !== null
                ? service.price
                : ""
          )
        : (formData?.price || "");

const serviceDuration =
    isEdit
        ? (service.duration || "")
        : (formData?.duration || "");

const serviceActive =
    isEdit
        ? service.active !== false
        : true;
%>


<section class="verah-service-page">

    <div class="verah-service-form-card">

        <div class="verah-service-page-header">

            <span class="verah-service-page-label">
                VERAH COSMETICS
            </span>


            <% if (isEdit) { %>

                <h1>
                    Edit Service
                </h1>

                <p>
                    Update the service details shown in the services section.
                </p>

            <% } else { %>

                <h1>
                    Add Service
                </h1>

                <p>
                    Add a service that will appear in the services section.
                </p>

            <% } %>

        </div>


        <form
            action="<%= isEdit
                ? `/services/add/${serviceId}`
                : `/services/add`
            %>"
            method="POST"
            class="verah-service-form"
        >


            <!-- =================================================
                 SERVICE NAME
            ================================================== -->

            <div class="verah-form-group">

                <label for="name">
                    Service Name
                </label>

                <input
                    type="text"
                    id="name"
                    name="name"
                    value="<%= serviceName %>"
                    required
                >

            </div>


            <!-- =================================================
                 IMAGE URL
            ================================================== -->

            <div class="verah-form-group">

                <label for="image">
                    Image URL
                </label>

                <input
                    type="url"
                    id="image"
                    name="image"
                    value="<%= serviceImage %>"
                    placeholder="https://example.com/image.jpg"
                >

                <% if (isEdit && serviceImage) { %>

                    <div class="verah-current-image">

                        <span>
                            Current Image
                        </span>

                        <img
                            src="<%= serviceImage %>"
                            alt="<%= serviceName %>"
                            loading="lazy"
                        >

                    </div>

                <% } %>

            </div>


            <!-- =================================================
                 DESCRIPTION
            ================================================== -->

            <div class="verah-form-group">

                <label for="description">
                    Description
                </label>

                <textarea
                    id="description"
                    name="description"
                    rows="5"
                    required
                ><%= serviceDescription %></textarea>

            </div>


            <!-- =================================================
                 PRICE + DURATION
            ================================================== -->

            <div class="verah-form-row">

                <div class="verah-form-group">

                    <label for="price">
                        Price
                    </label>

                    <input
                        type="number"
                        id="price"
                        name="price"
                        min="0"
                        step="0.01"
                        value="<%= servicePrice %>"
                        required
                    >

                </div>


                <div class="verah-form-group">

                    <label for="duration">
                        Duration
                    </label>

                    <input
                        type="text"
                        id="duration"
                        name="duration"
                        value="<%= serviceDuration %>"
                        placeholder="e.g. 45 minutes"
                    >

                </div>

            </div>


            <!-- =================================================
                 ACTIVE
            ================================================== -->

            <div class="verah-form-group verah-checkbox-group">

                <label>

                    <input
                        type="checkbox"
                        name="active"
                        value="true"
                        <%= serviceActive ? "checked" : "" %>
                    >

                    Active service

                </label>

            </div>


            <!-- =================================================
                 ACTIONS
            ================================================== -->

            <div class="verah-form-actions">

                <a
                    href="/"
                    class="verah-secondary-button"
                >
                    Cancel
                </a>


                <% if (isEdit) { %>

                    <button
                        type="submit"
                        class="verah-primary-button"
                    >
                        Save Changes
                    </button>

                <% } else { %>

                    <button
                        type="submit"
                        class="verah-primary-button"
                    >
                        Save Service
                    </button>

                <% } %>

            </div>

        </form>

    </div>

</section>