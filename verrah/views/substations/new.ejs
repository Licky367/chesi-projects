<section class="shop-page substations-page">

  <div class="product-back">
    <a href="/" class="secondary-btn">
      <i class="fas fa-arrow-left"></i>
      ⬅️Back
    </a>
  </div>


  <div class="form-card substation-form-card">

    <div class="form-heading">

      <div class="form-heading-icon">
        <i class="fas fa-bolt"></i>
      </div>

      <div>

        <span class="section-kicker">
          SUBSTATIONS
        </span>

        <h1 class="page-title">
          <%= typeof substation !== "undefined" && substation
            ? "Edit Substation"
            : "New Substation"
          %>
        </h1>

        <p class="page-subtitle">
          <%= typeof substation !== "undefined" && substation
            ? "Update the details of this substation."
            : "Add a new location where products can be allocated."
          %>
        </p>

      </div>

    </div>


    <!-- ======================================================
         ERROR
    ======================================================= -->

    <% if (typeof error !== "undefined" && error) { %>

      <div class="error" role="alert">

        <i class="fas fa-circle-exclamation"></i>

        <span>
          <%= error %>
        </span>

      </div>

    <% } %>


    <!-- ======================================================
         CREATE / EDIT FORM

         CREATE:
             POST /substations

         EDIT:
             POST /substations/branch/:id/edit

         multipart/form-data is required because the form
         supports image uploading.
    ======================================================= -->

    <form
      action="<%= typeof substation !== 'undefined' && substation
        ? '/substations/branch/' + substation._id + '/edit'
        : '/substations'
      %>"
      method="POST"
      enctype="multipart/form-data"
      class="substation-form"
    >


      <div class="form-grid">


        <!-- ==================================================
             SUBSTATION NAME
        =================================================== -->

        <div class="field">

          <label for="name">
            Substation name
          </label>

          <input
            id="name"
            name="name"
            value="<%= typeof substation !== 'undefined' && substation
              ? (substation.name || '')
              : (typeof old !== 'undefined' && old
                  ? (old.name || '')
                  : '')
            %>"
            placeholder="e.g. Nairobi Substation"
            required
            autocomplete="organization"
          >

        </div>


        <!-- ==================================================
             LOCATION
        =================================================== -->

        <div class="field">

          <label for="location">
            Location
          </label>

          <input
            id="location"
            name="location"
            value="<%= typeof substation !== 'undefined' && substation
              ? (substation.location || '')
              : (typeof old !== 'undefined' && old
                  ? (old.location || '')
                  : '')
            %>"
            placeholder="e.g. Nairobi CBD"
            autocomplete="street-address"
          >

        </div>


        <!-- ==================================================
             PHONE NUMBER
        =================================================== -->

        <div class="field">

          <label for="phoneNumber">
            Phone Number
          </label>

          <input
            id="phoneNumber"
            name="phoneNumber"
            type="tel"
            value="<%= typeof substation !== 'undefined' && substation
              ? (substation.phoneNumber || '')
              : (typeof old !== 'undefined' && old
                  ? (old.phoneNumber || '')
                  : '')
            %>"
            placeholder="e.g. 0712345678"
            autocomplete="tel"
          >

        </div>


        <!-- ==================================================
             DIRECTIONS
        =================================================== -->

        <div class="field">

          <label for="directions">
            Directions
          </label>

          <input
            id="directions"
            name="directions"
            value="<%= typeof substation !== 'undefined' && substation
              ? (substation.directions || '')
              : (typeof old !== 'undefined' && old
                  ? (old.directions || '')
                  : '')
            %>"
            placeholder="e.g. Near the main shopping centre"
          >

        </div>


        <!-- ==================================================
             GPS LOCATION
        =================================================== -->

        <div class="field full">

          <label>
            GPS Location
            <span class="field-optional">
              Optional
            </span>
          </label>


          <div class="gps-fields">

            <!-- LATITUDE -->

            <div class="gps-coordinate">

              <label for="latitude">
                Latitude
              </label>

              <input
                id="latitude"
                name="latitude"
                type="number"
                step="any"
                min="-90"
                max="90"
                value="<%= typeof substation !== 'undefined' &&
                          substation &&
                          substation.gps &&
                          substation.gps.latitude !== null &&
                          typeof substation.gps.latitude !== 'undefined'
                          ? substation.gps.latitude
                          : (typeof old !== 'undefined' && old &&
                             old.gps &&
                             old.gps.latitude !== null &&
                             typeof old.gps.latitude !== 'undefined'
                             ? old.gps.latitude
                             : '')
                %>"
                placeholder="Latitude"
              >

            </div>


            <!-- LONGITUDE -->

            <div class="gps-coordinate">

              <label for="longitude">
                Longitude
              </label>

              <input
                id="longitude"
                name="longitude"
                type="number"
                step="any"
                min="-180"
                max="180"
                value="<%= typeof substation !== 'undefined' &&
                          substation &&
                          substation.gps &&
                          substation.gps.longitude !== null &&
                          typeof substation.gps.longitude !== 'undefined'
                          ? substation.gps.longitude
                          : (typeof old !== 'undefined' && old &&
                             old.gps &&
                             old.gps.longitude !== null &&
                             typeof old.gps.longitude !== 'undefined'
                             ? old.gps.longitude
                             : '')
                %>"
                placeholder="Longitude"
              >

            </div>


            <!-- CURRENT LOCATION BUTTON -->

            <button
              type="button"
              class="secondary-btn gps-current-btn"
              id="use-current-location"
            >
              <i class="fas fa-location-crosshairs"></i>
              Use Current Location
            </button>

          </div>


          <small
            id="gps-status"
            class="field-help"
          >
            GPS is optional. You can enter the coordinates manually
            or use your current device location.
          </small>

        </div>


        <!-- ==================================================
             SUBSTATION ICON
        =================================================== -->

        <div class="field full">

          <label>
            Substation Icon
            <span class="field-optional">
              Optional
            </span>
          </label>


          <div class="icon-input-options">


            <!-- ==============================================
                 UPLOAD IMAGE
            =============================================== -->

            <div class="icon-option">

              <div class="icon-option-heading">

                <i class="fas fa-upload"></i>

                <strong>
                  Upload Image
                </strong>

              </div>

              <input
                type="file"
                id="substationIcon"
                name="substationIcon"
                accept="image/*"
              >

              <small class="field-help">
                Select an image from your device.
              </small>

            </div>


            <!-- ==============================================
                 IMAGE URL
            =============================================== -->

            <div class="icon-option">

              <div class="icon-option-heading">

                <i class="fas fa-link"></i>

                <strong>
                  Image URL
                </strong>

              </div>

              <input
                type="url"
                id="substationIconUrl"
                name="substationIconUrl"
                value="<%= typeof substation !== 'undefined' && substation
                  ? (
                      substation.substationIcon &&
                      /^https?:\/\//i.test(substation.substationIcon)
                        ? substation.substationIcon
                        : ''
                    )
                  : (
                      typeof old !== 'undefined' &&
                      old &&
                      old.substationIconUrl
                        ? old.substationIconUrl
                        : ''
                    )
                %>"
                placeholder="https://example.com/icon.jpg"
                autocomplete="url"
              >

              <small class="field-help">
                Paste the direct URL of the image.
              </small>

            </div>


          </div>


          <!-- ==============================================
               CURRENT ICON
          =============================================== -->

          <% if (
            typeof substation !== "undefined" &&
            substation &&
            substation.substationIcon
          ) { %>

            <div class="current-icon">

              <span class="current-icon-label">
                Current Icon
              </span>

              <img
                src="<%= substation.substationIcon %>"
                alt="<%= substation.name || 'Substation' %> icon"
                class="substation-icon-preview"
              >

            </div>

          <% } %>


          <small class="field-help">
            You can either upload an image or provide an image URL.
            If both are provided, the uploaded image should take
            priority.
          </small>

        </div>


        <!-- ==================================================
             DESCRIPTION
        =================================================== -->

        <div class="field full">

          <label for="description">
            Description
          </label>

          <textarea
            id="description"
            name="description"
            placeholder="Describe this substation or its location"
          ><%= typeof substation !== 'undefined' && substation
            ? (substation.description || '')
            : (typeof old !== 'undefined' && old
                ? (old.description || '')
                : '')
          %></textarea>

        </div>


      </div>


      <!-- ====================================================
           FORM ACTIONS
      ===================================================== -->

      <div class="form-actions">

        <% if (
          typeof substation !== "undefined" &&
          substation
        ) { %>

          <button
            type="submit"
            class="primary-btn"
          >
            <i class="fas fa-save"></i>
            Save Changes
          </button>

        <% } else { %>

          <button
            type="submit"
            class="primary-btn"
          >
            <i class="fas fa-plus"></i>
            Create Substation
          </button>

        <% } %>


        <a
          href="/"
          class="secondary-btn"
        >
          Cancel
        </a>

      </div>


    </form>

  </div>

</section>


<!-- ==========================================================
     GPS CURRENT LOCATION SCRIPT
=========================================================== -->

<script>

  document.addEventListener(
    "DOMContentLoaded",
    function () {

      const button =
        document.getElementById(
          "use-current-location"
        );

      const latitudeInput =
        document.getElementById(
          "latitude"
        );

      const longitudeInput =
        document.getElementById(
          "longitude"
        );

      const status =
        document.getElementById(
          "gps-status"
        );


      if (
        !button ||
        !latitudeInput ||
        !longitudeInput
      ) {
        return;
      }


      button.addEventListener(
        "click",
        function () {

          if (!navigator.geolocation) {

            status.textContent =
              "GPS is not supported by this browser.";

            return;
          }


          button.disabled = true;

          status.textContent =
            "Getting your current location...";


          navigator.geolocation.getCurrentPosition(

            function (position) {

              const latitude =
                position.coords.latitude;

              const longitude =
                position.coords.longitude;


              latitudeInput.value =
                latitude;

              longitudeInput.value =
                longitude;


              status.textContent =
                "Current location captured successfully.";


              button.disabled = false;

            },


            function (error) {

              button.disabled = false;


              switch (error.code) {

                case error.PERMISSION_DENIED:

                  status.textContent =
                    "Location permission was denied. Please allow location access.";

                  break;


                case error.POSITION_UNAVAILABLE:

                  status.textContent =
                    "Your current location could not be determined.";

                  break;


                case error.TIMEOUT:

                  status.textContent =
                    "Getting your location timed out. Please try again.";

                  break;


                default:

                  status.textContent =
                    "Unable to get your current location.";

              }

            },


            {
              enableHighAccuracy: true,
              timeout: 15000,
              maximumAge: 0
            }

          );

        }
      );

    }

  );

</script>