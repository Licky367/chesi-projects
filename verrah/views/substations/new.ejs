<section class="shop-page substations-page">

  <div class="product-back">
    <a href="/substations" class="secondary-btn">
      <i class="fas fa-arrow-left"></i>
      Substations
    </a>
  </div>

  <div class="form-card substation-form-card">

    <div class="form-heading">

      <div class="form-heading-icon">
        <i class="fas fa-bolt"></i>
      </div>

      <div>

        <span class="section-kicker">
          SUBSTATIONS
        </span>

        <h1 class="page-title">
          <%= typeof substation !== "undefined" && substation
            ? "Edit Substation"
            : "New Substation"
          %>
        </h1>

        <p class="page-subtitle">
          <%= typeof substation !== "undefined" && substation
            ? "Update the details of this substation."
            : "Add a new location where products can be allocated."
          %>
        </p>

      </div>

    </div>


    <!-- ======================================================
         ERROR
    ======================================================= -->

    <% if (typeof error !== "undefined" && error) { %>

      <div class="error" role="alert">

        <i class="fas fa-circle-exclamation"></i>

        <span>
          <%= error %>
        </span>

      </div>

    <% } %>


    <!-- ======================================================
         CREATE / EDIT FORM

         CREATE:
             POST /substations

         EDIT:
             POST /substations/branch/:id/edit
    ======================================================= -->

    <form
      action="<%= typeof substation !== 'undefined' && substation
        ? '/substations/branch/' + substation._id + '/edit'
        : '/substations'
      %>"
      method="POST"
      class="substation-form"
    >


      <div class="form-grid">


        <!-- ==================================================
             SUBSTATION NAME
        =================================================== -->

        <div class="field">

          <label for="name">
            Substation name
          </label>

          <input
            id="name"
            name="name"
            value="<%= typeof substation !== 'undefined' && substation
              ? (substation.name || '')
              : (typeof old !== 'undefined' && old
                  ? (old.name || '')
                  : '')
            %>"
            placeholder="e.g. Nairobi Substation"
            required
            autocomplete="organization"
          >

        </div>


        <!-- ==================================================
             LOCATION
        =================================================== -->

        <div class="field">

          <label for="location">
            Location
          </label>

          <input
            id="location"
            name="location"
            value="<%= typeof substation !== 'undefined' && substation
              ? (substation.location || '')
              : (typeof old !== 'undefined' && old
                  ? (old.location || '')
                  : '')
            %>"
            placeholder="e.g. Nairobi CBD"
            autocomplete="street-address"
          >

        </div>


        <!-- ==================================================
             DESCRIPTION
        =================================================== -->

        <div class="field full">

          <label for="description">
            Description
          </label>

          <textarea
            id="description"
            name="description"
            placeholder="Describe this substation or its location"
          ><%= typeof substation !== 'undefined' && substation
            ? (substation.description || '')
            : (typeof old !== 'undefined' && old
                ? (old.description || '')
                : '')
          %></textarea>

        </div>


      </div>


      <!-- ====================================================
           FORM ACTIONS
      ===================================================== -->

      <div class="form-actions">

        <% if (
          typeof substation !== "undefined" &&
          substation
        ) { %>

          <button
            type="submit"
            class="primary-btn"
          >
            <i class="fas fa-save"></i>
            Save Changes
          </button>

        <% } else { %>

          <button
            type="submit"
            class="primary-btn"
          >
            <i class="fas fa-plus"></i>
            Create Substation
          </button>

        <% } %>


        <a
          href="/substations"
          class="secondary-btn"
        >
          Cancel
        </a>

      </div>


    </form>

  </div>

</section>