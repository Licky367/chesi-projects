<!-- =========================================================
     VERRAH COSMETICS
     SCROLLABLE TABS + CARD PANELS
========================================================= -->

<section class="shop-page substations-page">

<div class="verrah-tabs-container">

    <!-- =====================================================
         SCROLLABLE TABS
    ====================================================== -->

    <div
        class="verrah-tabs"
        role="tablist"
        aria-label="Product information"
    >

        <!-- PRODUCT CARD TAB -->

        <button
            type="button"
            class="verrah-tab active"
            id="tab-product-card"
            role="tab"
            aria-selected="true"
            aria-controls="product-card"
            data-tab="product-card"
        >
            Product Card
        </button>


        <!-- SUBSTATION BALANCES TAB -->

        <button
            type="button"
            class="verrah-tab"
            id="tab-substation-balances"
            role="tab"
            aria-selected="false"
            aria-controls="substation-balances"
            data-tab="substation-balances"
        >
            Substation Balances
        </button>

    </div>


    <!-- =====================================================
         TAB CONTENT
    ====================================================== -->

    <div class="verrah-tab-content">

        <!-- =================================================
             PRODUCT CARD PANEL
        ================================================== -->

        <div
            class="verrah-tab-panel active"
            id="product-card"
            role="tabpanel"
            aria-labelledby="tab-product-card"
        >

            <%- include("substationProduct/product-card") %>

        </div>


        <!-- =================================================
             SUBSTATION BALANCES PANEL
        ================================================== -->

        <div
            class="verrah-tab-panel"
            id="substation-balances"
            role="tabpanel"
            aria-labelledby="tab-substation-balances"
            hidden
        >

            <%- include("substationProduct/substation-balances") %>

        </div>

    </div>

</div>

</section>


<!-- =========================================================
     TAB SWITCHING
========================================================= -->

<script>

(function () {

    "use strict";


    const tabs = document.querySelectorAll(
        ".verrah-tabs .verrah-tab"
    );

    const panels = document.querySelectorAll(
        ".verrah-tab-content .verrah-tab-panel"
    );


    /*
     * --------------------------------------------------------
     * SWITCH TAB
     * --------------------------------------------------------
     */

    function switchTab(tab) {

        if (!tab) {
            return;
        }


        const targetId = tab.dataset.tab;


        if (!targetId) {
            return;
        }


        /*
         * ----------------------------------------------------
         * UPDATE TABS
         * ----------------------------------------------------
         */

        tabs.forEach(function (item) {

            const isActive =
                item === tab;

            item.classList.toggle(
                "active",
                isActive
            );

            item.setAttribute(
                "aria-selected",
                isActive ? "true" : "false"
            );

            item.tabIndex =
                isActive ? 0 : -1;

        });


        /*
         * ----------------------------------------------------
         * UPDATE PANELS
         * ----------------------------------------------------
         */

        panels.forEach(function (panel) {

            const isActive =
                panel.id === targetId;

            panel.classList.toggle(
                "active",
                isActive
            );

            panel.hidden =
                !isActive;

        });


        /*
         * ----------------------------------------------------
         * KEEP SELECTED TAB VISIBLE
         * ----------------------------------------------------
         */

        tab.scrollIntoView({
            behavior: "smooth",
            block: "nearest",
            inline: "center"
        });

    }


    /*
     * --------------------------------------------------------
     * CLICK EVENTS
     * --------------------------------------------------------
     */

    tabs.forEach(function (tab) {

        tab.addEventListener(
            "click",
            function () {

                switchTab(this);

            }
        );

    });


    /*
     * --------------------------------------------------------
     * KEYBOARD NAVIGATION
     * --------------------------------------------------------
     *
     * ArrowLeft / ArrowRight:
     * Move between tabs.
     *
     * Home:
     * First tab.
     *
     * End:
     * Last tab.
     *
     */

    tabs.forEach(function (tab, index) {

        tab.addEventListener(
            "keydown",
            function (event) {

                let newIndex = index;


                if (event.key === "ArrowRight") {

                    newIndex =
                        (index + 1) % tabs.length;

                }


                else if (event.key === "ArrowLeft") {

                    newIndex =
                        (index - 1 + tabs.length)
                        % tabs.length;

                }


                else if (event.key === "Home") {

                    newIndex = 0;

                }


                else if (event.key === "End") {

                    newIndex =
                        tabs.length - 1;

                }


                else if (event.key === "Enter" ||
                         event.key === " ") {

                    event.preventDefault();

                    switchTab(this);

                    return;

                }


                else {

                    return;

                }


                event.preventDefault();


                const nextTab =
                    tabs[newIndex];


                switchTab(nextTab);

                nextTab.focus();

            }
        );

    });


    /*
     * --------------------------------------------------------
     * INITIAL STATE
     * --------------------------------------------------------
     */

    tabs.forEach(function (tab, index) {

        tab.tabIndex =
            index === 0 ? 0 : -1;

    });

    panels.forEach(function (panel) {

        panel.hidden =
            !panel.classList.contains("active");

    });

})();

</script>