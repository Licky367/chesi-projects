              <section class="shop-page substations-page">

  <div class="product-back">
    <a href="/substations" class="secondary-btn">
      <i class="fas fa-arrow-left"></i>
      Substations
    </a>
  </div>

  <% if (typeof error !== "undefined" && error) { %>
    <div class="error" role="alert">
      <i class="fas fa-circle-exclamation"></i>
      <span><%= error %></span>
    </div>
  <% } %>

  <% if (typeof success !== "undefined" && success) { %>
    <div class="notice" role="status">
      <i class="fas fa-circle-check"></i>
      <span><%= success %></span>
    </div>
  <% } %>

  <% if (!product) { %>

    <div class="empty-state-card">
      <div class="empty-icon">
        <i class="fas fa-box-open"></i>
      </div>

      <h2>Product not found</h2>

      <p>
        The requested product could not be found.
      </p>

      <a href="/substations" class="primary-btn">
        <i class="fas fa-arrow-left"></i>
        Back to Substations
      </a>
    </div>

  <% } else { %>

    <div class="detail-card substation-product-detail-card">

      <div class="detail-grid">

        <div class="detail-image">

          <% if (product.image) { %>

            <img
              src="<%= product.image %>"
              alt="<%= product.name %>"
              loading="lazy"
            >

          <% } else { %>

            <div class="placeholder">
              <i class="fas fa-box"></i>
            </div>

          <% } %>

        </div>

        <div class="detail-content">

          <span class="detail-category">
            <%= product.category || "Other" %>
          </span>

          <h1>
            <%= product.name || product.subcategory || "Product" %>
          </h1>

          <div class="detail-subcategory">
            <i class="fas fa-layer-group"></i>
            <%= product.subcategory || "Other" %>
          </div>

          <div class="detail-price">
            KSh <%= Number(product.unitSellPrice || 0).toLocaleString() %>
            <small>sell / unit</small>
          </div>

          <% if (product.description) { %>
            <div class="detail-description">
              <%= product.description %>
            </div>
          <% } %>

          <div class="stock-balance-box">
            <span>Total marketplace units</span>

            <strong>
              <%= Number(product.units || 0).toLocaleString() %>
            </strong>
          </div>

          <!-- =====================================================
               SUBSTATION BALANCES
          ====================================================== -->

          <div class="inventory-heading">
            <div>
              <span class="section-kicker">DISTRIBUTION</span>
              <h2>Substation Balances</h2>
            </div>
          </div>

          <% if (!product.substationStocks || !product.substationStocks.length) { %>

            <div class="empty-inline">
              <i class="fas fa-box-open"></i>
              <span>
                No substation allocation exists for this product.
              </span>
            </div>

          <% } else { %>

            <div class="sales-table-wrapper">

              <table class="sales-table">

                <thead>
                  <tr>
                    <th>#</th>
                    <th>Substation</th>
                    <th>Location</th>
                    <th>Units Available</th>

                    <% if (typeof role !== "undefined" && role === "admin") { %>
                      <th>Update</th>
                    <% } %>
                  </tr>
                </thead>

                <tbody>

                  <% product.substationStocks.forEach((item, index) => { %>

                    <tr class="sales-product-row">

                      <td>
                        <%= index + 1 %>
                      </td>

                      <td>
                        <strong>
                          <%= item.name %>
                        </strong>
                      </td>

                      <td>

                        <% if (item.location) { %>

                          <span>
                            <i class="fas fa-location-dot"></i>
                            <%= item.location %>
                          </span>

                        <% } else { %>

                          <span>—</span>

                        <% } %>

                      </td>

                      <td>
                        <strong>
                          <%= Number(item.units || 0).toLocaleString("en-KE") %>
                        </strong>
                      </td>

                      <% if (typeof role !== "undefined" && role === "admin") { %>

                        <td>

                          <form
                            method="POST"
                            action="/substations/product/<%= product._id %>"
                            class="inventory-update-form"
                          >

                            <input
                              type="hidden"
                              name="substationId"
                              value="<%= item._id %>"
                            >

                            <div class="field inventory-units-field">

                              <input
                                id="units-<%= item._id %>"
                                name="units"
                                type="number"
                                min="0"
                                step="1"
                                value="<%= Number(item.units || 0) %>"
                                required
                              >

                            </div>

                            <button
                              type="submit"
                              class="primary-btn"
                            >
                              <i class="fas fa-save"></i>
                              Save
                            </button>

                          </form>

                        </td>

                      <% } %>

                    </tr>

                  <% }); %>

                </tbody>

              </table>

            </div>

          <% } %>

        </div>

      </div>

    </div>

  <% } %>

</section>