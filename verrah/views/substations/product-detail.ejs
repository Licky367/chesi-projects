<%
function number(value) {
    return Number(value || 0).toLocaleString("en-KE");
}
%>

<section class="shop-page substations-page">

  <% if (typeof error !== "undefined" && error) { %>
    <div class="error" role="alert">
      <i class="fas fa-circle-exclamation"></i>
      <span><%= error %></span>
    </div>
  <% } %>

  <% if (typeof success !== "undefined" && success) { %>
    <div class="notice" role="status">
      <i class="fas fa-circle-check"></i>
      <span><%= success %></span>
    </div>
  <% } %>

  <% if (!product) { %>

    <div class="empty-state-card">

      <div class="empty-icon">
        <i class="fas fa-box-open"></i>
      </div>

      <h2>Product not found</h2>

      <p>
        The requested product could not be found.
      </p>

      <a href="/substations" class="primary-btn">
        <i class="fas fa-arrow-left"></i>
        Back to Substations
      </a>

    </div>

  <% } else { %>

    <div class="detail-card substation-product-detail-card">

      <div class="detail-grid">

        <!-- =====================================================
             PRODUCT IMAGE
        ====================================================== -->

        <div class="detail-image">

          <% if (product.image) { %>

            <img
              src="<%= product.image %>"
              alt="<%= product.name %>"
              loading="lazy"
            >

          <% } else { %>

            <div class="placeholder">
              <i class="fas fa-box"></i>
            </div>

          <% } %>

        </div>


        <!-- =====================================================
             PRODUCT DETAILS
        ====================================================== -->

        <div class="detail-content">

          <span class="detail-category">
            <%= product.category || "Other" %>
          </span>

          <h1>
            <%= product.name || product.subcategory || "Product" %>
          </h1>

          <div class="detail-subcategory">

            <i class="fas fa-layer-group"></i>

            <%= product.subcategory || "Other" %>

          </div>


          <!-- =================================================
               SELLING PRICE
          ================================================== -->

          <div class="detail-price">

            KSh <%= number(product.unitSellPrice) %>

            <small>
              sell / unit
            </small>

          </div>

      <!-- ==================================================
           ADMIN PRICE EDITOR
           ================================================== -->

      <% if (user && user.role === "admin") { %>

        <div class="admin-price-editor">

          <div class="admin-price-editor-title">

            <i class="fas fa-user-shield"></i>

            <strong>
              Admin: Edit Sell Price
            </strong>

          </div>


          <form
            action="/products/<%= product._id %>/update"
            method="POST"
            class="admin-price-form"
          >

            <input
              type="hidden"
              name="productId"
              value="<%= product._id %>"
            >


            <div class="admin-price-input-row">

              <div class="admin-price-input-group">

                <label for="unitSellPrice">
                  Sell Price (KSh)
                </label>

                <input
                  id="unitSellPrice"
                  name="unitSellPrice"
                  type="number"
                  min="0"
                  step="0.01"
                  value="<%= product.unitSellPrice || 0 %>"
                  required
                >

              </div>


              <button
                type="submit"
                class="primary-btn"
              >

                <i class="fas fa-save"></i>

                Update Price

              </button>

            </div>

          </form>

        </div>

      <% } %>


          <!-- =================================================
               DESCRIPTION
          ================================================== -->

          <% if (product.description) { %>

            <div class="detail-description">
              <%= product.description %>
            </div>

          <% } %>


          <!-- =================================================
               TOTAL MARKETPLACE STOCK
          ================================================== -->

          <div class="stock-balance-box">

            <span>
              Total marketplace units
            </span>

            <strong>
              <%= number(product.units) %>
            </strong>

          </div>
</section>


          <!-- =================================================
               SUBSTATION BALANCES
          ================================================== -->

          <div class="inventory-heading">

            <div>

              <span class="section-kicker">
                DISTRIBUTION
              </span>

              <h2>
                Substation Balances
              </h2>

            </div>

          </div>


          <% if (
            !product.substationStocks ||
            !product.substationStocks.length
          ) { %>

            <div class="empty-inline">

              <i class="fas fa-box-open"></i>

              <span>
                No substation allocation exists for this product.
              </span>

            </div>

          <% } else { %>


            <!-- =================================================
                 BALANCES TABLE
            ================================================== -->

            <div class="sales-table-wrapper">

              <table class="sales-table">

                <thead>

                  <tr>

                    <th>
                      #
                    </th>

                    <th>
                      Substation
                    </th>

                    <th>
                      Location
                    </th>

                    <th>
                      Units Available
                    </th>

                    <% if (
                      typeof role !== "undefined" &&
                      role === "admin"
                    ) { %>

                      <th>
                        Update
                      </th>

                    <% } %>

                  </tr>

                </thead>


                <tbody>

                  <% product.substationStocks.forEach(function(item, index) { %>

                    <tr class="sales-product-row">

                      <!-- =======================================
                           NUMBER
                      ======================================== -->

                      <td>
                        <%= index + 1 %>
                      </td>


                      <!-- =======================================
                           SUBSTATION NAME
                      ======================================== -->

                      <td>

                        <strong>
                          <%= item.name %>
                        </strong>

                      </td>


                      <!-- =======================================
                           LOCATION
                      ======================================== -->

                      <td>

                        <% if (item.location) { %>

                          <span>

                            <i class="fas fa-location-dot"></i>

                            <%= item.location %>

                          </span>

                        <% } else { %>

                          <span>
                            —
                          </span>

                        <% } %>

                      </td>


                      <!-- =======================================
                           AVAILABLE UNITS
                      ======================================== -->

                      <td>

                        <strong>
                          <%= number(item.units) %>
                        </strong>

                      </td>


                      <!-- =======================================
                           ADMIN UPDATE
                      ======================================== -->

                      <% if (
                        typeof role !== "undefined" &&
                        role === "admin"
                      ) { %>

                        <td>

                          <form
                            method="POST"
                            action="/substations/product/<%= product._id %>"
                            class="inventory-update-form"
                          >

                            <input
                              type="hidden"
                              name="substationId"
                              value="<%= item._id %>"
                            >


                            <div class="field inventory-units-field">

                              <input
                                id="units-<%= item._id %>"
                                name="units"
                                type="number"
                                min="0"
                                step="1"
                                value="<%= Number(item.units || 0) %>"
                                required
                              >

                            </div>


                            <button
                              type="submit"
                              class="primary-btn"
                            >

                              <i class="fas fa-save"></i>

                              Save

                            </button>

                          </form>

                        </td>

                      <% } %>

                    </tr>

                  <% }); %>

                </tbody>

              </table>

            </div>

          <% } %>

        </div>

      </div>

    </div>

  <% } %>