<%
/* =========================================================
SUBSTATION BALANCES
VERRAH COSMETICS
========================================================= */

function number(value) {
return Number(value || 0).toLocaleString("en-KE");
}

const isAdmin =
typeof user !== "undefined" &&
user &&
user.role === "admin";

/* =========================================================
ALL SUBSTATIONS
========================================================= */

const allSubstations =
typeof substations !== "undefined" &&
Array.isArray(substations)
? substations
: [];

/* =========================================================
PRODUCT SUBSTATION STOCK
========================================================= */

const substationStocks =
product &&
Array.isArray(product.substationStocks)
? product.substationStocks
: [];

/* =========================================================
CREATE BALANCE LOOKUP
========================================================= */

const balanceBySubstation = {};

substationStocks.forEach(function(item) {

if (!item) {
    return;
}

const id =
    item._id ||
    item.substationId;

if (!id) {
    return;
}

balanceBySubstation[String(id)] = item;

});

/* =========================================================
EMPTY STATE
========================================================= */

const hasSubstations =
allSubstations.length > 0;

%>

<section class="sales-page"><!-- =====================================================
     PAGE HEADER
====================================================== -->

<div class="sales-header">

    <h1>
        Substation Balances
    </h1>

    <p>
        Product units currently available at each substation.
    </p>

</div>


<!-- =====================================================
     SALES CONTENT
====================================================== -->

<div class="sales-content">

    <section class="sales-panel">

        <div class="sales-section">


            <% if (!hasSubstations) { %>


                <!-- =============================================
                     NO SUBSTATIONS
                ============================================== -->

                <div class="sales-table-wrapper">

                    <table class="sales-table">

                        <tbody>

                            <tr>

                                <td
                                    colspan="<%= isAdmin ? 6 : 4 %>"
                                    class="sales-empty"
                                >

                                    No substations exist.

                                </td>

                            </tr>

                        </tbody>

                    </table>

                </div>


            <% } else { %>


                <!-- =============================================
                     BALANCES TABLE
                ============================================== -->

                <div class="sales-table-wrapper">

                    <table class="sales-table">

                        <thead>

                            <tr>

                                <th>
                                    #
                                </th>

                                <th>
                                    Substation
                                </th>

                                <th>
                                    Location
                                </th>

                                <th>
                                    Available
                                </th>

                                <% if (isAdmin) { %>

                                    <th>
                                        Edit Units
                                    </th>

                                    <th>
                                        Save
                                    </th>

                                <% } %>

                            </tr>

                        </thead>


                        <tbody>

                            <% allSubstations.forEach(
                                function(substation, index)
                            { %>


                                <%
                                /*
                                 * Find this substation's existing
                                 * product balance.
                                 */
                                const substationId =
                                    String(
                                        substation._id
                                    );

                                const balance =
                                    balanceBySubstation[
                                        substationId
                                    ] || null;


                                /*
                                 * If there is no allocation record,
                                 * the balance is zero.
                                 */
                                const units =
                                    balance
                                        ? Number(balance.units || 0)
                                        : 0;
                                %>


                                <tr>


                                    <!-- =================================
                                         NUMBER
                                    ================================== -->

                                    <td>

                                        <strong>
                                            <%= index + 1 %>
                                        </strong>

                                    </td>


                                    <!-- =================================
                                         SUBSTATION
                                    ================================== -->

                                    <td>

                                        <strong>

                                            <%= substation.name ||
                                                "Unnamed Substation" %>

                                        </strong>

                                    </td>


                                    <!-- =================================
                                         LOCATION
                                    ================================== -->

                                    <td>

                                        <% if (substation.location) { %>

                                            <span>

                                                <i class="fas fa-location-dot"></i>

                                                <%= substation.location %>

                                            </span>

                                        <% } else { %>

                                            <span class="sales-muted">
                                                —
                                            </span>

                                        <% } %>

                                    </td>


                                    <!-- =================================
                                         AVAILABLE UNITS
                                    ================================== -->

                                    <td>

                                        <strong class="sales-arrears-value">

                                            <%= number(units) %>

                                        </strong>

                                    </td>


                                    <% if (isAdmin) { %>


                                        <!-- =================================
                                             UNITS INPUT
                                        ================================== -->

                                        <td>

                                            <form
                                                method="POST"
                                                action="/substations/product/<%= product._id %>"
                                                id="substation-update-<%= substation._id %>"
                                            >

                                                <input
                                                    type="hidden"
                                                    name="substationId"
                                                    value="<%= substation._id %>"
                                                >

                                                <input
                                                    id="sales-units-<%= substation._id %>"
                                                    name="units"
                                                    type="number"
                                                    min="0"
                                                    step="1"
                                                    value="<%= units %>"
                                                    required
                                                >

                                            </form>

                                        </td>


                                        <!-- =================================
                                             SAVE BUTTON
                                        ================================== -->

                                        <td>

                                            <button
                                                type="submit"
                                                form="substation-update-<%= substation._id %>"
                                                title="Save units"
                                            >

                                                <i class="fas fa-save"></i>

                                                <span>
                                                    Save
                                                </span>

                                            </button>

                                        </td>


                                    <% } %>


                                </tr>


                            <% }); %>

                        </tbody>

                    </table>

                </div>


            <% } %>


        </div>

    </section>

</div>

</section>