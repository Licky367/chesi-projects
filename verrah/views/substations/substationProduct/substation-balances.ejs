<%
/* =========================================================
   SUBSTATION BALANCES
   VERRAH COSMETICS
========================================================= */

function number(value) {
    return Number(value || 0).toLocaleString("en-KE");
}

const isAdmin =
    typeof user !== "undefined" &&
    user &&
    user.role === "admin";
%>


<div class="sales-section">


    <!-- =====================================================
         SECTION HEADING
    ====================================================== -->

    <div class="sales-section-heading">

        <div>

            <h2>
                Substation Balances
            </h2>

            <p>
                Product distribution across substations
            </p>

        </div>

    </div>


    <!-- =====================================================
         NO SUBSTATION ALLOCATIONS
    ====================================================== -->

    <% if (
        !product.substationStocks ||
        !product.substationStocks.length
    ) { %>

        <div class="sales-table-wrapper">

            <table class="sales-table">

                <tbody>

                    <tr>

                        <td
                            colspan="<%= isAdmin ? 5 : 4 %>"
                            class="sales-empty"
                        >

                            <i class="fas fa-box-open"></i>

                            No substation allocation exists
                            for this product.

                        </td>

                    </tr>

                </tbody>

            </table>

        </div>


    <% } else { %>


        <!-- =================================================
             BALANCES TABLE
        ================================================== -->

        <div class="sales-table-wrapper">

            <table class="sales-table">

                <thead>

                    <tr>

                        <th>
                            #
                        </th>

                        <th>
                            Substation
                        </th>

                        <th>
                            Location
                        </th>

                        <th>
                            Units Available
                        </th>

                        <% if (isAdmin) { %>

                            <th>
                                Update
                            </th>

                        <% } %>

                    </tr>

                </thead>


                <tbody>

                    <% product.substationStocks.forEach(function(item, index) { %>

                        <tr class="sales-product-row">


                            <!-- =================================
                                 NUMBER
                            ================================== -->

                            <td>
                                <%= index + 1 %>
                            </td>


                            <!-- =================================
                                 SUBSTATION
                            ================================== -->

                            <td>

                                <strong>
                                    <%= item.name || "Unnamed Substation" %>
                                </strong>

                            </td>


                            <!-- =================================
                                 LOCATION
                            ================================== -->

                            <td>

                                <% if (item.location) { %>

                                    <span>

                                        <i class="fas fa-location-dot"></i>

                                        <%= item.location %>

                                    </span>

                                <% } else { %>

                                    <span>
                                        —
                                    </span>

                                <% } %>

                            </td>


                            <!-- =================================
                                 UNITS AVAILABLE
                            ================================== -->

                            <td>

                                <strong>
                                    <%= number(item.units) %>
                                </strong>

                            </td>


                            <!-- =================================
                                 ADMIN UPDATE
                            ================================== -->

                            <% if (isAdmin) { %>

                                <td>

                                    <form
                                        method="POST"
                                        action="/substations/product/<%= product._id %>"
                                        class="inventory-update-form"
                                    >

                                        <input
                                            type="hidden"
                                            name="substationId"
                                            value="<%= item._id %>"
                                        >


                                        <div class="field inventory-units-field">

                                            <label
                                                for="units-<%= item._id %>"
                                                class="sr-only"
                                            >
                                                Units for
                                                <%= item.name || "substation" %>
                                            </label>

                                            <input
                                                id="units-<%= item._id %>"
                                                name="units"
                                                type="number"
                                                min="0"
                                                step="1"
                                                value="<%= Number(item.units || 0) %>"
                                                required
                                            >

                                        </div>


                                        <button
                                            type="submit"
                                            class="primary-btn"
                                        >

                                            <i class="fas fa-save"></i>

                                            Save

                                        </button>

                                    </form>

                                </td>

                            <% } %>


                        </tr>

                    <% }); %>

                </tbody>

            </table>

        </div>

    <% } %>


</div>