<%
/* =========================================================
   SUBSTATION BALANCES
   VERRAH COSMETICS
========================================================= */

function number(value) {
    return Number(value || 0).toLocaleString("en-KE");
}

const isAdmin =
    typeof user !== "undefined" &&
    user &&
    user.role === "admin";
%>


<div class="distribution-panel">


    <!-- =====================================================
         SECTION HEADER
    ====================================================== -->

    <div class="distribution-header">

        <div class="distribution-header-content">

            <span class="distribution-label">
                DISTRIBUTION
            </span>

            <h2 class="distribution-title">
                Substation Balances
            </h2>

            <p class="distribution-description">
                Product units currently available at each substation.
            </p>

        </div>

    </div>


    <!-- =====================================================
         EMPTY STATE
    ====================================================== -->

    <% if (
        !product.substationStocks ||
        !product.substationStocks.length
    ) { %>

        <div class="distribution-empty">

            <div class="distribution-empty-icon">

                <i class="fas fa-box-open"></i>

            </div>

            <span class="distribution-empty-text">
                No substation allocation exists for this product.
            </span>

        </div>


    <% } else { %>


        <!-- =================================================
             BALANCES TABLE
        ================================================== -->

        <div class="distribution-table-container">

            <table class="distribution-table">

                <thead>

                    <tr>

                        <th>
                            #
                        </th>

                        <th>
                            Substation
                        </th>

                        <th>
                            Location
                        </th>

                        <th>
                            Units Available
                        </th>

                        <% if (isAdmin) { %>

                            <th>
                                Update
                            </th>

                        <% } %>

                    </tr>

                </thead>


                <tbody>

                    <% product.substationStocks.forEach(function(item, index) { %>

                        <tr class="distribution-row">


                            <!-- =================================
                                 NUMBER
                            ================================== -->

                            <td class="distribution-index">
                                <%= index + 1 %>
                            </td>


                            <!-- =================================
                                 SUBSTATION
                            ================================== -->

                            <td class="distribution-substation">

                                <strong>
                                    <%= item.name || "Unnamed Substation" %>
                                </strong>

                            </td>


                            <!-- =================================
                                 LOCATION
                            ================================== -->

                            <td class="distribution-location">

                                <% if (item.location) { %>

                                    <span>

                                        <i class="fas fa-location-dot"></i>

                                        <%= item.location %>

                                    </span>

                                <% } else { %>

                                    <span>
                                        —
                                    </span>

                                <% } %>

                            </td>


                            <!-- =================================
                                 AVAILABLE UNITS
                            ================================== -->

                            <td class="distribution-quantity">

                                <strong>
                                    <%= number(item.units) %>
                                </strong>

                            </td>


                            <!-- =================================
                                 ADMIN UPDATE
                            ================================== -->

                            <% if (isAdmin) { %>

                                <td class="distribution-actions">

                                    <form
                                        method="POST"
                                        action="/substations/product/<%= product._id %>"
                                        class="distribution-update-form"
                                    >

                                        <input
                                            type="hidden"
                                            name="substationId"
                                            value="<%= item._id %>"
                                        >


                                        <div class="distribution-input-wrapper">

                                            <label
                                                for="distribution-units-<%= item._id %>"
                                                class="distribution-input-label"
                                            >
                                                Units
                                            </label>

                                            <input
                                                id="distribution-units-<%= item._id %>"
                                                name="units"
                                                type="number"
                                                min="0"
                                                step="1"
                                                value="<%= Number(item.units || 0) %>"
                                                class="distribution-units-input"
                                                required
                                            >

                                        </div>


                                        <button
                                            type="submit"
                                            class="distribution-save-button"
                                        >

                                            <i class="fas fa-save"></i>

                                            <span>
                                                Save
                                            </span>

                                        </button>

                                    </form>

                                </td>

                            <% } %>


                        </tr>

                    <% }); %>

                </tbody>

            </table>

        </div>

    <% } %>


</div>