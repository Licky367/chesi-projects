<%
/* =========================================================
   SUBSTATION BALANCES
   VERRAH COSMETICS
========================================================= */

function number(value) {
    return Number(value || 0).toLocaleString("en-KE");
}

const isAdmin =
    typeof user !== "undefined" &&
    user &&
    user.role === "admin";
%>


<section class="sales-page">


    <!-- =====================================================
         PAGE HEADER
    ====================================================== -->

    <div class="sales-header">

        <h1>
            Substation Balances
        </h1>

        <p>
            Product units currently available at each substation.
        </p>

    </div>


    <!-- =====================================================
         SALES CONTENT
    ====================================================== -->

    <div class="sales-content">

        <section class="sales-panel">

            <div class="sales-section">


                <% if (
                    !product.substationStocks ||
                    !product.substationStocks.length
                ) { %>


                    <!-- =============================================
                         EMPTY STATE
                    ============================================== -->

                    <div class="sales-table-wrapper">

                        <table class="sales-table">

                            <tbody>

                                <tr>

                                    <td
                                        colspan="<%= isAdmin ? 6 : 4 %>"
                                        class="sales-empty"
                                    >

                                        No substation allocation exists
                                        for this product.

                                    </td>

                                </tr>

                            </tbody>

                        </table>

                    </div>


                <% } else { %>


                    <!-- =============================================
                         BALANCES TABLE
                    ============================================== -->

                    <div class="sales-table-wrapper">

                        <table class="sales-table">

                            <thead>

                                <tr>

                                    <th>
                                        #
                                    </th>

                                    <th>
                                        Substation
                                    </th>

                                    <th>
                                        Location
                                    </th>

                                    <th>
                                        Available
                                    </th>

                                    <% if (isAdmin) { %>

                                        <th>
                                            Edit Units
                                        </th>

                                        <th>
                                            Save
                                        </th>

                                    <% } %>

                                </tr>

                            </thead>


                            <tbody>

                                <% product.substationStocks.forEach(
                                    function(item, index)
                                { %>


                                    <tr>


                                        <!-- =================================
                                             NUMBER
                                        ================================== -->

                                        <td>

                                            <strong>
                                                <%= index + 1 %>
                                            </strong>

                                        </td>


                                        <!-- =================================
                                             SUBSTATION
                                        ================================== -->

                                        <td>

                                            <strong>

                                                <%= item.name ||
                                                    "Unnamed Substation" %>

                                            </strong>

                                        </td>


                                        <!-- =================================
                                             LOCATION
                                        ================================== -->

                                        <td>

                                            <% if (item.location) { %>

                                                <span>

                                                    <i class="fas fa-location-dot"></i>

                                                    <%= item.location %>

                                                </span>

                                            <% } else { %>

                                                <span class="sales-muted">
                                                    —
                                                </span>

                                            <% } %>

                                        </td>


                                        <!-- =================================
                                             AVAILABLE UNITS
                                        ================================== -->

                                        <td>

                                            <strong class="sales-arrears-value">

                                                <%= number(item.units) %>

                                            </strong>

                                        </td>


                                        <% if (isAdmin) { %>


                                            <!-- =================================
                                                 UNITS INPUT
                                            ================================== -->

                                            <td>

                                                <form
                                                    method="POST"
                                                    action="/substations/product/<%= product._id %>"
                                                    id="substation-update-<%= item._id %>"
                                                >

                                                    <input
                                                        type="hidden"
                                                        name="substationId"
                                                        value="<%= item._id %>"
                                                    >

                                                    <input
                                                        id="sales-units-<%= item._id %>"
                                                        name="units"
                                                        type="number"
                                                        min="0"
                                                        step="1"
                                                        value="<%= Number(item.units || 0) %>"
                                                        required
                                                    >

                                                </form>

                                            </td>


                                            <!-- =================================
                                                 SAVE BUTTON
                                            ================================== -->

                                            <td>

                                                <button
                                                    type="submit"
                                                    form="substation-update-<%= item._id %>"
                                                    title="Save units"
                                                >

                                                    <i class="fas fa-save"></i>

                                                    <span>
                                                        Save
                                                    </span>

                                                </button>

                                            </td>


                                        <% } %>


                                    </tr>


                                <% }); %>

                            </tbody>

                        </table>

                    </div>


                <% } %>


            </div>

        </section>

    </div>

</section>