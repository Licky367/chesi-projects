<%
/* =========================================================
SUBSTATION BALANCES
VERRAH COSMETICS
========================================================= */

function number(value) {
return Number(value || 0).toLocaleString("en-KE");
}

const isAdmin =
typeof user !== "undefined" &&
user &&
user.role === "admin";

/* =========================================================
ALL SUBSTATIONS
========================================================= */

const allSubstations =
typeof substations !== "undefined" &&
Array.isArray(substations)
? substations
: [];

/* =========================================================
PRODUCT SUBSTATION STOCK
========================================================= */

const substationStocks =
product &&
Array.isArray(product.substationStocks)
? product.substationStocks
: [];

/* =========================================================
CREATE BALANCE LOOKUP
========================================================= */

const balanceBySubstation = {};

substationStocks.forEach(function(item) {

if (!item) {
    return;
}

const id =
    item._id ||
    item.substationId;

if (!id) {
    return;
}

balanceBySubstation[
    String(id)
] = item;

});

/* =========================================================
EMPTY STATE
========================================================= */

const hasSubstations =
allSubstations.length > 0;

%>

<section class="sales-page"><!-- =====================================================
     PAGE HEADER
====================================================== -->

<div class="sales-header">

    <h1>
        Substation Balances
    </h1>

    <p>
        Product units currently available at each substation.
    </p>

</div>


<!-- =====================================================
     SALES CONTENT
====================================================== -->

<div class="sales-content">

    <section class="sales-panel">

        <div class="sales-section">


            <% if (!hasSubstations) { %>


                <!-- =============================================
                     NO SUBSTATIONS
                ============================================== -->

                <div class="sales-table-wrapper">

                    <table class="sales-table">

                        <tbody>

                            <tr>

                                <td
                                    colspan="<%= isAdmin ? 5 : 4 %>"
                                    class="sales-empty"
                                >

                                    No substations exist.

                                </td>

                            </tr>

                        </tbody>

                    </table>

                </div>


            <% } else { %>


                <!-- =============================================
                     MULTI-SUBSTATION UPDATE FORM

                     One form controls the entire table.

                     The submitted structure is:

                     allocations[0][substationId]
                     allocations[0][units]

                     allocations[1][substationId]
                     allocations[1][units]

                     etc.
                ============================================== -->

                <form
                    method="POST"
                    action="/substations/product/<%= product._id %>"
                    id="substation-balances-form"
                >


                    <!-- =========================================
                         BALANCES TABLE
                    ========================================== -->

                    <div class="sales-table-wrapper">

                        <table class="sales-table">

                            <thead>

                                <tr>

                                    <th>
                                        #
                                    </th>

                                    <th>
                                        Substation
                                    </th>

                                    <th>
                                        Location
                                    </th>

                                    <th>
                                        Available
                                    </th>

                                    <% if (isAdmin) { %>

                                        <th>
                                            Edit Units
                                        </th>

                                    <% } %>

                                </tr>

                            </thead>


                            <tbody>


                                <% allSubstations.forEach(
                                    function(substation, index)
                                { %>


                                    <%
                                    /* =================================
                                       FIND CURRENT BALANCE
                                    ================================== */

                                    const substationId =
                                        String(
                                            substation._id
                                        );

                                    const balance =
                                        balanceBySubstation[
                                            substationId
                                        ] || null;


                                    /* =================================
                                       CURRENT UNITS
                                    ================================== */

                                    const units =
                                        balance
                                            ? Number(
                                                balance.units || 0
                                            )
                                            : 0;
                                    %>


                                    <tr>


                                        <!-- =============================
                                             NUMBER
                                        ============================== -->

                                        <td>

                                            <strong>
                                                <%= index + 1 %>
                                            </strong>

                                        </td>


                                        <!-- =============================
                                             SUBSTATION
                                        ============================== -->

                                        <td>

                                            <strong>

                                                <%= substation.name ||
                                                    "Unnamed Substation" %>

                                            </strong>

                                        </td>


                                        <!-- =============================
                                             LOCATION
                                        ============================== -->

                                        <td>

                                            <% if (
                                                substation.location
                                            ) { %>

                                                <span>

                                                    <i class="fas fa-location-dot"></i>

                                                    <%= substation.location %>

                                                </span>

                                            <% } else { %>

                                                <span class="sales-muted">
                                                    —
                                                </span>

                                            <% } %>

                                        </td>


                                        <!-- =============================
                                             CURRENT AVAILABLE
                                        ============================== -->

                                        <td>

                                            <strong
                                                class="sales-arrears-value"
                                            >

                                                <%= number(units) %>

                                            </strong>

                                        </td>


                                        <% if (isAdmin) { %>


                                            <!-- =============================
                                                 EDIT UNITS
                                            ============================== -->

                                            <td>

                                                <input
                                                    id="sales-units-<%= substation._id %>"
                                                    name="allocations[<%= index %>][units]"
                                                    type="number"
                                                    min="0"
                                                    step="1"
                                                    value="<%= units %>"
                                                    required
                                                >

                                                <input
                                                    type="hidden"
                                                    name="allocations[<%= index %>][substationId]"
                                                    value="<%= substation._id %>"
                                                >

                                            </td>


                                        <% } %>


                                    </tr>


                                <% }); %>


                            </tbody>

                        </table>

                    </div>


                    <% if (isAdmin) { %>


                        <!-- =============================================
                             SAVE ALL CHANGES
                        ============================================== -->

                        <div class="allocation-save-row">

                            <button
                                type="submit"
                                class="primary-btn"
                                id="save-all-substation-balances"
                            >

                                <i class="fas fa-save"></i>

                                Save All Changes

                            </button>

                        </div>


                    <% } %>


                </form>


            <% } %>


        </div>

    </section>

</div>

</section>