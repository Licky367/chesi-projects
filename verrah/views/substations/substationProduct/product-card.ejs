<%
function number(value) {
    return Number(value || 0).toLocaleString("en-KE");
}
%>

    <!-- =====================================================
         ERROR MESSAGE
    ====================================================== -->

    <% if (typeof error !== "undefined" && error) { %>

        <div class="error" role="alert">

            <i class="fas fa-circle-exclamation"></i>

            <span>
                <%= error %>
            </span>

        </div>

    <% } %>


    <!-- =====================================================
         SUCCESS MESSAGE
    ====================================================== -->

    <% if (typeof success !== "undefined" && success) { %>

        <div class="notice" role="status">

            <i class="fas fa-circle-check"></i>

            <span>
                <%= success %>
            </span>

        </div>

    <% } %>


    <!-- =====================================================
         PRODUCT NOT FOUND
    ====================================================== -->

    <% if (!product) { %>

        <div class="empty-state-card">

            <div class="empty-icon">
                <i class="fas fa-box-open"></i>
            </div>

            <h2>
                Product not found
            </h2>

            <p>
                The requested product could not be found.
            </p>

            <a
                href="/substations"
                class="primary-btn"
            >
                <i class="fas fa-arrow-left"></i>
                Back to Substations
            </a>

        </div>


    <% } else { %>


        <!-- =================================================
             PRODUCT DETAIL CARD
        ================================================== -->

        <div class="detail-card substation-product-detail-card">

            <div class="detail-grid">


                <!-- =============================================
                     PRODUCT IMAGE
                ============================================== -->

                <div class="detail-image">

                    <% if (product.image) { %>

                        <img
                            src="<%= product.image %>"
                            alt="<%= product.name || 'Product' %>"
                            loading="lazy"
                        >

                    <% } else { %>

                        <div
                            class="placeholder"
                            aria-label="No product image"
                        >
                            <i class="fas fa-box"></i>
                        </div>

                    <% } %>

                </div>


                <!-- =============================================
                     PRODUCT DETAILS
                ============================================== -->

                <div class="detail-content">


                    <!-- =========================================
                         CATEGORY
                    ========================================== -->

                    <span class="detail-category">
                        <%= product.category || "Other" %>
                    </span>


                    <!-- =========================================
                         PRODUCT NAME
                    ========================================== -->

                    <h1>
                        <%= product.name || product.subcategory || "Product" %>
                    </h1>


                    <!-- =========================================
                         SUBCATEGORY
                    ========================================== -->

                    <div class="detail-subcategory">

                        <i class="fas fa-layer-group"></i>

                        <%= product.subcategory || "Other" %>

                    </div>


                    <!-- =========================================
                         SELLING PRICE
                    ========================================== -->

                    <div class="detail-price">

                        KSh
                        <%= number(product.unitSellPrice) %>

                        <small>
                            sell / unit
                        </small>

                    </div>


                    <!-- =========================================
                         ADMIN PRICE EDITOR
                    ========================================== -->

                    <% if (
                        typeof user !== "undefined" &&
                        user &&
                        user.role === "admin"
                    ) { %>

                        <div class="admin-price-editor">

                            <div class="admin-price-editor-title">

                                <i class="fas fa-user-shield"></i>

                                <strong>
                                    Admin: Edit Sell Price
                                </strong>

                            </div>


                            <form
                                action="/products/<%= product._id %>/update"
                                method="POST"
                                class="admin-price-form"
                            >

                                <input
                                    type="hidden"
                                    name="productId"
                                    value="<%= product._id %>"
                                >


                                <div class="admin-price-input-row">


                                    <!-- =================================
                                         PRICE INPUT
                                    ================================== -->

                                    <div class="admin-price-input-group">

                                        <label for="unitSellPrice">
                                            Sell Price (KSh)
                                        </label>

                                        <input
                                            id="unitSellPrice"
                                            name="unitSellPrice"
                                            type="number"
                                            min="0"
                                            step="0.01"
                                            value="<%= product.unitSellPrice || 0 %>"
                                            required
                                        >

                                    </div>


                                    <!-- =================================
                                         UPDATE BUTTON
                                    ================================== -->

                                    <button
                                        type="submit"
                                        class="primary-btn"
                                    >

                                        <i class="fas fa-save"></i>

                                        Update Price

                                    </button>

                                </div>

                            </form>

                        </div>

                    <% } %>


                    <!-- =========================================
                         DESCRIPTION
                    ========================================== -->

                    <% if (product.description) { %>

                        <div class="detail-description">

                            <%= product.description %>

                        </div>

                    <% } %>


                    <!-- =========================================
                         TOTAL MARKETPLACE STOCK
                    ========================================== -->

                    <div class="stock-balance-box">

                        <span>
                            Total marketplace units
                        </span>

                        <strong>
                            <%= number(product.units) %>
                        </strong>

                    </div>


                </div>
                <!-- END detail-content -->


            </div>
            <!-- END detail-grid -->


        </div>
        <!-- END detail-card -->


    <% } %>

