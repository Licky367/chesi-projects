<%
/* =========================================================
   VERRAH COSMETICS
   CARTS PAGE
========================================================= */

/* =========================================================
   USER
========================================================= */

const pageUser =
    typeof user !== "undefined"
        ? user
        : (
            typeof req !== "undefined"
                ? req.user
                : null
        );

const userRole =
    String(pageUser?.role || "")
        .trim()
        .toLowerCase();

const isStaff =
    userRole === "staff";


/* =========================================================
   CART DATA
========================================================= */

const cartItems =
    Array.isArray(cart?.items)
        ? cart.items
        : [];

const hasItems =
    cartItems.length > 0;

const cartTotal =
    Number(cart?.total || 0);

const isMobile =
    cart?.isMobile !== false;


/* =========================================================
   PRODUCT ID
   Used for:
   /carts/:id
========================================================= */

let checkoutProductId = null;

if (cartItems.length > 0) {

    const firstItem =
        cartItems[0];

    if (firstItem?.product?._id) {

        checkoutProductId =
            firstItem.product._id;

    } else if (firstItem?.product) {

        checkoutProductId =
            firstItem.product;

    } else if (firstItem?.productId) {

        checkoutProductId =
            firstItem.productId;

    }
}
%>


<section class="shop-page cart-page">


    <!-- =====================================================
         PAGE HEADER
    ====================================================== -->

    <header class="cart-page-head">

        <div>

            <span class="cart-kicker">
                YOUR CART
            </span>

            <h1 class="page-title">
                Shopping Cart
            </h1>

            <p class="page-subtitle">
                Review your selected products before checkout.
            </p>

        </div>

    </header>


    <!-- =====================================================
         ALERTS
    ====================================================== -->

    <% if (
        typeof error !== "undefined" &&
        error
    ) { %>

        <div class="cart-alert cart-alert-error">
            <%= error %>
        </div>

    <% } %>


    <% if (
        typeof success !== "undefined" &&
        success
    ) { %>

        <div class="cart-alert cart-alert-success">
            <%= success %>
        </div>

    <% } %>


    <% if (hasItems) { %>


        <!-- =================================================
             CART ITEMS
        ================================================== -->

        <div class="cart-list">

            <% cartItems.forEach((item) => {

                const product =
                    item.product || {};

                const productId =
                    product._id ||
                    item.productId ||
                    "";

                const productName =
                    product.name ||
                    "Product";

                const productImage =
                    product.image ||
                    product.images?.[0] ||
                    "/images/default-product.png";

                const quantity =
                    Number(item.quantity || 1);

                const itemPrice =
                    Number(
                        item.price ||
                        product.price ||
                        0
                    );

                const itemTotal =
                    Number(
                        item.total ||
                        itemPrice * quantity
                    );

            %>


                <div class="cart-item-card">


                    <!-- =====================================
                         PRODUCT
                    ====================================== -->

                    <a
                        href="/products/<%= productId %>"
                        class="cart-item-link"
                    >

                        <div class="cart-item-image">

                            <img
                                src="<%= productImage %>"
                                alt="<%= productName %>"
                            >

                        </div>


                        <div class="cart-item-main">

                            <div class="cart-item-topline">

                                <span class="cart-item-label">
                                    PRODUCT
                                </span>

                                <span class="cart-item-arrow">
                                    <i class="fas fa-chevron-right"></i>
                                </span>

                            </div>


                            <h3>
                                <%= productName %>
                            </h3>


                            <div class="cart-item-meta">

                                <span>
                                    Quantity:
                                    <strong>
                                        <%= quantity %>
                                    </strong>
                                </span>

                            </div>


                            <div class="cart-item-total">

                                KSh
                                <%= itemTotal.toLocaleString() %>

                            </div>

                        </div>

                    </a>


                    <!-- =====================================
                         REMOVE
                    ====================================== -->

                    <form
                        action="/carts/remove/<%= productId %>"
                        method="POST"
                        class="cart-remove-form"
                    >

                        <button
                            type="submit"
                            class="cart-remove-btn"
                            aria-label="Remove product"
                        >

                            <i class="fas fa-trash"></i>

                        </button>

                    </form>

                </div>


            <% }); %>

        </div>


        <!-- =================================================
             CART SUMMARY
        ================================================== -->

        <aside class="cart-summary-card">

            <div class="cart-summary-head">

                <span class="cart-kicker">
                    SUMMARY
                </span>

                <h2>
                    Order Summary
                </h2>

            </div>


            <div class="cart-summary-row">

                <span>
                    Items
                </span>

                <strong>
                    <%= cartItems.length %>
                </strong>

            </div>


            <div class="cart-summary-row">

                <span>
                    Payment
                </span>

                <strong id="cart-payment-mode-label">
                    <%= isMobile ? "M-PESA" : "Cash" %>
                </strong>

            </div>


            <div class="cart-summary-row cart-summary-total">

                <span>
                    Total
                </span>

                <strong>
                    KSh
                    <%= cartTotal.toLocaleString() %>
                </strong>

            </div>


            <p class="cart-summary-note">

                <% if (isStaff) { %>

                    Select your payment method,
                    then continue with the appropriate
                    staff checkout.

                <% } else { %>

                    Continue to checkout to complete
                    your order.

                <% } %>

            </p>


            <!-- =================================================
                 STAFF CHECKOUT
            ================================================== -->

            <% if (isStaff) { %>


                <div class="staff-sale-form-group">

                    <label for="staff-payment-mode">
                        Payment Method
                    </label>


                    <div class="staff-sale-input-wrap">

                        <i class="fas fa-wallet"></i>

                        <select
                            id="staff-payment-mode"
                            class="checkout-substation-select"
                        >

                            <option
                                value="true"
                                <%= isMobile ? "selected" : "" %>
                            >
                                M-PESA
                            </option>

                            <option
                                value="false"
                                <%= !isMobile ? "selected" : "" %>
                            >
                                Cash
                            </option>

                        </select>

                    </div>

                </div>


                <!-- =============================================
                     STAFF MODAL TRIGGER
                ============================================== -->

                <button
                    type="button"
                    id="staff-sale-trigger"
                    class="staff-sale-trigger primary-btn"
                >

                    <i class="fas fa-cash-register"></i>

                    Continue to Checkout

                </button>


            <% } else { %>


                <!-- =================================================
                     NORMAL USER CHECKOUT
                ================================================== -->

                <% if (checkoutProductId) { %>

                    <a
                        href="/carts/<%= checkoutProductId %>"
                        class="cart-checkout-btn"
                    >

                        <i class="fas fa-shopping-cart"></i>

                        Checkout

                    </a>

                <% } %>

            <% } %>


            <!-- =================================================
                 CONTINUE SHOPPING
            ================================================== -->

            <div class="cart-summary-back">

                <a href="/products">

                    <i class="fas fa-arrow-left"></i>

                    Continue Shopping

                </a>

            </div>

        </aside>


        <!-- =====================================================
             STAFF SALE MODAL
        ====================================================== -->

        <% if (isStaff) { %>

            <div
                id="staff-sale-modal"
                class="staff-sale-modal"
                aria-hidden="true"
            >


                <!-- =================================================
                     MODAL OVERLAY
                ================================================== -->

                <div
                    class="staff-sale-modal-overlay"
                    data-staff-sale-close
                ></div>


                <!-- =================================================
                     MODAL CONTENT
                ================================================== -->

                <div
                    class="staff-sale-modal-content"
                    role="dialog"
                    aria-modal="true"
                    aria-labelledby="staff-sale-modal-title"
                >


                    <!-- =============================================
                         MODAL HEADER
                    ============================================== -->

                    <div class="staff-sale-modal-header">

                        <div class="staff-sale-modal-icon">

                            <i class="fas fa-receipt"></i>

                        </div>


                        <div>

                            <span class="staff-sale-modal-kicker">
                                STAFF CHECKOUT
                            </span>

                            <h2
                                id="staff-sale-modal-title"
                                class="staff-sale-modal-title"
                            >
                                Complete Sale
                            </h2>

                        </div>


                        <button
                            type="button"
                            class="staff-sale-modal-close"
                            data-staff-sale-close
                            aria-label="Close"
                        >

                            <i class="fas fa-times"></i>

                        </button>

                    </div>


                    <!-- =============================================
                         MODAL BODY
                    ============================================== -->

                    <div class="staff-sale-modal-body">


                        <p class="staff-sale-modal-description">

                            Confirm the sale details before
                            continuing to checkout.

                        </p>


                        <form
                            id="staff-sale-form"
                            class="staff-sale-form"
                            method="POST"
                            action=""
                        >


                            <!-- =====================================
                                 SALE SUMMARY
                            ====================================== -->

                            <div class="staff-sale-summary">

                                <div class="staff-sale-preview">


                                    <!-- PAYMENT -->

                                    <div class="staff-sale-preview-card">

                                        <span class="staff-sale-preview-label">
                                            PAYMENT METHOD
                                        </span>

                                        <strong
                                            id="staff-payment-preview"
                                            class="staff-sale-preview-value"
                                        >
                                            <%= isMobile ? "M-PESA" : "Cash" %>
                                        </strong>

                                    </div>


                                    <!-- TOTAL -->

                                    <div class="staff-sale-preview-card">

                                        <span class="staff-sale-preview-label">
                                            TOTAL
                                        </span>

                                        <strong
                                            class="staff-sale-preview-value sale-total"
                                        >
                                            KSh
                                            <%= cartTotal.toLocaleString() %>
                                        </strong>

                                    </div>

                                </div>


                                <div class="staff-sale-preview-row">

                                    <span>
                                        Items
                                    </span>

                                    <strong>
                                        <%= cartItems.length %>
                                    </strong>

                                </div>

                            </div>


                            <!-- =====================================
                                 MODAL ACTIONS
                            ====================================== -->

                            <div class="staff-sale-modal-actions">


                                <button
                                    type="button"
                                    class="staff-sale-submit"
                                    data-staff-sale-close
                                >

                                    Cancel

                                </button>


                                <button
                                    type="submit"
                                    class="staff-sale-submit-btn"
                                >

                                    <i class="fas fa-check"></i>

                                    Continue

                                </button>


                            </div>


                        </form>

                    </div>


                    <!-- =============================================
                         MODAL FOOTER
                    ============================================== -->

                    <div class="staff-sale-modal-footer">

                        <p class="staff-sale-modal-note">

                            Your selected payment method will
                            determine the checkout process.

                        </p>

                    </div>


                </div>

            </div>

        <% } %>


    <% } else { %>


        <!-- =====================================================
             EMPTY CART
        ====================================================== -->

        <div class="cart-empty">

            <div class="cart-empty-icon">

                <i class="fas fa-shopping-bag"></i>

            </div>


            <h2>
                Your cart is empty
            </h2>


            <p>
                You haven't added any products yet.
            </p>


            <a
                href="/products"
                class="primary-btn"
            >

                <i class="fas fa-store"></i>

                Browse Products

            </a>

        </div>


    <% } %>

</section>


<% if (isStaff && hasItems) { %>

<script>
(function () {

    "use strict";


    /* =====================================================
       ELEMENTS
    ====================================================== */

    const modal =
        document.getElementById(
            "staff-sale-modal"
        );

    const trigger =
        document.getElementById(
            "staff-sale-trigger"
        );

    const form =
        document.getElementById(
            "staff-sale-form"
        );

    const paymentSelect =
        document.getElementById(
            "staff-payment-mode"
        );

    const paymentPreview =
        document.getElementById(
            "staff-payment-preview"
        );

    const paymentLabel =
        document.getElementById(
            "cart-payment-mode-label"
        );


    /* =====================================================
       ROUTES
    ====================================================== */

    /*
     * M-PESA:
     * /carts/:id
     */

    const CART_CHECKOUT_ACTION =
        "/carts/<%= checkoutProductId %>";


    /*
     * CASH:
     * /carts/staff-sale
     */

    const STAFF_CASH_ACTION =
        "/carts/staff-sale";


    /*
     * Background payment-mode update.
     */

    const PAYMENT_MODE_ACTION =
        "/carts/payment-mode";


    /* =====================================================
       CURRENT PAYMENT MODE
    ====================================================== */

    let currentIsMobile =
        <%= isMobile ? "true" : "false" %>;


    /* =====================================================
       UPDATE FORM ACTION
    ====================================================== */

    function updateFormAction() {

        if (!form) {
            return;
        }


        /*
         * M-PESA
         * Goes to:
         *
         * /carts/:id
         */

        if (currentIsMobile) {

            form.action =
                CART_CHECKOUT_ACTION;

        }


        /*
         * CASH
         * Goes to:
         *
         * /carts/staff-sale
         */

        else {

            form.action =
                STAFF_CASH_ACTION;

        }

    }


    /* =====================================================
       UPDATE PAYMENT DISPLAY
    ====================================================== */

    function updatePaymentDisplay() {

        const text =
            currentIsMobile
                ? "M-PESA"
                : "Cash";


        if (paymentPreview) {

            paymentPreview.textContent =
                text;

        }


        if (paymentLabel) {

            paymentLabel.textContent =
                text;

        }

    }


    /* =====================================================
       SAVE PAYMENT MODE
    ====================================================== */

    async function savePaymentMode(
        newIsMobile
    ) {

        try {

            const response =
                await fetch(
                    PAYMENT_MODE_ACTION,
                    {
                        method: "POST",

                        headers: {
                            "Content-Type":
                                "application/x-www-form-urlencoded; charset=UTF-8",

                            "X-Requested-With":
                                "XMLHttpRequest"
                        },

                        body:
                            new URLSearchParams({
                                isMobile:
                                    String(
                                        newIsMobile
                                    )
                            })
                    }
                );


            const data =
                await response.json();


            if (
                !response.ok ||
                !data.ok
            ) {

                throw new Error(
                    data?.error ||
                    "Unable to update payment mode."
                );

            }


            /*
             * Use the value returned
             * by the server.
             */

            currentIsMobile =
                Boolean(
                    data.isMobile
                );


            updatePaymentDisplay();

            updateFormAction();


        } catch (error) {

            console.error(
                "Payment mode update error:",
                error
            );


            /*
             * Restore the saved value
             * if the request fails.
             */

            currentIsMobile =
                !newIsMobile;


            if (paymentSelect) {

                paymentSelect.value =
                    String(
                        currentIsMobile
                    );

            }


            updatePaymentDisplay();

            updateFormAction();


            alert(
                error?.message ||
                "Unable to update payment mode."
            );

        }

    }


    /* =====================================================
       PAYMENT MODE CHANGE
    ====================================================== */

    if (paymentSelect) {

        paymentSelect.addEventListener(
            "change",
            async function () {

                const newIsMobile =
                    this.value === "true";


                /*
                 * Update the interface immediately.
                 */

                currentIsMobile =
                    newIsMobile;

                updatePaymentDisplay();
                updateFormAction();


                /*
                 * Save the change in the cart.
                 */

                await savePaymentMode(
                    newIsMobile
                );

            }
        );

    }


    /* =====================================================
       OPEN MODAL
    ====================================================== */

    function openModal() {

        if (!modal) {
            return;
        }


        updatePaymentDisplay();

        updateFormAction();


        modal.classList.add(
            "is-open"
        );


        modal.setAttribute(
            "aria-hidden",
            "false"
        );


        document.body.classList.add(
            "staff-sale-modal-open"
        );

    }


    /* =====================================================
       CLOSE MODAL
    ====================================================== */

    function closeModal() {

        if (!modal) {
            return;
        }


        modal.classList.remove(
            "is-open"
        );


        modal.setAttribute(
            "aria-hidden",
            "true"
        );


        document.body.classList.remove(
            "staff-sale-modal-open"
        );

    }


    /* =====================================================
       OPEN STAFF SALE MODAL
    ====================================================== */

    if (trigger) {

        trigger.addEventListener(
            "click",
            function () {

                openModal();

            }
        );

    }


    /* =====================================================
       CLOSE MODAL
    ====================================================== */

    document
        .querySelectorAll(
            "[data-staff-sale-close]"
        )
        .forEach(
            function (element) {

                element.addEventListener(
                    "click",
                    function () {

                        closeModal();

                    }
                );

            }
        );


    /* =====================================================
       ESCAPE KEY
    ====================================================== */

    document.addEventListener(
        "keydown",
        function (event) {

            if (
                event.key === "Escape" &&
                modal &&
                modal.classList.contains(
                    "is-open"
                )
            ) {

                closeModal();

            }

        }
    );


    /* =====================================================
       FINAL FORM ACTION
    ====================================================== */

    if (form) {

        form.addEventListener(
            "submit",
            function () {

                /*
                 * M-PESA:
                 * /carts/:id
                 */

                if (currentIsMobile) {

                    form.action =
                        CART_CHECKOUT_ACTION;

                }


                /*
                 * CASH:
                 * /carts/staff-sale
                 */

                else {

                    form.action =
                        STAFF_CASH_ACTION;

                }

            }
        );

    }


    /* =====================================================
       INITIAL STATE
    ====================================================== */

    updatePaymentDisplay();

    updateFormAction();


})();
</script>

<% } %>