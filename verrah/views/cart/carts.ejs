<%
/* =========================================================
   VERRAH COSMETICS
   CART PAGE
   ========================================================= */

const pageUser =
    (typeof user !== "undefined" && user)
        ? user
        : (
            typeof currentUser !== "undefined"
                ? currentUser
                : null
        );

const userRole =
    pageUser && pageUser.role
        ? String(pageUser.role).toLowerCase()
        : "";

const isStaff =
    userRole === "staff";

const cartItems =
    cart &&
    Array.isArray(cart.items)
        ? cart.items
        : [];

const hasItems =
    cartItems.length > 0;

const cartTotal =
    cart && typeof cart.total === "number"
        ? cart.total
        : (
            typeof total === "number"
                ? total
                : 0
        );

const checkoutProductId =
    hasItems && cartItems[0].product
        ? (
            cartItems[0].product._id ||
            cartItems[0].product.id ||
            cartItems[0].product
        )
        : null;
%>


<section class="shop-page cart-page">

    <!-- =====================================================
         PAGE HEADER
    ====================================================== -->

    <header class="cart-page-head">

        <div>

            <span class="cart-kicker">
                SHOPPING CART
            </span>

            <h1 class="page-title">
                Your Cart
            </h1>

            <p class="page-subtitle">
                Review your selected products before checkout.
            </p>

        </div>

    </header>


    <!-- =====================================================
         ERROR
    ====================================================== -->

    <% if (typeof error !== "undefined" && error) { %>

        <div class="cart-alert cart-alert-error">

            <i class="fas fa-circle-exclamation"></i>

            <span>
                <%= error %>
            </span>

        </div>

    <% } %>


    <% if (!hasItems) { %>

        <!-- =================================================
             EMPTY CART
        ================================================== -->

        <div class="cart-summary-card">

            <div class="cart-summary-head">

                <i class="fas fa-shopping-cart"></i>

                <div>

                    <h2>
                        Your cart is empty
                    </h2>

                    <p>
                        Add products to your cart before checking out.
                    </p>

                </div>

            </div>


            <div class="cart-summary-back">

                <a
                    href="/products"
                    class="secondary-btn"
                >
                    <i class="fas fa-arrow-left"></i>
                    Continue Shopping
                </a>

            </div>

        </div>


    <% } else { %>


        <!-- =================================================
             CART ITEMS
        ================================================== -->

        <div class="cart-list">

            <% cartItems.forEach(function(item) {

                const product =
                    item.product || {};

                const productId =
                    product._id ||
                    product.id ||
                    "";

                const productName =
                    product.name ||
                    "Product";

                const quantity =
                    Number(item.quantity || 1);

                const itemTotal =
                    Number(
                        item.total ||
                        (
                            Number(item.price || 0) *
                            quantity
                        )
                    );

                const productImage =
                    product.image ||
                    (
                        Array.isArray(product.images) &&
                        product.images.length
                            ? product.images[0]
                            : ""
                    );

            %>

                <article class="cart-item-card">

                    <!-- =====================================
                         PRODUCT
                    ====================================== -->

                    <a
                        href="/products/<%= productId %>"
                        class="cart-item-link"
                    >

                        <% if (productImage) { %>

                            <div class="cart-item-image">

                                <img
                                    src="<%= productImage %>"
                                    alt="<%= productName %>"
                                >

                            </div>

                        <% } %>


                        <div class="cart-item-main">

                            <div class="cart-item-topline">

                                <span class="cart-item-label">
                                    PRODUCT
                                </span>

                                <i class="fas fa-chevron-right cart-item-arrow"></i>

                            </div>


                            <h3>
                                <%= productName %>
                            </h3>


                            <div class="cart-item-meta">

                                <span>
                                    Quantity:
                                    <strong>
                                        <%= quantity %>
                                    </strong>
                                </span>

                            </div>


                            <div class="cart-item-total">

                                KSh
                                <%= itemTotal.toLocaleString() %>

                            </div>

                        </div>

                    </a>


                    <!-- =====================================
                         REMOVE
                    ====================================== -->

                    <form
                        action="/carts/<%= productId %>/remove"
                        method="POST"
                        class="cart-remove-form"
                    >

                        <button
                            type="submit"
                            class="cart-remove-btn"
                            title="Remove from cart"
                        >

                            <i class="fas fa-trash"></i>

                        </button>

                    </form>

                </article>

            <% }); %>

        </div>


        <!-- =================================================
             CART SUMMARY
        ================================================== -->

        <div class="cart-summary-card">

            <div class="cart-summary-head">

                <div>

                    <span class="cart-kicker">
                        ORDER SUMMARY
                    </span>

                    <h2>
                        Checkout
                    </h2>

                </div>

            </div>


            <div class="cart-summary-row">

                <span>
                    Items
                </span>

                <strong>
                    <%= cartItems.length %>
                </strong>

            </div>


            <div class="cart-summary-row cart-summary-total">

                <span>
                    Total
                </span>

                <strong>
                    KSh <%= Number(cartTotal).toLocaleString() %>
                </strong>

            </div>


            <p class="cart-summary-note">

                <% if (isStaff) { %>

                    Choose how this sale will be paid.

                <% } else { %>

                    Continue to checkout to select your pickup
                    substation and payment method.

                <% } %>

            </p>


            <!-- =================================================
                 STAFF CHECKOUT
            ================================================== -->

            <% if (isStaff && checkoutProductId) { %>

                <button
                    type="button"
                    class="staff-sale-trigger primary-btn"
                    id="openStaffSalesNameModal"
                >

                    <i class="fas fa-cash-register"></i>

                    Continue to Checkout

                </button>


                <!-- =============================================
                     STAFF CHECKOUT MODAL
                     THIS MODAL IS ON /CARTS
                ============================================== -->

                <div
                    class="staff-sale-modal"
                    id="staffCheckoutModal"
                    aria-hidden="true"
                >

                    <div
                        class="staff-sale-modal-overlay"
                        id="staffCheckoutOverlay"
                    ></div>


                    <div
                        class="staff-sale-modal-content"
                        role="dialog"
                        aria-modal="true"
                        aria-labelledby="staffCheckoutTitle"
                    >

                        <!-- =================================
                             HEADER
                        ================================== -->

                        <div class="staff-sale-modal-header">

                            <div class="staff-sale-modal-icon">

                                <i class="fas fa-cash-register"></i>

                            </div>


                            <div>

                                <span class="staff-sale-modal-kicker">
                                    STAFF CHECKOUT
                                </span>

                                <h2
                                    class="staff-sale-modal-title"
                                    id="staffCheckoutTitle"
                                >
                                    Complete Sale
                                </h2>

                            </div>


                            <button
                                type="button"
                                class="staff-sale-modal-close"
                                id="closeStaffCheckoutModal"
                                aria-label="Close"
                            >

                                <i class="fas fa-times"></i>

                            </button>

                        </div>


                        <!-- =================================
                             BODY
                        ================================== -->

                        <div class="staff-sale-modal-body">

                            <p class="staff-sale-modal-description">

                                Select the payment method for this sale.

                            </p>


                            <form
                                class="staff-sale-form"
                                id="staffCheckoutForm"
                            >

                                <!-- =================================
                                     SALES NAME
                                ================================== -->

                                <div class="staff-sale-form-group">

                                    <label
                                        for="staffSalesName"
                                        class="staff-sale-field"
                                    >
                                        Sales Name
                                    </label>


                                    <div class="staff-sale-input-wrap">

                                        <i class="fas fa-user"></i>

                                        <input
                                            type="text"
                                            id="staffSalesName"
                                            name="salesName"
                                            placeholder="Enter sales name"
                                            autocomplete="off"
                                            required
                                        >

                                    </div>

                                </div>


                                <!-- =================================
                                     PAYMENT METHOD
                                ================================== -->

                                <div class="staff-sale-form-group">

                                    <label class="staff-sale-field">
                                        Payment Method
                                    </label>


                                    <label
                                        class="payment-choice"
                                        for="staffPaymentMpesa"
                                    >

                                        <input
                                            type="radio"
                                            name="staffPaymentMethod"
                                            id="staffPaymentMpesa"
                                            value="mpesa"
                                        >

                                        <span>

                                            <strong>
                                                Pay now with M-Pesa
                                            </strong>

                                            <small>
                                                An STK Push will be sent
                                                to the customer's phone.
                                            </small>

                                        </span>

                                    </label>


                                    <label
                                        class="payment-choice"
                                        for="staffPaymentDelivery"
                                    >

                                        <input
                                            type="radio"
                                            name="staffPaymentMethod"
                                            id="staffPaymentDelivery"
                                            value="pay_on_delivery"
                                        >

                                        <span>

                                            <strong>
                                                Pay upon delivery
                                            </strong>

                                            <small>
                                                The package will be created
                                                immediately.
                                            </small>

                                        </span>

                                    </label>

                                </div>


                                <!-- =================================
                                     M-PESA PHONE
                                ================================== -->

                                <div
                                    class="staff-sale-form-group phone-field"
                                    id="staffPhoneField"
                                    style="display:none;"
                                >

                                    <label
                                        for="staffPhoneNumber"
                                        class="staff-sale-field"
                                    >
                                        M-Pesa Phone Number
                                    </label>


                                    <div class="staff-sale-input-wrap">

                                        <i class="fas fa-phone"></i>

                                        <input
                                            type="tel"
                                            id="staffPhoneNumber"
                                            name="phoneNumber"
                                            placeholder="07XXXXXXXX"
                                            autocomplete="tel"
                                        >

                                    </div>

                                </div>


                                <!-- =================================
                                     SUMMARY
                                ================================== -->

                                <div class="staff-sale-summary">

                                    <div class="staff-sale-preview">

                                        <div class="staff-sale-preview-card">

                                            <span class="staff-sale-preview-label">
                                                ORDER TOTAL
                                            </span>

                                            <strong class="staff-sale-preview-value sale-total">
                                                KSh <%= Number(cartTotal).toLocaleString() %>
                                            </strong>

                                        </div>


                                        <div class="staff-sale-preview-card">

                                            <span class="staff-sale-preview-label">
                                                PAYMENT
                                            </span>

                                            <strong
                                                class="staff-sale-preview-value"
                                                id="staffPaymentPreview"
                                            >
                                                Select payment method
                                            </strong>

                                        </div>

                                    </div>

                                </div>


                                <!-- =================================
                                     ACTION
                                ================================== -->

                                <div class="staff-sale-modal-actions">

                                    <button
                                        type="submit"
                                        class="staff-sale-submit staff-sale-submit-btn"
                                    >

                                        <i class="fas fa-arrow-right"></i>

                                        Continue

                                    </button>

                                </div>

                            </form>

                        </div>


                        <!-- =================================
                             FOOTER
                        ================================== -->

                        <div class="staff-sale-modal-footer">

                            <span class="staff-sale-modal-note">

                                <i class="fas fa-lock"></i>

                                Your sales information is recorded
                                with this order.

                            </span>

                        </div>

                    </div>

                </div>


            <% } else if (checkoutProductId) { %>


                <!-- =================================================
                     NORMAL USER CHECKOUT
                ================================================== -->

                <a
                    href="/carts/<%= checkoutProductId %>"
                    class="cart-checkout-btn"
                >

                    <i class="fas fa-arrow-right"></i>

                    Continue to Checkout

                </a>


            <% } %>


            <!-- =================================================
                 BACK TO SHOP
            ================================================== -->

            <div class="cart-summary-back">

                <a
                    href="/products"
                    class="secondary-btn"
                >

                    <i class="fas fa-arrow-left"></i>

                    Continue Shopping

                </a>

            </div>

        </div>

    <% } %>

</section>


<!-- =========================================================
     STAFF CHECKOUT MODAL JAVASCRIPT
========================================================= -->

<% if (isStaff && checkoutProductId) { %>

<script>
document.addEventListener(
    "DOMContentLoaded",
    function () {

        const modal =
            document.getElementById(
                "staffCheckoutModal"
            );

        const openButton =
            document.getElementById(
                "openStaffSalesNameModal"
            );

        const closeButton =
            document.getElementById(
                "closeStaffCheckoutModal"
            );

        const overlay =
            document.getElementById(
                "staffCheckoutOverlay"
            );

        const form =
            document.getElementById(
                "staffCheckoutForm"
            );

        const salesName =
            document.getElementById(
                "staffSalesName"
            );

        const mpesaRadio =
            document.getElementById(
                "staffPaymentMpesa"
            );

        const deliveryRadio =
            document.getElementById(
                "staffPaymentDelivery"
            );

        const phoneField =
            document.getElementById(
                "staffPhoneField"
            );

        const phoneNumber =
            document.getElementById(
                "staffPhoneNumber"
            );

        const paymentPreview =
            document.getElementById(
                "staffPaymentPreview"
            );


        if (!modal || !openButton) {
            return;
        }


        /* =====================================================
           ROUTES
        ====================================================== */

        const checkoutUrl =
            "/carts/<%= checkoutProductId %>";

        const staffSaleUrl =
            "/carts/staff-sale";

        const paymentModeUrl =
            "/carts/payment-mode";


        /* =====================================================
           OPEN MODAL
        ====================================================== */

        function openModal() {

            modal.classList.add(
                "is-open"
            );

            modal.setAttribute(
                "aria-hidden",
                "false"
            );

            document.body.classList.add(
                "staff-sale-modal-open"
            );


            setTimeout(
                function () {

                    if (salesName) {
                        salesName.focus();
                    }

                },
                100
            );

        }


        /* =====================================================
           CLOSE MODAL
        ====================================================== */

        function closeModal() {

            modal.classList.remove(
                "is-open"
            );

            modal.setAttribute(
                "aria-hidden",
                "true"
            );

            document.body.classList.remove(
                "staff-sale-modal-open"
            );

        }


        /* =====================================================
           UPDATE PAYMENT DISPLAY
        ====================================================== */

        function updatePaymentDisplay() {

            if (
                mpesaRadio &&
                mpesaRadio.checked
            ) {

                if (paymentPreview) {

                    paymentPreview.textContent =
                        "Pay now with M-Pesa";

                }

                if (phoneField) {

                    phoneField.style.display =
                        "block";

                }

                if (phoneNumber) {

                    phoneNumber.required =
                        true;

                }

            } else if (
                deliveryRadio &&
                deliveryRadio.checked
            ) {

                if (paymentPreview) {

                    paymentPreview.textContent =
                        "Pay upon delivery";

                }

                if (phoneField) {

                    phoneField.style.display =
                        "none";

                }

                if (phoneNumber) {

                    phoneNumber.required =
                        false;

                }

            } else {

                if (paymentPreview) {

                    paymentPreview.textContent =
                        "Select payment method";

                }

                if (phoneField) {

                    phoneField.style.display =
                        "none";

                }

                if (phoneNumber) {

                    phoneNumber.required =
                        false;

                }

            }

        }


        /* =====================================================
           SAVE PAYMENT MODE
        ====================================================== */

        async function savePaymentMode(
            isMobile
        ) {

            try {

                const response =
                    await fetch(
                        paymentModeUrl,
                        {
                            method: "POST",

                            headers: {
                                "Content-Type":
                                    "application/json"
                            },

                            body: JSON.stringify({
                                isMobile:
                                    isMobile
                            })
                        }
                    );


                if (!response.ok) {

                    throw new Error(
                        "Unable to update payment mode."
                    );

                }

                return true;

            } catch (error) {

                console.error(
                    "Payment mode error:",
                    error
                );

                return false;

            }

        }


        /* =====================================================
           PAYMENT RADIO CHANGE
        ====================================================== */

        if (mpesaRadio) {

            mpesaRadio.addEventListener(
                "change",
                async function () {

                    if (!this.checked) {
                        return;
                    }

                    updatePaymentDisplay();

                    await savePaymentMode(
                        true
                    );

                }
            );

        }


        if (deliveryRadio) {

            deliveryRadio.addEventListener(
                "change",
                async function () {

                    if (!this.checked) {
                        return;
                    }

                    updatePaymentDisplay();

                    await savePaymentMode(
                        false
                    );

                }
            );

        }


        /* =====================================================
           OPEN
        ====================================================== */

        openButton.addEventListener(
            "click",
            openModal
        );


        /* =====================================================
           CLOSE
        ====================================================== */

        if (closeButton) {

            closeButton.addEventListener(
                "click",
                closeModal
            );

        }


        if (overlay) {

            overlay.addEventListener(
                "click",
                closeModal
            );

        }


        /* =====================================================
           ESCAPE
        ====================================================== */

        document.addEventListener(
            "keydown",
            function (event) {

                if (
                    event.key === "Escape" &&
                    modal.classList.contains(
                        "is-open"
                    )
                ) {

                    closeModal();

                }

            }
        );


        /* =====================================================
           SUBMIT
        ====================================================== */

        if (form) {

            form.addEventListener(
                "submit",
                async function (event) {

                    event.preventDefault();


                    const name =
                        salesName
                            ? salesName.value.trim()
                            : "";


                    /* =========================================
                       SALES NAME REQUIRED
                    ========================================== */

                    if (!name) {

                        if (salesName) {
                            salesName.focus();
                        }

                        return;

                    }


                    /* =========================================
                       PAYMENT REQUIRED
                    ========================================== */

                    const paymentMethod =
                        mpesaRadio &&
                        mpesaRadio.checked
                            ? "mpesa"
                            : (
                                deliveryRadio &&
                                deliveryRadio.checked
                                    ? "pay_on_delivery"
                                    : null
                            );


                    if (!paymentMethod) {
                        return;
                    }


                    /* =========================================
                       M-PESA PHONE REQUIRED
                    ========================================== */

                    if (
                        paymentMethod === "mpesa" &&
                        (
                            !phoneNumber ||
                            !phoneNumber.value.trim()
                        )
                    ) {

                        if (phoneNumber) {
                            phoneNumber.focus();
                        }

                        return;

                    }


                    /* =========================================
                       CASH
                       
                       KEEP EXISTING STAFF CASH FLOW.
                    ========================================== */

                    if (
                        paymentMethod ===
                        "pay_on_delivery"
                    ) {

                        const formData =
                            new FormData();

                        formData.append(
                            "salesName",
                            name
                        );


                        window.location.href =
                            staffSaleUrl +
                            "?" +
                            new URLSearchParams(
                                {
                                    salesName:
                                        name
                                }
                            ).toString();

                        return;

                    }


                    /* =========================================
                       M-PESA
                       
                       Staff enters ONLY salesName here.
                       
                       Payment mode has already been set to
                       isMobile = true.

                       Continue through the normal checkout
                       route rather than staff-sale.
                    ========================================== */

                    if (
                        paymentMethod ===
                        "mpesa"
                    ) {

                        const saved =
                            await savePaymentMode(
                                true
                            );


                        if (!saved) {
                            return;
                        }


                        const params =
                            new URLSearchParams();

                        params.set(
                            "salesName",
                            name
                        );


                        params.set(
                            "phoneNumber",
                            phoneNumber.value.trim()
                        );


                        window.location.href =
                            checkoutUrl +
                            "?" +
                            params.toString();

                    }

                }
            );

        }


        /* =====================================================
           INITIAL DISPLAY
        ====================================================== */

        updatePaymentDisplay();

    }
);
</script>

<% } %>