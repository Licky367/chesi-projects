<!-- ==========================================================
     views/cart/carts.ejs
     CART PAGE
========================================================== -->

<section class="shop-page cart-page">

  <!-- ========================================================
       PAGE HEADER
  ========================================================= -->

  <div class="cart-page-head">

    <div>

      <span class="cart-kicker">
        COREVESTER
      </span>

      <h1 class="page-title">
        Your Cart
      </h1>

      <p class="page-subtitle">
        Products you have reserved for checkout.
      </p>

    </div>


    <a
      href="/products"
      class="secondary-btn"
    >

      <i class="fas fa-arrow-left"></i>

      Continue Shopping

    </a>

  </div>


  <!-- ========================================================
       ERROR
  ========================================================= -->

  <% if (
    typeof error !== "undefined" &&
    error
  ) { %>

    <div class="cart-alert cart-alert-error">

      <i class="fas fa-circle-exclamation"></i>

      <span>
        <%= error %>
      </span>

    </div>

  <% } %>


  <!-- ========================================================
       EMPTY CART
  ========================================================= -->

  <% if (
    !cart ||
    !cart.items ||
    !cart.items.length
  ) { %>

    <div class="cart-empty">

      <div class="cart-empty-icon">

        <i class="fas fa-shopping-basket"></i>

      </div>

      <h2>
        Your cart is empty
      </h2>

      <p>
        You have not added any products to your cart yet.
      </p>

      <a
        class="primary-btn"
        href="/products"
      >

        <i class="fas fa-store"></i>

        Browse Products

      </a>

    </div>


  <% } else { %>


    <!-- ======================================================
         CART LAYOUT
    ======================================================= -->

    <div class="cart-layout">


      <!-- ====================================================
           CART ITEMS
      ===================================================== -->

      <div class="cart-items-section">

        <div class="cart-section-heading">

          <div>

            <span class="cart-section-kicker">
              YOUR SELECTION
            </span>

            <h2>
              Cart Items
            </h2>

          </div>


          <span class="cart-item-count">

            <%= cart.items.length %>

            <%= cart.items.length === 1
              ? "item"
              : "items"
            %>

          </span>

        </div>


        <div class="cart-list">

          <% cart.items.forEach(item => { %>

            <a
              href="/carts/<%= item.productId %>"
              class="cart-item-card"
            >

              <div class="cart-item-image">

                <% if (item.image) { %>

                  <img
                    src="<%= item.image %>"
                    alt="<%= item.name %>"
                  >

                <% } else { %>

                  <div class="cart-item-placeholder">

                    <i class="fas fa-box"></i>

                  </div>

                <% } %>

              </div>


              <div class="cart-item-main">

                <div class="cart-item-topline">

                  <span class="cart-item-label">
                    Product
                  </span>

                  <i
                    class="fas fa-chevron-right cart-item-arrow"
                  ></i>

                </div>


                <h3>
                  <%= item.name %>
                </h3>


                <div class="cart-item-meta">

                  <span>

                    <i class="fas fa-layer-group"></i>

                    Quantity:

                    <strong>
                      <%= item.qty %>
                    </strong>

                  </span>


                  <span>

                    <i class="fas fa-tag"></i>

                    Unit price:

                    <strong>
                      KSh
                      <%= Number(
                        item.price || 0
                      ).toLocaleString() %>
                    </strong>

                  </span>

                </div>


                <div class="cart-item-total">

                  KSh
                  <%= Number(
                    (item.price || 0) *
                    (item.qty || 0)
                  ).toLocaleString() %>

                </div>

              </div>

            </a>

          <% }) %>

        </div>

      </div>


      <!-- ====================================================
           ORDER SUMMARY
      ===================================================== -->

      <aside class="cart-summary-card">

        <div class="cart-summary-head">

          <span class="cart-section-kicker">
            ORDER SUMMARY
          </span>

          <i class="fas fa-receipt"></i>

        </div>


        <div class="cart-summary-row">

          <span>
            Items
          </span>

          <strong>
            <%= cart.items.length %>
          </strong>

        </div>


        <div class="cart-summary-row cart-summary-total">

          <span>
            Total
          </span>

          <strong>
            KSh
            <%= Number(
              total || 0
            ).toLocaleString() %>
          </strong>

        </div>


        <p class="cart-summary-note">

          Select a cart item to review its details,
          remove it, or continue to checkout.

        </p>


        <!-- ==================================================
             STAFF ACTION
        =================================================== -->

        <% if (
          String(
            user?.role || ""
          ).toLowerCase() === "staff"
        ) { %>


          <button
            type="button"
            class="primary-btn cart-checkout-btn staff-sale-open"
            id="staff-sale-open"
          >

            <i class="fas fa-cash-register"></i>

            Sale Items

          </button>


        <% } else { %>


          <!-- ================================================
               ADMIN / CLIENT CHECKOUT
          ================================================= -->

          <a
            class="primary-btn cart-checkout-btn"
            href="/carts/<%= cart.items[0].productId %>"
          >

            <i class="fas fa-credit-card"></i>

            Checkout

          </a>


        <% } %>


        <a
          class="cart-summary-back"
          href="/products"
        >

          <i class="fas fa-arrow-left"></i>

          Continue shopping

        </a>

      </aside>

    </div>


    <!-- ======================================================
         STAFF SALE MODAL
    ======================================================= -->

    <% if (
      String(
        user?.role || ""
      ).toLowerCase() === "staff"
    ) { %>


      <div
        class="staff-sale-modal"
        id="staff-sale-modal"
        aria-hidden="true"
      >

        <!-- BACKDROP -->

        <div
          class="staff-sale-backdrop"
          id="staff-sale-backdrop"
        ></div>


        <!-- MODAL -->

        <div
          class="staff-sale-dialog"
          role="dialog"
          aria-modal="true"
          aria-labelledby="staff-sale-title"
        >


          <!-- =================================================
               MODAL HEADER
          ================================================== -->

          <div class="staff-sale-header">

            <div>

              <span class="staff-sale-kicker">
                STAFF SALE
              </span>

              <h2 id="staff-sale-title">
                Record Sale
              </h2>

            </div>


            <button
              type="button"
              class="staff-sale-close"
              id="staff-sale-close"
              aria-label="Close"
            >

              <i class="fas fa-times"></i>

            </button>

          </div>


          <!-- =================================================
               MODAL BODY
          ================================================== -->

          <div class="staff-sale-body">

            <p class="staff-sale-intro">

              Enter the name of this sale.
              All products currently in your cart
              will be recorded under this sale.

            </p>


            <!-- SALE SUMMARY -->

            <div class="staff-sale-summary">

              <div>

                <span>
                  Cart items
                </span>

                <strong>
                  <%= cart.items.length %>
                </strong>

              </div>


              <div>

                <span>
                  Total amount
                </span>

                <strong>
                  KSh
                  <%= Number(
                    total || 0
                  ).toLocaleString() %>
                </strong>

              </div>

            </div>


            <!-- =================================================
                 FORM
            ================================================== -->

            <form
              action="/carts/staff-sale"
              method="POST"
              id="staff-sale-form"
            >

              <div class="staff-sale-field">

                <label for="salesName">
                  Sales Name
                </label>

                <input
                  type="text"
                  id="salesName"
                  name="salesName"
                  maxlength="150"
                  placeholder="e.g. Morning Sales"
                  autocomplete="off"
                  required
                >

              </div>


              <button
                type="submit"
                class="primary-btn staff-sale-submit"
              >

                <i class="fas fa-check-circle"></i>

                Submit Sale

              </button>

            </form>

          </div>

        </div>

      </div>


      <!-- ====================================================
           MODAL JAVASCRIPT
      ===================================================== -->

      <script>

        document.addEventListener(
          "DOMContentLoaded",
          function () {

            const modal =
              document.getElementById(
                "staff-sale-modal"
              );

            const openButton =
              document.getElementById(
                "staff-sale-open"
              );

            const closeButton =
              document.getElementById(
                "staff-sale-close"
              );

            const backdrop =
              document.getElementById(
                "staff-sale-backdrop"
              );

            const input =
              document.getElementById(
                "salesName"
              );


            if (
              !modal ||
              !openButton
            ) {
              return;
            }


            function openModal() {

              modal.classList.add(
                "is-open"
              );

              modal.setAttribute(
                "aria-hidden",
                "false"
              );

              document.body.classList.add(
                "staff-sale-modal-active"
              );


              if (input) {

                setTimeout(
                  function () {

                    input.focus();

                  },
                  150
                );
              }

            }


            function closeModal() {

              modal.classList.remove(
                "is-open"
              );

              modal.setAttribute(
                "aria-hidden",
                "true"
              );

              document.body.classList.remove(
                "staff-sale-modal-active"
              );

            }


            openButton.addEventListener(
              "click",
              openModal
            );


            if (closeButton) {

              closeButton.addEventListener(
                "click",
                closeModal
              );

            }


            if (backdrop) {

              backdrop.addEventListener(
                "click",
                closeModal
              );

            }


            document.addEventListener(
              "keydown",
              function (event) {

                if (
                  event.key === "Escape" &&
                  modal.classList.contains(
                    "is-open"
                  )
                ) {

                  closeModal();

                }

              }
            );

          }
        );

      </script>


    <% } %>


  <% } %>

</section>