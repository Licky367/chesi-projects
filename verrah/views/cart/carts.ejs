<%
/* =========================================================
   VERRAH COSMETICS
   CART PAGE
   ========================================================= */

const pageUser =
    (typeof user !== "undefined" && user)
        ? user
        : (
            typeof currentUser !== "undefined"
                ? currentUser
                : null
        );

const userRole =
    pageUser && pageUser.role
        ? String(pageUser.role).toLowerCase()
        : "";

const isStaff =
    userRole === "staff";

const cartItems =
    cart &&
    Array.isArray(cart.items)
        ? cart.items
        : [];

const hasItems =
    cartItems.length > 0;

const cartTotal =
    cart && typeof cart.total === "number"
        ? cart.total
        : (
            typeof total === "number"
                ? total
                : 0
        );

const checkoutProductId =
    hasItems && cartItems[0].product
        ? (
            cartItems[0].product._id ||
            cartItems[0].product.id ||
            cartItems[0].product
        )
        : null;
%>


<section class="shop-page cart-page">

    <!-- =====================================================
         PAGE HEADER
    ====================================================== -->

    <header class="cart-page-head">

        <div>

            <span class="cart-kicker">
                SHOPPING CART
            </span>

            <h1 class="page-title">
                Your Cart
            </h1>

            <p class="page-subtitle">
                Review your selected products before checkout.
            </p>

        </div>

    </header>


    <!-- =====================================================
         ERROR MESSAGE
    ====================================================== -->

    <% if (typeof error !== "undefined" && error) { %>

        <div class="cart-alert cart-alert-error">

            <i class="fas fa-circle-exclamation"></i>

            <span>
                <%= error %>
            </span>

        </div>

    <% } %>


    <% if (!hasItems) { %>

        <!-- =================================================
             EMPTY CART
        ================================================== -->

        <div class="cart-summary-card">

            <div class="cart-summary-head">

                <i class="fas fa-shopping-cart"></i>

                <div>

                    <h2>
                        Your cart is empty
                    </h2>

                    <p>
                        Add products to your cart before checking out.
                    </p>

                </div>

            </div>


            <div class="cart-summary-back">

                <a
                    href="/products"
                    class="secondary-btn"
                >
                    <i class="fas fa-arrow-left"></i>
                    Continue Shopping
                </a>

            </div>

        </div>


    <% } else { %>


        <!-- =================================================
             CART ITEMS
        ================================================== -->

        <div class="cart-list">

            <% cartItems.forEach(function(item) {

                const product =
                    item.product || {};

                const productId =
                    product._id ||
                    product.id ||
                    "";

                const productName =
                    product.name ||
                    "Product";

                const quantity =
                    Number(item.quantity || 1);

                const itemTotal =
                    Number(
                        item.total ||
                        (
                            Number(item.price || 0) *
                            quantity
                        )
                    );

                const productImage =
                    product.image ||
                    (
                        Array.isArray(product.images) &&
                        product.images.length
                            ? product.images[0]
                            : ""
                    );

            %>

                <article class="cart-item-card">

                    <!-- =====================================
                         PRODUCT
                    ====================================== -->

                    <a
                        href="/products/<%= productId %>"
                        class="cart-item-link"
                    >

                        <% if (productImage) { %>

                            <div class="cart-item-image">

                                <img
                                    src="<%= productImage %>"
                                    alt="<%= productName %>"
                                >

                            </div>

                        <% } %>


                        <div class="cart-item-main">

                            <div class="cart-item-topline">

                                <span class="cart-item-label">
                                    PRODUCT
                                </span>

                                <i class="fas fa-chevron-right cart-item-arrow"></i>

                            </div>


                            <h3>
                                <%= productName %>
                            </h3>


                            <div class="cart-item-meta">

                                <span>
                                    Quantity:
                                    <strong>
                                        <%= quantity %>
                                    </strong>
                                </span>

                            </div>


                            <div class="cart-item-total">

                                KSh
                                <%= itemTotal.toLocaleString() %>

                            </div>

                        </div>

                    </a>


                    <!-- =====================================
                         REMOVE
                    ====================================== -->

                    <form
                        action="/carts/<%= productId %>/remove"
                        method="POST"
                        class="cart-remove-form"
                    >

                        <button
                            type="submit"
                            class="cart-remove-btn"
                            title="Remove from cart"
                        >

                            <i class="fas fa-trash"></i>

                        </button>

                    </form>

                </article>

            <% }); %>

        </div>


        <!-- =================================================
             CART SUMMARY
        ================================================== -->

        <div class="cart-summary-card">

            <div class="cart-summary-head">

                <div>

                    <span class="cart-kicker">
                        ORDER SUMMARY
                    </span>

                    <h2>
                        Checkout
                    </h2>

                </div>

            </div>


            <div class="cart-summary-row">

                <span>
                    Items
                </span>

                <strong>
                    <%= cartItems.length %>
                </strong>

            </div>


            <div class="cart-summary-row cart-summary-total">

                <span>
                    Total
                </span>

                <strong>
                    KSh <%= Number(cartTotal).toLocaleString() %>
                </strong>

            </div>


            <p class="cart-summary-note">

                <% if (isStaff) { %>

                    Enter the sales name before continuing
                    to checkout.

                <% } else { %>

                    Continue to checkout to select your pickup
                    substation and payment method.

                <% } %>

            </p>


            <!-- =================================================
                 STAFF
            ================================================== -->

            <% if (isStaff && checkoutProductId) { %>

                <button
                    type="button"
                    class="staff-sale-trigger primary-btn"
                    id="openStaffSalesNameModal"
                >

                    <i class="fas fa-cash-register"></i>

                    Continue to Checkout

                </button>


                <!-- =============================================
                     STAFF SALES NAME MODAL
                     THIS MODAL EXISTS ON /CARTS
                ============================================== -->

                <div
                    class="staff-sale-modal"
                    id="staffSalesNameModal"
                    aria-hidden="true"
                >

                    <div
                        class="staff-sale-modal-overlay"
                        id="staffSalesNameOverlay"
                    ></div>


                    <div
                        class="staff-sale-modal-content"
                        role="dialog"
                        aria-modal="true"
                        aria-labelledby="staffSalesNameTitle"
                    >

                        <!-- =================================
                             HEADER
                        ================================== -->

                        <div class="staff-sale-modal-header">

                            <div class="staff-sale-modal-icon">

                                <i class="fas fa-user-tie"></i>

                            </div>


                            <div>

                                <span class="staff-sale-modal-kicker">
                                    STAFF CHECKOUT
                                </span>

                                <h2
                                    class="staff-sale-modal-title"
                                    id="staffSalesNameTitle"
                                >
                                    Sales Name
                                </h2>

                            </div>


                            <button
                                type="button"
                                class="staff-sale-modal-close"
                                id="closeStaffSalesNameModal"
                                aria-label="Close"
                            >

                                <i class="fas fa-times"></i>

                            </button>

                        </div>


                        <!-- =================================
                             BODY
                        ================================== -->

                        <div class="staff-sale-modal-body">

                            <p class="staff-sale-modal-description">

                                Enter the sales name before
                                continuing to checkout.

                            </p>


                            <!-- =================================
                                 IMPORTANT

                                 This form does NOT submit a POST
                                 to /carts/:id.

                                 It submits GET /carts/:id with
                                 salesName as a query parameter.

                                 The normal checkout page then
                                 handles the rest.
                            ================================== -->

                            <form
                                action="/carts/<%= checkoutProductId %>"
                                method="GET"
                                class="staff-sale-form"
                                id="staffCheckoutForm"
                            >

                                <div class="staff-sale-form-group">

                                    <label
                                        for="salesName"
                                        class="staff-sale-field"
                                    >
                                        Sales Name
                                    </label>


                                    <div class="staff-sale-input-wrap">

                                        <i class="fas fa-user"></i>

                                        <input
                                            type="text"
                                            id="salesName"
                                            name="salesName"
                                            placeholder="Enter sales name"
                                            autocomplete="off"
                                            required
                                        >

                                    </div>

                                </div>


                                <!-- =================================
                                     ACTION
                                ================================== -->

                                <div class="staff-sale-modal-actions">

                                    <button
                                        type="submit"
                                        class="staff-sale-submit staff-sale-submit-btn"
                                    >

                                        <i class="fas fa-arrow-right"></i>

                                        Continue to Checkout

                                    </button>

                                </div>

                            </form>

                        </div>


                        <!-- =================================
                             FOOTER
                        ================================== -->

                        <div class="staff-sale-modal-footer">

                            <span class="staff-sale-modal-note">

                                <i class="fas fa-lock"></i>

                                Sales information will be recorded
                                with this order.

                            </span>

                        </div>

                    </div>

                </div>


            <% } else if (checkoutProductId) { %>


                <!-- =================================================
                     NORMAL USER
                ================================================== -->

                <a
                    href="/carts/<%= checkoutProductId %>"
                    class="cart-checkout-btn"
                >

                    <i class="fas fa-arrow-right"></i>

                    Continue to Checkout

                </a>


            <% } %>


            <!-- =================================================
                 BACK
            ================================================== -->

            <div class="cart-summary-back">

                <a
                    href="/products"
                    class="secondary-btn"
                >

                    <i class="fas fa-arrow-left"></i>

                    Continue Shopping

                </a>

            </div>

        </div>

    <% } %>

</section>


<!-- =========================================================
     STAFF SALES NAME MODAL
========================================================= -->

<% if (isStaff && checkoutProductId) { %>

<script>
document.addEventListener(
    "DOMContentLoaded",
    function () {

        const modal =
            document.getElementById(
                "staffSalesNameModal"
            );

        const openButton =
            document.getElementById(
                "openStaffSalesNameModal"
            );

        const closeButton =
            document.getElementById(
                "closeStaffSalesNameModal"
            );

        const overlay =
            document.getElementById(
                "staffSalesNameOverlay"
            );

        const form =
            document.getElementById(
                "staffCheckoutForm"
            );

        const salesName =
            document.getElementById(
                "salesName"
            );


        if (!modal || !openButton) {
            return;
        }


        /* =====================================================
           OPEN
        ====================================================== */

        function openModal() {

            modal.classList.add(
                "is-open"
            );

            modal.setAttribute(
                "aria-hidden",
                "false"
            );

            document.body.classList.add(
                "staff-sale-modal-open"
            );


            setTimeout(
                function () {

                    if (salesName) {
                        salesName.focus();
                    }

                },
                100
            );

        }


        /* =====================================================
           CLOSE
        ====================================================== */

        function closeModal() {

            modal.classList.remove(
                "is-open"
            );

            modal.setAttribute(
                "aria-hidden",
                "true"
            );

            document.body.classList.remove(
                "staff-sale-modal-open"
            );

        }


        /* =====================================================
           OPEN BUTTON
        ====================================================== */

        openButton.addEventListener(
            "click",
            openModal
        );


        /* =====================================================
           CLOSE BUTTON
        ====================================================== */

        if (closeButton) {

            closeButton.addEventListener(
                "click",
                closeModal
            );

        }


        /* =====================================================
           OVERLAY
        ====================================================== */

        if (overlay) {

            overlay.addEventListener(
                "click",
                closeModal
            );

        }


        /* =====================================================
           ESCAPE
        ====================================================== */

        document.addEventListener(
            "keydown",
            function (event) {

                if (
                    event.key === "Escape" &&
                    modal.classList.contains(
                        "is-open"
                    )
                ) {

                    closeModal();

                }

            }
        );


        /* =====================================================
           SALES NAME VALIDATION
        ====================================================== */

        if (form) {

            form.addEventListener(
                "submit",
                function (event) {

                    const value =
                        salesName
                            ? salesName.value.trim()
                            : "";


                    if (!value) {

                        event.preventDefault();

                        if (salesName) {
                            salesName.focus();
                        }

                        return;

                    }

                }
            );

        }

    }
);
</script>

<% } %>