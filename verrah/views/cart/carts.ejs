<!-- ==========================================================
     verrah/views/cart/carts.ejs
     CART PAGE
========================================================== -->

<%
    const isStaff =
        String(user?.role || "").toLowerCase() === "staff";

    const staffBranchUrl =
        isStaff && user?.assignedSubstation
            ? `/branch/${user.assignedSubstation}`
            : "/products";
%>


<section class="shop-page cart-page">

    <div class="cart-page-head">

        <div>

            <span class="cart-kicker">
                VERRAH COSMETICS
            </span>

            <h1 class="page-title">
                Your Cart
            </h1>

            <p class="page-subtitle">
                Products in your cart.
            </p>

        </div>


        <a
            href="<%= staffBranchUrl %>"
            class="secondary-btn"
        >
            <i class="fas fa-arrow-left"></i>
            Continue Shopping
        </a>

    </div>


    <!-- ======================================================
         ERROR
    ======================================================= -->

    <% if (
        typeof error !== "undefined" &&
        error
    ) { %>

        <div class="cart-alert cart-alert-error">

            <i class="fas fa-circle-exclamation"></i>

            <span>
                <%= error %>
            </span>

        </div>

    <% } %>


    <!-- ======================================================
         EMPTY CART
    ======================================================= -->

    <% if (
        !cart ||
        !cart.items ||
        !cart.items.length
    ) { %>

        <div class="cart-empty">

            <div class="cart-empty-icon">
                <i class="fas fa-shopping-basket"></i>
            </div>

            <h2>
                Your Cart Is Empty
            </h2>

            <p>
                You have not added any products to your cart yet.
            </p>

            <a
                class="primary-btn"
                href="<%= staffBranchUrl %>"
            >
                <i class="fas fa-store"></i>
                Browse Products
            </a>

        </div>


    <% } else { %>


        <!-- ==================================================
             CART LAYOUT
        =================================================== -->

        <div class="cart-layout">


            <!-- ==================================================
                 CART ITEMS
            =================================================== -->

            <div class="cart-items-section">

                <div class="cart-section-heading">

                    <div>

                        <span class="cart-section-kicker">
                            YOUR SELECTION
                        </span>

                        <h2>
                            Cart Items
                        </h2>

                    </div>


                    <span class="cart-item-count">

                        <%= cart.items.length %>

                        <%= cart.items.length === 1
                            ? "item"
                            : "items"
                        %>

                    </span>

                </div>


                <div class="cart-list">

                    <% cart.items.forEach(item => { %>

                        <a
                            href="/carts/<%= item.productId %>"
                            class="cart-item-card"
                        >

                            <div class="cart-item-image">

                                <% if (item.image) { %>

                                    <img
                                        src="<%= item.image %>"
                                        alt="<%= item.name %>"
                                    >

                                <% } else { %>

                                    <div class="cart-item-placeholder">

                                        <i class="fas fa-box"></i>

                                    </div>

                                <% } %>

                            </div>


                            <div class="cart-item-main">

                                <div class="cart-item-topline">

                                    <span class="cart-item-label">
                                        Product
                                    </span>

                                    <i
                                        class="fas fa-chevron-right cart-item-arrow"
                                    ></i>

                                </div>


                                <h3>
                                    <%= item.name %>
                                </h3>


                                <div class="cart-item-meta">

                                    <span>

                                        <i class="fas fa-layer-group"></i>

                                        Quantity:

                                        <strong>
                                            <%= item.qty %>
                                        </strong>

                                    </span>


                                    <span>

                                        <i class="fas fa-tag"></i>

                                        Unit price:

                                        <strong>

                                            KSh

                                            <%= Number(
                                                item.price || 0
                                            ).toLocaleString() %>

                                        </strong>

                                    </span>

                                </div>


                                <div class="cart-item-total">

                                    KSh

                                    <%= Number(
                                        (item.price || 0) *
                                        (item.qty || 0)
                                    ).toLocaleString() %>

                                </div>

                            </div>

                        </a>

                    <% }) %>

                </div>

            </div>


            <!-- ==================================================
                 ORDER SUMMARY
            =================================================== -->

            <aside class="cart-summary-card">

                <div class="cart-summary-head">

                    <span class="cart-section-kicker">
                        ORDER SUMMARY
                    </span>

                    <i class="fas fa-receipt"></i>

                </div>


                <div class="cart-summary-row">

                    <span>
                        Items
                    </span>

                    <strong>
                        <%= cart.items.length %>
                    </strong>

                </div>


                <div class="cart-summary-row cart-summary-total">

                    <span>
                        Total
                    </span>

                    <strong>

                        KSh

                        <%= Number(
                            total || 0
                        ).toLocaleString() %>

                    </strong>

                </div>


                <p class="cart-summary-note">

                    Select a cart item to review its details,
                    remove it, or continue to checkout.

                </p>


                <!-- =================================================
                     STAFF SALE BUTTON
                ================================================== -->

                <% if (isStaff) { %>

                    <button
                        type="button"
                        class="primary-btn cart-checkout-btn staff-sale-btn"
                        id="open-staff-sale-modal"
                    >

                        <i class="fas fa-cash-register"></i>

                        Sale Items

                    </button>


                <% } else { %>


                    <!-- ===============================================
                         NORMAL CHECKOUT
                    ================================================ -->

                    <a
                        class="primary-btn cart-checkout-btn"
                        href="/carts/<%= cart.items[0].productId %>"
                    >

                        <i class="fas fa-credit-card"></i>

                        Checkout

                    </a>


                <% } %>


                <a
                    class="cart-summary-back"
                    href="<%= staffBranchUrl %>"
                >

                    <i class="fas fa-arrow-left"></i>

                    Continue Shopping

                </a>

            </aside>


        </div>


        <!-- ====================================================
             STAFF SALE MODAL
        ===================================================== -->

        <% if (isStaff) { %>

            <div
                id="staff-sale-modal"
                class="staff-sale-modal"
                aria-hidden="true"
            >

                <div
                    id="staff-sale-modal-overlay"
                    class="staff-sale-modal-overlay"
                ></div>


                <div
                    class="staff-sale-modal-card"
                    role="dialog"
                    aria-modal="true"
                    aria-labelledby="staff-sale-modal-title"
                >

                    <div class="staff-sale-modal-header">

                        <div>

                            <span class="cart-section-kicker">
                                STAFF SALE
                            </span>

                            <h2 id="staff-sale-modal-title">
                                Record Sale
                            </h2>

                        </div>


                        <button
                            type="button"
                            id="close-staff-sale-modal"
                            class="staff-sale-modal-close"
                            aria-label="Close"
                        >

                            <i class="fas fa-times"></i>

                        </button>

                    </div>


                    <div class="staff-sale-modal-body">

                        <p class="staff-sale-modal-description">

                            Enter a name for this sale before
                            submitting the items in your cart.

                        </p>


                        <div class="staff-sale-preview">

                            <div class="staff-sale-preview-row">

                                <span>
                                    Products
                                </span>

                                <strong>
                                    <%= cart.items.length %>
                                </strong>

                            </div>


                            <div class="staff-sale-preview-row">

                                <span>
                                    Total Amount
                                </span>

                                <strong>

                                    KSh

                                    <%= Number(
                                        total || 0
                                    ).toLocaleString() %>

                                </strong>

                            </div>

                        </div>


                        <form
                            method="POST"
                            action="/carts/staff-sale"
                            id="staff-sale-form"
                            class="staff-sale-form"
                        >

                            <div class="staff-sale-form-group">

                                <label for="sales-name">
                                    Sales Name
                                </label>


                                <input
                                    type="text"
                                    id="sales-name"
                                    name="salesName"
                                    placeholder="Enter sales name"
                                    maxlength="150"
                                    autocomplete="off"
                                    required
                                >


                                <small>
                                    Enter the name you want this sale
                                    to be recorded under.
                                </small>

                            </div>


                            <button
                                type="submit"
                                class="primary-btn staff-sale-submit-btn"
                            >

                                <i class="fas fa-check-circle"></i>

                                Submit Sale

                            </button>

                        </form>

                    </div>

                </div>

            </div>


            <!-- ==================================================
                 STAFF SALE JAVASCRIPT
            =================================================== -->

            <script>
                (function () {

                    const modal =
                        document.getElementById(
                            "staff-sale-modal"
                        );

                    const openButton =
                        document.getElementById(
                            "open-staff-sale-modal"
                        );

                    const closeButton =
                        document.getElementById(
                            "close-staff-sale-modal"
                        );

                    const overlay =
                        document.getElementById(
                            "staff-sale-modal-overlay"
                        );

                    const input =
                        document.getElementById(
                            "sales-name"
                        );


                    function openModal(event) {

                        if (event) {
                            event.preventDefault();
                            event.stopPropagation();
                        }

                        if (!modal) {
                            return;
                        }

                        modal.classList.add(
                            "is-open"
                        );

                        modal.setAttribute(
                            "aria-hidden",
                            "false"
                        );

                        document.body.classList.add(
                            "staff-sale-modal-open"
                        );

                        if (input) {

                            setTimeout(
                                function () {
                                    input.focus();
                                },
                                50
                            );

                        }
                    }


                    function closeModal(event) {

                        if (event) {
                            event.preventDefault();
                            event.stopPropagation();
                        }

                        if (!modal) {
                            return;
                        }

                        modal.classList.remove(
                            "is-open"
                        );

                        modal.setAttribute(
                            "aria-hidden",
                            "true"
                        );

                        document.body.classList.remove(
                            "staff-sale-modal-open"
                        );
                    }


                    if (openButton) {

                        openButton.addEventListener(
                            "click",
                            openModal
                        );

                    }


                    if (closeButton) {

                        closeButton.addEventListener(
                            "click",
                            closeModal
                        );

                    }


                    if (overlay) {

                        overlay.addEventListener(
                            "click",
                            closeModal
                        );

                    }


                    document.addEventListener(
                        "keydown",
                        function (event) {

                            if (
                                event.key === "Escape" &&
                                modal &&
                                modal.classList.contains(
                                    "is-open"
                                )
                            ) {

                                closeModal();

                            }

                        }
                    );


                    window.openStaffSaleModal =
                        openModal;

                    window.closeStaffSaleModal =
                        closeModal;

                })();
            </script>

        <% } %>


    <% } %>

</section>