<!-- ==========================================================
     verrah/views/cart/carts.ejs
     VERRAH COSMETICS
     CART PAGE
========================================================== -->

<%
    const isStaff =
        String(user?.role || "").toLowerCase() === "staff";

    const staffBranchUrl =
        isStaff && user?.assignedSubstation
            ? `/branch/${user.assignedSubstation}`
            : "/products";

    const cartItems =
        Array.isArray(cart?.items)
            ? cart.items
            : [];

    const hasItems =
        cartItems.length > 0;

    const cartTotal =
        Number(
            total ??
            cart?.totalPrice ??
            0
        );

    /*
     * PAYMENT MODE
     *
     * isMobile === false
     *     = Cash Payment
     *     = Record Sale
     *     = Existing staff-sale popup
     *
     * isMobile === true
     *     = Mpesa Payment
     *     = Checkout
     *     = /carts/:productId
     *
     * Cart model defaults isMobile to true.
     */
    const isMobile =
        cart?.isMobile !== false;

    const checkoutProductId =
        hasItems
            ? String(
                cartItems[0]?.product?._id ||
                cartItems[0]?.product ||
                cartItems[0]?.productId ||
                ""
            )
            : "";
%>


<section class="shop-page cart-page">

    <!-- ======================================================
         HEADER
    ======================================================= -->

    <div class="cart-page-head">

        <div>

            <span class="cart-kicker">
                VERRAH COSMETICS
            </span>

            <h1 class="page-title">
                Your Cart
            </h1>

            <p class="page-subtitle">
                Products in your cart.
            </p>

        </div>


        <a
            href="<%= staffBranchUrl %>"
            class="secondary-btn"
        >
            <i class="fas fa-arrow-left"></i>
            Continue Shopping
        </a>

    </div>


    <!-- ======================================================
         ERROR
    ======================================================= -->

    <% if (error) { %>

        <div class="cart-alert cart-alert-error">

            <i class="fas fa-circle-exclamation"></i>

            <span>
                <%= error %>
            </span>

        </div>

    <% } %>


    <!-- ======================================================
         EMPTY CART
    ======================================================= -->

    <% if (!hasItems) { %>

        <div class="cart-empty">

            <div class="cart-empty-icon">
                <i class="fas fa-shopping-basket"></i>
            </div>

            <h2>
                Your Cart Is Empty
            </h2>

            <p>
                You have not added any products to your cart yet.
            </p>

            <a
                class="primary-btn"
                href="<%= staffBranchUrl %>"
            >
                <i class="fas fa-store"></i>
                Browse Products
            </a>

        </div>


    <% } else { %>


        <!-- ==================================================
             CART LAYOUT
        =================================================== -->

        <div class="cart-layout">


            <!-- ==================================================
                 CART ITEMS
            =================================================== -->

            <div class="cart-items-section">

                <div class="cart-section-heading">

                    <div>

                        <span class="cart-section-kicker">
                            YOUR SELECTION
                        </span>

                        <h2>
                            Cart Items
                        </h2>

                    </div>


                    <span class="cart-item-count">

                        <%= cartItems.length %>

                        <%= cartItems.length === 1
                            ? "item"
                            : "items"
                        %>

                    </span>

                </div>


                <div class="cart-list">

                    <% cartItems.forEach(item => { %>

                        <%
                            const productId =
                                String(
                                    item.product?._id ||
                                    item.product ||
                                    item.productId ||
                                    ""
                                );

                            /*
                             * qty is the canonical cart quantity.
                             * quantity is kept only as a fallback for
                             * older documents.
                             */
                            const quantity =
                                Number(
                                    item.qty ??
                                    item.quantity ??
                                    0
                                );

                            const price =
                                Number(
                                    item.price || 0
                                );

                            const itemTotal =
                                price * quantity;

                            const productName =
                                item.name ||
                                item.product?.name ||
                                "Product";

                            const image =
                                item.image ||
                                item.product?.image ||
                                "";
                        %>


                        <div class="cart-item-card">

                            <!-- ==================================================
                                 CLICKABLE ITEM AREA
                            =================================================== -->

                            <a
                                href="/carts/<%= productId %>/details"
                                class="cart-item-link"
                            >

                                <div class="cart-item-image">

                                    <% if (image) { %>

                                        <img
                                            src="<%= image %>"
                                            alt="<%= productName %>"
                                        >

                                    <% } else { %>

                                        <div class="cart-item-placeholder">

                                            <i class="fas fa-box"></i>

                                        </div>

                                    <% } %>

                                </div>


                                <div class="cart-item-main">

                                    <div class="cart-item-topline">

                                        <span class="cart-item-label">
                                            Product
                                        </span>

                                        <i
                                            class="fas fa-chevron-right cart-item-arrow"
                                        ></i>

                                    </div>


                                    <h3>
                                        <%= productName %>
                                    </h3>


                                    <div class="cart-item-meta">

                                        <span>

                                            <i class="fas fa-layer-group"></i>

                                            Quantity:

                                            <strong>
                                                <%= quantity %>
                                            </strong>

                                        </span>


                                        <span>

                                            <i class="fas fa-tag"></i>

                                            Unit price:

                                            <strong>
                                                KSh
                                                <%= price.toLocaleString() %>
                                            </strong>

                                        </span>

                                    </div>


                                    <div class="cart-item-total">

                                        KSh
                                        <%= itemTotal.toLocaleString() %>

                                    </div>

                                </div>

                            </a>


                            <!-- ==================================================
                                 REMOVE
                            =================================================== -->

                            <form
                                action="/carts/<%= productId %>/remove"
                                method="POST"
                                class="cart-remove-form"
                            >

                                <button
                                    type="submit"
                                    class="cart-remove-btn"
                                    aria-label="Remove <%= productName %>"
                                >

                                    <i class="fas fa-trash"></i>

                                </button>

                            </form>

                        </div>


                    <% }) %>

                </div>

            </div>


            <!-- ==================================================
                 ORDER SUMMARY
            =================================================== -->

            <aside class="cart-summary-card">

                <div class="cart-summary-head">

                    <span class="cart-section-kicker">
                        ORDER SUMMARY
                    </span>

                    <i class="fas fa-receipt"></i>

                </div>


                <div class="cart-summary-row">

                    <span>
                        Items
                    </span>

                    <strong>
                        <%= cartItems.length %>
                    </strong>

                </div>


                <div class="cart-summary-row cart-summary-total">

                    <span>
                        Total
                    </span>

                    <strong>
                        KSh
                        <%= cartTotal.toLocaleString() %>
                    </strong>

                </div>


                <!-- ==================================================
                     STAFF PAYMENT MODE
                     
                     ONLY STAFF SEE THIS.
                =================================================== -->

                <% if (isStaff) { %>

                    <div class="cart-payment-mode">

                        <label
                            for="staffPaymentMode"
                            class="cart-payment-mode-label"
                        >
                            Select payment mode:
                        </label>


                        <select
                            id="staffPaymentMode"
                            class="cart-payment-mode-select"
                        >

                            <option
                                value="cash"
                                <%= !isMobile ? "selected" : "" %>
                            >
                                Cash Payment
                            </option>


                            <option
                                value="mpesa"
                                <%= isMobile ? "selected" : "" %>
                            >
                                Mpesa Payment
                            </option>

                        </select>

                    </div>

                <% } %>


                <!-- ==================================================
                     CHECKOUT ACTION
                =================================================== -->

                <% if (isStaff) { %>

                    <!--
                        STAFF + CASH

                        isMobile = false

                        Button:
                            Record Sale

                        Clicking:
                            Existing staff-sale popup
                    -->

                    <% if (!isMobile) { %>

                        <button
                            type="button"
                            class="primary-btn cart-checkout-btn staff-sale-trigger"
                            id="openStaffSaleModal"
                        >

                            <i class="fas fa-cash-register"></i>

                            <span>
                                Record Sale
                            </span>

                        </button>


                    <% } else { %>


                        <!--
                            STAFF + MPESA

                            isMobile = true

                            Button:
                                Checkout

                            Clicking goes directly to:

                                /carts/:productId

                            No staff-sale popup is opened.
                        -->

                        <a
                            class="primary-btn cart-checkout-btn"
                            id="staffMpesaCheckout"
                            href="/carts/<%= checkoutProductId %>"
                        >

                            <i class="fas fa-credit-card"></i>

                            <span>
                                Checkout
                            </span>

                        </a>

                    <% } %>


                <% } else { %>

                    <!--
                        NORMAL USERS

                        EXISTING CHECKOUT LOGIC REMAINS
                        EXACTLY THE SAME.
                    -->

                    <a
                        class="primary-btn cart-checkout-btn"
                        href="/carts/<%= checkoutProductId %>"
                    >

                        <i class="fas fa-credit-card"></i>

                        Checkout

                    </a>

                <% } %>


                <a
                    class="secondary-btn cart-continue-btn"
                    href="<%= staffBranchUrl %>"
                >

                    <i class="fas fa-store"></i>

                    Continue Shopping

                </a>

            </aside>

        </div>


    <% } %>

</section>


<!-- ==========================================================
     STAFF CASH SALE MODAL

     ONLY USED WHEN:

         role = staff
         isMobile = false

     Mpesa does NOT use this modal.
     Mpesa goes directly to /carts/:productId.
========================================================== -->

<% if (isStaff && hasItems && !isMobile) { %>

    <div
        class="staff-sale-modal"
        id="staffSaleModal"
        aria-hidden="true"
    >

        <div
            class="staff-sale-modal-overlay"
            data-close-staff-sale-modal
        ></div>


        <div
            class="staff-sale-modal-content"
            role="dialog"
            aria-modal="true"
            aria-labelledby="staffSaleModalTitle"
        >

            <!-- ==================================================
                 MODAL HEADER
            =================================================== -->

            <div class="staff-sale-modal-header">

                <div class="staff-sale-modal-icon">

                    <i class="fas fa-user-tag"></i>

                </div>


                <div>

                    <span class="staff-sale-modal-kicker">
                        STAFF SALE
                    </span>

                    <h2 id="staffSaleModalTitle">
                        Record Sale
                    </h2>

                </div>


                <button
                    type="button"
                    class="staff-sale-modal-close"
                    data-close-staff-sale-modal
                    aria-label="Close"
                >

                    <i class="fas fa-times"></i>

                </button>

            </div>


            <!-- ==================================================
                 MODAL BODY
            =================================================== -->

            <div class="staff-sale-modal-body">

                <p class="staff-sale-modal-description">

                    Enter the name of the customer for this sale.

                </p>


                <form
                    action="/carts/staff-sale"
                    method="POST"
                    id="staffSaleForm"
                    class="staff-sale-form"
                >

                    <!--
                        Cash payment:

                            isMobile = false
                    -->

                    <input
                        type="hidden"
                        name="isMobile"
                        value="false"
                    >


                    <div class="staff-sale-field">

                        <label
                            for="salesName"
                        >
                            Customer / Sales Name
                        </label>


                        <div class="staff-sale-input-wrap">

                            <i class="fas fa-user"></i>

                            <input
                                type="text"
                                id="salesName"
                                name="salesName"
                                maxlength="150"
                                autocomplete="name"
                                placeholder="Enter sales name"
                                required
                            >

                        </div>

                    </div>


                    <div class="staff-sale-summary">

                        <span>
                            Sale total
                        </span>

                        <strong>
                            KSh
                            <%= cartTotal.toLocaleString() %>
                        </strong>

                    </div>


                    <!-- ==================================================
                         MODAL ACTIONS
                    =================================================== -->

                    <div class="staff-sale-modal-actions">

                        <button
                            type="button"
                            class="secondary-btn staff-sale-cancel"
                            data-close-staff-sale-modal
                        >

                            Cancel

                        </button>


                        <button
                            type="submit"
                            class="primary-btn staff-sale-submit"
                        >

                            <i class="fas fa-check"></i>

                            Complete Sale

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>


    <!-- ==========================================================
         STAFF CASH SALE MODAL JAVASCRIPT
    =========================================================== -->

    <script>
        (function () {

            const modal =
                document.getElementById(
                    "staffSaleModal"
                );

            const openButton =
                document.getElementById(
                    "openStaffSaleModal"
                );

            const nameInput =
                document.getElementById(
                    "salesName"
                );


            if (!modal || !openButton) {
                return;
            }


            // ==================================================
            // CLOSE MODAL
            // ==================================================

            const closeModal =
                function () {

                    modal.classList.remove(
                        "is-open"
                    );

                    modal.setAttribute(
                        "aria-hidden",
                        "true"
                    );

                    document.body.classList.remove(
                        "staff-sale-modal-open"
                    );

                };


            // ==================================================
            // OPEN MODAL
            // ==================================================

            const openModal =
                function () {

                    modal.classList.add(
                        "is-open"
                    );

                    modal.setAttribute(
                        "aria-hidden",
                        "false"
                    );

                    document.body.classList.add(
                        "staff-sale-modal-open"
                    );


                    window.setTimeout(
                        function () {

                            if (nameInput) {

                                nameInput.focus();

                            }

                        },
                        100
                    );

                };


            // ==================================================
            // OPEN BUTTON
            // ==================================================

            openButton.addEventListener(
                "click",
                openModal
            );


            // ==================================================
            // CLOSE BUTTONS / OVERLAY
            // ==================================================

            modal
                .querySelectorAll(
                    "[data-close-staff-sale-modal]"
                )
                .forEach(
                    function (element) {

                        element.addEventListener(
                            "click",
                            closeModal
                        );

                    }
                );


            // ==================================================
            // ESCAPE KEY
            // ==================================================

            document.addEventListener(
                "keydown",
                function (event) {

                    if (
                        event.key === "Escape" &&
                        modal.classList.contains(
                            "is-open"
                        )
                    ) {

                        closeModal();

                    }

                }
            );

        })();
    </script>

<% } %>


<!-- ==========================================================
     STAFF PAYMENT MODE JAVASCRIPT

     Cash:
         isMobile = false
         Record Sale
         Existing popup

     Mpesa:
         isMobile = true
         Checkout
         /carts/:productId
========================================================== -->

<% if (isStaff && hasItems) { %>

    <script>
        (function () {

            const paymentMode =
                document.getElementById(
                    "staffPaymentMode"
                );

            if (!paymentMode) {
                return;
            }


            paymentMode.addEventListener(
                "change",
                function () {

                    const selectedMode =
                        paymentMode.value;


                    /*
                     * CASH
                     *
                     * isMobile = false
                     *
                     * Reload the cart page so the server
                     * renders the existing Record Sale
                     * button and staff-sale modal.
                     */
                    if (selectedMode === "cash") {

                        /*
                         * The payment mode must be persisted
                         * before the page is reloaded.
                         *
                         * This submits a small form to the cart
                         * update route.
                         */
                        const form =
                            document.createElement(
                                "form"
                            );

                        form.method = "POST";

                        form.action =
                            "/carts/payment-mode";


                        const input =
                            document.createElement(
                                "input"
                            );

                        input.type = "hidden";

                        input.name =
                            "isMobile";

                        input.value =
                            "false";


                        form.appendChild(
                            input
                        );

                        document.body.appendChild(
                            form
                        );

                        form.submit();

                        return;
                    }


                    /*
                     * MPESA
                     *
                     * isMobile = true
                     *
                     * Persist the payment mode, then reload
                     * so the server renders the normal Checkout
                     * link to /carts/:productId.
                     */
                    if (selectedMode === "mpesa") {

                        const form =
                            document.createElement(
                                "form"
                            );

                        form.method = "POST";

                        form.action =
                            "/carts/payment-mode";


                        const input =
                            document.createElement(
                                "input"
                            );

                        input.type = "hidden";

                        input.name =
                            "isMobile";

                        input.value =
                            "true";


                        form.appendChild(
                            input
                        );

                        document.body.appendChild(
                            form
                        );

                        form.submit();

                    }

                }
            );

        })();
    </script>

<% } %>