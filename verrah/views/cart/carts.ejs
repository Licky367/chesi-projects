<!-- ==========================================================
     verrah/views/cart/carts.ejs
     VERRAH COSMETICS
     CART PAGE
========================================================== -->

<%
const userRole =
    String(user?.role || "").toLowerCase();

const isStaff =
    ["admin", "staff"].includes(userRole);

const isAdmin =
    userRole === "admin";

const staffBranchUrl =
    isStaff && user?.assignedSubstation
        ? `/branch/${user.assignedSubstation}`
        : "/products";


const cartItems =
    Array.isArray(cart?.items)
        ? cart.items
        : [];


const hasItems =
    cartItems.length > 0;


const cartTotal =
    Number(
        total ??
        cart?.totalPrice ??
        0
    );


/*
 * Existing saved payment mode.
 *
 * true  = Mpesa
 * false = Cash
 */
const isMobile =
    cart?.isMobile === true;


const checkoutProductId =
    hasItems
        ? String(
            cartItems[0]?.product?._id ||
            cartItems[0]?.product ||
            cartItems[0]?.productId ||
            ""
        )
        : "";


/*
 * Substations supplied by the backend.
 *
 * Expected variable:
 *
 *     substations
 *
 * Each substation should contain:
 *
 *     _id
 *     name
 */
const availableSubstations =
    Array.isArray(substations)
        ? substations
        : [];
%>


<section class="shop-page cart-page">

    <!-- ======================================================
         HEADER
    ======================================================= -->

    <div class="cart-page-head">

        <div>

            <span class="cart-kicker">
                VERRAH COSMETICS
            </span>

            <h1 class="page-title">
                Your Cart
            </h1>

            <p class="page-subtitle">
                Products in your cart.
            </p>

        </div>


        <a
            href="<%= staffBranchUrl %>"
            class="secondary-btn"
        >

            <i class="fas fa-arrow-left"></i>

            Continue Shopping

        </a>

    </div>


    <!-- ======================================================
         ERROR
    ======================================================= -->

    <% if (typeof error !== "undefined" && error) { %>

        <div class="cart-alert cart-alert-error">

            <i class="fas fa-circle-exclamation"></i>

            <span>
                <%= error %>
            </span>

        </div>

    <% } %>


    <!-- ======================================================
         EMPTY CART
    ======================================================= -->

    <% if (!hasItems) { %>

        <div class="cart-empty">

            <div class="cart-empty-icon">

                <i class="fas fa-shopping-basket"></i>

            </div>


            <h2>
                Your Cart Is Empty
            </h2>


            <p>
                You have not added any products to your cart yet.
            </p>


            <a
                class="primary-btn"
                href="<%= staffBranchUrl %>"
            >

                <i class="fas fa-store"></i>

                Browse Products

            </a>

        </div>


    <% } else { %>


        <!-- ==================================================
             CART LAYOUT
        =================================================== -->

        <div class="cart-layout">


            <!-- ==================================================
                 CART ITEMS
            =================================================== -->

            <div class="cart-items-section">

                <div class="cart-section-heading">

                    <div>

                        <span class="cart-section-kicker">
                            YOUR SELECTION
                        </span>

                        <h2>
                            Cart Items
                        </h2>

                    </div>


                    <span class="cart-item-count">

                        <%= cartItems.length %>

                        <%= cartItems.length === 1
                            ? "item"
                            : "items"
                        %>

                    </span>

                </div>


                <div class="cart-list">

                    <% cartItems.forEach(item => { %>

                        <%
                            const productId =
                                String(
                                    item.product?._id ||
                                    item.product ||
                                    item.productId ||
                                    ""
                                );


                            const quantity =
                                Number(
                                    item.qty ??
                                    item.quantity ??
                                    0
                                );


                            const price =
                                Number(
                                    item.price || 0
                                );


                            const itemTotal =
                                price * quantity;


                            const productName =
                                item.name ||
                                item.product?.name ||
                                "Product";


                            const image =
                                item.image ||
                                item.product?.image ||
                                "";
                        %>


                        <div class="cart-item-card">

                            <a
                                href="/carts/<%= productId %>/details"
                                class="cart-item-link"
                            >

                                <div class="cart-item-image">

                                    <% if (image) { %>

                                        <img
                                            src="<%= image %>"
                                            alt="<%= productName %>"
                                        >

                                    <% } else { %>

                                        <div class="cart-item-placeholder">

                                            <i class="fas fa-box"></i>

                                        </div>

                                    <% } %>

                                </div>


                                <div class="cart-item-main">

                                    <div class="cart-item-topline">

                                        <span class="cart-item-label">
                                            Product
                                        </span>

                                        <i
                                            class="fas fa-chevron-right cart-item-arrow"
                                        ></i>

                                    </div>


                                    <h3>
                                        <%= productName %>
                                    </h3>


                                    <div class="cart-item-meta">

                                        <span>

                                            <i class="fas fa-layer-group"></i>

                                            Quantity:

                                            <strong>
                                                <%= quantity %>
                                            </strong>

                                        </span>


                                        <span>

                                            <i class="fas fa-tag"></i>

                                            Unit price:

                                            <strong>
                                                KSh
                                                <%= price.toLocaleString() %>
                                            </strong>

                                        </span>

                                    </div>


                                    <div class="cart-item-total">

                                        KSh
                                        <%= itemTotal.toLocaleString() %>

                                    </div>

                                </div>

                            </a>


                            <form
                                action="/carts/<%= productId %>/remove"
                                method="POST"
                                class="cart-remove-form"
                            >

                                <button
                                    type="submit"
                                    class="cart-remove-btn"
                                    aria-label="Remove <%= productName %>"
                                >

                                    <i class="fas fa-trash"></i>

                                </button>

                            </form>

                        </div>


                    <% }) %>

                </div>

            </div>


            <!-- ==================================================
                 ORDER SUMMARY
            =================================================== -->

            <aside class="cart-summary-card">

                <div class="cart-summary-head">

                    <span class="cart-section-kicker">
                        ORDER SUMMARY
                    </span>

                    <i class="fas fa-receipt"></i>

                </div>


                <div class="cart-summary-row">

                    <span>
                        Items
                    </span>

                    <strong>
                        <%= cartItems.length %>
                    </strong>

                </div>


                <div class="cart-summary-row cart-summary-total">

                    <span>
                        Total
                    </span>

                    <strong>
                        KSh
                        <%= cartTotal.toLocaleString() %>
                    </strong>

                </div>


                <!-- ==================================================
                     ADMIN / STAFF PAYMENT MODE
                =================================================== -->

                <% if (isStaff) { %>

                    <div class="cart-payment-mode">

                        <label
                            for="staffPaymentMode"
                            class="cart-payment-mode-label"
                        >
                            Payment mode:
                        </label>


                        <select
                            id="staffPaymentMode"
                            class="cart-payment-mode-select"
                        >

                            <option
                                value=""
                                disabled
                            >
                                Select payment mode
                            </option>


                            <option
                                value="cash"
                                <%= !isMobile ? "selected" : "" %>
                            >
                                Cash Payment
                            </option>


                            <option
                                value="mpesa"
                                <%= isMobile ? "selected" : "" %>
                            >
                                Mpesa Payment
                            </option>

                        </select>

                    </div>

                <% } %>


                <!-- ==================================================
                     CHECKOUT ACTION
                =================================================== -->

                <% if (isStaff) { %>


                    <% if (!isMobile) { %>

                        <button
                            type="button"
                            class="primary-btn cart-checkout-btn staff-sale-trigger"
                            id="openStaffSaleModal"
                        >

                            <i class="fas fa-cash-register"></i>

                            <span>
                                Record Sale
                            </span>

                        </button>


                    <% } else { %>

                        <a
                            class="primary-btn cart-checkout-btn"
                            id="staffMpesaCheckout"
                            href="/carts/<%= checkoutProductId %>"
                        >

                            <i class="fas fa-credit-card"></i>

                            <span>
                                Checkout
                            </span>

                        </a>

                    <% } %>


                <% } else { %>


                    <a
                        class="primary-btn cart-checkout-btn"
                        href="/carts/<%= checkoutProductId %>"
                    >

                        <i class="fas fa-credit-card"></i>

                        Checkout

                    </a>


                <% } %>


                <a
                    class="secondary-btn cart-continue-btn"
                    href="<%= staffBranchUrl %>"
                >

                    <i class="fas fa-store"></i>

                    Continue Shopping

                </a>

            </aside>

        </div>


    <% } %>

</section>


<!-- ==========================================================
     ADMIN / STAFF CASH SALE MODAL
========================================================== -->

<% if (isStaff && hasItems && !isMobile) { %>

    <div
        class="staff-sale-modal"
        id="staffSaleModal"
        aria-hidden="true"
    >

        <div
            class="staff-sale-modal-overlay"
            data-close-staff-sale-modal
        ></div>


        <div
            class="staff-sale-modal-content"
            role="dialog"
            aria-modal="true"
            aria-labelledby="staffSaleModalTitle"
        >


            <!-- ==================================================
                 MODAL HEADER
            =================================================== -->

            <div class="staff-sale-modal-header">

                <div class="staff-sale-modal-icon">

                    <i class="fas fa-user-tag"></i>

                </div>


                <div>

                    <span class="staff-sale-modal-kicker">
                        <%= isAdmin
                            ? "ADMIN SALE"
                            : "STAFF SALE"
                        %>
                    </span>

                    <h2 id="staffSaleModalTitle">
                        Record Sale
                    </h2>

                </div>


                <button
                    type="button"
                    class="staff-sale-modal-close"
                    data-close-staff-sale-modal
                    aria-label="Close"
                >

                    <i class="fas fa-times"></i>

                </button>

            </div>


            <!-- ==================================================
                 MODAL BODY
            =================================================== -->

            <div class="staff-sale-modal-body">

                <% if (isAdmin) { %>

                    <p class="staff-sale-modal-description">

                        Enter the sales name and select the
                        substation where the sale is recorded.

                    </p>

                <% } else { %>

                    <p class="staff-sale-modal-description">

                        Enter the name for this sale.

                    </p>

                <% } %>


                <form
                    action="/carts/staff-sale"
                    method="POST"
                    id="staffSaleForm"
                    class="staff-sale-form"
                >


                    <!-- ==================================================
                         PAYMENT MODE
                    =================================================== -->

                    <input
                        type="hidden"
                        name="isMobile"
                        value="false"
                    >


                    <!-- ==================================================
                         SALES NAME
                    =================================================== -->

                    <div class="staff-sale-field">

                        <label for="salesName">
                            Sales Name
                        </label>


                        <div class="staff-sale-input-wrap">

                            <i class="fas fa-user"></i>

                            <input
                                type="text"
                                id="salesName"
                                name="salesName"
                                maxlength="150"
                                autocomplete="name"
                                placeholder="Enter sales name"
                                required
                            >

                        </div>

                    </div>


                    <!-- ==================================================
                         ADMIN SUBSTATION
                    =================================================== -->

                    <% if (isAdmin) { %>

                        <div class="staff-sale-field">

                            <label for="salesSubstation">
                                Substation
                            </label>


                            <div class="staff-sale-input-wrap">

                                <i class="fas fa-location-dot"></i>


                                <select
                                    id="salesSubstation"
                                    name="salesSubstation"
                                    required
                                >

                                    <option
                                        value=""
                                        disabled
                                        selected
                                    >
                                        Select substation
                                    </option>


                                    <% availableSubstations.forEach(substation => { %>

                                        <%
                                            const substationId =
                                                String(
                                                    substation?._id ||
                                                    substation?.id ||
                                                    ""
                                                );


                                            const substationName =
                                                substation?.name ||
                                                "Unnamed Substation";
                                        %>

                                        <% if (substationId) { %>

                                            <option
                                                value="<%= substationId %>"
                                            >
                                                <%= substationName %>
                                            </option>

                                        <% } %>

                                    <% }) %>

                                </select>

                            </div>

                        </div>

                    <% } %>


                    <!-- ==================================================
                         SALE SUMMARY
                    =================================================== -->

                    <div class="staff-sale-summary">

                        <span>
                            Sale total
                        </span>

                        <strong>
                            KSh
                            <%= cartTotal.toLocaleString() %>
                        </strong>

                    </div>


                    <!-- ==================================================
                         MODAL ACTIONS
                    =================================================== -->

                    <div class="staff-sale-modal-actions">

                        <button
                            type="button"
                            class="secondary-btn staff-sale-cancel"
                            data-close-staff-sale-modal
                        >

                            Cancel

                        </button>


                        <button
                            type="submit"
                            class="primary-btn staff-sale-submit"
                        >

                            <i class="fas fa-check"></i>

                            Complete Sale

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>


    <!-- ==========================================================
         CASH SALE MODAL JAVASCRIPT
    =========================================================== -->

    <script>
        (function () {

            const modal =
                document.getElementById(
                    "staffSaleModal"
                );


            const openButton =
                document.getElementById(
                    "openStaffSaleModal"
                );


            const nameInput =
                document.getElementById(
                    "salesName"
                );


            if (!modal || !openButton) {
                return;
            }


            function closeModal() {

                modal.classList.remove(
                    "is-open"
                );


                modal.setAttribute(
                    "aria-hidden",
                    "true"
                );


                document.body.classList.remove(
                    "staff-sale-modal-open"
                );

            }


            function openModal() {

                modal.classList.add(
                    "is-open"
                );


                modal.setAttribute(
                    "aria-hidden",
                    "false"
                );


                document.body.classList.add(
                    "staff-sale-modal-open"
                );


                window.setTimeout(
                    function () {

                        if (nameInput) {

                            nameInput.focus();

                        }

                    },
                    100
                );

            }


            openButton.addEventListener(
                "click",
                openModal
            );


            modal
                .querySelectorAll(
                    "[data-close-staff-sale-modal]"
                )
                .forEach(
                    function (element) {

                        element.addEventListener(
                            "click",
                            closeModal
                        );

                    }
                );


            document.addEventListener(
                "keydown",
                function (event) {

                    if (
                        event.key === "Escape" &&
                        modal.classList.contains(
                            "is-open"
                        )
                    ) {

                        closeModal();

                    }

                }
            );

        })();
    </script>

<% } %>


<!-- ==========================================================
     ADMIN / STAFF PAYMENT MODE JAVASCRIPT
========================================================== -->

<% if (isStaff && hasItems) { %>

    <script>
        (function () {

            const paymentMode =
                document.getElementById(
                    "staffPaymentMode"
                );


            if (!paymentMode) {
                return;
            }


            paymentMode.addEventListener(
                "change",
                async function () {

                    const selectedMode =
                        paymentMode.value;


                    if (
                        selectedMode !== "cash" &&
                        selectedMode !== "mpesa"
                    ) {
                        return;
                    }


                    const newIsMobile =
                        selectedMode === "mpesa";


                    paymentMode.setAttribute(
                        "aria-busy",
                        "true"
                    );


                    try {

                        const response =
                            await fetch(
                                "/carts/payment-mode",
                                {
                                    method: "POST",

                                    headers: {
                                        "Content-Type":
                                            "application/x-www-form-urlencoded",

                                        "Accept":
                                            "application/json, text/plain, */*"
                                    },

                                    body:
                                        new URLSearchParams({
                                            isMobile:
                                                String(
                                                    newIsMobile
                                                )
                                        })
                                }
                            );


                        if (!response.ok) {

                            throw new Error(
                                "Unable to update payment mode."
                            );

                        }


                        window.location.reload();


                    } catch (error) {

                        console.error(
                            "Payment mode update error:",
                            error
                        );


                        paymentMode.value =
                            selectedMode;


                        paymentMode.removeAttribute(
                            "aria-busy"
                        );


                        alert(
                            error?.message ||
                            "Unable to update payment mode."
                        );

                    }

                }
            );

        })();
    </script>

<% } %>