<%
/* =========================================================
   VERRAH COSMETICS
   CART PAGE
========================================================= */

const currentUser =
    typeof user !== "undefined"
        ? user
        : (
            typeof currentUser !== "undefined"
                ? currentUser
                : (
                    typeof req !== "undefined"
                        ? req.user
                        : null
                )
        );

const isStaff =
    currentUser &&
    String(currentUser.role || "").toLowerCase() === "staff";

const cartItems =
    Array.isArray(cart?.items)
        ? cart.items
        : [];

const hasItems =
    cartItems.length > 0;

const cartTotal =
    Number(
        cart?.total ||
        cart?.cartTotal ||
        0
    );

const isMobile =
    cart?.isMobile !== false;


/* =========================================================
   FIRST PRODUCT ID
   Used by /cash/:id for M-PESA
========================================================= */

const checkoutProductId =
    cartItems.length > 0
        ? (
            cartItems[0]?.product?._id ||
            cartItems[0]?.product?.id ||
            cartItems[0]?.product ||
            ""
        )
        : "";


/* =========================================================
   STAFF ASSIGNED SUBSTATION
========================================================= */

const assignedSubstation =
    currentUser?.assignedSubstation || null;

const staffBranchUrl =
    assignedSubstation
        ? `/substations/${assignedSubstation}`
        : "/substations";
%>


<section class="shop-page cart-page">


    <!-- =====================================================
         PAGE HEADER
    ====================================================== -->

    <div class="cart-page-head">

        <div>

            <span class="cart-kicker">
                SHOPPING CART
            </span>

            <h1 class="page-title">
                Your Cart
            </h1>

            <p class="page-subtitle">
                Review your selected products before checkout.
            </p>

        </div>


        <% if (isStaff) { %>

            <a
                href="<%= staffBranchUrl %>"
                class="secondary-btn"
            >
                <i class="fas fa-store"></i>
                My Substation
            </a>

        <% } %>

    </div>



    <!-- =====================================================
         ERROR
    ====================================================== -->

    <% if (typeof error !== "undefined" && error) { %>

        <div class="cart-alert cart-alert-error">

            <i class="fas fa-exclamation-circle"></i>

            <span>
                <%= error %>
            </span>

        </div>

    <% } %>



    <!-- =====================================================
         SUCCESS
    ====================================================== -->

    <% if (typeof success !== "undefined" && success) { %>

        <div class="cart-alert cart-alert-success">

            <i class="fas fa-check-circle"></i>

            <span>
                <%= success %>
            </span>

        </div>

    <% } %>



    <% if (hasItems) { %>


        <!-- =================================================
             CART LAYOUT
        ================================================== -->

        <div class="cart-layout">


            <!-- =============================================
                 CART ITEMS
            ============================================== -->

            <section class="cart-items-section">


                <div class="cart-section-heading">

                    <div>

                        <span class="cart-section-kicker">
                            CART ITEMS
                        </span>

                        <h2>
                            Your Products
                        </h2>

                    </div>


                    <span class="cart-item-count">

                        <%= cartItems.length %>

                        <%= cartItems.length === 1
                            ? "item"
                            : "items"
                        %>

                    </span>

                </div>



                <div class="cart-list">


                    <% cartItems.forEach((item) => { %>

                        <%
                        const product =
                            item.product || {};

                        const productId =
                            product._id ||
                            product.id ||
                            item.product ||
                            "";

                        const productName =
                            product.name ||
                            item.name ||
                            "Product";

                        const quantity =
                            Number(
                                item.quantity || 1
                            );

                        const price =
                            Number(
                                item.price ||
                                product.price ||
                                0
                            );

                        const subtotal =
                            quantity * price;

                        const image =
                            product.image ||
                            item.image ||
                            "";
                        %>


                        <article class="cart-item-card">


                            <!-- =================================
                                 PRODUCT
                            ================================== -->

                            <a
                                href="/carts/<%= productId %>"
                                class="cart-item-link"
                            >


                                <div class="cart-item-image">

                                    <% if (image) { %>

                                        <img
                                            src="<%= image %>"
                                            alt="<%= productName %>"
                                        >

                                    <% } else { %>

                                        <i
                                            class="fas fa-box-open cart-item-placeholder"
                                        ></i>

                                    <% } %>

                                </div>



                                <div class="cart-item-main">


                                    <div class="cart-item-topline">

                                        <span class="cart-item-label">
                                            PRODUCT
                                        </span>

                                        <i
                                            class="fas fa-chevron-right cart-item-arrow"
                                        ></i>

                                    </div>


                                    <h3>
                                        <%= productName %>
                                    </h3>


                                    <div class="cart-item-meta">

                                        <span>

                                            <i class="fas fa-tag"></i>

                                            Price:

                                            <strong>
                                                KSh
                                                <%= price.toLocaleString() %>
                                            </strong>

                                        </span>


                                        <span>

                                            <i class="fas fa-layer-group"></i>

                                            Quantity:

                                            <strong>
                                                <%= quantity %>
                                            </strong>

                                        </span>

                                    </div>


                                    <div class="cart-item-total">

                                        KSh
                                        <%= subtotal.toLocaleString() %>

                                    </div>

                                </div>


                            </a>



                            <!-- =================================
                                 REMOVE
                            ================================== -->

                            <% if (!isStaff) { %>

                                <form
                                    action="/carts/<%= productId %>/remove"
                                    method="POST"
                                    class="cart-remove-form"
                                >

                                    <button
                                        type="submit"
                                        class="cart-remove-btn"
                                        title="Remove item"
                                    >

                                        <i class="fas fa-trash"></i>

                                    </button>

                                </form>

                            <% } %>


                        </article>


                    <% }) %>


                </div>


            </section>



            <!-- =================================================
                 CHECKOUT SUMMARY
            ================================================== -->

            <aside class="cart-summary-card">


                <div class="cart-summary-head">

                    <div>

                        <span class="cart-section-kicker">
                            CHECKOUT
                        </span>

                        <h2>
                            Order Summary
                        </h2>

                    </div>


                    <i class="fas fa-shopping-bag"></i>

                </div>



                <!-- =============================================
                     TOTAL
                ============================================== -->

                <div class="cart-summary-row">

                    <span>
                        Items
                    </span>

                    <strong>
                        <%= cartItems.length %>
                    </strong>

                </div>


                <div class="cart-summary-row cart-summary-total">

                    <span>
                        Total
                    </span>

                    <strong>
                        KSh
                        <%= cartTotal.toLocaleString() %>
                    </strong>

                </div>


                <p class="cart-summary-note">
                    Review your order carefully before completing
                    checkout.
                </p>



                <% if (isStaff) { %>


                    <!-- =========================================
                         STAFF PAYMENT MODE
                    ========================================== -->

                    <div class="staff-sale-field">

                        <label for="staffPaymentMode">
                            Payment Method
                        </label>


                        <div class="staff-sale-input-wrap">

                            <i
                                id="staffPaymentModeIcon"
                                class="<%= isMobile
                                    ? 'fas fa-mobile-alt'
                                    : 'fas fa-money-bill-wave'
                                %>"
                            ></i>


                            <select
                                id="staffPaymentMode"
                                class="checkout-substation-select"
                            >

                                <option
                                    value="cash"
                                    <%= !isMobile
                                        ? "selected"
                                        : "" %>
                                >
                                    Cash Payment
                                </option>


                                <option
                                    value="mpesa"
                                    <%= isMobile
                                        ? "selected"
                                        : "" %>
                                >
                                    M-PESA
                                </option>

                            </select>

                        </div>

                    </div>



                    <!-- =========================================
                         STAFF SALE TRIGGER

                         IMPORTANT:
                         Same popup opens for BOTH payment modes.
                    ========================================== -->

                    <button
                        type="button"
                        id="openStaffSaleModal"
                        class="staff-sale-trigger primary-btn"
                    >

                        <i
                            id="staffSaleTriggerIcon"
                            class="<%= isMobile
                                ? 'fas fa-mobile-alt'
                                : 'fas fa-cash-register'
                            %>"
                        ></i>


                        <span id="staffSaleTriggerText">

                            <%= isMobile
                                ? "Continue with M-PESA"
                                : "Complete Cash Sale"
                            %>

                        </span>

                    </button>


                <% } else { %>


                    <!-- =========================================
                         NORMAL CUSTOMER CHECKOUT
                    ========================================== -->

                    <a
                        href="/carts/<%= checkoutProductId %>"
                        class="primary-btn cart-checkout-btn"
                    >

                        <i class="fas fa-credit-card"></i>

                        Checkout

                    </a>


                <% } %>



                <!-- =============================================
                     BACK TO PRODUCTS
                ============================================== -->

                <a
                    href="/products"
                    class="cart-summary-back"
                >

                    <i class="fas fa-arrow-left"></i>

                    Continue Shopping

                </a>


            </aside>


        </div>


    <% } else { %>


        <!-- =================================================
             EMPTY CART
        ================================================== -->

        <div class="cart-empty">

            <div class="cart-empty-icon">

                <i class="fas fa-shopping-cart"></i>

            </div>


            <h2>
                Your cart is empty
            </h2>


            <p>
                You haven't added any products to your cart yet.
            </p>


            <a
                href="/products"
                class="primary-btn"
            >

                <i class="fas fa-store"></i>

                Browse Products

            </a>

        </div>


    <% } %>


</section>



<% if (isStaff && hasItems) { %>


<!-- =========================================================
     STAFF SALE POPUP MODAL

     CSS CLASSES MATCH THE PROVIDED CART CSS EXACTLY.

     CASH:
       /carts/staff-sales

     M-PESA:
       /cash/:id
========================================================== -->

<div
    id="staffSaleModal"
    class="staff-sale-modal"
    aria-hidden="true"
>


    <!-- =====================================================
         MODAL OVERLAY
    ====================================================== -->

    <div
        class="staff-sale-modal-overlay"
        id="staffSaleModalOverlay"
    ></div>



    <!-- =====================================================
         MODAL CONTENT
    ====================================================== -->

    <div
        class="staff-sale-modal-content"
        role="dialog"
        aria-modal="true"
        aria-labelledby="staffSaleModalTitle"
    >


        <!-- =================================================
             MODAL HEADER
        ================================================== -->

        <div class="staff-sale-modal-header">


            <div class="staff-sale-modal-icon">

                <i
                    id="staffSaleModalIcon"
                    class="<%= isMobile
                        ? 'fas fa-mobile-alt'
                        : 'fas fa-cash-register'
                    %>"
                ></i>

            </div>


            <div class="staff-sale-modal-header-content">

                <span class="staff-sale-modal-kicker">
                    STAFF CHECKOUT
                </span>


                <h2
                    id="staffSaleModalTitle"
                    class="staff-sale-modal-title"
                >
                    Confirm Sale
                </h2>

            </div>


            <button
                type="button"
                id="closeStaffSaleModal"
                class="staff-sale-modal-close"
                aria-label="Close"
            >

                <i class="fas fa-times"></i>

            </button>


        </div>



        <!-- =================================================
             MODAL BODY
        ================================================== -->

        <div class="staff-sale-modal-body">


            <p class="staff-sale-modal-description">

                Confirm the customer details and payment method
                before proceeding with this sale.

            </p>



            <!-- =============================================
                 SALE PREVIEW
            ============================================== -->

            <div class="staff-sale-preview">


                <div class="staff-sale-preview-card">

                    <span class="staff-sale-preview-label">
                        Payment Method
                    </span>


                    <strong
                        id="staffSalePaymentPreview"
                        class="staff-sale-preview-value"
                    >

                        <%= isMobile
                            ? "M-PESA"
                            : "Cash"
                        %>

                    </strong>

                </div>


                <div class="staff-sale-preview-card">

                    <span class="staff-sale-preview-label">
                        Total
                    </span>


                    <strong
                        class="staff-sale-preview-value sale-total"
                    >

                        KSh
                        <%= cartTotal.toLocaleString() %>

                    </strong>

                </div>


            </div>



            <!-- =================================================
                 STAFF SALE FORM
            ================================================== -->

            <form
                action="<%= isMobile
                    ? `/cash/${checkoutProductId}`
                    : `/carts/staff-sales`
                %>"
                method="POST"
                id="staffSaleForm"
                class="staff-sale-form"
            >


                <!-- =============================================
                     PAYMENT MODE
                ============================================== -->

                <input
                    type="hidden"
                    name="isMobile"
                    id="staffSaleIsMobile"
                    value="<%= isMobile
                        ? 'true'
                        : 'false'
                    %>"
                >



                <!-- =============================================
                     CUSTOMER NAME
                ============================================== -->

                <div class="staff-sale-field">


                    <label for="salesName">
                        Customer Name
                    </label>


                    <div class="staff-sale-input-wrap">

                        <i class="fas fa-user"></i>


                        <input
                            type="text"
                            id="salesName"
                            name="salesName"
                            placeholder="Enter customer name"
                            autocomplete="name"
                            required
                        >

                    </div>


                </div>



                <!-- =============================================
                     SALE PREVIEW ROWS
                ============================================== -->

                <div class="staff-sale-preview-row">

                    <span>
                        Number of Items
                    </span>


                    <strong>
                        <%= cartItems.length %>
                    </strong>

                </div>


                <div class="staff-sale-preview-row">

                    <span>
                        Order Total
                    </span>


                    <strong>
                        KSh
                        <%= cartTotal.toLocaleString() %>
                    </strong>

                </div>



                <!-- =============================================
                     MODAL ACTIONS
                ============================================== -->

                <div class="staff-sale-modal-actions">


                    <button
                        type="button"
                        id="cancelStaffSale"
                        class="secondary-btn"
                    >

                        <i class="fas fa-times"></i>

                        Cancel

                    </button>


                    <button
                        type="submit"
                        id="confirmStaffSale"
                        class="primary-btn staff-sale-submit"
                    >

                        <i
                            id="confirmStaffSaleIcon"
                            class="<%= isMobile
                                ? 'fas fa-mobile-alt'
                                : 'fas fa-check'
                            %>"
                        ></i>


                        <span id="confirmStaffSaleText">

                            <%= isMobile
                                ? "Continue to M-PESA"
                                : "Complete Cash Sale"
                            %>

                        </span>

                    </button>


                </div>


            </form>


        </div>



        <!-- =================================================
             MODAL FOOTER
        ================================================== -->

        <div class="staff-sale-modal-footer">

            <p class="staff-sale-modal-note">

                <i class="fas fa-info-circle"></i>

                <span id="staffSaleModalNote">

                    <%= isMobile
                        ? "You will continue to the M-PESA payment process."
                        : "This sale will be recorded as a cash payment."
                    %>

                </span>

            </p>

        </div>


    </div>

</div>



<!-- =========================================================
     STAFF CART JAVASCRIPT
========================================================== -->

<script>
(function () {

    "use strict";


    /* =====================================================
       ELEMENTS
    ====================================================== */

    const paymentMode =
        document.getElementById(
            "staffPaymentMode"
        );

    const paymentModeIcon =
        document.getElementById(
            "staffPaymentModeIcon"
        );

    const staffSaleModal =
        document.getElementById(
            "staffSaleModal"
        );

    const modalOverlay =
        document.getElementById(
            "staffSaleModalOverlay"
        );

    const openButton =
        document.getElementById(
            "openStaffSaleModal"
        );

    const closeButton =
        document.getElementById(
            "closeStaffSaleModal"
        );

    const cancelButton =
        document.getElementById(
            "cancelStaffSale"
        );

    const staffSaleForm =
        document.getElementById(
            "staffSaleForm"
        );

    const staffSaleIsMobile =
        document.getElementById(
            "staffSaleIsMobile"
        );

    const modalIcon =
        document.getElementById(
            "staffSaleModalIcon"
        );

    const paymentPreview =
        document.getElementById(
            "staffSalePaymentPreview"
        );

    const modalNote =
        document.getElementById(
            "staffSaleModalNote"
        );

    const triggerIcon =
        document.getElementById(
            "staffSaleTriggerIcon"
        );

    const triggerText =
        document.getElementById(
            "staffSaleTriggerText"
        );

    const confirmIcon =
        document.getElementById(
            "confirmStaffSaleIcon"
        );

    const confirmText =
        document.getElementById(
            "confirmStaffSaleText"
        );


    /* =====================================================
       ROUTES
    ====================================================== */

    const CASH_ACTION =
        "/carts/staff-sales";

    const MPESA_ACTION =
        "/cash/<%= checkoutProductId %>";


    /* =====================================================
       CURRENT PAYMENT MODE
    ====================================================== */

    let currentIsMobile =
        <%= isMobile ? "true" : "false" %>;


    /* =====================================================
       UPDATE UI
    ====================================================== */

    function updatePaymentUI(
        mobile
    ) {

        /* -----------------------------------------------
           FORM ACTION
        ----------------------------------------------- */

        if (staffSaleForm) {

            staffSaleForm.action =
                mobile
                    ? MPESA_ACTION
                    : CASH_ACTION;

        }


        /* -----------------------------------------------
           HIDDEN PAYMENT VALUE
        ----------------------------------------------- */

        if (staffSaleIsMobile) {

            staffSaleIsMobile.value =
                String(mobile);

        }


        /* -----------------------------------------------
           PAYMENT PREVIEW
        ----------------------------------------------- */

        if (paymentPreview) {

            paymentPreview.textContent =
                mobile
                    ? "M-PESA"
                    : "Cash";

        }


        /* -----------------------------------------------
           MODAL ICON
        ----------------------------------------------- */

        if (modalIcon) {

            modalIcon.className =
                mobile
                    ? "fas fa-mobile-alt"
                    : "fas fa-cash-register";

        }


        /* -----------------------------------------------
           PAYMENT SELECT ICON
        ----------------------------------------------- */

        if (paymentModeIcon) {

            paymentModeIcon.className =
                mobile
                    ? "fas fa-mobile-alt"
                    : "fas fa-money-bill-wave";

        }


        /* -----------------------------------------------
           TRIGGER ICON
        ----------------------------------------------- */

        if (triggerIcon) {

            triggerIcon.className =
                mobile
                    ? "fas fa-mobile-alt"
                    : "fas fa-cash-register";

        }


        /* -----------------------------------------------
           TRIGGER TEXT
        ----------------------------------------------- */

        if (triggerText) {

            triggerText.textContent =
                mobile
                    ? "Continue with M-PESA"
                    : "Complete Cash Sale";

        }


        /* -----------------------------------------------
           CONFIRM BUTTON ICON
        ----------------------------------------------- */

        if (confirmIcon) {

            confirmIcon.className =
                mobile
                    ? "fas fa-mobile-alt"
                    : "fas fa-check";

        }


        /* -----------------------------------------------
           CONFIRM BUTTON TEXT
        ----------------------------------------------- */

        if (confirmText) {

            confirmText.textContent =
                mobile
                    ? "Continue to M-PESA"
                    : "Complete Cash Sale";

        }


        /* -----------------------------------------------
           FOOTER NOTE
        ----------------------------------------------- */

        if (modalNote) {

            modalNote.textContent =
                mobile
                    ? "You will continue to the M-PESA payment process."
                    : "This sale will be recorded as a cash payment.";

        }

    }


    /* =====================================================
       INITIAL UI
    ====================================================== */

    updatePaymentUI(
        currentIsMobile
    );


    /* =====================================================
       PAYMENT MODE CHANGE
       
       IMPORTANT:
       The browser must NOT navigate to
       /carts/payment-mode because that endpoint
       returns JSON.

       Instead, update it using fetch().
    ====================================================== */

    if (paymentMode) {

        paymentMode.addEventListener(
            "change",
            async function () {

                const previousMode =
                    currentIsMobile;

                const newMode =
                    paymentMode.value === "mpesa";


                paymentMode.disabled =
                    true;


                try {

                    const response =
                        await fetch(
                            "/carts/payment-mode",
                            {
                                method: "POST",

                                headers: {
                                    "Content-Type":
                                        "application/x-www-form-urlencoded",

                                    "Accept":
                                        "application/json"
                                },

                                body:
                                    new URLSearchParams({
                                        isMobile:
                                            String(newMode)
                                    })
                            }
                        );


                    let result;


                    try {

                        result =
                            await response.json();

                    } catch (error) {

                        result = null;

                    }


                    if (
                        !response.ok ||
                        !result ||
                        result.ok !== true
                    ) {

                        throw new Error(
                            result?.error ||
                            "Unable to update payment method."
                        );

                    }


                    currentIsMobile =
                        Boolean(
                            result.isMobile
                        );


                    paymentMode.value =
                        currentIsMobile
                            ? "mpesa"
                            : "cash";


                    updatePaymentUI(
                        currentIsMobile
                    );


                } catch (error) {

                    currentIsMobile =
                        previousMode;


                    paymentMode.value =
                        previousMode
                            ? "mpesa"
                            : "cash";


                    updatePaymentUI(
                        previousMode
                    );


                    alert(
                        error?.message ||
                        "Unable to update payment method."
                    );

                } finally {

                    paymentMode.disabled =
                        false;

                }

            }
        );

    }


    /* =====================================================
       OPEN MODAL
    ====================================================== */

    function openStaffModal() {

        if (!staffSaleModal) {
            return;
        }


        updatePaymentUI(
            currentIsMobile
        );


        staffSaleModal.classList.add(
            "is-open"
        );


        staffSaleModal.setAttribute(
            "aria-hidden",
            "false"
        );


        document.body.classList.add(
            "staff-sale-modal-open"
        );


        const salesName =
            document.getElementById(
                "salesName"
            );


        if (salesName) {

            setTimeout(
                function () {

                    salesName.focus();

                },
                100
            );

        }

    }


    /* =====================================================
       CLOSE MODAL
    ====================================================== */

    function closeStaffModal() {

        if (!staffSaleModal) {
            return;
        }


        staffSaleModal.classList.remove(
            "is-open"
        );


        staffSaleModal.setAttribute(
            "aria-hidden",
            "true"
        );


        document.body.classList.remove(
            "staff-sale-modal-open"
        );

    }


    /* =====================================================
       OPEN BUTTON
    ====================================================== */

    if (openButton) {

        openButton.addEventListener(
            "click",
            openStaffModal
        );

    }


    /* =====================================================
       CLOSE BUTTON
    ====================================================== */

    if (closeButton) {

        closeButton.addEventListener(
            "click",
            closeStaffModal
        );

    }


    /* =====================================================
       CANCEL BUTTON
    ====================================================== */

    if (cancelButton) {

        cancelButton.addEventListener(
            "click",
            closeStaffModal
        );

    }


    /* =====================================================
       CLICK BACKDROP TO CLOSE
    ====================================================== */

    if (modalOverlay) {

        modalOverlay.addEventListener(
            "click",
            closeStaffModal
        );

    }


    /* =====================================================
       ESCAPE KEY
    ====================================================== */

    document.addEventListener(
        "keydown",
        function (event) {

            if (
                event.key === "Escape" &&
                staffSaleModal &&
                staffSaleModal.classList.contains(
                    "is-open"
                )
            ) {

                closeStaffModal();

            }

        }
    );


    /* =====================================================
       FINAL SUBMIT ROUTE CHECK
       
       CASH:
         /carts/staff-sales

       M-PESA:
         /cash/:id
    ====================================================== */

    if (staffSaleForm) {

        staffSaleForm.addEventListener(
            "submit",
            function () {

                const selectedIsMobile =
                    paymentMode &&
                    paymentMode.value === "mpesa";


                staffSaleForm.action =
                    selectedIsMobile
                        ? MPESA_ACTION
                        : CASH_ACTION;


                staffSaleIsMobile.value =
                    String(
                        selectedIsMobile
                    );

            }
        );

    }

})();
</script>

<% } %>