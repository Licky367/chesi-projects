<%
/* =========================================================
   VERRAH COSMETICS
   CARTS / CHECKOUT
========================================================= */

const isStaff =
    req?.user &&
    String(req.user.role || "").toLowerCase() === "staff";

const staffBranchUrl =
    req?.user?.assignedSubstation
        ? `/substations/${req.user.assignedSubstation}`
        : "/substations";

const cartItems =
    Array.isArray(cart?.items)
        ? cart.items
        : [];

const hasItems =
    cartItems.length > 0;

const cartTotal =
    Number(cart?.total || cart?.cartTotal || 0);

const isMobile =
    cart?.isMobile !== false;

const checkoutProductId =
    cartItems?.[0]?.product?._id ||
    cartItems?.[0]?.product ||
    "";
%>


<section class="shop-page cart-page">

    <!-- =====================================================
         CART HEADER
    ====================================================== -->

    <div class="cart-page-header">

        <div>

            <span class="cart-section-kicker">
                YOUR CART
            </span>

            <h1>
                Shopping Cart
            </h1>

            <p>
                Review your items before completing your order.
            </p>

        </div>

        <% if (isStaff) { %>

            <a
                href="<%= staffBranchUrl %>"
                class="secondary-btn"
            >
                <i class="fas fa-store"></i>
                My Substation
            </a>

        <% } %>

    </div>


    <!-- =====================================================
         ERROR / SUCCESS MESSAGE
    ====================================================== -->

    <% if (typeof error !== "undefined" && error) { %>

        <div class="cart-message cart-error">
            <i class="fas fa-exclamation-circle"></i>
            <span><%= error %></span>
        </div>

    <% } %>


    <% if (typeof success !== "undefined" && success) { %>

        <div class="cart-message cart-success">
            <i class="fas fa-check-circle"></i>
            <span><%= success %></span>
        </div>

    <% } %>


    <% if (hasItems) { %>

        <div class="cart-layout">

            <!-- =================================================
                 CART ITEMS
            ================================================== -->

            <div class="cart-items-section">

                <div class="cart-section-heading">

                    <div>

                        <span class="cart-section-kicker">
                            ITEMS
                        </span>

                        <h2>
                            Your Products
                        </h2>

                    </div>

                    <span class="cart-item-count">
                        <%= cartItems.length %>
                        <%= cartItems.length === 1 ? "item" : "items" %>
                    </span>

                </div>


                <div class="cart-items-list">

                    <% cartItems.forEach((item) => { %>

                        <%
                        const product =
                            item.product || {};

                        const productName =
                            product.name ||
                            item.name ||
                            "Product";

                        const quantity =
                            Number(item.quantity || 1);

                        const price =
                            Number(
                                item.price ||
                                product.price ||
                                0
                            );

                        const subtotal =
                            quantity * price;

                        const image =
                            product.image ||
                            item.image ||
                            "/images/product-placeholder.png";
                        %>


                        <article class="cart-item-card">

                            <div class="cart-item-image">

                                <img
                                    src="<%= image %>"
                                    alt="<%= productName %>"
                                >

                            </div>


                            <div class="cart-item-details">

                                <h3>
                                    <%= productName %>
                                </h3>

                                <p class="cart-item-price">
                                    KSh
                                    <%= price.toLocaleString() %>
                                </p>

                                <div class="cart-item-quantity">

                                    <span>
                                        Quantity:
                                    </span>

                                    <strong>
                                        <%= quantity %>
                                    </strong>

                                </div>

                            </div>


                            <div class="cart-item-total">

                                <span>
                                    Subtotal
                                </span>

                                <strong>
                                    KSh
                                    <%= subtotal.toLocaleString() %>
                                </strong>

                            </div>

                        </article>

                    <% }) %>

                </div>

            </div>


            <!-- =================================================
                 CHECKOUT CARD
            ================================================== -->

            <aside class="cart-checkout-card">

                <!-- =============================================
                     CHECKOUT HEADER
                ============================================== -->

                <div class="cart-checkout-heading">

                    <div>

                        <span class="cart-section-kicker">
                            CHECKOUT
                        </span>

                        <h2>
                            Complete your order
                        </h2>

                    </div>

                </div>


                <!-- =============================================
                     TOTAL
                ============================================== -->

                <div class="cart-total-row">

                    <span>
                        Cart Total
                    </span>

                    <strong>
                        KSh
                        <%= cartTotal.toLocaleString() %>
                    </strong>

                </div>


                <% if (isStaff) { %>

                    <!-- =========================================
                         STAFF PAYMENT MODE
                    ========================================== -->

                    <div class="cart-payment-mode">

                        <label
                            for="staffPaymentMode"
                            class="cart-payment-mode-label"
                        >
                            Payment Method
                        </label>

                        <select
                            id="staffPaymentMode"
                            class="cart-payment-mode-select"
                        >

                            <option
                                value="cash"
                                <%= !isMobile ? "selected" : "" %>
                            >
                                Cash Payment
                            </option>

                            <option
                                value="mpesa"
                                <%= isMobile ? "selected" : "" %>
                            >
                                M-PESA
                            </option>

                        </select>

                    </div>


                    <!-- =========================================
                         STAFF CHECKOUT BUTTON

                         Popup is used for BOTH:
                         - Cash
                         - M-PESA
                    ========================================== -->

                    <button
                        type="button"
                        id="openStaffSaleModal"
                        class="primary-btn cart-checkout-btn"
                    >
                        <i class="fas fa-shopping-cart"></i>

                        <span id="staffCheckoutButtonText">
                            <%= isMobile
                                ? "Continue with M-PESA"
                                : "Complete Cash Sale"
                            %>
                        </span>

                    </button>

                <% } else { %>

                    <!-- =========================================
                         NORMAL USER CHECKOUT
                    ========================================== -->

                    <a
                        href="/carts/<%= checkoutProductId %>"
                        class="primary-btn cart-checkout-btn"
                    >
                        <i class="fas fa-credit-card"></i>
                        Checkout
                    </a>

                <% } %>


                <!-- =============================================
                     CONTINUE SHOPPING
                ============================================== -->

                <a
                    href="/products"
                    class="secondary-btn cart-continue-btn"
                >
                    <i class="fas fa-arrow-left"></i>
                    Continue Shopping
                </a>

            </aside>

        </div>


    <% } else { %>

        <!-- =================================================
             EMPTY CART
        ================================================== -->

        <div class="cart-empty-state">

            <div class="cart-empty-icon">
                <i class="fas fa-shopping-cart"></i>
            </div>

            <h2>
                Your cart is empty
            </h2>

            <p>
                Add some products to your cart before checking out.
            </p>

            <a
                href="/products"
                class="primary-btn"
            >
                <i class="fas fa-store"></i>
                Browse Products
            </a>

        </div>

    <% } %>

</section>



<% if (isStaff && hasItems) { %>

<!-- =========================================================
     STAFF CHECKOUT POPUP MODAL
     
     The same popup is used for:
       CASH  -> /carts/staff-sales
       M-PESA -> /cash/:id
========================================================== -->

<div
    id="staffSaleModal"
    class="cart-modal-overlay"
    aria-hidden="true"
>

    <div
        class="cart-modal"
        role="dialog"
        aria-modal="true"
        aria-labelledby="staffSaleModalTitle"
    >

        <!-- =============================================
             MODAL HEADER
        ============================================== -->

        <div class="cart-modal-header">

            <div>

                <span class="cart-section-kicker">
                    STAFF CHECKOUT
                </span>

                <h2 id="staffSaleModalTitle">
                    Confirm Sale
                </h2>

            </div>

            <button
                type="button"
                id="closeStaffSaleModal"
                class="cart-modal-close"
                aria-label="Close"
            >
                <i class="fas fa-times"></i>
            </button>

        </div>


        <!-- =============================================
             PAYMENT SUMMARY
        ============================================== -->

        <div class="cart-modal-summary">

            <div class="cart-modal-summary-row">

                <span>
                    Payment Method
                </span>

                <strong id="paymentModeLabel">
                    <%= isMobile ? "M-PESA" : "Cash" %>
                </strong>

            </div>


            <div class="cart-modal-summary-row">

                <span>
                    Total Amount
                </span>

                <strong>
                    KSh
                    <%= cartTotal.toLocaleString() %>
                </strong>

            </div>

        </div>


        <!-- =============================================
             STAFF SALE FORM

             IMPORTANT:
             JavaScript changes the action according
             to the selected payment method.
        ============================================== -->

        <form
            action="<%= isMobile
                ? `/cash/${checkoutProductId}`
                : `/carts/staff-sales`
            %>"
            method="POST"
            id="staffSaleForm"
            class="staff-sale-form"
        >

            <input
                type="hidden"
                name="isMobile"
                id="staffSaleIsMobile"
                value="<%= isMobile ? 'true' : 'false' %>"
            >


            <!-- =========================================
                 CUSTOMER NAME
            ========================================== -->

            <div class="cart-form-group">

                <label for="salesName">
                    Customer Name
                </label>

                <input
                    type="text"
                    id="salesName"
                    name="salesName"
                    placeholder="Enter customer name"
                    autocomplete="name"
                    required
                >

            </div>


            <!-- =========================================
                 CONFIRMATION
            ========================================== -->

            <div class="cart-modal-notice">

                <i class="fas fa-info-circle"></i>

                <span>
                    <span id="paymentConfirmationText">
                        <%= isMobile
                            ? "Continue to M-PESA checkout."
                            : "This will record the sale as a cash payment."
                        %>
                    </span>
                </span>

            </div>


            <!-- =========================================
                 MODAL ACTIONS
            ========================================== -->

            <div class="cart-modal-actions">

                <button
                    type="button"
                    id="cancelStaffSale"
                    class="secondary-btn"
                >
                    Cancel
                </button>


                <button
                    type="submit"
                    id="confirmStaffSale"
                    class="primary-btn"
                >

                    <i
                        id="confirmStaffSaleIcon"
                        class="<%= isMobile
                            ? 'fas fa-mobile-alt'
                            : 'fas fa-check'
                        %>"
                    ></i>

                    <span id="confirmStaffSaleText">
                        <%= isMobile
                            ? "Continue to M-PESA"
                            : "Complete Cash Sale"
                        %>
                    </span>

                </button>

            </div>

        </form>

    </div>

</div>

<% } %>



<% if (isStaff && hasItems) { %>

<script>
(function () {

    "use strict";


    /* =====================================================
       ELEMENTS
    ====================================================== */

    const paymentMode =
        document.getElementById(
            "staffPaymentMode"
        );

    const staffSaleModal =
        document.getElementById(
            "staffSaleModal"
        );

    const openStaffSaleModal =
        document.getElementById(
            "openStaffSaleModal"
        );

    const closeStaffSaleModal =
        document.getElementById(
            "closeStaffSaleModal"
        );

    const cancelStaffSale =
        document.getElementById(
            "cancelStaffSale"
        );

    const staffSaleForm =
        document.getElementById(
            "staffSaleForm"
        );

    const staffSaleIsMobile =
        document.getElementById(
            "staffSaleIsMobile"
        );

    const paymentModeLabel =
        document.getElementById(
            "paymentModeLabel"
        );

    const paymentConfirmationText =
        document.getElementById(
            "paymentConfirmationText"
        );

    const confirmStaffSaleText =
        document.getElementById(
            "confirmStaffSaleText"
        );

    const confirmStaffSaleIcon =
        document.getElementById(
            "confirmStaffSaleIcon"
        );

    const staffCheckoutButtonText =
        document.getElementById(
            "staffCheckoutButtonText"
        );


    /* =====================================================
       ROUTES

       CASH:
         /carts/staff-sales

       M-PESA:
         /cash/:id
    ====================================================== */

    const CASH_ACTION =
        "/carts/staff-sales";

    const MPESA_ACTION =
        "/cash/<%= checkoutProductId %>";


    /* =====================================================
       PAYMENT MODE UI
    ====================================================== */

    function syncPaymentUI(isMobile) {

        if (staffSaleForm) {

            staffSaleForm.action =
                isMobile
                    ? MPESA_ACTION
                    : CASH_ACTION;

        }


        if (staffSaleIsMobile) {

            staffSaleIsMobile.value =
                String(isMobile);

        }


        if (paymentModeLabel) {

            paymentModeLabel.textContent =
                isMobile
                    ? "M-PESA"
                    : "Cash";

        }


        if (paymentConfirmationText) {

            paymentConfirmationText.textContent =
                isMobile
                    ? "Continue to M-PESA checkout."
                    : "This will record the sale as a cash payment.";

        }


        if (confirmStaffSaleText) {

            confirmStaffSaleText.textContent =
                isMobile
                    ? "Continue to M-PESA"
                    : "Complete Cash Sale";

        }


        if (confirmStaffSaleIcon) {

            confirmStaffSaleIcon.className =
                isMobile
                    ? "fas fa-mobile-alt"
                    : "fas fa-check";

        }


        if (staffCheckoutButtonText) {

            staffCheckoutButtonText.textContent =
                isMobile
                    ? "Continue with M-PESA"
                    : "Complete Cash Sale";

        }

    }


    /* =====================================================
       INITIAL PAYMENT MODE
    ====================================================== */

    let currentIsMobile =
        <%= isMobile ? "true" : "false" %>;

    syncPaymentUI(
        currentIsMobile
    );


    /* =====================================================
       CHANGE PAYMENT MODE

       IMPORTANT:
       /carts/payment-mode returns JSON.

       We therefore use fetch() instead of allowing the
       browser to navigate to that endpoint.
    ====================================================== */

    if (paymentMode) {

        paymentMode.addEventListener(
            "change",
            async function () {

                const newIsMobile =
                    paymentMode.value === "mpesa";

                const oldIsMobile =
                    currentIsMobile;


                paymentMode.disabled =
                    true;


                try {

                    const response =
                        await fetch(
                            "/carts/payment-mode",
                            {
                                method: "POST",

                                headers: {
                                    "Content-Type":
                                        "application/x-www-form-urlencoded",

                                    "Accept":
                                        "application/json"
                                },

                                body:
                                    new URLSearchParams({
                                        isMobile:
                                            String(
                                                newIsMobile
                                            )
                                    })
                            }
                        );


                    let result = null;


                    try {

                        result =
                            await response.json();

                    } catch (jsonError) {

                        result = null;

                    }


                    if (
                        !response.ok ||
                        !result ||
                        result.ok !== true
                    ) {

                        throw new Error(
                            result?.error ||
                            "Unable to update payment mode."
                        );

                    }


                    currentIsMobile =
                        Boolean(
                            result.isMobile
                        );


                    paymentMode.value =
                        currentIsMobile
                            ? "mpesa"
                            : "cash";


                    syncPaymentUI(
                        currentIsMobile
                    );


                } catch (error) {

                    currentIsMobile =
                        oldIsMobile;


                    paymentMode.value =
                        oldIsMobile
                            ? "mpesa"
                            : "cash";


                    syncPaymentUI(
                        oldIsMobile
                    );


                    alert(
                        error?.message ||
                        "Unable to change payment mode."
                    );

                } finally {

                    paymentMode.disabled =
                        false;

                }

            }
        );

    }


    /* =====================================================
       OPEN MODAL
    ====================================================== */

    function openModal() {

        if (!staffSaleModal) {
            return;
        }


        syncPaymentUI(
            currentIsMobile
        );


        staffSaleModal.classList.add(
            "active"
        );


        staffSaleModal.setAttribute(
            "aria-hidden",
            "false"
        );


        document.body.classList.add(
            "cart-modal-open"
        );


        const salesName =
            document.getElementById(
                "salesName"
            );


        if (salesName) {

            setTimeout(
                function () {

                    salesName.focus();

                },
                100
            );

        }

    }


    /* =====================================================
       CLOSE MODAL
    ====================================================== */

    function closeModal() {

        if (!staffSaleModal) {
            return;
        }


        staffSaleModal.classList.remove(
            "active"
        );


        staffSaleModal.setAttribute(
            "aria-hidden",
            "true"
        );


        document.body.classList.remove(
            "cart-modal-open"
        );

    }


    /* =====================================================
       OPEN BUTTON
    ====================================================== */

    if (openStaffSaleModal) {

        openStaffSaleModal.addEventListener(
            "click",
            openModal
        );

    }


    /* =====================================================
       CLOSE BUTTONS
    ====================================================== */

    if (closeStaffSaleModal) {

        closeStaffSaleModal.addEventListener(
            "click",
            closeModal
        );

    }


    if (cancelStaffSale) {

        cancelStaffSale.addEventListener(
            "click",
            closeModal
        );

    }


    /* =====================================================
       CLICK OUTSIDE MODAL
    ====================================================== */

    if (staffSaleModal) {

        staffSaleModal.addEventListener(
            "click",
            function (event) {

                if (
                    event.target ===
                    staffSaleModal
                ) {

                    closeModal();

                }

            }
        );

    }


    /* =====================================================
       ESC KEY
    ====================================================== */

    document.addEventListener(
        "keydown",
        function (event) {

            if (
                event.key === "Escape" &&
                staffSaleModal &&
                staffSaleModal.classList.contains(
                    "active"
                )
            ) {

                closeModal();

            }

        }
    );


    /* =====================================================
       FINAL FORM ACTION CHECK

       Ensures the correct route is used even if the
       payment selector was changed immediately before
       submitting the popup.
    ====================================================== */

    if (staffSaleForm) {

        staffSaleForm.addEventListener(
            "submit",
            function () {

                const selectedIsMobile =
                    paymentMode &&
                    paymentMode.value === "mpesa";


                syncPaymentUI(
                    selectedIsMobile
                );

            }
        );

    }

})();
</script>

<% } %>