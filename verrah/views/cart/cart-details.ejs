<section class="shop-page cart-page">

  <div class="product-back cart-back">
    <a href="/carts" class="secondary-btn">
      <i class="fas fa-arrow-left"></i>
      Cart
    </a>
  </div>

  <% if (typeof error !== "undefined" && error) { %>
    <div class="cart-alert cart-alert-error">
      <i class="fas fa-circle-exclamation"></i>
      <span><%= error %></span>
    </div>
  <% } %>

  <% if (item) { %>

    <div class="cart-detail-card">

      <div class="cart-detail-grid">

        <div class="cart-detail-image">
          <% if (item.image) { %>
            <img src="<%= item.image %>" alt="<%= item.name %>">
          <% } else { %>
            <div class="cart-detail-placeholder">
              <i class="fas fa-box"></i>
            </div>
          <% } %>
        </div>

        <div class="cart-detail-content">

          <span class="cart-detail-category">Cart Item</span>

          <h1><%= item.name %></h1>

          <div class="cart-detail-price">
            KSh <%= Number(item.price || 0).toLocaleString() %>
            <small>per unit</small>
          </div>

          <div class="cart-detail-meta-grid">

            <div class="cart-detail-meta-card">
              <span>Quantity</span>
              <strong><%= item.qty %></strong>
            </div>

            <div class="cart-detail-meta-card">
              <span>Item total</span>
              <strong>
                KSh <%= Number(
                  (item.price || 0) *
                  (item.qty || 0)
                ).toLocaleString() %>
              </strong>
            </div>

          </div>

          <form
            action="/carts/<%= item.productId %>/remove"
            method="POST"
            class="cart-remove-form"
          >
            <button
              class="secondary-btn cart-remove-btn"
              type="submit"
            >
              <i class="fas fa-trash"></i>
              Remove item
            </button>
          </form>

        </div>

      </div>

    </div>

  <% } else { %>

    <div class="cart-empty">

      <div class="cart-empty-icon">
        <i class="fas fa-box-open"></i>
      </div>

      <h2>Cart item not found</h2>

      <p>
        The selected cart item is no longer available.
      </p>

      <a href="/carts" class="primary-btn">
        <i class="fas fa-shopping-basket"></i>
        Back to Cart
      </a>

    </div>

  <% } %>

</section>