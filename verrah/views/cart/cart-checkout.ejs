<!-- =======================================================
         PICKUP SUBSTATION
    ======================================================== -->

    <fieldset
      class="payment-methods checkout-substation-fieldset"
    >

      <legend>
        Pickup substation
      </legend>


      <div class="checkout-substation-wrap">

        <label
          for="packageSubstation"
          class="checkout-substation-label"
        >

          <i class="fas fa-location-dot"></i>

          <% if (
            typeof user !== "undefined" &&
            user &&
            String(user.role || "").toLowerCase() === "staff"
          ) { %>

            Assigned pickup substation

          <% } else { %>

            Select where you want to collect your package

          <% } %>

        </label>


        <!-- =====================================================
             STAFF PICKUP SUBSTATION
        ====================================================== -->

        <% if (
          typeof user !== "undefined" &&
          user &&
          String(user.role || "").toLowerCase() === "staff"
        ) { %>

          <%
            const assignedSubstation =
              user.assignedSubstation || null;

            const assignedSubstationId =
              assignedSubstation &&
              typeof assignedSubstation === "object"
                ? (
                    assignedSubstation._id ||
                    assignedSubstation.id ||
                    ""
                  )
                : assignedSubstation || "";

            const assignedSubstationName =
              assignedSubstation &&
              typeof assignedSubstation === "object"
                ? (
                    assignedSubstation.name ||
                    assignedSubstation.location ||
                    String(assignedSubstationId || "")
                  )
                : (
                    substations &&
                    Array.isArray(substations)
                      ? (
                          substations.find(
                            function (substation) {
                              return String(
                                substation._id
                              ) === String(
                                assignedSubstationId
                              );
                            }
                          )?.name || String(
                            assignedSubstationId || ""
                          )
                        )
                      : String(
                          assignedSubstationId || ""
                        )
                  );

            const assignedSubstationLocation =
              assignedSubstation &&
              typeof assignedSubstation === "object"
                ? (
                    assignedSubstation.location || ""
                  )
                : (
                    substations &&
                    Array.isArray(substations)
                      ? (
                          substations.find(
                            function (substation) {
                              return String(
                                substation._id
                              ) === String(
                                assignedSubstationId
                              );
                            }
                          )?.location || ""
                        )
                      : ""
                  );
          %>


          <% if (assignedSubstationId) { %>

            <input
              type="hidden"
              name="packageSubstation"
              value="<%= assignedSubstationId %>"
            >


            <select
              id="packageSubstation"
              class="checkout-substation-select"
              disabled
            >

              <option
                value="<%= assignedSubstationId %>"
                selected
              >

                <%= assignedSubstationName %>

                <% if (assignedSubstationLocation) { %>
                  — <%= assignedSubstationLocation %>
                <% } %>

              </option>

            </select>


            <small class="checkout-substation-default">

              <i class="fas fa-lock"></i>

              Pickup is restricted to your assigned substation.

            </small>


          <% } else { %>

            <div class="checkout-substation-empty">

              <i class="fas fa-circle-exclamation"></i>

              You have not been assigned a pickup substation.

            </div>

          <% } %>


          <!-- ===================================================
               STAFF CUSTOMER NAME
          ==================================================== -->

          <div class="checkout-substation-wrap">

            <label
              for="salesName"
              class="checkout-substation-label"
            >

              <i class="fas fa-user"></i>

              Customer Name

            </label>


            <input
              type="text"
              id="salesName"
              name="salesName"
              class="checkout-substation-select"
              placeholder="Enter customer name"
              autocomplete="name"
              required
            >

          </div>


        <!-- =====================================================
             NON-STAFF PICKUP SUBSTATION
        ====================================================== -->

        <% } else { %>

          <select
            id="packageSubstation"
            name="packageSubstation"
            class="checkout-substation-select"
            required
          >

            <option value="">
              Select a substation
            </option>


            <% if (
              Array.isArray(substations) &&
              substations.length > 0
            ) { %>

              <% substations.forEach(function (substation) { %>

                <option
                  value="<%= substation._id %>"
                  <%= String(pickupStation || "") === String(substation._id)
                    ? "selected"
                    : "" %>
                >

                  <%= substation.name %>

                  <% if (substation.location) { %>
                    — <%= substation.location %>
                  <% } %>

                </option>

              <% }); %>

            <% } %>

          </select>


          <% if (
            Array.isArray(substations) &&
            substations.length === 0
          ) { %>

            <small class="checkout-substation-empty">

              <i class="fas fa-circle-exclamation"></i>

              No pickup substations are currently available.

            </small>

          <% } %>


          <% if (pickupStation) { %>

            <small class="checkout-substation-default">

              <i class="fas fa-circle-check"></i>

              Your previous pickup station is selected by default.

            </small>

          <% } %>

        <% } %>

      </div>

    </fieldset>