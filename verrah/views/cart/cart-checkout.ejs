<div class="cart-checkout-card">

  <!-- =========================================================
       CHECKOUT HEADER
  ========================================================== -->

  <div class="cart-checkout-heading">

    <div>

      <span class="cart-section-kicker">
        CHECKOUT
      </span>

      <h2>
        Complete your order
      </h2>

    </div>

    <i class="fas fa-bag-shopping"></i>

  </div>


  <!-- =========================================================
       CART TOTAL
  ========================================================== -->

  <div class="cart-total-line">

    <span>
      Cart total
    </span>

    <strong>
      KSh <%= Number(total || 0).toLocaleString() %>
    </strong>

  </div>


  <!-- =========================================================
       CHECKOUT FORM
  ========================================================== -->

  <form
    action="/carts/checkout"
    method="POST"
    class="checkout-form"
    id="checkoutForm"
  >

    <!-- PRODUCT ID -->

    <input
      type="hidden"
      name="productId"
      value="<%= item.productId || item.product?._id || item.product || '' %>"
    >


    <!-- =======================================================
         PICKUP SUBSTATION
    ======================================================== -->

    <fieldset class="payment-methods checkout-substation-fieldset">

      <legend>
        Pickup substation
      </legend>

      <div class="checkout-substation-wrap">

        <label
          for="packageSubstation"
          class="checkout-substation-label"
        >

          <i class="fas fa-location-dot"></i>

          <% if (
            typeof user !== "undefined" &&
            user &&
            String(user.role || "").toLowerCase() === "staff"
          ) { %>

            Assigned pickup substation

          <% } else { %>

            Select where you want to collect your package

          <% } %>

        </label>


        <!-- =====================================================
             STAFF PICKUP SUBSTATION
        ====================================================== -->

        <% if (
          typeof user !== "undefined" &&
          user &&
          String(user.role || "").toLowerCase() === "staff"
        ) { %>

          <%
            const assignedSubstation =
              user.assignedSubstation || null;

            const assignedSubstationId =
              assignedSubstation &&
              typeof assignedSubstation === "object"
                ? (
                    assignedSubstation._id ||
                    assignedSubstation.id ||
                    ""
                  )
                : assignedSubstation || "";

            const assignedSubstationName =
              assignedSubstation &&
              typeof assignedSubstation === "object"
                ? (
                    assignedSubstation.name ||
                    assignedSubstation.location ||
                    String(assignedSubstationId || "")
                  )
                : (
                    substations &&
                    Array.isArray(substations)
                      ? (
                          substations.find(
                            function (substation) {
                              return String(substation._id) ===
                                String(assignedSubstationId);
                            }
                          )?.name ||
                          String(assignedSubstationId || "")
                        )
                      : String(assignedSubstationId || "")
                  );

            const assignedSubstationLocation =
              assignedSubstation &&
              typeof assignedSubstation === "object"
                ? (
                    assignedSubstation.location || ""
                  )
                : (
                    substations &&
                    Array.isArray(substations)
                      ? (
                          substations.find(
                            function (substation) {
                              return String(substation._id) ===
                                String(assignedSubstationId);
                            }
                          )?.location || ""
                        )
                      : ""
                  );
          %>


          <% if (assignedSubstationId) { %>

            <input
              type="hidden"
              name="packageSubstation"
              value="<%= assignedSubstationId %>"
            >

            <select
              id="packageSubstation"
              class="checkout-substation-select"
              disabled
            >

              <option
                value="<%= assignedSubstationId %>"
                selected
              >

                <%= assignedSubstationName %>

                <% if (assignedSubstationLocation) { %>
                  — <%= assignedSubstationLocation %>
                <% } %>

              </option>

            </select>


            <small class="checkout-substation-default">

              <i class="fas fa-lock"></i>

              Pickup is restricted to your assigned substation.

            </small>


          <% } else { %>

            <div class="checkout-substation-empty">

              <i class="fas fa-circle-exclamation"></i>

              You have not been assigned a pickup substation.

            </div>

          <% } %>


          <!-- ===================================================
               CUSTOMER NAME / SALES NAME
          ==================================================== -->

          <div class="checkout-substation-wrap">

            <label
              for="salesName"
              class="checkout-substation-label"
            >

              <i class="fas fa-user"></i>

              Customer Name

            </label>


            <input
              type="text"
              id="salesName"
              name="salesName"
              class="checkout-substation-select"
              placeholder="Enter customer name"
              autocomplete="name"
              required
            >

          </div>


        <!-- =====================================================
             NON-STAFF PICKUP SUBSTATION
        ====================================================== -->

        <% } else { %>

          <select
            id="packageSubstation"
            name="packageSubstation"
            class="checkout-substation-select"
            required
          >

            <option value="">
              Select a substation
            </option>


            <% if (
              Array.isArray(substations) &&
              substations.length > 0
            ) { %>

              <% substations.forEach(function (substation) { %>

                <option
                  value="<%= substation._id %>"
                  <%= String(pickupStation || "") ===
                      String(substation._id)
                    ? "selected"
                    : "" %>
                >

                  <%= substation.name %>

                  <% if (substation.location) { %>
                    — <%= substation.location %>
                  <% } %>

                </option>

              <% }); %>

            <% } %>

          </select>


          <% if (
            Array.isArray(substations) &&
            substations.length === 0
          ) { %>

            <small class="checkout-substation-empty">

              <i class="fas fa-circle-exclamation"></i>

              No pickup substations are currently available.

            </small>

          <% } %>


          <% if (pickupStation) { %>

            <small class="checkout-substation-default">

              <i class="fas fa-circle-check"></i>

              Your previous pickup station is selected by default.

            </small>

          <% } %>

        <% } %>

      </div>

    </fieldset>


    <!-- =======================================================
         PAYMENT MODE
    ======================================================== -->

    <fieldset class="payment-methods checkout-payment-fieldset">

      <legend>
        Payment mode
      </legend>


      <div class="checkout-payment-wrap">

        <label
          for="paymentMethod"
          class="checkout-payment-label"
        >

          <i class="fas fa-money-bill-wave"></i>

          Select how you want to pay

        </label>


        <!-- =====================================================
             PAYMENT MODE SELECT
        ====================================================== -->

        <select
          id="paymentMethod"
          name="paymentMethod"
          class="checkout-payment-select"
          required
        >

          <!-- DEFAULT: NOTHING SELECTED -->

          <option
            value=""
            selected
            disabled
          >
            Select payment mode
          </option>


          <!-- M-PESA -->

          <option value="mpesa">
            M-Pesa
          </option>


          <!-- CASH -->

          <option value="cash">
            Cash
          </option>

        </select>


        <!-- =====================================================
             M-PESA PHONE NUMBER
        ====================================================== -->

        <div
          id="phoneField"
          class="phone-field"
        >

          <label for="phoneNumber">

            <i class="fas fa-mobile-screen-button"></i>

            M-Pesa phone number

          </label>


          <input
            type="tel"
            name="phoneNumber"
            id="phoneNumber"
            placeholder="0712345678"
            inputmode="numeric"
            autocomplete="tel"
            disabled
          >

        </div>

      </div>

    </fieldset>


    <!-- =======================================================
         CONTINUE CHECKOUT
    ======================================================== -->

    <button
      class="primary-btn cart-continue-btn"
      type="submit"
    >

      <i class="fas fa-check-circle"></i>

      Continue Checkout

    </button>

  </form>

</div>


<!-- ===========================================================
     CHECKOUT MESSAGE POPUP MODAL
============================================================ -->

<div
  id="checkoutMessageModal"
  class="checkout-message-modal"
  aria-hidden="true"
>

  <div
    class="checkout-message-overlay"
    id="checkoutMessageOverlay"
  ></div>


  <div
    class="checkout-message-box"
    role="dialog"
    aria-modal="true"
    aria-labelledby="checkoutMessageTitle"
  >

    <button
      type="button"
      class="checkout-message-close"
      id="checkoutMessageClose"
      aria-label="Close"
    >

      <i class="fas fa-xmark"></i>

    </button>


    <div
      class="checkout-message-icon"
      id="checkoutMessageIcon"
    >

      <i class="fas fa-circle-exclamation"></i>

    </div>


    <h3 id="checkoutMessageTitle">
      Checkout Error
    </h3>


    <p id="checkoutMessageText">
      Something went wrong.
    </p>


    <button
      type="button"
      class="checkout-message-button"
      id="checkoutMessageButton"
    >

      OK

    </button>

  </div>

</div>


<!-- ===========================================================
     CHECKOUT JAVASCRIPT
============================================================ -->

<script>
(function () {

  const form =
    document.getElementById("checkoutForm");

  const phoneField =
    document.getElementById("phoneField");

  const phoneInput =
    document.getElementById("phoneNumber");

  const paymentMethod =
    document.getElementById("paymentMethod");


  /* =========================================================
     POPUP MODAL ELEMENTS
  ========================================================== */

  const modal =
    document.getElementById("checkoutMessageModal");

  const modalOverlay =
    document.getElementById("checkoutMessageOverlay");

  const modalClose =
    document.getElementById("checkoutMessageClose");

  const modalButton =
    document.getElementById("checkoutMessageButton");

  const modalTitle =
    document.getElementById("checkoutMessageTitle");

  const modalText =
    document.getElementById("checkoutMessageText");

  const modalIcon =
    document.getElementById("checkoutMessageIcon");


  /* =========================================================
     SHOW POPUP
  ========================================================== */

  function showCheckoutMessage(
    message,
    type,
    title
  ) {

    if (!modal) {
      return;
    }


    modal.classList.remove(
      "checkout-message-success",
      "checkout-message-error"
    );


    if (type === "success") {

      modal.classList.add(
        "checkout-message-success"
      );

      modalTitle.textContent =
        title || "Success";

      modalIcon.innerHTML =
        '<i class="fas fa-circle-check"></i>';

    } else {

      modal.classList.add(
        "checkout-message-error"
      );

      modalTitle.textContent =
        title || "Checkout Error";

      modalIcon.innerHTML =
        '<i class="fas fa-circle-exclamation"></i>';

    }


    modalText.textContent =
      message || "Something went wrong.";


    modal.classList.add("show");

    modal.setAttribute(
      "aria-hidden",
      "false"
    );


    document.body.classList.add(
      "checkout-message-modal-open"
    );

  }


  /* =========================================================
     CLOSE POPUP
  ========================================================== */

  function closeCheckoutMessage() {

    if (!modal) {
      return;
    }


    modal.classList.remove("show");

    modal.setAttribute(
      "aria-hidden",
      "true"
    );


    document.body.classList.remove(
      "checkout-message-modal-open"
    );

  }


  /* =========================================================
     POPUP EVENTS
  ========================================================== */

  if (modalClose) {

    modalClose.addEventListener(
      "click",
      closeCheckoutMessage
    );

  }


  if (modalButton) {

    modalButton.addEventListener(
      "click",
      closeCheckoutMessage
    );

  }


  if (modalOverlay) {

    modalOverlay.addEventListener(
      "click",
      closeCheckoutMessage
    );

  }


  document.addEventListener(
    "keydown",
    function (event) {

      if (
        event.key === "Escape" &&
        modal &&
        modal.classList.contains("show")
      ) {

        closeCheckoutMessage();

      }

    }
  );


  /* =========================================================
     STOP SAFELY IF REQUIRED ELEMENTS ARE MISSING
  ========================================================== */

  if (
    !form ||
    !phoneField ||
    !phoneInput ||
    !paymentMethod
  ) {

    return;

  }


  /* =========================================================
     UPDATE PAYMENT MODE
  ========================================================== */

  function updatePaymentMode() {

    const selected =
      paymentMethod.value;


    const mpesaSelected =
      selected === "mpesa";


    /* Show phone field only for M-Pesa */

    phoneField.classList.toggle(
      "show",
      mpesaSelected
    );


    /* Phone is required only for M-Pesa */

    phoneInput.required =
      mpesaSelected;


    /* Disable phone input when not using M-Pesa */

    phoneInput.disabled =
      !mpesaSelected;


    /* Clear phone number when switching to Cash */

    if (!mpesaSelected) {

      phoneInput.value = "";

    }

  }


  /* =========================================================
     PAYMENT MODE CHANGE
  ========================================================== */

  paymentMethod.addEventListener(
    "change",
    updatePaymentMode
  );


  /* =========================================================
     FORM VALIDATION
  ========================================================== */

  form.addEventListener(
    "submit",
    function (event) {

      /* -----------------------------------------------
         PICKUP SUBSTATION
      ------------------------------------------------ */

      const substation =
        document.getElementById(
          "packageSubstation"
        );


      if (!substation) {

        event.preventDefault();


        showCheckoutMessage(
          "A pickup substation could not be determined.",
          "error",
          "Pickup Substation Required"
        );


        return;

      }


      const staff =
        <%= JSON.stringify(
          typeof user !== "undefined" &&
          user &&
          String(user.role || "").toLowerCase() === "staff"
        ) %>;


      /* -----------------------------------------------
         NON-STAFF SUBSTATION
      ------------------------------------------------ */

      if (!staff && !substation.value) {

        event.preventDefault();


        showCheckoutMessage(
          "Please select the substation where you want to collect your package.",
          "error",
          "Pickup Substation Required"
        );


        return;

      }


      /* -----------------------------------------------
         STAFF SUBSTATION
      ------------------------------------------------ */

      if (
        staff &&
        !document.querySelector(
          'input[name="packageSubstation"]'
        )?.value
      ) {

        event.preventDefault();


        showCheckoutMessage(
          "You do not have an assigned pickup substation.",
          "error",
          "Pickup Substation Required"
        );


        return;

      }


      /* -----------------------------------------------
         STAFF CUSTOMER NAME
      ------------------------------------------------ */

      if (staff) {

        const salesName =
          document.getElementById("salesName");


        if (
          !salesName ||
          !salesName.value.trim()
        ) {

          event.preventDefault();


          showCheckoutMessage(
            "Please enter the customer's name.",
            "error",
            "Customer Name Required"
          );


          if (salesName) {

            salesName.focus();

          }


          return;

        }

      }


      /* -----------------------------------------------
         PAYMENT MODE
      ------------------------------------------------ */

      const selectedPayment =
        paymentMethod.value;


      if (!selectedPayment) {

        event.preventDefault();


        showCheckoutMessage(
          "Please select either M-Pesa or Cash before continuing.",
          "error",
          "Payment Mode Required"
        );


        paymentMethod.focus();


        return;

      }


      /* -----------------------------------------------
         M-PESA PHONE NUMBER
      ------------------------------------------------ */

      if (selectedPayment === "mpesa") {

        const phone =
          phoneInput.value.trim();


        if (!phone) {

          event.preventDefault();


          showCheckoutMessage(
            "Please enter the M-Pesa phone number that should receive the STK Push.",
            "error",
            "M-Pesa Number Required"
          );


          phoneInput.focus();


          return;

        }

      }

    }
  );


  /* =========================================================
     INITIAL STATE
  ========================================================== */

  updatePaymentMode();


  /* =========================================================
     SERVER-SIDE ERROR
  ========================================================== */

  <% if (typeof error !== "undefined" && error) { %>

    showCheckoutMessage(
      <%- JSON.stringify(error) %>,
      "error",
      "Checkout Error"
    );

  <% } %>


  /* =========================================================
     SERVER-SIDE SUCCESS
  ========================================================== */

  <% if (typeof success !== "undefined" && success) { %>

    showCheckoutMessage(
      <%- JSON.stringify(success) %>,
      "success",
      "Checkout Successful"
    );

  <% } %>

})();
</script>