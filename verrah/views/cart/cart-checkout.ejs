<!-- ==========================================================
     verrah/views/cart/cart-checkout.ejs
     VERRAH COSMETICS
     CHECKOUT
========================================================== -->

<%
    const productId =
        String(
            item?.product?._id ||
            item?.product ||
            item?.productId ||
            ""
        );

    const quantity =
        Number(
            item?.quantity ||
            item?.qty ||
            0
        );

    const price =
        Number(
            item?.price ||
            0
        );

    const itemTotal =
        quantity * price;

    const productName =
        item?.name ||
        item?.product?.name ||
        "Product";

    const image =
        item?.image ||
        item?.product?.image ||
        "";
%>


<div class="cart-checkout-card">

    <!-- ======================================================
         HEADER
    ======================================================= -->

    <div class="cart-checkout-heading">

        <div>

            <span class="cart-section-kicker">
                CHECKOUT
            </span>

            <h2>
                Complete your order
            </h2>

        </div>

        <i class="fas fa-bag-shopping"></i>

    </div>


    <!-- ======================================================
         ERROR
    ======================================================= -->

    <% if (error) { %>

        <div class="checkout-error">

            <i class="fas fa-circle-exclamation"></i>

            <span>
                <%= error %>
            </span>

        </div>

    <% } %>


    <!-- ======================================================
         PRODUCT SUMMARY
    ======================================================= -->

    <div class="checkout-product-summary">

        <div class="checkout-product-image">

            <% if (image) { %>

                <img
                    src="<%= image %>"
                    alt="<%= productName %>"
                >

            <% } else { %>

                <div class="checkout-product-placeholder">
                    <i class="fas fa-box"></i>
                </div>

            <% } %>

        </div>


        <div class="checkout-product-info">

            <span>
                Product
            </span>

            <h3>
                <%= productName %>
            </h3>

            <p>
                Quantity:
                <strong>
                    <%= quantity %>
                </strong>
            </p>

            <p>
                Unit price:
                <strong>
                    KSh
                    <%= price.toLocaleString() %>
                </strong>
            </p>

        </div>


        <div class="checkout-product-total">

            KSh
            <%= itemTotal.toLocaleString() %>

        </div>

    </div>


    <!-- ======================================================
         CART TOTAL
    ======================================================= -->

    <div class="cart-total-line">

        <span>
            Cart total
        </span>

        <strong>
            KSh
            <%= Number(
                total || 0
            ).toLocaleString() %>
        </strong>

    </div>


    <!-- ======================================================
         CHECKOUT FORM
    ======================================================= -->

    <form
        action="/carts/checkout"
        method="POST"
        class="checkout-form"
        id="checkoutForm"
    >

        <input
            type="hidden"
            name="productId"
            value="<%= productId %>"
        >


        <!-- ==================================================
             PICKUP SUBSTATION
        =================================================== -->

        <fieldset
            class="payment-methods checkout-substation-fieldset"
        >

            <legend>
                Pickup substation
            </legend>


            <div class="checkout-substation-wrap">

                <label
                    for="packageSubstation"
                    class="checkout-substation-label"
                >
                    <i class="fas fa-location-dot"></i>

                    Select where you want to collect
                    your package
                </label>


                <select
                    id="packageSubstation"
                    name="packageSubstation"
                    class="checkout-substation-select"
                    required
                >

                    <option value="">
                        Select a substation
                    </option>


                    <% if (
                        Array.isArray(substations) &&
                        substations.length
                    ) { %>

                        <% substations.forEach(
                            function(substation)
                        { %>

                            <option
                                value="<%= substation._id %>"
                                <%= String(
                                    pickupStation || ""
                                ) === String(
                                    substation._id
                                )
                                    ? "selected"
                                    : ""
                                %>
                            >

                                <%= substation.name %>

                                <% if (
                                    substation.location
                                ) { %>

                                    —
                                    <%= substation.location %>

                                <% } %>

                            </option>

                        <% }); %>

                    <% } %>

                </select>


                <% if (
                    !Array.isArray(substations) ||
                    !substations.length
                ) { %>

                    <small class="checkout-substation-empty">

                        <i class="fas fa-circle-exclamation"></i>

                        No pickup substations are
                        currently available.

                    </small>

                <% } %>


                <% if (pickupStation) { %>

                    <small class="checkout-substation-default">

                        <i class="fas fa-circle-check"></i>

                        Your previous pickup station
                        is selected by default.

                    </small>

                <% } %>

            </div>

        </fieldset>


        <!-- ==================================================
             PAYMENT METHOD
        =================================================== -->

        <fieldset class="payment-methods">

            <legend>
                Payment method
            </legend>


            <!-- ==================================================
                 M-PESA
            =================================================== -->

            <label
                class="payment-choice"
                for="paymentMpesa"
            >

                <input
                    type="radio"
                    name="paymentMethod"
                    id="paymentMpesa"
                    value="mpesa"
                    required
                >

                <span class="payment-choice-icon">
                    <i class="fas fa-mobile-screen-button"></i>
                </span>

                <span class="payment-choice-copy">

                    <strong>
                        Pay now with M-Pesa
                    </strong>

                    <small>
                        An STK Push will be sent
                        to your phone.
                    </small>

                </span>

            </label>


            <!-- ==================================================
                 M-PESA PHONE
            =================================================== -->

            <div
                id="phoneField"
                class="phone-field"
            >

                <label
                    for="phoneNumber"
                >
                    M-Pesa phone number
                </label>

                <input
                    type="tel"
                    id="phoneNumber"
                    name="phoneNumber"
                    inputmode="tel"
                    autocomplete="tel"
                    placeholder="0712345678"
                >

            </div>


            <!-- ==================================================
                 PAY ON DELIVERY
            =================================================== -->

            <label
                class="payment-choice"
                for="paymentDelivery"
            >

                <input
                    type="radio"
                    name="paymentMethod"
                    id="paymentDelivery"
                    value="pay_on_delivery"
                >

                <span class="payment-choice-icon">
                    <i class="fas fa-truck"></i>
                </span>

                <span class="payment-choice-copy">

                    <strong>
                        Pay on delivery
                    </strong>

                    <small>
                        Pay when your package is delivered.
                    </small>

                </span>

            </label>

        </fieldset>


        <!-- ==================================================
             SUBMIT
        =================================================== -->

        <button
            type="submit"
            class="primary-btn checkout-submit-btn"
        >

            <i class="fas fa-check"></i>

            Complete Checkout

        </button>


        <a
            href="/carts"
            class="secondary-btn checkout-back-btn"
        >

            <i class="fas fa-arrow-left"></i>

            Back to Cart

        </a>

    </form>

</div>


<script>

(function () {

    const mpesa =
        document.getElementById(
            "paymentMpesa"
        );

    const delivery =
        document.getElementById(
            "paymentDelivery"
        );

    const phoneField =
        document.getElementById(
            "phoneField"
        );

    const phone =
        document.getElementById(
            "phoneNumber"
        );

    const form =
        document.getElementById(
            "checkoutForm"
        );


    function updatePhoneField() {

        const isMpesa =
            mpesa &&
            mpesa.checked;


        if (!phoneField || !phone) {
            return;
        }


        phoneField.style.display =
            isMpesa
                ? ""
                : "none";


        phone.required =
            isMpesa;


        phone.disabled =
            !isMpesa;

    }


    if (mpesa) {
        mpesa.addEventListener(
            "change",
            updatePhoneField
        );
    }


    if (delivery) {
        delivery.addEventListener(
            "change",
            updatePhoneField
        );
    }


    if (form) {

        form.addEventListener(
            "submit",
            function (event) {

                const method =
                    document.querySelector(
                        'input[name="paymentMethod"]:checked'
                    );


                const station =
                    document.getElementById(
                        "packageSubstation"
                    );


                if (
                    !station ||
                    !station.value
                ) {
                    event.preventDefault();

                    alert(
                        "Please select a pickup substation."
                    );

                    return;
                }


                if (
                    !method
                ) {
                    event.preventDefault();

                    alert(
                        "Please select a payment method."
                    );

                    return;
                }


                if (
                    method.value ===
                    "mpesa"
                ) {

                    const value =
                        String(
                            phone?.value ||
                            ""
                        ).trim();


                    if (!value) {
                        event.preventDefault();

                        alert(
                            "Please enter your M-Pesa phone number."
                        );

                        phone?.focus();

                        return;
                    }

                }

            }
        );

    }


    updatePhoneField();

})();

</script>