<!-- =========================================================
     STOCK SUMMARY
========================================================= -->

<div class="stock-summary-card">

  <div class="allocation-summary">

    <div class="allocation-summary-item">

      <span>
        Warehouse available
      </span>

      <strong>
        <%= Number(
          stock.units || 0
        ).toLocaleString() %>
      </strong>

    </div>


    <div class="allocation-summary-item">

      <span>
        Being dispatched
      </span>

      <strong id="summaryTotal">
        0
      </strong>

    </div>


    <div class="allocation-summary-item">

      <span>
        Remaining warehouse
      </span>

      <strong id="summaryRemaining">

        <%= Number(
          stock.units || 0
        ).toLocaleString() %>

      </strong>

    </div>

  </div>


  <div
    id="allocationWarning"
    class="error allocation-warning"
    hidden
  ></div>

</div>