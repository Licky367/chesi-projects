<!-- =========================================================
     STOCK SUMMARY
========================================================= -->

<div class="stock-summary-card">


  <!-- =======================================================
       SUMMARY TITLE
  ======================================================== -->

  <div class="stock-summary-heading">

    <div>

      <h2>
        Stock Summary
      </h2>

      <p>
        Review the warehouse balance and current allocation.
      </p>

    </div>

  </div>


  <!-- =======================================================
       SUMMARY VALUES
  ======================================================== -->

  <div class="allocation-summary">


    <!-- =====================================================
         WAREHOUSE AVAILABLE
    ====================================================== -->

    <div class="allocation-summary-item">

      <span>
        Warehouse available
      </span>

      <strong>

        <%= Number(
          stock.units || 0
        ).toLocaleString() %>

      </strong>

    </div>


    <!-- =====================================================
         BEING DISPATCHED
    ====================================================== -->

    <div class="allocation-summary-item">

      <span>
        Being dispatched
      </span>

      <strong id="summaryTotal">
        0
      </strong>

    </div>


    <!-- =====================================================
         REMAINING WAREHOUSE
    ====================================================== -->

    <div class="allocation-summary-item">

      <span>
        Remaining warehouse
      </span>

      <strong id="summaryRemaining">

        <%= Number(
          stock.units || 0
        ).toLocaleString() %>

      </strong>

    </div>

  </div>


  <!-- =======================================================
       WARNING
  ======================================================== -->

  <div
    id="allocationWarning"
    class="error allocation-warning"
    hidden
  ></div>

</div>