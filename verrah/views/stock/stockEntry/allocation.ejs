<!-- =========================================================
     STOCK ALLOCATION
     VERRAH COSMETICS
     
     PARTIAL:
     views/stock/stockEntry/allocation.ejs
     
     PURPOSE:
     Edit Product allocation across substations.
     
     IMPORTANT:
     - Product already exists for this Stock.
     - Product owns unitSellPrice.
     - Existing substation quantities are handled by the
       service as the current physical allocation.
     - Only submitted substation values are changed.
========================================================= -->


<div class="allocation-panel">


    <%
        /* =====================================================
           FIND PRODUCT BELONGING TO THIS STOCK

           Stock already has its Product.

           We only use this Product to obtain its current
           unitSellPrice for the form.
        ====================================================== */

        const stockProduct =
            Array.isArray(products)
                ? products.find(
                    function (product) {

                        return String(
                            product.stock
                        ) === String(
                            stock._id
                        );

                    }
                )
                : null;


        /* =====================================================
           CURRENT PRODUCT SELLING PRICE

           Product owns unitSellPrice.
        ====================================================== */

        const productUnitSellPrice =
            stockProduct &&
            stockProduct.unitSellPrice != null
                ? stockProduct.unitSellPrice
                : "";


        /* =====================================================
           SAFE OLD FORM DATA

           On validation failure, preserve submitted values.
        ====================================================== */

        const oldAllocations =
            old &&
            old.allocations &&
            typeof old.allocations === "object"
                ? old.allocations
                : {};
    %>


    <!-- =====================================================
         ALLOCATION HEADER
    ====================================================== -->

    <div class="allocation-heading">

        <div class="allocation-heading-content">

            <h2>
                Dispatch to substations
            </h2>

            <p>
                Enter the final units held by each substation.
            </p>

        </div>


        <div class="allocation-total-box">

            <small>
                Total allocated
            </small>

            <strong id="allocationTotal">
                0
            </strong>

        </div>

    </div>


    <!-- =====================================================
         ALLOCATION FORM

         This submits to the existing stock update route.

         The service treats this as an UPDATE of the existing
         Product allocation, not Product creation.
    ====================================================== -->

    <form
        action="/stock/<%= stock._id %>"
        method="POST"
        class="allocation-form"
        id="allocationForm"
    >


        <!-- =================================================
             PRODUCT SELLING PRICE
        ================================================== -->

        <div class="field">

            <label
                for="unitSellPrice"
            >
                Selling price per unit
            </label>


            <input
                id="unitSellPrice"
                type="number"
                min="0"
                step="0.01"
                name="unitSellPrice"
                value="<%= old && old.unitSellPrice != null
                    ? old.unitSellPrice
                    : productUnitSellPrice %>"
                required
                autocomplete="off"
            >

        </div>


        <!-- =================================================
             SUBSTATION ALLOCATION TABLE
        ================================================== -->

        <div class="sales-table-wrapper">

            <table class="sales-table">

                <thead>

                    <tr>

                        <th>
                            #
                        </th>

                        <th>
                            Substation
                        </th>

                        <th>
                            Location
                        </th>

                        <th>
                            Available Units
                        </th>

                        <th>
                            Add Units
                        </th>

                    </tr>

                </thead>


                <tbody>


                    <% if (
                        Array.isArray(substations) &&
                        substations.length > 0
                    ) { %>


                        <% substations.forEach(
                            function (
                                substation,
                                index
                            ) {

                                const substationId =
                                    String(
                                        substation._id
                                    );


                                const value =
                                    Object.prototype.hasOwnProperty.call(
                                        oldAllocations,
                                        substationId
                                    )
                                        ? oldAllocations[
                                            substationId
                                        ]
                                        : "";


                                /* =================================
                                   CURRENT PRODUCT INVENTORY
                                ================================== */

                                const substationInventory =
                                    Array.isArray(
                                        substation.productInventory
                                    )
                                        ? substation.productInventory.find(
                                            function (inventory) {

                                                return String(
                                                    inventory.productId
                                                ) === String(
                                                    stockProduct &&
                                                    stockProduct._id
                                                );

                                            }
                                        )
                                        : null;


                                const availableUnits =
                                    substationInventory &&
                                    substationInventory.units != null
                                        ? Number(
                                            substationInventory.units
                                        )
                                        : 0;
                        %>


                            <tr>


                                <!-- =================================
                                     NUMBER
                                ================================== -->

                                <td>

                                    <strong>
                                        <%= index + 1 %>
                                    </strong>

                                </td>


                                <!-- =================================
                                     SUBSTATION NAME
                                ================================== -->

                                <td>

                                    <strong>
                                        <%= substation.name ||
                                            "Unnamed Substation" %>
                                    </strong>

                                </td>


                                <!-- =================================
                                     LOCATION
                                ================================== -->

                                <td>

                                    <% if (
                                        substation.location
                                    ) { %>

                                        <span>

                                            <i
                                                class="fas fa-location-dot"
                                            ></i>

                                            <%= substation.location %>

                                        </span>

                                    <% } else { %>

                                        <span
                                            class="sales-muted"
                                        >
                                            —
                                        </span>

                                    <% } %>

                                </td>


                                <!-- =================================
                                     AVAILABLE INVENTORY
                                ================================== -->

                                <td>

                                    <strong>
                                        <%= availableUnits.toLocaleString("en-KE") %>
                                    </strong>

                                </td>


                                <!-- =================================
                                     FINAL ALLOCATION
                                ================================== -->

                                <td>

                                    <input
                                        id="allocation-<%= substationId %>"
                                        class="allocation-input"
                                        type="number"
                                        min="0"
                                        step="1"
                                        inputmode="numeric"
                                        name="allocations[<%= substationId %>]"
                                        value="<%= value %>"
                                        autocomplete="off"
                                    >

                                </td>


                            </tr>


                        <% }); %>


                    <% } else { %>


                        <tr>

                            <td
                                colspan="5"
                                class="sales-empty"
                            >
                                No active substations are available
                                for allocation.
                            </td>

                        </tr>


                    <% } %>


                </tbody>

            </table>

        </div>


        <!-- =================================================
             ALLOCATION WARNING
        ================================================== -->

        <div
            id="allocationWarning"
            class="error allocation-warning"
            hidden
        ></div>


    </form>

</div>