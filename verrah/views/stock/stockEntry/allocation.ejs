<!-- =========================================================
     STOCK ALLOCATION
     VERRAH COSMETICS
========================================================= -->

<div class="allocation-panel">


    <!-- =====================================================
         ALLOCATION HEADING
    ====================================================== -->

    <div class="allocation-heading">

        <div>

            <h2>
                Dispatch to substations
            </h2>

            <p>
                Enter the units each substation receives.
            </p>

        </div>


        <div class="allocation-total-box">

            <small>
                Total allocated
            </small>

            <strong id="allocationTotal">
                0
            </strong>

        </div>

    </div>


    <!-- =====================================================
         ALLOCATION FORM
    ====================================================== -->

    <form
        action="/stock/<%= stock._id %>"
        method="POST"
        class="allocation-form"
        id="allocationForm"
    >

        <input
            type="hidden"
            name="units"
            id="totalUnits"
            value="0"
        >


        <!-- =================================================
             SELLING PRICE
        ================================================== -->

        <div class="field">

            <label for="unitSellPrice">
                Selling price per unit
            </label>

            <input
                id="unitSellPrice"
                type="number"
                min="0"
                step="0.01"
                name="unitSellPrice"
                value="<%= old && old.unitSellPrice != null
                    ? old.unitSellPrice
                    : (unitSellPrice ?? "") %>"
                required
            >

        </div>


        <!-- =================================================
             SUBSTATION ALLOCATION TABLE
        ================================================== -->

        <div class="sales-table-wrapper">

            <table class="sales-table">

                <thead>

                    <tr>

                        <th>
                            #
                        </th>

                        <th>
                            Substation
                        </th>

                        <th>
                            Location
                        </th>

                        <th>
                            Allocate Units
                        </th>

                    </tr>

                </thead>


                <tbody>

                    <% if (
                        substations &&
                        substations.length
                    ) { %>


                        <% substations.forEach(
                            function (substation, index)
                        { %>

                            <%
                                const substationId =
                                    String(substation._id);

                                const value =
                                    old &&
                                    old.allocations &&
                                    typeof old.allocations === "object"
                                        ? (
                                            old.allocations[
                                                substationId
                                            ] ?? ""
                                        )
                                        : "";
                            %>


                            <tr>


                                <!-- =================================
                                     #
                                ================================== -->

                                <td>

                                    <strong>
                                        <%= index + 1 %>
                                    </strong>

                                </td>


                                <!-- =================================
                                     SUBSTATION
                                ================================== -->

                                <td>

                                    <strong>
                                        <%= substation.name ||
                                            "Unnamed Substation" %>
                                    </strong>

                                </td>


                                <!-- =================================
                                     LOCATION
                                ================================== -->

                                <td>

                                    <% if (substation.location) { %>

                                        <span>

                                            <i class="fas fa-location-dot"></i>

                                            <%= substation.location %>

                                        </span>

                                    <% } else { %>

                                        <span class="sales-muted">
                                            —
                                        </span>

                                    <% } %>

                                </td>


                                <!-- =================================
                                     ALLOCATE UNITS
                                ================================== -->

                                <td>

                                    <input
                                        id="allocation-<%= substationId %>"
                                        class="allocation-input"
                                        type="number"
                                        min="0"
                                        max="<%= Number(stock.units || 0) %>"
                                        step="1"
                                        inputmode="numeric"
                                        name="allocations[<%= substationId %>]"
                                        value="<%= value %>"
                                        autocomplete="off"
                                    >

                                </td>


                            </tr>


                        <% }); %>


                    <% } else { %>


                        <tr>

                            <td
                                colspan="4"
                                class="sales-empty"
                            >
                                No active substations are available
                                for allocation.
                            </td>

                        </tr>


                    <% } %>

                </tbody>

            </table>

        </div>


        <!-- =================================================
             ALLOCATION WARNING
        ================================================== -->

        <div
            id="allocationWarning"
            class="error allocation-warning"
            hidden
        ></div>


    </form>

</div>