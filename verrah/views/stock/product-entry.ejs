<section class="shop-page stock-entry-page">

  <!-- =========================================================
       STOCK MANAGEMENT FORM
  ========================================================== -->

  <div class="form-card stock-management-form">

    <div class="form-card-header">

      <div>

        <h1>
          <%= old ? "Edit Stock" : "Add Stock" %>
        </h1>

        <p>
          <%= old
            ? "Update the stock item and warehouse quantity."
            : "Add a new stock item to the warehouse."
          %>
        </p>

      </div>

    </div>


    <!-- =======================================================
         STOCK FORM
    ======================================================== -->

    <form
      action="/stock"
      method="POST"
      id="stockForm"
      novalidate
    >

      <% if (old && old._id) { %>

        <input
          type="hidden"
          name="stockId"
          value="<%= old._id %>"
        >

      <% } %>


      <!-- =====================================================
           FORM GRID
      ====================================================== -->

      <div class="form-grid">


        <!-- ===================================================
             CATEGORY
        ==================================================== -->

        <div class="field">

          <label for="category">
            Category
          </label>

          <select
            id="category"
            name="category"
            required
          >

            <option value="">
              Select category
            </option>

            <% if (typeof categories !== "undefined" && categories.length) { %>

              <% categories.forEach(category => { %>

                <option
                  value="<%= category.name || category %>"
                  <%= old?.category === (category.name || category) ? "selected" : "" %>
                >
                  <%= category.name || category %>
                </option>

              <% }) %>

            <% } %>

          </select>

        </div>


        <!-- ===================================================
             STOCK NAME
        ==================================================== -->

        <div class="field">

          <label for="name">
            Stock name
          </label>

          <input
            type="text"
            id="name"
            name="name"
            value="<%= old?.name || '' %>"
            required
            autocomplete="off"
            placeholder="Enter stock name"
          >

          <small class="form-help">
            The main name of this stock item.
          </small>

        </div>


        <!-- ===================================================
             SUBCATEGORY
        ==================================================== -->

        <div class="field">

          <label for="subcategory">
            Subcategory
          </label>

          <input
            type="text"
            id="subcategory"
            name="subcategory"
            value="<%= old?.subcategory || '' %>"
            required
            autocomplete="off"
            placeholder="Enter subcategory"
          >

          <small class="form-help">
            The subcategory of this stock item.
          </small>

        </div>


        <!-- ===================================================
             UNITS
        ==================================================== -->

        <div class="field">

          <label for="units">
            Units
          </label>

          <input
            type="number"
            id="units"
            name="units"
            min="0"
            step="1"
            value="<%= old?.units ?? '' %>"
            required
          >

          <% if (old) { %>

            <small class="form-help">
              Enter the new total warehouse quantity.
              Existing FIFO stock cannot be reduced.
            </small>

          <% } else { %>

            <small class="form-help">
              Initial quantity entering the warehouse.
            </small>

          <% } %>

        </div>


        <!-- ===================================================
             BUY PRICE
        ==================================================== -->

        <div class="field">

          <label for="buyPrice">
            Buy price
          </label>

          <input
            type="number"
            id="buyPrice"
            name="buyPrice"
            min="0"
            step="0.01"
            value="<%= old?.buyPrice ?? '' %>"
            <%= old ? "" : "required" %>
          >

          <% if (old) { %>

            <small class="form-help">
              Required only when adding additional units.
              Existing FIFO batches are not repriced.
            </small>

          <% } else { %>

            <small class="form-help">
              Purchase price for the initial FIFO batch.
            </small>

          <% } %>

        </div>


        <!-- ===================================================
             SELL PRICE
        ==================================================== -->

        <div class="field">

          <label for="sellPrice">
            Sell price
          </label>

          <input
            type="number"
            id="sellPrice"
            name="sellPrice"
            min="0"
            step="0.01"
            value="<%= old?.unitSellPrice ?? old?.sellPrice ?? '' %>"
            required
            placeholder="Enter sell price"
          >

          <small class="form-help">
            Selling price for the product.
          </small>

        </div>


        <!-- ===================================================
             DELIVERY DAYS
        ==================================================== -->

        <div class="field">

          <label for="days">
            Delivery days
          </label>

          <input
            type="number"
            id="days"
            name="days"
            min="0"
            step="1"
            value="<%= old?.days ?? '' %>"
            placeholder="Optional"
          >

        </div>


        <!-- ===================================================
             IMAGE
        ==================================================== -->

        <div class="field">

          <label for="image">
            Image
          </label>

          <input
            type="text"
            id="image"
            name="image"
            value="<%= old?.image || '' %>"
            autocomplete="off"
            placeholder="Image URL"
          >

        </div>


        <!-- ===================================================
             DESCRIPTION
        ==================================================== -->

        <div class="field field-full">

          <label for="description">
            Description
          </label>

          <textarea
            id="description"
            name="description"
            rows="5"
            placeholder="Enter stock description"
          ><%= old?.description || '' %></textarea>

        </div>

      </div>


      <!-- =====================================================
           FIFO INFORMATION
      ====================================================== -->

      <div class="info-card">

        <div class="info-card-icon">

          <i class="fas fa-layer-group"></i>

        </div>

        <div>

          <h3>
            FIFO stock management
          </h3>

          <% if (old) { %>

            <p>
              Existing purchase batches keep their original buy
              prices. If the new total quantity is greater than the
              current quantity, only the additional units are added
              as a new FIFO purchase batch using the supplied
              buy price.
            </p>

          <% } else { %>

            <p>
              The initial warehouse quantity will be stored as the
              first FIFO purchase batch using the supplied buy price.
              Future purchases will create separate batches.
            </p>

          <% } %>

        </div>

      </div>


      <!-- =====================================================
           EDIT SUMMARY
      ====================================================== -->

      <% if (old) { %>

        <div class="edit-summary">

          <div class="edit-summary-item">

            <span class="summary-label">
              Current warehouse units
            </span>

            <strong id="currentUnits">
              <%= Number(old.units || 0).toLocaleString("en-KE") %>
            </strong>

          </div>


          <div class="edit-summary-item">

            <span class="summary-label">
              New warehouse units
            </span>

            <strong id="newUnits">
              <%= Number(old.units || 0).toLocaleString("en-KE") %>
            </strong>

          </div>


          <div class="edit-summary-item">

            <span class="summary-label">
              Additional units
            </span>

            <strong id="additionalUnits">
              0
            </strong>

          </div>

        </div>

      <% } %>


      <!-- =====================================================
           FORM ACTIONS
      ====================================================== -->

      <div class="form-actions">

        <a
          href="/stock"
          class="secondary-btn"
        >

          <i class="fas fa-arrow-left"></i>

          Cancel

        </a>


        <button
          type="submit"
          class="primary-btn"
        >

          <i class="fas <%= old ? 'fa-save' : 'fa-plus' %>"></i>

          <%= old ? "Update Stock" : "Add Stock" %>

        </button>

      </div>

    </form>

  </div>

</section>


<script>

document.addEventListener("DOMContentLoaded", () => {

  /* ==========================================================
     ELEMENTS
  ========================================================== */

  const form =
    document.getElementById("stockForm");

  const unitsInput =
    document.getElementById("units");

  const buyPriceInput =
    document.getElementById("buyPrice");

  const sellPriceInput =
    document.getElementById("sellPrice");


  /* ==========================================================
     EXISTING UNITS
  ========================================================== */

  const currentUnits =
    <%= Number(old?.units || 0) %>;


  /* ==========================================================
     UPDATE EDIT SUMMARY
  ========================================================== */

  function updateUnitsSummary() {

    <% if (old) { %>

      const newUnits =
        Number(unitsInput.value || 0);

      const additional =
        Math.max(
          0,
          newUnits - currentUnits
        );

      const newUnitsElement =
        document.getElementById("newUnits");

      const additionalUnitsElement =
        document.getElementById("additionalUnits");


      if (newUnitsElement) {

        newUnitsElement.textContent =
          newUnits.toLocaleString("en-KE");

      }


      if (additionalUnitsElement) {

        additionalUnitsElement.textContent =
          additional.toLocaleString("en-KE");

      }

    <% } %>

  }


  if (unitsInput) {

    unitsInput.addEventListener(
      "input",
      updateUnitsSummary
    );

  }


  /* ==========================================================
     FORM SUBMISSION
  ========================================================== */

  form.addEventListener(
    "submit",
    event => {

      const name =
        document
          .getElementById("name")
          ?.value
          .trim();


      const category =
        document
          .getElementById("category")
          ?.value
          .trim();


      const subcategory =
        document
          .getElementById("subcategory")
          ?.value
          .trim();


      const sellPrice =
        Number(
          sellPriceInput.value
        );


      const units =
        Number(
          unitsInput.value
        );


      /* ------------------------------------------------------
         NAME
      ------------------------------------------------------ */

      if (!name) {

        event.preventDefault();

        alert(
          "Please enter the stock name."
        );

        document
          .getElementById("name")
          .focus();

        return;

      }


      /* ------------------------------------------------------
         CATEGORY
      ------------------------------------------------------ */

      if (!category) {

        event.preventDefault();

        alert(
          "Please select a category."
        );

        document
          .getElementById("category")
          .focus();

        return;

      }


      /* ------------------------------------------------------
         SUBCATEGORY
      ------------------------------------------------------ */

      if (!subcategory) {

        event.preventDefault();

        alert(
          "Please enter the subcategory."
        );

        document
          .getElementById("subcategory")
          .focus();

        return;

      }


      /* ------------------------------------------------------
         UNITS
      ------------------------------------------------------ */

      if (
        !Number.isFinite(units) ||
        units < 0
      ) {

        event.preventDefault();

        alert(
          "Please enter a valid stock quantity."
        );

        unitsInput.focus();

        return;

      }


      /* ------------------------------------------------------
         SELL PRICE
      ------------------------------------------------------ */

      if (
        !Number.isFinite(sellPrice) ||
        sellPrice < 0
      ) {

        event.preventDefault();

        alert(
          "Please enter a valid sell price."
        );

        sellPriceInput.focus();

        return;

      }


      /* ------------------------------------------------------
         EDIT MODE
      ------------------------------------------------------ */

      <% if (old) { %>

        if (units < currentUnits) {

          event.preventDefault();

          alert(
            "Warehouse units cannot be reduced when editing stock."
          );

          unitsInput.focus();

          return;

        }


        const additional =
          units - currentUnits;


        if (
          additional > 0 &&
          (
            buyPriceInput.value === "" ||
            Number(buyPriceInput.value) < 0
          )
        ) {

          event.preventDefault();

          alert(
            "Enter the buy price for the additional FIFO units."
          );

          buyPriceInput.focus();

          return;

        }

      <% } else { %>

        /* ----------------------------------------------------
           CREATE MODE
        ---------------------------------------------------- */

        if (
          buyPriceInput.value === "" ||
          Number(buyPriceInput.value) < 0
        ) {

          event.preventDefault();

          alert(
            "Please enter the initial buy price."
          );

          buyPriceInput.focus();

          return;

        }

      <% } %>

    }
  );


  /* ==========================================================
     INITIAL SUMMARY
  ========================================================== */

  updateUnitsSummary();

});

</script>