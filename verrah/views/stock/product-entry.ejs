<section class="shop-page stock-entry-page">
  <div class="form-card stock-management-form">
    <a href="/stock" class="secondary-btn"><i class="fas fa-arrow-left"></i> Stock</a>

    <h1 class="page-title"><%= title %></h1>
    <p class="page-subtitle">Add the stock details and, when needed, give customers clear instructions for using the product.</p>

    <% if (error) { %><div class="error"><%= error %></div><% } %>
    <% if (saved === "1") { %><div class="notice">Stock subcategory saved successfully.</div><% } %>

    <form action="/stock" method="POST" id="stockForm" novalidate>
      <input type="hidden" name="stockId" id="stockId" value="<%= selectedStockId || old?.stockId || '' %>">

      <div class="form-grid">
        <div class="field">
          <label for="category">Category</label>
          <div class="select-wrap">
            <select id="category" name="category" required aria-describedby="categoryHelp">
              <option value="">Select a category</option>
              <% (categories || []).forEach((category) => { 
                const categoryId = String(category._id || '');
                const categoryName = String(category.name || '');
                const oldCategory = String(old?.category?._id || old?.category || '');
              %>
                <option value="<%= categoryId %>" <%= oldCategory === categoryId ? 'selected' : '' %>>
                  <%= categoryName.replace(/[-_]+/g, ' ').replace(/\b\w/g, c => c.toUpperCase()) %>
                </option>
              <% }) %>
            </select>
          </div>
          <small class="form-help" id="categoryHelp">Select one of the active categories from the database.</small>
        </div>

        <div class="field">
          <label for="subcategory">Subcategory</label>
          <input id="subcategory" name="subcategory" value="<%= old?.subcategory || '' %>" required autocomplete="off">
          <small class="form-help">This becomes the product name.</small>
        </div>

        <div class="field">
          <label for="units" id="unitsLabel">Initial warehouse units</label>
          <input id="units" name="units" type="number" min="0" step="1" value="<%= old?.additionalUnits ?? old?.units ?? '' %>" required>
          <small class="form-help" id="unitsHelp">Units for a new subcategory.</small>
        </div>

        <div class="field">
          <label for="buyPrice">Buy price per unit</label>
          <input id="buyPrice" name="buyPrice" type="number" min="0" step="0.01" value="<%= old?.buyPrice ?? 0 %>" required>
        </div>

        <div class="field">
          <label for="days">Delivery days</label>
          <input id="days" name="days" type="number" min="0" step="1" value="<%= old?.days ?? 0 %>" required>
          <small class="form-help">Delivery time for this subcategory.</small>
        </div>

        <div class="field full">
          <label for="image">Image URL <span class="optional">(optional when updating)</span></label>
          <input id="image" name="image" value="<%= old?.image || '' %>" autocomplete="url">
        </div>

        <div class="field full">
          <label for="description">Description</label>
          <textarea id="description" name="description" placeholder="Briefly describe the product"><%= old?.description || '' %></textarea>
        </div>
      </div>

      <section class="directions-editor" aria-labelledby="directionsHeading">
        <div class="directions-editor-head">
          <div>
            <span class="directions-kicker"><i class="fas fa-circle-info"></i> Customer information</span>
            <h2 id="directionsHeading">Directions of Use</h2>
            <p>Add practical instructions that customers should see on the product page. This section is optional.</p>
          </div>
          <button type="button" class="secondary-btn directions-add-btn" id="addDirectionBtn"><i class="fas fa-plus"></i> Add instruction</button>
        </div>

        <div class="field full">
          <label for="directionsTitle">Section title</label>
          <input id="directionsTitle" name="directionsOfUse[title]" value="<%= old?.directionsOfUse?.title || '' %>" placeholder="e.g. How to use this product">
        </div>

        <div id="directionsList" class="directions-list">
          <% const items = Array.isArray(old?.directionsOfUse?.items) ? old.directionsOfUse.items : [{ subtitle: '', content: '' }]; %>
          <% items.forEach((item, index) => { %>
            <div class="direction-item" data-index="<%= index %>">
              <div class="direction-item-number"><%= index + 1 %></div>
              <div class="direction-item-fields">
                <div class="field">
                  <label>Instruction heading</label>
                  <input name="directionsOfUse[items][<%= index %>][subtitle]" value="<%= item?.subtitle || '' %>" placeholder="e.g. Before use">
                </div>
                <div class="field full">
                  <label>Instruction</label>
                  <textarea name="directionsOfUse[items][<%= index %>][content]" placeholder="Explain what the customer should do"><%= item?.content || '' %></textarea>
                </div>
              </div>
              <button type="button" class="direction-remove" aria-label="Remove instruction" title="Remove instruction"><i class="fas fa-trash"></i></button>
            </div>
          <% }) %>
        </div>

        <div id="directionsEmpty" class="directions-empty" hidden>
          <i class="fas fa-list-check"></i><strong>No directions added yet</strong><span>Add another instruction when the product needs more than one step.</span>
        </div>

        <input type="hidden" name="directionsOfUse[clear]" id="directionsClear" value="0">
        <label class="directions-clear-option">
          <input type="checkbox" id="clearDirections">
          <span>Remove directions of use from this stock item</span>
        </label>
      </section>

      <div class="stock-edit-summary" id="stockEditSummary" hidden>
        <div><strong>Current warehouse units:</strong> <span id="currentUnits">0</span></div>
        <div><strong>After this update:</strong> <span id="projectedUnits">0</span></div>
      </div>

      <div class="form-actions">
        <button type="submit" class="primary-btn" id="submitButton"><i class="fas fa-plus"></i> Create Stock Subcategory</button>
        <a href="/stock" class="secondary-btn">Cancel</a>
      </div>
    </form>
  </div>
</section>

<style>
.stock-entry-page .select-wrap{position:relative;width:100%}
.stock-entry-page .select-wrap::after{content:"\\f078";font-family:"Font Awesome 6 Free";font-weight:900;position:absolute;right:16px;top:50%;transform:translateY(-50%);pointer-events:none;color:#0a4d1e;font-size:.8rem}
.stock-entry-page select#category{display:block;width:100%;min-height:48px;padding:12px 44px 12px 14px;border:1px solid #cfd8d2;border-radius:10px;background:#fff;color:#173d30;font:inherit;line-height:1.3;appearance:none;-webkit-appearance:none;cursor:pointer}
.stock-entry-page select#category:focus{outline:none;border-color:#0a4d1e;box-shadow:0 0 0 3px rgba(10,77,30,.12)}
.stock-entry-page select#category option{padding:10px;background:#fff;color:#173d30}
</style>

<script>
(function(){
  "use strict";
  const form=document.getElementById("stockForm");
  const stockId=document.getElementById("stockId");
  const category=document.getElementById("category");
  const units=document.getElementById("units");
  const unitsLabel=document.getElementById("unitsLabel");
  const unitsHelp=document.getElementById("unitsHelp");
  const submitButton=document.getElementById("submitButton");
  const summary=document.getElementById("stockEditSummary");
  const currentUnits=document.getElementById("currentUnits");
  const projectedUnits=document.getElementById("projectedUnits");
  const directionsList=document.getElementById("directionsList");
  const directionsEmpty=document.getElementById("directionsEmpty");
  const addDirectionBtn=document.getElementById("addDirectionBtn");
  const clearDirections=document.getElementById("clearDirections");
  const directionsClear=document.getElementById("directionsClear");

  function renumber(){
    const items=[...directionsList.querySelectorAll(".direction-item")];
    items.forEach((item,index)=>{
      item.dataset.index=index;
      item.querySelector(".direction-item-number").textContent=index+1;
      item.querySelectorAll("input,textarea").forEach(field=>{
        const type=field.name.includes("subtitle")?"subtitle":"content";
        field.name=`directionsOfUse[items][${index}][${type}]`;
      });
    });
    directionsEmpty.hidden=items.length>0;
  }

  function addDirection(subtitle="",content=""){
    const index=directionsList.querySelectorAll(".direction-item").length;
    const item=document.createElement("div");
    item.className="direction-item";
    item.innerHTML=`<div class="direction-item-number">${index+1}</div><div class="direction-item-fields"><div class="field"><label>Instruction heading</label><input name="directionsOfUse[items][${index}][subtitle]" placeholder="e.g. Before use"></div><div class="field full"><label>Instruction</label><textarea name="directionsOfUse[items][${index}][content]" placeholder="Explain what the customer should do"></textarea></div></div><button type="button" class="direction-remove" aria-label="Remove instruction"><i class="fas fa-trash"></i></button>`;
    item.querySelector("input").value=subtitle;
    item.querySelector("textarea").value=content;
    directionsList.appendChild(item);
    renumber();
  }

  function updateDisabled(){
    const disabled=clearDirections.checked;
    directionsClear.value=disabled?"1":"0";
    document.querySelectorAll("#directionsList input,#directionsList textarea,#directionsTitle").forEach(el=>el.disabled=disabled);
  }

  directionsList.addEventListener("click",e=>{
    const btn=e.target.closest(".direction-remove");
    if(!btn)return;
    btn.closest(".direction-item")?.remove();
    renumber();
  });
  addDirectionBtn.addEventListener("click",()=>addDirection());
  clearDirections.addEventListener("change",updateDisabled);

  function updateSummary(){
    if(!stockId.value){summary.hidden=true;return;}
    const selected=category.options[category.selectedIndex];
    const current=Number(selected?.dataset.units||0);
    const additional=Math.max(0,Number(units.value||0));
    currentUnits.textContent=current.toLocaleString();
    projectedUnits.textContent=(current+additional).toLocaleString();
    summary.hidden=false;
  }

  if(stockId.value){
    units.name="additionalUnits";
    units.value="0";
    units.required=false;
    unitsLabel.textContent="Additional warehouse units";
    unitsHelp.textContent="These units are added to the existing warehouse balance.";
    submitButton.innerHTML='<i class="fas fa-save"></i> Update Stock Subcategory';
    const selectedCategory="<%= String(old?.category?._id || old?.category || '') %>";
    if(selectedCategory && [...category.options].some(o=>o.value===selectedCategory)) category.value=selectedCategory;
    const existingUnits=Number("<%= Number(old?.units || 0) %>");
    const selected=category.options[category.selectedIndex];
    if(selected) selected.dataset.units=String(existingUnits);
    updateSummary();
  } else {
    units.name="units";
    units.required=true;
  }

  units.addEventListener("input",updateSummary);
  category.addEventListener("change",updateSummary);
  form.addEventListener("submit",()=>{directionsClear.value=clearDirections.checked?"1":"0";});
  updateDisabled();
})();
</script>
