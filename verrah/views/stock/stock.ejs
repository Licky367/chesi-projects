<%
// ==========================================================
// views/stock/stock.ejs
// STOCK LISTING
//
// Displays ALL active stocks returned by stockService.listStock()
// grouped by category.
//
// IMPORTANT:
// This view does NOT create or modify stock.
// It only displays the data already returned by the backend.
// ==========================================================
%>

<section class="stock-page">

    <style>

        /* =====================================================
           STOCK PAGE
        ===================================================== */

        .stock-page {
            width: 100%;
            padding: 18px;
            color: #173d30;
        }

        .stock-page * {
            box-sizing: border-box;
        }


        /* =====================================================
           PAGE HEADER
        ===================================================== */

        .stock-page .page-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;

            margin-bottom: 20px;
            padding: 18px;

            background: #ffffff;
            border: 1px solid #e1e8e3;
            border-radius: 16px;

            box-shadow: 0 4px 16px rgba(23, 61, 48, 0.06);
        }

        .stock-page .page-title {
            margin: 0;

            color: #0a4d1e;

            font-size: 1.6rem;
            font-weight: 800;
        }

        .stock-page .page-subtitle {
            margin: 6px 0 0;

            color: #6b7b73;

            font-size: 0.92rem;
        }


        /* =====================================================
           ADD STOCK BUTTON
        ===================================================== */

        .stock-page .primary-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;

            min-height: 44px;

            padding: 10px 16px;

            border-radius: 10px;

            background: #0a4d1e;
            color: #ffffff;

            text-decoration: none;

            font-weight: 700;

            white-space: nowrap;
        }

        .stock-page .primary-btn:hover {
            background: #083d18;
        }


        /* =====================================================
           MESSAGES
        ===================================================== */

        .stock-page .message {
            margin-bottom: 18px;
            padding: 12px 14px;

            border-radius: 10px;

            font-size: 0.92rem;
        }

        .stock-page .message.error {
            background: #fff1f1;
            border: 1px solid #f0c7c7;

            color: #9d2020;
        }

        .stock-page .message.success {
            background: #edf8f0;
            border: 1px solid #c9e6d0;

            color: #17652b;
        }


        /* =====================================================
           EMPTY STATE
        ===================================================== */

        .stock-page .empty {
            padding: 50px 20px;

            text-align: center;

            background: #ffffff;

            border: 1px dashed #cbd8d0;
            border-radius: 16px;

            color: #6b7b73;
        }

        .stock-page .empty i {
            display: block;

            margin-bottom: 12px;

            color: #0a4d1e;

            font-size: 2rem;
        }


        /* =====================================================
           CATEGORY SECTION
        ===================================================== */

        .stock-page .category-section {
            margin-bottom: 30px;
        }

        .stock-page .category-head {
            display: flex;
            align-items: center;
            justify-content: space-between;

            gap: 12px;

            margin-bottom: 12px;
        }

        .stock-page .category-head h2 {
            margin: 0;

            color: #0a4d1e;

            font-size: 1.05rem;
            font-weight: 800;

            text-transform: capitalize;
        }

        .stock-page .category-count {
            color: #718078;

            font-size: 0.82rem;

            white-space: nowrap;
        }


        /* =====================================================
           STOCK GRID
        ===================================================== */

        .stock-page .stock-grid {
            display: grid;

            grid-template-columns:
                repeat(
                    auto-fill,
                    minmax(210px, 1fr)
                );

            gap: 14px;
        }


        /* =====================================================
           STOCK CARD
        ===================================================== */

        .stock-page .stock-card {
            display: flex;
            flex-direction: column;

            min-width: 0;

            overflow: hidden;

            background: #ffffff;

            border: 1px solid #e1e8e3;
            border-radius: 14px;

            color: inherit;

            text-decoration: none;

            box-shadow:
                0 3px 12px rgba(23, 61, 48, 0.05);

            transition:
                transform 0.16s ease,
                box-shadow 0.16s ease,
                border-color 0.16s ease;
        }

        .stock-page .stock-card:hover {
            transform: translateY(-2px);

            border-color: #a9c7b1;

            box-shadow:
                0 8px 22px rgba(23, 61, 48, 0.10);
        }


        /* =====================================================
           STOCK IMAGE
        ===================================================== */

        .stock-page .product-image {
            position: relative;

            width: 100%;

            aspect-ratio: 4 / 3;

            overflow: hidden;

            background: #f3f7f4;
        }

        .stock-page .product-image img {
            display: block;

            width: 100%;
            height: 100%;

            object-fit: cover;
        }

        .stock-page .placeholder {
            display: flex;

            align-items: center;
            justify-content: center;

            width: 100%;
            height: 100%;

            color: #7d9386;

            background: #edf4ef;

            font-size: 2rem;
        }


        /* =====================================================
           STOCK INFORMATION
        ===================================================== */

        .stock-page .product-info {
            display: flex;
            flex-direction: column;

            gap: 8px;

            padding: 14px;
        }

        .stock-page .product-name {
            color: #173d30;

            font-size: 1rem;
            font-weight: 800;

            line-height: 1.3;
        }

        .stock-page .subcategory {
            color: #728078;

            font-size: 0.82rem;

            line-height: 1.35;
        }

        .stock-page .subcategory strong {
            color: #3e554a;
        }

        .stock-page .price {
            color: #0a4d1e;

            font-size: 1rem;
            font-weight: 800;
        }


        /* =====================================================
           STOCK STATUS
        ===================================================== */

        .stock-page .stock-status {
            align-self: flex-start;

            padding: 5px 8px;

            border-radius: 999px;

            background: #eaf7ed;
            color: #17652b;

            font-size: 0.75rem;
            font-weight: 700;
        }

        .stock-page .stock-status.out {
            background: #fff0f0;
            color: #a52a2a;
        }


        /* =====================================================
           UNITS
        ===================================================== */

        .stock-page .units {
            padding-top: 8px;

            border-top: 1px solid #edf1ee;

            color: #728078;

            font-size: 0.78rem;
        }

        .stock-page .units strong {
            color: #344b40;
        }


        /* =====================================================
           TABLET / MOBILE
        ===================================================== */

        @media (max-width: 700px) {

            .stock-page {
                padding: 12px;
            }

            .stock-page .page-head {
                align-items: stretch;
                flex-direction: column;
            }

            .stock-page .primary-btn {
                width: 100%;
            }

            .stock-page .stock-grid {
                grid-template-columns:
                    repeat(
                        2,
                        minmax(0, 1fr)
                    );

                gap: 10px;
            }

            .stock-page .product-info {
                padding: 11px;
            }

        }


        @media (max-width: 430px) {

            .stock-page .stock-grid {
                grid-template-columns: 1fr;
            }

        }

    </style>


    <!-- ======================================================
         PAGE HEADER
    ======================================================= -->

    <div class="page-head">

        <div>

            <h1 class="page-title">
                Stock Management
            </h1>

            <p class="page-subtitle">
                All active warehouse stock, grouped by category.
            </p>

        </div>


        <a
            href="/stock/new"
            class="primary-btn"
        >

            <i class="fas fa-plus"></i>

            Add / Update Stock

        </a>

    </div>



    <!-- ======================================================
         ERROR MESSAGE
    ======================================================= -->

    <% if (
        typeof error !== "undefined" &&
        error
    ) { %>

        <div class="message error">

            <%= error %>

        </div>

    <% } %>



    <!-- ======================================================
         SUCCESS MESSAGE
    ======================================================= -->

    <% if (
        typeof saved !== "undefined" &&
        saved === "1"
    ) { %>

        <div class="message success">

            Stock saved successfully and is now listed below.

        </div>

    <% } %>



    <!-- ======================================================
         NO STOCK
    ======================================================= -->

    <% if (
        !Array.isArray(stocks) ||
        stocks.length === 0
    ) { %>


        <div class="empty">

            <i class="fas fa-warehouse"></i>

            <div>
                No stock records exist yet.
            </div>

            <div style="margin-top:8px;">

                Add stock using the button above.

            </div>

        </div>


    <% } else { %>



        <!-- ==================================================
             CATEGORY GROUPS
        =================================================== -->

        <% stocks.forEach((group) => { %>


            <% /*
               ------------------------------------------------
               stockService.listStock() returns:

               group
                 ├── category
                 ├── label
                 └── rows
                      ├── products
                      ├── products
                      └── ...

               Flatten all rows so EVERY stock is displayed.
               ------------------------------------------------
            */ %>

            <% const products =
                (group.rows || []).reduce(
                    (all, row) => {

                        if (
                            Array.isArray(row.products)
                        ) {

                            return all.concat(
                                row.products
                            );

                        }

                        return all;

                    },
                    []
                );
            %>



            <% if (products.length) { %>


                <section class="category-section">


                    <!-- ======================================
                         CATEGORY HEADER
                    ======================================= -->

                    <div class="category-head">

                        <h2>

                            <%=

                                group.label ||

                                group.category?.name ||

                                "Other"

                            %>

                        </h2>


                        <span class="category-count">

                            <%= products.length %>

                            stock

                            <%=

                                products.length === 1

                                    ? "item"

                                    : "items"

                            %>

                        </span>

                    </div>



                    <!-- ======================================
                         STOCK CARDS
                    ======================================= -->

                    <div class="stock-grid">


                        <% products.forEach((stock) => { %>


                            <a
                                href="/stock/<%= stock._id %>"
                                class="stock-card"
                            >


                                <!-- ==========================
                                     IMAGE
                                =========================== -->

                                <div class="product-image">


                                    <% if (stock.image) { %>


                                        <img
                                            src="<%= stock.image %>"
                                            alt="<%=

                                                stock.subcategory ||

                                                stock.name ||

                                                'Stock item'

                                            %>"
                                            loading="lazy"

                                            onerror="
                                                this.style.display='none';
                                                this.nextElementSibling.style.display='flex';
                                            "
                                        >


                                        <div
                                            class="placeholder"
                                            style="display:none;"
                                        >

                                            <i class="fas fa-box"></i>

                                        </div>


                                    <% } else { %>


                                        <div class="placeholder">

                                            <i class="fas fa-box"></i>

                                        </div>


                                    <% } %>


                                </div>



                                <!-- ==========================
                                     STOCK DETAILS
                                =========================== -->

                                <div class="product-info">


                                    <div class="product-name">

                                        <%=

                                            stock.name ||

                                            stock.subcategory ||

                                            "Unnamed stock"

                                        %>

                                    </div>



                                    <div class="subcategory">

                                        Subcategory:

                                        <strong>

                                            <%=

                                                stock.subcategory ||

                                                "Other"

                                            %>

                                        </strong>

                                    </div>



                                    <div class="price">

                                        KSh

                                        <%=

                                            Number(
                                                stock.buyPrice || 0
                                            ).toLocaleString()

                                        %>

                                    </div>



                                    <!-- ======================
                                         AVAILABILITY
                                    ======================= -->

                                    <% if (
                                        Number(stock.units || 0) > 0
                                    ) { %>


                                        <span class="stock-status">

                                            <%=

                                                Number(
                                                    stock.units
                                                ).toLocaleString()

                                            %>

                                            available

                                        </span>


                                    <% } else { %>


                                        <span class="stock-status out">

                                            Out of stock

                                        </span>


                                    <% } %>



                                    <!-- ======================
                                         UNITS
                                    ======================= -->

                                    <div class="units">

                                        Warehouse units:

                                        <strong>

                                            <%=

                                                Number(
                                                    stock.units || 0
                                                ).toLocaleString()

                                            %>

                                        </strong>

                                    </div>


                                </div>


                            </a>


                        <% }) %>


                    </div>


                </section>


            <% } %>


        <% }) %>


    <% } %>


</section>