<% rowProducts.forEach((stock) => { %>

    <a
        href="<%= user && user.role === 'staff'
            ? `/stock/${stock._id}/batches`
            : `/stock/${stock._id}`
        %>"
        class="product-card stock-card"
    >

        <!-- ======================
             STOCK IMAGE
        ======================= -->

        <div class="product-image">

            <% if (stock.image) { %>

                <img
                    src="<%= stock.image %>"
                    alt="<%=

                        stock.subcategory ||

                        stock.name ||

                        'Stock item'

                    %>"
                    loading="lazy"

                    onerror="
                        this.style.display='none';
                        this.nextElementSibling.style.display='flex';
                    "
                >

                <div
                    class="placeholder product-image-fallback stock-image-fallback"
                    style="display:none;"
                >
                    <i class="fas fa-box"></i>
                </div>

            <% } else { %>

                <div class="placeholder">
                    <i class="fas fa-box"></i>
                </div>

            <% } %>

        </div>


        <!-- ======================
             STOCK INFORMATION
        ======================= -->

        <div class="product-info">

            <div class="product-name">

                <%=

                    stock.name ||

                    stock.subcategory ||

                    "Unnamed stock"

                %>

            </div>


            <div class="stock-meta-line">

                Subcategory:

                <strong>

                    <%=

                        stock.subcategory ||

                        "Other"

                    %>

                </strong>

            </div>


            <div class="product-price">

                KSh

                <%=

                    Number(
                        stock.buyPrice || 0
                    ).toLocaleString()

                %>

            </div>


            <div
                class="stock-text <%=

                    Number(
                        stock.units || 0
                    ) <= 0

                        ? 'out'

                        : ''

                %>"
            >

                <% if (
                    Number(
                        stock.units || 0
                    ) > 0
                ) { %>

                    <strong>

                        <%=

                            Number(
                                stock.units
                            ).toLocaleString()

                        %>

                    </strong>

                    available

                <% } else { %>

                    Out of stock

                <% } %>

            </div>


            <div class="stock-text">

                Warehouse units:

                <strong>

                    <%=

                        Number(
                            stock.units || 0
                        ).toLocaleString()

                    %>

                </strong>

            </div>

        </div>

    </a>

<% }) %>