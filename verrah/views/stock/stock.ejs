<%- contentFor('body') %>

<style>
  .stock-page {
    padding: 18px;
    max-width: 1400px;
    margin: 0 auto;
  }

  .stock-page * { box-sizing: border-box; }

  .stock-page .page-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 20px;
  }

  .stock-page .page-title {
    margin: 0;
    font-size: clamp(1.35rem, 3vw, 2rem);
    font-weight: 800;
  }

  .stock-page .page-subtitle {
    margin: 6px 0 0;
    color: #667085;
    font-size: .92rem;
  }

  .stock-page .primary-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 42px;
    padding: 10px 16px;
    border-radius: 10px;
    text-decoration: none;
    font-weight: 700;
    white-space: nowrap;
  }

  .stock-page .message {
    padding: 12px 14px;
    border-radius: 10px;
    margin-bottom: 16px;
  }

  .stock-page .message.error {
    background: #fff1f2;
    color: #b42318;
    border: 1px solid #fecdd3;
  }

  .stock-page .message.success {
    background: #ecfdf3;
    color: #027a48;
    border: 1px solid #abefc6;
  }

  .stock-page .empty {
    padding: 50px 20px;
    text-align: center;
    border: 1px dashed #d0d5dd;
    border-radius: 14px;
    color: #667085;
    background: #fff;
  }

  .stock-page .empty i {
    display: block;
    font-size: 2.4rem;
    margin-bottom: 12px;
  }

  .stock-page .category-section {
    margin-bottom: 28px;
  }

  .stock-page .category-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 12px;
    padding-bottom: 9px;
    border-bottom: 2px solid #eaecf0;
  }

  .stock-page .category-head h2 {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 800;
  }

  .stock-page .category-count {
    color: #667085;
    font-size: .82rem;
    white-space: nowrap;
  }

  .stock-page .stock-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 14px;
  }

  .stock-page .stock-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    color: inherit;
    text-decoration: none;
    background: #fff;
    border: 1px solid #eaecf0;
    border-radius: 14px;
    box-shadow: 0 2px 8px rgba(16, 24, 40, .05);
    transition: transform .16s ease, box-shadow .16s ease, border-color .16s ease;
  }

  .stock-page .stock-card:hover {
    transform: translateY(-2px);
    border-color: #b8c9bf;
    box-shadow: 0 8px 22px rgba(16, 24, 40, .09);
  }

  .stock-page .product-image {
    height: 155px;
    background: #f8fafc;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .stock-page .product-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .stock-page .placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #98a2b3;
    font-size: 2rem;
  }

  .stock-page .product-info {
    padding: 14px;
  }

  .stock-page .product-name {
    font-weight: 800;
    line-height: 1.3;
    margin-bottom: 5px;
    overflow-wrap: anywhere;
  }

  .stock-page .subcategory {
    color: #667085;
    font-size: .84rem;
    margin-bottom: 9px;
  }

  .stock-page .price {
    font-weight: 800;
    font-size: 1rem;
    margin-bottom: 8px;
  }

  .stock-page .stock-status {
    display: inline-flex;
    width: fit-content;
    padding: 4px 8px;
    border-radius: 999px;
    font-size: .76rem;
    font-weight: 700;
    background: #ecfdf3;
    color: #027a48;
  }

  .stock-page .stock-status.out {
    background: #fff1f2;
    color: #b42318;
  }

  .stock-page .units {
    margin-top: 8px;
    color: #475467;
    font-size: .84rem;
  }

  @media (max-width: 700px) {
    .stock-page { padding: 12px; }

    .stock-page .page-head {
      align-items: stretch;
      flex-direction: column;
    }

    .stock-page .primary-btn { width: 100%; }

    .stock-page .stock-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
    }

    .stock-page .product-image { height: 125px; }
    .stock-page .product-info { padding: 11px; }
  }

  @media (max-width: 390px) {
    .stock-page .stock-grid { grid-template-columns: 1fr; }
  }
</style>

<section class="stock-page">
  <div class="page-head">
    <div>
      <h1 class="page-title">Stock Management</h1>
      <p class="page-subtitle">
        All active warehouse stock, grouped by category.
      </p>
    </div>

    <a href="/stock/new" class="primary-btn">
      <i class="fas fa-plus"></i>
      Add / Update Stock
    </a>
  </div>

  <% if (typeof error !== "undefined" && error) { %>
    <div class="message error"><%= error %></div>
  <% } %>

  <% if (typeof saved !== "undefined" && saved === "1") { %>
    <div class="message success">
      Stock saved successfully and is now listed below.
    </div>
  <% } %>

  <% if (!Array.isArray(stocks) || stocks.length === 0) { %>
    <div class="empty">
      <i class="fas fa-warehouse"></i>
      <div>No stock records exist yet.</div>
      <div style="margin-top:8px;">
        Add stock using the button above.
      </div>
    </div>
  <% } else { %>

    <% stocks.forEach((group) => { %>
      <% const products = (group.rows || []).reduce((all, row) => {
           return all.concat(Array.isArray(row.products) ? row.products : []);
         }, []); %>

      <% if (products.length) { %>
        <section class="category-section">
          <div class="category-head">
            <h2>
              <%= group.label || group.category?.name || "Other" %>
            </h2>
            <span class="category-count">
              <%= products.length %> stock <%= products.length === 1 ? "item" : "items" %>
            </span>
          </div>

          <div class="stock-grid">
            <% products.forEach((stock) => { %>
              <a href="/stock/<%= stock._id %>" class="stock-card">
                <div class="product-image">
                  <% if (stock.image) { %>
                    <img
                      src="<%= stock.image %>"
                      alt="<%= stock.subcategory || stock.name || 'Stock item' %>"
                      loading="lazy"
                      onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                    >
                    <div class="placeholder" style="display:none;">
                      <i class="fas fa-box"></i>
                    </div>
                  <% } else { %>
                    <div class="placeholder">
                      <i class="fas fa-box"></i>
                    </div>
                  <% } %>
                </div>

                <div class="product-info">
                  <div class="product-name">
                    <%= stock.name || stock.subcategory || "Unnamed stock" %>
                  </div>

                  <div class="subcategory">
                    Subcategory:
                    <strong><%= stock.subcategory || "Other" %></strong>
                  </div>

                  <div class="price">
                    KSh <%= Number(stock.buyPrice || 0).toLocaleString() %>
                  </div>

                  <% if (Number(stock.units || 0) > 0) { %>
                    <span class="stock-status">
                      <%= Number(stock.units).toLocaleString() %> available
                    </span>
                  <% } else { %>
                    <span class="stock-status out">Out of stock</span>
                  <% } %>

                  <div class="units">
                    Warehouse units:
                    <strong><%= Number(stock.units || 0).toLocaleString() %></strong>
                  </div>
                </div>
              </a>
            <% }) %>
          </div>
        </section>
      <% } %>
    <% }) %>

  <% } %>
</section>
