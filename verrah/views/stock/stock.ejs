<%
// ==========================================================
// views/stock/stock.ejs
// STOCK LISTING
//
// Displays ALL active stocks returned by stockService.listStock()
// grouped by category.
//
// IMPORTANT:
// This view does NOT create or modify stock.
// It only displays the data already returned by the backend.
// ==========================================================
%>

<section class="stock-page">


    <!-- ======================================================
         PAGE HEADER
    ======================================================= -->

    <div class="page-head">

        <div>

            <h1 class="page-title">
                Stock Management
            </h1>

            <p class="page-subtitle">
                All active warehouse stock, grouped by category.
            </p>

        </div>


        <a
            href="/stock/new"
            class="primary-btn"
        >

            <i class="fas fa-plus"></i>

            Add / Update Stock

        </a>

    </div>



    <!-- ======================================================
         ERROR MESSAGE
    ======================================================= -->

    <% if (
        typeof error !== "undefined" &&
        error
    ) { %>

        <div class="message error">

            <%= error %>

        </div>

    <% } %>



    <!-- ======================================================
         SUCCESS MESSAGE
    ======================================================= -->

    <% if (
        typeof saved !== "undefined" &&
        saved === "1"
    ) { %>

        <div class="message success">

            Stock saved successfully and is now listed below.

        </div>

    <% } %>



    <!-- ======================================================
         NO STOCK
    ======================================================= -->

    <% if (
        !Array.isArray(stocks) ||
        stocks.length === 0
    ) { %>


        <div class="empty">

            <i class="fas fa-warehouse"></i>

            <div>
                No stock records exist yet.
            </div>

            <div style="margin-top:8px;">

                Add stock using the button above.

            </div>

        </div>


    <% } else { %>



        <!-- ==================================================
             CATEGORY GROUPS
        =================================================== -->

        <% stocks.forEach((group) => { %>


            <% /*
               ------------------------------------------------
               stockService.listStock() returns:

               group
                 ├── category
                 ├── label
                 └── rows
                      ├── products
                      ├── products
                      └── ...

               Flatten all rows so EVERY stock is displayed.
               ------------------------------------------------
            */ %>

            <% const products =
                (group.rows || []).reduce(
                    (all, row) => {

                        if (
                            Array.isArray(row.products)
                        ) {

                            return all.concat(
                                row.products
                            );

                        }

                        return all;

                    },
                    []
                );
            %>



            <% if (products.length) { %>


                <section class="category-section">


                    <!-- ======================================
                         CATEGORY HEADER
                    ======================================= -->

                    <div class="category-head">

                        <h2>

                            <%=

                                group.label ||

                                group.category?.name ||

                                "Other"

                            %>

                        </h2>


                        <span class="category-count">

                            <%= products.length %>

                            stock

                            <%=

                                products.length === 1

                                    ? "item"

                                    : "items"

                            %>

                        </span>

                    </div>



                    <!-- ======================================
                         STOCK CARDS
                    ======================================= -->

                    <div class="stock-grid">


                        <% products.forEach((stock) => { %>


                            <a
                                href="/stock/<%= stock._id %>"
                                class="stock-card"
                            >


                                <!-- ==========================
                                     IMAGE
                                =========================== -->

                                <div class="product-image">


                                    <% if (stock.image) { %>


                                        <img
                                            src="<%= stock.image %>"
                                            alt="<%=

                                                stock.subcategory ||

                                                stock.name ||

                                                'Stock item'

                                            %>"
                                            loading="lazy"

                                            onerror="
                                                this.style.display='none';
                                                this.nextElementSibling.style.display='flex';
                                            "
                                        >


                                        <div
                                            class="placeholder"
                                            style="display:none;"
                                        >

                                            <i class="fas fa-box"></i>

                                        </div>


                                    <% } else { %>


                                        <div class="placeholder">

                                            <i class="fas fa-box"></i>

                                        </div>


                                    <% } %>


                                </div>



                                <!-- ==========================
                                     STOCK DETAILS
                                =========================== -->

                                <div class="product-info">


                                    <div class="product-name">

                                        <%=

                                            stock.name ||

                                            stock.subcategory ||

                                            "Unnamed stock"

                                        %>

                                    </div>



                                    <div class="subcategory">

                                        Subcategory:

                                        <strong>

                                            <%=

                                                stock.subcategory ||

                                                "Other"

                                            %>

                                        </strong>

                                    </div>



                                    <div class="price">

                                        KSh

                                        <%=

                                            Number(
                                                stock.buyPrice || 0
                                            ).toLocaleString()

                                        %>

                                    </div>



                                    <!-- ======================
                                         AVAILABILITY
                                    ======================= -->

                                    <% if (
                                        Number(stock.units || 0) > 0
                                    ) { %>


                                        <span class="stock-status">

                                            <%=

                                                Number(
                                                    stock.units
                                                ).toLocaleString()

                                            %>

                                            available

                                        </span>


                                    <% } else { %>


                                        <span class="stock-status out">

                                            Out of stock

                                        </span>


                                    <% } %>



                                    <!-- ======================
                                         UNITS
                                    ======================= -->

                                    <div class="units">

                                        Warehouse units:

                                        <strong>

                                            <%=

                                                Number(
                                                    stock.units || 0
                                                ).toLocaleString()

                                            %>

                                        </strong>

                                    </div>


                                </div>


                            </a>


                        <% }) %>


                    </div>


                </section>


            <% } %>


        <% }) %>


    <% } %>


</section>