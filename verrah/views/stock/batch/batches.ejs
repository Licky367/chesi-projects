<%
/*
==========================================================
VERRAH COSMETICS
STOCK FIFO BATCHES
==========================================================

ADMIN
-----
Displays:
    Stock.purchaseBatches

STAFF
-----
Displays:
    Product.fifoBatches

The service is responsible for filtering staff batches to
the authenticated user's assigned substation.

Routes MUST remain exactly as they already exist:

    GET /stock/:id/batches
    GET /stock/:id/batch/:batchId

Clicking a row opens:

    /stock/:stockId/batch/:batchId

New batch form:

    units
    totalBuyingPrice
    purchasedAt

The service calculates:

    buyPrice = totalBuyingPrice / units

IMPORTANT:
This view does NOT change any route.
==========================================================
*/


const stockId =
    stock && stock._id
        ? stock._id.toString()
        : "";


// ==========================================================
// DETERMINE STAFF
// ==========================================================

const isStaff =
    typeof user !== "undefined" &&
    user &&
    user.role === "staff";


// ==========================================================
// SORT BATCHES
//
// Supports both:
//
//     purchasedAt
//
// and:
//
//     receivedAt
//
// This is useful because Product FIFO batches may have been
// created by different FIFO creation services.
//
// ==========================================================

const sortedBatches =
    Array.isArray(batches)
        ? [...batches].sort((a, b) => {

            const aRawDate =
                a.purchasedAt ||
                a.receivedAt ||
                a.createdAt ||
                null;

            const bRawDate =
                b.purchasedAt ||
                b.receivedAt ||
                b.createdAt ||
                null;

            const aDate =
                aRawDate
                    ? new Date(aRawDate).getTime()
                    : 0;

            const bDate =
                bRawDate
                    ? new Date(bRawDate).getTime()
                    : 0;

            return bDate - aDate;

        })
        : [];

%>


<div class="sales-page">


    <!-- =====================================================
         HEADER
    ====================================================== -->

    <div class="sales-header">

        <div class="sales-header-icon">

            <i class="fas fa-boxes-stacked"></i>

        </div>


        <div>

            <h1 class="sales-title">

                <%= isStaff
                    ? "Product Batches"
                    : "Stock Batches" %>

            </h1>


            <p class="sales-subtitle">

                <%= stock && stock.name
                    ? stock.name
                    : "Stock Purchase Batches" %>

            </p>

        </div>

    </div>


    <!-- =====================================================
         STOCK NAVIGATION
    ====================================================== -->

    <div class="sales-navigation">


        <!-- ================================================
             STOCK DETAILS
        ================================================= -->

        <a
            href="/stock/<%= stockId %>"
            class="sales-navigation-tab"
        >

            <i class="fas fa-box"></i>

            Stock Details

        </a>


        <!-- ================================================
             BATCHES
        ================================================= -->

        <a
            href="/stock/<%= stockId %>/batches"
            class="sales-navigation-tab active"
        >

            <i class="fas fa-layer-group"></i>

            Batches

        </a>


    </div>


    <!-- =====================================================
         TABS
    ====================================================== -->

    <div class="verrah-tabs-container">


        <!-- =================================================
             TAB BAR
        ================================================== -->

        <div class="verrah-tabs">


            <!-- =============================================
                 BATCHES TAB
            ============================================== -->

            <button
                type="button"
                class="verrah-tab active"
                data-tab="batches"
            >

                <i class="fas fa-layer-group"></i>

                Batches

            </button>


            <!-- =============================================
                 NEW BATCH TAB
            ============================================== -->

            <button
                type="button"
                class="verrah-tab"
                data-tab="new-batch"
            >

                <i class="fas fa-plus"></i>

                New Batch

            </button>


        </div>


        <!-- =================================================
             TAB CONTENT
        ================================================== -->

        <div class="verrah-tab-content">


            <!-- =================================================
                 BATCHES PANEL
            ================================================== -->

            <div
                class="verrah-tab-panel active"
                data-panel="batches"
            >


                <section class="sales-section">


                    <div class="sales-section-heading">

                        <div>

                            <h2>

                                <%= isStaff
                                    ? "Product FIFO Batches"
                                    : "Purchase Batches" %>

                            </h2>


                            <p class="sales-subtitle">

                                <% if (isStaff) { %>

                                    FIFO batches belonging to your
                                    assigned substation.

                                <% } else { %>

                                    Existing FIFO purchase batches
                                    for this stock.

                                <% } %>

                            </p>

                        </div>

                    </div>


                    <!-- =========================================
                         BATCH TABLE
                    ========================================== -->

                    <% if (sortedBatches.length > 0) { %>


                        <div class="sales-table-wrapper">

                            <table class="sales-table">


                                <thead>

                                    <tr>

                                        <th>
                                            Date
                                        </th>


                                        <th>
                                            Units
                                        </th>


                                        <th>
                                            Buy Price
                                        </th>

                                    </tr>

                                </thead>


                                <tbody>


                                    <% sortedBatches.forEach(batch => { %>


                                        <%
                                        /*
                                        ==================================================
                                        BATCH DATE
                                        ==================================================
                                        */

                                        const batchRawDate =
                                            batch.purchasedAt ||
                                            batch.receivedAt ||
                                            batch.createdAt ||
                                            null;


                                        const batchDate =
                                            batchRawDate
                                                ? new Date(
                                                    batchRawDate
                                                )
                                                : null;
                                        %>


                                        <tr
                                            class="sales-product-row"
                                            tabindex="0"
                                            role="link"

                                            /*
                                            ==================================================
                                            IMPORTANT:
                                            KEEP EXISTING ROUTE EXACTLY.

                                            /stock/:stockId/batch/:batchId

                                            DO NOT CHANGE TO /batches/
                                            ==================================================
                                            */

                                            onclick="
                                                window.location.href =
                                                '/stock/<%= stockId %>/batch/<%= batch._id %>';
                                            "

                                            onkeydown="
                                                if (
                                                    event.key === 'Enter' ||
                                                    event.key === ' '
                                                ) {
                                                    event.preventDefault();

                                                    window.location.href =
                                                    '/stock/<%= stockId %>/batch/<%= batch._id %>';
                                                }
                                            "
                                        >


                                            <!-- =================
                                                 DATE
                                            ================== -->

                                            <td>


                                                <% if (
                                                    batchDate &&
                                                    !isNaN(
                                                        batchDate.getTime()
                                                    )
                                                ) { %>


                                                    <%= batchDate.toLocaleDateString(
                                                        "en-KE",
                                                        {
                                                            day: "2-digit",
                                                            month: "short",
                                                            year: "numeric"
                                                        }
                                                    ) %>


                                                <% } else { %>


                                                    <span class="sales-muted">
                                                        —
                                                    </span>


                                                <% } %>


                                            </td>


                                            <!-- =================
                                                 UNITS
                                            ================== -->

                                            <td>

                                                <%= Number(
                                                    batch.units || 0
                                                ).toLocaleString(
                                                    "en-KE"
                                                ) %>

                                            </td>


                                            <!-- =================
                                                 BUY PRICE
                                            ================== -->

                                            <td>

                                                KSh
                                                <%= Number(
                                                    batch.buyPrice || 0
                                                ).toLocaleString(
                                                    "en-KE",
                                                    {
                                                        minimumFractionDigits: 2,
                                                        maximumFractionDigits: 2
                                                    }
                                                ) %>

                                            </td>


                                        </tr>


                                    <% }) %>


                                </tbody>

                            </table>

                        </div>


                    <% } else { %>


                        <!-- =====================================
                             EMPTY STATE
                        ====================================== -->

                        <div class="sales-table-wrapper">

                            <table class="sales-table">

                                <tbody>

                                    <tr>

                                        <td
                                            colspan="3"
                                            class="sales-empty"
                                        >

                                            <i class="fas fa-box-open"></i>

                                            <br>


                                            <% if (isStaff) { %>

                                                No FIFO batches found for
                                                your assigned substation.

                                            <% } else { %>

                                                No purchase batches found
                                                for this stock.

                                            <% } %>


                                        </td>

                                    </tr>

                                </tbody>

                            </table>

                        </div>


                    <% } %>


                </section>


            </div>


            <!-- =================================================
                 NEW BATCH PANEL
            ================================================== -->

            <div
                class="verrah-tab-panel"
                data-panel="new-batch"
            >


                <section class="sales-section">


                    <div class="sales-section-heading">

                        <div>

                            <h2>
                                Create New Batch
                            </h2>


                            <p class="sales-subtitle">

                                <% if (isStaff) { %>

                                    Add a new FIFO batch to your
                                    assigned substation.

                                <% } else { %>

                                    Add a new purchase batch to
                                    <%= stock && stock.name
                                        ? stock.name
                                        : "this stock" %>.

                                <% } %>

                            </p>

                        </div>

                    </div>


                    <!-- =========================================
                         NEW BATCH FORM
                    ========================================== -->

                    <form
                        action="/stock/<%= stockId %>/batches"
                        method="POST"
                        class="sales-filter"
                    >


                        <!-- =====================================
                             UNITS
                        ====================================== -->

                        <div class="sales-filter-field">

                            <label for="units">

                                Units

                            </label>


                            <input
                                type="number"
                                id="units"
                                name="units"
                                min="1"
                                step="1"
                                required
                                inputmode="numeric"
                                placeholder="Number of units"
                            >

                        </div>


                        <!-- =====================================
                             TOTAL BUYING PRICE
                        ====================================== -->

                        <div class="sales-filter-field">

                            <label for="totalBuyingPrice">

                                Total Buying Price

                            </label>


                            <input
                                type="number"
                                id="totalBuyingPrice"
                                name="totalBuyingPrice"
                                min="0"
                                step="0.01"
                                required
                                inputmode="decimal"
                                placeholder="Total amount paid"
                            >

                        </div>


                        <!-- =====================================
                             PURCHASE DATE
                        ====================================== -->

                        <div class="sales-filter-field">

                            <label for="purchasedAt">

                                Purchase Date

                            </label>


                            <input
                                type="date"
                                id="purchasedAt"
                                name="purchasedAt"
                            >

                        </div>


                        <!-- =====================================
                             CALCULATED BUY PRICE
                        ====================================== -->

                        <div class="sales-filter-field">

                            <label>

                                Buy Price Per Unit

                            </label>


                            <div
                                class="sales-liability-assigned"
                            >

                                <span
                                    class="sales-liability-assigned-label"
                                >

                                    Calculated automatically

                                </span>


                                <strong
                                    id="calculatedBuyPrice"
                                >

                                    KSh 0.00

                                </strong>

                            </div>

                        </div>


                        <!-- =====================================
                             SUBMIT
                        ====================================== -->

                        <button
                            type="submit"
                            class="sales-filter-button"
                        >

                            <i class="fas fa-plus"></i>

                            Create Batch

                        </button>


                    </form>


                </section>


            </div>


        </div>

    </div>

</div>


<!-- ==========================================================
     TAB SWITCHING + BUY PRICE CALCULATION
=========================================================== -->

<script>

(function () {


    // ======================================================
    // TABS
    // ======================================================

    const tabs =
        document.querySelectorAll(
            ".verrah-tab"
        );


    const panels =
        document.querySelectorAll(
            ".verrah-tab-panel"
        );


    tabs.forEach(
        tab => {

            tab.addEventListener(
                "click",
                function () {

                    const target =
                        this.dataset.tab;


                    // ======================================
                    // DEACTIVATE ALL TABS
                    // ======================================

                    tabs.forEach(
                        currentTab => {

                            currentTab.classList.remove(
                                "active"
                            );

                        }
                    );


                    // ======================================
                    // HIDE ALL PANELS
                    // ======================================

                    panels.forEach(
                        panel => {

                            panel.classList.remove(
                                "active"
                            );

                        }
                    );


                    // ======================================
                    // ACTIVATE SELECTED TAB
                    // ======================================

                    this.classList.add(
                        "active"
                    );


                    const targetPanel =
                        document.querySelector(
                            '[data-panel="' +
                            target +
                            '"]'
                        );


                    if (targetPanel) {

                        targetPanel.classList.add(
                            "active"
                        );

                    }

                }
            );

        }
    );


    // ======================================================
    // BUY PRICE CALCULATION
    // ======================================================

    const unitsInput =
        document.getElementById(
            "units"
        );


    const totalBuyingPriceInput =
        document.getElementById(
            "totalBuyingPrice"
        );


    const calculatedBuyPrice =
        document.getElementById(
            "calculatedBuyPrice"
        );


    function calculateBuyPrice() {

        const units =
            Number(
                unitsInput.value
            );


        const totalBuyingPrice =
            Number(
                totalBuyingPriceInput.value
            );


        if (
            !Number.isFinite(units) ||
            units <= 0 ||
            !Number.isFinite(
                totalBuyingPrice
            ) ||
            totalBuyingPrice < 0
        ) {

            calculatedBuyPrice.textContent =
                "KSh 0.00";

            return;
        }


        const buyPrice =
            totalBuyingPrice /
            units;


        calculatedBuyPrice.textContent =
            "KSh " +
            buyPrice.toLocaleString(
                "en-KE",
                {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                }
            );

    }


    if (
        unitsInput &&
        totalBuyingPriceInput &&
        calculatedBuyPrice
    ) {

        unitsInput.addEventListener(
            "input",
            calculateBuyPrice
        );


        totalBuyingPriceInput.addEventListener(
            "input",
            calculateBuyPrice
        );

    }

})();

</script>