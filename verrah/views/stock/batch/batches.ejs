<%
/*
==========================================================
VERRAH COSMETICS
STOCK FIFO BATCHES
==========================================================

Displays all purchase batches belonging to a stock entry.

Tabs:
    Stock Details
    Batches
    New Batch

Columns:
    Date
    Units
    Buy Price

Latest batch appears first.

Clicking a row opens:
    /stock/:stockId/batch/:batchId
==========================================================
*/


const stockId =
    stock && stock._id
        ? stock._id.toString()
        : "";


// ==========================================================
// SORT BATCHES
// ==========================================================

const sortedBatches =
    Array.isArray(batches)
        ? [...batches].sort((a, b) => {

            const aDate =
                new Date(a.purchasedAt).getTime();

            const bDate =
                new Date(b.purchasedAt).getTime();

            return bDate - aDate;
        })
        : [];

%>


<div class="sales-page">

    <!-- =====================================================
         HEADER
    ====================================================== -->

    <div class="sales-header">

        <div class="sales-header-icon">
            <i class="fas fa-boxes-stacked"></i>
        </div>

        <div>

            <h1 class="sales-title">
                Stock Batches
            </h1>

            <p class="sales-subtitle">

                <%= stock && stock.name
                    ? stock.name
                    : "Stock Purchase Batches" %>

            </p>

        </div>

    </div>


    <!-- =====================================================
         NAVIGATION
    ====================================================== -->

    <div class="sales-navigation">

        <a
            href="/stock/<%= stockId %>"
            class="sales-navigation-tab"
        >
            <i class="fas fa-box"></i>
            Stock Details
        </a>


        <a
            href="/stock/<%= stockId %>/batches"
            class="sales-navigation-tab active"
        >
            <i class="fas fa-layer-group"></i>
            Batches
        </a>


        <a
            href="#new-batch"
            class="sales-navigation-tab"
            onclick="
                document
                    .getElementById('new-batch')
                    .scrollIntoView({
                        behavior: 'smooth'
                    });
                return false;
            "
        >
            <i class="fas fa-plus"></i>
            New Batch
        </a>

    </div>


    <!-- =====================================================
         BATCH CONTENT
    ====================================================== -->

    <div class="sales-content">

        <!-- =================================================
             PURCHASE BATCHES
        ================================================== -->

        <section class="sales-section">

            <div class="sales-section-heading">

                <div>

                    <h2>
                        Purchase Batches
                    </h2>

                </div>

            </div>


            <!-- =================================================
                 BATCH TABLE
            ================================================== -->

            <% if (sortedBatches.length > 0) { %>

                <div class="sales-table-wrapper">

                    <table class="sales-table">

                        <thead>

                            <tr>

                                <th>
                                    Date
                                </th>

                                <th>
                                    Units
                                </th>

                                <th>
                                    Buy Price
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            <% sortedBatches.forEach(batch => { %>

                                <tr
                                    class="sales-product-row"
                                    tabindex="0"
                                    role="link"
                                    onclick="window.location.href='/stock/<%= stockId %>/batch/<%= batch._id %>'"
                                    onkeydown="
                                        if (event.key === 'Enter' || event.key === ' ') {
                                            event.preventDefault();
                                            window.location.href='/stock/<%= stockId %>/batch/<%= batch._id %>';
                                        }
                                    "
                                >

                                    <!-- =================================
                                         DATE
                                    ================================== -->

                                    <td>

                                        <%
                                        const batchDate =
                                            batch.purchasedAt
                                                ? new Date(batch.purchasedAt)
                                                : null;
                                        %>

                                        <% if (batchDate && !isNaN(batchDate.getTime())) { %>

                                            <%= batchDate.toLocaleDateString(
                                                "en-KE",
                                                {
                                                    day: "2-digit",
                                                    month: "short",
                                                    year: "numeric"
                                                }
                                            ) %>

                                        <% } else { %>

                                            <span class="sales-muted">
                                                —
                                            </span>

                                        <% } %>

                                    </td>


                                    <!-- =================================
                                         UNITS
                                    ================================== -->

                                    <td>

                                        <%= Number(
                                            batch.units || 0
                                        ).toLocaleString() %>

                                    </td>


                                    <!-- =================================
                                         BUY PRICE
                                    ================================== -->

                                    <td>

                                        KSh
                                        <%= Number(
                                            batch.buyPrice || 0
                                        ).toLocaleString(
                                            "en-KE",
                                            {
                                                minimumFractionDigits: 2,
                                                maximumFractionDigits: 2
                                            }
                                        ) %>

                                    </td>

                                </tr>

                            <% }) %>

                        </tbody>

                    </table>

                </div>


            <% } else { %>


                <!-- =================================================
                     EMPTY STATE
                ================================================== -->

                <div class="sales-table-wrapper">

                    <table class="sales-table">

                        <tbody>

                            <tr>

                                <td
                                    colspan="3"
                                    class="sales-empty"
                                >

                                    <i class="fas fa-box-open"></i>

                                    <br>

                                    No purchase batches found for this stock.

                                </td>

                            </tr>

                        </tbody>

                    </table>

                </div>

            <% } %>

        </section>


        <!-- =====================================================
             NEW BATCH
        ====================================================== -->

        <section
            class="sales-section"
            id="new-batch"
        >

            <div class="sales-section-heading">

                <div>

                    <h2>
                        Create New Batch
                    </h2>

                    <p class="sales-subtitle">
                        Add a new purchase batch to this stock.
                    </p>

                </div>

            </div>


            <!-- =================================================
                 NEW BATCH FORM
            ================================================== -->

            <form
                action="/stock/<%= stockId %>/batches"
                method="POST"
            >

                <!-- =============================================
                     UNITS
                ============================================== -->

                <div class="sales-form-group">

                    <label for="units">
                        Units
                    </label>

                    <input
                        type="number"
                        id="units"
                        name="units"
                        min="1"
                        step="1"
                        required
                        inputmode="numeric"
                        placeholder="Enter number of units"
                    >

                </div>


                <!-- =============================================
                     TOTAL BUYING PRICE
                ============================================== -->

                <div class="sales-form-group">

                    <label for="totalBuyingPrice">
                        Total Buying Price
                    </label>

                    <input
                        type="number"
                        id="totalBuyingPrice"
                        name="totalBuyingPrice"
                        min="0"
                        step="0.01"
                        required
                        inputmode="decimal"
                        placeholder="Enter total buying price"
                    >

                    <small class="sales-muted">
                        Enter the total amount paid for the entire batch.
                    </small>

                </div>


                <!-- =============================================
                     PURCHASE DATE
                ============================================== -->

                <div class="sales-form-group">

                    <label for="purchasedAt">
                        Purchase Date
                    </label>

                    <input
                        type="date"
                        id="purchasedAt"
                        name="purchasedAt"
                    >

                </div>


                <!-- =============================================
                     CALCULATED BUY PRICE
                ============================================== -->

                <div class="sales-form-group">

                    <label>
                        Buy Price Per Unit
                    </label>

                    <div
                        class="sales-muted"
                        id="calculatedBuyPrice"
                    >
                        KSh 0.00
                    </div>

                </div>


                <!-- =============================================
                     SUBMIT
                ============================================== -->

                <button
                    type="submit"
                    class="sales-button"
                >

                    <i class="fas fa-plus"></i>

                    Create Batch

                </button>

            </form>

        </section>

    </div>

</div>


<!-- ==========================================================
     BUY PRICE CALCULATION
=========================================================== -->

<script>

(function () {

    const unitsInput =
        document.getElementById("units");

    const totalInput =
        document.getElementById(
            "totalBuyingPrice"
        );

    const result =
        document.getElementById(
            "calculatedBuyPrice"
        );


    function calculateBuyPrice() {

        const units =
            Number(
                unitsInput.value
            );

        const total =
            Number(
                totalInput.value
            );


        if (
            !Number.isFinite(units) ||
            units <= 0 ||
            !Number.isFinite(total) ||
            total < 0
        ) {

            result.textContent =
                "KSh 0.00";

            return;
        }


        const buyPrice =
            total / units;


        result.textContent =
            "KSh " +
            buyPrice.toLocaleString(
                "en-KE",
                {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                }
            );
    }


    unitsInput.addEventListener(
        "input",
        calculateBuyPrice
    );


    totalInput.addEventListener(
        "input",
        calculateBuyPrice
    );

})();

</script>