<%
/*
==========================================================
VERRAH COSMETICS
STOCK FIFO BATCH
EDIT PAGE
==========================================================

Expected variables:

    stock
    batch
    error
    saved
    user

Editable:

    units
    buyPrice

Read-only:

    purchasedAt / receivedAt

ROUTES — DO NOT CHANGE:

    GET  /stock/:id/batches
    GET  /stock/:id/batch/:batchId
    POST /stock/:id/batch/:batchId
==========================================================
*/


const stockId =
    stock && stock._id
        ? stock._id.toString()
        : "";

const batchId =
    batch && batch._id
        ? batch._id.toString()
        : "";


/*
==========================================================
STAFF
==========================================================

Staff batches belong to Product.fifoBatches and use:

    StaffFIFOsubstation

Admin/non-staff batches belong to:

    Stock.purchaseBatches
==========================================================
*/

const isStaff =
    typeof user !== "undefined" &&
    user &&
    user.role === "staff";


/*
==========================================================
BATCH DATE
==========================================================

Support both possible FIFO date fields:

    purchasedAt
    receivedAt

This allows the same view to display:

    Stock.purchaseBatches
    Product.fifoBatches
==========================================================
*/

const rawBatchDate =
    batch
    && (
        batch.purchasedAt ||
        batch.receivedAt ||
        batch.createdAt
    )
        ? (
            batch.purchasedAt ||
            batch.receivedAt ||
            batch.createdAt
        )
        : null;


const batchDate =
    rawBatchDate
        ? new Date(rawBatchDate)
        : null;


/*
==========================================================
CURRENT UNITS
==========================================================
*/

const currentUnits =
    batch &&
    batch.units !== undefined &&
    batch.units !== null
        ? String(batch.units)
        : "";


/*
==========================================================
CURRENT BUY PRICE
==========================================================
*/

const currentBuyPrice =
    batch &&
    batch.buyPrice !== undefined &&
    batch.buyPrice !== null
        ? String(batch.buyPrice)
        : "";

%>


<div class="sales-page">

    <!-- =====================================================
         HEADER
    ====================================================== -->

    <div class="sales-header">

        <div class="sales-header-icon">
            <i class="fas fa-layer-group"></i>
        </div>

        <div>

            <h1 class="sales-title">
                Edit FIFO Batch
            </h1>

            <p class="sales-subtitle">

                <%= stock && stock.name
                    ? stock.name
                    : "Stock Batch" %>

            </p>

        </div>

    </div>


    <!-- =====================================================
         NAVIGATION
    ====================================================== -->

    <div class="sales-navigation">

        <a
            href="/stock/<%= stockId %>/batches"
            class="sales-navigation-tab"
        >
            <i class="fas fa-layer-group"></i>
            Batches
        </a>


        <a
            href="/stock/<%= stockId %>"
            class="sales-navigation-tab"
        >
            <i class="fas fa-box"></i>
            Stock Details
        </a>

    </div>


    <!-- =====================================================
         ERROR
    ====================================================== -->

    <% if (error) { %>

        <div class="sales-liability-entry">

            <div style="
                color:#8a2f2f;
                font-weight:700;
            ">

                <i class="fas fa-circle-exclamation"></i>

                <%= error %>

            </div>

        </div>

    <% } %>


    <!-- =====================================================
         SAVED
    ====================================================== -->

    <% if (saved) { %>

        <div class="sales-liability-entry">

            <div style="
                color:#356b35;
                font-weight:700;
            ">

                <i class="fas fa-circle-check"></i>

                FIFO batch updated successfully.

            </div>

        </div>

    <% } %>


    <!-- =====================================================
         CONTENT
    ====================================================== -->

    <div class="sales-content">

        <section class="sales-section">

            <div class="sales-liability-entry">

                <div class="sales-section-heading">

                    <div>

                        <h2>
                            Batch Details
                        </h2>

                    </div>

                </div>


                <!-- =================================================
                     BATCH TYPE
                ================================================== -->

                <div class="sales-liability-field">

                    <label>
                        Batch Type
                    </label>

                    <div class="sales-liability-assigned">

                        <span class="sales-liability-assigned-label">
                            FIFO
                        </span>

                        <strong>

                            <% if (isStaff) { %>

                                Product FIFO Batch

                            <% } else { %>

                                Stock Purchase Batch

                            <% } %>

                        </strong>

                    </div>

                </div>


                <!-- =================================================
                     FORM
                ================================================== -->

                <form
                    id="stockBatchEditForm"
                    method="POST"
                    action="/stock/<%= stockId %>/batch/<%= batchId %>"
                    class="sales-liability-form"
                >

                    <!-- =============================================
                         PURCHASE DATE
                    ============================================== -->

                    <div class="sales-liability-field">

                        <label>
                            Purchase Date
                        </label>

                        <div class="sales-liability-assigned">

                            <span class="sales-liability-assigned-label">
                                Purchased
                            </span>

                            <strong>

                                <% if (
                                    batchDate &&
                                    !isNaN(
                                        batchDate.getTime()
                                    )
                                ) { %>

                                    <%= batchDate.toLocaleDateString(
                                        "en-KE",
                                        {
                                            day: "2-digit",
                                            month: "short",
                                            year: "numeric"
                                        }
                                    ) %>

                                <% } else { %>

                                    —

                                <% } %>

                            </strong>

                        </div>

                    </div>


                    <!-- =============================================
                         BATCH ID
                    ============================================== -->

                    <div class="sales-liability-field">

                        <label>
                            Batch ID
                        </label>

                        <div class="sales-liability-assigned">

                            <span class="sales-liability-assigned-label">
                                FIFO Batch
                            </span>

                            <strong>
                                <%= batchId %>
                            </strong>

                        </div>

                    </div>


                    <!-- =============================================
                         STAFF SUBSTATION
                    ============================================== -->

                    <% if (isStaff) { %>

                        <div class="sales-liability-field">

                            <label>
                                Substation
                            </label>

                            <div class="sales-liability-assigned">

                                <span class="sales-liability-assigned-label">
                                    Assigned
                                </span>

                                <strong>

                                    <%
                                    const staffSubstation =
                                        batch &&
                                        batch.StaffFIFOsubstation
                                            ? batch.StaffFIFOsubstation
                                            : (
                                                user &&
                                                user.assignedSubstation
                                                    ? user.assignedSubstation
                                                    : null
                                            );
                                    %>

                                    <%= staffSubstation || "Assigned Substation" %>

                                </strong>

                            </div>

                        </div>

                    <% } %>


                    <!-- =============================================
                         UNITS
                    ============================================== -->

                    <div class="sales-liability-field">

                        <label for="units">
                            Units
                        </label>

                        <input
                            type="number"
                            id="units"
                            name="units"
                            value="<%= currentUnits %>"
                            min="0"
                            step="1"
                            inputmode="numeric"
                            autocomplete="off"
                            required
                        >

                    </div>


                    <!-- =============================================
                         BUY PRICE
                    ============================================== -->

                    <div class="sales-liability-field">

                        <label for="buyPrice">
                            Unit Buy Price
                        </label>

                        <input
                            type="number"
                            id="buyPrice"
                            name="buyPrice"
                            value="<%= currentBuyPrice %>"
                            min="0"
                            step="0.01"
                            inputmode="decimal"
                            autocomplete="off"
                            required
                        >

                    </div>


                    <!-- =================================================
                         ACTIONS
                    ================================================== -->

                    <div class="sales-liability-form-actions">

                        <button
                            type="submit"
                            class="sales-liability-submit"
                        >

                            <i class="fas fa-save"></i>

                            Save Changes

                        </button>


                        <a
                            href="/stock/<%= stockId %>/batches"
                            class="sales-filter-clear"
                        >

                            <i class="fas fa-arrow-left"></i>

                            Cancel

                        </a>

                    </div>

                </form>

            </div>

        </section>

    </div>

</div>


<!-- ==========================================================
     FORM SUBMISSION
=========================================================== -->

<script>

(function () {

    const form =
        document.getElementById(
            "stockBatchEditForm"
        );


    if (!form) {
        return;
    }


    form.addEventListener(
        "submit",
        function (event) {

            const unitsInput =
                document.getElementById(
                    "units"
                );

            const buyPriceInput =
                document.getElementById(
                    "buyPrice"
                );


            /*
             * ======================================================
             * UNITS
             * ======================================================
             */

            if (!unitsInput) {

                event.preventDefault();

                return;
            }


            const rawUnits =
                String(
                    unitsInput.value || ""
                ).trim();


            if (!rawUnits) {

                event.preventDefault();

                unitsInput.focus();

                return;
            }


            const units =
                Number(rawUnits);


            /*
             * Units must be a safe,
             * non-negative whole number.
             */

            if (
                !Number.isSafeInteger(
                    units
                ) ||
                units < 0
            ) {

                event.preventDefault();

                unitsInput.focus();

                return;
            }


            unitsInput.value =
                String(units);


            /*
             * ======================================================
             * BUY PRICE
             * ======================================================
             */

            if (buyPriceInput) {

                const rawBuyPrice =
                    String(
                        buyPriceInput.value || ""
                    ).trim();


                if (!rawBuyPrice) {

                    event.preventDefault();

                    buyPriceInput.focus();

                    return;
                }


                const buyPrice =
                    Number(
                        rawBuyPrice
                    );


                if (
                    !Number.isFinite(
                        buyPrice
                    ) ||
                    buyPrice < 0
                ) {

                    event.preventDefault();

                    buyPriceInput.focus();

                    return;
                }


                buyPriceInput.value =
                    String(buyPrice);

            }


            /*
             * ======================================================
             * HIDDEN NORMALIZED UNITS
             * ======================================================
             *
             * Ensure only one explicit units
             * parameter exists.
             */

            const existingHidden =
                form.querySelector(
                    'input[type="hidden"][data-stock-units]'
                );


            if (existingHidden) {

                existingHidden.remove();

            }


            const hiddenUnits =
                document.createElement(
                    "input"
                );


            hiddenUnits.type =
                "hidden";

            hiddenUnits.name =
                "units";

            hiddenUnits.value =
                String(units);

            hiddenUnits.dataset.stockUnits =
                "true";


            form.appendChild(
                hiddenUnits
            );

        }
    );

})();

</script>