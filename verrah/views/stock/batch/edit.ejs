<%
/*
==========================================================
VERRAH COSMETICS
STOCK FIFO BATCH
EDIT PAGE
==========================================================

Expected variables:

    stock
    batch
    error
    saved

Editable:

    units
    buyPrice

Read-only:

    purchasedAt
==========================================================
*/


const stockId =
    stock && stock._id
        ? stock._id.toString()
        : "";

const batchId =
    batch && batch._id
        ? batch._id.toString()
        : "";


const batchDate =
    batch && batch.purchasedAt
        ? new Date(batch.purchasedAt)
        : null;


/*
 * Keep the existing batch units as a string.
 *
 * Do NOT use Number() here.
 *
 * The value is going directly into the
 * HTML form field.
 */
const currentUnits =
    batch &&
    batch.units !== undefined &&
    batch.units !== null
        ? String(batch.units)
        : "";


const currentBuyPrice =
    batch &&
    batch.buyPrice !== undefined &&
    batch.buyPrice !== null
        ? String(batch.buyPrice)
        : "";

%>


<div class="sales-page">

    <!-- =====================================================
         HEADER
    ====================================================== -->

    <div class="sales-header">

        <div class="sales-header-icon">
            <i class="fas fa-layer-group"></i>
        </div>

        <div>

            <h1 class="sales-title">
                Edit Stock Batch
            </h1>

            <p class="sales-subtitle">

                <%= stock && stock.name
                    ? stock.name
                    : "Stock Batch" %>

            </p>

        </div>

    </div>


    <!-- =====================================================
         NAVIGATION
    ====================================================== -->

    <div class="sales-navigation">

        <a
            href="/stock/<%= stockId %>/batches"
            class="sales-navigation-tab"
        >
            <i class="fas fa-layer-group"></i>
            Batches
        </a>

        <a
            href="/stock/<%= stockId %>"
            class="sales-navigation-tab"
        >
            <i class="fas fa-box"></i>
            Stock Details
        </a>

    </div>


    <!-- =====================================================
         ERROR
    ====================================================== -->

    <% if (error) { %>

        <div class="sales-liability-entry">

            <div style="
                color:#8a2f2f;
                font-weight:700;
            ">

                <i class="fas fa-circle-exclamation"></i>

                <%= error %>

            </div>

        </div>

    <% } %>


    <!-- =====================================================
         SAVED
    ====================================================== -->

    <% if (saved) { %>

        <div class="sales-liability-entry">

            <div style="
                color:#356b35;
                font-weight:700;
            ">

                <i class="fas fa-circle-check"></i>

                Stock batch updated successfully.

            </div>

        </div>

    <% } %>


    <!-- =====================================================
         CONTENT
    ====================================================== -->

    <div class="sales-content">

        <section class="sales-section">

            <div class="sales-liability-entry">

                <div class="sales-section-heading">

                    <div>

                        <h2>
                            Batch Details
                        </h2>

                    </div>

                </div>


                <!-- =================================================
                     FORM
                ================================================== -->

                <form
                    id="stockBatchEditForm"
                    method="POST"
                    action="/stock/<%= stockId %>/batches/<%= batchId %>"
                    class="sales-liability-form"
                >

                    <!-- =============================================
                         PURCHASE DATE
                    ============================================== -->

                    <div class="sales-liability-field">

                        <label>
                            Purchase Date
                        </label>

                        <div class="sales-liability-assigned">

                            <span class="sales-liability-assigned-label">
                                Purchased
                            </span>

                            <strong>

                                <% if (
                                    batchDate &&
                                    !isNaN(
                                        batchDate.getTime()
                                    )
                                ) { %>

                                    <%= batchDate.toLocaleDateString(
                                        "en-KE",
                                        {
                                            day: "2-digit",
                                            month: "short",
                                            year: "numeric"
                                        }
                                    ) %>

                                <% } else { %>

                                    —

                                <% } %>

                            </strong>

                        </div>

                    </div>


                    <!-- =============================================
                         BATCH ID
                    ============================================== -->

                    <div class="sales-liability-field">

                        <label>
                            Batch ID
                        </label>

                        <div class="sales-liability-assigned">

                            <span class="sales-liability-assigned-label">
                                FIFO Batch
                            </span>

                            <strong>
                                <%= batchId %>
                            </strong>

                        </div>

                    </div>


                    <!-- =============================================
                         UNITS
                    ============================================== -->

                    <div class="sales-liability-field">

                        <label for="units">
                            Units
                        </label>

                        <input
                            type="number"
                            id="units"
                            name="units"
                            value="<%= currentUnits %>"
                            min="0"
                            step="1"
                            inputmode="numeric"
                            autocomplete="off"
                            required
                        >

                    </div>


                    <!-- =============================================
                         BUY PRICE
                    ============================================== -->

                    <div class="sales-liability-field">

                        <label for="buyPrice">
                            Buy Price
                        </label>

                        <input
                            type="number"
                            id="buyPrice"
                            name="buyPrice"
                            value="<%= currentBuyPrice %>"
                            min="0"
                            step="0.01"
                            inputmode="decimal"
                            autocomplete="off"
                            required
                        >

                    </div>


                    <!-- =============================================
                         ACTIONS
                    ============================================== -->

                    <div class="sales-liability-form-actions">

                        <button
                            type="submit"
                            class="sales-liability-submit"
                        >

                            <i class="fas fa-save"></i>

                            Save Changes

                        </button>


                        <a
                            href="/stock/<%= stockId %>/batches"
                            class="sales-filter-clear"
                        >

                            <i class="fas fa-arrow-left"></i>

                            Cancel

                        </a>

                    </div>

                </form>

            </div>

        </section>

    </div>

</div>


<!-- ==========================================================
     FORM SUBMISSION
=========================================================== -->

<script>

(function () {

    const form =
        document.getElementById(
            "stockBatchEditForm"
        );


    if (!form) {
        return;
    }


    form.addEventListener(
        "submit",
        function (event) {

            const unitsInput =
                document.getElementById(
                    "units"
                );

            const buyPriceInput =
                document.getElementById(
                    "buyPrice"
                );


            if (!unitsInput) {

                event.preventDefault();

                return;
            }


            /*
             * Read the actual input value.
             */
            const rawUnits =
                String(
                    unitsInput.value || ""
                ).trim();


            /*
             * If the browser somehow gives us
             * an empty value, stop submission.
             */
            if (!rawUnits) {

                event.preventDefault();

                unitsInput.focus();

                return;
            }


            /*
             * Convert only after confirming
             * that a value exists.
             */
            const units =
                Number(rawUnits);


            /*
             * Units must be a non-negative
             * whole number.
             */
            if (
                !Number.isSafeInteger(
                    units
                ) ||
                units < 0
            ) {

                event.preventDefault();

                unitsInput.focus();

                return;
            }


            /*
             * IMPORTANT:
             *
             * Explicitly put the normalized
             * integer back into the input.
             *
             * Because the input has:
             *
             *     name="units"
             *
             * the browser will submit:
             *
             *     units=25
             *
             * for example.
             */
            unitsInput.value =
                String(units);


            /*
             * Normalize buy price too.
             */
            if (buyPriceInput) {

                const rawBuyPrice =
                    String(
                        buyPriceInput.value || ""
                    ).trim();


                if (!rawBuyPrice) {

                    event.preventDefault();

                    buyPriceInput.focus();

                    return;
                }


                const buyPrice =
                    Number(
                        rawBuyPrice
                    );


                if (
                    !Number.isFinite(
                        buyPrice
                    ) ||
                    buyPrice < 0
                ) {

                    event.preventDefault();

                    buyPriceInput.focus();

                    return;
                }


                buyPriceInput.value =
                    String(buyPrice);

            }


            /*
             * Final safety check:
             *
             * Create/update a hidden field
             * containing the exact `units`
             * parameter expected by Express.
             *
             * Remove an existing one first so
             * duplicate `units` parameters are
             * never submitted.
             */
            const existingHidden =
                form.querySelector(
                    'input[type="hidden"][data-stock-units]'
                );


            if (existingHidden) {

                existingHidden.remove();

            }


            const hiddenUnits =
                document.createElement(
                    "input"
                );


            hiddenUnits.type =
                "hidden";

            hiddenUnits.name =
                "units";

            hiddenUnits.value =
                String(units);

            hiddenUnits.dataset.stockUnits =
                "true";


            form.appendChild(
                hiddenUnits
            );


            /*
             * Keep the visible input as well.
             *
             * The hidden field is appended last,
             * so Express receives the same value.
             */
            unitsInput.value =
                String(units);

        }
    );

})();

</script>