<!-- =========================================================
     VERRAH COSMETICS
     SCROLLABLE TABS + CARD PANELS
========================================================= -->

<div class="verrah-tabs-container">

  <!-- =======================================================
       SCROLLABLE TABS
  ======================================================== -->

  <div
    class="verrah-tabs"
    role="tablist"
  >

    <button
      type="button"
      class="verrah-tab active"
      role="tab"
      aria-selected="true"
      aria-controls="stock-info"
      data-tab="stock-info"
    >
      Stock Info
    </button>


    <button
      type="button"
      class="verrah-tab"
      role="tab"
      aria-selected="false"
      aria-controls="stock-allocation"
      data-tab="stock-allocation"
    >
      Stock Allocation
    </button>


    <button
      type="button"
      class="verrah-tab"
      role="tab"
      aria-selected="false"
      aria-controls="stock-summary"
      data-tab="stock-summary"
    >
      Stock Summary
    </button>


    <button
      type="button"
      class="verrah-tab"
      role="tab"
      aria-selected="false"
      aria-controls="stock-actions"
      data-tab="stock-actions"
    >
      Actions
    </button>

  </div>


  <!-- =======================================================
       TAB CONTENT
  ======================================================== -->

  <div class="verrah-tab-content">


    <!-- =====================================================
         STOCK INFO
    ====================================================== -->

    <div
      class="verrah-tab-panel active"
      id="stock-info"
      role="tabpanel"
    >

      <%- include("stockEntry/stock-card") %>

    </div>


    <!-- =====================================================
         STOCK ALLOCATION
    ====================================================== -->

    <div
      class="verrah-tab-panel"
      id="stock-allocation"
      role="tabpanel"
      hidden
    >

      <%- include("stockEntry/allocation") %>

    </div>


    <!-- =====================================================
         STOCK SUMMARY
    ====================================================== -->

    <div
      class="verrah-tab-panel"
      id="stock-summary"
      role="tabpanel"
      hidden
    >

      <%- include("stockEntry/summary") %>

    </div>


    <!-- =====================================================
         ACTIONS
    ====================================================== -->

    <div
      class="verrah-tab-panel"
      id="stock-actions"
      role="tabpanel"
      hidden
    >

      <%- include("stockEntry/actions") %>

    </div>

  </div>

</div>


<!-- =========================================================
     TAB SWITCHING
========================================================= -->

<script>
(function () {

  "use strict";


  const tabs = document.querySelectorAll(
    ".verrah-tab"
  );


  const panels = document.querySelectorAll(
    ".verrah-tab-panel"
  );


  tabs.forEach(function (tab) {

    tab.addEventListener(
      "click",
      function () {

        const target =
          tab.getAttribute("data-tab");


        tabs.forEach(function (item) {

          const active =
            item === tab;


          item.classList.toggle(
            "active",
            active
          );


          item.setAttribute(
            "aria-selected",
            active
              ? "true"
              : "false"
          );

        });


        panels.forEach(function (panel) {

          const active =
            panel.id === target;


          panel.classList.toggle(
            "active",
            active
          );


          panel.hidden =
            !active;

        });


        tab.scrollIntoView({
          behavior: "smooth",
          block: "nearest",
          inline: "center"
        });

      }
    );

  });

})();
</script>


<!-- =========================================================
     ALLOCATION CALCULATIONS
========================================================= -->

<script>
(function () {

  "use strict";


  const form =
    document.getElementById(
      "allocationForm"
    );


  const inputs =
    Array.from(
      document.querySelectorAll(
        ".allocation-input"
      )
    );


  const hiddenTotal =
    document.getElementById(
      "totalUnits"
    );


  const allocationTotal =
    document.getElementById(
      "allocationTotal"
    );


  const summaryTotal =
    document.getElementById(
      "summaryTotal"
    );


  const summaryRemaining =
    document.getElementById(
      "summaryRemaining"
    );


  const warning =
    document.getElementById(
      "allocationWarning"
    );


  const allocateButton =
    document.getElementById(
      "allocateButton"
    );


  const sellPrice =
    document.getElementById(
      "unitSellPrice"
    );


  const warehouse =
    Number(
      <%= stock
        ? Number(stock.units || 0)
        : 0 %>
    );


  /* =========================================================
     GET INPUT VALUE
  ========================================================= */

  function getValue(input) {

    const raw =
      String(
        input.value ?? ""
      ).trim();


    if (raw === "") {
      return 0;
    }


    const value =
      Number(raw);


    if (
      !Number.isFinite(value) ||
      value < 0
    ) {
      return 0;
    }


    return Math.floor(value);

  }


  /* =========================================================
     CALCULATE
  ========================================================= */

  function calculate() {

    const sum =
      inputs.reduce(
        function (
          total,
          input
        ) {

          return (
            total +
            getValue(input)
          );

        },
        0
      );


    /* -------------------------------------------------------
       TOTAL ALLOCATED
    ------------------------------------------------------- */

    if (hiddenTotal) {

      hiddenTotal.value =
        String(sum);

    }


    if (allocationTotal) {

      allocationTotal.textContent =
        sum.toLocaleString();

    }


    if (summaryTotal) {

      summaryTotal.textContent =
        sum.toLocaleString();

    }


    /* -------------------------------------------------------
       REMAINING STOCK
    ------------------------------------------------------- */

    if (summaryRemaining) {

      summaryRemaining.textContent =
        Math.max(
          warehouse - sum,
          0
        ).toLocaleString();

    }


    /* -------------------------------------------------------
       VALIDATION
    ------------------------------------------------------- */

    let message = "";


    if (sum <= 0) {

      message =
        "Allocate at least one unit to at least one substation.";

    } else if (sum > warehouse) {

      message =
        "The total allocation cannot exceed the warehouse balance.";

    }


    if (warning) {

      warning.textContent =
        message;


      warning.hidden =
        !message;

    }


    if (allocateButton) {

      allocateButton.disabled =
        Boolean(message);

    }


    return sum;

  }


  /* =========================================================
     INPUT EVENTS
  ========================================================= */

  inputs.forEach(function (input) {

    input.addEventListener(
      "input",
      calculate
    );


    input.addEventListener(
      "change",
      calculate
    );

  });


  /* =========================================================
     FORM SUBMISSION
  ========================================================= */

  if (form) {

    form.addEventListener(
      "submit",
      function (event) {

        const sum =
          calculate();


        const invalidSellPrice =
          !sellPrice ||
          String(
            sellPrice.value
          ).trim() === "";


        if (
          sum <= 0 ||
          sum > warehouse ||
          invalidSellPrice
        ) {

          event.preventDefault();

          return;

        }


        if (allocateButton) {

          allocateButton.disabled =
            true;


          allocateButton.innerHTML =
            '<i class="fas fa-spinner fa-spin"></i> Allocating...';

        }

      }
    );

  }


  /* =========================================================
     INITIAL CALCULATION
  ========================================================= */

  calculate();

})();
</script>