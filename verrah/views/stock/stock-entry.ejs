<!-- =========================================================
     VERRAH COSMETICS
     SCROLLABLE TABS + CARD PANELS
========================================================= -->

<div class="verrah-tabs-container">


    <!-- =====================================================
         SCROLLABLE TABS
    ====================================================== -->

    <div
        class="verrah-tabs"
        role="tablist"
    >


        <!-- WELCOME -->

        <button
            type="button"
            class="verrah-tab active"
            role="tab"
            aria-selected="true"
            data-tab="welcome"
        >
            Welcome
        </button>


        <!-- DELIVERIES -->

        <button
            type="button"
            class="verrah-tab"
            role="tab"
            aria-selected="false"
            data-tab="deliveries"
        >
            Deliveries
        </button>


        <!-- SALES -->

        <button
            type="button"
            class="verrah-tab"
            role="tab"
            aria-selected="false"
            data-tab="sales"
        >
            Sales
        </button>


    </div>


    <!-- =====================================================
         TAB CONTENT
    ====================================================== -->

    <div class="verrah-tab-content">


        <!-- WELCOME / HERO -->

        <div
            class="verrah-tab-panel active"
            id="welcome"
            role="tabpanel"
        >

            <%- include("hero") %>

        </div>


        <!-- DELIVERIES -->

        <div
            class="verrah-tab-panel"
            id="deliveries"
            role="tabpanel"
            hidden
        >

            <%- include("delivery") %>

        </div>


        <!-- SALES -->

        <div
            class="verrah-tab-panel"
            id="sales"
            role="tabpanel"
            hidden
        >

            <%- include("sales") %>

        </div>


    </div>

</div>


<!-- =========================================================
     TAB SWITCHING
========================================================= -->

<script>

(function () {

    const tabs =
        document.querySelectorAll(
            ".verrah-tab"
        );

    const panels =
        document.querySelectorAll(
            ".verrah-tab-panel"
        );


    tabs.forEach(function (tab) {

        tab.addEventListener(
            "click",
            function () {

                const target =
                    this.dataset.tab;


                /* ---------------------------------------------
                   UPDATE ACTIVE TAB
                --------------------------------------------- */

                tabs.forEach(function (item) {

                    const active =
                        item === tab;

                    item.classList.toggle(
                        "active",
                        active
                    );

                    item.setAttribute(
                        "aria-selected",
                        active
                            ? "true"
                            : "false"
                    );

                });


                /* ---------------------------------------------
                   UPDATE VISIBLE CARD
                --------------------------------------------- */

                panels.forEach(function (panel) {

                    const active =
                        panel.id === target;

                    panel.classList.toggle(
                        "active",
                        active
                    );

                    panel.hidden =
                        !active;

                });


                /* ---------------------------------------------
                   KEEP SELECTED TAB VISIBLE
                --------------------------------------------- */

                tab.scrollIntoView({

                    behavior: "smooth",

                    block: "nearest",

                    inline: "center"

                });

            }
        );

    });

})();

</script>