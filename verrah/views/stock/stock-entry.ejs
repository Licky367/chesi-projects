<!-- =========================================================
     VERRAH COSMETICS
     STOCK ENTRY
     SCROLLABLE TABS + CARD PANELS
========================================================= -->

<div class="verrah-tabs-container">


  <!-- =======================================================
       SCROLLABLE TABS
  ======================================================== -->

  <div
    class="verrah-tabs"
    role="tablist"
    aria-label="Stock entry sections"
  >


    <!-- =====================================================
         STOCK INFO
    ====================================================== -->

    <button
      type="button"
      class="verrah-tab active"
      role="tab"
      aria-selected="true"
      aria-controls="stock-info"
      data-tab="stock-info"
    >
      Stock Info
    </button>


    <!-- =====================================================
         STOCK ALLOCATION
    ====================================================== -->

    <button
      type="button"
      class="verrah-tab"
      role="tab"
      aria-selected="false"
      aria-controls="stock-allocation"
      data-tab="stock-allocation"
    >
      Stock Allocation
    </button>


    <!-- =====================================================
         STOCK SUMMARY
    ====================================================== -->

    <button
      type="button"
      class="verrah-tab"
      role="tab"
      aria-selected="false"
      aria-controls="stock-summary"
      data-tab="stock-summary"
    >
      Stock Summary
    </button>


    <!-- =====================================================
         ACTIONS
    ====================================================== -->

    <button
      type="button"
      class="verrah-tab"
      role="tab"
      aria-selected="false"
      aria-controls="stock-actions"
      data-tab="stock-actions"
    >
      Actions
    </button>

  </div>


  <!-- =======================================================
       TAB CONTENT
  ======================================================== -->

  <div class="verrah-tab-content">


    <!-- =====================================================
         STOCK INFO
    ====================================================== -->

    <div
      class="verrah-tab-panel active"
      id="stock-info"
      role="tabpanel"
    >

      <%- include("stockEntry/stock-card") %>

    </div>


    <!-- =====================================================
         STOCK ALLOCATION
    ====================================================== -->

    <div
      class="verrah-tab-panel"
      id="stock-allocation"
      role="tabpanel"
    >

      <%- include("stockEntry/allocation") %>

    </div>


    <!-- =====================================================
         STOCK SUMMARY
    ====================================================== -->

    <div
      class="verrah-tab-panel"
      id="stock-summary"
      role="tabpanel"
    >

      <%- include("stockEntry/summary") %>

    </div>


    <!-- =====================================================
         ACTIONS
    ====================================================== -->

    <div
      class="verrah-tab-panel"
      id="stock-actions"
      role="tabpanel"
    >

      <%- include("stockEntry/actions") %>

    </div>

  </div>

</div>


<!-- =========================================================
     TAB SWITCHING
========================================================= -->

<script>

(function () {

  "use strict";


  const tabs =
    document.querySelectorAll(
      ".verrah-tab"
    );


  const panels =
    document.querySelectorAll(
      ".verrah-tab-panel"
    );


  tabs.forEach(function (tab) {

    tab.addEventListener(
      "click",
      function () {

        const target =
          tab.dataset.tab;


        /* ===================================================
           UPDATE TABS
        ==================================================== */

        tabs.forEach(function (item) {

          const isActive =
            item === tab;


          item.classList.toggle(
            "active",
            isActive
          );


          item.setAttribute(
            "aria-selected",
            isActive
              ? "true"
              : "false"
          );

        });


        /* ===================================================
           UPDATE PANELS
        ==================================================== */

        panels.forEach(function (panel) {

          const isActive =
            panel.id === target;


          panel.classList.toggle(
            "active",
            isActive
          );

        });


        /* ===================================================
           KEEP ACTIVE TAB VISIBLE
        ==================================================== */

        tab.scrollIntoView({
          behavior: "smooth",
          block: "nearest",
          inline: "center"
        });

      }
    );

  });

})();

</script>


<!-- =========================================================
     ALLOCATION CALCULATIONS
========================================================= -->

<script>

(function () {

  "use strict";


  /* =========================================================
     ELEMENTS
  ========================================================= */

  const form =
    document.getElementById(
      "allocationForm"
    );


  const inputs =
    Array.from(
      document.querySelectorAll(
        ".allocation-input"
      )
    );


  const hiddenTotal =
    document.getElementById(
      "totalUnits"
    );


  const allocationTotal =
    document.getElementById(
      "allocationTotal"
    );


  const summaryTotal =
    document.getElementById(
      "summaryTotal"
    );


  const summaryRemaining =
    document.getElementById(
      "summaryRemaining"
    );


  const warning =
    document.getElementById(
      "allocationWarning"
    );


  const allocateButton =
    document.getElementById(
      "allocateButton"
    );


  const sellPrice =
    document.getElementById(
      "unitSellPrice"
    );


  /* =========================================================
     WAREHOUSE BALANCE
  ========================================================= */

  const warehouse =
    Number(
      <%= stock
        ? Number(stock.units || 0)
        : 0 %>
    );


  /* =========================================================
     GET INPUT VALUE
  ========================================================= */

  function getValue(input) {

    const raw =
      String(
        input.value ?? ""
      ).trim();


    if (raw === "") {

      return 0;

    }


    const value =
      Number(raw);


    if (
      !Number.isFinite(value) ||
      value < 0
    ) {

      return 0;

    }


    return Math.floor(value);

  }


  /* =========================================================
     CALCULATE ALLOCATION
  ========================================================= */

  function calculate() {

    const sum =
      inputs.reduce(
        function (
          total,
          input
        ) {

          return (
            total +
            getValue(input)
          );

        },
        0
      );


    /* =======================================================
       HIDDEN TOTAL
    ======================================================== */

    if (hiddenTotal) {

      hiddenTotal.value =
        String(sum);

    }


    /* =======================================================
       ALLOCATION TOTAL
    ======================================================== */

    if (allocationTotal) {

      allocationTotal.textContent =
        sum.toLocaleString();

    }


    /* =======================================================
       SUMMARY TOTAL
    ======================================================== */

    if (summaryTotal) {

      summaryTotal.textContent =
        sum.toLocaleString();

    }


    /* =======================================================
       REMAINING WAREHOUSE
    ======================================================== */

    if (summaryRemaining) {

      summaryRemaining.textContent =
        Math.max(
          warehouse - sum,
          0
        ).toLocaleString();

    }


    /* =======================================================
       VALIDATION
    ======================================================== */

    let message = "";


    if (sum <= 0) {

      message =
        "Allocate at least one unit to at least one substation.";

    }


    else if (sum > warehouse) {

      message =
        "The total allocation cannot exceed the warehouse balance.";

    }


    /* =======================================================
       WARNING
    ======================================================== */

    if (warning) {

      warning.textContent =
        message;


      warning.hidden =
        !message;

    }


    /* =======================================================
       ALLOCATE BUTTON
    ======================================================== */

    if (allocateButton) {

      allocateButton.disabled =
        Boolean(message);

    }


    return sum;

  }


  /* =========================================================
     INPUT EVENTS
  ========================================================= */

  inputs.forEach(function (input) {

    input.addEventListener(
      "input",
      calculate
    );


    input.addEventListener(
      "change",
      calculate
    );

  });


  /* =========================================================
     FORM SUBMISSION
  ========================================================= */

  if (form) {

    form.addEventListener(
      "submit",
      function (event) {

        const sum =
          calculate();


        const invalidSellPrice =
          !sellPrice ||
          String(
            sellPrice.value
          ).trim() === "";


        if (
          sum <= 0 ||
          sum > warehouse ||
          invalidSellPrice
        ) {

          event.preventDefault();

          return;

        }


        if (allocateButton) {

          allocateButton.disabled =
            true;


          allocateButton.innerHTML =
            '<i class="fas fa-spinner fa-spin"></i> Allocating...';

        }

      }
    );

  }


  /* =========================================================
     INITIAL CALCULATION
  ========================================================= */

  calculate();

})();

</script>