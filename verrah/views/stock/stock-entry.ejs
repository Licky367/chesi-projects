<!-- =========================================================
     VERRAH COSMETICS
     SCROLLABLE TABS + CARD PANELS
========================================================= -->

<div class="verrah-tabs-container">

  <!-- =======================================================
       SCROLLABLE TABS
  ======================================================== -->

  <div
    class="verrah-tabs"
    role="tablist"
  >

    <!-- STOCK INFO -->

    <button
      type="button"
      class="verrah-tab active"
      role="tab"
      aria-selected="true"
      aria-controls="stock-info"
      data-tab="stock-info"
    >
      Stock Info
    </button>


    <!-- STOCK ALLOCATION -->

    <button
      type="button"
      class="verrah-tab"
      role="tab"
      aria-selected="false"
      aria-controls="stock-allocation"
      data-tab="stock-allocation"
    >
      Stock Allocation
    </button>


    <!-- STOCK SUMMARY -->

    <button
      type="button"
      class="verrah-tab"
      role="tab"
      aria-selected="false"
      aria-controls="stock-summary"
      data-tab="stock-summary"
    >
      Stock Summary
    </button>


    <!-- ACTIONS -->

    <button
      type="button"
      class="verrah-tab"
      role="tab"
      aria-selected="false"
      aria-controls="stock-actions"
      data-tab="stock-actions"
    >
      Actions
    </button>

  </div>


  <!-- =======================================================
       TAB CONTENT
  ======================================================== -->

  <div class="verrah-tab-content">

    <!-- =====================================================
         STOCK INFO
    ====================================================== -->

    <div
      class="verrah-tab-panel active"
      id="stock-info"
      role="tabpanel"
      aria-labelledby="stock-info-tab"
    >

      <%- include("stockEntry/stock-card") %>

    </div>


    <!-- =====================================================
         STOCK ALLOCATION
    ====================================================== -->

    <div
      class="verrah-tab-panel"
      id="stock-allocation"
      role="tabpanel"
      aria-labelledby="stock-allocation-tab"
      hidden
    >

      <%- include("stockEntry/allocation") %>

    </div>


    <!-- =====================================================
         STOCK SUMMARY
    ====================================================== -->

    <div
      class="verrah-tab-panel"
      id="stock-summary"
      role="tabpanel"
      aria-labelledby="stock-summary-tab"
      hidden
    >

      <%- include("stockEntry/summary") %>

    </div>


    <!-- =====================================================
         ACTIONS
    ====================================================== -->

    <div
      class="verrah-tab-panel"
      id="stock-actions"
      role="tabpanel"
      aria-labelledby="stock-actions-tab"
      hidden
    >

      <%- include("stockEntry/actions") %>

    </div>

  </div>

</div>


<!-- =========================================================
     TAB SWITCHING + ALLOCATION LOGIC
========================================================= -->

<script>
(function () {

  "use strict";


  /* =========================================================
     TAB SWITCHING
  ========================================================= */

  const tabs = Array.from(
    document.querySelectorAll(
      ".verrah-tab"
    )
  );


  const panels = Array.from(
    document.querySelectorAll(
      ".verrah-tab-panel"
    )
  );


  tabs.forEach(function (tab) {

    tab.addEventListener(
      "click",
      function () {

        const target =
          tab.dataset.tab;


        /* -----------------------------------------------------
           UPDATE TABS
        ----------------------------------------------------- */

        tabs.forEach(function (item) {

          const isActive =
            item === tab;


          item.classList.toggle(
            "active",
            isActive
          );


          item.setAttribute(
            "aria-selected",
            isActive
              ? "true"
              : "false"
          );

        });


        /* -----------------------------------------------------
           UPDATE PANELS
        ----------------------------------------------------- */

        panels.forEach(function (panel) {

          const isActive =
            panel.id === target;


          panel.classList.toggle(
            "active",
            isActive
          );


          panel.hidden =
            !isActive;

        });


        /* -----------------------------------------------------
           KEEP SELECTED TAB VISIBLE
        ----------------------------------------------------- */

        tab.scrollIntoView({
          behavior: "smooth",
          block: "nearest",
          inline: "center"
        });

      }
    );

  });


  /* =========================================================
     ALLOCATION FORM
  ========================================================= */

  const form =
    document.getElementById(
      "allocationForm"
    );


  if (!form) {
    return;
  }


  const inputs = Array.from(
    document.querySelectorAll(
      ".allocation-input"
    )
  );


  const hiddenTotal =
    document.getElementById(
      "totalUnits"
    );


  const total =
    document.getElementById(
      "allocationTotal"
    );


  const summaryTotal =
    document.getElementById(
      "summaryTotal"
    );


  const remaining =
    document.getElementById(
      "summaryRemaining"
    );


  const warning =
    document.getElementById(
      "allocationWarning"
    );


  const button =
    document.getElementById(
      "allocateButton"
    );


  const sellPrice =
    document.getElementById(
      "unitSellPrice"
    );


  /* =========================================================
     WAREHOUSE BALANCE
  ========================================================= */

  const warehouse =
    Number(
      <%= stock
        ? Number(stock.units || 0)
        : 0 %>
    );


  /* =========================================================
     GET INPUT VALUE
  ========================================================= */

  function valueOf(input) {

    const raw =
      String(
        input.value ?? ""
      ).trim();


    if (raw === "") {
      return 0;
    }


    const value =
      Number(raw);


    if (
      !Number.isFinite(value) ||
      value < 0
    ) {
      return 0;
    }


    return Math.floor(value);

  }


  /* =========================================================
     CALCULATE ALLOCATION
  ========================================================= */

  function calculate() {

    const sum =
      inputs.reduce(
        function (
          totalValue,
          input
        ) {

          return (
            totalValue +
            valueOf(input)
          );

        },
        0
      );


    /* -------------------------------------------------------
       HIDDEN TOTAL
    ------------------------------------------------------- */

    if (hiddenTotal) {

      hiddenTotal.value =
        String(sum);

    }


    /* -------------------------------------------------------
       DISPLAY TOTAL
    ------------------------------------------------------- */

    if (total) {

      total.textContent =
        sum.toLocaleString();

    }


    if (summaryTotal) {

      summaryTotal.textContent =
        sum.toLocaleString();

    }


    /* -------------------------------------------------------
       REMAINING WAREHOUSE STOCK
    ------------------------------------------------------- */

    if (remaining) {

      remaining.textContent =
        Math.max(
          warehouse - sum,
          0
        ).toLocaleString();

    }


    /* -------------------------------------------------------
       VALIDATION MESSAGE
    ------------------------------------------------------- */

    let message = "";


    if (sum <= 0) {

      message =
        "Allocate at least one unit to at least one substation.";

    } else if (sum > warehouse) {

      message =
        "The total allocation cannot exceed the warehouse balance.";

    }


    /* -------------------------------------------------------
       WARNING
    ------------------------------------------------------- */

    if (warning) {

      warning.textContent =
        message;


      warning.hidden =
        !message;

    }


    /* -------------------------------------------------------
       ALLOCATION BUTTON
    ------------------------------------------------------- */

    if (button) {

      button.disabled =
        Boolean(message);

    }


    return sum;

  }


  /* =========================================================
     INPUT EVENTS
  ========================================================= */

  inputs.forEach(
    function (input) {

      input.addEventListener(
        "input",
        calculate
      );


      input.addEventListener(
        "change",
        calculate
      );

    }
  );


  /* =========================================================
     FORM SUBMISSION
  ========================================================= */

  form.addEventListener(
    "submit",
    function (event) {

      const sum =
        calculate();


      if (hiddenTotal) {

        hiddenTotal.value =
          String(sum);

      }


      const invalidSellPrice =
        !sellPrice ||
        String(
          sellPrice.value
        ).trim() === "";


      if (
        sum <= 0 ||
        sum > warehouse ||
        invalidSellPrice
      ) {

        event.preventDefault();

        return;

      }


      /* -----------------------------------------------------
         PREVENT DOUBLE SUBMISSION
      ----------------------------------------------------- */

      if (button) {

        button.disabled =
          true;


        button.innerHTML =
          '<i class="fas fa-spinner fa-spin"></i> Allocating...';

      }

    }
  );


  /* =========================================================
     STOCK IMAGE FALLBACK
  ========================================================= */

  const image =
    document.querySelector(
      ".stock-detail-image-source"
    );


  if (image) {

    image.addEventListener(
      "error",
      function () {

        image.classList.add(
          "is-hidden"
        );


        const fallback =
          image.nextElementSibling;


        if (fallback) {

          fallback.classList.add(
            "is-visible"
          );

        }

      }
    );

  }


  /* =========================================================
     INITIAL CALCULATION
  ========================================================= */

  calculate();

})();
</script>