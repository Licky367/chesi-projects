<%
const isEdit = !!(category && category._id);

const categoryName =
    category?.name ||
    formData?.name ||
    "";

const categoryDescription =
    category?.description ||
    formData?.description ||
    "";

const existingImage =
    category?.categoryIcon ||
    "";

const businessTypes =
    Array.isArray(locals.businessTypes)
        ? locals.businessTypes
        : [];

const selectedBusinessTypeId =
    isEdit &&
    category?.businessType?.id
        ? String(category.businessType.id)
        : String(formData?.businessTypeId || "");
%>

<section class="shop-page category-form-page">

    <!-- =====================================================
         CATEGORY FORM
    ====================================================== -->

    <form
        id="categoryForm"
        class="category-form"
        method="POST"
        enctype="multipart/form-data"
        action="<%= isEdit
            ? '/products/category/add/' + category._id
            : '/products/category/add' %>"
    >

        <!-- =================================================
             CATEGORY NAME
        ================================================== -->

        <section class="form-section">

            <div class="section-heading">
                <span class="section-number">01</span>
                <h2>Category Details</h2>
            </div>

            <div class="form-group">

                <label for="name">
                    Category Name
                </label>

                <input
                    type="text"
                    id="name"
                    name="name"
                    value="<%= categoryName %>"
                    placeholder="Enter category name"
                    autocomplete="off"
                    required
                >

            </div>

            <div class="form-group">

                <label for="description">
                    Description
                </label>

                <textarea
                    id="description"
                    name="description"
                    rows="4"
                    placeholder="Enter category description"
                ><%= categoryDescription %></textarea>

            </div>

        </section>


        <!-- =================================================
             BUSINESS TYPE
        ================================================== -->

        <section class="form-section">

            <div class="section-heading">
                <span class="section-number">02</span>
                <h2>Business Type</h2>
            </div>

            <div class="form-group">

                <label for="businessTypeId">
                    Business Type
                </label>

                <select
                    id="businessTypeId"
                    name="businessTypeId"
                    required
                    <%= businessTypes.length ? "" : "disabled" %>
                >

                    <option value="">
                        <%= businessTypes.length
                            ? "Select business type"
                            : "No business types available" %>
                    </option>

                    <% businessTypes.forEach(type => { %>

                        <option
                            value="<%= type._id %>"
                            <%= String(type._id) === selectedBusinessTypeId
                                ? "selected"
                                : "" %>
                        >
                            <%= type.name %>
                        </option>

                    <% }) %>

                </select>

            </div>

        </section>


        <!-- =================================================
             CATEGORY IMAGE
        ================================================== -->

        <section class="form-section">

            <div class="section-heading">
                <span class="section-number">03</span>
                <h2>Category Image</h2>
            </div>

            <div class="form-group">

                <label for="categoryIcon">
                    Upload Image
                </label>

                <input
                    type="file"
                    id="categoryIcon"
                    name="categoryIcon"
                    accept="image/*"
                >

            </div>

            <div class="form-group">

                <label for="categoryIconUrl">
                    Or Image URL
                </label>

                <input
                    type="url"
                    id="categoryIconUrl"
                    name="categoryIconUrl"
                    value="<%= formData?.categoryIconUrl || "" %>"
                    placeholder="https://example.com/image.jpg"
                    autocomplete="off"
                >

            </div>


            <% if (existingImage) { %>

                <div
                    id="currentImageWrapper"
                    class="category-image-preview"
                >

                    <p>Current Image</p>

                    <img
                        id="currentImagePreview"
                        src="<%= existingImage %>"
                        alt="<%= categoryName %>"
                    >

                </div>

            <% } %>


            <div
                id="newImageWrapper"
                class="category-image-preview"
                style="display:none;"
            >

                <p>New Image Preview</p>

                <img
                    id="newImagePreview"
                    src=""
                    alt="New category image"
                >

            </div>

        </section>


        <!-- =================================================
             ACTIONS
        ================================================== -->

        <section class="form-actions">

            <button
                type="submit"
                class="btn btn-primary"
            >
                <%= isEdit
                    ? "Update Category"
                    : "Create Category" %>
            </button>

            <a
                href="/products/category"
                class="btn btn-secondary"
            >
                Cancel
            </a>

        </section>

    </form>

</section>


<script>

document.addEventListener("DOMContentLoaded", () => {

    const form =
        document.getElementById("categoryForm");

    const nameInput =
        document.getElementById("name");

    const businessTypeInput =
        document.getElementById("businessTypeId");

    const imageInput =
        document.getElementById("categoryIcon");

    const imageUrlInput =
        document.getElementById("categoryIconUrl");

    const newImageWrapper =
        document.getElementById("newImageWrapper");

    const newImagePreview =
        document.getElementById("newImagePreview");

    const currentImageWrapper =
        document.getElementById("currentImageWrapper");


    /* =====================================================
       FILE PREVIEW
    ====================================================== */

    if (imageInput) {

        imageInput.addEventListener("change", () => {

            const file =
                imageInput.files &&
                imageInput.files[0];

            if (!file) {

                if (newImageWrapper) {
                    newImageWrapper.style.display = "none";
                }

                newImagePreview.src = "";

                return;
            }

            const reader =
                new FileReader();

            reader.onload = event => {

                newImagePreview.src =
                    event.target.result;

                newImageWrapper.style.display =
                    "block";

            };

            reader.readAsDataURL(file);

        });

    }


    /* =====================================================
       URL PREVIEW
    ====================================================== */

    if (imageUrlInput) {

        imageUrlInput.addEventListener("input", () => {

            const url =
                imageUrlInput.value.trim();

            if (!url) {

                if (imageInput && imageInput.files.length) {
                    return;
                }

                if (newImageWrapper) {
                    newImageWrapper.style.display = "none";
                }

                newImagePreview.src = "";

                return;
            }

            newImagePreview.src = url;

            newImageWrapper.style.display =
                "block";

        });

    }


    /* =====================================================
       FORM VALIDATION
    ====================================================== */

    if (form) {

        form.addEventListener("submit", event => {

            const name =
                nameInput
                    ? nameInput.value.trim()
                    : "";

            const businessTypeId =
                businessTypeInput
                    ? businessTypeInput.value.trim()
                    : "";

            const imageFile =
                imageInput &&
                imageInput.files &&
                imageInput.files.length > 0;

            const imageUrl =
                imageUrlInput
                    ? imageUrlInput.value.trim()
                    : "";

            const hasExistingImage =
                <%= existingImage ? "true" : "false" %>;


            if (!name) {

                event.preventDefault();

                alert(
                    "Please enter a category name."
                );

                nameInput.focus();

                return;
            }


            if (!businessTypeId) {

                event.preventDefault();

                alert(
                    "Please select a business type."
                );

                businessTypeInput.focus();

                return;
            }


            if (
                !imageFile &&
                !imageUrl &&
                !hasExistingImage
            ) {

                event.preventDefault();

                alert(
                    "Please upload a category image or provide an image URL."
                );

                return;
            }

        });

    }

});

</script>