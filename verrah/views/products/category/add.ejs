<%
const isEdit = !!(category && category._id);

const categoryName =
category?.name ||
formData?.name ||
"";

const categoryDescription =
category?.description ||
formData?.description ||
"";

const existingImage =
category?.categoryIcon ||
"";

const businessTypes =
Array.isArray(locals.businessTypes)
? locals.businessTypes
: [];

const selectedBusinessTypeId =
isEdit &&
category?.businessType?.id
? String(category.businessType.id)
: String(formData?.businessTypeId || "");
%>

<section class="category-add-page"><div class="category-add-card">

    <!-- =====================================================
         HEADER
    ====================================================== -->

    <header class="category-add-header">

        <div class="category-add-icon">
            <i class="fas fa-layer-group"></i>
        </div>

        <div class="category-add-heading">

            <h1>
                <%= isEdit
                    ? "Edit Category"
                    : "Add Category" %>
            </h1>

            <p>
                <%= isEdit
                    ? "Update the category details and image."
                    : "Create a new product category for your business." %>
            </p>

        </div>

    </header>


    <!-- =====================================================
         ERROR ALERT
    ====================================================== -->

    <% if (typeof error !== "undefined" && error) { %>

        <div class="category-alert category-alert-error">

            <div class="alert-icon">
                <i class="fas fa-exclamation-circle"></i>
            </div>

            <div class="alert-content">

                <strong>
                    Unable to save category
                </strong>

                <span>
                    <%= error %>
                </span>

            </div>

        </div>

    <% } %>


    <!-- =====================================================
         FORM
    ====================================================== -->

    <form
        id="categoryForm"
        class="category-form"
        method="POST"
        enctype="multipart/form-data"
        action="<%= isEdit
            ? '/products/category/add/' + category._id
            : '/products/category/add' %>"
    >

        <!-- =================================================
             CATEGORY DETAILS
        ================================================== -->

        <section class="form-section">

            <div class="section-heading">

                <span class="section-number">
                    01
                </span>

                <div>

                    <h2>
                        Category Details
                    </h2>

                    <p>
                        Enter the basic information for this category.
                    </p>

                </div>

            </div>


            <!-- CATEGORY NAME -->

            <div class="form-group">

                <label for="name">
                    Category Name
                    <span class="required">*</span>
                </label>

                <div class="input-wrapper">

                    <i class="fas fa-tag"></i>

                    <input
                        type="text"
                        id="name"
                        name="name"
                        value="<%= categoryName %>"
                        placeholder="Enter category name"
                        autocomplete="off"
                        required
                    >

                </div>

            </div>


            <!-- DESCRIPTION -->

            <div class="form-group">

                <label for="description">
                    Description
                </label>

                <div class="input-wrapper">

                    <i class="fas fa-align-left"></i>

                    <textarea
                        id="description"
                        name="description"
                        rows="4"
                        placeholder="Enter category description"
                    ><%= categoryDescription %></textarea>

                </div>

            </div>

        </section>


        <!-- =================================================
             BUSINESS TYPE
        ================================================== -->

        <section class="form-section">

            <div class="section-heading">

                <span class="section-number">
                    02
                </span>

                <div>

                    <h2>
                        Business Type
                    </h2>

                    <p>
                        Select the business type this category belongs to.
                    </p>

                </div>

            </div>


            <div class="form-group">

                <label for="businessTypeId">
                    Business Type
                    <span class="required">*</span>
                </label>

                <div class="input-wrapper">

                    <i class="fas fa-briefcase"></i>

                    <select
                        id="businessTypeId"
                        name="businessTypeId"
                        required
                        <%= businessTypes.length
                            ? ""
                            : "disabled" %>
                    >

                        <option value="">

                            <%= businessTypes.length
                                ? "Select business type"
                                : "No business types available" %>

                        </option>

                        <% businessTypes.forEach(type => { %>

                            <option
                                value="<%= type._id %>"
                                <%= String(type._id) === selectedBusinessTypeId
                                    ? "selected"
                                    : "" %>
                            >
                                <%= type.name %>
                            </option>

                        <% }) %>

                    </select>

                </div>

            </div>

        </section>


        <!-- =================================================
             CATEGORY IMAGE
        ================================================== -->

        <section class="form-section">

            <div class="section-heading">

                <span class="section-number">
                    03
                </span>

                <div>

                    <h2>
                        Category Image
                    </h2>

                    <p>
                        Upload an image or provide an image URL.
                    </p>

                </div>

            </div>


            <!-- =================================================
                 IMAGE SOURCE OPTIONS
            ================================================== -->

            <div class="image-source-grid">


                <!-- =================================================
                     UPLOAD METHOD
                ================================================== -->

                <div class="image-method selected">

                    <div class="image-method-header">

                        <div class="method-radio">

                            <input
                                type="radio"
                                name="imageMethod"
                                value="upload"
                                checked
                            >

                            <span class="custom-radio"></span>

                        </div>

                        <div class="method-icon upload-icon">

                            <i class="fas fa-cloud-upload-alt"></i>

                        </div>

                        <div class="method-title">

                            <strong>
                                Upload Image
                            </strong>

                            <span>
                                Select an image from your device
                            </span>

                        </div>

                    </div>


                    <div class="image-method-content">

                        <label
                            for="categoryIcon"
                            class="file-upload-box"
                        >

                            <div class="upload-cloud">

                                <i class="fas fa-cloud-upload-alt"></i>

                            </div>

                            <strong>
                                Choose category image
                            </strong>

                            <span>
                                Tap to browse your device
                            </span>

                            <small>
                                JPG, JPEG, PNG, WEBP
                            </small>

                        </label>


                        <input
                            type="file"
                            id="categoryIcon"
                            name="categoryIcon"
                            accept="image/*"
                        >


                        <!-- SELECTED FILE -->

                        <div
                            id="selectedFile"
                            class="selected-file"
                            style="display:none;"
                        >

                            <div class="selected-file-icon">

                                <i class="fas fa-image"></i>

                            </div>

                            <div class="selected-file-info">

                                <strong id="selectedFileName">
                                    Selected image
                                </strong>

                                <span id="selectedFileSize">
                                    Image selected
                                </span>

                            </div>

                            <button
                                type="button"
                                id="removeFile"
                                class="remove-file"
                                aria-label="Remove selected image"
                            >
                                <i class="fas fa-times"></i>
                            </button>

                        </div>

                    </div>

                </div>


                <!-- =================================================
                     URL METHOD
                ================================================== -->

                <div class="image-method">

                    <div class="image-method-header">

                        <div class="method-radio">

                            <input
                                type="radio"
                                name="imageMethod"
                                value="url"
                            >

                            <span class="custom-radio"></span>

                        </div>

                        <div class="method-icon url-icon">

                            <i class="fas fa-link"></i>

                        </div>

                        <div class="method-title">

                            <strong>
                                Image URL
                            </strong>

                            <span>
                                Use an image hosted online
                            </span>

                        </div>

                    </div>


                    <div class="image-method-content">

                        <label
                            for="categoryIconUrl"
                            class="url-label"
                        >
                            Image URL
                        </label>

                        <div class="url-input-wrapper">

                            <i class="fas fa-link"></i>

                            <input
                                type="url"
                                id="categoryIconUrl"
                                name="categoryIconUrl"
                                value="<%= formData?.categoryIconUrl || "" %>"
                                placeholder="https://example.com/image.jpg"
                                autocomplete="off"
                            >

                        </div>

                        <div class="url-hint">

                            <i class="fas fa-info-circle"></i>

                            <span>
                                Enter a direct URL to the category image.
                            </span>

                        </div>

                    </div>

                </div>

            </div>


            <!-- =================================================
                 IMAGE PREVIEW
            ================================================== -->

            <div
                id="imagePreviewWrapper"
                class="image-preview-wrapper"
                style="<%= existingImage ? "" : "display:none;" %>"
            >

                <div class="preview-heading">

                    <div>

                        <span class="preview-label">
                            Image Preview
                        </span>

                        <span class="preview-description">
                            This is how the category image will appear.
                        </span>

                    </div>

                    <button
                        type="button"
                        id="clearPreview"
                        class="clear-preview"
                    >
                        Clear
                    </button>

                </div>


                <div class="image-preview-card">

                    <div class="preview-image-container">

                        <img
                            id="imagePreview"
                            src="<%= existingImage %>"
                            alt="<%= categoryName %>"
                        >

                    </div>


                    <div class="preview-details">

                        <span class="preview-details-label">
                            CATEGORY IMAGE
                        </span>

                        <strong>
                            <%= categoryName || "Category" %>
                        </strong>

                        <span>
                            <%= existingImage
                                ? "Current category image"
                                : "New image preview" %>
                        </span>

                    </div>

                </div>

            </div>

        </section>


        <!-- =================================================
             ACTIONS
        ================================================== -->

        <section class="category-form-actions">

            <a
                href="/products/category"
                class="category-btn category-btn-secondary"
            >
                <i class="fas fa-arrow-left"></i>

                Cancel
            </a>


            <button
                type="submit"
                class="category-btn category-btn-primary"
            >
                <i class="fas fa-save"></i>

                <%= isEdit
                    ? "Update Category"
                    : "Create Category" %>
            </button>

        </section>

    </form>

</div>

</section><script>

document.addEventListener("DOMContentLoaded", () => {

    const form =
        document.getElementById("categoryForm");

    const nameInput =
        document.getElementById("name");

    const businessTypeInput =
        document.getElementById("businessTypeId");

    const imageInput =
        document.getElementById("categoryIcon");

    const imageUrlInput =
        document.getElementById("categoryIconUrl");

    const imagePreviewWrapper =
        document.getElementById("imagePreviewWrapper");

    const imagePreview =
        document.getElementById("imagePreview");

    const clearPreview =
        document.getElementById("clearPreview");

    const selectedFile =
        document.getElementById("selectedFile");

    const selectedFileName =
        document.getElementById("selectedFileName");

    const selectedFileSize =
        document.getElementById("selectedFileSize");

    const removeFile =
        document.getElementById("removeFile");

    const imageMethods =
        document.querySelectorAll(".image-method");

    const imageMethodRadios =
        document.querySelectorAll(
            'input[name="imageMethod"]'
        );


    const hasExistingImage =
        <%= existingImage ? "true" : "false" %>;


    /* =====================================================
       IMAGE METHOD SELECTION
    ====================================================== */

    imageMethodRadios.forEach(radio => {

        radio.addEventListener("change", () => {

            imageMethods.forEach(method => {

                method.classList.remove("selected");

            });

            const method =
                radio.closest(".image-method");

            if (method) {
                method.classList.add("selected");
            }

        });

    });


    /* =====================================================
       FILE PREVIEW
    ====================================================== */

    if (imageInput) {

        imageInput.addEventListener("change", () => {

            const file =
                imageInput.files &&
                imageInput.files[0];

            if (!file) {

                if (selectedFile) {
                    selectedFile.style.display =
                        "none";
                }

                if (!imageUrlInput || !imageUrlInput.value.trim()) {

                    if (imagePreviewWrapper) {
                        imagePreviewWrapper.style.display =
                            hasExistingImage
                                ? "block"
                                : "none";
                    }

                    if (imagePreview) {
                        imagePreview.src =
                            hasExistingImage
                                ? "<%= existingImage %>"
                                : "";
                    }

                }

                return;
            }


            /* FILE INFORMATION */

            if (selectedFileName) {

                selectedFileName.textContent =
                    file.name;

            }


            if (selectedFileSize) {

                const size =
                    file.size >= 1024 * 1024
                        ? (
                            file.size /
                            (1024 * 1024)
                        ).toFixed(2) + " MB"
                        : (
                            file.size /
                            1024
                        ).toFixed(1) + " KB";

                selectedFileSize.textContent =
                    size;

            }


            if (selectedFile) {

                selectedFile.style.display =
                    "flex";

            }


            /* IMAGE PREVIEW */

            const reader =
                new FileReader();

            reader.onload = event => {

                if (imagePreview) {

                    imagePreview.src =
                        event.target.result;

                }

                if (imagePreviewWrapper) {

                    imagePreviewWrapper.style.display =
                        "block";

                }

            };

            reader.readAsDataURL(file);

        });

    }


    /* =====================================================
       REMOVE FILE
    ====================================================== */

    if (removeFile) {

        removeFile.addEventListener("click", event => {

            event.preventDefault();

            if (imageInput) {

                imageInput.value = "";

            }

            if (selectedFile) {

                selectedFile.style.display =
                    "none";

            }


            const url =
                imageUrlInput
                    ? imageUrlInput.value.trim()
                    : "";


            if (url) {

                if (imagePreview) {
                    imagePreview.src = url;
                }

                if (imagePreviewWrapper) {
                    imagePreviewWrapper.style.display =
                        "block";
                }

                return;

            }


            if (hasExistingImage) {

                if (imagePreview) {
                    imagePreview.src =
                        "<%= existingImage %>";
                }

                if (imagePreviewWrapper) {
                    imagePreviewWrapper.style.display =
                        "block";
                }

            } else {

                if (imagePreview) {
                    imagePreview.src = "";
                }

                if (imagePreviewWrapper) {
                    imagePreviewWrapper.style.display =
                        "none";
                }

            }

        });

    }


    /* =====================================================
       URL PREVIEW
    ====================================================== */

    if (imageUrlInput) {

        imageUrlInput.addEventListener("input", () => {

            const url =
                imageUrlInput.value.trim();


            if (!url) {

                if (
                    imageInput &&
                    imageInput.files &&
                    imageInput.files.length
                ) {

                    return;

                }


                if (hasExistingImage) {

                    if (imagePreview) {
                        imagePreview.src =
                            "<%= existingImage %>";
                    }

                    if (imagePreviewWrapper) {
                        imagePreviewWrapper.style.display =
                            "block";
                    }

                } else {

                    if (imagePreview) {
                        imagePreview.src = "";
                    }

                    if (imagePreviewWrapper) {
                        imagePreviewWrapper.style.display =
                            "none";
                    }

                }

                return;

            }


            if (imagePreview) {

                imagePreview.src =
                    url;

            }


            if (imagePreviewWrapper) {

                imagePreviewWrapper.style.display =
                    "block";

            }

        });

    }


    /* =====================================================
       PREVIEW ERROR
    ====================================================== */

    if (imagePreview) {

        imagePreview.addEventListener(
            "error",
            () => {

                imagePreview.classList.add(
                    "preview-error"
                );

            }
        );


        imagePreview.addEventListener(
            "load",
            () => {

                imagePreview.classList.remove(
                    "preview-error"
                );

            }
        );

    }


    /* =====================================================
       CLEAR PREVIEW
    ====================================================== */

    if (clearPreview) {

        clearPreview.addEventListener("click", () => {

            if (imageInput) {

                imageInput.value = "";

            }

            if (imageUrlInput) {

                imageUrlInput.value = "";

            }

            if (selectedFile) {

                selectedFile.style.display =
                    "none";

            }


            if (hasExistingImage) {

                if (imagePreview) {

                    imagePreview.src =
                        "<%= existingImage %>";

                }

                if (imagePreviewWrapper) {

                    imagePreviewWrapper.style.display =
                        "block";

                }

            } else {

                if (imagePreview) {

                    imagePreview.src =
                        "";

                }

                if (imagePreviewWrapper) {

                    imagePreviewWrapper.style.display =
                        "none";

                }

            }

        });

    }


    /* =====================================================
       FORM VALIDATION
    ====================================================== */

    if (form) {

        form.addEventListener("submit", event => {

            const name =
                nameInput
                    ? nameInput.value.trim()
                    : "";

            const businessTypeId =
                businessTypeInput
                    ? businessTypeInput.value.trim()
                    : "";

            const imageFile =
                imageInput &&
                imageInput.files &&
                imageInput.files.length > 0;

            const imageUrl =
                imageUrlInput
                    ? imageUrlInput.value.trim()
                    : "";


            if (!name) {

                event.preventDefault();

                alert(
                    "Please enter a category name."
                );

                if (nameInput) {
                    nameInput.focus();
                }

                return;

            }


            if (!businessTypeId) {

                event.preventDefault();

                alert(
                    "Please select a business type."
                );

                if (businessTypeInput) {
                    businessTypeInput.focus();
                }

                return;

            }


            if (
                !imageFile &&
                !imageUrl &&
                !hasExistingImage
            ) {

                event.preventDefault();

                alert(
                    "Please upload a category image or provide an image URL."
                );

                return;

            }

        });

    }

});

</script>