<!-- ======================================================
     verrah/views/products/category/add.ejs

     ADD / EDIT CATEGORY
====================================================== -->

<%
/* ==========================================================
   DETERMINE MODE
========================================================== */

const isEdit =
  typeof category !== "undefined" &&
  category &&
  category._id;

const categoryId =
  isEdit
    ? category._id
    : null;


/* ==========================================================
   FORM DATA

   During edit:
       category.name
       category.description
       category.categoryIcon

   During create after validation error:
       formData
========================================================== */

const categoryName =
  isEdit
    ? (category.name || "")
    : (formData?.name || "");

const categoryDescription =
  isEdit
    ? (category.description || "")
    : (formData?.description || "");

const existingImage =
  isEdit
    ? (category.categoryIcon || "")
    : "";
%>


<link
  rel="stylesheet"
  href="/css/products/category-add.css"
/>


<section class="category-add-page">

  <div class="category-add-card">


    <!-- ==================================================
         HEADER
    =================================================== -->

    <div class="category-add-header">

      <div class="category-add-icon">

        <i class="fas <%= isEdit
          ? 'fa-pen-to-square'
          : 'fa-layer-group'
        %>"></i>

      </div>


      <div class="category-add-heading">

        <h1>
          <%= isEdit
            ? "Edit Category"
            : "Add Category"
          %>
        </h1>

        <p>
          <%= isEdit
            ? "Update the category details and image."
            : "Create a new category and give it a beautiful icon."
          %>
        </p>

      </div>

    </div>


    <!-- ==================================================
         ERROR
    =================================================== -->

    <% if (error) { %>

      <div class="category-alert category-alert-error">

        <div class="alert-icon">
          <i class="fas fa-circle-exclamation"></i>
        </div>

        <div class="alert-content">

          <strong>
            <%= isEdit
              ? "Unable to update category"
              : "Unable to create category"
            %>
          </strong>

          <span>
            <%= error %>
          </span>

        </div>

      </div>

    <% } %>


    <!-- ==================================================
         FORM
    =================================================== -->

    <form
      id="categoryForm"
      class="category-form"
      action="<%= isEdit
        ? '/products/category/add/' + categoryId
        : '/products/category/add'
      %>"
      method="POST"
      enctype="multipart/form-data"
    >


      <!-- =================================================
           CATEGORY NAME
      ================================================== -->

      <div class="form-section">

        <div class="section-heading">

          <div class="section-number">
            01
          </div>

          <div>

            <h2>
              Category details
            </h2>

            <p>
              Give your category a clear and recognizable name.
            </p>

          </div>

        </div>


        <div class="form-group">

          <label for="name">

            Category Name

            <span class="required">*</span>

          </label>


          <div class="input-wrapper">

            <i class="fas fa-tag"></i>

            <input
              type="text"
              id="name"
              name="name"
              value="<%= categoryName %>"
              placeholder="e.g. Skincare"
              autocomplete="off"
              required
            />

          </div>

        </div>

      </div>


      <!-- =================================================
           IMAGE SECTION
      ================================================== -->

      <div class="form-section image-section">

        <div class="section-heading">

          <div class="section-number">
            02
          </div>

          <div>

            <h2>
              Category image
            </h2>

            <p>
              <%= isEdit
                ? "Keep the current image or choose a new one."
                : "Upload an image from your device or use an image URL."
              %>
            </p>

          </div>

        </div>


        <!-- ===============================================
             IMAGE SOURCE CHOICES
        ================================================ -->

        <div class="image-source-grid">


          <!-- =============================================
               UPLOAD
          ============================================== -->

          <div
            class="image-method selected"
            id="uploadMethod"
          >

            <label
              class="image-method-header"
              for="sourceUpload"
            >

              <div class="method-radio">

                <input
                  type="radio"
                  id="sourceUpload"
                  name="imageSource"
                  value="upload"
                  checked
                />

                <span class="custom-radio"></span>

              </div>


              <div class="method-icon upload-icon">

                <i class="fas fa-cloud-arrow-up"></i>

              </div>


              <div class="method-title">

                <strong>
                  Upload a photo
                </strong>

                <span>
                  Choose from your device
                </span>

              </div>

            </label>


            <div class="image-method-content">

              <label
                for="categoryIcon"
                class="file-upload-box"
                id="fileUploadBox"
              >

                <div class="upload-cloud">

                  <i class="fas fa-image"></i>

                </div>


                <strong>
                  Select category image
                </strong>


                <span>
                  Click here to browse your device
                </span>


                <small>
                  JPG, PNG, WEBP or GIF · Max 5 MB
                </small>

              </label>


              <input
                type="file"
                id="categoryIcon"
                name="categoryIcon"
                accept="image/jpeg,image/png,image/webp,image/gif,.jpg,.jpeg,.png,.webp,.gif"
              />


              <div
                class="selected-file"
                id="selectedFile"
                hidden
              >

                <div class="selected-file-icon">

                  <i class="fas fa-file-image"></i>

                </div>


                <div class="selected-file-info">

                  <strong id="selectedFileName">
                    Image selected
                  </strong>

                  <span id="selectedFileSize">
                    Ready to upload
                  </span>

                </div>


                <button
                  type="button"
                  id="removeFile"
                  class="remove-file"
                  aria-label="Remove selected image"
                >

                  <i class="fas fa-xmark"></i>

                </button>

              </div>

            </div>

          </div>


          <!-- =============================================
               URL
          ============================================== -->

          <div
            class="image-method"
            id="urlMethod"
          >

            <label
              class="image-method-header"
              for="sourceUrl"
            >

              <div class="method-radio">

                <input
                  type="radio"
                  id="sourceUrl"
                  name="imageSource"
                  value="url"
                />

                <span class="custom-radio"></span>

              </div>


              <div class="method-icon url-icon">

                <i class="fas fa-link"></i>

              </div>


              <div class="method-title">

                <strong>
                  Use image URL
                </strong>

                <span>
                  Link to an online image
                </span>

              </div>

            </label>


            <div class="image-method-content">

              <label
                for="categoryIconUrl"
                class="url-label"
              >
                Image URL
              </label>


              <div class="url-input-wrapper">

                <i class="fas fa-globe"></i>

                <input
                  type="url"
                  id="categoryIconUrl"
                  name="categoryIconUrl"
                  value="<%= formData?.categoryIconUrl || '' %>"
                  placeholder="https://example.com/image.jpg"
                  autocomplete="off"
                />

              </div>


              <div class="url-hint">

                <i class="fas fa-circle-info"></i>

                <span>
                  The image must be publicly accessible.
                </span>

              </div>

            </div>

          </div>

        </div>


        <!-- ===============================================
             EXISTING IMAGE
        ================================================ -->

        <% if (existingImage) { %>

          <div
            class="image-preview-wrapper"
            id="existingImageWrapper"
          >

            <div class="preview-heading">

              <div>

                <span class="preview-label">
                  Current Image
                </span>

                <span class="preview-description">
                  Your current category image.
                </span>

              </div>

            </div>


            <div class="image-preview-card">

              <div class="preview-image-container">

                <img
                  id="existingImagePreview"
                  src="<%= existingImage %>"
                  alt="<%= categoryName || 'Category' %>"
                  onerror="this.style.display='none';"
                />

              </div>


              <div class="preview-details">

                <span class="preview-details-label">
                  CATEGORY ICON
                </span>

                <strong>
                  <%= categoryName || "Category" %>
                </strong>

                <span>
                  Current image
                </span>

              </div>

            </div>

          </div>

        <% } %>


        <!-- ===============================================
             NEW IMAGE PREVIEW
        ================================================ -->

        <div
          class="image-preview-wrapper"
          id="previewWrapper"
          hidden
        >

          <div class="preview-heading">

            <div>

              <span class="preview-label">
                New Image Preview
              </span>

              <span class="preview-description">
                This image will replace the current image.
              </span>

            </div>


            <button
              type="button"
              id="clearPreview"
              class="clear-preview"
            >
              Clear
            </button>

          </div>


          <div class="image-preview-card">

            <div class="preview-image-container">

              <img
                id="imagePreview"
                src=""
                alt="Category image preview"
              />

            </div>


            <div class="preview-details">

              <span class="preview-details-label">
                CATEGORY ICON
              </span>

              <strong id="previewCategoryName">
                <%= categoryName || "New Category" %>
              </strong>

              <span>
                New image preview
              </span>

            </div>

          </div>

        </div>

      </div>


      <!-- =================================================
           ACTIONS
      ================================================== -->

      <div class="category-form-actions">


        <!-- CANCEL -->

        <a
          href="/products"
          class="category-btn category-btn-secondary"
        >

          <i class="fas fa-arrow-left"></i>

          <span>
            Cancel
          </span>

        </a>


        <!-- CREATE / SAVE -->

        <button
          type="submit"
          class="category-btn category-btn-primary"
        >

          <i class="fas <%= isEdit
            ? 'fa-floppy-disk'
            : 'fa-plus'
          %>"></i>

          <span>
            <%= isEdit
              ? "Save Changes"
              : "Create Category"
            %>
          </span>

        </button>


      </div>

    </form>

  </div>

</section>


<script>

  // ======================================================
  // MODE
  // ======================================================

  const isEditMode =
    <%= isEdit ? "true" : "false" %>;


  const existingImageUrl =
    <%- JSON.stringify(existingImage || "") %>;


  // ======================================================
  // ELEMENTS
  // ======================================================

  const form =
    document.getElementById("categoryForm");

  const nameInput =
    document.getElementById("name");

  const uploadRadio =
    document.getElementById("sourceUpload");

  const urlRadio =
    document.getElementById("sourceUrl");

  const uploadMethod =
    document.getElementById("uploadMethod");

  const urlMethod =
    document.getElementById("urlMethod");

  const fileInput =
    document.getElementById("categoryIcon");

  const urlInput =
    document.getElementById("categoryIconUrl");

  const selectedFile =
    document.getElementById("selectedFile");

  const selectedFileName =
    document.getElementById("selectedFileName");

  const selectedFileSize =
    document.getElementById("selectedFileSize");

  const removeFile =
    document.getElementById("removeFile");

  const previewWrapper =
    document.getElementById("previewWrapper");

  const imagePreview =
    document.getElementById("imagePreview");

  const clearPreview =
    document.getElementById("clearPreview");

  const previewCategoryName =
    document.getElementById("previewCategoryName");


  // ======================================================
  // FORMAT FILE SIZE
  // ======================================================

  function formatFileSize(bytes) {

    if (bytes < 1024) {
      return `${bytes} B`;
    }

    if (bytes < 1024 * 1024) {
      return `${(bytes / 1024).toFixed(1)} KB`;
    }

    return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;

  }


  // ======================================================
  // UPDATE METHOD
  // ======================================================

  function updateMethod() {

    uploadMethod.classList.toggle(
      "selected",
      uploadRadio.checked
    );

    urlMethod.classList.toggle(
      "selected",
      urlRadio.checked
    );

  }


  // ======================================================
  // HIDE NEW PREVIEW
  // ======================================================

  function hidePreview() {

    previewWrapper.hidden = true;

    imagePreview.removeAttribute("src");

  }


  // ======================================================
  // SHOW NEW PREVIEW
  // ======================================================

  function showPreview(src) {

    if (!src) {

      hidePreview();

      return;

    }

    imagePreview.src = src;

    previewCategoryName.textContent =
      nameInput.value.trim() ||
      "New Category";

    previewWrapper.hidden = false;

  }


  // ======================================================
  // FILE PREVIEW
  // ======================================================

  function previewUploadedImage() {

    const file =
      fileInput.files[0];

    if (!file) {

      selectedFile.hidden = true;

      hidePreview();

      return;

    }


    selectedFile.hidden = false;

    selectedFileName.textContent =
      file.name;

    selectedFileSize.textContent =
      formatFileSize(file.size);


    const reader =
      new FileReader();


    reader.onload =
      function(event) {

        showPreview(
          event.target.result
        );

      };


    reader.readAsDataURL(file);

  }


  // ======================================================
  // URL PREVIEW
  // ======================================================

  function previewUrlImage() {

    const url =
      urlInput.value.trim();

    if (!url) {

      hidePreview();

      return;

    }

    showPreview(url);

  }


  // ======================================================
  // UPLOAD SELECTED
  // ======================================================

  uploadRadio.addEventListener(
    "change",
    function() {

      updateMethod();

      urlInput.value = "";

      hidePreview();

    }
  );


  // ======================================================
  // URL SELECTED
  // ======================================================

  urlRadio.addEventListener(
    "change",
    function() {

      updateMethod();

      fileInput.value = "";

      selectedFile.hidden = true;

      previewUrlImage();

    }
  );


  // ======================================================
  // FILE SELECTED
  // ======================================================

  fileInput.addEventListener(
    "change",
    function() {

      if (!fileInput.files.length) {
        return;
      }


      uploadRadio.checked = true;

      updateMethod();

      urlInput.value = "";

      previewUploadedImage();

    }
  );


  // ======================================================
  // URL ENTERED
  // ======================================================

  urlInput.addEventListener(
    "input",
    function() {

      if (urlInput.value.trim()) {

        urlRadio.checked = true;

        updateMethod();

        fileInput.value = "";

        selectedFile.hidden = true;

        previewUrlImage();

      } else {

        hidePreview();

      }

    }
  );


  // ======================================================
  // REMOVE FILE
  // ======================================================

  removeFile.addEventListener(
    "click",
    function() {

      fileInput.value = "";

      selectedFile.hidden = true;

      hidePreview();

    }
  );


  // ======================================================
  // CLEAR NEW PREVIEW
  // ======================================================

  clearPreview.addEventListener(
    "click",
    function() {

      if (uploadRadio.checked) {

        fileInput.value = "";

        selectedFile.hidden = true;

      } else {

        urlInput.value = "";

      }

      hidePreview();

    }
  );


  // ======================================================
  // CATEGORY NAME PREVIEW
  // ======================================================

  nameInput.addEventListener(
    "input",
    function() {

      previewCategoryName.textContent =
        nameInput.value.trim() ||
        "New Category";

    }
  );


  // ======================================================
  // IMAGE LOAD ERROR
  // ======================================================

  imagePreview.addEventListener(
    "error",
    function() {

      imagePreview.classList.add(
        "preview-error"
      );

    }
  );


  imagePreview.addEventListener(
    "load",
    function() {

      imagePreview.classList.remove(
        "preview-error"
      );

    }
  );


  // ======================================================
  // FORM VALIDATION
  // ======================================================

  form.addEventListener(
    "submit",
    function(event) {

      const hasFile =
        fileInput.files.length > 0;

      const hasUrl =
        urlInput.value.trim().length > 0;


      // -----------------------------------------------
      // NAME REQUIRED
      // -----------------------------------------------

      if (!nameInput.value.trim()) {

        event.preventDefault();

        nameInput.focus();

        return;

      }


      // -----------------------------------------------
      // BOTH IMAGE SOURCES USED
      // -----------------------------------------------

      if (hasFile && hasUrl) {

        event.preventDefault();

        alert(
          "Please use either the uploaded image or the image URL, not both."
        );

        return;

      }


      // -----------------------------------------------
      // CREATE MODE
      //
      // New category must have an image.
      // -----------------------------------------------

      if (
        !isEditMode &&
        !hasFile &&
        !hasUrl
      ) {

        event.preventDefault();

        alert(
          "Please upload a category image or enter an image URL."
        );

        return;

      }


      // -----------------------------------------------
      // EDIT MODE
      //
      // Existing image is allowed to remain.
      // -----------------------------------------------

      if (
        isEditMode &&
        !hasFile &&
        !hasUrl &&
        !existingImageUrl
      ) {

        event.preventDefault();

        alert(
          "Please upload a category image or enter an image URL."
        );

        return;

      }

    }
  );


  // ======================================================
  // INITIALIZE
  // ======================================================

  updateMethod();

</script>