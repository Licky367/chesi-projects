<!-- ==========================================================
     views/products/category/add.ejs
     ADD CATEGORY
=========================================================== -->

<section class="category-add-page">

  <div class="category-add-shell">

    <!-- ======================================================
         HEADER
    ======================================================= -->

    <div class="category-add-header">

      <a
        href="/products"
        class="category-back-link"
      >
        <i class="fas fa-arrow-left"></i>
        <span>Back to Products</span>
      </a>

      <div class="category-heading">

        <div class="category-heading-icon">
          <i class="fas fa-layer-group"></i>
        </div>

        <div>
          <p class="category-eyebrow">
            Product Management
          </p>

          <h1>
            Add Category
          </h1>

          <p class="category-subtitle">
            Create a new product category for Verrah Cosmetics.
          </p>
        </div>

      </div>

    </div>


    <!-- ======================================================
         ERROR
    ======================================================= -->

    <% if (error) { %>

      <div class="category-alert category-alert-error">

        <i class="fas fa-circle-exclamation"></i>

        <span>
          <%= error %>
        </span>

      </div>

    <% } %>


    <!-- ======================================================
         SUCCESS
    ======================================================= -->

    <% if (success) { %>

      <div class="category-alert category-alert-success">

        <i class="fas fa-circle-check"></i>

        <span>
          <%= success %>
        </span>

      </div>

    <% } %>


    <!-- ======================================================
         FORM CARD
    ======================================================= -->

    <div class="category-form-card">

      <div class="category-form-header">

        <div class="category-form-icon">
          <i class="fas fa-folder-plus"></i>
        </div>

        <div>

          <h2>
            Category Details
          </h2>

          <p>
            Enter the name and icon for the new category.
          </p>

        </div>

      </div>


      <form
        action="/products/category/add"
        method="POST"
        enctype="multipart/form-data"
        class="category-form"
      >

        <!-- ==================================================
             CATEGORY NAME
        =================================================== -->

        <div class="form-group">

          <label for="name">
            Category Name
            <span>*</span>
          </label>

          <div class="input-wrapper">

            <i class="fas fa-tag"></i>

            <input
              type="text"
              id="name"
              name="name"
              value="<%= formData?.name || '' %>"
              placeholder="e.g. Skincare"
              autocomplete="off"
              required
            />

          </div>

          <small>
            Use a clear name such as Skincare, Haircare,
            Makeup, Fragrance, or Body Care.
          </small>

        </div>


        <!-- ==================================================
             CATEGORY ICON
        =================================================== -->

        <div class="form-group">

          <label for="categoryIcon">
            Category Icon
            <span>*</span>
          </label>

          <div class="icon-upload-box">

            <div
              class="icon-preview"
              id="iconPreview"
            >
              <i class="fas fa-image"></i>
            </div>

            <div class="icon-upload-content">

              <label
                for="categoryIcon"
                class="upload-button"
              >
                <i class="fas fa-cloud-arrow-up"></i>

                <span>
                  Choose Image
                </span>
              </label>

              <input
                type="file"
                id="categoryIcon"
                name="categoryIcon"
                accept="image/*"
                required
              />

              <p>
                Upload an image that represents this category.
              </p>

              <span
                class="selected-file"
                id="selectedFile"
              >
                No image selected
              </span>

            </div>

          </div>

        </div>


        <!-- ==================================================
             INFORMATION
        =================================================== -->

        <div class="category-info-box">

          <div class="info-icon">
            <i class="fas fa-circle-info"></i>
          </div>

          <div>

            <strong>
              Category information
            </strong>

            <p>
              A unique MongoDB <code>_id</code> will be
              generated automatically when this category
              is created.
            </p>

          </div>

        </div>


        <!-- ==================================================
             ACTIONS
        =================================================== -->

        <div class="category-form-actions">

          <a
            href="/products"
            class="category-cancel-button"
          >
            <i class="fas fa-xmark"></i>
            Cancel
          </a>

          <button
            type="submit"
            class="category-submit-button"
          >
            <i class="fas fa-plus"></i>
            Create Category
          </button>

        </div>

      </form>

    </div>

  </div>

</section>


<script>
  const iconInput =
    document.getElementById("categoryIcon");

  const iconPreview =
    document.getElementById("iconPreview");

  const selectedFile =
    document.getElementById("selectedFile");


  iconInput?.addEventListener(
    "change",
    function () {

      const file =
        this.files?.[0];

      if (!file) {

        selectedFile.textContent =
          "No image selected";

        iconPreview.innerHTML =
          '<i class="fas fa-image"></i>';

        return;
      }


      selectedFile.textContent =
        file.name;


      const reader =
        new FileReader();


      reader.onload =
        function (event) {

          iconPreview.innerHTML =
            `
              <img
                src="${event.target.result}"
                alt="Category preview"
              >
            `;

        };


      reader.readAsDataURL(file);

    }
  );
</script>