<!-- ======================================================
     verrah/views/products/category/add.ejs
     ADD CATEGORY
====================================================== -->

<link
  rel="stylesheet"
  href="/css/products/category-add.css"
/>

<section class="category-add-page">

  <div class="category-add-card">

    <!-- ==================================================
         HEADER
    =================================================== -->

    <div class="category-add-header">

      <div class="category-add-icon">
        <i class="fas fa-layer-group"></i>
      </div>

      <div>
        <h1>
          Add Category
        </h1>

        <p>
          Create a new Verrah Cosmetics category.
        </p>
      </div>

    </div>

    <!-- ==================================================
         ERROR
    =================================================== -->

    <% if (error) { %>

      <div class="category-alert category-alert-error">

        <i class="fas fa-circle-exclamation"></i>

        <span>
          <%= error %>
        </span>

      </div>

    <% } %>

    <!-- ==================================================
         FORM
    =================================================== -->

    <form
      class="category-form"
      action="/products/category/add"
      method="POST"
      enctype="multipart/form-data"
      id="categoryForm"
    >

      <!-- =================================================
           CATEGORY NAME
      ================================================== -->

      <div class="form-group">

        <label for="name">
          Category Name
        </label>

        <input
          type="text"
          id="name"
          name="name"
          value="<%= formData?.name || '' %>"
          placeholder="e.g. skincare"
          autocomplete="off"
          required
        />

      </div>

      <!-- =================================================
           IMAGE SOURCE
      ================================================== -->

      <div class="image-source-heading">

        <h2>
          Category Icon
        </h2>

        <p>
          Choose one way to provide the category image.
        </p>

      </div>

      <!-- =================================================
           UPLOAD OPTION
      ================================================== -->

      <div
        class="image-option"
        id="uploadOption"
      >

        <label class="option-label">

          <input
            type="radio"
            name="imageSource"
            value="upload"
            id="imageSourceUpload"
            checked
          />

          <span>
            Upload a photo
          </span>

        </label>

        <div
          class="option-content"
          id="uploadContent"
        >

          <label
            for="categoryIcon"
            class="file-drop"
            id="fileDrop"
          >

            <i class="fas fa-cloud-arrow-up"></i>

            <strong>
              Choose category photo
            </strong>

            <span>
              JPG, JPEG, PNG, WEBP or GIF
            </span>

            <span>
              Maximum size: 5 MB
            </span>

          </label>

          <input
            type="file"
            id="categoryIcon"
            name="categoryIcon"
            accept=".jpg,.jpeg,.png,.webp,.gif,image/jpeg,image/png,image/webp,image/gif"
          />

        </div>

      </div>

      <!-- =================================================
           URL OPTION
      ================================================== -->

      <div
        class="image-option"
        id="urlOption"
      >

        <label class="option-label">

          <input
            type="radio"
            name="imageSource"
            value="url"
            id="imageSourceUrl"
          />

          <span>
            Use an image URL
          </span>

        </label>

        <div
          class="option-content hidden-option"
          id="urlContent"
        >

          <label for="categoryIconUrl">
            Image URL
          </label>

          <input
            type="url"
            id="categoryIconUrl"
            name="categoryIconUrl"
            value="<%= formData?.categoryIconUrl || '' %>"
            placeholder="https://example.com/category-image.jpg"
            autocomplete="off"
          />

          <small>
            Enter a publicly accessible HTTP or HTTPS image URL.
          </small>

        </div>

      </div>

      <!-- =================================================
           PREVIEW
      ================================================== -->

      <div
        class="image-preview-wrapper"
        id="previewWrapper"
        hidden
      >

        <p>
          Preview
        </p>

        <div class="image-preview">

          <img
            id="imagePreview"
            src=""
            alt="Category icon preview"
          />

        </div>

      </div>

      <!-- =================================================
           ACTIONS
      ================================================== -->

      <div class="category-form-actions">

        <a
          href="/products"
          class="category-btn category-btn-secondary"
        >
          Cancel
        </a>

        <button
          type="submit"
          class="category-btn category-btn-primary"
        >

          <i class="fas fa-plus"></i>

          Create Category

        </button>

      </div>

    </form>

  </div>

</section>

<script>

  const uploadRadio =
    document.getElementById(
      "imageSourceUpload"
    );

  const urlRadio =
    document.getElementById(
      "imageSourceUrl"
    );

  const uploadContent =
    document.getElementById(
      "uploadContent"
    );

  const urlContent =
    document.getElementById(
      "urlContent"
    );

  const fileInput =
    document.getElementById(
      "categoryIcon"
    );

  const urlInput =
    document.getElementById(
      "categoryIconUrl"
    );

  const previewWrapper =
    document.getElementById(
      "previewWrapper"
    );

  const preview =
    document.getElementById(
      "imagePreview"
    );

  // ======================================================
  // UPDATE IMAGE SOURCE
  // ======================================================

  function updateImageSource() {

    if (uploadRadio.checked) {

      uploadContent.classList.remove(
        "hidden-option"
      );

      urlContent.classList.add(
        "hidden-option"
      );

      urlInput.value = "";

      showUploadPreview();

      return;
    }

    uploadContent.classList.add(
      "hidden-option"
    );

    urlContent.classList.remove(
      "hidden-option"
    );

    fileInput.value = "";

    showUrlPreview();
  }

  // ======================================================
  // UPLOAD PREVIEW
  // ======================================================

  function showUploadPreview() {

    const file =
      fileInput.files[0];

    if (!file) {

      previewWrapper.hidden = true;

      preview.src = "";

      return;
    }

    const reader =
      new FileReader();

    reader.onload =
      function (event) {

        preview.src =
          event.target.result;

        previewWrapper.hidden =
          false;
      };

    reader.readAsDataURL(file);
  }

  // ======================================================
  // URL PREVIEW
  // ======================================================

  function showUrlPreview() {

    const url =
      urlInput.value.trim();

    if (!url) {

      previewWrapper.hidden = true;

      preview.src = "";

      return;
    }

    preview.src = url;

    previewWrapper.hidden = false;
  }

  // ======================================================
  // EVENTS
  // ======================================================

  uploadRadio.addEventListener(
    "change",
    updateImageSource
  );

  urlRadio.addEventListener(
    "change",
    updateImageSource
  );

  fileInput.addEventListener(
    "change",
    showUploadPreview
  );

  urlInput.addEventListener(
    "input",
    showUrlPreview
  );

  // ======================================================
  // INITIAL STATE
  // ======================================================

  updateImageSource();

</script>