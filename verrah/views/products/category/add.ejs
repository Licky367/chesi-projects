      )
      .render(

        "products/category/add",

        {

          title:
            "Add Category | Verrah Cosmetics",

          error:
            error.message ||
            "Unable to create category.",

          success:
            null,

          category:
            null,

          businessTypes,

          formData:
            buildFormData(
              req.body
            ),

          isAdmin:
            getIsAdmin(req)

        }

      );

  }

};


