<!-- ======================================================
     verrah/views/products/category/add.ejs
     ADD CATEGORY
====================================================== -->

<link
  rel="stylesheet"
  href="/css/products/category-add.css"
/>

<section class="category-add-page">

  <div class="category-add-card">

    <!-- ==================================================
         HEADER
    =================================================== -->

    <div class="category-add-header">

      <div class="category-add-icon">
        <i class="fas fa-layer-group"></i>
      </div>

      <div>
        <h1>Add Category</h1>

        <p>
          Create a new Verrah Cosmetics category.
        </p>
      </div>

    </div>


    <!-- ==================================================
         ERROR
    =================================================== -->

    <% if (error) { %>

      <div class="category-alert category-alert-error">

        <i class="fas fa-circle-exclamation"></i>

        <span>
          <%= error %>
        </span>

      </div>

    <% } %>


    <!-- ==================================================
         FORM
    =================================================== -->

    <form
      id="categoryForm"
      class="category-form"
      action="/products/category/add"
      method="POST"
      enctype="multipart/form-data"
    >

      <!-- =================================================
           CATEGORY NAME
      ================================================== -->

      <div class="form-group">

        <label for="name">
          Category Name
        </label>

        <input
          type="text"
          id="name"
          name="name"
          value="<%= formData?.name || '' %>"
          placeholder="Enter category name"
          autocomplete="off"
          required
        />

      </div>


      <!-- =================================================
           CATEGORY IMAGE
      ================================================== -->

      <div class="form-group">

        <label>
          Category Image
        </label>

        <p class="field-description">
          Choose one of the two options below.
        </p>

      </div>


      <!-- =================================================
           UPLOAD IMAGE OPTION
      ================================================== -->

      <div class="image-source-card">

        <div class="image-source-header">

          <label
            class="source-radio"
            for="sourceUpload"
          >

            <input
              type="radio"
              id="sourceUpload"
              name="imageSource"
              value="upload"
              checked
            />

            <span>
              Upload a photo
            </span>

          </label>

        </div>


        <div class="image-source-body">

          <label
            for="categoryIcon"
            class="file-upload-box"
          >

            <i class="fas fa-cloud-arrow-up"></i>

            <strong>
              Choose a category image
            </strong>

            <span>
              JPG, JPEG, PNG, WEBP or GIF
            </span>

            <span>
              Maximum file size: 5 MB
            </span>

          </label>

          <input
            type="file"
            id="categoryIcon"
            name="categoryIcon"
            accept="image/jpeg,image/png,image/webp,image/gif,.jpg,.jpeg,.png,.webp,.gif"
          />

        </div>

      </div>


      <!-- =================================================
           OR
      ================================================== -->

      <div class="image-source-divider">

        <span>OR</span>

      </div>


      <!-- =================================================
           IMAGE URL OPTION
      ================================================== -->

      <div class="image-source-card">

        <div class="image-source-header">

          <label
            class="source-radio"
            for="sourceUrl"
          >

            <input
              type="radio"
              id="sourceUrl"
              name="imageSource"
              value="url"
            />

            <span>
              Use an image URL
            </span>

          </label>

        </div>


        <div class="image-source-body">

          <label
            for="categoryIconUrl"
            class="url-label"
          >
            Image URL
          </label>

          <input
            type="url"
            id="categoryIconUrl"
            name="categoryIconUrl"
            value="<%= formData?.categoryIconUrl || '' %>"
            placeholder="https://example.com/category-image.jpg"
            autocomplete="off"
          />

          <small class="url-help">
            Enter the complete HTTP or HTTPS URL of the image.
          </small>

        </div>

      </div>


      <!-- =================================================
           IMAGE PREVIEW
      ================================================== -->

      <div
        class="image-preview-wrapper"
        id="previewWrapper"
        hidden
      >

        <div class="preview-heading">
          Image Preview
        </div>

        <div class="image-preview">

          <img
            id="imagePreview"
            src=""
            alt="Category image preview"
          />

        </div>

      </div>


      <!-- =================================================
           ACTIONS
      ================================================== -->

      <div class="category-form-actions">

        <a
          href="/products"
          class="category-btn category-btn-secondary"
        >
          <i class="fas fa-arrow-left"></i>

          Cancel
        </a>


        <button
          type="submit"
          class="category-btn category-btn-primary"
        >

          <i class="fas fa-plus"></i>

          Create Category

        </button>

      </div>

    </form>

  </div>

</section>


<script>

  // ======================================================
  // ELEMENTS
  // ======================================================

  const uploadRadio =
    document.getElementById("sourceUpload");

  const urlRadio =
    document.getElementById("sourceUrl");

  const fileInput =
    document.getElementById("categoryIcon");

  const urlInput =
    document.getElementById("categoryIconUrl");

  const previewWrapper =
    document.getElementById("previewWrapper");

  const imagePreview =
    document.getElementById("imagePreview");


  // ======================================================
  // IMAGE PREVIEW
  // ======================================================

  function hidePreview() {

    previewWrapper.hidden = true;

    imagePreview.removeAttribute("src");

  }


  // ======================================================
  // UPLOADED IMAGE PREVIEW
  // ======================================================

  function previewUploadedImage() {

    const file =
      fileInput.files[0];

    if (!file) {

      hidePreview();

      return;

    }

    const reader =
      new FileReader();

    reader.onload =
      function (event) {

        imagePreview.src =
          event.target.result;

        previewWrapper.hidden =
          false;

      };

    reader.readAsDataURL(file);

  }


  // ======================================================
  // URL IMAGE PREVIEW
  // ======================================================

  function previewUrlImage() {

    const url =
      urlInput.value.trim();

    if (!url) {

      hidePreview();

      return;

    }

    imagePreview.src =
      url;

    previewWrapper.hidden =
      false;

  }


  // ======================================================
  // UPLOAD OPTION SELECTED
  // ======================================================

  uploadRadio.addEventListener(
    "change",
    function () {

      if (!uploadRadio.checked) {
        return;
      }

      // Clear URL because only one source
      // should be submitted.

      urlInput.value = "";

      hidePreview();

    }
  );


  // ======================================================
  // URL OPTION SELECTED
  // ======================================================

  urlRadio.addEventListener(
    "change",
    function () {

      if (!urlRadio.checked) {
        return;
      }

      // Clear uploaded file because only one
      // source should be submitted.

      fileInput.value = "";

      previewUrlImage();

    }
  );


  // ======================================================
  // FILE SELECTED
  // ======================================================

  fileInput.addEventListener(
    "change",
    function () {

      if (!fileInput.files.length) {

        hidePreview();

        return;

      }

      // Automatically choose upload mode.

      uploadRadio.checked = true;

      urlInput.value = "";

      previewUploadedImage();

    }
  );


  // ======================================================
  // URL ENTERED
  // ======================================================

  urlInput.addEventListener(
    "input",
    function () {

      if (!urlInput.value.trim()) {

        hidePreview();

        return;

      }

      // Automatically choose URL mode.

      urlRadio.checked = true;

      fileInput.value = "";

      previewUrlImage();

    }
  );


  // ======================================================
  // PREVENT BOTH SOURCES
  // ======================================================

  document
    .getElementById("categoryForm")
    .addEventListener(
      "submit",
      function (event) {

        const hasFile =
          fileInput.files.length > 0;

        const hasUrl =
          urlInput.value.trim().length > 0;


        if (!hasFile && !hasUrl) {

          event.preventDefault();

          alert(
            "Please upload a category image or enter an image URL."
          );

          return;

        }


        if (hasFile && hasUrl) {

          event.preventDefault();

          alert(
            "Please use either the uploaded image or the image URL, not both."
          );

          return;

        }

      }
    );

</script>