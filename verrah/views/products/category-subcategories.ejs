<%
// ==========================================================
// verrah/views/products/category-subcategories.ejs
//
// CATEGORY SUBCATEGORIES
// ==========================================================

const currentCategory =
    typeof category !== "undefined"
        ? category
        : null;

const categoryName =
    currentCategory?.name || "Category";

const items =
    Array.isArray(subcategories)
        ? subcategories
        : [];

const pageTitle =
    typeof title !== "undefined" && title
        ? title
        : `${categoryName} Subcategories`;

const pageError =
    typeof error !== "undefined"
        ? error
        : null;

const oldSubcategory =
    typeof old !== "undefined" && old
        ? old.subcategory || ""
        : "";
%>


<div class="category-subcategories-page">


  <!-- ======================================================
       PAGE HEADER
       ====================================================== -->

  <div class="category-subcategories-header">

    <div class="category-subcategories-header-content">

      <div>

        <span class="category-subcategories-eyebrow">
          CATEGORY
        </span>

        <h1>
          <%= categoryName %>
        </h1>

        <p>
          Manage the subcategories belonging to this category.
        </p>

      </div>


      <a
        href="/products/category/<%= currentCategory?._id || "" %>"
        class="category-subcategories-back"
      >
        Back to Products
      </a>

    </div>

  </div>


  <!-- ======================================================
       ERROR
       ====================================================== -->

  <% if (pageError) { %>

    <div class="category-subcategories-alert error">
      <%= pageError %>
    </div>

  <% } %>


  <!-- ======================================================
       MAIN CONTENT
       ====================================================== -->

  <div class="category-subcategories-content">


    <!-- ====================================================
         ADD SUBCATEGORY
         ==================================================== -->

    <section class="subcategory-card">

      <div class="subcategory-card-header">

        <div>

          <span class="subcategory-card-label">
            ADD
          </span>

          <h2>
            Add Subcategory
          </h2>

        </div>

      </div>


      <form
        method="POST"
        action="/products/category/<%= currentCategory?._id || "" %>/subcategory"
        class="subcategory-form"
      >

        <div class="subcategory-form-group">

          <label for="subcategory">
            Subcategory Name
          </label>

          <input
            type="text"
            id="subcategory"
            name="subcategory"
            value="<%= oldSubcategory %>"
            placeholder="Enter subcategory name"
            autocomplete="off"
            maxlength="100"
            required
          >

        </div>


        <button
          type="submit"
          class="subcategory-submit"
        >
          Add Subcategory
        </button>

      </form>

    </section>


    <!-- ====================================================
         SUBCATEGORY LIST
         ==================================================== -->

    <section class="subcategory-card">

      <div class="subcategory-card-header">

        <div>

          <span class="subcategory-card-label">
            AVAILABLE
          </span>

          <h2>
            Subcategories
          </h2>

        </div>


        <span class="subcategory-count">
          <%= items.length %>
        </span>

      </div>


      <% if (items.length) { %>

        <div class="subcategory-list">

          <% items.forEach((subcategory, index) => { %>

            <div class="subcategory-item">

              <span class="subcategory-number">
                <%= index + 1 %>
              </span>

              <span class="subcategory-name">
                <%= subcategory %>
              </span>

            </div>

          <% }) %>

        </div>

      <% } else { %>

        <div class="subcategory-empty">

          <div class="subcategory-empty-icon">
            +
          </div>

          <h3>
            No subcategories yet
          </h3>

          <p>
            Add the first subcategory for
            <strong><%= categoryName %></strong>.
          </p>

        </div>

      <% } %>

    </section>


  </div>

</div>