<%
/* ==========================================================
   views/products/searchComposser.ejs
   VERRAH COSMETICS
   PRODUCT SEARCH COMPOSER

   PURPOSE:
   ----------------------------------------------------------
   - Reusable search entry component
   - Used by products.ejs and search.ejs
   - Clicking anywhere on the composer opens:
         /products/search
   - This is a navigation component, NOT the actual
     search form.
   ========================================================== */
%>


<a
    href="/products/search"
    class="products-search-composer"
    aria-label="Search products or categories"
    title="Search products"
>


    <!-- ======================================================
         SEARCH ICON
    ======================================================= -->

    <span
        class="products-search-composer-icon"
        aria-hidden="true"
    >

        <i class="fas fa-search"></i>

    </span>


    <!-- ======================================================
         SEARCH TEXT
    ======================================================= -->

    <span class="products-search-composer-text">

        Search products or categories...

    </span>


    <!-- ======================================================
         SEARCH ACTION ICON
    ======================================================= -->

    <span
        class="products-search-composer-action"
        aria-hidden="true"
    >

        <i class="fas fa-arrow-right"></i>

    </span>


</a>