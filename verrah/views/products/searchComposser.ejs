<%
/* ==========================================================
   views/products/searchComposser.ejs
   VERRAH COSMETICS
   PRODUCT SEARCH COMPOSER

   PURPOSE:
   ----------------------------------------------------------
   - Reusable product search component
   - User can tap and type directly into the composer
   - Submits through GET
   - Opens:
         /products/search?q=SEARCH_TERM
   - Search results are therefore ready when the
     search page opens.

   IMPORTANT:
   ----------------------------------------------------------
   This is an actual search form, NOT a navigation link.
   ========================================================== */
%>


<form
    action="/products/search"
    method="GET"
    class="products-search-composer"
    role="search"
    aria-label="Search products"
>


    <!-- ======================================================
         SEARCH ICON
    ======================================================= -->

    <span
        class="products-search-composer-icon"
        aria-hidden="true"
    >

        <i class="fas fa-search"></i>

    </span>


    <!-- ======================================================
         SEARCH INPUT
    ======================================================= -->

    <input
        type="search"
        name="q"
        class="products-search-composer-input"
        placeholder="Search products or categories..."
        aria-label="Search products or categories"
        autocomplete="off"
        required
    >


    <!-- ======================================================
         SEARCH ACTION
    ======================================================= -->

    <button
        type="submit"
        class="products-search-composer-action"
        aria-label="Search"
        title="Search"
    >

        <i class="fas fa-arrow-right" aria-hidden="true"></i>

    </button>


</form>