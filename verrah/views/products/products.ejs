<%
/* ==========================================================
   views/products/products.ejs
   VERRAH COSMETICS
   PRODUCT LISTING

   STRUCTURE:
   ----------------------------------------------------------
   - Page heading
   - Page description
   - Error message
   - Products grouped by category
   - Category name displayed
   - Category ObjectId NEVER displayed
   - Maximum 6 products per desktop row
   - Mobile horizontal scrolling handled by CSS
   - Subcategories remain product information
   ========================================================== */
%>


<section class="shop-page">


    <!-- ======================================================
         PAGE HEADER
    ======================================================= -->

    <div class="products-heading">

        <h1 class="page-title">
            Products
        </h1>

        <p class="page-subtitle">
            Welcome to Verrah Cosmetics.
            Explore our collection of beauty and cosmetic products
            and find something you love.
        </p>

    </div>


    <!-- ======================================================
         ERROR MESSAGE
    ======================================================= -->

    <% if (typeof error !== "undefined" && error) { %>

        <div class="error">

            <%= error %>

        </div>

    <% } %>


    <!-- ======================================================
         PRODUCTS AVAILABILITY
    ======================================================= -->

    <% if (!Array.isArray(categories) || categories.length === 0) { %>


        <!-- ==================================================
             NO PRODUCTS
        =================================================== -->

        <div class="empty products-empty">

            <i
                class="fas fa-box-open"
                aria-hidden="true"
            ></i>

            <div>
                No products are available right now.
            </div>

        </div>


    <% } else { %>


        <!-- ==================================================
             CATEGORY GROUPS
        =================================================== -->

        <% categories.forEach(function(group) { %>


            <%
            /* ==================================================
               CATEGORY DISPLAY NAME
            ===================================================

               The frontend displays only the human-readable
               category name.

               Supported backend properties:
                   group.label
                   group.categoryName

               Category ObjectIds are never displayed.
            =================================================== */

            var categoryName = "Other";


            if (
                typeof group.label === "string" &&
                group.label.trim()
            ) {

                categoryName = group.label.trim();

            } else if (
                typeof group.categoryName === "string" &&
                group.categoryName.trim()
            ) {

                categoryName = group.categoryName.trim();

            }


            /* ==================================================
               COLLECT PRODUCTS
            ===================================================

               Primary structure:

                   group.rows[].products

               Fallback structure:

                   group.products

               This keeps the view compatible with the
               existing product service response.
            =================================================== */

            var categoryProducts = [];


            if (Array.isArray(group.rows)) {

                group.rows.forEach(function(row) {

                    if (
                        row &&
                        Array.isArray(row.products)
                    ) {

                        row.products.forEach(function(product) {

                            if (product) {

                                categoryProducts.push(product);

                            }

                        });

                    }

                });

            }


            /* ==================================================
               FALLBACK PRODUCTS
            =================================================== */

            if (
                categoryProducts.length === 0 &&
                Array.isArray(group.products)
            ) {

                group.products.forEach(function(product) {

                    if (product) {

                        categoryProducts.push(product);

                    }

                });

            }

            %>


            <!-- ==================================================
                 CATEGORY SECTION
            =================================================== -->

            <% if (categoryProducts.length > 0) { %>


                <section class="category-section">


                    <!-- ==========================================
                         CATEGORY HEADER
                    =========================================== -->

                    <div class="category-head">

                        <h2>
                            <%= categoryName %>
                        </h2>

                        <span class="category-count">

                            <%= categoryProducts.length %>

                            product<%= (
                                categoryProducts.length === 1
                            ) ? "" : "s" %>

                        </span>

                    </div>


                    <!-- ==========================================
                         PRODUCT ROW
                    =========================================== -->

                    <div
                        class="product-row category-product-row"
                        aria-label="<%= categoryName %> products"
                    >


                        <% categoryProducts.forEach(function(product) { %>


                            <!-- ==================================
                                 PRODUCT CARD
                            =================================== -->

                            <a
                                href="/products/<%= product._id %>"
                                class="product-card"
                            >


                                <!-- ==================================
                                     PRODUCT IMAGE
                                =================================== -->

                                <div class="product-image">


                                    <% if (product.image) { %>


                                        <img
                                            src="<%= product.image %>"
                                            alt="<%= product.name || 'Product' %>"
                                            loading="lazy"
                                            onerror="
                                                this.style.display='none';
                                                this.nextElementSibling.style.display='flex';
                                            "
                                        >


                                        <!-- IMAGE FALLBACK -->

                                        <div
                                            class="placeholder product-image-fallback"
                                            style="display:none;"
                                        >

                                            <i
                                                class="fas fa-box"
                                                aria-hidden="true"
                                            ></i>

                                        </div>


                                    <% } else { %>


                                        <!-- NO IMAGE -->

                                        <div class="placeholder">

                                            <i
                                                class="fas fa-box"
                                                aria-hidden="true"
                                            ></i>

                                        </div>


                                    <% } %>


                                </div>


                                <!-- ==================================
                                     PRODUCT INFORMATION
                                =================================== -->

                                <div class="product-info">


                                    <!-- ==================================
                                         PRODUCT NAME
                                    =================================== -->

                                    <div class="product-name">

                                        <%= product.name || "Unnamed product" %>

                                    </div>


                                    <!-- ==================================
                                         SUBCATEGORY
                                    =================================== -->

                                    <% if (product.subcategory) { %>

                                        <div class="stock-meta-line">

                                            <%= product.subcategory %>

                                        </div>

                                    <% } %>


                                    <!-- ==================================
                                         PRICE
                                    =================================== -->

                                    <div class="product-price">

                                        KSh

                                        <%= Number(
                                            product.unitSellPrice || 0
                                        ).toLocaleString() %>

                                    </div>


                                    <!-- ==================================
                                         DELIVERY
                                    =================================== -->

                                    <div class="stock-text">

                                        <strong>

                                            <%= Number(
                                                product.days || 0
                                            ) %>

                                        </strong>

                                        day<%= (
                                            Number(product.days || 0) === 1
                                        ) ? "" : "s" %>

                                        delivery

                                    </div>


                                    <!-- ==================================
                                         STOCK
                                    =================================== -->

                                    <% if (Number(product.units || 0) > 0) { %>


                                        <div class="stock-text">

                                            <%= Number(
                                                product.units
                                            ).toLocaleString() %>

                                            available

                                        </div>


                                    <% } else { %>


                                        <div class="stock-text out">

                                            Out of stock

                                        </div>


                                    <% } %>


                                </div>


                            </a>


                        <% }); %>


                    </div>


                </section>


            <% } %>


        <% }); %>


    <% } %>


</section>