<%
/* ==========================================================
views/products/products.ejs
VERRAH COSMETICS
PRODUCT LISTING

PURPOSE:

Displays all products returned by the backend.

Products are grouped by CATEGORY.

IMPORTANT:

- Product.category is handled by the backend.
- This view NEVER displays Category._id.
- The frontend displays the category NAME only.
- Product._id is used only to open the product detail page.
- Subcategories do NOT create separate product sections.
- Maximum of SIX products are displayed per desktop row.
- Mobile uses horizontal scrolling.
  ==========================================================
  %>

<section class="shop-page"><!-- ======================================================
     PAGE HEADER
======================================================= -->

<div class="products-heading">

    <h1 class="page-title">
        Products
    </h1>


    <p class="page-subtitle">
        Welcome to Verrah Cosmetics Products.
        Browse through our products and order your wish.
    </p>

</div>



<!-- ======================================================
     ERROR MESSAGE
======================================================= -->

<% if (
    typeof error !== "undefined" &&
    error
) { %>

    <div class="error">

        <%= error %>

    </div>

<% } %>



<!-- ======================================================
     NO PRODUCTS
======================================================= -->

<% if (
    !Array.isArray(categories) ||
    categories.length === 0
) { %>


    <div class="empty products-empty">

        <i class="fas fa-box-open"></i>

        <div>

            No products are available right now.

        </div>

    </div>


<% } else { %>



    <!-- ==================================================
         CATEGORY GROUPS
    =================================================== -->

    <% categories.forEach((group) => { %>


        <%
        /* ==================================================
           CATEGORY NAME

           The backend should provide the category name.

           Supported backend structures:
             group.label
             group.categoryName
             group.category.name
             group.category

           The view NEVER intentionally renders a
           MongoDB ObjectId as a category name.
        ================================================== */

        let categoryName = "Other";


        if (
            typeof group.label === "string" &&
            group.label.trim()
        ) {

            categoryName = group.label.trim();

        } else if (
            typeof group.categoryName === "string" &&
            group.categoryName.trim()
        ) {

            categoryName = group.categoryName.trim();

        } else if (
            group.category &&
            typeof group.category === "object" &&
            typeof group.category.name === "string" &&
            group.category.name.trim()
        ) {

            categoryName =
                group.category.name.trim();

        } else if (
            typeof group.category === "string" &&
            group.category.trim() &&
            !/^[a-fA-F0-9]{24}$/.test(
                group.category.trim()
            )
        ) {

            categoryName =
                group.category.trim();

        }
        %>



        <%
        /* ==================================================
           FLATTEN CATEGORY PRODUCTS

           The backend may return products directly on
           group.products or inside group.rows[].products.

           All products belonging to this category are
           placed into ONE collection.

           CSS controls the six-column layout.
        ================================================== */

        const categoryProducts = [];


        if (Array.isArray(group.rows)) {

            group.rows.forEach((row) => {

                if (
                    row &&
                    Array.isArray(row.products)
                ) {

                    row.products.forEach((product) => {

                        if (product) {

                            categoryProducts.push(product);

                        }

                    });

                }

            });

        }


        /*
         * FALLBACK:
         *
         * Some backend responses may provide products
         * directly on the category group.
         */

        if (
            categoryProducts.length === 0 &&
            Array.isArray(group.products)
        ) {

            group.products.forEach((product) => {

                if (product) {

                    categoryProducts.push(product);

                }

            });

        }
        %>



        <!-- ==================================================
             CATEGORY SECTION
        =================================================== -->

        <% if (categoryProducts.length) { %>


            <section class="category-section">


                <!-- ==========================================
                     CATEGORY HEADER
                =========================================== -->

                <div class="category-head">

                    <h2>
                        <%= categoryName %>
                    </h2>


                    <span class="category-count">

                        <%= categoryProducts.length %>

                        product

                        <%=

                            categoryProducts.length === 1
                                ? ""
                                : "s"

                        %>

                    </span>

                </div>



                <!-- ==========================================
                     PRODUCT ROW

                     CSS:
                     Desktop = maximum 6 columns
                     Tablet  = 4 columns
                     Mobile  = horizontal scroll
                =========================================== -->

                <div
                    class="product-row category-product-row"
                    aria-label="<%= categoryName %> products"
                >


                    <% categoryProducts.forEach((product) => { %>


                        <!-- ==================================
                             PRODUCT CARD
                        =================================== -->

                        <a
                            href="/products/<%= product._id %>"
                            class="product-card"
                        >


                            <!-- ==============================
                                 PRODUCT IMAGE
                            =============================== -->

                            <div class="product-image">


                                <% if (product.image) { %>


                                    <img
                                        src="<%= product.image %>"
                                        alt="<%= product.name || 'Product' %>"
                                        loading="lazy"

                                        onerror="
                                            this.style.display='none';
                                            this.nextElementSibling.style.display='flex';
                                        "
                                    >


                                    <div
                                        class="placeholder product-image-fallback"
                                        style="display:none;"
                                    >

                                        <i class="fas fa-box"></i>

                                    </div>


                                <% } else { %>


                                    <div class="placeholder">

                                        <i class="fas fa-box"></i>

                                    </div>


                                <% } %>


                            </div>



                            <!-- ==============================
                                 PRODUCT INFORMATION
                            =============================== -->

                            <div class="product-info">


                                <!-- PRODUCT NAME -->

                                <div class="product-name">

                                    <%=

                                        product.name ||

                                        "Unnamed product"

                                    %>

                                </div>



                                <!-- SUBCATEGORY -->

                                <div class="stock-meta-line">

                                    <%=

                                        product.subcategory ||

                                        "Other"

                                    %>

                                </div>



                                <!-- SELLING PRICE -->

                                <div class="product-price">

                                    KSh

                                    <%=

                                        Number(
                                            product.unitSellPrice || 0
                                        ).toLocaleString()

                                    %>

                                </div>



                                <!-- DELIVERY -->

                                <div class="stock-text">

                                    <strong>

                                        <%=

                                            Number(
                                                product.days || 0
                                            )

                                        %>

                                    </strong>

                                    day

                                    <%=

                                        Number(product.days || 0) === 1
                                            ? ""
                                            : "s"

                                    %>

                                    delivery

                                </div>



                                <!-- AVAILABILITY -->

                                <div
                                    class="stock-text <%=

                                        Number(product.units || 0) <= 0

                                            ? "out"

                                            : ""

                                    %>"
                                >


                                    <% if (
                                        Number(product.units || 0) > 0
                                    ) { %>


                                        <%=

                                            Number(
                                                product.units
                                            ).toLocaleString()

                                        %>

                                        available


                                    <% } else { %>


                                        Out of stock


                                    <% } %>


                                </div>


                            </div>


                        </a>


                    <% }) %>


                </div>


            </section>


        <% } %>


    <% }) %>


<% } %>

</section>