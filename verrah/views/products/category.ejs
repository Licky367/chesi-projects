<%
  /*
   * ==========================================================
   * VERRAH COSMETICS
   * CATEGORY PRODUCTS PAGE
   * ==========================================================
   *
   * EXPECTED CONTROLLER DATA
   *
   * category
   * products
   * isAdmin
   * error
   *
   * IMPORTANT:
   *
   * Products are NOT grouped by subcategory.
   *
   * The products array is treated as ONE continuous list.
   *
   * MAXIMUM 3 PRODUCTS PER ROW.
   *
   * product.subcategory is displayed only as information.
   * It does NOT create separate groups.
   * ==========================================================
   */


  /* ==========================================================
     CATEGORY NAME
  ========================================================== */

  const categoryName =
    category?.name || "Products";


  /* ==========================================================
     CATEGORY ID
  ========================================================== */

  const categoryId =
    category?._id || "";


  /* ==========================================================
     DISPLAY LABEL
  ========================================================== */

  const categoryLabel =
    String(categoryName)
      .replace(/[-_]+/g, " ")
      .replace(/\b\w/g, (character) =>
        character.toUpperCase()
      );


  /* ==========================================================
     NORMALIZE PRODUCTS
  ========================================================== */

  const categoryProducts =
    Array.isArray(products)
      ? products
      : [];


  /* ==========================================================
     ROW SIZE
  ========================================================== */

  const productsPerRow = 3;

%>


<section class="shop-page category-products-page">


  <!-- ========================================================
       PAGE HEADER
  ========================================================= -->

  <div class="products-heading">

<% if(user && user.role === "admin") { %>

    <!-- ======================================================
         SUBCATEGORY LINK
    ======================================================= -->

    <div class="product-back">

      <a
        href="/products/category/<%= category._id %>/categories"
        class="secondary-btn"
      >

        <span>
          View Subcategories
        </span>

      </a>

    </div>

<% } %>


    <!-- ======================================================
         CATEGORY ICON
    ======================================================= -->

    <div class="category-page-icon">

      <% if (category?.categoryIcon) { %>

        <img
          src="<%= category.categoryIcon %>"
          alt="<%= categoryLabel %>"
        >

      <% } else { %>

        <div
          class="category-page-icon-placeholder"
          aria-hidden="true"
        >

          <i class="fas fa-folder"></i>

        </div>

      <% } %>

    </div>


    <!-- ======================================================
         ADMIN CATEGORY EDIT
    ======================================================= -->

    <% if (isAdmin) { %>

      <div class="category-admin-actions">

        <a
          href="/products/category/add/<%= categoryId %>"
          class="secondary-btn"
        >

          <i class="fas fa-image"></i>

          <span>
            Edit Category
          </span>

        </a>

      </div>

    <% } %>


    <!-- ======================================================
         CATEGORY TITLE
    ======================================================= -->

    <h1 class="page-title">

      <%= categoryLabel %>

    </h1>


    <!-- ======================================================
         CATEGORY DESCRIPTION
    ======================================================= -->

    <p class="page-subtitle">

      Explore our
      <%= categoryLabel %>
      collection.

    </p>


  </div>


  <!-- ========================================================
       ERROR
  ========================================================= -->

  <% if (typeof error !== "undefined" && error) { %>

    <div class="error">

      <i class="fas fa-exclamation-circle"></i>

      <span>
        <%= error %>
      </span>

    </div>

  <% } %>


  <!-- ========================================================
       EMPTY CATEGORY
  ========================================================= -->

  <% if (categoryProducts.length === 0) { %>

    <div class="empty category-empty">

      <i class="fas fa-box-open"></i>

      <span>

        There are currently no products
        in this category.

      </span>

    </div>

  <% } %>


  <!-- ========================================================
       PRODUCTS
  ========================================================= -->

  <% if (categoryProducts.length > 0) { %>


    <section class="category-section">


      <!-- ====================================================
           CATEGORY HEADER
      ===================================================== -->

      <div class="category-head">

        <h2>

          <%= categoryLabel %>

        </h2>


        <span>

          <%= categoryProducts.length %>

          product<%= categoryProducts.length === 1 ? "" : "s" %>

        </span>

      </div>


      <!-- ====================================================
           PRODUCT ROWS
      ===================================================== -->

      <%

        for (
          let rowStart = 0;
          rowStart < categoryProducts.length;
          rowStart += productsPerRow
        ) {

          const rowProducts =
            categoryProducts.slice(
              rowStart,
              rowStart + productsPerRow
            );

      %>


        <!-- ==================================================
             ROW BLOCK
        =================================================== -->

        <div class="subcategory-row-block">


          <!-- ================================================
               HORIZONTAL PRODUCT ROW
          ================================================= -->

          <div class="product-row">


            <% rowProducts.forEach((product) => { %>


              <%

                /*
                 * ------------------------------------------------
                 * PRODUCT LINK
                 * ------------------------------------------------
                 *
                 * Admin:
                 *     /stock/<productStock._id>
                 *
                 * Normal user:
                 *     /products/<product._id>
                 *
                 * getCategoryProducts() supplies productStock
                 * as an array containing the related Stock
                 * document.
                 */

                let productLink =
                  "/products/" +
                  product._id;


                if (
                  isAdmin &&
                  Array.isArray(product.productStock) &&
                  product.productStock.length > 0 &&
                  product.productStock[0] &&
                  product.productStock[0]._id
                ) {

                  productLink =
                    "/stock/" +
                    product.productStock[0]._id;

                }

              %>


              <!-- ==========================================
                   PRODUCT CARD
              =========================================== -->

              <a
                href="<%= productLink %>"
                class="product-card"
                aria-label="View <%= product.name %>"
              >


                <!-- ========================================
                     PRODUCT IMAGE
                ========================================= -->

                <div class="product-image">


                  <% if (product.image) { %>

                    <img
                      src="<%= product.image %>"
                      alt="<%= product.name %>"
                      loading="lazy"
                      onerror="
                        this.style.display='none';
                        this.nextElementSibling.style.display='flex';
                      "
                    >

                  <% } %>


                  <!-- ======================================
                       IMAGE FALLBACK
                  ======================================= -->

                  <div
                    class="placeholder"
                    style="<%= product.image ? 'display:none;' : 'display:flex;' %>"
                    aria-hidden="true"
                  >

                    <i class="fas fa-image"></i>

                  </div>


                </div>


                <!-- ========================================
                     PRODUCT INFORMATION
                ========================================= -->

                <div class="product-info">


                  <!-- ======================================
                       PRODUCT NAME
                  ======================================= -->

                  <div class="product-name">

                    <%= product.name %>

                  </div>


                  <!-- ======================================
                       CATEGORY / SUBCATEGORY
                  ======================================= -->

                  <div class="stock-meta-line">

                    <%= categoryLabel %>


                    <% if (
                      product.subcategory &&
                      String(product.subcategory).trim()
                    ) { %>

                      ·

                      <%= product.subcategory %>

                    <% } %>

                  </div>


                  <!-- ======================================
                       PRICE
                  ======================================= -->

                  <div class="product-price">

                    KSh

                    <%= Number(
                      product.unitSellPrice || 0
                    ).toLocaleString(
                      "en-KE",
                      {
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 2
                      }
                    ) %>

                  </div>


                  <!-- ======================================
                       STOCK
                  ======================================= -->

                  <% if (
                    Number(product.units || 0) > 0
                  ) { %>


                    <div class="stock-text">

                      <strong>
                        <%= product.units %>
                      </strong>

                      unit<%= Number(product.units) === 1 ? "" : "s" %>
                      available

                    </div>


                  <% } else { %>


                    <div class="stock-text out">

                      <i class="fas fa-times-circle"></i>

                      Out of stock

                    </div>


                  <% } %>


                </div>


              </a>


            <% }); %>


          </div>


        </div>


      <% } %>


    </section>


  <% } %>


</section>