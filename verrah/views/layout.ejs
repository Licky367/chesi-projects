<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>VERAH COSMETICS</title>


    <!-- =====================================================
       FAVICON
    ====================================================== -->

    <link
        rel="icon"
        type="image/png"
        href="/images/cfp-logo.png"
    >


    <!-- =====================================================
       MAIN LAYOUT CSS
    ====================================================== -->

    <link
        rel="stylesheet"
        href="/css/verrah/index.css"
    >


    <!-- =====================================================
       OPEN GRAPH
    ====================================================== -->

    <meta
        property="og:title"
        content="VERAH COSMETICS"
    >

    <meta
        property="og:description"
        content="VERAH COSMETICS"
    >

    <meta
        property="og:image"
        content="https://verrah.onrender.com/images/cfp-logo.png"
    >

    <meta
        property="og:url"
        content="https://verrah.onrender.com<%= currentPath || "/" %>"
    >

    <meta
        property="og:type"
        content="website"
    >

    <meta
        property="og:site_name"
        content="VERAH COSMETICS"
    >


    <!-- =====================================================
       TWITTER / X
    ====================================================== -->

    <meta
        name="twitter:card"
        content="summary_large_image"
    >

    <meta
        name="twitter:title"
        content="VERAH COSMETICS"
    >

    <meta
        name="twitter:description"
        content="VERAH COSMETICS"
    >

    <meta
        name="twitter:image"
        content="https://verrah.onrender.com/images/cfp-logo.png"
    >

</head>


<%

/* =========================================================
   AUTHENTICATION PAGES
========================================================= */

const authPages = [
    "/login",
    "/signup",
    "/forgot-password",
    "/reset-password"
];


const currentPagePath =
    currentPath ||
    (typeof req !== "undefined" && req.path) ||
    "";


const isAuthPage =
    authPages.includes(
        currentPagePath
    );


/* =========================================================
   HOME LINK
========================================================= */

const homeLink = "/";


/* =========================================================
   ROLE FLAGS
   AVAILABLE ROLES:
   admin
   staff
   client
========================================================= */

const isAdmin =
    !!user &&
    user.role === "admin";


const isStaff =
    !!user &&
    user.role === "staff";


const isClient =
    !!user &&
    user.role === "client";

%>


<body
    class="<%= isAuthPage ? 'auth-page' : 'app-page' %>"
>


<% if(!isAuthPage){ %>


<!-- =========================================================
   HEADER
========================================================= -->

<%- include("layout-partials/header", {
    homeLink: homeLink,
    headerTitle: "VERAH COSMETICS"
}) %>


<!-- =========================================================
   SIDEBAR
   SAME SIDEBAR FOR EVERYONE
========================================================= -->

<%- include("layout-partials/sidebar", {
    homeLink: homeLink,
    isAdmin: isAdmin,
    isStaff: isStaff,
    isClient: isClient
}) %>


<% } %>


<!-- =========================================================
   MAIN CONTENT
========================================================= -->

<div class="main">

    <%- body %>

</div>


<!-- =========================================================
   FOOTER
========================================================= -->

<%- include("layout-partials/footer") %>


<% if(!isAuthPage){ %>


<script>

/* =========================================================
   PROFILE
========================================================= */

const profileBox =
    document.getElementById(
        "profileBox"
    );


function toggleProfile(event){

    event.stopPropagation();

    if(profileBox){

        profileBox.classList.toggle(
            "active"
        );

    }

}


/* =========================================================
   SIDEBAR ELEMENTS
========================================================= */

const sidebar =
    document.getElementById(
        "sidebar"
    );


const menuButton =
    document.getElementById(
        "menuButton"
    );


const sidebarMenuButton =
    document.getElementById(
        "sidebarMenuButton"
    );


const overlay =
    document.getElementById(
        "sidebarOverlay"
    );


const dairyActivitiesButton =
    document.getElementById(
        "dairyActivitiesButton"
    );


const dairyActivitiesSubmenu =
    document.getElementById(
        "dairyActivitiesSubmenu"
    );


/* =========================================================
   OPEN SIDEBAR
========================================================= */

function openSidebar(){

    if(
        !sidebar ||
        !overlay
    ){

        return;

    }


    sidebar.classList.add(
        "active"
    );


    overlay.classList.add(
        "active"
    );


    sidebar.setAttribute(
        "aria-expanded",
        "true"
    );


    overlay.setAttribute(
        "aria-hidden",
        "false"
    );


    if(menuButton){

        menuButton.setAttribute(
            "aria-expanded",
            "true"
        );

    }

}


/* =========================================================
   CLOSE DAIRY ACTIVITIES
========================================================= */

function closeDairyActivities(){

    if(
        !dairyActivitiesButton ||
        !dairyActivitiesSubmenu
    ){

        return;

    }


    dairyActivitiesButton.setAttribute(
        "aria-expanded",
        "false"
    );


    dairyActivitiesButton.classList.remove(
        "expanded"
    );


    dairyActivitiesSubmenu.classList.remove(
        "open"
    );

}


/* =========================================================
   CLOSE SIDEBAR
========================================================= */

function closeSidebar(){

    if(
        !sidebar ||
        !overlay
    ){

        return;

    }


    sidebar.classList.remove(
        "active"
    );


    overlay.classList.remove(
        "active"
    );


    sidebar.setAttribute(
        "aria-expanded",
        "false"
    );


    overlay.setAttribute(
        "aria-hidden",
        "true"
    );


    if(menuButton){

        menuButton.setAttribute(
            "aria-expanded",
            "false"
        );

    }


    closeDairyActivities();

}


/* =========================================================
   HEADER MENU BUTTON
========================================================= */

if(menuButton){

    menuButton.addEventListener(
        "click",
        function(event){

            event.preventDefault();

            event.stopPropagation();


            if(
                sidebar &&
                sidebar.classList.contains(
                    "active"
                )
            ){

                closeSidebar();

            }

            else{

                openSidebar();

            }

        }
    );

}


/* =========================================================
   SIDEBAR MENU BUTTON
   CLOSES SIDEBAR
========================================================= */

if(sidebarMenuButton){

    sidebarMenuButton.addEventListener(
        "click",
        function(event){

            event.preventDefault();

            event.stopPropagation();

            closeSidebar();

        }
    );

}


/* =========================================================
   DAIRY ACTIVITIES
========================================================= */

if(
    dairyActivitiesButton &&
    dairyActivitiesSubmenu
){

    dairyActivitiesButton.addEventListener(
        "click",
        function(event){

            event.preventDefault();

            event.stopPropagation();


            const isExpanded =
                dairyActivitiesButton.getAttribute(
                    "aria-expanded"
                ) === "true";


            dairyActivitiesButton.setAttribute(
                "aria-expanded",
                String(!isExpanded)
            );


            dairyActivitiesButton.classList.toggle(
                "expanded",
                !isExpanded
            );


            dairyActivitiesSubmenu.classList.toggle(
                "open",
                !isExpanded
            );

        }
    );

}


/* =========================================================
   SIDEBAR LINKS
========================================================= */

if(sidebar){

    sidebar
        .querySelectorAll(
            ".sidebar-link"
        )
        .forEach(
            function(link){

                link.addEventListener(
                    "click",
                    function(){

                        closeSidebar();

                    }
                );

            }
        );

}


/* =========================================================
   SIDEBAR OVERLAY
========================================================= */

if(overlay){

    overlay.addEventListener(
        "click",
        function(){

            closeSidebar();

        }
    );

}


/* =========================================================
   CLOSE PROFILE WHEN CLICKING OUTSIDE
========================================================= */

document.addEventListener(
    "click",
    function(event){

        if(
            profileBox &&
            !profileBox.contains(
                event.target
            )
        ){

            profileBox.classList.remove(
                "active"
            );

        }

    }
);


/* =========================================================
   ESCAPE KEY
========================================================= */

document.addEventListener(
    "keydown",
    function(event){

        if(event.key === "Escape"){

            closeSidebar();


            if(profileBox){

                profileBox.classList.remove(
                    "active"
                );

            }

        }

    }
);


/* =========================================================
   WINDOW RESIZE
========================================================= */

window.addEventListener(
    "resize",
    function(){

        closeSidebar();

    }
);

</script>


<% } %>


</body>

</html>