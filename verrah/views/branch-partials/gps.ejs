<!-- =========================================================
     SUBSTATION GPS LOCATION CARD
========================================================== -->

<div class="substation-gps-card">

    <div class="substation-gps-header">

        <div class="substation-gps-icon">
            <span>⌖</span>
        </div>

        <div class="substation-gps-heading">
            <h3>GPS Location</h3>
            <p>Exact geographical position</p>
        </div>

    </div>


    <% if (
        substation &&
        substation.gps &&
        substation.gps.latitude !== null &&
        substation.gps.latitude !== undefined &&
        substation.gps.longitude !== null &&
        substation.gps.longitude !== undefined
    ) { %>

        <div class="substation-gps-coordinates">

            <div class="substation-gps-coordinate">

                <span class="substation-gps-label">
                    Latitude
                </span>

                <strong>
                    <%= Number(substation.gps.latitude).toFixed(6) %>
                </strong>

            </div>


            <div class="substation-gps-coordinate">

                <span class="substation-gps-label">
                    Longitude
                </span>

                <strong>
                    <%= Number(substation.gps.longitude).toFixed(6) %>
                </strong>

            </div>

        </div>


        <div class="substation-gps-location">

            <span class="substation-gps-location-dot"></span>

            <div>
                <span class="substation-gps-location-title">
                    Substation Location
                </span>

                <span class="substation-gps-location-name">
                    <%= substation.name %>
                </span>
            </div>

        </div>


        <a
            class="substation-gps-directions"
            href="https://www.google.com/maps/dir/?api=1&destination=<%= substation.gps.latitude %>,<%= substation.gps.longitude %>"
            target="_blank"
            rel="noopener noreferrer"
        >
            <span class="substation-gps-directions-icon">↗</span>
            <span>Get Directions</span>
        </a>


        <div class="substation-gps-coordinates-copy">
            <span>
                <%= substation.gps.latitude %>, <%= substation.gps.longitude %>
            </span>
        </div>

    <% } else { %>

        <div class="substation-gps-empty">

            <div class="substation-gps-empty-icon">
                ⌖
            </div>

            <h4>GPS location not available</h4>

            <p>
                Coordinates have not been added for this substation yet.
            </p>

        </div>

    <% } %>

</div>