<%
/* ==========================================================
   VERRAH COSMETICS
   REUSABLE SUBSTATION PRODUCT SEARCH COMPONENT

   ----------------------------------------------------------
   BEHAVIOUR:

   - Accepts the current substation
   - Accepts the current search query
   - Searches by product name or category
   - Opens:

       /substations/:id/search?q=SEARCH_TERM

   ----------------------------------------------------------
   EXPECTED LOCALS:

   substation
   query
========================================================== */


const searchComponentSubstation =
  typeof substation !== "undefined"
    ? substation
    : null;


const searchComponentQuery =
  typeof query !== "undefined"
    ? String(query || "").trim()
    : "";


const searchComponentSubstationId =
  searchComponentSubstation &&
  searchComponentSubstation._id
    ? searchComponentSubstation._id
    : null;


const searchComponentAction =
  searchComponentSubstationId
    ? `/substations/${searchComponentSubstationId}/search`
    : "";
%>


<!-- ========================================================
     SEARCH COMPOSER
========================================================= -->

<form
  action="<%= searchComponentAction %>"
  method="GET"
  class="products-search-composer"
  role="search"
  aria-label="Search products"
>


  <!-- ======================================================
       SEARCH ICON
  ======================================================= -->

  <span
    class="products-search-composer-icon"
    aria-hidden="true"
  >

    <i class="fas fa-search"></i>

  </span>



  <!-- ======================================================
       SEARCH INPUT
  ======================================================= -->

  <input
    type="search"
    name="q"
    class="products-search-composer-input"
    placeholder="Search products or categories..."
    aria-label="Search products or categories"
    autocomplete="off"
    value="<%= searchComponentQuery %>"
    required
  >



  <!-- ======================================================
       SEARCH ACTION
  ======================================================= -->

  <button
    type="submit"
    class="products-search-composer-action"
    aria-label="Search"
    title="Search"
  >

    <i
      class="fas fa-arrow-right"
      aria-hidden="true"
    ></i>

  </button>


</form>