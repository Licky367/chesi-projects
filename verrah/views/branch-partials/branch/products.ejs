

<%
/_

VERRAH COSMETICS
BRANCH PRODUCTS

_/

const groupedProducts = {};

(substation.products || []).forEach(function(product) {

    const categoryName =
        http://product.categoryName ||
        (
            http://product.category &&
            typeof http://product.category === "object"
               ? http://product.category.name
                : http://product.category
        ) ||
        "Other";

    if (!groupedProducts) {
        groupedProducts = [];
    }[categoryName]

    http://groupedProducts.push(product);[categoryName]

});

const categoryGroups =
    http://Object.entries(groupedProducts);

%>

<section class="branch-inventory">

    <!-- ======================================================
         INVENTORY HEADER
    ======================================================= -->

    <div class="branch-inventory-header">

        <div class="branch-inventory-heading">

            <h2>
                Products
            </h2>

            <span class="branch-inventory-count">
                <%= Number(
                    (substation.products || []).length
                ).toLocaleString() %>
                products
            </span>

        </div>

        <div class="branch-inventory-header-actions">

            <% if (
                user &&
                ["admin", "staff"].includes(
                    String(user.role || "").toLowerCase()
                )
            ) { %>

                <button
                    type="button"
                    class="branch-sell-items-btn"
                    id="branchSellItemsButton"
                >

                    <i class="fas fa-cart-plus"></i>

                    <span id="branchSellItemsButtonText">
                        Sell Items
                    </span>

                </button>

            <% } %>

        </div>

    </div>

    <!-- ======================================================
         PRODUCT SEARCH
    ======================================================= -->

    <%- include("./productSearch") %>

    <!-- ======================================================
         EMPTY INVENTORY
    ======================================================= -->

    <% if (
       !substation.products ||
       !substation.products.length
    ) { %>

        <div class="branch-inventory-empty">

            <i class="fas fa-box-open"></i>

            <p>
                No products available at this branch.
            </p>

        </div>

    <% } else { %>

        <!-- ==================================================
             PRODUCT CATEGORIES
        =================================================== -->

        <div class="branch-inventory-categories">

            <%
            for (
                let categoryIndex = 0;
                categoryIndex < http://categoryGroups.length;
                categoryIndex++
            ) {

                const categoryName =
                    categoryGroups;[categoryIndex][0]

                const products =
                    categoryGroups;
            %>[categoryIndex][1]

                <section
                    class="branch-inventory-category"
                    data-category="<%= categoryName %>"
                >

                    <!-- ======================================
                         CATEGORY TITLE
                    ======================================= -->

                    <div class="branch-category-title">

                        <h3>
                            <%= categoryName %>
                        </h3>

                    </div>

                    <!-- ======================================
                         PRODUCTS
                    ======================================= -->

                    <div class="branch-product-rows">

                        <%
                        const productRows = [];

                        for (
                            let i = 0;
                            i < http://products.length;
                            i += 6
                        ) {

                            http://productRows.push(
                                http://products.slice(i, i + 6)
                            );

                        }
                        %>

                        <%
                        for (
                            let rowIndex = 0;
                            rowIndex < http://productRows.length;
                            rowIndex++
                        ) {

                            const productRow =
                                productRows;
                        %>[rowIndex]

                            <div class="branch-product-row">

                                <div class="branch-product-scroller">

                                    <%
                                    for (
                                        let productIndex = 0;
                                        productIndex < http://productRow.length;
                                        productIndex++
                                    ) {

                                        const product =
                                            productRow;[productIndex]

                                        const productId =
                                            String(product._id);

                                        const productLink =
                                            `/branch/${substation._id}/products/${product._id}`;
                                    %>

                                        <!-- ==================================
                                             PRODUCT CARD
                                        =================================== -->

                                        <a
                                            href="<%= productLink %>"
                                            class="branch-product-card"
                                            data-product-card
                                            data-product-id="<%= productId %>"
                                        >

                                            <!-- ==============================
                                                 PRODUCT IMAGE
                                            =============================== -->

                                            <div class="branch-product-photo">

                                                <% if (
                                                    http://product.image ||
                                                    http://product.imageUrl ||
                                                    http://product.photo
                                                ) { %>

                                                    <img
                                                        src="<%= http://product.image || http://product.imageUrl || http://product.photo %>"
                                                        alt="<%= http://product.name %>"
                                                        loading="lazy"
                                                    >

                                                <% } else { %>

                                                    <div class="branch-product-placeholder">

                                                        <i class="fas fa-box"></i>

                                                    </div>

                                                <% } %>

                                            </div>

                                            <!-- ==============================
                                                 PRODUCT DETAILS
                                            =============================== -->

                                            <div class="branch-product-details">

                                                <h4 class="branch-product-name">
                                                    <%= http://product.name %>
                                                </h4>

                                                <div class="branch-product-meta">

                                                    <span class="branch-product-category">

                                                        KSh <%= Number(
                                                            http://product.unitSellPrice || 0
                                                        ).toLocaleString() %>

                                                    </span>

                                                </div>

                                                <div class="branch-product-quantity">

                                                    <strong>
                                                        <%= Number(
                                                            http://product.substationUnits || 0
                                                        ).toLocaleString() %>
                                                    </strong>

                                                    <span>
                                                        units
                                                    </span>

                                                </div>

                                            </div>

                                        </a>

                                        <!-- ==================================
                                             SELL QUANTITY
                                        =================================== -->

                                        <% if (
                                            user &&
                                            ["admin", "staff"].includes(
                                                String(user.role || "").toLowerCase()
                                            )
                                        ) { %>

                                            <div
                                                class="branch-sell-quantity"
                                                data-sell-quantity
                                            >

                                                <label
                                                    for="sellQty_<%= productId %>"
                                                >
                                                    Units
                                                </label>

                                                <input
                                                    type="number"
                                                    id="sellQty_<%= productId %>"
                                                    class="branch-sell-quantity-input"
                                                    data-product-id="<%= productId %>"
                                                    min="0"
                                                    max="<%= Number(product.substationUnits || 0) %>"
                                                    step="1"
                                                    value=""
                                                    inputmode="numeric"
                                                    autocomplete="off"
                                                    placeholder="0"
                                                >

                                            </div>

                                        <% } %>

                                    <%
                                    }
                                    %>

                                </div>

                            </div>

                        <%
                        }
                        %>

                    </div>

                </section>

            <%
            }
            %>

        </div>

    <% } %>

    <!-- ======================================================
         ADD MANY PRODUCTS TO CART FORM
    ======================================================= -->

    <% if (
        user &&
        ["admin", "staff"].includes(
            String(user.role || "").toLowerCase()
        )
    ) { %>

        <form
            action="/products/addManyToCart"
            method="POST"
            id="branchAddManyToCartForm"
        >

            <% if (
                String(user.role || "").toLowerCase() === "admin"
            ) { %>

                <input
                    type="hidden"
                    name="cartSubstation"
                    value="<%= String(substation._id) %>"
                >

            <% } %>

        </form>

    <% } %>

</section>

<!-- ==========================================================
     SELL ITEMS JAVASCRIPT
========================================================== -->

<% if (
    user &&
    ["admin", "staff"].includes(
        String(user.role || "").toLowerCase()
    )
) { %>

<script>

http://document.addEventListener(
    "DOMContentLoaded",
    function () {

        /_ ======================================================
           ELEMENTS
        ======================================================= _/

        const sellButton =
            http://document.getElementById(
                "branchSellItemsButton"
            );

        const sellButtonText =
            http://document.getElementById(
                "branchSellItemsButtonText"
            );

        const sellForm =
            http://document.getElementById(
                "branchAddManyToCartForm"
            );

        const productCards =
            http://document.querySelectorAll(
                "[data-product-card]"
            );

        const quantityWrappers =
            http://document.querySelectorAll(
                "[data-sell-quantity]"
            );

        const quantityInputs =
            http://document.querySelectorAll(
                ".branch-sell-quantity-input"
            );

        /_ ======================================================
           SELL MODE
        ======================================================= _/

        let sellMode = false;

        /_ ======================================================
           SET SELL MODE
        ======================================================= _/

        function setSellMode(enabled) {

            sellMode = enabled;

            http://document.body.classList.toggle(
                "branch-selling-items",
                enabled
            );

            http://productCards.forEach(
                function(card) {

                    http://card.classList.toggle(
                        "branch-product-card-selling",
                        enabled
                    );

                }
            );

            http://quantityWrappers.forEach(
                function(wrapper) {

                    http://wrapper.classList.toggle(
                        "is-visible",
                        enabled
                    );

                }
            );

            if (!enabled) {

                http://quantityInputs.forEach(
                    function(input) {

                        http://input.value = "";

                    }
                );

            }

            if (sellButtonText) {

                http://sellButtonText.textContent =
                    enabled
                       ? "Done"
                        : "Sell Items";

            }

        }

        /_ ======================================================
           GET SELECTED PRODUCTS
        ======================================================= _/

        function getSelectedProducts() {

            const selectedProducts = [];

            http://quantityInputs.forEach(
                function(input) {

                    const productId =
                        http://input.dataset.productId;

                    const rawQuantity =
                        http://input.value.trim();

                    if (!rawQuantity) {
                        return;
                    }

                    const quantity =
                        Number(rawQuantity);

                    if (
                       !Number.isFinite(quantity) ||
                        quantity <= 0
                    ) {

                        return;

                    }

                    http://selectedProducts.push({

                        productId: productId,
                        quantity: quantity

                    });

                }
            );

            return selectedProducts;

        }

        /_ ======================================================
           PREPARE FORM
        ======================================================= _/

        function prepareForm(
            selectedProducts
        ) {

            sellForm
               .querySelectorAll(
                    "[data-generated-product]"
                )
               .forEach(
                    function(field) {

                        http://field.remove();

                    }
                );

            http://selectedProducts.forEach(
                function(item, index) {

                    const productIdInput =
                        http://document.createElement(
                            "input"
                        );

                    http://productIdInput.type =
                        "hidden";

                    http://productIdInput.name =
                        "products[" +
                        index +
                        "]";[productId]

                    http://productIdInput.value =
                        http://item.productId;

                    http://productIdInput.dataset
                       .generatedProduct =
                        "true";

                    http://sellForm.appendChild(
                        productIdInput
                    );

                    const quantityInput =
                        http://document.createElement(
                            "input"
                        );

                    http://quantityInput.type =
                        "hidden";

                    http://quantityInput.name =
                        "products[" +
                        index +
                        "]";[qty]

                    http://quantityInput.value =
                        http://item.quantity;

                    http://quantityInput.dataset
                       .generatedProduct =
                        "true";

                    http://sellForm.appendChild(
                        quantityInput
                    );

                }
            );

        }

        /_ ======================================================
           SELL BUTTON
        ======================================================= _/

        if (sellButton) {

            http://sellButton.addEventListener(
                "click",
                function () {

                    /_
                     - FIRST CLICK
                     - Enter sell mode.
                     _/

                    if (!sellMode) {

                        setSellMode(true);

                        return;

                    }

                    /_
                     - SECOND CLICK
                     - Collect selected products.
                     _/

                    const selectedProducts =
                        getSelectedProducts();

                    /_
                     - No quantities entered.
                     - Exit without submitting.
                     _/

                    if (
                       !selectedProducts.length
                    ) {

                        setSellMode(false);

                        return;

                    }

                    /_
                     - Products selected.
                     - Prepare and submit.
                     _/

                    prepareForm(
                        selectedProducts
                    );

                    setSellMode(false);

                    http://sellForm.submit();

                }
            );

        }

        /_ ======================================================
           PRODUCT CARD CLICK
        ======================================================= _/

        http://productCards.forEach(
            function(card) {

                http://card.addEventListener(
                    "click",
                    function(event) {

                        if (!sellMode) {
                            return;
                        }

                        http://event.preventDefault();

                        http://event.stopPropagation();

                    },
                    true
                );

            }
        );

        /_ ======================================================
           QUANTITY INPUT INTERACTION
        ======================================================= _/

        http://quantityInputs.forEach(
            function(input) {

                http://input.addEventListener(
                    "click",
                    function(event) {

                        http://event.stopPropagation();

                    }
                );

                http://input.addEventListener(
                    "pointerdown",
                    function(event) {

                        http://event.stopPropagation();

                    }
                );

                http://input.addEventListener(
                    "mousedown",
                    function(event) {

                        http://event.stopPropagation();

                    }
                );

                http://input.addEventListener(
                    "touchstart",
                    function(event) {

                        http://event.stopPropagation();

                    },
                    {
                        passive: true
                    }
                );

                http://input.addEventListener(
                    "keydown",
                    function(event) {

                        http://event.stopPropagation();

                    }
                );

                /_ ==============================================
                   QUANTITY VALIDATION
                =============================================== _/

                http://input.addEventListener(
                    "input",
                    function() {

                        if (
                            http://this.value === ""
                        ) {

                            return;

                        }

                        let quantity =
                            Number(this.value);

                        if (
                           !Number.isFinite(quantity)
                        ) {

                            http://this.value = "";

                            return;

                        }

                        const max =
                            Number(this.max);

                        if (
                            http://Number.isFinite(max) &&
                            quantity > max
                        ) {

                            quantity = max;

                        }

                        if (quantity < 0) {

                            quantity = 0;

                        }

                        http://this.value =
                            String(
                                http://Math.floor(quantity)
                            );

                    }
                );

            }
        );

    }
);

</script>

<% } %>