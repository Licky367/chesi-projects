<!-- ==========================================================
   views/branch-partials/branch/products.ejs

   VERRAH COSMETICS
   SUBSTATION PRODUCTS / INVENTORY

   ----------------------------------------------------------
   BEHAVIOUR:

   - Products grouped by category
   - Each category has its own rows
   - Maximum 6 products per row
   - 7th product starts a new row
   - Each row scrolls horizontally
   - Product card: 112px × 155px
   - All roles:
       /branch/:substationId/products/:productId

   ----------------------------------------------------------
   SELL ITEMS:

   - Admin and staff can sell multiple products
   - First "Sell Items" tap enables quantity inputs
   - Product cards become completely non-clickable
   - User can enter quantities for several products
   - Second "Sell Items" tap:
       1. Collects entered quantities
       2. Adds them to the form
       3. Closes quantity inputs
       4. Makes cards clickable again
       5. Submits to /products/addManyToCart

   - Admin also submits:
       cartSubstation = substation._id

========================================================== -->


<div class="branch-inventory">


  <!-- ========================================================
       INVENTORY HEADER
  ========================================================= -->

  <div class="branch-inventory-header">

    <div class="branch-inventory-heading">

      <h2>
        Products in this Substation
      </h2>

    </div>


    <div class="branch-inventory-header-actions">

      <span class="branch-inventory-count">

        <%= substation.products
          ? substation.products.length
          : 0 %>

      </span>


      <% if (
        user &&
        ["admin", "staff"].includes(
          String(user.role || "").toLowerCase()
        )
      ) { %>


        <!-- ==================================================
             SELL ITEMS BUTTON
        =================================================== -->

        <button
          type="button"
          class="branch-sell-items-btn"
          id="branchSellItemsButton"
        >

          <i class="fas fa-cart-plus"></i>

          <span id="branchSellItemsButtonText">
            Sell Items
          </span>

        </button>


      <% } %>

    </div>

  </div>


  <!-- ========================================================
       SEARCH PRODUCTS
  ========================================================= -->

  <%- include("./productSearch") %>


  <!-- ========================================================
       EMPTY INVENTORY
  ========================================================= -->

  <% if (
    !substation.products ||
    !substation.products.length
  ) { %>


    <div class="branch-inventory-empty">

      <div class="branch-inventory-empty-icon">

        <i class="fas fa-box-open"></i>

      </div>

      <h3>
        No products allocated
      </h3>

      <p>
        No products have been allocated to this substation yet.
      </p>

    </div>


  <% } else { %>


    <!-- ======================================================
         SELL ITEMS FORM

         This form is intentionally separate from the
         product-card links.

         Product quantities are copied into this form by
         JavaScript before submission.
    ======================================================= -->

    <% if (
      user &&
      ["admin", "staff"].includes(
        String(user.role || "").toLowerCase()
      )
    ) { %>


      <form
        action="/products/addManyToCart"
        method="POST"
        id="branchAddManyToCartForm"
      >

        <% if (
          String(user.role || "").toLowerCase() === "admin"
        ) { %>

          <input
            type="hidden"
            name="cartSubstation"
            value="<%= substation._id %>"
          >

        <% } %>

      </form>


    <% } %>


    <!-- ======================================================
         GROUP PRODUCTS BY CATEGORY
    =================================================== -->

    <%
      const groupedProducts = {};

      substation.products.forEach((product) => {

        const categoryName =
          product.categoryName ||
          (
            product.category &&
            typeof product.category === "object"
              ? product.category.name
              : product.category
          ) ||
          "Other";


        if (!groupedProducts[categoryName]) {

          groupedProducts[categoryName] = [];

        }


        groupedProducts[categoryName].push(product);

      });


      const categoryGroups =
        Object.entries(groupedProducts);
    %>


    <!-- ======================================================
         CATEGORY GROUPS
    ====================================================== -->

    <div class="branch-inventory-categories">


      <% categoryGroups.forEach(
        ([categoryName, products]) => {
      %>


        <%
          /*
           * Divide products belonging to this category
           * into rows of six.
           */

          const productRows = [];

          for (
            let i = 0;
            i < products.length;
            i += 6
          ) {

            productRows.push(
              products.slice(i, i + 6)
            );

          }
        %>


        <!-- ==================================================
             CATEGORY
        ================================================== -->

        <section class="branch-inventory-category">


          <!-- ================================================
               CATEGORY TITLE
          ================================================= -->

          <div class="branch-category-title">

            <h3>
              <%= categoryName %>
            </h3>

          </div>


          <!-- ================================================
               CATEGORY PRODUCT ROWS
          ================================================= -->

          <div class="branch-product-rows">


            <% productRows.forEach(
              (rowProducts) => {
            %>


              <!-- ============================================
                   HORIZONTAL PRODUCT ROW
              ============================================= -->

              <div class="branch-product-row">


                <div class="branch-product-scroller">


                  <% rowProducts.forEach((product) => { %>


                    <%
                      /*
                       * All users use the normal product page.
                       */

                      const productLink =
                        `/branch/${substation._id}/products/${product._id}`;


                      /*
                       * Resolve category name.
                       */

                      const productCategory =
                        product.categoryName ||
                        (
                          product.category &&
                          typeof product.category === "object"
                            ? product.category.name
                            : product.category
                        ) ||
                        categoryName ||
                        "Other";


                      /*
                       * Resolve subcategory name.
                       */

                      const productSubcategory =
                        product.subcategoryName ||
                        (
                          product.subcategory &&
                          typeof product.subcategory === "object"
                            ? product.subcategory.name
                            : product.subcategory
                        ) ||
                        "Other";


                      /*
                       * Product ID used by the add-many
                       * cart form.
                       */

                      const productId =
                        String(product._id);
                    %>


                    <!-- ======================================
                         PRODUCT CARD
                    ======================================= -->

                    <a
                      href="<%= productLink %>"
                      class="branch-product-card"
                      data-product-card
                      data-product-id="<%= productId %>"
                    >


                      <!-- ==================================
                           PRODUCT IMAGE
                      =================================== -->

                      <div class="branch-product-photo">


                        <% if (product.image) { %>

                          <img
                            src="<%= product.image %>"
                            alt="<%= product.name %>"
                            loading="lazy"
                          >

                        <% } else { %>

                          <span class="branch-product-placeholder">

                            <i class="fas fa-box"></i>

                          </span>

                        <% } %>


                      </div>


                      <!-- ==================================
                           PRODUCT DETAILS
                      =================================== -->

                      <div class="branch-product-details">


                        <!-- =================================
                             PRODUCT NAME
                        ================================== -->

                        <h4 class="branch-product-name">

                          <%= product.name %>

                        </h4>


                        <!-- =================================
                             CATEGORY / SUBCATEGORY
                        ================================== -->

                        <div class="branch-product-meta">

                          <span class="branch-product-category">

                            <%= productCategory %>

                          </span>


                          <span class="branch-product-separator">
                            •
                          </span>


                          <span class="branch-product-subcategory">

                            <%= productSubcategory %>

                          </span>

                        </div>


                        <!-- =================================
                             STOCK
                        ================================== -->

                        <div class="branch-product-quantity">

                          <strong>

                            <%= Number(
                              product.substationUnits || 0
                            ).toLocaleString() %>

                          </strong>

                          <span>
                            units
                          </span>

                        </div>


                        <!-- =================================
                             SELL QUANTITY INPUT
                        ================================== -->

                        <% if (
                          user &&
                          ["admin", "staff"].includes(
                            String(user.role || "").toLowerCase()
                          )
                        ) { %>


                          <div
                            class="branch-sell-quantity"
                            data-sell-quantity
                          >

                            <label
                              for="sellQty_<%= productId %>"
                            >
                              Units
                            </label>


                            <input
                              type="number"
                              id="sellQty_<%= productId %>"
                              class="branch-sell-quantity-input"
                              data-product-id="<%= productId %>"
                              min="0"
                              max="<%= Number(product.substationUnits || 0) %>"
                              step="1"
                              value=""
                              inputmode="numeric"
                              autocomplete="off"
                              placeholder="0"
                            >

                          </div>


                        <% } %>


                      </div>


                    </a>


                  <% }) %>


                </div>


              </div>


            <% }) %>


          </div>


        </section>


      <% }) %>


    </div>


  <% } %>


</div>


<!-- ==========================================================
     SELL ITEMS JAVASCRIPT
========================================================== -->

<% if (
  user &&
  ["admin", "staff"].includes(
    String(user.role || "").toLowerCase()
  ) &&
  substation.products &&
  substation.products.length
) { %>


<script>

(function () {

    "use strict";


    /* ======================================================
       ELEMENTS
    ====================================================== */

    const sellButton =
        document.getElementById(
            "branchSellItemsButton"
        );


    const sellButtonText =
        document.getElementById(
            "branchSellItemsButtonText"
        );


    const sellForm =
        document.getElementById(
            "branchAddManyToCartForm"
        );


    const productCards =
        document.querySelectorAll(
            "[data-product-card]"
        );


    const quantityWrappers =
        document.querySelectorAll(
            "[data-sell-quantity]"
        );


    const quantityInputs =
        document.querySelectorAll(
            ".branch-sell-quantity-input"
        );


    if (
        !sellButton ||
        !sellButtonText ||
        !sellForm
    ) {

        return;

    }


    let sellMode = false;


    /* ======================================================
       ENTER / EXIT SELL MODE
    ====================================================== */

    function setSellMode(enabled) {

        sellMode = enabled;


        document.body.classList.toggle(
            "branch-selling-items",
            enabled
        );


        productCards.forEach(
            function (card) {

                card.classList.toggle(
                    "branch-product-card-selling",
                    enabled
                );

            }
        );


        quantityWrappers.forEach(
            function (wrapper) {

                wrapper.classList.toggle(
                    "is-visible",
                    enabled
                );

            }
        );


        sellButton.classList.toggle(
            "is-selling",
            enabled
        );


        sellButtonText.textContent =
            "Sell Items";


        /*
         * When leaving sell mode manually,
         * clear the visible quantity inputs.
         */

        if (!enabled) {

            quantityInputs.forEach(
                function (input) {

                    input.value = "";

                }
            );

        }

    }


    /* ======================================================
       COMPLETELY BLOCK PRODUCT CARDS WHILE SELLING
    ======================================================

       This listener runs during the capture phase.

       Therefore, when sellMode is true, clicking anywhere
       on the product card cannot activate its <a> link.

       The quantity input is explicitly allowed through.
    ====================================================== */

    productCards.forEach(
        function (card) {

            card.addEventListener(
                "click",
                function (event) {

                    if (!sellMode) {

                        return;

                    }


                    /*
                     * Quantity input must remain clickable.
                     */

                    if (
                        event.target.closest(
                            ".branch-sell-quantity-input"
                        )
                    ) {

                        return;

                    }


                    event.preventDefault();

                    event.stopPropagation();

                },
                true
            );


            /*
             * Also block pointer activation while
             * sell mode is active.
             */

            card.addEventListener(
                "pointerup",
                function (event) {

                    if (!sellMode) {

                        return;

                    }


                    if (
                        event.target.closest(
                            ".branch-sell-quantity-input"
                        )
                    ) {

                        return;

                    }


                    event.preventDefault();

                    event.stopPropagation();

                },
                true
            );

        }
    );


    /* ======================================================
       QUANTITY INPUTS
    ====================================================== */

    quantityInputs.forEach(
        function (input) {


            /*
             * Do not allow the input click to reach
             * the product card.
             */

            input.addEventListener(
                "click",
                function (event) {

                    event.stopPropagation();

                }
            );


            input.addEventListener(
                "pointerdown",
                function (event) {

                    event.stopPropagation();

                }
            );


            input.addEventListener(
                "pointerup",
                function (event) {

                    event.stopPropagation();

                }
            );


            input.addEventListener(
                "keydown",
                function (event) {

                    event.stopPropagation();

                }
            );


            /*
             * Keep quantities within the available
             * substation stock.
             */

            input.addEventListener(
                "input",
                function () {

                    const max =
                        Number(
                            input.max || 0
                        );


                    let value =
                        Number(
                            input.value
                        );


                    if (
                        Number.isNaN(value) ||
                        value < 0
                    ) {

                        input.value = "";

                        return;

                    }


                    if (
                        max > 0 &&
                        value > max
                    ) {

                        input.value =
                            String(max);

                    }

                }
            );

        }
    );


    /* ======================================================
       COLLECT SELECTED PRODUCTS
    ====================================================== */

    function getSelectedProducts() {

        const selectedProducts = [];


        quantityInputs.forEach(
            function (input) {

                const productId =
                    String(
                        input.dataset.productId || ""
                    ).trim();


                const quantity =
                    Number(
                        input.value
                    );


                if (
                    !productId ||
                    !Number.isFinite(quantity) ||
                    quantity <= 0
                ) {

                    return;

                }


                selectedProducts.push({

                    productId,

                    quantity

                });

            }
        );


        return selectedProducts;

    }


    /* ======================================================
       SUBMIT SELECTED PRODUCTS
    ====================================================== */

    function submitSelectedProducts() {

        /*
         * Collect everything before changing
         * the interface.
         */

        const selectedProducts =
            getSelectedProducts();


        /*
         * Nothing selected.
         *
         * Keep sell mode active so the user can
         * enter quantities.
         */

        if (!selectedProducts.length) {

            alert(
                "Enter the number of units for at least one product."
            );

            return;

        }


        /*
         * Remove previously generated product fields.
         */

        sellForm
            .querySelectorAll(
                "[data-generated-product]"
            )
            .forEach(
                function (field) {

                    field.remove();

                }
            );


        /*
         * Build:

         * products[0][productId]
         * products[0][qty]

         * products[1][productId]
         * products[1][qty]

         * etc.
         */

        selectedProducts.forEach(
            function (item, index) {


                const productIdInput =
                    document.createElement(
                        "input"
                    );


                productIdInput.type =
                    "hidden";


                productIdInput.name =
                    `products[${index}][productId]`;


                productIdInput.value =
                    item.productId;


                productIdInput.dataset.generatedProduct =
                    "true";


                const quantityInput =
                    document.createElement(
                        "input"
                    );


                quantityInput.type =
                    "hidden";


                quantityInput.name =
                    `products[${index}][qty]`;


                quantityInput.value =
                    String(item.quantity);


                quantityInput.dataset.generatedProduct =
                    "true";


                sellForm.appendChild(
                    productIdInput
                );


                sellForm.appendChild(
                    quantityInput
                );

            }
        );


        /*
         * Close sell mode BEFORE submitting.
         *
         * This:
         *
         * - hides quantity inputs
         * - removes selling card state
         * - makes product cards clickable again
         */

        setSellMode(false);


        /*
         * Submit to:
         *
         * /products/addManyToCart
         */

        sellForm.submit();

    }


    /* ======================================================
       SELL BUTTON
    ======================================================

       FIRST TAP:
           Enable sell mode.

       SECOND TAP:
           Submit selected products.
    ====================================================== */

    sellButton.addEventListener(
        "click",
        function (event) {

            event.preventDefault();

            event.stopPropagation();


            if (!sellMode) {

                setSellMode(true);

                return;

            }


            submitSelectedProducts();

        }
    );


})();

</script>


<% } %>