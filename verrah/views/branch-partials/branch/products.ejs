<%
/*
==========================================================
VERRAH COSMETICS
BRANCH PRODUCTS

Displays products belonging to the current substation.

Product card:
- Product image
- Product name
- Unit selling price
- Available units

Admin / Staff:
- Can activate Sell Items mode
- Can enter quantities for multiple products
- Can submit selected products to /products/addManyToCart

Admin:
- Sends the parent branch/substation ID as cartSubstation

Staff:
- Does not send cartSubstation
==========================================================
*/


/* ==========================================================
   GROUP PRODUCTS BY CATEGORY
========================================================== */

const groupedProducts = {};

(substation.products || []).forEach(product => {

    const categoryName =
        product.categoryName ||
        (
            product.category &&
            typeof product.category === "object"
                ? product.category.name
                : product.category
        ) ||
        "Other";


    if (!groupedProducts[categoryName]) {
        groupedProducts[categoryName] = [];
    }

    groupedProducts[categoryName].push(product);

});


const categoryGroups =
    Object.entries(groupedProducts);

%>


<section class="branch-inventory">


    <!-- ======================================================
         INVENTORY HEADER
    ======================================================= -->

    <div class="branch-inventory-header">


        <div class="branch-inventory-heading">

            <h2>
                Products
            </h2>

            <span class="branch-inventory-count">
                <%= Number(
                    (substation.products || []).length
                ).toLocaleString() %>
                products
            </span>

        </div>


        <!-- ==================================================
             HEADER ACTIONS
        =================================================== -->

        <div class="branch-inventory-header-actions">

            <% if (
                user &&
                ["admin", "staff"].includes(
                    String(user.role || "").toLowerCase()
                )
            ) { %>


                <button
                    type="button"
                    class="branch-sell-items-btn"
                    id="branchSellItemsButton"
                >

                    <i class="fas fa-cart-plus"></i>

                    <span id="branchSellItemsButtonText">
                        Sell Items
                    </span>

                </button>


            <% } %>

        </div>

    </div>



    <!-- ======================================================
         PRODUCT SEARCH
    ======================================================= -->

    <%- include("./productSearch") %>



    <!-- ======================================================
         EMPTY INVENTORY
    ======================================================= -->

    <% if (
        !substation.products ||
        !substation.products.length
    ) { %>


        <div class="branch-inventory-empty">

            <i class="fas fa-box-open"></i>

            <p>
                No products available at this branch.
            </p>

        </div>


    <% } else { %>



        <!-- ==================================================
             PRODUCT CATEGORIES
        =================================================== -->

        <div class="branch-inventory-categories">


            <% categoryGroups.forEach(
                ([categoryName, products])
            => { %>


                <section
                    class="branch-inventory-category"
                    data-category="<%= categoryName %>"
                >


                    <!-- ======================================
                         CATEGORY TITLE
                    ======================================= -->

                    <div class="branch-category-title">

                        <h3>
                            <%= categoryName %>
                        </h3>

                    </div>



                    <!-- ======================================
                         PRODUCTS
                    ======================================= -->

                    <div class="branch-product-rows">


                        <%
                        const productRows = [];

                        for (
                            let i = 0;
                            i < products.length;
                            i += 6
                        ) {

                            productRows.push(
                                products.slice(i, i + 6)
                            );

                        }
                        %>


                        <% productRows.forEach(
                            productRow => { %>


                            <div class="branch-product-row">


                                <div class="branch-product-scroller">


                                    <% productRow.forEach(
                                        product => {

                                        const productId =
                                            String(product._id);

                                        const productLink =
                                            `/branch/${substation._id}/products/${product._id}`;

                                    %>


                                        <!-- ==================================
                                             PRODUCT CARD
                                        =================================== -->

                                        <a
                                            href="<%= productLink %>"
                                            class="branch-product-card"
                                            data-product-card
                                            data-product-id="<%= productId %>"
                                        >


                                            <!-- ==============================
                                                 PRODUCT IMAGE
                                            =============================== -->

                                            <div class="branch-product-photo">


                                                <% if (
                                                    product.image ||
                                                    product.imageUrl ||
                                                    product.photo
                                                ) { %>


                                                    <img
                                                        src="<%= product.image || product.imageUrl || product.photo %>"
                                                        alt="<%= product.name %>"
                                                        loading="lazy"
                                                    >


                                                <% } else { %>


                                                    <div class="branch-product-placeholder">

                                                        <i class="fas fa-box"></i>

                                                    </div>


                                                <% } %>


                                            </div>



                                            <!-- ==============================
                                                 PRODUCT DETAILS
                                            =============================== -->

                                            <div class="branch-product-details">


                                                <h4 class="branch-product-name">
                                                    <%= product.name %>
                                                </h4>


                                                <div class="branch-product-meta">


                                                    <span class="branch-product-category">

                                                        KSh <%= Number(
                                                            product.unitSellPrice || 0
                                                        ).toLocaleString() %>

                                                    </span>


                                                </div>


                                                <div class="branch-product-quantity">


                                                    <strong>
                                                        <%= Number(
                                                            product.substationUnits || 0
                                                        ).toLocaleString() %>
                                                    </strong>


                                                    <span>
                                                        units
                                                    </span>


                                                </div>


                                            </div>


                                        </a>



                                        <!-- ==================================
                                             SELL QUANTITY
                                        =================================== -->

                                        <% if (
                                            user &&
                                            ["admin", "staff"].includes(
                                                String(user.role || "").toLowerCase()
                                            )
                                        ) { %>


                                            <div
                                                class="branch-sell-quantity"
                                                data-sell-quantity
                                            >


                                                <label
                                                    for="sellQty_<%= productId %>"
                                                >
                                                    Units
                                                </label>


                                                <input
                                                    type="number"
                                                    id="sellQty_<%= productId %>"
                                                    class="branch-sell-quantity-input"
                                                    data-product-id="<%= productId %>"
                                                    min="0"
                                                    max="<%= Number(product.substationUnits || 0) %>"
                                                    step="1"
                                                    value=""
                                                    inputmode="numeric"
                                                    autocomplete="off"
                                                    placeholder="0"
                                                >


                                            </div>


                                        <% } %>


                                    <% }) %>


                                </div>


                            </div>


                        <% }) %>


                    </div>


                </section>


            <% }) %>


        </div>


    <% } %>



    <!-- ======================================================
         ADD MANY PRODUCTS TO CART FORM
    ======================================================= -->

    <% if (
        user &&
        ["admin", "staff"].includes(
            String(user.role || "").toLowerCase()
        )
    ) { %>


        <form
            action="/products/addManyToCart"
            method="POST"
            id="branchAddManyToCartForm"
        >


            <% if (
                String(user.role || "").toLowerCase() === "admin"
            ) { %>


                <input
                    type="hidden"
                    name="cartSubstation"
                    value="<%= String(substation._id) %>"
                >


            <% } %>


        </form>


    <% } %>


</section>



<!-- ==========================================================
     SELL ITEMS JAVASCRIPT
========================================================== -->

<% if (
    user &&
    ["admin", "staff"].includes(
        String(user.role || "").toLowerCase()
    )
) { %>


<script>

document.addEventListener(
    "DOMContentLoaded",
    function () {


        /* ======================================================
           ELEMENTS
        ======================================================= */

        const sellButton =
            document.getElementById(
                "branchSellItemsButton"
            );


        const sellButtonText =
            document.getElementById(
                "branchSellItemsButtonText"
            );


        const sellForm =
            document.getElementById(
                "branchAddManyToCartForm"
            );


        const productCards =
            document.querySelectorAll(
                "[data-product-card]"
            );


        const quantityWrappers =
            document.querySelectorAll(
                "[data-sell-quantity]"
            );


        const quantityInputs =
            document.querySelectorAll(
                ".branch-sell-quantity-input"
            );



        /* ======================================================
           SELL MODE
        ======================================================= */

        let sellMode = false;



        /* ======================================================
           SET SELL MODE
        ======================================================= */

        function setSellMode(enabled) {

            sellMode = enabled;


            document.body.classList.toggle(
                "branch-selling-items",
                enabled
            );


            productCards.forEach(card => {

                card.classList.toggle(
                    "branch-product-card-selling",
                    enabled
                );

            });


            quantityWrappers.forEach(wrapper => {

                wrapper.classList.toggle(
                    "is-visible",
                    enabled
                );

            });



            if (!enabled) {

                quantityInputs.forEach(input => {

                    input.value = "";

                });

            }



            if (sellButtonText) {

                sellButtonText.textContent =
                    enabled
                        ? "Done"
                        : "Sell Items";

            }

        }



        /* ======================================================
           GET SELECTED PRODUCTS
        ======================================================= */

        function getSelectedProducts() {

            const selectedProducts = [];


            quantityInputs.forEach(input => {

                const productId =
                    input.dataset.productId;


                const rawQuantity =
                    input.value.trim();


                if (!rawQuantity) {
                    return;
                }


                const quantity =
                    Number(rawQuantity);


                if (
                    !Number.isFinite(quantity) ||
                    quantity <= 0
                ) {
                    return;
                }


                selectedProducts.push({

                    productId,
                    quantity

                });

            });


            return selectedProducts;

        }



        /* ======================================================
           PREPARE FORM
        ======================================================= */

        function prepareForm(
            selectedProducts
        ) {


            /*
             * Remove only dynamically generated
             * product fields.
             *
             * cartSubstation remains untouched.
             */

            sellForm
                .querySelectorAll(
                    "[data-generated-product]"
                )
                .forEach(field => {

                    field.remove();

                });



            selectedProducts.forEach(
                (item, index) => {


                    const productIdInput =
                        document.createElement(
                            "input"
                        );


                    productIdInput.type =
                        "hidden";


                    productIdInput.name =
                        `products[${index}][productId]`;


                    productIdInput.value =
                        item.productId;


                    productIdInput.dataset
                        .generatedProduct =
                        "true";


                    sellForm.appendChild(
                        productIdInput
                    );



                    const quantityInput =
                        document.createElement(
                            "input"
                        );


                    quantityInput.type =
                        "hidden";


                    quantityInput.name =
                        `products[${index}][qty]`;


                    quantityInput.value =
                        item.quantity;


                    quantityInput.dataset
                        .generatedProduct =
                        "true";


                    sellForm.appendChild(
                        quantityInput
                    );

                });

        }



        /* ======================================================
           SELL BUTTON
        ======================================================= */

        if (sellButton) {


            sellButton.addEventListener(
                "click",
                function () {


                    /*
                     * First click:
                     * enter sell mode.
                     */

                    if (!sellMode) {

                        setSellMode(true);

                        return;

                    }



                    /*
                     * Second click:
                     * collect selected products.
                     */

                    const selectedProducts =
                        getSelectedProducts();



                    /*
                     * No quantities:
                     * simply exit sell mode.
                     *
                     * Nothing is submitted.
                     */

                    if (
                        !selectedProducts.length
                    ) {

                        setSellMode(false);

                        return;

                    }



                    /*
                     * Products selected:
                     * prepare and submit form.
                     */

                    prepareForm(
                        selectedProducts
                    );


                    setSellMode(false);


                    sellForm.submit();

                }
            );

        }



        /* ======================================================
           PRODUCT CARD CLICK
        ======================================================= */

        productCards.forEach(card => {


            card.addEventListener(
                "click",
                function (event) {


                    /*
                     * While selling, product cards
                     * must not navigate to their
                     * product pages.
                     */

                    if (!sellMode) {
                        return;
                    }


                    event.preventDefault();

                    event.stopPropagation();

                },
                true
            );

        });



        /* ======================================================
           QUANTITY INPUT INTERACTION
        ======================================================= */

        quantityInputs.forEach(input => {


            /*
             * Prevent input interaction from
             * triggering surrounding controls.
             */

            input.addEventListener(
                "click",
                function (event) {

                    event.stopPropagation();

                }
            );


            input.addEventListener(
                "pointerdown",
                function (event) {

                    event.stopPropagation();

                }
            );


            input.addEventListener(
                "mousedown",
                function (event) {

                    event.stopPropagation();

                }
            );


            input.addEventListener(
                "touchstart",
                function (event) {

                    event.stopPropagation();

                },
                {
                    passive: true
                }
            );


            input.addEventListener(
                "keydown",
                function (event) {

                    event.stopPropagation();

                }
            );



            /* ==================================================
               QUANTITY VALIDATION / CLAMPING
            =================================================== */

            input.addEventListener(
                "input",
                function () {


                    /*
                     * Allow empty input while
                     * the user is typing.
                     */

                    if (
                        this.value === ""
                    ) {

                        return;

                    }


                    let quantity =
                        Number(this.value);


                    if (
                        !Number.isFinite(quantity)
                    ) {

                        this.value = "";

                        return;

                    }


                    const max =
                        Number(this.max);


                    if (
                        Number.isFinite(max) &&
                        quantity > max
                    ) {

                        quantity = max;

                    }


                    if (quantity < 0) {

                        quantity = 0;

                    }


                    this.value =
                        String(
                            Math.floor(quantity)
                        );

                }
            );

        });


    }
);

</script>


<% } %>