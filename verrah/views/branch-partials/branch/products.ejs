<!-- ==========================================================
   views/branch-partials/branch/products.ejs

   VERRAH COSMETICS
   SUBSTATION PRODUCTS / INVENTORY

   ----------------------------------------------------------
   BEHAVIOUR:

   - Products grouped by category
   - Each category has its own rows
   - Maximum 6 products per row
   - 7th product starts a new row
   - Each row scrolls horizontally
   - Product card: 112px × 155px
   - All roles:
       /branch/:substationId/products/:productId

   ----------------------------------------------------------
   SELL ITEMS:

   - Admin and staff can sell multiple products
   - First "Sell Items" tap enables quantity inputs
   - Product cards cannot navigate while editing
   - Quantity inputs remain clickable/editable
   - Second "Sell Items" tap:
       WITH quantities:
           submit selected products
       WITHOUT quantities:
           exit sell mode only
   - After exiting/submitting:
       quantity inputs close
       cards become clickable again

   - Admin submits:
       cartSubstation = parent /branch/:id ID

========================================================== -->


<div class="branch-inventory">


  <!-- ========================================================
       INVENTORY HEADER
  ========================================================= -->

  <div class="branch-inventory-header">

    <div class="branch-inventory-heading">

      <h2>
        Products in this Substation
      </h2>

    </div>


    <div class="branch-inventory-header-actions">

      <span class="branch-inventory-count">

        <%= substation.products
          ? substation.products.length
          : 0 %>

      </span>


      <% if (
        user &&
        ["admin", "staff"].includes(
          String(user.role || "").toLowerCase()
        )
      ) { %>


        <button
          type="button"
          class="branch-sell-items-btn"
          id="branchSellItemsButton"
        >

          <i class="fas fa-cart-plus"></i>

          <span id="branchSellItemsButtonText">
            Sell Items
          </span>

        </button>


      <% } %>

    </div>

  </div>


  <!-- ========================================================
       SEARCH PRODUCTS
  ========================================================= -->

  <%- include("./productSearch") %>


  <!-- ========================================================
       EMPTY INVENTORY
  ========================================================= -->

  <% if (
    !substation.products ||
    !substation.products.length
  ) { %>


    <div class="branch-inventory-empty">

      <div class="branch-inventory-empty-icon">

        <i class="fas fa-box-open"></i>

      </div>

      <h3>
        No products allocated
      </h3>

      <p>
        No products have been allocated to this substation yet.
      </p>

    </div>


  <% } else { %>


    <!-- ======================================================
         SELL ITEMS FORM
    ====================================================== -->

    <% if (
      user &&
      ["admin", "staff"].includes(
        String(user.role || "").toLowerCase()
      )
    ) { %>


      <form
        action="/products/addManyToCart"
        method="POST"
        id="branchAddManyToCartForm"
      >

        <% if (
          String(user.role || "").toLowerCase() === "admin"
        ) { %>

          <%
            /*
             * The parent branch page is:

                 /branch/:id

             * Therefore use the :id from the current
             * parent URL.

             * Example:

                 /branch/68abc123/products

             * parentBranchId becomes:

                 68abc123
            */

            const parentBranchId =
              String(
                window.location.pathname
              )
              .split("/")
              .filter(Boolean)[1];
          %>

          <input
            type="hidden"
            name="cartSubstation"
            value="<%= parentBranchId %>"
          >

        <% } %>

      </form>


    <% } %>


    <!-- ======================================================
         GROUP PRODUCTS BY CATEGORY
    ====================================================== -->

    <%
      const groupedProducts = {};

      substation.products.forEach((product) => {

        const categoryName =
          product.categoryName ||
          (
            product.category &&
            typeof product.category === "object"
              ? product.category.name
              : product.category
          ) ||
          "Other";


        if (!groupedProducts[categoryName]) {

          groupedProducts[categoryName] = [];

        }


        groupedProducts[categoryName].push(product);

      });


      const categoryGroups =
        Object.entries(groupedProducts);
    %>


    <!-- ======================================================
         CATEGORY GROUPS
    ====================================================== -->

    <div class="branch-inventory-categories">


      <% categoryGroups.forEach(
        ([categoryName, products]) => {
      %>


        <%
          const productRows = [];

          for (
            let i = 0;
            i < products.length;
            i += 6
          ) {

            productRows.push(
              products.slice(i, i + 6)
            );

          }
        %>


        <section class="branch-inventory-category">


          <!-- ==================================================
               CATEGORY TITLE
          ================================================== -->

          <div class="branch-category-title">

            <h3>
              <%= categoryName %>
            </h3>

          </div>


          <!-- ==================================================
               PRODUCT ROWS
          ================================================== -->

          <div class="branch-product-rows">


            <% productRows.forEach(
              (rowProducts) => {
            %>


              <div class="branch-product-row">


                <div class="branch-product-scroller">


                  <% rowProducts.forEach((product) => { %>


                    <%
                      const productLink =
                        `/branch/${substation._id}/products/${product._id}`;


                      const productCategory =
                        product.categoryName ||
                        (
                          product.category &&
                          typeof product.category === "object"
                            ? product.category.name
                            : product.category
                        ) ||
                        categoryName ||
                        "Other";


                      const productSubcategory =
                        product.subcategoryName ||
                        (
                          product.subcategory &&
                          typeof product.subcategory === "object"
                            ? product.subcategory.name
                            : product.subcategory
                        ) ||
                        "Other";


                      const productId =
                        String(product._id);
                    %>


                    <!-- ======================================
                         PRODUCT CARD
                    ======================================= -->

                    <a
                      href="<%= productLink %>"
                      class="branch-product-card"
                      data-product-card
                      data-product-id="<%= productId %>"
                    >


                      <!-- ==================================
                           PRODUCT IMAGE
                      =================================== -->

                      <div class="branch-product-photo">

                        <% if (product.image) { %>

                          <img
                            src="<%= product.image %>"
                            alt="<%= product.name %>"
                            loading="lazy"
                          >

                        <% } else { %>

                          <span class="branch-product-placeholder">

                            <i class="fas fa-box"></i>

                          </span>

                        <% } %>

                      </div>


                      <!-- ==================================
                           PRODUCT DETAILS
                      =================================== -->

                      <div class="branch-product-details">


                        <h4 class="branch-product-name">

                          <%= product.name %>

                        </h4>


                        <div class="branch-product-meta">

                          <span class="branch-product-category">

                            <%= productCategory %>

                          </span>


                          <span class="branch-product-separator">
                            •
                          </span>


                          <span class="branch-product-subcategory">

                            <%= productSubcategory %>

                          </span>

                        </div>


                        <div class="branch-product-quantity">

                          <strong>

                            <%= Number(
                              product.substationUnits || 0
                            ).toLocaleString() %>

                          </strong>

                          <span>
                            units
                          </span>

                        </div>


                      </div>


                    </a>


                    <!-- ======================================
                         SELL QUANTITY

                         OUTSIDE THE PRODUCT LINK
                    ======================================= -->

                    <% if (
                      user &&
                      ["admin", "staff"].includes(
                        String(user.role || "").toLowerCase()
                      )
                    ) { %>


                      <div
                        class="branch-sell-quantity"
                        data-sell-quantity
                      >

                        <label
                          for="sellQty_<%= productId %>"
                        >
                          Units
                        </label>


                        <input
                          type="number"
                          id="sellQty_<%= productId %>"
                          class="branch-sell-quantity-input"
                          data-product-id="<%= productId %>"
                          min="0"
                          max="<%= Number(product.substationUnits || 0) %>"
                          step="1"
                          value=""
                          inputmode="numeric"
                          autocomplete="off"
                          placeholder="0"
                        >

                      </div>


                    <% } %>


                  <% }) %>


                </div>

              </div>


            <% }) %>


          </div>


        </section>


      <% }) %>


    </div>


  <% } %>


</div>


<!-- ==========================================================
     SELL ITEMS JAVASCRIPT
========================================================== -->

<% if (
  user &&
  ["admin", "staff"].includes(
    String(user.role || "").toLowerCase()
  ) &&
  substation.products &&
  substation.products.length
) { %>


<script>

(function () {

    "use strict";


    /* ======================================================
       GET PARENT /branch/:id ID
       
       The page is loaded under:

           /branch/:id/products

       or:

           /branch/:id/products/:productId

       Therefore the second URL segment is the parent
       branch/substation ID.
    ====================================================== */

    const pathParts =
        window.location.pathname
            .split("/")
            .filter(Boolean);


    const parentBranchId =
        String(
            pathParts[1] || ""
        ).trim();


    /* ======================================================
       ELEMENTS
    ====================================================== */

    const sellButton =
        document.getElementById(
            "branchSellItemsButton"
        );


    const sellForm =
        document.getElementById(
            "branchAddManyToCartForm"
        );


    const productCards =
        document.querySelectorAll(
            "[data-product-card]"
        );


    const quantityWrappers =
        document.querySelectorAll(
            "[data-sell-quantity]"
        );


    const quantityInputs =
        document.querySelectorAll(
            ".branch-sell-quantity-input"
        );


    if (
        !sellButton ||
        !sellForm
    ) {

        return;

    }


    let sellMode = false;


    /* ======================================================
       ENTER / EXIT SELL MODE
    ====================================================== */

    function setSellMode(enabled) {

        sellMode = enabled;


        document.body.classList.toggle(
            "branch-selling-items",
            enabled
        );


        productCards.forEach(
            function (card) {

                card.classList.toggle(
                    "branch-product-card-selling",
                    enabled
                );

            }
        );


        quantityWrappers.forEach(
            function (wrapper) {

                wrapper.classList.toggle(
                    "is-visible",
                    enabled
                );

            }
        );


        if (!enabled) {

            quantityInputs.forEach(
                function (input) {

                    input.value = "";

                }
            );

        }

    }


    /* ======================================================
       GET SELECTED PRODUCTS
    ====================================================== */

    function getSelectedProducts() {

        const selectedProducts = [];


        quantityInputs.forEach(
            function (input) {

                const productId =
                    String(
                        input.dataset.productId || ""
                    ).trim();


                const quantity =
                    Number(
                        input.value
                    );


                if (
                    !productId ||
                    !Number.isFinite(quantity) ||
                    quantity <= 0
                ) {

                    return;

                }


                selectedProducts.push({

                    productId: productId,

                    quantity: quantity

                });

            }
        );


        return selectedProducts;

    }


    /* ======================================================
       PREVENT PRODUCT NAVIGATION WHILE SELLING
    ====================================================== */

    productCards.forEach(
        function (card) {

            card.addEventListener(
                "click",
                function (event) {

                    if (!sellMode) {

                        return;

                    }


                    event.preventDefault();

                    event.stopPropagation();

                },
                true
            );

        }
    );


    /* ======================================================
       QUANTITY INPUTS
    ====================================================== */

    quantityInputs.forEach(
        function (input) {


            input.addEventListener(
                "click",
                function (event) {

                    event.stopPropagation();

                }
            );


            input.addEventListener(
                "pointerdown",
                function (event) {

                    event.stopPropagation();

                }
            );


            input.addEventListener(
                "pointerup",
                function (event) {

                    event.stopPropagation();

                }
            );


            input.addEventListener(
                "mousedown",
                function (event) {

                    event.stopPropagation();

                }
            );


            input.addEventListener(
                "touchstart",
                function (event) {

                    event.stopPropagation();

                }
            );


            input.addEventListener(
                "keydown",
                function (event) {

                    event.stopPropagation();

                }
            );


            input.addEventListener(
                "input",
                function () {

                    if (input.value === "") {

                        return;

                    }


                    let value =
                        Number(
                            input.value
                        );


                    const max =
                        Number(
                            input.max || 0
                        );


                    if (
                        !Number.isFinite(value) ||
                        value < 0
                    ) {

                        input.value = "";

                        return;

                    }


                    value =
                        Math.floor(value);


                    if (
                        max > 0 &&
                        value > max
                    ) {

                        value = max;

                    }


                    input.value =
                        String(value);

                }
            );

        }
    );


    /* ======================================================
       BUILD ADD-MANY FORM
    ====================================================== */

    function prepareForm(
        selectedProducts
    ) {

        /*
         * Remove only previously generated
         * product fields.
         *
         * cartSubstation is NOT removed.
         */

        sellForm
            .querySelectorAll(
                "[data-generated-product]"
            )
            .forEach(
                function (field) {

                    field.remove();

                }
            );


        selectedProducts.forEach(
            function (item, index) {

                const productIdInput =
                    document.createElement(
                        "input"
                    );


                productIdInput.type =
                    "hidden";


                productIdInput.name =
                    `products[${index}][productId]`;


                productIdInput.value =
                    item.productId;


                productIdInput.dataset.generatedProduct =
                    "true";


                const quantityInput =
                    document.createElement(
                        "input"
                    );


                quantityInput.type =
                    "hidden";


                quantityInput.name =
                    `products[${index}][qty]`;


                quantityInput.value =
                    String(item.quantity);


                quantityInput.dataset.generatedProduct =
                    "true";


                sellForm.appendChild(
                    productIdInput
                );


                sellForm.appendChild(
                    quantityInput
                );

            }
        );

    }


    /* ======================================================
       SELL ITEMS BUTTON
    ====================================================== */

    sellButton.addEventListener(
        "click",
        function (event) {

            event.preventDefault();

            event.stopPropagation();


            /* ==============================================
               FIRST CLICK
            ============================================== */

            if (!sellMode) {

                setSellMode(true);

                return;

            }


            /* ==============================================
               SECOND CLICK
            ============================================== */

            const selectedProducts =
                getSelectedProducts();


            /*
             * Nothing entered:
             * exit without submitting.
             */

            if (!selectedProducts.length) {

                setSellMode(false);

                return;

            }


            /*
             * ADMIN ONLY:
             *
             * cartSubstation MUST be the ID from
             * the parent /branch/:id URL.
             */

            if (
                String(
                    "<%= String(user.role || "").toLowerCase() %>"
                ) === "admin"
            ) {

                if (!parentBranchId) {

                    setSellMode(false);

                    return;

                }


                const cartSubstationInput =
                    sellForm.querySelector(
                        'input[name="cartSubstation"]'
                    );


                if (!cartSubstationInput) {

                    setSellMode(false);

                    return;

                }


                cartSubstationInput.value =
                    parentBranchId;

            }


            /*
             * Add the selected products.
             */

            prepareForm(
                selectedProducts
            );


            /*
             * Close sell mode.
             */

            setSellMode(false);


            /*
             * Submit the complete form.
             */

            sellForm.submit();

        }
    );


})();

</script>


<% } %>