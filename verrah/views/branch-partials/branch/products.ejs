<%
/*
==========================================================
VERRAH COSMETICS
BRANCH PRODUCTS
==========================================================

SELL ITEMS MODE
- Admin and staff can sell items.
- First tap: enter sell mode.
- Quantity inputs become visible.
- Product cards cannot navigate while selling.
- Quantity inputs remain fully interactive.
- Second tap:
    - quantities entered -> submit to addManyToCart
    - no quantities -> exit sell mode only
- Admin submits cartSubstation.
- Staff does not submit cartSubstation.
==========================================================
*/

const canSellItems =
    user &&
    (
        user.role === "admin" ||
        user.role === "staff"
    );

const isAdmin =
    user &&
    user.role === "admin";

const branchSubstationId =
    substation &&
    substation._id
        ? String(substation._id)
        : "";
%>


<!-- ==========================================================
     PRODUCTS SECTION
=========================================================== -->

<section class="branch-products-section">

    <!-- ======================================================
         PRODUCTS HEADER
    ======================================================= -->

    <div class="branch-inventory-header">

        <div class="branch-inventory-header-title">

            <h1>
                Products
            </h1>

            <p>
                Products available at
                <strong>
                    <%= substation?.name || "Substation" %>
                </strong>
            </p>

        </div>


        <% if (canSellItems) { %>

            <div class="branch-inventory-header-actions">

                <button
                    type="button"
                    id="branchSellItemsButton"
                    class="branch-sell-items-btn"
                >

                    <i class="fas fa-shopping-cart"></i>

                    <span id="branchSellButtonText">
                        Sell Items
                    </span>

                </button>

            </div>

        <% } %>

    </div>


    <!-- ======================================================
         PRODUCT SEARCH
    ======================================================= -->

    <%- include("../../partials/productSearch") %>


    <!-- ======================================================
         ADD MANY TO CART FORM

         IMPORTANT:
         Admin gets cartSubstation.
         Staff does not.
    ======================================================= -->

    <% if (canSellItems) { %>

        <form
            id="branchAddManyToCartForm"
            action="/products/addManyToCart"
            method="POST"
        >

            <% if (isAdmin) { %>

                <input
                    type="hidden"
                    name="cartSubstation"
                    value="<%= substation._id %>"
                >

            <% } %>

        </form>

    <% } %>


    <!-- ======================================================
         CATEGORY GROUPS
    ======================================================= -->

    <div
        class="branch-products-container"
        id="branchProductsContainer"
    >

        <% if (categoryGroups && categoryGroups.length) { %>

            <% categoryGroups.forEach(function([category, products]) { %>

                <section class="branch-product-category">

                    <!-- ======================================
                         CATEGORY HEADER
                    ======================================= -->

                    <div class="branch-product-category-header">

                        <h2>
                            <%= category %>
                        </h2>

                    </div>


                    <!-- ======================================
                         PRODUCT ROWS

                         MAXIMUM 6 PRODUCTS PER ROW
                    ======================================= -->

                    <div class="branch-product-rows">

                        <%
                        const productRows = [];

                        for (
                            let i = 0;
                            i < products.length;
                            i += 6
                        ) {

                            productRows.push(
                                products.slice(i, i + 6)
                            );

                        }
                        %>


                        <% productRows.forEach(function(rowProducts) { %>

                            <div class="branch-product-row">

                                <% rowProducts.forEach(function(product) { %>

                                    <%
                                    const productId =
                                        product &&
                                        product._id
                                            ? String(product._id)
                                            : "";

                                    const productLink =
                                        "/branch/" +
                                        String(substation._id) +
                                        "/products/" +
                                        productId;

                                    const productCategory =
                                        product.category ||
                                        category ||
                                        "";

                                    const productSubcategory =
                                        product.subcategory ||
                                        "";

                                    const stock =
                                        Number(
                                            product.stockAvailable ?? 0
                                        );
                                    %>


                                    <!-- ==================================
                                         PRODUCT UNIT

                                         The quantity control is deliberately
                                         OUTSIDE the <a>.
                                    =================================== -->

                                    <div
                                        class="branch-product-unit"
                                        data-product-id="<%= productId %>"
                                        data-stock="<%= stock %>"
                                    >


                                        <!-- ==============================
                                             CLICKABLE PRODUCT CARD
                                        =============================== -->

                                        <a
                                            href="<%= productLink %>"
                                            class="branch-product-card"
                                            data-product-link
                                        >

                                            <!-- PRODUCT IMAGE -->

                                            <div class="branch-product-image">

                                                <% if (product.image) { %>

                                                    <img
                                                        src="<%= product.image %>"
                                                        alt="<%= product.name %>"
                                                        loading="lazy"
                                                    >

                                                <% } else { %>

                                                    <div class="branch-product-no-image">

                                                        <i class="fas fa-box"></i>

                                                    </div>

                                                <% } %>

                                            </div>


                                            <!-- PRODUCT INFORMATION -->

                                            <div class="branch-product-info">

                                                <h3>
                                                    <%= product.name %>
                                                </h3>


                                                <% if (productCategory) { %>

                                                    <div class="branch-product-category-name">

                                                        <%= productCategory %>

                                                    </div>

                                                <% } %>


                                                <% if (productSubcategory) { %>

                                                    <div class="branch-product-subcategory">

                                                        <%= productSubcategory %>

                                                    </div>

                                                <% } %>


                                                <div class="branch-product-stock">

                                                    Stock:
                                                    <strong>
                                                        <%= stock %>
                                                    </strong>

                                                </div>

                                            </div>

                                        </a>


                                        <!-- ==================================
                                             QUANTITY CONTROL

                                             OUTSIDE THE ANCHOR.

                                             THIS IS THE IMPORTANT FIX.
                                        =================================== -->

                                        <% if (canSellItems) { %>

                                            <div
                                                class="branch-sell-quantity"
                                                data-quantity-wrapper
                                            >

                                                <label
                                                    for="branchQty_<%= productId %>"
                                                >
                                                    Quantity
                                                </label>

                                                <input
                                                    type="number"
                                                    id="branchQty_<%= productId %>"
                                                    class="branch-sell-quantity-input"
                                                    data-product-id="<%= productId %>"
                                                    data-stock="<%= stock %>"
                                                    min="0"
                                                    max="<%= stock %>"
                                                    step="1"
                                                    value=""
                                                    inputmode="numeric"
                                                    autocomplete="off"
                                                    placeholder="0"
                                                >

                                            </div>

                                        <% } %>

                                    </div>

                                <% }); %>

                            </div>

                        <% }); %>

                    </div>

                </section>

            <% }); %>


        <% } else { %>

            <!-- ==================================================
                 NO PRODUCTS
            =================================================== -->

            <div class="branch-products-empty">

                <i class="fas fa-box-open"></i>

                <h2>
                    No products available
                </h2>

                <p>
                    There are currently no products available
                    at this substation.
                </p>

            </div>

        <% } %>

    </div>

</section>


<% if (canSellItems) { %>

<script>
(function () {

    "use strict";


    /* ======================================================
       ELEMENTS
    ====================================================== */

    const sellButton =
        document.getElementById(
            "branchSellItemsButton"
        );

    const sellButtonText =
        document.getElementById(
            "branchSellButtonText"
        );

    const sellForm =
        document.getElementById(
            "branchAddManyToCartForm"
        );

    const productsContainer =
        document.getElementById(
            "branchProductsContainer"
        );


    if (
        !sellButton ||
        !sellForm ||
        !productsContainer
    ) {
        return;
    }


    /* ======================================================
       STATE
    ====================================================== */

    let sellMode = false;


    /* ======================================================
       PRODUCT UNITS
    ====================================================== */

    function getProductUnits() {

        return Array.from(
            productsContainer.querySelectorAll(
                ".branch-product-unit"
            )
        );

    }


    /* ======================================================
       QUANTITY INPUTS
    ====================================================== */

    function getQuantityInputs() {

        return Array.from(
            productsContainer.querySelectorAll(
                ".branch-sell-quantity-input"
            )
        );

    }


    /* ======================================================
       SET SELL MODE
    ====================================================== */

    function setSellMode(enabled) {

        sellMode = enabled;


        document.body.classList.toggle(
            "branch-selling-items",
            enabled
        );


        getProductUnits().forEach(function (unit) {

            unit.classList.toggle(
                "branch-product-unit-selling",
                enabled
            );

        });


        getQuantityInputs().forEach(function (input) {

            const wrapper =
                input.closest(
                    ".branch-sell-quantity"
                );


            if (wrapper) {

                wrapper.classList.toggle(
                    "is-visible",
                    enabled
                );

            }


            if (!enabled) {

                input.value = "";

            }

        });


        sellButton.classList.toggle(
            "is-selling",
            enabled
        );


        if (sellButtonText) {

            sellButtonText.textContent =
                enabled
                    ? "Finish Selling"
                    : "Sell Items";

        }

    }


    /* ======================================================
       COLLECT QUANTITIES
    ====================================================== */

    function getSelectedProducts() {

        const selectedProducts = [];


        getQuantityInputs().forEach(function (input) {

            const productId =
                String(
                    input.dataset.productId || ""
                ).trim();


            const stock =
                Number(
                    input.dataset.stock || 0
                );


            if (!productId) {
                return;
            }


            if (input.value === "") {
                return;
            }


            let quantity =
                Number(input.value);


            if (!Number.isFinite(quantity)) {
                return;
            }


            quantity =
                Math.floor(quantity);


            if (quantity <= 0) {
                return;
            }


            if (quantity > stock) {

                quantity = stock;

            }


            if (quantity <= 0) {
                return;
            }


            selectedProducts.push({
                productId: productId,
                qty: quantity
            });

        });


        return selectedProducts;

    }


    /* ======================================================
       PREPARE POST FORM
    ====================================================== */

    function prepareForm(selectedProducts) {

        sellForm
            .querySelectorAll(
                ".branch-add-many-product-field"
            )
            .forEach(function (field) {

                field.remove();

            });


        selectedProducts.forEach(
            function (item, index) {

                const productIdInput =
                    document.createElement(
                        "input"
                    );

                productIdInput.type =
                    "hidden";

                productIdInput.name =
                    "products[" +
                    index +
                    "][productId]";

                productIdInput.value =
                    item.productId;

                productIdInput.className =
                    "branch-add-many-product-field";


                const qtyInput =
                    document.createElement(
                        "input"
                    );

                qtyInput.type =
                    "hidden";

                qtyInput.name =
                    "products[" +
                    index +
                    "][qty]";

                qtyInput.value =
                    item.qty;

                qtyInput.className =
                    "branch-add-many-product-field";


                sellForm.appendChild(
                    productIdInput
                );

                sellForm.appendChild(
                    qtyInput
                );

            }
        );

    }


    /* ======================================================
       SELL BUTTON
    ====================================================== */

    sellButton.addEventListener(
        "click",
        function (event) {

            event.preventDefault();

            event.stopPropagation();


            /*
             * FIRST TAP
             *
             * Enter sell mode.
             */

            if (!sellMode) {

                setSellMode(true);

                return;

            }


            /*
             * SECOND TAP
             *
             * Collect entered quantities.
             */

            const selectedProducts =
                getSelectedProducts();


            /*
             * NOTHING ENTERED
             *
             * Simply leave sell mode.
             * Do not submit.
             */

            if (
                selectedProducts.length === 0
            ) {

                setSellMode(false);

                return;

            }


            /*
             * QUANTITIES EXIST
             *
             * Build the POST request.
             */

            prepareForm(
                selectedProducts
            );


            /*
             * Hide quantity controls and restore
             * normal card behaviour before submit.
             */

            setSellMode(false);


            sellForm.submit();

        }
    );


    /* ======================================================
       PRODUCT CARD BEHAVIOUR
    ====================================================== */

    getProductUnits().forEach(function (unit) {

        const card =
            unit.querySelector(
                "[data-product-link]"
            );


        if (!card) {
            return;
        }


        card.addEventListener(
            "click",
            function (event) {

                if (!sellMode) {
                    return;
                }


                event.preventDefault();

                event.stopPropagation();

            },
            true
        );

    });


    /* ======================================================
       QUANTITY INPUT BEHAVIOUR
    ====================================================== */

    getQuantityInputs().forEach(function (input) {

        /*
         * These events belong to the input itself.
         * Stop them from reaching the product card.
         */

        [
            "click",
            "dblclick",
            "mousedown",
            "mouseup",
            "pointerdown",
            "pointerup",
            "touchstart",
            "touchend",
            "keydown",
            "keypress",
            "keyup",
            "input",
            "change"
        ].forEach(function (eventName) {

            input.addEventListener(
                eventName,
                function (event) {

                    event.stopPropagation();

                }
            );

        });


        /* ==============================================
           QUANTITY VALIDATION
        =============================================== */

        input.addEventListener(
            "input",
            function () {

                const stock =
                    Number(
                        input.dataset.stock || 0
                    );


                if (input.value === "") {
                    return;
                }


                let quantity =
                    Number(input.value);


                if (!Number.isFinite(quantity)) {

                    input.value = "";

                    return;

                }


                quantity =
                    Math.floor(quantity);


                if (quantity < 0) {

                    quantity = 0;

                }


                if (quantity > stock) {

                    quantity = stock;

                }


                input.value =
                    quantity;

            }
        );


        /* ==============================================
           KEYBOARD VALIDATION
        =============================================== */

        input.addEventListener(
            "keydown",
            function (event) {

                const allowedKeys = [
                    "Backspace",
                    "Delete",
                    "Tab",
                    "ArrowLeft",
                    "ArrowRight",
                    "ArrowUp",
                    "ArrowDown",
                    "Home",
                    "End"
                ];


                if (
                    allowedKeys.includes(
                        event.key
                    )
                ) {
                    return;
                }


                if (
                    event.ctrlKey ||
                    event.metaKey
                ) {
                    return;
                }


                if (
                    !/^[0-9]$/.test(
                        event.key
                    )
                ) {

                    event.preventDefault();

                }

            }
        );

    });


    /* ======================================================
       INITIAL STATE
    ====================================================== */

    setSellMode(false);

})();
</script>

<% } %>