<%
/*

VERRAH COSMETICS
BRANCH PRODUCTS
SUBMITS cartSubstation AS DOCUMENT OBJECT

*/

const groupedProducts = {};

(substation.products || []).forEach(function(product) {

    const categoryName =
        product.categoryName ||
        (
            product.category &&
            typeof product.category === "object"
               ? product.category.name
                : product.category
        ) ||
        "Other";

    if (!groupedProducts[categoryName]) {
        groupedProducts[categoryName] = [];
    }

    groupedProducts[categoryName].push(product);

});

const categoryGroups =
    Object.entries(groupedProducts);

%>

<section class="branch-inventory">

    <!-- ======================================================
         INVENTORY HEADER
    ======================================================= -->

    <div class="branch-inventory-header">

        <div class="branch-inventory-heading">

            <h2>
                Products
            </h2>

            <span class="branch-inventory-count">
                <%= Number(
                    (substation.products || []).length
                ).toLocaleString() %>
                products
            </span>

        </div>

        <div class="branch-inventory-header-actions">

            <% if (
                user &&
                ["admin", "staff"].includes(
                    String(user.role || "").toLowerCase()
                )
            ) { %>

                <button
                    type="button"
                    class="branch-sell-items-btn"
                    id="branchSellItemsButton"
                >

                    <i class="fas fa-cart-plus"></i>

                    <span id="branchSellItemsButtonText">
                        Sell Items
                    </span>

                </button>

            <% } %>

        </div>

    </div>

    <!-- ======================================================
         PRODUCT SEARCH
    ======================================================= -->

    <%- include("./productSearch") %>

    <!-- ======================================================
         EMPTY INVENTORY
    ======================================================= -->

    <% if (
       !substation.products ||
       !substation.products.length
    ) { %>

        <div class="branch-inventory-empty">

            <i class="fas fa-box-open"></i>

            <p>
                No products available at this branch.
            </p>

        </div>

    <% } else { %>

        <!-- ==================================================
             PRODUCT CATEGORIES
        =================================================== -->

        <div class="branch-inventory-categories">

            <%
            for (
                let categoryIndex = 0;
                categoryIndex < categoryGroups.length;
                categoryIndex++
            ) {

                const categoryName =
                    categoryGroups[categoryIndex][0];

                const products =
                    categoryGroups[categoryIndex][1];
            %>

                <section
                    class="branch-inventory-category"
                    data-category="<%= categoryName %>"
                >

                    <!-- ======================================
                         CATEGORY TITLE
                    ======================================= -->

                    <div class="branch-category-title">

                        <h3>
                            <%= categoryName %>
                        </h3>

                    </div>

                    <!-- ======================================
                         PRODUCTS
                    ======================================= -->

                    <div class="branch-product-rows">

                        <%
                        const productRows = [];

                        for (
                            let i = 0;
                            i < products.length;
                            i += 6
                        ) {

                            productRows.push(
                                products.slice(i, i + 6)
                            );

                        }
                        %>

                        <%
                        for (
                            let rowIndex = 0;
                            rowIndex < productRows.length;
                            rowIndex++
                        ) {

                            const productRow =
                                productRows[rowIndex];
                        %>

                            <div class="branch-product-row">

                                <div class="branch-product-scroller">

                                    <%
                                    for (
                                        let productIndex = 0;
                                        productIndex < productRow.length;
                                        productIndex++
                                    ) {

                                        const product =
                                            productRow[productIndex];

                                        const productId =
                                            String(product._id);

                                        const productLink =
                                            `/branch/${substation._id}/products/${product._id}`;
                                    %>

                                        <!-- ==================================
                                             PRODUCT CARD
                                        =================================== -->

                                        <a
                                            href="<%= productLink %>"
                                            class="branch-product-card"
                                            data-product-card
                                            data-product-id="<%= productId %>"
                                        >

                                            <!-- ==============================
                                                 PRODUCT IMAGE
                                            =============================== -->

                                            <div class="branch-product-photo">

                                                <% if (
                                                    product.image ||
                                                    product.imageUrl ||
                                                    product.photo
                                                ) { %>

                                                    <img
                                                        src="<%= product.image || product.imageUrl || product.photo %>"
                                                        alt="<%= product.name %>"
                                                        loading="lazy"
                                                    >

                                                <% } else { %>

                                                    <div class="branch-product-placeholder">

                                                        <i class="fas fa-box"></i>

                                                    </div>

                                                <% } %>

                                            </div>

                                            <!-- ==============================
                                                 PRODUCT DETAILS
                                            =============================== -->

                                            <div class="branch-product-details">

                                                <h4 class="branch-product-name">
                                                    <%= product.name %>
                                                </h4>

                                                <div class="branch-product-meta">

                                                    <span class="branch-product-category">

                                                        KSh <%= Number(
                                                            product.unitSellPrice || 0
                                                        ).toLocaleString() %>

                                                    </span>

                                                </div>

                                                <div class="branch-product-quantity">

                                                    <strong>
                                                        <%= Number(
                                                            product.substationUnits || 0
                                                        ).toLocaleString() %>
                                                    </strong>

                                                    <span>
                                                        units
                                                    </span>

                                                </div>

                                            </div>

                                        </a>

                                        <!-- ==================================
                                             SELL QUANTITY
                                        =================================== -->

                                        <% if (
                                            user &&
                                            ["admin", "staff"].includes(
                                                String(user.role || "").toLowerCase()
                                            )
                                        ) { %>

                                            <div
                                                class="branch-sell-quantity"
                                                data-sell-quantity
                                            >

                                                <label
                                                    for="sellQty_<%= productId %>"
                                                >
                                                    Units
                                                </label>

                                                <input
                                                    type="number"
                                                    id="sellQty_<%= productId %>"
                                                    class="branch-sell-quantity-input"
                                                    data-product-id="<%= productId %>"
                                                    min="0"
                                                    max="<%= Number(product.substationUnits || 0) %>"
                                                    step="1"
                                                    value=""
                                                    inputmode="numeric"
                                                    autocomplete="off"
                                                    placeholder="0"
                                                >

                                            </div>

                                        <% } %>

                                    <%
                                    }
                                    %>

                                </div>

                            </div>

                        <%
                        }
                        %>

                    </div>

                </section>

            <%
            }
            %>

        </div>

    <% } %>

    <!-- ======================================================
         ADD MANY PRODUCTS TO CART FORM
         NOW SUBMITS SUBSTATION DOCUMENT OBJECT
    ======================================================= -->

    <% if (
        user &&
        ["admin", "staff"].includes(
            String(user.role || "").toLowerCase()
        )
    ) { %>

        <form
            action="/products/addManyToCart"
            method="POST"
            id="branchAddManyToCartForm"
        >
            <%
                // Parent page supplies the full substation document
                const _subDoc = typeof substation.toObject === 'function'? substation.toObject() : substation;
            %>
            <!-- Submit as document object using bracket notation -->
            <input type="hidden" name="cartSubstation[_id]" value="<%= String(_subDoc._id) %>" id="cartSubstationId">
            <input type="hidden" name="cartSubstation[name]" value="<%= _subDoc.name || '' %>">
            <input type="hidden" name="cartSubstation[branchName]" value="<%= _subDoc.branchName || _subDoc.name || '' %>">
            <input type="hidden" name="cartSubstation[location]" value="<%= _subDoc.location || '' %>">
            <input type="hidden" name="cartSubstation[type]" value="<%= _subDoc.type || '' %>">
            <!-- Keep full JSON as fallback -->
            <input type="hidden" name="cartSubstationJson" id="cartSubstationJson" value='<%- JSON.stringify(_subDoc).replace(/'/g, "&#39;") %>'>
        </form>

    <% } %>

</section>

<!-- ==========================================================
     SELL ITEMS JAVASCRIPT
========================================================== -->

<% if (
    user &&
    ["admin", "staff"].includes(
        String(user.role || "").toLowerCase()
    )
) { %>

<script>

document.addEventListener(
    "DOMContentLoaded",
    function () {

        const sellButton =
            document.getElementById(
                "branchSellItemsButton"
            );

        const sellButtonText =
            document.getElementById(
                "branchSellItemsButtonText"
            );

        const sellForm =
            document.getElementById(
                "branchAddManyToCartForm"
            );

        const productCards =
            document.querySelectorAll(
                "[data-product-card]"
            );

        const quantityWrappers =
            document.querySelectorAll(
                "[data-sell-quantity]"
            );

        const quantityInputs =
            document.querySelectorAll(
                ".branch-sell-quantity-input"
            );

        let sellMode = false;

        function setSellMode(enabled) {

            sellMode = enabled;

            document.body.classList.toggle(
                "branch-selling-items",
                enabled
            );

            productCards.forEach(
                function(card) {
                    card.classList.toggle(
                        "branch-product-card-selling",
                        enabled
                    );
                }
            );

            quantityWrappers.forEach(
                function(wrapper) {
                    wrapper.classList.toggle(
                        "is-visible",
                        enabled
                    );
                }
            );

            if (!enabled) {
                quantityInputs.forEach(
                    function(input) {
                        input.value = "";
                    }
                );
            }

            if (sellButtonText) {
                sellButtonText.textContent =
                    enabled
                       ? "Done"
                        : "Sell Items";
            }

        }

        function getSelectedProducts() {

            const selectedProducts = [];

            quantityInputs.forEach(
                function(input) {

                    const productId =
                        input.dataset.productId;

                    const rawQuantity =
                        input.value.trim();

                    if (!rawQuantity) {
                        return;
                    }

                    const quantity =
                        Number(rawQuantity);

                    if (
                       !Number.isFinite(quantity) ||
                        quantity <= 0
                    ) {
                        return;
                    }

                    selectedProducts.push({
                        productId: productId,
                        quantity: quantity
                    });

                }
            );

            return selectedProducts;

        }

        function prepareForm(
            selectedProducts
        ) {

            sellForm
               .querySelectorAll(
                    "[data-generated-product]"
                )
               .forEach(
                    function(field) {
                        field.remove();
                    }
                );

            // FORCE ID from mother page URL /branch/:id - ensures correct document
            const urlMatch = window.location.pathname.match(/\/branch\/([^\/]+)/);
            const correctId = urlMatch? urlMatch[1] : "";

            const idField = document.getElementById("cartSubstationId");
            if (idField && correctId) {
                idField.value = correctId;
            }

            // Also update JSON fallback
            const jsonField = document.getElementById("cartSubstationJson");
            if (jsonField && correctId) {
                try {
                    const doc = JSON.parse(jsonField.value);
                    doc._id = correctId;
                    jsonField.value = JSON.stringify(doc);
                } catch(e) {}
            }

            selectedProducts.forEach(
                function(item, index) {

                    const productIdInput =
                        document.createElement(
                            "input"
                        );

                    productIdInput.type =
                        "hidden";

                    productIdInput.name =
                        "products[" +
                        index +
                        "][productId]";

                    productIdInput.value =
                        item.productId;

                    productIdInput.dataset
                       .generatedProduct =
                        "true";

                    sellForm.appendChild(
                        productIdInput
                    );

                    const quantityInput =
                        document.createElement(
                            "input"
                        );

                    quantityInput.type =
                        "hidden";

                    quantityInput.name =
                        "products[" +
                        index +
                        "][qty]";

                    quantityInput.value =
                        item.quantity;

                    quantityInput.dataset
                       .generatedProduct =
                        "true";

                    sellForm.appendChild(
                        quantityInput
                    );

                }
            );

        }

        if (sellButton) {

            sellButton.addEventListener(
                "click",
                function () {

                    if (!sellMode) {
                        setSellMode(true);
                        return;
                    }

                    const selectedProducts =
                        getSelectedProducts();

                    if (
                       !selectedProducts.length
                    ) {
                        setSellMode(false);
                        return;
                    }

                    prepareForm(
                        selectedProducts
                    );

                    setSellMode(false);

                    sellForm.submit();

                }
            );

        }

        productCards.forEach(
            function(card) {

                card.addEventListener(
                    "click",
                    function(event) {

                        if (!sellMode) {
                            return;
                        }

                        event.preventDefault();
                        event.stopPropagation();

                    },
                    true
                );

            }
        );

        quantityInputs.forEach(
            function(input) {

                input.addEventListener(
                    "click",
                    function(event) {
                        event.stopPropagation();
                    }
                );

                input.addEventListener(
                    "pointerdown",
                    function(event) {
                        event.stopPropagation();
                    }
                );

                input.addEventListener(
                    "mousedown",
                    function(event) {
                        event.stopPropagation();
                    }
                );

                input.addEventListener(
                    "touchstart",
                    function(event) {
                        event.stopPropagation();
                    },
                    {
                        passive: true
                    }
                );

                input.addEventListener(
                    "keydown",
                    function(event) {
                        event.stopPropagation();
                    }
                );

                input.addEventListener(
                    "input",
                    function() {

                        if (
                            this.value === ""
                        ) {
                            return;
                        }

                        let quantity =
                            Number(this.value);

                        if (
                           !Number.isFinite(quantity)
                        ) {
                            this.value = "";
                            return;
                        }

                        const max =
                            Number(this.max);

                        if (
                            Number.isFinite(max) &&
                            quantity > max
                        ) {
                            quantity = max;
                        }

                        if (quantity < 0) {
                            quantity = 0;
                        }

                        this.value =
                            String(
                                Math.floor(quantity)
                            );

                    }
                );

            }
        );

    }
);

</script>

<% } %>