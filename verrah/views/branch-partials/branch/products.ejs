<%
/*
==========================================================
VERRAH COSMETICS
BRANCH PRODUCTS

SELL ITEMS MODE
- Admin and staff can enter sell mode.
- First tap: show quantity inputs.
- While selling: product links are disabled.
- Quantity inputs remain fully interactive.
- Second tap:
    - quantities entered -> submit to addManyToCart
    - no quantities -> simply exit sell mode
- Admin submits cartSubstation.
- Staff does not submit cartSubstation.
==========================================================
*/

const currentUserRole =
    String(user?.role || "").toLowerCase();

const canSellItems =
    currentUserRole === "admin" ||
    currentUserRole === "staff";

const isAdmin =
    currentUserRole === "admin";

const branchSubstationId =
    substation?._id
        ? String(substation._id)
        : "";

const groupedProducts =
    productsByCategory || {};
%>


<section class="branch-products-page">

    <!-- ==================================================
         INVENTORY HEADER
    =================================================== -->

    <div class="branch-inventory-header">

        <div class="branch-inventory-header-title">

            <h1>
                Products
            </h1>

            <p>
                Products available at
                <strong>
                    <%= substation?.name || "Substation" %>
                </strong>
            </p>

        </div>


        <% if (canSellItems) { %>

            <div class="branch-inventory-header-actions">

                <button
                    type="button"
                    class="branch-sell-items-btn"
                    id="branchSellItemsButton"
                >
                    <i class="fas fa-shopping-cart"></i>

                    <span id="branchSellButtonText">
                        Sell Items
                    </span>
                </button>

            </div>

        <% } %>

    </div>


    <!-- ==================================================
         PRODUCT SEARCH
    =================================================== -->

    <%- include("../partials/productSearch") %>


    <!-- ==================================================
         ADD MANY TO CART FORM
    =================================================== -->

    <% if (canSellItems) { %>

        <form
            action="/products/addManyToCart"
            method="POST"
            id="branchAddManyToCartForm"
        >

            <% if (isAdmin) { %>

                <input
                    type="hidden"
                    name="cartSubstation"
                    value="<%= branchSubstationId %>"
                >

            <% } %>

        </form>

    <% } %>


    <!-- ==================================================
         PRODUCTS
    =================================================== -->

    <div
        class="branch-products-container"
        id="branchProductsContainer"
    >

        <% Object.keys(groupedProducts).forEach(function(category) { %>

            <section class="branch-product-category">

                <div class="branch-product-category-header">

                    <h2>
                        <%= category %>
                    </h2>

                </div>


                <div class="branch-product-rows">

                    <%
                    const categoryProducts =
                        groupedProducts[category] || [];

                    for (
                        let rowStart = 0;
                        rowStart < categoryProducts.length;
                        rowStart += 6
                    ) {

                        const rowProducts =
                            categoryProducts.slice(
                                rowStart,
                                rowStart + 6
                            );
                    %>

                        <div class="branch-product-row">

                            <% rowProducts.forEach(function(product) { %>

                                <%
                                const productId =
                                    product?._id
                                        ? String(product._id)
                                        : "";

                                const stock =
                                    Number(
                                        product?.stockAvailable ?? 0
                                    );

                                const productUrl =
                                    "/branch/" +
                                    branchSubstationId +
                                    "/products/" +
                                    productId;
                                %>


                                <!-- ==========================================
                                     PRODUCT UNIT

                                     IMPORTANT:
                                     The quantity control is OUTSIDE the
                                     clickable <a>.

                                     This is what allows the input to receive
                                     focus and keyboard input normally.
                                =========================================== -->

                                <div
                                    class="branch-product-unit"
                                    data-product-id="<%= productId %>"
                                    data-stock="<%= stock %>"
                                >


                                    <!-- ======================================
                                         CLICKABLE PRODUCT CARD
                                    ======================================= -->

                                    <a
                                        href="<%= productUrl %>"
                                        class="branch-product-card"
                                        data-product-link
                                    >

                                        <!-- IMAGE -->

                                        <div class="branch-product-image">

                                            <% if (product?.image) { %>

                                                <img
                                                    src="<%= product.image %>"
                                                    alt="<%= product?.name || 'Product' %>"
                                                    loading="lazy"
                                                >

                                            <% } else { %>

                                                <div class="branch-product-no-image">

                                                    <i class="fas fa-box"></i>

                                                </div>

                                            <% } %>

                                        </div>


                                        <!-- PRODUCT INFORMATION -->

                                        <div class="branch-product-info">

                                            <h3>
                                                <%= product?.name || "Unnamed Product" %>
                                            </h3>


                                            <% if (product?.category) { %>

                                                <div class="branch-product-category-name">

                                                    <%= product.category %>

                                                </div>

                                            <% } %>


                                            <% if (product?.subcategory) { %>

                                                <div class="branch-product-subcategory">

                                                    <%= product.subcategory %>

                                                </div>

                                            <% } %>


                                            <div class="branch-product-stock">

                                                Stock:
                                                <strong>
                                                    <%= stock %>
                                                </strong>

                                            </div>

                                        </div>

                                    </a>


                                    <!-- ======================================
                                         QUANTITY INPUT

                                         OUTSIDE THE ANCHOR.

                                         Therefore:
                                         - can be focused
                                         - can be typed into
                                         - can be edited
                                         - can be selected
                                         - cannot trigger product navigation
                                    ======================================= -->

                                    <% if (canSellItems) { %>

                                        <div
                                            class="branch-sell-quantity"
                                            data-quantity-wrapper
                                        >

                                            <label
                                                for="branchQty_<%= productId %>"
                                            >
                                                Quantity
                                            </label>

                                            <input
                                                type="number"
                                                id="branchQty_<%= productId %>"
                                                class="branch-sell-quantity-input"
                                                data-product-id="<%= productId %>"
                                                data-stock="<%= stock %>"
                                                min="0"
                                                max="<%= stock %>"
                                                step="1"
                                                value=""
                                                inputmode="numeric"
                                                autocomplete="off"
                                                placeholder="0"
                                            >

                                        </div>

                                    <% } %>

                                </div>

                            <% }); %>

                        </div>

                    <% } %>

                </div>

            </section>

        <% }); %>


        <!-- ==================================================
             NO PRODUCTS
        =================================================== -->

        <% if (
            !Object.keys(groupedProducts).length
        ) { %>

            <div class="branch-products-empty">

                <i class="fas fa-box-open"></i>

                <h2>
                    No products available
                </h2>

                <p>
                    There are currently no products available
                    at this substation.
                </p>

            </div>

        <% } %>

    </div>

</section>


<% if (canSellItems) { %>

<script>
(function () {

    "use strict";


    /* ======================================================
       ELEMENTS
    ====================================================== */

    const sellButton =
        document.getElementById(
            "branchSellItemsButton"
        );

    const sellButtonText =
        document.getElementById(
            "branchSellButtonText"
        );

    const sellForm =
        document.getElementById(
            "branchAddManyToCartForm"
        );

    const productsContainer =
        document.getElementById(
            "branchProductsContainer"
        );


    if (
        !sellButton ||
        !sellForm ||
        !productsContainer
    ) {
        return;
    }


    /* ======================================================
       STATE
    ====================================================== */

    let sellMode = false;


    /* ======================================================
       PRODUCT UNITS
    ====================================================== */

    function getProductUnits() {

        return Array.from(
            productsContainer.querySelectorAll(
                ".branch-product-unit"
            )
        );

    }


    /* ======================================================
       QUANTITY INPUTS
    ====================================================== */

    function getQuantityInputs() {

        return Array.from(
            productsContainer.querySelectorAll(
                ".branch-sell-quantity-input"
            )
        );

    }


    /* ======================================================
       SELL MODE
    ====================================================== */

    function setSellMode(enabled) {

        sellMode = enabled;


        document.body.classList.toggle(
            "branch-selling-items",
            enabled
        );


        getProductUnits().forEach(function (unit) {

            unit.classList.toggle(
                "branch-product-unit-selling",
                enabled
            );

        });


        getQuantityInputs().forEach(function (input) {

            const wrapper =
                input.closest(
                    ".branch-sell-quantity"
                );


            if (wrapper) {

                wrapper.classList.toggle(
                    "is-visible",
                    enabled
                );

            }


            /*
             * When leaving sell mode, clear the inputs.
             */

            if (!enabled) {

                input.value = "";

            }

        });


        sellButton.classList.toggle(
            "is-selling",
            enabled
        );


        if (sellButtonText) {

            sellButtonText.textContent =
                enabled
                    ? "Finish Selling"
                    : "Sell Items";

        }

    }


    /* ======================================================
       COLLECT SELECTED PRODUCTS
    ====================================================== */

    function getSelectedProducts() {

        const selectedProducts = [];


        getQuantityInputs().forEach(function (input) {

            const productId =
                String(
                    input.dataset.productId || ""
                ).trim();


            let quantity =
                Number(input.value);


            const stock =
                Number(
                    input.dataset.stock || 0
                );


            if (!productId) {
                return;
            }


            if (!Number.isFinite(quantity)) {
                return;
            }


            quantity =
                Math.floor(quantity);


            if (quantity <= 0) {
                return;
            }


            /*
             * Never allow a quantity greater than available stock.
             */

            if (quantity > stock) {

                quantity = stock;

            }


            if (quantity <= 0) {
                return;
            }


            selectedProducts.push({
                productId: productId,
                qty: quantity
            });

        });


        return selectedProducts;

    }


    /* ======================================================
       PREPARE POST FORM
    ====================================================== */

    function prepareForm(selectedProducts) {

        /*
         * Remove only dynamically-created product fields.
         * The admin cartSubstation hidden input remains untouched.
         */

        sellForm
            .querySelectorAll(
                ".branch-add-many-product-field"
            )
            .forEach(function (field) {

                field.remove();

            });


        selectedProducts.forEach(
            function (item, index) {

                const productIdInput =
                    document.createElement(
                        "input"
                    );

                productIdInput.type =
                    "hidden";

                productIdInput.name =
                    "products[" +
                    index +
                    "][productId]";

                productIdInput.value =
                    item.productId;

                productIdInput.className =
                    "branch-add-many-product-field";


                const qtyInput =
                    document.createElement(
                        "input"
                    );

                qtyInput.type =
                    "hidden";

                qtyInput.name =
                    "products[" +
                    index +
                    "][qty]";

                qtyInput.value =
                    item.qty;

                qtyInput.className =
                    "branch-add-many-product-field";


                sellForm.appendChild(
                    productIdInput
                );

                sellForm.appendChild(
                    qtyInput
                );

            }
        );

    }


    /* ======================================================
       SELL BUTTON
    ====================================================== */

    sellButton.addEventListener(
        "click",
        function (event) {

            event.preventDefault();

            event.stopPropagation();


            /*
             * FIRST TAP
             *
             * Enter sell mode only.
             */

            if (!sellMode) {

                setSellMode(true);

                return;

            }


            /*
             * SECOND TAP
             *
             * Check whether anything was entered.
             */

            const selectedProducts =
                getSelectedProducts();


            /*
             * Nothing entered:
             *
             * Exit sell mode.
             * DO NOT submit anything.
             */

            if (
                selectedProducts.length === 0
            ) {

                setSellMode(false);

                return;

            }


            /*
             * Something was entered:
             *
             * Build the POST request.
             */

            prepareForm(
                selectedProducts
            );


            /*
             * Hide inputs and restore normal
             * product-card behaviour BEFORE
             * submitting.
             */

            setSellMode(false);


            /*
             * Submit to:
             *
             * POST /products/addManyToCart
             */

            sellForm.submit();

        }
    );


    /* ======================================================
       PRODUCT CARD NAVIGATION
    ====================================================== */

    getProductUnits().forEach(function (unit) {

        const card =
            unit.querySelector(
                "[data-product-link]"
            );


        if (!card) {
            return;
        }


        card.addEventListener(
            "click",
            function (event) {

                /*
                 * In sell mode the product card
                 * must not navigate.
                 */

                if (!sellMode) {
                    return;
                }


                event.preventDefault();

                event.stopPropagation();

            },
            true
        );

    });


    /* ======================================================
       QUANTITY INPUT INTERACTION
    ====================================================== */

    getQuantityInputs().forEach(function (input) {

        /*
         * Stop the input's events from reaching
         * the product-card/link.
         */

        [
            "click",
            "dblclick",
            "mousedown",
            "mouseup",
            "pointerdown",
            "pointerup",
            "touchstart",
            "touchend",
            "keydown",
            "keypress",
            "keyup",
            "input",
            "change"
        ].forEach(function (eventName) {

            input.addEventListener(
                eventName,
                function (event) {

                    event.stopPropagation();

                }
            );

        });


        /* ==============================================
           VALIDATE QUANTITY
        =============================================== */

        input.addEventListener(
            "input",
            function () {

                const stock =
                    Number(
                        input.dataset.stock || 0
                    );


                let value =
                    input.value;


                /*
                 * Allow the field to be temporarily
                 * empty while the user is typing.
                 */

                if (value === "") {
                    return;
                }


                let quantity =
                    Number(value);


                if (!Number.isFinite(quantity)) {

                    input.value = "";

                    return;

                }


                quantity =
                    Math.floor(quantity);


                if (quantity < 0) {

                    quantity = 0;

                }


                if (quantity > stock) {

                    quantity = stock;

                }


                input.value =
                    quantity;

            }
        );


        /* ==============================================
           PREVENT INVALID KEYS
        =============================================== */

        input.addEventListener(
            "keydown",
            function (event) {

                /*
                 * Allow:
                 * Backspace
                 * Delete
                 * Tab
                 * Arrow keys
                 * Home
                 * End
                 */

                const allowedKeys = [
                    "Backspace",
                    "Delete",
                    "Tab",
                    "ArrowLeft",
                    "ArrowRight",
                    "ArrowUp",
                    "ArrowDown",
                    "Home",
                    "End"
                ];


                if (
                    allowedKeys.includes(
                        event.key
                    )
                ) {
                    return;
                }


                /*
                 * Allow Ctrl/Cmd combinations.
                 */

                if (
                    event.ctrlKey ||
                    event.metaKey
                ) {
                    return;
                }


                /*
                 * Only numeric keys.
                 */

                if (
                    !/^[0-9]$/.test(
                        event.key
                    )
                ) {

                    event.preventDefault();

                }

            }
        );

    });


    /* ======================================================
       INITIAL STATE
    ====================================================== */

    setSellMode(false);

})();
</script>

<% } %>