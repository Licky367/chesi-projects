<%
const isAdmin =
    typeof user !== "undefined" &&
    user &&
    user.role === "admin";

const edit =
    typeof editMode !== "undefined" &&
    editMode;

const branchImages =
    substation &&
    Array.isArray(substation.images)
        ? substation.images.filter(Boolean)
        : [];

const visibleImages =
    branchImages.slice(0, 4);

const remainingImages =
    Math.max(
        branchImages.length - 4,
        0
    );
%>


<% if (edit) { %>

<section class="substation-images-edit-page">

    <div class="substation-images-edit-card">

        <div class="substation-images-edit-header">

            <h1>
                Manage Substation Images
            </h1>

            <p>
                <%= substation.name %>
            </p>

        </div>


        <% if (error) { %>

            <div class="error" role="alert">
                <%= error %>
            </div>

        <% } %>


        <% if (success) { %>

            <div class="success" role="status">
                <%= success %>
            </div>

        <% } %>


        <form
            action="/substations/branch/images/<%= substation._id %>"
            method="POST"
            enctype="multipart/form-data"
        >


            <% if (branchImages.length) { %>

                <div class="substation-existing-images">

                    <h3>
                        Existing Images
                    </h3>


                    <div class="substation-manage-grid">

                        <% branchImages.forEach((image, index) => { %>

                            <label
                                class="substation-manage-image"
                            >

                                <img
                                    src="<%= image %>"
                                    alt="<%= substation.name %> image <%= index + 1 %>"
                                >

                                <span>

                                    <input
                                        type="checkbox"
                                        name="keepImages"
                                        value="<%= image %>"
                                        checked
                                    >

                                    Keep image

                                </span>

                            </label>

                        <% }) %>

                    </div>

                </div>

            <% } %>


            <div class="substation-new-images">

                <label
                    for="images"
                >
                    Add new images
                </label>

                <input
                    id="images"
                    type="file"
                    name="images"
                    accept="image/jpeg,image/png,image/webp,image/gif"
                    multiple
                >

                <small>
                    You can select up to 20 images.
                </small>

            </div>


            <div class="substation-form-actions">

                <button
                    type="submit"
                >
                    Save Images
                </button>

                <a
                    href="/branch/<%= substation._id %>"
                >
                    Cancel
                </a>

            </div>


        </form>

    </div>

</section>


<% } else { %>


<div class="substation-images-card">

    <div class="substation-images-card-header">

        <h3>
            Images
        </h3>

        <% if (isAdmin) { %>

            <a
                href="/substations/branch/images/<%= substation._id %>"
                class="substation-images-edit"
            >
                Manage
            </a>

        <% } %>

    </div>


    <% if (branchImages.length > 0) { %>

        <div class="substation-images-grid">

            <% visibleImages.forEach((image, index) => { %>

                <button
                    type="button"
                    class="substation-image-item <%= index === 3 && remainingImages > 0 ? 'has-more-images' : '' %>"
                    data-image-index="<%= index %>"
                >

                    <img
                        src="<%= image %>"
                        alt="<%= substation.name %> image <%= index + 1 %>"
                        class="substation-grid-image"
                        loading="lazy"
                    >


                    <% if (
                        index === 3 &&
                        remainingImages > 0
                    ) { %>

                        <span
                            class="substation-more-overlay"
                        >
                            +<%= remainingImages %>
                        </span>

                    <% } %>

                </button>

            <% }) %>

        </div>


        <!-- ==================================================
             FULL SCREEN IMAGE VIEWER
        ================================================== -->

        <div
            class="substation-image-viewer"
            id="substationImageViewer"
            aria-hidden="true"
        >

            <button
                type="button"
                class="substation-viewer-close"
                id="substationViewerClose"
            >
                &times;
            </button>


            <div
                class="substation-viewer-track"
                id="substationViewerTrack"
            >

                <% branchImages.forEach((image, index) => { %>

                    <div
                        class="substation-viewer-slide"
                    >

                        <img
                            src="<%= image %>"
                            alt="<%= substation.name %> image <%= index + 1 %>"
                            class="substation-viewer-image"
                        >

                    </div>

                <% }) %>

            </div>

        </div>


        <script>
        (function () {

            const viewer =
                document.getElementById(
                    "substationImageViewer"
                );

            const track =
                document.getElementById(
                    "substationViewerTrack"
                );

            const closeButton =
                document.getElementById(
                    "substationViewerClose"
                );

            const imageItems =
                document.querySelectorAll(
                    ".substation-image-item"
                );

            if (
                !viewer ||
                !track ||
                !closeButton
            ) {
                return;
            }


            imageItems.forEach(
                function (item) {

                    item.addEventListener(
                        "click",
                        function () {

                            const index =
                                Number(
                                    item.dataset.imageIndex
                                );

                            viewer.classList.add(
                                "is-open"
                            );

                            viewer.setAttribute(
                                "aria-hidden",
                                "false"
                            );

                            document.body.classList.add(
                                "substation-viewer-open"
                            );

                            track.scrollLeft =
                                index *
                                track.clientWidth;

                        }
                    );

                }
            );


            function closeViewer() {

                viewer.classList.remove(
                    "is-open"
                );

                viewer.setAttribute(
                    "aria-hidden",
                    "true"
                );

                document.body.classList.remove(
                    "substation-viewer-open"
                );
            }


            closeButton.addEventListener(
                "click",
                closeViewer
            );


            viewer.addEventListener(
                "click",
                function (event) {

                    if (
                        event.target === viewer
                    ) {
                        closeViewer();
                    }

                }
            );


            document.addEventListener(
                "keydown",
                function (event) {

                    if (
                        event.key === "Escape" &&
                        viewer.classList.contains(
                            "is-open"
                        )
                    ) {
                        closeViewer();
                    }

                }
            );

        })();
        </script>


    <% } else { %>


        <div class="substation-images-empty">

            <span>
                No images
            </span>

            <% if (isAdmin) { %>

                <a
                    href="/substations/branch/images/<%= substation._id %>"
                    class="substation-images-add"
                >
                    Add Images
                </a>

            <% } %>

        </div>


    <% } %>

</div>


<% } %>