<section class="shop-page">

    <!-- ======================================================
         BACK TO SUBSTATION
    ======================================================= -->

    <div class="product-back">

        <a
            href="/branch/<%= substation._id %>"
            class="secondary-btn"
        >

            <i class="fas fa-arrow-left"></i>

            <%= substation.name %>

        </a>

    </div>


    <!-- ======================================================
         ERROR
    ======================================================= -->

    <% if (typeof error !== "undefined" && error) { %>

        <div class="error">

            <%= error %>

        </div>

    <% } %>


    <% if (product) { %>


        <%
        /*
         * ======================================================
         * CATEGORY NAME
         *
         * Product.category normally contains Category._id.
         *
         * Never expose the ObjectId to the customer.
         * ======================================================
         */

        let categoryName = "Other";


        if (
            product.category &&
            typeof product.category === "object" &&
            product.category.name
        ) {

            categoryName =
                product.category.name;

        } else if (
            product.categoryName
        ) {

            categoryName =
                product.categoryName;
        }


        /*
         * ======================================================
         * SUBSTATION PRODUCT UNITS
         *
         * IMPORTANT:
         *
         * These are NOT product.units.
         *
         * product.units represents the wider/global product
         * stock.
         *
         * product.substationUnits represents the quantity
         * physically allocated to THIS substation.
         * ======================================================
         */

        const substationUnits =
            Number(
                product.substationUnits || 0
            );


        /*
         * Prevent negative values from being displayed.
         */

        const availableUnits =
            Math.max(
                0,
                substationUnits
            );
        %>


        <!-- ==================================================
             PRODUCT DETAILS
        =================================================== -->

        <div class="detail-card">

            <div class="detail-grid">


                <!-- ==========================================
                     PRODUCT IMAGE
                =========================================== -->

                <div class="detail-image">

                    <% if (product.image) { %>

                        <img
                            src="<%= product.image %>"
                            alt="<%= product.name %>"
                        >

                    <% } else { %>

                        <div class="placeholder">

                            <i class="fas fa-box"></i>

                        </div>

                    <% } %>

                </div>


                <!-- ==========================================
                     PRODUCT INFORMATION
                =========================================== -->

                <div class="detail-content">


                    <!-- ======================================
                         SUBSTATION
                    ======================================= -->

                    <span class="detail-category">

                        <i class="fas fa-location-dot"></i>

                        <%= substation.name %>

                    </span>


                    <!-- ======================================
                         CATEGORY
                    ======================================= -->

                    <div class="detail-subcategory">

                        <i class="fas fa-layer-group"></i>

                        <%= categoryName %>

                        <% if (product.subcategory) { %>

                            · <%= product.subcategory %>

                        <% } %>

                    </div>


                    <!-- ======================================
                         PRODUCT NAME
                    ======================================= -->

                    <h1>

                        <%= product.name %>

                    </h1>


                    <!-- ======================================
                         PRICE
                    ======================================= -->

                    <div class="detail-price">

                        KSh

                        <%= Number(
                            product.unitSellPrice || 0
                        ).toLocaleString() %>

                    </div>


                    <!-- ======================================
                         DELIVERY
                    ======================================= -->

                    <div class="stock-days-badge">

                        <i class="fas fa-calendar-days"></i>

                        <strong>

                            <%= product.days || 0 %>

                        </strong>

                        day delivery

                    </div>


                    <!-- ======================================
                         DESCRIPTION
                    ======================================= -->

                    <div class="detail-description">

                        <%= product.description ||
                            "No description has been provided for this product." %>

                    </div>


                    <!-- ======================================
                         SUBSTATION STOCK
                    ======================================= -->

                    <% if (availableUnits > 0) { %>


                        <div class="stock-text detail-stock">

                            <strong>

                                <%= availableUnits.toLocaleString() %>

                            </strong>

                            units available at

                            <strong>

                                <%= substation.name %>

                            </strong>

                        </div>


                        <!-- ==================================
                             CUSTOMER CART
                        =================================== -->

                        <% if (
                            typeof user !== "undefined" &&
                            user
                        ) { %>


                            <form
                                action="/products/<%= product._id %>/cart"
                                method="POST"
                                class="cart-form"
                            >

                                <!-- --------------------------------
                                     SUBSTATION IDENTIFICATION
                                --------------------------------- -->

                                <input
                                    type="hidden"
                                    name="substationId"
                                    value="<%= substation._id %>"
                                >


                                <div class="qty-row">

                                    <label for="qty">

                                        <strong>
                                            Quantity
                                        </strong>

                                    </label>


                                    <input
                                        id="qty"
                                        name="qty"
                                        type="number"
                                        min="1"
                                        max="<%= availableUnits %>"
                                        value="1"
                                        required
                                    >

                                </div>


                                <button
                                    class="primary-btn"
                                    type="submit"
                                >

                                    <i class="fas fa-cart-plus"></i>

                                    Add to Cart

                                </button>

                            </form>


                        <% } else { %>


                            <a
                                class="primary-btn login-buy-btn"
                                href="/auth/login?next=/branch/<%= substation._id %>/product/<%= product._id %>"
                            >

                                <i class="fas fa-sign-in-alt"></i>

                                Log in to buy

                            </a>


                        <% } %>


                    <% } else { %>


                        <!-- ==================================
                             SUBSTATION OUT OF STOCK
                        =================================== -->

                        <div class="error detail-out-of-stock">

                            This product is currently out of stock at
                            <strong><%= substation.name %></strong>.

                        </div>


                    <% } %>


                    <!-- ======================================
                         CART SUCCESS MESSAGE
                    ======================================= -->

                    <% if (
                        typeof query !== "undefined" &&
                        query === "1"
                    ) { %>

                        <div class="notice">

                            Product added to your cart.

                        </div>

                    <% } %>


                </div>

            </div>

        </div>


        <!-- ==================================================
             DIRECTIONS OF USE
        =================================================== -->

        <% if (
            product.directionsOfUse &&
            (
                product.directionsOfUse.title ||
                (
                    product.directionsOfUse.items &&
                    product.directionsOfUse.items.length
                )
            )
        ) { %>


            <section
                class="directions-display"
                aria-labelledby="directionsOfUseTitle"
            >


                <!-- ==========================================
                     DIRECTIONS HEADER
                =========================================== -->

                <div class="directions-display-head">


                    <div class="directions-icon">

                        <i class="fas fa-list-check"></i>

                    </div>


                    <div>

                        <span class="directions-kicker">

                            Product guidance

                        </span>


                        <h2 id="directionsOfUseTitle">

                            <%= product.directionsOfUse.title ||
                                "Directions of Use" %>

                        </h2>


                        <p>

                            Follow these instructions when using
                            this product.

                        </p>

                    </div>


                </div>


                <!-- ==========================================
                     DIRECTIONS LIST
                =========================================== -->

                <% if (
                    product.directionsOfUse.items &&
                    product.directionsOfUse.items.length
                ) { %>


                    <div class="directions-display-list">


                        <% product.directionsOfUse.items.forEach(
                            (item, index) => {
                        %>


                            <article
                                class="directions-display-item"
                            >


                                <div
                                    class="directions-display-number"
                                >

                                    <%= index + 1 %>

                                </div>


                                <div>

                                    <h3>

                                        <%= item.subtitle %>

                                    </h3>


                                    <p>

                                        <%= item.content %>

                                    </p>

                                </div>


                            </article>


                        <% }) %>


                    </div>


                <% } %>


                <!-- ==========================================
                     DIRECTIONS FALLBACK
                =========================================== -->

                <% if (
                    !(
                        product.directionsOfUse.items &&
                        product.directionsOfUse.items.length
                    ) &&
                    product.directionsOfUse.title
                ) { %>


                    <p class="directions-display-note">

                        Please follow the product guidance provided
                        by the supplier.

                    </p>


                <% } %>


            </section>


        <% } %>


    <% } %>

</section>