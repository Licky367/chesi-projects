<section class="sales-page">

    <!-- =====================================================
         SALES HEADER
    ====================================================== -->

    <header class="sales-header">

        <div class="sales-header-icon">
            <i class="fas fa-chart-line"></i>
        </div>

        <div>
            <span class="sales-kicker">
                VERAH COSMETICS
            </span>

            <h1 class="sales-title">
                Sales
            </h1>

            <p class="sales-subtitle">
                Monitor sales, products, staff sales and customer arrears.
            </p>
        </div>

    </header>


    <!-- =====================================================
         SALES NAVIGATION
    ====================================================== -->

    <nav class="sales-navigation">

        <!-- SUMMARY -->

        <a
            href="/sales?tab=summary<%= salesQuerySuffix %>"
            class="sales-navigation-tab <%= activeTab === 'summary' ? 'active' : '' %>"
        >
            <i class="fas fa-chart-pie"></i>
            <span>Sales Summary</span>
        </a>


        <!-- STAFF SALES / SALES REPORT -->

        <a
            href="/sales?tab=staff-sales<%= salesQuerySuffix %>"
            class="sales-navigation-tab <%= activeTab === 'staff-sales' ? 'active' : '' %>"
        >
            <i class="fas fa-user-tie"></i>
            <span>Sales Report</span>
        </a>


        <!-- PRODUCTS -->

        <a
            href="/sales?tab=products<%= salesQuerySuffix %>"
            class="sales-navigation-tab <%= activeTab === 'products' ? 'active' : '' %>"
        >
            <i class="fas fa-boxes-stacked"></i>
            <span>Products</span>
        </a>


        <!-- ARREARS -->

        <a
            href="/sales?tab=arrears<%= salesQuerySuffix %>"
            class="sales-navigation-tab <%= activeTab === 'arrears' ? 'active' : '' %>"
        >
            <i class="fas fa-hand-holding-dollar"></i>
            <span>Customer Arrears</span>
        </a>

    </nav>


    <!-- =====================================================
         FILTER
         
         The service supplies activeFilter according to the
         currently selected tab.

         Therefore:
         summary      -> summaryFilter
         staff-sales  -> staffSalesFilter
         products     -> productsFilter
         arrears      -> arrearsFilter
    ====================================================== -->

    <div class="sales-filter-wrapper">

        <%- include("sales-partials/filter") %>

    </div>


    <!-- =====================================================
         SALES CONTENT
    ====================================================== -->

    <main class="sales-content">


        <!-- =================================================
             SALES SUMMARY
        ================================================== -->

        <section
            class="sales-panel <%= activeTab === 'summary' ? 'active' : '' %>"
            <%= activeTab === 'summary' ? '' : 'hidden' %>
        >

            <%- include("sales-partials/summary") %>

        </section>


        <!-- =================================================
             STAFF SALES / SALES REPORT
        ================================================== -->

        <section
            class="sales-panel <%= activeTab === 'staff-sales' ? 'active' : '' %>"
            <%= activeTab === 'staff-sales' ? '' : 'hidden' %>
        >

            <%- include("sales-partials/staff-sales") %>

        </section>


        <!-- =================================================
             PRODUCTS
        ================================================== -->

        <section
            class="sales-panel <%= activeTab === 'products' ? 'active' : '' %>"
            <%= activeTab === 'products' ? '' : 'hidden' %>
        >

            <%- include("sales-partials/products") %>

        </section>


        <!-- =================================================
             CUSTOMER ARREARS
        ================================================== -->

        <section
            class="sales-panel <%= activeTab === 'arrears' ? 'active' : '' %>"
            <%= activeTab === 'arrears' ? '' : 'hidden' %>
        >

            <%- include("sales-partials/arrears") %>

        </section>


    </main>

</section>