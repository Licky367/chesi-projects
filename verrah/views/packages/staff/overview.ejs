<div class="staff-overview-card">  <div class="staff-section-label">
    OVERVIEW
  </div>  <div class="staff-detail-overview-grid"><!-- CLIENT / SALES NAME -->

<div class="staff-info-card">

  <small>
    CLIENT
  </small>

  <strong>
    <%= clientName %>
  </strong>

</div>


<!-- PHONE -->

<div class="staff-info-card">

  <small>
    PHONE
  </small>

  <strong>

    <% if (clientPhone !== "—") { %>

      <a
        href="tel:<%= clientPhone %>"
        class="staff-phone-link"
      >
        <%= clientPhone %>
      </a>

    <% } else { %>

      —

    <% } %>

  </strong>

</div>


<!-- EMAIL -->

<div class="staff-info-card">

  <small>
    EMAIL
  </small>

  <strong>
    <%= clientEmail %>
  </strong>

</div>


<!-- CONFIRMED BY -->

<div class="staff-info-card">

  <small>
    CONFIRMED BY
  </small>

  <strong>
    <%= packageDoc.confirmedByStaffName || "Not yet" %>
  </strong>

</div>


<!-- CUSTOMER PICKUP SUBSTATION -->

<div class="staff-info-card">

  <small>
    SUBSTATION
  </small>

  <strong>

    <% if (selectedSubstation) { %>

      <%= selectedSubstation.name %>

      <% if (selectedSubstation.location) { %>

        <span
          style="
            display:block;
            margin-top:4px;
            font-size:12px;
            font-weight:500;
            opacity:.7;
          "
        >
          <%= selectedSubstation.location %>
        </span>

      <% } %>

    <% } else if (packageDoc.packageSubstation) { %>

      <%= String(
        packageDoc.packageSubstation
      ) %>

    <% } else { %>

      Not assigned

    <% } %>

  </strong>

</div>


<!-- CONFIRMED SUBSTATION -->

<% if (confirmedSubstation) { %>

  <div class="staff-info-card">

    <small>
      CONFIRMED AT
    </small>

    <strong>

      <%= confirmedSubstation.name || "—" %>

    </strong>

  </div>

<% } %>


<!-- PAID -->

<div class="staff-info-card">

  <small>
    PAID
  </small>

  <strong>
    KSh
    <%= totalPaid.toLocaleString() %>
  </strong>

</div>


<!-- ARREARS -->

<div class="staff-info-card">

  <small>
    ARREARS
  </small>

  <strong
    class="<%= arrears > 0
      ? 'staff-arrears-amount'
      : 'staff-cleared-amount'
    %>"
  >
    KSh
    <%= arrears.toLocaleString() %>
  </strong>

</div>

  </div></div>