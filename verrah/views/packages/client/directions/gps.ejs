<!-- =========================================================
     PACKAGE SUBSTATION GPS LOCATION CARD
     
     IMPORTANT:
     The package's packageSubstation is the authoritative
     customer pickup/destination location.
========================================================== --><%
const packageDestination =
(typeof packageSubstation !== "undefined" && packageSubstation)
? packageSubstation
: (
typeof packageDoc !== "undefined" &&
packageDoc &&
packageDoc.packageSubstation
? packageDoc.packageSubstation
: null
);

const gps =
    packageDestination &&
    packageDestination.gps
        ? packageDestination.gps
        : null;

const latitude =
    gps &&
    gps.latitude !== null &&
    gps.latitude !== undefined &&
    Number.isFinite(Number(gps.latitude))
        ? Number(gps.latitude)
        : null;

const longitude =
    gps &&
    gps.longitude !== null &&
    gps.longitude !== undefined &&
    Number.isFinite(Number(gps.longitude))
        ? Number(gps.longitude)
        : null;

const hasGps =
    latitude !== null &&
    longitude !== null;

const mapsDestination =
    hasGps
        ? `${latitude},${longitude}`
        : "";

%>

<!-- =========================================================
     CARD
========================================================== --><div class="substation-gps-card"><!-- =====================================================
     HEADER
====================================================== -->

<div class="substation-gps-header">

    <div class="substation-gps-icon">
        <span>⌖</span>
    </div>

    <div class="substation-gps-heading">

        <h3>
            GPS Location
        </h3>

        <p>
            Exact geographical position
        </p>

    </div>

</div>


<% if (hasGps) { %>


    <!-- =================================================
         COORDINATES
    ================================================== -->

    <div class="substation-gps-coordinates">

        <div class="substation-gps-coordinate">

            <span class="substation-gps-label">
                Latitude
            </span>

            <strong>
                <%= latitude.toFixed(6) %>
            </strong>

        </div>


        <div class="substation-gps-coordinate">

            <span class="substation-gps-label">
                Longitude
            </span>

            <strong>
                <%= longitude.toFixed(6) %>
            </strong>

        </div>

    </div>


    <!-- =================================================
         SUBSTATION NAME
    ================================================== -->

    <div class="substation-gps-location">

        <span class="substation-gps-location-dot"></span>

        <div>

            <span class="substation-gps-location-title">
                Pickup Substation
            </span>

            <span class="substation-gps-location-name">
                <%= packageDestination.name || "Substation" %>
            </span>

        </div>

    </div>


    <!-- =================================================
         LOCATION / ADDRESS
    ================================================== -->

    <% if (packageDestination.location) { %>

        <div class="substation-gps-address">

            <span class="substation-gps-address-label">
                Location
            </span>

            <span class="substation-gps-address-value">
                <%= packageDestination.location %>
            </span>

        </div>

    <% } %>


    <!-- =================================================
         DIRECTIONS
         
         Directions are based on the PACKAGE SUBSTATION,
         not the staff member's assigned substation.
    ================================================== -->

    <a
        class="substation-gps-directions"
        href="https://www.google.com/maps/dir/?api=1&destination=<%= encodeURIComponent(mapsDestination) %>"
        target="_blank"
        rel="noopener noreferrer"
    >

        <span class="substation-gps-directions-icon">
            ↗
        </span>

        <span>
            Get Directions
        </span>

    </a>


    <!-- =================================================
         RAW COORDINATES
    ================================================== -->

    <div class="substation-gps-coordinates-copy">

        <span>
            <%= latitude.toFixed(6) %>,
            <%= longitude.toFixed(6) %>
        </span>

    </div>


<% } else { %>


    <!-- =================================================
         GPS UNAVAILABLE
    ================================================== -->

    <div class="substation-gps-empty">

        <div class="substation-gps-empty-icon">
            ⌖
        </div>

        <h4>
            GPS location not available
        </h4>

        <p>
            Coordinates have not been added for this
            substation yet.
        </p>

    </div>


<% } %>

</div>