<%
/* ==========================================================
PACKAGE SUBSTATION ABOUT
DESCRIPTION

IMPORTANT:
For package pages, packageSubstation is the authoritative
customer pickup/destination substation.

substation remains only as a compatibility fallback.
========================================================== */

const packageDestination =
(typeof packageSubstation !== "undefined" &&
packageSubstation)
? packageSubstation
: (
typeof packageDoc !== "undefined" &&
packageDoc &&
packageDoc.packageSubstation
? packageDoc.packageSubstation
: (
typeof substation !== "undefined"
? substation
: null
)
);

%>

<section class="verah-sales-activities"><% if (
    !error &&
    packageDestination &&
    packageDestination.directions
) { %>

    <div class="verah-sales-content">

        <h2>
            Directions
        </h2>

        <p class="verah-sales-description">
            <%= packageDestination.description %>
        </p>

    </div>

<% } %>

</section>