<%
if (substation && substation.phoneNumber) {

const rawPhone = String(substation.phoneNumber).trim();

// Remove spaces, brackets, hyphens, etc.
const digits = rawPhone.replace(/\D/g, '');

let callPhone = rawPhone;
let whatsappPhone = digits;

// 9-digit Kenyan number: 712345678
if (digits.length === 9) {
callPhone = '0' + digits;
whatsappPhone = '254' + digits;
}

// 10-digit Kenyan number: 0712345678
else if (digits.length === 10 && digits.startsWith('0')) {
callPhone = digits;
whatsappPhone = '254' + digits.substring(1);
}

// 12-digit Kenyan number: 254712345678
else if (digits.length === 12 && digits.startsWith('254')) {
callPhone = '+' + digits;
whatsappPhone = digits;
}
%>

  <div class="substation-contact-float"><!-- CALL BUTTON -->
<a
  href="tel:<%= callPhone %>"
  class="substation-contact-button substation-call-button"
  aria-label="Call <%= substation.name %>"
  title="Call <%= substation.name %>"
>
  <span class="substation-contact-icon" aria-hidden="true">
    <svg
      viewBox="0 0 24 24"
      width="24"
      height="24"
      fill="currentColor"
    >
      <path d="M6.62 10.79a15.46 15.46 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.02-.24c1.12.37 2.33.57 3.57.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1C10.61 21 3 13.39 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1.02l-2.2 2.2z"/>
    </svg>
  </span>
</a>


<!-- WHATSAPP BUTTON -->
<a
  href="https://wa.me/<%= whatsappPhone %>"
  class="substation-contact-button substation-whatsapp-button"
  target="_blank"
  rel="noopener noreferrer"
  aria-label="WhatsApp <%= substation.name %>"
  title="WhatsApp <%= substation.name %>"
>
  <span class="substation-contact-icon" aria-hidden="true">

    <!-- REAL WHATSAPP ICON -->
    <svg
      viewBox="0 0 24 24"
      width="26"
      height="26"
      fill="currentColor"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.372-.025-.521-.075-.149-.669-1.611-.916-2.206-.242-.579-.487-.5-.669-.51-.173-.008-.372-.01-.57-.01-.198 0-.52.075-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.095 3.2 5.076 4.487.709.306 1.262.489 1.694.626.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.511-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.002 5.45-4.437 9.884-9.884 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.88 11.88 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.479-8.413"/>
    </svg>

  </span>
</a>

  </div><% } %>