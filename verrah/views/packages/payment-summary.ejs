<div class="payment-summary package-payment-summary">

  <div class="payment-summary-header">
    <strong>Payment</strong>

    <span
      id="package-payment-status"
      class="payment-status status-<%= packageDoc.paymentStatus %>"
    >
      <%= packageDoc.paymentStatus %>
    </span>
  </div>

  <div class="payment-summary-values">

    <div class="payment-summary-line">
      <span>Total amount</span>
      <strong>
        KSh
        <%= Number(packageDoc.totalAmount || 0).toLocaleString() %>
      </strong>
    </div>

    <div class="payment-summary-line">
      <span>Total paid</span>
      <strong>
        KSh
        <span id="package-total-paid">
          <%= Number(packageDoc.paidAmount || 0).toLocaleString() %>
        </span>
      </strong>
    </div>

    <div class="payment-summary-line payment-summary-arrears">
      <span>Arrears</span>
      <strong>
        KSh
        <span id="package-arrears">
          <%= Number(
            Math.max(
              0,
              Number(packageDoc.totalAmount || 0) -
              Number(packageDoc.paidAmount || 0)
            )
          ).toLocaleString() %>
        </span>
      </strong>
    </div>

  </div>
</div>

<script>
(function () {
  const packageId = "<%= packageDoc._id %>";

  const statusEl = document.getElementById(
    "package-payment-status"
  );

  const paidEl = document.getElementById(
    "package-total-paid"
  );

  const arrearsEl = document.getElementById(
    "package-arrears"
  );

  async function refresh() {
    try {
      const response = await fetch(
        `/packages/${packageId}/payment-summary`,
        {
          headers: {
            Accept: "application/json"
          }
        }
      );

      const data = await response.json();

      if (!data.ok) return;

      statusEl.textContent = data.paymentStatus;
      statusEl.className =
        "payment-status status-" + data.paymentStatus;

      paidEl.textContent = Number(
        data.totalPaid || 0
      ).toLocaleString();

      arrearsEl.textContent = Number(
        data.arrearsAmount || 0
      ).toLocaleString();
    } catch (err) {
      console.error(
        "Payment summary refresh:",
        err
      );
    }
  }

  refresh();
})();
</script>
