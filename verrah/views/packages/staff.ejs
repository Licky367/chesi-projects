<%
const safePackages = Array.isArray(packages) ? packages : [];

const tabCounts = counts || {
  all: safePackages.length,
  pending: 0,
  confirmed: 0,
  delivered: 0
};
%>

<section class="package-staff-page">

  <!-- =====================================================
       STAFF PACKAGE HEADER
  ====================================================== -->

  <div class="staff-package-header">

    <div class="staff-package-icon">
      <i class="fas fa-boxes-stacked"></i>
    </div>

    <div>
      <span class="staff-kicker">VERRAH COSMETICS</span>

      <h1>Package Management</h1>

      <p>
        <%= role === "admin"
          ? "Manage all client packages."
          : "Claim and process pending packages." %>
      </p>
    </div>

  </div>


  <!-- =====================================================
       ALERTS
  ====================================================== -->

  <% if (typeof error !== "undefined" && error) { %>

    <div class="staff-alert staff-alert-error">

      <i class="fas fa-circle-exclamation"></i>

      <span><%= error %></span>

    </div>

  <% } %>


  <% if (typeof success !== "undefined" && success) { %>

    <div class="staff-alert staff-alert-success">

      <i class="fas fa-circle-check"></i>

      <span><%= success %></span>

    </div>

  <% } %>


  <!-- =====================================================
       PACKAGE STATUS NAVIGATION
       
       Arranged like the SALES navigation tabs.
  ====================================================== -->

  <div class="staff-overview-card">

    <div class="staff-section-label">
      OVERVIEW
    </div>


    <nav
      class="sales-navigation staff-status-navigation"
      id="staff-status-navigation"
    >

      <% ["all", "pending", "confirmed", "delivered"].forEach(function (t) {

        const active = status === t;

        const icon =
          t === "all"
            ? "fa-box"
            : t === "pending"
              ? "fa-hourglass-half"
              : t === "confirmed"
                ? "fa-circle-check"
                : "fa-truck";

      %>

        <a
          href="/packages/staff?status=<%= t %>"
          class="sales-navigation-tab staff-status-navigation-tab <%= active ? 'active' : '' %>"
        >

          <i class="fas <%= icon %>"></i>

          <span>
            <%= t.charAt(0).toUpperCase() + t.slice(1) %>
          </span>

          <span class="staff-tab-count">
            <%= tabCounts[t] || 0 %>
          </span>

        </a>

      <% }); %>

    </nav>

  </div>


  <!-- =====================================================
       PACKAGES CONTENT
  ====================================================== -->

  <div class="staff-packages-card">

    <div class="staff-packages-heading">

      <div>

        <h2>
          Packages - <%= String(status || "all").toUpperCase() %>
        </h2>

        <p>
          <%= safePackages.length %> in this section
        </p>

      </div>

    </div>


    <!-- ===================================================
         PACKAGE LIST
    ==================================================== -->

    <div class="staff-package-list">

      <% if (!safePackages.length) { %>

        <div class="staff-empty">

          <i class="fas fa-inbox"></i>

          <strong>
            No packages in this section
          </strong>

        </div>

      <% } %>


      <% safePackages.forEach(function (pkg) {

        const arrears = Math.max(
          0,
          Number(pkg.totalAmount || 0) -
          Number(pkg.paidAmount || 0)
        );

        const hasOutstandingArrears =
          pkg.status === "delivered" &&
          arrears > 0;

        const displayClientName =
          pkg.isDirectSell === true
            ? (pkg.salesName || "Unknown")
            : (pkg.client?.name || "Unknown");

      %>

        <a
          href="/packages/staff/<%= pkg._id %>"
          class="staff-package-item"
        >

          <div class="staff-package-item-icon">

            <i class="fas fa-box"></i>

          </div>


          <div class="staff-package-item-main">

            <div class="staff-package-item-title">

              <span>
                Package <%= String(pkg._id).slice(-6) %>
              </span>


              <span class="package-status status-<%= pkg.status %>">

                <%= pkg.status %>

              </span>


              <% if (hasOutstandingArrears) { %>

                <span
                  class="staff-arrears-label"
                  title="Delivered package with outstanding arrears"
                  aria-label="Outstanding arrears"
                >
                  N
                </span>

              <% } %>

            </div>


            <div class="staff-package-item-meta">

              Client:
              <strong>
                <%= displayClientName %>
              </strong>

              <br>

              <%= (pkg.items || []).reduce(
                (s, i) => s + Number(i.qty || 0),
                0
              ) %> item(s)

              · KSh
              <%= Number(pkg.totalAmount || 0).toLocaleString() %>


              <% if (pkg.confirmedByStaffName) { %>

                <br>
                Staff:
                <%= pkg.confirmedByStaffName %>

              <% } %>


              <% if (hasOutstandingArrears) { %>

                <br>

                <span class="staff-arrears-text">
                  Arrears:
                  KSh <%= arrears.toLocaleString() %>
                </span>

              <% } %>

            </div>

          </div>


          <i class="fas fa-chevron-right staff-package-arrow"></i>

        </a>

      <% }); %>

    </div>

  </div>

</section>


<!-- =====================================================
     PACKAGE STATUS NAVIGATION SCRIPT
     
     Same horizontal-scroll behavior as SALES navigation.
====================================================== -->

<script>
document.addEventListener("DOMContentLoaded", function () {

    const navigation =
        document.getElementById("staff-status-navigation");

    if (!navigation) {
        return;
    }


    /*
     * Restore the navigation's horizontal position
     * after changing package status tabs.
     *
     * The active tab is NOT automatically scrolled
     * into view. This prevents the navigation from
     * jumping back toward the first tab.
     */

    const savedScrollLeft =
        sessionStorage.getItem(
            "staffStatusNavigationScrollLeft"
        );

    if (savedScrollLeft !== null) {

        requestAnimationFrame(function () {

            navigation.scrollLeft =
                Number(savedScrollLeft);

        });

        sessionStorage.removeItem(
            "staffStatusNavigationScrollLeft"
        );
    }


    /*
     * Save the exact horizontal position before
     * navigating to another package status.
     */

    const tabs =
        navigation.querySelectorAll(
            ".sales-navigation-tab"
        );

    tabs.forEach(function (tab) {

        tab.addEventListener("click", function () {

            sessionStorage.setItem(
                "staffStatusNavigationScrollLeft",
                String(navigation.scrollLeft)
            );

        });

    });

});
</script>

CSS adjustment

Because the new navigation uses the Sales tab classes, your existing ".sales-navigation" and ".sales-navigation-tab" styling can be reused. Add only the package-specific count styling if you don't already have it:

:::writing{variant="standard" id="74618" title="Package Status Tab CSS"}

/* =========================================================
   PACKAGE STATUS NAVIGATION
   Uses the same arrangement as SALES navigation
========================================================= */

.staff-status-navigation {
    display: flex;
    align-items: stretch;
    gap: 0;
    width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
}

.staff-status-navigation::-webkit-scrollbar {
    display: none;
}


/* Individual package status tab */

.staff-status-navigation-tab {
    flex: 0 0 auto;
    white-space: nowrap;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
}


/* Count beside the tab label */

.staff-status-navigation-tab .staff-tab-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 24px;
    height: 24px;
    padding: 0 7px;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1;
}


/* Keep the count visually integrated with the active tab */

.staff-status-navigation-tab.active .staff-tab-count {
    font-weight: 800;
}


/* Mobile */

@media (max-width: 576px) {

    .staff-status-navigation-tab {
        gap: 6px;
        padding-left: 14px;
        padding-right: 14px;
    }

}