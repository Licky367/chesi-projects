<section class="shop-page packages-page package-details-page">

  <% if (packageDoc) { %>

    <div class="package-summary-card">

      <div class="package-detail-header">

        <div>

          <span class="packages-kicker">
            ORDER DETAILS
          </span>

          <h1>
            Package <%= String(packageDoc._id).slice(-8) %>
          </h1>

          <p>
            <%= new Date(packageDoc.createdAt).toLocaleString() %>
          </p>

        </div>


        <span class="package-status status-<%= packageDoc.status %>">
          <%= packageDoc.status %>
        </span>

      </div>


      <!-- =====================================================
           PACKAGE ITEMS
      ====================================================== -->

      <div class="package-detail-items">

        <% packageDoc.items.forEach(item => { %>

          <div class="package-item-card">

            <div class="package-item-image">

              <% if (item.image) { %>

                <img
                  src="<%= item.image %>"
                  alt="<%= item.name %>"
                >

              <% } else { %>

                <i class="fas fa-box"></i>

              <% } %>

            </div>


            <div class="package-item-main">

              <h3>
                <%= item.name %>
              </h3>


              <div class="package-item-meta">

                Quantity:
                <strong>
                  <%= item.qty %>
                </strong>

              </div>


              <div class="package-item-meta">

                KSh
                <%= Number(item.price || 0).toLocaleString() %>
                each

              </div>

            </div>


            <strong class="package-item-total">

              KSh
              <%= Number(
                (item.price || 0) *
                (item.qty || 0)
              ).toLocaleString() %>

            </strong>

          </div>

        <% }) %>

      </div>


      <!-- =====================================================
           PAYMENT OVERVIEW
      ====================================================== -->

      <div class="package-payment-overview">

        <div class="package-total-line">

          <span>
            Total
          </span>

          <strong>
            KSh
            <%= Number(
              packageDoc.totalAmount || 0
            ).toLocaleString() %>
          </strong>

        </div>


        <div class="package-payment-meta">

          <span>

            Payment:

            <strong>

              <%= packageDoc.paymentMethod === 'mpesa'
                ? 'M-Pesa'
                : 'Pay upon delivery'
              %>

            </strong>

          </span>


          <% if (
            packageDoc.paymentStatus === 'paid' ||
            packageDoc.paymentStatus === 'confirmed'
          ) { %>

            <span class="payment-confirmed">

              <i class="fas fa-circle-check"></i>

              Paid

            </span>

          <% } %>


          <% if (packageDoc.mpesaReceiptNumber) { %>

            <span>

              Receipt:

              <strong>
                <%= packageDoc.mpesaReceiptNumber %>
              </strong>

            </span>

          <% } %>

        </div>

      </div>


      <!-- =====================================================
           PAY PACKAGE WITH M-PESA
      ====================================================== -->

      <% if (
        packageDoc.status !== 'delivered' &&
        packageDoc.paymentMethod === 'pay_on_delivery' &&
        packageDoc.paymentStatus !== 'paid' &&
        packageDoc.paymentStatus !== 'confirmed'
      ) { %>


        <div class="package-mpesa-card">

          <div class="package-mpesa-icon">

            <i class="fas fa-mobile-screen-button"></i>

          </div>


          <div class="package-mpesa-content">

            <h3>
              Pay this package with M-Pesa
            </h3>


            <p>
              You selected pay on delivery when placing this order.
              You can pay now using M-Pesa instead.
            </p>


            <form
              action="/packages/<%= packageDoc._id %>/pay"
              method="POST"
              class="package-mpesa-form"
            >

              <label for="package-phone">
                M-Pesa phone number
              </label>


              <input
                id="package-phone"
                name="phoneNumber"
                type="tel"
                inputmode="numeric"
                autocomplete="tel"
                placeholder="0712345678"
                required
              >


              <button
                type="submit"
                class="primary-btn packages-primary-btn"
              >

                <i class="fas fa-mobile-screen-button"></i>

                Pay KSh
                <%= Number(
                  packageDoc.totalAmount || 0
                ).toLocaleString() %>
                with M-Pesa

              </button>

            </form>

          </div>

        </div>


      <% } %>

    </div>


  <% } else { %>

    <!-- =======================================================
         PACKAGE NOT FOUND

         No persistent error box.
         The message is displayed through the popup modal below.
    ======================================================== -->

  <% } %>

</section>


<!-- ===========================================================
     PACKAGE MESSAGE POPUP MODAL
     
     Uses the SAME popup modal classes as the checkout modal.
============================================================ -->

<div
  id="checkoutMessageModal"
  class="checkout-message-modal"
  aria-hidden="true"
>

  <div
    class="checkout-message-overlay"
    id="checkoutMessageOverlay"
  ></div>


  <div
    class="checkout-message-box"
    role="dialog"
    aria-modal="true"
    aria-labelledby="checkoutMessageTitle"
  >

    <button
      type="button"
      class="checkout-message-close"
      id="checkoutMessageClose"
      aria-label="Close"
    >

      <i class="fas fa-xmark"></i>

    </button>


    <div
      class="checkout-message-icon"
      id="checkoutMessageIcon"
    >

      <i class="fas fa-circle-exclamation"></i>

    </div>


    <h3 id="checkoutMessageTitle">
      Package Error
    </h3>


    <p id="checkoutMessageText">
      Something went wrong.
    </p>


    <button
      type="button"
      class="checkout-message-button"
      id="checkoutMessageButton"
    >

      OK

    </button>

  </div>

</div>


<!-- ===========================================================
     PACKAGE MESSAGE MODAL JAVASCRIPT
============================================================ -->

<script>
(function () {

  const modal =
    document.getElementById(
      "checkoutMessageModal"
    );

  const modalOverlay =
    document.getElementById(
      "checkoutMessageOverlay"
    );

  const modalClose =
    document.getElementById(
      "checkoutMessageClose"
    );

  const modalButton =
    document.getElementById(
      "checkoutMessageButton"
    );

  const modalTitle =
    document.getElementById(
      "checkoutMessageTitle"
    );

  const modalText =
    document.getElementById(
      "checkoutMessageText"
    );

  const modalIcon =
    document.getElementById(
      "checkoutMessageIcon"
    );


  /* =========================================================
     SHOW MESSAGE
  ========================================================== */

  function showPackageMessage(
    message,
    type,
    title
  ) {

    if (!modal) {
      return;
    }


    modal.classList.remove(
      "checkout-message-success",
      "checkout-message-error"
    );


    if (type === "success") {

      modal.classList.add(
        "checkout-message-success"
      );


      modalTitle.textContent =
        title || "Success";


      modalIcon.innerHTML =
        '<i class="fas fa-circle-check"></i>';

    } else {

      modal.classList.add(
        "checkout-message-error"
      );


      modalTitle.textContent =
        title || "Package Error";


      modalIcon.innerHTML =
        '<i class="fas fa-circle-exclamation"></i>';

    }


    modalText.textContent =
      message || "Something went wrong.";


    modal.classList.add("show");

    modal.setAttribute(
      "aria-hidden",
      "false"
    );


    document.body.classList.add(
      "checkout-message-modal-open"
    );

  }


  /* =========================================================
     CLOSE MESSAGE
  ========================================================== */

  function closePackageMessage() {

    if (!modal) {
      return;
    }


    modal.classList.remove("show");

    modal.setAttribute(
      "aria-hidden",
      "true"
    );


    document.body.classList.remove(
      "checkout-message-modal-open"
    );

  }


  /* =========================================================
     CLOSE BUTTON
  ========================================================== */

  if (modalClose) {

    modalClose.addEventListener(
      "click",
      closePackageMessage
    );

  }


  /* =========================================================
     OK BUTTON
  ========================================================== */

  if (modalButton) {

    modalButton.addEventListener(
      "click",
      closePackageMessage
    );

  }


  /* =========================================================
     OVERLAY
  ========================================================== */

  if (modalOverlay) {

    modalOverlay.addEventListener(
      "click",
      closePackageMessage
    );

  }


  /* =========================================================
     ESC KEY
  ========================================================== */

  document.addEventListener(
    "keydown",
    function (event) {

      if (
        event.key === "Escape" &&
        modal &&
        modal.classList.contains("show")
      ) {

        closePackageMessage();

      }

    }
  );


  /* =========================================================
     SERVER-SIDE ERROR
  ========================================================== */

  <% if (typeof error !== "undefined" && error) { %>

    showPackageMessage(
      <%- JSON.stringify(error) %>,
      "error",
      "Package Error"
    );

  <% } else if (!packageDoc) { %>

    showPackageMessage(
      "Package not found.",
      "error",
      "Package Not Found"
    );

  <% } %>


  /* =========================================================
     SERVER-SIDE SUCCESS
  ========================================================== */

  <% if (typeof success !== "undefined" && success) { %>

    showPackageMessage(
      <%- JSON.stringify(success) %>,
      "success",
      "Success"
    );

  <% } %>

})();
</script>