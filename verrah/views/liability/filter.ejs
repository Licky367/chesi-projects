<%
/*

* ==========================================================
* LIABILITY FILTER
* ==========================================================
* 
* Filters ONLY Liability Records.
* 
* Controller supplies:
* activeTab
* activeFilterDate
* activeFilterPeriod
* activeFilterSubstation
* substations
* user
* 
* Query names:
* liabilityDate
* liabilityPeriod
* liabilitySubstation
* 
* ==========================================================
  */
  %>

<div class="sales-filter-toggle-wrapper"><button
    type="button"
    id="sales-filter-toggle"
    class="sales-filter-toggle"
    aria-expanded="false"
    aria-controls="sales-filter-form"
>
    filter date?
</button>

</div><form
    id="sales-filter-form"
    class="sales-filter"
    method="GET"
    action="/liability"
    hidden
><input
    type="hidden"
    name="tab"
    value="<%= activeTab || "records" %>"
>


<!-- =====================================================
     DATE
====================================================== -->

<div class="sales-filter-field">

    <label for="sales-filter-date">
        Date
    </label>

    <input
        id="sales-filter-date"
        type="date"
        name="liabilityDate"
        value="<%= activeFilterDate || "" %>"
        required
    >

</div>


<!-- =====================================================
     PERIOD
====================================================== -->

<div class="sales-filter-field">

    <label for="sales-filter-period">
        Period
    </label>

    <select
        id="sales-filter-period"
        name="liabilityPeriod"
    >

        <option
            value="day"
            <%= (activeFilterPeriod || "month") === "day"
                ? "selected"
                : "" %>
        >
            Day
        </option>

        <option
            value="month"
            <%= (activeFilterPeriod || "month") === "month"
                ? "selected"
                : "" %>
        >
            Month
        </option>

        <option
            value="year"
            <%= (activeFilterPeriod || "month") === "year"
                ? "selected"
                : "" %>
        >
            Year
        </option>

    </select>

</div>


<!-- =====================================================
     SUBSTATION
     ADMIN ONLY
====================================================== -->

<% if (user && user.role === "admin") { %>

    <div class="sales-filter-field">

        <label for="sales-filter-substation">
            Substation
        </label>

        <select
            id="sales-filter-substation"
            name="liabilitySubstation"
        >

            <option value="">
                All Substations
            </option>


            <% if (typeof substations !== "undefined" && substations.length) { %>

                <% substations.forEach(function (substation) { %>

                    <option
                        value="<%= substation._id %>"
                        <%= String(activeFilterSubstation || "") === String(substation._id)
                            ? "selected"
                            : "" %>
                    >
                        <%= substation.name %>
                    </option>

                <% }); %>

            <% } %>

        </select>

    </div>

<% } %>


<!-- =====================================================
     APPLY
====================================================== -->

<button
    type="submit"
    class="sales-filter-button"
>
    Apply Filter
</button>


<!-- =====================================================
     RESET
====================================================== -->

<a
    href="/liability?tab=<%= activeTab || "records" %>"
    class="sales-filter-clear"
>
    Reset
</a>

</form><script>
document.addEventListener("DOMContentLoaded", function () {

    const toggle =
        document.getElementById("sales-filter-toggle");

    const filter =
        document.getElementById("sales-filter-form");


    if (!toggle || !filter) {

        return;

    }


    toggle.addEventListener("click", function () {

        const isHidden =
            filter.hidden;


        filter.hidden =
            !isHidden;


        toggle.textContent =
            isHidden
                ? "hide filter"
                : "filter date?";


        toggle.setAttribute(
            "aria-expanded",
            isHidden
                ? "true"
                : "false"
        );

    });

});
</script>