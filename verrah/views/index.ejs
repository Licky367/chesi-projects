    width: 80px;

    height: 3px;

    margin-top: 30px;

    border-radius: 10px;

    background: #6f4e37;

}


/* =========================================================
   RIGHT SIDE — BEAUTY DISPLAY
========================================================= */

.vc-welcome-visual {

    position: relative;

    min-height: 470px;

    display: flex;

    align-items: center;

    justify-content: center;

}


/* Main circle */

.vc-beauty-circle {

    width: 390px;

    height: 390px;

    border-radius: 50%;

    background:
        radial-gradient(
            circle at 35% 30%,
            #fffaf5,
            #dfc7b4 70%,
            #c6a78e
        );

    box-shadow:
        0 30px 70px
        rgba(67,45,32,.18);

}


/* Decorative circles */

.vc-circle-small {

    position: absolute;

    border-radius: 50%;

}


.vc-circle-one {

    width: 75px;

    height: 75px;

    top: 55px;

    right: 45px;

    background: #b58b5a;

    opacity: .75;

}


.vc-circle-two {

    width: 45px;

    height: 45px;

    bottom: 70px;

    left: 35px;

    background: #6f4e37;

    opacity: .65;

}


/* =========================================================
   COSMETIC BOTTLE ILLUSTRATION
========================================================= */

.vc-cosmetic-bottle {

    position: absolute;

    width: 125px;

    height: 230px;

    border-radius: 18px 18px 28px 28px;

    background:
        linear-gradient(
            90deg,
            #5a3b29,
            #8a6248,
            #5a3b29
        );

    box-shadow:
        15px 20px 35px
        rgba(67,45,32,.22);

}


.vc-cosmetic-bottle::before {

    content: "";

    position: absolute;

    width: 58px;

    height: 55px;

    top: -48px;

    left: 50%;

    transform: translateX(-50%);

    border-radius: 7px 7px 2px 2px;

    background: #432d20;

}


.vc-cosmetic-bottle::after {

    content: "VERAH";

    position: absolute;

    top: 95px;

    left: 50%;

    transform:
        translateX(-50%)
        rotate(-90deg);

    color: #f6e8dc;

    font-family: Georgia, serif;

    font-size: 16px;

    letter-spacing: 3px;

}


/* =========================================================
   DECORATIVE CARD
========================================================= */

.vc-beauty-card {

    position: absolute;

    right: 5px;

    bottom: 55px;

    width: 155px;

    padding: 20px;

    border: 1px solid
        rgba(255,255,255,.7);

    border-radius: 18px;

    background:
        rgba(255,255,255,.65);

    backdrop-filter: blur(12px);

    box-shadow:
        0 15px 35px
        rgba(67,45,32,.10);

}


.vc-beauty-card span {

    display: block;

    margin-bottom: 7px;

    color: #b58b5a;

    font-size: 22px;

}


.vc-beauty-card strong {

    display: block;

    color: #432d20;

    font-family: Georgia, serif;

    font-size: 17px;

    font-weight: 500;

}


.vc-beauty-card small {

    display: block;

    margin-top: 5px;

    color: #756a63;

    font-size: 11px;

}


/* =========================================================
   RESPONSIVE
========================================================= */

@media (max-width: 800px) {

    .vc-welcome {

        min-height: calc(100vh - 120px);

        padding: 45px 15px;

    }


    .vc-welcome-inner {

        grid-template-columns: 1fr;

        gap: 25px;

        text-align: center;

    }


    .vc-welcome-content {

        padding: 10px;

    }


    .vc-welcome-label {

        justify-content: center;

    }


    .vc-welcome-text {

        margin-left: auto;

        margin-right: auto;

    }


    .vc-welcome-line {

        margin-left: auto;

        margin-right: auto;

    }


    .vc-welcome-visual {

        min-height: 380px;

    }


    .vc-beauty-circle {

        width: 300px;

        height: 300px;

    }


    .vc-cosmetic-bottle {

        width: 95px;

        height: 175px;

    }


    .vc-cosmetic-bottle::after {

        top: 70px;

        font-size: 13px;

    }


    .vc-beauty-card {

        right: 0;

        bottom: 20px;

    }

}


@media (max-width: 450px) {

    .vc-welcome h1 {

        font-size: 45px;

    }


    .vc-welcome-text {

        font-size: 15px;

    }


    .vc-welcome-visual {

        min-height: 330px;

    }


    .vc-beauty-circle {

        width: 260px;

        height: 260px;

    }


    .vc-beauty-card {

        width: 135px;

        padding: 15px;

    }

}

