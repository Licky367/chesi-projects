    line-height: 1.02;

}


.vc-welcome h1 span {

    display: block;

    color: #6f4e37;

    font-style: italic;

}


.vc-welcome-text {

    max-width: 520px;

    margin: 25px 0 0;

    color: #756a63;

    font-size: 17px;

    line-height: 1.8;

}


/* =========================================================
   DECORATIVE BUTTON / INDICATOR
========================================================= */

