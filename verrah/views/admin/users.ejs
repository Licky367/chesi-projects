<%
/* ==========================================================
views/admin/users.ejs
VERRAH COSMETICS — ADMIN USER MANAGEMENT
========================================================== */

const userList = Array.isArray(users) ? users : [];
const substationList = Array.isArray(substations) ? substations : [];

const currentTab = ["all", "admin", "staff", "client"].includes(
String(tab || "").toLowerCase()
)
? String(tab).toLowerCase()
: "all";

const filtered =
currentTab === "all"
? userList
: userList.filter(
account =>
String(account.role || "client").toLowerCase() === currentTab
);

const adminCount = userList.filter(
account => String(account.role || "").toLowerCase() === "admin"
).length;

const staffCount = userList.filter(
account => String(account.role || "").toLowerCase() === "staff"
).length;

const clientCount = userList.filter(
account => String(account.role || "").toLowerCase() === "client"
).length;

const totalCount = userList.length;

function active(value) {
return currentTab === value;
}

function assignedSubstationId(account) {
if (!account || !account.assignedSubstation) {
return "";
}

if (typeof account.assignedSubstation === "object") {
    return String(account.assignedSubstation._id || "");
}

return String(account.assignedSubstation);

}

function substationName(account) {
if (!account || !account.assignedSubstation) {
return "No substation assigned";
}

if (typeof account.assignedSubstation === "object") {
    return account.assignedSubstation.name || "Assigned substation";
}

const match = substationList.find(
    station => String(station._id) === String(account.assignedSubstation)
);

return match ? match.name : "Assigned substation";

}
%>

<section class="admin-page admin-users-page"><header class="admin-page-header">

    <div class="admin-header-icon">
        <i class="fas fa-users"></i>
    </div>

    <div class="admin-header-copy">

        <span class="admin-eyebrow">
            ADMINISTRATION
        </span>

        <h1>
            User Management
        </h1>

        <p>
            Organize accounts, roles and staff assignments.
        </p>

    </div>

</header>


<!-- ======================================================
     ACCOUNT OVERVIEW
======================================================= -->

<section class="admin-panel admin-overview-panel">

    <div class="admin-panel-heading">

        <div>

            <span class="admin-eyebrow">
                OVERVIEW
            </span>

            <h2>
                Accounts
            </h2>

        </div>

        <span class="admin-count-badge">
            <%= totalCount %>
        </span>

    </div>


    <!-- ==================================================
         FILTERS
    =================================================== -->

    <div class="admin-filter-grid">

        <a
            href="/auth/users?tab=all"
            class="admin-filter-card <%= active('all') ? 'is-active' : '' %>"
        >

            <span>
                <i class="fas fa-users"></i>
                Total Users
            </span>

            <strong>
                <%= totalCount %>
            </strong>

        </a>


        <a
            href="/auth/users?tab=admin"
            class="admin-filter-card <%= active('admin') ? 'is-active' : '' %>"
        >

            <span>
                <i class="fas fa-shield-halved"></i>
                Administrators
            </span>

            <strong>
                <%= adminCount %>
            </strong>

        </a>


        <a
            href="/auth/users?tab=staff"
            class="admin-filter-card <%= active('staff') ? 'is-active' : '' %>"
        >

            <span>
                <i class="fas fa-user-gear"></i>
                Staff
            </span>

            <strong>
                <%= staffCount %>
            </strong>

        </a>


        <a
            href="/auth/users?tab=client"
            class="admin-filter-card <%= active('client') ? 'is-active' : '' %>"
        >

            <span>
                <i class="fas fa-user"></i>
                Clients
            </span>

            <strong>
                <%= clientCount %>
            </strong>

        </a>

    </div>


    <a
        href="/auth/users/invitation"
        class="admin-primary-action"
    >

        <i class="fas fa-user-plus"></i>

        Invite User

    </a>

</section>



<!-- ======================================================
     USER DIRECTORY
======================================================= -->

<section class="admin-panel admin-user-list-panel">

    <div class="admin-panel-heading admin-list-heading">

        <div>

            <span class="admin-eyebrow">
                USER DIRECTORY
            </span>

            <h2>
                Users — <%= currentTab.toUpperCase() %>
            </h2>

            <p>
                <%= filtered.length %> accounts in this section.
            </p>

        </div>

        <span class="admin-tab-badge">
            <%= currentTab %>
        </span>

    </div>


    <% if (!filtered.length) { %>

        <div class="admin-empty-state">

            <div class="admin-empty-icon">
                <i class="fas fa-user-slash"></i>
            </div>

            <h3>
                No users found
            </h3>

            <p>
                There are no accounts in this section yet.
            </p>

        </div>

    <% } else { %>


        <div class="admin-user-list">

            <% filtered.forEach(account => { %>

                <%
                const userId = String(account._id || "");
                const role = String(account.role || "client").toLowerCase();
                const menuId = "admin-user-menu-" + userId;
                const assignedId = assignedSubstationId(account);
                %>


                <!-- ==========================================
                     USER CARD
                =========================================== -->

                <article
                    class="admin-user-card"
                    data-user-id="<%= userId %>"
                >

                    <div class="admin-user-avatar">

                        <i class="fas fa-user"></i>

                    </div>


                    <div class="admin-user-main">

                        <strong class="admin-user-name">
                            <%= account.name || "Unnamed User" %>
                        </strong>


                        <span class="admin-role-pill role-<%= role %>">
                            <%= role %>
                        </span>


                        <span class="admin-user-email">

                            <i class="fas fa-envelope"></i>

                            <%= account.email || "No email address" %>

                        </span>


                        <% if (role === "staff") { %>

                            <span class="admin-user-assignment">

                                <i class="fas fa-location-dot"></i>

                                <%= substationName(account) %>

                            </span>

                        <% } %>

                    </div>


                    <!-- =======================================
                         MANAGE BUTTON
                    ======================================== -->

                    <button
                        type="button"
                        class="admin-menu-button"
                        data-menu-target="<%= menuId %>"
                        aria-label="Manage <%= account.name || 'user' %>"
                        aria-expanded="false"
                    >

                        <span class="admin-menu-button-label">
                            Manage
                        </span>

                        <span class="admin-menu-button-dots">
                            <i class="fas fa-ellipsis-vertical"></i>
                        </span>

                    </button>

                </article>



                <!-- ==========================================
                     MANAGEMENT PANEL
                =========================================== -->

                <div
                    id="<%= menuId %>"
                    class="admin-user-menu"
                    hidden
                    data-user-menu
                >


                    <!-- ======================================
                         ROLE ASSIGNMENT
                    ======================================= -->

                    <div class="admin-user-menu-section">

                        <div class="admin-user-menu-title">

                            <i class="fas fa-user-shield"></i>

                            <span>
                                Account Role
                            </span>

                        </div>


                        <form
                            action="/auth/users/<%= userId %>/role"
                            method="POST"
                            class="admin-role-form"
                        >

                            <label
                                for="role-<%= userId %>"
                            >
                                Change role
                            </label>


                            <div class="admin-role-form-row">

                                <select
                                    id="role-<%= userId %>"
                                    name="role"
                                    required
                                >

                                    <option
                                        value="admin"
                                        <%= role === "admin" ? "selected" : "" %>
                                    >
                                        Administrator
                                    </option>

                                    <option
                                        value="staff"
                                        <%= role === "staff" ? "selected" : "" %>
                                    >
                                        Staff
                                    </option>

                                    <option
                                        value="client"
                                        <%= role === "client" ? "selected" : "" %>
                                    >
                                        Client
                                    </option>

                                </select>


                                <button
                                    type="submit"
                                    class="admin-save-role-button"
                                >

                                    <i class="fas fa-check"></i>

                                    Save Role

                                </button>

                            </div>

                        </form>

                    </div>



                    <!-- ======================================
                         SUBSTATION ASSIGNMENT

                         Only staff can have a substation.
                    ======================================= -->

                    <% if (role === "staff") { %>

                        <div class="admin-user-menu-section">

                            <div class="admin-user-menu-title">

                                <i class="fas fa-location-dot"></i>

                                <span>
                                    Substation Assignment
                                </span>

                            </div>


                            <form
                                action="/auth/users/<%= userId %>/substation"
                                method="POST"
                                class="admin-substation-form"
                            >

                                <label
                                    for="substation-<%= userId %>"
                                >
                                    Assigned substation
                                </label>


                                <div class="admin-substation-form-row">

                                    <select
                                        id="substation-<%= userId %>"
                                        name="assignedSubstation"
                                        required
                                    >

                                        <option value="">
                                            Select a substation
                                        </option>


                                        <% substationList.forEach(station => { %>

                                            <option
                                                value="<%= station._id %>"
                                                <%= assignedId === String(station._id) ? "selected" : "" %>
                                            >
                                                <%= station.name %>

                                                <% if (station.location) { %>

                                                    — <%= station.location %>

                                                <% } %>

                                            </option>

                                        <% }) %>

                                    </select>


                                    <button
                                        type="submit"
                                        class="admin-save-substation-button"
                                    >

                                        <i class="fas fa-location-arrow"></i>

                                        Save Assignment

                                    </button>

                                </div>


                                <% if (!substationList.length) { %>

                                    <p class="admin-assignment-warning">

                                        <i class="fas fa-triangle-exclamation"></i>

                                        No active substations are currently
                                        available. Create or activate a
                                        substation first.

                                    </p>

                                <% } %>

                            </form>

                        </div>

                    <% } %>

                </div>

            <% }) %>

        </div>

    <% } %>

</section>

</section><!-- ==========================================================
     USER MANAGEMENT JAVASCRIPT
========================================================== --><script>

(function () {

    "use strict";


    function closeAllUserMenus(exceptMenu) {

        document
            .querySelectorAll("[data-user-menu]")
            .forEach(function (menu) {

                if (menu !== exceptMenu) {

                    menu.hidden = true;


                    const button = document.querySelector(
                        '[data-menu-target="' + menu.id + '"]'
                    );


                    if (button) {

                        button.setAttribute(
                            "aria-expanded",
                            "false"
                        );

                    }

                }

            });

    }



    document
        .querySelectorAll(
            ".admin-menu-button[data-menu-target]"
        )
        .forEach(function (button) {

            button.addEventListener(
                "click",
                function (event) {

                    event.preventDefault();
                    event.stopPropagation();


                    const menuId =
                        button.getAttribute(
                            "data-menu-target"
                        );


                    const menu =
                        document.getElementById(menuId);


                    if (!menu) {

                        console.error(
                            "User management menu not found:",
                            menuId
                        );

                        return;

                    }


                    const opening = menu.hidden;


                    closeAllUserMenus(menu);


                    menu.hidden = !opening;


                    button.setAttribute(
                        "aria-expanded",
                        String(opening)
                    );

                }
            );

        });



    document.addEventListener(
        "click",
        function (event) {

            if (
                event.target.closest(
                    ".admin-user-menu"
                ) ||
                event.target.closest(
                    ".admin-menu-button"
                )
            ) {

                return;

            }


            closeAllUserMenus();

        }
    );



    document.addEventListener(
        "keydown",
        function (event) {

            if (event.key === "Escape") {

                closeAllUserMenus();

            }

        }
    );

})();

</script>