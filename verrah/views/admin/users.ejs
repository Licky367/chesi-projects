<%
/* ==========================================================
   views/admin/users.ejs

   VERRAH COSMETICS
   ADMIN USER MANAGEMENT

   IMPORTANT:
   - Manage uses native <details>/<summary>
   - No JavaScript is required to open the menu
   - Role changes POST to /auth/users/:id/role
   - Staff assignments POST to /auth/users/:id/substation
========================================================== */

const userList = Array.isArray(users) ? users : [];

const substationList = Array.isArray(substations)
    ? substations
    : [];

const requestedTab = String(tab || "").toLowerCase();

const currentTab = [
    "all",
    "admin",
    "staff",
    "client"
].includes(requestedTab)
    ? requestedTab
    : "all";

const filteredUsers =
    currentTab === "all"
        ? userList
        : userList.filter(function (account) {
            return (
                String(account.role || "client").toLowerCase() ===
                currentTab
            );
        });

const adminCount = userList.filter(function (account) {
    return String(account.role || "").toLowerCase() === "admin";
}).length;

const staffCount = userList.filter(function (account) {
    return String(account.role || "").toLowerCase() === "staff";
}).length;

const clientCount = userList.filter(function (account) {
    return String(account.role || "").toLowerCase() === "client";
}).length;

const totalCount = userList.length;

function isActiveTab(name) {
    return currentTab === name;
}

function getAssignedSubstationId(account) {
    if (!account || !account.assignedSubstation) {
        return "";
    }

    if (
        typeof account.assignedSubstation === "object" &&
        account.assignedSubstation._id
    ) {
        return String(account.assignedSubstation._id);
    }

    return String(account.assignedSubstation);
}

function getAssignedSubstationName(account) {
    if (!account || !account.assignedSubstation) {
        return "";
    }

    if (
        typeof account.assignedSubstation === "object" &&
        account.assignedSubstation.name
    ) {
        return account.assignedSubstation.name;
    }

    return "";
}
%>


<section class="admin-page admin-users-page">


    <!-- ======================================================
         PAGE HEADER
    ======================================================= -->

    <header class="admin-page-header">

        <div class="admin-header-icon">
            <i class="fas fa-users"></i>
        </div>

        <div class="admin-header-copy">

            <span class="admin-eyebrow">
                ADMINISTRATION
            </span>

            <h1>
                User Management
            </h1>

            <p>
                Organize accounts, roles and staff assignments.
            </p>

        </div>

    </header>


    <!-- ======================================================
         ACCOUNT OVERVIEW
    ======================================================= -->

    <section class="admin-panel admin-overview-panel">

        <div class="admin-panel-heading">

            <div>

                <span class="admin-eyebrow">
                    OVERVIEW
                </span>

                <h2>
                    Accounts
                </h2>

            </div>

            <span class="admin-count-badge">
                <%= totalCount %>
            </span>

        </div>


        <!-- ==================================================
             FILTERS
        =================================================== -->

        <div class="admin-filter-grid">


            <a
                href="/auth/users?tab=all"
                class="admin-filter-card <%= isActiveTab('all') ? 'is-active' : '' %>"
            >

                <span>
                    <i class="fas fa-users"></i>
                    Total Users
                </span>

                <strong>
                    <%= totalCount %>
                </strong>

            </a>


            <a
                href="/auth/users?tab=admin"
                class="admin-filter-card <%= isActiveTab('admin') ? 'is-active' : '' %>"
            >

                <span>
                    <i class="fas fa-shield-halved"></i>
                    Administrators
                </span>

                <strong>
                    <%= adminCount %>
                </strong>

            </a>


            <a
                href="/auth/users?tab=staff"
                class="admin-filter-card <%= isActiveTab('staff') ? 'is-active' : '' %>"
            >

                <span>
                    <i class="fas fa-user-gear"></i>
                    Staff
                </span>

                <strong>
                    <%= staffCount %>
                </strong>

            </a>


            <a
                href="/auth/users?tab=client"
                class="admin-filter-card <%= isActiveTab('client') ? 'is-active' : '' %>"
            >

                <span>
                    <i class="fas fa-user"></i>
                    Clients
                </span>

                <strong>
                    <%= clientCount %>
                </strong>

            </a>


        </div>


        <!-- ==================================================
             INVITE
        =================================================== -->

        <a
            href="/auth/users/invitation"
            class="admin-primary-action"
        >
            <i class="fas fa-user-plus"></i>
            Invite User
        </a>

    </section>


    <!-- ======================================================
         USER DIRECTORY
    ======================================================= -->

    <section class="admin-panel admin-user-list-panel">


        <div class="admin-panel-heading admin-list-heading">

            <div>

                <span class="admin-eyebrow">
                    USER DIRECTORY
                </span>

                <h2>
                    Users — <%= currentTab.toUpperCase() %>
                </h2>

                <p>
                    <%= filteredUsers.length %> accounts in this section.
                </p>

            </div>

            <span class="admin-tab-badge">
                <%= currentTab %>
            </span>

        </div>


        <!-- ==================================================
             EMPTY STATE
        =================================================== -->

        <% if (!filteredUsers.length) { %>

            <div class="admin-empty-state">

                <div class="admin-empty-icon">
                    <i class="fas fa-user-slash"></i>
                </div>

                <h3>
                    No users found
                </h3>

                <p>
                    There are no accounts in this section yet.
                </p>

            </div>


        <% } else { %>


            <!-- ==================================================
                 USER LIST
            =================================================== -->

            <div class="admin-user-list">


                <% filteredUsers.forEach(function (account) { %>

                    <%
                        const userId = String(account._id || "");

                        const userRole =
                            String(
                                account.role || "client"
                            ).toLowerCase();

                        const assignedSubstationId =
                            getAssignedSubstationId(account);

                        const assignedSubstationName =
                            getAssignedSubstationName(account);
                    %>


                    <!-- ==================================================
                         USER ITEM
                    =================================================== -->

                    <div
                        class="admin-user-item"
                        data-user-id="<%= userId %>"
                    >


                        <!-- ==================================================
                             USER CARD
                        =================================================== -->

                        <article class="admin-user-card">


                            <!-- ==================================================
                                 AVATAR
                            =================================================== -->

                            <div class="admin-user-avatar">

                                <i class="fas fa-user"></i>

                            </div>


                            <!-- ==================================================
                                 USER INFORMATION
                            =================================================== -->

                            <div class="admin-user-main">


                                <strong class="admin-user-name">
                                    <%= account.name || "Unnamed User" %>
                                </strong>


                                <span
                                    class="admin-role-pill role-<%= userRole %>"
                                >
                                    <%= userRole %>
                                </span>


                                <span class="admin-user-email">

                                    <i class="fas fa-envelope"></i>

                                    <%= account.email || "No email address" %>

                                </span>


                                <% if (userRole === "staff") { %>

                                    <span class="admin-user-assignment">

                                        <i class="fas fa-location-dot"></i>

                                        <% if (assignedSubstationName) { %>

                                            <%= assignedSubstationName %>

                                        <% } else { %>

                                            No substation assigned

                                        <% } %>

                                    </span>

                                <% } %>


                            </div>


                            <!-- ==================================================
                                 NATIVE MANAGE CONTROL

                                 IMPORTANT:
                                 This is deliberately NOT a button that
                                 depends on JavaScript.

                                 <details> handles opening/closing itself.
                            =================================================== -->

                            <details class="admin-user-management">


                                <summary
                                    class="admin-menu-button"
                                    aria-label="Manage <%= account.name || 'user' %>"
                                >

                                    <span class="admin-menu-button-label">
                                        Manage
                                    </span>

                                    <span class="admin-menu-button-dots">
                                        <i class="fas fa-ellipsis-vertical"></i>
                                    </span>

                                </summary>


                                <!-- ==================================================
                                     MANAGEMENT PANEL
                                =================================================== -->

                                <div class="admin-user-menu">


                                    <!-- ==================================================
                                         ROLE MANAGEMENT
                                    =================================================== -->

                                    <div class="admin-user-menu-section">


                                        <div class="admin-user-menu-title">

                                            <i class="fas fa-user-shield"></i>

                                            <span>
                                                Account Role
                                            </span>

                                        </div>


                                        <form
                                            action="/auth/users/<%= userId %>/role"
                                            method="POST"
                                            class="admin-role-form"
                                        >


                                            <label
                                                for="role-<%= userId %>"
                                            >
                                                Change role
                                            </label>


                                            <div class="admin-role-form-row">


                                                <select
                                                    id="role-<%= userId %>"
                                                    name="role"
                                                    required
                                                >

                                                    <option
                                                        value="admin"
                                                        <%= userRole === "admin" ? "selected" : "" %>
                                                    >
                                                        Administrator
                                                    </option>


                                                    <option
                                                        value="staff"
                                                        <%= userRole === "staff" ? "selected" : "" %>
                                                    >
                                                        Staff
                                                    </option>


                                                    <option
                                                        value="client"
                                                        <%= userRole === "client" ? "selected" : "" %>
                                                    >
                                                        Client
                                                    </option>

                                                </select>


                                                <button
                                                    type="submit"
                                                    class="admin-save-role-button"
                                                >

                                                    <i class="fas fa-check"></i>

                                                    Save Role

                                                </button>


                                            </div>

                                        </form>

                                    </div>


                                    <!-- ==================================================
                                         STAFF SUBSTATION ASSIGNMENT

                                         Only staff accounts can have a
                                         substation assigned.
                                    =================================================== -->

                                    <% if (userRole === "staff") { %>


                                        <div
                                            class="admin-user-menu-section admin-staff-section"
                                        >


                                            <div class="admin-user-menu-title">

                                                <i class="fas fa-location-dot"></i>

                                                <span>
                                                    Staff Assignment
                                                </span>

                                            </div>


                                            <form
                                                action="/auth/users/<%= userId %>/substation"
                                                method="POST"
                                                class="admin-substation-form"
                                            >


                                                <label
                                                    for="substation-<%= userId %>"
                                                >
                                                    Assigned Substation
                                                </label>


                                                <div
                                                    class="admin-substation-form-row"
                                                >


                                                    <select
                                                        id="substation-<%= userId %>"
                                                        name="assignedSubstation"
                                                    >

                                                        <option value="">
                                                            No substation assigned
                                                        </option>


                                                        <% substationList.forEach(function (substation) { %>

                                                            <option
                                                                value="<%= substation._id %>"
                                                                <%= assignedSubstationId === String(substation._id) ? "selected" : "" %>
                                                            >

                                                                <%= substation.name %>

                                                                <% if (substation.location) { %>
                                                                    — <%= substation.location %>
                                                                <% } %>

                                                            </option>

                                                        <% }); %>


                                                    </select>


                                                    <button
                                                        type="submit"
                                                        class="admin-save-substation-button"
                                                    >

                                                        <i class="fas fa-check"></i>

                                                        Save Assignment

                                                    </button>


                                                </div>


                                                <% if (!substationList.length) { %>

                                                    <p class="admin-assignment-warning">

                                                        <i class="fas fa-circle-exclamation"></i>

                                                        No active substations are available.

                                                    </p>

                                                <% } %>


                                            </form>


                                        </div>


                                    <% } %>


                                </div>


                            </details>


                        </article>


                    </div>


                <% }); %>


            </div>


        <% } %>


    </section>


</section>