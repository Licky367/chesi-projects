<!-- =========================================================
     VERRAH COSMETICS
     SCROLLABLE TABS + CARD PANELS
========================================================= -->

<div class="verrah-tabs-container">

    <!-- =====================================================
         SCROLLABLE TABS
    ====================================================== -->

    <div class="verrah-tabs" role="tablist">

        <!-- DEFAULT TAB -->

        <button
            type="button"
            class="verrah-tab active"
            role="tab"
            aria-selected="true"
            data-tab="welcome"
        >
            Welcome
        </button>


        <!-- BRANCH -->

        <button
            type="button"
            class="verrah-tab"
            role="tab"
            aria-selected="false"
            data-tab="branch"
        >
            Branch
        </button>


        <!-- CATEGORY -->

        <button
            type="button"
            class="verrah-tab"
            role="tab"
            aria-selected="false"
            data-tab="category"
        >
            Categories
        </button>


        <!-- STOCK -->

        <button
            type="button"
            class="verrah-tab"
            role="tab"
            aria-selected="false"
            data-tab="stock"
        >
            Stock
        </button>


        <!-- PRODUCTS -->

        <button
            type="button"
            class="verrah-tab"
            role="tab"
            aria-selected="false"
            data-tab="products"
        >
            Products
        </button>


        <!-- DELIVERIES -->

        <button
            type="button"
            class="verrah-tab"
            role="tab"
            aria-selected="false"
            data-tab="deliveries"
        >
            Deliveries
        </button>


        <!-- SALES -->

        <button
            type="button"
            class="verrah-tab"
            role="tab"
            aria-selected="false"
            data-tab="sales"
        >
            Sales
        </button>

    </div>


    <!-- =====================================================
         TAB CONTENT
    ====================================================== -->

    <div class="verrah-tab-content">


        <!-- WELCOME / HERO
             DEFAULT
        -->

        <div
            class="verrah-tab-panel active"
            id="welcome"
            role="tabpanel"
        >
            <%- include("hero") %>
        </div>


        <!-- BRANCH -->

        <div
            class="verrah-tab-panel"
            id="branch"
            role="tabpanel"
            hidden
        >
            <%- include("branch") %>
        </div>


        <!-- CATEGORY -->

        <div
            class="verrah-tab-panel"
            id="category"
            role="tabpanel"
            hidden
        >
            <%- include("category") %>
        </div>


        <!-- STOCK -->

        <div
            class="verrah-tab-panel"
            id="stock"
            role="tabpanel"
            hidden
        >
            <%- include("stock") %>
        </div>


        <!-- PRODUCTS -->

        <div
            class="verrah-tab-panel"
            id="products"
            role="tabpanel"
            hidden
        >
            <%- include("products") %>
        </div>


        <!-- DELIVERIES -->

        <div
            class="verrah-tab-panel"
            id="deliveries"
            role="tabpanel"
            hidden
        >
            <%- include("deliveries") %>
        </div>


        <!-- SALES -->

        <div
            class="verrah-tab-panel"
            id="sales"
            role="tabpanel"
            hidden
        >
            <%- include("sales") %>
        </div>

    </div>

</div>


<!-- =========================================================
     TAB SWITCHING
========================================================= -->

<script>

(function () {

    const tabs =
        document.querySelectorAll(".verrah-tab");

    const panels =
        document.querySelectorAll(".verrah-tab-panel");


    tabs.forEach(function (tab) {

        tab.addEventListener("click", function () {

            const target =
                this.dataset.tab;


            /* -----------------------------------------------
               UPDATE TAB BUTTONS
            ----------------------------------------------- */

            tabs.forEach(function (item) {

                const isActive =
                    item === tab;

                item.classList.toggle(
                    "active",
                    isActive
                );

                item.setAttribute(
                    "aria-selected",
                    isActive ? "true" : "false"
                );

            });


            /* -----------------------------------------------
               UPDATE CONTENT
            ----------------------------------------------- */

            panels.forEach(function (panel) {

                const isActive =
                    panel.id === target;

                panel.classList.toggle(
                    "active",
                    isActive
                );

                panel.hidden =
                    !isActive;

            });


            /* -----------------------------------------------
               KEEP ACTIVE TAB VISIBLE
            ----------------------------------------------- */

            tab.scrollIntoView({
                behavior: "smooth",
                block: "nearest",
                inline: "center"
            });

        });

    });

})();

</script>