<!-- =========================================================
     VERAH COSMETICS — SERVICES
========================================================= -->

<section class="verah-services">

    <div class="verah-services-header">

        <div>
            <span class="verah-services-eyebrow">
                VERAH COSMETICS
            </span>

            <h2>
                Our Services
            </h2>
        </div>

    </div>


    <div class="verah-services-scroll">


        <!-- =================================================
             ADMIN — ADD SERVICE
        ================================================== -->

        <% if (user && user.role === "admin") { %>

            <a
                href="/services/add"
                class="verah-service-card verah-add-service-card"
            >

                <div class="verah-service-card-visual">

                    <div class="verah-add-service-icon">
                        +
                    </div>

                </div>


                <div class="verah-service-card-info">

                    <h3>
                        Add Service
                    </h3>

                    <span>
                        Create a new service
                    </span>

                </div>

            </a>

        <% } %>


        <!-- =================================================
             SERVICES
        ================================================== -->

        <% if (services && services.length > 0) { %>

            <% services.forEach(function(service) { %>

                <div class="verah-service-card">

                    <!-- SERVICE LINK -->
                    <a
                        href="/services/<%= service._id %>"
                        class="verah-service-card-link"
                    >

                        <!-- IMAGE -->
                        <div class="verah-service-card-visual">

                            <% if (service.image) { %>

                                <img
                                    src="<%= service.image %>"
                                    alt="<%= service.name %>"
                                    class="verah-service-card-image"
                                    loading="lazy"
                                >

                            <% } else { %>

                                <div class="verah-service-card-placeholder">
                                    VERAH
                                </div>

                            <% } %>

                        </div>


                        <!-- INFORMATION -->
                        <div class="verah-service-card-info">

                            <h3>
                                <%= service.name %>
                            </h3>


                            <div class="verah-service-card-meta">

                                <% if (
                                    service.price !== undefined &&
                                    service.price !== null
                                ) { %>

                                    <strong>
                                        KSh <%= Number(
                                            service.price
                                        ).toLocaleString() %>
                                    </strong>

                                <% } %>


                                <% if (service.duration) { %>

                                    <span>
                                        <%= service.duration %>
                                    </span>

                                <% } %>

                            </div>

                        </div>

                    </a>


                    <!-- =================================================
                         ADMIN — EDIT SERVICE
                    ================================================== -->

                    <% if (user && user.role === "admin") { %>

                        <a
                            href="/services/add/<%= service._id %>"
                            class="verah-edit-service"
                            aria-label="Edit <%= service.name %>"
                            onclick="event.stopPropagation();"
                        >
                            <i class="fas fa-pen"></i>
                            <span>Edit</span>
                        </a>

                    <% } %>

                </div>

            <% }); %>


        <% } else { %>

            <div class="verah-services-empty">

                No services available yet.

            </div>

        <% } %>

    </div>

</section>