<!-- =========================================================
     VERRAH COSMETICS
     HORIZONTAL EJS CARDS
========================================================= -->

<section class="verrah-card-section">

    <div class="verrah-card-heading">

        <h2>
            Verrah Cosmetics
        </h2>

        <span>
            Swipe to explore
        </span>

    </div>


    <!-- =====================================================
         HORIZONTAL SCROLL CONTAINER
    ====================================================== -->

    <div class="verrah-horizontal-scroll">

        <div class="verrah-card-track">


            <!-- HERO -->

            <div class="verrah-scroll-card">
                <%- include("hero") %>
            </div>

         <!-- DELIVERIES -->
            <div class="verrah-scroll-card">
                <%- include("deliveries") %>
            </div>


            <!-- SALES-->

            <div class="verrah-scroll-card">
                <%- include("sales") %>
            </div>


        </div>

    </div>

</section>