<%
const pendingInvitations = Array.isArray(invitations) ? invitations : [];
const invitationDate = (value) => {
  if (!value) return "";
  const d = new Date(value);
  return Number.isNaN(d.getTime()) ? "" : d.toLocaleDateString(undefined,{day:"numeric",month:"short",year:"numeric"});
};
%>

<div style="width:100%;max-width:500px;margin:0 auto;padding:10px;box-sizing:border-box;background:#f6fbf6;font-family:system-ui,sans-serif;display:flex;flex-direction:column;gap:12px;">

  <!-- 1. USER MANAGEMENT HEADER - TOP -->
  <div style="background:#e8f2e6;border:1.5px solid #cfe1d3;border-radius:14px;padding:14px 16px;display:flex;align-items:center;gap:14px;">
    <div style="width:48px;height:48px;background:#fff;border-radius:50%;display:grid;place-items:center;font-size:22px;">✉️</div>
    <div style="flex:1;">
      <div style="font-size:13px;font-weight:900;color:#0a4d1e;">USER MANAGEMENT</div>
      <div style="font-size:11px;color:#5a7d5a;margin-top:2px;">Invite User - Create invitation and reserve role.</div>
    </div>
    <a href="/auth/users" style="padding:8px 12px;background:#fff;border:1.5px solid #cfe1d3;border-radius:8px;text-decoration:none;font-size:11px;font-weight:800;color:#0a4d1e;">Users</a>
  </div>

  <% if (typeof req !== 'undefined' && req.query?.success) { %>
    <div style="padding:10px 12px;border-radius:10px;background:#eaf7ed;color:#176b3a;font-size:11px;">✅ <%= req.query.success %></div>
  <% } %>
  <% if (typeof req !== 'undefined' && req.query?.error) { %>
    <div style="padding:10px 12px;border-radius:10px;background:#fff0f0;color:#a32828;font-size:11px;">⚠️ <%= req.query.error %></div>
  <% } %>

  <!-- 2. OVERVIEW - TAP TO FILTER BACK TO USERS -->
  <div style="background:#eef6ec;border:1.5px solid #cfe1d3;border-radius:14px;padding:12px;">
    <div style="font-size:10px;font-weight:900;letter-spacing:0.8px;color:#2e5a36;padding:0 4px 8px 4px;">QUICK NAV</div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
      <a href="/auth/users?tab=all" style="padding:10px;border-radius:10px;background:#fff;border:1.5px solid #dbe9dc;text-decoration:none;color:#1a3d1a;font-size:11px;font-weight:700;text-align:center;">👥 All Users</a>
      <a href="/auth/users/invitation" style="padding:10px;border-radius:10px;background:#0a4d1e;color:#fff;border:1.5px solid #0a4d1e;text-decoration:none;font-size:11px;font-weight:800;text-align:center;">✉️ Invite User</a>
    </div>
  </div>

  <!-- 3. CREATE INVITATION - FULL WIDTH -->
  <div style="background:#eef6ec;border:1.5px solid #cfe1d3;border-radius:14px;padding:10px;">
    <div style="background:#fff;border-radius:12px;padding:14px;">
      <div style="font-size:12px;font-weight:900;color:#0a4d1e;">✉️ CREATE INVITATION</div>
      <div style="font-size:10px;color:#777;margin-top:2px;">Enter email and choose its role.</div>
      
      <form action="/auth/users/invite" method="POST" style="margin-top:14px;display:flex;flex-direction:column;gap:12px;">
        <div>
          <label style="display:block;font-size:9px;font-weight:900;letter-spacing:0.6px;color:#4a5a4e;margin-bottom:5px;">EMAIL ADDRESS</label>
          <input name="email" type="email" required placeholder="name@example.com" style="width:100%;height:42px;padding:0 12px;border:1.5px solid #cadbd0;border-radius:10px;outline:none;font-size:12px;box-sizing:border-box;">
        </div>
        <div>
          <label style="display:block;font-size:9px;font-weight:900;letter-spacing:0.6px;color:#4a5a4e;margin-bottom:5px;">ROLE TO GRANT</label>
          <select name="role" required style="width:100%;height:42px;padding:0 12px;border:1.5px solid #cadbd0;border-radius:10px;outline:none;font-size:12px;background:#fff;box-sizing:border-box;">
            <option value="staff">Staff</option>
            <option value="client">Client</option>
            <option value="admin">Admin</option>
          </select>
        </div>
        <button type="submit" style="width:100%;height:44px;border:none;border-radius:10px;background:#0a4d1e;color:#fff;font-size:12px;font-weight:800;cursor:pointer;">+ Save Invitation</button>
      </form>

      <div style="margin-top:14px;padding:10px;background:#f4faf5;border-radius:10px;border:1px solid #e0ece1;">
        <div style="font-size:10px;font-weight:800;color:#2e5a36;">Available Roles</div>
        <div style="margin-top:8px;display:flex;flex-direction:column;gap:6px;font-size:10px;color:#555;">
          <div>⚙️ <b>Staff</b> - Can be assigned a substation.</div>
          <div>👤 <b>Client</b> - Standard client access.</div>
          <div>🛡️ <b>Admin</b> - Administrative access.</div>
        </div>
      </div>
    </div>
  </div>

  <!-- 4. PENDING INVITATIONS - BOTTOM -->
  <div style="background:#eef6ec;border:1.5px solid #cfe1d3;border-radius:14px;padding:10px;">
    <div style="background:#fff;border-radius:12px;padding:12px;">
      <div style="display:flex;justify-content:space-between;align-items:center;padding-bottom:10px;border-bottom:1px solid #eef2ee;">
        <div>
          <div style="font-size:12px;font-weight:900;color:#0a4d1e;">PENDING INVITATIONS</div>
          <div style="font-size:10px;color:#777;margin-top:1px;">Saved invitations waiting to be used.</div>
        </div>
        <span style="min-width:24px;height:24px;display:grid;place-items:center;border-radius:20px;background:#e8f2e6;color:#0a4d1e;font-size:11px;font-weight:800;"><%= pendingInvitations.length %></span>
      </div>

      <div style="margin-top:10px;display:flex;flex-direction:column;gap:8px;">
        <% if(!pendingInvitations.length){ %>
          <div style="padding:24px;text-align:center;border:1.5px dashed #cfe1d3;border-radius:10px;background:#f9fcf9;">
            <div style="font-size:22px;">📭</div>
            <div style="font-size:11px;font-weight:800;margin-top:6px;">No pending invitations</div>
            <div style="font-size:10px;color:#777;margin-top:2px;">Saved invitations will appear here.</div>
          </div>
        <% } else { %>
          <% pendingInvitations.forEach(inv=>{ %>
            <div style="display:flex;align-items:center;gap:10px;padding:10px 12px;border:1.5px solid #e0ece1;border-radius:10px;background:#fbfdfb;">
              <div style="width:36px;height:36px;background:#e8f2e6;border-radius:8px;display:grid;place-items:center;font-size:16px;flex-shrink:0;">✉️</div>
              <div style="flex:1;min-width:0;">
                <div style="font-size:11px;font-weight:800;word-break:break-all;"><%= inv.email %></div>
                <div style="font-size:9px;color:#777;margin-top:2px;">Added <%= invitationDate(inv.createdAt) %></div>
              </div>
              <span style="padding:4px 8px;border-radius:20px;background:#e8f2e6;color:#0a4d1e;font-size:9px;font-weight:800;text-transform:uppercase;"><%= inv.role %></span>
            </div>
          <% }) %>
        <% } %>
      </div>
    </div>
  </div>

</div>