<style>
/* ============================================================
   INVITATION UI
   Same large rounded-container language as users.ejs.
============================================================ */

.iv-page,
.iv-page * {
  box-sizing: border-box;
}

.iv-page {
  --green: #176b2c;
  --green-dark: #0d5422;
  --green-soft: #eaf6ed;
  --green-pale: #f5faf6;
  --green-border: #cfe1d3;
  --ink: #1d2a21;
  --text: #56645a;
  --muted: #879188;
  --border: #dce6de;
  --border-soft: #edf2ee;
  --white: #fff;

  width: 100%;
  max-width: 1080px;
  margin: 0 auto;
  padding: 24px 18px 70px;
  color: var(--ink);
  font-family: inherit;
}

.iv-page h1,
.iv-page h2,
.iv-page h3,
.iv-page p {
  margin-top: 0;
}

.iv-eyebrow {
  display: block;
  color: var(--green);
  font-size: 10px;
  font-weight: 900;
  letter-spacing: .13em;
}

/* -------------------- header -------------------- */

.iv-header {
  margin-bottom: 20px;
}

.iv-back {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  margin-bottom: 22px;
  color: var(--text);
  text-decoration: none;
  font-size: 10px;
  font-weight: 800;
}

.iv-back:hover {
  color: var(--green);
}

.iv-header h1 {
  margin: 7px 0 5px;
  font-size: clamp(30px, 5vw, 43px);
  line-height: 1;
  letter-spacing: -.035em;
}

.iv-header p {
  margin: 0;
  color: var(--text);
  font-size: 12px;
}

/* -------------------- alerts -------------------- */

.iv-alert {
  display: flex;
  gap: 8px;
  align-items: center;
  margin-bottom: 12px;
  padding: 11px 13px;
  border-radius: 10px;
  font-size: 10px;
}

.iv-success {
  background: #eaf8ee;
  color: var(--green);
}

.iv-error {
  background: #fff0f0;
  color: #a22525;
}

/* ============================================================
   MAIN LARGE FORM CONTAINER
============================================================ */

.iv-form-container,
.iv-process-container,
.iv-pending-container {
  border: 1px solid var(--border);
  border-radius: 18px;
  background: var(--white);
  box-shadow: 0 6px 22px rgba(22,60,32,.045);
}

.iv-form-container {
  padding: 20px;
}

.iv-container-heading {
  display: flex;
  align-items: center;
  gap: 11px;
  padding-bottom: 16px;
  margin-bottom: 17px;
  border-bottom: 1px solid var(--border-soft);
}

.iv-heading-icon {
  width: 43px;
  height: 43px;
  flex: 0 0 43px;
  display: grid;
  place-items: center;
  border-radius: 12px;
  background: var(--green-soft);
  color: var(--green);
  font-size: 13px;
}

.iv-container-heading h2 {
  margin: 5px 0 3px;
  font-size: 18px;
}

.iv-container-heading p {
  margin: 0;
  color: var(--muted);
  font-size: 9px;
}

/* ============================================================
   FORM
============================================================ */

.iv-form {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.iv-field label {
  display: block;
  margin-bottom: 5px;
  color: #657168;
  font-size: 8px;
  font-weight: 900;
  letter-spacing: .09em;
}

.iv-input,
.iv-select {
  width: 100%;
  height: 43px;
  padding: 0 12px;
  border: 1px solid #d1ddd4;
  border-radius: 10px;
  outline: none;
  background: #fff;
  color: #3f4b43;
  font-size: 10px;
}

.iv-input:focus,
.iv-select:focus {
  border-color: var(--green);
  box-shadow: 0 0 0 3px rgba(23,107,44,.08);
}

/* role cards */
.iv-role-list {
  display: flex;
  flex-direction: column;
  gap: 7px;
  margin: 1px 0 0;
  padding: 0;
  list-style: none;
}

.iv-role-item {
  display: flex;
  align-items: center;
  gap: 9px;
  min-height: 51px;
  padding: 8px 10px;
  border: 1px solid var(--border-soft);
  border-radius: 11px;
  background: #fbfdfb;
}

.iv-role-icon {
  width: 34px;
  height: 34px;
  flex: 0 0 34px;
  display: grid;
  place-items: center;
  border-radius: 9px;
  background: var(--green-soft);
  color: var(--green);
  font-size: 11px;
}

.iv-role-item strong {
  display: block;
  font-size: 9px;
}

.iv-role-item p {
  margin: 3px 0 0;
  color: var(--muted);
  font-size: 8px;
}

.iv-form-note {
  display: flex;
  gap: 7px;
  padding: 9px 10px;
  border-radius: 9px;
  background: var(--green-pale);
  color: #748078;
  font-size: 8px;
  line-height: 1.45;
}

.iv-form-note i {
  color: var(--green);
}

.iv-submit {
  width: 100%;
  height: 44px;
  border: 0;
  border-radius: 10px;
  background: var(--green);
  color: #fff;
  font-size: 10px;
  font-weight: 900;
  cursor: pointer;
}

.iv-submit:hover {
  background: var(--green-dark);
}

/* ============================================================
   PROCESS CONTAINER
============================================================ */

.iv-process-container {
  margin-top: 15px;
  padding: 19px;
}

.iv-steps {
  display: flex;
  flex-direction: column;
  gap: 9px;
  margin: 0;
  padding: 0;
  list-style: none;
}

.iv-step {
  display: grid;
  grid-template-columns: 31px minmax(0,1fr);
  align-items: center;
  gap: 9px;
  min-height: 57px;
  padding: 8px;
  border: 1px solid var(--border-soft);
  border-radius: 10px;
  background: #fbfdfb;
}

.iv-step-number {
  width: 31px;
  height: 31px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: var(--green-soft);
  color: var(--green);
  font-size: 8px;
  font-weight: 900;
}

.iv-step strong {
  display: block;
  font-size: 9px;
}

.iv-step p {
  margin: 3px 0 0;
  color: var(--muted);
  font-size: 8px;
}

.iv-info {
  margin-top: 11px;
  padding: 9px 10px;
  border-radius: 9px;
  background: var(--green-pale);
  color: #748078;
  font-size: 8px;
}

/* ============================================================
   PENDING INVITATIONS
============================================================ */

.iv-pending-container {
  margin-top: 15px;
  padding: 19px;
}

.iv-pending-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 10px;
  margin-bottom: 12px;
}

.iv-pending-heading h2 {
  margin: 5px 0 3px;
  font-size: 19px;
}

.iv-pending-heading p {
  margin: 0;
  color: var(--muted);
  font-size: 9px;
}

.iv-count {
  min-width: 24px;
  padding: 5px 7px;
  border-radius: 20px;
  background: var(--green-soft);
  color: var(--green);
  text-align: center;
  font-size: 8px;
  font-weight: 900;
}

.iv-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin: 0;
  padding: 0;
  list-style: none;
}

.iv-card {
  display: grid;
  grid-template-columns: 36px minmax(0,1fr) auto;
  align-items: center;
  gap: 9px;
  min-height: 57px;
  padding: 9px 10px;
  border: 1px solid var(--border);
  border-radius: 11px;
  background: #fcfdfc;
}

.iv-card-icon {
  width: 36px;
  height: 36px;
  display: grid;
  place-items: center;
  border-radius: 10px;
  background: var(--green-soft);
  color: var(--green);
  font-size: 10px;
}

.iv-card-email {
  display: block;
  overflow-wrap: anywhere;
  font-size: 10px;
  font-weight: 800;
}

.iv-card-date {
  display: block;
  margin-top: 3px;
  color: var(--muted);
  font-size: 8px;
}

.iv-role-pill {
  padding: 5px 8px;
  border-radius: 20px;
  background: var(--green-soft);
  color: var(--green);
  font-size: 8px;
  font-style: normal;
  font-weight: 900;
  text-transform: uppercase;
}

/* -------------------- empty -------------------- */

.iv-empty {
  padding: 32px 15px;
  border: 1px dashed #cfdbd1;
  border-radius: 11px;
  text-align: center;
}

.iv-empty-icon {
  width: 43px;
  height: 43px;
  margin: 0 auto;
  display: grid;
  place-items: center;
  border-radius: 12px;
  background: var(--green-soft);
  color: var(--green);
}

.iv-empty h3 {
  margin: 9px 0 3px;
  font-size: 13px;
}

.iv-empty p {
  margin: 0;
  color: var(--muted);
  font-size: 9px;
}

/* -------------------- mobile -------------------- */

@media (max-width: 560px) {
  .iv-page {
    padding: 18px 11px 55px;
  }

  .iv-form-container,
  .iv-process-container,
  .iv-pending-container {
    padding: 15px;
  }

  .iv-card {
    grid-template-columns: 35px minmax(0,1fr);
  }

  .iv-role-pill {
    grid-column: 2;
    justify-self: start;
    margin-top: -3px;
  }
}
</style>

<section class="iv-page">

  <header class="iv-header">

    <a class="iv-back" href="/auth/users">
      <i class="fas fa-arrow-left"></i>
      Back to users
    </a>

    <span class="iv-eyebrow">ACCESS CONTROL</span>
    <h1>Invite a User</h1>
    <p>Reserve a role for an email address before the person creates their account.</p>

  </header>

  <% if (req.query?.success) { %>
    <div class="iv-alert iv-success">
      <i class="fas fa-circle-check"></i>
      <%= req.query.success %>
    </div>
  <% } %>

  <% if (req.query?.error) { %>
    <div class="iv-alert iv-error">
      <i class="fas fa-circle-exclamation"></i>
      <%= req.query.error %>
    </div>
  <% } %>

  <!-- ========================================================
       INVITATION FORM CONTAINER
  ========================================================= -->
  <section class="iv-form-container">

    <header class="iv-container-heading">
      <div class="iv-heading-icon">
        <i class="fas fa-envelope"></i>
      </div>

      <div>
        <span class="iv-eyebrow">SECTION 01</span>
        <h2>Create Invitation</h2>
        <p>Enter the email address and choose the role.</p>
      </div>
    </header>

    <form class="iv-form" action="/auth/users/invite" method="POST">

      <div class="iv-field">
        <label for="invite-email">EMAIL ADDRESS</label>
        <input
          class="iv-input"
          id="invite-email"
          name="email"
          type="email"
          placeholder="name@example.com"
          autocomplete="email"
          required>
      </div>

      <div class="iv-field">
        <label for="invite-role">ROLE TO GRANT</label>

        <select class="iv-select" id="invite-role" name="role" required>
          <option value="staff">Staff</option>
          <option value="client">Client</option>
          <option value="admin">Admin</option>
        </select>
      </div>

      <ul class="iv-role-list">

        <li class="iv-role-item">
          <span class="iv-role-icon"><i class="fas fa-user-gear"></i></span>
          <div>
            <strong>Staff</strong>
            <p>Can be assigned a substation.</p>
          </div>
        </li>

        <li class="iv-role-item">
          <span class="iv-role-icon"><i class="fas fa-user"></i></span>
          <div>
            <strong>Client</strong>
            <p>Standard client access.</p>
          </div>
        </li>

        <li class="iv-role-item">
          <span class="iv-role-icon"><i class="fas fa-shield-halved"></i></span>
          <div>
            <strong>Admin</strong>
            <p>Administrative access.</p>
          </div>
        </li>

      </ul>

      <div class="iv-form-note">
        <i class="fas fa-circle-info"></i>
        <span>The selected role will be reserved for the invited email.</span>
      </div>

      <button class="iv-submit" type="submit">
        <i class="fas fa-paper-plane"></i>
        Save Invitation
      </button>

    </form>

  </section>

  <!-- ========================================================
       HOW IT WORKS CONTAINER
  ========================================================= -->
  <section class="iv-process-container">

    <header class="iv-container-heading">
      <div class="iv-heading-icon">
        <i class="fas fa-list-check"></i>
      </div>

      <div>
        <span class="iv-eyebrow">SECTION 02</span>
        <h2>How It Works</h2>
        <p>The invitation process.</p>
      </div>
    </header>

    <ol class="iv-steps">

      <li class="iv-step">
        <span class="iv-step-number">01</span>
        <div>
          <strong>Save the invitation</strong>
          <p>Store the email with its intended role.</p>
        </div>
      </li>

      <li class="iv-step">
        <span class="iv-step-number">02</span>
        <div>
          <strong>User registers</strong>
          <p>The person signs up using the invited email.</p>
        </div>
      </li>

      <li class="iv-step">
        <span class="iv-step-number">03</span>
        <div>
          <strong>Role is applied</strong>
          <p>The saved invitation determines the account role.</p>
        </div>
      </li>

    </ol>

    <div class="iv-info">
      <i class="fas fa-circle-info"></i>
      A signup without an invitation becomes <strong>client</strong>.
    </div>

  </section>

  <!-- ========================================================
       PENDING INVITATIONS CONTAINER
  ========================================================= -->
  <section class="iv-pending-container">

    <header class="iv-pending-heading">

      <div>
        <span class="iv-eyebrow">SECTION 03</span>
        <h2>Pending Invitations</h2>
        <p>Saved invitations waiting to be used.</p>
      </div>

      <span class="iv-count"><%= Array.isArray(invitations) ? invitations.length : 0 %></span>

    </header>

    <% if (!Array.isArray(invitations) || !invitations.length) { %>

      <div class="iv-empty">
        <div class="iv-empty-icon">
          <i class="fas fa-inbox"></i>
        </div>
        <h3>No pending invitations</h3>
        <p>Saved invitations will appear here.</p>
      </div>

    <% } else { %>

      <ul class="iv-list">

        <% invitations.forEach(invitation => { %>

          <li class="iv-card">

            <span class="iv-card-icon">
              <i class="fas fa-envelope"></i>
            </span>

            <div>
              <strong class="iv-card-email">
                <%= invitation.email %>
              </strong>

              <small class="iv-card-date">
                Added
                <%= invitation.createdAt
                  ? new Date(invitation.createdAt).toLocaleDateString()
                  : "" %>
              </small>
            </div>

            <em class="iv-role-pill">
              <%= invitation.role %>
            </em>

          </li>

        <% }) %>

      </ul>

    <% } %>

  </section>

</section>
