ransform:uppercase}.role.admin{background:#f0eafd;color:#6433a5}.role.staff{background:#e6f3fa;color:#12617d}.role.client{background:#f0f2f1;color:#59625d}.empty{text-align:center;padding:35px;color:#7b857e;border:1px dashed #d9dfda;border-radius:13px}.empty i{font-size:23px;color:#0b5d1e}.empty h3{margin:9px 0 4px;color:#3f4942;font-size:14px}.empty p{margin:0;font-size:10px}@media(max-width:760px){.invite-shell{grid-template-columns:1fr}}@media(max-width:500px){.iv{padding:19px 13px 55px}.panel,.info,.pending{padding:17px}.pending-card{align-items:flex-start}.role{margin-left:auto}}
</style>
