<% const pending = Array.isArray(invitations) ? invitations : []; %>
<section class="iv">
  <header class="iv-hero">
    <div>
      <a class="back" href="/auth/users"><i class="fas fa-arrow-left"></i><span>Back to users</span></a>
      <span class="eyebrow">ACCESS CONTROL</span>
      <h1>Invite a user</h1>
      <p>Reserve a role for an email address before the person creates their account.</p>
    </div>
  </header>

  <% if(req.query?.error){ %><div class="alert error"><i class="fas fa-circle-exclamation"></i><%= req.query.error %></div><% } %>
  <% if(req.query?.success){ %><div class="alert success"><i class="fas fa-circle-check"></i><%= req.query.success %></div><% } %>

  <div class="invite-shell">
    <main class="panel">
      <div class="panel-title">
        <div class="icon"><i class="fas fa-envelope"></i></div>
        <div><span class="eyebrow">NEW INVITATION</span><h2>Create invitation</h2><p>The email controls the role granted at signup.</p></div>
      </div>

      <form action="/auth/users/invite" method="POST">
        <label>Email address</label>
        <div class="input"><i class="fas fa-at"></i><input type="email" name="email" placeholder="name@example.com" required></div>

        <label>Role to grant</label>
        <select name="role" required>
          <option value="staff">Staff</option>
          <option value="client">Client</option>
          <option value="admin">Admin</option>
        </select>

        <div class="guide">
          <div><span class="guide-icon staff"><i class="fas fa-user-gear"></i></span><span><b>Staff</b><small>Can be assigned a substation after registration.</small></span></div>
          <div><span class="guide-icon client"><i class="fas fa-user"></i></span><span><b>Client</b><small>Standard client access.</small></span></div>
          <div><span class="guide-icon admin"><i class="fas fa-shield-halved"></i></span><span><b>Admin</b><small>Administrative access.</small></span></div>
        </div>

        <button class="submit" type="submit"><i class="fas fa-paper-plane"></i> Save Invitation</button>
      </form>
    </main>

    <aside class="info">
      <div class="info-head"><div class="icon"><i class="fas fa-shield-halved"></i></div><div><span class="eyebrow">PROCESS</span><h2>How it works</h2></div></div>
      <ol>
        <li><b>1</b><span>Save the email and intended role.</span></li>
        <li><b>2</b><span>The person signs up using that email.</span></li>
        <li><b>3</b><span>The server automatically grants the saved role.</span></li>
      </ol>
      <p class="tip"><i class="fas fa-circle-info"></i><span>A signup without an invitation always becomes <strong>client</strong>.</span></p>
    </aside>
  </div>

  <section class="pending">
    <div class="pending-head">
      <div><span class="eyebrow">WAITING LIST</span><h2>Pending invitations</h2><p>Invitations waiting to be used.</p></div>
      <b><%= pending.length %></b>
    </div>

    <% if(!pending.length){ %>
      <div class="empty"><i class="fas fa-inbox"></i><h3>No pending invitations</h3><p>Saved invitations appear here until used.</p></div>
    <% } else { %>
      <ul class="pending-list">
        <% pending.forEach(i=>{ %>
          <li class="pending-card">
            <div class="mail-icon"><i class="fas fa-envelope"></i></div>
            <div class="pending-details"><strong><%= i.email %></strong><small>Added <%= i.createdAt?new Date(i.createdAt).toLocaleDateString():'' %></small></div>
            <em class="role <%= i.role %>"><%= i.role %></em>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </section>
</section>

