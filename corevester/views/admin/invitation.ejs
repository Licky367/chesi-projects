<% const pending = Array.isArray(invitations) ? invitations : []; %>

<section class="iv">

  <!-- =========================================================
       HEADER
  ========================================================== -->
  <header class="iv-header">

    <a class="iv-back" href="/auth/users">
      <i class="fas fa-arrow-left"></i>
      <span>Back to users</span>
    </a>

    <span class="eyebrow">ACCESS CONTROL</span>
    <h1>Invite a User</h1>
    <p>Reserve a role for an email address before the person creates their account.</p>

  </header>

  <!-- =========================================================
       ALERTS
  ========================================================== -->
  <% if (req.query?.error) { %>
    <div class="iv-alert iv-alert-error">
      <i class="fas fa-circle-exclamation"></i>
      <span><%= req.query.error %></span>
    </div>
  <% } %>

  <% if (req.query?.success) { %>
    <div class="iv-alert iv-alert-success">
      <i class="fas fa-circle-check"></i>
      <span><%= req.query.success %></span>
    </div>
  <% } %>

  <!-- =========================================================
       MAIN INVITATION CONTAINERS
  ========================================================== -->
  <section class="iv-layout">

    <!-- =======================================================
         INVITATION FORM CONTAINER
    ======================================================== -->
    <article class="iv-container iv-form-container">

      <header class="iv-container-header">
        <div class="iv-container-icon">
          <i class="fas fa-envelope"></i>
        </div>

        <div>
          <span class="eyebrow">SECTION 01</span>
          <h2>Create Invitation</h2>
          <p>Enter the email and select the role to reserve.</p>
        </div>
      </header>

      <form action="/auth/users/invite" method="POST" class="iv-form">

        <div class="iv-field">
          <label for="invite-email">EMAIL ADDRESS</label>

          <div class="iv-input-wrap">
            <i class="fas fa-at"></i>

            <input
              id="invite-email"
              type="email"
              name="email"
              placeholder="name@example.com"
              autocomplete="email"
              required>
          </div>
        </div>

        <div class="iv-field">
          <label for="invite-role">ROLE TO GRANT</label>

          <div class="iv-select-wrap">
            <i class="fas fa-user-tag"></i>

            <select id="invite-role" name="role" required>
              <option value="staff">Staff</option>
              <option value="client">Client</option>
              <option value="admin">Admin</option>
            </select>
          </div>
        </div>

        <!-- Role containers -->
        <div class="iv-role-guide">

          <div class="iv-role-guide-item">
            <span class="iv-role-guide-icon iv-role-staff">
              <i class="fas fa-user-gear"></i>
            </span>
            <div>
              <strong>Staff</strong>
              <p>Can be assigned a substation.</p>
            </div>
          </div>

          <div class="iv-role-guide-item">
            <span class="iv-role-guide-icon iv-role-client">
              <i class="fas fa-user"></i>
            </span>
            <div>
              <strong>Client</strong>
              <p>Standard client access.</p>
            </div>
          </div>

          <div class="iv-role-guide-item">
            <span class="iv-role-guide-icon iv-role-admin">
              <i class="fas fa-shield-halved"></i>
            </span>
            <div>
              <strong>Admin</strong>
              <p>Administrative access.</p>
            </div>
          </div>

        </div>

        <div class="iv-form-note">
          <i class="fas fa-circle-info"></i>
          <span>The selected role will be reserved for the invited email.</span>
        </div>

        <button class="iv-submit" type="submit">
          <i class="fas fa-paper-plane"></i>
          <span>Save Invitation</span>
        </button>

      </form>

    </article>

    <!-- =======================================================
         HOW IT WORKS CONTAINER
    ======================================================== -->
    <article class="iv-container iv-info-container">

      <header class="iv-container-header">
        <div class="iv-container-icon">
          <i class="fas fa-list-check"></i>
        </div>

        <div>
          <span class="eyebrow">SECTION 02</span>
          <h2>How It Works</h2>
          <p>The invitation process.</p>
        </div>
      </header>

      <ol class="iv-steps">

        <li>
          <span>01</span>
          <div>
            <strong>Save the invitation</strong>
            <p>Store the email with its intended role.</p>
          </div>
        </li>

        <li>
          <span>02</span>
          <div>
            <strong>User registers</strong>
            <p>The person signs up using that email.</p>
          </div>
        </li>

        <li>
          <span>03</span>
          <div>
            <strong>Role is applied</strong>
            <p>The saved invitation determines the account role.</p>
          </div>
        </li>

      </ol>

      <div class="iv-info-note">
        <i class="fas fa-circle-info"></i>
        <span>
          A signup without an invitation always becomes
          <strong>client</strong>.
        </span>
      </div>

    </article>

  </section>

  <!-- =========================================================
       PENDING INVITATIONS
  ========================================================== -->
  <section class="iv-container iv-pending-container">

    <header class="iv-pending-header">

      <div>
        <span class="eyebrow">SECTION 03</span>
        <h2>Pending Invitations</h2>
        <p>Saved invitations waiting to be used.</p>
      </div>

      <span class="iv-pending-count"><%= pending.length %></span>

    </header>

    <% if (!pending.length) { %>

      <div class="iv-empty">
        <div class="iv-empty-icon">
          <i class="fas fa-inbox"></i>
        </div>
        <h3>No pending invitations</h3>
        <p>Saved invitations will appear here.</p>
      </div>

    <% } else { %>

      <ul class="iv-pending-list">

        <% pending.forEach(i => { %>

          <li class="iv-pending-card">

            <span class="iv-pending-icon">
              <i class="fas fa-envelope"></i>
            </span>

            <div class="iv-pending-details">
              <strong><%= i.email %></strong>
              <small>
                Added
                <%= i.createdAt
                  ? new Date(i.createdAt).toLocaleDateString()
                  : '' %>
              </small>
            </div>

            <em class="iv-role iv-role-<%= i.role %>">
              <%= i.role %>
            </em>

          </li>

        <% }) %>

      </ul>

    <% } %>

  </section>

</section>

<style>
/* ==============================================================
   INVITATION UI
   --------------------------------------------------------------
   Greenish, container-based layout matching the requested
   hand-drawn reference:
   - strong outer containers
   - rounded sections
   - clean forms
   - green accents
   - simple vertical information flow
================================================================ */

.iv {
  --iv-green: #176b2c;
  --iv-green-dark: #0d4f1e;
  --iv-green-light: #eaf5ed;
  --iv-green-pale: #f5faf6;
  --iv-ink: #203027;
  --iv-muted: #7c887f;
  --iv-line: #dfe8e1;
  --iv-line-light: #edf2ee;
  --iv-white: #fff;

  width: 100%;
  max-width: 1080px;
  margin: 0 auto;
  padding: 28px 20px 75px;
  box-sizing: border-box;
  color: var(--iv-ink);
}

.iv * {
  box-sizing: border-box;
}

.iv .eyebrow {
  display: block;
  color: var(--iv-green);
  font-size: 10px;
  font-weight: 900;
  letter-spacing: .14em;
}

/* ==============================================================
   HEADER
================================================================ */

.iv-header {
  margin-bottom: 22px;
}

.iv-back {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  margin-bottom: 25px;
  color: #68746c;
  text-decoration: none;
  font-size: 11px;
  font-weight: 850;
}

.iv-back:hover {
  color: var(--iv-green);
}

.iv-header h1 {
  margin: 7px 0 5px;
  color: var(--iv-ink);
  font-size: clamp(31px, 5vw, 44px);
  line-height: 1.05;
  letter-spacing: -.025em;
}

.iv-header > p {
  margin: 0;
  color: var(--iv-muted);
  font-size: 13px;
}

/* ==============================================================
   ALERTS
================================================================ */

.iv-alert {
  display: flex;
  align-items: center;
  gap: 9px;
  margin-bottom: 15px;
  padding: 12px 14px;
  border-radius: 11px;
  font-size: 11px;
}

.iv-alert-error {
  background: #fff0f1;
  color: #9b2027;
}

.iv-alert-success {
  background: #edf9f0;
  color: #166534;
}

/* ==============================================================
   MAIN CONTAINERS
================================================================ */

.iv-layout {
  display: grid;
  grid-template-columns: minmax(0, 1.35fr) minmax(280px, .65fr);
  gap: 15px;
}

.iv-container {
  min-width: 0;
  border: 1px solid var(--iv-line);
  border-radius: 18px;
  background: var(--iv-white);
  box-shadow: 0 6px 20px rgba(23, 58, 32, .045);
}

.iv-form-container {
  padding: 21px;
}

.iv-info-container {
  align-self: start;
  padding: 21px;
}

/* ==============================================================
   CONTAINER HEADER
================================================================ */

.iv-container-header {
  display: flex;
  align-items: center;
  gap: 11px;
  padding-bottom: 17px;
  margin-bottom: 19px;
  border-bottom: 1px solid var(--iv-line-light);
}

.iv-container-icon {
  width: 44px;
  height: 44px;
  flex: 0 0 44px;
  display: grid;
  place-items: center;
  border-radius: 13px;
  background: var(--iv-green-light);
  color: var(--iv-green);
  font-size: 13px;
}

.iv-container-header h2 {
  margin: 4px 0 3px;
  color: var(--iv-ink);
  font-size: 18px;
}

.iv-container-header p {
  margin: 0;
  color: var(--iv-muted);
  font-size: 10px;
}

/* ==============================================================
   FORM
================================================================ */

.iv-form {
  display: flex;
  flex-direction: column;
  gap: 15px;
}

.iv-field label {
  display: block;
  margin-bottom: 6px;
  color: #5e6a62;
  font-size: 9px;
  font-weight: 900;
  letter-spacing: .08em;
}

.iv-input-wrap,
.iv-select-wrap {
  position: relative;
}

.iv-input-wrap > i,
.iv-select-wrap > i {
  position: absolute;
  left: 13px;
  top: 14px;
  z-index: 1;
  color: #7d887f;
  font-size: 10px;
  pointer-events: none;
}

.iv-input-wrap input,
.iv-select-wrap select {
  width: 100%;
  height: 44px;
  border: 1px solid #d3ded5;
  border-radius: 10px;
  outline: none;
  background: #fff;
  color: #3d4941;
  font-family: inherit;
  font-size: 11px;
  transition: border-color .15s ease, box-shadow .15s ease;
}

.iv-input-wrap input {
  padding: 0 12px 0 36px;
}

.iv-select-wrap select {
  padding: 0 34px 0 36px;
}

.iv-input-wrap input:hover,
.iv-select-wrap select:hover {
  border-color: #b9cbbd;
}

.iv-input-wrap input:focus,
.iv-select-wrap select:focus {
  border-color: var(--iv-green);
  box-shadow: 0 0 0 3px rgba(23, 107, 44, .08);
}

/* ==============================================================
   ROLE GUIDE CONTAINERS
================================================================ */

.iv-role-guide {
  display: grid;
  gap: 7px;
  margin-top: 1px;
}

.iv-role-guide-item {
  display: flex;
  align-items: center;
  gap: 10px;
  min-height: 54px;
  padding: 8px 10px;
  border: 1px solid var(--iv-line-light);
  border-radius: 11px;
  background: #fbfcfb;
}

.iv-role-guide-icon {
  width: 35px;
  height: 35px;
  flex: 0 0 35px;
  display: grid;
  place-items: center;
  border-radius: 10px;
  font-size: 10px;
}

.iv-role-staff {
  background: #e7f3f8;
  color: #14627c;
}

.iv-role-client {
  background: #f0f2f0;
  color: #59635c;
}

.iv-role-admin {
  background: #f0eafd;
  color: #6333a2;
}

.iv-role-guide-item strong {
  display: block;
  color: #39453d;
  font-size: 10px;
}

.iv-role-guide-item p {
  margin: 3px 0 0;
  color: #808b83;
  font-size: 9px;
}

/* ==============================================================
   FORM NOTE + BUTTON
================================================================ */

.iv-form-note,
.iv-info-note {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  padding: 10px;
  border-radius: 10px;
  background: var(--iv-green-pale);
  color: #718078;
  font-size: 9px;
  line-height: 1.45;
}

.iv-form-note i,
.iv-info-note i {
  color: var(--iv-green);
  margin-top: 1px;
}

.iv-submit {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  width: 100%;
  height: 45px;
  margin-top: 1px;
  border: 0;
  border-radius: 10px;
  background: var(--iv-green);
  color: #fff;
  font-family: inherit;
  font-size: 10px;
  font-weight: 900;
  cursor: pointer;
  box-shadow: 0 6px 15px rgba(23, 107, 44, .11);
  transition: background .15s ease, transform .15s ease;
}

.iv-submit:hover {
  background: var(--iv-green-dark);
  transform: translateY(-1px);
}

/* ==============================================================
   HOW IT WORKS
================================================================ */

.iv-steps {
  display: flex;
  flex-direction: column;
  gap: 16px;
  margin: 0 0 16px;
  padding: 0;
  list-style: none;
}

.iv-steps li {
  display: flex;
  align-items: flex-start;
  gap: 10px;
}

.iv-steps li > span {
  width: 28px;
  height: 28px;
  flex: 0 0 28px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: var(--iv-green-light);
  color: var(--iv-green);
  font-size: 8px;
  font-weight: 900;
}

.iv-steps strong {
  display: block;
  color: #39453d;
  font-size: 10px;
}

.iv-steps p {
  margin: 3px 0 0;
  color: #7d8880;
  font-size: 9px;
  line-height: 1.45;
}

/* ==============================================================
   PENDING SECTION
================================================================ */

.iv-pending-container {
  margin-top: 16px;
  padding: 20px;
}

.iv-pending-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 15px;
  margin-bottom: 13px;
}

.iv-pending-header h2 {
  margin: 4px 0 3px;
  color: var(--iv-ink);
  font-size: 20px;
}

.iv-pending-header p {
  margin: 0;
  color: var(--iv-muted);
  font-size: 10px;
}

.iv-pending-count {
  min-width: 25px;
  padding: 5px 8px;
  border-radius: 20px;
  background: var(--iv-green-light);
  color: var(--iv-green);
  text-align: center;
  font-size: 9px;
  font-weight: 900;
}

/* Pending invitation list */
.iv-pending-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin: 0;
  padding: 0;
  list-style: none;
}

.iv-pending-card {
  display: flex;
  align-items: center;
  gap: 10px;
  min-height: 58px;
  padding: 10px 11px;
  border: 1px solid var(--iv-line);
  border-radius: 11px;
  background: #fcfdfc;
}

.iv-pending-icon {
  width: 35px;
  height: 35px;
  flex: 0 0 35px;
  display: grid;
  place-items: center;
  border-radius: 10px;
  background: var(--iv-green-light);
  color: var(--iv-green);
  font-size: 10px;
}

.iv-pending-details {
  min-width: 0;
  flex: 1;
}

.iv-pending-details strong {
  display: block;
  overflow-wrap: anywhere;
  color: #39453d;
  font-size: 11px;
}

.iv-pending-details small {
  display: block;
  margin-top: 3px;
  color: #8a948d;
  font-size: 8px;
}

.iv-role {
  flex: 0 0 auto;
  padding: 5px 8px;
  border-radius: 20px;
  font-size: 8px;
  font-style: normal;
  font-weight: 900;
  text-transform: uppercase;
}

.iv-role-admin {
  background: #f0eafd;
  color: #6333a2;
}

.iv-role-staff {
  background: #e7f3f8;
  color: #14627c;
}

.iv-role-client {
  background: #f0f2f0;
  color: #59635c;
}

/* ==============================================================
   EMPTY
================================================================ */

.iv-empty {
  padding: 36px 20px;
  border: 1px dashed #d3ddd5;
  border-radius: 12px;
  text-align: center;
}

.iv-empty-icon {
  width: 45px;
  height: 45px;
  margin: 0 auto;
  display: grid;
  place-items: center;
  border-radius: 13px;
  background: var(--iv-green-light);
  color: var(--iv-green);
  font-size: 14px;
}

.iv-empty h3 {
  margin: 10px 0 4px;
  color: #3d4941;
  font-size: 14px;
}

.iv-empty p {
  margin: 0;
  color: var(--iv-muted);
  font-size: 10px;
}

/* ==============================================================
   RESPONSIVE
================================================================ */

@media (max-width: 760px) {
  .iv-layout {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 500px) {
  .iv {
    padding: 20px 13px 55px;
  }

  .iv-form-container,
  .iv-info-container,
  .iv-pending-container {
    padding: 16px;
  }

  .iv-pending-card {
    align-items: flex-start;
  }

  .iv-role {
    margin-left: auto;
  }
}
</style>
