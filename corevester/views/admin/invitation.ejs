<% const pending = Array.isArray(invitations) ? invitations : []; %>

<section class="invitation-page">

  <!-- =========================================================
       PAGE HEADER
  ========================================================== -->
  <header class="invitation-header">
    <a class="back-link" href="/auth/users">
      <i class="fas fa-arrow-left"></i>
      <span>Back to users</span>
    </a>

    <span class="section-label">ACCESS CONTROL</span>
    <h1>Invite a User</h1>
    <p>Create an invitation and decide the account role before registration.</p>
  </header>

  <!-- =========================================================
       FLASH MESSAGES
  ========================================================== -->
  <% if (req.query?.error) { %>
    <div class="message message--error">
      <i class="fas fa-circle-exclamation"></i>
      <span><%= req.query.error %></span>
    </div>
  <% } %>

  <% if (req.query?.success) { %>
    <div class="message message--success">
      <i class="fas fa-circle-check"></i>
      <span><%= req.query.success %></span>
    </div>
  <% } %>

  <!-- =========================================================
       INVITATION SECTIONS
       1. Form
       2. Role guide
       3. Process
  ========================================================== -->
  <section class="invitation-sections">

    <!-- ================= INVITATION FORM ===================== -->
    <article class="invitation-card invitation-card--form">
      <header class="card-header">
        <div class="card-header__icon">
          <i class="fas fa-envelope"></i>
        </div>
        <div>
          <span class="section-label">SECTION 01</span>
          <h2>Invitation Details</h2>
          <p>Enter the email and role for the new account.</p>
        </div>
      </header>

      <form action="/auth/users/invite" method="POST" class="invitation-form">

        <div class="field">
          <label for="invite-email">EMAIL ADDRESS</label>
          <div class="field-input">
            <i class="fas fa-at"></i>
            <input
              id="invite-email"
              type="email"
              name="email"
              placeholder="name@example.com"
              required
            >
          </div>
        </div>

        <div class="field">
          <label for="invite-role">ROLE TO GRANT</label>

          <select id="invite-role" name="role" required>
            <option value="staff">Staff</option>
            <option value="client">Client</option>
            <option value="admin">Admin</option>
          </select>
        </div>

        <div class="form-note">
          <i class="fas fa-circle-info"></i>
          <span>The selected role will be applied when the invited email registers.</span>
        </div>

        <button class="submit-button" type="submit">
          <i class="fas fa-paper-plane"></i>
          <span>Save Invitation</span>
        </button>

      </form>
    </article>

    <!-- ================= ROLE SECTION ======================== -->
    <article class="invitation-card">
      <header class="card-header">
        <div class="card-header__icon">
          <i class="fas fa-user-tag"></i>
        </div>
        <div>
          <span class="section-label">SECTION 02</span>
          <h2>Available Roles</h2>
          <p>Choose the access level that fits the account.</p>
        </div>
      </header>

      <div class="role-list">

        <div class="role-item">
          <span class="role-item__icon role-item__icon--admin">
            <i class="fas fa-shield-halved"></i>
          </span>
          <div>
            <strong>Admin</strong>
            <p>Administrative access.</p>
          </div>
          <span class="role-tag role-tag--admin">ADMIN</span>
        </div>

        <div class="role-item">
          <span class="role-item__icon role-item__icon--staff">
            <i class="fas fa-user-gear"></i>
          </span>
          <div>
            <strong>Staff</strong>
            <p>Can be assigned a substation.</p>
          </div>
          <span class="role-tag role-tag--staff">STAFF</span>
        </div>

        <div class="role-item">
          <span class="role-item__icon role-item__icon--client">
            <i class="fas fa-user"></i>
          </span>
          <div>
            <strong>Client</strong>
            <p>Standard client access.</p>
          </div>
          <span class="role-tag role-tag--client">CLIENT</span>
        </div>

      </div>
    </article>

    <!-- ================= PROCESS SECTION ===================== -->
    <article class="invitation-card">
      <header class="card-header">
        <div class="card-header__icon">
          <i class="fas fa-list-check"></i>
        </div>
        <div>
          <span class="section-label">SECTION 03</span>
          <h2>How It Works</h2>
          <p>The invitation flow in three simple steps.</p>
        </div>
      </header>

      <ol class="process-list">
        <li>
          <span class="process-number">01</span>
          <div>
            <strong>Save the invitation</strong>
            <p>Store the email with its intended role.</p>
          </div>
        </li>

        <li>
          <span class="process-number">02</span>
          <div>
            <strong>User registers</strong>
            <p>The person signs up using the invited email.</p>
          </div>
        </li>

        <li>
          <span class="process-number">03</span>
          <div>
            <strong>Role is applied</strong>
            <p>The saved invitation determines the account role.</p>
          </div>
        </li>
      </ol>

      <div class="process-note">
        <i class="fas fa-circle-info"></i>
        <span>A signup without an invitation becomes <strong>client</strong>.</span>
      </div>
    </article>

  </section>

  <!-- =========================================================
       PENDING INVITATIONS SECTION
  ========================================================== -->
  <section class="pending-section">

    <header class="pending-header">
      <div>
        <span class="section-label">SECTION 04</span>
        <h2>Pending Invitations</h2>
        <p>Invitations that have been saved and are waiting to be used.</p>
      </div>

      <span class="pending-count"><%= pending.length %></span>
    </header>

    <% if (!pending.length) { %>

      <div class="pending-empty">
        <div class="pending-empty__icon">
          <i class="fas fa-inbox"></i>
        </div>
        <h3>No pending invitations</h3>
        <p>New invitations will appear here after they are saved.</p>
      </div>

    <% } else { %>

      <ul class="pending-list">

        <% pending.forEach(invitation => { %>

          <li class="pending-card">

            <span class="pending-card__icon">
              <i class="fas fa-envelope"></i>
            </span>

            <div class="pending-card__details">
              <strong><%= invitation.email %></strong>
              <small>
                Added
                <%= invitation.createdAt
                  ? new Date(invitation.createdAt).toLocaleDateString()
                  : "" %>
              </small>
            </div>

            <span class="role-tag role-tag--<%= invitation.role %>">
              <%= invitation.role %>
            </span>

          </li>

        <% }) %>

      </ul>

    <% } %>

  </section>

</section>

<style>
/* ==============================================================
   INVITATION PAGE
================================================================ */

.invitation-page {
  --green: #0b5d1e;
  --green-soft: #edf6ef;
  --ink: #1d2921;
  --text: #435048;
  --muted: #77827a;
  --line: #e1e8e3;
  --surface: #ffffff;

  max-width: 1120px;
  margin: 0 auto;
  padding: 25px 20px 70px;
  color: var(--ink);
}

/* ==============================================================
   HEADER
================================================================ */

.back-link {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  margin-bottom: 25px;
  color: #68736c;
  text-decoration: none;
  font-size: 11px;
  font-weight: 850;
}

.back-link:hover {
  color: var(--green);
}

.invitation-header h1 {
  margin: 7px 0 6px;
  font-size: clamp(31px, 5vw, 44px);
  line-height: 1.05;
  letter-spacing: -.025em;
}

.invitation-header > p {
  margin: 0;
  color: var(--muted);
  font-size: 13px;
}

/* ==============================================================
   MESSAGES
================================================================ */

.message {
  display: flex;
  align-items: center;
  gap: 9px;
  margin-top: 18px;
  padding: 12px 14px;
  border-radius: 11px;
  font-size: 12px;
}

.message--error {
  color: #991b1b;
  background: #fff1f2;
}

.message--success {
  color: #166534;
  background: #f0fdf4;
}

/* ==============================================================
   INVITATION SECTION GRID
================================================================ */

.invitation-sections {
  display: grid;
  grid-template-columns: minmax(0, 1.25fr) minmax(270px, .75fr);
  gap: 15px;
  margin-top: 25px;
}

/* ==============================================================
   CARDS
================================================================ */

.invitation-card {
  min-width: 0;
  padding: 20px;
  border: 1px solid var(--line);
  border-radius: 17px;
  background: var(--surface);
  box-shadow: 0 6px 20px rgba(24, 43, 29, .04);
}

.invitation-card--form {
  grid-row: span 2;
}

.card-header {
  display: flex;
  align-items: center;
  gap: 11px;
  padding-bottom: 17px;
  margin-bottom: 18px;
  border-bottom: 1px solid #edf0ed;
}

.card-header__icon {
  width: 43px;
  height: 43px;
  flex: 0 0 43px;
  display: grid;
  place-items: center;
  border-radius: 12px;
  background: var(--green-soft);
  color: var(--green);
}

.card-header h2 {
  margin: 4px 0 3px;
  color: #29352d;
  font-size: 18px;
}

.card-header p {
  margin: 0;
  color: var(--muted);
  font-size: 10px;
  line-height: 1.4;
}

/* ==============================================================
   FORM
================================================================ */

.invitation-form {
  display: grid;
  gap: 16px;
}

.field label {
  display: block;
  margin-bottom: 6px;
  color: #59635b;
  font-size: 9px;
  font-weight: 900;
  letter-spacing: .08em;
}

.field-input {
  position: relative;
}

.field-input > i {
  position: absolute;
  left: 13px;
  top: 14px;
  color: #7d877f;
  font-size: 11px;
}

.field input,
.field select {
  width: 100%;
  height: 44px;
  box-sizing: border-box;
  border: 1px solid #d7ded8;
  border-radius: 10px;
  background: #fff;
  color: #354038;
  font-size: 11px;
}

.field input {
  padding: 0 12px 0 36px;
}

.field select {
  padding: 0 10px;
}

.field input:focus,
.field select:focus {
  outline: 0;
  border-color: var(--green);
  box-shadow: 0 0 0 3px rgba(11, 93, 30, .07);
}

.form-note,
.process-note {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  padding: 10px;
  border-radius: 10px;
  background: #f7f9f7;
  color: #748078;
  font-size: 9px;
  line-height: 1.45;
}

.form-note i,
.process-note i {
  color: var(--green);
  margin-top: 1px;
}

.submit-button {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  width: 100%;
  height: 44px;
  border: 0;
  border-radius: 10px;
  background: var(--green);
  color: #fff;
  font-size: 11px;
  font-weight: 850;
  cursor: pointer;
}

.submit-button:hover {
  filter: brightness(.96);
}

/* ==============================================================
   ROLE LIST
================================================================ */

.role-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.role-item {
  display: grid;
  grid-template-columns: 35px minmax(0, 1fr) auto;
  align-items: center;
  gap: 9px;
  padding: 9px;
  border: 1px solid #edf0ed;
  border-radius: 11px;
  background: #fbfcfb;
}

.role-item__icon {
  width: 35px;
  height: 35px;
  display: grid;
  place-items: center;
  border-radius: 10px;
  font-size: 11px;
}

.role-item__icon--admin {
  background: #f0eafd;
  color: #6433a5;
}

.role-item__icon--staff {
  background: #e6f3fa;
  color: #12617d;
}

.role-item__icon--client {
  background: #f0f2f1;
  color: #59625d;
}

.role-item strong {
  display: block;
  color: #39443c;
  font-size: 11px;
}

.role-item p {
  margin: 3px 0 0;
  color: #7c867f;
  font-size: 9px;
}

.role-tag {
  padding: 5px 8px;
  border-radius: 20px;
  font-size: 8px;
  font-weight: 900;
  text-transform: uppercase;
}

.role-tag--admin {
  background: #f0eafd;
  color: #6433a5;
}

.role-tag--staff {
  background: #e6f3fa;
  color: #12617d;
}

.role-tag--client {
  background: #f0f2f1;
  color: #59625d;
}

/* ==============================================================
   PROCESS LIST
================================================================ */

.process-list {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 14px;
  margin: 0 0 15px;
  padding: 0;
}

.process-list li {
  display: flex;
  align-items: flex-start;
  gap: 10px;
}

.process-number {
  width: 27px;
  height: 27px;
  flex: 0 0 27px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: var(--green-soft);
  color: var(--green);
  font-size: 8px;
  font-weight: 900;
}

.process-list strong {
  display: block;
  color: #39443c;
  font-size: 10px;
}

.process-list p {
  margin: 3px 0 0;
  color: #7c867f;
  font-size: 9px;
  line-height: 1.4;
}

/* ==============================================================
   PENDING SECTION
================================================================ */

.pending-section {
  margin-top: 17px;
  padding: 20px;
  border: 1px solid var(--line);
  border-radius: 17px;
  background: var(--surface);
  box-shadow: 0 6px 20px rgba(24, 43, 29, .04);
}

.pending-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 15px;
  margin-bottom: 13px;
}

.pending-header h2 {
  margin: 4px 0;
  color: #29352d;
  font-size: 20px;
}

.pending-header p {
  margin: 0;
  color: var(--muted);
  font-size: 10px;
}

.pending-count {
  min-width: 25px;
  padding: 5px 8px;
  box-sizing: border-box;
  border-radius: 20px;
  background: var(--green-soft);
  color: var(--green);
  text-align: center;
  font-size: 9px;
  font-weight: 900;
}

.pending-list {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin: 0;
  padding: 0;
}

.pending-card {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 11px;
  border: 1px solid #e5e9e6;
  border-radius: 11px;
}

.pending-card__icon {
  width: 34px;
  height: 34px;
  flex: 0 0 34px;
  display: grid;
  place-items: center;
  border-radius: 10px;
  background: var(--green-soft);
  color: var(--green);
  font-size: 11px;
}

.pending-card__details {
  min-width: 0;
  flex: 1;
}

.pending-card__details strong {
  display: block;
  overflow-wrap: anywhere;
  color: #39443c;
  font-size: 11px;
}

.pending-card__details small {
  display: block;
  margin-top: 3px;
  color: #8a938d;
  font-size: 8px;
}

.pending-empty {
  padding: 35px 20px;
  border: 1px dashed #d8dfda;
  border-radius: 12px;
  text-align: center;
}

.pending-empty__icon {
  width: 44px;
  height: 44px;
  margin: 0 auto;
  display: grid;
  place-items: center;
  border-radius: 13px;
  background: var(--green-soft);
  color: var(--green);
}

.pending-empty h3 {
  margin: 10px 0 4px;
  color: #3d4841;
  font-size: 14px;
}

.pending-empty p {
  margin: 0;
  color: var(--muted);
  font-size: 10px;
}

/* ==============================================================
   RESPONSIVE
================================================================ */

@media (max-width: 780px) {
  .invitation-sections {
    grid-template-columns: 1fr;
  }

  .invitation-card--form {
    grid-row: auto;
  }
}

@media (max-width: 500px) {
  .invitation-page {
    padding: 20px 13px 55px;
  }

  .invitation-card,
  .pending-section {
    padding: 16px;
  }

  .role-item {
    grid-template-columns: 34px minmax(0, 1fr);
  }

  .role-item .role-tag {
    grid-column: 2;
    justify-self: start;
  }

  .pending-card {
    align-items: flex-start;
  }

  .pending-card .role-tag {
    margin-left: auto;
  }
}
</style>
