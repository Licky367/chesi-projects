<% const pending = Array.isArray(invitations) ? invitations : []; %>
<section class="iv">
<a class="back" href="/auth/users"><i class="fas fa-arrow-left"></i> Users</a><header><span>ACCESS CONTROL</span><h1>Invite a user</h1><p>Reserve a role for an email address before the person creates their account.</p></header>
<% if(req.query?.error){ %><div class="alert error"><i class="fas fa-circle-exclamation"></i><%= req.query.error %></div><% } %><% if(req.query?.success){ %><div class="alert success"><i class="fas fa-circle-check"></i><%= req.query.success %></div><% } %>
<div class="layout"><div class="panel"><div class="title"><div class="icon"><i class="fas fa-envelope"></i></div><div><h2>Create invitation</h2><p>The email controls the role granted at signup.</p></div></div><form action="/auth/users/invite" method="POST"><label>Email address</label><div class="input"><i class="fas fa-at"></i><input type="email" name="email" placeholder="name@example.com" required></div><label>Role to grant</label><select name="role" required><option value="staff">Staff</option><option value="client">Client</option><option value="admin">Admin</option></select><div class="guide"><div><b>Staff</b><span>Can be assigned a substation after registration.</span></div><div><b>Client</b><span>Standard client access.</span></div><div><b>Admin</b><span>Administrative access.</span></div></div><button class="submit"><i class="fas fa-paper-plane"></i> Save Invitation</button></form></div><aside class="info"><div class="icon"><i class="fas fa-shield-halved"></i></div><h2>How it works</h2><ol><li><b>1</b><span>Save the email and intended role.</span></li><li><b>2</b><span>The person signs up using that email.</span></li><li><b>3</b><span>The server automatically grants the saved role.</span></li></ol><p class="tip"><i class="fas fa-circle-info"></i> A signup without an invitation always becomes <strong>client</strong>.</p></aside></div>
<div class="pending"><div class="ph"><div><span>WAITING LIST</span><h2>Pending invitations</h2></div><b><%= pending.length %></b></div><% if(!pending.length){ %><div class="empty"><i class="fas fa-inbox"></i><h3>No pending invitations</h3><p>Saved invitations appear here until used.</p></div><% } else { %><div class="plist"><% pending.forEach(i=>{ %><div class="prow"><div><strong><%= i.email %></strong><small>Added <%= i.createdAt?new Date(i.createdAt).toLocaleDateString():'' %></small></div><em class="role <%= i.role %>"><%= i.role %></em></div><% }) %></div><% } %></div>
</section>
<style>
.iv{max-width:1050px;margin:auto;padding:24px 18px 70px}.back{display:inline-flex;gap:7px;color:#68736b;text-decoration:none;font-size:13px;font-weight:800;margin-bottom:28px}.iv header span,.ph span{color:#0b5d1e;font-size:11px;font-weight:900;letter-spacing:.12em}.iv header h1{margin:7px 0;color:#18251c;font-size:clamp(31px,5vw,43px)}.iv header p{margin:0;color:#69736c}.alert{padding:13px;border-radius:11px;margin:18px 0}.error{background:#fff1f2;color:#991b1b}.success{background:#f0fdf4;color:#166534}.layout{display:grid;grid-template-columns:1.35fr .65fr;gap:15px;margin-top:24px}.panel,.info,.pending{background:white;border:1px solid #e1e7e2;border-radius:18px;padding:21px}.title{display:flex;gap:12px;align-items:center;padding-bottom:18px;margin-bottom:20px;border-bottom:1px solid #edf0ed}.icon{width:44px;height:44px;display:grid;place-items:center;border-radius:13px;background:#edf6ef;color:#0b5d1e}.title h2,.info h2,.ph h2{margin:0;color:#29342d}.title p{margin:4px 0 0;color:#7a837d;font-size:12px}.panel label{display:block;margin:0 0 6px;color:#59635b;font-size:11px;font-weight:900}.input{position:relative;margin-bottom:16px}.input i{position:absolute;left:13px;top:15px;color:#7d877f}.input input,.panel select{width:100%;height:45px;box-sizing:border-box;border:1px solid #d7ded8;border-radius:10px;background:white;padding:0 12px}.input input{padding-left:37px}.input input:focus,.panel select:focus{outline:0;border-color:#0b5d1e;box-shadow:0 0 0 3px rgba(11,93,30,.08)}.guide{display:grid;gap:7px;margin:17px 0}.guide div{padding:10px;border-radius:10px;background:#f7f9f7}.guide b{display:block;color:#354038;font-size:12px}.guide span{display:block;color:#7b857e;font-size:11px;margin-top:2px}.submit{width:100%;height:45px;border:0;border-radius:10px;background:#0b5d1e;color:white;font-weight:850;cursor:pointer}.info{align-self:start}.info ol{list-style:none;padding:0;margin:20px 0;display:grid;gap:16px}.info li{display:flex;gap:10px;align-items:flex-start}.info li b{width:24px;height:24px;display:grid;place-items:center;border-radius:50%;background:#edf6ef;color:#0b5d1e;font-size:11px}.info li span{color:#68736c;font-size:12px;line-height:1.5}.tip{display:flex;gap:8px;margin:0;padding:11px;border-radius:10px;background:#f7f9f7;color:#68736c;font-size:11px;line-height:1.5}.tip i{color:#0b5d1e}.pending{margin-top:22px}.ph{display:flex;justify-content:space-between;align-items:end;margin-bottom:13px}.ph h2{margin-top:4px;font-size:20px}.ph>b{padding:5px 8px;border-radius:20px;background:#edf6ef;color:#0b5d1e;font-size:11px}.plist{display:grid;gap:8px}.prow{display:flex;justify-content:space-between;align-items:center;gap:15px;border:1px solid #e5e9e6;border-radius:11px;padding:12px}.prow strong{display:block;font-size:13px;color:#39433c;overflow-wrap:anywhere}.prow small{display:block;margin-top:3px;color:#8a938d;font-size:10px}.role{font-style:normal;font-size:9px;font-weight:900;padding:5px 8px;border-radius:20px;text-transform:uppercase}.role.admin{background:#f0eafd;color:#6433a5}.role.staff{background:#e6f3fa;color:#12617d}.role.client{background:#f0f2f1;color:#59625d}.empty{text-align:center;padding:35px;color:#7b857e}.empty i{font-size:23px;color:#0b5d1e}.empty h3{margin:9px 0 4px;color:#3f4942;font-size:14px}.empty p{margin:0;font-size:11px}@media(max-width:760px){.layout{grid-template-columns:1fr}}@media(max-width:500px){.iv{padding:19px 13px 55px}.panel,.info,.pending{padding:17px}}
</style>