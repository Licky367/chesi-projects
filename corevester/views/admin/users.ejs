<%
const list = Array.isArray(users) ? users : [];
const t = ['all','admin','staff','client'].includes(tab) ? tab : 'all';
const shown = t === 'all' ? list : list.filter(u => u.role === t);
const count = r => list.filter(u => u.role === r).length;
%>

<section class="um">

  <!-- =========================================================
       PAGE HEADER
  ========================================================== -->
  <header class="um-header">
    <div class="um-header-copy">
      <span class="eyebrow">USER MANAGEMENT</span>
      <h1>Manage Users</h1>
      <p>Organize accounts, roles and staff assignments.</p>
    </div>

    <a class="um-primary-button" href="/auth/users/invitation">
      <i class="fas fa-user-plus"></i>
      <span>Invite User</span>
    </a>
  </header>

  <!-- =========================================================
       ALERTS
  ========================================================== -->
  <% if (req.query?.error) { %>
    <div class="um-alert um-alert-error">
      <i class="fas fa-circle-exclamation"></i>
      <span><%= req.query.error %></span>
    </div>
  <% } %>

  <% if (req.query?.success) { %>
    <div class="um-alert um-alert-success">
      <i class="fas fa-circle-check"></i>
      <span><%= req.query.success %></span>
    </div>
  <% } %>

  <!-- =========================================================
       SUMMARY CONTAINERS
  ========================================================== -->
  <section class="um-summary" aria-label="User summary">

    <div class="um-summary-card">
      <div class="um-summary-icon"><i class="fas fa-users"></i></div>
      <div>
        <strong><%= list.length %></strong>
        <span>Total Users</span>
      </div>
    </div>

    <div class="um-summary-card">
      <div class="um-summary-icon"><i class="fas fa-shield-halved"></i></div>
      <div>
        <strong><%= count('admin') %></strong>
        <span>Administrators</span>
      </div>
    </div>

    <div class="um-summary-card">
      <div class="um-summary-icon"><i class="fas fa-user-gear"></i></div>
      <div>
        <strong><%= count('staff') %></strong>
        <span>Staff</span>
      </div>
    </div>

    <div class="um-summary-card">
      <div class="um-summary-icon"><i class="fas fa-user"></i></div>
      <div>
        <strong><%= count('client') %></strong>
        <span>Clients</span>
      </div>
    </div>

  </section>

  <!-- =========================================================
       MAIN ARRANGEMENT
       LEFT  = SECTION BAR
       RIGHT = USER CONTAINERS
  ========================================================== -->
  <section class="um-workspace">

    <!-- =======================================================
         SECTION BAR
    ======================================================== -->
    <aside class="um-section-bar">

      <div class="um-section-bar-title">
        <span class="eyebrow">SECTIONS</span>
        <h2>User Accounts</h2>
        <p>Choose a group to display.</p>
      </div>

      <nav class="um-section-buttons" aria-label="User account sections">

        <a class="um-section-button <%= t === 'all' ? 'active' : '' %>"
           href="/auth/users?tab=all">
          <span class="um-section-button-icon">
            <i class="fas fa-users"></i>
          </span>
          <span class="um-section-button-copy">
            <strong>All Users</strong>
            <small>Every account</small>
          </span>
          <b><%= list.length %></b>
        </a>

        <a class="um-section-button <%= t === 'admin' ? 'active' : '' %>"
           href="/auth/users?tab=admin">
          <span class="um-section-button-icon">
            <i class="fas fa-shield-halved"></i>
          </span>
          <span class="um-section-button-copy">
            <strong>Administrators</strong>
            <small>Admin accounts</small>
          </span>
          <b><%= count('admin') %></b>
        </a>

        <a class="um-section-button <%= t === 'staff' ? 'active' : '' %>"
           href="/auth/users?tab=staff">
          <span class="um-section-button-icon">
            <i class="fas fa-user-gear"></i>
          </span>
          <span class="um-section-button-copy">
            <strong>Staff</strong>
            <small>Staff accounts</small>
          </span>
          <b><%= count('staff') %></b>
        </a>

        <a class="um-section-button <%= t === 'client' ? 'active' : '' %>"
           href="/auth/users?tab=client">
          <span class="um-section-button-icon">
            <i class="fas fa-user"></i>
          </span>
          <span class="um-section-button-copy">
            <strong>Clients</strong>
            <small>Client accounts</small>
          </span>
          <b><%= count('client') %></b>
        </a>

      </nav>

      <div class="um-section-bar-note">
        <i class="fas fa-circle-info"></i>
        <span>Select a section to keep the list focused.</span>
      </div>

    </aside>

    <!-- =======================================================
         USERS
    ======================================================== -->
    <main class="um-users">

      <div class="um-users-heading">
        <div>
          <span class="eyebrow">ACCOUNTS</span>
          <h2>
            <%= t === 'all'
              ? 'All Users'
              : t.charAt(0).toUpperCase() + t.slice(1) + ' Users' %>
          </h2>
          <p>Accounts currently shown in this section.</p>
        </div>

        <span class="um-result-count">
          <%= shown.length %> account<%= shown.length === 1 ? '' : 's' %>
        </span>
      </div>

      <% if (!shown.length) { %>

        <div class="um-empty">
          <div class="um-empty-icon">
            <i class="fas fa-user-slash"></i>
          </div>
          <h3>No users here yet</h3>
          <p>There are no accounts in this category.</p>
        </div>

      <% } else { %>

        <!-- USER LIST -->
        <ul class="um-user-list">

          <% shown.forEach(account => { %>

            <!-- =================================================
                 ONE LARGE USER CONTAINER
            ================================================== -->
            <li class="um-user-card">

              <!-- USER HEADER -->
              <div class="um-user-card-header">

                <div class="um-avatar">
                  <i class="fas fa-user"></i>
                </div>

                <div class="um-user-identity">
                  <h3><%= account.name %></h3>
                  <p>
                    <i class="fas fa-envelope"></i>
                    <%= account.email %>
                  </p>
                </div>

                <em class="um-role um-role-<%= account.role %>">
                  <%= account.role %>
                </em>

              </div>

              <!-- USER INFORMATION -->
              <div class="um-user-information">

                <div class="um-information-item">
                  <span>ACCOUNT</span>
                  <strong>
                    <i class="fas fa-circle-check"></i>
                    Active
                  </strong>
                </div>

                <div class="um-information-item">
                  <span>ROLE</span>
                  <strong><%= account.role %></strong>
                </div>

                <div class="um-information-item">
                  <span>SUBSTATION</span>
                  <strong>
                    <%= account.assignedSubstation?.name || 'Not assigned' %>
                  </strong>
                </div>

              </div>

              <!-- ROLE FORM -->
              <form
                action="/auth/users/<%= account._id %>/role"
                method="POST"
                class="um-form">

                <div class="um-form-heading">
                  <div>
                    <span>ACCOUNT ROLE</span>
                    <p>Change the access level for this account.</p>
                  </div>
                </div>

                <div class="um-form-row">

                  <div class="um-field">
                    <label for="role-<%= account._id %>">Role</label>
                    <div class="um-select-wrap">
                      <i class="fas fa-user-tag"></i>
                      <select id="role-<%= account._id %>" name="role">
                        <option value="admin" <%= account.role === 'admin' ? 'selected' : '' %>>
                          Admin
                        </option>
                        <option value="staff" <%= account.role === 'staff' ? 'selected' : '' %>>
                          Staff
                        </option>
                        <option value="client" <%= account.role === 'client' ? 'selected' : '' %>>
                          Client
                        </option>
                      </select>
                    </div>
                  </div>

                  <button type="submit" class="um-form-button">
                    <i class="fas fa-check"></i>
                    <span>Save Role</span>
                  </button>

                </div>
              </form>

              <!-- STAFF SUBSTATION FORM -->
              <% if (account.role === 'staff') { %>

                <form
                  action="/auth/users/<%= account._id %>/substation"
                  method="POST"
                  class="um-form um-form-staff">

                  <div class="um-form-heading">
                    <div>
                      <span>STAFF ASSIGNMENT</span>
                      <p>Choose the substation assigned to this staff account.</p>
                    </div>
                  </div>

                  <div class="um-form-row">

                    <div class="um-field">
                      <label for="substation-<%= account._id %>">
                        Substation
                      </label>

                      <div class="um-select-wrap">
                        <i class="fas fa-location-dot"></i>

                        <select
                          id="substation-<%= account._id %>"
                          name="assignedSubstation">

                          <option value="">Unassigned</option>

                          <% substations.forEach(s => { %>
                            <option
                              value="<%= s._id %>"
                              <%= account.assignedSubstation &&
                                  String(account.assignedSubstation._id) === String(s._id)
                                  ? 'selected'
                                  : '' %>>
                              <%= s.name %>
                            </option>
                          <% }) %>

                        </select>
                      </div>
                    </div>

                    <button type="submit" class="um-form-button">
                      <i class="fas fa-location-dot"></i>
                      <span>Assign Staff</span>
                    </button>

                  </div>
                </form>

              <% } else { %>

                <div class="um-card-note">
                  <i class="fas fa-location-dot"></i>
                  <span>Substation assignment is available for staff accounts.</span>
                </div>

              <% } %>

            </li>

          <% }) %>

        </ul>

      <% } %>

    </main>

  </section>

</section>

<style>
/* ==============================================================
   USER MANAGEMENT UI
   --------------------------------------------------------------
   Design direction:
   - Green / cream administration theme
   - Large rounded containers
   - Clear section boundaries
   - Vertical section bar
   - One user per large card
   - Properly designed forms
   - Comfortable spacing
================================================================ */

.um {
  --um-green: #176b2c;
  --um-green-dark: #0d4f1e;
  --um-green-light: #eaf5ed;
  --um-green-pale: #f5faf6;
  --um-ink: #203027;
  --um-text: #536158;
  --um-muted: #7c887f;
  --um-line: #dfe8e1;
  --um-line-light: #edf2ee;
  --um-white: #ffffff;
  --um-page: #f4f8f4;

  width: 100%;
  max-width: 1220px;
  margin: 0 auto;
  padding: 30px 20px 75px;
  box-sizing: border-box;
  color: var(--um-ink);
}

/* ==============================================================
   SHARED
================================================================ */

.um * {
  box-sizing: border-box;
}

.um .eyebrow {
  display: block;
  color: var(--um-green);
  font-size: 10px;
  font-weight: 900;
  letter-spacing: .14em;
}

/* ==============================================================
   PAGE HEADER
================================================================ */

.um-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24px;
  margin-bottom: 22px;
}

.um-header h1 {
  margin: 7px 0 5px;
  color: var(--um-ink);
  font-size: clamp(30px, 5vw, 43px);
  line-height: 1.05;
  letter-spacing: -.025em;
}

.um-header p {
  margin: 0;
  color: var(--um-muted);
  font-size: 13px;
}

.um-primary-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 9px;
  min-height: 44px;
  padding: 0 17px;
  border-radius: 11px;
  background: var(--um-green);
  color: #fff;
  text-decoration: none;
  font-size: 11px;
  font-weight: 900;
  box-shadow: 0 7px 17px rgba(23, 107, 44, .13);
  transition: transform .15s ease, background .15s ease;
}

.um-primary-button:hover {
  background: var(--um-green-dark);
  transform: translateY(-1px);
}

/* ==============================================================
   ALERTS
================================================================ */

.um-alert {
  display: flex;
  align-items: center;
  gap: 9px;
  margin-bottom: 15px;
  padding: 12px 14px;
  border-radius: 11px;
  font-size: 11px;
}

.um-alert-error {
  background: #fff0f1;
  color: #9b2027;
}

.um-alert-success {
  background: #edf9f0;
  color: #166534;
}

/* ==============================================================
   SUMMARY
================================================================ */

.um-summary {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10px;
  margin-bottom: 20px;
}

.um-summary-card {
  display: flex;
  align-items: center;
  gap: 12px;
  min-height: 76px;
  padding: 13px 15px;
  border: 1px solid var(--um-line);
  border-radius: 15px;
  background: var(--um-white);
  box-shadow: 0 4px 16px rgba(23, 58, 32, .035);
}

.um-summary-icon {
  width: 39px;
  height: 39px;
  flex: 0 0 39px;
  display: grid;
  place-items: center;
  border-radius: 11px;
  background: var(--um-green-light);
  color: var(--um-green);
  font-size: 12px;
}

.um-summary-card strong {
  display: block;
  color: var(--um-ink);
  font-size: 22px;
  line-height: 1;
}

.um-summary-card span {
  display: block;
  margin-top: 5px;
  color: var(--um-muted);
  font-size: 10px;
}

/* ==============================================================
   MAIN WORKSPACE
================================================================ */

.um-workspace {
  display: grid;
  grid-template-columns: 238px minmax(0, 1fr);
  gap: 17px;
  align-items: start;
}

/* ==============================================================
   VERTICAL SECTION BAR
================================================================ */

.um-section-bar {
  position: sticky;
  top: 15px;
  padding: 13px;
  border: 1px solid var(--um-line);
  border-radius: 17px;
  background: var(--um-white);
  box-shadow: 0 5px 18px rgba(23, 58, 32, .035);
}

.um-section-bar-title {
  padding: 5px 7px 14px;
  border-bottom: 1px solid var(--um-line-light);
}

.um-section-bar-title h2 {
  margin: 5px 0 3px;
  color: var(--um-ink);
  font-size: 15px;
}

.um-section-bar-title p {
  margin: 0;
  color: var(--um-muted);
  font-size: 10px;
}

.um-section-buttons {
  display: flex;
  flex-direction: column;
  gap: 5px;
  padding-top: 8px;
}

/* Large, clean button-like section containers */
.um-section-button {
  display: grid;
  grid-template-columns: 36px minmax(0, 1fr) auto;
  align-items: center;
  gap: 9px;
  min-height: 58px;
  padding: 8px;
  border: 1px solid transparent;
  border-radius: 12px;
  color: #68746c;
  text-decoration: none;
  transition: background .15s ease, border-color .15s ease, color .15s ease;
}

.um-section-button:hover {
  border-color: var(--um-line);
  background: var(--um-green-pale);
  color: var(--um-green);
}

.um-section-button.active {
  border-color: #d4e6d7;
  background: var(--um-green-light);
  color: var(--um-green-dark);
  box-shadow: inset 3px 0 0 var(--um-green);
}

.um-section-button-icon {
  width: 36px;
  height: 36px;
  display: grid;
  place-items: center;
  border-radius: 10px;
  background: #f1f4f1;
  color: #667269;
  font-size: 11px;
}

.um-section-button.active .um-section-button-icon {
  background: #fff;
  color: var(--um-green);
}

.um-section-button-copy {
  min-width: 0;
}

.um-section-button-copy strong {
  display: block;
  font-size: 10px;
  line-height: 1.25;
}

.um-section-button-copy small {
  display: block;
  margin-top: 3px;
  color: #89948c;
  font-size: 8px;
}

.um-section-button b {
  min-width: 22px;
  padding: 4px 5px;
  border-radius: 20px;
  background: #f0f3f0;
  color: #667269;
  text-align: center;
  font-size: 8px;
}

.um-section-button.active b {
  background: #fff;
  color: var(--um-green);
}

.um-section-bar-note {
  display: flex;
  align-items: flex-start;
  gap: 7px;
  margin-top: 10px;
  padding: 10px;
  border-radius: 10px;
  background: var(--um-green-pale);
  color: #7a867d;
  font-size: 8px;
  line-height: 1.45;
}

.um-section-bar-note i {
  color: var(--um-green);
  margin-top: 1px;
}

/* ==============================================================
   USERS AREA
================================================================ */

.um-users {
  min-width: 0;
}

.um-users-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 15px;
  margin-bottom: 12px;
  padding: 2px 2px 0;
}

.um-users-heading h2 {
  margin: 5px 0 3px;
  color: var(--um-ink);
  font-size: 21px;
}

.um-users-heading p {
  margin: 0;
  color: var(--um-muted);
  font-size: 10px;
}

.um-result-count {
  padding: 6px 9px;
  border-radius: 20px;
  background: var(--um-green-light);
  color: var(--um-green);
  font-size: 9px;
  font-weight: 900;
  white-space: nowrap;
}

/* ==============================================================
   USER LIST
================================================================ */

.um-user-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin: 0;
  padding: 0;
  list-style: none;
}

/* ==============================================================
   LARGE USER CONTAINER
================================================================ */

.um-user-card {
  overflow: hidden;
  border: 1px solid var(--um-line);
  border-radius: 17px;
  background: var(--um-white);
  box-shadow: 0 6px 20px rgba(23, 58, 32, .045);
}

/* Top identity area */
.um-user-card-header {
  display: flex;
  align-items: center;
  gap: 12px;
  min-height: 76px;
  padding: 15px 17px;
  background:
    linear-gradient(
      90deg,
      #f4faf5 0%,
      #ffffff 55%
    );
}

.um-avatar {
  width: 46px;
  height: 46px;
  flex: 0 0 46px;
  display: grid;
  place-items: center;
  border: 1px solid #d7e8da;
  border-radius: 13px;
  background: var(--um-green-light);
  color: var(--um-green);
  font-size: 14px;
}

.um-user-identity {
  min-width: 0;
  flex: 1;
}

.um-user-identity h3 {
  overflow-wrap: anywhere;
  margin: 0 0 4px;
  color: var(--um-ink);
  font-size: 15px;
}

.um-user-identity p {
  overflow-wrap: anywhere;
  margin: 0;
  color: var(--um-muted);
  font-size: 10px;
}

.um-user-identity p i {
  margin-right: 3px;
  color: var(--um-green);
  font-size: 8px;
}

.um-role {
  flex: 0 0 auto;
  padding: 5px 9px;
  border-radius: 20px;
  font-size: 8px;
  font-style: normal;
  font-weight: 900;
  text-transform: uppercase;
}

.um-role-admin {
  background: #f0eafd;
  color: #6333a2;
}

.um-role-staff {
  background: #e7f3f8;
  color: #14627c;
}

.um-role-client {
  background: #f0f2f0;
  color: #59635c;
}

/* ==============================================================
   USER INFORMATION STRIP
================================================================ */

.um-user-information {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  border-top: 1px solid var(--um-line-light);
  border-bottom: 1px solid var(--um-line-light);
  background: #fbfcfb;
}

.um-information-item {
  min-width: 0;
  padding: 11px 15px;
  border-right: 1px solid var(--um-line-light);
}

.um-information-item:last-child {
  border-right: 0;
}

.um-information-item span {
  display: block;
  margin-bottom: 5px;
  color: #919a94;
  font-size: 8px;
  font-weight: 900;
  letter-spacing: .08em;
}

.um-information-item strong {
  display: block;
  overflow-wrap: anywhere;
  color: #4b574f;
  font-size: 10px;
}

.um-information-item strong i {
  margin-right: 3px;
  color: var(--um-green);
  font-size: 8px;
}

/* ==============================================================
   FORMS
================================================================ */

.um-form {
  margin: 0;
  padding: 14px 17px;
}

.um-form + .um-form {
  border-top: 1px solid var(--um-line-light);
}

.um-form-heading {
  margin-bottom: 9px;
}

.um-form-heading span {
  display: block;
  color: #69756d;
  font-size: 8px;
  font-weight: 900;
  letter-spacing: .08em;
}

.um-form-heading p {
  margin: 3px 0 0;
  color: #89938c;
  font-size: 9px;
}

.um-form-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 9px;
  align-items: end;
}

.um-field {
  min-width: 0;
}

.um-field label {
  display: block;
  margin-bottom: 5px;
  color: #657168;
  font-size: 9px;
  font-weight: 800;
}

.um-select-wrap {
  position: relative;
}

.um-select-wrap > i {
  position: absolute;
  left: 12px;
  top: 13px;
  z-index: 1;
  color: #7c887f;
  font-size: 10px;
  pointer-events: none;
}

.um-select-wrap select {
  width: 100%;
  height: 38px;
  padding: 0 32px 0 33px;
  border: 1px solid #d4ded6;
  border-radius: 9px;
  outline: none;
  background: #fff;
  color: #3e4942;
  font-family: inherit;
  font-size: 10px;
  cursor: pointer;
  appearance: auto;
  transition: border-color .15s ease, box-shadow .15s ease;
}

.um-select-wrap select:hover {
  border-color: #b9cbbd;
}

.um-select-wrap select:focus {
  border-color: var(--um-green);
  box-shadow: 0 0 0 3px rgba(23, 107, 44, .08);
}

.um-form-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  height: 38px;
  padding: 0 14px;
  border: 0;
  border-radius: 9px;
  background: var(--um-green);
  color: #fff;
  font-family: inherit;
  font-size: 9px;
  font-weight: 900;
  white-space: nowrap;
  cursor: pointer;
  transition: background .15s ease, transform .15s ease;
}

.um-form-button:hover {
  background: var(--um-green-dark);
  transform: translateY(-1px);
}

.um-form-staff {
  background: #fbfdfb;
}

/* Non-staff informational container */
.um-card-note {
  display: flex;
  align-items: center;
  gap: 8px;
  margin: 0 17px 15px;
  padding: 9px 10px;
