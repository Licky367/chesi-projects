<%
const list = Array.isArray(users) ? users : [];
const activeTab = ["all", "admin", "staff", "client"].includes(tab) ? tab : "all";
const visibleUsers = activeTab === "all" ? list : list.filter(user => user.role === activeTab);
const roleCount = role => list.filter(user => user.role === role).length;
%>

<section class="users-page">
  <!-- =========================================================
       PAGE HEADER
  ========================================================== -->
  <header class="page-header">
    <div class="page-header__copy">
      <span class="section-label">ADMINISTRATION</span>
      <h1>User Management</h1>
      <p>Manage accounts, roles and staff assignments from one place.</p>
    </div>

    <a class="header-action" href="/auth/users/invitation">
      <i class="fas fa-user-plus"></i>
      <span>Invite User</span>
    </a>
  </header>

  <!-- =========================================================
       FLASH MESSAGES
  ========================================================== -->
  <% if (req.query?.error) { %>
    <div class="message message--error">
      <i class="fas fa-circle-exclamation"></i>
      <span><%= req.query.error %></span>
    </div>
  <% } %>

  <% if (req.query?.success) { %>
    <div class="message message--success">
      <i class="fas fa-circle-check"></i>
      <span><%= req.query.success %></span>
    </div>
  <% } %>

  <!-- =========================================================
       SUMMARY SECTION
  ========================================================== -->
  <section class="summary-section" aria-label="User summary">
    <div class="summary-card summary-card--total">
      <span class="summary-card__icon"><i class="fas fa-users"></i></span>
      <div>
        <strong><%= list.length %></strong>
        <span>Total Users</span>
      </div>
    </div>

    <div class="summary-card">
      <span class="summary-card__icon"><i class="fas fa-shield-halved"></i></span>
      <div>
        <strong><%= roleCount("admin") %></strong>
        <span>Administrators</span>
      </div>
    </div>

    <div class="summary-card">
      <span class="summary-card__icon"><i class="fas fa-user-gear"></i></span>
      <div>
        <strong><%= roleCount("staff") %></strong>
        <span>Staff</span>
      </div>
    </div>

    <div class="summary-card">
      <span class="summary-card__icon"><i class="fas fa-user"></i></span>
      <div>
        <strong><%= roleCount("client") %></strong>
        <span>Clients</span>
      </div>
    </div>
  </section>

  <!-- =========================================================
       MAIN CONTENT
       LEFT  = SECTION BAR
       RIGHT = USERS SECTION
  ========================================================== -->
  <section class="management-section">

    <!-- ===================== SECTION BAR ====================== -->
    <aside class="section-bar">
      <div class="section-bar__header">
        <span class="section-label">USER SECTIONS</span>
        <p>Choose what you want to view.</p>
      </div>

      <nav class="section-buttons" aria-label="User sections">
        <a class="section-button <%= activeTab === 'all' ? 'is-active' : '' %>"
           href="/auth/users?tab=all">
          <span class="section-button__icon"><i class="fas fa-users"></i></span>
          <span class="section-button__text">
            <strong>All Users</strong>
            <small>Every account</small>
          </span>
          <b><%= list.length %></b>
        </a>

        <a class="section-button <%= activeTab === 'admin' ? 'is-active' : '' %>"
           href="/auth/users?tab=admin">
          <span class="section-button__icon"><i class="fas fa-shield-halved"></i></span>
          <span class="section-button__text">
            <strong>Administrators</strong>
            <small>Admin accounts</small>
          </span>
          <b><%= roleCount("admin") %></b>
        </a>

        <a class="section-button <%= activeTab === 'staff' ? 'is-active' : '' %>"
           href="/auth/users?tab=staff">
          <span class="section-button__icon"><i class="fas fa-user-gear"></i></span>
          <span class="section-button__text">
            <strong>Staff</strong>
            <small>Staff accounts</small>
          </span>
          <b><%= roleCount("staff") %></b>
        </a>

        <a class="section-button <%= activeTab === 'client' ? 'is-active' : '' %>"
           href="/auth/users?tab=client">
          <span class="section-button__icon"><i class="fas fa-user"></i></span>
          <span class="section-button__text">
            <strong>Clients</strong>
            <small>Client accounts</small>
          </span>
          <b><%= roleCount("client") %></b>
        </a>
      </nav>

      <div class="section-bar__footer">
        <i class="fas fa-circle-info"></i>
        <span>Use the sections above to keep the account list focused.</span>
      </div>
    </aside>

    <!-- ====================== USERS SECTION =================== -->
    <main class="users-section">
      <header class="users-section__header">
        <div>
          <span class="section-label">ACCOUNTS</span>
          <h2>
            <%= activeTab === "all"
              ? "All Users"
              : activeTab.charAt(0).toUpperCase() + activeTab.slice(1) + " Users" %>
          </h2>
          <p>
            <%= visibleUsers.length %>
            account<%= visibleUsers.length === 1 ? "" : "s" %> in this section.
          </p>
        </div>
      </header>

      <% if (!visibleUsers.length) { %>

        <div class="empty-section">
          <div class="empty-section__icon">
            <i class="fas fa-user-slash"></i>
          </div>
          <h3>No users in this section</h3>
          <p>There are currently no accounts matching this section.</p>
        </div>

      <% } else { %>

        <!-- IMPORTANT: USERS ARE A LIST -->
        <ul class="user-list">
          <% visibleUsers.forEach(account => { %>

            <li class="user-card">
              <!-- USER IDENTITY -->
              <div class="user-card__identity">
                <div class="user-avatar">
                  <i class="fas fa-user"></i>
                </div>

                <div class="user-card__name">
                  <h3><%= account.name %></h3>
                  <p><i class="fas fa-envelope"></i> <%= account.email %></p>
                </div>

                <span class="role-badge role-badge--<%= account.role %>">
                  <%= account.role %>
                </span>
              </div>

              <!-- USER INFORMATION -->
              <div class="user-card__details">
                <div class="detail-item">
                  <span class="detail-item__label">ACCOUNT</span>
                  <span class="detail-item__value">
                    <i class="fas fa-circle-check"></i>
                    Active account
                  </span>
                </div>

                <div class="detail-item">
                  <span class="detail-item__label">ROLE</span>
                  <span class="detail-item__value">
                    <%= account.role %>
                  </span>
                </div>

                <% if (account.role === "staff") { %>
                  <div class="detail-item">
                    <span class="detail-item__label">SUBSTATION</span>
                    <span class="detail-item__value">
                      <%= account.assignedSubstation?.name || "Unassigned" %>
                    </span>
                  </div>
                <% } %>
              </div>

              <!-- USER CONTROLS -->
              <div class="user-card__controls">

                <form action="/auth/users/<%= account._id %>/role"
                      method="POST"
                      class="control-block">

                  <label for="role-<%= account._id %>">ACCOUNT ROLE</label>

                  <div class="control-row">
                    <select id="role-<%= account._id %>" name="role">
                      <option value="admin" <%= account.role === "admin" ? "selected" : "" %>>
                        Admin
                      </option>
                      <option value="staff" <%= account.role === "staff" ? "selected" : "" %>>
                        Staff
                      </option>
                      <option value="client" <%= account.role === "client" ? "selected" : "" %>>
                        Client
                      </option>
                    </select>

                    <button type="submit" class="control-button">
                      <i class="fas fa-check"></i>
                      Save Role
                    </button>
                  </div>
                </form>

                <% if (account.role === "staff") { %>

                  <form action="/auth/users/<%= account._id %>/substation"
                        method="POST"
                        class="control-block">

                    <label for="substation-<%= account._id %>">
                      ASSIGNED SUBSTATION
                    </label>

                    <div class="control-row">
                      <select id="substation-<%= account._id %>"
                              name="assignedSubstation">

                        <option value="">Unassigned</option>

                        <% substations.forEach(s => { %>
                          <option value="<%= s._id %>"
                            <%= account.assignedSubstation &&
                                String(account.assignedSubstation._id) === String(s._id)
                                ? "selected"
                                : "" %>>
                            <%= s.name %>
                          </option>
                        <% }) %>

                      </select>

                      <button type="submit" class="control-button">
                        <i class="fas fa-location-dot"></i>
                        Assign
                      </button>
                    </div>
                  </form>

                <% } %>

              </div>
            </li>

          <% }) %>
        </ul>

      <% } %>
    </main>
  </section>
</section>

<style>
/* ==============================================================
   USER MANAGEMENT
   Structured into:
   1. Header
   2. Summary
   3. Section bar
   4. Users section
   5. Individual user cards
================================================================ */

.users-page {
  --green: #0b5d1e;
  --green-soft: #edf6ef;
  --ink: #1d2921;
  --text: #435048;
  --muted: #77827a;
  --line: #e1e8e3;
  --surface: #ffffff;
  --background: #f6f8f6;

  max-width: 1240px;
  margin: 0 auto;
  padding: 28px 20px 70px;
  color: var(--ink);
}

/* ==============================================================
   PAGE HEADER
================================================================ */

.page-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 25px;
  margin-bottom: 22px;
}

.section-label {
  display: block;
  color: var(--green);
  font-size: 10px;
  font-weight: 900;
  letter-spacing: .14em;
}

.page-header h1 {
  margin: 7px 0 6px;
  font-size: clamp(30px, 5vw, 44px);
  line-height: 1.05;
  letter-spacing: -.025em;
}

.page-header p {
  margin: 0;
  color: var(--muted);
  font-size: 13px;
}

.header-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 9px;
  min-height: 44px;
  padding: 0 17px;
  border-radius: 12px;
  background: var(--green);
  color: #fff;
  text-decoration: none;
  font-size: 12px;
  font-weight: 850;
  box-shadow: 0 7px 20px rgba(11, 93, 30, .12);
}

.header-action:hover {
  filter: brightness(.96);
}

/* ==============================================================
   MESSAGES
================================================================ */

.message {
  display: flex;
  align-items: center;
  gap: 9px;
  margin-bottom: 15px;
  padding: 12px 14px;
  border-radius: 11px;
  font-size: 12px;
}

.message--error {
  color: #991b1b;
  background: #fff1f2;
}

.message--success {
  color: #166534;
  background: #f0fdf4;
}

/* ==============================================================
   SUMMARY
================================================================ */

.summary-section {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 11px;
  margin-bottom: 20px;
}

.summary-card {
  display: flex;
  align-items: center;
  gap: 12px;
  min-height: 72px;
  padding: 13px 15px;
  box-sizing: border-box;
  border: 1px solid var(--line);
  border-radius: 15px;
  background: var(--surface);
  box-shadow: 0 5px 18px rgba(24, 43, 29, .035);
}

.summary-card__icon {
  width: 39px;
  height: 39px;
  flex: 0 0 39px;
  display: grid;
  place-items: center;
  border-radius: 11px;
  background: var(--green-soft);
  color: var(--green);
}

.summary-card strong {
  display: block;
  font-size: 22px;
  line-height: 1;
}

.summary-card div span {
  display: block;
  margin-top: 5px;
  color: var(--muted);
  font-size: 10px;
}

/* ==============================================================
   MAIN MANAGEMENT SECTION
   THIS IS THE MAJOR STRUCTURAL SECTION:
   LEFT = VERTICAL BAR
   RIGHT = USER LIST
================================================================ */

.management-section {
  display: grid;
  grid-template-columns: 245px minmax(0, 1fr);
  gap: 18px;
  align-items: start;
}

/* ==============================================================
   VERTICAL SECTION BAR
================================================================ */

.section-bar {
  position: sticky;
  top: 15px;
  padding: 12px;
  border: 1px solid var(--line);
  border-radius: 17px;
  background: var(--surface);
  box-shadow: 0 6px 20px rgba(24, 43, 29, .04);
}

.section-bar__header {
  padding: 7px 9px 13px;
  border-bottom: 1px solid #edf0ed;
  margin-bottom: 7px;
}

.section-bar__header p {
  margin: 5px 0 0;
  color: var(--muted);
  font-size: 10px;
  line-height: 1.4;
}

.section-buttons {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

/* Each tab is a proper button-like section item */
.section-button {
  display: grid;
  grid-template-columns: 34px minmax(0, 1fr) auto;
  align-items: center;
  gap: 9px;
  min-height: 54px;
  padding: 7px 8px;
  box-sizing: border-box;
  border-radius: 12px;
  text-decoration: none;
  color: #667169;
  transition: background .15s ease, color .15s ease, transform .15s ease;
}

.section-button:hover {
  background: #f6f9f6;
  color: var(--green);
}

.section-button.is-active {
  background: var(--green-soft);
  color: var(--green);
  box-shadow: inset 3px 0 0 var(--green);
}

.section-button__icon {
  width: 34px;
  height: 34px;
  display: grid;
  place-items: center;
  border-radius: 10px;
  background: #f5f7f5;
  font-size: 11px;
}

.section-button.is-active .section-button__icon {
  background: #fff;
}

.section-button__text {
  min-width: 0;
}

.section-button__text strong {
  display: block;
  font-size: 11px;
  line-height: 1.2;
}

.section-button__text small {
  display: block;
  margin-top: 3px;
  color: #8a938d;
  font-size: 9px;
}

.section-button b {
  min-width: 22px;
  box-sizing: border-box;
  padding: 4px 5px;
  border-radius: 20px;
  background: #f0f3f0;
  color: #69746d;
  text-align: center;
  font-size: 9px;
}

.section-button.is-active b {
  background: #fff;
  color: var(--green);
}

.section-bar__footer {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  margin-top: 10px;
  padding: 10px;
  border-radius: 10px;
  background: #f7f9f7;
  color: #7c867f;
  font-size: 9px;
  line-height: 1.45;
}

.section-bar__footer i {
  color: var(--green);
  margin-top: 1px;
}

/* ==============================================================
   USERS SECTION
================================================================ */

.users-section {
  min-width: 0;
}

.users-section__header {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: 12px;
  padding: 2px 1px 0;
}

.users-section__header h2 {
  margin: 5px 0 3px;
  font-size: 22px;
  letter-spacing: -.01em;
}

.users-section__header p {
  margin: 0;
  color: var(--muted);
  font-size: 11px;
}

/* ==============================================================
   USER LIST
================================================================ */

.user-list {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin: 0;
  padding: 0;
}

/* ==============================================================
   INDIVIDUAL USER CARD
================================================================ */

.user-card {
  overflow: hidden;
  border: 1px solid var(--line);
  border-radius: 17px;
  background: var(--surface);
  box-shadow: 0 6px 20px rgba(24, 43, 29, .04);
}

/* User identity row */
.user-card__identity {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 17px;
}

.user-avatar {
  width: 46px;
  height: 46px;
  flex: 0 0 46px;
  display: grid;
  place-items: center;
  border-radius: 13px;
  background: var(--green-soft);
  color: var(--green);
  font-size: 15px;
}

.user-card__name {
  min-width: 0;
  flex: 1;
}

.user-card__name h3 {
  margin: 0 0 4px;
  color: #27332b;
  font-size: 15px;
}

.user-card__name p {
  overflow-wrap: anywhere;
  margin: 0;
  color: #78827b;
  font-size: 11px;
}

.user-card__name p i {
  margin-right: 3px;
  font-size: 9px;
}

.role-badge {
  flex: 0 0 auto;
  padding: 5px 9px;
  border-radius: 20px;
  font-size: 9px;
  font-style: normal;
  font-weight: 900;
  letter-spacing: .02em;
  text-transform: uppercase;
}

.role-badge--admin {
  color: #6433a5;
  background: #f0eafd;
}

.role-badge--staff {
  color: #12617d;
  background: #e6f3fa;
}

.role-badge--client {
  color: #59625d;
  background: #f0f2f1;
}

/* Information strip */
.user-card__details {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  border-top: 1px solid #edf0ed;
  border-bottom: 1px solid #edf0ed;
  background: #fbfcfb;
}

.detail-item {
  min-width: 0;
  padding: 12px 15px;
  border-right: 1px solid #edf0ed;
}

.detail-item:last-child {
  border-right: 0;
}

.detail-item__label {
  display: block;
  margin-bottom: 5px;
  color: #909891;
  font-size: 8px;
  font-weight: 900;
  letter-spacing: .09em;
}

.detail-item__value {
  display: block;
  overflow-wrap: anywhere;
  color: #49544c;
  font-size: 10px;
  font-weight: 700;
}

.detail-item__value i {
  color: var(--green);
  margin-right: 4px;
  font-size: 8px;
}

/* Controls */
.user-card__controls {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 15px;
  padding: 15px 17px 17px;
}

.control-block {
  min-width: 0;
}

.control-block label {
  display: block;
  margin-bottom: 6px;
  color: #69746d;
  font-size: 8px;
  font-weight: 900;
  letter-spacing: .08em;
}

.control-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 7px;
}

.control-row select {
  width: 100%;
  min-width: 0;
  height: 39px;
  box-sizing: border-box;
  padding: 0 9px;
  border: 1px solid #d7ded8;
  border-radius: 9px;
  background: #fff;
  color: #39443c;
  font-size: 10px;
}

.control-row select:focus {
  outline: 0;
  border-color: var(--green);
  box-shadow: 0 0 0 3px rgba(11, 93, 30, .07);
}

.control-button {
  height: 39px;
  padding: 0 12px;
  border: 0;
  border-radius: 9px;
  background: var(--green-soft);
  color: var(--green);
  font-size: 10px;
  font-weight: 850;
  cursor: pointer;
  white-space: nowrap;
}

.control-button:hover {
  background: #e2f0e5;
}

/* ==============================================================
   EMPTY STATE
================================================================ */

.empty-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 250px;
  padding: 30px;
  box-sizing: border-box;
  border: 1px dashed #d7dfd9;
  border-radius: 16px;
  background: #fff;
  text-align: center;
}

.empty-section__icon {
  width: 48px;
  height: 48px;
  display: grid;
  place-items: center;
  border-radius: 14px;
  background: var(--green-soft);
  color: var(--green);
}

.empty-section h3 {
  margin: 12px 0 5px;
  font-size: 15px;
}

.empty-section p {
  margin: 0;
  color: var(--muted);
  font-size: 11px;
}

/* ==============================================================
   RESPONSIVE
================================================================ */

@media (max-width: 900px) {
  .management-section {
    grid-template-columns: 205px minmax(0, 1fr);
  }

  .user-card__controls {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 720px) {
  .summary-section {
    grid-template-columns: repeat(2, 1fr);
  }

  .management-section {
    grid-template-columns: 1fr;
  }

  .section-bar {
    position: static;
  }

  .section-buttons {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
  }

  .section-button {
    min-height: 58px;
  }
}

@media (max-width: 520px) {
  .users-page {
    padding: 20px 13px 55px;
  }

  .page-header {
    align-items: stretch;
    flex-direction: column;
  }

  .header-action {
    width: 100%;
    box-sizing: border-box;
  }

  .summary-section {
    gap: 8px;
  }

  .summary-card {
    min-height: 65px;
    padding: 10px;
  }

  .summary-card__icon {
    width: 34px;
    height: 34px;
    flex-basis: 34px;
  }

  .summary-card strong {
    font-size: 19px;
  }

  .section-buttons {
    grid-template-columns: 1fr;
  }

  .user-card__identity {
    align-items: flex-start;
    padding: 14px;
  }

  .role-badge {
    margin-left: auto;
  }

  .user-card__details {
    grid-template-columns: 1fr;
  }

  .detail-item {
    border-right: 0;
    border-bottom: 1px solid #edf0ed;
  }

  .detail-item:last-child {
    border-bottom: 0;
  }

  .user-card__controls {
    padding: 14px;
  }

  .control-row {
    grid-template-columns: 1fr;
  }

  .control-button {
    width: 100%;
  }
}
</style>
