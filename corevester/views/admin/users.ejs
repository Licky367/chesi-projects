<%
const userList = Array.isArray(users) ? users : [];
const currentTab = ["all","admin","staff","client"].includes(tab) ? tab : "all";
const filtered = currentTab==="all" ? userList : userList.filter(u=>String(u.role||"").toLowerCase()===currentTab);
const adminCount = userList.filter(u=>u.role==="admin").length;
const staffCount = userList.filter(u=>u.role==="staff").length;
const clientCount = userList.filter(u=>u.role==="client").length;
const totalCount = userList.length;
function active(t){ return currentTab===t; }
%>

<div style="width:100%;max-width:500px;margin:0 auto;padding:10px;box-sizing:border-box;background:#f6fbf6;font-family:system-ui,sans-serif;display:flex;flex-direction:column;gap:12px;">

  <!-- 1. USER MANAGEMENT - TOP -->
  <div style="background:#e8f2e6;border:1.5px solid #cfe1d3;border-radius:14px;padding:14px 16px;display:flex;align-items:center;gap:14px;">
    <div style="width:48px;height:48px;background:#fff;border-radius:50%;display:grid;place-items:center;font-size:22px;flex-shrink:0;">👥</div>
    <div>
      <div style="font-size:13px;font-weight:900;color:#0a4d1e;">USER MANAGEMENT</div>
      <div style="font-size:11px;color:#5a7d5a;margin-top:2px;">Organize accounts, roles and staff assignments.</div>
    </div>
  </div>

  <!-- 2. OVERVIEW - MIDDLE, NOW FILTERS -->
  <div style="background:#eef6ec;border:1.5px solid #cfe1d3;border-radius:14px;padding:12px;">
    <div style="font-size:10px;font-weight:900;letter-spacing:0.8px;color:#2e5a36;padding:0 4px 8px 4px;">OVERVIEW</div>
    
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
      <a href="/auth/users?tab=all" style="display:flex;flex-direction:column;padding:10px 12px;border-radius:10px;text-decoration:none;<%= active('all') ? 'background:#0a4d1e;color:#fff;border:1.5px solid #0a4d1e;' : 'background:#fff;color:#1a3d1a;border:1.5px solid #dbe9dc;' %>">
        <span style="font-size:11px;opacity:0.9;">👥 Total Users</span>
        <b style="font-size:18px;margin-top:2px;"><%= totalCount %></b>
      </a>
      <a href="/auth/users?tab=admin" style="display:flex;flex-direction:column;padding:10px 12px;border-radius:10px;text-decoration:none;<%= active('admin') ? 'background:#0a4d1e;color:#fff;border:1.5px solid #0a4d1e;' : 'background:#fff;color:#1a3d1a;border:1.5px solid #dbe9dc;' %>">
        <span style="font-size:11px;opacity:0.9;">🛡️ Administrators</span>
        <b style="font-size:18px;margin-top:2px;"><%= adminCount %></b>
      </a>
      <a href="/auth/users?tab=staff" style="display:flex;flex-direction:column;padding:10px 12px;border-radius:10px;text-decoration:none;<%= active('staff') ? 'background:#0a4d1e;color:#fff;border:1.5px solid #0a4d1e;' : 'background:#fff;color:#1a3d1a;border:1.5px solid #dbe9dc;' %>">
        <span style="font-size:11px;opacity:0.9;">⚙️ Staff</span>
        <b style="font-size:18px;margin-top:2px;"><%= staffCount %></b>
      </a>
      <a href="/auth/users?tab=client" style="display:flex;flex-direction:column;padding:10px 12px;border-radius:10px;text-decoration:none;<%= active('client') ? 'background:#0a4d1e;color:#fff;border:1.5px solid #0a4d1e;' : 'background:#fff;color:#1a3d1a;border:1.5px solid #dbe9dc;' %>">
        <span style="font-size:11px;opacity:0.9;">👤 Clients</span>
        <b style="font-size:18px;margin-top:2px;"><%= clientCount %></b>
      </a>
    </div>

    <a href="/auth/users/invitation" style="margin-top:10px;display:flex;align-items:center;justify-content:center;gap:6px;padding:11px;border:1.5px solid #0a4d1e;border-radius:10px;background:#fff;color:#0a4d1e;font-weight:800;text-decoration:none;font-size:12px;">+ Invite User</a>
  </div>

  <!-- 3. USERS - BOTTOM, FULL WIDTH -->
  <div style="background:#eef6ec;border:1.5px solid #cfe1d3;border-radius:14px;padding:10px;">
    <div style="background:#fff;border-radius:12px;padding:10px;">
      <div style="display:flex;justify-content:space-between;align-items:center;padding-bottom:10px;border-bottom:1px solid #eef2ee;">
        <div>
          <div style="font-size:12px;font-weight:900;color:#0a4d1e;">USERS - <%= currentTab.toUpperCase() %></div>
          <div style="font-size:10px;color:#777;margin-top:1px;"><%= filtered.length %> accounts in this section</div>
        </div>
        <div style="font-size:10px;font-weight:800;background:#e8f2e6;color:#0a4d1e;padding:5px 8px;border-radius:20px;"><%= currentTab %></div>
      </div>

      <div style="margin-top:10px;display:flex;flex-direction:column;gap:8px;">
        <% filtered.forEach(acc=>{ %>
          <div style="border:1.5px solid #dce9dc;border-radius:10px;padding:12px;display:flex;gap:10px;align-items:center;">
            <div style="width:42px;height:42px;background:#d9efdb;border-radius:50%;display:grid;place-items:center;font-size:20px;flex-shrink:0;">👤</div>
            <div style="flex:1;min-width:0;">
              <div style="font-size:13px;font-weight:800;color:#0a2e14;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"><%= acc.name %></div>
              <div style="font-size:10px;font-weight:700;margin-top:2px;display:inline-block;padding:3px 7px;border-radius:10px;<%= acc.role==='admin'?'background:#e8e0f7;color:#4a2c8a;':acc.role==='staff'?'background:#dbeeff;color:#164a7a;':'background:#fff6c5;color:#7a5a00;' %>"><%= acc.role %></div>
              <div style="font-size:10px;color:#666;margin-top:4px;word-break:break-all;">✉️ <%= acc.email %></div>
            </div>
            <button type="button" onclick="var m=document.getElementById('m-<%= acc._id %>'); m.style.display=m.style.display==='block'?'none':'block'" style="padding:6px 10px;border-radius:8px;border:1px solid #b8d8b8;background:#f5faf5;font-size:10px;font-weight:700;cursor:pointer;">⋮</button>
          </div>
          <div id="m-<%= acc._id %>" style="display:none;margin-top:-4px;margin-bottom:4px;background:#fff;border:1px solid #ddd;border-radius:10px;padding:8px;">
            <form action="/auth/users/<%= acc._id %>/role" method="POST" style="display:flex;gap:6px;">
              <select name="role" style="flex:1;padding:8px;border-radius:8px;border:1px solid #ddd;font-size:11px;"><option value="admin" <%= acc.role==='admin'?'selected':'' %>>Admin</option><option value="staff" <%= acc.role==='staff'?'selected':'' %>>Staff</option><option value="client" <%= acc.role==='client'?'selected':'' %>>Client</option></select>
              <button type="submit" style="padding:8px 12px;background:#0a4d1e;color:#fff;border:none;border-radius:8px;font-size:11px;font-weight:800;cursor:pointer;">Save</button>
            </form>
          </div>
        <% }) %>
      </div>
    </div>
  </div>

</div>