<% const list = Array.isArray(users) ? users : []; const t = ['all','admin','staff','client'].includes(tab) ? tab : 'all'; const shown = t === 'all' ? list : list.filter(u => u.role === t); const count = r => list.filter(u => u.role === r).length; %>
<section class="um">
  <header class="um-hero"><div><span>ADMINISTRATION</span><h1>User Management</h1><p>Manage accounts, roles and staff assignments.</p></div><a class="primary" href="/auth/users/invitation"><i class="fas fa-user-plus"></i> Invite User</a></header>
  <% if (req.query?.error) { %><div class="alert error"><i class="fas fa-circle-exclamation"></i><%= req.query.error %></div><% } %>
  <% if (req.query?.success) { %><div class="alert success"><i class="fas fa-circle-check"></i><%= req.query.success %></div><% } %>
  <div class="stats"><div><b><%= list.length %></b><small>Total Users</small></div><div><b><%= count('admin') %></b><small>Admins</small></div><div><b><%= count('staff') %></b><small>Staff</small></div><div><b><%= count('client') %></b><small>Clients</small></div></div>
  <nav class="tabs"><a class="<%= t==='all'?'active':'' %>" href="/auth/users?tab=all">All <b><%= list.length %></b></a><a class="<%= t==='admin'?'active':'' %>" href="/auth/users?tab=admin">Admins <b><%= count('admin') %></b></a><a class="<%= t==='staff'?'active':'' %>" href="/auth/users?tab=staff">Staff <b><%= count('staff') %></b></a><a class="<%= t==='client'?'active':'' %>" href="/auth/users?tab=client">Clients <b><%= count('client') %></b></a></nav>
  <div class="heading"><div><small>ACCOUNTS</small><h2><%= t==='all'?'All users':t.charAt(0).toUpperCase()+t.slice(1)+' users' %></h2></div><span><%= shown.length %> account<%= shown.length===1?'':'s' %></span></div>
  <% if (!shown.length) { %><div class="empty"><i class="fas fa-user-slash"></i><h3>No users here yet</h3><p>There are no accounts in this category.</p></div><% } else { %><div class="grid"><% shown.forEach(account => { %><article class="card"><div class="top"><div class="avatar"><i class="fas fa-user"></i></div><div class="identity"><h3><%= account.name %></h3><p><%= account.email %></p></div><em class="role <%= account.role %>"><%= account.role %></em></div><hr><form action="/auth/users/<%= account._id %>/role" method="POST"><label>ACCOUNT ROLE</label><div class="row"><select name="role"><option value="admin" <%= account.role==='admin'?'selected':'' %>>Admin</option><option value="staff" <%= account.role==='staff'?'selected':'' %>>Staff</option><option value="client" <%= account.role==='client'?'selected':'' %>>Client</option></select><button>Save</button></div></form><% if(account.role==='staff'){ %><form action="/auth/users/<%= account._id %>/substation" method="POST"><label>ASSIGNED SUBSTATION</label><div class="row"><select name="assignedSubstation"><option value="">Unassigned</option><% substations.forEach(s=>{ %><option value="<%= s._id %>" <%= account.assignedSubstation&&String(account.assignedSubstation._id)===String(s._id)?'selected':'' %>><%= s.name %></option><% }) %></select><button>Assign</button></div></form><% } else { %><div class="note"><i class="fas fa-location-dot"></i> Substation assignment is available for staff.</div><% } %></article><% }) %></div><% } %>
</section>
<style>
.um{max-width:1180px;margin:auto;padding:28px 18px 70px}.um-hero{display:flex;justify-content:space-between;align-items:end;gap:20px;padding-bottom:25px}.um-hero span,.heading small{color:#0b5d1e;font-size:11px;font-weight:900;letter-spacing:.12em}.um-hero h1{margin:7px 0;color:#18251c;font-size:clamp(30px,5vw,44px)}.um-hero p{margin:0;color:#69736c}.primary{background:#0b5d1e;color:white;text-decoration:none;padding:13px 17px;border-radius:12px;font-weight:800}.alert{padding:13px 15px;border-radius:11px;margin-bottom:16px}.error{background:#fff1f2;color:#991b1b}.success{background:#f0fdf4;color:#166534}.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:20px}.stats>div{background:white;border:1px solid #e3e8e4;border-radius:14px;padding:15px}.stats b{display:block;font-size:23px;color:#17231a}.stats small{color:#7a837d}.tabs{display:flex;gap:4px;border-bottom:1px solid #e1e6e2;margin-bottom:27px;overflow:auto}.tabs a{padding:12px 15px;border-bottom:3px solid transparent;text-decoration:none;color:#68736b;font-weight:800;white-space:nowrap}.tabs a.active{color:#0b5d1e;border-color:#0b5d1e}.tabs b{font-size:10px;background:#f0f3f0;padding:3px 6px;border-radius:20px}.heading{display:flex;justify-content:space-between;align-items:end;margin-bottom:13px}.heading h2{margin:4px 0;color:#263129}.heading>span{color:#7b857e;font-size:12px}.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}.card{background:white;border:1px solid #e1e7e2;border-radius:17px;padding:18px}.top{display:flex;align-items:center;gap:12px}.avatar{width:45px;height:45px;border-radius:13px;display:grid;place-items:center;background:#edf6ef;color:#0b5d1e}.identity{min-width:0;flex:1}.identity h3{margin:0 0 3px;color:#263129;font-size:16px}.identity p{margin:0;color:#737d76;font-size:12px;overflow-wrap:anywhere}.role{font-style:normal;font-size:9px;font-weight:900;padding:5px 8px;border-radius:20px;text-transform:uppercase}.role.admin{background:#f0eafd;color:#6433a5}.role.staff{background:#e6f3fa;color:#12617d}.role.client{background:#f0f2f1;color:#59625d}.card hr{border:0;border-top:1px solid #edf0ed;margin:17px 0}.card form{margin-top:13px}.card label{display:block;font-size:10px;font-weight:900;color:#69736c;margin-bottom:6px;letter-spacing:.06em}.row{display:grid;grid-template-columns:1fr auto;gap:8px}.row select{min-width:0;width:100%;padding:10px;border:1px solid #d7ded8;border-radius:10px;background:white}.row button{border:0;border-radius:10px;background:#edf6ef;color:#0b5d1e;font-weight:850;padding:0 14px;cursor:pointer}.note{margin-top:13px;background:#f7f9f7;color:#7a837d;border-radius:10px;padding:10px;font-size:11px}.empty{padding:55px;text-align:center;border:1px dashed #d9dfda;border-radius:16px}.empty i{font-size:25px;color:#0b5d1e}.empty h3{margin:10px 0 4px}.empty p{margin:0;color:#7b857e;font-size:12px}@media(max-width:800px){.stats{grid-template-columns:repeat(2,1fr)}.grid{grid-template-columns:1fr}}@media(max-width:560px){.um{padding:20px 13px 50px}.um-hero{align-items:stretch;flex-direction:column}.primary{text-align:center}.card{padding:15px}.top{align-items:flex-start}.role{margin-left:auto}}
</style>