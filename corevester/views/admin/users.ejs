<%
const userList = Array.isArray(users) ? users : [];
const currentTab = ["all","admin","staff","client"].includes(tab) ? tab : "all";
const filtered = currentTab==="all" ? userList : userList.filter(u=>String(u.role||"").toLowerCase()===currentTab);
const adminCount = userList.filter(u=>u.role==="admin").length;
const staffCount = userList.filter(u=>u.role==="staff").length;
const clientCount = userList.filter(u=>u.role==="client").length;
%>

<div style="max-width:1240px;margin:0 auto;padding:12px;box-sizing:border-box;font-family:Inter,system-ui,sans-serif;background:#f6fbf6;">
  
  <!-- GRID: left 260px + right 1fr -->
  <div style="display:grid;grid-template-columns:260px 1fr;gap:14px;align-items:start;">

    <!-- LEFT -->
    <div style="display:flex;flex-direction:column;gap:14px;">
      <div style="background:#eef6ec;border:1.5px solid #cfe1d3;border-radius:14px;padding:10px;">
        <div style="font-size:11px;font-weight:800;color:#3a6b4a;letter-spacing:0.8px;padding:6px 8px;">SECTIONS</div>
        <a href="/auth/users?tab=all" style="display:flex;align-items:center;gap:10px;padding:12px 12px;border-radius:10px;text-decoration:none;font-weight:800;font-size:13px;<%= currentTab==='all' ? 'background:#0a4d1e;color:#fff;' : 'background:#fff;color:#1a3d1a;border:1px solid #dbe9dc;' %>"><span style="width:22px;">👥</span> All Users</a>
        <a href="/auth/users?tab=admin" style="display:flex;align-items:center;gap:10px;padding:12px 12px;border-radius:10px;text-decoration:none;font-weight:700;font-size:13px;margin-top:6px;<%= currentTab==='admin' ? 'background:#0a4d1e;color:#fff;' : 'background:#fff;color:#1a3d1a;border:1px solid #dbe9dc;' %>"><span style="width:22px;">🛡️</span> Administrators</a>
        <a href="/auth/users?tab=staff" style="display:flex;align-items:center;gap:10px;padding:12px 12px;border-radius:10px;text-decoration:none;font-weight:700;font-size:13px;margin-top:6px;<%= currentTab==='staff' ? 'background:#0a4d1e;color:#fff;' : 'background:#fff;color:#1a3d1a;border:1px solid #dbe9dc;' %>"><span style="width:22px;">⚙️</span> Staff</a>
        <a href="/auth/users?tab=client" style="display:flex;align-items:center;gap:10px;padding:12px 12px;border-radius:10px;text-decoration:none;font-weight:700;font-size:13px;margin-top:6px;<%= currentTab==='client' ? 'background:#0a4d1e;color:#fff;' : 'background:#fff;color:#1a3d1a;border:1px solid #dbe9dc;' %>"><span style="width:22px;">👤</span> Clients</a>
      </div>

      <div style="background:#eef6ec;border:1.5px solid #cfe1d3;border-radius:14px;padding:10px;">
        <div style="font-size:11px;font-weight:800;color:#3a6b4a;letter-spacing:0.8px;padding:6px 8px;">OVERVIEW</div>
        <div style="background:#fff;border-radius:10px;padding:4px 8px;">
          <div style="display:flex;justify-content:space-between;padding:10px 4px;font-size:13px;border-bottom:1px solid #eef2ee;"><span>👥 Total Users</span><b><%= userList.length %></b></div>
          <div style="display:flex;justify-content:space-between;padding:10px 4px;font-size:13px;border-bottom:1px solid #eef2ee;"><span>🛡️ Administrators</span><b><%= adminCount %></b></div>
          <div style="display:flex;justify-content:space-between;padding:10px 4px;font-size:13px;border-bottom:1px solid #eef2ee;"><span>⚙️ Staff</span><b><%= staffCount %></b></div>
          <div style="display:flex;justify-content:space-between;padding:10px 4px;font-size:13px;"><span>👤 Clients</span><b><%= clientCount %></b></div>
        </div>
        <a href="/auth/users/invitation" style="display:flex;align-items:center;justify-content:center;gap:8px;margin-top:10px;padding:12px;border:1.5px solid #0a4d1e;border-radius:10px;background:#fff;color:#0a4d1e;font-weight:800;text-decoration:none;font-size:13px;">+ Invite User</a>
      </div>
    </div>

    <!-- RIGHT -->
    <div style="display:flex;flex-direction:column;gap:14px;">
      <div style="background:#e8f2e6;border:1.5px solid #cfe1d3;border-radius:14px;padding:16px;display:flex;align-items:center;gap:16px;">
        <div style="width:56px;height:56px;background:#fff;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:28px;">👥</div>
        <div><div style="font-size:14px;font-weight:900;color:#0a4d1e;letter-spacing:0.5px;">USER MANAGEMENT</div><div style="font-size:12px;color:#5a7d5a;margin-top:2px;">Organize accounts, roles and staff assignments.</div></div>
      </div>

      <div style="background:#eef6ec;border:1.5px solid #cfe1d3;border-radius:14px;padding:10px;">
        <div style="background:#fff;border-radius:12px;padding:12px;">
          <div style="display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;">
            <div><div style="font-size:13px;font-weight:900;display:flex;align-items:center;gap:6px;">👥 ALL USERS</div><div style="font-size:11px;color:#777;margin-top:2px;">Accounts currently shown in this section.</div></div>
            <select onchange="location.href='/auth/users?tab='+this.value" style="padding:8px 12px;border-radius:8px;border:1.5px solid #d5e8d0;background:#fff;font-size:12px;">
              <option value="all" <%= currentTab==='all'?'selected':'' %>>All Users</option><option value="admin" <%= currentTab==='admin'?'selected':'' %>>Administrators</option><option value="staff" <%= currentTab==='staff'?'selected':'' %>>Staff</option><option value="client" <%= currentTab==='client'?'selected':'' %>>Clients</option>
            </select>
          </div>

          <div style="margin-top:12px;display:flex;flex-direction:column;gap:10px;">
            <% filtered.forEach(acc=>{ %>
            <div style="background:#fff;border:1.5px solid #dbe9dc;border-radius:12px;padding:14px;display:flex;align-items:center;gap:14px;">
              <div style="width:52px;height:52px;background:#d9efdb;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:26px;flex-shrink:0;">👤</div>
              <div style="flex:1;min-width:0;">
                <div style="font-size:14px;font-weight:800;color:#0a2e14;"><%= acc.name %></div>
                <div style="display:inline-flex;margin-top:4px;padding:4px 10px;border-radius:20px;font-size:11px;font-weight:700;<%= acc.role==='admin'?'background:#e8e0f7;color:#4a2c8a;':acc.role==='staff'?'background:#dbeeff;color:#0a4d8a;':'background:#fff3cd;color:#7a5a00;' %>"><%= acc.role %></div>
                <div style="margin-top:6px;font-size:11px;color:#555;overflow-wrap:break-word;">✉️ <%= acc.email %></div>
                <div style="margin-top:2px;font-size:11px;color:#555;">📅 Joined <%= acc.createdAt ? new Date(acc.createdAt).toDateString() : 'Recently' %></div>
              </div>
              <button type="button" onclick="document.getElementById('m-<%= acc._id %>').style.display = document.getElementById('m-<%= acc._id %>').style.display==='block' ? 'none' : 'block'" style="padding:8px 12px;border-radius:8px;border:1.5px solid #b8d8b8;background:#f5faf5;font-size:12px;font-weight:700;cursor:pointer;flex-shrink:0;">⋮ Actions</button>
            </div>
            <% }) %>
          </div>
        </div>
      </div>
    </div>

  </div>
</div>

<style>@media(max-width:800px){ div[style*="grid-template-columns:260px 1fr"]{grid-template-columns:1fr !important;}}</style>