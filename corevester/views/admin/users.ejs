<%
// ============================================================
// USER MANAGEMENT
// UI: large rounded containers / green theme
// Existing data expected:
//   users, substations
// Existing query feedback:
//   req.query.error, req.query.success
// ============================================================
const userList = Array.isArray(users) ? users : [];
const currentTab = ["all", "admin", "staff", "client"].includes(tab) ? tab : "all";

const filteredUsers =
  currentTab === "all"
    ? userList
    : userList.filter(user => String(user.role || "").toLowerCase() === currentTab);

const adminCount  = userList.filter(u => u.role === "admin").length;
const staffCount  = userList.filter(u => u.role === "staff").length;
const clientCount = userList.filter(u => u.role === "client").length;
%>

<style>
/* ============================================================
   USER MANAGEMENT UI
   ------------------------------------------------------------
   Large containers inspired by the supplied hand-drawn layout.
   No dashboard tiles scattered across the page.
============================================================ */

.um-page,
.um-page * {
  box-sizing: border-box;
}

.um-page {
  --green: #176b2c;
  --green-dark: #0d5422;
  --green-soft: #eaf6ed;
  --green-pale: #f5faf6;
  --green-border: #cfe1d3;

  --ink: #1d2a21;
  --text: #56645a;
  --muted: #879188;

  --border: #dce6de;
  --border-soft: #edf2ee;
  --white: #ffffff;
  --page: #f7faf7;

  width: 100%;
  max-width: 1180px;
  margin: 0 auto;
  padding: 24px 18px 70px;
  color: var(--ink);
  font-family: inherit;
}

/* -------------------- common -------------------- */

.um-page button,
.um-page input,
.um-page select {
  font: inherit;
}

.um-eyebrow {
  display: block;
  margin: 0;
  color: var(--green);
  font-size: 10px;
  line-height: 1;
  font-weight: 900;
  letter-spacing: .13em;
}

.um-page h1,
.um-page h2,
.um-page h3,
.um-page p {
  margin-top: 0;
}

/* -------------------- page header -------------------- */

.um-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 22px;
}

.um-header h1 {
  margin: 8px 0 5px;
  font-size: clamp(30px, 5vw, 44px);
  line-height: 1;
  letter-spacing: -.035em;
  font-weight: 800;
}

.um-header-description {
  margin: 0;
  color: var(--text);
  font-size: 13px;
}

.um-invite-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-height: 43px;
  padding: 0 17px;
  border: 1px solid var(--green);
  border-radius: 10px;
  background: var(--green);
  color: #fff;
  text-decoration: none;
  font-size: 11px;
  font-weight: 800;
  white-space: nowrap;
  box-shadow: 0 5px 13px rgba(23,107,44,.13);
}

.um-invite-button:hover {
  background: var(--green-dark);
}

/* -------------------- feedback -------------------- */

.um-alert {
  display: flex;
  align-items: center;
  gap: 9px;
  margin-bottom: 13px;
  padding: 11px 13px;
  border-radius: 10px;
  font-size: 11px;
}

.um-alert-success {
  background: #eaf8ee;
  color: #176b2c;
}

.um-alert-error {
  background: #fff0f0;
  color: #a22525;
}

/* ============================================================
   THE LARGE SUMMARY CONTAINER
============================================================ */

.um-summary-container {
  margin-bottom: 17px;
  padding: 15px;
  border: 1px solid var(--border);
  border-radius: 17px;
  background: var(--white);
  box-shadow: 0 5px 18px rgba(22,60,32,.035);
}

.um-summary-title {
  margin: 0 0 11px;
  color: #637067;
  font-size: 9px;
  font-weight: 900;
  letter-spacing: .11em;
}

.um-summary-list {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 9px;
  margin: 0;
  padding: 0;
  list-style: none;
}

.um-summary-item {
  display: flex;
  align-items: center;
  gap: 10px;
  min-height: 62px;
  padding: 10px 12px;
  border: 1px solid var(--border-soft);
  border-radius: 11px;
  background: var(--green-pale);
}

.um-summary-icon {
  width: 34px;
  height: 34px;
  flex: 0 0 34px;
  display: grid;
  place-items: center;
  border-radius: 9px;
  background: var(--green-soft);
  color: var(--green);
  font-size: 13px;
}

.um-summary-number {
  display: block;
  color: var(--ink);
  font-size: 19px;
  line-height: 1;
  font-weight: 800;
}

.um-summary-label {
  display: block;
  margin-top: 4px;
  color: var(--muted);
  font-size: 9px;
}

/* ============================================================
   MAIN CONTAINER
============================================================ */

.um-main-container {
  padding: 15px;
  border: 1px solid var(--border);
  border-radius: 19px;
  background: var(--white);
  box-shadow: 0 6px 22px rgba(22,60,32,.045);
}

.um-main-heading {
  padding: 7px 8px 14px;
  border-bottom: 1px solid var(--border-soft);
}

.um-main-heading h2 {
  margin: 6px 0 4px;
  font-size: 20px;
  line-height: 1.1;
}

.um-main-heading p {
  margin: 0;
  color: var(--muted);
  font-size: 10px;
}

/* ============================================================
   VERTICAL SECTION BAR
============================================================ */

.um-section-bar {
  display: flex;
  flex-direction: column;
  gap: 6px;
  margin: 14px 0 17px;
  padding: 9px;
  border: 1px solid var(--green-border);
  border-radius: 13px;
  background: var(--green-pale);
}

.um-section-bar-title {
  padding: 3px 4px 7px;
  color: #68756c;
  font-size: 8px;
  font-weight: 900;
  letter-spacing: .1em;
}

.um-section-buttons {
  display: flex;
  flex-direction: column;
  gap: 5px;
  margin: 0;
  padding: 0;
  list-style: none;
}

.um-section-button {
  display: grid;
  grid-template-columns: 34px minmax(0,1fr) auto;
  align-items: center;
  gap: 9px;
  min-height: 52px;
  padding: 7px 9px;
  border: 1px solid transparent;
  border-radius: 10px;
  background: transparent;
  color: var(--text);
  text-decoration: none;
}

.um-section-button:hover {
  background: #fff;
  border-color: var(--border);
}

.um-section-button.active {
  border-color: #c7ddcc;
  background: #fff;
  color: var(--green-dark);
  box-shadow: 0 3px 10px rgba(23,107,44,.05);
}

.um-section-icon {
  width: 34px;
  height: 34px;
  display: grid;
  place-items: center;
  border-radius: 9px;
  background: var(--green-soft);
  color: var(--green);
  font-size: 12px;
}

.um-section-copy strong {
  display: block;
  font-size: 10px;
  line-height: 1.2;
}

.um-section-copy small {
  display: block;
  margin-top: 3px;
  color: var(--muted);
  font-size: 8px;
}

.um-section-count {
  min-width: 23px;
  padding: 4px 6px;
  border-radius: 20px;
  background: var(--green-soft);
  color: var(--green);
  text-align: center;
  font-size: 8px;
  font-weight: 900;
}

/* ============================================================
   ACCOUNTS CONTAINER
============================================================ */

.um-accounts-container {
  margin-top: 3px;
  padding: 13px;
  border: 1px solid var(--border);
  border-radius: 15px;
  background: #fbfdfb;
}

.um-accounts-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
  margin-bottom: 11px;
  padding: 2px 4px 10px;
  border-bottom: 1px solid var(--border-soft);
}

.um-accounts-heading h2 {
  margin: 5px 0 3px;
  font-size: 17px;
}

.um-accounts-heading p {
  margin: 0;
  color: var(--muted);
  font-size: 9px;
}

.um-account-count {
  padding: 5px 8px;
  border-radius: 20px;
  background: var(--green-soft);
  color: var(--green);
  font-size: 8px;
  font-weight: 900;
}

/* ============================================================
   USER LIST + LARGE USER CONTAINERS
============================================================ */

.um-user-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin: 0;
  padding: 0;
  list-style: none;
}

.um-user-card {
  overflow: hidden;
  border: 1px solid var(--border);
  border-radius: 14px;
  background: #fff;
}

/* Identity row */
.um-user-top {
  display: grid;
  grid-template-columns: 43px minmax(0,1fr) auto;
  align-items: center;
  gap: 11px;
  min-height: 70px;
  padding: 12px 14px;
  background: linear-gradient(90deg, #f1f9f3, #fff);
}

.um-avatar {
  width: 43px;
  height: 43px;
  display: grid;
  place-items: center;
  border: 1px solid #cfe1d3;
  border-radius: 12px;
  background: var(--green-soft);
  color: var(--green);
  font-size: 14px;
}

.um-user-name {
  margin: 0 0 4px;
  overflow-wrap: anywhere;
  font-size: 14px;
  font-weight: 800;
}

.um-user-email {
  margin: 0;
  overflow-wrap: anywhere;
  color: var(--muted);
  font-size: 9px;
}

.um-role {
  padding: 5px 8px;
  border-radius: 20px;
  font-size: 8px;
  font-style: normal;
  font-weight: 900;
  text-transform: uppercase;
}

.um-role-admin {
  background: #f0eafa;
  color: #653aa0;
}

.um-role-staff {
  background: #e7f3f7;
  color: #16627a;
}

.um-role-client {
  background: #eef1ef;
  color: #5c665f;
}

/* Info row */
.um-user-info {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  border-top: 1px solid var(--border-soft);
  border-bottom: 1px solid var(--border-soft);
  background: #fcfdfc;
}

.um-info-cell {
  min-width: 0;
  padding: 10px 13px;
  border-right: 1px solid var(--border-soft);
}

.um-info-cell:last-child {
  border-right: 0;
}

.um-info-cell span {
  display: block;
  margin-bottom: 4px;
  color: #919a94;
  font-size: 7px;
  font-weight: 900;
  letter-spacing: .09em;
}

.um-info-cell strong {
  display: block;
  overflow-wrap: anywhere;
  color: #4b574f;
  font-size: 9px;
}

/* ============================================================
   BEAUTIFUL FORM CONTAINERS
============================================================ */

.um-card-form {
  padding: 12px 14px;
}

.um-card-form + .um-card-form {
  border-top: 1px solid var(--border-soft);
  background: #fbfdfb;
}

.um-form-title {
  margin-bottom: 8px;
}

.um-form-title strong {
  display: block;
  color: #4d5a51;
  font-size: 8px;
  letter-spacing: .09em;
}

.um-form-title span {
  display: block;
  margin-top: 3px;
  color: var(--muted);
  font-size: 8px;
}

.um-form-row {
  display: grid;
  grid-template-columns: minmax(0,1fr) auto;
  align-items: end;
  gap: 9px;
}

.um-field label {
  display: block;
  margin-bottom: 5px;
  color: #657168;
  font-size: 8px;
  font-weight: 800;
}

.um-control {
  width: 100%;
  height: 38px;
  padding: 0 11px;
  border: 1px solid #d1ddd4;
  border-radius: 9px;
  outline: none;
  background: #fff;
  color: #3f4b43;
  font-size: 9px;
}

.um-control:focus {
  border-color: var(--green);
  box-shadow: 0 0 0 3px rgba(23,107,44,.08);
}

.um-save-button {
  height: 38px;
  padding: 0 14px;
  border: 0;
  border-radius: 9px;
  background: var(--green);
  color: #fff;
  font-size: 9px;
  font-weight: 900;
  cursor: pointer;
}

.um-save-button:hover {
  background: var(--green-dark);
}

.um-note {
  display: flex;
  align-items: center;
  gap: 7px;
  margin: 0 14px 13px;
  padding: 8px 9px;
  border-radius: 9px;
  background: var(--green-pale);
  color: #7b877e;
  font-size: 8px;
}

.um-note i {
  color: var(--green);
}

/* -------------------- empty -------------------- */

.um-empty {
  padding: 32px 18px;
  border: 1px dashed #cfdbd1;
  border-radius: 12px;
  background: #fff;
  text-align: center;
}

.um-empty-icon {
  width: 43px;
  height: 43px;
  margin: 0 auto;
  display: grid;
  place-items: center;
  border-radius: 12px;
  background: var(--green-soft);
  color: var(--green);
}

.um-empty h3 {
  margin: 9px 0 3px;
  font-size: 13px;
}

.um-empty p {
  margin: 0;
  color: var(--muted);
  font-size: 9px;
}

/* ============================================================
   MOBILE
============================================================ */

@media (max-width: 700px) {
  .um-page {
    padding: 18px 11px 55px;
  }

  .um-header {
    align-items: stretch;
    flex-direction: column;
  }

  .um-invite-button {
    width: 100%;
  }

  .um-summary-list {
    grid-template-columns: repeat(2, 1fr);
  }

  .um-main-container {
    padding: 11px;
  }

  .um-section-bar {
    margin-top: 11px;
  }

  .um-section-buttons {
    gap: 4px;
  }

  .um-user-top {
    grid-template-columns: 39px minmax(0,1fr);
  }

  .um-avatar {
    width: 39px;
    height: 39px;
  }

  .um-role {
    grid-column: 2;
    justify-self: start;
    margin-top: -4px;
  }

  .um-user-info {
    grid-template-columns: 1fr;
  }

  .um-info-cell {
    border-right: 0;
    border-bottom: 1px solid var(--border-soft);
  }

  .um-info-cell:last-child {
    border-bottom: 0;
  }

  .um-form-row {
    grid-template-columns: 1fr;
  }

  .um-save-button {
    width: 100%;
  }
}

@media (max-width: 420px) {
  .um-summary-list {
    grid-template-columns: 1fr;
  }

  .um-section-button {
    min-height: 49px;
  }
}
</style>

<section class="um-page">

  <!-- PAGE HEADER -->
  <header class="um-header">
    <div>
      <span class="um-eyebrow">USER MANAGEMENT</span>
      <h1>Manage Users</h1>
      <p class="um-header-description">
        Organize accounts, roles and staff assignments.
      </p>
    </div>

    <a class="um-invite-button" href="/auth/users/invitation">
      <i class="fas fa-user-plus"></i>
      Invite User
    </a>
  </header>

  <% if (req.query?.success) { %>
    <div class="um-alert um-alert-success">
      <i class="fas fa-circle-check"></i>
      <%= req.query.success %>
    </div>
  <% } %>

  <% if (req.query?.error) { %>
    <div class="um-alert um-alert-error">
      <i class="fas fa-circle-exclamation"></i>
      <%= req.query.error %>
    </div>
  <% } %>

  <!-- LARGE SUMMARY CONTAINER -->
  <section class="um-summary-container">

    <p class="um-summary-title">ACCOUNT SUMMARY</p>

    <ul class="um-summary-list">
      <li class="um-summary-item">
        <span class="um-summary-icon"><i class="fas fa-users"></i></span>
        <span>
          <strong class="um-summary-number"><%= userList.length %></strong>
          <span class="um-summary-label">Total Users</span>
        </span>
      </li>

      <li class="um-summary-item">
        <span class="um-summary-icon"><i class="fas fa-shield-halved"></i></span>
        <span>
          <strong class="um-summary-number"><%= adminCount %></strong>
          <span class="um-summary-label">Administrators</span>
        </span>
      </li>

      <li class="um-summary-item">
        <span class="um-summary-icon"><i class="fas fa-user-gear"></i></span>
        <span>
          <strong class="um-summary-number"><%= staffCount %></strong>
          <span class="um-summary-label">Staff</span>
        </span>
      </li>

      <li class="um-summary-item">
        <span class="um-summary-icon"><i class="fas fa-user"></i></span>
        <span>
          <strong class="um-summary-number"><%= clientCount %></strong>
          <span class="um-summary-label">Clients</span>
        </span>
      </li>
    </ul>

  </section>

  <!-- MAIN LARGE CONTAINER -->
  <section class="um-main-container">

    <header class="um-main-heading">
      <span class="um-eyebrow">SECTIONS</span>
      <h2>User Accounts</h2>
      <p>Choose a group to display.</p>
    </header>

    <!-- VERTICAL BAR / BUTTONS -->
    <nav class="um-section-bar" aria-label="User sections">

      <span class="um-section-bar-title">ACCOUNT GROUPS</span>

      <div class="um-section-buttons">

        <a
          class="um-section-button <%= currentTab === 'all' ? 'active' : '' %>"
          href="/auth/users?tab=all">

          <span class="um-section-icon"><i class="fas fa-users"></i></span>

          <span class="um-section-copy">
            <strong>All Users</strong>
            <small>Every account</small>
          </span>

          <b class="um-section-count"><%= userList.length %></b>
        </a>

        <a
          class="um-section-button <%= currentTab === 'admin' ? 'active' : '' %>"
          href="/auth/users?tab=admin">

          <span class="um-section-icon"><i class="fas fa-shield-halved"></i></span>

          <span class="um-section-copy">
            <strong>Administrators</strong>
            <small>Admin accounts</small>
          </span>

          <b class="um-section-count"><%= adminCount %></b>
        </a>

        <a
          class="um-section-button <%= currentTab === 'staff' ? 'active' : '' %>"
          href="/auth/users?tab=staff">

          <span class="um-section-icon"><i class="fas fa-user-gear"></i></span>

          <span class="um-section-copy">
            <strong>Staff</strong>
            <small>Staff accounts</small>
          </span>

          <b class="um-section-count"><%= staffCount %></b>
        </a>

        <a
          class="um-section-button <%= currentTab === 'client' ? 'active' : '' %>"
          href="/auth/users?tab=client">

          <span class="um-section-icon"><i class="fas fa-user"></i></span>

          <span class="um-section-copy">
            <strong>Clients</strong>
            <small>Client accounts</small>
          </span>

          <b class="um-section-count"><%= clientCount %></b>
        </a>

      </div>
    </nav>

    <!-- ACCOUNTS CONTAINER -->
    <section class="um-accounts-container">

      <header class="um-accounts-heading">
        <div>
          <span class="um-eyebrow">ACCOUNTS</span>
          <h2>
            <%= currentTab === "all"
              ? "All Users"
              : currentTab.charAt(0).toUpperCase() + currentTab.slice(1) + " Users" %>
          </h2>
          <p>Accounts currently shown in this section.</p>
        </div>

        <span class="um-account-count">
          <%= filteredUsers.length %>
        </span>
      </header>

      <% if (!filteredUsers.length) { %>

        <div class="um-empty">
          <div class="um-empty-icon">
            <i class="fas fa-user-slash"></i>
          </div>
          <h3>No users in this section</h3>
          <p>There are no accounts to display here.</p>
        </div>

      <% } else { %>

        <ul class="um-user-list">

          <% filteredUsers.forEach(account => { %>

            <li class="um-user-card">

              <!-- USER CONTAINER HEADER -->
              <div class="um-user-top">

                <div class="um-avatar">
                  <i class="fas fa-user"></i>
                </div>

                <div>
                  <h3 class="um-user-name"><%= account.name %></h3>
                  <p class="um-user-email">
                    <i class="fas fa-envelope"></i>
                    <%= account.email %>
                  </p>
                </div>

                <em class="um-role um-role-<%= account.role %>">
                  <%= account.role %>
                </em>

              </div>

              <!-- USER INFORMATION -->
              <div class="um-user-info">

                <div class="um-info-cell">
                  <span>ACCOUNT</span>
                  <strong>
                    <i class="fas fa-circle-check"></i>
                    Active
                  </strong>
                </div>

                <div class="um-info-cell">
                  <span>ROLE</span>
                  <strong><%= account.role %></strong>
                </div>

                <div class="um-info-cell">
                  <span>SUBSTATION</span>
                  <strong>
                    <%= account.assignedSubstation?.name || "Not assigned" %>
                  </strong>
                </div>

              </div>

              <!-- ROLE FORM -->
              <form
                class="um-card-form"
                action="/auth/users/<%= account._id %>/role"
                method="POST">

                <div class="um-form-title">
                  <strong>ACCOUNT ROLE</strong>
                  <span>Change the access level for this account.</span>
                </div>

                <div class="um-form-row">

                  <div class="um-field">
                    <label for="role-<%= account._id %>">ROLE</label>

                    <select
                      class="um-control"
                      id="role-<%= account._id %>"
                      name="role">

                      <option value="admin" <%= account.role === "admin" ? "selected" : "" %>>
                        Admin
                      </option>

                      <option value="staff" <%= account.role === "staff" ? "selected" : "" %>>
                        Staff
                      </option>

                      <option value="client" <%= account.role === "client" ? "selected" : "" %>>
                        Client
                      </option>

                    </select>
                  </div>

                  <button class="um-save-button" type="submit">
                    <i class="fas fa-check"></i>
                    Save Role
                  </button>

                </div>

              </form>

              <% if (account.role === "staff") { %>

                <!-- STAFF FORM -->
                <form
                  class="um-card-form"
                  action="/auth/users/<%= account._id %>/substation"
                  method="POST">

                  <div class="um-form-title">
                    <strong>STAFF ASSIGNMENT</strong>
                    <span>Choose the substation assigned to this staff account.</span>
                  </div>

                  <div class="um-form-row">

                    <div class="um-field">
                      <label for="substation-<%= account._id %>">
                        SUBSTATION
                      </label>

                      <select
                        class="um-control"
                        id="substation-<%= account._id %>"
                        name="assignedSubstation">

                        <option value="">Unassigned</option>

                        <% (Array.isArray(substations) ? substations : []).forEach(s => { %>

                          <option
                            value="<%= s._id %>"
                            <%= account.assignedSubstation &&
                                String(account.assignedSubstation._id) === String(s._id)
                                ? "selected"
                                : "" %>>

                            <%= s.name %>

                          </option>

                        <% }) %>

                      </select>

                    </div>

                    <button class="um-save-button" type="submit">
                      <i class="fas fa-location-dot"></i>
                      Assign Staff
                    </button>

                  </div>

                </form>

              <% } else { %>

                <div class="um-note">
                  <i class="fas fa-location-dot"></i>
                  Substation assignment is available for staff accounts.
                </div>

              <% } %>

            </li>

          <% }) %>

        </ul>

      <% } %>

    </section>

  </section>

</section>
