<%
/*
============================================================

COREVESTER ADMIN — USER MANAGEMENT
FILE:
    corevester/views/admin/users.ejs

UI direction:
    Reworked to closely follow the supplied mobile screenshot:
      - compact CoreVester-style green header
      - left section navigation on desktop
      - stacked section navigation on small screens
      - large rounded content containers
      - faint green/cream surfaces
      - user cards with Actions menus
      - existing routes and controller variables preserved

Expected controller data:
    users
    substations
    tab
    req
============================================================
*/

const userList = Array.isArray(users) ? users : [];

const currentTab =
  ["all", "admin", "staff", "client"].includes(String(tab))
    ? String(tab)
    : "all";

const normalizedRole = (user) =>
  String(user?.role || "").trim().toLowerCase();

const adminUsers = userList.filter(u => normalizedRole(u) === "admin");
const staffUsers = userList.filter(u => normalizedRole(u) === "staff");
const clientUsers = userList.filter(u => normalizedRole(u) === "client");

const filteredUsers =
  currentTab === "all"
    ? userList
    : userList.filter(u => normalizedRole(u) === currentTab);

const safeSubstations = Array.isArray(substations) ? substations : [];

const sectionTitle =
  currentTab === "all"
    ? "All Users"
    : `${currentTab.charAt(0).toUpperCase()}${currentTab.slice(1)}s`;

const roleLabel = (role) => {
  const value = String(role || "").toLowerCase();
  return value === "admin"
    ? "Administrator"
    : value === "staff"
      ? "Staff"
      : "Client";
};

const joinedDate = (value) => {
  if (!value) return "";
  const date = new Date(value);
  return Number.isNaN(date.getTime())
    ? ""
    : date.toLocaleDateString(undefined, {
        day: "numeric",
        month: "short",
        year: "numeric"
      });
};
%>

<style>
/* ==========================================================
   COREVESTER ADMIN USER MANAGEMENT
   ========================================================== */

.cv-admin,
.cv-admin * {
  box-sizing: border-box;
}

.cv-admin {
  --cv-green: #176b3a;
  --cv-green-dark: #0f5b2f;
  --cv-green-soft: #e8f5ec;
  --cv-green-pale: #f4faf5;
  --cv-green-border: #cfe2d4;

  --cv-cream: #fbfdf9;
  --cv-white: #ffffff;
  --cv-ink: #1f3025;
  --cv-text: #53645a;
  --cv-muted: #87938b;

  --cv-border: #dbe7de;
  --cv-border-soft: #eaf0eb;

  width: 100%;
  min-height: calc(100vh - 120px);
  padding: 16px;
  background:
    radial-gradient(circle at 10% 0%, rgba(232,245,236,.75), transparent 32%),
    #f8fbf8;
  color: var(--cv-ink);
  font-family: inherit;
}

.cv-admin-shell {
  width: min(1180px, 100%);
  margin: 0 auto;
  border: 1px solid var(--cv-green-border);
  border-radius: 14px;
  overflow: hidden;
  background: var(--cv-white);
  box-shadow: 0 8px 28px rgba(25, 76, 42, .07);
}

/* ==========================================================
   TOP BAR
   ========================================================== */

.cv-admin-topbar {
  min-height: 74px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  padding: 10px 14px;
  border-bottom: 1px solid var(--cv-green-border);
  background: #fff;
}

.cv-brand {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  min-width: 0;
  color: var(--cv-green);
  text-decoration: none;
}

.cv-brand-mark {
  width: 40px;
  height: 40px;
  display: grid;
  place-items: center;
  border: 1px solid var(--cv-green-border);
  border-radius: 10px;
  background: var(--cv-green-soft);
  color: var(--cv-green);
  font-size: 17px;
}

.cv-brand-copy {
  min-width: 0;
}

.cv-brand-copy strong {
  display: block;
  color: var(--cv-green);
  font-size: 13px;
  line-height: 1.05;
  letter-spacing: .04em;
}

.cv-brand-copy small {
  display: block;
  margin-top: 3px;
  color: var(--cv-muted);
  font-size: 7px;
  line-height: 1.1;
}

.cv-top-actions {
  display: flex;
  align-items: center;
  gap: 7px;
}

.cv-top-button {
  min-width: 42px;
  height: 38px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: 0 10px;
  border: 1px solid #9dbca5;
  border-radius: 8px;
  background: #fff;
  color: var(--cv-green);
  text-decoration: none;
  font-size: 11px;
  font-weight: 800;
}

.cv-top-button:hover {
  background: var(--cv-green-pale);
}

.cv-top-button .count {
  font-size: 9px;
}

/* ==========================================================
   BODY LAYOUT
   ========================================================== */

.cv-admin-body {
  display: grid;
  grid-template-columns: 205px minmax(0, 1fr);
  gap: 0;
  background: #fbfdfb;
}

.cv-sidebar {
  padding: 18px 12px;
  border-right: 1px solid var(--cv-border);
  background: #f7fbf7;
}

.cv-sidebar-title {
  margin: 0 9px 9px;
  color: #64736a;
  font-size: 9px;
  font-weight: 900;
  letter-spacing: .08em;
}

.cv-sidebar-nav {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.cv-sidebar-link {
  min-height: 44px;
  display: grid;
  grid-template-columns: 27px minmax(0,1fr) auto;
  align-items: center;
  gap: 7px;
  padding: 6px 8px;
  border: 1px solid transparent;
  border-radius: 9px;
  color: var(--cv-text);
  text-decoration: none;
}

.cv-sidebar-link:hover {
  border-color: var(--cv-green-border);
  background: #fff;
}

.cv-sidebar-link.active {
  border-color: #166936;
  background: var(--cv-green);
  color: #fff;
  box-shadow: 0 4px 10px rgba(23,107,58,.12);
}

.cv-sidebar-icon {
  width: 27px;
  height: 27px;
  display: grid;
  place-items: center;
  border-radius: 7px;
  background: var(--cv-green-soft);
  color: var(--cv-green);
  font-size: 11px;
}

.cv-sidebar-link.active .cv-sidebar-icon {
  background: rgba(255,255,255,.14);
  color: #fff;
}

.cv-sidebar-copy strong {
  display: block;
  font-size: 10px;
  line-height: 1.1;
}

.cv-sidebar-count {
  min-width: 20px;
  padding: 3px 5px;
  border-radius: 15px;
  background: var(--cv-green-soft);
  color: var(--cv-green);
  text-align: center;
  font-size: 8px;
  font-weight: 900;
}

.cv-sidebar-link.active .cv-sidebar-count {
  background: rgba(255,255,255,.16);
  color: #fff;
}

.cv-sidebar-divider {
  height: 1px;
  margin: 16px 4px;
  background: var(--cv-border);
}

.cv-overview {
  padding: 0 9px;
}

.cv-overview-title {
  margin: 0 0 8px;
  color: #64736a;
  font-size: 9px;
  font-weight: 900;
  letter-spacing: .08em;
}

.cv-overview-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  padding: 8px 0;
  border-bottom: 1px solid var(--cv-border-soft);
  color: var(--cv-text);
  font-size: 9px;
}

.cv-overview-row:last-child {
  border-bottom: 0;
}

.cv-overview-row span {
  display: inline-flex;
  align-items: center;
  gap: 6px;
}

.cv-overview-row i {
  width: 15px;
  color: var(--cv-green);
  text-align: center;
}

.cv-overview-row strong {
  color: var(--cv-ink);
  font-size: 10px;
}

.cv-invite-sidebar {
  width: 100%;
  min-height: 38px;
  margin-top: 15px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  border: 1px solid #83ae8d;
  border-radius: 8px;
  background: #eff8f0;
  color: var(--cv-green);
  text-decoration: none;
  font-size: 9px;
  font-weight: 900;
}

.cv-invite-sidebar:hover {
  background: #e4f2e6;
}

/* ==========================================================
   MAIN CONTENT
   ========================================================== */

.cv-content {
  min-width: 0;
  padding: 18px;
}

.cv-content-heading {
  min-height: 90px;
  display: flex;
  align-items: center;
  gap: 13px;
  padding: 14px 16px;
  border: 1px solid var(--cv-border);
  border-radius: 12px;
  background: linear-gradient(90deg, #f2faf3, #fbfdfb);
}

.cv-heading-icon {
  width: 61px;
  height: 61px;
  flex: 0 0 61px;
  display: grid;
  place-items: center;
  border: 1px solid var(--cv-green-border);
  border-radius: 50%;
  background: #fff;
  color: var(--cv-green);
  font-size: 24px;
}

.cv-eyebrow {
  display: block;
  color: var(--cv-green);
  font-size: 9px;
  font-weight: 900;
  letter-spacing: .08em;
}

.cv-content-heading h1 {
  margin: 5px 0 5px;
  font-size: 20px;
  line-height: 1;
  letter-spacing: -.02em;
}

.cv-content-heading p {
  margin: 0;
  color: var(--cv-text);
  font-size: 10px;
}

.cv-feedback {
  margin-top: 10px;
  padding: 9px 11px;
  border-radius: 8px;
  font-size: 9px;
}

.cv-feedback.success {
  background: #eaf7ed;
  color: var(--cv-green);
}

.cv-feedback.error {
  background: #fff0f0;
  color: #a32828;
}

/* ==========================================================
   ACCOUNTS CONTAINER
   ========================================================== */

.cv-accounts {
  margin-top: 13px;
  padding: 12px;
  border: 1px solid var(--cv-border);
  border-radius: 12px;
  background: #fbfdfb;
}

.cv-accounts-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 10px;
  padding: 2px 3px 10px;
  border-bottom: 1px solid var(--cv-border-soft);
}

.cv-accounts-heading h2 {
  margin: 4px 0 3px;
  font-size: 16px;
}

.cv-accounts-heading p {
  margin: 0;
  color: var(--cv-muted);
  font-size: 9px;
}

.cv-filter {
  min-width: 112px;
  height: 35px;
  padding: 0 9px;
  border: 1px solid #cadbd0;
  border-radius: 8px;
  background: #fff;
  color: var(--cv-text);
  font-size: 9px;
}

/* ==========================================================
   USER CARDS
   ========================================================== */

.cv-user-list {
  display: flex;
  flex-direction: column;
  gap: 9px;
  margin: 0;
  padding: 0;
  list-style: none;
}

.cv-user-card {
  border: 1px solid var(--cv-border);
  border-radius: 10px;
  overflow: hidden;
  background: #fff;
}

.cv-user-main {
  min-height: 96px;
  display: grid;
  grid-template-columns: 58px minmax(0,1fr) auto;
  align-items: center;
  gap: 10px;
  padding: 12px;
}

.cv-avatar {
  width: 58px;
  height: 58px;
  display: grid;
  place-items: center;
  border: 1px solid #cfe5d5;
  border-radius: 50%;
  background: #e3f5e8;
  color: #2b9b58;
  font-size: 22px;
}

.cv-user-name {
  margin: 0 0 5px;
  color: var(--cv-ink);
  font-size: 14px;
  font-weight: 800;
}

.cv-user-email {
  margin: 0 0 6px;
  color: var(--cv-text);
  font-size: 9px;
  overflow-wrap: anywhere;
}

.cv-user-email i {
  margin-right: 4px;
  color: var(--cv-green);
}

.cv-role-pill {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 4px 7px;
  border-radius: 12px;
  background: var(--cv-green-soft);
  color: var(--cv-green);
  font-size: 8px;
  font-weight: 900;
}

.cv-role-pill.admin {
  background: #e9f5ed;
  color: #176b3a;
}

.cv-role-pill.staff {
  background: #edf4fb;
  color: #256a9b;
}

.cv-role-pill.client {
  background: #f5f0df;
  color: #78601b;
}

.cv-actions {
  position: relative;
}

.cv-actions summary {
  min-width: 82px;
  height: 35px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: 0 9px;
  border: 1px solid #a7c3ad;
  border-radius: 8px;
  background: #fff;
  color: var(--cv-green);
  cursor: pointer;
  list-style: none;
  font-size: 9px;
  font-weight: 900;
}

.cv-actions summary::-webkit-details-marker {
  display: none;
}

.cv-actions[open] summary,
.cv-actions summary:hover {
  background: var(--cv-green-pale);
}

.cv-actions-menu {
  position: absolute;
  z-index: 20;
  top: 42px;
  right: 0;
  width: 250px;
  padding: 10px;
  border: 1px solid var(--cv-border);
  border-radius: 10px;
  background: #fff;
  box-shadow: 0 12px 30px rgba(27, 62, 38, .13);
}

.cv-action-form + .cv-action-form {
  margin-top: 9px;
  padding-top: 9px;
  border-top: 1px solid var(--cv-border-soft);
}

.cv-action-title {
  margin: 0 0 6px;
  color: #65746b;
  font-size: 8px;
  font-weight: 900;
  letter-spacing: .07em;
}

.cv-action-row {
  display: grid;
  grid-template-columns: minmax(0,1fr) auto;
  gap: 6px;
}

.cv-action-control {
  width: 100%;
  height: 34px;
  padding: 0 8px;
  border: 1px solid #cadbd0;
  border-radius: 7px;
  background: #fff;
  color: var(--cv-text);
  font-size: 8px;
}

.cv-action-submit {
  height: 34px;
  padding: 0 9px;
  border: 0;
  border-radius: 7px;
  background: var(--cv-green);
  color: #fff;
  cursor: pointer;
  font-size: 8px;
  font-weight: 900;
}

.cv-action-submit:hover {
  background: var(--cv-green-dark);
}

.cv-user-meta {
  display: grid;
  grid-template-columns: repeat(2, minmax(0,1fr));
  border-top: 1px solid var(--cv-border-soft);
  background: #fbfdfb;
}

.cv-meta-item {
  min-width: 0;
  padding: 8px 11px;
  border-right: 1px solid var(--cv-border-soft);
}

.cv-meta-item:last-child {
  border-right: 0;
}

.cv-meta-item span {
  display: block;
  margin-bottom: 3px;
  color: #89948d;
  font-size: 7px;
  font-weight: 900;
  letter-spacing: .07em;
}

.cv-meta-item strong {
  display: block;
  color: #536158;
  font-size: 9px;
  overflow-wrap: anywhere;
}

.cv-empty {
  padding: 35px 15px;
  border: 1px dashed #cbdace;
  border-radius: 9px;
  background: #fff;
  text-align: center;
}

.cv-empty-icon {
  width: 44px;
  height: 44px;
  margin: 0 auto;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: var(--cv-green-soft);
  color: var(--cv-green);
}

.cv-empty h3 {
  margin: 9px 0 3px;
  font-size: 13px;
}

.cv-empty p {
  margin: 0;
  color: var(--cv-muted);
  font-size: 9px;
}

/* ==========================================================
   MOBILE
   ========================================================== */

@media (max-width: 760px) {
  .cv-admin {
    padding: 7px;
    background: #fff;
  }

  .cv-admin-shell {
    border-radius: 9px;
  }

  .cv-admin-topbar {
    min-height: 60px;
    padding: 8px 9px;
  }

  .cv-brand-mark {
    width: 34px;
    height: 34px;
    font-size: 14px;
  }

  .cv-brand-copy strong {
    font-size: 11px;
  }

  .cv-brand-copy small {
    font-size: 6px;
  }

  .cv-top-button {
    min-width: 37px;
    height: 34px;
    padding: 0 8px;
  }

  .cv-top-button span.label {
    display: none;
  }

  .cv-admin-body {
    display: block;
  }

  .cv-sidebar {
    padding: 10px;
    border-right: 0;
    border-bottom: 1px solid var(--cv-border);
  }

  .cv-sidebar-title,
  .cv-overview-title {
    margin-left: 3px;
  }

  .cv-sidebar-nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0,1fr));
  }

  .cv-sidebar-link {
    min-height: 42px;
  }

  .cv-sidebar-divider,
  .cv-overview,
  .cv-invite-sidebar {
    display: none;
  }

  .cv-content {
    padding: 10px;
  }

  .cv-content-heading {
    min-height: 80px;
    padding: 11px;
  }

  .cv-heading-icon {
    width: 50px;
    height: 50px;
    flex-basis: 50px;
    font-size: 19px;
  }

  .cv-content-heading h1 {
    font-size: 17px;
  }

  .cv-content-heading p {
    font-size: 9px;
  }

  .cv-user-main {
    grid-template-columns: 48px minmax(0,1fr) auto;
    gap: 8px;
    padding: 10px;
  }

  .cv-avatar {
    width: 48px;
    height: 48px;
    font-size: 18px;
  }

  .cv-user-name {
    font-size: 12px;
  }

  .cv-user-email {
    font-size: 8px;
  }

  .cv-actions summary {
    min-width: 38px;
    width: 38px;
    padding: 0;
    font-size: 0;
  }

  .cv-actions summary i {
    font-size: 12px;
  }

  .cv-actions-menu {
    right: -2px;
    width: min(250px, calc(100vw - 38px));
  }
}

@media (max-width: 450px) {
  .cv-sidebar-nav {
    grid-template-columns: 1fr 1fr;
  }

  .cv-sidebar-copy strong {
    font-size: 9px;
  }

  .cv-accounts-heading {
    align-items: stretch;
    flex-direction: column;
  }

  .cv-filter {
    width: 100%;
  }

  .cv-user-main {
    grid-template-columns: 43px minmax(0,1fr) 38px;
  }

  .cv-avatar {
    width: 43px;
    height: 43px;
  }

  .cv-user-name {
    font-size: 11px;
  }

  .cv-user-email {
    font-size: 7px;
  }
}
</style>

<section class="cv-admin">
  <div class="cv-admin-shell">

    <!-- ======================================================
         HEADER
    ======================================================= -->
    <header class="cv-admin-topbar">
      <a class="cv-brand" href="/auth/users">
        <span class="cv-brand-mark">
          <i class="fas fa-leaf"></i>
        </span>

        <span class="cv-brand-copy">
          <strong>COREVESTER</strong>
          <small>INVESTMENTS LIMITED</small>
        </span>
      </a>

      <div class="cv-top-actions">
        <a class="cv-top-button" href="/carts" aria-label="Cart">
          <i class="fas fa-cart-shopping"></i>
          <span class="count">0</span>
        </a>

        <a class="cv-top-button" href="/auth/users/invitation" aria-label="Invite user">
          <i class="fas fa-user-plus"></i>
          <span class="label">Invite</span>
        </a>
      </div>
    </header>

    <div class="cv-admin-body">

      <!-- ====================================================
           SIDEBAR
      ===================================================== -->
      <aside class="cv-sidebar">

        <p class="cv-sidebar-title">SECTIONS</p>

        <nav class="cv-sidebar-nav" aria-label="User management sections">

          <a
            class="cv-sidebar-link <%= currentTab === 'all' ? 'active' : '' %>"
            href="/auth/users?tab=all">
            <span class="cv-sidebar-icon">
              <i class="fas fa-users"></i>
            </span>
            <span class="cv-sidebar-copy">
              <strong>All Users</strong>
            </span>
            <b class="cv-sidebar-count"><%= userList.length %></b>
          </a>

          <a
            class="cv-sidebar-link <%= currentTab === 'admin' ? 'active' : '' %>"
            href="/auth/users?tab=admin">
            <span class="cv-sidebar-icon">
              <i class="fas fa-shield-halved"></i>
            </span>
            <span class="cv-sidebar-copy">
              <strong>Administrators</strong>
            </span>
            <b class="cv-sidebar-count"><%= adminUsers.length %></b>
          </a>

          <a
            class="cv-sidebar-link <%= currentTab === 'staff' ? 'active' : '' %>"
            href="/auth/users?tab=staff">
            <span class="cv-sidebar-icon">
              <i class="fas fa-user-gear"></i>
            </span>
            <span class="cv-sidebar-copy">
              <strong>Staff</strong>
            </span>
            <b class="cv-sidebar-count"><%= staffUsers.length %></b>
          </a>

          <a
            class="cv-sidebar-link <%= currentTab === 'client' ? 'active' : '' %>"
            href="/auth/users?tab=client">
            <span class="cv-sidebar-icon">
              <i class="fas fa-user"></i>
            </span>
            <span class="cv-sidebar-copy">
              <strong>Clients</strong>
            </span>
            <b class="cv-sidebar-count"><%= clientUsers.length %></b>
          </a>

        </nav>

        <div class="cv-sidebar-divider"></div>

        <section class="cv-overview">
          <p class="cv-overview-title">OVERVIEW</p>

          <div class="cv-overview-row">
            <span>
              <i class="fas fa-users"></i>
              Total Users
            </span>
            <strong><%= userList.length %></strong>
          </div>

          <div class="cv-overview-row">
            <span>
              <i class="fas fa-shield-halved"></i>
              Administrators
            </span>
            <strong><%= adminUsers.length %></strong>
          </div>

          <div class="cv-overview-row">
            <span>
              <i class="fas fa-user-gear"></i>
              Staff
            </span>
            <strong><%= staffUsers.length %></strong>
          </div>

          <div class="cv-overview-row">
            <span>
              <i class="fas fa-user"></i>
              Clients
            </span>
            <strong><%= clientUsers.length %></strong>
          </div>

          <a class="cv-invite-sidebar" href="/auth/users/invitation">
            <i class="fas fa-user-plus"></i>
            Invite User
          </a>
        </section>

      </aside>

      <!-- ====================================================
           MAIN
      ===================================================== -->
      <main class="cv-content">

        <section class="cv-content-heading">
          <div class="cv-heading-icon">
            <i class="fas fa-users"></i>
          </div>

          <div>
            <span class="cv-eyebrow">USER MANAGEMENT</span>
            <h1>User Management</h1>
            <p>Organize accounts, roles and staff assignments.</p>
          </div>
        </section>

        <% if (req.query?.success) { %>
          <div class="cv-feedback success">
            <i class="fas fa-circle-check"></i>
            <%= req.query.success %>
          </div>
        <% } %>

        <% if (req.query?.error) { %>
          <div class="cv-feedback error">
            <i class="fas fa-circle-exclamation"></i>
            <%= req.query.error %>
          </div>
        <% } %>

        <section class="cv-accounts">

          <header class="cv-accounts-heading">
            <div>
              <span class="cv-eyebrow">ACCOUNTS</span>
              <h2><%= sectionTitle %></h2>
              <p>Accounts currently shown in this section.</p>
            </div>

            <select
              class="cv-filter"
              aria-label="Filter users"
              onchange="if(this.value) window.location.href=this.value;">
              <option value="/auth/users?tab=all" <%= currentTab === "all" ? "selected" : "" %>>
                All Users
              </option>
              <option value="/auth/users?tab=admin" <%= currentTab === "admin" ? "selected" : "" %>>
                Administrators
              </option>
              <option value="/auth/users?tab=staff" <%= currentTab === "staff" ? "selected" : "" %>>
                Staff
              </option>
              <option value="/auth/users?tab=client" <%= currentTab === "client" ? "selected" : "" %>>
                Clients
              </option>
            </select>
          </header>

          <% if (!filteredUsers.length) { %>

            <div class="cv-empty">
              <div class="cv-empty-icon">
                <i class="fas fa-user-slash"></i>
              </div>
              <h3>No users in this section</h3>
              <p>There are no accounts to display here.</p>
            </div>

          <% } else { %>

            <ul class="cv-user-list">

              <% filteredUsers.forEach(account => {
                const role = normalizedRole(account);
                const assignedSubstationName =
                  account.assignedSubstation?.name || "Not assigned";
              %>

                <li class="cv-user-card">

                  <div class="cv-user-main">

                    <div class="cv-avatar" aria-hidden="true">
                      <i class="fas fa-user"></i>
                    </div>

                    <div>
                      <h3 class="cv-user-name">
                        <%= account.name || "Unnamed User" %>
                      </h3>

                      <p class="cv-user-email">
                        <i class="fas fa-envelope"></i>
                        <%= account.email || "No email" %>
                      </p>

                      <span class="cv-role-pill <%= role %>">
                        <i class="fas <%= role === 'admin'
                          ? 'fa-shield-halved'
                          : role === 'staff'
                            ? 'fa-user-gear'
                            : 'fa-user' %>"></i>
                        <%= roleLabel(role) %>
                      </span>
                    </div>

                    <details class="cv-actions">
                      <summary>
                        <i class="fas fa-ellipsis-vertical"></i>
                        <span>Actions</span>
                      </summary>

                      <div class="cv-actions-menu">

                        <form
                          class="cv-action-form"
                          action="/auth/users/<%= account._id %>/role"
                          method="POST">

                          <p class="cv-action-title">CHANGE ROLE</p>

                          <div class="cv-action-row">
                            <select
                              class="cv-action-control"
                              name="role"
                              aria-label="Role">
                              <option value="admin" <%= role === "admin" ? "selected" : "" %>>
                                Administrator
                              </option>
                              <option value="staff" <%= role === "staff" ? "selected" : "" %>>
                                Staff
                              </option>
                              <option value="client" <%= role === "client" ? "selected" : "" %>>
                                Client
                              </option>
                            </select>

                            <button class="cv-action-submit" type="submit">
                              Save
                            </button>
                          </div>
                        </form>

                        <% if (role === "staff") { %>

                          <form
                            class="cv-action-form"
                            action="/auth/users/<%= account._id %>/substation"
                            method="POST">

                            <p class="cv-action-title">STAFF ASSIGNMENT</p>

                            <div class="cv-action-row">
                              <select
                                class="cv-action-control"
                                name="assignedSubstation"
                                aria-label="Assigned substation">

                                <option value="">Unassigned</option>

                                <% safeSubstations.forEach(s => { %>
                                  <option
                                    value="<%= s._id %>"
                                    <%= account.assignedSubstation &&
                                        String(account.assignedSubstation._id) === String(s._id)
                                        ? "selected"
                                        : "" %>>
                                    <%= s.name %>
                                  </option>
                                <% }) %>

                              </select>

                              <button class="cv-action-submit" type="submit">
                                Assign
                              </button>
                            </div>
                          </form>

                        <% } %>

                      </div>
                    </details>

                  </div>

                  <div class="cv-user-meta">

                    <div class="cv-meta-item">
                      <span>ACCOUNT</span>
                      <strong>
                        <i class="fas fa-circle-check"></i>
                        Active
                      </strong>
                    </div>

                    <div class="cv-meta-item">
                      <span>JOINED</span>
                      <strong>
                        <%= joinedDate(account.createdAt || account.joinedAt) || "Not available" %>
                      </strong>
                    </div>

                    <div class="cv-meta-item">
                      <span>SUBSTATION</span>
                      <strong><%= assignedSubstationName %></strong>
                    </div>

                  </div>

                </li>

              <% }) %>

            </ul>

          <% } %>

        </section>

      </main>
    </div>
  </div>
</section>
