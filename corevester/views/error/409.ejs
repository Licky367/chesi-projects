<link rel="stylesheet" href="/css/error.css">

<div class="page-error">

  <div class="error-card">

    <div class="error-icon">
      🔄
    </div>

    <div
      class="error-code"
      style="color:#6f42c1;"
    >
      409
    </div>

    <h1 class="error-title">
      Conflict Detected
    </h1>

    <p class="error-text">
      <%= typeof error !== "undefined" && error
        ? error
        : "Your request could not be completed because it conflicts with the current state of the data. Please review your request and try again." %>
    </p>

    <div class="button-group">

      <button
        type="button"
        class="btn-action btn-back"
        onclick="history.back()"
      >
        ← Go Back
      </button>

      <a
        href="/"
        class="btn-action btn-home"
      >
        🏠 Home
      </a>

    </div>

    <div class="help-box">
      This usually happens when the requested action would create duplicate or conflicting information. Refresh the page, review the data, and try again. If the problem persists, contact your system administrator.
    </div>

  </div>

</div>