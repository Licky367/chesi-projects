<section class="shop-page auth-page">

  <div class="auth-card">

    <div class="auth-heading">

      <div class="auth-icon">

        <i class="fas fa-sign-in-alt"></i>

      </div>


      <h1 class="page-title">

        Welcome Back

      </h1>


      <p class="page-subtitle">

        Log in to continue to your CoreVester account.

      </p>

    </div>


    <% if (typeof error !== "undefined" && error) { %>

      <div class="error">

        <%= error %>

      </div>

    <% } %>


    <form
      action="/auth/login"
      method="POST"
      class="auth-form"
    >


      <input
        type="hidden"
        name="returnTo"
        value="<%= typeof returnTo !== 'undefined' ? returnTo : '/' %>"
      >


      <!-- =========================
           EMAIL
      ========================== -->

      <div class="field">

        <label for="email">

          <i class="fas fa-envelope"></i>
          Email Address

        </label>


        <input
          id="email"
          type="email"
          name="email"
          value="<%= typeof email !== 'undefined' ? email : '' %>"
          placeholder="Enter your email address"
          autocomplete="email"
          required
        >

      </div>


      <!-- =========================
           PASSWORD
      ========================== -->

      <div class="field">

        <label for="password">

          <i class="fas fa-lock"></i>
          Password

        </label>


        <div class="password-input">

          <input
            id="password"
            type="password"
            name="password"
            placeholder="Enter your password"
            autocomplete="current-password"
            required
          >


          <button
            type="button"
            class="password-toggle"
            onclick="togglePassword()"
            aria-label="Show password"
          >

            <i
              id="passwordIcon"
              class="fas fa-eye"
            ></i>

          </button>

        </div>

      </div>


      <!-- =========================
           SUBMIT
      ========================== -->

      <div class="form-actions">

        <button
          type="submit"
          class="primary-btn auth-submit"
        >

          <i class="fas fa-sign-in-alt"></i>

          Log In

        </button>

      </div>


    </form>


    <!-- =========================
         REGISTER
    ========================== -->

    <div class="auth-footer">

      <span>

        Don't have an account?

      </span>


      <a
        href="/auth/register"
      >

        Create Account

      </a>

    </div>


  </div>

</section>


<script>

function togglePassword() {

  const password =
    document.getElementById(
      "password"
    );


  const icon =
    document.getElementById(
      "passwordIcon"
    );


  if (
    password.type ===
    "password"
  ) {

    password.type =
      "text";


    icon.classList.remove(
      "fa-eye"
    );


    icon.classList.add(
      "fa-eye-slash"
    );

  } else {

    password.type =
      "password";


    icon.classList.remove(
      "fa-eye-slash"
    );


    icon.classList.add(
      "fa-eye"
    );

  }

}

</script>


<style>

.auth-page {

  min-height: 70vh;

  display: flex;

  align-items: center;

  justify-content: center;

}


.auth-card {

  width: 100%;

  max-width: 460px;

  background: #ffffff;

  border: 1px solid #e5e7eb;

  border-radius: 18px;

  padding: 30px 24px;

  box-shadow:

    0 10px 30px

    rgba(0, 0, 0, 0.08);

}


.auth-heading {

  text-align: center;

  margin-bottom: 25px;

}


.auth-heading .page-title {

  margin-bottom: 8px;

}


.auth-icon {

  width: 60px;

  height: 60px;

  margin: 0 auto 15px;

  display: flex;

  align-items: center;

  justify-content: center;

  border-radius: 50%;

  background: #f0f7f2;

  color: #0b5d1e;

  font-size: 23px;

}


.auth-form {

  display: flex;

  flex-direction: column;

  gap: 18px;

}


.field {

  display: flex;

  flex-direction: column;

  gap: 8px;

}


.field label {

  font-weight: 600;

  color: #263238;

}


.field label i {

  color: #0b5d1e;

  margin-right: 5px;

}


.field input {

  width: 100%;

  padding: 13px 14px;

  border: 1px solid #d1d5db;

  border-radius: 10px;

  font-size: 15px;

  box-sizing: border-box;

}


.field input:focus {

  outline: none;

  border-color: #0b5d1e;

  box-shadow:

    0 0 0 3px

    rgba(11, 93, 30, 0.1);

}


.password-input {

  position: relative;

}


.password-input input {

  padding-right: 48px;

}


.password-toggle {

  position: absolute;

  right: 0;

  top: 0;

  height: 100%;

  width: 48px;

  border: none;

  background: transparent;

  color: #0b5d1e;

  cursor: pointer;

}


.auth-submit {

  width: 100%;

  justify-content: center;

  border: none;

  cursor: pointer;

}


.auth-footer {

  margin-top: 25px;

  padding-top: 20px;

  border-top: 1px solid #e5e7eb;

  text-align: center;

  display: flex;

  justify-content: center;

  gap: 6px;

  flex-wrap: wrap;

}


.auth-footer a {

  color: #0b5d1e;

  font-weight: 700;

  text-decoration: none;

}


.auth-footer a:hover {

  text-decoration: underline;

}


@media (
  max-width: 600px
) {

  .auth-card {

    padding: 24px 18px;

    border-radius: 14px;

  }

}

</style>