<section class="shop-page">  <div>
    <h1 class="page-title">Products</h1><p class="page-subtitle">
  Browse available products by category.
  Each row contains a maximum of six compact cards and scrolls horizontally.
</p>

  </div><% if (typeof error !== "undefined" && error) { %>

<div class="error">
  <%= error %>
</div>

<% } %>

<% if (!categories || !categories.length) { %>

<div
  class="empty"
  style="margin-top:25px"
>

  <i class="fas fa-box-open"></i>

  <div>
    No products are available right now.
  </div>

</div>

<% } %>

<% (categories || []).forEach((group) => { %>

<section class="category-section">

  <!-- ==================================================
       CATEGORY
  =================================================== -->

  <div class="category-head">

    <h2>
      <%= group.label || group.category || "Other" %>
    </h2>

  </div>


  <%
    /*
     * ==================================================
     * IMPORTANT
     *
     * The backend may currently give us:
     *
     * category
     *   -> row
     *        -> products
     *
     * where each row was previously created for a
     * subcategory.
     *
     * We deliberately flatten those rows here.
     *
     * SUBCATEGORY IS NOT USED TO CREATE ROWS.
     *
     * All products belonging to this category are placed
     * into one continuous product collection.
     * ==================================================
     */

    const categoryProducts = [];

    (group.rows || []).forEach((row) => {

      (row.products || []).forEach((product) => {

        categoryProducts.push(product);

      });

    });


    /*
     * ==================================================
     * FALLBACK
     *
     * If the controller supplies group.products directly,
     * use those instead.
     * ==================================================
     */

    if (
      categoryProducts.length === 0 &&
      Array.isArray(group.products)
    ) {

      group.products.forEach((product) => {

        categoryProducts.push(product);

      });

    }
  %>


  <% if (categoryProducts.length) { %>


    <%
      /*
       * ==================================================
       * SIX PRODUCTS PER ROW
       *
       * Subcategory DOES NOT matter here.
       *
       * Example:
       *
       * Category: Diagnostic Equipment
       *
       * Product A - subcategory X
       * Product B - subcategory X
       * Product C - subcategory Y
       * Product D - subcategory Z
       * Product E - subcategory Y
       * Product F - subcategory X
       * Product G - subcategory Z
       *
       * First row:
       * A B C D E F
       *
       * Second row:
       * G
       *
       * Exactly what was requested.
       * ==================================================
       */

      for (
        let rowStart = 0;
        rowStart < categoryProducts.length;
        rowStart += 6
      ) {

        const rowProducts =
          categoryProducts.slice(
            rowStart,
            rowStart + 6
          );
    %>


      <div class="subcategory-row-block">

        <!--
          We retain the existing class names so the existing
          shopt.css continues to control the appearance.
          
          This is still visually the same product-row layout.
          The heading is now the CATEGORY, not a subcategory.
        -->

        <div class="subcategory-head">

          <h3>
            <%= group.label || group.category || "Other" %>
          </h3>


          <% if (categoryProducts.length > 6) { %>

            <span>
              Swipe left/right
            </span>

          <% } %>

        </div>


        <!-- ==================================================
             PRODUCT ROW
             
             Maximum six cards in this row.
             
             CSS controls horizontal scrolling.
        =================================================== -->

        <div
          class="product-row category-product-row"
          aria-label="<%= group.label || group.category || 'Products' %> products"
        >


          <% rowProducts.forEach((product) => { %>


            <a
              class="product-card"
              href="/products/<%= product._id %>"
            >


              <!-- ==================================================
                   PRODUCT IMAGE
              =================================================== -->

              <div class="product-image">


                <% if (product.image) { %>

                  <img
                    src="<%= product.image %>"
                    alt="<%= product.name %>"
                    loading="lazy"
                    onerror="this.style.display='none';this.nextElementSibling.style.display='flex';"
                  >


                  <div
                    class="placeholder"
                    style="display:none"
                  >

                    <i class="fas fa-box"></i>

                  </div>


                <% } else { %>


                  <div class="placeholder">

                    <i class="fas fa-box"></i>

                  </div>


                <% } %>


              </div>


              <!-- ==================================================
                   PRODUCT INFORMATION
              =================================================== -->

              <div class="product-info">


                <!-- PRODUCT NAME -->

                <div class="product-name">

                  <%= product.name %>

                </div>


                <!-- SUBCATEGORY
                     
                     Display only.
                     It DOES NOT determine row grouping.
                -->

                <div class="stock-meta-line">

                  <%= product.subcategory || "Other" %>

                </div>


                <!-- SELLING PRICE -->

                <div class="product-price">

                  KSh

                  <%= Number(
                    product.unitSellPrice || 0
                  ).toLocaleString() %>

                </div>


                <!-- DELIVERY DAYS -->

                <div class="stock-text">

                  <strong>

                    <%= Number(
                      product.days || 0
                    ) %>

                  </strong>

                  day delivery

                </div>


                <!-- AVAILABLE UNITS -->

                <div
                  class="stock-text <%= Number(product.units || 0) <= 0 ? 'out' : '' %>"
                >

                  <% if (Number(product.units || 0) > 0) { %>

                    <%= Number(
                      product.units
                    ).toLocaleString() %>

                    available

                  <% } else { %>

                    Out of stock

                  <% } %>

                </div>


              </div>


            </a>


          <% }) %>


        </div>


      </div>


    <%
      }
    %>


  <% } else { %>


    <div
      class="empty"
      style="margin-top:15px"
    >

      <i class="fas fa-box-open"></i>

      <div>
        No products are available in this category.
      </div>

    </div>


  <% } %>


</section>

<% }) %>

</section>