<section class="shop-page">
  <div style="margin-bottom:15px">
    <a href="/products" class="secondary-btn">
      <i class="fas fa-arrow-left"></i>
      Products
    </a>
  </div>

  <% if (typeof error !== "undefined" && error) { %>
    <div class="error"><%= error %></div>
  <% } %>

  <% if (product) { %>
    <div class="detail-card">
      <div class="detail-grid">

        <div class="detail-image">
          <% if (product.image) { %>
            <img
              src="<%= product.image %>"
              alt="<%= product.name %>"
              onerror="this.style.display='none';this.nextElementSibling.style.display='flex';"
            >
            <div class="placeholder" style="display:none">
              <i class="fas fa-box"></i>
            </div>
          <% } else { %>
            <div class="placeholder">
              <i class="fas fa-box"></i>
            </div>
          <% } %>
        </div>

        <div class="detail-content">
          <span class="detail-category">
            <%= product.category %>
          </span>

          <h1><%= product.name %></h1>

          <div class="detail-subcategory">
            <i class="fas fa-layer-group"></i>
            <%= product.subcategory || "Other" %>
          </div>

          <div class="detail-price">
            KSh
            <%= Number(
              product.unitSellPrice || 0
            ).toLocaleString() %>
          </div>

          <div class="stock-days-badge">
            <i class="fas fa-calendar-days"></i>
            <strong><%= product.days || 0 %></strong>
            day delivery
          </div>

          <div class="detail-description">
            <%= product.description ||
              "No description has been provided for this product." %>
          </div>

          <% if (product.units > 0) { %>

            <div class="stock-text">
              <strong><%= product.units %></strong>
              units available
            </div>

            <% if (typeof user !== "undefined" && user) { %>
              <form
                action="/products/<%= product._id %>/cart"
                method="POST"
              >
                <div class="qty-row">
                  <label for="qty">
                    <strong>Quantity</strong>
                  </label>

                  <input
                    id="qty"
                    name="qty"
                    type="number"
                    min="1"
                    max="<%= product.units %>"
                    value="1"
                    required
                  >
                </div>

                <button
                  class="primary-btn"
                  type="submit"
                >
                  <i class="fas fa-cart-plus"></i>
                  Add to Cart
                </button>
              </form>
            <% } else { %>

              <a
                class="primary-btn"
                href="/auth/login?next=/products/<%= product._id %>"
              >
                <i class="fas fa-sign-in-alt"></i>
                Log in to buy
              </a>

            <% } %>

          <% } else { %>

            <div class="error">
              This product is currently out of stock.
            </div>

          <% } %>

          <% if (
            typeof query !== "undefined" &&
            query === "1"
          ) { %>
            <div class="notice">
              Product added to your cart.
            </div>
          <% } %>

        </div>
      </div>
    </div>
  <% } %>
</section>
