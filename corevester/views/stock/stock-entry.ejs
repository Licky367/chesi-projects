<section class="shop-page">
  <div style="margin-bottom:15px">
    <a href="/stock" class="secondary-btn">
      <i class="fas fa-arrow-left"></i>
      Stock
    </a>
  </div>

  <% if (typeof error!== "undefined" && error) { %>
    <div class="error"><%= error %></div>
  <% } %>

  <% if (typeof saved!== "undefined" && saved === "1") { %>
    <div class="notice">Product allocation saved successfully.</div>
  <% } %>

  <% if (!stock) { %>
    <div class="error">Stock item not found.</div>
  <% } else { %>

    <div class="detail-card stock-allocation-card">
      <div class="detail-grid">
        <div class="detail-image stock-detail-image">
          <% if (stock.image) { %>
            <img
              src="<%= stock.image %>"
              alt="<%= stock.name || stock.subcategory || 'Stock item' %>"
              onerror="this.style.display='none';this.nextElementSibling.style.display='flex';"
            >
            <div class="placeholder" style="display:none">
              <i class="fas fa-box"></i>
            </div>
          <% } else { %>
            <div class="placeholder">
              <i class="fas fa-box"></i>
            </div>
          <% } %>
        </div>

        <div class="detail-content">
          <span class="detail-category"><%= stock.category || "Other" %></span>
          <h1><%= stock.subcategory || stock.name || "Stock item" %></h1>
          <div class="detail-subcategory">
            <i class="fas fa-layer-group"></i>
            <%= stock.subcategory || stock.name || "Other" %>
          </div>
          <div class="detail-price">
            KSh <%= Number(stock.buyPrice || 0).toLocaleString() %>
            <small>buy / unit</small>
          </div>
          <% if (stock.description) { %>
            <div class="detail-description"><%= stock.description %></div>
          <% } %>
          <div class="stock-balance-box">
            <span>Warehouse balance</span>
            <strong><%= Number(stock.units || 0).toLocaleString() %> units</strong>
          </div>
        </div>
      </div>

      <!-- DIRECTIONS OF USE - READ ONLY -->
      <% if (stock.directionsOfUse && (stock.directionsOfUse.title || (stock.directionsOfUse.items && stock.directionsOfUse.items.length))) { %>
      <div style="margin:20px;background:#f8f9ff;border:1px solid #e8e9ff;border-radius:16px;padding:20px">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px">
          <h3 style="margin:0;font-size:14px;font-weight:800;display:flex;align-items:center;gap:8px;text-transform:uppercase;letter-spacing:.04em">
            <span style="width:30px;height:30px;border-radius:9px;background:#6366f1;color:#fff;display:inline-flex;align-items:center;justify-content:center"><i class="fas fa-list-check"></i></span>
            <%= stock.directionsOfUse.title || 'Directions of Use' %>
          </h3>
          <a href="/stock/new?stockId=<%= stock._id %>" class="secondary-btn" style="border-radius:999px;padding:6px 12px;font-size:12px">
            <i class="fas fa-pen"></i> Edit
          </a>
        </div>
        <div style="display:flex;flex-direction:column;gap:10px">
          <% (stock.directionsOfUse.items || []).forEach((it, idx) => { %>
            <div style="background:#fff;border:1px solid #eef0f3;border-radius:12px;padding:12px 14px;display:flex;gap:12px">
              <div style="min-width:26px;height:26px;border-radius:8px;background:#eef2ff;color:#4f46e5;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:11px"><%= idx+1 %></div>
              <div>
                <div style="font-weight:700;font-size:13px"><%= it.subtitle %></div>
                <div style="color:#4b5563;font-size:13px;margin-top:2px;line-height:1.5"><%= it.content %></div>
              </div>
            </div>
          <% }) %>
        </div>
      </div>
      <% } %>

      <!-- ALLOCATION -->
      <div class="allocation-panel">
        <div class="allocation-heading">
          <div>
            <h2>Dispatch to substations</h2>
            <p>Enter the units each substation receives.</p>
          </div>
          <div class="allocation-total-box">
            <small>Total allocated</small>
            <strong id="allocationTotal">0</strong>
          </div>
        </div>

        <form action="/stock/<%= stock._id %>" method="POST" class="allocation-form" id="allocationForm">
          <input type="hidden" name="units" id="totalUnits" value="0">

          <div class="field">
            <label for="unitSellPrice">Selling price per unit</label>
            <input id="unitSellPrice" type="number" min="0" step="0.01" name="unitSellPrice" value="<%= old && old.unitSellPrice!= null? old.unitSellPrice : '' %>" required>
          </div>

          <div class="substation-allocation-list">
            <% if (substations && substations.length) { %>
              <% substations.forEach((s) => { %>
                <% const substationId = String(s._id); const value = old && old.allocations && typeof old.allocations === "object"? (old.allocations[substationId]?? "") : ""; %>
                <div class="substation-allocation-row">
                  <div class="substation-name">
                    <i class="fas fa-store"></i>
                    <div><strong><%= s.name %></strong><% if (s.location) { %><small><%= s.location %></small><% } %></div>
                  </div>
                  <div class="substation-unit-input">
                    <label for="allocation-<%= substationId %>">Units</label>
                    <input id="allocation-<%= substationId %>" class="allocation-input" type="number" min="0" max="<%= Number(stock.units || 0) %>" step="1" inputmode="numeric" name="allocations[<%= substationId %>]" value="<%= value %>" autocomplete="off">
                  </div>
                </div>
              <% }) %>
            <% } else { %>
              <div class="error">No active substations are available.</div>
            <% } %>
          </div>

          <div class="allocation-summary">
            <div><span>Warehouse available</span><strong><%= Number(stock.units || 0).toLocaleString() %></strong></div>
            <div><span>Being dispatched</span><strong id="summaryTotal">0</strong></div>
            <div><span>Remaining warehouse</span><strong id="summaryRemaining"><%= Number(stock.units || 0).toLocaleString() %></strong></div>
          </div>

          <div id="allocationWarning" class="error" style="display:none;margin-top:12px"></div>

          <div class="form-actions">
            <button type="submit" class="primary-btn" id="allocateButton" <%=!substations ||!substations.length? "disabled" : "" %>>
              <i class="fas fa-boxes-stacked"></i> Allocate Product
            </button>
            <a href="/stock/new?stockId=<%= stock._id %>" class="secondary-btn">
              <i class="fas fa-pen"></i> Edit Stock
            </a>
            <a href="/stock" class="secondary-btn">Cancel</a>
          </div>
        </form>
      </div>
    </div>
  <% } %>
</section>

<script>
(function () {
  "use strict";
  const form = document.getElementById("allocationForm");
  const inputs = Array.from(document.querySelectorAll(".allocation-input"));
  const hiddenTotal = document.getElementById("totalUnits");
  const total = document.getElementById("allocationTotal");
  const summaryTotal = document.getElementById("summaryTotal");
  const remaining = document.getElementById("summaryRemaining");
  const warning = document.getElementById("allocationWarning");
  const button = document.getElementById("allocateButton");
  const sellPrice = document.getElementById("unitSellPrice");
  const warehouse = Number(<%= stock? Number(stock.units || 0) : 0 %>);
  if (!form) return;

  function valueOf(input) {
    const raw = String(input.value?? "").trim();
    if (raw === "") return 0;
    const v = Number(raw);
    return (!Number.isFinite(v) || v < 0)? 0 : Math.floor(v);
  }
  function calculate() {
    const sum = inputs.reduce((t, i) => t + valueOf(i), 0);
    hiddenTotal.value = String(sum);
    total.textContent = sum.toLocaleString();
    summaryTotal.textContent = sum.toLocaleString();
    remaining.textContent = Math.max(warehouse - sum, 0).toLocaleString();
    let msg = "";
    if (sum <= 0) msg = "Allocate at least one unit to at least one substation.";
    else if (sum > warehouse) msg = "The total allocation cannot exceed the warehouse balance.";
    warning.textContent = msg;
    warning.style.display = msg? "block" : "none";
    if (button) button.disabled = Boolean(msg);
    return sum;
  }
  inputs.forEach((input) => {
    input.addEventListener("input", calculate);
    input.addEventListener("change", calculate);
  });
  form.addEventListener("submit", function (e) {
    const sum = calculate();
    hiddenTotal.value = String(sum);
    if (sum <= 0 || sum > warehouse ||!sellPrice || String(sellPrice.value).trim() === "") { e.preventDefault(); return; }
    if (button) { button.disabled = true; button.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Allocating...'; }
  });
  calculate();
})();
</script>