<section class="shop-page">
  <div style="margin-bottom:15px">
    <a href="/stock" class="secondary-btn">
      <i class="fas fa-arrow-left"></i> Stock
    </a>
  </div>

  <% if (error) { %>
    <div class="error"><%= error %></div>
  <% } %>

  <% if (saved === "1") { %>
    <div class="notice">
      Product allocation saved. Stock was reduced by the allocated units.
    </div>
  <% } %>

  <div class="detail-card stock-allocation-card">
    <div class="detail-grid">
      <div class="detail-image stock-detail-image">
        <% if (stock.image) { %>
          <img
            src="<%= stock.image %>"
            alt="<%= stock.name %>"
          >
        <% } else { %>
          <div class="placeholder">
            <i class="fas fa-box"></i>
          </div>
        <% } %>
      </div>

      <div class="detail-content">
        <span class="detail-category">
          <%= stock.category %>
        </span>

        <h1><%= stock.name %></h1>

        <% if (stock.subcategory) { %>
          <div class="detail-subcategory">
            <i class="fas fa-layer-group"></i>
            <%= stock.subcategory %>
          </div>
        <% } %>

        <div class="detail-price">
          KSh <%= Number(stock.buyPrice || 0).toLocaleString() %>
          <small>buy / unit</small>
        </div>

        <% if (stock.description) { %>
          <div class="detail-description">
            <%= stock.description %>
          </div>
        <% } %>

        <div class="stock-balance-box">
          <span>Warehouse balance</span>
          <strong><%= stock.units %> units</strong>
        </div>

        <form
          action="/stock/<%= stock._id %>"
          method="POST"
          class="allocation-form"
        >
          <div class="form-grid">
            <div class="field">
              <label for="units">Units to allocate</label>
              <input
                id="units"
                type="number"
                min="1"
                max="<%= stock.units %>"
                step="1"
                name="units"
                value="<%= old.units || '' %>"
                required
              >
              <small class="form-help">
                Maximum: <%= stock.units %> units currently available.
              </small>
            </div>

            <div class="field">
              <label for="unitSellPrice">Selling price</label>
              <input
                id="unitSellPrice"
                type="number"
                min="0"
                step="0.01"
                name="unitSellPrice"
                value="<%= old.unitSellPrice || '' %>"
                required
              >
            </div>

            <div class="field full">
              <label for="substation">Substation</label>
              <select id="substation" name="substation" required>
                <option
                  value=""
                  disabled
                  <%= !old.substation ? "selected" : "" %>
                >
                  Select substation
                </option>

                <% substations.forEach((s) => { %>
                  <option
                    value="<%= s._id %>"
                    <%= String(old.substation || "") === String(s._id)
                      ? "selected"
                      : "" %>
                  >
                    <%= s.name %>
                  </option>
                <% }) %>
              </select>
            </div>
          </div>

          <div class="allocation-note">
            The product inherits its name, category, subcategory, image,
            buy price and description from this Stock record. If a Product
            already exists for this Stock category at the selected substation,
            the allocated units are added to its existing Product.units.
            Stock.units is reduced by the allocated quantity.
          </div>

          <div class="form-actions">
            <button type="submit" class="primary-btn">
              <i class="fas fa-boxes-stacked"></i>
              Allocate Product
            </button>

            <a
              href="/stock/new?stockId=<%= stock._id %>"
              class="secondary-btn"
            >
              <i class="fas fa-pen"></i> Edit Stock Category
            </a>

            <a href="/stock" class="secondary-btn">
              Cancel
            </a>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>
