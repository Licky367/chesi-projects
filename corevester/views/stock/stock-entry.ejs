<section class="shop-page">
  <div style="margin-bottom:15px">
    <a href="/stock" class="secondary-btn"><i class="fas fa-arrow-left"></i> Stock</a>
  </div>

  <% if (error) { %><div class="error"><%= error %></div><% } %>
  <% if (saved === "1") { %><div class="notice">Product allocation saved successfully.</div><% } %>

  <div class="detail-card stock-allocation-card">
    <div class="detail-grid">
      <div class="detail-image stock-detail-image">
        <% if (stock.image) { %>
          <img src="<%= stock.image %>" alt="<%= stock.subcategory %>">
        <% } else { %>
          <div class="placeholder"><i class="fas fa-box"></i></div>
        <% } %>
      </div>

      <div class="detail-content">
        <span class="detail-category"><%= stock.category %></span>
        <h1><%= stock.subcategory %></h1>
        <div class="detail-subcategory"><i class="fas fa-layer-group"></i> <%= stock.subcategory %></div>
        <div class="detail-price">KSh <%= Number(stock.buyPrice || 0).toLocaleString() %> <small>buy / unit</small></div>
        <% if (stock.description) { %><div class="detail-description"><%= stock.description %></div><% } %>
        <div class="stock-balance-box">
          <span>Warehouse balance</span>
          <strong><%= Number(stock.units || 0).toLocaleString() %> units</strong>
        </div>
      </div>
    </div>

    <div class="allocation-panel">
      <div class="allocation-heading">
        <div>
          <h2>Dispatch to substations</h2>
          <p>Enter the units each substation receives. The server calculates the total from these fields.</p>
        </div>
        <div class="allocation-total-box">
          <small>Total allocated</small>
          <strong id="allocationTotal">0</strong>
        </div>
      </div>

      <form action="/stock/<%= stock._id %>" method="POST" class="allocation-form" id="allocationForm">
        <div class="field">
          <label for="unitSellPrice">Selling price per unit</label>
          <input id="unitSellPrice" type="number" min="0" step="0.01" name="unitSellPrice" value="<%= old && old.unitSellPrice != null ? old.unitSellPrice : '' %>" required>
        </div>

        <div class="substation-allocation-list">
          <% (substations || []).forEach((s) => { %>
            <% const value = old && old.allocations ? (old.allocations[String(s._id)] ?? '') : ''; %>
            <div class="substation-allocation-row">
              <div class="substation-name">
                <i class="fas fa-store"></i>
                <div>
                  <strong><%= s.name %></strong>
                  <% if (s.location) { %><small><%= s.location %></small><% } %>
                </div>
              </div>
              <div class="substation-unit-input">
                <label for="allocation-<%= s._id %>">Units</label>
                <input
                  id="allocation-<%= s._id %>"
                  class="allocation-input"
                  type="number"
                  min="0"
                  max="<%= Number(stock.units || 0) %>"
                  step="1"
                  inputmode="numeric"
                  name="allocations[<%= s._id %>]"
                  value="<%= value %>"
                >
              </div>
            </div>
          <% }) %>
        </div>

        <div class="allocation-summary">
          <div><span>Warehouse available</span><strong><%= Number(stock.units || 0).toLocaleString() %></strong></div>
          <div><span>Being dispatched</span><strong id="summaryTotal">0</strong></div>
          <div><span>Remaining warehouse</span><strong id="summaryRemaining"><%= Number(stock.units || 0).toLocaleString() %></strong></div>
        </div>

        <div id="allocationWarning" class="error" style="display:none;margin-top:12px"></div>

        <div class="form-actions">
          <button type="submit" class="primary-btn" id="allocateButton"><i class="fas fa-boxes-stacked"></i> Allocate Product</button>
          <a href="/stock/new?stockId=<%= stock._id %>" class="secondary-btn"><i class="fas fa-pen"></i> Edit Stock</a>
          <a href="/stock" class="secondary-btn">Cancel</a>
        </div>
      </form>
    </div>
  </div>
</section>

<script>
(function () {
  const form = document.getElementById("allocationForm");
  const inputs = Array.from(document.querySelectorAll(".allocation-input"));
  const total = document.getElementById("allocationTotal");
  const summaryTotal = document.getElementById("summaryTotal");
  const remaining = document.getElementById("summaryRemaining");
  const warning = document.getElementById("allocationWarning");
  const button = document.getElementById("allocateButton");
  const sellPrice = document.getElementById("unitSellPrice");
  const warehouse = Number(<%= Number(stock.units || 0) %>);

  function valueOf(input) {
    const n = Number(input.value || 0);
    return Number.isFinite(n) && n >= 0 ? Math.floor(n) : 0;
  }

  function calculate() {
    const sum = inputs.reduce((total, input) => total + valueOf(input), 0);
    total.textContent = sum.toLocaleString();
    summaryTotal.textContent = sum.toLocaleString();
    remaining.textContent = Math.max(warehouse - sum, 0).toLocaleString();

    let message = "";
    if (sum <= 0) message = "Allocate at least one unit to at least one substation.";
    else if (sum > warehouse) message = "The total allocation cannot exceed the warehouse balance.";

    warning.textContent = message;
    warning.style.display = message ? "block" : "none";
    button.disabled = Boolean(message);
    return sum;
  }

  inputs.forEach((input) => input.addEventListener("input", calculate));
  inputs.forEach((input) => input.addEventListener("change", calculate));

  form.addEventListener("submit", (event) => {
    const sum = calculate();
    if (sum <= 0 || sum > warehouse || !sellPrice.value) {
      event.preventDefault();
      return;
    }
    button.disabled = true;
    button.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Allocating...';
  });

  calculate();
})();
</script>
