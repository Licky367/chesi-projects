<section class="shop-page">
  <div style="margin-bottom:15px">
    <a href="/stock" class="secondary-btn">
      <i class="fas fa-arrow-left"></i> Stock
    </a>
  </div>

  <div class="form-card">
    <h1 class="page-title">Enter Product</h1>
    <p class="page-subtitle">
      <strong><%= stock.name %></strong> and <strong><%= stock.category %></strong> come from Stock.
      Enter the product-specific details below. Added units are deducted from the Stock record and added to the Product record.
    </p>

    <% if (error) { %>
      <div class="error"><%= error %></div>
    <% } %>

    <% if (typeof query !== "undefined" && query === "1") { %>
      <div class="notice">Product created and stock quantity updated successfully.</div>
    <% } %>

    <form action="/stock/<%= stock._id %>" method="POST">
      <div class="form-grid">
        <div class="field">
          <label>Product name</label>
          <input value="<%= stock.name %>" readonly>
        </div>

        <div class="field">
          <label>Category</label>
          <input value="<%= stock.category %>" readonly>
        </div>

        <div class="field">
          <label>Units currently in stock</label>
          <input value="<%= stock.units %>" readonly>
        </div>

        <div class="field">
          <label for="units">Units to add to product</label>
          <input id="units" name="units" type="number" min="1" step="1" value="<%= old.units || '' %>" required>
        </div>

        <div class="field full">
          <label for="image">Product image URL</label>
          <input id="image" name="image" type="url" value="<%= old.image || '' %>" placeholder="https://example.com/product-image.jpg">
        </div>

        <div class="field">
          <label for="buyPrice">Unit buy price (KSh)</label>
          <input id="buyPrice" name="buyPrice" type="number" min="0" step="0.01" value="<%= old.buyPrice ?? stock.buyPrice ?? 0 %>">
        </div>

        <div class="field">
          <label for="unitSellPrice">Unit selling price (KSh)</label>
          <input id="unitSellPrice" name="unitSellPrice" type="number" min="0" step="0.01" value="<%= old.unitSellPrice ?? 0 %>" required>
        </div>

        <div class="field">
          <label for="substation">Substation</label>
          <select id="substation" name="substation">
            <option value="">Do not save to a substation</option>
            <% substations.forEach(substation => { %>
              <option value="<%= substation._id %>" <%= String(old.substation || '') === String(substation._id) ? 'selected' : '' %>>
                <%= substation.name %>
              </option>
            <% }) %>
          </select>
        </div>

        <div class="field full">
          <label for="description">Description</label>
          <textarea id="description" name="description"><%= old.description || '' %></textarea>
        </div>
      </div>

      <div class="form-actions">
        <button type="submit" class="primary-btn">
          <i class="fas fa-plus-circle"></i> Add Product
        </button>

        <a href="/stock" class="secondary-btn">Cancel</a>
      </div>
    </form>
  </div>
</section>
