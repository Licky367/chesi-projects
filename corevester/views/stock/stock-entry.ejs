<section class="shop-page">
  <div style="margin-bottom:15px">
    <a href="/stock" class="secondary-btn">
      <i class="fas fa-arrow-left"></i>
      Stock
    </a>
  </div>

  <% if (typeof error !== "undefined" && error) { %>
    <div class="error"><%= error %></div>
  <% } %>

  <% if (typeof saved !== "undefined" && saved === "1") { %>
    <div class="notice">Product allocation saved successfully.</div>
  <% } %>

  <% if (!stock) { %>
    <div class="error">Stock item not found.</div>
  <% } else { %>

    <div class="detail-card stock-allocation-card">
      <div class="detail-grid">

        <div class="detail-image stock-detail-image">
          <% if (stock.image) { %>
            <img
              src="<%= stock.image %>"
              alt="<%= stock.name || stock.subcategory || 'Stock item' %>"
              onerror="this.style.display='none';this.nextElementSibling.style.display='flex';"
            >
            <div class="placeholder" style="display:none">
              <i class="fas fa-box"></i>
            </div>
          <% } else { %>
            <div class="placeholder">
              <i class="fas fa-box"></i>
            </div>
          <% } %>
        </div>

        <div class="detail-content">
          <span class="detail-category">
            <%= stock.category || "Other" %>
          </span>

          <h1>
            <%= stock.subcategory || stock.name || "Stock item" %>
          </h1>

          <div class="detail-subcategory">
            <i class="fas fa-layer-group"></i>
            <%= stock.subcategory || stock.name || "Other" %>
          </div>

          <div class="detail-price">
            KSh <%= Number(stock.buyPrice || 0).toLocaleString() %>
            <small>buy / unit</small>
          </div>

          <% if (stock.description) { %>
            <div class="detail-description">
              <%= stock.description %>
            </div>
          <% } %>

          <div class="stock-balance-box">
            <span>Warehouse balance</span>
            <strong>
              <%= Number(stock.units || 0).toLocaleString() %> units
            </strong>
          </div>
        </div>
      </div>

      <div class="allocation-panel">
        <div class="allocation-heading">
          <div>
            <h2>Dispatch to substations</h2>
            <p>Enter the units each substation receives.</p>
          </div>

          <div class="allocation-total-box">
            <small>Total allocated</small>
            <strong id="allocationTotal">0</strong>
          </div>
        </div>

        <form
          action="/stock/<%= stock._id %>"
          method="POST"
          class="allocation-form"
          id="allocationForm"
        >
          <input type="hidden" name="units" id="totalUnits" value="0">

          <div class="field">
            <label for="unitSellPrice">Selling price per unit</label>
            <input
              id="unitSellPrice"
              type="number"
              min="0"
              step="0.01"
              name="unitSellPrice"
              value="<%= old && old.unitSellPrice != null ? old.unitSellPrice : '' %>"
              required
            >
          </div>

          <div class="substation-allocation-list">
            <% if (substations && substations.length) { %>

              <% substations.forEach((s) => { %>
                <%
                  const substationId = String(s._id);
                  const value =
                    old &&
                    old.allocations &&
                    typeof old.allocations === "object"
                      ? (old.allocations[substationId] ?? "")
                      : "";
                %>

                <div class="substation-allocation-row">
                  <div class="substation-name">
                    <i class="fas fa-store"></i>
                    <div>
                      <strong><%= s.name %></strong>
                      <% if (s.location) { %>
                        <small><%= s.location %></small>
                      <% } %>
                    </div>
                  </div>

                  <div class="substation-unit-input">
                    <label for="allocation-<%= substationId %>">
                      Units
                    </label>

                    <input
                      id="allocation-<%= substationId %>"
                      class="allocation-input"
                      type="number"
                      min="0"
                      max="<%= Number(stock.units || 0) %>"
                      step="1"
                      inputmode="numeric"
                      name="allocations[<%= substationId %>]"
                      value="<%= value %>"
                      autocomplete="off"
                    >
                  </div>
                </div>
              <% }) %>

            <% } else { %>
              <div class="error">
                No active substations are available.
              </div>
            <% } %>
          </div>

          <div class="allocation-summary">
            <div>
              <span>Warehouse available</span>
              <strong>
                <%= Number(stock.units || 0).toLocaleString() %>
              </strong>
            </div>

            <div>
              <span>Being dispatched</span>
              <strong id="summaryTotal">0</strong>
            </div>

            <div>
              <span>Remaining warehouse</span>
              <strong id="summaryRemaining">
                <%= Number(stock.units || 0).toLocaleString() %>
              </strong>
            </div>
          </div>

          <div
            id="allocationWarning"
            class="error"
            style="display:none;margin-top:12px"
          ></div>

          <div class="form-actions">
            <button
              type="submit"
              class="primary-btn"
              id="allocateButton"
              <%= !substations || !substations.length ? "disabled" : "" %>
            >
              <i class="fas fa-boxes-stacked"></i>
              Allocate Product
            </button>

            <a
              href="/stock/new?stockId=<%= stock._id %>"
              class="secondary-btn"
            >
              <i class="fas fa-pen"></i>
              Edit Stock
            </a>

            <a href="/stock" class="secondary-btn">
              Cancel
            </a>
          </div>
        </form>
      </div>
    </div>

  <% } %>
</section>

<script>
(function () {
  "use strict";

  const form = document.getElementById("allocationForm");
  const inputs = Array.from(
    document.querySelectorAll(".allocation-input")
  );

  const hiddenTotal = document.getElementById("totalUnits");
  const total = document.getElementById("allocationTotal");
  const summaryTotal = document.getElementById("summaryTotal");
  const remaining = document.getElementById("summaryRemaining");
  const warning = document.getElementById("allocationWarning");
  const button = document.getElementById("allocateButton");
  const sellPrice = document.getElementById("unitSellPrice");

  const warehouse =
    Number(<%= stock ? Number(stock.units || 0) : 0 %>);

  if (!form) return;

  function valueOf(input) {
    const raw = String(input.value ?? "").trim();

    if (raw === "") return 0;

    const value = Number(raw);

    if (!Number.isFinite(value) || value < 0) {
      return 0;
    }

    return Math.floor(value);
  }

  function calculate() {
    const sum = inputs.reduce(
      (runningTotal, input) =>
        runningTotal + valueOf(input),
      0
    );

    /*
     * This hidden field is deliberately updated on every
     * calculation AND immediately before POST.
     */
    hiddenTotal.value = String(sum);

    total.textContent = sum.toLocaleString();
    summaryTotal.textContent = sum.toLocaleString();

    remaining.textContent =
      Math.max(warehouse - sum, 0).toLocaleString();

    let message = "";

    if (sum <= 0) {
      message =
        "Allocate at least one unit to at least one substation.";
    } else if (sum > warehouse) {
      message =
        "The total allocation cannot exceed the warehouse balance.";
    }

    warning.textContent = message;
    warning.style.display =
      message ? "block" : "none";

    if (button) {
      button.disabled = Boolean(message);
    }

    return sum;
  }

  inputs.forEach((input) => {
    input.addEventListener("input", calculate);
    input.addEventListener("change", calculate);
  });

  form.addEventListener("submit", function (event) {
    const sum = calculate();

    /*
     * Recalculate one final time. This guarantees that the
     * submitted `units` matches allocations[...] values.
     */
    hiddenTotal.value = String(sum);

    if (
      sum <= 0 ||
      sum > warehouse ||
      !sellPrice ||
      String(sellPrice.value).trim() === ""
    ) {
      event.preventDefault();
      return;
    }

    if (button) {
      button.disabled = true;
      button.innerHTML =
        '<i class="fas fa-spinner fa-spin"></i> Allocating...';
    }
  });

  calculate();
})();
</script>
