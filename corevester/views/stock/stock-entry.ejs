<section class="shop-page"><div class="form-card"><a href="/stock" class="secondary-btn">← Stock</a><h1 class="page-title">Create Product from Stock</h1><p>Warehouse stock: <strong><%=stock.name%></strong> — available: <strong><%=stock.units%></strong> units.</p><% if(error){ %><div class="error"><%=error%></div><% } %><% if(saved==='1'){ %><div class="notice">Product created and only allocated units were deducted from stock.</div><% } %><form action="/stock/<%=stock._id%>" method="POST"><div class="form-grid"><div class="field"><label>Product name</label><input name="name" value="<%=old.name||''%>" required></div><div class="field"><label>Category</label><input name="category" value="<%=old.category||stock.category%>" required></div><div class="field"><label>Units to allocate</label><input type="number" min="1" max="<%=stock.units%>" name="units" value="<%=old.units||''%>" required></div><div class="field"><label>Buy price</label><input type="number" min="0" step="0.01" name="buyPrice" value="<%=old.buyPrice??stock.buyPrice??0%>"></div><div class="field"><label>Selling price</label><input type="number" min="0" step="0.01" name="unitSellPrice" value="<%=old.unitSellPrice??''%>" required></div><div class="field"><label>Substation</label><select name="substation"><option value="">No substation</option><% substations.forEach(s=>{ %><option value="<%=s._id%>"><%=s.name%></option><% }) %></select></div><div class="field full"><label>Image URL</label><input name="image" value="<%=old.image||''%>"></div><div class="field full"><label>Description</label><textarea name="description"><%=old.description||''%></textarea></div></div><button class="primary-btn">Create Product</button></form></div></section>
