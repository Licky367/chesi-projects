<section class="shop-page">
  <div class="page-head">
    <div>
      <h1 class="page-title">Stock Management</h1>
      <p class="page-subtitle">Warehouse stock grouped by category and subcategory.</p>
    </div>
    <a href="/stock/new" class="primary-btn"><i class="fas fa-plus"></i> Add / Update Stock</a>
  </div>

  <% if (error) { %><div class="error"><%= error %></div><% } %>
  <% if (saved === "1") { %><div class="notice">Stock saved successfully.</div><% } %>

  <% if (!stocks || !stocks.length) { %>
    <div class="empty" style="margin-top:25px"><i class="fas fa-warehouse"></i><div>No stock records exist yet.</div></div>
  <% } else { %>
    <% stocks.forEach((group) => { %>
      <section class="category-section">
        <div class="category-head">
          <h2><%= group.label %></h2>
          <span>Six cards maximum · swipe left/right</span>
        </div>

        <% (group.rows || []).forEach((row) => { %>
          <div class="product-row stock-row">
            <% row.products.forEach((stock) => { %>
              <div class="stock-card-wrap">
                <a href="/stock/<%= stock._id %>" class="product-card stock-card">
                  <div class="product-image">
                    <% if (stock.image) { %><img src="<%= stock.image %>" alt="<%= stock.subcategory %>" loading="lazy"><% } else { %><div class="placeholder"><i class="fas fa-box"></i></div><% } %>
                  </div>
                  <div class="product-info">
                    <div class="product-name"><%= stock.subcategory %></div>
                    <div class="stock-text"><%= stock.category %></div>
                    <div class="stock-subcategory"><%= stock.subcategory %></div>
                    <div class="stock-data">
                      <div class="data-cell"><small>Warehouse units</small><strong><%= Number(stock.units || 0).toLocaleString() %></strong></div>
                      <div class="data-cell"><small>Buy / unit</small><strong>KSh <%= Number(stock.buyPrice || 0).toLocaleString() %></strong></div>
                    </div>
                  </div>
                </a>
                <a href="/stock/new?stockId=<%= stock._id %>" class="secondary-btn stock-edit-btn"><i class="fas fa-pen"></i> Edit</a>
              </div>
            <% }) %>
          </div>
        <% }) %>
      </section>
    <% }) %>
  <% } %>
</section>
