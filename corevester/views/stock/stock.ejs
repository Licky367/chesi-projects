<section class="shop-page">
  <div class="page-head">
    <div>
      <h1 class="page-title">Stock</h1>
      <p class="page-subtitle">
        Warehouse inventory organized by category and subcategory.
        Open a subcategory to dispatch units to substations.
      </p>
    </div>

    <a href="/stock/new" class="primary-btn">
      <i class="fas fa-plus"></i> Add Stock
    </a>
  </div>

  <% if (error) { %>
    <div class="error"><%= error %></div>
  <% } %>

  <% if (saved === "1") { %>
    <div class="notice">
      Stock subcategory saved successfully.
    </div>
  <% } %>

  <% if (!stocks.length) { %>
    <div class="empty">
      <i class="fas fa-box-open"></i>
      <div>No stock records are available.</div>
    </div>
  <% } %>

  <% stocks.forEach((category) => { %>
    <section class="category-section">
      <div class="category-head">
        <h2><%= category.label %></h2>
      </div>

      <% category.subcategories.forEach((subcategory) => { %>
        <div class="subcategory-row-block">
          <div class="subcategory-head">
            <h3><%= subcategory.label %></h3>
          </div>

          <% subcategory.rows.forEach((row) => { %>
            <div class="product-row category-product-row">
              <% row.products.forEach((stock) => { %>
                <a
                  class="product-card stock-card"
                  href="/stock/<%= stock._id %>"
                >
                  <div class="product-image">
                    <% if (stock.image) { %>
                      <img
                        src="<%= stock.image %>"
                        alt="<%= stock.name %>"
                        loading="lazy"
                      >
                    <% } else { %>
                      <div class="placeholder">
                        <i class="fas fa-box"></i>
                      </div>
                    <% } %>
                  </div>

                  <div class="product-info">
                    <div class="product-name">
                      <%= stock.name %>
                    </div>

                    <div class="stock-meta-line">
                      <%= stock.subcategory %>
                    </div>

                    <div class="stock-data">
                      <div class="data-cell">
                        <small>Warehouse</small>
                        <strong><%= stock.units %></strong>
                      </div>

                      <div class="data-cell">
                        <small>Days</small>
                        <strong><%= stock.days %></strong>
                      </div>
                    </div>
                  </div>
                </a>
              <% }) %>
            </div>
          <% }) %>
        </div>
      <% }) %>
    </section>
  <% }) %>
</section>
