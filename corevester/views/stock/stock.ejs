<section class="shop-page">
  <div class="page-head">
    <div>
      <h1 class="page-title">Stock</h1>
      <p class="page-subtitle">Warehouse inventory.
      Open stock to allocate units into products.</p>
    </div>
    <a href="/stock/new" class="primary-btn">Add Stock</a>
  </div>

  <% if(error){ %>
    <div class="error"><%=error%></div>
  <% } %>

  <% if(saved==='1'){ %>
    <div class="notice">Stock saved successfully.</div>
  <% } %>

  <div class="product-row" aria-label="Stock categories">
    <% stocks.forEach(stock=>{ %>
      <a class="product-card stock-card" href="/stock/<%=stock._id%>">
        <div class="product-image">
          <% if(stock.image){ %>
            <img src="<%=stock.image%>" alt="<%=stock.name%>" loading="lazy">
          <% }else{ %>
            <div class="placeholder">Stock</div>
          <% } %>
        </div>

        <div class="product-info">
          <div class="product-name"><%=stock.name%></div>
          <div class="stock-text"><%=stock.category%></div>

          <div class="stock-data">
            <div class="data-cell">
              <small>Warehouse</small>
              <strong><%=stock.units%></strong>
            </div>
            <div class="data-cell">
              <small>Units</small>
              <strong>units</strong>
            </div>
          </div>
        </div>
      </a>
    <% }) %>
  </div>
</section>
