<section class="shop-page"><div class="form-card"><a href="/stock" class="secondary-btn">← Stock</a><h1 class="page-title">Add Stock</h1><p class="page-subtitle">Create warehouse inventory only.</p><% if(error){ %><div class="error"><%=error%></div><% } %><form action="/stock" method="POST"><div class="form-grid"><div class="field"><label>Stock name</label><input name="name" value="<%=old.name||''%>" required></div><div class="field"><label>Category</label><input name="category" value="<%=old.category||''%>" required></div><div class="field"><label>Warehouse units</label><input type="number" min="0" step="1" name="units" value="<%=old.units??0%>" required></div><div class="field"><label>Buy price</label><input type="number" min="0" step="0.01" name="buyPrice" value="<%=old.buyPrice??0%>"></div><div class="field full"><label>Image URL</label><input name="image" value="<%=old.image||''%>"></div><div class="field full"><label>Description</label><textarea name="description"><%=old.description||''%></textarea></div></div><button class="primary-btn">Create Stock</button></form></div></section>
