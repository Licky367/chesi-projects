<section class="shop-page"><div class="page-head"><div><h1 class="page-title">Substations</h1></div><a href="/substations/new" class="primary-btn">New Substation</a></div><% if(error){ %><div class="error"><%=error%></div><% } %><div class="product-row"><% substations.forEach(s=>{ %><a href="/substations/<%=s._id%>" class="product-card"><div class="product-info"><div class="product-name"><%=s.name%></div><div class="stock-text"><%=s.location||'No location'%></div></div></a><% }) %></div></section>
