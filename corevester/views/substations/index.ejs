<div style="width:100%;max-width:500px;margin:0 auto;padding:10px;box-sizing:border-box;background:#f6fbf6;font-family:system-ui,sans-serif;display:flex;flex-direction:column;gap:12px;">

  <!-- 1. HEADER -->
  <div style="background:#e8f2e6;border:1.5px solid #cfe1d3;border-radius:14px;padding:14px 16px;display:flex;align-items:center;justify-content:space-between;gap:10px;">
    <div style="display:flex;align-items:center;gap:12px;">
      <div style="width:48px;height:48px;background:#fff;border-radius:50%;display:grid;place-items:center;font-size:20px;">⚡</div>
      <div>
        <div style="font-size:13px;font-weight:900;color:#0a4d1e;">SUBSTATIONS</div>
        <div style="font-size:11px;color:#5a7d5a;margin-top:2px;">Select to view products.</div>
      </div>
    </div>
    <a href="/substations/new" style="padding:9px 12px;background:#0a4d1e;color:#fff;border-radius:8px;text-decoration:none;font-size:11px;font-weight:800;white-space:nowrap;">+ New</a>
  </div>

  <% if (typeof error !== 'undefined' && error) { %><div style="padding:10px 12px;border-radius:10px;background:#fff0f0;color:#9b2424;font-size:11px;"><%= error %></div><% } %>
  <% if (typeof saved !== 'undefined' && saved==="1") { %><div style="padding:10px 12px;border-radius:10px;background:#eaf8ee;color:#176b2c;font-size:11px;">✅ Substation created successfully.</div><% } %>

  <!-- 2. OVERVIEW -->
  <div style="background:#eef6ec;border:1.5px solid #cfe1d3;border-radius:14px;padding:12px;">
    <div style="font-size:10px;font-weight:900;letter-spacing:0.8px;color:#2e5a36;padding:0 4px 8px 4px;">OVERVIEW</div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
      <div style="padding:11px 12px;border-radius:10px;background:#fff;border:1.5px solid #dbe9dc;text-align:center;">
        <div style="font-size:10px;color:#666;">Total</div>
        <b style="font-size:18px;color:#0a4d1e;display:block;margin-top:2px;"><%= Array.isArray(substations)? substations.length : 0 %></b>
      </div>
      <a href="/substations/new" style="padding:11px 12px;border-radius:10px;background:#0a4d1e;color:#fff;border:1.5px solid #0a4d1e;text-decoration:none;text-align:center;font-size:11px;font-weight:800;display:grid;place-items:center;">+ Add Substation</a>
    </div>
  </div>

  <!-- 3. LIST - FULL WIDTH -->
  <div style="background:#eef6ec;border:1.5px solid #cfe1d3;border-radius:14px;padding:10px;">
    <div style="background:#fff;border-radius:12px;padding:10px;">
      <div style="font-size:11px;font-weight:900;color:#0a4d1e;padding-bottom:10px;border-bottom:1px solid #eef2ee;">SUBSTATIONS LIST</div>

      <% if (!substations || substations.length===0) { %>
        <div style="padding:30px 10px;text-align:center;border:1.5px dashed #cfe1d3;border-radius:10px;background:#f9fcf9;margin-top:10px;">
          <div style="font-size:28px;">⚡</div>
          <div style="font-size:12px;font-weight:800;margin-top:8px;">No substations yet</div>
          <div style="font-size:10px;color:#777;margin-top:4px;">Create your first one</div>
          <a href="/substations/new" style="display:inline-block;margin-top:12px;padding:10px 16px;background:#0a4d1e;color:#fff;border-radius:8px;text-decoration:none;font-size:11px;font-weight:800;">Create First Substation</a>
        </div>
      <% } else { %>
        <div style="margin-top:10px;display:flex;flex-direction:column;gap:8px;">
          <% substations.forEach((substation, idx)=>{ %>
            <a href="/substations/<%= substation._id %>" style="display:flex;align-items:center;justify-content:space-between;gap:10px;padding:12px 14px;background:#fbfdfb;border:1.5px solid #dce9dc;border-radius:10px;text-decoration:none;color:inherit;">
              <div style="display:flex;align-items:center;gap:10px;min-width:0;">
                <div style="width:32px;height:32px;background:#e8f2e6;border-radius:8px;display:grid;place-items:center;font-size:12px;font-weight:900;color:#0a4d1e;flex-shrink:0;"><%= idx+1 %></div>
                <div style="min-width:0;">
                  <div style="font-size:13px;font-weight:800;color:#0a2e14;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"><%= substation.name %></div>
                  <% if(substation.location){ %><div style="font-size:10px;color:#777;margin-top:2px;">📍 <%= substation.location %></div><% } %>
                </div>
              </div>
              <div style="font-size:16px;color:#0a4d1e;flex-shrink:0;">›</div>
            </a>
          <% }) %>
        </div>
      <% } %>
    </div>
  </div>

</div>