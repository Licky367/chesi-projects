<section class="shop-page"><div class="form-card"><a href="/substations" class="secondary-btn">← Substations</a><h1 class="page-title">New Substation</h1><% if(error){ %><div class="error"><%=error%></div><% } %><form action="/substations" method="POST"><div class="form-grid"><div class="field"><label>Name</label><input name="name" value="<%=old.name||''%>" required></div><div class="field"><label>Location</label><input name="location" value="<%=old.location||''%>"></div><div class="field full"><label>Description</label><textarea name="description"><%=old.description||''%></textarea></div></div><button class="primary-btn">Create Substation</button></form></div></section>
