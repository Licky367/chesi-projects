<section class="shop-page">
  <div style="margin-bottom:15px">
    <a href="/substations" class="secondary-btn">← Substations</a>
  </div>

  <div class="substation-detail-card">
    <div class="substation-detail-header">
      <div class="substation-icon">⚡</div>
      <div>
        <h1><%= substation.name %></h1>
        <% if (substation.location) { %>
          <p>📍 <%= substation.location %></p>
        <% } %>
      </div>
    </div>

    <% if (substation.description) { %>
      <div class="substation-description">
        <%= substation.description %>
      </div>
    <% } %>

    <div class="substation-overview">
      <div>
        <small>Products</small>
        <strong><%= substation.products ? substation.products.length : 0 %></strong>
      </div>
      <div>
        <small>Location</small>
        <strong><%= substation.location || "—" %></strong>
      </div>
    </div>

    <div class="substation-products-panel">
      <h2>Products in this substation</h2>

      <% if (!substation.products || !substation.products.length) { %>
        <div class="empty">
          <i class="fas fa-box-open"></i>
          <div>No products have been allocated here yet.</div>
        </div>
      <% } else { %>
        <div class="substation-product-list">
          <% substation.products.forEach((product) => { %>
            <a
              href="/substations/product/<%= product._id %>"
              class="substation-product-item"
            >
              <div class="list-thumb">
                <% if (product.image) { %>
                  <img
                    src="<%= product.image %>"
                    alt="<%= product.name %>"
                  >
                <% } else { %>
                  <span>📦</span>
                <% } %>
              </div>

              <div class="list-main">
                <h3><%= product.name %></h3>
                <div class="list-meta">
                  <%= product.category %>
                  ·
                  <%= product.subcategory || "Other" %>
                </div>
                <div class="list-price">
                  <%= product.substationUnits %> units here
                </div>
              </div>

              <span>›</span>
            </a>
          <% }) %>
        </div>
      <% } %>
    </div>
  </div>
</section>
