<section class="shop-page">

  <!-- =========================
       BACK
  ========================== -->

  <div class="page-actions">

    <a
      href="/substations"
      class="secondary-btn"
    >
      <i class="fas fa-arrow-left"></i>
      Substations
    </a>

  </div>


  <!-- =========================
       SUBSTATION HEADER
  ========================== -->

  <div class="substation-header">

    <h1 class="page-title">
      <%= substation.name %>
    </h1>


    <% if (substation.location) { %>

      <p class="page-subtitle">
        <%= substation.location %>
      </p>

    <% } %>


    <% if (substation.description) { %>

      <p class="substation-description">
        <%= substation.description %>
      </p>

    <% } %>

  </div>


  <!-- =========================
       PRODUCTS
  ========================== -->

  <% if (
    !substation.products ||
    substation.products.length === 0
  ) { %>

    <div class="empty">

      <i class="fas fa-box-open"></i>

      <p>
        No products have been assigned to this substation yet.
      </p>

    </div>


  <% } else { %>


    <div class="products-section">

      <h2>
        Products
      </h2>


      <ul class="substation-products-list">


        <% substation.products.forEach(
          product => {
        %>


          <li class="substation-product-item">


            <a
              href="/substations/product/<%= product._id %>"
              class="substation-product-link"
            >


              <!-- IMAGE -->

              <div class="product-list-image">

                <% if (product.image) { %>

                  <img
                    src="<%= product.image %>"
                    alt="<%= product.name %>"
                  >

                <% } else { %>

                  <div class="product-placeholder">

                    <i class="fas fa-box"></i>

                  </div>

                <% } %>

              </div>


              <!-- PRODUCT INFORMATION -->

              <div class="product-list-info">


                <strong class="product-list-name">

                  <%= product.name %>

                </strong>


                <span class="product-list-category">

                  <%= product.category %>

                </span>


                <span class="product-list-units">

                  <%= product.units %> units

                </span>


              </div>


              <!-- ARROW -->

              <div class="product-list-arrow">

                <i class="fas fa-chevron-right"></i>

              </div>


            </a>


          </li>


        <% }) %>


      </ul>


    </div>


  <% } %>


</section>


<style>


/* =========================
   PAGE ACTIONS
========================= */

.page-actions {

  margin-bottom: 20px;

}


/* =========================
   SUBSTATION HEADER
========================= */

.substation-header {

  margin-bottom: 30px;

}


.substation-description {

  margin-top: 10px;

  line-height: 1.6;

  color: #555;

}


/* =========================
   PRODUCTS SECTION
========================= */

.products-section {

  margin-top: 25px;

}


.products-section h2 {

  margin-bottom: 15px;

}


/* =========================
   UL
========================= */

.substation-products-list {

  list-style: none;

  padding: 0;

  margin: 0;

  display: flex;

  flex-direction: column;

  gap: 12px;

}


/* =========================
   LI
========================= */

.substation-product-item {

  width: 100%;

}


/* =========================
   PRODUCT LINK
========================= */

.substation-product-link {

  display: flex;

  align-items: center;

  gap: 15px;

  padding: 15px;

  background: #ffffff;

  border: 1px solid #e5e7eb;

  border-radius: 12px;

  text-decoration: none;

  color: inherit;

  transition:

    transform 0.2s ease,

    box-shadow 0.2s ease;

}


.substation-product-link:hover {

  transform: translateY(-2px);

  box-shadow:

    0 6px 18px

    rgba(0, 0, 0, 0.08);

}


/* =========================
   IMAGE
========================= */

.product-list-image {

  width: 65px;

  height: 65px;

  flex-shrink: 0;

}


.product-list-image img {

  width: 100%;

  height: 100%;

  object-fit: cover;

  border-radius: 10px;

}


.product-placeholder {

  width: 100%;

  height: 100%;

  display: flex;

  align-items: center;

  justify-content: center;

  border-radius: 10px;

  background: #f3f4f6;

  color: #0b5d1e;

}


/* =========================
   PRODUCT INFORMATION
========================= */

.product-list-info {

  display: flex;

  flex-direction: column;

  gap: 5px;

  flex: 1;

}


.product-list-name {

  font-size: 16px;

}


.product-list-category {

  font-size: 13px;

  color: #6b7280;

}


.product-list-units {

  font-size: 13px;

  color: #0b5d1e;

  font-weight: 600;

}


/* =========================
   ARROW
========================= */

.product-list-arrow {

  color: #0b5d1e;

}


</style>