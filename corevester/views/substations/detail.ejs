<section class="shop-page"><a href="/substations" class="secondary-btn">← Substations</a><h1 class="page-title"><%=substation.name%></h1><div class="product-row"><% substation.products.forEach(product=>{ %><a href="/substations/product/<%=product._id%>" class="product-card"><div class="product-info"><div class="product-name"><%=product.name%></div><div class="stock-text"><%=product.category%></div><strong><%=product.units%> units</strong></div></a><% }) %></div><% if(!substation.products.length){ %><div class="empty">No products assigned yet.</div><% } %></section>
