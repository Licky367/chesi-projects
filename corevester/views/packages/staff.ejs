<% const safePackages = Array.isArray(packages)? packages : []; const tabCounts = counts || {all:safePackages.length,pending:0,confirmed:0,delivered:0}; %>

<div style="width:100%;max-width:500px;margin:0 auto;padding:10px;box-sizing:border-box;background:#f6fbf6;font-family:system-ui,sans-serif;display:flex;flex-direction:column;gap:12px;">

  <!-- 1. PACKAGE MANAGEMENT HEADER -->
  <div style="background:#e8f2e6;border:1.5px solid #cfe1d3;border-radius:14px;padding:14px 16px;display:flex;align-items:center;gap:14px;">
    <div style="width:48px;height:48px;background:#fff;border-radius:50%;display:grid;place-items:center;font-size:20px;">📦</div>
    <div>
      <div style="font-size:13px;font-weight:900;color:#0a4d1e;">PACKAGE MANAGEMENT</div>
      <div style="font-size:11px;color:#5a7d5a;margin-top:2px;"><%= role === 'admin'? 'All client packages.' : 'Claim pending packages.' %></div>
    </div>
  </div>

  <% if (typeof error!== 'undefined' && error) { %>
    <div style="padding:10px 12px;border-radius:10px;background:#fff0f0;color:#9b2424;font-size:11px;"><%= error %></div>
  <% } %>
  <% if (typeof success!== 'undefined' && success) { %>
    <div style="padding:10px 12px;border-radius:10px;background:#eaf8ee;color:#176b2c;font-size:11px;"><%= success %></div>
  <% } %>

  <!-- 2. OVERVIEW - TABS AS FILTER (2x2 grid, tappable) -->
  <div style="background:#eef6ec;border:1.5px solid #cfe1d3;border-radius:14px;padding:12px;">
    <div style="font-size:10px;font-weight:900;letter-spacing:0.8px;color:#2e5a36;padding:0 4px 8px 4px;">OVERVIEW</div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
      <% ['all','pending','confirmed','delivered'].forEach(t => {
         const active = status===t;
         const icon = t==='all'?'📦':t==='pending'?'⏳':t==='confirmed'?'✅':'🚚';
      %>
        <a href="/packages/staff?status=<%= t %>" style="display:flex;justify-content:space-between;align-items:center;padding:11px 12px;border-radius:10px;text-decoration:none;font-size:11px;font-weight:<%= active?'900':'700' %>;<%= active? 'background:#0a4d1e;color:#fff;border:1.5px solid #0a4d1e;' : 'background:#fff;color:#1a3d1a;border:1.5px solid #dbe9dc;' %>">
          <span><%= icon %> <%= t.charAt(0).toUpperCase()+t.slice(1) %></span>
          <span style="min-width:20px;height:20px;display:grid;place-items:center;border-radius:20px;font-size:10px;font-weight:800;<%= active? 'background:#fff;color:#0a4d1e;' : 'background:#e8f2e6;color:#0a4d1e;' %>"><%= tabCounts[t]||0 %></span>
        </a>
      <% }) %>
    </div>
  </div>

  <!-- 3. USERS / PACKAGES LIST - BOTTOM FULL WIDTH -->
  <div style="background:#eef6ec;border:1.5px solid #cfe1d3;border-radius:14px;padding:10px;">
    <div style="background:#fff;border-radius:12px;padding:10px;">
      <div style="display:flex;justify-content:space-between;align-items:center;padding-bottom:10px;border-bottom:1px solid #eef2ee;">
        <div>
          <div style="font-size:12px;font-weight:900;color:#0a4d1e;">PACKAGES - <%= String(status||'all').toUpperCase() %></div>
          <div style="font-size:10px;color:#777;margin-top:1px;"><%= safePackages.length %> in this section</div>
        </div>
      </div>

      <div style="margin-top:10px;display:flex;flex-direction:column;gap:8px;">
        <% if (!safePackages.length) { %>
          <div style="padding:28px;text-align:center;border:1.5px dashed #cfe1d3;border-radius:10px;background:#f9fcf9;">
            <div style="font-size:24px;">📭</div>
            <div style="font-size:11px;font-weight:800;margin-top:6px;">No packages in this section</div>
          </div>
        <% } %>
        <% safePackages.forEach(pkg => { %>
          <a href="/packages/staff/<%= pkg._id %>" style="display:flex;gap:10px;align-items:center;padding:12px;border:1.5px solid #dce9dc;border-radius:10px;background:#fbfdfb;text-decoration:none;color:inherit;">
            <div style="width:42px;height:42px;background:#eaf6ed;border-radius:50%;display:grid;place-items:center;font-size:18px;flex-shrink:0;">📦</div>
            <div style="flex:1;min-width:0;">
              <div style="display:flex;align-items:center;gap:6px;flex-wrap:wrap;">
                <span style="font-size:12px;font-weight:800;color:#0a2e14;">Package <%= String(pkg._id).slice(-6) %></span>
                <span style="padding:3px 7px;border-radius:20px;font-size:8px;font-weight:900;text-transform:uppercase;<%= pkg.status==='pending'?'background:#fff5dd;color:#9a6a00;':pkg.status==='confirmed'?'background:#e8f1ff;color:#245a9c;':'background:#eaf8ee;color:#176b2c;' %>"><%= pkg.status %></span>
              </div>
              <div style="font-size:10px;color:#666;margin-top:4px;line-height:1.5;">
                Client: <b style="color:#222;"><%= pkg.client?.name || 'Unknown' %></b><br>
                <%= pkg.items.reduce((s,i)=>s+Number(i.qty||0),0) %> item(s) · KSh <%= Number(pkg.totalAmount||0).toLocaleString() %>
                <% if (pkg.confirmedByStaffName) { %><br>Staff: <%= pkg.confirmedByStaffName %><% } %>
              </div>
            </div>
            <div style="font-size:16px;color:#aaa;">›</div>
          </a>
        <% }) %>
      </div>
    </div>
  </div>

</div>