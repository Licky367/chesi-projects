<section class="shop-page">
  <div class="form-card" style="text-align:center">

    <div
      id="icon"
      style="font-size:52px;color:var(--green)"
    >
      <i class="fas fa-mobile-screen-button"></i>
    </div>

    <h1
      id="heading"
      style="margin:14px 0 8px"
    >
      Confirm M-Pesa payment
    </h1>

    <p
      id="message"
      style="color:var(--muted);line-height:1.6"
    >
      Check your phone and enter your M-Pesa PIN.
      This page will update automatically.
    </p>

    <div style="margin:20px 0">
      <span
        id="status"
        class="status pending"
      >
        Pending
      </span>
    </div>

    <a
      id="packagesLink"
      href="/packages"
      class="primary-btn"
      style="display:none"
    >
      View My Packages
    </a>

    <a
      href="/carts"
      class="secondary-btn"
      style="
        margin-top:10px;
        display:inline-block
      "
    >
      Back to Cart
    </a>

  </div>
</section>

<script>
(function () {
  const paymentId =
    "<%= payment._id %>";

  const statusEl =
    document.getElementById("status");

  const messageEl =
    document.getElementById("message");

  const headingEl =
    document.getElementById("heading");

  const packagesLink =
    document.getElementById("packagesLink");

  let attempts = 0;

  async function check() {
    try {
      const response = await fetch(
        `/carts/payment/${paymentId}/status`,
        {
          headers: {
            "Accept": "application/json"
          }
        }
      );

      const data =
        await response.json();

      if (!data.ok) {
        throw new Error(
          data.message ||
          "Unable to check payment."
        );
      }

      statusEl.textContent =
        data.status;

      statusEl.className =
        "status " + data.status;

      if (data.status === "confirmed") {
        headingEl.textContent =
          "Payment confirmed";

        messageEl.textContent =
          data.receipt
            ? `M-Pesa receipt: ${data.receipt}. Your payment has been confirmed.`
            : "Payment confirmed successfully.";

        packagesLink.style.display =
          "inline-block";

        setTimeout(() => {
          window.location.href =
            data.packageId
              ? `/packages/${data.packageId}`
              : "/packages";
        }, 1200);

        return;
      }

      if (data.status === "failed") {
        headingEl.textContent =
          "Payment failed";

        messageEl.textContent =
          data.description ||
          "The M-Pesa payment was not completed.";

        return;
      }

      attempts++;

      if (attempts < 40) {
        setTimeout(check, 3000);
      } else {
        messageEl.textContent =
          "Payment is still pending. Refresh this page to check again.";
      }

    } catch (err) {
      attempts++;

      if (attempts < 40) {
        setTimeout(check, 4000);
      }
    }
  }

  check();
})();
</script>
