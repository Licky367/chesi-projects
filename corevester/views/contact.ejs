     COMPANY CONTACT PAGE
     ========================================================== -->


<style>

    /* ======================================================
       PAGE
       ====================================================== */

    .contact-page {
        width: 100%;
        max-width: 1100px;
        margin: 0 auto;
        padding: 28px 18px 60px;
        box-sizing: border-box;
    }


    /* ======================================================
       HERO
       ====================================================== */

    .contact-hero {
        position: relative;

        overflow: hidden;

        background:
            linear-gradient(
                135deg,
                #f4faf5 0%,
                #ffffff 55%,
                #fff8ed 100%
            );

        border: 1px solid #e0e9e2;
        border-radius: 24px;

        padding: 38px 30px;

        margin-bottom: 22px;

        box-shadow:
            0 10px 30px rgba(20, 50, 30, .06);
    }


    .contact-hero::after {
        content: "";

        position: absolute;

        width: 180px;
        height: 180px;

        right: -70px;
        top: -70px;

        border-radius: 50%;

        background: rgba(64, 151, 78, .08);
    }


    .contact-hero-content {
        position: relative;
        z-index: 1;

        max-width: 760px;
    }


    .contact-eyebrow {
        display: inline-flex;

        align-items: center;
        gap: 7px;

        margin-bottom: 13px;

        color: #34794a;

        font-size: 12px;
        font-weight: 800;

        text-transform: uppercase;
        letter-spacing: .8px;
    }


    .contact-eyebrow i {
        font-size: 11px;
    }


    .contact-hero h1 {
        margin: 0 0 12px;

        color: #15221a;

        font-size: clamp(30px, 6vw, 48px);
        line-height: 1.08;

        font-weight: 850;

        letter-spacing: -.8px;
    }


    .contact-hero p {
        max-width: 680px;

        margin: 0;

        color: #5f6c64;

        font-size: 15px;
        line-height: 1.75;
    }


    /* ======================================================
       COMPANY INTRO
       ====================================================== */

    .company-card {
        background: #ffffff;

        border: 1px solid #e3e9e5;
        border-radius: 20px;

        padding: 27px 28px;

        margin-bottom: 22px;

        box-shadow:
            0 7px 24px rgba(20, 50, 30, .045);
    }


    .company-card-header {
        display: flex;

        align-items: center;
        gap: 14px;

        margin-bottom: 17px;
    }


    .company-mark {
        width: 48px;
        height: 48px;

        flex: 0 0 48px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 14px;

        background: #edf7ef;

        color: #24713e;

        font-size: 20px;
    }


    .company-card h2 {
        margin: 0 0 4px;

        color: #1b2921;

        font-size: 22px;
        line-height: 1.2;
        font-weight: 800;
    }


    .company-tagline {
        margin: 0;

        color: #477052;

        font-size: 13px;
        font-weight: 650;
    }


    .company-description {
        margin: 0;

        padding-top: 18px;

        border-top: 1px solid #edf1ee;

        color: #5e6962;

        font-size: 14px;
        line-height: 1.8;
    }


    /* ======================================================
       CONTACT SECTION
       ====================================================== */

    .contact-section-title {
        margin: 0 0 14px 2px;

        color: #1b2921;

        font-size: 20px;
        font-weight: 800;
    }


    .contact-grid {
        display: grid;

        grid-template-columns:
            repeat(2, minmax(0, 1fr));

        gap: 16px;

        margin-bottom: 22px;
    }


    /* ======================================================
       CONTACT CARD
       ====================================================== */

    .contact-card {
        background: #ffffff;

        border: 1px solid #e3e9e5;
        border-radius: 18px;

        padding: 21px;

        box-shadow:
            0 6px 20px rgba(20, 50, 30, .04);

        transition:
            transform .18s ease,
            box-shadow .18s ease,
            border-color .18s ease;
    }


    .contact-card:hover {
        transform: translateY(-2px);

        border-color: #cbdccd;

        box-shadow:
            0 10px 25px rgba(20, 50, 30, .07);
    }


    .contact-card-top {
        display: flex;

        align-items: flex-start;

        gap: 14px;
    }


    .contact-icon {
        width: 46px;
        height: 46px;

        flex: 0 0 46px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 13px;

        background: #f0f7f1;

        color: #24713e;

        font-size: 18px;
    }


    .contact-card h3 {
        margin: 2px 0 4px;

        color: #253229;

        font-size: 14px;
        font-weight: 800;
    }


    .contact-value {
        margin: 0;

        color: #69746d;

        font-size: 13px;
        line-height: 1.5;
    }


    /* ======================================================
       PHONE / EMAIL LINK
       ====================================================== */

    .contact-main-link {
        display: inline-block;

        margin-top: 7px;

        color: #196437;

        font-size: 16px;
        font-weight: 800;

        text-decoration: none;

        word-break: break-word;
    }


    .contact-main-link:hover {
        text-decoration: underline;
    }


    /* ======================================================
       PHONE ACTIONS
       ====================================================== */

    .contact-actions {
        display: flex;

        flex-wrap: wrap;

        gap: 8px;

        margin-top: 15px;
    }


    .contact-action {
        display: inline-flex;

        align-items: center;
        justify-content: center;

        gap: 7px;

        min-height: 35px;

        padding: 7px 12px;

        box-sizing: border-box;

        border-radius: 9px;

        background: #f4f7f5;

        border: 1px solid #e1e8e3;

        color: #31513c;

        font-size: 12px;
        font-weight: 750;

        text-decoration: none;

        transition:
            background .18s ease,
            border-color .18s ease,
            transform .18s ease;
    }


    .contact-action:hover {
        background: #edf5ef;

        border-color: #cbdccd;

        transform: translateY(-1px);
    }


    .contact-action i {
        font-size: 12px;
    }


    /* ======================================================
       EMAIL CARD
       ====================================================== */

    .email-card .contact-icon {
        background: #fff5e8;
        color: #bd721e;
    }


    .email-card .contact-main-link {
        color: #a86216;
    }


    /* ======================================================
       LOCATION CARD
       ====================================================== */

    .location-card .contact-icon {
        background: #f1f5fa;
        color: #3e658d;
    }


    /* ======================================================
       BUSINESS CARD
       ====================================================== */

    .business-card .contact-icon {
        background: #f7f2fa;
        color: #76518e;
    }


    /* ======================================================
       BUSINESS AREAS
       ====================================================== */

    .business-section {
        background:
            linear-gradient(
                135deg,
                #f5faf6,
                #ffffff
            );

        border: 1px solid #e0e9e2;
        border-radius: 20px;

        padding: 25px 27px;

        box-shadow:
            0 7px 23px rgba(20, 50, 30, .04);
    }


    .business-section h2 {
        margin: 0 0 7px;

        color: #1b2921;

        font-size: 20px;
        font-weight: 800;
    }


    .business-section > p {
        margin: 0 0 19px;

        color: #69746d;

        font-size: 14px;
        line-height: 1.65;
    }


    .business-list {
        display: grid;

        grid-template-columns:
            repeat(2, minmax(0, 1fr));

        gap: 10px;

        margin: 0;
        padding: 0;

        list-style: none;
    }


    .business-list li {
        display: flex;

        align-items: center;

        gap: 9px;

        min-height: 40px;

        padding: 9px 12px;

        box-sizing: border-box;

        background: #ffffff;

        border: 1px solid #e5ebe6;

        border-radius: 10px;

        color: #4e5e54;

        font-size: 13px;
        font-weight: 600;
    }


    .business-list i {
        color: #3c8b50;

        font-size: 12px;
    }


    /* ======================================================
       MOBILE
       ====================================================== */

    @media (max-width: 720px) {

        .contact-page {
            padding: 20px 14px 45px;
        }


        .contact-hero {
            padding: 28px 21px;

            border-radius: 20px;
        }


        .company-card {
            padding: 22px 20px;

            border-radius: 18px;
        }


        .contact-grid {
            grid-template-columns: 1fr;
        }


        .business-section {
            padding: 22px 20px;

            border-radius: 18px;
        }


        .business-list {
            grid-template-columns: 1fr;
        }

    }


    @media (max-width: 420px) {

        .contact-hero h1 {
            font-size: 31px;
        }


        .contact-actions {
            display: grid;

            grid-template-columns:
                repeat(3, minmax(0, 1fr));
        }


        .contact-action {
            padding-left: 6px;
            padding-right: 6px;

            font-size: 11px;
        }

    }

</style>


