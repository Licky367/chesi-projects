<!-- ==========================================================
     views/contact.ejs
     COREVESTER INVESTMENTS LIMITED
     CONTACT PAGE
     ========================================================== -->

<style>

    /* ======================================================
       CONTACT PAGE
       ====================================================== */

    .contact-page {
        width: 100%;
        max-width: 1050px;
        margin: 0 auto;
        padding: 28px 18px 55px;
        box-sizing: border-box;
    }


    /* ======================================================
       PAGE INTRO
       ====================================================== */

    .contact-intro {
        text-align: center;
        max-width: 720px;
        margin: 0 auto 30px;
    }

    .contact-intro h1 {
        margin: 0 0 10px;
        color: #17231c;
        font-size: clamp(30px, 6vw, 44px);
        line-height: 1.1;
        font-weight: 800;
    }

    .contact-intro p {
        margin: 0;
        color: #68746d;
        font-size: 15px;
        line-height: 1.7;
    }


    /* ======================================================
       COMPANY CARD
       ====================================================== */

    .company-card {
        background: #ffffff;
        border: 1px solid #e1e8e2;
        border-radius: 20px;
        padding: 28px;
        box-shadow: 0 8px 28px rgba(20, 45, 29, .06);
        margin-bottom: 22px;
    }


    .company-brand {
        display: flex;
        align-items: center;
        gap: 18px;
        padding-bottom: 22px;
        border-bottom: 1px solid #edf1ee;
    }


    .company-logo {
        width: 82px;
        height: 82px;
        object-fit: contain;
        flex: 0 0 82px;
    }


    .company-name {
        min-width: 0;
    }

    .company-name h2 {
        margin: 0 0 5px;
        color: #17231c;
        font-size: clamp(21px, 4vw, 28px);
        line-height: 1.2;
    }

    .company-name p {
        margin: 0;
        color: #4c6655;
        font-size: 13px;
        line-height: 1.5;
    }


    /* ======================================================
       ABOUT COMPANY
       ====================================================== */

    .company-description {
        padding-top: 22px;
    }

    .company-description p {
        margin: 0;
        color: #58645d;
        font-size: 15px;
        line-height: 1.8;
    }


    /* ======================================================
       CONTACT DETAILS GRID
       ====================================================== */

    .contact-details {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px;
    }


    .contact-card {
        display: flex;
        align-items: flex-start;
        gap: 15px;
        background: #ffffff;
        border: 1px solid #e1e8e2;
        border-radius: 18px;
        padding: 21px;
        box-shadow: 0 6px 22px rgba(20, 45, 29, .045);
    }


    .contact-icon {
        width: 45px;
        height: 45px;
        flex: 0 0 45px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 13px;
        background: #edf7ef;
        color: #176234;
        font-size: 18px;
    }


    .contact-content {
        min-width: 0;
    }

    .contact-content h3 {
        margin: 0 0 5px;
        color: #25332a;
        font-size: 14px;
        font-weight: 750;
    }

    .contact-content p {
        margin: 0;
        color: #68736c;
        font-size: 14px;
        line-height: 1.55;
    }

    .contact-content a {
        color: #176234;
        text-decoration: none;
        font-size: 14px;
        line-height: 1.55;
        word-break: break-word;
    }

    .contact-content a:hover {
        text-decoration: underline;
    }


    /* ======================================================
       SERVICES
       ====================================================== */

    .company-services {
        margin-top: 22px;
        background: #f6faf7;
        border: 1px solid #e0ebe2;
        border-radius: 18px;
        padding: 23px;
    }

    .company-services h2 {
        margin: 0 0 14px;
        color: #1c2c22;
        font-size: 20px;
    }

    .services-list {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px 20px;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .services-list li {
        display: flex;
        align-items: flex-start;
        gap: 9px;
        color: #5f6d64;
        font-size: 14px;
        line-height: 1.5;
    }

    .services-list i {
        color: #3a8a50;
        margin-top: 3px;
    }


    /* ======================================================
       MOBILE
       ====================================================== */

    @media (max-width: 700px) {

        .contact-page {
            padding: 22px 14px 45px;
        }

        .company-card {
            padding: 21px;
            border-radius: 17px;
        }

        .company-brand {
            align-items: center;
        }

        .company-logo {
            width: 68px;
            height: 68px;
            flex-basis: 68px;
        }

        .contact-details {
            grid-template-columns: 1fr;
        }

        .services-list {
            grid-template-columns: 1fr;
        }

    }


    @media (max-width: 430px) {

        .company-brand {
            gap: 13px;
        }

        .company-logo {
            width: 60px;
            height: 60px;
            flex-basis: 60px;
        }

        .company-name h2 {
            font-size: 20px;
        }

    }

</style>


<main class="contact-page">


    <!-- ==================================================
         INTRO
         ================================================== -->

    <section class="contact-intro">

        <h1>Contact Us</h1>

        <p>
            Get in touch with CoreVester Investments Limited.
            We are here to assist you with our products,
            services and business enquiries.
        </p>

    </section>


    <!-- ==================================================
         COMPANY INFORMATION
         ================================================== -->

    <section class="company-card">


        <div class="company-brand">

            <img
                src="/images/corevester.png"
                alt="CoreVester Investments Limited"
                class="company-logo"
            >

            <div class="company-name">

                <h2>
                    CoreVester Investments Limited
                </h2>

                <p>
                    Medical Equipment, Surgical and Hospital Supplies
                </p>

            </div>

        </div>


        <div class="company-description">

            <p>
                CoreVester Investments Limited is a Kenyan company
                dealing in medical equipment, surgical supplies and
                hospital supplies. We provide products intended to
                support healthcare facilities, professionals and
                other customers with their medical supply needs.
            </p>

        </div>

    </section>


    <!-- ==================================================
         CONTACT DETAILS
         ================================================== -->

    <section class="contact-details">


        <!-- LOCATION -->

        <article class="contact-card">

            <div class="contact-icon">
                <i class="fas fa-location-dot"></i>
            </div>

            <div class="contact-content">

                <h3>Our Location</h3>

                <p>
                    Kitengela, Kenya
                </p>

            </div>

        </article>


        <!-- PHONE -->

        <article class="contact-card">

            <div class="contact-icon">
                <i class="fas fa-phone"></i>
            </div>

            <div class="contact-content">

                <h3>Phone</h3>

                <p>
                    Contact us by phone for enquiries
                    and assistance.
                </p>

                <!--
                    Add the verified company number here.

                    Example:

                    <a href="tel:+254XXXXXXXXX">
                        +254 XXX XXX XXX
                    </a>
                -->

            </div>

        </article>


        <!-- EMAIL -->

        <article class="contact-card">

            <div class="contact-icon">
                <i class="fas fa-envelope"></i>
            </div>

            <div class="contact-content">

                <h3>Email</h3>

                <p>
                    Send us an email for business
                    and product enquiries.
                </p>

                <!--
                    Add the verified company email here.

                    Example:

                    <a href="mailto:info@example.com">
                        info@example.com
                    </a>
                -->

            </div>

        </article>


        <!-- BUSINESS -->

        <article class="contact-card">

            <div class="contact-icon">
                <i class="fas fa-building"></i>
            </div>

            <div class="contact-content">

                <h3>Business</h3>

                <p>
                    Medical equipment, surgical and
                    hospital supplies.
                </p>

            </div>

        </article>

    </section>


    <!-- ==================================================
         WHAT WE PROVIDE
         ================================================== -->

    <section class="company-services">

        <h2>
            What We Do
        </h2>

        <ul class="services-list">

            <li>
                <i class="fas fa-circle-check"></i>
                <span>Medical equipment</span>
            </li>

            <li>
                <i class="fas fa-circle-check"></i>
                <span>Surgical supplies</span>
            </li>

            <li>
                <i class="fas fa-circle-check"></i>
                <span>Hospital supplies</span>
            </li>

            <li>
                <i class="fas fa-circle-check"></i>
                <span>Healthcare product enquiries</span>
            </li>

        </ul>

    </section>


</main>