<div class="financial-card revenue-card">

  <!-- Soft green visual accent -->
  <div class="financial-card-glow"></div>

  <div class="financial-section-header">

    <div class="financial-section-icon">
      <span>+</span>
    </div>

    <div class="financial-section-title">

      <span class="financial-eyebrow">
        REVENUE
      </span>

      <h2>
        Record Revenue
      </h2>

      <p>
        Add revenue generated by
        <strong><%= dairy.name %></strong>.
      </p>

    </div>

  </div>

  <div class="financial-welcome-divider"></div>


  <form
    action="/financials/revenue"
    method="POST"
    class="financial-form"
  >

    <input
      type="hidden"
      name="dairy"
      value="<%= dairy._id %>"
    >


    <!-- REVENUE AMOUNT -->
    <div class="form-group">

      <label for="revenueAmount">
        Revenue Amount
      </label>

      <div class="financial-input-wrapper">

        <span class="financial-input-prefix">
          KSh
        </span>

        <input
          type="number"
          id="revenueAmount"
          name="amount"
          placeholder="0.00"
          min="0"
          step="0.01"
          required
        >

      </div>

    </div>


    <!-- REVENUE DESCRIPTION -->
    <div class="form-group">

      <label for="revenueDescription">
        Description
      </label>

      <textarea
        id="revenueDescription"
        name="description"
        placeholder="Describe what generated this revenue..."
        rows="4"
        required
      ></textarea>

      <small class="financial-field-hint">
        Briefly explain the source of this revenue.
      </small>

    </div>


    <!-- DATE -->
    <div class="form-group">

      <label for="revenueDate">
        Revenue Date
      </label>

      <input
        type="date"
        id="revenueDate"
        name="date"
        required
      >

    </div>


    <!-- SUBMIT -->
    <button
      type="submit"
      class="financial-btn revenue-btn"
    >
      <span class="financial-btn-icon">✓</span>
      <span>Record Revenue</span>
    </button>

  </form>

</div>