<div class="financial-card revenue-card">

  <div class="financial-card-glow"></div>


  <!-- HEADER -->
  <div class="financial-section-header">

    <div
      class="financial-section-icon revenue-icon"
      aria-hidden="true"
    >
      <span>+</span>
    </div>

    <div class="financial-section-title">

      <span class="financial-eyebrow">
        REVENUE
      </span>

      <h2>
        Record Revenue
      </h2>

      <p>
        Add income generated by
        <strong><%= dairy.name %></strong>.
      </p>

    </div>

  </div>


  <div class="financial-welcome-divider"></div>


  <!-- FORM -->
  <form
    action="/financials/revenue"
    method="POST"
    class="financial-form"
  >

    <input
      type="hidden"
      name="dairy"
      value="<%= dairy._id %>"
    >


    <!-- AMOUNT -->
    <div class="form-group">

      <label for="revenueAmount">
        Revenue Amount
      </label>

      <div class="financial-input-wrapper">

        <span
          class="financial-input-prefix"
          aria-hidden="true"
        >
          KSh
        </span>

        <input
          type="number"
          id="revenueAmount"
          name="amount"
          placeholder="0.00"
          min="0"
          step="0.01"
          inputmode="decimal"
          autocomplete="off"
          required
        >

      </div>

      <small class="financial-field-hint">
        Enter the amount received or generated.
      </small>

    </div>


    <!-- DESCRIPTION -->
    <div class="form-group">

      <label for="revenueDescription">
        Description
      </label>

      <textarea
        id="revenueDescription"
        name="description"
        placeholder="e.g. Milk sales, animal sale, manure sales..."
        rows="4"
        required
      ></textarea>

      <small class="financial-field-hint">
        Briefly explain the source of this revenue.
      </small>

    </div>


    <!-- DATE -->
    <div class="form-group">

      <label for="revenueDate">
        Revenue Date
      </label>

      <input
        type="date"
        id="revenueDate"
        name="date"
        required
      >

      <small class="financial-field-hint">
        Select the date the revenue was generated.
      </small>

    </div>


    <!-- ACTION -->
    <div class="financial-form-action">

      <button
        type="submit"
        class="financial-btn revenue-btn"
      >

        <span
          class="financial-btn-icon"
          aria-hidden="true"
        >
          ✓
        </span>

        <span>
          Record Revenue
        </span>

      </button>

    </div>

  </form>

</div>