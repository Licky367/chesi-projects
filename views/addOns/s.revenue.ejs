<div class="financial-card revenue-card">

  <div class="card-header">

    <div>
      <h2>Record Revenue</h2>

      <p>
        Record revenue generated by
        <%= dairy.name %>.
      </p>
    </div>

  </div>


  <form
    action="/financials/revenue"
    method="POST"
    class="financial-form"
  >

    <input
      type="hidden"
      name="dairy"
      value="<%= dairy._id %>"
    >


    <!-- REVENUE AMOUNT -->
    <div class="form-group">

      <label for="revenueAmount">
        Revenue Amount
      </label>

      <input
        type="number"
        id="revenueAmount"
        name="amount"
        placeholder="Enter revenue amount"
        min="0"
        step="0.01"
        required
      >

    </div>


    <!-- REVENUE DESCRIPTION -->
    <div class="form-group">

      <label for="revenueDescription">
        Description
      </label>

      <textarea
        id="revenueDescription"
        name="description"
        placeholder="What generated this revenue?"
        rows="4"
        required
      ></textarea>

    </div>


    <!-- DATE -->
    <div class="form-group">

      <label for="revenueDate">
        Date
      </label>

      <input
        type="date"
        id="revenueDate"
        name="date"
        required
      >

    </div>


    <button
      type="submit"
      class="financial-btn revenue-btn"
    >
      Record Revenue
    </button>

  </form>

</div>