<div class="financial-card liability-card">

  <!-- Soft green visual accent -->
  <div class="financial-card-glow"></div>

  <div class="financial-section-header">

    <div class="financial-section-icon liability-icon">
      <span>−</span>
    </div>

    <div class="financial-section-title">

      <span class="financial-eyebrow">
        LIABILITIES
      </span>

      <h2>
        Record Liability
      </h2>

      <p>
        Add an amount owed or financial obligation
        associated with <strong><%= dairy.name %></strong>.
      </p>

    </div>

  </div>

  <div class="financial-welcome-divider"></div>


  <form
    action="/financials/liability"
    method="POST"
    class="financial-form"
  >

    <input
      type="hidden"
      name="dairy"
      value="<%= dairy._id %>"
    >


    <!-- LIABILITY AMOUNT -->
    <div class="form-group">

      <label for="liabilityAmount">
        Liability Amount
      </label>

      <div class="financial-input-wrapper">

        <span class="financial-input-prefix">
          KSh
        </span>

        <input
          type="number"
          id="liabilityAmount"
          name="amount"
          placeholder="0.00"
          min="0"
          step="0.01"
          required
        >

      </div>

    </div>


    <!-- LIABILITY DESCRIPTION -->
    <div class="form-group">

      <label for="liabilityDescription">
        Description
      </label>

      <textarea
        id="liabilityDescription"
        name="description"
        placeholder="Describe the liability or financial obligation..."
        rows="4"
        required
      ></textarea>

      <small class="financial-field-hint">
        Briefly explain what this amount is owed for.
      </small>

    </div>


    <!-- DATE -->
    <div class="form-group">

      <label for="liabilityDate">
        Liability Date
      </label>

      <input
        type="date"
        id="liabilityDate"
        name="date"
        required
      >

    </div>


    <!-- SUBMIT -->
    <button
      type="submit"
      class="financial-btn liability-btn"
    >
      <span class="financial-btn-icon">✓</span>
      <span>Record Liability</span>
    </button>

  </form>

</div>