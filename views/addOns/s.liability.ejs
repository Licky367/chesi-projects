<div class="financial-card liability-card">

  <div class="card-header">

    <div>
      <h2>Record Liability</h2>

      <p>
        Record an amount owed or financial obligation
        for <%= dairy.name %>.
      </p>
    </div>

  </div>


  <form
    action="/financials/liability"
    method="POST"
    class="financial-form"
  >

    <input
      type="hidden"
      name="dairy"
      value="<%= dairy._id %>"
    >


    <!-- LIABILITY AMOUNT -->
    <div class="form-group">

      <label for="liabilityAmount">
        Liability Amount
      </label>

      <input
        type="number"
        id="liabilityAmount"
        name="amount"
        placeholder="Enter liability amount"
        min="0"
        step="0.01"
        required
      >

    </div>


    <!-- LIABILITY DESCRIPTION -->
    <div class="form-group">

      <label for="liabilityDescription">
        Description
      </label>

      <textarea
        id="liabilityDescription"
        name="description"
        placeholder="Describe the liability"
        rows="4"
        required
      ></textarea>

    </div>


    <!-- DATE -->
    <div class="form-group">

      <label for="liabilityDate">
        Date
      </label>

      <input
        type="date"
        id="liabilityDate"
        name="date"
        required
      >

    </div>


    <button
      type="submit"
      class="financial-btn liability-btn"
    >
      Record Liability
    </button>

  </form>

</div>