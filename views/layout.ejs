<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>
<%= typeof title !== "undefined" ? title : "Projects" %>
</title>

<style>

/* =========================================================
   GLOBAL
========================================================= */

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial,sans-serif;
}

html,
body{
height:100%;
background:#f4f6f8;
}


/* =========================================================
   HEADER
========================================================= */

.header{

position:fixed;

top:0;
left:0;
right:0;

height:70px;

background:#0b5d1e;

display:flex;
align-items:center;

padding:0 18px;

color:#fff;

z-index:1002;

box-shadow:
0 2px 8px rgba(0,0,0,.15);

}


/* =========================================================
   HEADER LOGO
========================================================= */

.header-logo-link{

display:flex;
align-items:center;
justify-content:flex-start;

width:auto;

height:100%;

text-decoration:none;

flex-shrink:0;

}


.header-logo{

height:138px;

width:auto;

display:block;

object-fit:contain;

position:relative;

top:10px;

}


/* =========================================================
   HEADER TITLE
========================================================= */

.header-title{

flex:1;

min-width:0;

display:flex;

align-items:center;

justify-content:center;

padding:0 18px;

text-align:center;

}


.header-title-text{

display:block;

width:100%;

font-size:18px;

font-weight:700;

letter-spacing:.3px;

color:#fff;

white-space:nowrap;

overflow:hidden;

text-overflow:ellipsis;

}


/* =========================================================
   TOP MENU
========================================================= */

.top-menu{

position:fixed;

top:70px;

left:0;

right:0;

height:50px;

background:#084816;

display:flex;

align-items:center;

justify-content:space-between;

padding:0 15px;

z-index:1001;

box-shadow:
0 2px 8px rgba(0,0,0,.15);

}


/* =========================================================
   DAIRY WORKER TOP NAVIGATION
========================================================= */

.dairy-worker-nav{

display:flex;

align-items:center;

justify-content:flex-start;

gap:8px;

height:100%;

overflow-x:auto;

overflow-y:hidden;

flex:1;

scrollbar-width:none;

}


.dairy-worker-nav::-webkit-scrollbar{

display:none;

}


.dairy-worker-nav a{

display:flex;

flex-direction:column;

align-items:center;

justify-content:center;

gap:2px;

height:46px;

min-width:62px;

padding:2px 8px;

border-radius:7px;

color:#fff;

text-decoration:none;

font-size:11px;

font-weight:500;

white-space:nowrap;

transition:.2s;

}


.dairy-worker-nav a:hover{

background:rgba(255,255,255,.15);

}


.dairy-worker-nav a:active{

background:rgba(255,255,255,.2);

}


/* =========================================================
   NAV ICON
========================================================= */

.nav-icon{

display:block;

font-size:19px;

line-height:19px;

}


.nav-label{

display:block;

font-size:10px;

line-height:12px;

}


/* =========================================================
   MENU BUTTON
========================================================= */

.menu-btn{

width:44px;

height:44px;

border-radius:8px;

background:#fff;

color:#0b5d1e;

display:flex;

align-items:center;

justify-content:center;

cursor:pointer;

font-size:28px;

font-weight:bold;

user-select:none;

flex-shrink:0;

}


/* =========================================================
   PROFILE
========================================================= */

.profile-box{

position:relative;

flex-shrink:0;

height:50px;

display:flex;

align-items:center;

}


.profile-trigger{

height:48px;

min-width:58px;

display:flex;

flex-direction:column;

align-items:center;

justify-content:center;

gap:1px;

cursor:pointer;

}


.profile-icon{

font-size:19px;

line-height:19px;

display:block;

}


.profile-name{

font-size:10px;

line-height:12px;

color:#fff;

max-width:75px;

overflow:hidden;

text-overflow:ellipsis;

white-space:nowrap;

}


/* =========================================================
   PROFILE DROPDOWN
========================================================= */

.dropdown-profile{

position:absolute;

top:52px;

right:0;

width:190px;

background:#fff;

border-radius:10px;

overflow:hidden;

box-shadow:
0 8px 25px rgba(0,0,0,.2);

display:none;

z-index:1100;

}


.profile-box.active
.dropdown-profile{

display:block;

}


.dropdown-profile a{

display:block;

padding:12px 15px;

text-decoration:none;

color:#333;

border-bottom:1px solid #eee;

}


.dropdown-profile a:last-child{

border-bottom:none;

}


.dropdown-profile a:hover{

background:#f2f2f2;

}


/* =========================================================
   SIDEBAR
========================================================= */

.sidebar{

position:fixed;

top:120px;

left:-260px;

width:240px;

height:calc(100vh - 170px);

background:#084816;

overflow-y:auto;

padding:15px;

transition:left .3s ease;

z-index:1002;

}


.sidebar.active{

left:0;

}


.sidebar a{

display:block;

padding:12px;

margin-bottom:6px;

border-radius:6px;

text-decoration:none;

color:#fff;

font-size:15px;

transition:.2s;

}


.sidebar a:hover{

background:rgba(255,255,255,.15);

}


/* =========================================================
   OVERLAY
========================================================= */

.overlay{

position:fixed;

top:120px;

left:0;

width:100%;

height:calc(100vh - 170px);

background:rgba(0,0,0,.45);

display:none;

z-index:1001;

}


.overlay.active{

display:block;

}


/* =========================================================
   MAIN
========================================================= */

.main{

padding:140px 18px 70px;

min-height:100vh;

}


/* =========================================================
   FOOTER
========================================================= */

.footer{

position:fixed;

bottom:0;

left:0;

right:0;

height:50px;

background:#0b5d1e;

color:#fff;

display:flex;

align-items:center;

justify-content:center;

font-size:13px;

z-index:1000;

}


/* =========================================================
   MOBILE
========================================================= */

@media(max-width:600px){

.sidebar{

width:260px;

left:-280px;

}


.header{

padding:0 10px;

}


.header-logo{

height:100px;

top:8px;

}


.header-title{

padding:0 8px;

}


.header-title-text{

font-size:15px;

}


.top-menu{

padding:0 8px;

}


.dairy-worker-nav{

gap:3px;

}


.dairy-worker-nav a{

min-width:57px;

padding:2px 5px;

}


.nav-icon{

font-size:18px;

}


.nav-label{

font-size:9px;

}


.profile-trigger{

min-width:53px;

}


.profile-name{

max-width:60px;

}

}

</style>

</head>


<body>


<%

/* =========================================================
   AUTHENTICATION PAGES
========================================================= */

const authPages=[
    "/login",
    "/signup",
    "/forgot-password",
    "/reset-password"
];


const isAuthPage=
authPages.includes(
    currentPath || req?.path || ""
);


/* =========================================================
   HOME DESTINATION
========================================================= */

let homeLink="/";


if(
    user &&
    user.role==="dairyWorker" &&
    Array.isArray(user.assignedFarm) &&
    user.assignedFarm.length>0
){

    const firstFarm=user.assignedFarm[0];

    homeLink=`/dairy/${firstFarm}`;

}


/* =========================================================
   HEADER TITLE

   dairyWorker:
       Current dairy farm name

   Fallback:
       HOME COMMERCIAL DAIRIES

   Other roles:
       HOME COMMERCIAL DAIRIES
========================================================= */

let headerTitle="HOME COMMERCIAL DAIRIES";


if(
    user &&
    user.role==="dairyWorker" &&
    typeof dairy !== "undefined" &&
    dairy &&
    dairy.name
){

    headerTitle=dairy.name;

}

%>


<% if(!isAuthPage){ %>


<!-- =========================================================
     HEADER
========================================================= -->

<div class="header">


    <!-- =====================================================
         LOGO
    ====================================================== -->

    <a
        href="<%= user && user.role==="dairyWorker"
            ? homeLink
            : "/" %>"
        class="header-logo-link"
        aria-label="Home"
    >

        <img
            src="/images/cfp-logo.png"
            alt="CFP Logo"
            class="header-logo"
        >

    </a>


    <!-- =====================================================
         HEADER TITLE
    ====================================================== -->

    <div class="header-title">

        <span class="header-title-text">
            <%= headerTitle %>
        </span>

    </div>


</div>


<!-- =========================================================
     TOP MENU
========================================================= -->

<div class="top-menu">


<% if(user && user.role==="dairyWorker"){ %>


    <!-- =====================================================
         DAIRY WORKER NAVIGATION
    ====================================================== -->

    <div class="dairy-worker-nav">


        <!-- HOME -->

        <a href="<%= homeLink %>">

            <span
                class="nav-icon"
                aria-hidden="true"
            >
                🏠
            </span>

            <span class="nav-label">
                Home
            </span>

        </a>


        <!-- PRODUCTION -->

        <a href="/milk">

            <span
                class="nav-icon"
                aria-hidden="true"
            >
                🥛
            </span>

            <span class="nav-label">
                Production
            </span>

        </a>


        <!-- SALES -->

        <a href="/sales">

            <span
                class="nav-icon"
                aria-hidden="true"
            >
                💰
            </span>

            <span class="nav-label">
                Sales
            </span>

        </a>


    </div>


<% }else{ %>


    <!-- =====================================================
         SIDEBAR MENU BUTTON
    ====================================================== -->

    <div
        class="menu-btn"
        onclick="openSidebar()"
        role="button"
        tabindex="0"
        aria-label="Open menu"
    >

        ☰

    </div>


<% } %>


<!-- =========================================================
     PROFILE
========================================================= -->

<div
    class="profile-box"
    id="profileBox"
>


    <div
        class="profile-trigger"
        onclick="toggleProfile(event)"
        role="button"
        tabindex="0"
        aria-label="Open profile menu"
    >

        <span
            class="profile-icon"
            aria-hidden="true"
        >
            👤
        </span>

        <span class="profile-name">
            Profile
        </span>

    </div>


    <div class="dropdown-profile">


        <% if(user){ %>


            <a href="/profile">
                👤 My Account
            </a>


            <% if(user.role==="admin"){ %>

                <a href="/accounts">
                    👥 People
                </a>

            <% } %>


            <a href="/logout">
                🚪 Logout
            </a>


        <% } %>


    </div>


</div>


</div>


<!-- =========================================================
     SIDEBAR

     Dairy workers DO NOT receive the sidebar.
========================================================= -->

<% if(!user || user.role!=="dairyWorker"){ %>


<div
    class="sidebar"
    id="sidebar"
>


    <% if(user && user.role==="admin"){ %>


        <a href="/">
            🏠 Home
        </a>


        <a href="/create-invite">
            👥 Add Staff
        </a>


        <a href="/dashboard/dairy">
            🐄 Dairy Dashboard
        </a>


        <a href="/dashboard/poultry">
            🐔 Poultry Dashboard
        </a>


        <a href="/dashboard/agriculture">
            🌾 Agriculture Dashboard
        </a>


    <% }else if(user && user.role==="poultryWorker"){ %>


        <a href="/">
            🏠 Home
        </a>


        <a href="/incubation">
            🥚 Incubate Eggs
        </a>


        <a href="/nursing">
            🐣 Poultry Progress
        </a>


        <a href="/cage">
            🐔 Caged Chicken
        </a>


        <a href="/poultry-stats">
            📊 Track Production
        </a>


        <a href="/eggs">
            🥚 Sell Eggs
        </a>


    <% } %>


</div>


<div
    class="overlay"
    id="overlay"
></div>


<% } %>


<% } %>


<!-- =========================================================
     MAIN
========================================================= -->

<div class="main">

    <%- body %>

</div>


<% if(!isAuthPage){ %>


<!-- =========================================================
     FOOTER
========================================================= -->

<div class="footer">

    © <%= new Date().getFullYear() %> Dr. Chessy Edwin

</div>


<script>

/* =========================================================
   ELEMENTS
========================================================= */

const sidebar =
    document.getElementById("sidebar");


const overlay =
    document.getElementById("overlay");


const profileBox =
    document.getElementById("profileBox");


/* =========================================================
   SIDEBAR
========================================================= */

function openSidebar(){

    if(!sidebar || !overlay){

        return;

    }

    sidebar.classList.add("active");

    overlay.classList.add("active");

}


function closeSidebar(){

    if(!sidebar || !overlay){

        return;

    }

    sidebar.classList.remove("active");

    overlay.classList.remove("active");

}


/* =========================================================
   PROFILE
========================================================= */

function toggleProfile(event){

    event.stopPropagation();

    if(profileBox){

        profileBox.classList.toggle("active");

    }

}


/* =========================================================
   OVERLAY
========================================================= */

if(overlay){

    overlay.addEventListener(
        "click",
        closeSidebar
    );

}


/* =========================================================
   SIDEBAR LINKS
========================================================= */

if(sidebar){

    sidebar
        .querySelectorAll("a")
        .forEach(link=>{

            link.addEventListener(
                "click",
                function(){

                    closeSidebar();

                }
            );

        });

}


/* =========================================================
   CLOSE PROFILE WHEN CLICKING OUTSIDE
========================================================= */

document.addEventListener(
    "click",
    function(event){

        if(
            profileBox &&
            !profileBox.contains(event.target)
        ){

            profileBox.classList.remove(
                "active"
            );

        }

    }
);


/* =========================================================
   ESCAPE KEY
========================================================= */

document.addEventListener(
    "keydown",
    function(event){

        if(event.key==="Escape"){

            closeSidebar();

            if(profileBox){

                profileBox.classList.remove(
                    "active"
                );

            }

        }

    }
);


/* =========================================================
   RESIZE
========================================================= */

window.addEventListener(
    "resize",
    function(){

        if(window.innerWidth>768){

            closeSidebar();

        }

    }
);

</script>


<% } %>


</body>
</html>