<!-- =========================================================
   FOOTER
   ---------------------------------------------------------
   IMPORTANT:
   Footer is rendered for BOTH auth and normal pages.
========================================================= -->

<div class="footer">

    © <%= new Date().getFullYear() %>
    Dr. Chessy Edwin

</div>


<% if(!isAuthPage){ %>


<script>

/* =========================================================
   PROFILE
========================================================= */

const profileBox =
    document.getElementById(
        "profileBox"
    );


function toggleProfile(event){

    event.stopPropagation();

    if(profileBox){

        profileBox.classList.toggle(
            "active"
        );

    }

}


/* =========================================================
   POULTRY SIDEBAR
========================================================= */

const poultrySidebar =
    document.getElementById(
        "sidebar"
    );

const poultryOverlay =
    document.getElementById(
        "overlay"
    );


function openSidebar(){

    if(
        !poultrySidebar ||
        !poultryOverlay
    ){

        return;

    }

    poultrySidebar.classList.add(
        "active"
    );

    poultryOverlay.classList.add(
        "active"
    );

}


function closeSidebar(){

    if(
        !poultrySidebar ||
        !poultryOverlay
    ){

        return;

    }

    poultrySidebar.classList.remove(
        "active"
    );

    poultryOverlay.classList.remove(
        "active"
    );

}


if(poultryOverlay){

    poultryOverlay.addEventListener(
        "click",
        closeSidebar
    );

}


if(poultrySidebar){

    poultrySidebar
        .querySelectorAll("a")
        .forEach(
            function(link){

                link.addEventListener(
                    "click",
                    closeSidebar
                );

            }
        );

}


/* =========================================================
   ADMIN SIDEBAR
========================================================= */

const adminSidebar =
    document.getElementById(
        "adminDashboardSidebar"
    );


const adminTopMenuButton =
    document.getElementById(
        "adminTopMenuButton"
    );


const adminSidebarMenuButton =
    document.getElementById(
        "adminSidebarMenuButton"
    );


const adminSidebarOverlay =
    document.getElementById(
        "adminSidebarOverlay"
    );


const dairyActivitiesButton =
    document.getElementById(
        "dairyActivitiesButton"
    );


const dairyActivitiesSubmenu =
    document.getElementById(
        "dairyActivitiesSubmenu"
    );


/* =========================================================
   OPEN ADMIN SIDEBAR
========================================================= */

function openAdminSidebar(){

    if(
        !adminSidebar ||
        !adminSidebarOverlay
    ){

        return;

    }


    adminSidebar.classList.add(
        "open"
    );


    adminSidebarOverlay.classList.add(
        "active"
    );


    adminSidebar.setAttribute(
        "aria-expanded",
        "true"
    );


    if(adminTopMenuButton){

        adminTopMenuButton.setAttribute(
            "aria-expanded",
            "true"
        );

    }


    adminSidebarOverlay.setAttribute(
        "aria-hidden",
        "false"
    );

}


/* =========================================================
   CLOSE DAIRY ACTIVITIES
========================================================= */

function closeDairyActivities(){

    if(
        !dairyActivitiesButton ||
        !dairyActivitiesSubmenu
    ){

        return;

    }


    dairyActivitiesButton.setAttribute(
        "aria-expanded",
        "false"
    );


    dairyActivitiesButton.classList.remove(
        "expanded"
    );


    dairyActivitiesSubmenu.classList.remove(
        "open"
    );

}


/* =========================================================
   CLOSE ADMIN SIDEBAR
========================================================= */

function closeAdminSidebar(){

    if(
        !adminSidebar ||
        !adminSidebarOverlay
    ){

        return;

    }


    adminSidebar.classList.remove(
        "open"
    );


    adminSidebarOverlay.classList.remove(
        "active"
    );


    adminSidebar.setAttribute(
        "aria-expanded",
        "false"
    );


    if(adminTopMenuButton){

        adminTopMenuButton.setAttribute(
            "aria-expanded",
            "false"
        );

    }


    adminSidebarOverlay.setAttribute(
        "aria-hidden",
        "true"
    );


    closeDairyActivities();

}


/* =========================================================
   ADMIN TOP MENU BUTTON
========================================================= */

if(adminTopMenuButton){

    adminTopMenuButton.addEventListener(
        "click",
        function(event){

            event.preventDefault();

            event.stopPropagation();


            if(
                adminSidebar &&
                adminSidebar.classList.contains(
                    "open"
                )
            ){

                closeAdminSidebar();

            }

            else{

                openAdminSidebar();

            }

        }
    );

}


/* =========================================================
   ADMIN SIDEBAR MENU BUTTON
========================================================= */

if(adminSidebarMenuButton){

    adminSidebarMenuButton.addEventListener(
        "click",
        function(event){

            event.preventDefault();

            event.stopPropagation();

            closeAdminSidebar();

        }
    );

}


/* =========================================================
   DAIRY ACTIVITIES
========================================================= */

if(
    dairyActivitiesButton &&
    dairyActivitiesSubmenu
){

    dairyActivitiesButton.addEventListener(
        "click",
        function(event){

            event.preventDefault();

            event.stopPropagation();


            const isExpanded =
                dairyActivitiesButton.getAttribute(
                    "aria-expanded"
                ) === "true";


            dairyActivitiesButton.setAttribute(
                "aria-expanded",
                String(!isExpanded)
            );


            dairyActivitiesButton.classList.toggle(
                "expanded",
                !isExpanded
            );


            dairyActivitiesSubmenu.classList.toggle(
                "open",
                !isExpanded
            );

        }
    );

}


/* =========================================================
   ADMIN SIDEBAR LINKS
========================================================= */

if(adminSidebar){

    adminSidebar
        .querySelectorAll(
            ".admin-sidebar-link"
        )
        .forEach(
            function(link){

                link.addEventListener(
                    "click",
                    function(){

                        closeAdminSidebar();

                    }
                );

            }
        );

}


/* =========================================================
   ADMIN OVERLAY
========================================================= */

if(adminSidebarOverlay){

    adminSidebarOverlay.addEventListener(
        "click",
        function(){

            closeAdminSidebar();

        }
    );

}


/* =========================================================
   CLOSE PROFILE WHEN CLICKING OUTSIDE
========================================================= */

document.addEventListener(
    "click",
    function(event){

        if(
            profileBox &&
            !profileBox.contains(
                event.target
            )
        ){

            profileBox.classList.remove(
                "active"
            );

        }

    }
);


/* =========================================================
   ESCAPE KEY
========================================================= */

document.addEventListener(
    "keydown",
    function(event){

        if(event.key === "Escape"){

            closeSidebar();

            closeAdminSidebar();


            if(profileBox){

                profileBox.classList.remove(
                    "active"
                );

            }

        }

    }
);


/* =========================================================
   WINDOW RESIZE
========================================================= */

window.addEventListener(
    "resize",
    function(){

        closeAdminSidebar();

        closeSidebar();

    }
);

</script>


<% } %>


</body>

</html>