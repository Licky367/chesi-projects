<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
>

<title>
    <%= typeof title !== "undefined" ? title : "Projects" %>
</title>


<style>

/* =========================================================
   GLOBAL
========================================================= */

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial,sans-serif;
}

html,
body{
    min-height:100%;
    background:#f4f6f8;
}


/* =========================================================
   THEME
========================================================= */

:root{

    --primary:#0b5d1e;

    --primary-dark:#084814;

    --primary-light:#eaf7ee;

    --primary-soft:#f3faf5;

    --text:#263238;

    --muted:#667085;

    --border:#e5e7eb;

    --white:#ffffff;

    --sidebar-width:275px;

    --layout-top:120px;

}


/* =========================================================
   HEADER
========================================================= */

.header{
    position:fixed;

    top:0;
    left:0;
    right:0;

    min-height:70px;

    background:#0b5d1e;

    display:flex;

    align-items:center;

    padding:0 18px;

    color:#fff;

    z-index:2000;

    box-shadow:
        0 2px 8px rgba(0,0,0,.15);
}


/* =========================================================
   HEADER LOGO
========================================================= */

.header-logo-link{
    display:flex;

    align-items:center;
    justify-content:flex-start;

    width:auto;

    height:70px;

    text-decoration:none;

    flex-shrink:0;
}

.header-logo{
    height:138px;

    width:auto;

    display:block;

    object-fit:contain;

    position:relative;

    top:10px;
}


/* =========================================================
   HEADER TITLE
========================================================= */

.header-title{
    display:flex;

    align-items:center;
    justify-content:flex-start;

    flex:0 1 auto;

    min-width:0;

    padding:0 0 0 8px;

    text-align:left;
}

.header-title-text{
    display:block;

    width:auto;

    font-size:18px;

    font-weight:700;

    letter-spacing:.3px;

    color:#fff;

    white-space:normal;

    line-height:21px;
}


/* =========================================================
   TOP MENU
========================================================= */

.top-menu{

    position:fixed;

    top:70px;

    left:0;

    right:0;

    height:50px;

    background:#084816;

    display:flex;

    align-items:center;

    padding:0 15px;

    z-index:1999;

    box-shadow:
        0 2px 8px rgba(0,0,0,.15);
}


/* =========================================================
   TOP NAVIGATION
========================================================= */

.dairy-worker-nav{

    display:flex;

    align-items:center;

    justify-content:space-evenly;

    width:auto;

    height:100%;

    overflow-x:auto;

    overflow-y:hidden;

    flex:1 1 auto;

    min-width:0;

    scrollbar-width:none;
}

.dairy-worker-nav::-webkit-scrollbar{
    display:none;
}


/* =========================================================
   TOP NAV LINKS
========================================================= */

.dairy-worker-nav a{

    display:flex;

    flex-direction:column;

    align-items:center;

    justify-content:center;

    gap:2px;

    height:46px;

    flex:1 1 0;

    min-width:0;

    padding:2px 8px;

    border-radius:7px;

    color:#fff;

    text-decoration:none;

    font-size:11px;

    font-weight:500;

    white-space:nowrap;

    transition:
        background .2s ease,
        transform .15s ease;
}

.dairy-worker-nav a:hover{
    background:rgba(255,255,255,.15);
}

.dairy-worker-nav a:active{

    background:rgba(255,255,255,.20);

    transform:scale(.97);
}


/* =========================================================
   TOP NAV ICON
========================================================= */

.nav-icon{

    display:block;

    font-size:19px;

    line-height:19px;
}

.nav-label{

    display:block;

    font-size:10px;

    line-height:12px;
}


/* =========================================================
   MENU BUTTON
========================================================= */

.menu-btn{

    width:44px;

    height:44px;

    border-radius:8px;

    background:transparent;

    color:#fff;

    border:0;

    display:flex;

    align-items:center;

    justify-content:center;

    cursor:pointer;

    font-size:28px;

    font-weight:bold;

    user-select:none;

    flex-shrink:0;

    transition:
        background .2s ease,
        transform .15s ease;
}

.menu-btn:hover{

    background:rgba(255,255,255,.12);
}

.menu-btn:active{

    transform:scale(.94);
}


/* =========================================================
   PROFILE
========================================================= */

.profile-box{

    position:relative;

    margin-left:auto;

    flex-shrink:0;

    height:50px;

    display:flex;

    align-items:center;
}

.profile-trigger{

    height:48px;

    min-width:58px;

    display:flex;

    flex-direction:column;

    align-items:center;

    justify-content:center;

    gap:1px;

    cursor:pointer;
}

.profile-icon{

    font-size:19px;

    line-height:19px;

    display:block;
}

.profile-name{

    font-size:10px;

    line-height:12px;

    color:#fff;

    max-width:75px;

    overflow:hidden;

    text-overflow:ellipsis;

    white-space:nowrap;
}


/* =========================================================
   PROFILE DROPDOWN
========================================================= */

.dropdown-profile{

    position:absolute;

    top:52px;

    right:0;

    width:190px;

    background:#fff;

    border-radius:10px;

    overflow:hidden;

    box-shadow:
        0 8px 25px rgba(0,0,0,.20);

    display:none;

    z-index:2500;
}

.profile-box.active .dropdown-profile{
    display:block;
}

.dropdown-profile a{

    display:block;

    padding:12px 15px;

    text-decoration:none;

    color:#333;

    border-bottom:1px solid #eee;
}

.dropdown-profile a:last-child{
    border-bottom:none;
}

.dropdown-profile a:hover{
    background:#f2f2f2;
}


/* =========================================================
   ADMIN SIDEBAR
========================================================= */

.admin-dashboard-sidebar{

    position:fixed;

    top:var(--layout-top);

    left:calc(-1 * var(--sidebar-width));

    bottom:50px;

    width:var(--sidebar-width);

    background:var(--white);

    z-index:2100;

    overflow-x:hidden;

    overflow-y:auto;

    box-shadow:
        5px 0 22px rgba(0,0,0,.16);

    border-right:
        1px solid var(--border);

    transition:
        left .28s ease;
}


.admin-dashboard-sidebar.open{

    left:0;

}


/* =========================================================
   ADMIN SIDEBAR MENU
========================================================= */

.admin-sidebar-menu{

    list-style:none;

    width:100%;

    margin:0;

    padding:0;
}


.admin-sidebar-item{

    width:100%;

    margin:0;

    padding:0;
}


.admin-sidebar-menu-button{

    width:100%;

    height:58px;

    display:flex;

    align-items:center;

    gap:15px;

    padding:0 15px;

    box-sizing:border-box;

    border:0;

    border-bottom:
        1px solid var(--border);

    background:
        var(--primary-soft);

    color:var(--primary);

    cursor:pointer;

    font:inherit;

    text-align:left;

    white-space:nowrap;

    transition:
        background .2s ease;
}

.admin-sidebar-menu-button:hover{

    background:var(--primary-light);
}


.admin-sidebar-menu-icon{

    width:34px;

    min-width:34px;

    height:34px;

    display:flex;

    align-items:center;

    justify-content:center;

    font-size:25px;

    line-height:1;

    border-radius:8px;

    color:var(--primary);

    pointer-events:none;
}


.admin-sidebar-link{

    width:100%;

    min-height:58px;

    box-sizing:border-box;

    display:flex;

    align-items:center;

    gap:15px;

    padding:0 15px;

    color:var(--text);

    text-decoration:none;

    white-space:nowrap;

    border-bottom:
        1px solid var(--border);

    transition:
        background .2s ease,
        color .2s ease;
}

.admin-sidebar-link:hover{

    background:var(--primary-soft);

    color:var(--primary);
}


.admin-sidebar-link.active{

    background:var(--primary-light);

    color:var(--primary);

    font-weight:600;
}

.admin-sidebar-link.active
.admin-sidebar-icon{

    color:var(--primary);
}


.admin-sidebar-icon{

    width:34px;

    min-width:34px;

    height:34px;

    display:flex;

    align-items:center;

    justify-content:center;

    font-size:21px;

    line-height:1;

    border-radius:8px;

    color:var(--primary);

    pointer-events:none;
}


.admin-sidebar-label{

    display:block;

    font-size:15px;

    font-weight:600;

    color:inherit;
}


.admin-sidebar-section-button{

    width:100%;

    min-height:58px;

    display:flex;

    align-items:center;

    gap:15px;

    padding:0 15px;

    box-sizing:border-box;

    border:0;

    border-bottom:
        1px solid var(--border);

    background:transparent;

    color:var(--text);

    cursor:pointer;

    font:inherit;

    text-align:left;

    white-space:nowrap;

    transition:
        background .2s ease,
        color .2s ease;
}

.admin-sidebar-section-button:hover{

    background:var(--primary-soft);

    color:var(--primary);
}


.admin-sidebar-section-button.expanded{

    background:var(--primary-light);

    color:var(--primary);
}


.admin-sidebar-section-arrow{

    margin-left:auto;

    font-size:14px;

    line-height:1;

    color:var(--primary);

    opacity:.9;

    transition:
        transform .2s ease;
}

.admin-sidebar-section-button.expanded
.admin-sidebar-section-arrow{

    transform:rotate(90deg);
}


.admin-sidebar-submenu{

    display:none;

    width:100%;

    margin:0;

    padding:0;

    list-style:none;

    background:#f7fbf8;

    border-bottom:
        1px solid var(--border);
}

.admin-sidebar-submenu.open{
    display:block;
}


.admin-sidebar-submenu
.admin-sidebar-link{

    min-height:52px;

    padding-left:28px;

    gap:12px;

    border-bottom:
        1px solid #edf1ee;
}

.admin-sidebar-submenu
.admin-sidebar-link:hover{

    background:var(--primary-light);
}


.admin-sidebar-submenu
.admin-sidebar-icon{

    width:30px;

    min-width:30px;

    height:30px;

    font-size:18px;
}


.admin-sidebar-submenu
.admin-sidebar-label{

    font-size:14px;

    font-weight:600;
}


.admin-sidebar-footer{

    padding:25px 15px 30px;

    color:#7a8a80;

    font-size:12px;

    line-height:1.5;

    border-top:
        1px solid var(--border);
}


/* =========================================================
   ADMIN SIDEBAR OVERLAY
========================================================= */

.admin-sidebar-overlay{

    position:fixed;

    top:var(--layout-top);

    left:0;

    right:0;

    bottom:50px;

    background:rgba(0,0,0,.28);

    z-index:2050;

    opacity:0;

    visibility:hidden;

    cursor:pointer;

    transition:
        opacity .2s ease,
        visibility .2s ease;
}

.admin-sidebar-overlay.active{

    opacity:1;

    visibility:visible;
}


/* =========================================================
   POULTRY SIDEBAR
========================================================= */

.sidebar{

    position:fixed;

    top:120px;

    left:-260px;

    width:240px;

    height:calc(100vh - 170px);

    background:#084816;

    overflow-y:auto;

    padding:15px;

    transition:left .3s ease;

    z-index:2100;
}

.sidebar.active{
    left:0;
}

.sidebar a{

    display:block;

    padding:12px;

    margin-bottom:6px;

    border-radius:6px;

    text-decoration:none;

    color:#fff;

    font-size:15px;

    transition:.2s;
}

.sidebar a:hover{

    background:rgba(255,255,255,.15);
}


/* =========================================================
   POULTRY OVERLAY
========================================================= */

.overlay{

    position:fixed;

    top:120px;

    left:0;

    width:100%;

    height:calc(100vh - 170px);

    background:rgba(0,0,0,.45);

    display:none;

    z-index:2050;
}

.overlay.active{
    display:block;
}


/* =========================================================
   MAIN — NORMAL PAGES
========================================================= */

.main{

    padding:140px 18px 70px;

    min-height:100vh;
}


/* =========================================================
   MAIN — AUTH PAGES
   ---------------------------------------------------------
   IMPORTANT:
   Auth pages do NOT receive the 140px top padding.
   
   They still receive bottom space for the fixed footer.
========================================================= */

.auth-page .main{

    padding:
        0 18px 70px;

    min-height:100vh;
}


/* =========================================================
   FOOTER
   ---------------------------------------------------------
   Footer is shown on BOTH:
       - Normal pages
       - Authentication pages
========================================================= */

.footer{

    position:fixed;

    bottom:0;

    left:0;

    right:0;

    height:50px;

    background:#0b5d1e;

    color:#fff;

    display:flex;

    align-items:center;

    justify-content:center;

    font-size:13px;

    z-index:1000;
}


/* =========================================================
   MOBILE
========================================================= */

@media(max-width:600px){

    .header{

        padding:0 10px;

        min-height:70px;
    }


    .header-logo{

        height:100px;

        top:8px;
    }


    .header-title{

        padding-left:6px;

        flex:1 1 auto;
    }


    .header-title-text{

        font-size:15px;

        line-height:18px;
    }


    .top-menu{

        padding:0 8px;
    }


    .dairy-worker-nav{

        gap:3px;

        flex:1 1 auto;

        min-width:0;
    }


    .dairy-worker-nav a{

        min-width:0;

        padding:2px 5px;
    }


    .nav-icon{
        font-size:18px;
    }


    .nav-label{
        font-size:9px;
    }


    .menu-btn{

        width:42px;

        min-width:42px;

        height:42px;
    }


    .profile-trigger{

        min-width:53px;
    }


    .profile-name{

        max-width:60px;
    }


    .admin-dashboard-sidebar{

        width:270px;

        left:-285px;
    }


    .admin-dashboard-sidebar.open{

        left:0;
    }


    .main{

        padding-left:12px;

        padding-right:12px;
    }


    /* =============================================
       AUTH MOBILE
    ============================================== */

    .auth-page .main{

        padding-left:12px;

        padding-right:12px;

        padding-top:0;

        padding-bottom:70px;
    }

}


/* =========================================================
   VERY SMALL SCREENS
========================================================= */

@media(max-width:380px){

    .header{

        padding:0 6px;
    }


    .header-logo{

        height:88px;
    }


    .header-title{

        padding-left:4px;
    }


    .header-title-text{

        font-size:14px;

        line-height:17px;
    }


    .profile-trigger{

        min-width:48px;
    }


    .profile-name{

        max-width:50px;
    }


    .dairy-worker-nav a{

        padding-left:2px;

        padding-right:2px;
    }


    .admin-dashboard-sidebar{

        width:250px;

        left:-265px;
    }

}

</style>

</head>


<%

/* =========================================================
   AUTHENTICATION PAGES
========================================================= */

const authPages = [
    "/login",
    "/signup",
    "/forgot-password",
    "/reset-password"
];

const currentPagePath =
    currentPath ||
    (typeof req !== "undefined" && req.path) ||
    "";

const isAuthPage =
    authPages.includes(
        currentPagePath
    );

%>


<body class="<%= isAuthPage ? 'auth-page' : 'app-page' %>">


<%

/* =========================================================
   HOME DESTINATION
========================================================= */

let homeLink = "/";


/*
   ADMIN
*/

if(
    user &&
    user.role === "admin"
){

    homeLink =
        "/dashboard/dairy";

}


/*
   DAIRY WORKER
*/

else if(
    user &&
    user.role === "dairyWorker" &&
    Array.isArray(user.assignedFarm) &&
    user.assignedFarm.length > 0
){

    const firstFarm =
        user.assignedFarm[0];

    homeLink =
        `/dairy/${firstFarm}`;

}


/* =========================================================
   HEADER TITLE
========================================================= */

let headerTitle =
    "CHESI PROJECTS";

if(user){

    if(
        user.role === "dairyWorker"
    ){

        headerTitle =
            "DAIRY ACTIVITIES";

    }

    else if(
        user.role === "poultryWorker"
    ){

        headerTitle =
            "POULTRY ACTIVITIES";

    }

    else if(
        user.role === "admin"
    ){

        headerTitle =
            "CHESI PROJECTS";

    }

}


/* =========================================================
   ROLE FLAGS
========================================================= */

const isAdmin =
    !!user &&
    user.role === "admin";

const isDairyWorker =
    !!user &&
    user.role === "dairyWorker";

const isPoultryWorker =
    !!user &&
    user.role === "poultryWorker";

%>


<% if(!isAuthPage){ %>


<!-- =========================================================
   HEADER
========================================================= -->

<div class="header">


    <!-- =====================================================
       LOGO
    ====================================================== -->

    <a
        href="<%= homeLink %>"

        class="header-logo-link"

        aria-label="Home"
    >

        <img
            src="/images/cfp-logo.png"

            alt="CFP Logo"

            class="header-logo"
        >

    </a>


    <!-- =====================================================
       HEADER TITLE
    ====================================================== -->

    <div class="header-title">

        <span class="header-title-text">
            <%= headerTitle %>
        </span>

    </div>


</div>


<!-- =========================================================
   TOP MENU
========================================================= -->

<div class="top-menu">


<% if(isDairyWorker){ %>


    <!-- =====================================================
       DAIRY WORKER TOP NAVIGATION
    ====================================================== -->

    <div class="dairy-worker-nav">


        <a href="<%= homeLink %>">

            <span
                class="nav-icon"
                aria-hidden="true"
            >
                🏠
            </span>

            <span class="nav-label">
                Home
            </span>

        </a>


        <a href="/milk">

            <span
                class="nav-icon"
                aria-hidden="true"
            >
                🥛
            </span>

            <span class="nav-label">
                Production
            </span>

        </a>


        <a href="/sales">

            <span
                class="nav-icon"
                aria-hidden="true"
            >
                💰
            </span>

            <span class="nav-label">
                Sales
            </span>

        </a>


    </div>


<% }else if(isAdmin){ %>


    <!-- =====================================================
       ADMIN TOP NAVIGATION
    ====================================================== -->

    <button
        type="button"

        id="adminTopMenuButton"

        class="menu-btn"

        aria-label="Open admin navigation menu"

        aria-expanded="false"

        title="Menu"
    >

        ☰

    </button>


    <div class="dairy-worker-nav">


        <a href="/milk">

            <span
                class="nav-icon"
                aria-hidden="true"
            >
                🥛
            </span>

            <span class="nav-label">
                Production
            </span>

        </a>


        <a href="/sales">

            <span
                class="nav-icon"
                aria-hidden="true"
            >
                💰
            </span>

            <span class="nav-label">
                Sales
            </span>

        </a>


        <a href="/stats">

            <span
                class="nav-icon"
                aria-hidden="true"
            >
                📊
            </span>

            <span class="nav-label">
                Stats
            </span>

        </a>


    </div>


<% }else{ %>


    <!-- =====================================================
       POULTRY WORKER MENU BUTTON
    ====================================================== -->

    <button
        type="button"

        class="menu-btn"

        onclick="openSidebar()"

        aria-label="Open menu"

        title="Menu"
    >

        ☰

    </button>


<% } %>


<!-- =========================================================
   PROFILE
========================================================= -->

<div
    class="profile-box"
    id="profileBox"
>

    <div
        class="profile-trigger"

        onclick="toggleProfile(event)"

        role="button"

        tabindex="0"

        aria-label="Open profile menu"
    >

        <span
            class="profile-icon"
            aria-hidden="true"
        >
            👤
        </span>

        <span class="profile-name">
            Profile
        </span>

    </div>


    <div class="dropdown-profile">


        <% if(user){ %>


            <a href="/profile">
                👤 My Account
            </a>


            <% if(isAdmin){ %>

                <a href="/accounts">
                    👥 People
                </a>

            <% } %>


            <a href="/logout">
                🚪 Logout
            </a>


        <% } %>


    </div>

</div>


</div>


<!-- =========================================================
   ADMIN SIDEBAR
========================================================= -->

<% if(isAdmin){ %>


<aside
    id="adminDashboardSidebar"

    class="admin-dashboard-sidebar"

    aria-label="Project navigation"

    aria-expanded="false"
>


    <ul class="admin-sidebar-menu">


        <li class="admin-sidebar-item">

            <button
                type="button"

                id="adminSidebarMenuButton"

                class="admin-sidebar-menu-button"

                aria-label="Close navigation menu"

                aria-expanded="true"
            >

                <span
                    class="admin-sidebar-menu-icon"

                    aria-hidden="true"
                >
                    ☰
                </span>

                <span class="admin-sidebar-label">
                    Menu
                </span>

            </button>

        </li>


        <li class="admin-sidebar-item">

            <a
                href="<%= homeLink %>"

                class="admin-sidebar-link active"

                title="Dashboard"
            >

                <span
                    class="admin-sidebar-icon"

                    aria-hidden="true"
                >
                    ⌂
                </span>

                <span class="admin-sidebar-label">
                    Dashboard
                </span>

            </a>

        </li>


        <li class="admin-sidebar-item">

            <button
                type="button"

                id="dairyActivitiesButton"

                class="admin-sidebar-section-button"

                aria-expanded="false"

                aria-controls="dairyActivitiesSubmenu"
            >

                <span
                    class="admin-sidebar-icon"

                    aria-hidden="true"
                >
                    🐄
                </span>

                <span class="admin-sidebar-label">
                    Dairy Activities
                </span>

                <span
                    class="admin-sidebar-section-arrow"

                    aria-hidden="true"
                >
                    ▶
                </span>

            </button>


            <ul
                id="dairyActivitiesSubmenu"

                class="admin-sidebar-submenu"
            >


                <li class="admin-sidebar-item">

                    <a
                        href="/add"

                        class="admin-sidebar-link"

                        title="Add an Asset"
                    >

                        <span
                            class="admin-sidebar-icon"

                            aria-hidden="true"
                        >
                            ＋
                        </span>

                        <span class="admin-sidebar-label">
                            Add an Asset
                        </span>

                    </a>

                </li>


                <li class="admin-sidebar-item">

                    <a
                        href="/milk"

