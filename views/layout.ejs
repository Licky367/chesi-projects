<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title><%= typeof title !== "undefined" ? title : "Projects" %></title>

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial,sans-serif;
}

html,body{
height:100%;
background:#f4f6f8;
}

/* ================= HEADER ================= */

.header{
position:fixed;
top:0;
left:0;
right:0;
height:70px;
background:#0b5d1e;
display:flex;
align-items:center;
justify-content:center;
padding:0 18px;
color:#fff;
z-index:1002;
box-shadow:0 2px 8px rgba(0,0,0,.15);
}

/* ================= TOP MENU ================= */

.top-menu{
position:fixed;
top:70px;
left:0;
right:0;
height:50px;
background:#084816;
display:flex;
align-items:center;
justify-content:space-between;
padding:0 15px;
z-index:1001;
box-shadow:0 2px 8px rgba(0,0,0,.15);
}

/* ================= MENU ================= */

.menu-btn{
width:44px;
height:44px;
border-radius:8px;
background:#fff;
color:#0b5d1e;
display:flex;
align-items:center;
justify-content:center;
cursor:pointer;
font-size:28px;
font-weight:bold;
user-select:none;
}

/* ================= HEADER LOGO ================= */

.header-title{
display:flex;
align-items:center;
justify-content:center;
overflow:visible;
}

.header-logo{
height:138px;
width:auto;
display:block;
object-fit:contain;
position:relative;
top:10px;
}

/* ================= PROFILE ================= */

.profile-box{
position:relative;
}

.profile-trigger{
display:flex;
flex-direction:column;
align-items:center;
cursor:pointer;
}

.profile-avatar{
width:40px;
height:40px;
border-radius:50%;
border:2px solid #fff;
}

.profile-name{
margin-top:3px;
font-size:11px;
color:#fff;
max-width:75px;
overflow:hidden;
text-overflow:ellipsis;
white-space:nowrap;
}

.dropdown-profile{
position:absolute;
top:58px;
right:0;
width:190px;
background:#fff;
border-radius:10px;
overflow:hidden;
box-shadow:0 8px 25px rgba(0,0,0,.2);
display:none;
z-index:1100;
}

.profile-box.active .dropdown-profile{
display:block;
}

.dropdown-profile a{
display:block;
padding:12px 15px;
text-decoration:none;
color:#333;
border-bottom:1px solid #eee;
}

.dropdown-profile a:last-child{
border-bottom:none;
}

.dropdown-profile a:hover{
background:#f2f2f2;
}

/* ================= SIDEBAR ================= */

.sidebar{
position:fixed;
top:120px;
left:-260px;
width:240px;
height:calc(100vh - 170px);
background:#084816;
overflow-y:auto;
padding:15px;
transition:left .3s ease;
z-index:1002;
}

.sidebar.active{
left:0;
}

.sidebar a{
display:block;
padding:12px;
margin-bottom:6px;
border-radius:6px;
text-decoration:none;
color:#fff;
font-size:15px;
transition:.2s;
}

.sidebar a:hover{
background:rgba(255,255,255,.15);
}
/* ================= OVERLAY ================= */

.overlay{
position:fixed;
top:120px;
left:0;
width:100%;
height:calc(100vh - 170px);
background:rgba(0,0,0,.45);
display:none;
z-index:1001;
}

.overlay.active{
display:block;
}

/* ================= MAIN ================= */

.main{
padding:140px 18px 70px;
min-height:100vh;
}

/* ================= FOOTER ================= */

.footer{
position:fixed;
bottom:0;
left:0;
right:0;
height:50px;
background:#0b5d1e;
color:#fff;
display:flex;
align-items:center;
justify-content:center;
font-size:13px;
z-index:1000;
}

@media(max-width:600px){

.sidebar{
width:260px;
left:-280px;
}

.header-logo{
height:100px;
top:8px;
}

.top-menu{
padding:0 10px;
}

}

</style>
</head>

<body>

<%

const authPages=[
"/login",
"/signup",
"/forgot-password",
"/reset-password"
];

const isAuthPage=authPages.includes(currentPath||req?.path||"");

%>

<% if(!isAuthPage){ %>

<!-- ================= HEADER (LOGO ONLY) ================= -->

<div class="header">

<div class="header-title">

<a href="/">

<img
src="/images/cfp-logo.png"
alt="CFP Logo"
class="header-logo">

</a>

</div>

</div>

<!-- ================= TOP MENU ================= -->

<div class="top-menu">

<div class="menu-btn" onclick="openSidebar()">
☰
</div>

<div class="profile-box" id="profileBox">

<div class="profile-trigger" onclick="toggleProfile(event)">
    <div class="profile-name">
        <%= user ? user.name : "Profile" %> ▼
    </div>
</div> 

<div class="dropdown-profile">

<% if(user){ %>

<a href="/profile">👤 My Account</a>

<% if (user.role === "admin") { %>

<a href="/accounts">👥 People</a>

<% } %>

<a href="/logout">🚪 Logout</a>

<% } %>

</div>

</div>

</div>

<!-- ================= SIDEBAR ================= -->

<div class="sidebar" id="sidebar">

<% if(user && user.role==="admin"){ %>

<a href="/">🏠 Home</a>

<a href="/create-invite">👥 Add Staff</a>

<a href="/dashboard/dairy">🐄 Dairy Dashboard</a>

<a href="/dashboard/poultry">🐔 Poultry Dashboard</a>

<a href="/dashboard/agriculture">🌾 Agriculture Dashboard</a>

<% }else if(user && user.role==="dairyWorker"){ %>

<a href="/">🏠 Home</a>

<a href="/dairyProjects">🐄 View Dairy Cattle</a>

<a href="/structures">🏗 Facilities</a>

<a href="/milk">🥛 Production</a>

<a href="/sales">💰 Sales</a>

<% }else if(user && user.role==="poultryWorker"){ %>

<a href="/">🏠 Home</a>

<a href="/incubation">🥚 Incubate Eggs</a>

<a href="/nursing">🐣 Poultry Progress</a>

<a href="/cage">🐔 Caged Chicken</a>

<a href="/poultry-stats">📊 Track Production</a>

<a href="/eggs">🥚 Sell Eggs</a>

<% } %>

</div>

<div class="overlay" id="overlay"></div>

<% } %>

<div class="main">

<%- body %>

</div>
<% if(!isAuthPage){ %>

<div class="footer">
© <%= new Date().getFullYear() %> Dr. Chessy Edwin
</div>

<script>

const sidebar=document.getElementById("sidebar");
const overlay=document.getElementById("overlay");
const profileBox=document.getElementById("profileBox");

function openSidebar(){

sidebar.classList.add("active");
overlay.classList.add("active");

}

function closeSidebar(){

sidebar.classList.remove("active");
overlay.classList.remove("active");

}

function toggleProfile(event){

event.stopPropagation();

if(profileBox){

profileBox.classList.toggle("active");

}

}

if(overlay){

overlay.addEventListener("click",closeSidebar);

}

document.querySelectorAll(".sidebar a").forEach(link=>{

link.addEventListener("click",function(){

closeSidebar();

});

});

document.addEventListener("click",function(event){

if(profileBox && !profileBox.contains(event.target)){

profileBox.classList.remove("active");

}

});

document.addEventListener("keydown",function(event){

if(event.key==="Escape"){

closeSidebar();

if(profileBox){

profileBox.classList.remove("active");

}

}

});

window.addEventListener("resize",function(){

if(window.innerWidth>768){

closeSidebar();

}

});

</script>

<% } %>

</body>
</html>