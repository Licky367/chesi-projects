<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
>

<title>
    <%= typeof title !== "undefined" ? title : "Projects" %>
</title>


<style>

/* =========================================================
   GLOBAL
========================================================= */

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial,sans-serif;
}

html,
body{
    height:100%;
    background:#f4f6f8;
}


/* =========================================================
   HEADER
========================================================= */

.header{
    position:fixed;

    top:0;
    left:0;
    right:0;

    min-height:70px;

    background:#0b5d1e;

    display:flex;
    align-items:center;

    padding:0 18px;

    color:#fff;

    z-index:1002;

    box-shadow:
        0 2px 8px rgba(0,0,0,.15);
}


/* =========================================================
   HEADER LOGO
========================================================= */

.header-logo-link{
    display:flex;

    align-items:center;
    justify-content:flex-start;

    width:auto;
    height:70px;

    text-decoration:none;

    flex-shrink:0;
}

.header-logo{
    height:138px;
    width:auto;

    display:block;

    object-fit:contain;

    position:relative;
    top:10px;
}


/* =========================================================
   HEADER TITLE
========================================================= */

.header-title{
    display:flex;

    align-items:center;
    justify-content:flex-start;

    flex:0 1 auto;

    min-width:0;

    padding:0 0 0 8px;

    text-align:left;
}

.header-title-text{
    display:block;

    width:auto;

    font-size:18px;
    font-weight:700;

    letter-spacing:.3px;

    color:#fff;

    white-space:normal;

    overflow:visible;

    text-overflow:clip;

    line-height:21px;
}


/* =========================================================
   TOP MENU
========================================================= */

.top-menu{
    position:fixed;

    top:70px;
    left:0;
    right:0;

    height:50px;

    background:#084816;

    display:flex;

    align-items:center;

    padding:0 15px;

    z-index:1001;

    box-shadow:
        0 2px 8px rgba(0,0,0,.15);
}


/* =========================================================
   TOP NAVIGATION
   Used by:
   - Admin
   - Dairy Worker
========================================================= */

.dairy-worker-nav{
    display:flex;

    align-items:center;

    justify-content:space-evenly;

    width:auto;

    height:100%;

    overflow-x:auto;
    overflow-y:hidden;

    flex:1 1 auto;

    min-width:0;

    scrollbar-width:none;
}

.dairy-worker-nav::-webkit-scrollbar{
    display:none;
}


/* =========================================================
   NAV LINKS
========================================================= */

.dairy-worker-nav a{
    display:flex;

    flex-direction:column;

    align-items:center;

    justify-content:center;

    gap:2px;

    height:46px;

    flex:1 1 0;

    min-width:0;

    padding:2px 8px;

    border-radius:7px;

    color:#fff;

    text-decoration:none;

    font-size:11px;

    font-weight:500;

    white-space:nowrap;

    transition:
        background .2s ease,
        transform .15s ease;
}

.dairy-worker-nav a:hover{
    background:rgba(255,255,255,.15);
}

.dairy-worker-nav a:active{
    background:rgba(255,255,255,.2);

    transform:scale(.97);
}


/* =========================================================
   NAV ICON
========================================================= */

.nav-icon{
    display:block;

    font-size:19px;

    line-height:19px;
}

.nav-label{
    display:block;

    font-size:10px;

    line-height:12px;
}


/* =========================================================
   MENU BUTTON
   Used by poultry worker.
========================================================= */

.menu-btn{
    width:44px;
    height:44px;

    border-radius:8px;

    background:#fff;

    color:#0b5d1e;

    display:flex;

    align-items:center;
    justify-content:center;

    cursor:pointer;

    font-size:28px;
    font-weight:bold;

    user-select:none;

    flex-shrink:0;
}

.menu-btn:active{
    transform:scale(.96);
}


/* =========================================================
   PROFILE
========================================================= */

.profile-box{
    position:relative;

    margin-left:auto;

    flex-shrink:0;

    height:50px;

    display:flex;

    align-items:center;
}

.profile-trigger{
    height:48px;

    min-width:58px;

    display:flex;

    flex-direction:column;

    align-items:center;

    justify-content:center;

    gap:1px;

    cursor:pointer;
}

.profile-icon{
    font-size:19px;

    line-height:19px;

    display:block;
}

.profile-name{
    font-size:10px;

    line-height:12px;

    color:#fff;

    max-width:75px;

    overflow:hidden;

    text-overflow:ellipsis;

    white-space:nowrap;
}


/* =========================================================
   PROFILE DROPDOWN
========================================================= */

.dropdown-profile{
    position:absolute;

    top:52px;
    right:0;

    width:190px;

    background:#fff;

    border-radius:10px;

    overflow:hidden;

    box-shadow:
        0 8px 25px rgba(0,0,0,.2);

    display:none;

    z-index:1100;
}

.profile-box.active .dropdown-profile{
    display:block;
}

.dropdown-profile a{
    display:block;

    padding:12px 15px;

    text-decoration:none;

    color:#333;

    border-bottom:1px solid #eee;
}

.dropdown-profile a:last-child{
    border-bottom:none;
}

.dropdown-profile a:hover{
    background:#f2f2f2;
}


/* =========================================================
   SIDEBAR
========================================================= */

.sidebar{
    position:fixed;

    top:120px;
    left:-260px;

    width:240px;

    height:calc(100vh - 170px);

    background:#084816;

    overflow-y:auto;

    padding:15px;

    transition:left .3s ease;

    z-index:1002;
}

.sidebar.active{
    left:0;
}

.sidebar a{
    display:block;

    padding:12px;

    margin-bottom:6px;

    border-radius:6px;

    text-decoration:none;

    color:#fff;

    font-size:15px;

    transition:.2s;
}

.sidebar a:hover{
    background:rgba(255,255,255,.15);
}


/* =========================================================
   OVERLAY
========================================================= */

.overlay{
    position:fixed;

    top:120px;
    left:0;

    width:100%;

    height:calc(100vh - 170px);

    background:rgba(0,0,0,.45);

    display:none;

    z-index:1001;
}

.overlay.active{
    display:block;
}


/* =========================================================
   MAIN
========================================================= */

.main{
    padding:140px 18px 70px;

    min-height:100vh;
}


/* =========================================================
   FOOTER
========================================================= */

.footer{
    position:fixed;

    bottom:0;
    left:0;
    right:0;

    height:50px;

    background:#0b5d1e;

    color:#fff;

    display:flex;

    align-items:center;
    justify-content:center;

    font-size:13px;

    z-index:1000;
}


/* =========================================================
   MOBILE
========================================================= */

@media(max-width:600px){

    .sidebar{
        width:260px;

        left:-280px;
    }


    .header{
        padding:0 10px;

        min-height:70px;
    }


    .header-logo{
        height:100px;

        top:8px;
    }


    .header-title{
        padding-left:6px;

        flex:1 1 auto;
    }


    .header-title-text{
        font-size:15px;

        line-height:18px;

        white-space:normal;

        overflow:visible;

        text-overflow:clip;
    }


    .top-menu{
        padding:0 8px;
    }


    .dairy-worker-nav{
        gap:3px;

        flex:1 1 auto;

        min-width:0;
    }


    .dairy-worker-nav a{
        min-width:0;

        padding:2px 5px;
    }


    .nav-icon{
        font-size:18px;
    }


    .nav-label{
        font-size:9px;
    }


    .profile-trigger{
        min-width:53px;
    }


    .profile-name{
        max-width:60px;
    }

}


/* =========================================================
   VERY SMALL SCREENS
========================================================= */

@media(max-width:380px){

    .header{
        padding:0 6px;
    }

    .header-logo{
        height:88px;
    }

    .header-title{
        padding-left:4px;
    }

    .header-title-text{
        font-size:14px;
        line-height:17px;
    }

    .profile-trigger{
        min-width:48px;
    }

    .profile-name{
        max-width:50px;
    }

    .dairy-worker-nav a{
        padding-left:2px;
        padding-right:2px;
    }

}

</style>

</head>


<body>


<%

/* =========================================================
   AUTHENTICATION PAGES
========================================================= */

const authPages = [
    "/login",
    "/signup",
    "/forgot-password",
    "/reset-password"
];

const isAuthPage =
    authPages.includes(
        currentPath || req?.path || ""
    );


/* =========================================================
   HOME DESTINATION
========================================================= */

let homeLink = "/";


/*
   ADMIN
   ---------------------------------------------------------
   Admin home page:
   /dashboard/dairy
*/

if(
    user &&
    user.role === "admin"
){

    homeLink = "/dashboard/dairy";

}


/*
   DAIRY WORKER
   ---------------------------------------------------------
   Dairy worker home page is their assigned farm.
*/

else if(
    user &&
    user.role === "dairyWorker" &&
    Array.isArray(user.assignedFarm) &&
    user.assignedFarm.length > 0
){

    const firstFarm = user.assignedFarm[0];

    homeLink = `/dairy/${firstFarm}`;

}


/* =========================================================
   HEADER TITLE
========================================================= */

let headerTitle = "CHESI PROJECTS";

if(user){

    if(user.role === "dairyWorker"){

        headerTitle = "DAIRY ACTIVITIES";

    }

    else if(user.role === "poultryWorker"){

        headerTitle = "POULTRY ACTIVITIES";

    }

    else if(user.role === "admin"){

        headerTitle = "CHESI PROJECTS";

    }

}


/* =========================================================
   ROLE FLAGS
========================================================= */

const isAdmin =
    !!user &&
    user.role === "admin";

const isDairyWorker =
    !!user &&
    user.role === "dairyWorker";

const isPoultryWorker =
    !!user &&
    user.role === "poultryWorker";

%>


<% if(!isAuthPage){ %>


<!-- =========================================================
   HEADER
========================================================= -->

<div class="header">


    <!-- =====================================================
       LOGO
    ====================================================== -->

    <a
        href="<%= homeLink %>"

        class="header-logo-link"

        aria-label="Home"
    >

        <img
            src="/images/cfp-logo.png"

            alt="CFP Logo"

            class="header-logo"
        >

    </a>


    <!-- =====================================================
       HEADER TITLE
    ====================================================== -->

    <div class="header-title">

        <span class="header-title-text">
            <%= headerTitle %>
        </span>

    </div>


</div>


<!-- =========================================================
   TOP MENU
========================================================= -->

<div class="top-menu">


<% if(isDairyWorker){ %>


    <!-- =====================================================
       DAIRY WORKER TOP NAVIGATION
    ====================================================== -->

    <div class="dairy-worker-nav">


        <!-- HOME -->

        <a href="<%= homeLink %>">

            <span
                class="nav-icon"
                aria-hidden="true"
            >
                🏠
            </span>

            <span class="nav-label">
                Home
            </span>

        </a>


        <!-- PRODUCTION -->

        <a href="/milk">

            <span
                class="nav-icon"
                aria-hidden="true"
            >
                🥛
            </span>

            <span class="nav-label">
                Production
            </span>

        </a>


        <!-- SALES -->

        <a href="/sales">

            <span
                class="nav-icon"
                aria-hidden="true"
            >
                💰
            </span>

            <span class="nav-label">
                Sales
            </span>

        </a>


    </div>


<% }else if(isAdmin){ %>


    <!-- =====================================================
       ADMIN TOP NAVIGATION

       Home:
           /dashboard/dairy

       Production:
           /milk

       Sales:
           /sales

       Stats:
           /stats

       IMPORTANT:
       The Home icon is intentionally NOT placed
       inside a white box.
    ====================================================== -->

    <div class="dairy-worker-nav">


        <!-- =================================================
           ADMIN HOME
        ================================================== -->

        <a
            href="<%= homeLink %>"
            title="Dairy Dashboard"
        >

            <span
                class="nav-icon"
                aria-hidden="true"
            >
                🏠
            </span>

            <span class="nav-label">
                Home
            </span>

        </a>


        <!-- =================================================
           PRODUCTION
        ================================================== -->

        <a href="/milk">

            <span
                class="nav-icon"
                aria-hidden="true"
            >
                🥛
            </span>

            <span class="nav-label">
                Production
            </span>

        </a>


        <!-- =================================================
           SALES
        ================================================== -->

        <a href="/sales">

            <span
                class="nav-icon"
                aria-hidden="true"
            >
                💰
            </span>

            <span class="nav-label">
                Sales
            </span>

        </a>


        <!-- =================================================
           STATS
        ================================================== -->

        <a href="/stats">

            <span
                class="nav-icon"
                aria-hidden="true"
            >
                📊
            </span>

            <span class="nav-label">
                Stats
            </span>

        </a>


    </div>


<% }else{ %>


    <!-- =====================================================
       POULTRY WORKER MENU BUTTON
    ====================================================== -->

    <div
        class="menu-btn"

        onclick="openSidebar()"

        role="button"

        tabindex="0"

        aria-label="Open menu"
    >

        ☰

    </div>


<% } %>


<!-- =========================================================
   PROFILE
========================================================= -->

<div
    class="profile-box"
    id="profileBox"
>

    <div
        class="profile-trigger"

        onclick="toggleProfile(event)"

        role="button"

        tabindex="0"

        aria-label="Open profile menu"
    >

        <span
            class="profile-icon"
            aria-hidden="true"
        >
            👤
        </span>

        <span class="profile-name">
            Profile
        </span>

    </div>


    <div class="dropdown-profile">


        <% if(user){ %>


            <a href="/profile">
                👤 My Account
            </a>


            <% if(isAdmin){ %>

                <a href="/accounts">
                    👥 People
                </a>

            <% } %>


            <a href="/logout">
                🚪 Logout
            </a>


        <% } %>


    </div>

</div>


</div>


<!-- =========================================================
   SIDEBAR

   ADMIN:
       NO SIDEBAR

   DAIRY WORKER:
       NO SIDEBAR

   POULTRY WORKER:
       SIDEBAR ENABLED
========================================================= -->

<% if(isPoultryWorker){ %>


<div
    class="sidebar"
    id="sidebar"
>


    <a href="/">
        🏠 Home
    </a>


    <a href="/incubation">
        🥚 Incubate Eggs
    </a>


    <a href="/nursing">
        🐣 Poultry Progress
    </a>


    <a href="/cage">
        🐔 Caged Chicken
    </a>


    <a href="/poultry-stats">
        📊 Track Production
    </a>


    <a href="/eggs">
        🥚 Sell Eggs
    </a>


</div>


<div
    class="overlay"
    id="overlay"
></div>


<% } %>


<% } %>


<!-- =========================================================
   MAIN
========================================================= -->

<div class="main">

    <%- body %>

</div>


<% if(!isAuthPage){ %>


<!-- =========================================================
   FOOTER
========================================================= -->

<div class="footer">

    © <%= new Date().getFullYear() %>
    Dr. Chessy Edwin

</div>


<script>

/* =========================================================
   ELEMENTS
========================================================= */

const sidebar =
    document.getElementById("sidebar");

const overlay =
    document.getElementById("overlay");

const profileBox =
    document.getElementById("profileBox");


/* =========================================================
   SIDEBAR
========================================================= */

function openSidebar(){

    if(!sidebar || !overlay){
        return;
    }

    sidebar.classList.add("active");

    overlay.classList.add("active");

}


function closeSidebar(){

    if(!sidebar || !overlay){
        return;
    }

    sidebar.classList.remove("active");

    overlay.classList.remove("active");

}


/* =========================================================
   PROFILE
========================================================= */

function toggleProfile(event){

    event.stopPropagation();

    if(profileBox){

        profileBox.classList.toggle(
            "active"
        );

    }

}


/* =========================================================
   OVERLAY
========================================================= */

if(overlay){

    overlay.addEventListener(
        "click",
        closeSidebar
    );

}


/* =========================================================
   SIDEBAR LINKS
========================================================= */

if(sidebar){

    sidebar
        .querySelectorAll("a")
        .forEach(link=>{

            link.addEventListener(
                "click",
                function(){

                    closeSidebar();

                }
            );

        });

}


/* =========================================================
   CLOSE PROFILE WHEN CLICKING OUTSIDE
========================================================= */

document.addEventListener(
    "click",
    function(event){

        if(
            profileBox &&
            !profileBox.contains(event.target)
        ){

            profileBox.classList.remove(
                "active"
            );

        }

    }
);


/* =========================================================
   ESCAPE KEY
========================================================= */

document.addEventListener(
    "keydown",
    function(event){

        if(event.key === "Escape"){

            closeSidebar();

            if(profileBox){

                profileBox.classList.remove(
                    "active"
                );

            }

        }

    }
);


/* =========================================================
   RESIZE
========================================================= */

window.addEventListener(
    "resize",
    function(){

        if(window.innerWidth > 768){

            closeSidebar();

        }

    }
);

</script>


<% } %>


</body>

</html>