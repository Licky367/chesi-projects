<style>

:root{
--primary:#16a34a;
--primary-dark:#15803d;
--primary-light:#dcfce7;
--secondary:#f8fafc;
--border:#e5e7eb;
--text:#1f2937;
--muted:#6b7280;
--danger:#dc2626;
--info:#2563eb;
--radius:18px;
}

body{
background:#f3f6f9;
}

.new-dairy-page{
max-width:1200px;
margin:auto;
padding:30px 15px 50px;
animation:fadeUp .4s ease;
}

@keyframes fadeUp{

from{
opacity:0;
transform:translateY(20px);
}

to{
opacity:1;
transform:none;
}

}

.new-card{

background:#fff;

border-radius:24px;

overflow:hidden;

box-shadow:0 18px 45px rgba(0,0,0,.08);

}

.page-header{

padding:30px;

background:linear-gradient(135deg,#ecfdf5,#ffffff);

border-bottom:1px solid var(--border);

display:flex;

justify-content:space-between;

align-items:center;

flex-wrap:wrap;

gap:20px;

}

.page-title{

display:flex;

align-items:center;

gap:18px;

}

.page-icon{

width:70px;

height:70px;

border-radius:20px;

display:flex;

align-items:center;

justify-content:center;

font-size:34px;

background:var(--primary-light);

}

.page-title h2{

margin:0;

font-size:30px;

color:#166534;

}

.page-title p{

margin:5px 0 0;

color:var(--muted);

}

.content{

padding:30px;

}

.form-grid{

display:grid;

grid-template-columns:2fr 1fr;

gap:35px;

}

.section{

background:#fff;

border:1px solid var(--border);

border-radius:18px;

padding:25px;

margin-bottom:25px;

}

.section-title{

display:flex;

align-items:center;

gap:10px;

font-size:18px;

font-weight:700;

margin-bottom:20px;

color:#166534;

}

.image-upload{

display:flex;

flex-direction:column;

align-items:center;

}

.image-preview{

position:relative;

margin-bottom:15px;

}

.image-preview img{

width:160px;

height:160px;

border-radius:50%;

border:5px solid var(--primary-light);

object-fit:cover;

cursor:pointer;

transition:.3s;

box-shadow:0 10px 25px rgba(0,0,0,.12);

}

.image-preview img:hover{

transform:scale(1.05);

}

.camera{

position:absolute;

right:5px;

bottom:8px;

width:42px;

height:42px;

border-radius:50%;

background:var(--primary);

color:white;

display:flex;

align-items:center;

justify-content:center;

font-size:18px;

border:3px solid white;

pointer-events:none;

}

.image-input{

display:none;

}

.upload-button{

margin-top:8px;

padding:10px 18px;

border-radius:999px;

background:var(--primary);

color:white;

cursor:pointer;

font-weight:600;

}

.row-two{

display:grid;

grid-template-columns:1fr 1fr;

gap:18px;

}

.form-group{

margin-bottom:22px;

}

.form-label{

display:block;

font-weight:700;

margin-bottom:8px;

color:var(--text);

}

.input-wrap{

position:relative;

}

.input-icon{

position:absolute;

left:14px;

top:50%;

transform:translateY(-50%);

font-size:18px;

opacity:.6;

}

.form-input{

width:100%;

padding:13px 14px 13px 45px;

border-radius:12px;

border:1px solid var(--border);

background:#fafafa;

transition:.25s;

outline:none;

}

.form-input:focus{

border-color:var(--primary);

background:white;

transform:translateY(-2px);

box-shadow:0 0 0 4px rgba(22,163,74,.12);

}
.form-help{

font-size:12px;

color:var(--muted);

margin-top:6px;

display:block;

}

.badge-box{

margin-top:10px;

min-height:45px;

display:flex;

align-items:center;

}

.badge{

display:inline-flex;

align-items:center;

gap:8px;

padding:10px 16px;

border-radius:999px;

font-size:14px;

font-weight:700;

background:#f3f4f6;

color:#6b7280;

transition:.25s;

}

.badge.female{

background:#ecfdf5;

color:#166534;

}

.badge.male{

background:#eff6ff;

color:#1d4ed8;

}

.badge.other{

background:#fef2f2;

color:#b91c1c;

}

.summary{

position:sticky;

top:20px;

background:#fafafa;

border:1px solid var(--border);

border-radius:18px;

padding:25px;

}

.summary h3{

margin:0 0 20px;

color:#166534;

}

.summary-image{

display:flex;

justify-content:center;

margin-bottom:20px;

}

.summary-image img{

width:120px;

height:120px;

border-radius:50%;

object-fit:cover;

border:4px solid var(--primary-light);

}

.summary-item{

display:flex;

justify-content:space-between;

padding:12px 0;

border-bottom:1px solid #ececec;

font-size:14px;

}

.summary-item:last-child{

border-bottom:none;

}

.summary-label{

font-weight:700;

color:#6b7280;

}

.summary-value{

font-weight:600;

color:#111827;

text-align:right;

}

.submit-btn{

width:100%;

padding:16px;

border:none;

border-radius:14px;

background:linear-gradient(135deg,var(--primary),var(--primary-dark));

color:white;

font-size:16px;

font-weight:700;

cursor:pointer;

transition:.3s;

margin-top:15px;

}

.submit-btn:hover{

transform:translateY(-3px);

box-shadow:0 12px 25px rgba(22,163,74,.25);

}

@media(max-width:900px){

.form-grid{

grid-template-columns:1fr;

}

.summary{

position:static;

}

}

@media(max-width:600px){

.row-two{

grid-template-columns:1fr;

}

.page-header{

padding:20px;

}

.content{

padding:20px;

}

.page-title h2{

font-size:24px;

}

.image-preview img{

width:130px;

height:130px;

}

}

</style>
<div class="new-dairy-page">

<div class="new-card">

<div class="page-header">

<div class="page-title">

<div class="page-icon">
🐄
</div>

<div>

<h2>Add New Dairy Record</h2>

<p>
Register a new animal or create a facility record.
</p>

</div>

</div>

</div>

<form
id="newDairyForm"
action="/new"
method="POST"
enctype="multipart/form-data">

<div class="content">

<div class="form-grid">

<div>

<!-- ===========================
     PROFILE PHOTO
=========================== -->

<div class="section">

<div class="section-title">

📸 Profile Photo

</div>

<div class="image-upload">

<div class="image-preview">

<img
id="previewImage"
src="/images/avatar.png"
alt="Preview">

<div class="camera">
📷
</div>

</div>

<label
for="profileImageInput"
class="upload-button">

Choose Image

</label>

<input
type="file"
id="profileImageInput"
name="profileImage"
accept="image/*"
class="image-input">

</div>

</div>

<!-- ===========================
     ANIMAL INFORMATION
=========================== -->

<div class="section">

<div class="section-title">

📋 Animal Information

</div>

<div class="form-group">

<label
class="form-label"
for="nameInput">

Animal / Record Name

</label>

<div class="input-wrap">

<span class="input-icon">
🐄
</span>

<input
type="text"
id="nameInput"
name="name"
class="form-input"
placeholder="Enter record name"
required>

</div>

</div>

<div class="row-two">

<!-- CODE -->

<div class="form-group">

<label
class="form-label"
for="codeInput">

Identification Code

</label>

<div class="input-wrap">

<span class="input-icon">
🔢
</span>

<input
type="number"
id="codeInput"
name="code"
class="form-input"
placeholder="Unique code"
required>

</div>

<div class="badge-box">

<div
id="codeHint"
class="badge">

Enter a code

</div>

</div>

</div>

<!-- MASS -->

<div class="form-group">

<label
class="form-label"
for="massInput">

Mass (Kg)

</label>

<div class="input-wrap">

<span class="input-icon">
⚖️
</span>

<input
type="number"
id="massInput"
name="mass"
class="form-input"
placeholder="Enter mass"
min="0"
step="0.1"
required>

</div>

</div>

</div>

<!-- DATE OF BIRTH -->

<div class="form-group">

<label
class="form-label"
for="dobInput">

Date of Birth

</label>

<div class="input-wrap">

<span class="input-icon">
📅
</span>

<input
type="date"
id="dobInput"
name="dateOfBirth"
class="form-input"
required>

</div>

<small
id="dobHelp"
class="form-help">

Required for animals (code 0 or greater). Disabled automatically for structures (negative codes).

</small>

</div>

<button
type="submit"
class="submit-btn">

💾 Save Dairy Record

</button>

</div>
<!-- ===========================
     LIVE SUMMARY PANEL
=========================== -->

<div>

<div class="summary">

<h3>

📄 Live Preview

</h3>

<div class="summary-image">

<img
id="summaryImage"
src="/images/avatar.png"
alt="Preview">

</div>

<div class="summary-item">

<span class="summary-label">

Name

</span>

<span
id="summaryName"
class="summary-value">

—

</span>

</div>

<div class="summary-item">

<span class="summary-label">

Code

</span>

<span
id="summaryCode"
class="summary-value">

—

</span>

</div>

<div class="summary-item">

<span class="summary-label">

Classification

</span>

<span
id="summaryGender"
class="summary-value">

—

</span>

</div>

<div class="summary-item">

<span class="summary-label">

Mass

</span>

<span
id="summaryMass"
class="summary-value">

—

</span>

</div>

<div class="summary-item">

<span class="summary-label">

Date of Birth

</span>

<span
id="summaryDob"
class="summary-value">

—

</span>

</div>

</div>

</div>

</div>

</div>

</div>

</form>

</div>

</div>

<script>

document.addEventListener("DOMContentLoaded",()=>{

const form=document.getElementById("newDairyForm");

const imageInput=document.getElementById("profileImageInput");
const previewImage=document.getElementById("previewImage");
const summaryImage=document.getElementById("summaryImage");

const nameInput=document.getElementById("nameInput");
const codeInput=document.getElementById("codeInput");
const massInput=document.getElementById("massInput");
const dobInput=document.getElementById("dobInput");

const summaryName=document.getElementById("summaryName");
const summaryCode=document.getElementById("summaryCode");
const summaryGender=document.getElementById("summaryGender");
const summaryMass=document.getElementById("summaryMass");
const summaryDob=document.getElementById("summaryDob");

const codeHint=document.getElementById("codeHint");
const dobHelp=document.getElementById("dobHelp");

previewImage.onclick=()=>imageInput.click();

imageInput.addEventListener("change",function(){

const file=this.files[0];

if(!file){

previewImage.src="/images/avatar.png";
summaryImage.src="/images/avatar.png";

return;

}

if(!file.type.startsWith("image/")){

alert("Please choose an image.");

this.value="";

previewImage.src="/images/avatar.png";
summaryImage.src="/images/avatar.png";

return;

}

const reader=new FileReader();

reader.onload=e=>{

previewImage.src=e.target.result;
summaryImage.src=e.target.result;

};

reader.readAsDataURL(file);

});

function updateSummary(){

summaryName.textContent=nameInput.value||"—";

summaryCode.textContent=codeInput.value||"—";

summaryMass.textContent=
massInput.value
?massInput.value+" Kg"
:"—";

summaryDob.textContent=
dobInput.value||"—";

}
function classifyCode(){

const value=Number(codeInput.value);

if(codeInput.value===""){

codeHint.className="badge";
codeHint.textContent="Enter a code";

summaryGender.textContent="—";

dobInput.disabled=false;
dobInput.required=true;

dobHelp.textContent=
"Required for animals (code 0 or greater). Disabled automatically for structures (negative codes).";

return;

}

if(Number.isNaN(value)){

codeHint.className="badge other";
codeHint.textContent="⚠ Invalid Code";

summaryGender.textContent="Invalid";

dobInput.disabled=false;
dobInput.required=true;

return;

}

/* ===========================
   STRUCTURE RECORD
=========================== */

if(value<0){

codeHint.className="badge other";
codeHint.textContent="🏢 Structure Record";

summaryGender.textContent="Structure";

dobInput.value="";
dobInput.disabled=true;
dobInput.required=false;

summaryDob.textContent="N/A";

dobHelp.textContent=
"Structures do not require a Date of Birth.";

return;

}

/* ===========================
   ANIMAL RECORD
=========================== */

dobInput.disabled=false;
dobInput.required=true;

dobHelp.textContent=
"Date of Birth is required for all animals.";

if(value%2===0){

codeHint.className="badge female";
codeHint.textContent="♀ Female Animal";

summaryGender.textContent="Female";

}else{

codeHint.className="badge male";
codeHint.textContent="♂ Male Animal";

summaryGender.textContent="Male";

}

}

form.addEventListener("submit",function(e){

const value=Number(codeInput.value);

if(value>=0 && !dobInput.value){

e.preventDefault();

alert("Please enter the animal's Date of Birth.");

dobInput.focus();

return;

}

/* Prevent sending an empty date for structures */

if(value<0){

dobInput.disabled=true;

}

});

nameInput.addEventListener("input",updateSummary);

massInput.addEventListener("input",updateSummary);

dobInput.addEventListener("change",updateSummary);

codeInput.addEventListener("input",()=>{

classifyCode();

updateSummary();

});

updateSummary();

classifyCode();

});

</script>