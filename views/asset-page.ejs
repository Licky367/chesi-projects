<%
/*
==========================================================
ASSET PAGE

FILE:
    views/asset-page.ejs

PURPOSE:
----------------------------------------------------------
Dedicated asset page for a dairy farm.

URL:
    /dairy/:id/assets

EXPECTED DATA:
----------------------------------------------------------
    dairy
    assetDairies
    assignedFarms

LAYOUT:
----------------------------------------------------------
The category tabs are the FIRST BAR on the page.

Tabs:
    1. Animals
    2. Cow Shades
    3. AgroStores
    4. Tools
    5. Farm switch icon

FARM SWITCHING:
----------------------------------------------------------
The ⇄ button inside the tab row opens the list of farms
assigned to the current dairy worker.

ASSET ROUTES:
----------------------------------------------------------
Every asset opens:

    /dairy/<asset._id>

EXCEPTION:
----------------------------------------------------------
Cow Shades and AgroStores open their storage contents:

    /storage/<dairy._id>/contents/<asset._id>

FARM ROUTES:
----------------------------------------------------------
Every assigned farm opens:

    /dairy/<farm._id>
==========================================================
*/
%>


<%
/* ==========================================================
   PREPARE ASSET DATA
========================================================== */

const availableAssets =
    Array.isArray(assetDairies)
        ? assetDairies.filter(asset => !!asset)
        : [];


/* ==========================================================
   HELPER:
   CHECK WHETHER VALUE IS MISSING
========================================================== */

function isMissing(value) {

    return (
        value === null ||
        value === undefined ||
        value === ""
    );

}


/* ==========================================================
   HELPER:
   POSITIVE CODE
========================================================== */

function hasPositiveCode(asset) {

    if (!asset || isMissing(asset.code)) {

        return false;

    }

    const code =
        Number(asset.code);

    return (
        Number.isFinite(code) &&
        code > 0
    );

}


/* ==========================================================
   HELPER:
   ANIMAL RECORD TYPE
========================================================== */

function hasAnimalRecordType(asset) {

    if (!asset) {

        return false;

    }

    return (
        typeof asset.recordType === "string" &&
        asset.recordType.trim().toLowerCase() === "animal"
    );

}


/* ==========================================================
   DETERMINE ANIMAL
========================================================== */

function isAnimal(asset) {

    return (
        hasPositiveCode(asset) ||
        hasAnimalRecordType(asset)
    );

}


/* ==========================================================
   DETERMINE ANIMAL GENDER
========================================================== */

function getAnimalGender(asset) {

    if (!asset || isMissing(asset.code)) {

        return "";

    }

    const code =
        Number(asset.code);

    if (!Number.isFinite(code)) {

        return "";

    }

    return (
        Math.abs(code) % 2 !== 0
            ? "Male"
            : "Female"
    );

}


/* ==========================================================
   ANIMALS
========================================================== */

const animalDairies =
    availableAssets.filter(asset => {

        return isAnimal(asset);

    });


/* ==========================================================
   COW SHADES

   Positive roomNumber
========================================================== */

const cowShadeDairies =
    availableAssets.filter(asset => {

        if (isAnimal(asset)) {

            return false;

        }

        if (isMissing(asset.roomNumber)) {

            return false;

        }

        const roomNumber =
            Number(asset.roomNumber);

        return (
            Number.isFinite(roomNumber) &&
            roomNumber > 0
        );

    });


/* ==========================================================
   AGROSTORES

   Negative roomNumber
========================================================== */

const animalFeedDairies =
    availableAssets.filter(asset => {

        if (isAnimal(asset)) {

            return false;

        }

        if (isMissing(asset.roomNumber)) {

            return false;

        }

        const roomNumber =
            Number(asset.roomNumber);

        return (
            Number.isFinite(roomNumber) &&
            roomNumber < 0
        );

    });


/* ==========================================================
   TOOLS

   No code
   AND
   No roomNumber
   AND
   No dwellNumber
========================================================== */

const toolDairies =
    availableAssets.filter(asset => {

        return (
            !isAnimal(asset) &&
            isMissing(asset.code) &&
            isMissing(asset.roomNumber) &&
            isMissing(asset.dwellNumber)
        );

    });


/* ==========================================================
   ASSIGNED FARMS
========================================================== */

const workerAssignedFarms =
    Array.isArray(assignedFarms)
        ? assignedFarms.filter(farm => !!farm)
        : [];


const canSwitchFarms =
    workerAssignedFarms.length > 1;


/* ==========================================================
   CURRENT FARM
========================================================== */

const currentFarmId =
    dairy && dairy._id
        ? dairy._id.toString()
        : "";

%>


<!-- ==========================================================
     ASSET PAGE
========================================================== -->

<div
    class="asset-page"
    id="assetPage"
>


    <!-- ======================================================
         TOP TAB BAR

         THIS IS THE FIRST BAR ON THE PAGE.
    ======================================================= -->

    <div
        class="asset-page__tabs-wrapper"
        role="navigation"
        aria-label="Farm assets"
    >

        <div
            class="asset-page__tabs"
            role="tablist"
            aria-label="Asset categories"
        >


            <!-- ==============================================
                 ANIMALS
            =============================================== -->

            <button
                type="button"
                id="assetAnimalsTab"
                class="asset-page__tab is-active"
                data-asset-category="animals"
                role="tab"
                aria-selected="true"
                aria-controls="assetAnimals"
            >

                <span class="asset-page__tab-icon">
                    🐄
                </span>

                <span class="asset-page__tab-label">
                    Animals
                </span>

                <span class="asset-page__tab-count">
                    <%= animalDairies.length %>
                </span>

            </button>


            <!-- ==============================================
                 COW SHADES
            =============================================== -->

            <button
                type="button"
                id="assetCowShadesTab"
                class="asset-page__tab"
                data-asset-category="cow-shades"
                role="tab"
                aria-selected="false"
                aria-controls="assetCowShades"
            >

                <span class="asset-page__tab-icon">
                    🏠
                </span>

                <span class="asset-page__tab-label">
                    Cow Shades
                </span>

                <span class="asset-page__tab-count">
                    <%= cowShadeDairies.length %>
                </span>

            </button>


            <!-- ==============================================
                 AGROSTORES
            =============================================== -->

            <button
                type="button"
                id="assetAnimalFeedsTab"
                class="asset-page__tab"
                data-asset-category="animal-feeds"
                role="tab"
                aria-selected="false"
                aria-controls="assetAnimalFeeds"
            >

                <span class="asset-page__tab-icon">
                    🌾
                </span>

                <span class="asset-page__tab-label">
                    AgroStores
                </span>

                <span class="asset-page__tab-count">
                    <%= animalFeedDairies.length %>
                </span>

            </button>


            <!-- ==============================================
                 TOOLS
            =============================================== -->

            <button
                type="button"
                id="assetToolsTab"
                class="asset-page__tab"
                data-asset-category="tools"
                role="tab"
                aria-selected="false"
                aria-controls="assetTools"
            >

                <span class="asset-page__tab-icon">
                    🔧
                </span>

                <span class="asset-page__tab-label">
                    Tools
                </span>

                <span class="asset-page__tab-count">
                    <%= toolDairies.length %>
                </span>

            </button>


            <!-- ==============================================
                 FARM SWITCH

                 SWAP ICON IS PART OF THE TAB BAR.
            =============================================== -->

            <% if (canSwitchFarms) { %>

                <button
                    type="button"
                    id="farmSwitchButton"
                    class="asset-page__farm-switch"
                    aria-label="Switch dairy farm"
                    aria-expanded="false"
                    aria-controls="assignedFarmList"
                    title="Switch Farm"
                >

                    <span
                        class="asset-page__farm-switch-icon"
                        aria-hidden="true"
                    >
                        ⇄
                    </span>

                    <span class="asset-page__farm-switch-label">
                        Switch
                    </span>

                </button>

            <% } %>


        </div>


        <!-- ==================================================
             FARM SWITCHER DROPDOWN

             SITS DIRECTLY UNDER THE TABS.
        =================================================== -->

        <% if (canSwitchFarms) { %>

            <div
                id="assignedFarmList"
                class="asset-page__farm-list"
                hidden
            >

                <div class="asset-page__farm-list-heading">

                    <div>

                        <span class="asset-page__farm-list-eyebrow">
                            YOUR ASSIGNED FARMS
                        </span>

                        <strong>
                            Switch Dairy Farm
                        </strong>

                    </div>

                    <button
                        type="button"
                        id="closeFarmList"
                        class="asset-page__farm-list-close"
                        aria-label="Close farm list"
                    >
                        ×
                    </button>

                </div>


                <div class="asset-page__farm-options">

                    <% workerAssignedFarms.forEach(farm => {

                        const farmId =
                            farm &&
                            farm._id
                                ? farm._id.toString()
                                : "";

                        const isCurrent =
                            farmId &&
                            farmId === currentFarmId;

                    %>

                        <a
                            href="/dairy/<%= farm._id %>"
                            class="asset-page__farm-option <%= isCurrent ? 'is-current' : '' %>"
                        >

                            <span
                                class="asset-page__farm-option-icon"
                                aria-hidden="true"
                            >
                                <%= isCurrent ? "✓" : "⌂" %>
                            </span>


                            <span class="asset-page__farm-option-details">

                                <span class="asset-page__farm-option-name">
                                    <%= farm.name %>
                                </span>

                                <% if (
                                    farm.code !== null &&
                                    farm.code !== undefined
                                ) { %>

                                    <span class="asset-page__farm-option-code">
                                        Farm #<%= farm.code %>
                                    </span>

                                <% } %>

                            </span>


                            <% if (isCurrent) { %>

                                <span class="asset-page__current-label">
                                    CURRENT
                                </span>

                            <% } %>

                        </a>

                    <% }); %>

                </div>

            </div>

        <% } %>

    </div>


    <!-- ======================================================
         CURRENT FARM IDENTIFICATION

         This is NOT a second navigation bar.
         It simply identifies the page's farm.
    ======================================================= -->

    <% if (dairy) { %>

        <div class="asset-page__farm-heading">

            <div class="asset-page__farm-heading-text">

                <span class="asset-page__farm-heading-eyebrow">
                    FARM ASSETS
                </span>

                <h1>
                    <%= dairy.name %>
                </h1>

            </div>


            <% if (
                dairy.code !== null &&
                dairy.code !== undefined &&
                Number(dairy.code) < 0
            ) { %>

                <span class="asset-page__farm-code">
                    Farm #<%= dairy.code %>
                </span>

            <% } %>

        </div>

    <% } %>


    <!-- ======================================================
         ASSET CONTENT
    ======================================================= -->

    <main class="asset-page__content">


        <!-- ==================================================
             ANIMALS
        =================================================== -->

        <section
            id="assetAnimals"
            class="asset-page__section is-active"
            data-asset-section="animals"
            role="tabpanel"
            aria-labelledby="assetAnimalsTab"
        >

            <div class="asset-page__section-heading">

                <div>

                    <span class="asset-page__section-eyebrow">
                        LIVESTOCK
                    </span>

                    <h2>
                        Animals
                    </h2>

                </div>

                <span class="asset-page__section-count">
                    <%= animalDairies.length %>
                </span>

            </div>


            <div class="asset-page__grid">

                <% if (animalDairies.length > 0) { %>

                    <% animalDairies.forEach(animal => {

                        const animalGender =
                            getAnimalGender(animal);

                    %>

                        <a
                            href="/dairy/<%= animal._id %>"
                            class="asset-page__card"
                            data-asset-id="<%= animal._id %>"
                            data-asset-type="animal"
                        >

                            <div class="asset-page__card-image">

                                <% if (animal.displayImage) { %>

                                    <img
                                        src="<%= animal.displayImage %>"
                                        alt="<%= animal.name %>"
                                        loading="lazy"
                                    >

                                <% } else { %>

                                    <span
                                        class="asset-page__placeholder"
                                        aria-hidden="true"
                                    >
                                        🐄
                                    </span>

                                <% } %>

                            </div>


                            <div class="asset-page__card-details">

                                <span class="asset-page__card-name">
                                    <%= animal.name %>
                                </span>


                                <% if (animalGender) { %>

                                    <span class="asset-page__card-code">
                                        <%= animalGender %>
                                    </span>

                                <% } %>


                                <% if (animal.type) { %>

                                    <span class="asset-page__card-meta">
                                        <%= animal.type %>
                                    </span>

                                <% } %>

                            </div>


                            <span
                                class="asset-page__card-arrow"
                                aria-hidden="true"
                            >
                                ›
                            </span>

                        </a>

                    <% }); %>

                <% } else { %>

                    <div class="asset-page__empty">

                        <span class="asset-page__empty-icon">
                            🐄
                        </span>

                        <strong>
                            No animals found
                        </strong>

                        <span>
                            No animals are currently assigned
                            to this dairy farm.
                        </span>

                    </div>

                <% } %>

            </div>

        </section>


        <!-- ==================================================
             COW SHADES
        =================================================== -->

        <section
            id="assetCowShades"
            class="asset-page__section"
            data-asset-section="cow-shades"
            role="tabpanel"
            aria-labelledby="assetCowShadesTab"
            hidden
        >

            <div class="asset-page__section-heading">

                <div>

                    <span class="asset-page__section-eyebrow">
                        FARM FACILITIES
                    </span>

                    <h2>
                        Cow Shades
                    </h2>

                </div>

                <span class="asset-page__section-count">
                    <%= cowShadeDairies.length %>
                </span>

            </div>


            <div class="asset-page__grid">

                <% if (cowShadeDairies.length > 0) { %>

                    <% cowShadeDairies.forEach(shade => { %>

                        <a
                            href="/storage/<%= dairy._id %>/contents/<%= shade._id %>"
                            class="asset-page__card"
                            data-asset-id="<%= shade._id %>"
                            data-asset-room-number="<%= shade.roomNumber %>"
                            data-asset-type="cow-shade"
                        >

                            <div class="asset-page__card-image">

                                <% if (shade.displayImage) { %>

                                    <img
                                        src="<%= shade.displayImage %>"
                                        alt="<%= shade.name %>"
                                        loading="lazy"
                                    >

                                <% } else { %>

                                    <span
                                        class="asset-page__placeholder"
                                        aria-hidden="true"
                                    >
                                        🏠
                                    </span>

                                <% } %>

                            </div>


                            <div class="asset-page__card-details">

                                <span class="asset-page__card-name">
                                    <%= shade.name %>
                                </span>

                                <span class="asset-page__card-code">
                                    Shade #<%= shade.roomNumber %>
                                </span>


                                <% if (shade.type) { %>

                                    <span class="asset-page__card-meta">
                                        <%= shade.type %>
                                    </span>

                                <% } %>


                                <% if (shade.location) { %>

                                    <span class="asset-page__card-meta">
                                        <%= shade.location %>
                                    </span>

                                <% } %>

                            </div>


                            <span
                                class="asset-page__card-arrow"
                                aria-hidden="true"
                            >
                                ›
                            </span>

                        </a>

                    <% }); %>

                <% } else { %>

                    <div class="asset-page__empty">

                        <span class="asset-page__empty-icon">
                            🏠
                        </span>

                        <strong>
                            No cow shades found
                        </strong>

                        <span>
                            No cow shades are currently assigned
                            to this dairy farm.
                        </span>

                    </div>

                <% } %>

            </div>

        </section>


        <!-- ==================================================
             AGROSTORES
        =================================================== -->

        <section
            id="assetAnimalFeeds"
            class="asset-page__section"
            data-asset-section="animal-feeds"
            role="tabpanel"
            aria-labelledby="assetAnimalFeedsTab"
            hidden
        >

            <div class="asset-page__section-heading">

                <div>

                    <span class="asset-page__section-eyebrow">
                        FEED FACILITIES
                    </span>

                    <h2>
                        AgroStores
                    </h2>

                </div>

                <span class="asset-page__section-count">
                    <%= animalFeedDairies.length %>
                </span>

            </div>


            <div class="asset-page__grid">

                <% if (animalFeedDairies.length > 0) { %>

                    <% animalFeedDairies.forEach(feed => { %>

                        <a
                            href="/storage/<%= dairy._id %>/contents/<%= feed._id %>"
                            class="asset-page__card"
                            data-asset-id="<%= feed._id %>"
                            data-asset-room-number="<%= feed.roomNumber %>"
                            data-asset-type="agrostore"
                        >

                            <div class="asset-page__card-image">

                                <% if (feed.displayImage) { %>

                                    <img
                                        src="<%= feed.displayImage %>"
                                        alt="<%= feed.name %>"
                                        loading="lazy"
                                    >

                                <% } else { %>

                                    <span
                                        class="asset-page__placeholder"
                                        aria-hidden="true"
                                    >
                                        🌾
                                    </span>

                                <% } %>

                            </div>


                            <div class="asset-page__card-details">

                                <span class="asset-page__card-name">
                                    <%= feed.name %>
                                </span>

                                <span class="asset-page__card-code">
                                    AgroStore #<%= feed.roomNumber %>
                                </span>


                                <% if (feed.type) { %>

                                    <span class="asset-page__card-meta">
                                        <%= feed.type %>
                                    </span>

                                <% } %>


                                <% if (feed.location) { %>

                                    <span class="asset-page__card-meta">
                                        <%= feed.location %>
                                    </span>

                                <% } %>

                            </div>


                            <span
                                class="asset-page__card-arrow"
                                aria-hidden="true"
                            >
                                ›
                            </span>

                        </a>

                    <% }); %>

                <% } else { %>

                    <div class="asset-page__empty">

                        <span class="asset-page__empty-icon">
                            🌾
                        </span>

                        <strong>
                            No AgroStores found
                        </strong>

                        <span>
                            No AgroStores are currently assigned
                            to this dairy farm.
                        </span>

                    </div>

                <% } %>

            </div>

        </section>


        <!-- ==================================================
             TOOLS
        =================================================== -->

        <section
            id="assetTools"
            class="asset-page__section"
            data-asset-section="tools"
            role="tabpanel"
            aria-labelledby="assetToolsTab"
            hidden
        >

            <div class="asset-page__section-heading">

                <div>

                    <span class="asset-page__section-eyebrow">
                        FARM EQUIPMENT
                    </span>

                    <h2>
                        Tools
                    </h2>

                </div>

                <span class="asset-page__section-count">
                    <%= toolDairies.length %>
                </span>

            </div>


            <div class="asset-page__grid">

                <% if (toolDairies.length > 0) { %>

                    <% toolDairies.forEach(tool => { %>

                        <a
                            href="/dairy/<%= tool._id %>"
                            class="asset-page__card"
                            data-asset-id="<%= tool._id %>"
                            data-asset-type="tool"
                        >

                            <div class="asset-page__card-image">

                                <% if (tool.displayImage) { %>

                                    <img
                                        src="<%= tool.displayImage %>"
                                        alt="<%= tool.name %>"
                                        loading="lazy"
                                    >

                                <% } else { %>

                                    <span
                                        class="asset-page__placeholder"
                                        aria-hidden="true"
                                    >
                                        🔧
                                    </span>

                                <% } %>

                            </div>


                            <div class="asset-page__card-details">

                                <span class="asset-page__card-name">
                                    <%= tool.name %>
                                </span>


                                <% if (tool.type) { %>

                                    <span class="asset-page__card-meta">
                                        <%= tool.type %>
                                    </span>

                                <% } %>


                                <% if (tool.location) { %>

                                    <span class="asset-page__card-meta">
                                        <%= tool.location %>
                                    </span>

                                <% } %>

                            </div>


                            <span
                                class="asset-page__card-arrow"
                                aria-hidden="true"
                            >
                                ›
                            </span>

                        </a>

                    <% }); %>

                <% } else { %>

                    <div class="asset-page__empty">

                        <span class="asset-page__empty-icon">
                            🔧
                        </span>

                        <strong>
                            No tools found
                        </strong>

                        <span>
                            No tools are currently assigned
                            to this dairy farm.
                        </span>

                    </div>

                <% } %>

            </div>

        </section>


    </main>

</div>


<!-- ==========================================================
     ASSET PAGE JAVASCRIPT
========================================================== -->

<script>
(function () {

    "use strict";


    function initializeAssetPage() {

        const page =
            document.getElementById(
                "assetPage"
            );


        if (!page) {

            return;

        }


        const tabs =
            page.querySelectorAll(
                ".asset-page__tab"
            );


        const sections =
            page.querySelectorAll(
                ".asset-page__section"
            );


        const farmSwitchButton =
            document.getElementById(
                "farmSwitchButton"
            );


        const assignedFarmList =
            document.getElementById(
                "assignedFarmList"
            );


        const closeFarmList =
            document.getElementById(
                "closeFarmList"
            );


        /* ==================================================
           CATEGORY SWITCHING
        =================================================== */

        function setCategory(category) {

            if (!category) {

                return;

            }


            tabs.forEach(function (tab) {

                const active =
                    tab.dataset.assetCategory ===
                    category;


                tab.classList.toggle(
                    "is-active",
                    active
                );


                tab.setAttribute(
                    "aria-selected",
                    String(active)
                );

            });


            sections.forEach(function (section) {

                const active =
                    section.dataset.assetSection ===
                    category;


                section.classList.toggle(
                    "is-active",
                    active
                );


                section.hidden =
                    !active;

            });

        }


        /* ==================================================
           CLOSE FARM SWITCHER
        =================================================== */

        function closeFarmSwitcher() {

            if (assignedFarmList) {

                assignedFarmList.hidden =
                    true;

            }


            if (farmSwitchButton) {

                farmSwitchButton.setAttribute(
                    "aria-expanded",
                    "false"
                );

                farmSwitchButton.classList.remove(
                    "is-open"
                );

            }

        }


        /* ==================================================
           TOGGLE FARM SWITCHER
        =================================================== */

        function toggleFarmSwitcher() {

            if (
                !farmSwitchButton ||
                !assignedFarmList
            ) {

                return;

            }


            const shouldOpen =
                assignedFarmList.hidden;


            assignedFarmList.hidden =
                !shouldOpen;


            farmSwitchButton.setAttribute(
                "aria-expanded",
                String(shouldOpen)
            );


            farmSwitchButton.classList.toggle(
                "is-open",
                shouldOpen
            );

        }


        /* ==================================================
           CATEGORY TAB EVENTS
        =================================================== */

        tabs.forEach(function (tab) {

            tab.addEventListener(
                "click",
                function () {

                    const category =
                        tab.dataset.assetCategory;


                    setCategory(
                        category
                    );


                    closeFarmSwitcher();

                }
            );

        });


        /* ==================================================
           FARM SWITCH BUTTON
        =================================================== */

        if (farmSwitchButton) {

            farmSwitchButton.addEventListener(
                "click",
                function (event) {

                    event.preventDefault();

                    event.stopPropagation();

                    toggleFarmSwitcher();

                }
            );

        }


        /* ==================================================
           CLOSE FARM LIST BUTTON
        =================================================== */

        if (closeFarmList) {

            closeFarmList.addEventListener(
                "click",
                function (event) {

                    event.preventDefault();

                    event.stopPropagation();

                    closeFarmSwitcher();

                }
            );

        }


        /* ==================================================
           CLICK OUTSIDE FARM LIST
        =================================================== */

        document.addEventListener(
            "click",
            function (event) {

                if (
                    !assignedFarmList ||
                    assignedFarmList.hidden
                ) {

                    return;

                }


                if (
                    farmSwitchButton &&
                    farmSwitchButton.contains(
                        event.target
                    )
                ) {

                    return;

                }


                if (
                    assignedFarmList.contains(
                        event.target
                    )
                ) {

                    return;

                }


                closeFarmSwitcher();

            }
        );


        /* ==================================================
           ESCAPE KEY
        =================================================== */

        document.addEventListener(
            "keydown",
            function (event) {

                if (
                    event.key === "Escape"
                ) {

                    closeFarmSwitcher();

                }

            }
        );


        /* ==================================================
           INITIAL STATE
        =================================================== */

        setCategory(
            "animals"
        );


        closeFarmSwitcher();

    }


    /* ======================================================
       DOM READY
    ======================================================= */

    if (
        document.readyState ===
        "loading"
    ) {

        document.addEventListener(
            "DOMContentLoaded",
            initializeAssetPage
        );

    } else {

        initializeAssetPage();

    }

})();
</script>


