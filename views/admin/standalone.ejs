</style>


<!-- ==========================================================
     STANDALONE ASSETS SECTION
========================================================== -->

<section
    class="standalone-assets-section"
    aria-label="Standalone assets"
>


    <!-- ======================================================
         HEADER
    ======================================================= -->

    <header
        class="standalone-assets-header"
    >


        <div
            class="standalone-assets-heading"
        >


            <h2
                class="standalone-assets-title"
            >

                Standalone Assets

            </h2>


            <p
                class="standalone-assets-description"
            >

                Assets not assigned to another asset

            </p>


        </div>


        <span
            class="standalone-assets-status-label"
        >

            <span
                class="standalone-assets-status-dot"
                aria-hidden="true"
            ></span>

            Assets

        </span>


    </header>



    <!-- ======================================================
         HORIZONTAL STORIES ROW

         Cards remain in ONE horizontal row.

         They never wrap.

         Users can swipe:

             ← LEFT
             RIGHT →

         on mobile.
    ======================================================= -->

    <div
        class="standalone-assets-scroller"
        role="list"
        aria-label="Standalone assets"
    >


        <% if (
            standaloneAssetList.length > 0
        ) { %>


            <% standaloneAssetList.forEach(
                function (dairy) {

                    if (
                        !dairy ||
                        !dairy._id
                    ) {

                        return;

                    }


                    /* ==========================================
                       ASSET NAME
                    =========================================== */

                    const assetName =
                        dairy.name ||
                        "Unnamed Asset";


                    /* ==========================================
                       PROFILE IMAGE
                    =========================================== */

                    let assetImage =
                        "";


                    if (
                        dairy.profileImage &&
                        String(
                            dairy.profileImage
                        ).trim()
                    ) {

                        assetImage =
                            String(
                                dairy.profileImage
                            ).trim();

                    }


                    /* ==========================================
                       FALLBACK PROFILE IMAGE
                    =========================================== */

                    if (
                        !assetImage &&
                        Array.isArray(
                            dairy.profileImages
                        ) &&
                        dairy.profileImages.length > 0
                    ) {

                        const firstImage =
                            dairy.profileImages[0];


                        if (
                            firstImage &&
                            String(
                                firstImage
                            ).trim()
                        ) {

                            assetImage =
                                String(
                                    firstImage
                                ).trim();

                        }

                    }


                    /* ==========================================
                       AVATAR LETTER
                    =========================================== */

                    const avatarLetter =
                        String(
                            assetName
                        )
                            .trim()
                            .charAt(0)
                            .toUpperCase() ||
                        "A";

            %>


                <!-- ==========================================
                     ASSET STORY CARD
                =========================================== -->

                <a
                    href="/dairy/<%= dairy._id %>"
                    class="standalone-asset-card"
                    role="listitem"
                    aria-label="Open <%= assetName %>"
                >


                    <!-- ======================================
                         IMAGE / AVATAR
                    ======================================= -->

                    <% if (assetImage) { %>


                        <img
                            src="<%= assetImage %>"
                            alt="<%= assetName %>"
                            class="standalone-asset-image"
                            loading="lazy"
                        >


                    <% } else { %>


                        <span
                            class="standalone-asset-avatar"
                            aria-hidden="true"
                        >

                            <%= avatarLetter %>

                        </span>


                    <% } %>



                    <!-- ======================================
                         IMAGE OVERLAY
                    ======================================= -->

                    <span
                        class="standalone-asset-overlay"
                        aria-hidden="true"
                    ></span>



                    <!-- ======================================
                         STORY-STYLE STATUS RING
                    ======================================= -->

                    <span
                        class="standalone-asset-status"
                        aria-hidden="true"
                    >


                        <span
                            class="standalone-asset-status-inner"
                        >


                            <% if (assetImage) { %>


                                <img
                                    src="<%= assetImage %>"
                                    alt=""
                                >


                            <% } else { %>


                                <span
                                    class="standalone-asset-status-avatar"
                                >

                                    <%= avatarLetter %>

                                </span>


                            <% } %>


                        </span>


                    </span>



                    <!-- ======================================
                         ASSET INFORMATION

                         ONLY ASSET NAME IS DISPLAYED.
                    ======================================= -->

                    <span
                        class="standalone-asset-info"
                    >


                        <span
                            class="standalone-asset-name"
                        >

                            <%= assetName %>

                        </span>


                    </span>


                </a>


            <% }); %>


        <% } else { %>


            <!-- ==============================================
                 EMPTY STATE
            =============================================== -->

            <div
                class="standalone-assets-empty"
                role="status"
            >


                <span
                    class="standalone-assets-empty-icon"
                    aria-hidden="true"
                >

                    +

                </span>


                <span>

                    No standalone assets found.

                </span>


            </div>


        <% } %>


    </div>


</section>