<%
/* ==========================================================
   ADMIN STANDALONE ASSET CARDS

   FILE:
       views/admin/standalone.ejs

   PURPOSE:
       Horizontal, left/right scrollable cards for standalone
       structures / manual assets.

   STANDALONE RULE:
       recordType === "structure"
       AND
       code === null
       AND
       assetCode === null

   EXISTING ASSET:
       /dairy/:id

   FIRST CARD:
       /add
========================================================== */


const sourceAssets =
    Array.isArray(standaloneAssets)
        ? standaloneAssets
        : (
            Array.isArray(assets)
                ? assets
                : []
        );


const standaloneRecords =
    sourceAssets.filter(function (item) {

        if (!item) {
            return false;
        }

        const recordType =
            String(
                item.recordType || ""
            )
                .trim()
                .toLowerCase();

        const codeIsNull =
            item.code === null ||
            item.code === undefined;

        const assetCodeIsNull =
            item.assetCode === null ||
            item.assetCode === undefined;

        return (
            recordType === "structure" &&
            codeIsNull &&
            assetCodeIsNull
        );

    });
%>


<section
    class="admin-standalone-strip"
    aria-label="Standalone assets"
>

    <!-- ======================================================
         HEADER
    ======================================================= -->

    <div class="admin-standalone-strip-header">

        <div class="admin-standalone-strip-title">

            <strong>
                Standalone Assets
            </strong>

        </div>

        <div class="admin-standalone-strip-description">

            View and manage structures and assets that are not
            assigned to a dairy farm.

        </div>

    </div>


    <!-- ======================================================
         HORIZONTAL SCROLL
    ======================================================= -->

    <div
        class="admin-standalone-scroll"
        role="list"
        aria-label="Standalone assets"
    >


        <!-- ==================================================
             ADD ASSET CARD
        ================================================== -->

        <a
            href="/add"
            class="admin-standalone-card admin-standalone-add-card"
            role="listitem"
            aria-label="Add a standalone asset"
        >

            <div class="admin-standalone-add-icon">
                +
            </div>

            <div class="admin-standalone-add-title">
                Add Asset
            </div>

            <div class="admin-standalone-add-text">
                Create a standalone asset
            </div>

        </a>



        <!-- ==================================================
             EXISTING STANDALONE ASSETS
        ================================================== -->

        <% standaloneRecords.forEach(function (asset) { %>

            <%
                if (
                    !asset ||
                    !asset._id
                ) {
                    return;
                }


                const assetName =
                    asset.name ||
                    "Unnamed Asset";


                const assetImage =
                    asset.displayImage ||
                    asset.profileImage ||
                    (
                        "https://ui-avatars.com/api/?name=" +
                        encodeURIComponent(
                            assetName
                        ) +
                        "&background=e8f5ee&color=198754"
                    );


                const assetType =
                    asset.type
                        ? String(asset.type)
                        : "Asset";


                const assetCondition =
                    asset.condition
                        ? String(asset.condition)
                        : "";
            %>


            <a
                href="/dairy/<%= dairy._id/addOns %>"
                class="admin-standalone-card"
                role="listitem"
                aria-label="Open <%= assetName %>"
            >

                <div class="admin-standalone-image-wrap">

                    <img
                        src="<%= assetImage %>"
                        alt="<%= assetName %>"
                        class="admin-standalone-image"
                        loading="lazy"
                    >

                </div>


                <div class="admin-standalone-content">

                    <div class="admin-standalone-name">
                        <%= assetName %>
                    </div>


                    <div class="admin-standalone-type">

                        <span
                            class="admin-standalone-type-icon"
                            aria-hidden="true"
                        >
                            🧰
                        </span>

                        <span>
                            <%= assetType %>
                        </span>

                    </div>


                    <% if (assetCondition) { %>

                        <div class="admin-standalone-condition">

                            <span class="admin-standalone-condition-label">
                                Condition:
                            </span>

                            <span>
                                <%= assetCondition %>
                            </span>

                        </div>

                    <% } %>

                </div>

            </a>

        <% }); %>


    </div>

</section>



<style>

/* ==========================================================
   STANDALONE STRIP
========================================================== */

.admin-standalone-strip {

    width: 100%;

    margin: 0 0 18px;

    padding: 0;

    overflow: hidden;

    font-family:
        Arial,
        Helvetica,
        sans-serif;

}


/* ==========================================================
   HEADER
========================================================== */

.admin-standalone-strip-header {

    width: 100%;

    padding:
        0
        2px
        10px;

}


.admin-standalone-strip-title strong {

    display: block;

    color: #202520;

    font-size: 18px;

    font-weight: 700;

    line-height: 1.35;

}


.admin-standalone-strip-description {

    max-width: 620px;

    margin-top: 4px;

    color: #7b847e;

    font-size: 12px;

    line-height: 1.45;

}


/* ==========================================================
   HORIZONTAL SCROLL
========================================================== */

.admin-standalone-scroll {

    width: 100%;

    display: flex;

    gap: 10px;

    overflow-x: auto;

    overflow-y: hidden;

    padding:
        2px
        2px
        8px;

    scroll-behavior: smooth;

    -webkit-overflow-scrolling: touch;

    scrollbar-width: none;

}


.admin-standalone-scroll::-webkit-scrollbar {

    display: none;

}


/* ==========================================================
   CARD
========================================================== */

.admin-standalone-card {

    position: relative;

    flex:
        0 0
        116px;

    width: 116px;

    height: 190px;

    display: flex;

    flex-direction: column;

    overflow: hidden;

    flex-shrink: 0;

    text-decoration: none;

    border:
        1px solid
        #e4e9e6;

    border-radius: 15px;

    background: #ffffff;

    box-shadow:
        0 2px 8px
        rgba(20, 40, 28, .06);

    transition:
        transform .16s ease,
        box-shadow .16s ease;

}


.admin-standalone-card:hover {

    transform:
        translateY(-2px);

    box-shadow:
        0 5px 14px
        rgba(20, 40, 28, .10);

}


.admin-standalone-card:active {

    transform:
        scale(.97);

}


/* ==========================================================
   IMAGE
========================================================== */

.admin-standalone-image-wrap {

    position: relative;

    width: 100%;

    height: 116px;

    flex:
        0 0
        116px;

    overflow: hidden;

    background: #eef3ef;

}


.admin-standalone-image {

    width: 100%;

    height: 100%;

    display: block;

    object-fit: cover;

}


/* ==========================================================
   CONTENT
========================================================== */

.admin-standalone-content {

    width: 100%;

    min-width: 0;

    display: flex;

    flex-direction: column;

    flex: 1;

}


/* ==========================================================
   NAME
========================================================== */

.admin-standalone-name {

    width: 100%;

    padding:
        8px
        8px
        2px;

    color: #202520;

    font-size: 13px;

    font-weight: 700;

    line-height: 16px;

    overflow: hidden;

    display: -webkit-box;

    -webkit-box-orient: vertical;

    -webkit-line-clamp: 2;

}


/* ==========================================================
   TYPE
========================================================== */

.admin-standalone-type {

    width: 100%;

    display: flex;

    align-items: center;

    gap: 4px;

    padding:
        1px
        8px
        3px;

    color: #7b847e;

    font-size: 10px;

    line-height: 13px;

    overflow: hidden;

}


.admin-standalone-type-icon {

    flex:
        0 0
        auto;

    font-size: 10px;

}


.admin-standalone-type span:last-child {

    min-width: 0;

    overflow: hidden;

    text-overflow: ellipsis;

    white-space: nowrap;

}


/* ==========================================================
   CONDITION
========================================================== */

.admin-standalone-condition {

    width: 100%;

    display: flex;

    align-items: baseline;

    gap: 3px;

    padding:
        1px
        8px
        8px;

    color: #198754;

    font-size: 10px;

    font-weight: 600;

    line-height: 13px;

    overflow: hidden;

}


.admin-standalone-condition-label {

    flex:
        0 0
        auto;

    color: #8a938d;

    font-weight: 400;

}


.admin-standalone-condition > span:last-child {

    min-width: 0;

    overflow: hidden;

    text-overflow: ellipsis;

    white-space: nowrap;

}


/* ==========================================================
   ADD CARD
========================================================== */

.admin-standalone-add-card {

    align-items: center;

    justify-content: center;

    text-align: center;

    padding: 12px;

    border:
        1px dashed
        #b9cfc1;

    background:
        #f7fbf8;

}


.admin-standalone-add-icon {

    width: 42px;

    height: 42px;

    display: flex;

    align-items: center;

    justify-content: center;

    margin-bottom: 9px;

    border-radius: 50%;

    background: #e8f5ee;

    color: #198754;

    font-size: 27px;

    font-weight: 400;

    line-height: 1;

}


.admin-standalone-add-title {

    color: #202520;

    font-size: 13px;

    font-weight: 700;

    line-height: 16px;

}


.admin-standalone-add-text {

    margin-top: 4px;

    color: #7b847e;

    font-size: 10px;

    line-height: 13px;

}


/* ==========================================================
   FOCUS
========================================================== */

.admin-standalone-card:focus-visible {

    outline:
        2px solid
        #198754;

    outline-offset: 2px;

}


/* ==========================================================
   MOBILE
========================================================== */

@media (max-width: 600px) {

    .admin-standalone-card {

        flex-basis: 112px;

        width: 112px;

        height: 184px;

        border-radius: 14px;

    }


    .admin-standalone-image-wrap {

        height: 112px;

        flex-basis: 112px;

    }


    .admin-standalone-name {

        padding:
            7px
            7px
            2px;

        font-size: 12px;

        line-height: 15px;

    }


    .admin-standalone-type {

        padding:
            1px
            7px
            3px;

        font-size: 9px;

    }


    .admin-standalone-condition {

        padding:
            1px
            7px
            7px;

        font-size: 9px;

    }

}

</style>