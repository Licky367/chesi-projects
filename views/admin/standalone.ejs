<% /*
==============================================================
STANDALONE DAIRY ASSETS
==============================================================

FILE:
    views/admin/standalone.ejs

PURPOSE:
    Reusable EJS partial displaying standalone Dairy
    assets as WhatsApp / Facebook / Instagram
    Stories-style horizontal cards.

IDENTIFICATION:

    dairy.assetCode === null
        = Standalone asset

    dairy.assetCode === undefined
        = Standalone asset

    dairy.assetCode !== null
    AND
    dairy.assetCode !== undefined
        = Assigned asset
        = NOT displayed here

IMPORTANT:

    Standalone status is determined ONLY by assetCode.

    dairy.code is NOT used to determine standalone status.

STANDALONE ASSETS MAY BE:

    • Animals
    • Structures
    • Facilities
    • Equipment

FINANCIAL INFORMATION:

    This partial contains NO financial information.

    It does NOT use:

        currentWorth
        assetWorth
        value
        price
        netWorth

    The cards display only:

        • Image
        • Asset name

LINK:

    /dairy/:id

DESIGN:

    • Greenish theme
    • Story-style vertical cards
    • Horizontal left-to-right scrolling
    • Touch friendly
    • Scroll snapping
    • Image focused
    • Green status ring
    • Responsive sizing
    • No visible scrollbar

CARD SIZES:

    Mobile:
        108px × 150px

    Very small screens:
        102px × 144px

    Laptop / desktop:
        116px × 164px

IMPORTANT:

    This is a PARTIAL.

    It is intended to be included
    inside another view.

==============================================================
*/ %>


<%
/* ==========================================================
   SAFE ASSET ARRAY
==========================================================

   typeof is important here.

   If the controller does not provide standaloneAssets,
   EJS will NOT throw:

       standaloneAssets is not defined

   Instead, an empty array is used.
========================================================== */

const standaloneAssetSource =
    typeof standaloneAssets !== "undefined" &&
    Array.isArray(standaloneAssets)

        ? standaloneAssets

        : [];


/* ==========================================================
   FILTER STANDALONE ASSETS
==========================================================

   STANDALONE DEFINITION:

       assetCode === null
       OR
       assetCode === undefined

   IMPORTANT:

       dairy.code is deliberately NOT checked.

   Therefore an asset may have:

       code > 0
       code < 0
       code === 0

   and STILL be standalone if assetCode
   is missing.
========================================================== */

const standaloneAssetList =
    standaloneAssetSource.filter(
        function (dairy) {

            if (!dairy) {

                return false;

            }


            return (
                dairy.assetCode === null ||
                dairy.assetCode === undefined
            );

        }
    );

%>


<style>

