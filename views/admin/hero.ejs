<% /*

ADMIN PLATFORM HERO

FILE:
views/admin/hero.ejs

PURPOSE:
General welcome hero section for the Admin platform.

IMPORTANT:
This is NOT a dairy-specific section.

It does not use:
    dairy.name
    dairy.code
    or any other dairy data.

DATA REQUIRED:
user

*/ %>

<section
    class="admin-hero"
    aria-label="Admin Welcome"
><!-- =================================================
     BACKGROUND LOGO
================================================== -->

<div
    class="admin-hero-background"
    aria-hidden="true"
>

    <img
        src="/images/h1.png"
        alt=""
        class="admin-hero-logo"
    >

</div>


<!-- =================================================
     CONTENT
================================================== -->

<div class="admin-hero-content">

    <div class="admin-hero-label">

        <span class="admin-hero-label-line"></span>

        <span>ADMINISTRATOR</span>

        <span class="admin-hero-label-line"></span>

    </div>


    <h1 class="admin-hero-title">

        Welcome,
        <span>
            <%= user && user.name
                ? user.name
                : "Admin" %>
        </span>

    </h1>


    <div class="admin-hero-message">

        <p>
            Welcome to your administration
            platform.
        </p>

        <p>
            Go through this platform and
            manage your activities here.
        </p>

        <p>
            Monitor activities, manage records,
            keep information updated, and use
            the available tools to keep everything
            organized.
        </p>

    </div>

</div>

</section><style>

/* =========================================================
   MAIN SECTION
========================================================= */

.admin-hero {

    position: relative;

    width: 100%;

    min-height: 390px;

    margin: 0 0 28px;

    overflow: hidden;

    background: #fff;

}


/* =========================================================
   BACKGROUND
========================================================= */

.admin-hero-background {

    position: absolute;

    inset: 0;

    z-index: 0;

    display: flex;

    align-items: center;

    justify-content: center;

    overflow: hidden;

    pointer-events: none;

}


.admin-hero-logo {

    display: block;

    width: min(720px, 105vw);

    height: auto;

    opacity: .11;

}


/* =========================================================
   CONTENT
========================================================= */

.admin-hero-content {

    position: relative;

    z-index: 2;

    width: 100%;

    max-width: 1180px;

    min-height: 390px;

    margin: 0 auto;

    padding:
        38px
        clamp(20px, 5vw, 65px)
        34px;

    box-sizing: border-box;

    display: flex;

    flex-direction: column;

    justify-content: center;

    align-items: flex-start;

}


/* =========================================================
   LABEL
========================================================= */

.admin-hero-label {

    display: flex;

    align-items: center;

    gap: 9px;

    margin-bottom: 12px;

    color: #426b4d;

    font-family:
        Arial,
        Helvetica,
        sans-serif;

    font-size: 9px;

    font-weight: 800;

    letter-spacing: 2.5px;

}


.admin-hero-label-line {

    width: 27px;

    height: 1px;

    background:
        rgba(66, 107, 77, .65);

}


/* =========================================================
   TITLE
========================================================= */

.admin-hero-title {

    max-width: 820px;

    margin: 0;

    color: #263d2d;

    font-family:
        Georgia,
        "Times New Roman",
        serif;

    font-size:
        clamp(34px, 4.5vw, 56px);

    line-height: 1.02;

    letter-spacing: -1.3px;

    font-weight: 700;

}


.admin-hero-title span {

    display: block;

    margin-top: 4px;

    color: #3d6849;

}


/* =========================================================
   MESSAGE
========================================================= */

.admin-hero-message {

    max-width: 650px;

    margin-top: 19px;

}


.admin-hero-message p {

    margin: 0 0 7px;

    color:
        rgba(39, 58, 45, .84);

    font-family:
        Arial,
        Helvetica,
        sans-serif;

    font-size:
        clamp(12px, 1.35vw, 14px);

    line-height: 1.55;

    font-weight: 400;

}


.admin-hero-message p:last-child {

    margin-bottom: 0;

}


/* =========================================================
   TABLETS
========================================================= */

@media (max-width: 900px) {

    .admin-hero {

        min-height: 365px;

    }

    .admin-hero-content {

        min-height: 365px;

        padding:
            34px
            28px
            30px;

    }

    .admin-hero-logo {

        width: min(650px, 110vw);

    }

}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 650px) {

    .admin-hero {

        min-height: 400px;

        margin-bottom: 22px;

    }

    .admin-hero-content {

        min-height: 400px;

        padding:
            30px
            20px
            28px;

    }

    .admin-hero-logo {

        width: 520px;

        max-width: 130vw;

        opacity: .10;

    }

    .admin-hero-label {

        margin-bottom: 10px;

        font-size: 8px;

        letter-spacing: 2px;

    }

    .admin-hero-title {

        font-size:
            clamp(30px, 9vw, 41px);

        letter-spacing: -.8px;

    }

    .admin-hero-title span {

        margin-top: 3px;

    }

    .admin-hero-message {

        margin-top: 17px;

    }

    .admin-hero-message p {

        font-size: 12.5px;

        line-height: 1.55;

        margin-bottom: 6px;

    }

}


/* =========================================================
   VERY SMALL PHONES
========================================================= */

@media (max-width: 380px) {

    .admin-hero {

        min-height: 385px;

    }

    .admin-hero-content {

        min-height: 385px;

        padding:
            27px
            16px
            25px;

    }

    .admin-hero-title {

        font-size: 29px;

    }

    .admin-hero-message {

        margin-top: 15px;

    }

    .admin-hero-message p {

        font-size: 12px;

        line-height: 1.5;

    }

    .admin-hero-logo {

        width: 470px;

    }

}

</style>