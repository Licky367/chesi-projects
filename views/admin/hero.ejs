<% /*
==========================================================
DAIRY MANAGEMENT INTRODUCTION / H1

FILE:
    views/update/h1.ejs

PURPOSE:
    Premium editorial introductory section for the
    dairy management dashboard.

DATA REQUIRED:
    user
==========================================================
*/ %>

<section
    class="dairy-h1"
    aria-label="Management Introduction"
>

    <!-- ==================================================
         BACKGROUND LOGO
    =================================================== -->

    <div
        class="dairy-h1-background"
        aria-hidden="true"
    >
        <img
            src="/images/h1.png"
            alt=""
            class="dairy-h1-logo"
        >
    </div>


    <!-- ==================================================
         DECORATIVE ACCENTS
    =================================================== -->

    <div
        class="dairy-h1-accent"
        aria-hidden="true"
    ></div>

    <div
        class="dairy-h1-glow dairy-h1-glow-one"
        aria-hidden="true"
    ></div>

    <div
        class="dairy-h1-glow dairy-h1-glow-two"
        aria-hidden="true"
    ></div>


    <!-- ==================================================
         CONTENT
    =================================================== -->

    <div class="dairy-h1-content">

        <!-- ==============================================
             TOP LABEL
        =============================================== -->

        <div class="dairy-h1-label">

            <span class="dairy-h1-label-line"></span>

            <span class="dairy-h1-label-text">
                MANAGEMENT
            </span>

            <span class="dairy-h1-label-line"></span>

        </div>


        <!-- ==============================================
             WELCOME
        =============================================== -->

        <h1 class="dairy-h1-title">

            <span class="dairy-h1-title-intro">
                Welcome,
            </span>

            <span class="dairy-h1-title-name">
                <%= user && user.name ? user.name : "User" %>
            </span>

        </h1>


        <!-- ==============================================
             MANAGEMENT MESSAGE
        =============================================== -->

        <div class="dairy-h1-message">

            <p>
                Welcome to your management space.
                We're glad to have you here.
            </p>

            <p>
                Keep management information up to date
                and ensure that activities, records, assets,
                welfare, maintenance, and other operations
                are properly monitored.
            </p>

            <p>
                Review updates regularly and keep the
                relevant information current to support
                effective management and decision-making.
            </p>

        </div>


        <!-- ==============================================
             BOTTOM DETAIL
        =============================================== -->

        <div class="dairy-h1-footer">

            <span class="dairy-h1-footer-line"></span>

            <span>
                MANAGEMENT
            </span>

            <span class="dairy-h1-footer-dot"></span>

            <span>
                OPERATIONS
            </span>

        </div>

    </div>

</section>


<style>

/* =========================================================
   MAIN SECTION
========================================================= */

.dairy-h1 {

    position: relative;

    width: 100%;

    min-height: 410px;

    margin: 0 0 30px;

    overflow: hidden;

    isolation: isolate;

    background:
        linear-gradient(
            135deg,
            #ffffff 0%,
            #f9fcfa 52%,
            #f1f8f3 100%
        );

    border: 1px solid #e2ebe4;

    border-radius: 24px;

    box-shadow:
        0 12px 35px rgba(24, 63, 37, .07),
        0 2px 8px rgba(24, 63, 37, .04);

}


/* =========================================================
   LEFT ACCENT
========================================================= */

.dairy-h1-accent {

    position: absolute;

    top: 0;
    left: 0;
    bottom: 0;

    width: 6px;

    z-index: 5;

    background:
        linear-gradient(
            to bottom,
            #0b5d1e,
            #2d8a48,
            #0b5d1e
        );

}


/* =========================================================
   BACKGROUND LOGO
========================================================= */

.dairy-h1-background {

    position: absolute;

    inset: 0;

    z-index: 0;

    display: flex;

    align-items: center;

    justify-content: flex-end;

    padding-right: 4%;

    overflow: hidden;

    pointer-events: none;

}


.dairy-h1-logo {

    display: block;

    width: min(610px, 62vw);

    height: auto;

    opacity: .075;

    filter:
        saturate(.7)
        contrast(.9);

    transform:
        rotate(-3deg)
        translateX(3%);

}


/* =========================================================
   DECORATIVE GLOW
========================================================= */

.dairy-h1-glow {

    position: absolute;

    z-index: 0;

    border-radius: 50%;

    pointer-events: none;

    filter: blur(2px);

}


.dairy-h1-glow-one {

    width: 230px;
    height: 230px;

    right: -90px;
    top: -100px;

    background:
        rgba(42, 130, 65, .07);

}


.dairy-h1-glow-two {

    width: 180px;
    height: 180px;

    left: -90px;
    bottom: -100px;

    background:
        rgba(11, 93, 30, .045);

}


/* =========================================================
   CONTENT
========================================================= */

.dairy-h1-content {

    position: relative;

    z-index: 3;

    width: 100%;

    max-width: 1180px;

    min-height: 410px;

    margin: 0 auto;

    padding:
        45px
        clamp(25px, 6vw, 72px)
        34px 48px;

    box-sizing: border-box;

    display: flex;

    flex-direction: column;

    justify-content: center;

    align-items: flex-start;

}


/* =========================================================
   LABEL
========================================================= */

.dairy-h1-label {

    display: flex;

    align-items: center;

    gap: 10px;

    margin-bottom: 15px;

}


.dairy-h1-label-line {

    width: 30px;

    height: 2px;

    border-radius: 5px;

    background: #0b5d1e;

    opacity: .7;

}


.dairy-h1-label-text {

    color: #397149;

    font-family:
        Arial,
        Helvetica,
        sans-serif;

    font-size: 9px;

    font-weight: 800;

    letter-spacing: 2.8px;

}


/* =========================================================
   TITLE
========================================================= */

.dairy-h1-title {

    max-width: 850px;

    margin: 0;

    font-family:
        Georgia,
        "Times New Roman",
        serif;

    font-weight: 700;

    line-height: 1;

    letter-spacing: -1.8px;

}


.dairy-h1-title-intro {

    display: block;

    color: #263c2d;

    font-size:
        clamp(32px, 4.3vw, 52px);

}


.dairy-h1-title-name {

    display: block;

    margin-top: 7px;

    color: #0b5d1e;

    font-size:
        clamp(37px, 5.2vw, 64px);

    line-height: 1.02;

    text-wrap: balance;

}


/* =========================================================
   MESSAGE
========================================================= */

.dairy-h1-message {

    max-width: 650px;

    margin-top: 22px;

    padding-left: 15px;

    border-left:
        2px solid
        rgba(11, 93, 30, .16);

}


.dairy-h1-message p {

    margin: 0 0 8px;

    color:
        rgba(39, 58, 45, .82);

    font-family:
        Arial,
        Helvetica,
        sans-serif;

    font-size:
        clamp(12px, 1.35vw, 14px);

    line-height: 1.6;

    font-weight: 400;

}


.dairy-h1-message p:last-child {

    margin-bottom: 0;

}


/* =========================================================
   FOOTER DETAIL
========================================================= */

.dairy-h1-footer {

    display: flex;

    align-items: center;

    gap: 8px;

    margin-top: 25px;

    color: #789080;

    font-family:
        Arial,
        Helvetica,
        sans-serif;

    font-size: 7px;

    font-weight: 800;

    letter-spacing: 1.4px;

}


.dairy-h1-footer-line {

    width: 25px;

    height: 1px;

    background: #9ab2a0;

}


.dairy-h1-footer-dot {

    width: 3px;
    height: 3px;

    border-radius: 50%;

    background: #4b7957;

}


/* =========================================================
   TABLETS
========================================================= */

@media (max-width: 900px) {

    .dairy-h1 {

        min-height: 390px;

        border-radius: 20px;

    }

    .dairy-h1-content {

        min-height: 390px;

        padding:
            38px
            32px
            30px
            38px;

    }

    .dairy-h1-logo {

        width: 560px;

        max-width: 75vw;

    }

}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 650px) {

    .dairy-h1 {

        min-height: 430px;

        margin-bottom: 22px;

        border-radius: 18px;

    }


    .dairy-h1-accent {

        width: 4px;

    }


    .dairy-h1-content {

        min-height: 430px;

        padding:
            31px
            21px
            26px
            25px;

    }


    .dairy-h1-background {

        align-items: flex-end;

        justify-content: center;

        padding: 0;

    }


    .dairy-h1-logo {

        width: 480px;

        max-width: 125vw;

        opacity: .065;

        transform:
            rotate(-3deg)
            translateY(15%);

    }


    .dairy-h1-label {

        gap: 7px;

        margin-bottom: 12px;

    }


    .dairy-h1-label-line {

        width: 21px;

    }


    .dairy-h1-label-text {

        font-size: 7.5px;

        letter-spacing: 2.1px;

    }


    .dairy-h1-title-intro {

        font-size:
            clamp(29px, 8.5vw, 39px);

    }


    .dairy-h1-title-name {

        margin-top: 5px;

        font-size:
            clamp(34px, 10vw, 47px);

        letter-spacing: -1px;

    }


    .dairy-h1-message {

        max-width: 100%;

        margin-top: 18px;

        padding-left: 12px;

    }


    .dairy-h1-message p {

        font-size: 12.2px;

        line-height: 1.58;

        margin-bottom: 7px;

    }


    .dairy-h1-footer {

        margin-top: 19px;

        font-size: 6.5px;

        letter-spacing: 1.1px;

    }

}


/* =========================================================
   VERY SMALL PHONES
========================================================= */

@media (max-width: 380px) {

    .dairy-h1 {

        min-height: 415px;

    }


    .dairy-h1-content {

        min-height: 415px;

        padding:
            27px
            17px
            23px
            21px;

    }


    .dairy-h1-title-intro {

        font-size: 28px;

    }


    .dairy-h1-title-name {

        font-size: 32px;

    }


    .dairy-h1-message {

        margin-top: 16px;

    }


    .dairy-h1-message p {

        font-size: 11.5px;

        line-height: 1.5;

    }


    .dairy-h1-footer {

        margin-top: 16px;

        font-size: 6px;

    }


    .dairy-h1-logo {

        width: 440px;

    }

}


/* =========================================================
   REDUCED MOTION
========================================================= */

@media (prefers-reduced-motion: reduce) {

    .dairy-h1,
    .dairy-h1-logo {

        transition: none;

    }

}

</style>