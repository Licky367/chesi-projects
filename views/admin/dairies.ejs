<% /*
==============================================================
DAIRY FARM HORIZONTAL STATUS CARDS
==============================================================

FILE:
    views/admin/dairies.ejs

PURPOSE:
    Reusable EJS partial displaying Dairy Farms in a
    WhatsApp / Facebook / Instagram Stories-style
    horizontal scrollable card row.

CARD ORDER:

    1. Add Dairy Farm
       → /add

    2. Existing Dairy Farms
       → /dairy/:id

DATA:

    dairies
        Supplied by dashboardController.

IDENTITY:

    Dairy Farm:
        code < 0

PROFILE IMAGE:

    1. profileImage
    2. profileImages[0]
    3. Generated avatar

DESIGN:

    • Greenish theme
    • Story-style vertical cards
    • Mobile card:
          108px × 150px
    • Horizontal scrolling
    • Touch-friendly
    • Scroll snapping
    • No visible scrollbar
    • Responsive laptop sizing
    • Very-small-screen adjustment

IMPORTANT:

    This is a PARTIAL.

    It is intended to be included inside another view.

==============================================================
*/ %>


<%
/* ==========================================================
   SAFE DAIRY ARRAY
========================================================== */

const dairyFarmSource =
    Array.isArray(dairies)
        ? dairies
        : [];


/* ==========================================================
   FILTER DAIRY FARMS

   Dairy Farm:
       code < 0
========================================================== */

const dairyFarms =
    dairyFarmSource.filter(
        function (dairy) {

            if (!dairy) {

                return false;

            }


            if (
                dairy.code === null ||
                dairy.code === undefined
            ) {

                return false;

            }


            return (
                Number(dairy.code) < 0
            );

        }
    );

%>


