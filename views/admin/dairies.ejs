<%
/* ==========================================================
   ADMIN DAIRY FARM CARDS

   FILE:
       views/admin/dairies.ejs

   PURPOSE:
       Display ALL Dairy Farms as horizontal,
       left/right scrollable cards.

   FARM IDENTITY:
   ----------------------------------------------------------
       A Dairy Farm is identified by:

           code < 0

   IMPORTANT:
   ----------------------------------------------------------
       Negative code is the authoritative farm identity.

       We intentionally do NOT require:

           recordType === "farm"

       because all negative-code Dairy records are farms.

   EXISTING FARM:
       /dairy/:id

   FIRST CARD:
       /add
========================================================== */


const sourceDairies =
    Array.isArray(dairies)
        ? dairies
        : (
            Array.isArray(dairyFarms)
                ? dairyFarms
                : []
        );


/* ==========================================================
   ALL NEGATIVE-CODE DAIRY FARMS
========================================================== */

const farmRecords =
    sourceDairies.filter(function (item) {

        if (!item) {

            return false;

        }


        const code =
            Number(item.code);


        return (

            Number.isInteger(code) &&
            code < 0

        );

    });

%>


<section
    class="admin-dairy-strip"
    aria-label="Dairy farms"
>


    <!-- ======================================================
         HEADER
    ======================================================= -->

    <div class="admin-dairy-strip-header">

        <div class="admin-dairy-strip-title">

            <strong>
                Dairy Farms
            </strong>

        </div>


        <div class="admin-dairy-strip-description">

            View and manage all dairy farms in the system.

        </div>

    </div>



    <!-- ======================================================
         HORIZONTAL SCROLL
    ======================================================= -->

    <div
        class="admin-dairy-scroll"
        role="list"
        aria-label="Dairy farms"
    >


        <!-- ==================================================
             ADD FARM CARD
        =================================================== -->

        <a
            href="/add"
            class="admin-dairy-card admin-dairy-add-card"
            role="listitem"
            aria-label="Add a new dairy farm"
        >

            <div class="admin-dairy-add-icon">
                +
            </div>


            <div class="admin-dairy-add-title">
                Add Dairy Farm
            </div>


            <div class="admin-dairy-add-text">
                Create a new dairy farm
            </div>

        </a>



        <!-- ==================================================
             ALL EXISTING DAIRY FARMS
        =================================================== -->

        <% farmRecords.forEach(function (farm) { %>

            <%

                if (
                    !farm ||
                    !farm._id
                ) {

                    return;

                }


                /* ==============================================
                   FARM NAME
                ============================================== */

                const farmName =
                    String(
                        farm.name ||
                        "Unnamed Dairy Farm"
                    );


                /* ==============================================
                   FARM IMAGE
                ============================================== */

                const farmImage =
                    farm.displayImage ||
                    farm.profileImage ||
                    (
                        "https://ui-avatars.com/api/?name=" +
                        encodeURIComponent(
                            farmName
                        ) +
                        "&background=e8f5ee&color=198754"
                    );


                /* ==============================================
                   FARM TYPE
                ============================================== */

                const farmType =
                    farm.type
                        ? String(
                            farm.type
                        )
                        : "Dairy Farm";


                /* ==============================================
                   NEGATIVE FARM CODE
                ============================================== */

                const farmCode =
                    Number(
                        farm.code
                    );

            %>


            <!-- ==============================================
                 FARM CARD
            =============================================== -->

            <a
                href="/dairy/<%= farm._id %>"
                class="admin-dairy-card"
                role="listitem"
                aria-label="Open <%= farmName %>"
            >


                <!-- ==========================================
                     IMAGE
                =========================================== -->

                <div class="admin-dairy-image-wrap">

                    <img
                        src="<%= farmImage %>"
                        alt="<%= farmName %>"
                        class="admin-dairy-image"
                        loading="lazy"
                    >

                </div>



                <!-- ==========================================
                     CONTENT
                =========================================== -->

                <div class="admin-dairy-content">


                    <!-- ======================================
                         NAME
                    ======================================= -->

                    <div class="admin-dairy-name">

                        <%= farmName %>

                    </div>



                    <!-- ======================================
                         TYPE
                    ======================================= -->

                    <div class="admin-dairy-type">

                        <span
                            class="admin-dairy-type-icon"
                            aria-hidden="true"
                        >
                            🐄
                        </span>


                        <span>
                            <%= farmType %>
                        </span>

                    </div>



                    <!-- ======================================
                         CODE
                    ======================================= -->

                    <div class="admin-dairy-code">

                        <span class="admin-dairy-code-label">
                            Code:
                        </span>


                        <span>
                            <%= farmCode %>
                        </span>

                    </div>


                </div>

            </a>

        <% }); %>


    </div>

</section>



<style>

/* ==========================================================
   ADMIN DAIRY STRIP
========================================================== */

.admin-dairy-strip {

    width: 100%;

    margin: 0 0 18px;

    padding: 0;

    overflow: hidden;

    font-family:
        Arial,
        Helvetica,
        sans-serif;

}


/* ==========================================================
   HEADER
========================================================== */

.admin-dairy-strip-header {

    width: 100%;

    padding:
        0
        2px
        10px;

}


.admin-dairy-strip-title strong {

    display: block;

    color: #202520;

    font-size: 18px;

    font-weight: 700;

    line-height: 1.35;

}


.admin-dairy-strip-description {

    max-width: 620px;

    margin-top: 4px;

    color: #7b847e;

    font-size: 12px;

    line-height: 1.45;

}


/* ==========================================================
   HORIZONTAL SCROLL
========================================================== */

.admin-dairy-scroll {

    width: 100%;

    display: flex;

    gap: 10px;

    overflow-x: auto;

    overflow-y: hidden;

    padding:
        2px
        2px
        8px;

    scroll-behavior: smooth;

    -webkit-overflow-scrolling: touch;

    scrollbar-width: none;

}


.admin-dairy-scroll::-webkit-scrollbar {

    display: none;

}


/* ==========================================================
   CARD
========================================================== */

.admin-dairy-card {

    position: relative;

    flex:
        0 0
        116px;

    width: 116px;

    height: 190px;

    display: flex;

    flex-direction: column;

    overflow: hidden;

    flex-shrink: 0;

    text-decoration: none;

    border:
        1px solid
        #e4e9e6;

    border-radius: 15px;

    background: #ffffff;

    box-shadow:
        0 2px 8px
        rgba(20, 40, 28, .06);

    transition:
        transform .16s ease,
        box-shadow .16s ease;

}


.admin-dairy-card:hover {

    transform:
        translateY(-2px);

    box-shadow:
        0 5px 14px
        rgba(20, 40, 28, .10);

}


.admin-dairy-card:active {

    transform:
        scale(.97);

}


/* ==========================================================
   IMAGE
========================================================== */

.admin-dairy-image-wrap {

    position: relative;

    width: 100%;

    height: 116px;

    flex:
        0 0
        116px;

    overflow: hidden;

    background: #eef3ef;

}


.admin-dairy-image {

    width: 100%;

    height: 100%;

    display: block;

    object-fit: cover;

}


/* ==========================================================
   CONTENT
========================================================== */

.admin-dairy-content {

    width: 100%;

    min-width: 0;

    display: flex;

    flex-direction: column;

    flex: 1;

}


/* ==========================================================
   NAME
========================================================== */

.admin-dairy-name {

    width: 100%;

    padding:
        8px
        8px
        2px;

    color: #202520;

    font-size: 13px;

    font-weight: 700;

    line-height: 16px;

    overflow: hidden;

    display: -webkit-box;

    -webkit-box-orient: vertical;

    -webkit-line-clamp: 2;

}


/* ==========================================================
   TYPE
========================================================== */

.admin-dairy-type {

    width: 100%;

    display: flex;

    align-items: center;

    gap: 4px;

    padding:
        1px
        8px
        3px;

    color: #7b847e;

    font-size: 10px;

    line-height: 13px;

    overflow: hidden;

}


.admin-dairy-type-icon {

    flex:
        0 0
        auto;

    font-size: 10px;

}


.admin-dairy-type span:last-child {

    min-width: 0;

    overflow: hidden;

    text-overflow: ellipsis;

    white-space: nowrap;

}


/* ==========================================================
   CODE
========================================================== */

.admin-dairy-code {

    width: 100%;

    display: flex;

    align-items: baseline;

    gap: 3px;

    padding:
        1px
        8px
        8px;

    color: #198754;

    font-size: 10px;

    font-weight: 600;

    line-height: 13px;

    overflow: hidden;

}


.admin-dairy-code-label {

    flex:
        0 0
        auto;

    color: #8a938d;

    font-weight: 400;

}


/* ==========================================================
   ADD CARD
========================================================== */

.admin-dairy-add-card {

    align-items: center;

    justify-content: center;

    text-align: center;

    padding: 12px;

    border:
        1px dashed
        #b9cfc1;

    background:
        #f7fbf8;

}


.admin-dairy-add-icon {

    width: 42px;

    height: 42px;

    display: flex;

    align-items: center;

    justify-content: center;

    margin-bottom: 9px;

    border-radius: 50%;

    background: #e8f5ee;

    color: #198754;

    font-size: 27px;

    font-weight: 400;

    line-height: 1;

}


.admin-dairy-add-title {

    color: #202520;

    font-size: 13px;

    font-weight: 700;

    line-height: 16px;

}


.admin-dairy-add-text {

    margin-top: 4px;

    color: #7b847e;

    font-size: 10px;

    line-height: 13px;

}


/* ==========================================================
   FOCUS
========================================================== */

.admin-dairy-card:focus-visible {

    outline:
        2px solid
        #198754;

    outline-offset: 2px;

}


/* ==========================================================
   MOBILE
========================================================== */

@media (max-width: 600px) {

    .admin-dairy-card {

        flex-basis: 112px;

        width: 112px;

        height: 184px;

        border-radius: 14px;

    }


    .admin-dairy-image-wrap {

        height: 112px;

        flex-basis: 112px;

    }


    .admin-dairy-name {

        padding:
            7px
            7px
            2px;

        font-size: 12px;

        line-height: 15px;

    }


    .admin-dairy-type {

        padding:
            1px
            7px
            3px;

        font-size: 9px;

    }


    .admin-dairy-code {

        padding:
            1px
            7px
            7px;

        font-size: 9px;

    }

}

</style>