</style>


<!-- ==========================================================
     DAIRY FARMS SECTION
========================================================== -->

<section
    class="dairy-farms-section"
    aria-label="Dairy farms"
>


    <!-- ======================================================
         HEADER
    ======================================================= -->

    <header
        class="dairy-farms-section-header"
    >


        <div
            class="dairy-farms-section-heading"
        >


            <h2
                class="dairy-farms-section-title"
            >

                Dairy Farms

            </h2>


            <p
                class="dairy-farms-section-description"
            >

                Your dairy farms

            </p>


        </div>


        <span
            class="dairy-farms-status-label"
        >

            <span
                class="dairy-farms-status-dot"
                aria-hidden="true"
            ></span>

            Farms

        </span>


    </header>



    <!-- ======================================================
         HORIZONTAL STORIES ROW

         Cards remain in ONE horizontal row.

         They NEVER wrap.

         Mobile:
             108px × 150px

         Very small screens:
             102px × 145px

         Laptop:
             118px × 164px

         Large desktop:
             126px × 176px
    ======================================================= -->

    <div
        class="dairy-farms-scroller"
        role="list"
        aria-label="Dairy farms"
    >


        <!-- ==================================================
             ADD DAIRY FARM
        ================================================== -->

        <a
            href="/add"
            class="dairy-farm-card dairy-farm-add-card"
            role="listitem"
            aria-label="Add Dairy Farm"
        >


            <span
                class="dairy-farm-add-icon"
                aria-hidden="true"
            >

                +

            </span>


            <span
                class="dairy-farm-add-label"
            >

                Add Farm

            </span>


            <span
                class="dairy-farm-add-description"
            >

                Create a new dairy farm

            </span>


        </a>



        <!-- ==================================================
             EXISTING DAIRY FARMS
        ================================================== -->

        <% dairyFarms.forEach(
            function (dairy) {

                if (
                    !dairy ||
                    !dairy._id
                ) {

                    return;

                }


                /* ==============================================
                   FARM NAME
                =============================================== */

                const farmName =
                    dairy.name ||
                    "Dairy Farm";


                /* ==============================================
                   FARM IMAGE
                =============================================== */

                let farmImage =
                    "";


                if (
                    dairy.profileImage &&
                    String(
                        dairy.profileImage
                    ).trim()
                ) {

                    farmImage =
                        String(
                            dairy.profileImage
                        ).trim();

                }


                /* ==============================================
                   FALLBACK IMAGE
                =============================================== */

                if (
                    !farmImage &&
                    Array.isArray(
                        dairy.profileImages
                    ) &&
                    dairy.profileImages.length
                ) {

                    const firstImage =
                        dairy.profileImages[0];


                    if (
                        firstImage &&
                        String(
                            firstImage
                        ).trim()
                    ) {

                        farmImage =
                            String(
                                firstImage
                            ).trim();

                    }

                }


                /* ==============================================
                   GENERATED FALLBACK
                =============================================== */

                if (!farmImage) {

                    farmImage =
                        "https://ui-avatars.com/api/?" +
                        "name=" +
                        encodeURIComponent(
                            farmName
                        ) +
                        "&background=e5f2e7" +
                        "&color=39734a" +
                        "&size=256";

                }

        %>


            <!-- ==============================================
                 FARM STORY CARD
            =============================================== -->

            <a
                href="/dairy/<%= dairy._id %>"
                class="dairy-farm-card"
                role="listitem"
                aria-label="Open <%= farmName %>"
            >


                <!-- ==========================================
                     MAIN IMAGE
                =========================================== -->

                <img
                    src="<%= farmImage %>"
                    alt="<%= farmName %>"
                    class="dairy-farm-card-image"
                    loading="lazy"
                >


                <!-- ==========================================
                     IMAGE OVERLAY
                =========================================== -->

                <span
                    class="dairy-farm-card-overlay"
                    aria-hidden="true"
                ></span>


                <!-- ==========================================
                     STORY-STYLE PROFILE RING
                =========================================== -->

                <span
                    class="dairy-farm-card-status"
                    aria-hidden="true"
                >

                    <span
                        class="dairy-farm-card-status-inner"
                    >

                        <img
                            src="<%= farmImage %>"
                            alt=""
                        >

                    </span>

                </span>


                <!-- ==========================================
                     FARM NAME
                =========================================== -->

                <span
                    class="dairy-farm-card-name"
                >

                    <%= farmName %>

                </span>


            </a>


        <% }); %>



        <!-- ==================================================
             EMPTY STATE
        =================================================== -->

        <% if (
            dairyFarms.length === 0
        ) { %>


            <div
                class="dairy-farms-empty"
                role="status"
            >


                <span
                    class="dairy-farms-empty-icon"
                    aria-hidden="true"
                >

                    +

                </span>


                <span>

                    No Dairy Farms found.

                </span>


            </div>


        <% } %>


    </div>


</section>