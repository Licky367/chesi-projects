<%
/* ==========================================================
   ADMIN DAIRY FARM CARDS

   FILE:
       views/admin/dairies.ejs

   PURPOSE:
       Display ALL Dairy Farms as horizontal,
       left/right scrollable cards.

   FARM IDENTITY:
   ----------------------------------------------------------
       A Dairy Farm is identified by:

           code < 0

   IMPORTANT:
   ----------------------------------------------------------
       Negative code is the authoritative farm identity.

       We intentionally do NOT require:

           recordType === "farm"

       because all negative-code Dairy records are farms.

   EXISTING FARM:
       /dairy/:id

   FIRST CARD:
       /add
========================================================== */


const sourceDairies =
    Array.isArray(dairies)
        ? dairies
        : (
            Array.isArray(dairyFarms)
                ? dairyFarms
                : []
        );


/* ==========================================================
   ALL NEGATIVE-CODE DAIRY FARMS
========================================================== */

const farmRecords =
    sourceDairies.filter(function (item) {

        if (!item) {

            return false;

        }

        const code =
            Number(item.code);

        return (
            Number.isInteger(code) &&
            code < 0
        );

    });

%>


<section
    class="admin-dairy-strip"
    aria-label="Dairy farms"
>


    <!-- ======================================================
         HEADER
    ======================================================= -->

    <div class="admin-dairy-strip-header">

        <div class="admin-dairy-heading">

            <span class="admin-dairy-kicker">
                MANAGEMENT
            </span>

            <strong>
                Dairy Farms
            </strong>

        </div>


        <div class="admin-dairy-strip-description">

            View and manage all dairy farms in the system.

        </div>

    </div>



    <!-- ======================================================
         HORIZONTAL SCROLL
    ======================================================= -->

    <div
        class="admin-dairy-scroll"
        role="list"
        aria-label="Dairy farms"
    >


        <!-- ==================================================
             ADD FARM CARD
        =================================================== -->

        <a
            href="/add"
            class="admin-dairy-card admin-dairy-add-card"
            role="listitem"
            aria-label="Add a new dairy farm"
        >

            <div class="admin-dairy-add-accent"></div>


            <div class="admin-dairy-add-icon">

                <i class="fas fa-plus"></i>

            </div>


            <div class="admin-dairy-add-title">
                Add Dairy Farm
            </div>


            <div class="admin-dairy-add-text">
                Create a new dairy farm
            </div>


            <div class="admin-dairy-add-arrow">
                <i class="fas fa-arrow-right"></i>
            </div>

        </a>



        <!-- ==================================================
             ALL EXISTING DAIRY FARMS
        =================================================== -->

        <% farmRecords.forEach(function (farm) { %>

            <%

                if (
                    !farm ||
                    !farm._id
                ) {

                    return;

                }


                /* ==============================================
                   FARM NAME
                ============================================== */

                const farmName =
                    String(
                        farm.name ||
                        "Unnamed Dairy Farm"
                    );


                /* ==============================================
                   FARM IMAGE
                ============================================== */

                const farmImage =
                    farm.displayImage ||
                    farm.profileImage ||
                    (
                        "https://ui-avatars.com/api/?name=" +
                        encodeURIComponent(
                            farmName
                        ) +
                        "&background=e8f0e5&color=47733f"
                    );


                /* ==============================================
                   FARM TYPE
                ============================================== */

                const farmType =
                    farm.type
                        ? String(
                            farm.type
                        )
                        : "Dairy Farm";


                /* ==============================================
                   NEGATIVE FARM CODE
                ============================================== */

                const farmCode =
                    Number(
                        farm.code
                    );

            %>


            <!-- ==============================================
                 FARM CARD
            =============================================== -->

            <a
                href="/dairy/<%= farm._id %>"
                class="admin-dairy-card admin-dairy-farm-card"
                role="listitem"
                aria-label="Open <%= farmName %>"
            >


                <!-- ==========================================
                     CARD ACCENT
                =========================================== -->

                <div
                    class="admin-dairy-card-accent"
                    aria-hidden="true"
                ></div>



                <!-- ==========================================
                     IMAGE
                =========================================== -->

                <div class="admin-dairy-image-wrap">

                    <img
                        src="<%= farmImage %>"
                        alt="<%= farmName %>"
                        class="admin-dairy-image"
                        loading="lazy"
                    >


                    <!-- IMAGE SHADE -->

                    <div
                        class="admin-dairy-image-overlay"
                        aria-hidden="true"
                    ></div>


                    <!-- FARM BADGE -->

                    <div class="admin-dairy-farm-badge">

                        <i class="fas fa-cow"></i>

                        <span>
                            FARM
                        </span>

                    </div>


                    <!-- OPEN ICON -->

                    <div class="admin-dairy-open-icon">

                        <i class="fas fa-arrow-up-right-from-square"></i>

                    </div>

                </div>



                <!-- ==========================================
                     CONTENT
                =========================================== -->

                <div class="admin-dairy-content">


                    <!-- ======================================
                         NAME
                    ======================================= -->

                    <div class="admin-dairy-name">

                        <%= farmName %>

                    </div>



                    <!-- ======================================
                         TYPE
                    ======================================= -->

                    <div class="admin-dairy-type">

                        <span
                            class="admin-dairy-type-icon"
                            aria-hidden="true"
                        >
                            <i class="fas fa-cow"></i>
                        </span>


                        <span>
                            <%= farmType %>
                        </span>

                    </div>



                    <!-- ======================================
                         CODE
                    ======================================= -->

                    <div class="admin-dairy-code">

                        <span class="admin-dairy-code-label">
                            Code
                        </span>


                        <span class="admin-dairy-code-value">
                            <%= farmCode %>
                        </span>

                    </div>


                </div>


                <!-- ==========================================
                     BOTTOM ACCENT
                =========================================== -->

                <div
                    class="admin-dairy-bottom-line"
                    aria-hidden="true"
                ></div>

            </a>

        <% }); %>


    </div>

</section>



<style>

