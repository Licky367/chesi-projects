<style>

/* ==========================================================
   DAIRY FARM NET WORTH PAGE
========================================================== */

.financial-page.networth-page {

    max-width: 1050px;

    margin: 0 auto;

    padding: 25px 18px 55px;

    box-sizing: border-box;

}


/* ==========================================================
   HEADER
========================================================== */

.networth-page .financial-header {

    margin-bottom: 25px;

}

.networth-page .financial-header h1 {

    margin: 10px 0 6px;

    color: #173b2a;

    font-size: 31px;

    font-weight: 800;

    line-height: 1.2;

    letter-spacing: -0.6px;

    overflow-wrap: anywhere;

}

.networth-page .financial-header p {

    margin: 0;

    color: #718078;

    font-size: 15px;

    line-height: 1.5;

}


/* ==========================================================
   BACK LINK
========================================================== */

.financial-back-link {

    display: inline-flex;

    align-items: center;

    gap: 6px;

    color: #2f7d4c;

    font-size: 13px;

    font-weight: 700;

    text-decoration: none;

    transition:
        color 0.2s ease,
        transform 0.2s ease;

}

.financial-back-link:hover {

    color: #1e6037;

    transform: translateX(-2px);

}


/* ==========================================================
   TOTAL FARM WORTH
========================================================== */

.networth-total-card {

    position: relative;

    overflow: hidden;

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 25px;

    min-height: 155px;

    margin-bottom: 35px;

    padding: 30px 34px;

    box-sizing: border-box;

    border: 1px solid #cfe5d7;

    border-radius: 20px;

    background:
        linear-gradient(
            135deg,
            #f1faf4 0%,
            #ffffff 68%
        );

    box-shadow:
        0 10px 30px rgba(31, 111, 70, 0.08);

}


/* ==========================================================
   DECORATIVE CIRCLE
========================================================== */

.networth-total-card::after {

    content: "";

    position: absolute;

    width: 190px;

    height: 190px;

    right: -70px;

    top: -75px;

    border-radius: 50%;

    background: rgba(39, 125, 73, 0.07);

    pointer-events: none;

}


/* ==========================================================
   TOTAL LABEL
========================================================== */

.networth-total-label {

    position: relative;

    z-index: 1;

    display: flex;

    align-items: center;

    gap: 10px;

    color: #52705f;

    font-size: 14px;

    font-weight: 700;

}

.networth-total-label::before {

    content: "◆";

    display: inline-flex;

    align-items: center;

    justify-content: center;

    width: 34px;

    height: 34px;

    border-radius: 10px;

    background: #e0f1e6;

    color: #267345;

    font-size: 13px;

}


/* ==========================================================
   TOTAL VALUE
========================================================== */

.networth-total-value {

    position: relative;

    z-index: 1;

    color: #176337;

    font-size: 34px;

    font-weight: 800;

    line-height: 1.15;

    letter-spacing: -0.7px;

    white-space: nowrap;

    font-variant-numeric: tabular-nums;

}


/* ==========================================================
   ASSETS SECTION
========================================================== */

.networth-section {

    margin-bottom: 30px;

}


/* ==========================================================
   SECTION HEADER
========================================================== */

.networth-section-header {

    margin-bottom: 13px;

}

.networth-section-header h2 {

    display: flex;

    align-items: center;

    gap: 10px;

    margin: 0 0 5px;

    color: #24352c;

    font-size: 19px;

    font-weight: 750;

    line-height: 1.3;

}

.networth-section-header h2::before {

    content: "";

    display: block;

    width: 4px;

    height: 20px;

    border-radius: 5px;

    background: #2f8f55;

}

.networth-section-header p {

    margin: 0;

    color: #7a877f;

    font-size: 13px;

    line-height: 1.5;

}


/* ==========================================================
   ASSET LIST
========================================================== */

.networth-list {

    display: flex;

    flex-direction: column;

    gap: 9px;

}


/* ==========================================================
   ASSET ITEM
========================================================== */

.networth-list-item {

    position: relative;

    display: flex;

    align-items: center;

    min-height: 64px;

    padding: 0 17px;

    box-sizing: border-box;

    border: 1px solid #e2ebe5;

    border-radius: 13px;

    background: #ffffff;

    color: #26362d;

    text-decoration: none;

    box-shadow:
        0 2px 8px rgba(25, 70, 43, 0.035);

    transition:
        border-color 0.2s ease,
        background 0.2s ease,
        box-shadow 0.2s ease,
        transform 0.2s ease;

}


/* ==========================================================
   ASSET ICON
========================================================== */

.networth-list-item::before {

    content: "◆";

    flex-shrink: 0;

    display: flex;

    align-items: center;

    justify-content: center;

    width: 37px;

    height: 37px;

    margin-right: 13px;

    border-radius: 10px;

    background: #edf8f0;

    color: #2d8050;

    font-size: 12px;

    transition:
        background 0.2s ease,
        color 0.2s ease;

}


/* ==========================================================
   ASSET NAME
========================================================== */

.networth-list-name {

    flex: 1;

    min-width: 0;

    overflow: hidden;

    color: #293a31;

    font-size: 14px;

    font-weight: 650;

    line-height: 1.4;

    text-overflow: ellipsis;

    white-space: nowrap;

}


/* ==========================================================
   ASSET WORTH
========================================================== */

.networth-list-worth {

    flex-shrink: 0;

    margin-left: 15px;

    color: #2b6f43;

    font-size: 13px;

    font-weight: 750;

    font-variant-numeric: tabular-nums;

    white-space: nowrap;

}


/* ==========================================================
   ARROW
========================================================== */

.networth-list-item::after {

    content: "›";

    flex-shrink: 0;

    margin-left: 12px;

    color: #91a098;

    font-size: 24px;

    font-weight: 400;

    line-height: 1;

    transition:
        color 0.2s ease,
        transform 0.2s ease;

}


/* ==========================================================
   HOVER
========================================================== */

.networth-list-item:hover {

    border-color: #b8d9c3;

    background: #fbfefc;

    box-shadow:
        0 7px 18px rgba(31, 111, 70, 0.08);

    transform: translateY(-1px);

}

.networth-list-item:hover::before {

    background: #dff1e5;

    color: #216b3e;

}

.networth-list-item:hover::after {

    color: #267345;

    transform: translateX(3px);

}


/* ==========================================================
   EMPTY STATE
========================================================== */

.networth-empty {

    display: flex;

    align-items: center;

    justify-content: center;

    flex-direction: column;

    min-height: 145px;

    padding: 25px;

    box-sizing: border-box;

    border: 1px dashed #cddbd2;

    border-radius: 14px;

    background: #fbfdfb;

    color: #829087;

    font-size: 14px;

    line-height: 1.5;

    text-align: center;

}

.networth-empty::before {

    content: "◇";

    display: flex;

    align-items: center;

    justify-content: center;

    width: 42px;

    height: 42px;

    margin-bottom: 10px;

    border-radius: 50%;

    background: #edf7f0;

    color: #59936e;

    font-size: 22px;

}


/* ==========================================================
   ACTIONS
========================================================== */

.networth-actions {

    display: flex;

    justify-content: flex-end;

    padding-top: 5px;

}


/* ==========================================================
   PRIMARY BUTTON
========================================================== */

.networth-actions .button-primary {

    display: inline-flex;

    align-items: center;

    justify-content: center;

    gap: 8px;

    min-height: 46px;

    padding: 0 20px;

    box-sizing: border-box;

    border: 1px solid #2f8f55;

    border-radius: 11px;

    background: #2f8f55;

    color: #ffffff;

    text-decoration: none;

    font-family: inherit;

    font-size: 14px;

    font-weight: 700;

    box-shadow:
        0 5px 12px rgba(47, 143, 85, 0.17);

    transition:
        background 0.2s ease,
        border-color 0.2s ease,
        box-shadow 0.2s ease,
        transform 0.2s ease;

}

.networth-actions .button-primary::before {

    content: "+";

    font-size: 19px;

    font-weight: 400;

    line-height: 1;

}

.networth-actions .button-primary:hover {

    background: #267747;

    border-color: #267747;

    box-shadow:
        0 7px 16px rgba(47, 143, 85, 0.22);

    transform: translateY(-1px);

}

.networth-actions .button-primary:active {

    transform: translateY(0);

}


/* ==========================================================
   MOBILE
========================================================== */

@media (max-width: 700px) {

    .financial-page.networth-page {

        padding: 18px 14px 45px;

    }


    .networth-page .financial-header h1 {

        margin-top: 9px;

        font-size: 26px;

    }


    .networth-page .financial-header p {

        font-size: 14px;

    }


    .networth-total-card {

        align-items: flex-start;

        flex-direction: column;

        gap: 14px;

        min-height: auto;

        padding: 24px 22px;

        border-radius: 17px;

    }


    .networth-total-label {

        font-size: 13px;

    }


    .networth-total-value {

        font-size: 28px;

        white-space: normal;

    }


    .networth-section {

        margin-bottom: 27px;

    }


    .networth-section-header h2 {

        font-size: 18px;

    }


    .networth-section-header p {

        font-size: 12.5px;

    }


    .networth-list-item {

        min-height: 59px;

        padding: 0 13px;

    }


    .networth-list-item::before {

        width: 34px;

        height: 34px;

        margin-right: 11px;

    }


    .networth-list-name {

        font-size: 14px;

    }


    .networth-list-worth {

        margin-left: 8px;

        font-size: 12px;

    }


    .networth-actions {

        justify-content: stretch;

    }


    .networth-actions .button-primary {

        width: 100%;

    }

}


/* ==========================================================
   SMALL PHONES
========================================================== */

@media (max-width: 400px) {

    .financial-page.networth-page {

        padding-left: 10px;

        padding-right: 10px;

    }


    .networth-page .financial-header h1 {

        font-size: 24px;

    }


    .networth-total-card {

        padding: 21px 18px;

    }


    .networth-total-value {

        font-size: 25px;

    }


    .networth-section-header h2 {

        font-size: 17px;

    }


    .networth-list-item {

        min-height: 56px;

    }


    .networth-list-worth {

        display: none;

    }

}

</style>


<div class="financial-page networth-page">


    <!-- =====================================================
         DAIRY FARM HEADER

         dairy = the Dairy Farm record

         dairy._id = the Dairy Farm record identifier

         dairy.code = the Dairy Farm's code.

         A Dairy Farm is a Dairy record whose
         dairy.code is negative.
    ====================================================== -->

    <div class="financial-header">

        <div>

            <a
                href="/networth"
                class="financial-back-link"
            >
                ← Net Worth
            </a>


            <h1>
                <%= dairy.item || dairy.name || "Dairy Farm" %>
            </h1>


            <p>
                Assets assigned to this Dairy Farm.
            </p>

        </div>

    </div>


    <!-- =====================================================
         DAIRY FARM TOTAL

         dairyTotal is the combined currentWorth of every
         Dairy record included in assets.

         assets may contain:

         1. A Dairy whose dairy.assetCode is equal to
            dairy.code of this Dairy Farm.

         2. Another asset added directly to this Dairy Farm,
            where dairy.code is null.

         The asset's dairy.code does NOT determine whether
         it belongs to this Dairy Farm.

         Membership is determined by the backend data passed
         into assets.
    ====================================================== -->

    <div class="financial-card networth-total-card">

        <span class="networth-total-label">
            Dairy Farm Asset Worth
        </span>


        <strong class="networth-total-value">

            KSh
            <%= Number(
                dairyTotal || 0
            ).toLocaleString("en-KE") %>

        </strong>

    </div>


    <!-- =====================================================
         DAIRY FARM ASSETS

         assets contains all assets assigned to this
         Dairy Farm.

         A Dairy record can be included because:

             dairy.assetCode === dairy.code

         where the second dairy.code refers to the
         current Dairy Farm.

         OR because the asset was added directly to this
         Dairy Farm and its dairy.code is null.

         No asset.code or dairyCode field is used.
    ====================================================== -->

    <section class="networth-section">


        <div class="networth-section-header">

            <div>

                <h2>
                    Assets
                </h2>


                <p>
                    Assets currently assigned to this Dairy Farm.
                </p>

            </div>

        </div>


        <div class="networth-list">


            <% if (
                Array.isArray(assets) &&
                assets.length > 0
            ) { %>


                <% assets.forEach(function(asset) { %>


                    <!-- ======================================
                         ASSET

                         Each item is a Dairy record.

                         asset._id identifies the Dairy record.

                         The asset may have:

                             asset.assetCode

                         and/or:

                             asset.code

                         depending on how it was created.

                         The page does not use either field
                         to determine membership.

                         Membership has already been determined
                         before assets reaches this EJS.
                    ======================================= -->

                    <a
                        href="/networth/asset/<%= asset._id %>"
                        class="networth-list-item"
                    >


                        <span class="networth-list-name">

                            <%= asset.item ||
                                asset.name ||
                                "Unnamed Asset" %>

                        </span>


                        <span class="networth-list-worth">

                            KSh
                            <%= Number(
                                asset.currentWorth || 0
                            ).toLocaleString("en-KE") %>

                        </span>


                    </a>


                <% }); %>


            <% } else { %>


                <div class="networth-empty">

                    No assets have been assigned
                    to this Dairy Farm.

                </div>


            <% } %>


        </div>

    </section>


    <!-- =====================================================
         ADD ASSET

         The current Dairy Farm is identified by dairy._id.

         The route therefore uses:

             /networth/structure/<dairy._id>/add

         The Dairy Farm's dairy.code is not placed in
         the URL and is not used as the page identifier.
    ====================================================== -->

    <div class="networth-actions">

        <a
            href="/networth/structure/<%= dairy._id %>/add"
            class="button button-primary"
        >
            Add Asset
        </a>

    </div>


</div>