<%
/* ==========================================================
ADD DAIRY / ASSET PAGE

Backend provides:

dairyBreeds:
Breeds supplied by the Dairy model.

structures:
Existing Dairy Farm records.

Access control must also be enforced server-side.
========================================================== */

const breeds =
Array.isArray(dairyBreeds)
? dairyBreeds
: [];

const dairyFarms =
Array.isArray(structures)
? structures
: [];

%>

<!-- ==========================================================
     PAGE HEADER
========================================================== --><div class="financial-header"><a
    href="/networth"
    class="financial-back-link"
>
    ← Net Worth
</a>

<h1>
    Add Dairy / Asset
</h1>

</div><!-- ==========================================================
     FORM CARD
========================================================== --><div class="financial-card"><form
    id="addDairyForm"
    action="/add"
    method="POST"
    enctype="multipart/form-data"
    class="add-dairy-form"
>

    <!-- ==================================================
         FORM STATUS
    ================================================== -->

    <div
        id="formSaveStatus"
        class="form-save-status"
        role="status"
        aria-live="polite"
    ></div>


    <!-- ==================================================
         PROFILE IMAGE
    ================================================== -->

    <div class="profile-image-section">

        <div class="profile-image-preview">

            <img
                id="profileImagePreview"
                src=""
                alt="Profile image preview"
                style="display:none;"
            >

            <span
                id="profileImagePlaceholder"
                class="profile-image-placeholder"
            >
                🐄
            </span>

        </div>

        <div class="profile-image-title">
            Profile Image
        </div>

        <p class="profile-image-description">
            Optional. Choose an image for this record.
        </p>

        <input
            type="file"
            id="profileImage"
            name="profileImage"
            class="profile-image-input"
            accept="image/jpeg,image/jpg,image/png,image/webp"
        >

    </div>


    <!-- ==================================================
         RECORD TYPE
    ================================================== -->

    <div class="form-group">

        <label for="recordType">
            What are you adding? *
        </label>

        <select
            id="recordType"
            name="recordType"
            required
        >

            <option value="">
                Select record type
            </option>

            <option value="dairyFarm">
                Dairy Farm
            </option>

            <option value="animal">
                Animal
            </option>

            <option value="structure">
                Structure / Facility
            </option>

        </select>

    </div>


    <!-- ==================================================
         INTERNAL STATUS ELEMENT

         JavaScript may use this internally.
         It is never displayed to the user.
    ================================================== -->

    <div
        id="recordTypeInfo"
        class="record-type-info"
        style="display:none;"
        aria-hidden="true"
    ></div>


    <!-- ==================================================
         NAME
    ================================================== -->

    <div class="form-group">

        <label for="name">
            Name *
        </label>

        <input
            type="text"
            id="name"
            name="name"
            required
            autocomplete="off"
            placeholder="Enter name"
        >

    </div>


    <!-- ==================================================
         DAIRY FARM TYPE
    ================================================== -->

    <div
        id="farmTypeGroup"
        class="form-group record-section"
        style="display:none;"
    >

        <label for="farmType">
            Dairy Farm Type *
        </label>

        <select
            id="farmType"
            name="farmType"
            disabled
        >

            <option value="">
                Select farm type
            </option>

            <option value="ranch">
                Ranch
            </option>

            <option value="zeroGrazing">
                Zero Grazing
            </option>

            <option value="semiZeroGrazing">
                Semi-Zero Grazing
            </option>

            <option value="pastureBased">
                Pasture-Based
            </option>

            <option value="mixedFarming">
                Mixed Farming
            </option>

            <option value="cooperative">
                Dairy Cooperative
            </option>

            <option value="other">
                Other
            </option>

        </select>

    </div>


    <!-- ==================================================
         ANIMAL PARENT DAIRY FARM
    ================================================== -->

    <div
        id="animalFarmGroup"
        class="form-group record-section"
        style="display:none;"
    >

        <label for="animalFarmCode">
            Dairy Farm *
        </label>

        <select
            id="animalFarmCode"
            name="assetCode"
            disabled
        >

            <option value="">
                Select Dairy Farm
            </option>

            <% dairyFarms.forEach(function(farm) { %>

                <% if (
                    farm.code !== null &&
                    farm.code !== undefined &&
                    Number(farm.code) < 0
                ) { %>

                    <option
                        value="<%= farm.code %>"
                    >
                        <%= farm.name || "Dairy Farm" %>
                        —
                        <%= farm.code %>
                    </option>

                <% } %>

            <% }); %>

        </select>

    </div>


    <!-- ==================================================
         ANIMAL GENDER

         Sent as:

         male
         female

         The backend uses gender to determine the
         automatically generated animal code parity.

         Male:
             odd numbers

         Female:
             even numbers
    ================================================== -->

    <div
        id="animalGenderGroup"
        class="form-group record-section"
        style="display:none;"
    >

        <label for="gender">
            Gender *
        </label>

        <select
            id="gender"
            name="gender"
            disabled
        >

            <option value="">
                Select gender
            </option>

            <option value="male">
                Male
            </option>

            <option value="female">
                Female
            </option>

        </select>

    </div>


    <!-- ==================================================
         ANIMAL DATE OF BIRTH
    ================================================== -->

    <div
        id="dateOfBirthGroup"
        class="form-group record-section"
        style="display:none;"
    >

        <label for="dateOfBirth">
            Date of Birth *
        </label>

        <input
            type="date"
            id="dateOfBirth"
            name="dateOfBirth"
            disabled
        >

    </div>


    <!-- ==================================================
         ANIMAL BREED

         The options come directly from dairyBreeds,
         which comes from the Dairy model.
    ================================================== -->

    <div
        id="animalBreedGroup"
        class="form-group record-section"
        style="display:none;"
    >

        <label for="breed">
            Breed *
        </label>

        <select
            id="breed"
            name="type"
            disabled
        >

            <option value="">
                Select breed
            </option>

            <% breeds.forEach(function(breed) { %>

                <option
                    value="<%= breed %>"
                >
                    <%= breed %>
                </option>

            <% }); %>

        </select>

    </div>


    <!-- ==================================================
         ANIMAL MASS
    ================================================== -->

    <div
        id="massGroup"
        class="form-group record-section"
        style="display:none;"
    >

        <label for="mass">
            Mass (kg)
        </label>

        <input
            type="number"
            id="mass"
            name="mass"
            min="0"
            step="0.01"
            placeholder="Enter animal mass"
            disabled
        >

    </div>


    <!-- ==================================================
         STRUCTURE TYPE
    ================================================== -->

    <div
        id="structureTypeGroup"
        class="form-group record-section"
        style="display:none;"
    >

        <label for="structureType">
            Type *
        </label>

        <select
            id="structureType"
            name="type"
            disabled
        >

            <option value="">
                Select type
            </option>

            <option value="machine">
                Machine
            </option>

            <option value="equipment">
                Equipment
            </option>

            <option value="tool">
                Tool
            </option>

            <option value="building">
                Building
            </option>

            <option value="cowshed">
                Cowshed
            </option>

            <option value="milkingParlour">
                Milking Parlour
            </option>

            <option value="feedStore">
                Feed Store
            </option>

            <option value="hayShed">
                Hay Shed
            </option>

            <option value="waterSystem">
                Water System
            </option>

            <option value="fencing">
                Fencing
            </option>

            <option value="vehicle">
                Vehicle
            </option>

            <option value="generator">
                Generator
            </option>

            <option value="solarSystem">
                Solar System
            </option>

            <option value="other">
                Other
            </option>

        </select>

    </div>


    <!-- ==================================================
         STRUCTURE PARENT DAIRY FARM
    ================================================== -->

    <div
        id="structureFarmGroup"
        class="form-group record-section"
        style="display:none;"
    >

        <label for="structureFarmCode">
            Dairy Farm
        </label>

        <select
            id="structureFarmCode"
            name="structureFarmCode"
            disabled
        >

            <option value="">
                No Dairy Farm
            </option>

            <% dairyFarms.forEach(function(farm) { %>

                <% if (
                    farm.code !== null &&
                    farm.code !== undefined &&
                    Number(farm.code) < 0
                ) { %>

                    <option
                        value="<%= farm.code %>"
                    >
                        <%= farm.name || "Dairy Farm" %>
                        —
                        <%= farm.code %>
                    </option>

                <% } %>

            <% }); %>

        </select>

    </div>


    <!-- ==================================================
         BUYING PRICE
    ================================================== -->

    <div class="form-group">

        <label for="buyingPrice">
            Buying Price
        </label>

        <input
            type="number"
            id="buyingPrice"
            name="buyingPrice"
            min="0"
            step="0.01"
            placeholder="Enter buying price"
        >

    </div>


    <!-- ==================================================
         CURRENT WORTH
    ================================================== -->

    <div class="form-group">

        <label for="currentWorth">
            Current Worth
        </label>

        <input
            type="number"
            id="currentWorth"
            name="currentWorth"
            min="0"
            step="0.01"
            placeholder="Enter current worth"
        >

    </div>


    <!-- ==================================================
         DESCRIPTION
    ================================================== -->

    <div class="form-group">

        <label for="description">
            Description
        </label>

        <textarea
            id="description"
            name="description"
            placeholder="Describe the dairy, animal, structure, or asset..."
        ></textarea>

    </div>


    <!-- ==================================================
         CONDITION
    ================================================== -->

    <div class="form-group">

        <label for="condition">
            Condition
        </label>

        <input
            type="text"
            id="condition"
            name="condition"
            placeholder="e.g. New, Good, Needs Repair"
        >

    </div>


    <!-- ==================================================
         LOCATION
    ================================================== -->

    <div class="form-group">

        <label for="location">
            Physical Location
        </label>

        <input
            type="text"
            id="location"
            name="location"
            placeholder="Where is it physically located?"
        >

    </div>


    <!-- ==================================================
         STATUS
    ================================================== -->

    <div class="form-group">

        <label for="status">
            Status
        </label>

        <select
            id="status"
            name="status"
        >

            <option
                value="active"
                selected
            >
                Active
            </option>

            <option value="sold">
                Sold
            </option>

            <option value="disposed">
                Disposed
            </option>

            <option value="inactive">
                Inactive
            </option>

        </select>

    </div>


    <!-- ==================================================
         ACTIONS
    ================================================== -->

    <div class="form-actions">

        <a
            href="/networth"
            class="button button-secondary"
        >
            Cancel
        </a>

        <button
            type="submit"
            id="saveDairyButton"
            class="button button-primary"
        >
            Create Record
        </button>

    </div>

</form>

</div><script>

document.addEventListener(
    "DOMContentLoaded",
    function() {


        /* =====================================================
           ELEMENTS
        ===================================================== */

        const form =
            document.getElementById(
                "addDairyForm"
            );

        const recordType =
            document.getElementById(
                "recordType"
            );

        const formSaveStatus =
            document.getElementById(
                "formSaveStatus"
            );

        const saveButton =
            document.getElementById(
                "saveDairyButton"
            );


        const farmTypeGroup =
            document.getElementById(
                "farmTypeGroup"
            );

        const farmType =
            document.getElementById(
                "farmType"
            );


        const animalFarmGroup =
            document.getElementById(
                "animalFarmGroup"
            );

        const animalFarmCode =
            document.getElementById(
                "animalFarmCode"
            );


        const animalGenderGroup =
            document.getElementById(
                "animalGenderGroup"
            );

        const gender =
            document.getElementById(
                "gender"
            );


        const dateOfBirthGroup =
            document.getElementById(
                "dateOfBirthGroup"
            );

        const dateOfBirth =
            document.getElementById(
                "dateOfBirth"
            );


        const animalBreedGroup =
            document.getElementById(
                "animalBreedGroup"
            );

        const breed =
            document.getElementById(
                "breed"
            );


        const massGroup =
            document.getElementById(
                "massGroup"
            );

        const mass =
            document.getElementById(
                "mass"
            );


        const structureTypeGroup =
            document.getElementById(
                "structureTypeGroup"
            );

        const structureType =
            document.getElementById(
                "structureType"
            );


        const structureFarmGroup =
            document.getElementById(
                "structureFarmGroup"
            );

        const structureFarmCode =
            document.getElementById(
                "structureFarmCode"
            );


        const profileImage =
            document.getElementById(
                "profileImage"
            );

        const profileImagePreview =
            document.getElementById(
                "profileImagePreview"
            );

        const profileImagePlaceholder =
            document.getElementById(
                "profileImagePlaceholder"
            );


        /* =====================================================
           RECORD-SPECIFIC SECTIONS
        ===================================================== */

        const sections = [

            farmTypeGroup,

            animalFarmGroup,

            animalGenderGroup,

            dateOfBirthGroup,

            animalBreedGroup,

            massGroup,

            structureTypeGroup,

            structureFarmGroup

        ];


        /* =====================================================
           HIDE SECTION
        ===================================================== */

        function hideSection(
            section
        ) {

            section.style.display =
                "none";

        }


        /* =====================================================
           SHOW SECTION
        ===================================================== */

        function showSection(
            section
        ) {

            section.style.display =
                "";

        }


        /* =====================================================
           ENABLE FIELD
        ===================================================== */

        function enableField(
            field
        ) {

            field.disabled =
                false;

        }


        /* =====================================================
           DISABLE FIELD
        ===================================================== */

        function disableField(
            field
        ) {

            field.disabled =
                true;

        }


        /* =====================================================
           REQUIRED STATE
        ===================================================== */

        function setRequired(
            field,
            required
        ) {

            field.required =
                required;

        }


        /* =====================================================
           RESET FIELD
        ===================================================== */

        function resetField(
            field
        ) {

            if (!field) {

                return;

            }


            if (
                field.tagName ===
                "SELECT"
            ) {

                field.selectedIndex =
                    0;

            } else {

                field.value =
                    "";

            }

        }


        /* =====================================================
           RESET ALL CONDITIONAL FIELDS
        ===================================================== */

        function resetConditionalFields() {


            sections.forEach(
                hideSection
            );


            resetField(
                farmType
            );

            resetField(
                animalFarmCode
            );

            resetField(
                gender
            );

            resetField(
                dateOfBirth
            );

            resetField(
                breed
            );

            resetField(
                mass
            );

            resetField(
                structureType
            );

            resetField(
                structureFarmCode
            );


            disableField(
                farmType
            );

            disableField(
                animalFarmCode
            );

            disableField(
                gender
            );

            disableField(
                dateOfBirth
            );

            disableField(
                breed
            );

            disableField(
                mass
            );

            disableField(
                structureType
            );

            disableField(
                structureFarmCode
            );


            setRequired(
                farmType,
                false
            );

            setRequired(
                animalFarmCode,
                false
            );

            setRequired(
                gender,
                false
            );

            setRequired(
                dateOfBirth,
                false
            );

            setRequired(
                breed,
                false
            );

            setRequired(
                structureType,
                false
            );

        }


        /* =====================================================
           CONFIGURE DAIRY FARM
        ===================================================== */

        function configureDairyFarm() {


            showSection(
                farmTypeGroup
            );


            enableField(
                farmType
            );


            setRequired(
                farmType,
                true
            );

        }


        /* =====================================================
           CONFIGURE ANIMAL
        ===================================================== */

        function configureAnimal() {


            showSection(
                animalFarmGroup
            );

            showSection(
                animalGenderGroup
            );

            showSection(
                dateOfBirthGroup
            );

            showSection(
                animalBreedGroup
            );

            showSection(
                massGroup
            );


            enableField(
                animalFarmCode
            );

            enableField(
                gender
            );

            enableField(
                dateOfBirth
            );

            enableField(
                breed
            );

            enableField(
                mass
            );


            setRequired(
                animalFarmCode,
                true
            );

            setRequired(
                gender,
                true
            );

            setRequired(
                dateOfBirth,
                true
            );

            setRequired(
                breed,
                true
            );

        }


        /* =====================================================
           CONFIGURE STRUCTURE
        ===================================================== */

        function configureStructure() {


            showSection(
                structureTypeGroup
            );

            showSection(
                structureFarmGroup
            );


            enableField(
                structureType
            );

            enableField(
                structureFarmCode
            );


            setRequired(
                structureType,
                true
            );

        }


        /* =====================================================
           UPDATE FORM
        ===================================================== */

        function updateForm() {


            resetConditionalFields();


            const selectedType =
                recordType.value;


            if (
                selectedType ===
                "dairyFarm"
            ) {

                configureDairyFarm();

            }


            if (
                selectedType ===
                "animal"
            ) {

                configureAnimal();

            }


            if (
                selectedType ===
                "structure"
            ) {

                configureStructure();

            }

        }


        /* =====================================================
           RECORD TYPE CHANGE
        ===================================================== */

        recordType.addEventListener(
            "change",
            updateForm
        );


        /* =====================================================
           PROFILE IMAGE PREVIEW
        ===================================================== */

        profileImage.addEventListener(
            "change",
            function() {


                const file =
                    profileImage.files &&
                    profileImage.files[0];


                if (!file) {

                    profileImagePreview.src =
                        "";

                    profileImagePreview.style.display =
                        "none";

                    profileImagePlaceholder.style.display =
                        "";

                    return;

                }


                const allowedTypes = [

                    "image/jpeg",

                    "image/jpg",

                    "image/png",

                    "image/webp"

                ];


                if (
                    !allowedTypes.includes(
                        file.type
                    )
                ) {

                    profileImage.value =
                        "";

                    profileImagePreview.src =
                        "";

                    profileImagePreview.style.display =
                        "none";

                    profileImagePlaceholder.style.display =
                        "";

                    formSaveStatus.textContent =
                        "Invalid image type.";

                    return;

                }


                const imageUrl =
                    URL.createObjectURL(
                        file
                    );


                profileImagePreview.src =
                    imageUrl;


                profileImagePreview.style.display =
                    "";


                profileImagePlaceholder.style.display =
                    "none";


                profileImagePreview.onload =
                    function() {

                        URL.revokeObjectURL(
                            imageUrl
                        );

                    };

            }
        );


        /* =====================================================
           FORM SUBMISSION
        ===================================================== */

        form.addEventListener(
            "submit",
            function(event) {


                formSaveStatus.textContent =
                    "";


                const selectedType =
                    recordType.value;


                if (!selectedType) {

                    event.preventDefault();

                    recordType.focus();

                    return;

                }


                /* =============================================
                   ANIMAL VALIDATION
                ============================================= */

                if (
                    selectedType ===
                    "animal"
                ) {


                    if (
                        !animalFarmCode.value
                    ) {

                        event.preventDefault();

                        animalFarmCode.focus();

                        return;

                    }


                    if (
                        !gender.value
                    ) {

                        event.preventDefault();

                        gender.focus();

                        return;

                    }


                    if (
                        !dateOfBirth.value
                    ) {

                        event.preventDefault();

                        dateOfBirth.focus();

                        return;

                    }


                    if (
                        !breed.value
                    ) {

                        event.preventDefault();

                        breed.focus();

                        return;

                    }

                }


                /* =============================================
                   DAIRY FARM VALIDATION
                ============================================= */

                if (
                    selectedType ===
                    "dairyFarm"
                ) {

                    if (
                        !farmType.value
                    ) {

                        event.preventDefault();

                        farmType.focus();

                        return;

                    }

                }


                /* =============================================
                   STRUCTURE VALIDATION
                ============================================= */

                if (
                    selectedType ===
                    "structure"
                ) {

                    if (
                        !structureType.value
                    ) {

                        event.preventDefault();

                        structureType.focus();

                        return;

                    }

                }


                /* =============================================
                   PREVENT DOUBLE SUBMISSION
                ============================================= */

                if (saveButton) {

                    saveButton.disabled =
                        true;

                    saveButton.textContent =
                        "Creating...";

                }

            }
        );


        /* =====================================================
           INITIAL FORM STATE
        ===================================================== */

        updateForm();

    }

);

</script>