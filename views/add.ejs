    margin: 8px 0 0;

    color: #6b7280;

    font-size: 15px;

    line-height: 1.6;

}


/* ==========================================================
   MAIN CARD
========================================================== */

.add-dairy-card {

    background: #ffffff;

    border: 1px solid #e5e7eb;

    border-radius: 22px;

    padding: 26px;

    box-shadow:
        0 8px 30px rgba(15, 23, 42, 0.08);

}


/* ==========================================================
   FORM STATUS
========================================================== */

.form-save-status {

    display: none;

    margin-bottom: 20px;

