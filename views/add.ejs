</div><script>

document.addEventListener(
    "DOMContentLoaded",
    function () {


        /* ======================================================
           ELEMENTS
        ====================================================== */

        const form =
            document.getElementById(
                "addDairyForm"
            );


        const recordType =
            document.getElementById(
                "recordType"
            );


        const farmTypeGroup =
            document.getElementById(
                "farmTypeGroup"
            );


        const animalFarmGroup =
            document.getElementById(
                "animalFarmGroup"
            );


        const dateOfBirthGroup =
            document.getElementById(
                "dateOfBirthGroup"
            );


        const animalBreedGroup =
            document.getElementById(
                "animalBreedGroup"
            );


        const genderGroup =
            document.getElementById(
                "genderGroup"
            );


        const massGroup =
            document.getElementById(
                "massGroup"
            );


        const structureTypeGroup =
            document.getElementById(
                "structureTypeGroup"
            );


        const structureFarmGroup =
            document.getElementById(
                "structureFarmGroup"
            );


        const farmType =
            document.getElementById(
                "farmType"
            );


        const animalFarmCode =
            document.getElementById(
                "animalFarmCode"
            );


        const dateOfBirth =
            document.getElementById(
                "dateOfBirth"
            );


        const breed =
            document.getElementById(
                "breed"
            );


        const gender =
            document.getElementById(
                "gender"
            );


        const mass =
            document.getElementById(
                "mass"
            );


        const structureType =
            document.getElementById(
                "structureType"
            );


        const structureFarmCode =
            document.getElementById(
                "structureFarmCode"
            );


        const imageInput =
            document.getElementById(
                "profileImage"
            );


        const imagePreview =
            document.getElementById(
                "profileImagePreview"
            );


        const imagePlaceholder =
            document.getElementById(
                "profileImagePlaceholder"
            );


        /* ======================================================
           HIDE RECORD-SPECIFIC SECTIONS
        ====================================================== */

        function hideRecordSections() {

            const sections = [

                farmTypeGroup,

                animalFarmGroup,

                dateOfBirthGroup,

                animalBreedGroup,

                genderGroup,

                massGroup,

                structureTypeGroup,

                structureFarmGroup

            ];


            sections.forEach(
                function (section) {

                    section.classList.remove(
                        "visible"
                    );

                }
            );

        }


        /* ======================================================
           UPDATE FORM
        ====================================================== */

        function updateForm() {

            const selectedType =
                recordType.value;


            hideRecordSections();


            /* --------------------------------------------------
               RESET CONDITIONAL REQUIRED FIELDS
            -------------------------------------------------- */

            farmType.required =
                false;

            animalFarmCode.required =
                false;

            dateOfBirth.required =
                false;

            breed.required =
                false;

            gender.required =
                false;

            structureType.required =
                false;


            /* --------------------------------------------------
               DAIRY FARM
            -------------------------------------------------- */

            if (
                selectedType ===
                "dairyFarm"
            ) {

                farmTypeGroup.classList.add(
                    "visible"
                );


                farmType.required =
                    true;

            }


            /* --------------------------------------------------
               ANIMAL
            -------------------------------------------------- */

            else if (
                selectedType ===
                "animal"
            ) {

                animalFarmGroup.classList.add(
                    "visible"
                );


                dateOfBirthGroup.classList.add(
                    "visible"
                );


                animalBreedGroup.classList.add(
                    "visible"
                );


                genderGroup.classList.add(
                    "visible"
                );


                massGroup.classList.add(
                    "visible"
                );


                dateOfBirth.required =
                    true;


                breed.required =
                    true;


                gender.required =
                    true;

            }


            /* --------------------------------------------------
               STRUCTURE / FACILITY
            -------------------------------------------------- */

            else if (
                selectedType ===
                "structure"
            ) {

                structureTypeGroup.classList.add(
                    "visible"
                );


                structureFarmGroup.classList.add(
                    "visible"
                );


                structureType.required =
                    true;

            }

        }


        recordType.addEventListener(
            "change",
            updateForm
        );


        updateForm();


        /* ======================================================
           IMAGE PREVIEW
        ====================================================== */

        imageInput.addEventListener(
            "change",
            function () {

                const file =
                    imageInput.files &&
                    imageInput.files[0];


                if (!file) {

                    imagePreview.src =
                        "";

                    imagePreview.style.display =
                        "none";

                    imagePlaceholder.style.display =
                        "block";

                    return;

                }


                const url =
                    URL.createObjectURL(
                        file
                    );


                imagePreview.src =
                    url;

                imagePreview.style.display =
                    "block";

                imagePlaceholder.style.display =
                    "none";

            }
        );


        /* ======================================================
           FORM SUBMISSION
        ====================================================== */

        form.addEventListener(
            "submit",
            function () {

                const button =
                    document.getElementById(
                        "saveDairyButton"
                    );


                if (button) {

                    button.disabled =
                        true;

                    button.textContent =
                        "Creating...";

                }

            }
        );

    }
);

</script>