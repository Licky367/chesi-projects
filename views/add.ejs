    border: 4px solid #ffffff;

    box-shadow:
        0 4px 18px rgba(0, 0, 0, 0.10);

    margin-bottom: 14px;

}

.profile-image-preview img {

    width: 100%;

    height: 100%;

    object-fit: cover;

}

.profile-image-placeholder {

    font-size: 48px;

}

.profile-image-title {

    font-size: 17px;

    font-weight: 700;

    color: #172033;

}

.profile-image-description {

    margin: 5px 0 14px;

    color: #7b8494;

    font-size: 13px;

}

.profile-image-input {

    width: 100%;

    max-width: 300px;

    font-size: 13px;

}


/* ==========================================================
   RECORD TYPE SELECTOR
   ========================================================== */

.record-type-card {

    padding: 18px;

    margin-bottom: 24px;

    border-radius: 16px;

    background: #f8fafc;

    border: 1px solid #e6ebf1;

}

.record-type-card label {

    font-weight: 700;

    color: #172033;

}


/* ==========================================================
   FORM GROUPS
   ========================================================== */

.form-group {

    margin-bottom: 20px;

}

.form-group label {

    display: block;

    margin-bottom: 8px;

    color: #273449;

    font-size: 14px;

    font-weight: 700;

}

.form-group input,
.form-group select,
.form-group textarea {

    width: 100%;

    box-sizing: border-box;

    border: 1px solid #d9dee7;

    border-radius: 12px;

    background: #ffffff;

    color: #172033;

    font-size: 15px;

    padding: 12px 13px;

    outline: none;

    transition:
        border-color .2s ease,
        box-shadow .2s ease,
        background .2s ease;

}

.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus {

    border-color: #2563eb;

    box-shadow:
        0 0 0 3px rgba(37, 99, 235, 0.10);

}

.form-group input:disabled,
.form-group select:disabled,
.form-group textarea:disabled {

    background: #f4f6f8;

    color: #9aa2ad;

    cursor: not-allowed;

}

.form-group textarea {

    min-height: 120px;

    resize: vertical;

}


/* ==========================================================
   RECORD-SPECIFIC SECTIONS
   ========================================================== */

.record-section {

    display: none;

    padding: 18px;

    margin-bottom: 18px;

    border-radius: 16px;

    background: #fbfcfe;

    border: 1px solid #e8edf3;

}

.record-section.visible {

    display: block;

}


/* ==========================================================
   SECTION TITLE ACCENT
   ========================================================== */

.record-section::before {

    content: "";

    display: block;

    width: 35px;

    height: 3px;

    margin-bottom: 14px;

    border-radius: 5px;

    background: #2563eb;

}


/* ==========================================================
   HELP TEXT
   ========================================================== */

.code-help {

    margin-bottom: 8px;

    color: #7b8494;

    font-size: 12px;

    line-height: 1.5;

}


/* ==========================================================
   TWO COLUMN LAYOUT
   ========================================================== */

.form-grid {

    display: grid;

    grid-template-columns:
        repeat(2, minmax(0, 1fr));

    gap: 18px;

}

.form-grid .form-group {

    margin-bottom: 0;

}


/* ==========================================================
   ACTIONS
   ========================================================== */

.form-actions {

    display: flex;

    justify-content: flex-end;

    align-items: center;

    gap: 12px;

    margin-top: 28px;

    padding-top: 22px;

    border-top: 1px solid #edf0f4;

}

.button {

    display: inline-flex;

    align-items: center;

    justify-content: center;

    min-height: 46px;

    padding: 0 20px;

    border-radius: 12px;

    text-decoration: none;

    border: none;

    cursor: pointer;

    font-size: 14px;

    font-weight: 700;

    transition:
        transform .15s ease,
        opacity .15s ease,
        box-shadow .15s ease;

}

.button:hover {

    transform: translateY(-1px);

}

.button:disabled {

    opacity: .65;

    cursor: not-allowed;

    transform: none;

}

.button-secondary {

    background: #f1f4f8;

