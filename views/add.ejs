<script>

/*
============================================================
ADD DAIRY / ASSET PAGE JAVASCRIPT

This script controls:
- Showing the correct fields
- Hiding irrelevant fields
- Enabling/disabling conditional fields
- Image preview
- Basic browser-side validation

The server remains responsible for all final validation,
authorization, breed validation and code generation.
============================================================
*/

document.addEventListener(
    "DOMContentLoaded",
    function () {


        /* ==================================================
           MAIN ELEMENTS
        ================================================== */

        const form =
            document.getElementById(
                "addDairyForm"
            );

        const recordType =
            document.getElementById(
                "recordType"
            );

        const statusBox =
            document.getElementById(
                "formSaveStatus"
            );

        const saveButton =
            document.getElementById(
                "saveDairyButton"
            );

        const profileImage =
            document.getElementById(
                "profileImage"
            );

        const profileImagePreview =
            document.getElementById(
                "profileImagePreview"
            );

        const profileImagePlaceholder =
            document.getElementById(
                "profileImagePlaceholder"
            );


        /* ==================================================
           CONDITIONAL SECTIONS
        ================================================== */

        const farmTypeGroup =
            document.getElementById(
                "farmTypeGroup"
            );

        const animalFarmGroup =
            document.getElementById(
                "animalFarmGroup"
            );

        const animalGenderGroup =
            document.getElementById(
                "animalGenderGroup"
            );

        const dateOfBirthGroup =
            document.getElementById(
                "dateOfBirthGroup"
            );

        const animalBreedGroup =
            document.getElementById(
                "animalBreedGroup"
            );

        const massGroup =
            document.getElementById(
                "massGroup"
            );

        const structureTypeGroup =
            document.getElementById(
                "structureTypeGroup"
            );

        const structureFarmGroup =
            document.getElementById(
                "structureFarmGroup"
            );


        /* ==================================================
           CONDITIONAL FIELDS
        ================================================== */

        const farmType =
            document.getElementById(
                "farmType"
            );

        const animalFarmCode =
            document.getElementById(
                "animalFarmCode"
            );

        const gender =
            document.getElementById(
                "gender"
            );

        const dateOfBirth =
            document.getElementById(
                "dateOfBirth"
            );

        const breed =
            document.getElementById(
                "breed"
            );

        const mass =
            document.getElementById(
                "mass"
            );

        const structureType =
            document.getElementById(
                "structureType"
            );

        const structureFarmCode =
            document.getElementById(
                "structureFarmCode"
            );


        /* ==================================================
           SECTION MAP
        ================================================== */

        const sections = [

            {
                element: farmTypeGroup,
                fields: [
                    farmType
                ]
            },

            {
                element: animalFarmGroup,
                fields: [
                    animalFarmCode
                ]
            },

            {
                element: animalGenderGroup,
                fields: [
                    gender
                ]
            },

            {
                element: dateOfBirthGroup,
                fields: [
                    dateOfBirth
                ]
            },

            {
                element: animalBreedGroup,
                fields: [
                    breed
                ]
            },

            {
                element: massGroup,
                fields: [
                    mass
                ]
            },

            {
                element: structureTypeGroup,
                fields: [
                    structureType
                ]
            },

            {
                element: structureFarmGroup,
                fields: [
                    structureFarmCode
                ]
            }

        ];


        /* ==================================================
           HIDE ALL CONDITIONAL SECTIONS
        ================================================== */

        function hideAllSections() {

            sections.forEach(
                function (section) {

                    section.element
                        .classList
                        .remove(
                            "visible"
                        );


                    section.fields.forEach(
                        function (field) {

                            field.disabled =
                                true;

                            field.required =
                                false;

                        }
                    );

                }
            );

        }


        /* ==================================================
           SHOW SECTION
        ================================================== */

        function showSection(
            section,
            requiredFields = []
        ) {

            const sectionData =
                sections.find(
                    function (item) {

                        return (
                            item.element ===
                            section
                        );

                    }
                );


            if (!sectionData) {

                return;

            }


            section.classList.add(
                "visible"
            );


            sectionData.fields.forEach(
                function (field) {

                    field.disabled =
                        false;

                }
            );


            requiredFields.forEach(
                function (field) {

                    if (field) {

                        field.required =
                            true;

                    }

                }
            );

        }


        /* ==================================================
           CLEAR CONDITIONAL VALUES
        ================================================== */

        function clearConditionalValues() {

            sections.forEach(
                function (section) {

                    section.fields.forEach(
                        function (field) {

                            if (
                                field.tagName ===
                                "SELECT"
                            ) {

                                field.selectedIndex =
                                    0;

                            } else {

                                field.value =
                                    "";

                            }

                        }
                    );

                }
            );

        }


        /* ==================================================
           UPDATE RECORD TYPE
        ================================================== */

        function updateRecordType() {

            hideAllSections();

            clearConditionalValues();


            const selectedType =
                recordType.value;


            if (
                selectedType ===
                "dairyFarm"
            ) {

                showSection(
                    farmTypeGroup,
                    [
                        farmType
                    ]
                );

            }


            if (
                selectedType ===
                "animal"
            ) {

                showSection(
                    animalFarmGroup,
                    [
                        animalFarmCode
                    ]
                );


                showSection(
                    animalGenderGroup,
                    [
                        gender
                    ]
                );


                showSection(
                    dateOfBirthGroup,
                    [
                        dateOfBirth
                    ]
                );


                showSection(
                    animalBreedGroup,
                    [
                        breed
                    ]
                );


                showSection(
                    massGroup
                );

            }


            if (
                selectedType ===
                "structure"
            ) {

                showSection(
                    structureTypeGroup,
                    [
                        structureType
                    ]
                );


                showSection(
                    structureFarmGroup
                );

            }

        }


        /* ==================================================
           RECORD TYPE CHANGE
        ================================================== */

        recordType.addEventListener(
            "change",
            function () {

                clearStatus();

                updateRecordType();

            }
        );


        /* ==================================================
           IMAGE PREVIEW
        ================================================== */

        profileImage.addEventListener(
            "change",
            function () {

                clearStatus();


                const file =
                    this.files &&
                    this.files[0];


                if (!file) {

                    profileImagePreview
                        .style
                        .display =
                        "none";

                    profileImagePlaceholder
                        .style
                        .display =
                        "inline";

                    return;

                }


                if (
                    !file.type.startsWith(
                        "image/"
                    )
                ) {

                    showError(
                        "Please select a valid image file."
                    );

                    this.value =
                        "";

                    return;

                }


                const reader =
                    new FileReader();


                reader.onload =
                    function (event) {

                        profileImagePreview
                            .src =
                            event.target.result;

                        profileImagePreview
                            .style
                            .display =
                            "block";

                        profileImagePlaceholder
                            .style
                            .display =
                            "none";

                    };


                reader.readAsDataURL(
                    file
                );

            }
        );


        /* ==================================================
           STATUS HELPERS
        ================================================== */

        function clearStatus() {

            statusBox.textContent =
                "";

            statusBox.className =
                "form-save-status";

        }


        function showError(
            message
        ) {

            statusBox.textContent =
                message;

            statusBox.className =
                "form-save-status error";

        }


        /* ==================================================
           CLIENT VALIDATION
        ================================================== */

        function validateForm() {

            const selectedType =
                recordType.value;


            if (!selectedType) {

                return (
                    "Please select what you are adding."
                );

            }


            const name =
                document
                    .getElementById(
                        "name"
                    )
                    .value
                    .trim();


            if (!name) {

                return (
                    "Name is required."
                );

            }


            if (
                selectedType ===
                "dairyFarm"
            ) {

                if (
                    !farmType.value
                ) {

                    return (
                        "Please select a Dairy Farm Type."
                    );

                }

            }


            if (
                selectedType ===
                "animal"
            ) {

                if (
                    !animalFarmCode.value
                ) {

                    return (
                        "Please select the Dairy Farm for this animal."
                    );

                }


                if (
                    !gender.value
                ) {

                    return (
                        "Please select the animal gender."
                    );

                }


                if (
                    !dateOfBirth.value
                ) {

                    return (
                        "Please enter the animal Date of Birth."
                    );

                }


                if (
                    !breed.value
                ) {

                    return (
                        "Please select the animal breed."
                    );

                }


                if (
                    mass.value !== "" &&
                    Number(mass.value) < 0
                ) {

                    return (
                        "Animal mass cannot be negative."
                    );

                }

            }


            if (
                selectedType ===
                "structure"
            ) {

                if (
                    !structureType.value
                ) {

                    return (
                        "Please select the Structure / Facility Type."
                    );

                }

            }


            const buyingPrice =
                document
                    .getElementById(
                        "buyingPrice"
                    )
                    .value;


            const currentWorth =
                document
                    .getElementById(
                        "currentWorth"
                    )
                    .value;


            if (
                buyingPrice !== "" &&
                Number(buyingPrice) < 0
            ) {

                return (
                    "Buying Price cannot be negative."
                );

            }


            if (
                currentWorth !== "" &&
                Number(currentWorth) < 0
            ) {

                return (
                    "Current Worth cannot be negative."
                );

            }


            return null;

        }


        /* ==================================================
           FORM SUBMISSION
        ================================================== */

        form.addEventListener(
            "submit",
            function (event) {

                clearStatus();


                const error =
                    validateForm();


                if (error) {

                    event.preventDefault();

                    showError(
                        error
                    );

                    return;

                }


                saveButton.disabled =
                    true;

                saveButton.textContent =
                    "Creating Record...";

            }
        );


        /* ==================================================
           INITIAL STATE
        ================================================== */

        hideAllSections();

        updateRecordType();


    }
);

</script>