<%
/* ==========================================================
   ADD DAIRY / ASSET PAGE

   BACKEND DATA
   ----------------------------------------------------------
   dairyBreeds:
       Breed values supplied by the Dairy model/service.

   structures:
       Existing Dairy Farm records supplied by the backend.

   SECURITY
   ----------------------------------------------------------
   This page must also be protected by server-side
   authentication/authorization. Client-side JavaScript is
   only responsible for UI behavior and is NOT security.
   ========================================================== */

const breeds =
    Array.isArray(dairyBreeds)
        ? dairyBreeds
        : [];

const dairyFarms =
    Array.isArray(structures)
        ? structures
        : [];

%>


<style>

/* ==========================================================
   PAGE
   ========================================================== */

.add-dairy-page {

    max-width: 900px;

    margin: 0 auto;

    padding: 24px 16px 50px;

}


/* ==========================================================
   HEADER
   ========================================================== */

.add-dairy-header {

    margin-bottom: 24px;

}

.add-dairy-header-top {

    display: flex;

    align-items: center;

    gap: 12px;

    margin-bottom: 18px;

}

.financial-back-link {

    display: inline-flex;

    align-items: center;

    gap: 6px;

    color: #2563eb;

    text-decoration: none;

    font-weight: 600;

    font-size: 14px;

}

.financial-back-link:hover {

    text-decoration: underline;

}

.add-dairy-header h1 {

    margin: 0;

    font-size: 30px;

    line-height: 1.2;

    color: #172033;

}

.add-dairy-header p {

    margin: 8px 0 0;

    color: #6b7280;

    font-size: 15px;

}


/* ==========================================================
   CARD
   ========================================================== */

.add-dairy-card {

    background: #ffffff;

    border-radius: 22px;

    padding: 24px;

    box-shadow:
        0 8px 30px rgba(15, 23, 42, 0.08);

    border: 1px solid #eef1f5;

}


/* ==========================================================
   FORM STATUS
   ========================================================== */

.form-save-status {

    display: none;

    margin-bottom: 20px;

    padding: 12px 14px;

    border-radius: 12px;

    font-size: 14px;

    font-weight: 600;

}

.form-save-status.success {

    display: block;

    background: #ecfdf5;

    color: #047857;

    border: 1px solid #a7f3d0;

}

.form-save-status.error {

    display: block;

    background: #fef2f2;

    color: #b91c1c;

    border: 1px solid #fecaca;

}


/* ==========================================================
   PROFILE IMAGE
   ========================================================== */

.profile-image-section {

    display: flex;

    flex-direction: column;

    align-items: center;

    text-align: center;

    padding: 8px 0 28px;

    margin-bottom: 24px;

    border-bottom: 1px solid #edf0f4;

}

.profile-image-preview {

    width: 125px;

    height: 125px;

    border-radius: 50%;

    overflow: hidden;

    display: flex;

    align-items: center;

    justify-content: center;

