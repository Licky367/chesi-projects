<% /*
============================================================
ADD DAIRY / ASSET PAGE

BACKEND DATA
------------------------------------------------------------
dairyBreeds:
    Breed values supplied by the Dairy model/service.

structures:
    Existing Dairy Farm records supplied by the backend.

SECURITY
------------------------------------------------------------
Server-side authentication and authorization must protect
the route. Browser JavaScript is only for UI behavior and
client-side validation.
============================================================
*/

const breeds =
    Array.isArray(dairyBreeds)
        ? dairyBreeds
        : [];

const dairyFarms =
    Array.isArray(structures)
        ? structures
        : [];

%>


<style>

/* ==========================================================
   PAGE
========================================================== */

.add-dairy-page {

    max-width: 900px;

    margin: 0 auto;

    padding: 24px 16px 60px;

}


/* ==========================================================
   HEADER
========================================================== */

