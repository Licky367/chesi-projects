<style>

  /* =========================
     PAGE HEADER
  ========================= */

  .batch-details-header {
    display: flex;

    align-items: flex-start;

    justify-content: space-between;

    gap: 20px;

    margin-bottom: 25px;
  }

  .batch-details-header h2 {
    margin: 0 0 6px;

    color: #166534;

    font-size: 28px;

    font-weight: 700;
  }

  .batch-details-header p {
    margin: 0;

    color: #6b7280;

    font-size: 14px;
  }

  .back-btn {
    display: inline-flex;

    align-items: center;

    gap: 6px;

    padding: 10px 15px;

    border-radius: 9px;

    background: #f3f4f6;

    color: #374151;

    font-size: 13px;

    font-weight: 600;

    text-decoration: none;

    transition: 0.25s ease;
  }

  .back-btn:hover {
    background: #e5e7eb;

    color: #111827;
  }


  /* =========================
     SUMMARY CARDS
  ========================= */

  .summary-grid {
    display: grid;

    grid-template-columns:
      repeat(3, 1fr);

    gap: 18px;

    margin-bottom: 30px;
  }

  .summary-card {
    display: flex;

    align-items: center;

    gap: 15px;

    padding: 20px;

    border-radius: 16px;

    background: #ffffff;

    box-shadow:
      0 6px 20px rgba(0, 0, 0, 0.06);
  }

  .summary-icon {
    width: 48px;
    height: 48px;

    display: flex;

    align-items: center;
    justify-content: center;

    border-radius: 14px;

    font-size: 23px;
  }

  .summary-card:nth-child(1) .summary-icon {
    background: #dcfce7;
  }

  .summary-card:nth-child(2) .summary-icon {
    background: #dbeafe;
  }

  .summary-card:nth-child(3) .summary-icon {
    background: #fef3c7;
  }

  .summary-card span {
    display: block;

    margin-bottom: 4px;

    color: #6b7280;

    font-size: 12px;
  }

  .summary-card strong {
    display: block;

    color: #111827;

    font-size: 19px;

    text-transform: capitalize;
  }


  /* =========================
     ACTION GRID
  ========================= */

  .actions-grid {
    display: grid;

    grid-template-columns:
      repeat(2, 1fr);

    gap: 22px;

    margin-bottom: 30px;
  }

  .action-card {
    padding: 25px;

    border-radius: 18px;

    background: #ffffff;

    box-shadow:
      0 6px 20px rgba(0, 0, 0, 0.06);
  }

  .action-header {
    display: flex;

    align-items: center;

    gap: 13px;

    margin-bottom: 20px;
  }

  .action-icon {
    width: 46px;
    height: 46px;

    display: flex;

    align-items: center;
    justify-content: center;

    border-radius: 13px;

    font-size: 22px;
  }

  .action-header h3 {
    margin: 0;

    color: #374151;

    font-size: 19px;
  }

  .action-header p {
    margin: 3px 0 0;

    color: #9ca3af;

    font-size: 12px;
  }


  /* =========================
     ACTION COLORS
  ========================= */

  .eggs-card {
    border-top: 5px solid #f59e0b;
  }

  .eggs-card .action-icon {
    background: #fef3c7;
  }

  .death-card {
    border-top: 5px solid #dc3545;
  }

  .death-card .action-icon {
    background: #fee2e2;
  }

  .sell-card {
    border-top: 5px solid #198754;
  }

  .sell-card .action-icon {
    background: #dcfce7;
  }

  .cage-card {
    border-top: 5px solid #0d6efd;
  }

  .cage-card .action-icon {
    background: #dbeafe;
  }


  /* =========================
     FORMS
  ========================= */

  .action-form {
    display: flex;

    flex-direction: column;

    gap: 12px;
  }

  .action-form label {
    color: #374151;

    font-size: 13px;

    font-weight: 600;
  }

  .action-form input {
    width: 100%;

    padding: 13px 14px;

    border: 1px solid #d1d5db;

    border-radius: 10px;

    outline: none;

    background: #f9fafb;

    color: #111827;

    font-size: 14px;

    transition: all 0.25s ease;
  }

  .action-form input:focus {
    border-color: #16a34a;

    background: #ffffff;

    box-shadow:
      0 0 0 4px rgba(22, 163, 74, 0.12);
  }

  .form-row {
    display: grid;

    grid-template-columns:
      1fr
      1fr;

    gap: 12px;
  }


  /* =========================
     BUTTONS
  ========================= */

  .action-btn {
    width: 100%;

    padding: 13px;

    border: none;

    border-radius: 10px;

    color: #ffffff;

    font-size: 14px;

    font-weight: 700;

    cursor: pointer;

    transition: all 0.25s ease;
  }

  .action-btn:hover {
    transform: translateY(-2px);

    box-shadow:
      0 7px 16px rgba(0, 0, 0, 0.15);
  }

  .btn-eggs {
    background: #d97706;
  }

  .btn-death {
    background: #dc3545;
  }

  .btn-sell {
    background: #198754;
  }

  .btn-cage {
    background: #0d6efd;
  }


  /* =========================
     DEATH RECORDS
  ========================= */

  .records-card {
    padding: 25px;

    border-radius: 18px;

    background: #ffffff;

    box-shadow:
      0 6px 20px rgba(0, 0, 0, 0.06);
  }

  .records-card h3 {
    margin: 0 0 18px;

    color: #374151;

    font-size: 20px;
  }

  .death-record {
    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 15px;

    padding: 14px 16px;

    margin-bottom: 10px;

    border-radius: 10px;

    background: #fef2f2;

    border-left: 4px solid #dc3545;
  }

  .death-record:last-child {
    margin-bottom: 0;
  }

  .death-count {
    color: #b91c1c;

    font-weight: 700;
  }

  .death-cause {
    color: #6b7280;

    font-size: 14px;
  }

  .no-records {
    padding: 20px;

    border-radius: 10px;

    background: #f9fafb;

    color: #6b7280;

    font-size: 14px;

    text-align: center;
  }


  /* =========================
     RESPONSIVE
  ========================= */

  @media (max-width: 900px) {

    .summary-grid {
      grid-template-columns:
        repeat(2, 1fr);
    }

    .actions-grid {
      grid-template-columns:
        1fr;
    }

  }

  @media (max-width: 600px) {

    .batch-details-header {
      flex-direction: column;
    }

    .back-btn {
      width: 100%;

      justify-content: center;
    }

    .summary-grid {
      grid-template-columns:
        1fr;
    }

    .batch-details-header h2 {
      font-size: 24px;
    }

    .action-card {
      padding: 21px;
    }

    .form-row {
      grid-template-columns:
        1fr;
    }

  }

</style>


<div class="container mt-4 mb-5">


  <!-- PAGE HEADER -->

  <div class="batch-details-header">

    <div>

      <h2>
        🐥 <%= batch.groupName %>
      </h2>

      <p>
        Manage this poultry batch and record daily activities.
      </p>

    </div>


    <a
      href="/nursing"
      class="back-btn"
    >

      ← Back to Nursing

    </a>

  </div>


  <!-- SUMMARY -->

  <div class="summary-grid">


    <div class="summary-card">

      <div class="summary-icon">
        🐣
      </div>

      <div>

        <span>
          Available Poultry
        </span>

        <strong>
          <%= batch.available %>
        </strong>

      </div>

    </div>


    <div class="summary-card">

      <div class="summary-icon">
        🐔
      </div>

      <div>

        <span>
          Poultry Type
        </span>

        <strong>
          <%= batch.poultryType %>
        </strong>

      </div>

    </div>


    <div class="summary-card">

      <div class="summary-icon">
        📅
      </div>

      <div>

        <span>
          Date of Birth
        </span>

        <strong>
          <%= batch.dob.toDateString() %>
        </strong>

      </div>

    </div>


  </div>


  <!-- ACTIONS -->

  <div class="actions-grid">


    <!-- COLLECT EGGS -->

    <div class="action-card eggs-card">

      <div class="action-header">

        <div class="action-icon">
          🥚
        </div>

        <div>

          <h3>
            Collect Eggs
          </h3>

          <p>
            Record eggs collected from this batch.
          </p>

        </div>

      </div>


      <form
        method="POST"
        action="/nursing/<%= batch._id %>/eggs"
        class="action-form"
      >

        <input
          type="hidden"
          name="poultryType"
          value="<%= batch.poultryType %>"
        >

        <label for="eggs">
          Number of Eggs
        </label>

        <input
          type="number"
          id="eggs"
          name="eggs"
          min="1"
          placeholder="Enter number of eggs"
          required
        >

        <button
          type="submit"
          class="action-btn btn-eggs"
        >

          Collect Eggs

        </button>

      </form>

    </div>


    <!-- RECORD DEATH -->

    <div class="action-card death-card">

      <div class="action-header">

        <div class="action-icon">
          ⚠️
        </div>

        <div>

          <h3>
            Record Deaths
          </h3>

          <p>
            Track poultry losses and their causes.
          </p>

        </div>

      </div>


      <form
        method="POST"
        action="/nursing/<%= batch._id %>/death"
        class="action-form"
      >

        <div class="form-row">

          <div>

            <label for="deathCount">
              Number Dead
            </label>

            <input
              type="number"
              id="deathCount"
              name="count"
              min="1"
              placeholder="Count"
              required
            >

          </div>


          <div>

            <label for="cause">
              Cause
            </label>

            <input
              type="text"
              id="cause"
              name="cause"
              placeholder="e.g. Disease"
              required
            >

          </div>

        </div>


        <button
          type="submit"
          class="action-btn btn-death"
        >

          Record Death

        </button>

      </form>

    </div>


    <!-- SELL POULTRY -->

    <div class="action-card sell-card">

      <div class="action-header">

        <div class="action-icon">
          💰
        </div>

        <div>

          <h3>
            Sell Poultry
          </h3>

          <p>
            Record a poultry sale from this batch.
          </p>

        </div>

      </div>


      <form
        method="POST"
        action="/nursing/<%= batch._id %>/sell"
        class="action-form"
      >

        <div class="form-row">

          <div>

            <label for="sellCount">
              Quantity
            </label>

            <input
              type="number"
              id="sellCount"
              name="count"
              min="1"
              placeholder="Quantity"
              required
            >

          </div>


          <div>

            <label for="amount">
              Amount
            </label>

            <input
              type="number"
              id="amount"
              name="amount"
              min="0"
              placeholder="Amount"
              required
            >

          </div>

        </div>


        <button
          type="submit"
          class="action-btn btn-sell"
        >

          Record Sale

        </button>

      </form>

    </div>


    <!-- CAGE POULTRY -->

    <div class="action-card cage-card">

      <div class="action-header">

        <div class="action-icon">
          🏠
        </div>

        <div>

          <h3>
            Cage Poultry
          </h3>

          <p>
            Available for chicken batches only.
          </p>

        </div>

      </div>


      <form
        method="POST"
        action="/nursing/<%= batch._id %>/cage"
        class="action-form"
      >

        <label for="perCage">
          Birds Per Cage
        </label>

        <input
          type="number"
          id="perCage"
          name="perCage"
          min="1"
          placeholder="Enter birds per cage"
          required
        >

        <button
          type="submit"
          class="action-btn btn-cage"
        >

          Cage Poultry

        </button>

      </form>

    </div>


  </div>


  <!-- DEATH RECORDS -->

  <div class="records-card">

    <h3>
      📋 Death Records
    </h3>


    <% if (batch.deaths && batch.deaths.length > 0) { %>


      <% batch.deaths.forEach(d => { %>

        <div class="death-record">

          <span class="death-count">

            <%= d.count %> poultry died

          </span>

          <span class="death-cause">

            Cause: <%= d.cause %>

          </span>

        </div>

      <% }) %>


    <% } else { %>


      <div class="no-records">

        No death records have been recorded for this batch.

      </div>


    <% } %>


  </div>


</div>