<style>

  /* =========================
     PAGE HEADER
  ========================= */

  .analytics-header {
    display: flex;

    align-items: flex-start;

    justify-content: space-between;

    gap: 20px;

    margin-bottom: 25px;
  }

  .analytics-header h2 {
    margin: 0 0 6px;

    color: #166534;

    font-size: 28px;

    font-weight: 700;
  }

  .analytics-header p {
    margin: 0;

    color: #6b7280;

    font-size: 14px;
  }


  /* =========================
     FILTER CARD
  ========================= */

  .filter-card {
    padding: 22px;

    margin-bottom: 28px;

    border-radius: 18px;

    background: #ffffff;

    box-shadow:
      0 6px 20px rgba(0, 0, 0, 0.06);
  }

  .filter-form {
    display: grid;

    grid-template-columns:
      1fr
      1fr
      auto;

    align-items: end;

    gap: 15px;
  }

  .filter-group {
    display: flex;

    flex-direction: column;

    gap: 7px;
  }

  .filter-group label {
    color: #374151;

    font-size: 13px;

    font-weight: 600;
  }

  .filter-group input,
  .filter-group select {
    width: 100%;

    padding: 13px 14px;

    border: 1px solid #d1d5db;

    border-radius: 10px;

    outline: none;

    background: #f9fafb;

    color: #111827;

    font-size: 14px;

    transition: all 0.25s ease;
  }

  .filter-group input:focus,
  .filter-group select:focus {
    border-color: #16a34a;

    background: #ffffff;

    box-shadow:
      0 0 0 4px rgba(22, 163, 74, 0.12);
  }

  .filter-btn {
    padding: 13px 25px;

    border: none;

    border-radius: 10px;

    background:
      linear-gradient(135deg, #16a34a, #15803d);

    color: #ffffff;

    font-size: 14px;

    font-weight: 700;

    cursor: pointer;

    transition: all 0.25s ease;
  }

  .filter-btn:hover {
    transform: translateY(-2px);

    box-shadow:
      0 8px 18px rgba(22, 163, 74, 0.25);
  }


  /* =========================
     SUMMARY CARDS
  ========================= */

  .analytics-summary {
    display: grid;

    grid-template-columns:
      repeat(3, 1fr);

    gap: 18px;

    margin-bottom: 28px;
  }

  .summary-card {
    padding: 22px;

    border-radius: 16px;

    background: #ffffff;

    box-shadow:
      0 6px 20px rgba(0, 0, 0, 0.06);
  }

  .summary-card-header {
    display: flex;

    align-items: center;

    justify-content: space-between;

    margin-bottom: 14px;
  }

  .summary-card-title {
    color: #6b7280;

    font-size: 13px;

    font-weight: 600;
  }

  .summary-card-icon {
    width: 40px;
    height: 40px;

    display: flex;

    align-items: center;
    justify-content: center;

    border-radius: 12px;

    font-size: 20px;
  }

  .summary-card-value {
    color: #111827;

    font-size: 25px;

    font-weight: 700;
  }

  .summary-card:nth-child(1) {
    border-left: 5px solid #f59e0b;
  }

  .summary-card:nth-child(1) .summary-card-icon {
    background: #fef3c7;
  }

  .summary-card:nth-child(2) {
    border-left: 5px solid #198754;
  }

  .summary-card:nth-child(2) .summary-card-icon {
    background: #dcfce7;
  }

  .summary-card:nth-child(3) {
    border-left: 5px solid #0d6efd;
  }

  .summary-card:nth-child(3) .summary-card-icon {
    background: #dbeafe;
  }


  /* =========================
     TABLE CARD
  ========================= */

  .analytics-table-card {
    overflow: hidden;

    border-radius: 18px;

    background: #ffffff;

    box-shadow:
      0 6px 20px rgba(0, 0, 0, 0.06);
  }

  .table-header {
    display: flex;

    align-items: center;

    justify-content: space-between;

    padding: 22px 25px;

    border-bottom: 1px solid #e5e7eb;
  }

  .table-header h3 {
    margin: 0;

    color: #374151;

    font-size: 20px;
  }

  .selected-filter {
    padding: 7px 12px;

    border-radius: 20px;

    background: #dcfce7;

    color: #166534;

    font-size: 12px;

    font-weight: 700;
  }


  /* =========================
     TABLE
  ========================= */

  .table-wrapper {
    overflow-x: auto;
  }

  .analytics-table {
    width: 100%;

    border-collapse: collapse;

    min-width: 600px;
  }

  .analytics-table th {
    padding: 16px 20px;

    background: #f9fafb;

    color: #6b7280;

    font-size: 12px;

    font-weight: 700;

    text-align: left;

    text-transform: uppercase;

    letter-spacing: 0.4px;
  }

  .analytics-table td {
    padding: 17px 20px;

    border-top: 1px solid #f0f0f0;

    color: #374151;

    font-size: 14px;
  }

  .analytics-table tbody tr {
    transition: background 0.2s ease;
  }

  .analytics-table tbody tr:hover {
    background: #f9fafb;
  }

  .poultry-type {
    display: inline-flex;

    align-items: center;

    gap: 8px;

    font-weight: 700;

    text-transform: capitalize;
  }

  .poultry-type::before {
    content: "🐔";

    font-size: 18px;
  }

  .metric-value {
    font-weight: 600;
  }


  /* =========================
     TABLE FOOTER
  ========================= */

  .analytics-table tfoot {
    background: #f0fdf4;
  }

  .analytics-table tfoot th {
    padding: 18px 20px;

    background: #f0fdf4;

    color: #166534;

    font-size: 14px;

    text-transform: none;

    letter-spacing: normal;
  }

  .total-label {
    font-size: 15px !important;

    font-weight: 700 !important;
  }


  /* =========================
     EMPTY STATE
  ========================= */

  .empty-state {
    padding: 50px 20px;

    color: #6b7280;

    text-align: center;
  }

  .empty-state-icon {
    margin-bottom: 10px;

    font-size: 40px;
  }


  /* =========================
     RESPONSIVE
  ========================= */

  @media (max-width: 900px) {

    .analytics-summary {
      grid-template-columns:
        repeat(2, 1fr);
    }

    .filter-form {
      grid-template-columns:
        1fr
        1fr;
    }

    .filter-btn {
      width: 100%;
    }

  }

  @media (max-width: 600px) {

    .analytics-header {
      flex-direction: column;
    }

    .analytics-header h2 {
      font-size: 24px;
    }

    .analytics-summary {
      grid-template-columns:
        1fr;
    }

    .filter-form {
      display: flex;

      flex-direction: column;

      align-items: stretch;
    }

    .filter-card {
      padding: 18px;
    }

    .table-header {
      align-items: flex-start;

      flex-direction: column;

      gap: 12px;
    }

  }

</style>


<div class="container mt-4 mb-5">


  <!-- PAGE HEADER -->

  <div class="analytics-header">

    <div>

      <h2>
        📊 Poultry Analytics Dashboard
      </h2>

      <p>
        Track production, sales, revenue, and profitability across your poultry operations.
      </p>

    </div>

  </div>


  <!-- FILTER -->

  <div class="filter-card">

    <form
      method="GET"
      action="/poultry-stats"
      class="filter-form"
    >


      <div class="filter-group">

        <label for="date">
          Select Date
        </label>

        <input
          type="date"
          id="date"
          name="date"
          value="<%= selectedDate || '' %>"
        >

      </div>


      <div class="filter-group">

        <label for="type">
          Analytics Metric
        </label>

        <select
          id="type"
          name="type"
        >

          <option
            value="eggs"
            <%= selectedType === "eggs" ? "selected" : "" %>
          >
            🥚 Eggs Collected
          </option>

          <option
            value="egg_sales"
            <%= selectedType === "egg_sales" ? "selected" : "" %>
          >
            💰 Egg Sales Revenue
          </option>

          <option
            value="poultry_sales"
            <%= selectedType === "poultry_sales" ? "selected" : "" %>
          >
            💵 Poultry Sales Revenue
          </option>

          <option
            value="total_revenue"
            <%= selectedType === "total_revenue" ? "selected" : "" %>
          >
            📈 Total Revenue
          </option>

          <option
            value="profit"
            <%= selectedType === "profit" ? "selected" : "" %>
          >
            💎 Profit
          </option>

        </select>

      </div>


      <button
        type="submit"
        class="filter-btn"
      >

        🔍 Apply Filter

      </button>


    </form>

  </div>


  <!-- SUMMARY -->

  <div class="analytics-summary">


    <div class="summary-card">

      <div class="summary-card-header">

        <span class="summary-card-title">
          Daily Total
        </span>

        <div class="summary-card-icon">
          📅
        </div>

      </div>

      <div class="summary-card-value">
        <%= grandTotal.day %>
      </div>

    </div>


    <div class="summary-card">

      <div class="summary-card-header">

        <span class="summary-card-title">
          Monthly Total
        </span>

        <div class="summary-card-icon">
          📊
        </div>

      </div>

      <div class="summary-card-value">
        <%= grandTotal.month %>
      </div>

    </div>


    <div class="summary-card">

      <div class="summary-card-header">

        <span class="summary-card-title">
          Yearly Total
        </span>

        <div class="summary-card-icon">
          📈
        </div>

      </div>

      <div class="summary-card-value">
        <%= grandTotal.year %>
      </div>

    </div>


  </div>


  <!-- ANALYTICS TABLE -->

  <div class="analytics-table-card">


    <div class="table-header">

      <h3>
        Performance Breakdown
      </h3>

      <span class="selected-filter">

        <%= selectedType || "Analytics" %>

      </span>

    </div>


    <% if (rows && rows.length > 0) { %>


      <div class="table-wrapper">

        <table class="analytics-table">

          <thead>

            <tr>

              <th>
                Poultry Type
              </th>

              <th>
                Day Total
              </th>

              <th>
                Month Total
              </th>

              <th>
                Year Total
              </th>

            </tr>

          </thead>


          <tbody>


            <% rows.forEach(r => { %>

              <tr>

                <td>

                  <span class="poultry-type">

                    <%= r.poultryType %>

                  </span>

                </td>

                <td class="metric-value">

                  <%= r.day %>

                </td>

                <td class="metric-value">

                  <%= r.month %>

                </td>

                <td class="metric-value">

                  <%= r.year %>

                </td>

              </tr>

            <% }) %>


          </tbody>


          <tfoot>

            <tr>

              <th class="total-label">
                Grand Total
              </th>

              <th>
                <%= grandTotal.day %>
              </th>

              <th>
                <%= grandTotal.month %>
              </th>

              <th>
                <%= grandTotal.year %>
              </th>

            </tr>

          </tfoot>


        </table>

      </div>


    <% } else { %>


      <div class="empty-state">

        <div class="empty-state-icon">
          📊
        </div>

        <h4>
          No Analytics Data
        </h4>

        <p>
          There is currently no data available for the selected filters.
        </p>

      </div>


    <% } %>


  </div>


</div>