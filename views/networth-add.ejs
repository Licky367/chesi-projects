<style>

/* ==========================================================
   NET WORTH ASSET ADD PAGE
========================================================== */

.financial-page.networth-page {

    max-width: 850px;

    margin: 0 auto;

    padding: 25px 18px 55px;

    box-sizing: border-box;

}


/* ==========================================================
   HEADER
========================================================== */

.networth-page .financial-header {

    margin-bottom: 25px;

}

.networth-page .financial-header h1 {

    margin: 10px 0 6px;

    color: #173b2a;

    font-size: 30px;

    font-weight: 800;

    line-height: 1.2;

    letter-spacing: -0.6px;

    overflow-wrap: anywhere;

}

.networth-page .financial-header p {

    margin: 0;

    color: #718078;

    font-size: 15px;

    line-height: 1.5;

}


/* ==========================================================
   BACK LINK
========================================================== */

.financial-back-link {

    display: inline-flex;

    align-items: center;

    gap: 6px;

    color: #2f7d4c;

    font-size: 13px;

    font-weight: 700;

    text-decoration: none;

    transition:
        color 0.2s ease,
        transform 0.2s ease;

}

.financial-back-link:hover {

    color: #1e6037;

    transform: translateX(-2px);

}


/* ==========================================================
   MAIN CARD
========================================================== */

.networth-page > .financial-card {

    overflow: hidden;

    padding: 30px;

    box-sizing: border-box;

    background: #ffffff;

    border: 1px solid #e1e9e4;

    border-radius: 18px;

    box-shadow:
        0 8px 25px rgba(25, 70, 43, 0.055),
        0 2px 6px rgba(25, 70, 43, 0.025);

}


/* ==========================================================
   FORM
========================================================== */

.networth-form {

    width: 100%;

}

.networth-form .form-group {

    margin-bottom: 21px;

}


/* ==========================================================
   LABEL
========================================================== */

.networth-form .form-group > label {

    display: block;

    margin-bottom: 8px;

    color: #304139;

    font-size: 13px;

    font-weight: 750;

    line-height: 1.4;

}


/* ==========================================================
   INPUT / SELECT / TEXTAREA
========================================================== */

.networth-form .form-group input,
.networth-form .form-group select,
.networth-form .form-group textarea {

    display: block;

    width: 100%;

    box-sizing: border-box;

    border: 1px solid #d5dfd9;

    border-radius: 11px;

    background: #fbfdfb;

    color: #24352c;

    font-family: inherit;

    font-size: 14px;

    outline: none;

    transition:
        border-color 0.2s ease,
        box-shadow 0.2s ease,
        background 0.2s ease;

}


/* ==========================================================
   INPUT
========================================================== */

.networth-form .form-group input {

    height: 49px;

    padding: 0 14px;

}


/* ==========================================================
   SELECT
========================================================== */

.networth-form .form-group select {

    height: 49px;

    padding: 0 40px 0 14px;

    cursor: pointer;

}


/* ==========================================================
   TEXTAREA
========================================================== */

.networth-form .form-group textarea {

    min-height: 115px;

    padding: 13px 14px;

    resize: vertical;

    line-height: 1.55;

}


/* ==========================================================
   FOCUS
========================================================== */

.networth-form .form-group input:focus,
.networth-form .form-group select:focus,
.networth-form .form-group textarea:focus {

    background: #ffffff;

    border-color: #3b945b;

    box-shadow:
        0 0 0 3px rgba(59, 148, 91, 0.11);

}


/* ==========================================================
   PLACEHOLDER
========================================================== */

.networth-form input::placeholder,
.networth-form textarea::placeholder {

    color: #9aa79f;

}


/* ==========================================================
   CODE / MONEY
========================================================== */

.networth-form #buyingPrice,
.networth-form #currentWorth {

    font-weight: 650;

    font-variant-numeric: tabular-nums;

}


/* ==========================================================
   CURRENT WORTH
========================================================== */

.networth-form #currentWorth {

    border-color: #bcd8c5;

    background: #f7fcf8;

}

.networth-form #currentWorth:focus {

    background: #ffffff;

    border-color: #328650;

    box-shadow:
        0 0 0 3px rgba(50, 134, 80, 0.12);

}


/* ==========================================================
   PARENT FARM INFORMATION
========================================================== */

.structure-info {

    margin-bottom: 21px;

    padding: 14px 16px;

    background: #f3f8f4;

    border: 1px solid #dce9df;

    border-radius: 11px;

    color: #50665a;

    font-size: 13px;

    line-height: 1.5;

}

.structure-info strong {

    color: #294c37;

}


/* ==========================================================
   INFORMATION ICON / MARKER
========================================================== */

.parent-farm-display {

    display: flex;

    flex-direction: column;

    gap: 4px;

    min-height: 49px;

    padding: 10px 14px;

    box-sizing: border-box;

    border: 1px solid #d8e4dc;

    border-radius: 11px;

    background: #f3f7f4;

}

.parent-farm-name {

    color: #294c37;

    font-size: 14px;

    font-weight: 750;

}

.parent-farm-code {

    color: #718078;

    font-size: 12px;

}


/* ==========================================================
   SAVE STATUS
========================================================== */

.form-save-status {

    display: none;

    margin-bottom: 18px;

    padding: 12px 14px;

    border-radius: 10px;

    font-size: 13px;

    line-height: 1.4;

}

.form-save-status.success {

    display: block;

    background: #eef8f1;

    border: 1px solid #cfe5d5;

    color: #28633b;

}

.form-save-status.error {

    display: block;

    background: #fff3f2;

    border: 1px solid #efd0cd;

    color: #a13c35;

}


/* ==========================================================
   ACTIONS
========================================================== */

.networth-form .form-actions {

    display: flex;

    align-items: center;

    justify-content: flex-end;

    gap: 11px;

    margin-top: 8px;

    padding-top: 22px;

    border-top: 1px solid #edf1ee;

}


/* ==========================================================
   BUTTON
========================================================== */

.networth-form .button {

    display: inline-flex;

    align-items: center;

    justify-content: center;

    gap: 8px;

    min-height: 46px;

    padding: 0 19px;

    box-sizing: border-box;

    border-radius: 10px;

    font-family: inherit;

    font-size: 14px;

    font-weight: 700;

    text-decoration: none;

    cursor: pointer;

    transition:
        background 0.2s ease,
        border-color 0.2s ease,
        color 0.2s ease,
        box-shadow 0.2s ease,
        transform 0.2s ease;

}


/* ==========================================================
   SECONDARY
========================================================== */

.networth-form .button-secondary {

    background: #ffffff;

    color: #536159;

    border: 1px solid #d6dfd9;

}

.networth-form .button-secondary:hover {

    background: #f7f9f7;

    border-color: #c4d0c8;

    color: #29382f;

    transform: translateY(-1px);

}


/* ==========================================================
   PRIMARY
========================================================== */

.networth-form .button-primary {

    background: #2f8f55;

    color: #ffffff;

    border: 1px solid #2f8f55;

    box-shadow:
        0 5px 12px rgba(47, 143, 85, 0.17);

}

.networth-form .button-primary::before {

    content: "+";

    font-size: 16px;

}

.networth-form .button-primary:hover {

    background: #267747;

    border-color: #267747;

    box-shadow:
        0 7px 16px rgba(47, 143, 85, 0.22);

    transform: translateY(-1px);

}

.networth-form .button-primary:disabled {

    opacity: 0.65;

    cursor: wait;

    transform: none;

}


/* ==========================================================
   MOBILE
========================================================== */

@media (max-width: 650px) {

    .financial-page.networth-page {

        padding: 18px 14px 45px;

    }

    .networth-page .financial-header h1 {

        font-size: 25px;

    }

    .networth-page .financial-header p {

        font-size: 14px;

    }

    .networth-page > .financial-card {

        padding: 22px 18px;

        border-radius: 15px;

    }

    .networth-form .form-group {

        margin-bottom: 19px;

    }

    .networth-form .form-group input,
    .networth-form .form-group select {

        height: 48px;

    }

    .networth-form .form-group textarea {

        min-height: 110px;

    }

    .networth-form .form-actions {

        flex-direction: column-reverse;

        align-items: stretch;

        gap: 10px;

        padding-top: 19px;

    }

    .networth-form .button {

        width: 100%;

        min-height: 48px;

    }

}


/* ==========================================================
   SMALL PHONES
========================================================== */

@media (max-width: 380px) {

    .financial-page.networth-page {

        padding-left: 10px;

        padding-right: 10px;

    }

    .networth-page > .financial-card {

        padding: 19px 14px;

    }

    .networth-page .financial-header h1 {

        font-size: 23px;

    }

}

</style>


<%

/* ==========================================================
   ADD PAGE DATA
========================================================== */

const parentFarm =
    dairy || {};

const parentFarmName =
    parentFarm.name ||
    "Dairy Farm";

const parentFarmCode =
    parentFarm.code !== undefined &&
    parentFarm.code !== null
        ? parentFarm.code
        : "";


/* ==========================================================
   ASSET TYPES
========================================================== */

const assetTypes = [

    "machine",
    "equipment",
    "tool",
    "building",
    "cowshed",
    "milkingParlour",
    "feedStore",
    "hayShed",
    "waterSystem",
    "fencing",
    "vehicle",
    "generator",
    "solarSystem",
    "other"

];


/* ==========================================================
   STATUS VALUES
========================================================== */

const statusValues = [

    "active",
    "sold",
    "disposed",
    "inactive"

];

%>


<div class="financial-page networth-page">


    <!-- ======================================================
         HEADER
    ======================================================= -->

    <div class="financial-header">

        <div>


            <!-- ==============================================
                 BACK TO DAIRY FARM
            =============================================== -->

            <a
                href="/dairy/<%= parentFarm._id %>"
                class="financial-back-link"
            >

                ← Dairy Farm

            </a>


            <h1>

                Add Asset

            </h1>


            <p>

                Add a new asset to
                <strong>
                    <%= parentFarmName %>
                </strong>.

            </p>


        </div>

    </div>



    <!-- ======================================================
         MAIN CARD
    ======================================================= -->

    <div class="financial-card">


        <form
            id="networthAddForm"
            action="/networth/structure/<%= parentFarm._id %>/add"
            method="POST"
            class="networth-form"
        >


            <!-- =================================================
                 SAVE STATUS
            ================================================== -->

            <div
                id="formSaveStatus"
                class="form-save-status"
                role="status"
                aria-live="polite"
            ></div>



            <!-- =================================================
                 PARENT DAIRY FARM
            ================================================== -->

            <div class="form-group">


                <label>

                    Parent Dairy Farm

                </label>


                <div class="parent-farm-display">


                    <div class="parent-farm-name">

                        <%= parentFarmName %>

                    </div>


                    <div class="parent-farm-code">

                        Dairy Farm Code:
                        <%= parentFarmCode %>

                    </div>


                </div>


            </div>



            <!-- =================================================
                 INFORMATION
            ================================================== -->

            <div class="structure-info">


                <strong>

                    Manual asset.

                </strong>


                This asset will automatically be assigned
                to the selected Dairy Farm.


                <br>


                You do not need to enter an asset code.
                The system will use the Dairy Farm's code
                automatically.

            </div>



            <!-- =================================================
                 NAME
            ================================================== -->

            <div class="form-group">


                <label for="name">

                    Name

                </label>


                <input
                    type="text"
                    id="name"
                    name="name"
                    maxlength="200"
                    autocomplete="off"
                    placeholder="Enter asset name"
                    required
                >


            </div>



            <!-- =================================================
                 ASSET TYPE
            ================================================== -->

            <div class="form-group">


                <label for="type">

                    Asset Type

                </label>


                <select
                    id="type"
                    name="type"
                    required
                >


                    <option
                        value=""
                        selected
                        disabled
                    >

                        Select asset type

                    </option>


                    <% assetTypes.forEach(
                        function(assetType)
                    { %>


                        <option
                            value="<%= assetType %>"
                        >

                            <%= assetType
                                .replace(
                                    /([A-Z])/g,
                                    " $1"
                                )
                                .replace(
                                    /^./,
                                    function(char) {
                                        return char.toUpperCase();
                                    }
                                ) %>

                        </option>


                    <% }); %>


                </select>


            </div>



            <!-- =================================================
                 BUYING PRICE
            ================================================== -->

            <div class="form-group">


                <label for="buyingPrice">

                    Buying Price

                </label>


                <input
                    type="number"
                    id="buyingPrice"
                    name="buyingPrice"
                    min="0"
                    step="0.01"
                    inputmode="decimal"
                    value="0"
                    placeholder="Enter buying price"
                    required
                >


            </div>



            <!-- =================================================
                 CURRENT WORTH
            ================================================== -->

            <div class="form-group">


                <label for="currentWorth">

                    Current Worth

                </label>


                <input
                    type="number"
                    id="currentWorth"
                    name="currentWorth"
                    min="0"
                    step="0.01"
                    inputmode="decimal"
                    value="0"
                    placeholder="Enter current estimated worth"
                    required
                >


            </div>



            <!-- =================================================
                 DESCRIPTION
            ================================================== -->

            <div class="form-group">


                <label for="description">

                    Description

                </label>


                <textarea
                    id="description"
                    name="description"
                    rows="4"
                    placeholder="Describe the asset..."
                ></textarea>


            </div>



            <!-- =================================================
                 CONDITION
            ================================================== -->

            <div class="form-group">


                <label for="condition">

                    Condition

                </label>


                <input
                    type="text"
                    id="condition"
                    name="condition"
                    maxlength="200"
                    placeholder="e.g. Good, New, Needs Repair"
                >


            </div>



            <!-- =================================================
                 PHYSICAL LOCATION
            ================================================== -->

            <div class="form-group">


                <label for="location">

                    Physical Location

                </label>


                <input
                    type="text"
                    id="location"
                    name="location"
                    maxlength="300"
                    placeholder="Where is the asset physically located?"
                >


            </div>



            <!-- =================================================
                 STATUS
            ================================================== -->

            <div class="form-group">


                <label for="status">

                    Status

                </label>


                <select
                    id="status"
                    name="status"
                    required
                >


                    <% statusValues.forEach(
                        function(status)
                    { %>


                        <option
                            value="<%= status %>"
                            <%= status === "active"
                                ? "selected"
                                : "" %>
                        >

                            <%= status.charAt(0).toUpperCase() +
                                status.slice(1) %>

                        </option>


                    <% }); %>


                </select>


            </div>



            <!-- =================================================
                 ACTIONS
            ================================================== -->

            <div class="form-actions">


                <a
                    href="/networth"
                    class="button button-secondary"
                >

                    Cancel

                </a>


                <button
                    type="submit"
                    id="saveAssetButton"
                    class="button button-primary"
                >

                    Add Asset

                </button>


            </div>


        </form>


    </div>


</div>



<script>

document.addEventListener(
    "DOMContentLoaded",
    function() {


        const form =
            document.getElementById(
                "networthAddForm"
            );


        const button =
            document.getElementById(
                "saveAssetButton"
            );


        const status =
            document.getElementById(
                "formSaveStatus"
            );


        if (!form) {

            return;

        }


        form.addEventListener(
            "submit",
            async function(event) {

                event.preventDefault();


                if (button) {

                    button.disabled = true;

                    button.textContent =
                        "Adding...";

                }


                if (status) {

                    status.className =
                        "form-save-status";

                    status.textContent =
                        "";

                }


                try {

                    const response =
                        await fetch(
                            form.action,
                            {

                                method: "POST",

                                body:
                                    new FormData(form),

                                headers: {

                                    "Accept":
                                        "application/json"

                                }

                            }
                        );


                    let result = null;


                    try {

                        result =
                            await response.json();

                    } catch (jsonError) {

                        result = null;

                    }


                    if (
                        !response.ok ||
                        !result ||
                        !result.success
                    ) {

                        throw new Error(

                            result &&
                            result.message

                                ? result.message

                                : "Unable to add the asset."

                        );

                    }


                    if (status) {

                        status.className =
                            "form-save-status success";

                        status.textContent =
                            result.message ||
                            "Asset added successfully.";

                    }


                    setTimeout(
                        function() {

                            window.location.href =
                                "/dairy/<%= parentFarm._id %>";

                        },
                        700
                    );


                } catch (error) {


                    console.error(
                        "Add Asset Error:",
                        error
                    );


                    if (status) {

                        status.className =
                            "form-save-status error";

                        status.textContent =
                            error.message ||
                            "Unable to add the asset.";

                    }


                    if (button) {

                        button.disabled =
                            false;

                        button.textContent =
                            "Add Asset";

                    }

                }

            }
        );

    }
);

</script>