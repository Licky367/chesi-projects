<style>

/* ==========================================================
   NET WORTH ASSET DETAILS / EDIT PAGE
========================================================== */

.financial-page.networth-page {

    max-width: 850px;

    margin: 0 auto;

    padding: 25px 18px 55px;

    box-sizing: border-box;

}


/* ==========================================================
   HEADER
========================================================== */

.networth-page .financial-header {

    margin-bottom: 25px;

}

.networth-page .financial-header h1 {

    margin: 10px 0 6px;

    color: #173b2a;

    font-size: 30px;

    font-weight: 800;

    line-height: 1.2;

    letter-spacing: -0.6px;

    overflow-wrap: anywhere;

}

.networth-page .financial-header p {

    margin: 0;

    color: #718078;

    font-size: 15px;

    line-height: 1.5;

}


/* ==========================================================
   BACK LINK
========================================================== */

.financial-back-link {

    display: inline-flex;

    align-items: center;

    gap: 6px;

    color: #2f7d4c;

    font-size: 13px;

    font-weight: 700;

    text-decoration: none;

    transition:
        color 0.2s ease,
        transform 0.2s ease;

}

.financial-back-link:hover {

    color: #1e6037;

    transform: translateX(-2px);

}


/* ==========================================================
   MAIN CARD
========================================================== */

.networth-page > .financial-card {

    overflow: hidden;

    padding: 30px;

    box-sizing: border-box;

    background: #ffffff;

    border: 1px solid #e1e9e4;

    border-radius: 18px;

    box-shadow:
        0 8px 25px rgba(25, 70, 43, 0.055),
        0 2px 6px rgba(25, 70, 43, 0.025);

}


/* ==========================================================
   FORM
========================================================== */

.networth-form {

    width: 100%;

}

.networth-form .form-group {

    margin-bottom: 21px;

}


/* ==========================================================
   LABEL
========================================================== */

.networth-form .form-group > label {

    display: block;

    margin-bottom: 8px;

    color: #304139;

    font-size: 13px;

    font-weight: 750;

    line-height: 1.4;

}


/* ==========================================================
   INPUT / SELECT / TEXTAREA
========================================================== */

.networth-form .form-group input,
.networth-form .form-group select,
.networth-form .form-group textarea {

    display: block;

    width: 100%;

    box-sizing: border-box;

    border: 1px solid #d5dfd9;

    border-radius: 11px;

    background: #fbfdfb;

    color: #24352c;

    font-family: inherit;

    font-size: 14px;

    outline: none;

    transition:
        border-color 0.2s ease,
        box-shadow 0.2s ease,
        background 0.2s ease;

}


/* ==========================================================
   INPUT
========================================================== */

.networth-form .form-group input {

    height: 49px;

    padding: 0 14px;

}


/* ==========================================================
   FILE INPUT
========================================================== */

.networth-form input[type="file"] {

    height: auto;

    min-height: 49px;

    padding: 12px 14px;

    cursor: pointer;

}


/* ==========================================================
   SELECT
========================================================== */

.networth-form .form-group select {

    height: 49px;

    padding: 0 40px 0 14px;

    cursor: pointer;

}


/* ==========================================================
   TEXTAREA
========================================================== */

.networth-form .form-group textarea {

    min-height: 115px;

    padding: 13px 14px;

    resize: vertical;

    line-height: 1.55;

}


/* ==========================================================
   FOCUS
========================================================== */

.networth-form .form-group input:focus,
.networth-form .form-group select:focus,
.networth-form .form-group textarea:focus {

    background: #ffffff;

    border-color: #3b945b;

    box-shadow:
        0 0 0 3px rgba(59, 148, 91, 0.11);

}


/* ==========================================================
   PLACEHOLDER
========================================================== */

.networth-form input::placeholder,
.networth-form textarea::placeholder {

    color: #9aa79f;

}


/* ==========================================================
   READ ONLY
========================================================== */

.networth-form input[readonly] {

    background: #f3f6f4;

    border-color: #e0e7e2;

    color: #69766e;

    cursor: not-allowed;

}


/* ==========================================================
   CODE / MONEY / MASS
========================================================== */

.networth-form #code,
.networth-form #buyingPrice,
.networth-form #currentWorth,
.networth-form #mass {

    font-weight: 650;

    font-variant-numeric: tabular-nums;

}


/* ==========================================================
   CURRENT WORTH
========================================================== */

.networth-form #currentWorth {

    border-color: #bcd8c5;

    background: #f7fcf8;

}

.networth-form #currentWorth:focus {

    background: #ffffff;

    border-color: #328650;

    box-shadow:
        0 0 0 3px rgba(50, 134, 80, 0.12);

}


/* ==========================================================
   PROFILE IMAGE
========================================================== */

.profile-image-section {

    display: flex;

    flex-direction: column;

    align-items: center;

    margin-bottom: 30px;

    padding-bottom: 25px;

    border-bottom: 1px solid #edf1ee;

}

.profile-image-preview {

    width: 125px;

    height: 125px;

    margin-bottom: 15px;

    border-radius: 50%;

    overflow: hidden;

    background: #f1f5f2;

    border: 4px solid #ffffff;

    box-shadow:
        0 4px 15px rgba(25, 70, 43, 0.12);

    display: flex;

    align-items: center;

    justify-content: center;

}

.profile-image-preview img {

    width: 100%;

    height: 100%;

    object-fit: cover;

    display: block;

}

.profile-image-placeholder {

    color: #8b9991;

    font-size: 42px;

}

.profile-image-title {

    margin-bottom: 5px;

    color: #304139;

    font-size: 14px;

    font-weight: 750;

}

.profile-image-description {

    margin: 0 0 15px;

    color: #7a8880;

    font-size: 12px;

    text-align: center;

}

.profile-image-input {

    width: 100%;

    max-width: 400px;

}


/* ==========================================================
   AGE DISPLAY
========================================================== */

.age-display {

    display: flex;

    align-items: center;

    min-height: 49px;

    padding: 0 14px;

    box-sizing: border-box;

    border: 1px solid #d8e4dc;

    border-radius: 11px;

    background: #f3f7f4;

    color: #405449;

    font-size: 14px;

    font-weight: 650;

}


/* ==========================================================
   BOOLEAN FIELD
========================================================== */

.boolean-display {

    display: flex;

    align-items: center;

    gap: 10px;

    min-height: 49px;

    padding: 0 14px;

    box-sizing: border-box;

    border: 1px solid #d8e4dc;

    border-radius: 11px;

    background: #f3f7f4;

}

.boolean-display input {

    width: 18px !important;

    height: 18px !important;

    margin: 0;

    cursor: pointer;

    accent-color: #2f8f55;

}

.boolean-display label {

    margin: 0 !important;

    color: #405449 !important;

    font-size: 14px !important;

    font-weight: 600 !important;

    cursor: pointer;

}


/* ==========================================================
   ASSET LOCATION
========================================================== */

.asset-location-group {

    margin-top: 5px;

}

.asset-location-description {

    margin: 0 0 9px;

    color: #7a8880;

    font-size: 12px;

    line-height: 1.5;

}


/* ==========================================================
   STRUCTURE INFORMATION
========================================================== */

.structure-info {

    margin-bottom: 21px;

    padding: 14px 16px;

    background: #f3f8f4;

    border: 1px solid #dce9df;

    border-radius: 11px;

    color: #50665a;

    font-size: 13px;

    line-height: 1.5;

}

.structure-info strong {

    color: #294c37;

}


/* ==========================================================
   MAINTENANCE / MEDICAL INFORMATION
========================================================== */

.asset-section-title {

    margin: 30px 0 18px;

    padding-bottom: 9px;

    border-bottom: 1px solid #edf1ee;

    color: #294c37;

    font-size: 16px;

    font-weight: 800;

}

.asset-section-description {

    margin: -10px 0 18px;

    color: #7a8880;

    font-size: 12px;

    line-height: 1.5;

}


/* ==========================================================
   SAVE STATUS
========================================================== */

.form-save-status {

    display: none;

    margin-bottom: 18px;

    padding: 12px 14px;

    border-radius: 10px;

    font-size: 13px;

    line-height: 1.4;

}

.form-save-status.success {

    display: block;

    background: #eef8f1;

    border: 1px solid #cfe5d5;

    color: #28633b;

}

.form-save-status.error {

    display: block;

    background: #fff3f2;

    border: 1px solid #efd0cd;

    color: #a13c35;

}


/* ==========================================================
   ACTIONS
========================================================== */

.networth-form .form-actions {

    display: flex;

    align-items: center;

    justify-content: flex-end;

    gap: 11px;

    margin-top: 8px;

    padding-top: 22px;

    border-top: 1px solid #edf1ee;

}


/* ==========================================================
   BUTTON
========================================================== */

.networth-form .button {

    display: inline-flex;

    align-items: center;

    justify-content: center;

    gap: 8px;

    min-height: 46px;

    padding: 0 19px;

    box-sizing: border-box;

    border-radius: 10px;

    font-family: inherit;

    font-size: 14px;

    font-weight: 700;

    text-decoration: none;

    cursor: pointer;

    transition:
        background 0.2s ease,
        border-color 0.2s ease,
        color 0.2s ease,
        box-shadow 0.2s ease,
        transform 0.2s ease;

}


/* ==========================================================
   SECONDARY
========================================================== */

.networth-form .button-secondary {

    background: #ffffff;

    color: #536159;

    border: 1px solid #d6dfd9;

}

.networth-form .button-secondary:hover {

    background: #f7f9f7;

    border-color: #c4d0c8;

    color: #29382f;

    transform: translateY(-1px);

}


/* ==========================================================
   PRIMARY
========================================================== */

.networth-form .button-primary {

    background: #2f8f55;

    color: #ffffff;

    border: 1px solid #2f8f55;

    box-shadow:
        0 5px 12px rgba(47, 143, 85, 0.17);

}

.networth-form .button-primary::before {

    content: "✓";

    font-size: 14px;

}

.networth-form .button-primary:hover {

    background: #267747;

    border-color: #267747;

    box-shadow:
        0 7px 16px rgba(47, 143, 85, 0.22);

    transform: translateY(-1px);

}

.networth-form .button-primary:disabled {

    opacity: 0.65;

    cursor: wait;

    transform: none;

}


/* ==========================================================
   MOBILE
========================================================== */

@media (max-width: 650px) {

    .financial-page.networth-page {

        padding: 18px 14px 45px;

    }

    .networth-page .financial-header h1 {

        font-size: 25px;

    }

    .networth-page .financial-header p {

        font-size: 14px;

    }

    .networth-page > .financial-card {

        padding: 22px 18px;

        border-radius: 15px;

    }

    .networth-form .form-group {

        margin-bottom: 19px;

    }

    .networth-form .form-group input,
    .networth-form .form-group select {

        height: 48px;

    }

    .networth-form .form-group textarea {

        min-height: 110px;

    }

    .networth-form .form-actions {

        flex-direction: column-reverse;

        align-items: stretch;

        gap: 10px;

        padding-top: 19px;

    }

    .networth-form .button {

        width: 100%;

        min-height: 48px;

    }

    .profile-image-preview {

        width: 110px;

        height: 110px;

    }

}


/* ==========================================================
   SMALL PHONES
========================================================== */

@media (max-width: 380px) {

    .financial-page.networth-page {

        padding-left: 10px;

        padding-right: 10px;

    }

    .networth-page > .financial-card {

        padding: 19px 14px;

    }

    .networth-page .financial-header h1 {

        font-size: 23px;

    }

}

</style>


<%

// ==========================================================
// RECORD CLASSIFICATION
// ==========================================================

const hasCode =
    dairy &&
    dairy.code !== null &&
    dairy.code !== undefined;


const numericCode =
    hasCode
        ? Number(dairy.code)
        : null;


const isDairyFarm =
    hasCode &&
    Number.isFinite(numericCode) &&
    numericCode < 0;


const isAnimal =
    hasCode &&
    Number.isFinite(numericCode) &&
    numericCode > 0;


const isStructure =
    !hasCode;


// ==========================================================
// FEMALE ANIMAL
// ==========================================================

const isFemale =
    isAnimal &&
    numericCode % 2 === 0;


// ==========================================================
// DATE HELPERS
// ==========================================================

const dateOnly = (value) => {

    if (!value) {

        return "";

    }


    const date =
        new Date(value);


    if (
        Number.isNaN(
            date.getTime()
        )
    ) {

        return "";

    }


    return date
        .toISOString()
        .slice(0, 10);

};


const displayDate = (value) => {

    if (!value) {

        return "";

    }


    const date =
        new Date(value);


    if (
        Number.isNaN(
            date.getTime()
        )
    ) {

        return "";

    }


    return date.toLocaleString(
        "en-KE",
        {

            timeZone:
                "Africa/Nairobi",

            year:
                "numeric",

            month:
                "short",

            day:
                "numeric",

            hour:
                "2-digit",

            minute:
                "2-digit"

        }
    );

};


// ==========================================================
// DISPLAY IMAGE
// ==========================================================

const displayImage =
    dairy.displayImage ||
    dairy.profileImage ||
    "";


// ==========================================================
// BREEDS
// ==========================================================

const breeds =
    Array.isArray(dairyBreeds)
        ? [...dairyBreeds]
        : [];


if (
    isAnimal &&
    dairy.type &&
    !breeds.includes(
        dairy.type
    )
) {

    breeds.unshift(
        dairy.type
    );

}


// ==========================================================
// STRUCTURE TYPES
// ==========================================================

const structureTypes =
    Array.isArray(structureTypesList)
        ? [...structureTypesList]
        : [

            "machine",
            "equipment",
            "tool",
            "building",
            "cowshed",
            "milkingParlour",
            "feedStore",
            "hayShed",
            "waterSystem",
            "fencing",
            "vehicle",
            "generator",
            "solarSystem",
            "other"

        ];


// ==========================================================
// STATUS VALUES
// ==========================================================

const statusValues =
    Array.isArray(dairyStatuses)
        ? [...dairyStatuses]
        : [

            "active",
            "sold",
            "disposed",
            "inactive"

        ];


// ==========================================================
// PARENT DAIRY FARMS
//
// Controller should preferably provide `structures` as
// Dairy Farm records. The template additionally filters
// them using their negative code.
// ==========================================================

const parentDairyFarms =
    Array.isArray(structures)
        ? structures.filter(
            function(farm) {

                return (

                    farm &&

                    farm.code !== null &&

                    farm.code !== undefined &&

                    Number(farm.code) < 0

                );

            }
        )
        : [];

%>


<div class="financial-page networth-page">


    <!-- ======================================================
         HEADER
    ======================================================= -->

    <div class="financial-header">

        <div>

            <a
                href="/networth"
                class="financial-back-link"
            >

                ← Net Worth

            </a>


            <h1 id="assetPageTitle">

                <%= dairy.name || "Asset" %>

            </h1>


            <p>

                View and edit the information
                stored for this asset.

            </p>

        </div>

    </div>


    <!-- ======================================================
         MAIN CARD
    ======================================================= -->

    <div class="financial-card">


        <form
            id="networthAssetForm"
            action="/networth/asset/<%= dairy._id %>"
            method="POST"
            enctype="multipart/form-data"
            class="networth-form"
        >


            <!-- =================================================
                 METHOD OVERRIDE
            ================================================== -->

            <input
                type="hidden"
                name="_method"
                value="PUT"
            >


            <!-- =================================================
                 SAVE STATUS
            ================================================== -->

            <div
                id="formSaveStatus"
                class="form-save-status"
                role="status"
                aria-live="polite"
            ></div>


            <!-- =================================================
                 PROFILE IMAGE
            ================================================== -->

            <div class="profile-image-section">


                <div class="profile-image-preview">


                    <% if (displayImage) { %>

                        <img
                            id="profileImagePreview"
                            src="<%= displayImage %>"
                            alt="<%= dairy.name || 'Asset profile image' %>"
                        >


                        <span
                            id="profileImagePlaceholder"
                            class="profile-image-placeholder"
                            style="display:none;"
                        >

                            🐄

                        </span>


                    <% } else { %>


                        <img
                            id="profileImagePreview"
                            src=""
                            alt=""
                            style="display:none;"
                        >


                        <span
                            id="profileImagePlaceholder"
                            class="profile-image-placeholder"
                        >

                            🐄

                        </span>


                    <% } %>


                </div>


                <div class="profile-image-title">

                    Profile Image

                </div>


                <p class="profile-image-description">

                    Choose a new image only if you want
                    to replace the current image.

                </p>


                <input
                    type="file"
                    id="profileImage"
                    name="profileImage"
                    class="profile-image-input"
                    accept="image/*"
                >

            </div>


            <!-- =================================================
                 NAME
            ================================================== -->

            <div class="form-group">


                <label for="name">

                    Name

                </label>


                <input
                    type="text"
                    id="name"
                    name="name"
                    value="<%= dairy.name ?? "" %>"
                    autocomplete="off"
                    maxlength="200"
                    required
                >


            </div>


            <!-- =================================================
                 RECORD CODE
            ================================================== -->

            <div class="form-group">


                <label for="code">

                    Record Code

                </label>


                <input
                    type="text"
                    id="code"
                    value="<%= hasCode ? dairy.code : "Structure / Facility" %>"
                    readonly
                >


            </div>


            <!-- =================================================
                 RECORD TYPE INFORMATION
            ================================================== -->

            <div class="structure-info">


                <% if (isAnimal) { %>

                    <strong>Animal record.</strong>

                    This record uses an automatically assigned
                    positive animal code.

                <% } else if (isStructure) { %>

                    <strong>Structure / Facility record.</strong>

                    This record has no independent code.
                    Its parent Dairy Farm is represented by
                    <code>assetCode</code>.

                <% } else { %>

                    <strong>Dairy Farm record.</strong>

                    Dairy Farm records use a negative code.

                <% } %>


            </div>


            <!-- =================================================
                 ANIMAL INFORMATION
            ================================================== -->

            <% if (isAnimal) { %>


                <!-- =============================================
                     DATE OF BIRTH
                ============================================== -->

                <div class="form-group">


                    <label for="dateOfBirth">

                        Date of Birth

                    </label>


                    <input
                        type="date"
                        id="dateOfBirth"
                        name="dateOfBirth"
                        value="<%= dateOnly(dairy.dateOfBirth) %>"
                    >


                </div>


                <!-- =============================================
                     AGE
                ============================================== -->

                <div class="form-group">


                    <label for="age">

                        Age

                    </label>


                    <div
                        id="age"
                        class="age-display"
                        data-date-of-birth="<%= dateOnly(dairy.dateOfBirth) %>"
                    >

                        <%= dairy.ageText || "Not available" %>

                    </div>


                </div>


                <!-- =============================================
                     GENDER
                ============================================== -->

                <div class="form-group">


                    <label for="gender">

                        Gender

                    </label>


                    <input
                        type="text"
                        id="gender"
                        value="<%= dairy.gender || "Not available" %>"
                        readonly
                    >


                </div>


                <!-- =============================================
                     BREED
                ============================================== -->

                <div class="form-group">


                    <label for="type">

                        Breed

                    </label>


                    <select
                        id="type"
                        name="type"
                    >


                        <option
                            value=""
                            <%= !dairy.type
                                ? "selected"
                                : "" %>
                        >

                            Select breed

                        </option>


                        <% breeds.forEach(
                            function(breed)
                        { %>


                            <option
                                value="<%= breed %>"
                                <%= dairy.type === breed
                                    ? "selected"
                                    : "" %>
                            >

                                <%= breed %>

                            </option>


                        <% }); %>


                    </select>


                </div>


                <!-- =============================================
                     MASS
                ============================================== -->

                <div class="form-group">


                    <label for="mass">

                        Mass (kg)

                    </label>


                    <input
                        type="number"
                        id="mass"
                        name="mass"
                        value="<%= dairy.mass ?? 0 %>"
                        min="0"
                        step="0.01"
                        placeholder="Enter animal mass"
                    >


                </div>


                <!-- =============================================
                     MILKING
                ============================================== -->

                <% if (isFemale) { %>


                    <div class="form-group">


                        <label>

                            Milking

                        </label>


                        <div class="boolean-display">


                            <input
                                type="checkbox"
                                id="isMilking"
                                name="isMilking"
                                value="true"
                                <%= dairy.isMilking
                                    ? "checked"
                                    : "" %>
                            >


                            <label for="isMilking">

                                Currently being milked

                            </label>


                        </div>


                    </div>


                <% } %>


            <% } %>


            <!-- =================================================
                 STRUCTURE INFORMATION
            ================================================== -->

            <% if (isStructure) { %>


                <div class="form-group">


                    <label for="type">

                        Asset Type

                    </label>


                    <select
                        id="type"
                        name="type"
                        required
                    >


                        <option
                            value=""
                            <%= !dairy.type
                                ? "selected"
                                : "" %>
                        >

                            Select asset type

                        </option>


                        <% structureTypes.forEach(
                            function(assetType)
                        { %>


                            <option
                                value="<%= assetType %>"
                                <%= dairy.type === assetType
                                    ? "selected"
                                    : "" %>
                            >

                                <%= assetType
                                    .replace(
                                        /([A-Z])/g,
                                        " $1"
                                    )
                                    .replace(
                                        /^./,
                                        function(char) {
                                            return char.toUpperCase();
                                        }
                                    ) %>

                            </option>


                        <% }); %>


                    </select>


                </div>


            <% } %>


            <!-- =================================================
                 BUYING PRICE
            ================================================== -->

            <div class="form-group">


                <label for="buyingPrice">

                    Buying Price

                </label>


                <input
                    type="number"
                    id="buyingPrice"
                    name="buyingPrice"
                    value="<%= dairy.buyingPrice ?? 0 %>"
                    min="0"
                    step="0.01"
                    inputmode="decimal"
                >


            </div>


            <!-- =================================================
                 CURRENT WORTH
            ================================================== -->

            <div class="form-group">


                <label for="currentWorth">

                    Current Worth

                </label>


                <input
                    type="number"
                    id="currentWorth"
                    name="currentWorth"
                    value="<%= dairy.currentWorth ?? 0 %>"
                    min="0"
                    step="0.01"
                    inputmode="decimal"
                    required
                >


            </div>


            <!-- =================================================
                 DESCRIPTION
            ================================================== -->

            <div class="form-group">


                <label for="description">

                    Description

                </label>


                <textarea
                    id="description"
                    name="description"
                    rows="4"
                    placeholder="Describe the asset..."
                ><%= dairy.description ?? "" %></textarea>


            </div>


            <!-- =================================================
                 CONDITION
            ================================================== -->

            <div class="form-group">


                <label for="condition">

                    Condition

                </label>


                <input
                    type="text"
                    id="condition"
                    name="condition"
                    value="<%= dairy.condition ?? "" %>"
                    placeholder="e.g. Good, New, Needs Repair"
                >


            </div>


            <!-- =================================================
                 PHYSICAL LOCATION
            ================================================== -->

            <div class="form-group">


                <label for="location">

                    Physical Location

                </label>


                <input
                    type="text"
                    id="location"
                    name="location"
                    value="<%= dairy.location ?? "" %>"
                    placeholder="Where is the asset physically located?"
                >


            </div>


            <!-- =================================================
                 PARENT DAIRY FARM
            ================================================== -->

            <% if (isAnimal || isStructure) { %>


                <div class="form-group asset-location-group">


                    <label for="assetCode">

                        Parent Dairy Farm

                    </label>


                    <p class="asset-location-description">


                        <% if (isAnimal) { %>

                            An animal must belong to a Dairy Farm.

                        <% } else { %>

                            A structure or facility may either
                            belong to a Dairy Farm or remain
                            standalone.

                        <% } %>


                    </p>


                    <select
                        id="assetCode"
                        name="assetCode"
                        <%= isAnimal ? "required" : "" %>
                    >


                        <% if (isStructure) { %>


                            <option
                                value=""
                                <%= dairy.assetCode === null ||
                                    dairy.assetCode === undefined ||
                                    dairy.assetCode === ""
                                        ? "selected"
                                        : "" %>
                            >

                                Standalone — No Dairy Farm

                            </option>


                        <% } %>


                        <% if (
                            parentDairyFarms.length > 0
                        ) { %>


                            <% parentDairyFarms.forEach(
                                function(farm)
                            { %>


                                <option
                                    value="<%= farm.code %>"
                                    <%= dairy.assetCode != null &&
                                        dairy.assetCode !== "" &&
                                        Number(dairy.assetCode) ===
                                        Number(farm.code)
                                            ? "selected"
                                            : "" %>
                                >

                                    <%= farm.name || "Dairy Farm" %>
                                    —
                                    <%= farm.code %>

                                </option>


                            <% }); %>


                        <% } else { %>


                            <option
                                value=""
                                disabled
                            >

                                No Dairy Farms available

                            </option>


                        <% } %>


                    </select>


                </div>


            <% } %>


            <!-- =================================================
                 STATUS
            ================================================== -->

            <div class="form-group">


                <label for="status">

                    Status

                </label>


                <select
                    id="status"
                    name="status"
                    required
                >


                    <% statusValues.forEach(
                        function(status)
                    { %>


                        <option
                            value="<%= status %>"
                            <%= dairy.status === status
                                ? "selected"
                                : "" %>
                        >

                            <%= status.charAt(0).toUpperCase() +
                                status.slice(1) %>

                        </option>


                    <% }); %>


                </select>


            </div>


            <!-- =================================================
                 VALUATION DATE
            ================================================== -->

            <div class="form-group">


                <label for="valuationDate">

                    Valuation Date

                </label>


                <input
                    type="date"
                    id="valuationDate"
                    name="valuationDate"
                    value="<%= dateOnly(dairy.valuationDate) %>"
                >


            </div>


            <!-- =================================================
                 ACQUISITION DATE
                 READ ONLY
            ================================================== -->

            <div class="form-group">


                <label for="acquisitionDate">

                    Acquisition Date

                </label>


                <input
                    type="text"
                    id="acquisitionDate"
                    value="<%= displayDate(dairy.acquisitionDate) %>"
                    readonly
                >


            </div>


            <!-- =================================================
                 MAINTENANCE
            ================================================== -->

            <div class="asset-section-title">

                Maintenance

            </div>


            <p class="asset-section-description">

                Maintenance information is stored in the
                Dairy model under <code>needsMaintenance</code>
                and <code>maintenance</code>.

            </p>


            <div class="form-group">


                <label>

                    Maintenance Status

                </label>


                <div class="boolean-display">


                    <input
                        type="checkbox"
                        id="needsMaintenance"
                        name="needsMaintenance"
                        value="true"
                        <%= dairy.needsMaintenance
                            ? "checked"
                            : "" %>
                    >


                    <label for="needsMaintenance">

                        This asset needs maintenance

                    </label>


                </div>


            </div>


            <div class="form-group">


                <label for="maintenanceType">

                    Maintenance Type

                </label>


                <input
                    type="text"
                    id="maintenanceType"
                    name="maintenance[type]"
                    value="<%= dairy.maintenance?.type ?? "" %>"
                    placeholder="e.g. Repair, Servicing, Replacement"
                >


            </div>


            <div class="form-group">


                <label for="maintenanceDescription">

                    Maintenance Description

                </label>


                <textarea
                    id="maintenanceDescription"
                    name="maintenance[description]"
                    rows="3"
                    placeholder="Describe the required maintenance..."
                ><%= dairy.maintenance?.description ?? "" %></textarea>


            </div>


            <div class="form-group">


                <label for="maintenanceCharges">

                    Maintenance Charges

                </label>


                <input
                    type="number"
                    id="maintenanceCharges"
                    name="maintenance[charges]"
                    value="<%= dairy.maintenance?.charges ?? 0 %>"
                    min="0"
                    step="0.01"
                    inputmode="decimal"
                >


            </div>


            <div class="form-group">


                <label for="maintenanceCompletionDescription">

                    Completion Description

                </label>


                <textarea
                    id="maintenanceCompletionDescription"
                    name="maintenance[completionDescription]"
                    rows="3"
                    placeholder="Describe completed maintenance..."
                ><%= dairy.maintenance?.completionDescription ?? "" %></textarea>


            </div>


            <!-- =================================================
                 MEDICAL ATTENTION

                 Only meaningful for animals.
            ================================================== -->

            <% if (isAnimal) { %>


                <div class="asset-section-title">

                    Medical Attention

                </div>


                <p class="asset-section-description">

                    Medical information is stored in the
                    <code>medicalAttention</code> object
                    in the Dairy model.

                </p>


                <div class="form-group">


                    <label>

                        Medical Status

                    </label>


                    <div class="boolean-display">


                        <input
                            type="checkbox"
                            id="medicalAttentionMarked"
                            name="medicalAttention[isMarked]"
                            value="true"
                            <%= dairy.medicalAttention?.isMarked
                                ? "checked"
                                : "" %>
                        >


                        <label for="medicalAttentionMarked">

                            This animal needs medical attention

                        </label>


                    </div>


                </div>


                <div class="form-group">


                    <label for="medicalType">

                        Medical Type

                    </label>


                    <input
                        type="text"
                        id="medicalType"
                        name="medicalAttention[type]"
                        value="<%= dairy.medicalAttention?.type ?? "" %>"
                        placeholder="e.g. Treatment, Injury, Vaccination"
                    >


                </div>


                <div class="form-group">


                    <label for="medicalDetails">

                        Medical Details

                    </label>


                    <textarea
                        id="medicalDetails"
                        name="medicalAttention[details]"
                        rows="3"
                        placeholder="Enter medical details..."
                    ><%= dairy.medicalAttention?.details ?? "" %></textarea>


                </div>


                <div class="form-group">


                    <label for="medicalCharges">

                        Medical Charges

                    </label>


                    <input
                        type="number"
                        id="medicalCharges"
                        name="medicalAttention[charges]"
                        value="<%= dairy.medicalAttention?.charges ?? 0 %>"
                        min="0"
                        step="0.01"
                        inputmode="decimal"
                    >


                </div>


                <div class="form-group">


                    <label for="medicalDescription">

                        Medical Description

                    </label>


                    <textarea
                        id="medicalDescription"
                        name="medicalAttention[description]"
                        rows="3"
                        placeholder="Describe the medical attention..."
                    ><%= dairy.medicalAttention?.description ?? "" %></textarea>


                </div>


            <% } %>


            <!-- =================================================
                 ACTIONS
            ================================================== -->

            <div class="form-actions">


                <a
                    href="/networth"
                    class="button button-secondary"
                >

                    Cancel

                </a>


                <button
                    type="submit"
                    id="saveAssetButton"
                    class="button button-primary"
                >

                    Save Changes

                </button>


            </div>


        </form>


    </div>


</div>


<script
    src="/js/networth-asset.js"
    defer
></script>