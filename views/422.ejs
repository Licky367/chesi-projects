<link rel="stylesheet" href="/css/error.css">

<div class="page-error">

  <div class="error-card">

    <div class="error-icon">
      📝
    </div>

    <div
      class="error-code"
      style="color:#fd7e14;"
    >
      422
    </div>

    <h1 class="error-title">
      Unprocessable Request
    </h1>

    <p class="error-text">
      <%= typeof error !== "undefined" && error
        ? error
        : "Your request was understood, but it contains invalid or incomplete information. Please review the submitted data and try again." %>
    </p>

    <div class="button-group">

      <button
        type="button"
        class="btn-action btn-back"
        onclick="history.back()"
      >
        ← Go Back
      </button>

      <a
        href="/"
        class="btn-action btn-home"
      >
        🏠 Home
      </a>

    </div>

    <div class="help-box">
      One or more fields contain invalid values or fail validation. Please correct the highlighted information and submit your request again. If you continue to experience this problem, contact your system administrator.
    </div>

  </div>

</div>