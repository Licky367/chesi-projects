<div class="login-page">

  <div class="login-card">

    <div class="brand">

      <div class="brand-icon">
        <img
          src="/images/h1"
          alt="Logo"
        >
      </div>

      <h1>Welcome Back</h1>

      <p>Login to continue to your account</p>

    </div>

    <% if (error) { %>
      <div class="error">
        <%= error %>
      </div>
    <% } %>

    <form method="POST" action="/login">

      <div class="form-group">

        <label for="email">
          Email Address
        </label>

        <div class="input-wrapper">

          <span>✉️</span>

          <input
            type="email"
            id="email"
            name="email"
            placeholder="Enter your email"
            autocomplete="email"
            required
          >

        </div>

      </div>

      <div class="form-group">

        <label for="password">
          Password
        </label>

        <div class="input-wrapper">

          <span>🔒</span>

          <input
            type="password"
            id="password"
            name="password"
            placeholder="Enter your password"
            autocomplete="current-password"
            required
          >

          <button
            type="button"
            class="password-toggle"
            onclick="togglePassword()"
            aria-label="Show or hide password"
          >
            👁️
          </button>

        </div>

      </div>

      <!-- FORGOT PASSWORD -->

      <div class="forgot-password">

        <a href="/forgot-password">
          Forgot Password?
        </a>

      </div>

      <button
        type="submit"
        class="login-btn"
      >
        Login
      </button>

    </form>

    <div class="signup-link">

      Don't have an account?

      <a href="/signup">
        Create an account
      </a>

    </div>

  </div>

</div>


<style>

/* ==========================================================
   LOGIN PAGE
========================================================== */

.login-page {

  width: 100%;

  min-height: calc(100vh - 80px);

  display: flex;

  align-items: center;

  justify-content: center;

  padding: 30px 20px;

}


/* ==========================================================
   LOGIN CARD
========================================================== */

.login-card {

  width: 100%;

  max-width: 430px;

  background: rgba(255, 255, 255, 0.98);

  padding: 40px 35px;

  border-radius: 22px;

  box-shadow:
    0 20px 50px rgba(0, 0, 0, 0.12),
    0 5px 15px rgba(0, 0, 0, 0.05);

  animation: loginFadeIn 0.6s ease-in-out;

}


/* ==========================================================
   BRAND
========================================================== */

.brand {

  text-align: center;

  margin-bottom: 28px;

}


/* ==========================================================
   BRAND ICON / LOGO
========================================================== */

.brand-icon {

  width: 70px;

  height: 70px;

  margin: 0 auto 15px;

  display: flex;

  align-items: center;

  justify-content: center;

  border-radius: 50%;

  background: linear-gradient(
    135deg,
    #16a34a,
    #15803d
  );

  overflow: hidden;

  box-shadow:
    0 10px 20px rgba(22, 163, 74, 0.25);

}


/* LOGO IMAGE */

.brand-icon img {

  width: 100%;

  height: 100%;

  object-fit: cover;

  display: block;

}


/* ==========================================================
   BRAND TEXT
========================================================== */

.brand h1 {

  margin: 0 0 8px;

  color: #166534;

  font-size: 28px;

  font-weight: 700;

}


.brand p {

  margin: 0;

  color: #6b7280;

  font-size: 14px;

}


/* ==========================================================
   ERROR
========================================================== */

.error {

  margin-bottom: 20px;

  padding: 12px 14px;

  border: 1px solid #fecaca;

  border-radius: 10px;

  background: #fee2e2;

  color: #b91c1c;

  font-size: 14px;

  text-align: center;

}


/* ==========================================================
   FORM GROUP
========================================================== */

.form-group {

  margin-bottom: 18px;

}


.form-group label {

  display: block;

  margin-bottom: 8px;

  color: #374151;

  font-size: 14px;

  font-weight: 600;

}


/* ==========================================================
   INPUT WRAPPER
========================================================== */

.input-wrapper {

  position: relative;

}


.input-wrapper > span {

  position: absolute;

  left: 14px;

  top: 50%;

  transform: translateY(-50%);

  color: #9ca3af;

  font-size: 17px;

  pointer-events: none;

}


/* ==========================================================
   INPUT
========================================================== */

.input-wrapper input {

  width: 100%;

  padding: 14px 45px;

  border: 1px solid #d1d5db;

  border-radius: 12px;

  outline: none;

  background: #f9fafb;

  color: #111827;

  font-size: 15px;

  transition: all 0.3s ease;

  box-sizing: border-box;

}


.input-wrapper input:focus {

  border-color: #16a34a;

  background: #ffffff;

  box-shadow:
    0 0 0 4px rgba(22, 163, 74, 0.12);

}


/* ==========================================================
   PASSWORD TOGGLE
========================================================== */

.password-toggle {

  position: absolute;

  right: 14px;

  top: 50%;

  transform: translateY(-50%);

  padding: 0;

  border: none;

  background: transparent;

  cursor: pointer;

  color: #6b7280;

  font-size: 17px;

}


.password-toggle:hover {

  color: #16a34a;

}


/* ==========================================================
   FORGOT PASSWORD
========================================================== */

.forgot-password {

  margin: -4px 0 18px;

  text-align: right;

}


.forgot-password a {

  color: #15803d;

  font-size: 14px;

  font-weight: 600;

  text-decoration: none;

  transition: color 0.3s ease;

}


.forgot-password a:hover {

  color: #166534;

  text-decoration: underline;

}


/* ==========================================================
   LOGIN BUTTON
========================================================== */

.login-btn {

  width: 100%;

  margin-top: 8px;

  padding: 15px;

  border: none;

  border-radius: 12px;

  background: linear-gradient(
    135deg,
    #16a34a,
    #15803d
  );

  color: white;

  font-size: 16px;

  font-weight: 700;

  cursor: pointer;

  box-shadow:
    0 8px 18px rgba(22, 163, 74, 0.25);

  transition: all 0.3s ease;

}


.login-btn:hover {

  transform: translateY(-2px);

  box-shadow:
    0 12px 24px rgba(22, 163, 74, 0.35);

}


.login-btn:active {

  transform: translateY(0);

}


/* ==========================================================
   SIGNUP LINK
========================================================== */

.signup-link {

  margin-top: 24px;

  color: #6b7280;

  font-size: 14px;

  text-align: center;

}


.signup-link a {

  color: #15803d;

  font-weight: 700;

  text-decoration: none;

}


.signup-link a:hover {

  text-decoration: underline;

}


/* ==========================================================
   ANIMATION
========================================================== */

@keyframes loginFadeIn {

  from {

    opacity: 0;

    transform: translateY(20px);

  }

  to {

    opacity: 1;

    transform: translateY(0);

  }

}


/* ==========================================================
   MOBILE
========================================================== */

@media (max-width: 480px) {

  .login-card {

    padding: 32px 24px;

  }

  .brand h1 {

    font-size: 24px;

  }

}

</style>


<script>

function togglePassword() {

  const passwordInput =
    document.getElementById("password");

  const toggleButton =
    document.querySelector(".password-toggle");


  if (passwordInput.type === "password") {

    passwordInput.type = "text";

    toggleButton.textContent = "🙈";

  } else {

    passwordInput.type = "password";

    toggleButton.textContent = "👁️";

  }

}

</script>