<% /*
==============================================================
ADMIN DASHBOARD
==============================================================

FILE:
    views/admin.ejs

PURPOSE:
    Main Admin dashboard view.

INCLUDES:

    views/admin/dairies.ejs
    views/admin/standalone.ejs

IMPORTANT:

    Both partials are optional-safe.

    If the controller does not provide:

        dairies

    or:

        standaloneAssets

    the page will NOT crash.

==============================================================
*/ %>


<%
/* ==========================================================
   SAFE DAIRIES
========================================================== */

const safeDairies =
    typeof dairies !== "undefined" &&
    Array.isArray(dairies)

        ? dairies

        : [];


/* ==========================================================
   SAFE STANDALONE ASSETS
========================================================== */

const safeStandaloneAssets =
    typeof standaloneAssets !== "undefined" &&
    Array.isArray(standaloneAssets)

        ? standaloneAssets

        : [];

%>


<style>

/* ==========================================================
   ADMIN PAGE
========================================================== */

.admin-page {

    width:
        100%;

    min-height:
        100vh;

    margin:
        0;

    padding:
        18px 14px 30px;

    box-sizing:
        border-box;

    background:
        #f5f9f6;

    color:
        #26352c;

    font-family:
        Arial,
        Helvetica,
        sans-serif;

}


/* ==========================================================
   ADMIN CONTENT
========================================================== */

.admin-page-content {

    width:
        100%;

    max-width:
        1200px;

    margin:
        0 auto;

}


/* ==========================================================
   ADMIN HEADER
========================================================== */

.admin-page-header {

    display:
        flex;

    align-items:
        flex-start;

    justify-content:
        space-between;

    gap:
        14px;

    margin:
        0 0 20px;

    padding:
        0 2px;

}


.admin-page-heading {

    min-width:
        0;

    flex:
        1;

}


.admin-page-title {

    margin:
        0;

    color:
        #24372b;

    font-size:
        24px;

    font-weight:
        850;

    line-height:
        1.2;

    letter-spacing:
        -.025em;

}


.admin-page-description {

    margin:
        5px 0 0;

    color:
        #7b877f;

    font-size:
        12px;

    line-height:
        1.5;

}


/* ==========================================================
   ADMIN STATUS
========================================================== */

.admin-page-status {

    flex:
        0 0 auto;

    display:
        flex;

    align-items:
        center;

    gap:
        6px;

    padding:
        7px 10px;

    border:
        1px solid
        #d7e8da;

    border-radius:
        999px;

    background:
        #edf7ef;

    color:
        #39734a;

    font-size:
        9px;

    font-weight:
        800;

    line-height:
        1;

    text-transform:
        uppercase;

    letter-spacing:
        .04em;

}


.admin-page-status-dot {

    width:
        6px;

    height:
        6px;

    flex:
        0 0 6px;

    border-radius:
        50%;

    background:
        #39a65a;

    box-shadow:
        0 0 0 3px
        rgba(57,166,90,.10);

}


/* ==========================================================
   ADMIN SECTION
========================================================== */

.admin-page-section {

    width:
        100%;

    margin:
        0;

    padding:
        0;

}


/* ==========================================================
   SECTION SEPARATOR
========================================================== */

.admin-page-separator {

    width:
        100%;

    height:
        1px;

    margin:
        2px 0 20px;

    background:
        #e1ebe3;

}


/* ==========================================================
   MOBILE
========================================================== */

@media (max-width:600px) {

    .admin-page {

        padding:
            15px 10px 24px;

    }


    .admin-page-header {

        margin-bottom:
            16px;

    }


    .admin-page-title {

        font-size:
            21px;

    }


    .admin-page-description {

        font-size:
            10px;

    }


    .admin-page-status {

        padding:
            6px 8px;

        font-size:
            8px;

    }

}


/* ==========================================================
   VERY SMALL SCREENS
========================================================== */

@media (max-width:380px) {

    .admin-page {

        padding:
            13px 8px 22px;

    }


    .admin-page-header {

        gap:
            8px;

    }


    .admin-page-title {

        font-size:
            19px;

    }


    .admin-page-status {

        display:
            none;

    }

}


/* ==========================================================
   REDUCED MOTION
========================================================== */

@media (prefers-reduced-motion: reduce) {

    .admin-page {

        scroll-behavior:
            auto;

    }

}

</style>


<!-- ==========================================================
     ADMIN PAGE
========================================================== -->

<main
    class="admin-page"
>


    <div
        class="admin-page-content"
    >


        <!-- ==================================================
             ADMIN HEADER
        =================================================== -->

        <header
            class="admin-page-header"
        >


            <div
                class="admin-page-heading"
        >


                <h1
                    class="admin-page-title"
                >

                    Admin Dashboard

                </h1>


                <p
                    class="admin-page-description"
                >

                    Manage your dairy farms and standalone assets.

                </p>


            </div>


            <span
                class="admin-page-status"
            >


                <span
                    class="admin-page-status-dot"
                    aria-hidden="true"
                ></span>


                Admin


            </span>


        </header>



        <!-- ==================================================
             DAIRY FARMS
        =================================================== -->

        <section
            class="admin-page-section"
            aria-label="Dairy farms"
        >


            <%- include(
                "admin/dairies",
                {
                    dairies:
                        safeDairies
                }
            ) %>


        </section>



        <!-- ==================================================
             SECTION SEPARATOR
        =================================================== -->

        <div
            class="admin-page-separator"
            aria-hidden="true"
        ></div>



        <!-- ==================================================
             STANDALONE ASSETS
        =================================================== -->

        <section
            class="admin-page-section"
            aria-label="Standalone assets"
        >


            <%- include(
                "admin/standalone",
                {
                    standaloneAssets:
                        safeStandaloneAssets
                }
            ) %>


        </section>


    </div>


</main>