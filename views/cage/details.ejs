<style>

  /* =========================
     PAGE HEADER
  ========================= */

  .cage-details-header {
    display: flex;

    align-items: flex-start;

    justify-content: space-between;

    gap: 20px;

    margin-bottom: 25px;
  }

  .cage-details-header h2 {
    margin: 0 0 6px;

    color: #166534;

    font-size: 28px;

    font-weight: 700;
  }

  .cage-details-header p {
    margin: 0;

    color: #6b7280;

    font-size: 14px;
  }

  .back-btn {
    display: inline-flex;

    align-items: center;

    gap: 6px;

    padding: 10px 15px;

    border-radius: 9px;

    background: #f3f4f6;

    color: #374151;

    font-size: 13px;

    font-weight: 600;

    text-decoration: none;

    transition: 0.25s ease;
  }

  .back-btn:hover {
    background: #e5e7eb;

    color: #111827;
  }


  /* =========================
     SUMMARY CARD
  ========================= */

  .cage-summary {
    display: flex;

    align-items: center;

    gap: 18px;

    padding: 22px;

    margin-bottom: 30px;

    border-radius: 18px;

    background: #ffffff;

    box-shadow:
      0 6px 20px rgba(0, 0, 0, 0.06);
  }

  .summary-icon {
    width: 58px;
    height: 58px;

    display: flex;

    align-items: center;
    justify-content: center;

    border-radius: 16px;

    background: #dbeafe;

    font-size: 28px;
  }

  .summary-label {
    display: block;

    margin-bottom: 4px;

    color: #6b7280;

    font-size: 13px;
  }

  .summary-value {
    display: block;

    color: #111827;

    font-size: 26px;

    font-weight: 700;
  }


  /* =========================
     ACTION GRID
  ========================= */

  .cage-actions-grid {
    display: grid;

    grid-template-columns:
      repeat(3, 1fr);

    gap: 22px;
  }

  .action-card {
    padding: 25px;

    border-radius: 18px;

    background: #ffffff;

    box-shadow:
      0 6px 20px rgba(0, 0, 0, 0.06);
  }

  .action-header {
    display: flex;

    align-items: center;

    gap: 13px;

    margin-bottom: 20px;
  }

  .action-icon {
    width: 46px;
    height: 46px;

    display: flex;

    align-items: center;
    justify-content: center;

    border-radius: 13px;

    font-size: 22px;
  }

  .action-header h3 {
    margin: 0;

    color: #374151;

    font-size: 18px;
  }

  .action-header p {
    margin: 3px 0 0;

    color: #9ca3af;

    font-size: 12px;
  }


  /* =========================
     ACTION COLORS
  ========================= */

  .eggs-card {
    border-top: 5px solid #f59e0b;
  }

  .eggs-card .action-icon {
    background: #fef3c7;
  }

  .sell-card {
    border-top: 5px solid #198754;
  }

  .sell-card .action-icon {
    background: #dcfce7;
  }

  .dead-card {
    border-top: 5px solid #dc3545;
  }

  .dead-card .action-icon {
    background: #fee2e2;
  }


  /* =========================
     FORMS
  ========================= */

  .action-form {
    display: flex;

    flex-direction: column;

    gap: 12px;
  }

  .action-form label {
    color: #374151;

    font-size: 13px;

    font-weight: 600;
  }

  .action-form input {
    width: 100%;

    padding: 13px 14px;

    border: 1px solid #d1d5db;

    border-radius: 10px;

    outline: none;

    background: #f9fafb;

    color: #111827;

    font-size: 14px;

    transition: all 0.25s ease;
  }

  .action-form input:focus {
    border-color: #16a34a;

    background: #ffffff;

    box-shadow:
      0 0 0 4px rgba(22, 163, 74, 0.12);
  }

  .form-row {
    display: grid;

    grid-template-columns:
      1fr
      1fr;

    gap: 12px;
  }


  /* =========================
     BUTTONS
  ========================= */

  .action-btn {
    width: 100%;

    padding: 13px;

    border: none;

    border-radius: 10px;

    color: #ffffff;

    font-size: 14px;

    font-weight: 700;

    cursor: pointer;

    transition: all 0.25s ease;
  }

  .action-btn:hover {
    transform: translateY(-2px);

    box-shadow:
      0 7px 16px rgba(0, 0, 0, 0.15);
  }

  .btn-eggs {
    background: #d97706;
  }

  .btn-sell {
    background: #198754;
  }

  .btn-dead {
    background: #dc3545;
  }


  /* =========================
     RESPONSIVE
  ========================= */

  @media (max-width: 900px) {

    .cage-actions-grid {
      grid-template-columns:
        1fr
        1fr;
    }

  }

  @media (max-width: 600px) {

    .cage-details-header {
      flex-direction: column;
    }

    .back-btn {
      width: 100%;

      justify-content: center;
    }

    .cage-actions-grid {
      grid-template-columns:
        1fr;
    }

    .cage-details-header h2 {
      font-size: 24px;
    }

    .form-row {
      grid-template-columns:
        1fr;
    }

  }

</style>


<div class="container mt-4 mb-5">


  <!-- PAGE HEADER -->

  <div class="cage-details-header">

    <div>

      <h2>
        🏠 <%= cage.cageName %>
      </h2>

      <p>
        Manage cage activities and record daily operations.
      </p>

    </div>


    <a
      href="/cage"
      class="back-btn"
    >

      ← Back to Cages

    </a>

  </div>


  <!-- SUMMARY -->

  <div class="cage-summary">

    <div class="summary-icon">
      🐔
    </div>

    <div>

      <span class="summary-label">
        Available Chicken
      </span>

      <strong class="summary-value">
        <%= cage.available %>
      </strong>

    </div>

  </div>


  <!-- ACTIONS -->

  <div class="cage-actions-grid">


    <!-- COLLECT EGGS -->

    <div class="action-card eggs-card">

      <div class="action-header">

        <div class="action-icon">
          🥚
        </div>

        <div>

          <h3>
            Collect Eggs
          </h3>

          <p>
            Add eggs collected from this cage.
          </p>

        </div>

      </div>


      <form
        method="POST"
        action="/cage/<%= cage._id %>/eggs"
        class="action-form"
      >

        <label for="eggs">
          Number of Eggs
        </label>

        <input
          type="number"
          id="eggs"
          name="eggs"
          min="0"
          placeholder="Enter number of eggs"
          required
        >

        <button
          type="submit"
          class="action-btn btn-eggs"
        >

          Add Eggs

        </button>

      </form>

    </div>


    <!-- SELL CHICKEN -->

    <div class="action-card sell-card">

      <div class="action-header">

        <div class="action-icon">
          💰
        </div>

        <div>

          <h3>
            Sell Chicken
          </h3>

          <p>
            Record a chicken sale.
          </p>

        </div>

      </div>


      <form
        method="POST"
        action="/cage/<%= cage._id %>/sell"
        class="action-form"
      >

        <div class="form-row">

          <div>

            <label for="sellCount">
              Number Sold
            </label>

            <input
              type="number"
              id="sellCount"
              name="count"
              min="1"
              placeholder="Quantity"
              required
            >

          </div>


          <div>

            <label for="amount">
              Amount
            </label>

            <input
              type="number"
              id="amount"
              name="amount"
              min="0"
              placeholder="Amount"
              required
            >

          </div>

        </div>


        <button
          type="submit"
          class="action-btn btn-sell"
        >

          Record Sale

        </button>

      </form>

    </div>


    <!-- RECORD DEAD CHICKEN -->

    <div class="action-card dead-card">

      <div class="action-header">

        <div class="action-icon">
          ⚠️
        </div>

        <div>

          <h3>
            Record Deaths
          </h3>

          <p>
            Record chicken losses from this cage.
          </p>

        </div>

      </div>


      <form
        method="POST"
        action="/cage/<%= cage._id %>/dead"
        class="action-form"
      >

        <label for="deadCount">
          Number of Chicken Dead
        </label>

        <input
          type="number"
          id="deadCount"
          name="count"
          min="1"
          placeholder="Number dead"
          required
        >

        <button
          type="submit"
          class="action-btn btn-dead"
        >

          Record Dead Chicken

        </button>

      </form>

    </div>


  </div>


</div>