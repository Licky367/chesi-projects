<style>

  /* =========================
     PAGE HEADER
  ========================= */

  .cages-header {
    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 20px;

    margin-bottom: 25px;
  }

  .cages-header h2 {
    margin: 0 0 6px;

    color: #166534;

    font-size: 28px;

    font-weight: 700;
  }

  .cages-header p {
    margin: 0;

    color: #6b7280;

    font-size: 14px;
  }


  /* =========================
     COUNT BADGE
  ========================= */

  .cages-count {
    padding: 8px 14px;

    border-radius: 20px;

    background: #dcfce7;

    color: #166534;

    font-size: 13px;

    font-weight: 700;
  }


  /* =========================
     CAGES GRID
  ========================= */

  .cages-grid {
    display: grid;

    grid-template-columns:
      repeat(auto-fill, minmax(280px, 1fr));

    gap: 20px;
  }


  /* =========================
     CAGE CARD
  ========================= */

  .cage-card {
    position: relative;

    overflow: hidden;

    padding: 24px;

    border: 1px solid #e5e7eb;

    border-radius: 18px;

    background: #ffffff;

    box-shadow:
      0 6px 20px rgba(0, 0, 0, 0.06);

    transition: all 0.25s ease;
  }

  .cage-card::before {
    content: "";

    position: absolute;

    top: 0;
    left: 0;

    width: 100%;
    height: 5px;

    background: #0d6efd;
  }

  .cage-card:hover {
    transform: translateY(-5px);

    box-shadow:
      0 14px 30px rgba(0, 0, 0, 0.1);
  }


  /* =========================
     CARD TOP
  ========================= */

  .cage-card-top {
    display: flex;

    align-items: flex-start;

    justify-content: space-between;

    margin-bottom: 20px;
  }

  .cage-icon {
    width: 50px;
    height: 50px;

    display: flex;

    align-items: center;
    justify-content: center;

    border-radius: 14px;

    background: #dbeafe;

    font-size: 24px;
  }

  .cage-status {
    padding: 6px 10px;

    border-radius: 20px;

    background: #dcfce7;

    color: #166534;

    font-size: 11px;

    font-weight: 700;

    text-transform: uppercase;
  }


  /* =========================
     CAGE NAME
  ========================= */

  .cage-name {
    display: block;

    margin-bottom: 18px;

    color: #166534;

    font-size: 20px;

    font-weight: 700;

    text-decoration: none;
  }

  .cage-name:hover {
    color: #15803d;
  }


  /* =========================
     AVAILABLE INFO
  ========================= */

  .available-box {
    display: flex;

    align-items: center;

    gap: 14px;

    padding: 15px;

    margin-bottom: 18px;

    border-radius: 12px;

    background: #f9fafb;
  }

  .available-icon {
    width: 42px;
    height: 42px;

    display: flex;

    align-items: center;
    justify-content: center;

    border-radius: 12px;

    background: #fef3c7;

    font-size: 20px;
  }

  .available-box strong {
    display: block;

    color: #111827;

    font-size: 22px;
  }

  .available-box span {
    color: #6b7280;

    font-size: 12px;
  }


  /* =========================
     VIEW BUTTON
  ========================= */

  .view-cage-btn {
    display: block;

    width: 100%;

    padding: 11px;

    border-radius: 9px;

    background: #166534;

    color: #ffffff;

    font-size: 13px;

    font-weight: 600;

    text-align: center;

    text-decoration: none;

    transition: 0.25s ease;
  }

  .view-cage-btn:hover {
    background: #14532d;

    color: #ffffff;
  }


  /* =========================
     EMPTY STATE
  ========================= */

  .empty-state {
    padding: 50px 20px;

    border-radius: 18px;

    background: #f9fafb;

    color: #6b7280;

    text-align: center;
  }

  .empty-state-icon {
    margin-bottom: 10px;

    font-size: 42px;
  }

  .empty-state h4 {
    color: #374151;
  }


  /* =========================
     RESPONSIVE
  ========================= */

  @media (max-width: 600px) {

    .cages-header {
      align-items: flex-start;

      flex-direction: column;
    }

    .cages-header h2 {
      font-size: 24px;
    }

    .cages-count {
      align-self: flex-start;
    }

  }

</style>


<div class="container mt-4 mb-5">


  <!-- PAGE HEADER -->

  <div class="cages-header">

    <div>

      <h2>
        🏠 Cages
      </h2>

      <p>
        Manage your poultry cages and monitor available capacity.
      </p>

    </div>


    <span class="cages-count">

      <%= cages.length %>
      Cages

    </span>

  </div>


  <!-- CAGES -->

  <% if (cages.length > 0) { %>


    <div class="cages-grid">


      <% cages.forEach(c => { %>


        <div class="cage-card">


          <div class="cage-card-top">

            <div class="cage-icon">
              🏠
            </div>

            <span class="cage-status">
              Active
            </span>

          </div>


          <a
            href="/cage/<%= c._id %>"
            class="cage-name"
          >

            <%= c.cageName %>

          </a>


          <div class="available-box">

            <div class="available-icon">
              🐔
            </div>

            <div>

              <strong>
                <%= c.available %>
              </strong>

              <span>
                Poultry available
              </span>

            </div>

          </div>


          <a
            href="/cage/<%= c._id %>"
            class="view-cage-btn"
          >

            View Cage Details →

          </a>


        </div>


      <% }) %>


    </div>


  <% } else { %>


    <div class="empty-state">

      <div class="empty-state-icon">
        🏠
      </div>

      <h4>
        No Cages Available
      </h4>

      <p>
        There are currently no cages registered in the system.
      </p>

    </div>


  <% } %>


</div>