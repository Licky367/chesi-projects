<style>

  /* =========================
     PAGE
  ========================= */

  .projects-page {
    max-width: 1100px;

    margin: 0 auto;

    padding: 20px 0 40px;
  }


  /* =========================
     HEADER
  ========================= */

  .projects-header {
    display: flex;

    align-items: flex-start;

    justify-content: space-between;

    gap: 20px;

    margin-bottom: 25px;
  }

  .projects-header h2 {
    margin: 0 0 7px;

    color: #166534;

    font-size: 28px;

    font-weight: 700;
  }

  .projects-header p {
    margin: 0;

    color: #6b7280;

    font-size: 14px;
  }


  /* =========================
     CREATE BUTTON
  ========================= */

  .create-project-link {
    display: inline-flex;

    align-items: center;

    gap: 8px;

    padding: 12px 18px;

    border-radius: 10px;

    background: #166534;

    color: #ffffff;

    font-size: 14px;

    font-weight: 700;

    text-decoration: none;

    transition: all 0.25s ease;
  }

  .create-project-link:hover {
    background: #14532d;

    color: #ffffff;

    transform: translateY(-2px);

    box-shadow:
      0 8px 18px rgba(22, 101, 52, 0.2);
  }


  /* =========================
     PROJECT GRID
  ========================= */

  .projects-grid {
    display: grid;

    grid-template-columns:
      repeat(auto-fill, minmax(280px, 1fr));

    gap: 20px;
  }


  /* =========================
     PROJECT CARD
  ========================= */

  .project-card {
    position: relative;

    display: flex;

    flex-direction: column;

    padding: 24px;

    overflow: hidden;

    border: 1px solid #e5e7eb;

    border-radius: 18px;

    background: #ffffff;

    box-shadow:
      0 6px 20px rgba(0, 0, 0, 0.06);

    transition: all 0.25s ease;
  }

  .project-card::before {
    content: "";

    position: absolute;

    top: 0;
    left: 0;

    width: 100%;
    height: 5px;

    background: #16a34a;
  }

  .project-card:hover {
    transform: translateY(-5px);

    box-shadow:
      0 14px 30px rgba(0, 0, 0, 0.1);
  }


  /* =========================
     CARD TOP
  ========================= */

  .project-card-top {
    display: flex;

    align-items: center;

    justify-content: space-between;

    margin-bottom: 20px;
  }

  .project-icon {
    width: 52px;
    height: 52px;

    display: flex;

    align-items: center;
    justify-content: center;

    border-radius: 15px;

    background: #dcfce7;

    font-size: 25px;
  }

  .project-status {
    padding: 6px 10px;

    border-radius: 20px;

    background: #dcfce7;

    color: #166534;

    font-size: 11px;

    font-weight: 700;

    text-transform: uppercase;
  }


  /* =========================
     PROJECT NAME
  ========================= */

  .project-name {
    margin-bottom: 12px;

    color: #166534;

    font-size: 20px;

    font-weight: 700;

    line-height: 1.3;
  }


  /* =========================
     PROJECT DETAILS
  ========================= */

  .project-info {
    display: flex;

    flex-direction: column;

    gap: 10px;

    margin-bottom: 22px;

    color: #6b7280;

    font-size: 13px;
  }

  .project-info-row {
    display: flex;

    align-items: center;

    gap: 8px;
  }

  .project-info-row strong {
    color: #374151;
  }


  /* =========================
     VIEW BUTTON
  ========================= */

  .view-project-btn {
    display: block;

    width: 100%;

    padding: 11px;

    margin-top: auto;

    border-radius: 9px;

    background: #f0fdf4;

    color: #166534;

    font-size: 13px;

    font-weight: 700;

    text-align: center;

    text-decoration: none;

    transition: all 0.25s ease;
  }

  .view-project-btn:hover {
    background: #166534;

    color: #ffffff;
  }


  /* =========================
     EMPTY STATE
  ========================= */

  .empty-state {
    padding: 55px 20px;

    border-radius: 18px;

    background: #f9fafb;

    color: #6b7280;

    text-align: center;
  }

  .empty-state-icon {
    margin-bottom: 12px;

    font-size: 45px;
  }

  .empty-state h3 {
    margin-bottom: 8px;

    color: #374151;
  }

  .empty-state p {
    margin-bottom: 20px;
  }


  /* =========================
     RESPONSIVE
  ========================= */

  @media (max-width: 650px) {

    .projects-header {
      flex-direction: column;
    }

    .create-project-link {
      width: 100%;

      justify-content: center;
    }

    .projects-header h2 {
      font-size: 24px;
    }

  }

</style>


<div class="projects-page">


  <!-- PAGE HEADER -->

  <div class="projects-header">

    <div>

      <h2>
        📂 Farm Projects
      </h2>

      <p>
        View, manage, and track all your farm projects.
      </p>

    </div>


    <a
      href="/farm"
      class="create-project-link"
    >

      ➕ Create Project

    </a>

  </div>


  <% if (projects && projects.length > 0) { %>


    <!-- PROJECTS GRID -->

    <div class="projects-grid">


      <% projects.forEach(project => { %>


        <div class="project-card">


          <div class="project-card-top">

            <div class="project-icon">
              🌱
            </div>

            <span class="project-status">
              Active
            </span>

          </div>


          <div class="project-name">

            <%= project.name %>

          </div>


          <div class="project-info">

            <div class="project-info-row">

              <span>📁</span>

              <span>
                Farm Project
              </span>

            </div>

            <div class="project-info-row">

              <span>🔍</span>

              <span>
                View project details and progress
              </span>

            </div>

          </div>


          <a
            href="/farm/details?id=<%= project._id %>"
            class="view-project-btn"
          >

            View Project Details →

          </a>


        </div>


      <% }) %>


    </div>


  <% } else { %>


    <!-- EMPTY STATE -->

    <div class="empty-state">

      <div class="empty-state-icon">
        🌱
      </div>

      <h3>
        No Farm Projects Yet
      </h3>

      <p>
        Create your first farm project to start tracking your activities.
      </p>

      <a
        href="/farm"
        class="create-project-link"
      >

        ➕ Create First Project

      </a>

    </div>


  <% } %>


</div>