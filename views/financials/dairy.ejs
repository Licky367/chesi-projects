<% /* ==========================================================
   FINANCIAL / DAIRY DETAILS PAGE

   BACKEND DATA

   Current controller provides:

       dairy
       liabilities
       filters

   The updated service should provide:

       dairy: {
           _id,
           name,
           code,
           currentWorth,
           salesAmount,
           revenue,
           profit,
           assets: []
       }

       Each asset may contain:

           _id
           name
           code
           type
           currentWorth
           buyingPrice
           sellingPrice
           revenue
           liabilities
           profit

       filters: {
           startDate,
           endDate
       }

   PROFIT RULE:

       sellingPrice
       - buyingPrice
       - liabilities
       + revenue

   ========================================================== */ %>


<%
/* ==========================================================
   HELPERS
   ========================================================== */

function number(value) {

    const result = Number(value);

    return Number.isFinite(result)
        ? result
        : 0;

}


function formatMoney(value) {

    const amount = Number(value);

    if (!Number.isFinite(amount)) {

        return "—";

    }

    return amount.toLocaleString(

        "en-KE",

        {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
        }

    );

}


function profitClass(value) {

    return number(value) < 0
        ? "financial-negative"
        : "financial-positive";

}


function profitText(value) {

    const amount = number(value);

    return (
        amount < 0
            ? "-KSh " + formatMoney(Math.abs(amount))
            : "KSh " + formatMoney(amount)
    );

}


/* ==========================================================
   SAFE DATA
   ========================================================== */

const farm =
    dairy || {};


const assets =
    Array.isArray(farm.assets)
        ? farm.assets
        : [];


const filterStart =
    filters?.startDate || "";


const filterEnd =
    filters?.endDate || "";


const hasFilter =
    Boolean(
        filterStart ||
        filterEnd
    );


/* ==========================================================
   FARM TOTALS
   ========================================================== */

let totalCurrentWorth = 0;

let totalSalesAmount = 0;

let totalBuyingPrice = 0;

let totalRevenue = 0;

let totalLiabilities = 0;

let totalProfit = 0;


/* ==========================================================
   CALCULATE ASSET TOTALS

   The service should preferably supply these values.

   We calculate them here as a safe presentation fallback.
   ========================================================== */

assets.forEach(function(asset) {

    const currentWorth =
        number(
            asset?.currentWorth
        );


    const buyingPrice =
        number(
            asset?.buyingPrice
        );


    const sellingPrice =
        number(
            asset?.sellingPrice
        );


    const revenue =
        number(
            asset?.revenue
        );


    const liabilitiesValue =
        number(
            asset?.liabilities
        );


    const calculatedProfit =
        sellingPrice
        - buyingPrice
        - liabilitiesValue
        + revenue;


    totalCurrentWorth +=
        currentWorth;


    totalSalesAmount +=
        sellingPrice;


    totalBuyingPrice +=
        buyingPrice;


    totalRevenue +=
        revenue;


    totalLiabilities +=
        liabilitiesValue;


    totalProfit +=
        calculatedProfit;

});


/* ==========================================================
   PREFER SERVICE-SUPPLIED FARM TOTALS

   These values will be supplied by the updated service.

   Fall back to asset calculations where necessary.
   ========================================================== */

if (
    farm.currentWorth !== undefined &&
    farm.currentWorth !== null
) {

    totalCurrentWorth =
        number(farm.currentWorth);

}


if (
    farm.salesAmount !== undefined &&
    farm.salesAmount !== null
) {

    totalSalesAmount =
        number(farm.salesAmount);

}


if (
    farm.revenue !== undefined &&
    farm.revenue !== null
) {

    totalRevenue =
        number(farm.revenue);

}


if (
    farm.liabilities !== undefined &&
    farm.liabilities !== null
) {

    totalLiabilities =
        number(farm.liabilities);

}


if (
    farm.profit !== undefined &&
    farm.profit !== null
) {

    totalProfit =
        number(farm.profit);

}


/* ==========================================================
   SORT ASSETS

   Highest profit first.

   If profit is tied:
       highest currentWorth first.
   ========================================================== */

assets.sort(function(a, b) {

    const profitA =
        number(a?.profit);


    const profitB =
        number(b?.profit);


    if (profitA !== profitB) {

        return profitB - profitA;

    }


    return (
        number(b?.currentWorth)
        -
        number(a?.currentWorth)
    );

});

%>


<div class="financial-page dairy-financial-page">


    <!-- ======================================================
         HEADER
         ====================================================== -->

    <div class="financial-page-header">

        <div>

            <span class="financial-eyebrow">

                DAIRY FARM FINANCIALS

            </span>


            <h1 class="financial-title">

                <%= farm.name || "Dairy Farm" %>

            </h1>


            <p class="financial-subtitle">

                <% if (farm.code !== undefined && farm.code !== null) { %>

                    Farm Code:
                    <strong>
                        <%= farm.code %>
                    </strong>

                <% } else { %>

                    Financial performance and asset breakdown.

                <% } %>

            </p>

        </div>


        <a
            href="/financials/summary"
            class="financial-button financial-button-secondary"
        >

            <i class="bi bi-arrow-left"></i>

            Summary

        </a>

    </div>


    <!-- ======================================================
         CURRENT NET WORTH
         ====================================================== -->

    <section class="financial-worth-card">

        <div class="financial-worth-icon">

            <i class="bi bi-wallet2"></i>

        </div>


        <div>

            <span>

                Current Net Worth

            </span>


            <strong>

                KSh
                <%= formatMoney(totalCurrentWorth) %>

            </strong>


            <small>

                Current value — independent of date filter

            </small>

        </div>

    </section>


    <!-- ======================================================
         DATE FILTER
         ====================================================== -->

    <section class="financial-filter-card">


        <form
            method="GET"
            action="/financials/dairy/<%= farm._id %>"
            class="financial-filter-form"
        >


            <div class="financial-filter-group">

                <label for="startDate">

                    From

                </label>


                <input
                    type="date"
                    id="startDate"
                    name="startDate"
                    value="<%= filterStart %>"
                >

            </div>


            <div class="financial-filter-group">

                <label for="endDate">

                    To

                </label>


                <input
                    type="date"
                    id="endDate"
                    name="endDate"
                    value="<%= filterEnd %>"
                >

            </div>


            <button
                type="submit"
                class="financial-button financial-button-primary"
            >

                <i class="bi bi-funnel"></i>

                Apply

            </button>


            <% if (hasFilter) { %>

                <a
                    href="/financials/dairy/<%= farm._id %>"
                    class="financial-clear-filter"
                >

                    <i class="bi bi-x-circle"></i>

                    Clear

                </a>

            <% } %>


        </form>

    </section>


    <!-- ======================================================
         FARM FINANCIAL TABLE
         ====================================================== -->

    <section class="financial-section">


        <div class="financial-section-header">

            <span class="financial-eyebrow">

                ASSET BREAKDOWN

            </span>


            <h2>

                Farm Assets

            </h2>


            <p>

                Assets are ranked by profit/loss, with current
                worth used to break ties.

            </p>

        </div>


        <div class="financial-table-wrapper">


            <table class="financial-table">


                <thead>

                    <tr>

                        <th>

                            Asset

                        </th>

                        <th>

                            Current Worth

                        </th>

                        <th>

                            Sales Amount

                        </th>

                        <th>

                            Revenue

                        </th>

                        <th>

                            Profit / Loss

                        </th>

                    </tr>

                </thead>


                <tbody>


                    <% if (assets.length) { %>


                        <% assets.forEach(function(asset) { %>

                            <%
                                const assetProfit =
                                    asset?.profit !== undefined &&
                                    asset?.profit !== null

                                        ? number(asset.profit)

                                        : (
                                            number(asset?.sellingPrice)
                                            -
                                            number(asset?.buyingPrice)
                                            -
                                            number(asset?.liabilities)
                                            +
                                            number(asset?.revenue)
                                        );
                            %>


                            <tr>


                                <td>

                                    <a
                                        href="/financials/dairy/<%= asset._id %>"
                                        class="financial-table-name"
                                    >

                                        <strong>

                                            <%= asset.name ||
                                                "Unnamed Asset"
                                            %>

                                        </strong>


                                        <% if (asset.type) { %>

                                            <small>

                                                <%= asset.type %>

                                            </small>

                                        <% } %>


                                        <% if (
                                            asset.code !== undefined &&
                                            asset.code !== null
                                        ) { %>

                                            <small>

                                                Code:
                                                <%= asset.code %>

                                            </small>

                                        <% } %>

                                    </a>

                                </td>


                                <td>

                                    KSh
                                    <%= formatMoney(
                                        asset.currentWorth
                                    ) %>

                                </td>


                                <td>

                                    KSh
                                    <%= formatMoney(
                                        asset.sellingPrice
                                    ) %>

                                </td>


                                <td>

                                    KSh
                                    <%= formatMoney(
                                        asset.revenue
                                    ) %>

                                </td>


                                <td>

                                    <strong
                                        class="<%= profitClass(
                                            assetProfit
                                        ) %>"
                                    >

                                        <%= profitText(
                                            assetProfit
                                        ) %>

                                    </strong>

                                </td>


                            </tr>


                        <% }); %>


                    <% } else { %>


                        <tr>

                            <td
                                colspan="5"
                                class="financial-table-empty"
                            >

                                <i class="bi bi-box-seam"></i>


                                <strong>

                                    No assets found

                                </strong>


                                <span>

                                    This farm currently has no
                                    assets available for financial
                                    analysis.

                                </span>

                            </td>

                        </tr>


                    <% } %>


                </tbody>


                <!-- ==================================================
                     TOTAL
                     ================================================== -->

                <tfoot>

                    <tr>

                        <th>

                            Total

                        </th>


                        <th>

                            KSh
                            <%= formatMoney(
                                totalCurrentWorth
                            ) %>

                        </th>


                        <th>

                            KSh
                            <%= formatMoney(
                                totalSalesAmount
                            ) %>

                        </th>


                        <th>

                            KSh
                            <%= formatMoney(
                                totalRevenue
                            ) %>

                        </th>


                        <th>

                            <strong
                                class="<%= profitClass(
                                    totalProfit
                                ) %>"
                            >

                                <%= profitText(
                                    totalProfit
                                ) %>

                            </strong>

                        </th>

                    </tr>

                </tfoot>


            </table>

        </div>

    </section>


    <!-- ======================================================
         FINANCIAL FORMULA
         ====================================================== -->

    <section class="financial-formula-note">

        <i class="bi bi-calculator"></i>


        <div>

            <strong>

                Profit / Loss calculation

            </strong>


            <span>

                Selling Price − Buying Price − Liabilities
                + Revenue

            </span>

        </div>

    </section>


</div>


