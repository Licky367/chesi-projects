<% /* ==========================================================
   DAIRY FARM FINANCIAL PAGE

   CONTROLLER DATA:

       dairy

   SERVICE RESPONSE FOR FARM:

       dairy.farm
       dairy.assets

       dairy.currentWorth
       dairy.totalCurrentWorth

       dairy.salesAmount
       dairy.totalSalesAmount

       dairy.revenue
       dairy.totalRevenue

       dairy.totalLiabilities

       dairy.profit
       dairy.totalProfit

   FARM IDENTIFICATION:

       farm.code < 0

   FARM ASSET IDENTIFICATION:

       asset.assetCode === farm.code

   The service is responsible for finding and calculating
   farm assets.

   This template only displays the supplied data.

   ========================================================== */ %>


<%
/* ==========================================================
   HELPERS
   ========================================================== */

function number(value) {

    const result =
        Number(value);

    return Number.isFinite(result)
        ? result
        : 0;

}


function formatMoney(value) {

    const amount =
        Number(value);

    if (
        !Number.isFinite(amount)
    ) {

        return "—";

    }

    return amount.toLocaleString(

        "en-KE",

        {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
        }

    );

}


function profitClass(value) {

    return number(value) < 0
        ? "financial-negative"
        : "financial-positive";

}


function profitText(value) {

    const amount =
        number(value);

    if (
        amount < 0
    ) {

        return (
            "-KSh " +
            formatMoney(
                Math.abs(amount)
            )
        );

    }

    return (
        "KSh " +
        formatMoney(amount)
    );

}


/* ==========================================================
   NORMALIZE SERVICE RESPONSE
   ========================================================== */

const financial =
    dairy || {};


const farm =
    financial.farm || financial;


const assets =
    Array.isArray(
        financial.assets
    )

        ? financial.assets

        : [];


const farmId =
    farm._id || financial._id || "";


const farmName =
    farm.name ||
    financial.name ||
    "Dairy Farm";


const farmCode =
    farm.code;


/* ==========================================================
   FARM TOTALS

   These include:

       farm itself
       +
       all farm assets
   ========================================================== */

const totalCurrentWorth =
    number(
        financial.totalCurrentWorth ??
        financial.currentWorth
    );


const totalSalesAmount =
    number(
        financial.totalSalesAmount ??
        financial.salesAmount
    );


const totalRevenue =
    number(
        financial.totalRevenue ??
        financial.revenue
    );


const totalLiabilities =
    number(
        financial.totalLiabilities
    );


const totalProfit =
    number(
        financial.totalProfit ??
        financial.profit
    );


/* ==========================================================
   DATE FILTERS
   ========================================================== */

const filterStart =
    filters?.startDate || "";


const filterEnd =
    filters?.endDate || "";


const hasFilter =
    Boolean(
        filterStart ||
        filterEnd
    );


/* ==========================================================
   SORT ASSETS

   The service already sorts assets, but sorting here again
   keeps the display deterministic if the response changes.
   ========================================================== */

assets.sort(

    function(a, b) {

        const profitA =
            number(
                a?.profit
            );


        const profitB =
            number(
                b?.profit
            );


        if (
            profitA !== profitB
        ) {

            return (
                profitB -
                profitA
            );

        }


        return (

            number(
                b?.currentWorth
            )

            -

            number(
                a?.currentWorth
            )

        );

    }

);

%>


<div class="financial-page dairy-financial-page">


    <!-- ======================================================
         HEADER
         ====================================================== -->

    <div class="financial-page-header">


        <div>

            <span class="financial-eyebrow">

                DAIRY FARM FINANCIALS

            </span>


            <h1 class="financial-title">

                <%= farmName %>

            </h1>


            <p class="financial-subtitle">

                <% if (
                    farmCode !== undefined &&
                    farmCode !== null &&
                    farmCode !== ""
                ) { %>

                    Farm Code:

                    <strong>
                        <%= farmCode %>
                    </strong>

                <% } else { %>

                    Financial performance and
                    asset breakdown.

                <% } %>

            </p>

        </div>


        <a
            href="/financials/summary"
            class="financial-button financial-button-secondary"
        >

            <i class="bi bi-arrow-left"></i>

            Summary

        </a>


    </div>


    <!-- ======================================================
         CURRENT NET WORTH
         ====================================================== -->

    <section class="financial-worth-card">


        <div class="financial-worth-icon">

            <i class="bi bi-wallet2"></i>

        </div>


        <div>

            <span>
                Current Net Worth
            </span>


            <strong>

                KSh
                <%= formatMoney(
                    totalCurrentWorth
                ) %>

            </strong>


            <small>

                Farm + assigned assets.
                Independent of liability date filter.

            </small>

        </div>


    </section>


    <!-- ======================================================
         DATE FILTER
         ====================================================== -->

    <section class="financial-filter-card">


        <form
            method="GET"
            action="/financials/farm/<%= farmId %>"
            class="financial-filter-form"
        >


            <div class="financial-filter-group">


                <label for="startDate">

                    From

                </label>


                <input
                    type="date"
                    id="startDate"
                    name="startDate"
                    value="<%= filterStart %>"
                >


            </div>


            <div class="financial-filter-group">


                <label for="endDate">

                    To

                </label>


                <input
                    type="date"
                    id="endDate"
                    name="endDate"
                    value="<%= filterEnd %>"
                >


            </div>


            <button
                type="submit"
                class="financial-button financial-button-primary"
            >

                <i class="bi bi-funnel"></i>

                Apply

            </button>


            <% if (hasFilter) { %>

                <a
                    href="/financials/farm/<%= farmId %>"
                    class="financial-clear-filter"
                >

                    <i class="bi bi-x-circle"></i>

                    Clear

                </a>

            <% } %>


        </form>


    </section>


    <!-- ======================================================
         FARM ASSETS
         ====================================================== -->

    <section class="financial-section">


        <div class="financial-section-header">


            <span class="financial-eyebrow">

                ASSET BREAKDOWN

            </span>


            <h2>

                Farm Assets

            </h2>


            <p>

                Dairy records belonging to this farm
                through their assetCode.

            </p>


        </div>


        <div class="financial-table-wrapper">


            <table class="financial-table">


                <thead>

                    <tr>

                        <th>
                            Asset
                        </th>


                        <th>
                            Type
                        </th>


                        <th>
                            Current Worth
                        </th>


                        <th>
                            Sales Amount
                        </th>


                        <th>
                            Revenue
                        </th>


                        <th>
                            Liabilities
                        </th>


                        <th>
                            Profit / Loss
                        </th>

                    </tr>

                </thead>


                <tbody>


                    <% if (
                        assets.length > 0
                    ) { %>


                        <% assets.forEach(
                            function(asset) {
                        %>


                            <tr>


                                <!-- ==================================
                                     ASSET
                                     ================================== -->

                                <td>


                                    <div
                                        class="financial-table-name"
                                    >


                                        <strong>

                                            <%= asset.name ||
                                                "Unnamed Asset"
                                            %>

                                        </strong>


                                        <% if (
                                            asset.code !== undefined &&
                                            asset.code !== null &&
                                            asset.code !== ""
                                        ) { %>


                                            <small>

                                                Code:
                                                <%= asset.code %>

                                            </small>


                                        <% } %>


                                        <% if (
                                            asset.assetCode !== undefined &&
                                            asset.assetCode !== null &&
                                            asset.assetCode !== ""
                                        ) { %>


                                            <small>

                                                Farm:
                                                <%= asset.assetCode %>

                                            </small>


                                        <% } %>


                                    </div>


                                </td>


                                <!-- ==================================
                                     TYPE
                                     ================================== -->

                                <td>

                                    <%= asset.type ||
                                        "—"
                                    %>

                                </td>


                                <!-- ==================================
                                     CURRENT WORTH
                                     ================================== -->

                                <td>

                                    KSh
                                    <%= formatMoney(
                                        asset.currentWorth
                                    ) %>

                                </td>


                                <!-- ==================================
                                     SALES AMOUNT
                                     ================================== -->

                                <td>

                                    KSh
                                    <%= formatMoney(
                                        asset.salesAmount
                                    ) %>

                                </td>


                                <!-- ==================================
                                     REVENUE
                                     ================================== -->

                                <td>

                                    KSh
                                    <%= formatMoney(
                                        asset.revenue
                                    ) %>

                                </td>


                                <!-- ==================================
                                     LIABILITIES
                                     ================================== -->

                                <td>

                                    KSh
                                    <%= formatMoney(
                                        asset.totalLiabilities
                                    ) %>

                                </td>


                                <!-- ==================================
                                     PROFIT / LOSS
                                     ================================== -->

                                <td>


                                    <strong
                                        class="<%= profitClass(
                                            asset.profit
                                        ) %>"
                                    >

                                        <%= profitText(
                                            asset.profit
                                        ) %>

                                    </strong>


                                </td>


                            </tr>


                        <% }); %>


                    <% } else { %>


                        <tr>


                            <td
                                colspan="7"
                                class="financial-table-empty"
                            >


                                <i class="bi bi-box-seam"></i>


                                <strong>

                                    No assets found

                                </strong>


                                <span>

                                    No Dairy records were found
                                    with assetCode equal to this
                                    farm's code.

                                </span>


                            </td>


                        </tr>


                    <% } %>


                </tbody>


                <!-- ==================================================
                     FARM TOTAL
                     ================================================== -->

                <tfoot>


                    <tr>


                        <th colspan="2">

                            Farm Total

                        </th>


                        <th>

                            KSh
                            <%= formatMoney(
                                totalCurrentWorth
                            ) %>

                        </th>


                        <th>

                            KSh
                            <%= formatMoney(
                                totalSalesAmount
                            ) %>

                        </th>


                        <th>

                            KSh
                            <%= formatMoney(
                                totalRevenue
                            ) %>

                        </th>


                        <th>

                            KSh
                            <%= formatMoney(
                                totalLiabilities
                            ) %>

                        </th>


                        <th>


                            <strong
                                class="<%= profitClass(
                                    totalProfit
                                ) %>"
                            >

                                <%= profitText(
                                    totalProfit
                                ) %>

                            </strong>


                        </th>


                    </tr>


                </tfoot>


            </table>


        </div>


    </section>


    <!-- ======================================================
         FINANCIAL FORMULA
         ====================================================== -->

    <section class="financial-formula-note">


        <i class="bi bi-calculator"></i>


        <div>


            <strong>

                Profit / Loss calculation

            </strong>


            <span>

                For unsold records:
                Revenue − Liabilities.

                For sold records:
                Selling Price − Buying Price
                − Liabilities + Revenue.

            </span>


        </div>


    </section>


</div>


