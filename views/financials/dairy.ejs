<%
// ==========================================================
// views/financials/dairy.ejs
// ==========================================================
//
// INDIVIDUAL DAIRY / ASSET FINANCIAL DETAILS
//
// Controller supplies:
//
//     dairy
//     liabilities
//     filters
//     user
//
// Financial rules:
//
//     currentWorth
//         -> always current
//
//     totalLiabilities
//         -> respects date filter
//
//     profit
//         -> respects date filter
//
// Shared layout:
//     This view is rendered inside the application's
//     shared layout.
//
// ==========================================================
%>


<style>

/* ==========================================================
   FINANCIAL PAGE
========================================================== */

.financial-page {

    max-width: 1100px;

    margin: 0 auto;

    padding: 24px 16px 50px;

}


/* ==========================================================
   HEADER
========================================================== */

.financial-header {

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 16px;

    margin-bottom: 24px;

    flex-wrap: wrap;

}


.financial-header-left {

    display: flex;

    align-items: center;

    gap: 14px;

}


.back-button {

    width: 42px;

    height: 42px;

    display: flex;

    align-items: center;

    justify-content: center;

    border-radius: 12px;

    background: #f1f8f3;

    color: #198754;

    text-decoration: none;

    font-size: 20px;

    transition:
        background .2s ease,
        color .2s ease,
        transform .2s ease;

}


.back-button:hover {

    background: #dff1e5;

    color: #146c43;

    transform: translateX(-2px);

}


.financial-title {

    margin: 0;

    font-size: 24px;

    font-weight: 700;

    color: #1f2937;

}


.financial-subtitle {

    margin: 4px 0 0;

    color: #6b7280;

    font-size: 14px;

}


/* ==========================================================
   FILTER CARD
========================================================== */

.filter-card {

    background: #ffffff;

    border: 1px solid #e5e7eb;

    border-radius: 16px;

    padding: 18px;

    margin-bottom: 22px;

    box-shadow:
        0 3px 12px rgba(0, 0, 0, .05);

}


.filter-title {

    display: flex;

    align-items: center;

    gap: 8px;

    margin-bottom: 14px;

    font-size: 15px;

    font-weight: 700;

    color: #374151;

}


.filter-title i {

    color: #198754;

}


.filter-grid {

    display: grid;

    grid-template-columns:
        repeat(2, minmax(0, 1fr));

    gap: 14px;

}


.filter-field {

    display: flex;

    flex-direction: column;

    gap: 6px;

}


.filter-label {

    font-size: 13px;

    font-weight: 600;

    color: #4b5563;

}


.filter-input {

    width: 100%;

    box-sizing: border-box;

    padding: 11px 12px;

    border: 1px solid #d1d5db;

    border-radius: 10px;

    font-size: 14px;

    background: #ffffff;

    color: #1f2937;

}


.filter-input:focus {

    outline: none;

    border-color: #198754;

    box-shadow:
        0 0 0 3px rgba(25, 135, 84, .12);

}


.filter-actions {

    display: flex;

    align-items: center;

    gap: 10px;

    margin-top: 15px;

    flex-wrap: wrap;

}


.filter-button {

    border: none;

    border-radius: 10px;

    padding: 10px 16px;

    background: #198754;

    color: #ffffff;

    font-size: 14px;

    font-weight: 600;

    cursor: pointer;

    transition:
        background .2s ease,
        transform .2s ease;

}


.filter-button:hover {

    background: #157347;

    transform: translateY(-1px);

}


.clear-button {

    display: inline-flex;

    align-items: center;

    gap: 6px;

    padding: 10px 16px;

    border-radius: 10px;

    background: #f3f4f6;

    color: #374151;

    text-decoration: none;

    font-size: 14px;

    font-weight: 600;

}


.clear-button:hover {

    background: #e5e7eb;

}


/* ==========================================================
   FINANCIAL CARDS
========================================================== */

.financial-grid {

    display: grid;

    grid-template-columns:
        repeat(3, minmax(0, 1fr));

    gap: 16px;

    margin-bottom: 24px;

}


.financial-card {

    background: #ffffff;

    border: 1px solid #e5e7eb;

    border-radius: 16px;

    padding: 20px;

    box-shadow:
        0 3px 12px rgba(0, 0, 0, .05);

}


.financial-card-label {

    display: flex;

    align-items: center;

    gap: 8px;

    color: #6b7280;

    font-size: 13px;

    font-weight: 600;

    margin-bottom: 10px;

}


.financial-card-label i {

    color: #198754;

}


.financial-card-value {

    font-size: 24px;

    font-weight: 750;

    color: #1f2937;

    word-break: break-word;

}


.financial-card-note {

    margin-top: 6px;

    font-size: 12px;

    color: #9ca3af;

}


/* ==========================================================
   PROFIT / LOSS VALUE
========================================================== */

.profit-positive {

    color: #198754;

}


.profit-negative {

    color: #dc3545;

}


/* ==========================================================
   DETAILS CARD
========================================================== */

.details-card {

    background: #ffffff;

    border: 1px solid #e5e7eb;

    border-radius: 16px;

    padding: 20px;

    margin-bottom: 24px;

    box-shadow:
        0 3px 12px rgba(0, 0, 0, .05);

}


.section-title {

    display: flex;

    align-items: center;

    gap: 8px;

    margin: 0 0 18px;

    font-size: 17px;

    font-weight: 700;

    color: #1f2937;

}


.section-title i {

    color: #198754;

}


.details-grid {

    display: grid;

    grid-template-columns:
        repeat(2, minmax(0, 1fr));

    gap: 14px 24px;

}


.detail-item {

    display: flex;

    flex-direction: column;

    gap: 4px;

    padding-bottom: 12px;

    border-bottom: 1px solid #f0f0f0;

}


.detail-label {

    font-size: 12px;

    color: #6b7280;

    font-weight: 600;

}


.detail-value {

    font-size: 15px;

    color: #1f2937;

    font-weight: 600;

    word-break: break-word;

}


/* ==========================================================
   LIABILITY HISTORY
========================================================== */

.liability-card {

    background: #ffffff;

    border: 1px solid #e5e7eb;

    border-radius: 16px;

    overflow: hidden;

    box-shadow:
        0 3px 12px rgba(0, 0, 0, .05);

}


.liability-header {

    padding: 18px 20px;

    border-bottom: 1px solid #e5e7eb;

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 12px;

    flex-wrap: wrap;

}


.liability-header-title {

    margin: 0;

    font-size: 17px;

    font-weight: 700;

    color: #1f2937;

}


.liability-count {

    padding: 5px 9px;

    border-radius: 20px;

    background: #e9f7ef;

    color: #198754;

    font-size: 12px;

    font-weight: 700;

}


.liability-list {

    display: flex;

    flex-direction: column;

}


.liability-row {

    padding: 17px 20px;

    border-bottom: 1px solid #f0f0f0;

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 16px;

}


.liability-row:last-child {

    border-bottom: none;

}


.liability-description {

    font-size: 14px;

    font-weight: 600;

    color: #1f2937;

}


.liability-date {

    margin-top: 4px;

    font-size: 12px;

    color: #9ca3af;

}


.liability-recorded {

    margin-top: 3px;

    font-size: 12px;

    color: #6b7280;

}


.liability-amount {

    white-space: nowrap;

    font-size: 15px;

    font-weight: 700;

    color: #dc3545;

}


/* ==========================================================
   EMPTY STATE
========================================================== */

.empty-state {

    padding: 40px 20px;

    text-align: center;

    color: #6b7280;

}


.empty-state-icon {

    font-size: 32px;

    margin-bottom: 10px;

    color: #9ca3af;

}


.empty-state-title {

    margin-bottom: 4px;

    font-weight: 700;

    color: #4b5563;

}


.empty-state-text {

    font-size: 13px;

}


/* ==========================================================
   RESPONSIVE
========================================================== */

@media (max-width: 800px) {

    .financial-grid {

        grid-template-columns: 1fr;

    }

}


@media (max-width: 600px) {

    .financial-page {

        padding:
            18px 12px 40px;

    }


    .financial-title {

        font-size: 21px;

    }


    .filter-grid {

        grid-template-columns: 1fr;

    }


    .details-grid {

        grid-template-columns: 1fr;

    }


    .liability-row {

        align-items: flex-start;

        flex-direction: column;

    }


    .liability-amount {

        align-self: flex-start;

    }

}

</style>


<div class="financial-page">


    <!-- ==================================================
         HEADER
    ================================================== -->

    <header class="financial-header">

        <div class="financial-header-left">

            <a
                href="/financials/summary"
                class="back-button"
                aria-label="Back to Financial Summary"
            >

                <i class="bi bi-arrow-left"></i>

            </a>


            <div>

                <h1 class="financial-title">

                    <%= dairy?.name || "Financial Details" %>

                </h1>


                <p class="financial-subtitle">

                    Individual financial record

                </p>

            </div>

        </div>

    </header>


    <!-- ==================================================
         DATE FILTER
    ================================================== -->

    <section class="filter-card">

        <div class="filter-title">

            <i class="bi bi-calendar3"></i>

            Financial Period

        </div>


        <form
            method="GET"
            action="/financials/dairy/<%= dairy?._id %>"
        >

            <div class="filter-grid">


                <!-- START DATE -->

                <div class="filter-field">

                    <label
                        class="filter-label"
                        for="startDate"
                    >

                        Start date

                    </label>


                    <input
                        type="date"
                        id="startDate"
                        name="startDate"
                        class="filter-input"
                        value="<%= filters?.startDate || '' %>"
                    >

                </div>


                <!-- END DATE -->

                <div class="filter-field">

                    <label
                        class="filter-label"
                        for="endDate"
                    >

                        End date

                    </label>


                    <input
                        type="date"
                        id="endDate"
                        name="endDate"
                        class="filter-input"
                        value="<%= filters?.endDate || '' %>"
                    >

                </div>

            </div>


            <div class="filter-actions">

                <button
                    type="submit"
                    class="filter-button"
                >

                    <i class="bi bi-funnel"></i>

                    Apply Filter

                </button>


                <a
                    href="/financials/dairy/<%= dairy?._id %>"
                    class="clear-button"
                >

                    <i class="bi bi-x-circle"></i>

                    Clear

                </a>

            </div>

        </form>

    </section>


    <!-- ==================================================
         FINANCIAL SUMMARY
    ================================================== -->

    <section class="financial-grid">


        <!-- CURRENT WORTH -->

        <article class="financial-card">

            <div class="financial-card-label">

                <i class="bi bi-wallet2"></i>

                Current Worth

            </div>


            <div class="financial-card-value">

                KSh

                <%= Number(
                    dairy?.currentWorth || 0
                ).toLocaleString("en-KE") %>

            </div>


            <div class="financial-card-note">

                Current value — not date filtered

            </div>

        </article>


        <!-- LIABILITIES -->

        <article class="financial-card">

            <div class="financial-card-label">

                <i class="bi bi-credit-card"></i>

                Liabilities

            </div>


            <div class="financial-card-value">

                KSh

                <%= Number(
                    dairy?.totalLiabilities || 0
                ).toLocaleString("en-KE") %>

            </div>


            <div class="financial-card-note">

                Selected financial period

            </div>

        </article>


        <!-- PROFIT / LOSS -->

        <article class="financial-card">

            <div class="financial-card-label">

                <i class="bi bi-graph-up-arrow"></i>

                Profit / Loss

            </div>


            <div class="financial-card-value
                <%= Number(dairy?.profit || 0) >= 0
                    ? 'profit-positive'
                    : 'profit-negative'
                %>"
            >

                KSh

                <%= Number(
                    dairy?.profit || 0
                ).toLocaleString("en-KE") %>

            </div>


            <div class="financial-card-note">

                Selected financial period

            </div>

        </article>


    </section>


    <!-- ==================================================
         ASSET DETAILS
    ================================================== -->

    <section class="details-card">

        <h2 class="section-title">

            <i class="bi bi-info-circle"></i>

            Asset Details

        </h2>


        <div class="details-grid">


            <!-- NAME -->

            <div class="detail-item">

                <span class="detail-label">

                    Name

                </span>


                <span class="detail-value">

                    <%= dairy?.name || "—" %>

                </span>

            </div>


            <!-- CODE -->

            <div class="detail-item">

                <span class="detail-label">

                    Code

                </span>


                <span class="detail-value">

                    <%= (

                        dairy?.code !== null &&

                        dairy?.code !== undefined &&

                        dairy?.code !== ""

                    )

                        ? dairy.code

                        : "—"

                    %>

                </span>

            </div>


            <!-- ASSET CODE -->

            <div class="detail-item">

                <span class="detail-label">

                    Asset Code

                </span>


                <span class="detail-value">

                    <%= (

                        dairy?.assetCode !== null &&

                        dairy?.assetCode !== undefined &&

                        dairy?.assetCode !== ""

                    )

                        ? dairy.assetCode

                        : "—"

                    %>

                </span>

            </div>


            <!-- TYPE -->

            <div class="detail-item">

                <span class="detail-label">

                    Type

                </span>


                <span class="detail-value">

                    <%= dairy?.type || "—" %>

                </span>

            </div>


            <!-- STATUS -->

            <div class="detail-item">

                <span class="detail-label">

                    Status

                </span>


                <span class="detail-value">

                    <%= dairy?.status || "—" %>

                </span>

            </div>


            <!-- BUYING PRICE -->

            <div class="detail-item">

                <span class="detail-label">

                    Buying Price

                </span>


                <span class="detail-value">

                    KSh

                    <%= Number(
                        dairy?.buyingPrice || 0
                    ).toLocaleString("en-KE") %>

                </span>

            </div>


            <!-- SELLING PRICE -->

            <div class="detail-item">

                <span class="detail-label">

                    Selling Price

                </span>


                <span class="detail-value">

                    <%= (

                        dairy?.sellingPrice !== null &&

                        dairy?.sellingPrice !== undefined

                    )

                        ? `KSh ${Number(
                            dairy.sellingPrice
                        ).toLocaleString("en-KE")}`

                        : "—"

                    %>

                </span>

            </div>


        </div>

    </section>


    <!-- ==================================================
         LIABILITY HISTORY
    ================================================== -->

    <section class="liability-card">


        <div class="liability-header">

            <h2 class="liability-header-title">

                Liability History

            </h2>


            <span class="liability-count">

                <%= Array.isArray(liabilities)
                    ? liabilities.length
                    : 0
                %>

                record<%= (

                    Array.isArray(liabilities) &&

                    liabilities.length === 1

                )

                    ? ""

                    : "s"

                %>

            </span>

        </div>


        <% if (

            Array.isArray(liabilities) &&

            liabilities.length

        ) { %>


            <div class="liability-list">


                <% liabilities.forEach(
                    liability => {
                %>


                    <article class="liability-row">


                        <div>


                            <div class="liability-description">

                                <%= liability?.description ||
                                    "Liability"
                                %>

                            </div>


                            <div class="liability-date">

                                <%= liability?.createdAt

                                    ? new Date(
                                        liability.createdAt
                                    ).toLocaleDateString(
                                        "en-KE",
                                        {
                                            year: "numeric",
                                            month: "short",
                                            day: "numeric"
                                        }
                                    )

                                    : "Date unavailable"

                                %>

                            </div>


                            <% if (
                                liability?.recordedBy
                            ) { %>


                                <div class="liability-recorded">

                                    Recorded by:

                                    <%= liability.recordedBy.name ||

                                        liability.recordedBy.email ||

                                        "Unknown"

                                    %>

                                </div>


                            <% } %>


                        </div>


                        <div class="liability-amount">

                            KSh

                            <%= Number(
                                liability?.amount || 0
                            ).toLocaleString("en-KE") %>

                        </div>


                    </article>


                <% }) %>


            </div>


        <% } else { %>


            <div class="empty-state">

                <div class="empty-state-icon">

                    <i class="bi bi-receipt"></i>

                </div>


                <div class="empty-state-title">

                    No liabilities found

                </div>


                <div class="empty-state-text">

                    There are no liability records for the
                    selected financial period.

                </div>

            </div>


        <% } %>


    </section>


</div>