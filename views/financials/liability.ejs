<% /* ==========================================================
   views/financials/liability.ejs

   FINANCIAL / LIABILITY ENTRY PAGE

   CONTROLLER DATA

   farms:
       Array returned from:
       financialsService.getFinancialStructure()

       Each farm contains:
           farm fields
           assets[]

   standaloneAssets:
       Array of standalone Dairy records.

   user:
       Currently authenticated user.

   success:
       Boolean.

   error:
       Error message or null.

   FORM CONTRACT

   POST /financials/liability

   Body:

       dairyId
       amount
       description

   IMPORTANT:
   Controller expects:

       req.body.dairyId

   ========================================================== */


/* ==========================================================
   SAFE DATA
   ========================================================== */

const safeFarms =
    Array.isArray(farms)
        ? farms
        : [];


const safeStandaloneAssets =
    Array.isArray(standaloneAssets)
        ? standaloneAssets
        : [];

%>


<div class="financial-page liability-entry-page">


    <!-- ======================================================
         HEADER
         ====================================================== -->

    <div class="financial-page-header">

        <div>

            <span class="financial-eyebrow">

                FINANCIALS

            </span>

            <h1 class="financial-title">

                Record Liability

            </h1>

            <p class="financial-subtitle">

                Record a liability against a dairy farm,
                farm asset, or standalone asset.

            </p>

        </div>


        <div class="financial-header-actions">

            <a
                href="/financials/history"
                class="financial-button financial-button-secondary"
            >

                <i class="bi bi-clock-history"></i>

                History

            </a>


            <a
                href="/financials/summary"
                class="financial-button financial-button-secondary"
            >

                <i class="bi bi-bar-chart-line"></i>

                Summary

            </a>

        </div>

    </div>


    <!-- ======================================================
         SUCCESS
         ====================================================== -->

    <% if (
        typeof success !== "undefined" &&
        success
    ) { %>

        <div
            class="financial-alert financial-alert-success"
            role="alert"
        >

            <div class="financial-alert-icon">

                <i class="bi bi-check-circle-fill"></i>

            </div>

            <div>

                <strong>

                    Liability recorded successfully.

                </strong>

                <span>

                    The financial record has been saved.

                </span>

            </div>

        </div>

    <% } %>


    <!-- ======================================================
         ERROR
         ====================================================== -->

    <% if (
        typeof error !== "undefined" &&
        error
    ) { %>

        <div
            class="financial-alert financial-alert-error"
            role="alert"
        >

            <div class="financial-alert-icon">

                <i class="bi bi-exclamation-circle-fill"></i>

            </div>

            <div>

                <strong>

                    Unable to record liability.

                </strong>

                <span>

                    <%= error %>

                </span>

            </div>

        </div>

    <% } %>


    <!-- ======================================================
         FORM CARD
         ====================================================== -->

    <div class="financial-card liability-form-card">


        <!-- ==================================================
             CARD HEADER
             ================================================== -->

        <div class="financial-card-header">

            <div>

                <h2>

                    Liability Details

                </h2>

                <p>

                    Select the farm, farm asset, or standalone
                    asset receiving the liability.

                </p>

            </div>


            <i class="bi bi-receipt"></i>

        </div>


        <!-- ==================================================
             FORM

             IMPORTANT:
             name="dairyId"

             The controller reads:

                 req.body.dairyId

             ================================================== -->

        <form
            action="/financials/liability"
            method="POST"
            class="financial-form"
            id="liabilityForm"
        >


            <!-- ==============================================
                 DAIRY / ASSET
                 ============================================== -->

            <div class="financial-form-group">

                <label
                    for="dairyId"
                    class="financial-label"
                >

                    Dairy / Asset

                </label>


                <select
                    id="dairyId"
                    name="dairyId"
                    class="financial-select"
                    required
                >

                    <option value="">

                        Select a dairy or asset

                    </option>


                    <!-- ======================================
                         DAIRY FARMS
                         ====================================== -->

                    <% if (
                        safeFarms.length
                    ) { %>

                        <optgroup label="Dairy Farms">


                            <% safeFarms.forEach(
                                function(farm)
                            { %>


                                <!-- ==========================
                                     FARM ITSELF
                                     ========================== -->

                                <option
                                    value="<%= farm?._id || '' %>"
                                    data-kind="farm"
                                    data-name="<%= farm?.name || 'Dairy Farm' %>"
                                    data-type="<%= farm?.type || 'Dairy Farm' %>"
                                >

                                    <%= farm?.name ||
                                        "Unnamed Farm"
                                    %>

                                    — Dairy Farm

                                </option>


                                <!-- ==========================
                                     FARM ASSETS
                                     ========================== -->

                                <% if (
                                    Array.isArray(
                                        farm?.assets
                                    ) &&
                                    farm.assets.length
                                ) { %>


                                    <% farm.assets.forEach(
                                        function(asset)
                                    { %>


                                        <option
                                            value="<%= asset?._id || '' %>"
                                            data-kind="asset"
                                            data-name="<%= asset?.name || 'Asset' %>"
                                            data-type="<%= asset?.type || 'Farm Asset' %>"
                                        >

                                            ↳

                                            <%= asset?.name ||
                                                "Unnamed Asset"
                                            %>


                                            <% if (
                                                asset?.type
                                            ) { %>

                                                —
                                                <%= asset.type %>

                                            <% } %>

                                        </option>


                                    <% }); %>


                                <% } %>


                            <% }); %>


                        </optgroup>

                    <% } %>


                    <!-- ======================================
                         STANDALONE ASSETS
                         ====================================== -->

                    <% if (
                        safeStandaloneAssets.length
                    ) { %>


                        <optgroup label="Standalone Assets">


                            <% safeStandaloneAssets.forEach(
                                function(asset)
                            { %>


                                <option
                                    value="<%= asset?._id || '' %>"
                                    data-kind="standalone"
                                    data-name="<%= asset?.name || 'Asset' %>"
                                    data-type="<%= asset?.type || 'Standalone Asset' %>"
                                >

                                    <%= asset?.name ||
                                        "Unnamed Asset"
                                    %>


                                    <% if (
                                        asset?.type
                                    ) { %>

                                        —
                                        <%= asset.type %>

                                    <% } %>

                                </option>


                            <% }); %>


                        </optgroup>


                    <% } %>


                </select>


                <small class="financial-help-text">

                    A liability may belong to the farm itself,
                    an asset assigned to a farm, or a standalone
                    asset.

                </small>

            </div>


            <!-- ==================================================
                 SELECTED RECORD
                 ================================================== -->

            <div
                class="financial-selected-record"
                id="selectedDairyInformation"
                hidden
            >

                <div class="financial-selected-icon">

                    <i class="bi bi-diagram-3"></i>

                </div>


                <div>

                    <span class="financial-selected-label">

                        Selected

                    </span>


                    <strong
                        id="selectedDairyName"
                        class="financial-selected-name"
                    ></strong>


                    <span
                        id="selectedDairyType"
                        class="financial-selected-type"
                    ></span>

                </div>

            </div>


            <!-- ==================================================
                 AMOUNT
                 ================================================== -->

            <div class="financial-form-group">

                <label
                    for="amount"
                    class="financial-label"
                >

                    Liability Amount

                </label>


                <div class="financial-money-input">

                    <span>

                        KSh

                    </span>


                    <input
                        type="number"
                        id="amount"
                        name="amount"
                        min="0.01"
                        step="0.01"
                        inputmode="decimal"
                        placeholder="0.00"
                        required
                    >

                </div>

            </div>


            <!-- ==================================================
                 DESCRIPTION
                 ================================================== -->

            <div class="financial-form-group">

                <label
                    for="description"
                    class="financial-label"
                >

                    Description

                </label>


                <textarea
                    id="description"
                    name="description"
                    class="financial-textarea"
                    rows="5"
                    maxlength="1000"
                    placeholder="Describe the liability..."
                    required
                ></textarea>


                <div class="financial-character-count">

                    <span id="descriptionCount">

                        0

                    </span>

                    / 1000

                </div>

            </div>


            <!-- ==================================================
                 RECORDER
                 ================================================== -->

            <div class="financial-recorder">

                <div class="financial-recorder-icon">

                    <i class="bi bi-person-check"></i>

                </div>


                <div>

                    <span>

                        Recorded by

                    </span>


                    <strong>

                        <%= user?.name ||
                            "Current user"
                        %>

                    </strong>

                </div>

            </div>


            <!-- ==================================================
                 ACTIONS
                 ================================================== -->

            <div class="financial-form-actions">


                <a
                    href="/financials/history"
                    class="financial-button financial-button-secondary"
                >

                    <i class="bi bi-clock-history"></i>

                    View History

                </a>


                <button
                    type="submit"
                    class="financial-button financial-button-primary"
                    id="submitLiabilityButton"
                >

                    <i class="bi bi-check2-circle"></i>

                    Record Liability

                </button>


            </div>


        </form>


    </div>


</div>


<style>

/* ==========================================================
   PAGE
   ========================================================== */

.liability-entry-page{

    --financial-green:#2f7d4a;
    --financial-green-dark:#236238;
    --financial-green-light:#eaf6ee;
    --financial-green-soft:#f4faf6;

    --financial-red:#c0392b;
    --financial-red-light:#fceceb;

    --financial-text:#243329;
    --financial-muted:#718078;

    max-width:1100px;

    margin:0 auto;

    padding:24px;

}


/* ==========================================================
   HEADER
   ========================================================== */

.liability-entry-page
.financial-page-header{

    display:flex;

    align-items:center;

    justify-content:space-between;

    gap:20px;

    margin-bottom:24px;

}


.liability-entry-page
.financial-eyebrow{

    display:block;

    margin-bottom:5px;

    color:var(--financial-green);

    font-size:.72rem;

    font-weight:800;

    letter-spacing:.12em;

}


.liability-entry-page
.financial-title{

    margin:0;

    color:var(--financial-text);

    font-size:clamp(1.5rem,4vw,2.2rem);

}


.liability-entry-page
.financial-subtitle{

    margin:6px 0 0;

    color:var(--financial-muted);

    font-size:.85rem;

}


.liability-entry-page
.financial-header-actions{

    display:flex;

    align-items:center;

    gap:9px;

}


/* ==========================================================
   BUTTONS
   ========================================================== */

.liability-entry-page
.financial-button{

    display:inline-flex;

    align-items:center;

    justify-content:center;

    gap:8px;

    padding:11px 16px;

    border:0;

    border-radius:10px;

    font:inherit;

    font-weight:600;

    text-decoration:none;

    cursor:pointer;

    transition:.2s ease;

}


.liability-entry-page
.financial-button-primary{

    background:var(--financial-green);

    color:#fff;

}


.liability-entry-page
.financial-button-primary:hover{

    background:var(--financial-green-dark);

}


.liability-entry-page
.financial-button-primary:disabled{

    opacity:.65;

    cursor:not-allowed;

}


.liability-entry-page
.financial-button-secondary{

    background:var(--financial-green-light);

    color:var(--financial-green-dark);

}


.liability-entry-page
.financial-button-secondary:hover{

    background:#dcefe3;

}


/* ==========================================================
   ALERTS
   ========================================================== */

.liability-entry-page
.financial-alert{

    display:flex;

    align-items:center;

    gap:12px;

    padding:14px 16px;

    margin-bottom:20px;

    border-radius:12px;

}


.liability-entry-page
.financial-alert-success{

    background:var(--financial-green-light);

    color:var(--financial-green-dark);

}


.liability-entry-page
.financial-alert-error{

    background:var(--financial-red-light);

    color:var(--financial-red);

}


.liability-entry-page
.financial-alert-icon{

    flex:0 0 auto;

    font-size:1.2rem;

}


.liability-entry-page
.financial-alert span{

    display:block;

    margin-top:2px;

    font-size:.8rem;

}


/* ==========================================================
   CARD
   ========================================================== */

.liability-entry-page
.financial-card{

    padding:24px;

    background:#fff;

    border-radius:18px;

    box-shadow:
        0 4px 20px
        rgba(0,0,0,.07);

}


.liability-entry-page
.financial-card-header{

    display:flex;

    justify-content:space-between;

    gap:15px;

    margin-bottom:24px;

}


.liability-entry-page
.financial-card-header h2{

    margin:0;

    color:var(--financial-text);

    font-size:1.2rem;

}


.liability-entry-page
.financial-card-header p{

    margin:5px 0 0;

    color:var(--financial-muted);

    font-size:.85rem;

}


.liability-entry-page
.financial-card-header > i{

    color:var(--financial-green);

    font-size:1.3rem;

}


/* ==========================================================
   FORM
   ========================================================== */

.liability-entry-page
.financial-form{

    display:flex;

    flex-direction:column;

    gap:20px;

}


.liability-entry-page
.financial-form-group{

    position:relative;

}


.liability-entry-page
.financial-label{

    display:block;

    margin-bottom:8px;

    color:var(--financial-text);

    font-size:.88rem;

    font-weight:600;

}


/* ==========================================================
   INPUTS
   ========================================================== */

.liability-entry-page
.financial-select,
.liability-entry-page
.financial-textarea,
.liability-entry-page
.financial-money-input input{

    width:100%;

    box-sizing:border-box;

    border:1px solid #dce5df;

    border-radius:11px;

    background:#fff;

    color:var(--financial-text);

    font:inherit;

    outline:none;

    transition:.2s ease;

}


.liability-entry-page
.financial-select{

    padding:13px 14px;

    cursor:pointer;

}


.liability-entry-page
.financial-textarea{

    min-height:120px;

    padding:13px 14px;

    resize:vertical;

}


.liability-entry-page
.financial-select:focus,
.liability-entry-page
.financial-textarea:focus,
.liability-entry-page
.financial-money-input:focus-within{

    border-color:var(--financial-green);

    box-shadow:
        0 0 0 3px
        rgba(47,125,74,.1);

}


/* ==========================================================
   MONEY
   ========================================================== */

.liability-entry-page
.financial-money-input{

    display:flex;

    align-items:center;

    overflow:hidden;

    border:1px solid #dce5df;

    border-radius:11px;

    background:#fff;

    transition:.2s ease;

}


.liability-entry-page
.financial-money-input span{

    padding:13px 14px;

    background:var(--financial-green-soft);

    color:var(--financial-green);

    font-weight:700;

}


.liability-entry-page
.financial-money-input input{

    border:0;

    border-radius:0;

}


.liability-entry-page
.financial-money-input input:focus{

    border-color:transparent;

    box-shadow:none;

}


/* ==========================================================
   HELP
   ========================================================== */

.liability-entry-page
.financial-help-text{

    display:block;

    margin-top:7px;

    color:var(--financial-muted);

    font-size:.75rem;

}


/* ==========================================================
   SELECTED RECORD
   ========================================================== */

.liability-entry-page
.financial-selected-record{

    display:flex;

    align-items:center;

    gap:12px;

    padding:13px;

    border:1px solid #dceee2;

    border-radius:12px;

    background:var(--financial-green-soft);

}


.liability-entry-page
.financial-selected-icon{

    width:38px;

    height:38px;

    display:flex;

    align-items:center;

    justify-content:center;

    flex:0 0 38px;

    border-radius:10px;

    background:var(--financial-green-light);

    color:var(--financial-green);

}


.liability-entry-page
.financial-selected-label,
.liability-entry-page
.financial-selected-type{

    display:block;

    color:var(--financial-muted);

    font-size:.72rem;

}


.liability-entry-page
.financial-selected-name{

    display:block;

    margin:2px 0;

    color:var(--financial-text);

}


/* ==========================================================
   RECORDER
   ========================================================== */

.liability-entry-page
.financial-recorder{

    display:flex;

    align-items:center;

    gap:12px;

    padding:13px;

    border-radius:12px;

    background:#f8faf9;

}


.liability-entry-page
.financial-recorder-icon{

    width:38px;

    height:38px;

    display:flex;

    align-items:center;

    justify-content:center;

    flex:0 0 38px;

    border-radius:50%;

    background:var(--financial-green-light);

    color:var(--financial-green);

}


.liability-entry-page
.financial-recorder span,
.liability-entry-page
.financial-recorder strong{

    display:block;

}


.liability-entry-page
.financial-recorder span{

    color:var(--financial-muted);

    font-size:.72rem;

}


.liability-entry-page
.financial-recorder strong{

    color:var(--financial-text);

}


/* ==========================================================
   CHARACTER COUNT
   ========================================================== */

.liability-entry-page
.financial-character-count{

    margin-top:4px;

    color:var(--financial-muted);

    font-size:.72rem;

    text-align:right;

}


/* ==========================================================
   ACTIONS
   ========================================================== */

.liability-entry-page
.financial-form-actions{

    display:flex;

    justify-content:flex-end;

    gap:10px;

    padding-top:4px;

}


/* ==========================================================
   MOBILE
   ========================================================== */

@media(max-width:650px){

    .liability-entry-page{

        padding:16px;

    }


    .liability-entry-page
    .financial-page-header{

        align-items:flex-start;

        flex-direction:column;

    }


    .liability-entry-page
    .financial-header-actions{

        width:100%;

    }


    .liability-entry-page
    .financial-header-actions
    .financial-button{

        flex:1;

    }


    .liability-entry-page
    .financial-card{

        padding:18px;

    }


    .liability-entry-page
    .financial-form-actions{

        flex-direction:column-reverse;

    }


    .liability-entry-page
    .financial-form-actions
    .financial-button{

        width:100%;

    }

}

</style>


<script>

/* ==========================================================
   LIABILITY PAGE JAVASCRIPT
   ========================================================== */

document.addEventListener(
    "DOMContentLoaded",
    function() {


        /* ==================================================
           ELEMENTS
           ================================================== */

        const dairySelect =
            document.getElementById(
                "dairyId"
            );


        const selectedInformation =
            document.getElementById(
                "selectedDairyInformation"
            );


        const selectedName =
            document.getElementById(
                "selectedDairyName"
            );


        const selectedType =
            document.getElementById(
                "selectedDairyType"
            );


        const description =
            document.getElementById(
                "description"
            );


        const descriptionCount =
            document.getElementById(
                "descriptionCount"
            );


        const form =
            document.getElementById(
                "liabilityForm"
            );


        const submitButton =
            document.getElementById(
                "submitLiabilityButton"
            );


        /* ==================================================
           SELECTED RECORD
           ================================================== */

        function updateSelectedDairy() {

            if (!dairySelect) {

                return;

            }


            const option =
                dairySelect.options[
                    dairySelect.selectedIndex
                ];


            if (
                !option ||
                !option.value
            ) {

                if (selectedInformation) {

                    selectedInformation.hidden =
                        true;

                }

                if (selectedName) {

                    selectedName.textContent =
                        "";

                }

                if (selectedType) {

                    selectedType.textContent =
                        "";

                }

                return;

            }


            if (selectedInformation) {

                selectedInformation.hidden =
                    false;

            }


            if (selectedName) {

                selectedName.textContent =
                    option.dataset.name ||
                    option.textContent.trim();

            }


            const kind =
                option.dataset.kind;


            let type =
                option.dataset.type ||
                "";


            if (
                kind === "farm"
            ) {

                type =
                    type ||
                    "Dairy Farm";

            }

            else if (
                kind === "standalone"
            ) {

                type =
                    type ||
                    "Standalone Asset";

            }

            else {

                type =
                    type ||
                    "Farm Asset";

            }


            if (selectedType) {

                selectedType.textContent =
                    type;

            }

        }


        if (dairySelect) {

            dairySelect.addEventListener(
                "change",
                updateSelectedDairy
            );

        }


        /* ==================================================
           DESCRIPTION COUNTER
           ================================================== */

        function updateDescriptionCount() {

            if (
                !description ||
                !descriptionCount
            ) {

                return;

            }


            descriptionCount.textContent =
                description.value.length;

        }


        if (description) {

            description.addEventListener(
                "input",
                updateDescriptionCount
            );

        }


        updateDescriptionCount();


        /* ==================================================
           SUBMIT STATE
           ================================================== */

        if (
            form &&
            submitButton
        ) {

            form.addEventListener(
                "submit",
                function() {

                    submitButton.disabled =
                        true;

                    submitButton.innerHTML =
                        '<i class="bi bi-hourglass-split"></i>' +
                        ' Recording...';

                }
            );

        }

    }
);

</script>