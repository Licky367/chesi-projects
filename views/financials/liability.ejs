<% /*

views/financials/liability.ejs

FINANCIAL / LIABILITY ENTRY PAGE

EXPECTED BACKEND DATA

farms:
Array of farm records.

  Each farm contains:
      .assets

  containing assets belonging to that farm.

standaloneAssets:
Array of standalone assets.

user:
Currently authenticated user.

success:
Optional success message.

error:
Optional error message.

==========================================================
*/ %>

<!-- ==========================================================
     PAGE
========================================================== --><div class="financial-page liability-entry-page"><!-- ======================================================
     PAGE HEADER
====================================================== -->

<header class="financial-page-header">

    <div>

        <span class="financial-eyebrow">
            FINANCIALS
        </span>

        <h1 class="financial-title">
            Record Liability
        </h1>

        <p class="financial-subtitle">
            Record a liability against a dairy farm,
            animal, or asset.
        </p>

    </div>


    <div class="financial-header-icon">

        <i class="bi bi-wallet2"></i>

    </div>

</header>


<!-- ======================================================
     SUCCESS MESSAGE
====================================================== -->

<% if (typeof success !== "undefined" && success) { %>

    <div
        class="financial-alert financial-alert-success"
        role="alert"
    >

        <div class="financial-alert-icon">

            <i class="bi bi-check-circle-fill"></i>

        </div>

        <div>

            <strong>
                Liability recorded successfully.
            </strong>

            <span>
                The financial record has been saved.
            </span>

        </div>

    </div>

<% } %>


<!-- ======================================================
     ERROR MESSAGE
====================================================== -->

<% if (typeof error !== "undefined" && error) { %>

    <div
        class="financial-alert financial-alert-error"
        role="alert"
    >

        <div class="financial-alert-icon">

            <i class="bi bi-exclamation-circle-fill"></i>

        </div>

        <div>

            <strong>
                Unable to record liability.
            </strong>

            <span>
                <%= error %>
            </span>

        </div>

    </div>

<% } %>


<!-- ======================================================
     FORM CARD
====================================================== -->

<section class="financial-card liability-form-card">


    <!-- ==================================================
         CARD HEADER
    ================================================== -->

    <div class="financial-card-header">

        <div>

            <h2>
                Liability Details
            </h2>

            <p>
                Select the dairy or asset receiving
                the liability.
            </p>

        </div>

        <i class="bi bi-receipt"></i>

    </div>


    <!-- ==================================================
         FORM

         ROUTE:
             POST /financials/liability
    ================================================== -->

    <form
        action="/financials/liability"
        method="POST"
        class="financial-form"
        id="liabilityForm"
    >


        <!-- ==============================================
             DAIRY / ASSET SELECTOR
        =============================================== -->

        <div class="financial-form-group">

            <label
                for="dairy"
                class="financial-label"
            >
                Dairy / Asset
            </label>


            <select
                id="dairy"
                name="dairy"
                class="financial-select"
                required
            >

                <option value="">
                    Select a dairy or asset
                </option>


                <!-- ======================================
                     FARMS
                ======================================= -->

                <% if (
                    Array.isArray(farms) &&
                    farms.length
                ) { %>

                    <optgroup label="Dairy Farms">


                        <% farms.forEach(function(farm) { %>

                            <!-- ==================================
                                 FARM ITSELF
                            =================================== -->

                            <option
                                value="<%= farm._id %>"
                                data-code="<%= farm.code ?? '' %>"
                                data-parent=""
                                data-kind="farm"
                            >

                                <%= farm.name || "Unnamed Farm" %>
                                — Dairy Farm

                            </option>


                            <!-- ==================================
                                 FARM ASSETS

                                 Service supplies .assets
                            =================================== -->

                            <% if (
                                Array.isArray(farm.assets) &&
                                farm.assets.length
                            ) { %>


                                <% farm.assets.forEach(
                                    function(asset)
                                { %>

                                    <option
                                        value="<%= asset._id %>"
                                        data-code="<%= asset.code ?? '' %>"
                                        data-asset-code="<%= asset.assetCode ?? '' %>"
                                        data-parent="<%= farm._id %>"
                                        data-kind="asset"
                                    >

                                        ↳
                                        <%= asset.name || "Unnamed Asset" %>

                                        <% if (asset.type) { %>

                                            —
                                            <%= asset.type %>

                                        <% } %>

                                    </option>

                                <% }); %>


                            <% } %>


                        <% }); %>


                    </optgroup>

                <% } %>


                <!-- ======================================
                     STANDALONE ASSETS
                ======================================= -->

                <% if (
                    Array.isArray(standaloneAssets) &&
                    standaloneAssets.length
                ) { %>

                    <optgroup label="Standalone Assets">


                        <% standaloneAssets.forEach(
                            function(asset)
                        { %>

                            <option
                                value="<%= asset._id %>"
                                data-code="<%= asset.code ?? '' %>"
                                data-asset-code="<%= asset.assetCode ?? '' %>"
                                data-parent=""
                                data-kind="standalone"
                            >

                                <%= asset.name || "Unnamed Asset" %>

                                <% if (asset.type) { %>

                                    —
                                    <%= asset.type %>

                                <% } %>

                            </option>

                        <% }); %>


                    </optgroup>

                <% } %>


            </select>


            <small class="financial-help-text">

                A liability may be recorded against
                a farm, farm asset, or standalone asset.

            </small>

        </div>


        <!-- ==================================================
             SELECTED RECORD
        ================================================== -->

        <div
            class="financial-selected-record"
            id="selectedDairyInformation"
            hidden
        >

            <div class="financial-selected-icon">

                <i class="bi bi-diagram-3"></i>

            </div>


            <div>

                <span class="financial-selected-label">
                    Selected
                </span>


                <strong
                    id="selectedDairyName"
                    class="financial-selected-name"
                >
                </strong>


                <span
                    id="selectedDairyType"
                    class="financial-selected-type"
                >
                </span>

            </div>

        </div>


        <!-- ==================================================
             LIABILITY AMOUNT
        ================================================== -->

        <div class="financial-form-group">

            <label
                for="amount"
                class="financial-label"
            >
                Liability Amount
            </label>


            <div class="financial-money-input">

                <span>
                    KSh
                </span>


                <input
                    type="number"
                    id="amount"
                    name="amount"
                    min="0.01"
                    step="0.01"
                    inputmode="decimal"
                    placeholder="0.00"
                    required
                >

            </div>

        </div>


        <!-- ==================================================
             DESCRIPTION
        ================================================== -->

        <div class="financial-form-group">

            <label
                for="description"
                class="financial-label"
            >
                Description
            </label>


            <textarea
                id="description"
                name="description"
                class="financial-textarea"
                rows="5"
                maxlength="1000"
                placeholder="Describe the liability..."
                required
            ></textarea>


            <div class="financial-character-count">

                <span id="descriptionCount">
                    0
                </span>

                / 1000

            </div>

        </div>


        <!-- ==================================================
             RECORDED BY
        ================================================== -->

        <div class="financial-recorder">

            <div class="financial-recorder-icon">

                <i class="bi bi-person-check"></i>

            </div>


            <div>

                <span>
                    Recorded by
                </span>


                <strong>
                    <%= user?.name || "Current user" %>
                </strong>

            </div>

        </div>


        <!-- ==================================================
             ACTIONS
        ================================================== -->

        <div class="financial-form-actions">


            <!-- ==========================================
                 LIABILITY HISTORY

                 ROUTE:
                     GET /financials/history
            =========================================== -->

            <a
                href="/financials/history"
                class="financial-button financial-button-secondary"
            >

                <i class="bi bi-clock-history"></i>

                View History

            </a>


            <!-- ==========================================
                 SUBMIT

                 ROUTE:
                     POST /financials/liability
            =========================================== -->

            <button
                type="submit"
                class="financial-button financial-button-primary"
                id="submitLiabilityButton"
            >

                <i class="bi bi-check2-circle"></i>

                Record Liability

            </button>


        </div>


    </form>


</section>

</div><!-- ==========================================================
     PAGE CSS
========================================================== --><style>

    .financial-page {

        --financial-green:
            #2f7d4a;

        --financial-green-dark:
            #236238;

        --financial-green-light:
            #eaf6ee;

        --financial-green-soft:
            #f4faf6;

        --financial-red:
            #c0392b;

        --financial-red-light:
            #fceceb;

        --financial-text:
            #243329;

        --financial-muted:
            #718078;


        max-width:
            1100px;

        margin:
            0 auto;

        padding:
            24px;

    }


    /* ======================================================
       HEADER
    ====================================================== */

    .financial-page-header {

        display:
            flex;

        align-items:
            center;

        justify-content:
            space-between;

        gap:
            20px;

        margin-bottom:
            24px;

    }


    .financial-eyebrow {

        display:
            block;

        margin-bottom:
            5px;

        color:
            var(--financial-green);

        font-size:
            .75rem;

        font-weight:
            700;

        letter-spacing:
            .12em;

    }


    .financial-title {

        margin:
            0;

        color:
            var(--financial-text);

        font-size:
            clamp(1.6rem, 4vw, 2.2rem);

        line-height:
            1.2;

    }


    .financial-subtitle {

        margin:
            7px 0 0;

        color:
            var(--financial-muted);

        line-height:
            1.5;

    }


    .financial-header-icon {

        width:
            52px;

        height:
            52px;

        display:
            flex;

        align-items:
            center;

        justify-content:
            center;

        flex-shrink:
            0;

        border-radius:
            14px;

        background:
            var(--financial-green-light);

        color:
            var(--financial-green);

        font-size:
            1.4rem;

    }


    /* ======================================================
       ALERTS
    ====================================================== */

    .financial-alert {

        display:
            flex;

        align-items:
            center;

        gap:
            12px;

        padding:
            14px 16px;

        margin-bottom:
            20px;

        border-radius:
            12px;

    }


    .financial-alert-success {

        background:
            var(--financial-green-light);

        color:
            var(--financial-green-dark);

    }


    .financial-alert-error {

        background:
            var(--financial-red-light);

        color:
            var(--financial-red);

    }


    .financial-alert-icon {

        flex-shrink:
            0;

        font-size:
            1.2rem;

    }


    .financial-alert strong {

        display:
            block;

    }


    .financial-alert span {

        display:
            block;

        margin-top:
            2px;

        font-size:
            .85rem;

    }


    /* ======================================================
       CARD
    ====================================================== */

    .financial-card {

        background:
            #fff;

        border-radius:
            18px;

        padding:
            24px;

        box-shadow:
            0 4px 20px rgba(0, 0, 0, .07);

    }


    .financial-card-header {

        display:
            flex;

        align-items:
            flex-start;

        justify-content:
            space-between;

        gap:
            15px;

        margin-bottom:
            24px;

    }


    .financial-card-header h2 {

        margin:
            0;

        color:
            var(--financial-text);

        font-size:
            1.2rem;

    }


    .financial-card-header p {

        margin:
            5px 0 0;

        color:
            var(--financial-muted);

        font-size:
            .9rem;

        line-height:
            1.5;

    }


    .financial-card-header > i {

        flex-shrink:
            0;

        color:
            var(--financial-green);

        font-size:
            1.3rem;

    }


    /* ======================================================
       FORM
    ====================================================== */

    .financial-form {

        display:
            flex;

        flex-direction:
            column;

        gap:
            20px;

    }


    .financial-form-group {

        position:
            relative;

    }


    .financial-label {

        display:
            block;

        margin-bottom:
            8px;

        color:
            var(--financial-text);

        font-size:
            .9rem;

        font-weight:
            600;

    }


    .financial-select,
    .financial-textarea,
    .financial-money-input input {

        width:
            100%;

        box-sizing:
            border-box;

        border:
            1px solid #dce5df;

        border-radius:
            11px;

        background:
            #fff;

        color:
            var(--financial-text);

        font:
            inherit;

        outline:
            none;

        transition:
            .2s ease;

    }


    .financial-select {

        padding:
            13px 14px;

    }


    .financial-textarea {

        min-height:
            120px;

        padding:
            13px 14px;

        resize:
            vertical;

    }


    .financial-select:focus,
    .financial-textarea:focus,
    .financial-money-input:focus-within {

        border-color:
            var(--financial-green);

        box-shadow:
            0 0 0 3px rgba(47, 125, 74, .1);

    }


    /* ======================================================
       MONEY INPUT
    ====================================================== */

    .financial-money-input {

        display:
            flex;

        align-items:
            stretch;

        overflow:
            hidden;

        border:
            1px solid #dce5df;

        border-radius:
            11px;

        transition:
            .2s ease;

    }


    .financial-money-input span {

        display:
            flex;

        align-items:
            center;

        padding:
            13px 14px;

        background:
            var(--financial-green-soft);

        color:
            var(--financial-green);

        font-weight:
            700;

    }


    .financial-money-input input {

        min-width:
            0;

        border:
            0;

        border-radius:
            0;

        box-shadow:
            none;

    }


    .financial-money-input input:focus {

        border:
            0;

        box-shadow:
            none;

    }


    /* ======================================================
       HELP TEXT
    ====================================================== */

    .financial-help-text {

        display:
            block;

        margin-top:
            7px;

        color:
            var(--financial-muted);

        font-size:
            .8rem;

        line-height:
            1.4;

    }


    /* ======================================================
       SELECTED RECORD
    ====================================================== */

    .financial-selected-record {

        display:
            flex;

        align-items:
            center;

        gap:
            12px;

        padding:
            13px;

        border:
            1px solid #dceee2;

        border-radius:
            12px;

        background:
            var(--financial-green-soft);

    }


    .financial-selected-icon {

        width:
            38px;

        height:
            38px;

        display:
            flex;

        align-items:
            center;

        justify-content:
            center;

        flex-shrink:
            0;

        border-radius:
            10px;

        background:
            var(--financial-green-light);

        color:
            var(--financial-green);

    }


    .financial-selected-label,
    .financial-selected-type {

        display:
            block;

        color:
            var(--financial-muted);

        font-size:
            .75rem;

    }


    .financial-selected-name {

        display:
            block;

        margin:
            2px 0;

        color:
            var(--financial-text);

    }


    /* ======================================================
       RECORDER
    ====================================================== */

    .financial-recorder {

        display:
            flex;

        align-items:
            center;

        gap:
            12px;

        padding:
            13px;

        border-radius:
            12px;

        background:
            #f8faf9;

    }


    .financial-recorder-icon {

        width:
            38px;

        height:
            38px;

        display:
            flex;

        align-items:
            center;

        justify-content:
            center;

        flex-shrink:
            0;

        border-radius:
            50%;

        background:
            var(--financial-green-light);

        color:
            var(--financial-green);

    }


    .financial-recorder span,
    .financial-recorder strong {

        display:
            block;

    }


    .financial-recorder span {

        color:
            var(--financial-muted);

        font-size:
            .75rem;

    }


    .financial-recorder strong {

        margin-top:
            2px;

        color:
            var(--financial-text);

    }


    /* ======================================================
       CHARACTER COUNT
    ====================================================== */

    .financial-character-count {

        margin-top:
            4px;

        color:
            var(--financial-muted);

        font-size:
            .75rem;

        text-align:
            right;

    }


    /* ======================================================
       ACTIONS
    ====================================================== */

    .financial-form-actions {

        display:
            flex;

        align-items:
            center;

        justify-content:
            flex-end;

        gap:
            10px;

        padding-top:
            4px;

    }


    .financial-button {

        display:
            inline-flex;

        align-items:
            center;

        justify-content:
            center;

        gap:
            8px;

        padding:
            12px 17px;

        border:
            0;

        border-radius:
            10px;

        font:
            inherit;

        font-weight:
            600;

        text-decoration:
            none;

        cursor:
            pointer;

        transition:
            .2s ease;

    }


    .financial-button-primary {

        background:
            var(--financial-green);

        color:
            #fff;

    }


    .financial-button-primary:hover {

        background:
            var(--financial-green-dark);

    }


    .financial-button-primary:disabled {

        opacity:
            .65;

        cursor:
            not-allowed;

    }


    .financial-button-secondary {

        background:
            var(--financial-green-light);

        color:
            var(--financial-green-dark);

    }


    .financial-button-secondary:hover {

        background:
            #dcefe3;

    }


    /* ======================================================
       RESPONSIVE
    ====================================================== */

    @media (max-width: 600px) {

        .financial-page {

            padding:
                16px;

        }


        .financial-card {

            padding:
                18px;

        }


        .financial-page-header {

            align-items:
                flex-start;

        }


        .financial-form-actions {

            flex-direction:
                column-reverse;

        }


        .financial-button {

            width:
                100%;

        }

    }

</style><!-- ==========================================================
     PAGE JAVASCRIPT
========================================================== --><script>

document.addEventListener(
    "DOMContentLoaded",
    function () {


        const dairySelect =
            document.getElementById(
                "dairy"
            );


        const selectedInformation =
            document.getElementById(
                "selectedDairyInformation"
            );


        const selectedName =
            document.getElementById(
                "selectedDairyName"
            );


        const selectedType =
            document.getElementById(
                "selectedDairyType"
            );


        const description =
            document.getElementById(
                "description"
            );


        const descriptionCount =
            document.getElementById(
                "descriptionCount"
            );


        const form =
            document.getElementById(
                "liabilityForm"
            );


        const submitButton =
            document.getElementById(
                "submitLiabilityButton"
            );


        /* ==================================================
           UPDATE SELECTED RECORD
        ================================================== */

        function updateSelectedDairy() {


            const option =
                dairySelect.options[
                    dairySelect.selectedIndex
                ];


            if (
                !option ||
                !option.value
            ) {

                selectedInformation.hidden =
                    true;

                selectedName.textContent =
                    "";

                selectedType.textContent =
                    "";

                return;

            }


            selectedInformation.hidden =
                false;


            selectedName.textContent =
                option.textContent
                    .replace(/\s+/g, " ")
                    .trim();


            const kind =
                option.dataset.kind;


            if (
                kind === "farm"
            ) {

                selectedType.textContent =
                    "Dairy Farm";

            }

            else if (
                kind === "standalone"
            ) {

                selectedType.textContent =
                    "Standalone Asset";

            }

            else {

                selectedType.textContent =
                    "Farm Asset";

            }

        }


        dairySelect.addEventListener(
            "change",
            updateSelectedDairy
        );


        /* ==================================================
           DESCRIPTION COUNTER
        ================================================== */

        function updateDescriptionCount() {

            descriptionCount.textContent =
                description.value.length;

        }


        description.addEventListener(
            "input",
            updateDescriptionCount
        );


        updateDescriptionCount();


        /* ==================================================
           SUBMIT STATE
        ================================================== */

        form.addEventListener(
            "submit",
            function () {

                submitButton.disabled =
                    true;

                submitButton.innerHTML =
                    '<i class="bi bi-hourglass-split"></i>' +
                    ' Recording...';

            }
        );


    }
);

</script>