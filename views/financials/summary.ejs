<% /* ==========================================================
FINANCIAL SUMMARY PAGE

EXPECTED BACKEND DATA

summary:

{
totals: {
currentWorth,
salesAmount,
revenue,
liabilities,
profit
},

   farms: [

       {
           farm: {
               _id,
               name,
               code
           },

           currentWorth,
           salesAmount,
           revenue,
           liabilities,
           profit,

           assets: []
       }

   ],

   standalone: {

       currentWorth,
       salesAmount,
       revenue,
       liabilities,
       profit,

       assets: []

   }

}

filters:

{
startDate,
endDate
}

FINANCIAL RULES

Current worth:
Always current.

Sales:
Selling price of assets.

Revenue:
Revenue generated by assets.

Liabilities:
Date-filtered when a date range is supplied.

Profit/Loss:

   selling price
   - buying price
   - liabilities
   + revenue

The backend/service is responsible for calculating
and sorting the rows.

========================================================== */ %>

<%
/* ==========================================================
MONEY FORMATTER
========================================================== */

function formatMoney(value) {

if (
    value === null ||
    value === undefined ||
    value === "" ||
    Number.isNaN(Number(value))
) {

    return "—";

}

return Number(value).toLocaleString(

    "en-KE",

    {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
    }

);

}

/* ==========================================================
PROFIT CLASS
========================================================== */

function profitClass(value) {

if (
    value !== null &&
    value !== undefined &&
    value !== "" &&
    Number(value) < 0
) {

    return "financial-negative";

}

return "financial-positive";

}

/* ==========================================================
PROFIT TEXT
========================================================== */

function profitText(value) {

if (
    value === null ||
    value === undefined ||
    value === ""
) {

    return "—";

}

return "KSh " + formatMoney(value);

}

/* ==========================================================
SAFE DATA
========================================================== */

const totals =
summary?.totals || {};

const farms =
Array.isArray(summary?.farms)

    ? summary.farms

    : [];

const standalone =
summary?.standalone || {};

/* ==========================================================
FILTER STATE
========================================================== */

const startDate =
filters?.startDate || "";

const endDate =
filters?.endDate || "";

const hasDateFilter =
Boolean(
startDate ||
endDate
);

/* ==========================================================
SORT FARM ROWS

Highest profit first.

If profit is tied:
Highest current worth first.

========================================================== */

const sortedFarms =
[...farms].sort(

    function(a, b) {

        const profitA =
            Number(a?.profit) || 0;

        const profitB =
            Number(b?.profit) || 0;


        if (profitA !== profitB) {

            return profitB - profitA;

        }


        const worthA =
            Number(a?.currentWorth) || 0;

        const worthB =
            Number(b?.currentWorth) || 0;


        return worthB - worthA;

    }

);

/* ==========================================================
TABLE ROWS
========================================================== */

const financialRows = [];

sortedFarms.forEach(

function(item) {

    financialRows.push({

        type:
            "farm",

        id:
            item?.farm?._id,

        name:
            item?.farm?.name ||
            "Unnamed Farm",

        code:
            item?.farm?.code ||
            "",

        currentWorth:
            Number(item?.currentWorth) || 0,

        salesAmount:
            Number(item?.salesAmount) || 0,

        revenue:
            Number(item?.revenue) || 0,

        liabilities:
            Number(item?.liabilities) || 0,

        profit:
            Number(item?.profit) || 0

    });

}

);

/* ==========================================================
STANDALONE ROW
========================================================== */

financialRows.push({

type:
    "standalone",

id:
    null,

name:
    "Standalone Assets",

code:
    "",

currentWorth:
    Number(standalone?.currentWorth) || 0,

salesAmount:
    Number(standalone?.salesAmount) || 0,

revenue:
    Number(standalone?.revenue) || 0,

liabilities:
    Number(standalone?.liabilities) || 0,

profit:
    Number(standalone?.profit) || 0

});

/* ==========================================================
TOTALS
========================================================== */

const totalCurrentWorth =
Number(
totals?.currentWorth
) || 0;

const totalSalesAmount =
Number(
totals?.salesAmount
) || 0;

const totalRevenue =
Number(
totals?.revenue
) || 0;

const totalLiabilities =
Number(
totals?.liabilities
) || 0;

const totalProfit =
Number(
totals?.profit
) || 0;

%>

<div class="financial-page summary-page"><!-- ======================================================
     PAGE HEADER
     ====================================================== -->

<div class="financial-page-header">

    <div>

        <span class="financial-eyebrow">

            FINANCIALS

        </span>


        <h1 class="financial-title">

            Financial Summary

        </h1>


        <p class="financial-subtitle">

            Financial position across all dairy farms
            and standalone assets.

        </p>

    </div>


    <a
        href="/financials/liability"
        class="financial-button financial-button-primary"
    >

        <i class="bi bi-plus-circle"></i>

        Record Liability

    </a>

</div>


<!-- ======================================================
     CURRENT NET WORTH
     ====================================================== -->

<section class="financial-current-worth-card">


    <div class="financial-current-worth-icon">

        <i class="bi bi-wallet2"></i>

    </div>


    <div>

        <span class="financial-current-worth-label">

            TOTAL CURRENT NET WORTH

        </span>


        <strong class="financial-current-worth-value">

            KSh
            <%= formatMoney(
                totalCurrentWorth
            ) %>

        </strong>


        <small>

            Current value of all farms and standalone
            assets.

        </small>

    </div>

</section>


<!-- ======================================================
     FILTER
     ====================================================== -->

<section class="financial-filter-card">


    <form
        method="GET"
        action="/financials/summary"
        class="financial-filter-form"
    >


        <div class="financial-filter-title">

            <i class="bi bi-calendar3"></i>

            <span>

                Liability & Profit Period

            </span>

        </div>


        <!-- ==============================================
             FROM
             ============================================== -->

        <div class="financial-filter-group">

            <label for="startDate">

                From

            </label>


            <input
                type="date"
                id="startDate"
                name="startDate"
                value="<%= startDate %>"
            >

        </div>


        <!-- ==============================================
             TO
             ============================================== -->

        <div class="financial-filter-group">

            <label for="endDate">

                To

            </label>


            <input
                type="date"
                id="endDate"
                name="endDate"
                value="<%= endDate %>"
            >

        </div>


        <!-- ==============================================
             APPLY
             ============================================== -->

        <button
            type="submit"
            class="financial-button financial-button-primary"
        >

            <i class="bi bi-funnel"></i>

            Apply

        </button>


        <!-- ==============================================
             CLEAR
             ============================================== -->

        <% if (hasDateFilter) { %>

            <a
                href="/financials/summary"
                class="financial-clear-filter"
            >

                <i class="bi bi-x-circle"></i>

                Clear

            </a>

        <% } %>


    </form>


</section>


<!-- ======================================================
     PERIOD INDICATOR
     ====================================================== -->

<% if (hasDateFilter) { %>

    <div class="financial-period-indicator">

        <i class="bi bi-clock-history"></i>

        <span>

            Liabilities & profit:

        </span>


        <% if (startDate) { %>

            <strong>

                <%= startDate %>

            </strong>

        <% } %>


        <% if (startDate && endDate) { %>

            <span>

                to

            </span>

        <% } %>


        <% if (endDate) { %>

            <strong>

                <%= endDate %>

            </strong>

        <% } %>

    </div>

<% } %>


<!-- ======================================================
     FINANCIAL TABLE
     ====================================================== -->

<section class="financial-section">


    <div class="financial-section-header">

        <div>

            <span class="financial-eyebrow">

                FINANCIAL BREAKDOWN

            </span>


            <h2>

                Dairy Farms & Standalone Assets

            </h2>

        </div>

    </div>


    <div class="financial-table-wrapper">


        <table class="financial-table">


            <!-- ==========================================
                 TABLE HEADER
                 ========================================== -->

            <thead>

                <tr>

                    <th class="financial-name-column">

                        Farm / Asset

                    </th>


                    <th>

                        Current Worth

                    </th>


                    <th>

                        Sales Amount

                    </th>


                    <th>

                        Revenue

                    </th>


                    <th>

                        Liabilities

                    </th>


                    <th>

                        Profit / Loss

                    </th>

                </tr>

            </thead>


            <!-- ==========================================
                 TABLE BODY
                 ========================================== -->

            <tbody>


                <% financialRows.forEach(
                    function(row, index)
                { %>


                    <tr
                        class="
                            <%= row.profit < 0
                                ? 'financial-row-negative'
                                : ''
                            %>
                        "
                    >


                        <!-- ==================================
                             NAME
                             ================================== -->

                        <td>

                            <% if (
                                row.type === "farm" &&
                                row.id
                            ) { %>


                                <a
                                    href="/financials/dairy/<%= row.id %>"
                                    class="financial-name-link"
                                >

                                    <span
                                        class="financial-row-icon"
                                    >

                                        <i class="bi bi-building"></i>

                                    </span>


                                    <span>

                                        <strong>

                                            <%= row.name %>

                                        </strong>


                                        <% if (row.code) { %>

                                            <small>

                                                Code:
                                                <%= row.code %>

                                            </small>

                                        <% } %>

                                    </span>

                                </a>


                            <% } else { %>


                                <a
                                    href="/financials/standalone"
                                    class="financial-name-link"
                                >

                                    <span
                                        class="financial-row-icon"
                                    >

                                        <i class="bi bi-box"></i>

                                    </span>


                                    <span>

                                        <strong>

                                            <%= row.name %>

                                        </strong>


                                        <small>

                                            Individual assets

                                        </small>

                                    </span>

                                </a>


                            <% } %>

                        </td>


                        <!-- ==================================
                             CURRENT WORTH
                             ================================== -->

                        <td>

                            <span class="financial-table-value">

                                KSh
                                <%= formatMoney(
                                    row.currentWorth
                                ) %>

                            </span>

                        </td>


                        <!-- ==================================
                             SALES
                             ================================== -->

                        <td>

                            <span class="financial-table-value">

                                KSh
                                <%= formatMoney(
                                    row.salesAmount
                                ) %>

                            </span>

                        </td>


                        <!-- ==================================
                             REVENUE
                             ================================== -->

                        <td>

                            <span class="financial-table-value">

                                KSh
                                <%= formatMoney(
                                    row.revenue
                                ) %>

                            </span>

                        </td>


                        <!-- ==================================
                             LIABILITIES
                             ================================== -->

                        <td>

                            <span class="financial-table-value financial-liability">

                                KSh
                                <%= formatMoney(
                                    row.liabilities
                                ) %>

                            </span>

                        </td>


                        <!-- ==================================
                             PROFIT
                             ================================== -->

                        <td>

                            <strong
                                class="
                                    financial-table-profit

                                    <%= profitClass(
                                        row.profit
                                    ) %>
                                "
                            >

                                <%= profitText(
                                    row.profit
                                ) %>

                            </strong>

                        </td>


                    </tr>


                <% }); %>


                <!-- ==========================================
                     TOTAL ROW
                     ========================================== -->

                <tr class="financial-total-row">


                    <td>

                        <strong>

                            TOTAL

                        </strong>

                    </td>


                    <td>

                        <strong>

                            KSh
                            <%= formatMoney(
                                totalCurrentWorth
                            ) %>

                        </strong>

                    </td>


                    <td>

                        <strong>

                            KSh
                            <%= formatMoney(
                                totalSalesAmount
                            ) %>

                        </strong>

                    </td>


                    <td>

                        <strong>

                            KSh
                            <%= formatMoney(
                                totalRevenue
                            ) %>

                        </strong>

                    </td>


                    <td>

                        <strong
                            class="financial-liability"
                        >

                            KSh
                            <%= formatMoney(
                                totalLiabilities
                            ) %>

                        </strong>

                    </td>


                    <td>

                        <strong
                            class="
                                financial-table-profit

                                <%= profitClass(
                                    totalProfit
                                ) %>
                            "
                        >

                            <%= profitText(
                                totalProfit
                            ) %>

                        </strong>

                    </td>


                </tr>


            </tbody>


        </table>


    </div>


</section>

</div><style>

/* ==========================================================
   FINANCIAL SUMMARY
   ========================================================== */

.financial-page{

    --financial-green:#2f7d4a;
    --financial-green-dark:#236238;
    --financial-green-light:#eaf6ee;
    --financial-green-soft:#f4faf6;

    --financial-red:#c0392b;
    --financial-red-light:#fceceb;

    --financial-text:#243329;
    --financial-muted:#718078;

    padding:24px;

    max-width:1400px;

    margin:0 auto;

}


/* ==========================================================
   HEADER
   ========================================================== */

.financial-page-header{

    display:flex;

    align-items:center;

    justify-content:space-between;

    gap:20px;

    margin-bottom:20px;

}


.financial-eyebrow{

    display:block;

    margin-bottom:4px;

    color:var(--financial-green);

    font-size:.7rem;

    font-weight:800;

    letter-spacing:.12em;

}


.financial-title{

    margin:0;

    color:var(--financial-text);

    font-size:clamp(1.6rem,4vw,2.2rem);

}


.financial-subtitle{

    margin:5px 0 0;

    color:var(--financial-muted);

    font-size:.88rem;

}


/* ==========================================================
   BUTTON
   ========================================================== */

.financial-button{

    display:inline-flex;

    align-items:center;

    justify-content:center;

    gap:7px;

    padding:10px 15px;

    border:0;

    border-radius:10px;

    text-decoration:none;

    font:inherit;

    font-size:.85rem;

    font-weight:600;

    cursor:pointer;

    white-space:nowrap;

}


.financial-button-primary{

    background:var(--financial-green);

    color:#fff;

}


.financial-button-primary:hover{

    background:var(--financial-green-dark);

}


/* ==========================================================
   CURRENT NET WORTH
   ========================================================== */

.financial-current-worth-card{

    display:flex;

    align-items:center;

    gap:16px;

    padding:20px 22px;

    margin-bottom:14px;

    background:#fff;

    border-radius:16px;

    border-left:4px solid
        var(--financial-green);

    box-shadow:
        0 3px 16px
        rgba(0,0,0,.06);

}


.financial-current-worth-icon{

    width:48px;

    height:48px;

    display:flex;

    align-items:center;

    justify-content:center;

    flex-shrink:0;

    border-radius:13px;

    background:
        var(--financial-green-light);

    color:var(--financial-green);

    font-size:1.25rem;

}


.financial-current-worth-label{

    display:block;

    color:var(--financial-muted);

    font-size:.7rem;

    font-weight:800;

    letter-spacing:.08em;

}


.financial-current-worth-value{

    display:block;

    margin-top:2px;

    color:var(--financial-green-dark);

    font-size:1.45rem;

}


.financial-current-worth-card small{

    display:block;

    margin-top:3px;

    color:var(--financial-muted);

    font-size:.7rem;

}


/* ==========================================================
   FILTER
   ========================================================== */

.financial-filter-card{

    padding:12px 15px;

    margin-bottom:12px;

    background:#fff;

    border-radius:13px;

    box-shadow:
        0 2px 10px
        rgba(0,0,0,.05);

}


.financial-filter-form{

    display:flex;

    align-items:flex-end;

    gap:9px;

}


.financial-filter-title{

    display:flex;

    align-items:center;

    gap:7px;

    min-width:185px;

    padding-bottom:9px;

    color:var(--financial-text);

    font-size:.8rem;

    font-weight:700;

}


.financial-filter-title i{

    color:var(--financial-green);

}


.financial-filter-group{

    width:180px;

}


.financial-filter-group label{

    display:block;

    margin-bottom:4px;

    color:var(--financial-muted);

    font-size:.68rem;

    font-weight:600;

}


.financial-filter-group input{

    width:100%;

    box-sizing:border-box;

    padding:8px 9px;

    border:1px solid #dce5df;

    border-radius:8px;

    outline:none;

    background:#fff;

    color:var(--financial-text);

    font:inherit;

    font-size:.8rem;

}


.financial-filter-group input:focus{

    border-color:var(--financial-green);

    box-shadow:
        0 0 0 2px
        rgba(47,125,74,.1);

}


.financial-filter-form .financial-button{

    padding:8px 13px;

    font-size:.78rem;

}


.financial-clear-filter{

    display:inline-flex;

    align-items:center;

    gap:4px;

    padding:8px 5px;

    color:var(--financial-green);

    font-size:.78rem;

    font-weight:600;

    text-decoration:none;

    white-space:nowrap;

}


/* ==========================================================
   PERIOD
   ========================================================== */

.financial-period-indicator{

    display:flex;

    align-items:center;

    gap:6px;

    margin:0 0 18px;

    color:var(--financial-muted);

    font-size:.7rem;

}


.financial-period-indicator i{

    color:var(--financial-green);

}


.financial-period-indicator strong{

    color:var(--financial-text);

}


/* ==========================================================
   SECTION
   ========================================================== */

.financial-section{

    margin-bottom:35px;

}


.financial-section-header{

    margin-bottom:12px;

}


.financial-section-header h2{

    margin:0;

    color:var(--financial-text);

    font-size:1.2rem;

}


/* ==========================================================
   TABLE WRAPPER
   ========================================================== */

.financial-table-wrapper{

    width:100%;

    overflow-x:auto;

    background:#fff;

    border-radius:15px;

    box-shadow:
        0 3px 16px
        rgba(0,0,0,.06);

}


/* ==========================================================
   TABLE
   ========================================================== */

.financial-table{

    width:100%;

    min-width:850px;

    border-collapse:collapse;

    table-layout:auto;

}


.financial-table th{

    padding:13px 15px;

    background:#f5f8f6;

    border-bottom:1px solid #e3ebe5;

    color:var(--financial-muted);

    font-size:.7rem;

    font-weight:800;

    text-align:right;

    white-space:nowrap;

}


.financial-table th:first-child{

    text-align:left;

}


.financial-name-column{

    min-width:210px;

}


.financial-table td{

    padding:14px 15px;

    border-bottom:1px solid #edf1ee;

    color:var(--financial-text);

    font-size:.8rem;

    text-align:right;

    white-space:nowrap;

}


.financial-table td:first-child{

    text-align:left;

}


.financial-table tbody tr:last-child td{

    border-bottom:0;

}


/* ==========================================================
   NAME LINK
   ========================================================== */

.financial-name-link{

    display:flex;

    align-items:center;

    gap:10px;

    color:var(--financial-text);

    text-decoration:none;

}


.financial-name-link:hover strong{

    color:var(--financial-green);

}


.financial-row-icon{

    width:34px;

    height:34px;

    display:flex;

    align-items:center;

    justify-content:center;

    flex-shrink:0;

    border-radius:9px;

    background:var(--financial-green-light);

    color:var(--financial-green);

}


.financial-name-link strong{

    display:block;

    transition:.15s ease;

}


.financial-name-link small{

    display:block;

    margin-top:2px;

    color:var(--financial-muted);

    font-size:.65rem;

}


/* ==========================================================
   TABLE VALUES
   ========================================================== */

.financial-table-value{

    color:var(--financial-text);

}


.financial-liability{

    color:var(--financial-green-dark) !important;

}


.financial-table-profit{

    font-weight:800;

}


.financial-positive{

    color:var(--financial-green-dark) !important;

}


.financial-negative{

    color:var(--financial-red) !important;

}


.financial-row-negative{

    background:
        rgba(192,57,43,.025);

}


/* ==========================================================
   TOTAL
   ========================================================== */

.financial-total-row{

    background:var(--financial-green-soft);

}


.financial-total-row td{

    padding-top:16px;

    padding-bottom:16px;

    border-top:2px solid
        #d8e9dd;

    color:var(--financial-text);

    font-weight:800;

}


/* ==========================================================
   RESPONSIVE
   ========================================================== */

@media(max-width:800px){

    .financial-page{

        padding:16px;

    }


    .financial-page-header{

        align-items:flex-start;

        flex-direction:column;

    }


    .financial-page-header .financial-button{

        width:100%;

    }


    .financial-current-worth-card{

        padding:17px;

    }


    .financial-filter-form{

        flex-wrap:wrap;

    }


    .financial-filter-title{

        width:100%;

        min-width:0;

        padding-bottom:2px;

    }


    .financial-filter-group{

        flex:1;

        min-width:130px;

    }

}


@media(max-width:500px){

    .financial-filter-form{

        display:grid;

        grid-template-columns:
            1fr 1fr;

    }


    .financial-filter-title{

        grid-column:
            1 / -1;

    }


    .financial-filter-group{

        width:auto;

        min-width:0;

    }


    .financial-filter-form
    .financial-button{

        width:100%;

    }


    .financial-clear-filter{

        justify-content:center;

    }

}

</style>