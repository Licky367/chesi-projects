<% /* ==========================================================
FINANCIAL SUMMARY PAGE

BACKEND DATA PROVIDED BY:

   controllers/financialsController.js

FINANCIAL RULES

1. DATE FILTER
   
   The selected date range applies ONLY to:
   
   - Liabilities
- Profit
   
   It does NOT affect current net worth.
   
   When no startDate or endDate is supplied:
   
   -> Lifetime analysis

2. CURRENT NET WORTH
   
   Current net worth is always the CURRENT value.
   
   It is NOT calculated for the selected date range.
   
   Historical net-worth graphing will be handled separately.

3. PROFIT
   
   For a dairy / asset:
   
   status === "sold"
    -> actual realized profit/loss

status !== "sold"
    -> profit = negative liabilities
   
   Therefore an unsold item carrying:
   
   KSh 50,000 liabilities
   
   contributes:
   
   -KSh 50,000
   
   to the financial position.
   
   The controller/service is responsible for supplying
   the correct profit values.

EXPECTED DATA:

   summary:

       {
           totals: {
               currentWorth,
               liabilities,
               profit
           },

           farms: [
               {
                   farm,
                   farmLiabilities,
                   totalLiabilities,
                   profit,
                   assets: []
               }
           ],

           standalone: {
               currentWorth,
               liabilities,
               profit,
               assets: []
           }
       }


   filters:

       {
           startDate,
           endDate
       }

========================================================== */ %>

<%
// ========================================================
// MONEY FORMATTER
// ========================================================

function formatMoney(value) {

    if (
        value === null ||
        value === undefined ||
        value === "" ||
        Number.isNaN(Number(value))
    ) {

        return "—";

    }

    return Number(value).toLocaleString(

        "en-KE",

        {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
        }

    );

}


// ========================================================
// PROFIT CLASS
// ========================================================

function profitClass(value) {

    if (
        value !== null &&
        value !== undefined &&
        value !== "" &&
        Number(value) < 0
    ) {

        return "financial-negative";

    }

    return "financial-positive";

}


// ========================================================
// PROFIT TEXT
// ========================================================

function profitText(value) {

    if (
        value === null ||
        value === undefined ||
        value === ""
    ) {

        return "—";

    }

    return "KSh " + formatMoney(value);

}


// ========================================================
// SAFE SUMMARY VALUES
// ========================================================

const totals =
    summary?.totals || {};


const standalone =
    summary?.standalone || {};


const farms =
    Array.isArray(summary?.farms)

        ? summary.farms

        : [];


// ========================================================
// FILTER STATE
// ========================================================

const startDate =
    filters?.startDate || "";


const endDate =
    filters?.endDate || "";


const hasDateFilter =
    Boolean(
        startDate ||
        endDate
    );


// ========================================================
// FARM TOTALS
//
// IMPORTANT:
//
// farmCurrentWorth is ALWAYS the current value.
//
// It is NOT affected by the date filter.
//
// farmLiabilities and farmProfit are supplied by the
// backend and are expected to respect the selected
// liability/profit date range.
// ========================================================

let farmCurrentWorth = 0;

let farmLiabilities = 0;

let farmProfit = 0;


farms.forEach(
    function(item) {

        // ------------------------------------------------
        // CURRENT NET WORTH
        //
        // Always current.
        // Never date-filtered.
        // ------------------------------------------------

        farmCurrentWorth +=
            Number(
                item?.farm?.currentWorth
            ) || 0;


        // ------------------------------------------------
        // LIABILITIES
        //
        // Backend supplies the filtered value.
        // ------------------------------------------------

        farmLiabilities +=
            Number(
                item?.totalLiabilities
            ) || 0;


        // ------------------------------------------------
        // PROFIT
        //
        // Backend supplies:
        //
        // SOLD:
        //     realized profit/loss
        //
        // NOT SOLD:
        //     negative liabilities
        // ------------------------------------------------

        if (
            item?.profit !== null &&
            item?.profit !== undefined &&
            item?.profit !== ""
        ) {

            farmProfit +=
                Number(
                    item.profit
                ) || 0;

        }

    }
);

%>

<div class="financial-page summary-page"><!-- ======================================================
     HEADER
     ====================================================== -->

<div class="financial-page-header">

    <div>

        <span class="financial-eyebrow">

            FINANCIALS

        </span>


        <h1 class="financial-title">

            Financial Summary

        </h1>


        <p class="financial-subtitle">

            Current net worth, liabilities, and realized
            financial performance.

        </p>

    </div>


    <div>

        <a
            href="/financials/liability"
            class="financial-button financial-button-primary"
        >

            <i class="bi bi-plus-circle"></i>

            Record Liability

        </a>

    </div>

</div>


<!-- ======================================================
     DATE FILTER
     ====================================================== -->

<section class="financial-filter-card">


    <div class="financial-filter-header">

        <div>

            <h2>

                Liability & Profit Period

            </h2>


            <p>

                The date range applies only to liabilities
                and profit. Current net worth is always
                shown as the current value.

            </p>

        </div>


        <i class="bi bi-calendar3"></i>

    </div>


    <form
        method="GET"
        action="/financials/summary"
        class="financial-filter-form"
    >


        <!-- ==================================================
             START DATE
             ================================================== -->

        <div class="financial-filter-group">

            <label for="startDate">

                From

            </label>


            <input
                type="date"
                id="startDate"
                name="startDate"
                value="<%= startDate %>"
            >

        </div>


        <!-- ==================================================
             END DATE
             ================================================== -->

        <div class="financial-filter-group">

            <label for="endDate">

                To

            </label>


            <input
                type="date"
                id="endDate"
                name="endDate"
                value="<%= endDate %>"
            >

        </div>


        <!-- ==================================================
             APPLY
             ================================================== -->

        <button
            type="submit"
            class="financial-button financial-button-primary"
        >

            <i class="bi bi-funnel"></i>

            Apply Filter

        </button>


        <!-- ==================================================
             CLEAR
             ================================================== -->

        <% if (hasDateFilter) { %>

            <a
                href="/financials"
                class="financial-clear-filter"
            >

                <i class="bi bi-x-circle"></i>

                Clear

            </a>

        <% } %>


    </form>


    <!-- ==================================================
         PERIOD STATUS
         ================================================== -->

    <div class="financial-period">

        <i class="bi bi-clock-history"></i>


        <% if (hasDateFilter) { %>


            <span>

                Liability & profit analysis:

            </span>


            <% if (startDate) { %>

                <strong>

                    <%= startDate %>

                </strong>

            <% } %>


            <% if (startDate && endDate) { %>

                <span>

                    to

                </span>

            <% } %>


            <% if (endDate) { %>

                <strong>

                    <%= endDate %>

                </strong>

            <% } %>


        <% } else { %>


            <span>

                Lifetime liability & profit analysis

            </span>


        <% } %>


    </div>


</section>


<!-- ======================================================
     TOP LEVEL SUMMARY
     ====================================================== -->

<section class="financial-summary-grid">


    <!-- ==================================================
         CURRENT NET WORTH
         ================================================== -->

    <article class="financial-summary-card">


        <div class="financial-summary-icon">

            <i class="bi bi-wallet2"></i>

        </div>


        <div>

            <span class="financial-summary-label">

                Current Net Worth

            </span>


            <strong class="financial-summary-value">

                KSh
                <%= formatMoney(
                    totals.currentWorth
                ) %>

            </strong>


            <small class="financial-summary-hint">

                Current value — not date filtered

            </small>

        </div>


    </article>


    <!-- ==================================================
         LIABILITIES
         ================================================== -->

    <article class="financial-summary-card">


        <div class="financial-summary-icon">

            <i class="bi bi-receipt"></i>

        </div>


        <div>

            <span class="financial-summary-label">

                Total Liabilities

            </span>


            <strong class="financial-summary-value">

                KSh
                <%= formatMoney(
                    totals.liabilities
                ) %>

            </strong>


            <small class="financial-summary-hint">

                <% if (hasDateFilter) { %>

                    Selected period

                <% } else { %>

                    Lifetime

                <% } %>

            </small>

        </div>


    </article>


    <!-- ==================================================
         PROFIT
         ================================================== -->

    <article
        class="
            financial-summary-card

            <%= totals.profit !== null &&
                totals.profit !== undefined &&
                Number(totals.profit) < 0

                    ? 'financial-profit-negative'

                    : ''
            %>
        "
    >


        <div class="financial-summary-icon">

            <i class="bi bi-graph-up-arrow"></i>

        </div>


        <div>

            <span class="financial-summary-label">

                Financial Profit / Loss

            </span>


            <strong
                class="
                    financial-summary-value

                    <%= profitClass(
                        totals.profit
                    ) %>
                "
            >

                <%= profitText(
                    totals.profit
                ) %>

            </strong>


            <small class="financial-summary-hint">

                <% if (hasDateFilter) { %>

                    Selected period

                <% } else { %>

                    Lifetime

                <% } %>

            </small>

        </div>


    </article>


</section>


<!-- ======================================================
     CATEGORY SUMMARY
     ====================================================== -->

<section class="financial-section">


    <div class="financial-section-header">

        <span class="financial-eyebrow">

            BREAKDOWN

        </span>


        <h2>

            Assets & Dairy Farms

        </h2>


        <p>

            Current net worth is shown separately from
            date-filtered liabilities and profit.

        </p>

    </div>


    <div class="financial-category-grid">


        <!-- ==================================================
             STANDALONE ASSETS
             ================================================== -->

        <article class="financial-category-card">


            <div class="financial-category-header">

                <div>

                    <span class="financial-category-label">

                        STANDALONE ASSETS

                    </span>


                    <h3>

                        Standalone Assets

                    </h3>

                </div>


                <i class="bi bi-box"></i>

            </div>


            <div class="financial-metric-list">


                <!-- ==================================================
                     CURRENT NET WORTH
                     ================================================== -->

                <div class="financial-metric">

                    <span>

                        Current Net Worth

                    </span>


                    <strong>

                        KSh
                        <%= formatMoney(
                            standalone.currentWorth
                        ) %>

                    </strong>

                </div>


                <!-- ==================================================
                     LIABILITIES
                     ================================================== -->

                <div class="financial-metric">

                    <span>

                        Total Liabilities

                        <% if (hasDateFilter) { %>

                            <small>

                                Filtered

                            </small>

                        <% } %>

                    </span>


                    <strong
                        class="financial-liability-text"
                    >

                        KSh
                        <%= formatMoney(
                            standalone.liabilities
                        ) %>

                    </strong>

                </div>


                <!-- ==================================================
                     PROFIT
                     ================================================== -->

                <div class="financial-metric">

                    <span>

                        Profit / Loss

                        <% if (hasDateFilter) { %>

                            <small>

                                Filtered

                            </small>

                        <% } %>

                    </span>


                    <strong
                        class="<%= profitClass(
                            standalone.profit
                        ) %>"
                    >

                        <%= profitText(
                            standalone.profit
                        ) %>

                    </strong>

                </div>


            </div>


        </article>


        <!-- ==================================================
             DAIRY FARMS
             ================================================== -->

        <article class="financial-category-card">


            <div class="financial-category-header">

                <div>

                    <span class="financial-category-label">

                        FARMS

                    </span>


                    <h3>

                        Dairy Farms

                    </h3>

                </div>


                <i class="bi bi-diagram-3"></i>

            </div>


            <div class="financial-metric-list">


                <!-- ==================================================
                     CURRENT NET WORTH
                     ================================================== -->

                <div class="financial-metric">

                    <span>

                        Current Net Worth

                    </span>


                    <strong>

                        KSh
                        <%= formatMoney(
                            farmCurrentWorth
                        ) %>

                    </strong>

                </div>


                <!-- ==================================================
                     LIABILITIES
                     ================================================== -->

                <div class="financial-metric">

                    <span>

                        Total Liabilities

                        <% if (hasDateFilter) { %>

                            <small>

                                Filtered

                            </small>

                        <% } %>

                    </span>


                    <strong
                        class="financial-liability-text"
                    >

                        KSh
                        <%= formatMoney(
                            farmLiabilities
                        ) %>

                    </strong>

                </div>


                <!-- ==================================================
                     PROFIT
                     ================================================== -->

                <div class="financial-metric">

                    <span>

                        Profit / Loss

                        <% if (hasDateFilter) { %>

                            <small>

                                Filtered

                            </small>

                        <% } %>

                    </span>


                    <strong
                        class="<%= profitClass(
                            farmProfit
                        ) %>"
                    >

                        <%= profitText(
                            farmProfit
                        ) %>

                    </strong>

                </div>


            </div>


        </article>


    </div>


</section>


<!-- ======================================================
     INDIVIDUAL FARM ANALYTICS
     ====================================================== -->

<section class="financial-section">


    <div class="financial-section-header">

        <span class="financial-eyebrow">

            FARM ANALYTICS

        </span>


        <h2>

            Dairy Farm Financials

        </h2>


        <p>

            Current farm net worth is shown independently
            from the selected liability and profit period.

        </p>

    </div>


    <% if (farms.length) { %>


        <div class="financial-farm-summary-grid">


            <% farms.forEach(
                function(item)
            { %>


                <%
                    const farm =
                        item?.farm || {};


                    const farmProfitValue =
                        item?.profit;


                    const farmIsNegative =
                        farmProfitValue !== null &&
                        farmProfitValue !== undefined &&
                        farmProfitValue !== "" &&
                        Number(farmProfitValue) < 0;
                %>


                <article
                    class="
                        financial-farm-summary-card

                        <%= farmIsNegative
                            ? 'financial-farm-negative'
                            : ''
                        %>
                    "
                >


                    <!-- ==================================
                         FARM HEADER
                         ================================== -->

                    <div class="financial-farm-summary-header">


                        <div>

                            <span>

                                Farm Code:

                                <%= farm.code ?? "—" %>

                            </span>


                            <h3>

                                <%= farm.name ||
                                    "Unnamed Farm"
                                %>

                            </h3>

                        </div>


                        <i class="bi bi-building"></i>

                    </div>


                    <!-- ==================================
                         FARM METRICS
                         ================================== -->

                    <div class="financial-farm-metrics">


                        <!-- ==================================
                             CURRENT NET WORTH
                             ================================== -->

                        <div>

                            <span>

                                Current Net Worth

                            </span>


                            <strong>

                                KSh
                                <%= formatMoney(
                                    farm.currentWorth
                                ) %>

                            </strong>


                            <small>

                                Current value

                            </small>

                        </div>


                        <!-- ==================================
                             LIABILITIES
                             ================================== -->

                        <div>

                            <span>

                                Liabilities

                            </span>


                            <strong
                                class="financial-liability-text"
                            >

                                KSh
                                <%= formatMoney(
                                    item.totalLiabilities
                                ) %>

                            </strong>


                            <small>

                                <% if (hasDateFilter) { %>

                                    Selected period

                                <% } else { %>

                                    Lifetime

                                <% } %>

                            </small>

                        </div>


                        <!-- ==================================
                             PROFIT
                             ================================== -->

                        <div>

                            <span>

                                Profit / Loss

                            </span>


                            <strong
                                class="<%= profitClass(
                                    farmProfitValue
                                ) %>"
                            >

                                <%= profitText(
                                    farmProfitValue
                                ) %>

                            </strong>


                            <small>

                                <% if (hasDateFilter) { %>

                                    Selected period

                                <% } else { %>

                                    Lifetime

                                <% } %>

                            </small>

                        </div>


                    </div>


                    <!-- ==================================
                         LIABILITY BREAKDOWN
                         ================================== -->

                    <div
                        class="
                            financial-farm-liability-breakdown
                        "
                    >


                        <div>

                            <span>

                                Farm's Own Liabilities

                            </span>


                            <strong>

                                KSh
                                <%= formatMoney(
                                    item.farmLiabilities
                                ) %>

                            </strong>

                        </div>


                        <div>

                            <span>

                                Farm Assets

                            </span>


                            <strong>

                                <%= Array.isArray(
                                    item.assets
                                )
                                    ? item.assets.length
                                    : 0
                                %>

                            </strong>

                        </div>


                    </div>


                    <!-- ==================================
                         FINANCIAL RULE NOTE
                         ================================== -->

                    <div class="financial-farm-note">


                        <i class="bi bi-info-circle"></i>


                        <span>

                            Current net worth is always the
                            farm's current value. Liabilities
                            and profit follow the selected
                            period. Unsold assets contribute
                            their liabilities as a negative
                            financial position; sold assets
                            contribute their realized
                            profit or loss.

                        </span>


                    </div>


                </article>


            <% }); %>


        </div>


    <% } else { %>


        <!-- ==============================================
             EMPTY STATE
             ============================================== -->

        <div class="financial-empty">


            <i class="bi bi-building"></i>


            <strong>

                No dairy farms found

            </strong>


            <span>

                There are currently no dairy farms
                available for financial analysis.

            </span>


        </div>


    <% } %>


</section>

</div><style>

/* ==========================================================
   FINANCIAL SUMMARY PAGE
   ========================================================== */

.financial-page{

    --financial-green:#2f7d4a;
    --financial-green-dark:#236238;
    --financial-green-light:#eaf6ee;
    --financial-green-soft:#f4faf6;

    --financial-red:#c0392b;
    --financial-red-light:#fceceb;

    --financial-text:#243329;
    --financial-muted:#718078;

    padding:24px;

    max-width:1400px;

    margin:0 auto;

}


/* ==========================================================
   HEADER
   ========================================================== */

.financial-page-header{

    display:flex;

    justify-content:space-between;

    align-items:center;

    gap:20px;

    margin-bottom:25px;

}


.financial-eyebrow{

    display:block;

    color:var(--financial-green);

    font-size:.72rem;

    font-weight:800;

    letter-spacing:.12em;

    margin-bottom:5px;

}


.financial-title{

    margin:0;

    color:var(--financial-text);

    font-size:clamp(1.6rem,4vw,2.2rem);

}


.financial-subtitle{

    margin:7px 0 0;

    color:var(--financial-muted);

}


/* ==========================================================
   BUTTONS
   ========================================================== */

.financial-button{

    display:inline-flex;

    align-items:center;

    justify-content:center;

    gap:8px;

    padding:11px 16px;

    border:0;

    border-radius:10px;

    text-decoration:none;

    font:inherit;

    font-weight:600;

    cursor:pointer;

}


.financial-button-primary{

    background:var(--financial-green);

    color:#fff;

}


.financial-button-primary:hover{

    background:var(--financial-green-dark);

}


/* ==========================================================
   FILTER CARD
   ========================================================== */

.financial-filter-card{

    background:#fff;

    padding:20px;

    border-radius:17px;

    box-shadow:
        0 3px 16px
        rgba(0,0,0,.06);

    margin-bottom:28px;

}


.financial-filter-header{

    display:flex;

    justify-content:space-between;

    align-items:flex-start;

    gap:15px;

    margin-bottom:18px;

}


.financial-filter-header h2{

    margin:0;

    font-size:1.05rem;

    color:var(--financial-text);

}


.financial-filter-header p{

    margin:5px 0 0;

    max-width:760px;

    color:var(--financial-muted);

    font-size:.82rem;

    line-height:1.5;

}


.financial-filter-header > i{

    color:var(--financial-green);

    font-size:1.2rem;

}


/* ==========================================================
   FILTER FORM
   ========================================================== */

.financial-filter-form{

    display:flex;

    align-items:flex-end;

    gap:12px;

    flex-wrap:wrap;

}


.financial-filter-group{

    min-width:190px;

    flex:1;

