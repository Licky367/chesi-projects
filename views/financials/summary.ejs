}


/* ==========================================================
   TOP SUMMARY
   ========================================================== */

.financial-summary-grid{

    display:grid;

    grid-template-columns:
        repeat(3,minmax(0,1fr));

    gap:16px;

    margin-bottom:36px;

}


.financial-summary-card{

    display:flex;

    align-items:center;

    gap:15px;

    padding:20px;

    background:#fff;

    border-radius:17px;

    box-shadow:
        0 3px 16px
        rgba(0,0,0,.06);

    border-left:4px solid
