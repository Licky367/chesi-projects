<% /* ==========================================================
   FINANCIAL SUMMARY PAGE
   ==========================================================

   BACKEND DATA PROVIDED BY:

       controllers/financialsController.js

   EXPECTED:

       summary:

           {
               filters: {
                   startDate,
                   endDate
               },

               totals: {
                   currentWorth,
                   liabilities,
                   profit
               },

               farms: [
                   {
                       farm,
                       farmLiabilities,
                       totalLiabilities,
                       profit,
                       assets: []
                   }
               ],

               standalone: {
                   currentWorth,
                   liabilities,
                   profit,
                   assets: []
               }
           }

       filters:

           {
               startDate,
               endDate
           }

   IMPORTANT PROFIT RULE

   Profit is only calculated/displayed when the dairy/asset
   status is "sold".

   Otherwise:

       profit = null

   Negative profit receives:

       financial-negative

   ========================================================== */ %>


<%
    // ========================================================
    // MONEY FORMATTER
    // ========================================================

    function formatMoney(value) {

        if (
            value === null ||
            value === undefined ||
            Number.isNaN(Number(value))
        ) {

            return "—";

        }

        return Number(value).toLocaleString(

            "en-KE",

            {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            }

        );

    }


    // ========================================================
    // PROFIT CLASS
    // ========================================================

    function profitClass(value) {

        if (
            value !== null &&
            value !== undefined &&
            Number(value) < 0
        ) {

            return "financial-negative";

        }

        return "financial-positive";

    }


    // ========================================================
    // PROFIT TEXT
    // ========================================================

    function profitText(value) {

        if (
            value === null ||
            value === undefined
        ) {

            return "—";

        }

        return "KSh " + formatMoney(value);

    }


    // ========================================================
    // SAFE SUMMARY VALUES
    // ========================================================

    const totals =
        summary?.totals || {};


    const standalone =
        summary?.standalone || {};


    const farms =
        Array.isArray(summary?.farms)

            ? summary.farms

            : [];


    // ========================================================
    // FARM TOTALS
    //
    // Farm current worth is based on the farm record itself.
    //
    // Farm liabilities include:
    //
    //     1. Farm's own liability
    //     2. Liabilities belonging to farm assets
    //
    // The service provides:
    //
    //     farmLiabilities
    //     totalLiabilities
    // ========================================================

    let farmCurrentWorth = 0;

    let farmLiabilities = 0;

    let farmProfit = 0;


    farms.forEach(
        function(item) {

            farmCurrentWorth +=
                Number(
                    item?.farm?.currentWorth
                ) || 0;


            farmLiabilities +=
                Number(
                    item?.totalLiabilities
                ) || 0;


            if (
                item?.profit !== null &&
                item?.profit !== undefined
            ) {

                farmProfit +=
                    Number(
                        item.profit
                    ) || 0;

            }

        }
    );
%>


<div class="financial-page summary-page">


    <!-- ======================================================
         HEADER
         ====================================================== -->

    <div class="financial-page-header">

        <div>

            <span class="financial-eyebrow">

                FINANCIALS

            </span>

            <h1 class="financial-title">

                Financial Summary

            </h1>

            <p class="financial-subtitle">

                Overview of current worth, liabilities,
                and realized profit.

            </p>

        </div>


        <div>

            <a
                href="/financials/liability"
                class="financial-button financial-button-primary"
            >

                <i class="bi bi-plus-circle"></i>

                Record Liability

            </a>

        </div>

    </div>


    <!-- ======================================================
         DATE FILTER
         ====================================================== -->

    <section class="financial-filter-card">


        <div class="financial-filter-header">

            <div>

                <h2>

                    Analysis Period

                </h2>

                <p>

                    Leave the dates empty for lifetime analysis.

                </p>

            </div>


            <i class="bi bi-calendar3"></i>

        </div>


        <form
            method="GET"
            action="/financials"
            class="financial-filter-form"
        >


            <div class="financial-filter-group">

                <label for="startDate">

                    From

                </label>

                <input
                    type="date"
                    id="startDate"
                    name="startDate"
                    value="<%= filters?.startDate || '' %>"
                >

            </div>


            <div class="financial-filter-group">

                <label for="endDate">

                    To

                </label>

                <input
                    type="date"
                    id="endDate"
                    name="endDate"
                    value="<%= filters?.endDate || '' %>"
                >

            </div>


            <button
                type="submit"
                class="financial-button financial-button-primary"
            >

                <i class="bi bi-funnel"></i>

                Apply Filter

            </button>


            <% if (
                filters?.startDate ||
                filters?.endDate
            ) { %>

                <a
                    href="/financials"
                    class="financial-clear-filter"
                >

                    Clear

                </a>

            <% } %>


        </form>


        <div class="financial-period">

            <i class="bi bi-clock-history"></i>


            <% if (
                filters?.startDate ||
                filters?.endDate
            ) { %>

                Filtered analysis


                <% if (filters?.startDate) { %>

                    from

                    <strong>

                        <%= filters.startDate %>

                    </strong>

                <% } %>


                <% if (filters?.endDate) { %>

                    to

                    <strong>

                        <%= filters.endDate %>

                    </strong>

                <% } %>


            <% } else { %>

                Lifetime analysis

            <% } %>

        </div>


    </section>


    <!-- ======================================================
         TOP LEVEL SUMMARY
         ====================================================== -->

    <section class="financial-summary-grid">


        <!-- ==================================================
             CURRENT WORTH
             ================================================== -->

        <article class="financial-summary-card">

            <div class="financial-summary-icon">

                <i class="bi bi-building"></i>

            </div>


            <div>

                <span class="financial-summary-label">

                    Total Current Worth

                </span>


                <strong class="financial-summary-value">

                    KSh
                    <%= formatMoney(
                        totals.currentWorth
                    ) %>

                </strong>

            </div>

        </article>


        <!-- ==================================================
             LIABILITIES
             ================================================== -->

        <article class="financial-summary-card">

            <div class="financial-summary-icon">

                <i class="bi bi-receipt"></i>

            </div>


            <div>

                <span class="financial-summary-label">

                    Total Liabilities

                </span>


                <strong class="financial-summary-value">

                    KSh
                    <%= formatMoney(
                        totals.liabilities
                    ) %>

                </strong>

            </div>

        </article>


        <!-- ==================================================
             PROFIT
             ================================================== -->

        <article
            class="
                financial-summary-card

                <%= totals.profit !== null &&
                    totals.profit !== undefined &&
                    Number(totals.profit) < 0

                        ? 'financial-profit-negative'

                        : ''
                %>
            "
        >

            <div class="financial-summary-icon">

                <i class="bi bi-graph-up-arrow"></i>

            </div>


            <div>

                <span class="financial-summary-label">

                    Total Profit

                </span>


                <strong
                    class="
                        financial-summary-value
                        <%= profitClass(
                            totals.profit
                        ) %>
                    "
                >

                    <%= profitText(
                        totals.profit
                    ) %>

                </strong>

            </div>

        </article>


    </section>


    <!-- ======================================================
         CATEGORY SUMMARY
         ====================================================== -->

    <section class="financial-section">


        <div class="financial-section-header">

            <span class="financial-eyebrow">

                BREAKDOWN

            </span>


            <h2>

                Assets & Dairy Farms

            </h2>


            <p>

                Financial position grouped by asset category.

            </p>

        </div>


        <div class="financial-category-grid">


            <!-- ==================================================
                 STANDALONE ASSETS
                 ================================================== -->

            <article class="financial-category-card">


                <div class="financial-category-header">

                    <div>

                        <span class="financial-category-label">

                            STANDALONE ASSETS

                        </span>


                        <h3>

                            Standalone Assets

                        </h3>

                    </div>


                    <i class="bi bi-box"></i>

                </div>


                <div class="financial-metric-list">


                    <!-- CURRENT WORTH -->

                    <div class="financial-metric">

                        <span>

                            Current Worth

                        </span>


                        <strong>

                            KSh
                            <%= formatMoney(
                                standalone.currentWorth
                            ) %>

                        </strong>

                    </div>


                    <!-- LIABILITIES -->

                    <div class="financial-metric">

                        <span>

                            Total Liabilities

                        </span>


                        <strong class="financial-liability-text">

                            KSh
                            <%= formatMoney(
                                standalone.liabilities
                            ) %>

                        </strong>

                    </div>


                    <!-- PROFIT -->

                    <div class="financial-metric">

                        <span>

                            Total Profit

                        </span>


                        <strong
                            class="<%= profitClass(
                                standalone.profit
                            ) %>"
                        >

                            <%= profitText(
                                standalone.profit
                            ) %>

                        </strong>

                    </div>


                </div>


            </article>


            <!-- ==================================================
                 DAIRY FARMS
                 ================================================== -->

            <article class="financial-category-card">


                <div class="financial-category-header">

                    <div>

                        <span class="financial-category-label">

                            FARMS

                        </span>


                        <h3>

                            Dairy Farms

                        </h3>

                    </div>


                    <i class="bi bi-diagram-3"></i>

                </div>


                <div class="financial-metric-list">


                    <!-- CURRENT WORTH -->

                    <div class="financial-metric">

                        <span>

                            Current Worth

                        </span>


                        <strong>

                            KSh
                            <%= formatMoney(
                                farmCurrentWorth
                            ) %>

                        </strong>

                    </div>


                    <!-- LIABILITIES -->

                    <div class="financial-metric">

                        <span>

                            Total Liabilities

                        </span>


                        <strong class="financial-liability-text">

                            KSh
                            <%= formatMoney(
                                farmLiabilities
                            ) %>

                        </strong>

                    </div>


                    <!-- PROFIT -->

                    <div class="financial-metric">

                        <span>

                            Total Profit

                        </span>


                        <strong
                            class="<%= profitClass(
                                farmProfit
                            ) %>"
                        >

                            <%= profitText(
                                farmProfit
                            ) %>

                        </strong>

                    </div>


                </div>


            </article>


        </div>

    </section>


    <!-- ======================================================
         INDIVIDUAL FARM ANALYTICS
         ====================================================== -->

    <section class="financial-section">


        <div class="financial-section-header">

            <span class="financial-eyebrow">

                FARM ANALYTICS

            </span>


            <h2>

                Dairy Farm Financials

            </h2>


            <p>

                Each farm includes its own financial records
                and the financial records of its assets.

            </p>

        </div>


        <% if (
            farms.length
        ) { %>


            <div class="financial-farm-summary-grid">


                <% farms.forEach(
                    function(item)
                { %>


                    <%
                        const farm =
                            item?.farm || {};

                        const farmProfitValue =
                            item?.profit;
                    %>


                    <article
                        class="
                            financial-farm-summary-card

                            <%= farmProfitValue !== null &&
                                farmProfitValue !== undefined &&
                                Number(farmProfitValue) < 0

                                    ? 'financial-farm-negative'

                                    : ''
                            %>
                        "
                    >


                        <!-- ==================================
                             FARM HEADER
                             ================================== -->

                        <div class="financial-farm-summary-header">

                            <div>

                                <span>

                                    Farm Code:

                                    <%= farm.code ?? "—" %>

                                </span>


                                <h3>

                                    <%= farm.name || "Unnamed Farm" %>

                                </h3>

                            </div>


                            <i class="bi bi-building"></i>

                        </div>


                        <!-- ==================================
                             FARM METRICS
                             ================================== -->

                        <div class="financial-farm-metrics">


                            <!-- CURRENT WORTH -->

                            <div>

                                <span>

                                    Current Worth

                                </span>


                                <strong>

                                    KSh
                                    <%= formatMoney(
                                        farm.currentWorth
                                    ) %>

                                </strong>

                            </div>


                            <!-- LIABILITIES -->

                            <div>

                                <span>

                                    Liabilities

                                </span>


                                <strong
                                    class="financial-liability-text"
                                >

                                    KSh
                                    <%= formatMoney(
                                        item.totalLiabilities
                                    ) %>

                                </strong>

                            </div>


                            <!-- PROFIT -->

                            <div>

                                <span>

                                    Profit

                                </span>


                                <strong
                                    class="<%= profitClass(
                                        farmProfitValue
                                    ) %>"
                                >

                                    <%= profitText(
                                        farmProfitValue
                                    ) %>

                                </strong>

                            </div>


                        </div>


                        <!-- ==================================
                             LIABILITY BREAKDOWN
                             ================================== -->

                        <div class="financial-farm-liability-breakdown">


                            <div>

                                <span>

                                    Farm's Own Liabilities

                                </span>


                                <strong>

                                    KSh
                                    <%= formatMoney(
                                        item.farmLiabilities
                                    ) %>

                                </strong>

                            </div>


                            <div>

                                <span>

                                    Farm Assets

                                </span>


                                <strong>

                                    <%= Array.isArray(item.assets)
                                        ? item.assets.length
                                        : 0
                                    %>

                                </strong>

                            </div>


                        </div>


                        <!-- ==================================
                             NOTE
                             ================================== -->

                        <div class="financial-farm-note">

                            <i class="bi bi-info-circle"></i>


                            <span>

                                Total liabilities include the
                                farm's own liability and the
                                liabilities of its assets.

                            </span>

                        </div>


                    </article>


                <% }); %>


            </div>


        <% } else { %>


            <div class="financial-empty">

                <i class="bi bi-building"></i>


                <strong>

                    No dairy farms found

                </strong>


                <span>

                    There are currently no dairy farms
                    available for financial analysis.

                </span>

            </div>


        <% } %>


    </section>


</div>


<style>

/* ==========================================================
   FINANCIAL SUMMARY PAGE
   ========================================================== */

.financial-page{

    --financial-green:#2f7d4a;
    --financial-green-dark:#236238;
    --financial-green-light:#eaf6ee;
    --financial-green-soft:#f4faf6;

    --financial-red:#c0392b;
    --financial-red-light:#fceceb;

    --financial-text:#243329;
    --financial-muted:#718078;

    padding:24px;

    max-width:1400px;

    margin:0 auto;

}


/* ==========================================================
   HEADER
   ========================================================== */

.financial-page-header{

    display:flex;

    justify-content:space-between;

    align-items:center;

    gap:20px;

    margin-bottom:25px;

}


.financial-eyebrow{

    display:block;

    color:var(--financial-green);

    font-size:.72rem;

    font-weight:800;

    letter-spacing:.12em;

    margin-bottom:5px;

}


.financial-title{

    margin:0;

    color:var(--financial-text);

    font-size:clamp(1.6rem,4vw,2.2rem);

}


.financial-subtitle{

    margin:7px 0 0;

    color:var(--financial-muted);

}


/* ==========================================================
   BUTTONS
   ========================================================== */

.financial-button{

    display:inline-flex;

    align-items:center;

    justify-content:center;

    gap:8px;

    padding:11px 16px;

    border:0;

    border-radius:10px;

    text-decoration:none;

    font:inherit;

    font-weight:600;

    cursor:pointer;

}


.financial-button-primary{

    background:var(--financial-green);

    color:#fff;

}


.financial-button-primary:hover{

    background:var(--financial-green-dark);

}


/* ==========================================================
   FILTER CARD
   ========================================================== */

.financial-filter-card{

    background:#fff;

    padding:20px;

    border-radius:17px;

    box-shadow:0 3px 16px rgba(0,0,0,.06);

    margin-bottom:28px;

}


.financial-filter-header{

    display:flex;

    justify-content:space-between;

    align-items:flex-start;

    gap:15px;

    margin-bottom:18px;

}


.financial-filter-header h2{

    margin:0;

    font-size:1.05rem;

    color:var(--financial-text);

}


.financial-filter-header p{

    margin:4px 0 0;

    color:var(--financial-muted);

    font-size:.82rem;

}


.financial-filter-header > i{

    color:var(--financial-green);

    font-size:1.2rem;

}


.financial-filter-form{

    display:flex;

    align-items:flex-end;

    gap:12px;

    flex-wrap:wrap;

}


.financial-filter-group{

    min-width:190px;

    flex:1;

}


.financial-filter-group label{

    display:block;

    margin-bottom:6px;

    color:var(--financial-text);

    font-size:.8rem;

    font-weight:600;

}


.financial-filter-group input{

    width:100%;

    box-sizing:border-box;

    padding:11px 12px;

    border:1px solid #dce5df;

    border-radius:10px;

    outline:none;

    font:inherit;

}


.financial-filter-group input:focus{

    border-color:var(--financial-green);

    box-shadow:
        0 0 0 3px
        rgba(47,125,74,.1);

}


.financial-clear-filter{

    color:var(--financial-green);

    text-decoration:none;

    padding:11px 5px;

    font-weight:600;

    font-size:.85rem;

}


.financial-period{

    display:flex;

    align-items:center;

    gap:7px;

    margin-top:15px;

    padding-top:13px;

    border-top:1px solid #edf1ee;

    color:var(--financial-muted);

    font-size:.8rem;

}


.financial-period i{

    color:var(--financial-green);

}


/* ==========================================================
   TOP SUMMARY
   ========================================================== */

.financial-summary-grid{

    display:grid;

    grid-template-columns:
        repeat(3,minmax(0,1fr));

    gap:16px;

    margin-bottom:36px;

}


.financial-summary-card{

    display:flex;

    align-items:center;

    gap:15px;

    padding:20px;

    background:#fff;

    border-radius:17px;

    box-shadow:
        0 3px 16px
        rgba(0,0,0,.06);

    border-left:4px solid
        var(--financial-green);

}


.financial-summary-icon{

    width:46px;

    height:46px;

    display:flex;

    align-items:center;

    justify-content:center;

    border-radius:13px;

    background:
        var(--financial-green-light);

    color:var(--financial-green);

    font-size:1.2rem;

    flex-shrink:0;

}


.financial-summary-label{

    display:block;

    color:var(--financial-muted);

    font-size:.78rem;

    margin-bottom:4px;

}


.financial-summary-value{

    display:block;

    color:var(--financial-green-dark);

    font-size:1.25rem;

}


.financial-profit-negative{

    border-left-color:
        var(--financial-red);

    background:
        var(--financial-red-light);

}


/* ==========================================================
   SECTIONS
   ========================================================== */

.financial-section{

    margin-bottom:38px;

}


.financial-section-header{

    margin-bottom:16px;

}


.financial-section-header h2{

    margin:0;

    color:var(--financial-text);

    font-size:1.35rem;

}


.financial-section-header p{

    margin:5px 0 0;

    color:var(--financial-muted);

    font-size:.87rem;

}


/* ==========================================================
   CATEGORY CARDS
   ========================================================== */

.financial-category-grid{

    display:grid;

    grid-template-columns:
        repeat(2,minmax(0,1fr));

    gap:18px;

}


.financial-category-card{

    background:#fff;

    border-radius:17px;

    padding:20px;

    box-shadow:
        0 3px 16px
        rgba(0,0,0,.06);

}


.financial-category-header{

    display:flex;

    align-items:center;

    justify-content:space-between;

    padding-bottom:15px;

    border-bottom:1px solid #edf1ee;

}


.financial-category-label{

    display:block;

    color:var(--financial-green);

    font-size:.68rem;

    font-weight:800;

    letter-spacing:.08em;

}


.financial-category-header h3{

    margin:4px 0 0;

    color:var(--financial-text);

    font-size:1.05rem;

}


.financial-category-header > i{

    color:var(--financial-green);

    font-size:1.25rem;

}


/* ==========================================================
   METRICS
   ========================================================== */

.financial-metric-list{

    display:flex;

    flex-direction:column;

}


.financial-metric{

    display:flex;

    justify-content:space-between;

    align-items:center;

    gap:15px;

    padding:13px 0;

    border-bottom:1px solid #f0f3f1;

}


.financial-metric:last-child{

    border-bottom:0;

    padding-bottom:0;

}


.financial-metric span{

    color:var(--financial-muted);

    font-size:.85rem;

}


.financial-metric strong{

    color:var(--financial-text);

    text-align:right;

}


.financial-liability-text{

    color:var(--financial-green-dark) !important;

}


.financial-positive{

    color:var(--financial-green-dark) !important;

}


.financial-negative{

    color:var(--financial-red) !important;

}


/* ==========================================================
   FARM SUMMARY
   ========================================================== */

.financial-farm-summary-grid{

    display:grid;

    grid-template-columns:
        repeat(2,minmax(0,1fr));

    gap:18px;

}


.financial-farm-summary-card{

    background:#fff;

    border-radius:17px;

    padding:20px;

    box-shadow:
        0 3px 16px
        rgba(0,0,0,.06);

    border-left:4px solid
        var(--financial-green);

}


.financial-farm-summary-card.financial-farm-negative{

    border-left-color:
        var(--financial-red);

}


/* ==========================================================
   FARM HEADER
   ========================================================== */

.financial-farm-summary-header{

    display:flex;

    justify-content:space-between;

    align-items:flex-start;

    gap:15px;

    padding-bottom:15px;

    border-bottom:1px solid #edf1ee;

}


.financial-farm-summary-header span{

    color:var(--financial-muted);

    font-size:.72rem;

}


.financial-farm-summary-header h3{

    margin:4px 0 0;

    color:var(--financial-text);

    font-size:1.1rem;

}


.financial-farm-summary-header > i{

    color:var(--financial-green);

    font-size:1.25rem;

}


/* ==========================================================
   FARM METRICS
   ========================================================== */

.financial-farm-metrics{

    display:grid;

    grid-template-columns:
        repeat(3,minmax(0,1fr));

    gap:12px;

    padding:18px 0;

}


.financial-farm-metrics span{

    display:block;

    color:var(--financial-muted);

    font-size:.73rem;

    margin-bottom:5px;

}


.financial-farm-metrics strong{

    display:block;

    color:var(--financial-text);

    font-size:.92rem;

}


/* ==========================================================
   FARM LIABILITY BREAKDOWN
   ========================================================== */

.financial-farm-liability-breakdown{

    display:grid;

    grid-template-columns:
        repeat(2,minmax(0,1fr));

    gap:10px;

    padding:

        12px

        0;

    border-top:
