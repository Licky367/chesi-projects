}


.financial-summary-icon{

    width:46px;

    height:46px;

    display:flex;

    align-items:center;

    justify-content:center;

    border-radius:13px;

    background:
        var(--financial-green-light);

    color:var(--financial-green);

    font-size:1.2rem;

    flex-shrink:0;

}


.financial-summary-label{

    display:block;

    color:var(--financial-muted);

    font-size:.78rem;

    margin-bottom:4px;

}


.financial-summary-value{

    display:block;

    color:var(--financial-green-dark);

    font-size:1.25rem;

}


.financial-summary-hint{

    display:block;

    margin-top:4px;

    color:var(--financial-muted);

    font-size:.68rem;

}


.financial-profit-negative{

    border-left-color:
        var(--financial-red);

    background:
        var(--financial-red-light);

}


/* ==========================================================
   SECTIONS
   ========================================================== */

.financial-section{

    margin-bottom:38px;

}


.financial-section-header{

    margin-bottom:16px;

}


.financial-section-header h2{

    margin:0;

    color:var(--financial-text);

    font-size:1.35rem;

}


.financial-section-header p{

    margin:5px 0 0;

    color:var(--financial-muted);

    font-size:.87rem;

    line-height:1.5;

}


/* ==========================================================
   CATEGORY CARDS
