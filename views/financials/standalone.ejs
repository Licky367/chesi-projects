/* ==========================================================
   PERIOD NOTE
   ========================================================== */

.financial-period-note{

    display:flex;

    align-items:center;

    gap:8px;

    padding:10px 13px;

    margin-bottom:20px;

    border-radius:10px;

    background:var(--financial-green-soft);

    color:var(--financial-muted);

    font-size:.75rem;

}


.financial-period-note i{

    color:var(--financial-green);

}


/* ==========================================================
   SECTION
   ========================================================== */

.financial-section{

    margin-bottom:20px;

}


.financial-section-header{

    margin-bottom:12px;

}


.financial-section-header h2{

    margin:0;

    color:var(--financial-text);

    font-size:1.25rem;

}


/* ==========================================================
   TABLE
   ========================================================== */

.financial-table-wrapper{

    width:100%;

    overflow-x:auto;

    background:#fff;

    border-radius:15px;

    box-shadow:
        0 3px 16px
        rgba(0,0,0,.06);

}


.financial-table{

    width:100%;

    min-width:980px;

    border-collapse:collapse;

}


.financial-table th,
.financial-table td{

    padding:14px 15px;

    border-bottom:1px solid #edf1ee;

    text-align:right;

    white-space:nowrap;

    color:var(--financial-text);

    font-size:.82rem;

}


.financial-table th:first-child,
.financial-table td:first-child{

    text-align:left;

}


.financial-table thead th{

    background:#f8faf9;

    color:var(--financial-muted);

    font-size:.7rem;

    font-weight:800;

    text-transform:uppercase;

    letter-spacing:.05em;

}


.financial-table tbody tr:hover{

    background:var(--financial-green-soft);

}


.financial-table-name{

    display:flex;

    flex-direction:column;

    gap:2px;

    color:var(--financial-text);

    text-decoration:none;

}


.financial-table-name:hover strong{

    color:var(--financial-green);

}


.financial-table-name small{

    color:var(--financial-muted);

    font-size:.68rem;

}


.financial-table tfoot th,
.financial-table tfoot td{

    background:var(--financial-green-soft);

    border-bottom:0;

    color:var(--financial-green-dark);

    font-weight:800;

}


.financial-table-empty{

    height:140px;

    text-align:center !important;

}


.financial-table-empty i{

    display:block;

    margin-bottom:7px;

    color:var(--financial-green);

    font-size:1.4rem;

}


.financial-table-empty strong{

    display:block;

}


.financial-table-empty span{

    display:block;

    margin-top:3px;

    color:var(--financial-muted);

    font-size:.75rem;

}


/* ==========================================================
   PROFIT
   ========================================================== */

.financial-positive{

    color:var(--financial-green-dark) !important;

}


.financial-negative{

    color:var(--financial-red) !important;

}


/* ==========================================================
   FORMULA
   ========================================================== */

.financial-formula-note{

    display:flex;

    align-items:flex-start;

    gap:10px;

    padding:13px 15px;

    border-radius:12px;

    background:var(--financial-green-soft);

    color:var(--financial-muted);

}


.financial-formula-note i{

    color:var(--financial-green);

}


.financial-formula-note strong{

    display:block;

    margin-bottom:2px;

    color:var(--financial-text);

    font-size:.78rem;

}


.financial-formula-note span{

    font-size:.75rem;

}


/* ==========================================================
   MOBILE
   ========================================================== */

@media(max-width:650px){

    .standalone-financial-page{

        padding:16px;

    }


    .standalone-financial-page
    .financial-page-header{

        align-items:flex-start;

        flex-direction:column;

    }


    .standalone-financial-page
    .financial-page-header
    .financial-button{

        width:100%;

    }


    .financial-filter-form{

        flex-wrap:wrap;

    }


    .financial-filter-group{

        min-width:calc(50% - 5px);

    }


    .financial-filter-form
    .financial-button{

        flex:1;

    }


    .financial-clear-filter{

        width:100%;

        padding-left:0;

    }

}

</style>