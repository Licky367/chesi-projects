.financial-table{

    width:100%;

    min-width:1050px;

    border-collapse:collapse;

}


.standalone-financial-page
.financial-table th,
.standalone-financial-page
.financial-table td{

    padding:14px 15px;

    border-bottom:1px solid #edf1ee;

