    display:inline-block;

    padding:5px 8px;

    border-radius:7px;

    background:var(--financial-green-light);

    color:var(--financial-green-dark);

    font-size:.68rem;

    font-weight:700;

}


/* ==========================================================
   TOTAL
   ========================================================== */

