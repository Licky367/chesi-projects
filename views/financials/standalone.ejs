.financial-table th:first-child,
.standalone-financial-page
.financial-table td:first-child{

    text-align:left;

}


.standalone-financial-page
.financial-table thead th{

    background:#f8faf9;

    color:var(--financial-muted);

    font-size:.68rem;

    font-weight:800;

    text-transform:uppercase;

    letter-spacing:.05em;

}


/* ==========================================================
   CLICKABLE ROW
   ========================================================== */

.standalone-financial-page
.financial-asset-row{

    cursor:pointer;

    transition:
        background .15s ease,
        box-shadow .15s ease;

}


