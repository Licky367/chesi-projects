<% /* ==========================================================
FINANCIAL / STANDALONE ASSETS PAGE
========================================================== */

/* ==========================================================
HELPERS
========================================================== */

function number(value) {

    const result = Number(value);

    return Number.isFinite(result)
        ? result
        : 0;

}


function formatMoney(value) {

    const amount = Number(value);

    if (!Number.isFinite(amount)) {

        return "—";

    }

    return amount.toLocaleString(
        "en-KE",
        {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
        }
    );

}


function profitClass(value) {

    return number(value) < 0
        ? "financial-negative"
        : "financial-positive";

}


function profitText(value) {

    const amount =
        number(value);

    return amount < 0

        ? "-KSh " +
          formatMoney(
              Math.abs(amount)
          )

        : "KSh " +
          formatMoney(amount);

}


/* ==========================================================
SAFE DATA
========================================================== */

const standaloneData =
    standalone || {};


const assets =
    Array.isArray(
        standaloneData.assets
    )
        ? standaloneData.assets
        : [];


const filterStart =
    filters?.startDate || "";


const filterEnd =
    filters?.endDate || "";


const hasFilter =
    Boolean(
        filterStart ||
        filterEnd
    );


/* ==========================================================
TOTALS
========================================================== */

let totalCurrentWorth = 0;

let totalBuyingPrice = 0;

let totalSellingPrice = 0;

let totalRevenue = 0;

let totalLiabilities = 0;

let totalProfit = 0;


/* ==========================================================
CALCULATE TOTALS
========================================================== */

assets.forEach(function(asset) {

    const currentWorth =
        number(
            asset?.currentWorth
        );


    const buyingPrice =
        number(
            asset?.buyingPrice
        );


    const sellingPrice =
        number(
            asset?.sellingPrice
        );


    const revenue =
        number(
            asset?.revenue
        );


    const liabilities =
        number(
            asset?.liabilities
        );


    const profit =

        sellingPrice
        -
        buyingPrice
        -
        liabilities
        +
        revenue;


    totalCurrentWorth +=
        currentWorth;


    totalBuyingPrice +=
        buyingPrice;


    totalSellingPrice +=
        sellingPrice;


    totalRevenue +=
        revenue;


    totalLiabilities +=
        liabilities;


    totalProfit +=
        profit;

});


/* ==========================================================
SERVICE TOTALS
========================================================== */

if (
    standaloneData.currentWorth !== undefined &&
    standaloneData.currentWorth !== null
) {

    totalCurrentWorth =
        number(
            standaloneData.currentWorth
        );

}


if (
    standaloneData.buyingPrice !== undefined &&
    standaloneData.buyingPrice !== null
) {

    totalBuyingPrice =
        number(
            standaloneData.buyingPrice
        );

}


if (
    standaloneData.sellingPrice !== undefined &&
    standaloneData.sellingPrice !== null
) {

    totalSellingPrice =
        number(
            standaloneData.sellingPrice
        );

}


/* ==========================================================
BACKWARDS COMPATIBILITY
========================================================== */

if (
    standaloneData.salesAmount !== undefined &&
    standaloneData.salesAmount !== null
) {

    totalSellingPrice =
        number(
            standaloneData.salesAmount
        );

}


if (
    standaloneData.revenue !== undefined &&
    standaloneData.revenue !== null
) {

    totalRevenue =
        number(
            standaloneData.revenue
        );

}


if (
    standaloneData.liabilities !== undefined &&
    standaloneData.liabilities !== null
) {

    totalLiabilities =
        number(
            standaloneData.liabilities
        );

}


/* ==========================================================
TOTAL PROFIT
========================================================== */

if (
    standaloneData.profit !== undefined &&
    standaloneData.profit !== null
) {

    totalProfit =
        number(
            standaloneData.profit
        );

} else {

    totalProfit =

        totalSellingPrice
        -
        totalBuyingPrice
        -
        totalLiabilities
        +
        totalRevenue;

}


/* ==========================================================
SORT ASSETS
========================================================== */

assets.sort(function(a, b) {

    const profitA =

        a?.profit !== undefined &&
        a?.profit !== null

            ? number(a.profit)

            : (
                number(a?.sellingPrice)
                -
                number(a?.buyingPrice)
                -
                number(a?.liabilities)
                +
                number(a?.revenue)
            );


    const profitB =

        b?.profit !== undefined &&
        b?.profit !== null

            ? number(b.profit)

            : (
                number(b?.sellingPrice)
                -
                number(b?.buyingPrice)
                -
                number(b?.liabilities)
                +
                number(b?.revenue)
            );


    if (profitA !== profitB) {

        return profitB - profitA;

    }


    return (

        number(b?.currentWorth)
        -
        number(a?.currentWorth)

    );

});

%>


<div class="financial-page standalone-financial-page">


    <!-- ======================================================
         HEADER
         ====================================================== -->

    <div class="financial-page-header">


        <div>

            <span class="financial-eyebrow">

                FINANCIALS

            </span>


            <h1 class="financial-title">

                Standalone Assets

            </h1>


            <p class="financial-subtitle">

                Financial performance of assets that do not
                belong to any Dairy Farm.

            </p>

        </div>


        <a
            href="/financials/summary"
            class="financial-button financial-button-secondary"
        >

            <i class="bi bi-arrow-left"></i>

            Summary

        </a>


    </div>


    <!-- ======================================================
         CURRENT NET WORTH
         ====================================================== -->

    <section class="financial-worth-card">


        <div class="financial-worth-icon">

            <i class="bi bi-box-seam"></i>

        </div>


        <div>

            <span>

                Current Net Worth

            </span>


            <strong>

                KSh
                <%= formatMoney(
                    totalCurrentWorth
                ) %>

            </strong>


            <small>

                Current value — not affected by date filter

            </small>

        </div>


    </section>


    <!-- ======================================================
         FILTER
         ====================================================== -->

    <section class="financial-filter-card">


        <form
            method="GET"
            action="/financials/standalone"
            class="financial-filter-form"
        >


            <div class="financial-filter-group">

                <label for="startDate">

                    From

                </label>


                <input
                    type="date"
                    id="startDate"
                    name="startDate"
                    value="<%= filterStart %>"
                >

            </div>


            <div class="financial-filter-group">

                <label for="endDate">

                    To

                </label>


                <input
                    type="date"
                    id="endDate"
                    name="endDate"
                    value="<%= filterEnd %>"
                >

            </div>


            <button
                type="submit"
                class="financial-button financial-button-primary"
            >

                <i class="bi bi-funnel"></i>

                Apply

            </button>


            <% if (hasFilter) { %>

                <a
                    href="/financials/standalone"
                    class="financial-clear-filter"
                >

                    <i class="bi bi-x-circle"></i>

                    Clear

                </a>

            <% } %>


        </form>


        <% if (hasFilter) { %>

            <div class="financial-filter-status">

                <i class="bi bi-calendar3"></i>

                Showing revenue, liabilities and
                profit/loss for the selected period.

                Current worth, buying price and selling
                price remain current.

            </div>

        <% } %>


    </section>


    <!-- ======================================================
         ASSET SECTION
         ====================================================== -->

    <section class="financial-section">


        <div class="financial-section-header">


            <div>

                <span class="financial-eyebrow">

                    STANDALONE ASSETS

                </span>


                <h2>

                    All Standalone Assets

                </h2>


                <p class="financial-section-description">

                    Assets that are not assigned to any
                    Dairy Farm.

                </p>

            </div>


            <span class="financial-count">

                <%= assets.length %>

                <%= assets.length === 1
                    ? "Asset"
                    : "Assets"
                %>

            </span>


        </div>


        <!-- ==================================================
             TABLE
             ================================================== -->

        <div class="financial-table-wrapper">


            <table class="financial-table">


                <thead>

                    <tr>

                        <th>
                            Asset
                        </th>

                        <th>
                            Type
                        </th>

                        <th>
                            Current Worth
                        </th>

                        <th>
                            Buying Price
                        </th>

                        <th>
                            Selling Price
                        </th>

                        <th>
                            Revenue
                        </th>

                        <th>
                            Liabilities
                        </th>

                        <th>
                            Profit / Loss
                        </th>

                    </tr>

                </thead>


                <tbody>


                    <% if (assets.length > 0) { %>


                        <% assets.forEach(function(asset) { %>


                            <%

                                const sellingPrice =
                                    number(
                                        asset?.sellingPrice
                                    );


                                const buyingPrice =
                                    number(
                                        asset?.buyingPrice
                                    );


                                const liabilities =
                                    number(
                                        asset?.liabilities
                                    );


                                const revenue =
                                    number(
                                        asset?.revenue
                                    );


                                const assetProfit =

                                    asset?.profit !== undefined &&
                                    asset?.profit !== null

                                        ? number(
                                            asset.profit
                                        )

                                        : (
                                            sellingPrice
                                            -
                                            buyingPrice
                                            -
                                            liabilities
                                            +
                                            revenue
                                        );


                                const assetId =
                                    asset?._id ||
                                    asset?.id ||
                                    "";

                            %>


                            <!-- ==================================================
                                 CLICKABLE ASSET ROW
                                 ================================================== -->

                            <% if (assetId) { %>

                                <tr
                                    class="financial-asset-row"
                                    onclick="window.location.href='/networth/asset/<%= assetId %>'"
                                    tabindex="0"
                                    role="link"
                                    onkeydown="
                                        if (
                                            event.key === 'Enter' ||
                                            event.key === ' '
                                        ) {
                                            event.preventDefault();
                                            window.location.href='/networth/asset/<%= assetId %>';
                                        }
                                    "
                                >

                            <% } else { %>

                                <tr
                                    class="financial-asset-row financial-asset-row-disabled"
                                >

                            <% } %>


                                <!-- ==============================================
                                     ASSET
                                     ============================================== -->

                                <td>


                                    <div
                                        class="financial-table-name"
                                    >


                                        <strong>

                                            <%= asset?.name ||
                                                "Unnamed Asset"
                                            %>

                                        </strong>


                                        <% if (
                                            asset?.description
                                        ) { %>

                                            <small>

                                                <%= asset.description %>

                                            </small>

                                        <% } %>


                                        <% if (
                                            asset?.code !== undefined &&
                                            asset?.code !== null
                                        ) { %>

                                            <small>

                                                Code:
                                                <%= asset.code %>

                                            </small>

                                        <% } else { %>

                                            <small>

                                                Standalone

                                            </small>

                                        <% } %>


                                    </div>


                                </td>


                                <!-- ==============================================
                                     TYPE
                                     ============================================== -->

                                <td>


                                    <span
                                        class="financial-type-badge"
                                    >

                                        <%= asset?.type ||
                                            "Other"
                                        %>

                                    </span>


                                </td>


                                <!-- ==============================================
                                     CURRENT WORTH
                                     ============================================== -->

                                <td>

                                    KSh
                                    <%= formatMoney(
                                        asset?.currentWorth
                                    ) %>

                                </td>


                                <!-- ==============================================
                                     BUYING PRICE
                                     ============================================== -->

                                <td>

                                    KSh
                                    <%= formatMoney(
                                        asset?.buyingPrice
                                    ) %>

                                </td>


                                <!-- ==============================================
                                     SELLING PRICE
                                     ============================================== -->

                                <td>

                                    KSh
                                    <%= formatMoney(
                                        asset?.sellingPrice
                                    ) %>

                                </td>


                                <!-- ==============================================
                                     REVENUE
                                     ============================================== -->

                                <td>

                                    KSh
                                    <%= formatMoney(
                                        asset?.revenue
                                    ) %>

                                </td>


                                <!-- ==============================================
                                     LIABILITIES
                                     ============================================== -->

                                <td>

                                    KSh
                                    <%= formatMoney(
                                        asset?.liabilities
                                    ) %>

                                </td>


                                <!-- ==============================================
                                     PROFIT / LOSS
                                     ============================================== -->

                                <td>

                                    <strong
                                        class="<%= profitClass(
                                            assetProfit
                                        ) %>"
                                    >

                                        <%= profitText(
                                            assetProfit
                                        ) %>

                                    </strong>

                                </td>


                            </tr>


                        <% }); %>


                    <% } else { %>


                        <tr>


                            <td
                                colspan="8"
                                class="financial-table-empty"
                            >


                                <i class="bi bi-box-seam"></i>


                                <strong>

                                    No standalone assets found

                                </strong>


                                <span>

                                    There are currently no
                                    assets outside a Dairy Farm.

                                </span>


                            </td>

                        </tr>


                    <% } %>


                </tbody>


                <!-- ==================================================
                     TOTAL
                     ================================================== -->

                <tfoot>


                    <tr>


                        <th colspan="2">

                            Total

                        </th>


                        <th>

                            KSh
                            <%= formatMoney(
                                totalCurrentWorth
                            ) %>

                        </th>


                        <th>

                            KSh
                            <%= formatMoney(
                                totalBuyingPrice
                            ) %>

                        </th>


                        <th>

                            KSh
                            <%= formatMoney(
                                totalSellingPrice
                            ) %>

                        </th>


                        <th>

                            KSh
                            <%= formatMoney(
                                totalRevenue
                            ) %>

                        </th>


                        <th>

                            KSh
                            <%= formatMoney(
                                totalLiabilities
                            ) %>

                        </th>


                        <th>

                            <strong
                                class="<%= profitClass(
                                    totalProfit
                                ) %>"
                            >

                                <%= profitText(
                                    totalProfit
                                ) %>

                            </strong>

                        </th>


                    </tr>


                </tfoot>


            </table>


        </div>


    </section>


    <!-- ======================================================
         FINANCIAL RULE
         ====================================================== -->

    <section class="financial-formula-note">


        <i class="bi bi-calculator"></i>


        <div>


            <strong>

                Profit / Loss calculation

            </strong>


            <span>

                Selling Price − Buying Price −
                Filtered Liabilities + Filtered Revenue

            </span>


        </div>


    </section>


</div>


<style>

/* ==========================================================
   PAGE
   ========================================================== */

