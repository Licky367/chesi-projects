.financial-asset-row:hover{

    background:var(--financial-green-soft);

}


.standalone-financial-page
.financial-asset-row:active{

    background:var(--financial-green-light);

}


.standalone-financial-page
.financial-asset-row:focus{

    outline:none;

    box-shadow:
        inset 3px 0 0
        var(--financial-green);

}


.standalone-financial-page
.financial-asset-row-disabled{

    cursor:default;

}


.standalone-financial-page
.financial-asset-row-disabled:hover{

    background:transparent;

}


/* ==========================================================
   ASSET NAME
   ========================================================== */

.standalone-financial-page
.financial-table-name{

    display:flex;

    flex-direction:column;

    gap:2px;

}


.standalone-financial-page
.financial-table-name strong{

    color:var(--financial-text);

    font-weight:700;

}


.standalone-financial-page
.financial-table-name small{

    color:var(--financial-muted);

    font-size:.68rem;

}


/* ==========================================================
   TYPE
   ========================================================== */

.standalone-financial-page
.financial-type-badge{

    display:inline-block;

    padding:5px 8px;

    border-radius:7px;

    background:var(--financial-green-light);

    color:var(--financial-green-dark);

    font-size:.68rem;

    font-weight:700;

}


/* ==========================================================
   TOTAL
   ========================================================== */

.standalone-financial-page
.financial-table tfoot th,
.standalone-financial-page
.financial-table tfoot td{

    background:var(--financial-green-soft);

    border-bottom:0;

    color:var(--financial-green-dark);

    font-weight:800;

}


/* ==========================================================
   EMPTY
   ========================================================== */

.standalone-financial-page
.financial-table-empty{

    height:150px;

    text-align:center !important;

}


.standalone-financial-page
.financial-table-empty i{

    display:block;

    margin-bottom:8px;

    color:var(--financial-green);

    font-size:1.5rem;

}


