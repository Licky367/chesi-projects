}


/* ==========================================================
   FILTER
   ========================================================== */

.standalone-financial-page
.financial-filter-card{

    padding:15px;

    margin-bottom:28px;

    background:#fff;

    border-radius:14px;

    box-shadow:
        0 2px 12px
        rgba(0,0,0,.05);

}


.standalone-financial-page
.financial-filter-form{

    display:flex;

    align-items:flex-end;

    gap:10px;

}


.standalone-financial-page
.financial-filter-group{

    flex:1;

}


.standalone-financial-page
.financial-filter-group label{

    display:block;

    margin-bottom:5px;

    color:var(--financial-muted);

    font-size:.72rem;

    font-weight:600;

}


.standalone-financial-page
.financial-filter-group input{

    width:100%;

    box-sizing:border-box;

    padding:9px 10px;

    border:1px solid #dce5df;

    border-radius:9px;

    background:#fff;

    color:var(--financial-text);

    font:inherit;

    outline:none;

}


.standalone-financial-page
.financial-filter-group input:focus{

    border-color:var(--financial-green);

    box-shadow:
