    background:var(--financial-green-soft);

    box-shadow:
        inset 3px 0 0
        var(--financial-green);

}


.standalone-financial-page
.financial-asset-row:active{

    background:var(--financial-green-light);

}


.standalone-financial-page
.financial-asset-row-disabled{

    cursor:default;

}


.standalone-financial-page
.financial-asset-row-disabled:hover{

    background:transparent;

}


