    margin-top:11px;

    padding-top:10px;

    border-top:1px solid #edf1ee;

    color:var(--financial-muted);

    font-size:.72rem;

}


.financial-filter-status i{

    color:var(--financial-green);

    margin-top:1px;

}


/* ==========================================================
   SECTION
   ========================================================== */

.financial-section{

    margin-bottom:20px;

}


.financial-section-header{

    display:flex;

    align-items:flex-end;

    justify-content:space-between;

    gap:15px;

    margin-bottom:12px;

}


.financial-section-header h2{

    margin:0;

    color:var(--financial-text);

    font-size:1.25rem;

}


.financial-section-description{

    margin:4px 0 0;

    color:var(--financial-muted);

    font-size:.76rem;

}


.financial-count{

    flex:0 0 auto;

    padding:6px 10px;

    border-radius:20px;

    background:var(--financial-green-light);

    color:var(--financial-green-dark);

    font-size:.72rem;

    font-weight:700;

}


/* ==========================================================
   TABLE
   ========================================================== */

.financial-table-wrapper{

    width:100%;

    overflow-x:auto;

    background:#fff;

    border-radius:15px;

    box-shadow:
        0 3px 16px
        rgba(0,0,0,.06);

}


.financial-table{

    width:100%;

    min-width:1050px;

    border-collapse:collapse;

}


.financial-table th,
.financial-table td{

    padding:14px 15px;

    border-bottom:1px solid #edf1ee;

