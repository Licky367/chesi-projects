    font:inherit;

    outline:none;

}


.financial-filter-group input:focus{

    border-color:var(--financial-green);

    box-shadow:
        0 0 0 3px
        rgba(47,125,74,.1);

}


.financial-clear-filter{

    display:inline-flex;

    align-items:center;

    gap:5px;

    padding:9px 4px;

    color:var(--financial-green);

