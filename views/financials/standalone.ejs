.financial-button-secondary{

    background:var(--financial-green-light);

    color:var(--financial-green-dark);

}


/* ==========================================================
   WORTH CARD
   ========================================================== */

.standalone-financial-page
.financial-worth-card{

    display:flex;

    align-items:center;

    gap:15px;

    padding:20px;

    margin-bottom:16px;

    background:#fff;

    border-radius:17px;

    border-left:4px solid
        var(--financial-green);

    box-shadow:
        0 3px 16px
        rgba(0,0,0,.06);

}


