<% /* ==========================================================
   FINANCIAL / STANDALONE ASSETS PAGE

   PURPOSE
   ----------------------------------------------------------
   This page displays ALL standalone assets in a table.

   There is NO individual standalone asset page.

   ROUTE:

       GET /financials/standalone

   EXPECTED BACKEND DATA:

       standalone: {

           currentWorth,
           buyingPrice,
           sellingPrice,
           revenue,
           liabilities,
           profit,

           assets: [

               {
                   _id,
                   name,
                   type,
                   code,

                   currentWorth,
                   buyingPrice,
                   sellingPrice,

                   revenue,
                   liabilities,
                   profit
               }

           ]

       }

       filters: {

           startDate,
           endDate

       }


   FINANCIAL RULES
   ----------------------------------------------------------

   CURRENT VALUES:

       currentWorth
       buyingPrice
       sellingPrice


   FILTERED VALUES:

       revenue
       liabilities
       profit/loss


   PROFIT / LOSS:

       sellingPrice
       - buyingPrice
       - liabilities
       + revenue


   IMPORTANT
   ----------------------------------------------------------

   Revenue is stored for each asset.

   Liabilities are stored as Financials transactions and
   are filtered according to startDate/endDate.

   Current worth, buying price and selling price are NOT
   affected by the date filter.

   ========================================================== */ %>


<%
/* ==========================================================
   HELPERS
   ========================================================== */

function number(value) {

    const result =
        Number(value);

    return Number.isFinite(result)
        ? result
        : 0;

}


function formatMoney(value) {

    const amount =
        Number(value);

    if (!Number.isFinite(amount)) {

        return "—";

    }

    return amount.toLocaleString(

        "en-KE",

        {

            minimumFractionDigits: 2,

            maximumFractionDigits: 2

        }

    );

}


function profitClass(value) {

    return number(value) < 0

        ? "financial-negative"

        : "financial-positive";

}


function profitText(value) {

    const amount =
        number(value);


    if (amount < 0) {

        return (

            "-KSh " +

            formatMoney(
                Math.abs(amount)
            )

        );

    }


    return (

        "KSh " +

        formatMoney(amount)

    );

}


/* ==========================================================
   SAFE DATA
   ========================================================== */

const standaloneData =
    standalone || {};


const assets =
    Array.isArray(
        standaloneData.assets
    )

        ? standaloneData.assets
        : [];


const filterStart =
    filters?.startDate || "";


const filterEnd =
    filters?.endDate || "";


const hasFilter =
    Boolean(

        filterStart ||

        filterEnd

    );


/* ==========================================================
   ASSET FINANCIAL CALCULATOR
   ==========================================================
//
// The backend should preferably supply `profit` and
// `liabilities` for every asset.
//
// This fallback keeps the template safe if one of those
// values is missing.
//

   ========================================================== */

function getAssetProfit(asset) {

    if (

        asset?.profit !== undefined &&

        asset?.profit !== null

    ) {

        return number(
            asset.profit
        );

    }


    return (

        number(
            asset?.sellingPrice
        )

        -

        number(
            asset?.buyingPrice
        )

        -

        number(
            asset?.liabilities
        )

        +

        number(
            asset?.revenue
        )

    );

}


/* ==========================================================
   CALCULATE TOTALS
   ========================================================== */

let totalCurrentWorth = 0;

let totalBuyingPrice = 0;

let totalSellingPrice = 0;

let totalRevenue = 0;

let totalLiabilities = 0;

let totalProfit = 0;


assets.forEach(function(asset) {

    totalCurrentWorth +=
        number(
            asset?.currentWorth
        );


    totalBuyingPrice +=
        number(
            asset?.buyingPrice
        );


    totalSellingPrice +=
        number(
            asset?.sellingPrice
        );


    totalRevenue +=
        number(
            asset?.revenue
        );


    totalLiabilities +=
        number(
            asset?.liabilities
        );


    totalProfit +=
        getAssetProfit(asset);

});


/* ==========================================================
   PREFER SERVICE TOTALS
   ========================================================== */

if (

    standaloneData.currentWorth !== undefined &&

    standaloneData.currentWorth !== null

) {

    totalCurrentWorth =
        number(
            standaloneData.currentWorth
        );

}


if (

    standaloneData.buyingPrice !== undefined &&

    standaloneData.buyingPrice !== null

) {

    totalBuyingPrice =
        number(
            standaloneData.buyingPrice
        );

}


if (

    standaloneData.sellingPrice !== undefined &&

    standaloneData.sellingPrice !== null

) {

    totalSellingPrice =
        number(
            standaloneData.sellingPrice
        );

}


if (

    standaloneData.revenue !== undefined &&

    standaloneData.revenue !== null

) {

    totalRevenue =
        number(
            standaloneData.revenue
        );

}


if (

    standaloneData.liabilities !== undefined &&

    standaloneData.liabilities !== null

) {

    totalLiabilities =
        number(
            standaloneData.liabilities
        );

}


if (

    standaloneData.profit !== undefined &&

    standaloneData.profit !== null

) {

    totalProfit =
        number(
            standaloneData.profit
        );

}


/* ==========================================================
   SORT ASSETS
   ----------------------------------------------------------
   1. Highest profit first
   2. Highest current worth on tie
   ========================================================== */

assets.sort(function(a, b) {

    const profitA =
        getAssetProfit(a);


    const profitB =
        getAssetProfit(b);


    if (profitA !== profitB) {

        return profitB - profitA;

    }


    return (

        number(
            b?.currentWorth
        )

        -

        number(
            a?.currentWorth
        )

    );

});

%>


<div class="financial-page standalone-financial-page">


    <!-- ======================================================
         HEADER
         ====================================================== -->

    <div class="financial-page-header">


        <div>

            <span class="financial-eyebrow">

                FINANCIALS

            </span>


            <h1 class="financial-title">

                Standalone Assets

            </h1>


            <p class="financial-subtitle">

                Financial performance of assets that do not
                belong to a dairy farm.

            </p>

        </div>


        <a
            href="/financials/summary"
            class="financial-button financial-button-secondary"
        >

            <i class="bi bi-arrow-left"></i>

            Summary

        </a>


    </div>


    <!-- ======================================================
         CURRENT NET WORTH
         ====================================================== -->

    <section class="financial-worth-card">


        <div class="financial-worth-icon">

            <i class="bi bi-box-seam"></i>

        </div>


        <div>

            <span>

                Current Net Worth

            </span>


            <strong>

                KSh
                <%= formatMoney(
                    totalCurrentWorth
                ) %>

            </strong>


            <small>

                Current value — independent of date filter

            </small>

        </div>


    </section>


    <!-- ======================================================
         FILTER
         ====================================================== -->

    <section class="financial-filter-card">


        <form
            method="GET"
            action="/financials/standalone"
            class="financial-filter-form"
        >


            <div class="financial-filter-group">


                <label for="startDate">

                    From

                </label>


                <input
                    type="date"
                    id="startDate"
                    name="startDate"
                    value="<%= filterStart %>"
                >


            </div>


            <div class="financial-filter-group">


                <label for="endDate">

                    To

                </label>


                <input
                    type="date"
                    id="endDate"
                    name="endDate"
                    value="<%= filterEnd %>"
                >


            </div>


            <button
                type="submit"
                class="financial-button financial-button-primary"
            >

                <i class="bi bi-funnel"></i>

                Apply

            </button>


            <% if (hasFilter) { %>


                <a
                    href="/financials/standalone"
                    class="financial-clear-filter"
                >

                    <i class="bi bi-x-circle"></i>

                    Clear

                </a>


            <% } %>


        </form>


    </section>


    <!-- ======================================================
         FILTER STATUS
         ====================================================== -->

    <% if (hasFilter) { %>


        <div class="financial-filter-status">


            <i class="bi bi-calendar3"></i>


            <span>

                Showing filtered revenue, liabilities and
                profit/loss


                <% if (filterStart && filterEnd) { %>

                    from
                    <strong>
                        <%= filterStart %>
                    </strong>

                    to

                    <strong>
                        <%= filterEnd %>
                    </strong>

                <% } else if (filterStart) { %>

                    from

                    <strong>
                        <%= filterStart %>
                    </strong>

                <% } else if (filterEnd) { %>

                    up to

                    <strong>
                        <%= filterEnd %>
                    </strong>

                <% } %>


            </span>


        </div>


    <% } %>


    <!-- ======================================================
         ASSET TABLE
         ====================================================== -->

    <section class="financial-section">


        <div class="financial-section-header">


            <span class="financial-eyebrow">

                ASSET BREAKDOWN

            </span>


            <h2>

                All Standalone Assets

            </h2>


            <p class="financial-section-description">

                Current asset values remain unchanged by the
                selected date range. Revenue, liabilities and
                profit/loss are period-based.

            </p>


        </div>


        <div class="financial-table-wrapper">


            <table class="financial-table">


                <thead>

                    <tr>


                        <th>

                            Asset

                        </th>


                        <th>

                            Buying Price

                        </th>


                        <th>

                            Selling Price

                        </th>


                        <th>

                            Current Worth

                        </th>


                        <th>

                            Revenue

                        </th>


                        <th>

                            Liabilities

                        </th>


                        <th>

                            Profit / Loss

                        </th>


                    </tr>

                </thead>


                <tbody>


                    <% if (assets.length) { %>


                        <% assets.forEach(function(asset) { %>


                            <%

                                const assetProfit =
                                    getAssetProfit(
                                        asset
                                    );


                                const assetLiabilities =
                                    number(
                                        asset?.liabilities
                                    );


                            %>


                            <tr>


                                <!-- ==================================
                                     ASSET
                                     ================================== -->


                                <td>


                                    <div
                                        class="financial-table-name"
                                    >


                                        <strong>

                                            <%= asset?.name ||
                                                "Unnamed Asset"
                                            %>

                                        </strong>


                                        <% if (asset?.type) { %>


                                            <small>

                                                <%= asset.type %>

                                            </small>


                                        <% } %>


                                        <% if (
                                            asset?.code !==
                                            undefined &&
                                            asset?.code !== null
                                        ) { %>


                                            <small>

                                                Code:
                                                <%= asset.code %>

                                            </small>


                                        <% } %>


                                    </div>


                                </td>


                                <!-- ==================================
                                     BUYING PRICE
                                     ================================== -->


                                <td>

                                    KSh
                                    <%= formatMoney(
                                        asset?.buyingPrice
                                    ) %>

                                </td>


                                <!-- ==================================
                                     SELLING PRICE
                                     ================================== -->


                                <td>

                                    KSh
                                    <%= formatMoney(
                                        asset?.sellingPrice
                                    ) %>

                                </td>


                                <!-- ==================================
                                     CURRENT WORTH
                                     ================================== -->


                                <td>

                                    KSh
                                    <%= formatMoney(
                                        asset?.currentWorth
                                    ) %>

                                </td>


                                <!-- ==================================
                                     REVENUE
                                     ================================== -->


                                <td>

                                    KSh
                                    <%= formatMoney(
                                        asset?.revenue
                                    ) %>

                                </td>


                                <!-- ==================================
                                     LIABILITIES
                                     ================================== -->


                                <td>

                                    <span
                                        class="<%= assetLiabilities > 0
                                            ? 'financial-negative'
                                            : 'financial-neutral'
                                        %>"
                                    >

                                        KSh
                                        <%= formatMoney(
                                            assetLiabilities
                                        ) %>

                                    </span>

                                </td>


                                <!-- ==================================
                                     PROFIT / LOSS
                                     ================================== -->


                                <td>


                                    <strong
                                        class="<%= profitClass(
                                            assetProfit
                                        ) %>"
                                    >

                                        <%= profitText(
                                            assetProfit
                                        ) %>

                                    </strong>


                                </td>


                            </tr>


                        <% }); %>


                    <% } else { %>


                        <tr>


                            <td
                                colspan="7"
                                class="financial-table-empty"
                            >


                                <i class="bi bi-box-seam"></i>


                                <strong>

                                    No standalone assets found

                                </strong>


                                <span>

                                    There are currently no
                                    standalone assets available
                                    for financial analysis.

                                </span>


                            </td>


                        </tr>


                    <% } %>


                </tbody>


                <!-- ==================================================
                     TOTAL
                     ================================================== -->

                <tfoot>


                    <tr>


                        <th>

                            Total

                        </th>


                        <th>

                            KSh
                            <%= formatMoney(
                                totalBuyingPrice
                            ) %>

                        </th>


                        <th>

                            KSh
                            <%= formatMoney(
                                totalSellingPrice
                            ) %>

                        </th>


                        <th>

                            KSh
                            <%= formatMoney(
                                totalCurrentWorth
                            ) %>

                        </th>


                        <th>

                            KSh
                            <%= formatMoney(
                                totalRevenue
                            ) %>

                        </th>


                        <th>

                            KSh
                            <%= formatMoney(
                                totalLiabilities
                            ) %>

                        </th>


                        <th>


                            <strong
                                class="<%= profitClass(
                                    totalProfit
                                ) %>"
                            >

                                <%= profitText(
                                    totalProfit
                                ) %>

                            </strong>


                        </th>


                    </tr>


                </tfoot>


            </table>


        </div>


    </section>


    <!-- ======================================================
         FINANCIAL RULE
         ====================================================== -->

    <section class="financial-formula-note">


        <i class="bi bi-calculator"></i>


        <div>


            <strong>

                Profit / Loss calculation

            </strong>


            <span>

                Selling Price − Buying Price − Filtered
                Liabilities + Filtered Revenue

            </span>


        </div>


    </section>


</div>


<style>

