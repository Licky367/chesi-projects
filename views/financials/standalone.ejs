    --financial-green-soft:#f4faf6;

    --financial-red:#c0392b;

    --financial-text:#243329;
    --financial-muted:#718078;

    padding:24px;

    max-width:1400px;

    margin:0 auto;

}


/* ==========================================================
   HEADER
   ========================================================== */

.standalone-financial-page
.financial-page-header{

    display:flex;

    align-items:center;

    justify-content:space-between;

    gap:20px;

    margin-bottom:20px;

}


.standalone-financial-page
.financial-eyebrow{

    display:block;

    color:var(--financial-green);

    font-size:.72rem;

    font-weight:800;

    letter-spacing:.12em;

    margin-bottom:5px;

}


.standalone-financial-page
.financial-title{

    margin:0;

    color:var(--financial-text);

    font-size:clamp(1.5rem,4vw,2.2rem);

}


.standalone-financial-page
.financial-subtitle{

    margin:6px 0 0;

    color:var(--financial-muted);

    font-size:.85rem;

}


/* ==========================================================
   BUTTONS
   ========================================================== */

.standalone-financial-page
.financial-button{

    display:inline-flex;

    align-items:center;

    justify-content:center;

    gap:8px;

    padding:11px 16px;

    border:0;

    border-radius:10px;

    text-decoration:none;

    font:inherit;

    font-weight:600;

    cursor:pointer;

}


.financial-button-primary{

    background:var(--financial-green);

    color:#fff;

}


.financial-button-secondary{

    background:var(--financial-green-light);

    color:var(--financial-green-dark);

}


/* ==========================================================
   WORTH
   ========================================================== */

.financial-worth-card{

    display:flex;

    align-items:center;

    gap:15px;

    padding:20px;

    margin-bottom:16px;

    background:#fff;

    border-radius:17px;

    border-left:4px solid
        var(--financial-green);

    box-shadow:
        0 3px 16px
        rgba(0,0,0,.06);

}


.financial-worth-icon{

    width:48px;

    height:48px;

    display:flex;

    align-items:center;

    justify-content:center;

    border-radius:13px;

    background:var(--financial-green-light);

    color:var(--financial-green);

    font-size:1.25rem;

}


.financial-worth-card span{

    display:block;

    color:var(--financial-muted);

    font-size:.78rem;

}


.financial-worth-card strong{

    display:block;

    color:var(--financial-green-dark);

    font-size:1.35rem;

}


.financial-worth-card small{

    display:block;

    margin-top:3px;

    color:var(--financial-muted);

    font-size:.68rem;

}


/* ==========================================================
   FILTER
   ========================================================== */

.financial-filter-card{

    padding:12px 15px;

    margin-bottom:12px;

    background:#fff;

    border-radius:14px;

    box-shadow:
        0 2px 12px
        rgba(0,0,0,.05);

}


.financial-filter-form{

    display:flex;

    align-items:flex-end;

    gap:10px;

}


.financial-filter-group{

    flex:1;

}


.financial-filter-group label{

    display:block;

    margin-bottom:5px;

    color:var(--financial-muted);

    font-size:.72rem;

    font-weight:600;

}


.financial-filter-group input{

    width:100%;

    box-sizing:border-box;

    padding:9px 10px;

    border:1px solid #dce5df;

    border-radius:9px;

    background:#fff;

    color:var(--financial-text);

    font:inherit;

    outline:none;

}


.financial-filter-group input:focus{

    border-color:var(--financial-green);

    box-shadow:
        0 0 0 3px
        rgba(47,125,74,.1);

}


.financial-clear-filter{

    display:inline-flex;

    align-items:center;

    gap:5px;

    padding:9px 4px;

    color:var(--financial-green);

    text-decoration:none;

    font-size:.8rem;

    font-weight:600;

