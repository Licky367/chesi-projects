<% /* ==========================================================
   FINANCIAL / STANDALONE ASSETS PAGE

   PURPOSE:
   ----------------------------------------------------------
   Displays financial information for assets that do not
   belong to a Dairy Farm.

   EXPECTED BACKEND DATA:

   standalone:

   {
       assets: [],

       currentWorth,
       salesAmount,
       revenue,
       liabilities,
       profit
   }

   OR, for compatibility:

   {
       assets: [],

       currentWorth,
       sellingPrice,
       buyingPrice,
       revenue,
       liabilities,
       profit
   }

   filters:

   {
       startDate,
       endDate
   }

   FINANCIAL RULES:

   Current worth:
   Always current.

   Sales:
   Selling price of assets.

   Revenue:
   Revenue generated by assets.

   Liabilities:
   Date-filtered when a date range is supplied.

   Profit/Loss:

       selling price
       - buying price
       - liabilities
       + revenue

   The backend/service should preferably provide the
   calculated financial values.

========================================================== */ %>


<%
/* ==========================================================
   HELPERS
   ========================================================== */

function number(value) {

    const result =
        Number(value);

    return Number.isFinite(result)
        ? result
        : 0;

}


function formatMoney(value) {

    const amount =
        Number(value);

    if (!Number.isFinite(amount)) {

        return "—";

    }

    return amount.toLocaleString(
        "en-KE",
        {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
        }
    );

}


function profitClass(value) {

    return number(value) < 0
        ? "financial-negative"
        : "financial-positive";

}


function profitText(value) {

    const amount =
        number(value);

    if (amount < 0) {

        return (
            "-KSh " +
            formatMoney(
                Math.abs(amount)
            )
        );

    }

    return (
        "KSh " +
        formatMoney(amount)
    );

}


/* ==========================================================
   SAFE DATA
   ========================================================== */

const standaloneData =
    standalone || {};


const assets =
    Array.isArray(
        standaloneData.assets
    )
        ? standaloneData.assets
        : [];


/* ==========================================================
   DATE FILTERS
   ========================================================== */

const startDate =
    filters?.startDate || "";


const endDate =
    filters?.endDate || "";


const hasDateFilter =
    Boolean(
        startDate ||
        endDate
    );


/* ==========================================================
   SERVICE TOTALS
   ==========================================================

   Prefer values supplied by the backend.

   Fallbacks are retained for compatibility with older
   service responses.
========================================================== */

const totalCurrentWorth =
    number(
        standaloneData.currentWorth
    );


const totalSalesAmount =
    number(
        standaloneData.salesAmount ??
        standaloneData.sellingPrice
    );


const totalRevenue =
    number(
        standaloneData.revenue
    );


const totalLiabilities =
    number(
        standaloneData.liabilities
    );


/* ==========================================================
   TOTAL BUYING PRICE
   ==========================================================

   Buying price is retained because it is useful for the
   standalone asset financial breakdown and profit formula.

   It does not replace Sales Amount in the main financial
   presentation.
========================================================== */

let totalBuyingPrice =
    number(
        standaloneData.buyingPrice
    );


/* ==========================================================
   TOTAL PROFIT
   ========================================================== */

let totalProfit;


if (
    standaloneData.profit !== undefined &&
    standaloneData.profit !== null
) {

    totalProfit =
        number(
            standaloneData.profit
        );

} else {

    totalProfit =

        totalSalesAmount
        -
        totalBuyingPrice
        -
        totalLiabilities
        +
        totalRevenue;

}


/* ==========================================================
   FALLBACK BUYING PRICE

   If the service does not provide a total buying price,
   derive it from the assets.
========================================================== */

if (
    standaloneData.buyingPrice === undefined ||
    standaloneData.buyingPrice === null
) {

    totalBuyingPrice = 0;

    assets.forEach(
        function(asset) {

            totalBuyingPrice +=
                number(
                    asset?.buyingPrice
                );

        }
    );

}


/* ==========================================================
   SORT ASSETS
   ==========================================================

   Highest profit first.

   If profit is tied:
   Highest current worth first.
========================================================== */

const sortedAssets =
    [...assets].sort(

        function(a, b) {

            const profitA =

                a?.profit !== undefined &&
                a?.profit !== null

                    ? number(
                        a.profit
                    )

                    : (
                        number(
                            a?.sellingPrice ??
                            a?.salesAmount
                        )
                        -
                        number(
                            a?.buyingPrice
                        )
                        -
                        number(
                            a?.liabilities
                        )
                        +
                        number(
                            a?.revenue
                        )
                    );


            const profitB =

                b?.profit !== undefined &&
                b?.profit !== null

                    ? number(
                        b.profit
                    )

                    : (
                        number(
                            b?.sellingPrice ??
                            b?.salesAmount
                        )
                        -
                        number(
                            b?.buyingPrice
                        )
                        -
                        number(
                            b?.liabilities
                        )
                        +
                        number(
                            b?.revenue
                        )
                    );


            if (
                profitA !== profitB
            ) {

                return (
                    profitB -
                    profitA
                );

            }


            return (

                number(
                    b?.currentWorth
                )
                -
                number(
                    a?.currentWorth
                )

            );

        }

    );

%>


<div class="financial-page standalone-financial-page">


    <!-- ======================================================
         PAGE HEADER
         ====================================================== -->

    <div class="financial-page-header">


        <div>

            <span class="financial-eyebrow">

                FINANCIALS

            </span>


            <h1 class="financial-title">

                Standalone Assets

            </h1>


            <p class="financial-subtitle">

                Financial position and performance of assets
                that do not belong to any Dairy Farm.

            </p>

        </div>


        <a
            href="/financials/summary"
            class="financial-button financial-button-secondary"
        >

            <i class="bi bi-arrow-left"></i>

            Summary

        </a>


    </div>


    <!-- ======================================================
         CURRENT NET WORTH
         ====================================================== -->

    <section class="financial-current-worth-card">


        <div class="financial-current-worth-icon">

            <i class="bi bi-box-seam"></i>

        </div>


        <div>

            <span class="financial-current-worth-label">

                TOTAL CURRENT NET WORTH

            </span>


            <strong class="financial-current-worth-value">

                KSh
                <%= formatMoney(
                    totalCurrentWorth
                ) %>

            </strong>


            <small>

                Current value of all standalone assets.
                Independent of the liability date filter.

            </small>

        </div>


    </section>


    <!-- ======================================================
         DATE FILTER
         ====================================================== -->

    <section class="financial-filter-card">


        <form
            method="GET"
            action="/financials/standalone"
            class="financial-filter-form"
        >


            <!-- ==============================================
                 FILTER TITLE
                 ============================================== -->

            <div class="financial-filter-title">

                <i class="bi bi-calendar3"></i>

                <span>

                    Liability & Profit Period

                </span>

            </div>


            <!-- ==============================================
                 FROM
                 ============================================== -->

            <div class="financial-filter-group">

                <label for="startDate">

                    From

                </label>


                <input
                    type="date"
                    id="startDate"
                    name="startDate"
                    value="<%= startDate %>"
                >

            </div>


            <!-- ==============================================
                 TO
                 ============================================== -->

            <div class="financial-filter-group">

                <label for="endDate">

                    To

                </label>


                <input
                    type="date"
                    id="endDate"
                    name="endDate"
                    value="<%= endDate %>"
                >

            </div>


            <!-- ==============================================
                 APPLY
                 ============================================== -->

            <button
                type="submit"
                class="financial-button financial-button-primary"
            >

                <i class="bi bi-funnel"></i>

                Apply

            </button>


            <!-- ==============================================
                 CLEAR
                 ============================================== -->

            <% if (hasDateFilter) { %>

                <a
                    href="/financials/standalone"
                    class="financial-clear-filter"
                >

                    <i class="bi bi-x-circle"></i>

                    Clear

                </a>

            <% } %>


        </form>


    </section>


    <!-- ======================================================
         PERIOD INDICATOR
         ====================================================== -->

    <% if (hasDateFilter) { %>

        <div class="financial-period-indicator">

            <i class="bi bi-clock-history"></i>

            <span>

                Liabilities & profit:

            </span>


            <% if (startDate) { %>

                <strong>

                    <%= startDate %>

                </strong>

            <% } %>


            <% if (
                startDate &&
                endDate
            ) { %>

                <span>

                    to

                </span>

            <% } %>


            <% if (endDate) { %>

                <strong>

                    <%= endDate %>

                </strong>

            <% } %>

        </div>

    <% } %>


    <!-- ======================================================
         ASSET SECTION
         ====================================================== -->

    <section class="financial-section">


        <div class="financial-section-header">


            <div>

                <span class="financial-eyebrow">

                    FINANCIAL BREAKDOWN

                </span>


                <h2>

                    Standalone Assets

                </h2>


                <p>

                    Assets that are not assigned to any
                    Dairy Farm.

                </p>

            </div>


            <span class="financial-count">

                <%= sortedAssets.length %>

                <%= sortedAssets.length === 1
                    ? "Asset"
                    : "Assets"
                %>

            </span>


        </div>


        <!-- ==================================================
             TABLE
             ================================================== -->

        <div class="financial-table-wrapper">


            <table class="financial-table">


                <!-- ==========================================
                     TABLE HEADER
                     ========================================== -->

                <thead>

                    <tr>

                        <th class="financial-name-column">

                            Asset

                        </th>


                        <th>

                            Type

                        </th>


                        <th>

                            Current Worth

                        </th>


                        <th>

                            Sales Amount

                        </th>


                        <th>

                            Revenue

                        </th>


                        <th>

                            Liabilities

                        </th>


                        <th>

                            Profit / Loss

                        </th>

                    </tr>

                </thead>


                <!-- ==========================================
                     TABLE BODY
                     ========================================== -->

                <tbody>


                    <% if (
                        sortedAssets.length > 0
                    ) { %>


                        <% sortedAssets.forEach(
                            function(asset)
                        { %>


                            <%

                                const assetId =
                                    asset?._id ||
                                    asset?.id ||
                                    "";


                                const assetSalesAmount =
                                    number(
                                        asset?.salesAmount ??
                                        asset?.sellingPrice
                                    );


                                const assetBuyingPrice =
                                    number(
                                        asset?.buyingPrice
                                    );


                                const assetRevenue =
                                    number(
                                        asset?.revenue
                                    );


                                const assetLiabilities =
                                    number(
                                        asset?.liabilities ??
                                        asset?.totalLiabilities
                                    );


                                const assetProfit =

                                    asset?.profit !== undefined &&
                                    asset?.profit !== null

                                        ? number(
                                            asset.profit
                                        )

                                        : (
                                            assetSalesAmount
                                            -
                                            assetBuyingPrice
                                            -
                                            assetLiabilities
                                            +
                                            assetRevenue
                                        );

                            %>


                            <!-- ==================================
                                 CLICKABLE ASSET ROW
                                 ================================== -->

                            <% if (assetId) { %>

                                <tr
                                    class="financial-asset-row"
                                    onclick="window.location.href='/networth/asset/<%= assetId %>'"
                                    role="link"
                                    tabindex="0"
                                    onkeydown="
                                        if (
                                            event.key === 'Enter' ||
                                            event.key === ' '
                                        ) {
                                            event.preventDefault();
                                            window.location.href='/networth/asset/<%= assetId %>';
                                        }
                                    "
                                >

                            <% } else { %>

                                <tr
                                    class="
                                        financial-asset-row
                                        financial-asset-row-disabled
                                    "
                                >

                            <% } %>


                                <!-- ==================================
                                     ASSET
                                     ================================== -->

                                <td>

                                    <div
                                        class="financial-table-name"
                                    >

                                        <strong>

                                            <%= asset?.name ||
                                                "Unnamed Asset"
                                            %>

                                        </strong>


                                        <% if (
                                            asset?.code !== undefined &&
                                            asset?.code !== null &&
                                            asset?.code !== ""
                                        ) { %>

                                            <small>

                                                Code:
                                                <%= asset.code %>

                                            </small>

                                        <% } else { %>

                                            <small>

                                                Standalone asset

                                            </small>

                                        <% } %>

                                    </div>

                                </td>


                                <!-- ==================================
                                     TYPE
                                     ================================== -->

                                <td>

                                    <span
                                        class="financial-type-badge"
                                    >

                                        <%= asset?.type ||
                                            "Other"
                                        %>

                                    </span>

                                </td>


                                <!-- ==================================
                                     CURRENT WORTH
                                     ================================== -->

                                <td>

                                    <span
                                        class="financial-table-value"
                                    >

                                        KSh
                                        <%= formatMoney(
                                            asset?.currentWorth
                                        ) %>

                                    </span>

                                </td>


                                <!-- ==================================
                                     SALES AMOUNT
                                     ================================== -->

                                <td>

                                    <span
                                        class="financial-table-value"
                                    >

                                        KSh
                                        <%= formatMoney(
                                            assetSalesAmount
                                        ) %>

                                    </span>

                                </td>


                                <!-- ==================================
                                     REVENUE
                                     ================================== -->

                                <td>

                                    <span
                                        class="financial-table-value"
                                    >

                                        KSh
                                        <%= formatMoney(
                                            assetRevenue
                                        ) %>

                                    </span>

                                </td>


                                <!-- ==================================
                                     LIABILITIES
                                     ================================== -->

                                <td>

                                    <span
                                        class="
                                            financial-table-value
                                            financial-liability
                                        "
                                    >

                                        KSh
                                        <%= formatMoney(
                                            assetLiabilities
                                        ) %>

                                    </span>

                                </td>


                                <!-- ==================================
                                     PROFIT / LOSS
                                     ================================== -->

                                <td>

                                    <strong
                                        class="
                                            financial-table-profit
                                            <%= profitClass(
                                                assetProfit
                                            ) %>
                                        "
                                    >

                                        <%= profitText(
                                            assetProfit
                                        ) %>

                                    </strong>

                                </td>


                            </tr>


                        <% }); %>


                    <% } else { %>


                        <tr>

                            <td
                                colspan="7"
                                class="financial-table-empty"
                            >

                                <i class="bi bi-box-seam"></i>


                                <strong>

                                    No standalone assets found

                                </strong>


                                <span>

                                    There are currently no assets
                                    outside a Dairy Farm.

                                </span>

                            </td>

                        </tr>


                    <% } %>


                </tbody>


                <!-- ==========================================
                     TOTAL
                     ========================================== -->

                <tfoot>

                    <tr class="financial-total-row">


                        <td colspan="2">

                            <strong>

                                TOTAL

                            </strong>

                        </td>


                        <td>

                            <strong>

                                KSh
                                <%= formatMoney(
                                    totalCurrentWorth
                                ) %>

                            </strong>

                        </td>


                        <td>

                            <strong>

                                KSh
                                <%= formatMoney(
                                    totalSalesAmount
                                ) %>

                            </strong>

                        </td>


                        <td>

                            <strong>

                                KSh
                                <%= formatMoney(
                                    totalRevenue
                                ) %>

                            </strong>

                        </td>


                        <td>

                            <strong
                                class="financial-liability"
                            >

                                KSh
                                <%= formatMoney(
                                    totalLiabilities
                                ) %>

                            </strong>

                        </td>


                        <td>

                            <strong
                                class="
                                    financial-table-profit
                                    <%= profitClass(
                                        totalProfit
                                    ) %>
                                "
                            >

                                <%= profitText(
                                    totalProfit
                                ) %>

                            </strong>

                        </td>


                    </tr>

                </tfoot>


            </table>


        </div>


    </section>


    <!-- ======================================================
         FINANCIAL FORMULA
         ====================================================== -->

    <section class="financial-formula-note">


        <i class="bi bi-calculator"></i>


        <div>

            <strong>

                Profit / Loss calculation

            </strong>


            <span>

                Selling Price − Buying Price −
                Liabilities + Revenue.

                Liabilities and revenue follow the selected
                date period when a filter is applied.

            </span>

        </div>


    </section>


</div>


<style>

