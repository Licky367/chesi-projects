.financial-section{

    margin-bottom:20px;

}


.standalone-financial-page
.financial-section-header{

    display:flex;

    align-items:flex-end;

    justify-content:space-between;

    gap:15px;

    margin-bottom:12px;

}


.standalone-financial-page
.financial-section-header h2{

    margin:0;

    color:var(--financial-text);

    font-size:1.25rem;

}


.standalone-financial-page
.financial-section-description{

    margin:4px 0 0;

    color:var(--financial-muted);

    font-size:.76rem;

}


.standalone-financial-page
.financial-count{

    flex:0 0 auto;

    padding:6px 10px;

    border-radius:20px;

    background:var(--financial-green-light);

    color:var(--financial-green-dark);

