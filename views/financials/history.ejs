<% /* ==========================================================
   FINANCIAL / LIABILITY HISTORY PAGE

   EXPECTED BACKEND DATA

   farmGroups:
       Array such as:

       [
           {
               farm: Dairy,
               liabilities: Financials[],
               totalLiabilities: Number
           }
       ]

   standaloneAssets:
       Array such as:

       [
           {
               dairy: Dairy,
               liabilities: Financials[]
           }
       ]

   LIABILITY FIELDS

       liability.dairy
       liability.amount
       liability.description
       liability.recordedByName
       liability.createdAt

   ========================================================== */


/* ==========================================================
   HELPERS
   ========================================================== */

function number(value) {

    const result = Number(value);

    return Number.isFinite(result)
        ? result
        : 0;

}


function formatMoney(value) {

    const amount = Number(value);

    if (!Number.isFinite(amount)) {

        return "—";

    }

    return amount.toLocaleString(
        "en-KE",
        {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
        }
    );

}


function safeId(value) {

    if (
        value === undefined ||
        value === null
    ) {

        return "";

    }

    return String(value);

}


function recordName(dairy) {

    if (
        dairy &&
        dairy.name
    ) {

        return dairy.name;

    }

    return "Unknown Asset";

}


function recordType(dairy) {

    if (
        dairy &&
        dairy.type
    ) {

        return dairy.type;

    }

    return "Dairy Asset";

}


function formatDate(value) {

    if (!value) {

        return "Unknown date";

    }

    const date =
        new Date(value);


    if (
        Number.isNaN(
            date.getTime()
        )
    ) {

        return "Unknown date";

    }

    return date.toLocaleString(
        "en-KE",
        {
            dateStyle: "medium",
            timeStyle: "short"
        }
    );

}


/* ==========================================================
   SAFE ARRAYS
   ========================================================== */

const safeFarmGroups =
    Array.isArray(farmGroups)
        ? farmGroups
        : [];


const safeStandaloneAssets =
    Array.isArray(standaloneAssets)
        ? standaloneAssets
        : [];


/* ==========================================================
   TOTALS
   ========================================================== */

let farmLiabilityTotal = 0;

let standaloneLiabilityTotal = 0;

let liabilityRecordCount = 0;


safeFarmGroups.forEach(
    function(group) {

        if (
            Array.isArray(
                group.liabilities
            )
        ) {

            group.liabilities.forEach(
                function(liability) {

                    farmLiabilityTotal +=
                        number(
                            liability?.amount
                        );

                    liabilityRecordCount++;

                }
            );

        }

    }
);


safeStandaloneAssets.forEach(
    function(group) {

        if (
            Array.isArray(
                group.liabilities
            )
        ) {

            group.liabilities.forEach(
                function(liability) {

                    standaloneLiabilityTotal +=
                        number(
                            liability?.amount
                        );

                    liabilityRecordCount++;

                }
            );

        }

    }
);


const totalLiabilities =
    farmLiabilityTotal +
    standaloneLiabilityTotal;

%>


<div class="financial-page liability-history-page">


    <!-- ======================================================
         HEADER
         ====================================================== -->

    <div class="financial-page-header">

        <div>

            <span class="financial-eyebrow">

                FINANCIALS

            </span>

            <h1 class="financial-title">

                Liability History

            </h1>

            <p class="financial-subtitle">

                Review liabilities recorded against
                dairy farms and their assets.

            </p>

        </div>


        <div class="financial-header-actions">

            <a
                href="/financials/summary"
                class="financial-button financial-button-secondary"
            >

                <i class="bi bi-bar-chart-line"></i>

                Summary

            </a>


            <a
                href="/financials/liability"
                class="financial-button financial-button-primary"
            >

                <i class="bi bi-plus-circle"></i>

                Record Liability

            </a>

        </div>

    </div>


    <!-- ======================================================
         SUMMARY
         ====================================================== -->

    <section class="financial-history-summary">


        <div class="financial-history-stat">

            <div class="financial-history-stat-icon">

                <i class="bi bi-receipt"></i>

            </div>

            <div>

                <span>
                    Liability Records
                </span>

                <strong>
                    <%= liabilityRecordCount %>
                </strong>

            </div>

        </div>


        <div class="financial-history-stat">

            <div class="financial-history-stat-icon">

                <i class="bi bi-building"></i>

            </div>

            <div>

                <span>
                    Farm Liabilities
                </span>

                <strong>
                    KSh
                    <%= formatMoney(
                        farmLiabilityTotal
                    ) %>
                </strong>

            </div>

        </div>


        <div class="financial-history-stat">

            <div class="financial-history-stat-icon">

                <i class="bi bi-box-seam"></i>

            </div>

            <div>

                <span>
                    Standalone Liabilities
                </span>

                <strong>
                    KSh
                    <%= formatMoney(
                        standaloneLiabilityTotal
                    ) %>
                </strong>

            </div>

        </div>


        <div class="financial-history-stat financial-history-stat-total">

            <div class="financial-history-stat-icon">

                <i class="bi bi-wallet2"></i>

            </div>

            <div>

                <span>
                    Total Liabilities
                </span>

                <strong>
                    KSh
                    <%= formatMoney(
                        totalLiabilities
                    ) %>
                </strong>

            </div>

        </div>


    </section>


    <!-- ======================================================
         STANDALONE ASSETS
         ====================================================== -->

    <section class="financial-section">


        <div class="financial-section-header">

            <div>

                <span class="financial-eyebrow">

                    STANDALONE

                </span>

                <h2>

                    Standalone Asset Liabilities

                </h2>

                <p>

                    Liabilities belonging to assets that
                    are not assigned to a dairy farm.

                </p>

            </div>


            <span class="financial-count">

                <%= safeStandaloneAssets.length %>

                <%= safeStandaloneAssets.length === 1
                    ? "Asset"
                    : "Assets"
                %>

            </span>

        </div>


        <% if (
            safeStandaloneAssets.length
        ) { %>


            <div class="financial-table-card">

                <div class="financial-table-wrapper">

                    <table class="financial-table">

                        <thead>

                            <tr>

                                <th>
                                    Asset
                                </th>

                                <th>
                                    Description
                                </th>

                                <th>
                                    Amount
                                </th>

                                <th>
                                    Recorded By
                                </th>

                                <th>
                                    Date & Time
                                </th>

                            </tr>

                        </thead>


                        <tbody>


                            <% safeStandaloneAssets.forEach(
                                function(group)
                            { %>


                                <% if (
                                    Array.isArray(
                                        group?.liabilities
                                    ) &&
                                    group.liabilities.length
                                ) { %>


                                    <% group.liabilities.forEach(
                                        function(liability)
                                    { %>


                                        <tr>


                                            <!-- ==========================
                                                 ASSET
                                                 ========================== -->

                                            <td>

                                                <div
                                                    class="financial-record-name"
                                                >

                                                    <strong>

                                                        <%= recordName(
                                                            group?.dairy
                                                        ) %>

                                                    </strong>


                                                    <span>

                                                        <%= recordType(
                                                            group?.dairy
                                                        ) %>

                                                    </span>

                                                </div>

                                            </td>


                                            <!-- ==========================
                                                 DESCRIPTION
                                                 ========================== -->

                                            <td>

                                                <span
                                                    class="financial-description"
                                                >

                                                    <%= liability?.description ||
                                                        "No description"
                                                    %>

                                                </span>

                                            </td>


                                            <!-- ==========================
                                                 AMOUNT
                                                 ========================== -->

                                            <td>

                                                <strong
                                                    class="financial-liability-amount"
                                                >

                                                    KSh
                                                    <%= formatMoney(
                                                        liability?.amount
                                                    ) %>

                                                </strong>

                                            </td>


                                            <!-- ==========================
                                                 RECORDED BY
                                                 ========================== -->

                                            <td>

                                                <span
                                                    class="financial-recorder-name"
                                                >

                                                    <%= liability?.recordedByName ||
                                                        "Unknown"
                                                    %>

                                                </span>

                                            </td>


                                            <!-- ==========================
                                                 DATE
                                                 ========================== -->

                                            <td>

                                                <time
                                                    datetime="<%= liability?.createdAt || '' %>"
                                                    class="financial-date"
                                                >

                                                    <%= formatDate(
                                                        liability?.createdAt
                                                    ) %>

                                                </time>

                                            </td>


                                        </tr>


                                    <% }); %>


                                <% } %>


                            <% }); %>


                        </tbody>

                    </table>

                </div>

            </div>


        <% } else { %>


            <div class="financial-empty">

                <i class="bi bi-box-seam"></i>

                <strong>

                    No standalone liabilities

                </strong>

                <span>

                    No liabilities have been recorded for
                    standalone assets.

                </span>

            </div>


        <% } %>


    </section>


    <!-- ======================================================
         DAIRY FARMS
         ====================================================== -->

    <section class="financial-section">


        <div class="financial-section-header">

            <div>

                <span class="financial-eyebrow">

                    DAIRY FARMS

                </span>

                <h2>

                    Farm Liabilities

                </h2>

                <p>

                    Each farm includes liabilities recorded
                    against the farm itself and its assets.

                </p>

            </div>


            <span class="financial-count">

                <%= safeFarmGroups.length %>

                <%= safeFarmGroups.length === 1
                    ? "Farm"
                    : "Farms"
                %>

            </span>

        </div>


        <% if (
            safeFarmGroups.length
        ) { %>


            <div class="financial-farm-list">


                <% safeFarmGroups.forEach(
                    function(group)
                { %>


                    <%

                        const groupFarm =
                            group?.farm || {};

                        const groupFarmId =
                            safeId(
                                groupFarm?._id
                            );

                        const groupFarmName =
                            groupFarm?.name ||
                            "Unnamed Dairy Farm";

                        const groupFarmCode =
                            groupFarm?.code;

                        const groupFarmType =
                            groupFarm?.type;

                        const calculatedGroupTotal =
                            Array.isArray(
                                group?.liabilities
                            )
                                ? group.liabilities.reduce(
                                    function(total, liability) {

                                        return total +
                                            number(
                                                liability?.amount
                                            );

                                    },
                                    0
                                )
                                : 0;

                        const groupTotal =
                            group?.totalLiabilities !==
                            undefined &&
                            group?.totalLiabilities !==
                            null

                                ? number(
                                    group.totalLiabilities
                                )

                                : calculatedGroupTotal;

                    %>


                    <article
                        class="financial-farm-card"
                    >


                        <!-- ==================================
                             FARM HEADER
                             ================================== -->

                        <div
                            class="financial-farm-header"
                        >

                            <div>

                                <% if (
                                    groupFarmCode !==
                                    undefined &&
                                    groupFarmCode !==
                                    null &&
                                    groupFarmCode !== ""
                                ) { %>

                                    <span
                                        class="financial-farm-code"
                                    >

                                        Farm Code:
                                        <%= groupFarmCode %>

                                    </span>

                                <% } %>


                                <h3>

                                    <%= groupFarmName %>

                                </h3>


                                <% if (
                                    groupFarmType
                                ) { %>

                                    <span
                                        class="financial-farm-type"
                                    >

                                        <%= groupFarmType %>

                                    </span>

                                <% } %>

                            </div>


                            <div
                                class="financial-farm-header-actions"
                            >

                                <% if (groupFarmId) { %>

                                    <a
                                        href="/financials/farm/<%= groupFarmId %>"
                                        class="financial-farm-link"
                                    >

                                        View Financials

                                    </a>

                                <% } %>


                                <div
                                    class="financial-farm-total"
                                >

                                    <span>

                                        Total Liabilities

                                    </span>

                                    <strong>

                                        KSh
                                        <%= formatMoney(
                                            groupTotal
                                        ) %>

                                    </strong>

                                </div>

                            </div>

                        </div>


                        <!-- ==================================
                             LIABILITY TABLE
                             ================================== -->

                        <% if (
                            Array.isArray(
                                group?.liabilities
                            ) &&
                            group.liabilities.length
                        ) { %>


                            <div
                                class="financial-table-card"
                            >

                                <div
                                    class="financial-table-wrapper"
                                >

                                    <table
                                        class="financial-table"
                                    >

                                        <thead>

                                            <tr>

                                                <th>
                                                    Dairy / Asset
                                                </th>

                                                <th>
                                                    Description
                                                </th>

                                                <th>
                                                    Amount
                                                </th>

                                                <th>
                                                    Recorded By
                                                </th>

                                                <th>
                                                    Date & Time
                                                </th>

                                            </tr>

                                        </thead>


                                        <tbody>


                                            <% group.liabilities.forEach(
                                                function(liability)
                                            { %>


                                                <%

                                                    const liabilityDairy =
                                                        liability?.dairy ||
                                                        {};

                                                    const liabilityDairyId =
                                                        safeId(
                                                            liabilityDairy?._id
                                                        );

                                                    const isFarm =
                                                        groupFarmId &&
                                                        liabilityDairyId &&
                                                        groupFarmId ===
                                                        liabilityDairyId;

                                                %>


                                                <tr>


                                                    <!-- ======================
                                                         RECORD
                                                         ====================== -->

                                                    <td>

                                                        <div
                                                            class="financial-record-name"
                                                        >

                                                            <strong>

                                                                <%= recordName(
                                                                    liabilityDairy
                                                                ) %>

                                                            </strong>


                                                            <% if (
                                                                isFarm
                                                            ) { %>

                                                                <span
                                                                    class="financial-farm-own-label"
                                                                >

                                                                    Farm itself

                                                                </span>

                                                            <% } else { %>

                                                                <span>

                                                                    Farm asset

                                                                </span>

                                                            <% } %>

                                                        </div>

                                                    </td>


                                                    <!-- ======================
                                                         DESCRIPTION
                                                         ====================== -->

                                                    <td>

                                                        <span
                                                            class="financial-description"
                                                        >

                                                            <%= liability?.description ||
                                                                "No description"
                                                            %>

                                                        </span>

                                                    </td>


                                                    <!-- ======================
                                                         AMOUNT
                                                         ====================== -->

                                                    <td>

                                                        <strong
                                                            class="financial-liability-amount"
                                                        >

                                                            KSh
                                                            <%= formatMoney(
                                                                liability?.amount
                                                            ) %>

                                                        </strong>

                                                    </td>


                                                    <!-- ======================
                                                         RECORDER
                                                         ====================== -->

                                                    <td>

                                                        <span
                                                            class="financial-recorder-name"
                                                        >

                                                            <%= liability?.recordedByName ||
                                                                "Unknown"
                                                            %>

                                                        </span>

                                                    </td>


                                                    <!-- ======================
                                                         DATE
                                                         ====================== -->

                                                    <td>

                                                        <time
                                                            datetime="<%= liability?.createdAt || '' %>"
                                                            class="financial-date"
                                                        >

                                                            <%= formatDate(
                                                                liability?.createdAt
                                                            ) %>

                                                        </time>

                                                    </td>


                                                </tr>


                                            <% }); %>


                                        </tbody>

                                    </table>

                                </div>

                            </div>


                        <% } else { %>


                            <div
                                class="financial-empty financial-empty-small"
                            >

                                <i
                                    class="bi bi-check-circle"
                                ></i>

                                <span>

                                    No liabilities recorded for
                                    this farm or its assets.

                                </span>

                            </div>


                        <% } %>


                    </article>


                <% }); %>


            </div>


        <% } else { %>


            <div class="financial-empty">

                <i class="bi bi-building"></i>

                <strong>

                    No dairy farms

                </strong>

                <span>

                    No dairy farms have been found.

                </span>

            </div>


        <% } %>


    </section>


</div>


<style>

/* ==========================================================
   PAGE
   ========================================================== */

.liability-history-page{

    --financial-green:#2f7d4a;
    --financial-green-dark:#236238;
    --financial-green-light:#eaf6ee;
    --financial-green-soft:#f4faf6;

    --financial-red:#c0392b;

    --financial-text:#243329;
    --financial-muted:#718078;

    padding:24px;

    max-width:1400px;

    margin:0 auto;

}


/* ==========================================================
   HEADER
   ========================================================== */

.liability-history-page
.financial-page-header{

    display:flex;

    align-items:center;

    justify-content:space-between;

    gap:20px;

    margin-bottom:24px;

}


.liability-history-page
.financial-eyebrow{

    display:block;

    margin-bottom:5px;

    color:var(--financial-green);

    font-size:.72rem;

    font-weight:800;

    letter-spacing:.12em;

}


.liability-history-page
.financial-title{

    margin:0;

    color:var(--financial-text);

    font-size:clamp(1.5rem,4vw,2.2rem);

}


.liability-history-page
.financial-subtitle{

    margin:6px 0 0;

    color:var(--financial-muted);

    font-size:.85rem;

}


.liability-history-page
.financial-header-actions{

    display:flex;

    align-items:center;

    justify-content:flex-end;

    gap:10px;

}


/* ==========================================================
   BUTTONS
   ========================================================== */

.liability-history-page
.financial-button{

    display:inline-flex;

    align-items:center;

    justify-content:center;

    gap:8px;

    padding:11px 16px;

    border:0;

    border-radius:10px;

    text-decoration:none;

    font:inherit;

    font-weight:600;

    cursor:pointer;

}


.liability-history-page
.financial-button-primary{

    background:var(--financial-green);

    color:#fff;

}


.liability-history-page
.financial-button-secondary{

    background:var(--financial-green-light);

    color:var(--financial-green-dark);

}


/* ==========================================================
   SUMMARY
   ========================================================== */

.liability-history-page
.financial-history-summary{

    display:grid;

    grid-template-columns:
        repeat(4,minmax(0,1fr));

    gap:12px;

    margin-bottom:30px;

}


.liability-history-page
.financial-history-stat{

    display:flex;

    align-items:center;

    gap:12px;

    padding:16px;

    background:#fff;

    border-radius:15px;

    box-shadow:
        0 3px 16px
        rgba(0,0,0,.05);

}


.liability-history-page
.financial-history-stat-icon{

    width:42px;

    height:42px;

    display:flex;

    align-items:center;

    justify-content:center;

    flex:0 0 42px;

    border-radius:11px;

    background:var(--financial-green-light);

    color:var(--financial-green);

}


.liability-history-page
.financial-history-stat span{

    display:block;

    color:var(--financial-muted);

    font-size:.7rem;

}


.liability-history-page
.financial-history-stat strong{

    display:block;

    margin-top:2px;

    color:var(--financial-green-dark);

    font-size:1rem;

}


.liability-history-page
.financial-history-stat-total{

    border-left:4px solid
        var(--financial-green);

}


/* ==========================================================
   SECTIONS
   ========================================================== */

.liability-history-page
.financial-section{

    margin-bottom:32px;

}


.liability-history-page
.financial-section-header{

    display:flex;

    align-items:flex-end;

    justify-content:space-between;

    gap:15px;

    margin-bottom:12px;

}


.liability-history-page
.financial-section-header h2{

    margin:0;

    color:var(--financial-text);

    font-size:1.25rem;

}


.liability-history-page
.financial-section-header p{

    margin:4px 0 0;

    color:var(--financial-muted);

    font-size:.8rem;

}


.liability-history-page
.financial-count{

    flex:0 0 auto;

    padding:6px 10px;

    border-radius:20px;

    background:var(--financial-green-light);

    color:var(--financial-green-dark);

    font-size:.72rem;

    font-weight:700;

}


/* ==========================================================
   TABLE CARD
   ========================================================== */

.liability-history-page
.financial-table-card{

    overflow:hidden;

    background:#fff;

    border-radius:15px;

    box-shadow:
        0 3px 16px
        rgba(0,0,0,.06);

}


.liability-history-page
.financial-table-wrapper{

    width:100%;

    overflow-x:auto;

}


.liability-history-page
.financial-table{

    width:100%;

    min-width:800px;

    border-collapse:collapse;

}


.liability-history-page
.financial-table th,
.liability-history-page
.financial-table td{

    padding:14px 15px;

    border-bottom:1px solid #edf1ee;

    text-align:left;

    vertical-align:middle;

    color:var(--financial-text);

    font-size:.82rem;

}


.liability-history-page
.financial-table thead th{

    background:#f8faf9;

    color:var(--financial-muted);

    font-size:.68rem;

    font-weight:800;

    text-transform:uppercase;

    letter-spacing:.05em;

    white-space:nowrap;

}


.liability-history-page
.financial-table tbody tr:hover{

    background:var(--financial-green-soft);

}


/* ==========================================================
   RECORD
   ========================================================== */

.liability-history-page
.financial-record-name{

    display:flex;

    flex-direction:column;

    gap:2px;

}


.liability-history-page
.financial-record-name strong{

    color:var(--financial-text);

}


.liability-history-page
.financial-record-name span{

    color:var(--financial-muted);

    font-size:.68rem;

}


.liability-history-page
.financial-farm-own-label{

    color:var(--financial-green) !important;

    font-weight:700;

}


/* ==========================================================
   DESCRIPTION
   ========================================================== */

.liability-history-page
.financial-description{

    display:block;

    max-width:340px;

    line-height:1.4;

    white-space:normal;

}


/* ==========================================================
   AMOUNT
   ========================================================== */

.liability-history-page
.financial-liability-amount{

    color:var(--financial-green-dark);

    white-space:nowrap;

}


/* ==========================================================
   RECORDER / DATE
   ========================================================== */

.liability-history-page
.financial-recorder-name{

    color:var(--financial-muted);

    white-space:nowrap;

}


.liability-history-page
.financial-date{

    color:var(--financial-muted);

    white-space:nowrap;

    font-size:.78rem;

}


/* ==========================================================
   FARM CARDS
   ========================================================== */

.liability-history-page
.financial-farm-list{

    display:flex;

    flex-direction:column;

    gap:20px;

}


.liability-history-page
.financial-farm-card{

    padding:17px;

    background:#fff;

    border-radius:17px;

    box-shadow:
        0 3px 16px
        rgba(0,0,0,.06);

}


.liability-history-page
.financial-farm-header{

    display:flex;

    align-items:center;

    justify-content:space-between;

    gap:20px;

    padding:3px 3px 17px;

}


.liability-history-page
.financial-farm-code{

    color:var(--financial-muted);

    font-size:.7rem;

