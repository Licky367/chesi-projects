.financial-section{

    margin-bottom:38px;

}


.liability-history-page
.financial-section-header{

    margin-bottom:15px;

}


.liability-history-page
.financial-section-header h2{

    margin:0;
    color:var(--financial-text);
    font-size:1.35rem;

}


