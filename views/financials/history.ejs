<% /* ==========================================================
   FINANCIAL / LIABILITY HISTORY PAGE
   ==========================================================

   EXPECTED BACKEND DATA

   farmGroups:
       Array such as:

       [
           {
               farm: Dairy,
               liabilities: Financials[]
           }
       ]

   standaloneAssets:
       Array such as:

       [
           {
               dairy: Dairy,
               liabilities: Financials[]
           }
       ]

   Each liability should have:

       liability.dairy
       liability.amount
       liability.description
       liability.recordedByName
       liability.createdAt

   ========================================================== */ %>


<div class="financial-page liabilities-page">


    <!-- ======================================================
         HEADER
         ====================================================== -->

    <div class="financial-page-header">

        <div>

            <span class="financial-eyebrow">

                FINANCIALS

            </span>

            <h1 class="financial-title">

                Liability History

            </h1>

            <p class="financial-subtitle">

                Review liabilities recorded against farms,
                animals, and assets.

            </p>

        </div>


        <div class="financial-header-actions">

            <a
                href="/financial/liabilities/new"
                class="financial-button financial-button-primary"
            >

                <i class="bi bi-plus-circle"></i>

                Record Liability

            </a>

        </div>

    </div>


    <!-- ======================================================
         STANDALONE ASSETS
         ====================================================== -->

    <section class="financial-section">


        <div class="financial-section-header">

            <div>

                <span class="financial-eyebrow">

                    STANDALONE

                </span>

                <h2>

                    Standalone Assets

                </h2>

                <p>

                    Liabilities belonging to assets that are
                    not assigned to a dairy farm.

                </p>

            </div>

        </div>


        <% if (
            Array.isArray(standaloneAssets) &&
            standaloneAssets.length
        ) { %>


            <div class="financial-table-card">

                <div class="financial-table-wrapper">

                    <table class="financial-table">

                        <thead>

                            <tr>

                                <th>

                                    Dairy / Asset

                                </th>

                                <th>

                                    Description

                                </th>

                                <th>

                                    Amount

                                </th>

                                <th>

                                    Recorded By

                                </th>

                                <th>

                                    Date & Time

                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            <% standaloneAssets.forEach(
                                function(group)
                            { %>


                                <% if (
                                    Array.isArray(
                                        group.liabilities
                                    ) &&
                                    group.liabilities.length
                                ) { %>


                                    <% group.liabilities.forEach(
                                        function(liability)
                                    { %>

                                        <tr>

                                            <td>

                                                <div
                                                    class="financial-record-name"
                                                >

                                                    <strong>

                                                        <%= group.dairy.name %>

                                                    </strong>

                                                    <% if (
                                                        group.dairy.type
                                                    ) { %>

                                                        <span>

                                                            <%= group.dairy.type %>

                                                        </span>

                                                    <% } %>

                                                </div>

                                            </td>


                                            <td>

                                                <span class="financial-description">

                                                    <%= liability.description %>

                                                </span>

                                            </td>


                                            <td>

                                                <strong class="financial-liability-amount">

                                                    KSh
                                                    <%= Number(
                                                        liability.amount || 0
                                                    ).toLocaleString(
                                                        "en-KE",
                                                        {
                                                            minimumFractionDigits: 2
                                                        }
                                                    ) %>

                                                </strong>

                                            </td>


                                            <td>

                                                <span class="financial-recorder-name">

                                                    <%= liability.recordedByName || "Unknown" %>

                                                </span>

                                            </td>


                                            <td>

                                                <time
                                                    datetime="<%= liability.createdAt %>"
                                                    class="financial-date"
                                                >

                                                    <%= new Date(
                                                        liability.createdAt
                                                    ).toLocaleString(
                                                        "en-KE",
                                                        {
                                                            dateStyle: "medium",
                                                            timeStyle: "short"
                                                        }
                                                    ) %>

                                                </time>

                                            </td>

                                        </tr>

                                    <% }); %>


                                <% } %>


                            <% }); %>

                        </tbody>

                    </table>

                </div>

            </div>


        <% } else { %>


            <div class="financial-empty">

                <i class="bi bi-inbox"></i>

                <strong>

                    No standalone liabilities

                </strong>

                <span>

                    No liabilities have been recorded for
                    standalone assets.

                </span>

            </div>


        <% } %>

    </section>


    <!-- ======================================================
         DAIRY FARMS
         ====================================================== -->

    <section class="financial-section">


        <div class="financial-section-header">

            <div>

                <span class="financial-eyebrow">

                    DAIRY FARMS

                </span>

                <h2>

                    Farm Liabilities

                </h2>

                <p>

                    Each farm includes its own liabilities
                    together with liabilities belonging to
                    assets within that farm.

                </p>

            </div>

        </div>


        <% if (
            Array.isArray(farmGroups) &&
            farmGroups.length
        ) { %>


            <div class="financial-farm-list">


                <% farmGroups.forEach(
                    function(group)
                { %>


                    <article
                        class="financial-farm-card"
                    >


                        <!-- ==================================
                             FARM HEADER
                             ================================== -->

                        <div class="financial-farm-header">

                            <div>

                                <span class="financial-farm-code">

                                    Farm Code:
                                    <%= group.farm.code %>

                                </span>

                                <h3>

                                    <%= group.farm.name %>

                                </h3>

                                <% if (
                                    group.farm.type
                                ) { %>

                                    <span class="financial-farm-type">

                                        <%= group.farm.type %>

                                    </span>

                                <% } %>

                            </div>


                            <div class="financial-farm-total">

                                <span>

                                    Total Liabilities

                                </span>

                                <strong>

                                    KSh
                                    <%= Number(
                                        group.totalLiabilities || 0
                                    ).toLocaleString(
                                        "en-KE",
                                        {
                                            minimumFractionDigits: 2
                                        }
                                    ) %>

                                </strong>

                            </div>

                        </div>


                        <!-- ==================================
                             LIABILITY TABLE
                             ================================== -->

                        <% if (
                            Array.isArray(
                                group.liabilities
                            ) &&
                            group.liabilities.length
                        ) { %>


                            <div class="financial-table-card">

                                <div class="financial-table-wrapper">

                                    <table class="financial-table">

                                        <thead>

                                            <tr>

                                                <th>

                                                    Dairy / Asset

                                                </th>

                                                <th>

                                                    Description

                                                </th>

                                                <th>

                                                    Amount

                                                </th>

                                                <th>

                                                    Recorded By

                                                </th>

                                                <th>

                                                    Date & Time

                                                </th>

                                            </tr>

                                        </thead>


                                        <tbody>


                                            <% group.liabilities.forEach(
                                                function(liability)
                                            { %>


                                                <tr>

                                                    <td>

                                                        <div
                                                            class="financial-record-name"
                                                        >

                                                            <strong>

                                                                <%= liability.dairy?.name || "Unknown" %>

                                                            </strong>


                                                            <% if (
                                                                liability.dairy &&
                                                                liability.dairy._id.toString() ===
                                                                group.farm._id.toString()
                                                            ) { %>

                                                                <span class="financial-farm-own-label">

                                                                    Farm itself

                                                                </span>

                                                            <% } else { %>

                                                                <span>

                                                                    Farm asset

                                                                </span>

                                                            <% } %>

                                                        </div>

                                                    </td>


                                                    <td>

                                                        <span class="financial-description">

                                                            <%= liability.description %>

                                                        </span>

                                                    </td>


                                                    <td>

                                                        <strong class="financial-liability-amount">

                                                            KSh
                                                            <%= Number(
                                                                liability.amount || 0
                                                            ).toLocaleString(
                                                                "en-KE",
                                                                {
                                                                    minimumFractionDigits: 2
                                                                }
                                                            ) %>

                                                        </strong>

                                                    </td>


                                                    <td>

                                                        <span class="financial-recorder-name">

                                                            <%= liability.recordedByName || "Unknown" %>

                                                        </span>

                                                    </td>


                                                    <td>

                                                        <time
                                                            datetime="<%= liability.createdAt %>"
                                                            class="financial-date"
                                                        >

                                                            <%= new Date(
                                                                liability.createdAt
                                                            ).toLocaleString(
                                                                "en-KE",
                                                                {
                                                                    dateStyle: "medium",
                                                                    timeStyle: "short"
                                                                }
                                                            ) %>

                                                        </time>

                                                    </td>

                                                </tr>


                                            <% }); %>


                                        </tbody>

                                    </table>

                                </div>

                            </div>


                        <% } else { %>


                            <div class="financial-empty financial-empty-small">

                                <i class="bi bi-check-circle"></i>

                                <span>

                                    No liabilities recorded for
                                    this farm or its assets.

                                </span>

                            </div>


                        <% } %>


                    </article>


                <% }); %>


            </div>


        <% } else { %>


            <div class="financial-empty">

                <i class="bi bi-building"></i>

                <strong>

                    No dairy farms

                </strong>

                <span>

                    No dairy farms have been found.

                </span>

            </div>


        <% } %>


    </section>


</div>


<style>

    .financial-page{

        --financial-green:#2f7d4a;
        --financial-green-dark:#236238;
        --financial-green-light:#eaf6ee;
        --financial-green-soft:#f4faf6;

        --financial-red:#c0392b;
        --financial-red-light:#fceceb;

        --financial-text:#243329;
        --financial-muted:#718078;

        padding:24px;

        max-width:1400px;

        margin:0 auto;

    }


    .financial-page-header{

        display:flex;

        justify-content:space-between;

        align-items:center;

        gap:20px;

        margin-bottom:30px;

    }


    .financial-eyebrow{

        display:block;

        color:var(--financial-green);

        font-size:.72rem;

        font-weight:800;

        letter-spacing:.12em;

        margin-bottom:5px;

    }


    .financial-title{

        margin:0;

        color:var(--financial-text);

        font-size:clamp(1.6rem,4vw,2.2rem);

    }


    .financial-subtitle{

        margin:7px 0 0;

        color:var(--financial-muted);

    }


    .financial-button{

        display:inline-flex;

        align-items:center;

        justify-content:center;

        gap:8px;

        padding:11px 16px;

        border-radius:10px;

        text-decoration:none;

        font-weight:600;

        transition:.2s ease;

    }


    .financial-button-primary{

        background:var(--financial-green);

        color:#fff;

    }


    .financial-button-primary:hover{

        background:var(--financial-green-dark);

    }


    .financial-section{

        margin-bottom:38px;

    }


    .financial-section-header{

        margin-bottom:15px;

    }


    .financial-section-header h2{

        margin:0;

        color:var(--financial-text);

        font-size:1.35rem;

    }


    .financial-section-header p{

        margin:5px 0 0;

        color:var(--financial-muted);

        font-size:.88rem;

    }


    .financial-table-card{

        background:#fff;

        border-radius:16px;

        box-shadow:0 3px 16px rgba(0,0,0,.06);

        overflow:hidden;

    }


    .financial-table-wrapper{

        overflow-x:auto;

    }


    .financial-table{

        width:100%;

        border-collapse:collapse;

        min-width:760px;

    }


    .financial-table th{

        background:var(--financial-green-soft);

        color:var(--financial-green-dark);

        text-align:left;

        font-size:.76rem;

        text-transform:uppercase;

        letter-spacing:.04em;

        padding:13px 15px;

        white-space:nowrap;

    }


    .financial-table td{

        padding:15px;

        border-top:1px solid #edf1ee;

        color:var(--financial-text);

        vertical-align:middle;

    }


    .financial-record-name strong{

        display:block;

    }


    .financial-record-name span{

        display:block;

        margin-top:3px;

        color:var(--financial-muted);

        font-size:.75rem;

    }


    .financial-farm-own-label{

        color:var(--financial-green) !important;

        font-weight:600;

    }


    .financial-description{

        display:block;

        max-width:300px;

        line-height:1.4;

    }


    .financial-liability-amount{

        color:var(--financial-green-dark);

        white-space:nowrap;

    }


    .financial-recorder-name{

        color:var(--financial-muted);

        white-space:nowrap;

    }


    .financial-date{

        color:var(--financial-muted);

        white-space:nowrap;

        font-size:.85rem;

    }


    .financial-farm-list{

        display:flex;

        flex-direction:column;

        gap:22px;

    }


    .financial-farm-card{

        background:#fff;

        border-radius:18px;

        padding:18px;

        box-shadow:0 3px 16px rgba(0,0,0,.06);

    }


    .financial-farm-header{

        display:flex;

        align-items:center;

        justify-content:space-between;

        gap:20px;

        padding:4px 4px 18px;

    }


    .financial-farm-code{

        color:var(--financial-muted);

        font-size:.75rem;

    }


    .financial-farm-header h3{

        margin:3px 0;

        color:var(--financial-text);

        font-size:1.2rem;

    }


    .financial-farm-type{

        color:var(--financial-green);

        font-size:.8rem;

    }


    .financial-farm-total{

        text-align:right;

    }


    .financial-farm-total span{

        display:block;

        color:var(--financial-muted);

        font-size:.75rem;

    }


    .financial-farm-total strong{

        display:block;

        color:var(--financial-green-dark);

        font-size:1.15rem;

        margin-top:3px;

    }


    .financial-empty{

        display:flex;

        flex-direction:column;

        align-items:center;

        justify-content:center;

        gap:6px;

        min-height:150px;

        padding:25px;

        background:#fff;

        border-radius:16px;

        color:var(--financial-muted);

        text-align:center;

        box-shadow:0 3px 16px rgba(0,0,0,.05);

    }


    .financial-empty i{

        color:var(--financial-green);

        font-size:1.5rem;

        margin-bottom:4px;

    }


    .financial-empty strong{

        color:var(--financial-text);

    }


    .financial-empty-small{

        min-height:90px;

        box-shadow:none;

        background:var(--financial-green-soft);

    }


    @media(max-width:700px){

        .financial-page{

            padding:16px;

        }


        .financial-page-header{

            align-items:flex-start;

            flex-direction:column;

        }


        .financial-header-actions,
        .financial-button{

            width:100%;

        }


        .financial-farm-header{

            align-items:flex-start;

            flex-direction:column;

        }


        .financial-farm-total{

            text-align:left;

        }

    }

</style>