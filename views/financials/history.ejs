<% /* ==========================================================
   views/financials/history.ejs

   FINANCIAL / LIABILITY HISTORY PAGE

   SUPPORTED BACKEND DATA

   farms:
       Array of dairy farms.

       Each farm may contain:
           farm fields
           assets[]
           liabilities[]

   standaloneAssets:
       Array of standalone Dairy records/assets.

   farmGroups:
       Optional legacy structure.

   Each liability may contain:

       liability.dairy
       liability.amount
       liability.description
       liability.recordedByName
       liability.createdAt

   ========================================================== */


/* ==========================================================
   SAFE DATA
   ========================================================== */

const historyFarms =
    typeof farms !== "undefined" &&
    Array.isArray(farms)
        ? farms
        : [];


const historyStandaloneAssets =
    typeof standaloneAssets !== "undefined" &&
    Array.isArray(standaloneAssets)
        ? standaloneAssets
        : [];


const legacyFarmGroups =
    typeof farmGroups !== "undefined" &&
    Array.isArray(farmGroups)
        ? farmGroups
        : [];


/* ==========================================================
   HELPERS
   ========================================================== */

function historyNumber(value) {

    const result = Number(value);

    return Number.isFinite(result)
        ? result
        : 0;

}


function historyMoney(value) {

    return historyNumber(value).toLocaleString(
        "en-KE",
        {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
        }
    );

}


function historyDate(value) {

    if (!value) {

        return "—";

    }

    const date =
        new Date(value);


    if (
        Number.isNaN(
            date.getTime()
        )
    ) {

        return "—";

    }


    return date.toLocaleString(
        "en-KE",
        {
            dateStyle: "medium",
            timeStyle: "short"
        }
    );

}


/* ==========================================================
   BUILD FARM LIABILITY GROUPS
   ========================================================== */

const liabilityFarmGroups = [];


/* ==========================================================
   USE NEW FARM STRUCTURE
   ========================================================== */

historyFarms.forEach(function(farm) {

    if (!farm) {

        return;

    }


    const farmId =
        farm?._id
            ? farm._id.toString()
            : "";


    const liabilities = [];


    /* ======================================================
       FARM ITSELF
       ====================================================== */

    if (
        Array.isArray(
            farm.liabilities
        )
    ) {

        farm.liabilities.forEach(
            function(liability) {

                liabilities.push(
                    liability
                );

            }
        );

    }


    /* ======================================================
       FARM ASSETS
       ====================================================== */

    if (
        Array.isArray(
            farm.assets
        )
    ) {

        farm.assets.forEach(
            function(asset) {

                if (
                    !asset ||
                    !Array.isArray(
                        asset.liabilities
                    )
                ) {

                    return;

                }


                asset.liabilities.forEach(
                    function(liability) {

                        liabilities.push(
                            liability
                        );

                    }
                );

            }
        );

    }


    /*
     * Some controllers may already return a combined
     * liability array on the farm.
     */
    if (
        Array.isArray(
            farm.allLiabilities
        )
    ) {

        liabilities.length = 0;

        farm.allLiabilities.forEach(
            function(liability) {

                liabilities.push(
                    liability
                );

            }
        );

    }


    liabilityFarmGroups.push({

        farm: farm,

        farmId: farmId,

        liabilities: liabilities,

        totalLiabilities:
            liabilities.reduce(
                function(total, liability) {

                    return total +
                        historyNumber(
                            liability?.amount
                        );

                },
                0
            )

    });

});


/* ==========================================================
   FALLBACK TO LEGACY FARM GROUPS
   ========================================================== */

if (
    liabilityFarmGroups.length === 0 &&
    legacyFarmGroups.length > 0
) {

    legacyFarmGroups.forEach(
        function(group) {

            const liabilities =
                Array.isArray(
                    group?.liabilities
                )
                    ? group.liabilities
                    : [];


            liabilityFarmGroups.push({

                farm:
                    group?.farm || {},

                farmId:
                    group?.farm?._id
                        ? group.farm._id.toString()
                        : "",

                liabilities:
                    liabilities,

                totalLiabilities:
                    liabilities.reduce(
                        function(total, liability) {

                            return total +
                                historyNumber(
                                    liability?.amount
                                );

                        },
                        0
                    )

            });

        }
    );

}


/* ==========================================================
   DETERMINE WHETHER THERE IS ANY HISTORY
   ========================================================== */

const hasFarmHistory =
    liabilityFarmGroups.some(
        function(group) {

            return (
                Array.isArray(
                    group.liabilities
                ) &&
                group.liabilities.length > 0
            );

        }
    );


const hasStandaloneHistory =
    historyStandaloneAssets.some(
        function(group) {

            return (
                Array.isArray(
                    group?.liabilities
                ) &&
                group.liabilities.length > 0
            );

        }
    );

%>


<div class="financial-page liability-history-page">


    <!-- ======================================================
         HEADER
         ====================================================== -->

    <div class="financial-page-header">

        <div>

            <span class="financial-eyebrow">
                FINANCIALS
            </span>

            <h1 class="financial-title">
                Liability History
            </h1>

            <p class="financial-subtitle">
                Review liabilities recorded against
                dairy farms and assets.
            </p>

        </div>


        <div class="financial-header-actions">

            <a
                href="/financials/liability"
                class="financial-button financial-button-primary"
            >

                <i class="bi bi-plus-circle"></i>

                Record Liability

            </a>

        </div>

    </div>


    <!-- ======================================================
         STANDALONE ASSETS
         ====================================================== -->

    <section class="financial-section">

        <div class="financial-section-header">

            <div>

                <span class="financial-eyebrow">
                    STANDALONE
                </span>

                <h2>
                    Standalone Asset Liabilities
                </h2>

                <p>
                    Liabilities belonging to assets that
                    are not assigned to a dairy farm.
                </p>

            </div>

        </div>


        <% if (hasStandaloneHistory) { %>


            <div class="financial-table-card">

                <div class="financial-table-wrapper">

                    <table class="financial-table">

                        <thead>

                            <tr>

                                <th>
                                    Asset
                                </th>

                                <th>
                                    Type
                                </th>

                                <th>
                                    Description
                                </th>

                                <th>
                                    Amount
                                </th>

                                <th>
                                    Recorded By
                                </th>

                                <th>
                                    Date & Time
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            <% historyStandaloneAssets.forEach(
                                function(group)
                            { %>


                                <% if (
                                    Array.isArray(
                                        group?.liabilities
                                    ) &&
                                    group.liabilities.length
                                ) { %>


                                    <% group.liabilities.forEach(
                                        function(liability)
                                    { %>

                                        <tr>

                                            <td>

                                                <div class="financial-record-name">

                                                    <strong>

                                                        <%= group?.dairy?.name ||
                                                            group?.name ||
                                                            "Unnamed Asset"
                                                        %>

                                                    </strong>

                                                </div>

                                            </td>


                                            <td>

                                                <span class="financial-record-type">

                                                    <%= group?.dairy?.type ||
                                                        group?.type ||
                                                        "Standalone Asset"
                                                    %>

                                                </span>

                                            </td>


                                            <td>

                                                <span class="financial-description">

                                                    <%= liability?.description ||
                                                        "—"
                                                    %>

                                                </span>

                                            </td>


                                            <td>

                                                <strong class="financial-liability-amount">

                                                    KSh
                                                    <%= historyMoney(
                                                        liability?.amount
                                                    ) %>

                                                </strong>

                                            </td>


                                            <td>

                                                <span class="financial-recorder-name">

                                                    <%= liability?.recordedByName ||
                                                        "Unknown"
                                                    %>

                                                </span>

                                            </td>


                                            <td>

                                                <time
                                                    datetime="<%= liability?.createdAt || '' %>"
                                                    class="financial-date"
                                                >

                                                    <%= historyDate(
                                                        liability?.createdAt
                                                    ) %>

                                                </time>

                                            </td>

                                        </tr>

                                    <% }); %>


                                <% } %>


                            <% }); %>

                        </tbody>

                    </table>

                </div>

            </div>


        <% } else { %>


            <div class="financial-empty">

                <i class="bi bi-inbox"></i>

                <strong>
                    No standalone liabilities
                </strong>

                <span>
                    No liabilities have been recorded
                    for standalone assets.
                </span>

            </div>


        <% } %>

    </section>


    <!-- ======================================================
         DAIRY FARMS
         ====================================================== -->

    <section class="financial-section">

        <div class="financial-section-header">

            <div>

                <span class="financial-eyebrow">
                    DAIRY FARMS
                </span>

                <h2>
                    Farm Liabilities
                </h2>

                <p>
                    Liabilities recorded against farms
                    and assets belonging to those farms.
                </p>

            </div>

        </div>


        <% if (liabilityFarmGroups.length > 0) { %>


            <div class="financial-farm-list">


                <% liabilityFarmGroups.forEach(
                    function(group)
                { %>


                    <article class="financial-farm-card">


                        <!-- ==================================
                             FARM HEADER
                             ================================== -->

                        <div class="financial-farm-header">

                            <div>

                                <% if (
                                    group.farm?.code
                                ) { %>

                                    <span class="financial-farm-code">

                                        Farm Code:
                                        <%= group.farm.code %>

                                    </span>

                                <% } %>


                                <h3>

                                    <%= group.farm?.name ||
                                        "Unnamed Dairy Farm"
                                    %>

                                </h3>


                                <% if (
                                    group.farm?.type
                                ) { %>

                                    <span class="financial-farm-type">

                                        <%= group.farm.type %>

                                    </span>

                                <% } %>

                            </div>


                            <div class="financial-farm-total">

                                <span>
                                    Total Liabilities
                                </span>

                                <strong>

                                    KSh
                                    <%= historyMoney(
                                        group.totalLiabilities
                                    ) %>

                                </strong>

                            </div>

                        </div>


                        <!-- ==================================
                             LIABILITY TABLE
                             ================================== -->

                        <% if (
                            Array.isArray(
                                group.liabilities
                            ) &&
                            group.liabilities.length
                        ) { %>


                            <div class="financial-table-card">

                                <div class="financial-table-wrapper">

                                    <table class="financial-table">

                                        <thead>

                                            <tr>

                                                <th>
                                                    Dairy / Asset
                                                </th>

                                                <th>
                                                    Description
                                                </th>

                                                <th>
                                                    Amount
                                                </th>

                                                <th>
                                                    Recorded By
                                                </th>

                                                <th>
                                                    Date & Time
                                                </th>

                                            </tr>

                                        </thead>


                                        <tbody>


                                            <% group.liabilities.forEach(
                                                function(liability)
                                            { %>


                                                <%

                                                    const liabilityDairy =
                                                        liability?.dairy ||
                                                        {};

                                                    const liabilityDairyId =
                                                        liabilityDairy?._id
                                                            ? liabilityDairy._id.toString()
                                                            : "";

                                                    const currentFarmId =
                                                        group.farmId || "";

                                                    const isFarmItself =
                                                        liabilityDairyId &&
                                                        currentFarmId &&
                                                        liabilityDairyId ===
                                                        currentFarmId;

                                                %>


                                                <tr>

                                                    <td>

                                                        <div class="financial-record-name">

                                                            <strong>

                                                                <%= liabilityDairy?.name ||
                                                                    group.farm?.name ||
                                                                    "Unknown"
                                                                %>

                                                            </strong>


                                                            <% if (isFarmItself) { %>

                                                                <span class="financial-farm-own-label">

                                                                    Farm itself

                                                                </span>

                                                            <% } else { %>

                                                                <span>

                                                                    Farm asset

                                                                </span>

                                                            <% } %>

                                                        </div>

                                                    </td>


                                                    <td>

                                                        <span class="financial-description">

                                                            <%= liability?.description ||
                                                                "—"
                                                            %>

                                                        </span>

                                                    </td>


                                                    <td>

                                                        <strong class="financial-liability-amount">

                                                            KSh
                                                            <%= historyMoney(
                                                                liability?.amount
                                                            ) %>

                                                        </strong>

                                                    </td>


                                                    <td>

                                                        <span class="financial-recorder-name">

                                                            <%= liability?.recordedByName ||
                                                                "Unknown"
                                                            %>

                                                        </span>

                                                    </td>


                                                    <td>

                                                        <time
                                                            datetime="<%= liability?.createdAt || '' %>"
                                                            class="financial-date"
                                                        >

                                                            <%= historyDate(
                                                                liability?.createdAt
                                                            ) %>

                                                        </time>

                                                    </td>

                                                </tr>


                                            <% }); %>


                                        </tbody>

                                    </table>

                                </div>

                            </div>


                        <% } else { %>


                            <div class="financial-empty financial-empty-small">

                                <i class="bi bi-check-circle"></i>

                                <span>

                                    No liabilities recorded for
                                    this farm or its assets.

                                </span>

                            </div>


                        <% } %>


                    </article>


                <% }); %>


            </div>


        <% } else { %>


            <div class="financial-empty">

                <i class="bi bi-building"></i>

                <strong>
                    No dairy farms
                </strong>

                <span>
                    No dairy farms have been found.
                </span>

            </div>

        <% } %>


    </section>


</div>


<style>

