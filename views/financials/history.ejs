.financial-page-header{

    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:20px;
    margin-bottom:30px;

}


.liability-history-page
.financial-eyebrow{

    display:block;
    margin-bottom:5px;
    color:var(--financial-green);
