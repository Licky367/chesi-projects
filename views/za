<% /*

DAIRY FARM INTRODUCTION / H1

FILE:
views/update/h1.ejs

PURPOSE:
Compact editorial introductory section for a Dairy Farm.

DATA REQUIRED:
dairy

*/ %>

<section
    class="dairy-h1"
    aria-label="Dairy Farm Introduction"
><!-- =================================================
     BACKGROUND LOGO
================================================== -->

<div
    class="dairy-h1-background"
    aria-hidden="true"
>
    <img
        src="/images/h1.png"
        alt=""
        class="dairy-h1-logo"
    >
</div>


<!-- =================================================
     CONTENT
================================================== -->

<div class="dairy-h1-content">

    <div class="dairy-h1-label">
        <span class="dairy-h1-label-line"></span>
        <span>DAIRY FARM</span>
        <span class="dairy-h1-label-line"></span>
    </div>


    <h1 class="dairy-h1-title">
        Welcome to
        <span>
            <%= dairy.name || "Our Dairy Farm" %>
        </span>
    </h1>


    <% if (dairy && dairy.code != null) { %>
        <div class="dairy-h1-code">
            FARM #<%= dairy.code %>
        </div>
    <% } %>


    <div class="dairy-h1-message">

        <p>
            Welcome to
            <strong>
                <%= dairy.name || "this dairy farm" %>
            </strong>.
            We're glad to have you here.
        </p>

        <p>
            Support the activities here by updating us
            about the welfare of all assets within the
            dairy farm.
        </p>

        <p>
            In case of any inconveniences, keep us
            updated on this site.
        </p>

    </div>

</div>

</section><style>

/* =========================================================
   MAIN SECTION
========================================================= */

.dairy-h1 {

    position: relative;

    width: 100%;

    min-height: 390px;

    margin: 0 0 28px;

    overflow: hidden;

    background: #fff;

}


/* =========================================================
   BACKGROUND
========================================================= */

.dairy-h1-background {

    position: absolute;

    inset: 0;

    z-index: 0;

    display: flex;

    align-items: center;

    justify-content: center;

    overflow: hidden;

    pointer-events: none;

}


.dairy-h1-logo {

    display: block;

    width: min(720px, 105vw);

    height: auto;

    opacity: .11;

}


/* =========================================================
   CONTENT
========================================================= */

.dairy-h1-content {

    position: relative;

    z-index: 2;

    width: 100%;

    max-width: 1180px;

    min-height: 390px;

    margin: 0 auto;

    padding:
        38px
        clamp(20px, 5vw, 65px)
        34px;

    box-sizing: border-box;

    display: flex;

    flex-direction: column;

    justify-content: center;

    align-items: flex-start;

}


/* =========================================================
   LABEL
========================================================= */

.dairy-h1-label {

    display: flex;

    align-items: center;

    gap: 9px;

    margin-bottom: 12px;

    color: #426b4d;

    font-family:
        Arial,
        Helvetica,
        sans-serif;

    font-size: 9px;

    font-weight: 800;

    letter-spacing: 2.5px;

}


.dairy-h1-label-line {

    width: 27px;

    height: 1px;

    background:
        rgba(66, 107, 77, .65);

}


/* =========================================================
   TITLE
========================================================= */

.dairy-h1-title {

    max-width: 820px;

    margin: 0;

    color: #263d2d;

    font-family:
        Georgia,
        "Times New Roman",
        serif;

    font-size:
        clamp(34px, 4.5vw, 56px);

    line-height: 1.02;

    letter-spacing: -1.3px;

    font-weight: 700;

}


.dairy-h1-title span {

    display: block;

    margin-top: 4px;

    color: #3d6849;

}


/* =========================================================
   FARM CODE
========================================================= */

.dairy-h1-code {

    margin-top: 9px;

    color: #55765c;

    font-family:
        Arial,
        Helvetica,
        sans-serif;

    font-size: 8px;

    font-weight: 800;

    letter-spacing: 1.6px;

    text-transform: uppercase;

}


/* =========================================================
   MESSAGE
========================================================= */

.dairy-h1-message {

    max-width: 650px;

    margin-top: 19px;

}


.dairy-h1-message p {

    margin: 0 0 7px;

    color:
        rgba(39, 58, 45, .84);

    font-family:
        Arial,
        Helvetica,
        sans-serif;

    font-size:
        clamp(12px, 1.35vw, 14px);

    line-height: 1.55;

    font-weight: 400;

}


.dairy-h1-message p:last-child {

    margin-bottom: 0;

}


.dairy-h1-message strong {

    color: #3f6848;

    font-weight: 700;

}


/* =========================================================
   TABLETS
========================================================= */

@media (max-width: 900px) {

    .dairy-h1 {

        min-height: 365px;

    }

    .dairy-h1-content {

        min-height: 365px;

        padding:
            34px
            28px
            30px;

    }

    .dairy-h1-logo {

        width: min(650px, 110vw);

    }

}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 650px) {

    .dairy-h1 {

        min-height: 400px;

        margin-bottom: 22px;

    }

    .dairy-h1-content {

        min-height: 400px;

        padding:
            30px
            20px
            28px;

    }

    .dairy-h1-logo {

        width: 520px;

        max-width: 130vw;

        opacity: .10;

    }

    .dairy-h1-label {

        margin-bottom: 10px;

        font-size: 8px;

        letter-spacing: 2px;

    }

    .dairy-h1-title {

        font-size:
            clamp(30px, 9vw, 41px);

        letter-spacing: -.8px;

    }

    .dairy-h1-title span {

        margin-top: 3px;

    }

    .dairy-h1-code {

        margin-top: 8px;

        font-size: 7.5px;

    }

    .dairy-h1-message {

        margin-top: 17px;

    }

    .dairy-h1-message p {

        font-size: 12.5px;

        line-height: 1.55;

        margin-bottom: 6px;

    }

}


/* =========================================================
   VERY SMALL PHONES
========================================================= */

@media (max-width: 380px) {

    .dairy-h1 {

        min-height: 385px;

    }

    .dairy-h1-content {

        min-height: 385px;

        padding:
            27px
            16px
            25px;

    }

    .dairy-h1-title {

        font-size: 29px;

    }

    .dairy-h1-message {

        margin-top: 15px;

    }

    .dairy-h1-message p {

        font-size: 12px;

        line-height: 1.5;

    }

    .dairy-h1-logo {

        width: 470px;

    }

}

</style>