<!-- ==========================================================
     DAIRY FARMS
     
     Rules:
     - Dairy record must have a negative code.
     
     Each item opens the farm/structure page.
     
     The farm page will then display all positive-code Dairy
     records whose assetCode equals the farm's code.
========================================================== -->

<section class="networth-section">

    <div class="networth-section-header">

        <div>

            <h2>
                Dairy Farms
            </h2>

            <p>
                Dairy farms and facilities containing assigned assets.
            </p>

        </div>

    </div>


    <div class="networth-list">

        <% if (
            Array.isArray(structures) &&
            structures.length > 0
        ) { %>


            <% structures.forEach(function(farm) { %>

                <a
                    href="/networth/structure/<%= farm._id %>"
                    class="networth-list-item networth-structure-item"
                >

                    <span class="networth-list-name">

                        <%= farm.name || farm.item || farm.code %>

                    </span>

                </a>

            <% }); %>


        <% } else { %>

            <div class="networth-empty">

                No Dairy Farms found.

            </div>

        <% } %>

    </div>

</section>