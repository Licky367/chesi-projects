<!-- ==========================================================
     views/networth/dairy-farms.ejs

     Displays ALL Dairy Farms / structures.

     A Dairy Farm is defined by:
         dairy.code < 0

     Every negative-code Dairy record is displayed.

     The Dairy _id is used to open the farm detail page.
========================================================== --><section class="networth-section"><!-- ======================================================
     SECTION HEADER
======================================================= -->

<div class="networth-section-header">

    <div>

        <h2>
            Dairy Farms
        </h2>

        <p>
            Dairy farms and facilities containing assigned assets.
        </p>

    </div>

</div>


<!-- ======================================================
     DAIRY FARM LIST
======================================================= -->

<div class="networth-list">

    <%
        /*
         * `structures` is expected to contain the Dairy
         * records supplied to this partial.
         *
         * We explicitly filter here so that this view
         * only displays records whose code is negative.
         *
         * Number() also allows the check to work if the
         * value happens to arrive as a numeric string.
         */

        const dairyFarms =
            Array.isArray(structures)
                ? structures.filter(function (dairy) {

                    return (
                        dairy &&
                        dairy.code !== null &&
                        dairy.code !== undefined &&
                        Number(dairy.code) < 0
                    );

                })
                : [];
    %>


    <% if (dairyFarms.length > 0) { %>


        <% dairyFarms.forEach(function (dairy) { %>


            <!-- ==========================================
                 DAIRY FARM / STRUCTURE
            =========================================== -->

            <a
                href="/networth/structure/<%= dairy._id %>"
                class="networth-list-item networth-structure-item"
            >

                <span class="networth-list-name">

                    <%= dairy.name || dairy.item || dairy.code %>

                </span>

            </a>


        <% }); %>


    <% } else { %>


        <!-- ==========================================
             EMPTY STATE
        =========================================== -->

        <div class="networth-empty">

            No Dairy Farms found.

        </div>


    <% } %>


</div>

</section>