<!-- ==========================================================
     views/networth/dairy-farms.ejs

     Displays ALL Dairy Farm records.

     MODEL DEFINITION:

         code < 0
             = Dairy Farm

         code > 0
             = Animal

         code === null
             = Structure / Facility / Equipment

     This partial therefore displays ONLY records whose
     `code` is negative.

     `assetCode` is always null for a Dairy Farm.
========================================================== --><section class="networth-section"><!-- ======================================================
     SECTION HEADER
======================================================= -->

<div class="networth-section-header">

    <div>

        <h2>
            Dairy Farms
        </h2>

        <p>
            Dairy farms and their current estimated worth.
        </p>

    </div>

</div>


<!-- ======================================================
     DAIRY FARM LIST
======================================================= -->

<div class="networth-list">


    <%
        /*
         * `structures` is the collection supplied by the
         * controller/service for this partial.
         *
         * The model defines a Dairy Farm exclusively by
         * a negative `code`.
         *
         * We keep the filtering defensive here so the
         * partial cannot accidentally display animals or
         * standalone structures.
         */

        const dairyFarms =
            Array.isArray(structures)

                ? structures.filter(function (dairy) {

                    return (

                        dairy &&

                        dairy.code !== null &&

                        dairy.code !== undefined &&

                        Number(dairy.code) < 0

                    );

                })

                : [];
    %>


    <% if (dairyFarms.length > 0) { %>


        <% dairyFarms.forEach(function (dairy) { %>


            <!-- ==========================================
                 DAIRY FARM
            =========================================== -->

            <a
                href="/networth/structure/<%= dairy._id %>"
                class="networth-list-item networth-structure-item"
            >


                <span class="networth-list-name">

                    <%= dairy.name || dairy.code %>

                </span>


            </a>


        <% }); %>


    <% } else { %>


        <!-- ==========================================
             EMPTY STATE
        =========================================== -->

        <div class="networth-empty">

            No Dairy Farms found.

        </div>


    <% } %>


</div>

</section>