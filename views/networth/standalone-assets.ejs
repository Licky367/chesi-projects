<!-- ==========================================================
     standalone-assets.ejs

     Displays identified dairy / animal assets that are
     currently not assigned to a Dairy Farm.

     STANDALONE ASSET:

         code > 0
         assetCode === null

     NOT INCLUDED:

         code < 0
             = Dairy Farm

         code === null
             = Manual asset

         assetCode !== null
             = Assigned asset
========================================================== -->


<section class="networth-section">


    <!-- ======================================================
         SECTION HEADER
    ======================================================= -->

    <div class="networth-section-header">

        <div>

            <h2>
                Standalone Assets
            </h2>

            <p>
                Identified dairy assets that are not assigned
                to a Dairy Farm.
            </p>

        </div>

    </div>


    <!-- ======================================================
         ASSET LIST
    ======================================================= -->

    <div class="networth-list">


        <% if (
            Array.isArray(standaloneAssets) &&
            standaloneAssets.length > 0
        ) { %>


            <% standaloneAssets.forEach(function(dairy) { %>


                <a
                    href="/networth/asset/<%= dairy._id %>"
                    class="networth-list-item"
                >


                    <!-- ======================================
                         ASSET NAME
                    ======================================= -->

                    <span class="networth-list-name">

                        <%= dairy.name || dairy.code %>

                    </span>


                </a>


            <% }); %>


        <% } else { %>


            <!-- ==============================================
                 EMPTY STATE
            =============================================== -->

            <div class="networth-empty">

                No standalone assets found.

            </div>


        <% } %>


    </div>


</section>