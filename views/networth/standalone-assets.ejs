<!-- ==================.========================================
     standalone-assets.ejs
     
     Displays ALL standalone dairy assets.

     A standalone asset is an identified dairy/animal where:
         code > 0
         assetCode is null / undefined

     The backend should already provide `standaloneAssets`
     containing only records satisfying those rules.
========================================================== --><section class="networth-section"><div class="networth-section-header">

    <div>

        <h2>
            Standalone Assets
        </h2>

        <p>
            Dairy assets that have not yet been assigned
            to a Dairy Farm.
        </p>

    </div>

</div>


<div class="networth-list">

    <% if (
        Array.isArray(standaloneAssets) &&
        standaloneAssets.length > 0
    ) { %>


        <% standaloneAssets.forEach(function (dairy) { %>

            <%
                /*
                 * A standalone asset must:
                 *
                 * 1. Have a positive dairy code.
                 * 2. Have no assetCode assigned.
                 *
                 * The backend should already enforce this,
                 * but these checks prevent an incorrectly
                 * supplied record from being displayed here.
                 */

                const isStandalone =
                    Number.isInteger(dairy.code) &&
                    dairy.code > 0 &&
                    (
                        dairy.assetCode === null ||
                        dairy.assetCode === undefined
                    );
            %>


            <% if (isStandalone) { %>

                <a
                    href="/networth/asset/<%= dairy._id %>"
                    class="networth-list-item"
                >

                    <span class="networth-list-name">

                        <%= dairy.name || dairy.item || dairy.code %>

                    </span>

                </a>

            <% } %>


        <% }); %>


    <% } else { %>

        <div class="networth-empty">

            No standalone assets found.

        </div>

    <% } %>

</div>

</section>