<style>

  /* =========================
     PAGE
  ========================= */

  .dairy-page {
    max-width: 1050px;

    margin: 0 auto;

    padding: 20px 0 40px;
  }


  /* =========================
     HEADER
  ========================= */

  .dairy-header {
    display: flex;

    align-items: flex-start;

    justify-content: space-between;

    margin-bottom: 25px;
  }

  .dairy-header h2 {
    margin: 0 0 7px;

    color: #166534;

    font-size: 28px;

    font-weight: 700;
  }

  .dairy-header p {
    margin: 0;

    color: #6b7280;

    font-size: 14px;
  }


  /* =========================
     LIST
  ========================= */

  .dairy-list {
    list-style: none;

    padding: 0;

    margin: 0;

    overflow: hidden;

    border-radius: 18px;

    background: #ffffff;

    box-shadow:
      0 6px 20px rgba(0, 0, 0, 0.06);
  }


  /* =========================
     ITEM
  ========================= */

  .dairy-item {
    border-bottom: 1px solid #e5e7eb;

    transition: background 0.25s ease;
  }

  .dairy-item:last-child {
    border-bottom: none;
  }

  .dairy-item:hover {
    background: #fcfffd;
  }


  /* =========================
     MAIN LINK
  ========================= */

  .dairy-link {
    display: flex;

    align-items: center;

    gap: 16px;

    padding: 18px;

    color: #111827;

    text-decoration: none;

    transition: all 0.25s ease;
  }

  .dairy-link:hover {
    color: #166534;
  }


  /* =========================
     AVATAR
  ========================= */

  .dairy-avatar {
    width: 64px;
    height: 64px;

    flex-shrink: 0;

    object-fit: cover;

    border: 3px solid #dcfce7;

    border-radius: 50%;

    background: #f0fdf4;
  }


  /* =========================
     DETAILS
  ========================= */

  .dairy-details {
    flex: 1;

    min-width: 0;
  }

  .dairy-name {
    margin-bottom: 6px;

    color: #111827;

    font-size: 17px;

    font-weight: 700;
  }

  .dairy-code {
    margin-bottom: 7px;

    color: #6b7280;

    font-size: 13px;
  }


  /* =========================
     STATUS BADGES
  ========================= */

  .status-badge {
    display: inline-flex;

    align-items: center;

    gap: 5px;

    padding: 5px 10px;

    border-radius: 20px;

    font-size: 11px;

    font-weight: 700;
  }

  .status-ok {
    background: #dcfce7;

    color: #166534;
  }

  .status-maintenance {
    background: #fee2e2;

    color: #b91c1c;
  }


  /* =========================
     ARROW
  ========================= */

  .dairy-arrow {
    color: #9ca3af;

    font-size: 24px;

    transition: all 0.25s ease;
  }

  .dairy-link:hover .dairy-arrow {
    color: #16a34a;

    transform: translateX(5px);
  }


  /* =========================
     RESPONSIVE
  ========================= */

  @media (max-width: 650px) {

    .dairy-header h2 {
      font-size: 24px;
    }

    .dairy-link {
      padding: 15px;
    }

    .dairy-avatar {
      width: 55px;
      height: 55px;
    }

    .dairy-name {
      font-size: 15px;
    }

    .dairy-arrow {
      font-size: 20px;
    }

  }

</style>


<div class="dairy-page">


  <!-- =========================
       HEADER
  ========================= -->

  <div class="dairy-header">

    <div>

      <h2>
        🏢 Dairy Structures
      </h2>

      <p>
        View facilities and manage maintenance status.
      </p>

    </div>

  </div>


  <% if (dairies && dairies.length > 0) { %>


    <ul class="dairy-list">


      <% dairies.forEach(dairy => { %>


        <% if (dairy.code < 0) { %>


          <li class="dairy-item">


            <!-- =========================
                 DAIRY INFORMATION
            ========================= -->

            <a
              href="/dairy/<%= dairy._id %>"
              class="dairy-link"
            >


              <div>

                <% if (
                  dairy.profileImage &&
                  dairy.profileImage.trim() !== ""
                ) { %>

                  <img
                    src="/uploads/<%= dairy.profileImage %>"
                    class="dairy-avatar"
                    alt="<%= dairy.name %>"
                  >

                <% } else { %>

                  <img
                    src="https://ui-avatars.com/api/?name=<%= encodeURIComponent(dairy.name || 'Dairy') %>&background=0b5d1e&color=fff"
                    class="dairy-avatar"
                    alt="<%= dairy.name %>"
                  >

                <% } %>

              </div>


              <div class="dairy-details">


                <div class="dairy-name">

                  <%= dairy.name %>

                </div>


                <div class="dairy-code">

                  Facility Code:
                  <strong><%= dairy.code %></strong>

                </div>


                <% if (dairy.needsMaintenance === true) { %>


                  <span class="status-badge status-maintenance">

                    ⚠️ Needs Repair / Maintenance

                  </span>


                <% } else { %>


                  <span class="status-badge status-ok">

                    ✓ Facility OK

                  </span>


                <% } %>


              </div>


              <span class="dairy-arrow">

                →

              </span>


            </a>


          </li>


        <% } %>


      <% }) %>


    </ul>


  <% } else { %>


    <!-- =========================
         EMPTY STATE
    ========================= -->

    <div class="empty-state">

      <div class="empty-state-icon">
        🏢
      </div>

      <h3>
        No Dairy Structures Found
      </h3>

      <p>
        There are currently no dairy structures available to display.
      </p>

    </div>


  <% } %>


</div>