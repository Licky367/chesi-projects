<% /*

MILK COLLECTION PAGE

EXPECTED CONTROLLER DATA:

dairies
session
isAdmin
success
error

SESSION VALUES:

"morning"  = 00:00 - 10:00
"closed"   = 10:00 - 16:00
"evening"  = 16:00 - 00:00

EACH DAIRY MAY HAVE:

dairy.morning
dairy.evening

IMPORTANT:

The EJS only displays records.

The controller/service MUST enforce:
  - one record per cow per session
  - submission time restrictions
  - admin-only editing
  - closed-window restrictions

==========================================================
SAFE DEFAULTS

*/

const pageError =
typeof error !== "undefined"
? error
: "";

const pageSuccess =
typeof success !== "undefined"
? Boolean(success)
: false;

const currentSession =
typeof session !== "undefined"
? session
: "";

const adminUser =
typeof isAdmin !== "undefined"
? Boolean(isAdmin)
: (
typeof user !== "undefined" &&
user &&
user.role === "admin"
);

const milkDairies =
typeof dairies !== "undefined" &&
Array.isArray(dairies)
? dairies
: [];

%>

<!-- ==================================================
     HEADER
================================================== --><div class="milk-header">  <div><h2>
  🥛 Milk Collection
</h2>

<p>
  Record milk production for each dairy animal.
</p>

  </div>  <div class="milk-icon">
    🥛
  </div></div><!-- ==================================================
     ERROR
================================================== --><% if (pageError) { %>

  <div class="milk-error">⚠️ <%= pageError %>

  </div><% } %>

<!-- ==================================================
     SUCCESS
================================================== --><% if (pageSuccess) { %>

  <div class="milk-success">✓ Milk record saved successfully.

  </div><% } %>

<!-- ==================================================
     CURRENT COLLECTION WINDOW
================================================== --><% if (currentSession === "morning") { %>

  <div class="milk-status">🌅

<strong>
  Morning collection is open.
</strong>

Submit one record per cow before
10:00 AM.

  </div><% } else if (currentSession === "closed") { %>

  <div class="milk-status warning">⏰

<strong>
  Collection is temporarily closed.
</strong>

Morning collection closed at
10:00 AM.

Evening collection opens at
4:00 PM.

<% if (!adminUser) { %>

  If a correction is required,
  contact an administrator.

<% } else { %>

  Administrators can still edit
  existing morning records.

<% } %>

  </div><% } else if (currentSession === "evening") { %>

  <div class="milk-status">🌆

<strong>
  Evening collection is open.
</strong>

Submit one record per cow before
midnight.

  </div><% } else { %>

  <div class="milk-status warning">⏰

<strong>
  Collection window unavailable.
</strong>

Please contact an administrator
if this continues.

  </div><% } %>

<!-- ==================================================
     ANIMALS
================================================== --><% if (milkDairies.length === 0) { %>

  <div class="empty-state"><div class="empty-icon">
  🐄
</div>

<h3>
  No Animals Currently Being Milked
</h3>

<p>
  There are no active dairy animals available.
</p>

  </div><% } else { %>

  <!-- ==================================================
       MILK FORM
  ================================================== -->  <form
    action="/milk"
    method="POST"
    id="milkForm"
  ><div class="milk-table-wrapper">

  <table class="milk-table">

    <thead>

      <tr>

        <th>
          Code
        </th>

        <th>
          Name
        </th>

        <th>
          Milk (L)
        </th>

        <th>
          Remarks
        </th>

      </tr>

    </thead>


    <tbody>

      <% milkDairies.forEach((dairy, index) => {

        /*
        ==================================================
        DETERMINE THE RECORD TO DISPLAY
        ==================================================

        MORNING:
          Only dairy.morning is relevant.

        EVENING:
          Only dairy.evening is relevant.

        CLOSED:
          Morning is the most recently closed session,
          so display dairy.morning.

        We deliberately DO NOT use:

          dairy.morning || dairy.evening

        because that could expose an unrelated session.
        */

        let record = null;

        if (currentSession === "morning") {

          record =
            dairy.morning || null;

        } else if (currentSession === "evening") {

          record =
            dairy.evening || null;

        } else if (currentSession === "closed") {

          record =
            dairy.morning || null;

        }

      %>


        <tr>


          <!-- ==================================================
               CODE
          ================================================== -->

          <td>

            <span class="code-badge">

              #<%= dairy.code %>

            </span>

          </td>


          <!-- ==================================================
               NAME
          ================================================== -->

          <td>

            <span class="animal-name">

              <%= dairy.name %>

            </span>

          </td>


          <!-- ==================================================
               MILK
          ================================================== -->

          <td>

            <% if (record) { %>

              <!--
              Existing record.

              It is always readonly in the collection form.
              Admin editing happens through the edit modal.
              -->

              <input
                class="milk-input readonly-input"
                type="number"
                value="<%= Number(record.liters || 0) %>"
                readonly
              >


            <% } else if (
              currentSession === "morning" ||
              currentSession === "evening"
            ) { %>

              <!--
              No record exists for the CURRENT session.

              This cow can therefore be submitted.
              -->

              <input
                class="milk-input"
                type="number"
                step="0.1"
                min="0"
                name="records[<%= index %>][liters]"
                placeholder="0.0"
                required
              >

              <input
                type="hidden"
                name="records[<%= index %>][dairy]"
                value="<%= dairy._id %>"
              >


            <% } else { %>

              <!--
              Closed period.

              No new records can be submitted.
              -->

              <input
                class="milk-input readonly-input"
                type="number"
                value="0"
                readonly
              >

            <% } %>

          </td>


          <!-- ==================================================
               REMARKS
          ================================================== -->

          <td>


            <% if (record) { %>

              <!--
              EXISTING RECORD
              -->

              <textarea
                class="remarks-input readonly-input"
                readonly
              ><%= record.remarks || "" %></textarea>


              <!-- ==================================================
                   RECORD INFORMATION
              ================================================== -->

              <div class="recorded">


                <% if (
                  record.recordedByType === "system"
                ) { %>

                  <strong class="system-record">

                    System

                  </strong>

                  Automatically recorded as
                  Not Milked.


                <% } else { %>

                  <strong>

                    Recorded

                  </strong>

                  This cow has already been
                  recorded for this session.

                <% } %>


              </div>


              <!-- ==================================================
                   ADMIN EDIT
              ================================================== -->

              <% if (
                adminUser &&
                record._id
              ) { %>

                <div class="admin-edit">

                  <button
                    type="button"
                    onclick="openEditModal(
                      '<%= record._id %>',
                      '<%= Number(record.liters || 0) %>',
                      <%- JSON.stringify(record.remarks || "") %>
                    )"
                  >

                    ✏️ Edit Record

                  </button>

                </div>

              <% } %>


            <% } else if (
              currentSession === "morning" ||
              currentSession === "evening"
            ) { %>

              <!-- ==================================================
                   NEW RECORD
              ================================================== -->

              <textarea
                class="remarks-input"
                name="records[<%= index %>][remarks]"
                placeholder="Optional remarks..."
              ></textarea>


            <% } else { %>

              <!-- ==================================================
                   CLOSED
              ================================================== -->

              <textarea
                class="remarks-input readonly-input"
                readonly
              >No new records can be submitted during this period.</textarea>

            <% } %>


          </td>


        </tr>


      <% }); %>

    </tbody>

  </table>

</div>


<!-- ==================================================
     SUBMIT SECTION
================================================== -->

<div class="submit-section">


  <div class="submit-hint">


    <% if (currentSession === "morning") { %>

      🌅

      Morning collection is open until
      10:00 AM.

      Each cow can be recorded once.


    <% } else if (currentSession === "closed") { %>

      🔒

      Morning collection has closed.

      New submissions are unavailable
      until 4:00 PM.

      <% if (adminUser) { %>

        Administrators can still edit
        existing morning records.

      <% } else { %>

        Contact an administrator if
        a correction is required.

      <% } %>


    <% } else if (currentSession === "evening") { %>

      🌆

      Evening collection is open until
      midnight.

      Each cow can be recorded once.


    <% } else { %>

      🔒

      The current collection window
      is unavailable.

    <% } %>


  </div>


  <!-- ==================================================
       SUBMIT BUTTON
  ================================================== -->

  <button
    type="submit"
    class="submit-btn"

    <% if (
      currentSession !== "morning" &&
      currentSession !== "evening"
    ) { %>

      disabled

    <% } %>
  >

    ✓ Submit Milk Records

  </button>


</div>

  </form><% } %>

<!-- ==================================================
     ADMIN EDIT MODAL
================================================== --><div
  id="editMilkModal"
  class="milk-modal"
>  <div class="milk-modal-box"><h3>

  ✏️ Edit Milk Record

</h3>


<p>

  You are editing an existing milk record.

  Changes will be recorded under your
  administrator account.

</p>


<form
  id="editMilkForm"
  method="POST"
>


  <label for="editLiters">

    Milk (Liters)

  </label>


  <input
    id="editLiters"
    class="milk-input"
    type="number"
    step="0.1"
    min="0"
    name="liters"
    required
  >


  <label for="editRemarks">

    Remarks

  </label>


  <textarea
    id="editRemarks"
    class="remarks-input"
    name="remarks"
  ></textarea>


  <div class="modal-actions">


    <button
      type="button"
      onclick="closeEditModal()"
    >

      Cancel

    </button>


    <button
      type="submit"
      class="modal-ok"
    >

      Save Changes

    </button>


  </div>


</form>

  </div></div><!-- ==================================================
     EDIT MODAL JAVASCRIPT
================================================== --><script>

  // ==================================================
  // OPEN EDIT MODAL
  // ==================================================

  function openEditModal(
    id,
    liters,
    remarks
  ) {

    const modal =
      document.getElementById(
        "editMilkModal"
      );

    const form =
      document.getElementById(
        "editMilkForm"
      );

    const litersInput =
      document.getElementById(
        "editLiters"
      );

    const remarksInput =
      document.getElementById(
        "editRemarks"
      );


    if (
      !modal ||
      !form ||
      !litersInput ||
      !remarksInput
    ) {

      return;

    }


    form.action =
      "/milk/edit/" + id;


    litersInput.value =
      liters;


    remarksInput.value =
      remarks || "";


    modal.classList.add(
      "show"
    );

  }


  // ==================================================
  // CLOSE EDIT MODAL
  // ==================================================

  function closeEditModal() {

    const modal =
      document.getElementById(
        "editMilkModal"
      );


    if (modal) {

      modal.classList.remove(
        "show"
      );

    }

  }


  // ==================================================
  // CLOSE WHEN CLICKING OUTSIDE MODAL
  // ==================================================

  const editMilkModal =
    document.getElementById(
      "editMilkModal"
    );


  if (editMilkModal) {

    editMilkModal.addEventListener(
      "click",
      function(event) {

        if (
          event.target === this
        ) {

          closeEditModal();

        }

      }
    );

  }


  // ==================================================
  // ESCAPE KEY
  // ==================================================

  document.addEventListener(
    "keydown",
    function(event) {

      if (
        event.key === "Escape"
      ) {

        closeEditModal();

      }

    }
  );

</script>