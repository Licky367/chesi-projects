  Select Daily or Monthly report type to view milk statistics.
</p>

</div>


</div>


<% } %>


</div>


<!-- =====================================================
     POPUP JAVASCRIPT
===================================================== -->

<script>

document.addEventListener(
  "DOMContentLoaded",
  function () {

    const overlay =
      document.getElementById(
        "milkMessageOverlay"
      );


    const button =
      document.getElementById(
        "milkMessageButton"
      );


    if (!overlay || !button) {

      return;

    }


    overlay.classList.add("show");


    button.addEventListener(
      "click",
      function () {

        overlay.classList.remove("show");


        /*
         * Refresh the page after OK.
         *
         * This removes the success/error query
         * parameter that caused the popup.
         */

        window.location.reload();

      }
    );


    /*
     * Prevent clicking outside the popup
     * from accidentally dismissing it.
     */

    overlay.addEventListener(
      "click",
      function (event) {

        if (
          event.target === overlay
        ) {

          return;

        }

      }
    );

  }
);

</script>