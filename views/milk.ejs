<!-- =========================================================
     MILK COLLECTION PAGE

     FILE:
     views/milk.ejs

     PURPOSE
     ---------------------------------------------------------
     Records today's milk production.

     DATA PROVIDED BY:
     controllers/milkCollectController.js

     EXPECTED DATA:
     ---------------------------------------------------------
     day
     month
     farms
     isAdmin
     user
     success
     error

     FARM:
     ---------------------------------------------------------
     Each farm contains:

         _id
         name
         code
         animals
         total

     ANIMAL:
     ---------------------------------------------------------
     Each animal contains:

         _id
         name
         code
         assetCode
         isMilking
         morning
         evening

     EXISTING RECORD:
     ---------------------------------------------------------
     morning / evening may contain:

         liters
         remarks
         session
         day
         date
         recordedBy

     PERMISSIONS:
     ---------------------------------------------------------
     Admin:
         • Can create records
         • Can edit existing records

     Dairy Worker:
         • Can create records
         • Cannot edit existing records
========================================================= -->


<!-- =========================================================
     STYLESHEET
========================================================= -->

<link
    rel="stylesheet"
    href="/css/milk.css"
>


<!-- =========================================================
     PAGE
========================================================= -->

<div class="milk-page">


    <!-- =====================================================
         PAGE HEADER
    ====================================================== -->

    <header class="milk-header">

        <div class="milk-header-content">

            <h1>
                Record Today's Milk
            </h1>

            <p class="milk-date">

                <%= day %>

            </p>

        </div>


        <!-- ================================================
             USER ROLE
        ================================================= -->

        <div class="milk-role-badge">

            <% if (isAdmin) { %>

                Administrator

            <% } else { %>

                Dairy Worker

            <% } %>

        </div>

    </header>



    <!-- =====================================================
         FLASH / STATUS MESSAGES
    ====================================================== -->

    <% if (
        typeof success !== "undefined" &&
        success
    ) { %>

        <div
            class="milk-message milk-success"
            role="alert"
        >

            <%= success %>

        </div>

    <% } %>


    <% if (
        typeof error !== "undefined" &&
        error
    ) { %>

        <div
            class="milk-message milk-error"
            role="alert"
        >

            <%= error %>

        </div>

    <% } %>



    <!-- =====================================================
         NO FARMS
    ====================================================== -->

    <% if (
        !farms ||
        farms.length === 0
    ) { %>


        <section class="milk-empty">

            <h2>
                No Dairy Farms Available
            </h2>

            <p>

                There are currently no dairy farms available
                for milk collection.

            </p>

        </section>


    <% } %>



    <!-- =====================================================
         COLLECTION FORM
    ====================================================== -->

    <% if (
        farms &&
        farms.length > 0
    ) { %>


        <form
            action="/milk"
            method="POST"
            id="milkCollectionForm"
            autocomplete="off"
        >


            <!-- =================================================
                 FARMS
            ================================================== -->

            <% farms.forEach(
                function(farm) {
            { %>


                <section
                    class="milk-farm-section"
                    data-farm-id="<%= farm._id %>"
                    data-farm-code="<%= farm.code %>"
                >


                    <!-- =========================================
                         FARM HEADER
                    ========================================== -->

                    <div class="milk-farm-header">


                        <!-- =====================================
                             FARM INFORMATION
                        ====================================== -->

                        <div class="milk-farm-information">

                            <h2>
                                <%= farm.name %>
                            </h2>

                            <span class="milk-farm-code">

                                Farm Code:
                                <%= farm.code %>

                            </span>

                        </div>



                        <!-- =====================================
                             FARM TOTAL
                        ====================================== -->

                        <div class="milk-farm-total">

                            <span>
                                Today's Farm Total
                            </span>

                            <strong>

                                <%= Number(
                                    farm.total || 0
                                ).toFixed(2) %>
                                L

                            </strong>

                        </div>


                    </div>



                    <!-- =========================================
                         FARM HAS NO MILKING ANIMALS
                    ========================================== -->

                    <% if (
                        !farm.animals ||
                        farm.animals.length === 0
                    ) { %>


                        <div class="milk-no-animals">

                            No milking animals are currently
                            registered for this farm.

                        </div>


                    <% } else { %>



                        <!-- =====================================
                             TABLE WRAPPER
                        ====================================== -->

                        <div class="milk-table-wrapper">


                            <table class="milk-table">


                                <!-- =================================
                                     TABLE HEADER
                                ================================== -->

                                <thead>

                                    <tr>

                                        <th
                                            rowspan="2"
                                            scope="col"
                                        >
                                            Animal
                                        </th>

                                        <th
                                            colspan="2"
                                            scope="colgroup"
                                        >
                                            Morning
                                        </th>

                                        <th
                                            colspan="2"
                                            scope="colgroup"
                                        >
                                            Evening
                                        </th>

                                    </tr>


                                    <tr>

                                        <th scope="col">
                                            Liters
                                        </th>

                                        <th scope="col">
                                            Remarks
                                        </th>

                                        <th scope="col">
                                            Liters
                                        </th>

                                        <th scope="col">
                                            Remarks
                                        </th>

                                    </tr>

                                </thead>



                                <!-- =================================
                                     TABLE BODY
                                ================================== -->

                                <tbody>


                                    <% farm.animals.forEach(
                                        function(animal) {
                                    { %>


                                        <%
                                            /*
                                             * Existing records supplied
                                             * by milkCollectService.
                                             */

                                            const morning =
                                                animal.morning ||
                                                null;

                                            const evening =
                                                animal.evening ||
                                                null;


                                            /*
                                             * Existing records are locked
                                             * for dairy workers.
                                             *
                                             * Administrators may edit them.
                                             */

                                            const morningLocked =
                                                Boolean(
                                                    morning
                                                );

                                            const eveningLocked =
                                                Boolean(
                                                    evening
                                                );


                                            /*
                                             * Existing values.
                                             */

                                            const morningLiters =
                                                morning &&
                                                morning.liters !== undefined
                                                    ? morning.liters
                                                    : "";

                                            const morningRemarks =
                                                morning &&
                                                morning.remarks
                                                    ? morning.remarks
                                                    : "";

                                            const eveningLiters =
                                                evening &&
                                                evening.liters !== undefined
                                                    ? evening.liters
                                                    : "";

                                            const eveningRemarks =
                                                evening &&
                                                evening.remarks
                                                    ? evening.remarks
                                                    : "";
                                        %>


                                        <!-- =================================
                                             ANIMAL ROW
                                        ================================== -->

                                        <tr
                                            class="milk-animal-row"
                                            data-animal-id="<%= animal._id %>"
                                            data-farm-id="<%= farm._id %>"
                                        >


                                            <!-- =============================
                                                 ANIMAL
                                            ============================== -->

                                            <td class="milk-animal-cell">


                                                <div class="milk-animal-name">

                                                    <strong>
                                                        <%= animal.name %>
                                                    </strong>

                                                </div>


                                                <small class="milk-animal-code">

                                                    #<%= animal.code %>

                                                </small>


                                            </td>



                                            <!-- =============================
                                                 MORNING LITERS
                                            ============================== -->

                                            <td class="milk-liters-cell">


                                                <input
                                                    type="number"
                                                    name="records[<%= animal._id %>][morning][liters]"
                                                    class="milk-liters-input"
                                                    min="0"
                                                    step="0.01"
                                                    inputmode="decimal"
                                                    value="<%= morningLiters %>"
                                                    data-session="morning"
                                                    data-animal-id="<%= animal._id %>"
                                                    aria-label="Morning milk liters for <%= animal.name %>"

                                                    <% if (
                                                        !isAdmin &&
                                                        morningLocked
                                                    ) { %>

                                                        readonly
                                                        aria-readonly="true"

                                                    <% } %>
                                                >


                                            </td>



                                            <!-- =============================
                                                 MORNING REMARKS
                                            ============================== -->

                                            <td class="milk-remarks-cell">


                                                <input
                                                    type="text"
                                                    name="records[<%= animal._id %>][morning][remarks]"
                                                    class="milk-remarks-input"
                                                    value="<%= morningRemarks %>"
                                                    maxlength="500"
                                                    data-session="morning"
                                                    data-animal-id="<%= animal._id %>"
                                                    aria-label="Morning remarks for <%= animal.name %>"

                                                    <% if (
                                                        !isAdmin &&
                                                        morningLocked
                                                    ) { %>

                                                        readonly
                                                        aria-readonly="true"

                                                    <% } %>
                                                >


                                            </td>



                                            <!-- =============================
                                                 EVENING LITERS
                                            ============================== -->

                                            <td class="milk-liters-cell">


                                                <input
                                                    type="number"
                                                    name="records[<%= animal._id %>][evening][liters]"
                                                    class="milk-liters-input"
                                                    min="0"
                                                    step="0.01"
                                                    inputmode="decimal"
                                                    value="<%= eveningLiters %>"
                                                    data-session="evening"
                                                    data-animal-id="<%= animal._id %>"
                                                    aria-label="Evening milk liters for <%= animal.name %>"

                                                    <% if (
                                                        !isAdmin &&
                                                        eveningLocked
                                                    ) { %>

                                                        readonly
                                                        aria-readonly="true"

                                                    <% } %>
                                                >


                                            </td>



                                            <!-- =============================
                                                 EVENING REMARKS
                                            ============================== -->

                                            <td class="milk-remarks-cell">


                                                <input
                                                    type="text"
                                                    name="records[<%= animal._id %>][evening][remarks]"
                                                    class="milk-remarks-input"
                                                    value="<%= eveningRemarks %>"
                                                    maxlength="500"
                                                    data-session="evening"
                                                    data-animal-id="<%= animal._id %>"
                                                    aria-label="Evening remarks for <%= animal.name %>"

                                                    <% if (
                                                        !isAdmin &&
                                                        eveningLocked
                                                    ) { %>

                                                        readonly
                                                        aria-readonly="true"

                                                    <% } %>
                                                >


                                            </td>


                                        </tr>


                                    <% }); %>


                                </tbody>


                            </table>


                        </div>


                    <% } %>


                </section>


            <% }); %>



            <!-- =================================================
                 SUBMIT AREA
            ================================================== -->

            <div class="milk-submit-area">


                <!-- =============================================
                     PERMISSION MESSAGE
                ============================================== -->

                <% if (isAdmin) { %>


                    <p class="milk-admin-note">

                        Administrator mode:
                        existing milk records can be edited.

                    </p>


                <% } else { %>


                    <p class="milk-worker-note">

                        Existing submitted milk records are
                        read-only for dairy workers.

                    </p>


                <% } %>



                <!-- =============================================
                     SUBMIT BUTTON
                ============================================== -->

                <button
                    type="submit"
                    class="milk-submit-button"
                    id="milkSubmitButton"
                >

                    <% if (isAdmin) { %>

                        Save Milk Records

                    <% } else { %>

                        Submit Today's Milk

                    <% } %>

                </button>


            </div>


        </form>


    <% } %>


</div>



<!-- =========================================================
     PAGE JAVASCRIPT
========================================================= -->

<script>

document.addEventListener(
    "DOMContentLoaded",
    function() {


        /* =====================================================
           COLLECTION FORM
        ====================================================== */

        const form =
            document.getElementById(
                "milkCollectionForm"
            );


        /*
         * There is no form when the user has no farms.
         */

        if (!form) {

            return;

        }



        /* =====================================================
           SUBMIT BUTTON
        ====================================================== */

        const submitButton =
            document.getElementById(
                "milkSubmitButton"
            );



        /* =====================================================
           FARM TOTAL
           -----------------------------------------------------
           Client-side preview only.

           The server recalculates all authoritative totals.
        ====================================================== */

        function updateFarmTotal(
            farmSection
        ) {


            if (!farmSection) {

                return;

            }


            let total =
                0;


            const inputs =
                farmSection.querySelectorAll(
                    ".milk-liters-input"
                );


            inputs.forEach(
                function(input) {


                    const rawValue =
                        input.value;


                    /*
                     * Empty input is not a quantity.
                     */

                    if (
                        rawValue === ""
                    ) {

                        return;

                    }


                    const value =
                        Number(
                            rawValue
                        );


                    if (
                        Number.isFinite(value) &&
                        value >= 0
                    ) {

                        total += value;

                    }

                }
            );


            const totalElement =
                farmSection.querySelector(
                    ".milk-farm-total strong"
                );


            if (!totalElement) {

                return;

            }


            totalElement.textContent =
                total.toFixed(2) +
                " L";

        }



        /* =====================================================
           UPDATE ALL FARM TOTALS
        ====================================================== */

        const farmSections =
            document.querySelectorAll(
                ".milk-farm-section"
            );


        farmSections.forEach(
            function(farmSection) {


                const inputs =
                    farmSection.querySelectorAll(
                        ".milk-liters-input"
                    );


                inputs.forEach(
                    function(input) {


                        input.addEventListener(
                            "input",
                            function() {

                                updateFarmTotal(
                                    farmSection
                                );

                            }
                        );


                    }
                );


                /*
                 * Calculate the initial displayed total.
                 */

                updateFarmTotal(
                    farmSection
                );


            }
        );



        /* =====================================================
           FORM SUBMISSION
        ====================================================== */

        form.addEventListener(
            "submit",
            function(event) {


                /*
                 * Prevent accidental double submission.
                 */

                if (
                    form.dataset.submitting === "true"
                ) {

                    event.preventDefault();

                    return;

                }


                form.dataset.submitting =
                    "true";


                /*
                 * Disable the submit button.
                 */

                if (submitButton) {

                    submitButton.disabled =
                        true;

                    submitButton.setAttribute(
                        "aria-disabled",
                        "true"
                    );

                    submitButton.textContent =
                        "Saving...";

                }


                /*
                 * Do NOT disable the input fields here.
                 *
                 * Disabled inputs are NOT submitted by the
                 * browser.
                 *
                 * Readonly inputs ARE submitted.
                 *
                 * This is important for administrator edits
                 * and for the existing-record structure.
                 */

            }
        );



        /* =====================================================
           PREVENT NEGATIVE CLIENT INPUT
           -----------------------------------------------------
           Server validation remains authoritative.
        ====================================================== */

        const litersInputs =
            form.querySelectorAll(
                ".milk-liters-input"
            );


        litersInputs.forEach(
            function(input) {


                input.addEventListener(
                    "input",
                    function() {


                        const value =
                            Number(
                                input.value
                            );


                        if (
                            input.value !== "" &&
                            Number.isFinite(value) &&
                            value < 0
                        ) {

                            input.value =
                                "";

                        }


                    }
                );


            }
        );


    }
);

</script>