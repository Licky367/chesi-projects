<!-- =========================================================
     MILK COLLECTION PAGE

     TITLE:
     Record Today's Milk
========================================================= -->


<link
    rel="stylesheet"
    href="/css/milk.css"
>


<div
    class="milk-page"
    data-user-role="<%= user.role %>"
    data-day="<%= day %>"
>


    <!-- =====================================================
         HEADER
    ====================================================== -->

    <div class="milk-header">

        <div>

            <h1>
                Record Today's Milk
            </h1>

            <p class="milk-date">

                <%= new Date(day + "T00:00:00")
                    .toLocaleDateString(
                        "en-KE",
                        {
                            weekday: "long",
                            year: "numeric",
                            month: "long",
                            day: "numeric"
                        }
                    )
                %>

            </p>

        </div>


        <div class="milk-header-summary">

            <span>
                Total
            </span>

            <strong id="pageFarmTotal">

                <%= Number(
                    summary?.farmTotal || 0
                ).toFixed(2) %> L

            </strong>

        </div>

    </div>



    <!-- =====================================================
         NO FARMS
    ====================================================== -->

    <% if (!farms || farms.length === 0) { %>


        <div class="milk-empty">

            <div class="milk-empty-icon">
                🐄
            </div>

            <h2>
                No Dairy Farms Available
            </h2>

            <% if (user.role === "dairyWorker") { %>

                <p>
                    You currently have no dairy farms assigned to you.
                </p>

            <% } else { %>

                <p>
                    There are currently no active dairy farms.
                </p>

            <% } %>

        </div>


    <% } else { %>



        <!-- =================================================
             COLLECTION FORM
        ================================================== -->

        <form
            id="milkCollectionForm"
            method="POST"
            action="/milk"
            novalidate
        >


            <!-- =============================================
                 FARM TABLES
            ============================================== -->

            <div class="milk-farms">


                <% farms.forEach((farm) => { %>


                    <section
                        class="milk-farm-card"
                        data-farm-id="<%= farm.id %>"
                        data-farm-code="<%= farm.code %>"
                    >


                        <!-- =================================
                             FARM HEADER
                        ================================== -->

                        <div class="milk-farm-header">

                            <div>

                                <h2>
                                    <%= farm.name %>
                                </h2>

                                <span class="milk-farm-code">
                                    Farm <%= farm.code %>
                                </span>

                            </div>


                            <div class="milk-farm-total">

                                <span>
                                    Farm Total
                                </span>

                                <strong
                                    class="farm-total-value"
                                    data-farm-total="<%= farm.id %>"
                                >

                                    <%= Number(
                                        farm.farmTotal || 0
                                    ).toFixed(2) %> L

                                </strong>

                            </div>

                        </div>



                        <!-- =================================
                             TABLE
                        ================================== -->

                        <div class="milk-table-wrapper">

                            <table
                                class="milk-table"
                            >

                                <thead>

                                    <tr>

                                        <th
                                            rowspan="2"
                                            class="animal-column"
                                        >
                                            Animal
                                        </th>

                                        <th
                                            colspan="2"
                                            class="session-heading"
                                        >
                                            Morning
                                        </th>

                                        <th
                                            colspan="2"
                                            class="session-heading"
                                        >
                                            Evening
                                        </th>

                                    </tr>


                                    <tr>

                                        <th>
                                            Liters
                                        </th>

                                        <th>
                                            Remark
                                        </th>

                                        <th>
                                            Liters
                                        </th>

                                        <th>
                                            Remark
                                        </th>

                                    </tr>

                                </thead>


                                <tbody>


                                    <% if (
                                        !farm.animals ||
                                        farm.animals.length === 0
                                    ) { %>


                                        <tr>

                                            <td
                                                colspan="5"
                                                class="no-animals"
                                            >

                                                No milking animals
                                                are currently registered
                                                for this farm.

                                            </td>

                                        </tr>


                                    <% } else { %>


                                        <% farm.animals.forEach(
                                            (animal)
                                        => { %>


                                            <%
                                                const morningExists =
                                                    !!animal.morning;

                                                const eveningExists =
                                                    !!animal.evening;

                                                const isWorker =
                                                    user.role ===
                                                    "dairyWorker";
                                            %>


                                            <tr
                                                class="animal-row"
                                                data-animal-id="<%= animal.id %>"
                                                data-farm-id="<%= farm.id %>"
                                            >


                                                <!-- =================
                                                     ANIMAL
                                                ================== -->

                                                <td
                                                    class="animal-cell"
                                                >

                                                    <div class="animal-info">


                                                        <div
                                                            class="animal-avatar"
                                                        >

                                                            <% if (
                                                                animal.displayImage
                                                            ) { %>

                                                                <img
                                                                    src="<%= animal.displayImage %>"
                                                                    alt="<%= animal.name %>"
                                                                >

                                                            <% } else { %>

                                                                <span>
                                                                    🐄
                                                                </span>

                                                            <% } %>

                                                        </div>


                                                        <div>

                                                            <strong>
                                                                <%= animal.name %>
                                                            </strong>

                                                            <small>
                                                                #<%= animal.code %>
                                                            </small>

                                                        </div>

                                                    </div>


                                                    <input
                                                        type="hidden"
                                                        name="records[][animalId]"
                                                        value="<%= animal.id %>"
                                                    >

                                                </td>



                                                <!-- =================
                                                     MORNING LITERS
                                                ================== -->

                                                <td
                                                    class="liters-cell"
                                                >

                                                    <input
                                                        type="number"
                                                        class="milk-input liters-input"
                                                        name="records[][morningLiters]"
                                                        value="<%= morningExists
                                                            ? animal.morning.liters
                                                            : '' %>"
                                                        min="0"
                                                        step="0.01"
                                                        inputmode="decimal"
                                                        placeholder="0.00"

                                                        <%= (
                                                            isWorker &&
                                                            morningExists
                                                        )
                                                            ? "readonly"
                                                            : "" %>
                                                    >

                                                </td>



                                                <!-- =================
                                                     MORNING REMARK
                                                ================== -->

                                                <td>

                                                    <input
                                                        type="text"
                                                        class="milk-input remark-input"
                                                        name="records[][morningRemarks]"
                                                        value="<%= morningExists
                                                            ? (
                                                                animal.morning.remarks ||
                                                                ''
                                                            )
                                                            : '' %>"
                                                        maxlength="500"
                                                        placeholder="Remark"

                                                        <%= (
                                                            isWorker &&
                                                            morningExists
                                                        )
                                                            ? "readonly"
                                                            : "" %>
                                                    >

                                                </td>



                                                <!-- =================
                                                     EVENING LITERS
                                                ================== -->

                                                <td
                                                    class="liters-cell"
                                                >

                                                    <input
                                                        type="number"
                                                        class="milk-input liters-input"
                                                        name="records[][eveningLiters]"
                                                        value="<%= eveningExists
                                                            ? animal.evening.liters
                                                            : '' %>"
                                                        min="0"
                                                        step="0.01"
                                                        inputmode="decimal"
                                                        placeholder="0.00"

                                                        <%= (
                                                            isWorker &&
                                                            eveningExists
                                                        )
                                                            ? "readonly"
                                                            : "" %>
                                                    >

                                                </td>



                                                <!-- =================
                                                     EVENING REMARK
                                                ================== -->

                                                <td>

                                                    <input
                                                        type="text"
                                                        class="milk-input remark-input"
                                                        name="records[][eveningRemarks]"
                                                        value="<%= eveningExists
                                                            ? (
                                                                animal.evening.remarks ||
                                                                ''
                                                            )
                                                            : '' %>"
                                                        maxlength="500"
                                                        placeholder="Remark"

                                                        <%= (
                                                            isWorker &&
                                                            eveningExists
                                                        )
                                                            ? "readonly"
                                                            : "" %>
                                                    >

                                                </td>


                                            </tr>


                                        <% }) %>


                                    <% } %>


                                </tbody>


                                <!-- =================================
                                     FARM FOOTER
                                ================================== -->

                                <tfoot>

                                    <tr>

                                        <td
                                            colspan="4"
                                            class="farm-total-label"
                                        >
                                            Farm Total
                                        </td>

                                        <td
                                            class="farm-total-footer"
                                        >

                                            <strong
                                                data-farm-total-footer="<%= farm.id %>"
                                            >
                                                <%= Number(
                                                    farm.farmTotal || 0
                                                ).toFixed(2) %>
                                                L
                                            </strong>

                                        </td>

                                    </tr>

                                </tfoot>

                            </table>

                        </div>


                    </section>


                <% }) %>


            </div>



            <!-- =================================================
                 SUBMIT AREA
            ================================================== -->

            <div class="milk-submit-bar">


                <div class="milk-submit-info">

                    <strong>
                        Daily Production
                    </strong>

                    <span id="liveTotal">
                        <%= Number(
                            summary?.farmTotal || 0
                        ).toFixed(2) %> L
                    </span>

                </div>


                <button
                    type="submit"
                    id="submitMilkButton"
                    class="milk-submit-button"
                >

                    Save Today's Milk

                </button>


            </div>


        </form>


    <% } %>


</div>



<!-- =========================================================
     JAVASCRIPT
========================================================= -->

<script>

document.addEventListener(
    "DOMContentLoaded",
    function() {

        const form =
            document.getElementById(
                "milkCollectionForm"
            );


        if (!form) {

            return;

        }


        const submitButton =
            document.getElementById(
                "submitMilkButton"
            );


        const liveTotal =
            document.getElementById(
                "liveTotal"
            );


        const pageTotal =
            document.getElementById(
                "pageFarmTotal"
            );


        const userRole =
            document
                .querySelector(
                    ".milk-page"
                )
                ?.dataset
                .userRole;


        // ==================================================
        // CALCULATE FARM TOTALS
        // ==================================================

        function updateTotals() {

            let pageTotalValue =
                0;


            document
                .querySelectorAll(
                    ".milk-farm-card"
                )
                .forEach(
                    function(farmCard) {

                        let farmTotal =
                            0;


                        farmCard
                            .querySelectorAll(
                                ".liters-input"
                            )
                            .forEach(
                                function(input) {

                                    const value =
                                        Number(
                                            input.value
                                        );


                                    if (
                                        Number.isFinite(
                                            value
                                        )
                                    ) {

                                        farmTotal +=
                                            value;

                                    }

                                }
                            );


                        pageTotalValue +=
                            farmTotal;


                        const farmId =
                            farmCard.dataset.farmId;


                        const farmTotalElement =
                            document.querySelector(
                                `[data-farm-total="${farmId}"]`
                            );


                        const footerElement =
                            document.querySelector(
                                `[data-farm-total-footer="${farmId}"]`
                            );


                        if (
                            farmTotalElement
                        ) {

                            farmTotalElement.textContent =
                                farmTotal.toFixed(2) +
                                " L";

                        }


                        if (
                            footerElement
                        ) {

                            footerElement.textContent =
                                farmTotal.toFixed(2) +
                                " L";

                        }

                    }
                );


            if (
                liveTotal
            ) {

                liveTotal.textContent =
                    pageTotalValue.toFixed(2) +
                    " L";

            }


            if (
                pageTotal
            ) {

                pageTotal.textContent =
                    pageTotalValue.toFixed(2) +
                    " L";

            }

        }


        // ==================================================
        // UPDATE WHILE TYPING
        // ==================================================

        form.addEventListener(
            "input",
            function(event) {

                if (
                    event.target.classList.contains(
                        "liters-input"
                    )
                ) {

                    updateTotals();

                }

            }
        );


        // ==================================================
        // FORM SUBMISSION
        // ==================================================

        form.addEventListener(
            "submit",
            async function(event) {

                event.preventDefault();


                if (
                    submitButton
                ) {

                    submitButton.disabled =
                        true;

                    submitButton.textContent =
                        "Saving...";

                }


                try {

                    const formData =
                        new FormData(
                            form
                        );


                    // ======================================
                    // CONVERT FORM DATA
                    // ======================================

                    const rows =
                        Array.from(
                            document.querySelectorAll(
                                ".animal-row"
                            )
                        );


                    const records =
                        [];


                    rows.forEach(
                        function(row) {

                            const animalId =
                                row.dataset.animalId;


                            if (
                                !animalId
                            ) {

                                return;

                            }


                            const morningLiters =
                                row.querySelector(
                                    '[name="records[][morningLiters]"]'
                                );


                            const morningRemarks =
                                row.querySelector(
                                    '[name="records[][morningRemarks]"]'
                                );


                            const eveningLiters =
                                row.querySelector(
                                    '[name="records[][eveningLiters]"]'
                                );


                            const eveningRemarks =
                                row.querySelector(
                                    '[name="records[][eveningRemarks]"]'
                                );


                            records.push({

                                animalId,

                                morningLiters:
                                    morningLiters
                                        ?.value || "",

                                morningRemarks:
                                    morningRemarks
                                        ?.value || "",

                                eveningLiters:
                                    eveningLiters
                                        ?.value || "",

                                eveningRemarks:
                                    eveningRemarks
                                        ?.value || ""

                            });

                        }
                    );


                    // ======================================
                    // SEND
                    // ======================================

                    const response =
                        await fetch(
                            form.action,
                            {

                                method:
                                    "POST",

                                headers: {

                                    "Content-Type":
                                        "application/json",

                                    "Accept":
                                        "application/json"

                                },

                                body:
                                    JSON.stringify({

                                        records

                                    })

                            }
                        );


                    const result =
                        await response.json();


                    if (
                        !response.ok ||
                        !result.success
                    ) {

                        throw new Error(
                            result.message ||
                            "Unable to save milk records."
                        );

                    }


                    // ======================================
                    // SUCCESS
                    // ======================================

                    alert(
                        result.message ||
                        "Milk records saved successfully."
                    );


                    // Reload so newly submitted records
                    // become readonly for dairy workers.

                    window.location.reload();

                }

                catch (error) {

                    console.error(
                        "Milk submission error:",
                        error
                    );


                    alert(
                        error.message ||
                        "Unable to save milk records."
                    );


                    if (
                        submitButton
                    ) {

                        submitButton.disabled =
                            false;

                        submitButton.textContent =
                            "Save Today's Milk";

                    }

                }

            }
        );


        // ==================================================
        // INITIAL TOTAL
        // ==================================================

        updateTotals();


        // ==================================================
        // ADMIN EDITING
        // ==================================================
        //
        // Existing records are initially displayed in the
        // normal form. Admin can change them and submit the
        // whole page.
        //
        // The service recognizes the existing Milk record
        // and updates it because the user is an admin.
        //
        // ==================================================

        if (
            userRole === "admin"
        ) {

            document
                .querySelectorAll(
                    ".milk-input"
                )
                .forEach(
                    function(input) {

                        input.removeAttribute(
                            "readonly"
                        );

                    }
                );

        }

    }
);

</script>