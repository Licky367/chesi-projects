<%
// ==========================================================
// MILK COLLECTION PAGE
// ==========================================================
//
// EXPECTED CONTROLLER DATA:
//
//     dairies
//     session
//     isAdmin
//     success
//     error
//
// SESSION VALUES:
//
//     morning = 00:00 - 10:00
//     closed  = 10:00 - 16:00
//     evening = 16:00 - 00:00
//
// BUSINESS RULES:
//
// NORMAL USER
//     • Morning: can submit morning records.
//     • 10:00 AM - 4:00 PM: completely closed.
//     • Evening: can submit evening records.
//     • Existing records cannot be edited.
//
// ADMIN
//     • Morning: can submit/edit morning records.
//     • 10:00 AM - 4:00 PM: can submit/edit morning records.
//     • Evening: can submit/edit evening records.
//     • Can create a new record where one does not exist.
//     • Can edit existing records by tapping them.
//
// IMPORTANT:
//
//     The frontend controls what is displayed.
//     The backend must ALSO enforce these rules.
// ==========================================================


// ==========================================================
// SAFE DEFAULTS
// ==========================================================

const pageError =
    typeof error !== "undefined"
        ? error
        : "";

const pageSuccess =
    typeof success !== "undefined"
        ? Boolean(success)
        : false;

const currentSession =
    typeof session !== "undefined"
        ? session
        : "";

const adminUser =
    typeof isAdmin !== "undefined"
        ? Boolean(isAdmin)
        : (
            typeof user !== "undefined" &&
            user &&
            user.role === "admin"
        );

const milkDairies =
    typeof dairies !== "undefined" &&
    Array.isArray(dairies)
        ? dairies
        : [];


// ==========================================================
// SESSION PERMISSIONS
// ==========================================================

// Admin can enter morning records during BOTH:
//     morning session
//     closed period
//
// Admin can enter evening records only during:
//     evening session
//
const adminMorningWindow =
    adminUser &&
    (
        currentSession === "morning" ||
        currentSession === "closed"
    );

const adminEveningWindow =
    adminUser &&
    currentSession === "evening";


// Anyone can create records only during their open session.
// Admin gets the additional morning access during closed time.
const canSubmit =
    currentSession === "morning" ||
    currentSession === "evening" ||
    adminMorningWindow;


// ==========================================================
// DETERMINE WHICH SESSION IS CURRENTLY BEING ENTERED
// ==========================================================
//
// During "closed":
//     the relevant session is still MORNING.
//
// During evening:
//     the relevant session is EVENING.
//
const entrySession =
    currentSession === "evening"
        ? "evening"
        : "morning";


// ==========================================================
// DISPLAY LABELS
// ==========================================================

let sessionTitle = "Collection Closed";
let sessionDescription = "";
let sessionIcon = "🔒";
let sessionClass = "session-card-closed";
let sessionBadgeClass = "session-closed";
let sessionBadgeText = "Closed";

if (currentSession === "morning") {

    sessionTitle = "Morning collection is open";
    sessionDescription =
        "Record one milk entry for each cow before 10:00 AM.";
    sessionIcon = "🌅";
    sessionClass = "session-card-open";
    sessionBadgeClass = "session-morning";
    sessionBadgeText = "Morning";

} else if (currentSession === "closed") {

    sessionTitle = adminUser
        ? "Morning collection is still available to administrators"
        : "Collection is temporarily closed";

    sessionDescription = adminUser
        ? "Administrators can submit or edit morning records until 4:00 PM."
        : "Morning collection closed at 10:00 AM. Evening collection opens at 4:00 PM.";

    sessionIcon = adminUser ? "✏️" : "⏰";
    sessionClass = adminUser
        ? "session-card-admin"
        : "session-card-closed";

    sessionBadgeClass = adminUser
        ? "session-admin"
        : "session-closed";

    sessionBadgeText = adminUser
        ? "Admin Access"
        : "Closed";

} else if (currentSession === "evening") {

    sessionTitle = "Evening collection is open";
    sessionDescription =
        "Record one milk entry for each cow before midnight.";
    sessionIcon = "🌆";
    sessionClass = "session-card-evening";
    sessionBadgeClass = "session-evening";
    sessionBadgeText = "Evening";

} else {

    sessionTitle = "Collection window unavailable";
    sessionDescription =
        "Please contact an administrator if this continues.";

}
%>


<!-- ==========================================================
     MILK COLLECTION PAGE
========================================================== -->

<div class="milk-page">


    <!-- ======================================================
         HEADER
    ======================================================= -->

    <header class="milk-header">

        <div class="milk-header-content">

            <div class="milk-header-icon">
                🥛
            </div>

            <div class="milk-header-text">

                <div class="milk-eyebrow">
                    DAILY PRODUCTION
                </div>

                <h1>
                    Milk Collection
                </h1>

                <p>
                    Record today's milk production for each dairy animal.
                </p>

            </div>

        </div>


        <!-- SESSION BADGE -->

        <div class="milk-session-badge <%= sessionBadgeClass %>">

            <span class="session-dot"></span>

            <span>
                <%= sessionBadgeText %>
            </span>

        </div>

    </header>



    <!-- ======================================================
         ERROR
    ======================================================= -->

    <% if (pageError) { %>

        <div class="milk-alert milk-alert-error">

            <div class="alert-icon">
                ⚠️
            </div>

            <div>

                <strong>
                    Unable to save records
                </strong>

                <p>
                    <%= pageError %>
                </p>

            </div>

        </div>

    <% } %>



    <!-- ======================================================
         SUCCESS
    ======================================================= -->

    <% if (pageSuccess) { %>

        <div class="milk-alert milk-alert-success">

            <div class="alert-icon">
                ✓
            </div>

            <div>

                <strong>
                    Milk records saved
                </strong>

                <p>
                    The collection records were saved successfully.
                </p>

            </div>

        </div>

    <% } %>



    <!-- ======================================================
         SESSION STATUS
    ======================================================= -->

    <div class="milk-session-card <%= sessionClass %>">

        <div class="session-card-icon">
            <%= sessionIcon %>
        </div>

        <div class="session-card-content">

            <div class="session-card-title">
                <%= sessionTitle %>
            </div>

            <div class="session-card-description">

                <%= sessionDescription %>

                <% if (currentSession === "closed" && adminUser) { %>

                    <div class="admin-session-note">
                        ✏️ Admin access: morning records can still be
                        submitted or edited until 4:00 PM.
                    </div>

                <% } else if (currentSession === "closed" && !adminUser) { %>

                    <div class="admin-session-note">
                        Contact an administrator if a correction is required.
                    </div>

                <% } %>

            </div>

        </div>


        <div class="session-time">

            <% if (currentSession === "morning") { %>

                <span>
                    Closes
                </span>

                <strong>
                    10:00 AM
                </strong>

            <% } else if (currentSession === "closed") { %>

                <span>
                    Evening
                </span>

                <strong>
                    4:00 PM
                </strong>

            <% } else if (currentSession === "evening") { %>

                <span>
                    Closes
                </span>

                <strong>
                    Midnight
                </strong>

            <% } %>

        </div>

    </div>



    <!-- ======================================================
         NO ANIMALS
    ======================================================= -->

    <% if (milkDairies.length === 0) { %>

        <div class="milk-empty-state">

            <div class="empty-animal-icon">
                🐄
            </div>

            <h2>
                No Animals Currently Being Milked
            </h2>

            <p>
                There are currently no active dairy animals
                available for milk collection.
            </p>

        </div>


    <% } else { %>


        <!-- ==================================================
             MILK FORM
        =================================================== -->

        <form
            action="/milk"
            method="POST"
            id="milkForm"
            class="milk-form"
        >


            <!-- ==================================================
                 COLLECTION CARD
            =================================================== -->

            <section class="collection-card">


                <!-- COLLECTION HEADER -->

                <div class="collection-card-header">

                    <div>

                        <div class="collection-title">
                            Today's Collection
                        </div>

                        <div class="collection-subtitle">

                            <%= milkDairies.length %>

                            <%= milkDairies.length === 1
                                ? "animal"
                                : "animals"
                            %>

                        </div>

                    </div>


                    <% if (canSubmit) { %>

                        <div class="collection-status">

                            <span class="status-dot"></span>

                            <% if (currentSession === "closed" && adminUser) { %>
                                Admin Entry
                            <% } else { %>
                                Ready for Entry
                            <% } %>

                        </div>

                    <% } else { %>

                        <div class="collection-status status-locked">
                            🔒 Locked
                        </div>

                    <% } %>

                </div>



                <!-- ==================================================
                     TABLE
                =================================================== -->

                <div class="milk-table-wrapper">

                    <table class="milk-table">

                        <thead>

                            <tr>

                                <th class="col-animal">
                                    Animal
                                </th>

                                <th class="col-code">
                                    Code
                                </th>

                                <th class="col-milk">
                                    Milk
                                    <span>(Litres)</span>
                                </th>

                                <th class="col-remarks">
                                    Remarks
                                </th>

                            </tr>

                        </thead>


                        <tbody>


                            <% milkDairies.forEach((dairy, index) => {

                                // ==================================================
                                // GET ONLY THE RECORD FOR THE ACTIVE SESSION
                                // ==================================================

                                let record = null;

                                if (entrySession === "morning") {

                                    record = dairy.morning || null;

                                } else if (entrySession === "evening") {

                                    record = dairy.evening || null;

                                }

                                // ==================================================
                                // CAN THIS ROW ACCEPT A NEW RECORD?
                                // ==================================================

                                const canCreateRecord =
                                    !record &&
                                    canSubmit;

                                // ==================================================
                                // CAN ADMIN EDIT THIS EXISTING RECORD?
                                // ==================================================

                                const canEditRecord =
                                    adminUser &&
                                    record &&
                                    record._id;

                            %>


                                <!-- ==================================================
                                     ANIMAL ROW
                                =================================================== -->

                                <tr class="<%= record ? 'has-record' : 'needs-record' %>">


                                    <!-- ==========================================
                                         ANIMAL
                                    =========================================== -->

                                    <td>

                                        <div class="animal-cell">

                                            <div class="animal-avatar">
                                                🐄
                                            </div>

                                            <div class="animal-info">

                                                <span class="animal-name">
                                                    <%= dairy.name %>
                                                </span>

                                                <span class="animal-label">
                                                    Dairy animal
                                                </span>

                                            </div>

                                        </div>

                                    </td>



                                    <!-- ==========================================
                                         CODE
                                    =========================================== -->

                                    <td>

                                        <span class="code-badge">
                                            #<%= dairy.code %>
                                        </span>

                                    </td>



                                    <!-- ==========================================
                                         MILK
                                    =========================================== -->

                                    <td>


                                        <% if (record) { %>


                                            <!-- ==================================
                                                 EXISTING RECORD
                                            =================================== -->

                                            <div
                                                class="<%= canEditRecord
                                                    ? 'record-wrapper admin-edit-record'
                                                    : 'record-wrapper'
                                                %>"

                                                <% if (canEditRecord) { %>

                                                    role="button"

                                                    tabindex="0"

                                                    title="Tap to edit this record"

                                                    onclick="openEditModal(
                                                        '<%= record._id %>',
                                                        '<%= Number(record.liters || 0) %>',
                                                        <%- JSON.stringify(record.remarks || "") %>
                                                    )"

                                                <% } %>
                                            >

                                                <div class="milk-value-display">

                                                    <span>
                                                        <%= Number(
                                                            record.liters || 0
                                                        ).toFixed(1) %>
                                                    </span>

                                                    <small>
                                                        L
                                                    </small>

                                                </div>


                                                <% if (canEditRecord) { %>

                                                    <span class="edit-icon">
                                                        ✏️
                                                    </span>

                                                <% } %>

                                            </div>


                                        <% } else if (canCreateRecord) { %>


                                            <!-- ==================================
                                                 NEW RECORD
                                            =================================== -->

                                            <div class="milk-entry-wrapper">

                                                <input
                                                    class="milk-input"
                                                    type="number"
                                                    step="0.1"
                                                    min="0"
                                                    name="records[<%= index %>][liters]"
                                                    placeholder="0.0"
                                                    required
                                                    inputmode="decimal"
                                                >

                                                <span class="input-unit">
                                                    L
                                                </span>

                                            </div>


                                            <input
                                                type="hidden"
                                                name="records[<%= index %>][dairy]"
                                                value="<%= dairy._id %>"
                                            >


                                        <% } else { %>


                                            <!-- ==================================
                                                 LOCKED
                                            =================================== -->

                                            <div class="locked-input">

                                                <span>
                                                    —
                                                </span>

                                                <small>
                                                    Locked
                                                </small>

                                            </div>


                                        <% } %>

                                    </td>



                                    <!-- ==========================================
                                         REMARKS
                                    =========================================== -->

                                    <td>


                                        <% if (record) { %>


                                            <%
                                                const displayRemarks =
                                                    record.remarks &&
                                                    String(record.remarks).trim()
                                                        ? record.remarks
                                                        : "No remarks";
                                            %>


                                            <!-- ==================================
                                                 EXISTING RECORD
                                            =================================== -->

                                            <div
                                                class="<%= canEditRecord
                                                    ? 'remarks-wrapper admin-edit-record'
                                                    : 'remarks-wrapper'
                                                %>"

                                                <% if (canEditRecord) { %>

                                                    role="button"

                                                    tabindex="0"

                                                    title="Tap to edit this record"

                                                    onclick="openEditModal(
                                                        '<%= record._id %>',
                                                        '<%= Number(record.liters || 0) %>',
                                                        <%- JSON.stringify(record.remarks || "") %>
                                                    )"

                                                <% } %>
                                            >

                                                <div class="remarks-text">
                                                    <%= displayRemarks %>
                                                </div>


                                                <% if (
                                                    record.recordedByType === "system" ||
                                                    record.recordedBySystem
                                                ) { %>

                                                    <div class="record-badge system-record">

                                                        <span>
                                                            ⚙️
                                                        </span>

                                                        Automatically recorded
                                                        as Not Milked.

                                                    </div>

                                                <% } else { %>

                                                    <div class="record-badge">

                                                        <span>
                                                            ✓
                                                        </span>

                                                        Already recorded

                                                    </div>

                                                <% } %>


                                                <% if (canEditRecord) { %>

                                                    <div class="admin-edit-hint">

                                                        ✏️
                                                        Tap to edit

                                                    </div>

                                                <% } %>

                                            </div>


                                        <% } else if (canCreateRecord) { %>


                                            <!-- ==================================
                                                 NEW REMARKS
                                            =================================== -->

                                            <textarea
                                                class="remarks-input"
                                                name="records[<%= index %>][remarks]"
                                                placeholder="Optional remarks..."
                                                rows="2"
                                            ></textarea>


                                        <% } else { %>


                                            <!-- ==================================
                                                 LOCKED REMARKS
                                            =================================== -->

                                            <div class="closed-remarks">

                                                <span>
                                                    🔒
                                                </span>

                                                No new records can be
                                                submitted at this time.

                                            </div>


                                        <% } %>

                                    </td>

                                </tr>


                            <% }); %>


                        </tbody>

                    </table>

                </div>

            </section>



            <!-- ==================================================
                 SUBMISSION CARD
            =================================================== -->

            <div class="milk-submit-card">


                <div class="submit-information">


                    <div class="submit-info-icon">

                        <% if (canSubmit) { %>
                            ✓
                        <% } else { %>
                            🔒
                        <% } %>

                    </div>


                    <div>


                        <% if (currentSession === "morning") { %>

                            <strong>
                                Morning collection is open
                            </strong>

                            <span>
                                Normal users can submit until
                                <strong>10:00 AM</strong>.
                                Administrators can continue making
                                morning entries until <strong>4:00 PM</strong>.
                            </span>


                        <% } else if (currentSession === "closed" && adminUser) { %>

                            <strong>
                                Administrator morning access
                            </strong>

                            <span>
                                You can submit or edit morning records
                                until <strong>4:00 PM</strong>.
                            </span>


                        <% } else if (currentSession === "closed") { %>

                            <strong>
                                Collection is currently closed
                            </strong>

                            <span>
                                Evening collection becomes available
                                at <strong>4:00 PM</strong>.
                            </span>


                        <% } else if (currentSession === "evening") { %>

                            <strong>
                                Evening collection is open
                            </strong>

                            <span>
                                Submit or, for administrators, edit
                                evening records before <strong>midnight</strong>.
                            </span>


                        <% } else { %>

                            <strong>
                                Collection unavailable
                            </strong>

                            <span>
                                Please contact an administrator.
                            </span>

                        <% } %>


                    </div>

                </div>



                <!-- ==================================================
                     SUBMIT BUTTON
                =================================================== -->

                <button
                    type="submit"
                    class="submit-btn"
                    <%= canSubmit ? "" : "disabled" %>
                >

                    <span class="submit-btn-icon">
                        ✓
                    </span>

                    <span>
                        Submit Milk Records
                    </span>

                </button>


            </div>

        </form>


    <% } %>

</div>



<!-- ==========================================================
     STYLES
========================================================== -->

<style>

/* ==========================================================
   PAGE
========================================================== */

.milk-page {
    width: 100%;
    max-width: 1450px;
    margin: 0 auto;
    padding: 28px 24px 50px;
    box-sizing: border-box;
}


/* ==========================================================
   HEADER
========================================================== */

.milk-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 24px;
}

.milk-header-content {
    display: flex;
    align-items: center;
    gap: 16px;
}

.milk-header-icon {
    width: 58px;
    height: 58px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;

    background: #eaf7ef;
    border: 1px solid #d5eddd;
    border-radius: 17px;

    font-size: 29px;

    box-shadow:
        0 6px 18px rgba(27, 94, 32, 0.08);
}

.milk-eyebrow {
    margin-bottom: 3px;

    color: #2e7d32;

    font-size: 11px;
    font-weight: 800;

    letter-spacing: 1.4px;
}

.milk-header h1 {
    margin: 0;

    color: #17231a;

    font-size: 29px;
    font-weight: 800;

    line-height: 1.15;
}

.milk-header p {
    margin: 6px 0 0;

    color: #718078;

    font-size: 14px;
}


/* ==========================================================
   SESSION BADGE
========================================================== */

.milk-session-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;

    padding: 9px 14px;

    border-radius: 999px;

    font-size: 13px;
    font-weight: 700;

    white-space: nowrap;
}

.session-morning,
.session-evening,
.session-admin {
    background: #eaf7ef;
    color: #277437;
}

.session-closed {
    background: #f4f5f4;
    color: #707873;
}

.session-dot {
    width: 8px;
    height: 8px;

    border-radius: 50%;

    background: currentColor;
}


/* ==========================================================
   ALERTS
========================================================== */

.milk-alert {
    display: flex;
    align-items: flex-start;
    gap: 13px;

    padding: 15px 17px;
    margin-bottom: 18px;

    border-radius: 14px;
    border: 1px solid;
}

.alert-icon {
    width: 32px;
    height: 32px;

    flex-shrink: 0;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 10px;

    font-weight: 800;
}

.milk-alert strong {
    display: block;
    margin-bottom: 2px;

    font-size: 14px;
}

.milk-alert p {
    margin: 0;

    font-size: 13px;
    line-height: 1.5;
}

.milk-alert-error {
    background: #fff5f5;
    border-color: #ffd9d9;
    color: #9b3030;
}

.milk-alert-success {
    background: #f0faf3;
    border-color: #d2ecd8;
    color: #28723a;
}


/* ==========================================================
   SESSION CARD
========================================================== */

.milk-session-card {
    display: flex;
    align-items: center;
    gap: 15px;

    margin-bottom: 22px;
    padding: 17px 19px;

    border-radius: 17px;
    border: 1px solid;

    box-shadow:
        0 5px 18px rgba(0, 0, 0, 0.035);
}

.session-card-open {
    background: #f3fbf5;
    border-color: #d8eddd;
}

.session-card-evening {
    background: #f4fbf7;
    border-color: #d9ede0;
}

.session-card-admin {
    background: #f0faf3;
    border-color: #cce6d2;
}

.session-card-closed {
    background: #fafafa;
    border-color: #e7e9e7;
}

.session-card-icon {
    width: 45px;
    height: 45px;

    flex-shrink: 0;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 13px;

    background: rgba(255,255,255,0.8);

    font-size: 21px;
}

.session-card-content {
    flex: 1;
    min-width: 0;
}

.session-card-title {
    margin-bottom: 4px;

    color: #253129;

    font-size: 14px;
    font-weight: 800;
}

.session-card-description {
    color: #68746d;

    font-size: 13px;
    line-height: 1.55;
}

.admin-session-note {
    margin-top: 7px;

    color: #377444;

    font-size: 12px;
    font-weight: 600;
}

.session-time {
    min-width: 82px;

    text-align: right;
}

.session-time span {
    display: block;

    margin-bottom: 2px;

    color: #8a948e;

    font-size: 10px;
    font-weight: 700;

    text-transform: uppercase;
    letter-spacing: .7px;
}

.session-time strong {
    color: #315b3b;

    font-size: 13px;
}


/* ==========================================================
   EMPTY STATE
========================================================== */

.milk-empty-state {
    padding: 70px 25px;

    text-align: center;

    background: #ffffff;

    border: 1px solid #e7ebe8;
    border-radius: 20px;

    box-shadow:
        0 8px 28px rgba(0, 0, 0, 0.04);
}

.empty-animal-icon {
    width: 74px;
    height: 74px;

    margin: 0 auto 18px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 22px;

    background: #eef8f1;

    font-size: 35px;
}

.milk-empty-state h2 {
    margin: 0 0 8px;

    color: #26322a;

    font-size: 19px;
}

.milk-empty-state p {
    max-width: 420px;

    margin: 0 auto;

    color: #7b8580;

    font-size: 13px;
    line-height: 1.6;
}


/* ==========================================================
   COLLECTION CARD
========================================================== */

.collection-card {
    overflow: hidden;

    background: #ffffff;

    border: 1px solid #e5eae6;
    border-radius: 19px;

    box-shadow:
        0 8px 30px rgba(27, 55, 35, 0.055);
}

.collection-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 18px 20px;

    border-bottom: 1px solid #edf0ed;
}

.collection-title {
    color: #27332b;

    font-size: 16px;
    font-weight: 800;
}

.collection-subtitle {
    margin-top: 3px;

    color: #89928d;

    font-size: 12px;
}

.collection-status {
    display: inline-flex;
    align-items: center;
    gap: 7px;

    padding: 7px 11px;

    border-radius: 999px;

    background: #eef9f1;

    color: #357a43;

    font-size: 11px;
    font-weight: 700;
