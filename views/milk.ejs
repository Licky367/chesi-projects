<%
/* ==========================================================
MILK COLLECTION PAGE
========================================================== */

const pageError =
typeof error !== "undefined"
? error
: "";

const pageSuccess =
typeof success !== "undefined"
? Boolean(success)
: false;

const currentSession =
typeof session !== "undefined"
? session
: "";

const adminUser =
typeof isAdmin !== "undefined"
? Boolean(isAdmin)
: (
typeof user !== "undefined" &&
user &&
user.role === "admin"
);

const milkDairies =
typeof dairies !== "undefined" &&
Array.isArray(dairies)
? dairies
: [];

/* ==========================================================
SESSION PERMISSIONS
========================================================== */

/*
ADMIN:

- Morning: morning records
- Closed: morning records
- Evening: evening records

NORMAL USER:

- Morning: morning records
- Evening: evening records
- Closed: no entry
  */

const adminMorningWindow =
adminUser &&
(
currentSession === "morning" ||
currentSession === "closed"
);

const adminEveningWindow =
adminUser &&
currentSession === "evening";

const canSubmit =
currentSession === "morning" ||
currentSession === "evening" ||
adminMorningWindow;

/* ==========================================================
ACTIVE ENTRY SESSION
========================================================== */

const entrySession =
currentSession === "evening"
? "evening"
: "morning";

/* ==========================================================
SESSION DISPLAY
========================================================== */

let sessionTitle = "Collection Closed";
let sessionDescription = "";
let sessionIcon = "🔒";
let sessionClass = "session-card-closed";
let sessionBadgeClass = "session-closed";
let sessionBadgeText = "Closed";

if (currentSession === "morning") {

sessionTitle =
    "Morning collection is open";

sessionDescription =
    "Record milk for animals individually before 10:00 AM.";

sessionIcon = "🌅";

sessionClass =
    "session-card-open";

sessionBadgeClass =
    "session-morning";

sessionBadgeText =
    "Morning";

} else if (currentSession === "closed") {

if (adminUser) {

    sessionTitle =
        "Morning collection is available to administrators";

    sessionDescription =
        "Administrators can submit new or edit existing morning records until 4:00 PM.";

    sessionIcon = "✏️";

    sessionClass =
        "session-card-admin";

    sessionBadgeClass =
        "session-admin";

    sessionBadgeText =
        "Admin Access";

} else {

    sessionTitle =
        "Collection is temporarily closed";

    sessionDescription =
        "Morning collection closed at 10:00 AM. Evening collection opens at 4:00 PM.";

    sessionIcon = "⏰";

    sessionClass =
        "session-card-closed";

    sessionBadgeClass =
        "session-closed";

    sessionBadgeText =
        "Closed";
}

} else if (currentSession === "evening") {

sessionTitle =
    "Evening collection is open";

sessionDescription =
    "Record milk for animals individually before midnight.";

sessionIcon = "🌆";

sessionClass =
    "session-card-evening";

sessionBadgeClass =
    "session-evening";

sessionBadgeText =
    "Evening";

} else {

sessionTitle =
    "Collection window unavailable";

sessionDescription =
    "Please contact an administrator if this continues.";

}
%>

<!-- ==========================================================
     MILK COLLECTION PAGE
========================================================== --><div class="milk-page"><!-- ======================================================
     HEADER
======================================================= -->

<header class="milk-header">

    <div class="milk-header-content">

        <div class="milk-header-icon">
            🥛
        </div>

        <div class="milk-header-text">

            <div class="milk-eyebrow">
                DAILY PRODUCTION
            </div>

            <h1>
                Milk Collection
            </h1>

            <p>
                Record today's milk production one animal at a time.
            </p>

        </div>

    </div>


    <div class="milk-session-badge <%= sessionBadgeClass %>">

        <span class="session-dot"></span>

        <span>
            <%= sessionBadgeText %>
        </span>

    </div>

</header>



<!-- ======================================================
     ERROR
======================================================= -->

<% if (pageError) { %>

    <div class="milk-alert milk-alert-error">

        <div class="alert-icon">
            ⚠️
        </div>

        <div>

            <strong>
                Unable to save record
            </strong>

            <p>
                <%= pageError %>
            </p>

        </div>

    </div>

<% } %>



<!-- ======================================================
     SUCCESS
======================================================= -->

<% if (pageSuccess) { %>

    <div class="milk-alert milk-alert-success">

        <div class="alert-icon">
            ✓
        </div>

        <div>

            <strong>
                Milk record saved
            </strong>

            <p>
                The milk record was saved successfully.
            </p>

        </div>

    </div>

<% } %>



<!-- ======================================================
     SESSION STATUS
======================================================= -->

<div class="milk-session-card <%= sessionClass %>">

    <div class="session-card-icon">
        <%= sessionIcon %>
    </div>


    <div class="session-card-content">

        <div class="session-card-title">
            <%= sessionTitle %>
        </div>

        <div class="session-card-description">

            <%= sessionDescription %>

            <% if (currentSession === "closed" && adminUser) { %>

                <div class="admin-session-note">
                    ✏️ Admin access: morning records can still be
                    submitted or edited until 4:00 PM.
                </div>

            <% } else if (currentSession === "closed" && !adminUser) { %>

                <div class="admin-session-note">
                    Contact an administrator if a correction is required.
                </div>

            <% } %>

        </div>

    </div>


    <div class="session-time">

        <% if (currentSession === "morning") { %>

            <span>
                Closes
            </span>

            <strong>
                10:00 AM
            </strong>

        <% } else if (currentSession === "closed") { %>

            <span>
                Evening
            </span>

            <strong>
                4:00 PM
            </strong>

        <% } else if (currentSession === "evening") { %>

            <span>
                Closes
            </span>

            <strong>
                Midnight
            </strong>

        <% } %>

    </div>

</div>



<!-- ======================================================
     NO ANIMALS
======================================================= -->

<% if (milkDairies.length === 0) { %>

    <div class="milk-empty-state">

        <div class="empty-animal-icon">
            🐄
        </div>

        <h2>
            No Animals Currently Being Milked
        </h2>

        <p>
            There are currently no active dairy animals
            available for milk collection.
        </p>

    </div>


<% } else { %>


    <!-- ==================================================
         COLLECTION CARD
    =================================================== -->

    <section class="collection-card">


        <div class="collection-card-header">

            <div>

                <div class="collection-title">
                    Today's Collection
                </div>

                <div class="collection-subtitle">
                    <%= milkDairies.length %>
                    <%= milkDairies.length === 1
                        ? "animal"
                        : "animals"
                    %>
                </div>

            </div>


            <% if (canSubmit) { %>

                <div class="collection-status">

                    <span class="status-dot"></span>

                    <% if (currentSession === "closed" && adminUser) { %>
                        Admin Entry
                    <% } else { %>
                        Ready for Entry
                    <% } %>

                </div>

            <% } else { %>

                <div class="collection-status status-locked">
                    🔒 Locked
                </div>

            <% } %>

        </div>



        <!-- ==================================================
             TABLE
        =================================================== -->

        <div class="milk-table-wrapper">

            <table class="milk-table">

                <thead>

                    <tr>

                        <th class="col-animal">
                            Animal
                        </th>

                        <th class="col-code">
                            Code
                        </th>

                        <th class="col-milk">
                            Milk
                            <span>(Litres)</span>
                        </th>

                        <th class="col-remarks">
                            Remarks
                        </th>

                        <th class="col-action">
                            Action
                        </th>

                    </tr>

                </thead>


                <tbody>

                <%
                    milkDairies.forEach((dairy, index) => {

                        let record = null;

                        if (entrySession === "morning") {

                            record =
                                dairy.morning || null;

                        } else {

                            record =
                                dairy.evening || null;

                        }


                        const canCreateRecord =
                            !record &&
                            canSubmit;


                        const canEditRecord =
                            adminUser &&
                            record &&
                            record._id;


                        const formId =
                            "milkRecordForm_" +
                            String(dairy._id) +
                            "_" +
                            String(index);
                %>


                    <!-- ==================================================
                         ANIMAL ROW
                    =================================================== -->

                    <tr
                        class="<%= record
                            ? 'has-record'
                            : 'needs-record'
                        %>"
                    >


                        <!-- ==============================================
                             ANIMAL
                        =============================================== -->

                        <td>

                            <div class="animal-cell">

                                <div class="animal-avatar">
                                    🐄
                                </div>

                                <div class="animal-info">

                                    <span class="animal-name">
                                        <%= dairy.name %>
                                    </span>

                                    <span class="animal-label">
                                        Dairy animal
                                    </span>

                                </div>

                            </div>

                        </td>



                        <!-- ==============================================
                             CODE
                        =============================================== -->

                        <td>

                            <span class="code-badge">
                                #<%= dairy.code %>
                            </span>

                        </td>



                        <!-- ==============================================
                             MILK
                        =============================================== -->

                        <td>

                        <% if (record) { %>


                            <% if (canEditRecord) { %>

                                <!-- ADMIN EDITABLE RECORD -->

                                <button
                                    type="button"
                                    class="record-wrapper admin-edit-record js-edit-milk"
                                    data-record-id="<%= record._id %>"
                                    data-liters="<%= Number(record.liters || 0) %>"
                                    data-remarks="<%= String(record.remarks || '').replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;') %>"
                                    title="Tap to edit this record"
                                    aria-label="Edit milk record"
                                >

                                    <span class="milk-value-display">

                                        <span>
                                            <%= Number(
                                                record.liters || 0
                                            ).toFixed(1) %>
                                        </span>

                                        <small>
                                            L
                                        </small>

                                    </span>

                                    <span class="edit-icon">
                                        ✏️
                                    </span>

                                </button>

                            <% } else { %>

                                <!-- READ ONLY RECORD -->

                                <div class="record-wrapper">

                                    <div class="milk-value-display">

                                        <span>
                                            <%= Number(
                                                record.liters || 0
                                            ).toFixed(1) %>
                                        </span>

                                        <small>
                                            L
                                        </small>

                                    </div>

                                </div>

                            <% } %>


                        <% } else if (canCreateRecord) { %>


                            <!-- NEW RECORD -->

                            <div class="milk-entry-wrapper">

                                <input
                                    class="milk-input"
                                    type="number"
                                    step="0.1"
                                    min="0"
                                    name="liters"
                                    form="<%= formId %>"
                                    placeholder="0.0"
                                    required
                                    inputmode="decimal"
                                >

                                <span class="input-unit">
                                    L
                                </span>

                            </div>


                        <% } else { %>


                            <!-- LOCKED -->

                            <div class="locked-input">

                                <span>
                                    —
                                </span>

                                <small>
                                    Locked
                                </small>

                            </div>


                        <% } %>

                        </td>



                        <!-- ==============================================
                             REMARKS
                        =============================================== -->

                        <td>

                        <% if (record) { %>

                            <%
                                const displayRemarks =
                                    record.remarks &&
                                    String(record.remarks).trim()
                                        ? record.remarks
                                        : "No remarks";
                            %>


                            <% if (canEditRecord) { %>

                                <button
                                    type="button"
                                    class="remarks-wrapper admin-edit-record js-edit-milk"
                                    data-record-id="<%= record._id %>"
                                    data-liters="<%= Number(record.liters || 0) %>"
                                    data-remarks="<%= String(record.remarks || '').replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;') %>"
                                    title="Tap to edit this record"
                                >

                                    <span class="remarks-text">
                                        <%= displayRemarks %>
                                    </span>


                                    <% if (
                                        record.recordedByType === "system" ||
                                        record.recordedBySystem
                                    ) { %>

                                        <span class="record-badge system-record">

                                            <span>
                                                ⚙️
                                            </span>

                                            Automatically recorded
                                            as Not Milked.

                                        </span>

                                    <% } else { %>

                                        <span class="record-badge">

                                            <span>
                                                ✓
                                            </span>

                                            Already recorded

                                        </span>

                                    <% } %>


                                    <span class="admin-edit-hint">
                                        ✏️ Tap to edit
                                    </span>

                                </button>

                            <% } else { %>

                                <div class="remarks-wrapper">

                                    <div class="remarks-text">
                                        <%= displayRemarks %>
                                    </div>


                                    <% if (
                                        record.recordedByType === "system" ||
                                        record.recordedBySystem
                                    ) { %>

                                        <div class="record-badge system-record">

                                            <span>
                                                ⚙️
                                            </span>

                                            Automatically recorded
                                            as Not Milked.

                                        </div>

                                    <% } else { %>

                                        <div class="record-badge">

                                            <span>
                                                ✓
                                            </span>

                                            Already recorded

                                        </div>

                                    <% } %>

                                </div>

                            <% } %>


                        <% } else if (canCreateRecord) { %>


                            <!-- NEW REMARKS -->

                            <textarea
                                class="remarks-input"
                                name="remarks"
                                form="<%= formId %>"
                                placeholder="Optional remarks..."
                                rows="2"
                            ></textarea>


                        <% } else { %>


                            <!-- LOCKED REMARKS -->

                            <div class="closed-remarks">

                                <span>
                                    🔒
                                </span>

                                <span>
                                    No new record can be
                                    submitted at this time.
                                </span>

                            </div>


                        <% } %>

                        </td>



                        <!-- ==============================================
                             ACTION
                        =============================================== -->

                        <td class="action-cell">

                        <% if (record) { %>


                            <% if (canEditRecord) { %>

                                <button
                                    type="button"
                                    class="row-action-btn admin-action js-edit-milk"
                                    data-record-id="<%= record._id %>"
                                    data-liters="<%= Number(record.liters || 0) %>"
                                    data-remarks="<%= String(record.remarks || '').replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;') %>"
                                >

                                    ✏️
                                    <span>
                                        Edit
                                    </span>

                                </button>

                            <% } else { %>

                                <div class="read-only-label">

                                    <span>
                                        ✓
                                    </span>

                                    <span>
                                        Read-only
                                    </span>

                                </div>

                            <% } %>


                        <% } else if (canCreateRecord) { %>


                            <button
                                type="submit"
                                form="<%= formId %>"
                                class="row-action-btn save-action"
                            >

                                ✓

                                <span>
                                    Save
                                </span>

                            </button>


                        <% } else { %>


                            <div class="read-only-label locked-label">

                                <span>
                                    🔒
                                </span>

                                <span>
                                    Locked
                                </span>

                            </div>


                        <% } %>

                        </td>

                    </tr>


                    <!-- ==================================================
                         INDIVIDUAL FORM
                    =================================================== -->

                    <% if (canCreateRecord) { %>

                        <form
                            id="<%= formId %>"
                            action="/milk"
                            method="POST"
                            class="individual-milk-form"
                        >

                            <input
                                type="hidden"
                                name="dairy"
                                value="<%= dairy._id %>"
                            >

                            <input
                                type="hidden"
                                name="session"
                                value="<%= entrySession %>"
                            >

                        </form>

                    <% } %>


                <%
                    });
                %>

                </tbody>

            </table>

        </div>

    </section>



    <!-- ==================================================
         INFORMATION CARD
    =================================================== -->

    <div class="milk-submit-card">

        <div class="submit-information">

            <div class="submit-info-icon">

                <% if (canSubmit) { %>
                    ✓
                <% } else { %>
                    🔒
                <% } %>

            </div>


            <div>

                <% if (currentSession === "morning") { %>

                    <strong>
                        Morning collection is open
                    </strong>

                    <span>
                        Enter and save each animal individually.
                        Once saved, the record becomes read-only
                        for normal users.
                    </span>


                <% } else if (
                    currentSession === "closed" &&
                    adminUser
                ) { %>

                    <strong>
                        Administrator morning access
                    </strong>

                    <span>
                        You can submit new morning records or edit
                        existing morning records until
                        <strong>4:00 PM</strong>.
                    </span>


                <% } else if (
                    currentSession === "closed"
                ) { %>

                    <strong>
                        Collection is currently closed
                    </strong>

                    <span>
                        Evening collection becomes available
                        at <strong>4:00 PM</strong>.
                    </span>


                <% } else if (
                    currentSession === "evening"
                ) { %>

                    <strong>
                        Evening collection is open
                    </strong>

                    <span>
                        Enter and save each animal individually.
                        Administrators can also edit existing
                        evening records.
                    </span>


                <% } else { %>

                    <strong>
                        Collection unavailable
                    </strong>

                    <span>
                        Please contact an administrator.
                    </span>

                <% } %>

            </div>

        </div>

    </div>


<% } %>

</div><!-- ==========================================================
     ADMIN EDIT MODAL
========================================================== --><div
    id="milkEditModal"
    class="milk-edit-modal"
    aria-hidden="true"
><div
    class="milk-edit-backdrop"
    data-close-edit-modal
></div>


<div
    class="milk-edit-dialog"
    role="dialog"
    aria-modal="true"
    aria-labelledby="milkEditTitle"
>

    <div class="edit-modal-header">

        <div>

            <div class="edit-modal-eyebrow">
                ADMINISTRATOR
            </div>

            <h2 id="milkEditTitle">
                Edit Milk Record
            </h2>

            <p>
                Update the litres or remarks for this record.
            </p>

        </div>


        <button
            type="button"
            class="modal-close-btn"
            id="closeMilkEditButton"
            aria-label="Close"
        >
            ×
        </button>

    </div>


    <!-- ======================================================
         UPDATE FORM

         Matches controller:

         exports.updateMilkRecord = async (req, res) => ...

         Expected route:

         POST /milk/:id
    ======================================================= -->

    <form
        id="milkEditForm"
        method="POST"
        action=""
    >

        <div class="edit-modal-body">


            <div class="edit-field">

                <label for="editLiters">
                    Milk
                </label>

                <div class="edit-input-wrapper">

                    <input
                        id="editLiters"
                        name="liters"
                        type="number"
                        step="0.1"
                        min="0"
                        required
                        inputmode="decimal"
                    >

                    <span>
                        Litres
                    </span>

                </div>

            </div>


            <div class="edit-field">

                <label for="editRemarks">
                    Remarks
                </label>

                <textarea
                    id="editRemarks"
                    name="remarks"
                    rows="4"
                    placeholder="Optional remarks..."
                ></textarea>

            </div>


        </div>


        <div class="edit-modal-footer">

            <button
                type="button"
                class="modal-cancel-btn"
                id="cancelMilkEditButton"
            >
                Cancel
            </button>

            <button
                type="submit"
                class="modal-save-btn"
                id="saveMilkEditButton"
            >
                ✓ Save Changes
            </button>

        </div>

    </form>

</div>

</div><!-- ==========================================================
     STYLES
========================================================== --><style>

/* ==========================================================
   PAGE
========================================================== */

.milk-page {
    width: 100%;
    max-width: 1500px;
    margin: 0 auto;
    padding: 28px 24px 50px;
    box-sizing: border-box;
}


/* ==========================================================
   HEADER
========================================================== */

.milk-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 24px;
}

.milk-header-content {
    display: flex;
    align-items: center;
    gap: 16px;
    min-width: 0;
}

.milk-header-icon {
    width: 58px;
    height: 58px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    background: #eaf7ef;
    border: 1px solid #d5eddd;
    border-radius: 17px;
    font-size: 29px;
    box-shadow: 0 6px 18px rgba(27, 94, 32, 0.08);
}

.milk-eyebrow {
    margin-bottom: 3px;
    color: #2e7d32;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1.4px;
}

.milk-header h1 {
    margin: 0;
    color: #17231a;
    font-size: 29px;
    font-weight: 800;
    line-height: 1.15;
}

.milk-header p {
    margin: 6px 0 0;
    color: #718078;
    font-size: 14px;
}


/* ==========================================================
   SESSION BADGE
========================================================== */

.milk-session-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 14px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 700;
    white-space: nowrap;
}

.session-morning,
.session-evening,
.session-admin {
    background: #eaf7ef;
    color: #277437;
}

.session-closed {
    background: #f4f5f4;
    color: #707873;
}

.session-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: currentColor;
}


/* ==========================================================
   ALERTS
========================================================== */

.milk-alert {
    display: flex;
    align-items: flex-start;
    gap: 13px;
    padding: 15px 17px;
    margin-bottom: 18px;
    border-radius: 14px;
    border: 1px solid;
}

.alert-icon {
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    font-weight: 800;
}

.milk-alert strong {
    display: block;
    margin-bottom: 2px;
    font-size: 14px;
}

.milk-alert p {
    margin: 0;
    font-size: 13px;
    line-height: 1.5;
}

.milk-alert-error {
    background: #fff5f5;
    border-color: #ffd9d9;
    color: #9b3030;
}

.milk-alert-success {
    background: #f0faf3;
    border-color: #d2ecd8;
    color: #28723a;
}


/* ==========================================================
   SESSION CARD
========================================================== */

.milk-session-card {
    display: flex;
    align-items: center;
    gap: 15px;
    margin-bottom: 22px;
    padding: 17px 19px;
    border-radius: 17px;
    border: 1px solid;
    box-shadow: 0 5px 18px rgba(0, 0, 0, 0.035);
}

.session-card-open {
    background: #f3fbf5;
    border-color: #d8eddd;
}

.session-card-evening {
    background: #f4fbf7;
    border-color: #d9ede0;
}

.session-card-admin {
    background: #f0faf3;
    border-color: #cce6d2;
}

.session-card-closed {
    background: #fafafa;
    border-color: #e7e9e7;
}

.session-card-icon {
    width: 45px;
    height: 45px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 13px;
    background: rgba(255,255,255,0.8);
    font-size: 21px;
}

.session-card-content {
    flex: 1;
    min-width: 0;
}

.session-card-title {
    margin-bottom: 4px;
    color: #253129;
    font-size: 14px;
    font-weight: 800;
}

.session-card-description {
    color: #68746d;
    font-size: 13px;
