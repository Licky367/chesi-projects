<!-- ==========================================================
     JAVASCRIPT
========================================================== -->

<script>

(function () {

    "use strict";


    /* ======================================================
       SUCCESS / ERROR POPUP
    ====================================================== */

    const resultPopup =
        document.getElementById(
            "milkResultPopup"
        );


    const resultCloseButton =
        document.getElementById(
            "closeMilkResultPopup"
        );


    function closeResultPopup() {

        if (!resultPopup) {
            return;
        }

        resultPopup.style.display =
            "none";

        resultPopup.setAttribute(
            "aria-hidden",
            "true"
        );

    }


    if (resultCloseButton) {

        resultCloseButton.addEventListener(
            "click",
            closeResultPopup
        );

    }


    if (resultPopup) {

        resultPopup.addEventListener(
            "click",
            function (event) {

                if (
                    event.target &&
                    event.target.classList.contains(
                        "milk-result-backdrop"
                    )
                ) {

                    closeResultPopup();

                }

            }
        );

    }


    /* ======================================================
       EDIT MODAL
    ====================================================== */

    const modal =
        document.getElementById(
            "milkEditModal"
        );


    const form =
        document.getElementById(
            "milkEditForm"
        );


    const litersInput =
        document.getElementById(
            "editLiters"
        );


    const remarksInput =
        document.getElementById(
            "editRemarks"
        );


    const closeButton =
        document.getElementById(
            "closeMilkEditButton"
        );


    const cancelButton =
        document.getElementById(
            "cancelMilkEditButton"
        );


    const backdrop =
        document.querySelector(
            "[data-close-edit-modal]"
        );


    const saveButton =
        document.getElementById(
            "saveMilkEditButton"
        );


    if (
        !modal ||
        !form ||
        !litersInput ||
        !remarksInput
    ) {

        return;

    }


    /* ======================================================
       OPEN EDIT MODAL
    ====================================================== */

    function openEditModal(
        recordId,
        liters,
        remarks
    ) {

        if (!recordId) {

            console.error(
                "Cannot edit milk record: record ID missing."
            );

            return;

        }


        /*
         * Milk router is mounted at "/"
         *
         * Edit endpoint:
         *
         * POST /milk/:recordId
         */

        form.action =
            "/milk/" +
            encodeURIComponent(
                recordId
            );


        litersInput.value =
            Number(
                liters || 0
            );


        remarksInput.value =
            remarks || "";


        modal.classList.add(
            "open"
        );


        modal.setAttribute(
            "aria-hidden",
            "false"
        );


        document.body.classList.add(
            "milk-modal-open"
        );


        setTimeout(function () {

            litersInput.focus();
            litersInput.select();

        }, 50);

    }


    /* ======================================================
       CLOSE EDIT MODAL
    ====================================================== */

    function closeEditModal() {

        modal.classList.remove(
            "open"
        );


        modal.setAttribute(
            "aria-hidden",
            "true"
        );


        document.body.classList.remove(
            "milk-modal-open"
        );


        form.action = "";

        litersInput.value = "";

        remarksInput.value = "";


        if (saveButton) {

            saveButton.disabled =
                false;

            saveButton.textContent =
                "✓ Save Changes";

        }

    }


    /* ======================================================
       EDIT BUTTONS
    ====================================================== */

    const editButtons =
        document.querySelectorAll(
            ".js-edit-milk"
        );


    editButtons.forEach(
        function (button) {

            button.addEventListener(
                "click",
                function () {

                    openEditModal(
                        button.dataset.recordId,
                        button.dataset.liters,
                        button.dataset.remarks || ""
                    );

                }
            );

        }
    );


    /* ======================================================
       CLOSE MODAL
    ====================================================== */

    if (closeButton) {

        closeButton.addEventListener(
            "click",
            closeEditModal
        );

    }


    if (cancelButton) {

        cancelButton.addEventListener(
            "click",
            closeEditModal
        );

    }


    if (backdrop) {

        backdrop.addEventListener(
            "click",
            closeEditModal
        );

    }


    /* ======================================================
       ESCAPE
    ====================================================== */

    document.addEventListener(
        "keydown",
        function (event) {

            if (
                event.key === "Escape" &&
                modal.classList.contains("open")
            ) {

                closeEditModal();

            }

        }
    );


    /* ======================================================
       EDIT DOUBLE SUBMISSION
    ====================================================== */

    form.addEventListener(
        "submit",
        function () {

            if (!saveButton) {
                return;
            }


            saveButton.disabled =
                true;

            saveButton.textContent =
                "Saving...";

        }
    );


    /* ======================================================
       NEW RECORD DOUBLE SUBMISSION
    ====================================================== */

    document.addEventListener(
        "submit",
        function (event) {

            const submittedForm =
                event.target;


            if (
                !submittedForm ||
                !submittedForm.classList ||
                !submittedForm.classList.contains(
                    "individual-milk-form"
                )
            ) {

                return;

            }


            const formId =
                submittedForm.id;


            const button =
                document.querySelector(
                    'button[type="submit"][form="' +
                    formId +
                    '"]'
                );


            if (!button) {
                return;
            }


            button.disabled =
                true;

            button.classList.add(
                "is-submitting"
            );


            const span =
                button.querySelector(
                    "span"
                );


            if (span) {

                span.textContent =
                    "Saving...";

            } else {

                button.textContent =
                    "Saving...";

            }

        }
    );


})();

</script>