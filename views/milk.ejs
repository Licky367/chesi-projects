<%
/* ==========================================================
   MILK COLLECTION PAGE
========================================================== */

const pageError =
    typeof error !== "undefined"
        ? error
        : "";

const pageSuccess =
    typeof success !== "undefined"
        ? Boolean(success)
        : false;


/* ==========================================================
   SESSION
========================================================== */

const currentSession =
    typeof session !== "undefined"
        ? session
        : "";


/* ==========================================================
   USER
========================================================== */

const currentUser =
    typeof user !== "undefined" && user
        ? user
        : null;


const adminUser =
    currentUser &&
    currentUser.role === "admin";


const dairyWorker =
    currentUser &&
    currentUser.role === "dairyWorker";


/* ==========================================================
   CURRENT FARM
========================================================== */

const activeFarm =
    typeof currentDairy !== "undefined" &&
    currentDairy
        ? currentDairy
        : (
            typeof currentFarm !== "undefined" &&
            currentFarm
                ? currentFarm
                : null
        );


/* ==========================================================
   ACTIVE FARM NAME
========================================================== */

const activeFarmName =
    activeFarm &&
    activeFarm.name
        ? activeFarm.name
        : "Dairy Farm";


/* ==========================================================
   FARM TABLE DATA
========================================================== */

let milkTables = [];


/*
 * Preferred source.
 *
 * The backend should eventually provide:
 *
 * milkDairyTables = [
 *
 *     {
 *         farm: {
 *             _id,
 *             name,
 *             code
 *         },
 *
 *         animals: [...]
 *     }
 *
 * ]
 *
 */

if (
    typeof milkDairyTables !== "undefined" &&
    Array.isArray(milkDairyTables)
) {

    milkTables =
        milkDairyTables;

}


/* ==========================================================
   FALLBACK FOR EXISTING / OLD DATA
========================================================== */

else if (
    typeof dairies !== "undefined" &&
    Array.isArray(dairies)
) {

    const grouped =
        new Map();


    dairies.forEach(function (animal) {

        if (!animal) {
            return;
        }


        if (
            animal.isMilking !== true
        ) {
            return;
        }


        const farm =
            animal.farm ||
            animal.dairyFarm ||
            animal.farmInfo ||
            null;


        const farmId =
            farm &&
            farm._id
                ? String(farm._id)
                : null;


        const farmCode =
            farm &&
            farm.code !== undefined &&
            farm.code !== null
                ? String(farm.code)
                : (
                    animal.assetCode !== undefined &&
                    animal.assetCode !== null
                        ? String(animal.assetCode)
                        : "unassigned"
                );


        /*
         * Prefer farm ID when available.
         *
         * This prevents two farms with different
         * internal IDs from accidentally being
         * grouped together.
         */

        const groupKey =
            farmId
                ? "farm_" + farmId
                : "code_" + farmCode;


        if (!grouped.has(groupKey)) {

            grouped.set(
                groupKey,
                {
                    farm: farm,
                    animals: []
                }
            );

        }


        grouped
            .get(groupKey)
            .animals
            .push(animal);

    });


    milkTables =
        Array.from(
            grouped.values()
        );

}


/* ==========================================================
   ENSURE ARRAY
========================================================== */

if (!Array.isArray(milkTables)) {

    milkTables = [];

}


/* ==========================================================
   DAIRY WORKER FARM FILTER
========================================================== */

if (dairyWorker) {

    milkTables =
        milkTables.filter(function (table) {

            if (
                !table ||
                !table.farm ||
                !activeFarm
            ) {

                return false;

            }


            const tableFarmId =
                table.farm._id
                    ? String(table.farm._id)
                    : null;


            const activeFarmId =
                activeFarm._id
                    ? String(activeFarm._id)
                    : null;


            /*
             * First attempt:
             * compare MongoDB IDs.
             */

            if (
                tableFarmId &&
                activeFarmId &&
                tableFarmId === activeFarmId
            ) {

                return true;

            }


            /*
             * Fallback:
             * compare farm codes.
             */

            const tableFarmCode =
                table.farm.code !== undefined &&
                table.farm.code !== null
                    ? String(table.farm.code)
                    : null;


            const activeFarmCode =
                activeFarm.code !== undefined &&
                activeFarm.code !== null
                    ? String(activeFarm.code)
                    : null;


            if (
                tableFarmCode &&
                activeFarmCode &&
                tableFarmCode === activeFarmCode
            ) {

                return true;

            }


            return false;

        });

}


/* ==========================================================
   REMOVE EMPTY TABLES
========================================================== */

milkTables =
    milkTables.filter(function (table) {

        return (
            table &&
            Array.isArray(table.animals) &&
            table.animals.length > 0
        );

    });


/* ==========================================================
   SESSION PERMISSIONS
========================================================== */

const adminMorningWindow =
    adminUser &&
    (
        currentSession === "morning" ||
        currentSession === "closed"
    );


const adminEveningWindow =
    adminUser &&
    currentSession === "evening";


const canSubmit =
    currentSession === "morning" ||
    currentSession === "evening" ||
    adminMorningWindow;


/* ==========================================================
   ACTIVE ENTRY SESSION
========================================================== */

const entrySession =
    currentSession === "evening"
        ? "evening"
        : "morning";


/* ==========================================================
   TOTAL ANIMAL COUNT
========================================================== */

let totalAnimals = 0;


milkTables.forEach(function (table) {

    if (
        Array.isArray(table.animals)
    ) {

        totalAnimals +=
            table.animals.length;

    }

});


/* ==========================================================
   SESSION DISPLAY
========================================================== */

let sessionTitle =
    "Collection Closed";

let sessionIcon =
    "🔒";

let sessionClass =
    "session-card-closed";

let sessionBadgeClass =
    "session-closed";

let sessionBadgeText =
    "Closed";


if (currentSession === "morning") {

    sessionTitle =
        "Morning collection";

    sessionIcon =
        "🌅";

    sessionClass =
        "session-card-open";

    sessionBadgeClass =
        "session-morning";

    sessionBadgeText =
        "Morning";

}


else if (currentSession === "closed") {

    if (adminUser) {

        sessionTitle =
            "Morning collection";

        sessionIcon =
            "✏️";

        sessionClass =
            "session-card-admin";

        sessionBadgeClass =
            "session-admin";

        sessionBadgeText =
            "Admin Access";

    }

    else {

        sessionTitle =
            "Collection closed";

        sessionIcon =
            "⏰";

        sessionClass =
            "session-card-closed";

        sessionBadgeClass =
            "session-closed";

        sessionBadgeText =
            "Closed";

    }

}


else if (currentSession === "evening") {

    sessionTitle =
        "Evening collection";

    sessionIcon =
        "🌆";

    sessionClass =
        "session-card-evening";

    sessionBadgeClass =
        "session-evening";

    sessionBadgeText =
        "Evening";

}


else {

    sessionTitle =
        "Collection unavailable";

}

%>


<!-- ==========================================================
     MILK COLLECTION PAGE
========================================================== -->

<div class="milk-page">


<!-- ==========================================================
     HEADER
========================================================== -->

<header class="milk-header">

    <div class="milk-header-content">

        <div class="milk-header-icon">
            🥛
        </div>


        <div class="milk-header-text">

            <% if (adminUser) { %>

                <div class="milk-eyebrow">
                    ALL DAIRY FARMS
                </div>

            <% } else { %>

                <div class="milk-eyebrow">
                    <%= activeFarmName %>
                </div>

            <% } %>


            <h1>
                Milk Collection
            </h1>

        </div>

    </div>


    <div class="milk-session-badge <%= sessionBadgeClass %>">

        <span class="session-dot"></span>

        <span>
            <%= sessionBadgeText %>
        </span>

    </div>

</header>


<!-- ==========================================================
     ADMIN FARM SUMMARY
========================================================== -->

<% if (adminUser && milkTables.length > 0) { %>

    <div class="admin-farm-summary">

        <div class="admin-farm-summary-icon">
            🏡
        </div>

        <div class="admin-farm-summary-content">

            <strong>
                Dairy farm collections
            </strong>

            <span>
                <%= milkTables.length %>
                <%= milkTables.length === 1
                    ? "farm"
                    : "farms"
                %>
                ·
                <%= totalAnimals %>
                <%= totalAnimals === 1
                    ? "milking animal"
                    : "milking animals"
                %>
            </span>

        </div>

    </div>

<% } %>


<!-- ==========================================================
     SESSION STATUS
========================================================== -->

<div class="milk-session-card <%= sessionClass %>">

    <div class="session-card-icon">
        <%= sessionIcon %>
    </div>


    <div class="session-card-content">

        <div class="session-card-title">
            <%= sessionTitle %>
        </div>

    </div>


    <div class="session-time">

        <% if (currentSession === "morning") { %>

            <span>
                Closes
            </span>

            <strong>
                10:00 AM
            </strong>

        <% } else if (currentSession === "closed") { %>

            <span>
                Evening
            </span>

            <strong>
                4:00 PM
            </strong>

        <% } else if (currentSession === "evening") { %>

            <span>
                Closes
            </span>

            <strong>
                Midnight
            </strong>

        <% } %>

    </div>

</div>


<!-- ==========================================================
     NO ANIMALS
========================================================== -->

<% if (milkTables.length === 0) { %>

    <div class="milk-empty-state">

        <div class="empty-animal-icon">
            🐄
        </div>

        <h2>
            No Animals Currently Being Milked
        </h2>

        <% if (adminUser) { %>

            <p>
                No dairy farms currently have animals marked
                as being milked.
            </p>

        <% } %>

    </div>


<% } else { %>


<!-- ==========================================================
     FARM TABLES
========================================================== -->

<%
milkTables.forEach(function (table, tableIndex) {

    const farm =
        table.farm || null;


    const animals =
        Array.isArray(table.animals)
            ? table.animals
            : [];


    /*
     * IMPORTANT:
     *
     * For admins this is the title of each
     * individual milk table.
     *
     * For workers it is their farm name.
     */

    const farmName =
        farm &&
        farm.name
            ? farm.name
            : "Dairy Farm";


    const farmCode =
        farm &&
        farm.code !== undefined &&
        farm.code !== null
            ? farm.code
            : null;


    const farmId =
        farm &&
        farm._id
            ? String(farm._id)
            : "";


    /*
     * Admin-specific table title.
     *
     * This guarantees every table clearly
     * identifies the dairy farm it belongs to.
     */

    const tableTitle =
        adminUser
            ? farmName
            : farmName;

%>


<!-- ==========================================================
     COLLECTION CARD — ONE PER FARM
========================================================== -->

<section
    class="collection-card farm-collection-card <%= adminUser ? 'admin-farm-card' : '' %>"
    data-farm-id="<%= farmId %>"
    data-farm-name="<%= farmName %>"
>


    <!-- ======================================================
         FARM HEADER
    ======================================================= -->

    <div class="collection-card-header">


        <div class="farm-title-area">


            <% if (adminUser) { %>

                <!-- ADMIN FARM TITLE -->

                <div class="admin-farm-label">
                    DAIRY FARM
                </div>

            <% } %>


            <div class="collection-title">

                <span class="farm-title-icon">
                    🐄
                </span>

                <span>
                    <%= tableTitle %>
                </span>

            </div>


            <div class="collection-subtitle">

                <% if (farmCode !== null) { %>

                    <span>
                        Farm #<%= farmCode %>
                    </span>

                    <span class="subtitle-separator">
                        ·
                    </span>

                <% } %>


                <span>
                    <%= animals.length %>
                    <%= animals.length === 1
                        ? "milking animal"
                        : "milking animals"
                    %>
                </span>

            </div>

        </div>


        <% if (canSubmit) { %>

            <div class="collection-status">

                <span class="status-dot"></span>

                <% if (
                    currentSession === "closed" &&
                    adminUser
                ) { %>

                    Admin Entry

                <% } else { %>

                    Ready

                <% } %>

            </div>

        <% } else { %>

            <div class="collection-status status-locked">

                🔒 Locked

            </div>

        <% } %>

    </div>


    <!-- ======================================================
         FARM TABLE
    ======================================================= -->

    <div class="milk-table-wrapper">

        <table
            class="milk-table"
            data-farm-id="<%= farmId %>"
        >

            <thead>

                <tr>

                    <th class="col-animal">
                        Animal
                    </th>

                    <th class="col-code">
                        Code
                    </th>

                    <th class="col-milk">
                        Milk
                        <span>(Litres)</span>
                    </th>

                    <th class="col-remarks">
                        Remarks
                    </th>

                    <th class="col-action">
                        Action
                    </th>

                </tr>

            </thead>


            <tbody>


            <%
            animals.forEach(function (dairy, animalIndex) {

                let record = null;


                if (entrySession === "morning") {

                    record =
                        dairy.morning || null;

                }

                else {

                    record =
                        dairy.evening || null;

                }


                const canCreateRecord =
                    !record &&
                    canSubmit;


                const canEditRecord =
                    adminUser &&
                    record &&
                    record._id;


                const formId =
                    "milkRecordForm_" +
                    String(dairy._id) +
                    "_" +
                    String(tableIndex) +
                    "_" +
                    String(animalIndex);

            %>


            <!-- ==================================================
                 ANIMAL ROW
            =================================================== -->

            <tr
                class="<%= record
                    ? 'has-record'
                    : 'needs-record'
                %>"
            >


                <!-- ==============================================
                     ANIMAL
                =============================================== -->

                <td>

                    <div class="animal-cell">

                        <div class="animal-avatar">
                            🐄
                        </div>

                        <div class="animal-info">

                            <span class="animal-name">
                                <%= dairy.name %>
                            </span>

                            <span class="animal-label">
                                Dairy animal
                            </span>

                        </div>

                    </div>

                </td>


                <!-- ==============================================
                     CODE
                =============================================== -->

                <td>

                    <span class="code-badge">
                        #<%= dairy.code %>
                    </span>

                </td>


                <!-- ==============================================
                     MILK
                =============================================== -->

                <td>

                <% if (record) { %>


                    <% if (canEditRecord) { %>

                        <button
                            type="button"
                            class="record-wrapper admin-edit-record js-edit-milk"
                            data-record-id="<%= record._id %>"
                            data-liters="<%= Number(record.liters || 0) %>"
                            data-remarks="<%= String(record.remarks || '').replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;') %>"
                            title="Edit milk record"
                            aria-label="Edit milk record"
                        >

                            <span class="milk-value-display">

                                <span>
                                    <%= Number(
                                        record.liters || 0
                                    ).toFixed(1) %>
                                </span>

                                <small>
                                    L
                                </small>

                            </span>

                            <span class="edit-icon">
                                ✏️
                            </span>

                        </button>


                    <% } else { %>

                        <div class="record-wrapper">

                            <div class="milk-value-display">

                                <span>
                                    <%= Number(
                                        record.liters || 0
                                    ).toFixed(1) %>
                                </span>

                                <small>
                                    L
                                </small>

                            </div>

                        </div>

                    <% } %>


                <% } else if (canCreateRecord) { %>


                    <div class="milk-entry-wrapper">

                        <input
                            class="milk-input"
                            type="number"
                            step="0.1"
                            min="0"
                            name="liters"
                            form="<%= formId %>"
                            placeholder="0.0"
                            required
                            inputmode="decimal"
                        >

                        <span class="input-unit">
                            L
                        </span>

                    </div>


                <% } else { %>


                    <div class="locked-input">

                        <span>
                            —
                        </span>

                        <small>
                            Locked
                        </small>

                    </div>


                <% } %>

                </td>


                <!-- ==============================================
                     REMARKS
                =============================================== -->

                <td>

                <% if (record) { %>

                    <%
                    const displayRemarks =
                        record.remarks &&
                        String(record.remarks).trim()
                            ? record.remarks
                            : "No remarks";
                    %>


                    <% if (canEditRecord) { %>

                        <button
                            type="button"
                            class="remarks-wrapper admin-edit-record js-edit-milk"
                            data-record-id="<%= record._id %>"
                            data-liters="<%= Number(record.liters || 0) %>"
                            data-remarks="<%= String(record.remarks || '').replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;') %>"
                            title="Edit milk record"
                        >

                            <span class="remarks-text">
                                <%= displayRemarks %>
                            </span>


                            <% if (
                                record.recordedByType === "system" ||
                                record.recordedBySystem
                            ) { %>

                                <span class="record-badge system-record">

                                    <span>
                                        ⚙️
                                    </span>

                                    Automatically recorded
                                    as Not Milked.

                                </span>

                            <% } else { %>

                                <span class="record-badge">

                                    <span>
                                        ✓
                                    </span>

                                    Already recorded

                                </span>

                            <% } %>


                            <span class="admin-edit-hint">
                                ✏️ Tap to edit
                            </span>

                        </button>


                    <% } else { %>

                        <div class="remarks-wrapper">

                            <div class="remarks-text">
                                <%= displayRemarks %>
                            </div>


                            <% if (
                                record.recordedByType === "system" ||
                                record.recordedBySystem
                            ) { %>

                                <div class="record-badge system-record">

                                    <span>
                                        ⚙️
                                    </span>

                                    Automatically recorded
                                    as Not Milked.

                                </div>

                            <% } else { %>

                                <div class="record-badge">

                                    <span>
                                        ✓
                                    </span>

                                    Already recorded

                                </div>

                            <% } %>

                        </div>

                    <% } %>


                <% } else if (canCreateRecord) { %>


                    <textarea
                        class="remarks-input"
                        name="remarks"
                        form="<%= formId %>"
                        placeholder="Optional remarks..."
                        rows="2"
                    ></textarea>


                <% } else { %>


                    <div class="closed-remarks">

                        🔒

                    </div>


                <% } %>

                </td>


                <!-- ==============================================
                     ACTION
                =============================================== -->

                <td class="action-cell">

                <% if (record) { %>


                    <% if (canEditRecord) { %>

                        <button
                            type="button"
                            class="row-action-btn admin-action js-edit-milk"
                            data-record-id="<%= record._id %>"
                            data-liters="<%= Number(record.liters || 0) %>"
                            data-remarks="<%= String(record.remarks || '').replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;') %>"
                        >

                            ✏️

                            <span>
                                Edit
                            </span>

                        </button>


                    <% } else { %>

                        <div class="read-only-label">

                            <span>
                                ✓
                            </span>

                            <span>
                                Read-only
                            </span>

                        </div>

                    <% } %>


                <% } else if (canCreateRecord) { %>


                    <button
                        type="submit"
                        form="<%= formId %>"
                        class="row-action-btn save-action"
                    >

                        ✓

                        <span>
                            Save
                        </span>

                    </button>


                <% } else { %>


                    <div class="read-only-label locked-label">

                        <span>
                            🔒
                        </span>

                        <span>
                            Locked
                        </span>

                    </div>


                <% } %>

                </td>

            </tr>


            <!-- ==================================================
                 INDIVIDUAL FORM
            =================================================== -->

            <% if (canCreateRecord) { %>

                <form
                    id="<%= formId %>"
                    action="/milk"
                    method="POST"
                    class="individual-milk-form"
                >

                    <input
                        type="hidden"
                        name="dairy"
                        value="<%= dairy._id %>"
                    >

                    <input
                        type="hidden"
                        name="session"
                        value="<%= entrySession %>"
                    >

                    <input
                        type="hidden"
                        name="farm"
                        value="<%= farmId %>"
                    >

                </form>

            <% } %>


            <%
            });
            %>


            </tbody>

        </table>

    </div>

</section>


<%
});
%>


<% } %>

</div>


<!-- ==========================================================
     SUCCESS / ERROR POPUP
========================================================== -->

<% if (pageSuccess || pageError) { %>

<div
    id="milkResultPopup"
    class="milk-result-popup"
    aria-hidden="false"
>

    <div class="milk-result-backdrop"></div>


    <div
        class="milk-result-dialog <%= pageSuccess
            ? 'result-success'
            : 'result-error'
        %>"
        role="alertdialog"
        aria-modal="true"
    >

        <div class="result-icon">

            <% if (pageSuccess) { %>
                ✓
            <% } else { %>
                !
            <% } %>

        </div>


        <div class="result-content">

            <h2>

                <% if (pageSuccess) { %>
                    Milk record saved
                <% } else { %>
                    Unable to save record
                <% } %>

            </h2>


            <p>

                <% if (pageSuccess) { %>

                    Milk record saved successfully.

                <% } else { %>

                    <%= pageError %>

                <% } %>

            </p>

        </div>


        <button
            type="button"
            id="closeMilkResultPopup"
            class="result-ok-button"
        >
            OK
        </button>

    </div>

</div>

<% } %>


<!-- ==========================================================
     ADMIN EDIT MODAL
========================================================== -->

<div
    id="milkEditModal"
    class="milk-edit-modal"
    aria-hidden="true"
>

    <div
        class="milk-edit-backdrop"
        data-close-edit-modal
    ></div>


    <div
        class="milk-edit-dialog"
        role="dialog"
        aria-modal="true"
        aria-labelledby="milkEditTitle"
    >

        <div class="edit-modal-header">

            <div>

                <div class="edit-modal-eyebrow">
                    ADMINISTRATOR
                </div>

                <h2 id="milkEditTitle">
                    Edit Milk Record
                </h2>

            </div>


            <button
                type="button"
                class="modal-close-btn"
                id="closeMilkEditButton"
                aria-label="Close"
            >
                ×
            </button>

        </div>


        <form
            id="milkEditForm"
            method="POST"
            action=""
        >

            <div class="edit-modal-body">

                <div class="edit-field">

                    <label for="editLiters">
                        Milk
                    </label>

                    <div class="edit-input-wrapper">

                        <input
                            id="editLiters"
                            name="liters"
                            type="number"
                            step="0.1"
                            min="0"
                            required
                            inputmode="decimal"
                        >

                        <span>
                            Litres
                        </span>

                    </div>

                </div>


                <div class="edit-field">

                    <label for="editRemarks">
                        Remarks
                    </label>

                    <textarea
                        id="editRemarks"
                        name="remarks"
                        rows="4"
                        placeholder="Optional remarks..."
                    ></textarea>

                </div>

            </div>


            <div class="edit-modal-footer">

                <button
                    type="button"
                    class="modal-cancel-btn"
                    id="cancelMilkEditButton"
                >
                    Cancel
                </button>

                <button
                    type="submit"
                    class="modal-save-btn"
                    id="saveMilkEditButton"
                >
                    ✓ Save Changes
                </button>

            </div>

        </form>

    </div>

</div>


<!-- ==========================================================
     FARM TABLE STYLES
========================================================== -->

<style>

/* ==========================================================
   FARM CARD
========================================================== */

.farm-collection-card {
