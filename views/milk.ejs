<!-- =====================================================
     FRONTEND TOTAL CALCULATION
===================================================== -->

<script>

document.addEventListener(
  "input",
  function(event) {

    if (
      !event.target.classList.contains(
        "milk-input"
      )
    ) {

      return;

    }


    const row =
      event.target.closest("tr");


    if (!row) {

      return;

    }


    const inputs =
      row.querySelectorAll(
        ".milk-input"
      );


    let total = 0;


    inputs.forEach(input => {

      total +=
        Number(input.value || 0);

    });


    const totalElement =
      row.querySelector(
        ".daily-total-number"
      );


    if (totalElement) {

      totalElement.textContent =
        total.toFixed(2);

    }

  }
);


/* =====================================================
   SUCCESS / FAILURE POPUP

   The page does not contain a permanent message section.

   Supported URL states:

   ?success=1
   ?error=1
===================================================== */

function showMilkMessage(
  type,
  title,
  message
) {

  const popup =
    document.getElementById(
      "milkMessagePopup"
    );


  const icon =
    document.getElementById(
      "milkMessageIcon"
    );


  const titleElement =
    document.getElementById(
      "milkMessageTitle"
    );


  const textElement =
    document.getElementById(
      "milkMessageText"
    );


  if (!popup) {

    return;

  }


  popup.classList.remove(
    "success",
    "error"
  );


  popup.classList.add(type);


  icon.textContent =
    type === "success"
      ? "✅"
      : "❌";


  titleElement.textContent =
    title;


  textElement.textContent =
    message;


  popup.classList.add("show");


  window.setTimeout(
    closeMilkMessage,
    5000
  );

}


function closeMilkMessage() {

  const popup =
    document.getElementById(
      "milkMessagePopup"
    );


  if (popup) {

    popup.classList.remove(
      "show"
    );

  }

}


/* =====================================================
   READ MESSAGE FROM URL
===================================================== */

document.addEventListener(
  "DOMContentLoaded",
  function() {

    const params =
      new URLSearchParams(
        window.location.search
      );


    if (
      params.get("success") === "1"
    ) {

      showMilkMessage(
        "success",
        "Success",
        "Milk record submitted successfully."
      );

    }


    if (
      params.get("error") === "1"
    ) {

      showMilkMessage(
        "error",
        "Unable to save",
        "The milk record could not be saved."
      );

    }

  }
);

</script>