<% /*
==========================================================
MILK COLLECTION PAGE
==========================================================

EXPECTED CONTROLLER DATA:

    dairies
    session
    isAdmin
    success
    error

SESSION VALUES:

    morning = 00:00 - 10:00
    closed  = 10:00 - 16:00
    evening = 16:00 - 00:00

BUSINESS RULES:

    • One record per cow per session.
    • Normal users can submit only during an open session.
    • Once a cow has a record, normal users cannot edit it.
    • Admins can edit existing records.
    • Admins can edit morning records during the
      10:00 AM - 4:00 PM closed period.
    • No separate edit form is displayed here.
    • Admin editing is triggered by tapping the existing
      record and calling openEditModal(...).

Each dairy may have:

    dairy.morning
    dairy.evening

==========================================================
SAFE DEFAULTS
==========================================================
*/

const pageError =
    typeof error !== "undefined"
        ? error
        : "";

const pageSuccess =
    typeof success !== "undefined"
        ? Boolean(success)
        : false;

const currentSession =
    typeof session !== "undefined"
        ? session
        : "";

const adminUser =
    typeof isAdmin !== "undefined"
        ? Boolean(isAdmin)
        : (
            typeof user !== "undefined" &&
            user &&
            user.role === "admin"
        );

const milkDairies =
    typeof dairies !== "undefined" &&
    Array.isArray(dairies)
        ? dairies
        : "";

%>


<!-- ==========================================================
     MILK PAGE
========================================================== -->

<div class="milk-page">


    <!-- ======================================================
         HEADER
    ====================================================== -->

    <div class="milk-header">

        <div>

            <h2>
                🥛 Milk Collection
            </h2>

            <p>
                Record milk production for each dairy animal.
            </p>

        </div>

        <div class="milk-icon">
            🥛
        </div>

    </div>



    <!-- ======================================================
         ERROR
    ====================================================== -->

    <% if (pageError) { %>

        <div class="milk-error">
            ⚠️
            <%= pageError %>
        </div>

    <% } %>



    <!-- ======================================================
         SUCCESS
    ====================================================== -->

    <% if (pageSuccess) { %>

        <div class="milk-success">
            ✓
            Milk record saved successfully.
        </div>

    <% } %>



    <!-- ======================================================
         SESSION STATUS
    ====================================================== -->

    <% if (currentSession === "morning") { %>

        <div class="milk-status">

            🌅

            <strong>
                Morning collection is open.
            </strong>

            Submit one record per cow before
            <strong>10:00 AM</strong>.

        </div>


    <% } else if (currentSession === "closed") { %>

        <div class="milk-status warning">

            ⏰

            <strong>
                Collection is temporarily closed.
            </strong>

            Morning collection closed at
            <strong>10:00 AM</strong>.

            Evening collection opens at
            <strong>4:00 PM</strong>.

            <% if (adminUser) { %>

                <div class="admin-session-note">

                    Administrators can still edit
                    existing morning records.

                </div>

            <% } else { %>

                <div class="admin-session-note">

                    If a correction is required,
                    contact an administrator.

                </div>

            <% } %>

        </div>


    <% } else if (currentSession === "evening") { %>

        <div class="milk-status">

            🌆

            <strong>
                Evening collection is open.
            </strong>

            Submit one record per cow before
            <strong>midnight</strong>.

        </div>


    <% } else { %>

        <div class="milk-status warning">

            ⏰

            <strong>
                Collection window unavailable.
            </strong>

            Please contact an administrator
            if this continues.

        </div>

    <% } %>



    <!-- ======================================================
         ANIMALS
    ====================================================== -->

    <% if (milkDairies.length === 0) { %>

        <div class="empty-state">

            <div class="empty-icon">
                🐄
            </div>

            <h3>
                No Animals Currently Being Milked
            </h3>

            <p>
                There are no active dairy animals available.
            </p>

        </div>


    <% } else { %>


        <!-- ==================================================
             MILK FORM
        ================================================== -->

        <form
            action="/milk"
            method="POST"
            id="milkForm"
        >


            <!-- ==============================================
                 TABLE
            =============================================== -->

            <div class="milk-table-wrapper">

                <table class="milk-table">

                    <thead>

                        <tr>

                            <th>
                                Code
                            </th>

                            <th>
                                Name
                            </th>

                            <th>
                                Milk (L)
                            </th>

                            <th>
                                Remarks
                            </th>

                        </tr>

                    </thead>


                    <tbody>


                        <% milkDairies.forEach((dairy, index) => {

                            /*
                            ==================================================
                            DETERMINE THE RECORD TO DISPLAY
                            ==================================================

                            MORNING:
                                Only dairy.morning.

                            EVENING:
                                Only dairy.evening.

                            CLOSED:
                                Morning is the session that has just closed.

                            We deliberately do NOT use:

                                dairy.morning || dairy.evening

                            because that could expose a record belonging
                            to another session.
                            */

                            let record = null;

                            if (
                                currentSession === "morning"
                            ) {

                                record =
                                    dairy.morning || null;

                            } else if (
                                currentSession === "evening"
                            ) {

                                record =
                                    dairy.evening || null;

                            } else if (
                                currentSession === "closed"
                            ) {

                                record =
                                    dairy.morning || null;

                            }

                        %>


                            <tr>


                                <!-- ======================================
                                     CODE
                                ======================================= -->

                                <td>

                                    <span class="code-badge">
                                        #<%= dairy.code %>
                                    </span>

                                </td>



                                <!-- ======================================
                                     NAME
                                ======================================= -->

                                <td>

                                    <span class="animal-name">
                                        <%= dairy.name %>
                                    </span>

                                </td>



                                <!-- ======================================
                                     MILK
                                ======================================= -->

                                <td>

                                    <% if (record) { %>


                                        <!--
                                        EXISTING RECORD

                                        Normal users:
                                            readonly.

                                        Admin:
                                            tapping the field opens the
                                            existing edit modal.
                                        -->

                                        <div
                                            <% if (
                                                adminUser &&
                                                record._id
                                            ) { %>

                                                class="admin-edit-record"
                                                role="button"
                                                tabindex="0"
                                                title="Tap to edit record"
                                                onclick="openEditModal(
                                                    '<%= record._id %>',
                                                    '<%= Number(record.liters || 0) %>',
                                                    <%- JSON.stringify(record.remarks || "") %>
                                                )"

                                            <% } else { %>

                                                class="record-display"

                                            <% } %>
                                        >

                                            <input
                                                class="milk-input readonly-input"
                                                type="number"
                                                value="<%= Number(record.liters || 0) %>"
                                                readonly
                                            >

                                            <% if (
                                                adminUser &&
                                                record._id
                                            ) { %>

                                                <span class="edit-hint">
                                                    ✏️
                                                </span>

                                            <% } %>

                                        </div>


                                    <% } else if (
                                        currentSession === "morning" ||
                                        currentSession === "evening"
                                    ) { %>


                                        <!--
                                        NO RECORD FOR CURRENT SESSION

                                        This cow can be submitted.
                                        -->

                                        <input
                                            class="milk-input"
                                            type="number"
                                            step="0.1"
                                            min="0"
                                            name="records[<%= index %>][liters]"
                                            placeholder="0.0"
                                            required
                                        >

                                        <input
                                            type="hidden"
                                            name="records[<%= index %>][dairy]"
                                            value="<%= dairy._id %>"
                                        >


                                    <% } else { %>


                                        <!--
                                        CLOSED PERIOD

                                        No new record may be submitted.
                                        -->

                                        <input
                                            class="milk-input readonly-input"
                                            type="number"
                                            value="0"
                                            readonly
                                        >


                                    <% } %>

                                </td>



                                <!-- ======================================
                                     REMARKS
                                ======================================= -->

                                <td>


                                    <% if (record) { %>


                                        <!--
                                        EXISTING RECORD
                                        -->

                                        <div
                                            <% if (
                                                adminUser &&
                                                record._id
                                            ) { %>

                                                class="admin-edit-record remarks-edit"
                                                role="button"
                                                tabindex="0"
                                                title="Tap to edit record"
                                                onclick="openEditModal(
                                                    '<%= record._id %>',
                                                    '<%= Number(record.liters || 0) %>',
                                                    <%- JSON.stringify(record.remarks || "") %>
                                                )"

                                            <% } else { %>

                                                class="record-display"

                                            <% } %>
                                        >

                                            <textarea
                                                class="remarks-input readonly-input"
                                                readonly
                                            ><%= record.remarks || "" %></textarea>


                                            <% if (
                                                record.recordedByType === "system" ||
                                                record.recordedBySystem
                                            ) { %>

                                                <div class="recorded system-record">

                                                    <strong>
                                                        System
                                                    </strong>

                                                    Automatically recorded
                                                    as Not Milked.

                                                </div>


                                            <% } else { %>

                                                <div class="recorded">

                                                    <strong>
                                                        Recorded
                                                    </strong>

                                                    This cow has already been
                                                    recorded for this session.

                                                </div>

                                            <% } %>


                                            <% if (
                                                adminUser &&
                                                record._id
                                            ) { %>

                                                <div class="admin-edit-hint">

                                                    ✏️
                                                    Tap record to edit

                                                </div>

                                            <% } %>


                                        </div>


                                    <% } else if (
                                        currentSession === "morning" ||
                                        currentSession === "evening"
                                    ) { %>


                                        <!--
                                        NEW RECORD
                                        -->

                                        <textarea
                                            class="remarks-input"
                                            name="records[<%= index %>][remarks]"
                                            placeholder="Optional remarks..."
                                        ></textarea>


                                    <% } else { %>


                                        <!--
                                        CLOSED PERIOD
                                        -->

                                        <textarea
                                            class="remarks-input readonly-input"
                                            readonly
                                        >No new records can be submitted during this period.</textarea>


                                    <% } %>


                                </td>


                            </tr>


                        <% }); %>


                    </tbody>

                </table>

            </div>



            <!-- ==================================================
                 SUBMIT SECTION
            ================================================== -->

            <div class="submit-section">


                <div class="submit-hint">


                    <% if (currentSession === "morning") { %>

                        🌅

                        Morning collection is open until
                        <strong>10:00 AM</strong>.

                        Each cow can be recorded once.


                    <% } else if (currentSession === "closed") { %>

                        🔒

                        Morning collection has closed.

                        New submissions are unavailable
                        until <strong>4:00 PM</strong>.

                        <% if (adminUser) { %>

                            <div>
                                Administrators can still edit
                                existing morning records.
                            </div>

                        <% } else { %>

                            <div>
                                Contact an administrator if
                                a correction is required.
                            </div>

                        <% } %>


                    <% } else if (currentSession === "evening") { %>

                        🌆

                        Evening collection is open until
                        <strong>midnight</strong>.

                        Each cow can be recorded once.


                    <% } else { %>

                        🔒

                        The current collection window
                        is unavailable.


                    <% } %>


                </div>



                <!-- ==================================================
                     SUBMIT BUTTON
                ================================================== -->

                <button
                    type="submit"
                    class="submit-btn"

                    <% if (
                        currentSession !== "morning" &&
                        currentSession !== "evening"
                    ) { %>

                        disabled

                    <% } %>
                >

                    ✓

                    Submit Milk Records

                </button>


            </div>


        </form>


    <% } %>


</div>