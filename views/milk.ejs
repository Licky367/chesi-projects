<% /*

==========================================================
MILK COLLECTION PAGE

EXPECTED CONTROLLER DATA:

dairies
session
isAdmin
success
error

SESSION VALUES:

"morning"  = 00:00 - 10:00
"closed"   = 10:00 - 16:00
"evening"  = 16:00 - 00:00

EACH DAIRY MAY HAVE:

dairy.morning
dairy.evening

IMPORTANT:

The EJS only displays records.

The controller/service MUST enforce:

- one record per cow per session
- submission time restrictions
- admin-only editing
- closed-window restrictions

ADMIN EDITING:

- Admin can tap an existing record.
- Admin can edit morning records during the
  closed 10:00 AM - 4:00 PM window.
- Admin cannot create a second record.
- Normal users cannot edit existing records.

==========================================================
SAFE DEFAULTS

*/

const pageError =
typeof error !== "undefined"
? error
: "";

const pageSuccess =
typeof success !== "undefined"
? Boolean(success)
: false;

const currentSession =
typeof session !== "undefined"
? session
: "";

const adminUser =
typeof isAdmin !== "undefined"
? Boolean(isAdmin)
: (
typeof user !== "undefined" &&
user &&
user.role === "admin"
);

const milkDairies =
typeof dairies !== "undefined" &&
Array.isArray(dairies)
? dairies
: [];

%>

<!-- ==================================================
     HEADER
================================================== --><h2>
    🥛 Milk Collection
</h2><p>
    Record milk production for each dairy animal.
</p><div class="milk-icon">🥛

</div><!-- ==================================================
     ERROR
================================================== --><% if (pageError) { %>

<div class="milk-error">

    ⚠️ <%= pageError %>

</div>

<% } %>

<!-- ==================================================
     SUCCESS
================================================== --><% if (pageSuccess) { %>

<div class="milk-success">

    ✓ Milk record saved successfully.

</div>

<% } %>

<!-- ==================================================
     CURRENT TIME WINDOW
================================================== --><% if (currentSession === "morning") { %>

<div class="milk-status">

    🌅

    <strong>
        Morning collection is open.
    </strong>

    Submit one record per cow before
    10:00 AM.

</div>

<% } else if (currentSession === "closed") { %>

<div class="milk-status warning">

    ⏰

    <strong>
        Collection is temporarily closed.
    </strong>

    Morning collection closed at 10:00 AM.
    Evening collection opens at 4:00 PM.

    <% if (!adminUser) { %>

        If a correction is required,
        contact an administrator.

    <% } else { %>

        Administrators can still edit
        existing morning records.

    <% } %>

</div>

<% } else if (currentSession === "evening") { %>

<div class="milk-status">

    🌆

    <strong>
        Evening collection is open.
    </strong>

    Submit one record per cow before midnight.

</div>

<% } else { %>

<div class="milk-status warning">

    ⏰

    <strong>
        Collection window unavailable.
    </strong>

    Please contact an administrator
    if this continues.

</div>

<% } %>

<!-- ==================================================
     ANIMALS
================================================== --><% if (milkDairies.length === 0) { %>

<div class="empty-state">

    <div class="empty-icon">

        🐄

    </div>

    <h3>

        No Animals Currently Being Milked

    </h3>

    <p>

        There are no active dairy animals available.

    </p>

</div>

<% } else { %>

<!-- ==================================================
     MILK FORM
================================================== -->

<form
    action="/milk"
    method="POST"
    id="milkForm"
>

    <div class="milk-table-wrapper">

        <table class="milk-table">

            <thead>

                <tr>

                    <th>
                        Code
                    </th>

                    <th>
                        Name
                    </th>

                    <th>
                        Milk (L)
                    </th>

                    <th>
                        Remarks
                    </th>

                </tr>

            </thead>


            <tbody>

                <% milkDairies.forEach((dairy, index) => {

                    /*
                     * ==================================================
                     * DETERMINE THE RECORD TO DISPLAY
                     * ==================================================
                     *
                     * MORNING:
                     *     Only dairy.morning
                     *
                     * EVENING:
                     *     Only dairy.evening
                     *
                     * CLOSED:
                     *     Morning is the most recently closed session.
                     *
                     * We deliberately DO NOT use:
                     *
                     *     dairy.morning || dairy.evening
                     *
                     * because that could expose an unrelated
                     * session's record.
                     */

                    let record = null;

                    if (currentSession === "morning") {

                        record =
                            dairy.morning || null;

                    } else if (currentSession === "evening") {

                        record =
                            dairy.evening || null;

                    } else if (currentSession === "closed") {

                        record =
                            dairy.morning || null;

                    }

                %>


                    <tr>


                        <!-- ==================================================
                             CODE
                        ================================================== -->

                        <td>

                            <span class="code-badge">

                                #<%= dairy.code %>

                            </span>

                        </td>


                        <!-- ==================================================
                             NAME
                        ================================================== -->

                        <td>

                            <span class="animal-name">

                                <%= dairy.name %>

                            </span>

                        </td>


                        <!-- ==================================================
                             MILK
                        ================================================== -->

                        <td>


                            <% if (record) { %>

                                <!--
                                ==================================================
                                EXISTING RECORD

                                For administrators, tapping the existing
                                record opens the edit modal.

                                For normal users, it remains readonly.
                                ==================================================
                                -->

                                <div
                                    <% if (adminUser && record._id) { %>

                                        onclick="openEditModal(
                                            '<%= record._id %>',
                                            '<%= Number(record.liters || 0) %>',
                                            <%- JSON.stringify(record.remarks || "") %>
                                        )"

                                    <% } %>
                                >

                                    <input
                                        class="milk-input readonly-input"
                                        type="number"
                                        value="<%= Number(record.liters || 0) %>"
                                        readonly
                                    >

                                </div>


                            <% } else if (
                                currentSession === "morning" ||
                                currentSession === "evening"
                            ) { %>


                                <!--
                                ==================================================
                                NO RECORD FOR CURRENT SESSION

                                This cow can be submitted.
                                ==================================================
                                -->

                                <input
                                    class="milk-input"
                                    type="number"
                                    step="0.1"
                                    min="0"
                                    name="records[<%= index %>][liters]"
                                    placeholder="0.0"
                                    required
                                >

                                <input
                                    type="hidden"
                                    name="records[<%= index %>][dairy]"
                                    value="<%= dairy._id %>"
                                >


                            <% } else { %>


                                <!--
                                ==================================================
                                CLOSED PERIOD

                                No new records can be submitted.
                                ==================================================
                                -->

                                <input
                                    class="milk-input readonly-input"
                                    type="number"
                                    value="0"
                                    readonly
                                >

                            <% } %>


                        </td>


                        <!-- ==================================================
                             REMARKS
                        ================================================== -->

                        <td>


                            <% if (record) { %>

                                <!--
                                ==================================================
                                EXISTING RECORD
                                ==================================================
                                -->

                                <div
                                    <% if (adminUser && record._id) { %>

                                        onclick="openEditModal(
                                            '<%= record._id %>',
                                            '<%= Number(record.liters || 0) %>',
                                            <%- JSON.stringify(record.remarks || "") %>
                                        )"

                                    <% } %>
                                >

                                    <textarea
                                        class="remarks-input readonly-input"
                                        readonly
                                    ><%= record.remarks || "" %></textarea>


                                    <!-- ==================================================
                                         RECORD INFORMATION
                                    ================================================== -->

                                    <div class="recorded">

                                        <% if (
                                            record.recordedByType === "system" ||
                                            record.recordedBySystem
                                        ) { %>

                                            <strong class="system-record">

                                                System

                                            </strong>

                                            Automatically recorded as
                                            Not Milked.


                                        <% } else { %>

                                            <strong>

                                                Recorded

                                            </strong>

                                            This cow has already been
                                            recorded for this session.

                                        <% } %>

                                    </div>

                                </div>


                            <% } else if (
                                currentSession === "morning" ||
                                currentSession === "evening"
                            ) { %>


                                <!--
                                ==================================================
                                NEW RECORD
                                ==================================================
                                -->

                                <textarea
                                    class="remarks-input"
                                    name="records[<%= index %>][remarks]"
                                    placeholder="Optional remarks..."
                                ></textarea>


                            <% } else { %>


                                <!--
                                ==================================================
                                CLOSED
                                ==================================================
                                -->

                                <textarea
                                    class="remarks-input readonly-input"
                                    readonly
                                >No new records can be submitted during this period.</textarea>


                            <% } %>


                        </td>


                    </tr>


                <% }); %>

            </tbody>

        </table>

    </div>


    <!-- ==================================================
         SUBMIT SECTION
    ================================================== -->

    <div class="submit-section">


        <div class="submit-hint">


            <% if (currentSession === "morning") { %>

                🌅

                Morning collection is open until
                10:00 AM.

                Each cow can be recorded once.


            <% } else if (currentSession === "closed") { %>

                🔒

                Morning collection has closed.

                New submissions are unavailable
                until 4:00 PM.

                <% if (adminUser) { %>

                    Administrators can still edit
                    existing morning records.

                <% } else { %>

                    Contact an administrator if
                    a correction is required.

                <% } %>


            <% } else if (currentSession === "evening") { %>

                🌆

                Evening collection is open until
                midnight.

                Each cow can be recorded once.


            <% } else { %>

                🔒

                The current collection window
                is unavailable.

            <% } %>


        </div>


        <!-- ==================================================
             SUBMIT BUTTON
        ================================================== -->

        <button
            type="submit"
            class="submit-btn"

            <% if (
                currentSession !== "morning" &&
                currentSession !== "evening"
            ) { %>

                disabled

            <% } %>
        >

            ✓ Submit Milk Records

        </button>


    </div>


</form>

<% } %>

<!-- ==========================================================
     ADMIN EDIT MODAL
==========================================================

This is NOT a separate edit page.

It is only the hidden editor opened when an administrator
taps an existing record in the collection table.

========================================================== --><% if (adminUser) { %>

<div
    id="editMilkModal"
    style="display:none;"
>

    <h3>

        ✏️ Edit Milk Record

    </h3>


    <p>

        You are editing an existing milk record.
        Changes will be recorded under your
        administrator account.

    </p>


    <form
        id="editMilkForm"
        method="POST"
    >


        <label for="editLiters">

            Milk (Liters)

        </label>


        <input
            id="editLiters"
            class="milk-input"
            type="number"
            step="0.1"
            min="0"
            name="liters"
            required
        >


        <label for="editRemarks">

            Remarks

        </label>


        <textarea
            id="editRemarks"
            class="remarks-input"
            name="remarks"
        ></textarea>


        <div class="modal-actions">


            <button
                type="button"
                onclick="closeEditModal()"
            >

                Cancel

            </button>


            <button
                type="submit"
                class="modal-ok"
            >

                Save Changes

            </button>


        </div>


    </form>

</div>

<% } %>

<!-- ==========================================================
     ADMIN RECORD EDIT SCRIPT
========================================================== --><% if (adminUser) { %>

<script>

function openEditModal(
    recordId,
    liters,
    remarks
) {

    const modal =
        document.getElementById(
            "editMilkModal"
        );

    const form =
        document.getElementById(
            "editMilkForm"
        );

    const litersInput =
        document.getElementById(
            "editLiters"
        );

    const remarksInput =
        document.getElementById(
            "editRemarks"
        );


    if (
        !modal ||
        !form ||
        !litersInput ||
        !remarksInput
    ) {

        return;

    }


    /*
     * The admin is editing the EXISTING record.
     *
     * This does not submit through /milk.
     *
     * It targets the update route using the
     * record ID.
     */

    form.action =
        "/milk/" +
        encodeURIComponent(
            recordId
        );


    litersInput.value =
        liters ?? "";


    remarksInput.value =
        remarks ?? "";


    modal.style.display =
        "block";


    litersInput.focus();

}


function closeEditModal() {

    const modal =
        document.getElementById(
            "editMilkModal"
        );

    if (!modal) {

        return;

    }


    modal.style.display =
        "none";

}


</script><% } %>