<%
/* ==========================================================
   MILK COLLECTION PAGE
   FILE:
   views/milk.ejs

   PURPOSE:
   ----------------------------------------------------------
   Displays milk collection tables grouped by Dairy Farm.

   The page intentionally contains only:
       • Page title
       • Page subtitle
       • Dairy Farm tables
       • Milk entry/edit functionality

   Session logic remains internally so that permissions and
   collection windows continue to work, but explanatory
   session/admin sections are not displayed.
========================================================== */


/* ==========================================================
   SESSION
========================================================== */

const currentSession =
    typeof session !== "undefined"
        ? session
        : "";


/* ==========================================================
   USER
========================================================== */

const currentUser =
    typeof user !== "undefined" && user
        ? user
        : null;


const adminUser =
    currentUser &&
    currentUser.role === "admin";


const dairyWorker =
    currentUser &&
    currentUser.role === "dairyWorker";


/* ==========================================================
   CURRENT SWITCHED FARM
========================================================== */

const activeFarm =
    typeof currentDairy !== "undefined" &&
    currentDairy
        ? currentDairy
        : (
            typeof currentFarm !== "undefined" &&
            currentFarm
                ? currentFarm
                : null
        );


/* ==========================================================
   FARM TABLE DATA
========================================================== */

let milkTables = [];


/* ==========================================================
   PREFERRED DATA
========================================================== */

if (
    typeof milkDairyTables !== "undefined" &&
    Array.isArray(milkDairyTables)
) {

    milkTables =
        milkDairyTables;

}


/* ==========================================================
   FALLBACK FOR OLD DATA
========================================================== */

else if (
    typeof dairies !== "undefined" &&
    Array.isArray(dairies)
) {

    const grouped =
        new Map();


    dairies.forEach(function (animal) {

        if (!animal) {
            return;
        }


        /*
         * Only animals currently being milked.
         */

        if (
            animal.isMilking !== true
        ) {

            return;

        }


        const farm =
            animal.farm ||
            animal.dairyFarm ||
            animal.farmInfo ||
            null;


        const farmCode =
            farm &&
            farm.code !== undefined &&
            farm.code !== null

                ? String(farm.code)

                : (
                    animal.assetCode !== undefined &&
                    animal.assetCode !== null

                        ? String(animal.assetCode)

                        : "unassigned"
                );


        if (!grouped.has(farmCode)) {

            grouped.set(
                farmCode,
                {
                    farm: farm,
                    animals: []
                }
            );

        }


        grouped
            .get(farmCode)
            .animals
            .push(animal);

    });


    milkTables =
        Array.from(
            grouped.values()
        );

}


/* ==========================================================
   ENSURE VALID ARRAY
========================================================== */

milkTables =
    Array.isArray(milkTables)
        ? milkTables
        : [];


/* ==========================================================
   DAIRY WORKER FARM FILTER
==========================================================

   ADMIN:
       Can see all farms.

   DAIRY WORKER:
       Can see only the currently selected farm.
========================================================== */

if (dairyWorker) {

    milkTables =
        milkTables.filter(function (table) {

            if (
                !table ||
                !table.farm ||
                !activeFarm
            ) {

                return false;

            }


            const tableFarmId =
                table.farm._id
                    ? String(table.farm._id)
                    : null;


            const activeFarmId =
                activeFarm._id
                    ? String(activeFarm._id)
                    : null;


            if (
                tableFarmId &&
                activeFarmId &&
                tableFarmId === activeFarmId
            ) {

                return true;

            }


            const tableFarmCode =
                table.farm.code !== undefined &&
                table.farm.code !== null

                    ? String(table.farm.code)

                    : null;


            const activeFarmCode =
                activeFarm.code !== undefined &&
                activeFarm.code !== null

                    ? String(activeFarm.code)

                    : null;


            if (
                tableFarmCode &&
                activeFarmCode &&
                tableFarmCode === activeFarmCode
            ) {

                return true;

            }


            return false;

        });

}


/* ==========================================================
   REMOVE EMPTY FARM TABLES
========================================================== */

milkTables =
    milkTables.filter(function (table) {

        return (
            table &&
            Array.isArray(table.animals) &&
            table.animals.length > 0
        );

    });


/* ==========================================================
   SESSION PERMISSIONS
==========================================================

   These values are intentionally kept because they control
   whether the user can create or edit records.

   Nothing here is displayed as a separate information card.
========================================================== */

const adminMorningWindow =
    adminUser &&
    (
        currentSession === "morning" ||
        currentSession === "closed"
    );


const adminEveningWindow =
    adminUser &&
    currentSession === "evening";


const canSubmit =
    currentSession === "morning" ||
    currentSession === "evening" ||
    adminMorningWindow;


/* ==========================================================
   ACTIVE ENTRY SESSION
========================================================== */

const entrySession =
    currentSession === "evening"
        ? "evening"
        : "morning";

%>


<!-- ==========================================================
     MILK COLLECTION PAGE
========================================================== -->

<div class="milk-page">


    <!-- ======================================================
         PAGE HEADER
    ======================================================= -->

    <header class="milk-header">

        <h1>
            Milk Collection
        </h1>

        <p>
            Record today's milk production for each dairy animal.
        </p>

    </header>


    <!-- ======================================================
         NO ANIMALS
    ======================================================= -->

    <% if (milkTables.length === 0) { %>

        <div class="milk-empty-state">

            <div class="empty-animal-icon">
                🐄
            </div>

            <h2>
                No Animals Currently Being Milked
            </h2>

            <p>

                <% if (dairyWorker && !activeFarm) { %>

                    No Dairy Farm is currently selected
                    for milk collection.

                <% } else { %>

                    There are currently no active dairy animals
                    available for milk collection.

                <% } %>

            </p>

        </div>


    <% } else { %>


        <!-- ==================================================
             FARM TABLES
        =================================================== -->

        <%
        milkTables.forEach(function (table, tableIndex) {

            const farm =
                table.farm || null;


            const animals =
                Array.isArray(table.animals)
                    ? table.animals
                    : [];


            /*
             * IMPORTANT:
             * The table is labeled using the actual Dairy
             * Farm name.
             */

            const farmName =
                farm &&
                farm.name
                    ? farm.name
                    : "Dairy Farm";


        %>


        <!-- ==================================================
             COLLECTION CARD
        =================================================== -->

        <section
            class="collection-card farm-collection-card"
            data-farm-id="<%= farm && farm._id ? farm._id : '' %>"
        >


            <!-- ==============================================
                 FARM NAME
            =============================================== -->

            <div class="collection-card-header">

                <div class="collection-title">

                    🐄

                    <span>
                        <%= farmName %>
                    </span>

                </div>


                <% if (canSubmit) { %>

                    <div class="collection-status">

                        <span class="status-dot"></span>

                        Ready

                    </div>

                <% } else { %>

                    <div class="collection-status status-locked">

                        🔒 Locked

                    </div>

                <% } %>

            </div>


            <!-- ==================================================
                 FARM TABLE
            =================================================== -->

            <div class="milk-table-wrapper">

                <table class="milk-table">

                    <thead>

                        <tr>

                            <th class="col-animal">
                                Animal
                            </th>

                            <th class="col-code">
                                Code
                            </th>

                            <th class="col-milk">
                                Milk
                                <span>
                                    (Litres)
                                </span>
                            </th>

                            <th class="col-remarks">
                                Remarks
                            </th>

                            <th class="col-action">
                                Action
                            </th>

                        </tr>

                    </thead>


                    <tbody>


                    <%
                    animals.forEach(function (
                        dairy,
                        animalIndex
                    ) {

                        let record = null;


                        /* ======================================
                           CURRENT RECORD
                        ====================================== */

                        if (
                            entrySession === "morning"
                        ) {

                            record =
                                dairy.morning || null;

                        }

                        else {

                            record =
                                dairy.evening || null;

                        }


                        /* ======================================
                           RECORD PERMISSIONS
                        ====================================== */

                        const canCreateRecord =
                            !record &&
                            canSubmit;


                        const canEditRecord =
                            adminUser &&
                            record &&
                            record._id;


                        /* ======================================
                           FORM ID
                        ====================================== */

                        const formId =
                            "milkRecordForm_" +
                            String(dairy._id) +
                            "_" +
                            String(tableIndex) +
                            "_" +
                            String(animalIndex);

                    %>


                    <!-- ==================================================
                         ANIMAL ROW
                    =================================================== -->

                    <tr
                        class="<%= record
                            ? 'has-record'
                            : 'needs-record'
                        %>"
                    >


                        <!-- ==============================================
                             ANIMAL
                        =============================================== -->

                        <td>

                            <div class="animal-cell">

                                <div class="animal-avatar">
                                    🐄
                                </div>

                                <div class="animal-info">

                                    <span class="animal-name">
                                        <%= dairy.name %>
                                    </span>

                                    <span class="animal-label">
                                        Dairy animal
                                    </span>

                                </div>

                            </div>

                        </td>


                        <!-- ==============================================
                             CODE
                        =============================================== -->

                        <td>

                            <span class="code-badge">
                                #<%= dairy.code %>
                            </span>

                        </td>


                        <!-- ==============================================
                             MILK
                        =============================================== -->

                        <td>

                        <% if (record) { %>


                            <% if (canEditRecord) { %>

                                <button
                                    type="button"
                                    class="record-wrapper admin-edit-record js-edit-milk"
                                    data-record-id="<%= record._id %>"
                                    data-liters="<%= Number(record.liters || 0) %>"
                                    data-remarks="<%= String(record.remarks || '').replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;') %>"
                                    title="Tap to edit this record"
                                    aria-label="Edit milk record"
                                >

                                    <span class="milk-value-display">

                                        <span>
                                            <%= Number(
                                                record.liters || 0
                                            ).toFixed(1) %>
                                        </span>

                                        <small>
                                            L
                                        </small>

                                    </span>

                                    <span class="edit-icon">
                                        ✏️
                                    </span>

                                </button>


                            <% } else { %>

                                <div class="record-wrapper">

                                    <div class="milk-value-display">

                                        <span>
                                            <%= Number(
                                                record.liters || 0
                                            ).toFixed(1) %>
                                        </span>

                                        <small>
                                            L
                                        </small>

                                    </div>

                                </div>

                            <% } %>


                        <% } else if (canCreateRecord) { %>


                            <div class="milk-entry-wrapper">

                                <input
                                    class="milk-input"
                                    type="number"
                                    step="0.1"
                                    min="0"
                                    name="liters"
                                    form="<%= formId %>"
                                    placeholder="0.0"
                                    required
                                    inputmode="decimal"
                                >

                                <span class="input-unit">
                                    L
                                </span>

                            </div>


                        <% } else { %>


                            <div class="locked-input">

                                <span>
                                    —
                                </span>

                                <small>
                                    Locked
                                </small>

                            </div>


                        <% } %>

                        </td>


                        <!-- ==============================================
                             REMARKS
                        =============================================== -->

                        <td>

                        <% if (record) { %>

                            <%
                            const displayRemarks =
                                record.remarks &&
                                String(record.remarks).trim()
                                    ? record.remarks
                                    : "No remarks";
                            %>


                            <% if (canEditRecord) { %>

                                <button
                                    type="button"
                                    class="remarks-wrapper admin-edit-record js-edit-milk"
                                    data-record-id="<%= record._id %>"
                                    data-liters="<%= Number(record.liters || 0) %>"
                                    data-remarks="<%= String(record.remarks || '').replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;') %>"
                                    title="Tap to edit this record"
                                >

                                    <span class="remarks-text">
                                        <%= displayRemarks %>
                                    </span>


                                    <% if (
                                        record.recordedByType === "system" ||
                                        record.recordedBySystem
                                    ) { %>

                                        <span class="record-badge system-record">

                                            <span>
                                                ⚙️
                                            </span>

                                            Automatically recorded
                                            as Not Milked.

                                        </span>

                                    <% } else { %>

                                        <span class="record-badge">

                                            <span>
                                                ✓
                                            </span>

                                            Already recorded

                                        </span>

                                    <% } %>


                                    <span class="admin-edit-hint">
                                        ✏️ Tap to edit
                                    </span>

                                </button>


                            <% } else { %>

                                <div class="remarks-wrapper">

                                    <div class="remarks-text">
                                        <%= displayRemarks %>
                                    </div>


                                    <% if (
                                        record.recordedByType === "system" ||
                                        record.recordedBySystem
                                    ) { %>

                                        <div class="record-badge system-record">

                                            <span>
                                                ⚙️
                                            </span>

                                            Automatically recorded
                                            as Not Milked.

                                        </div>

                                    <% } else { %>

                                        <div class="record-badge">

                                            <span>
                                                ✓
                                            </span>

                                            Already recorded

                                        </div>

                                    <% } %>

                                </div>

                            <% } %>


                        <% } else if (canCreateRecord) { %>


                            <textarea
                                class="remarks-input"
                                name="remarks"
                                form="<%= formId %>"
                                placeholder="Optional remarks..."
                                rows="2"
                            ></textarea>


                        <% } else { %>


                            <div class="closed-remarks">

                                <span>
                                    🔒
                                </span>

                                <span>
                                    Locked
                                </span>

                            </div>


                        <% } %>

                        </td>


                        <!-- ==============================================
                             ACTION
                        =============================================== -->

                        <td class="action-cell">

                        <% if (record) { %>


                            <% if (canEditRecord) { %>

                                <button
                                    type="button"
                                    class="row-action-btn admin-action js-edit-milk"
                                    data-record-id="<%= record._id %>"
                                    data-liters="<%= Number(record.liters || 0) %>"
                                    data-remarks="<%= String(record.remarks || '').replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;') %>"
                                >

                                    ✏️

                                    <span>
                                        Edit
                                    </span>

                                </button>


                            <% } else { %>

                                <div class="read-only-label">

                                    <span>
                                        ✓
                                    </span>

                                    <span>
                                        Read-only
                                    </span>

                                </div>

                            <% } %>


                        <% } else if (canCreateRecord) { %>


                            <button
                                type="submit"
                                form="<%= formId %>"
                                class="row-action-btn save-action"
                            >

                                ✓

                                <span>
                                    Save
                                </span>

                            </button>


                        <% } else { %>


                            <div class="read-only-label locked-label">

                                <span>
                                    🔒
                                </span>

                                <span>
                                    Locked
                                </span>

                            </div>


                        <% } %>

                        </td>

                    </tr>


                    <!-- ==================================================
                         INDIVIDUAL FORM
                    =================================================== -->

                    <% if (canCreateRecord) { %>

                        <form
                            id="<%= formId %>"
                            action="/milk"
                            method="POST"
                            class="individual-milk-form"
                        >

                            <input
                                type="hidden"
                                name="dairy"
                                value="<%= dairy._id %>"
                            >

                            <input
                                type="hidden"
                                name="session"
                                value="<%= entrySession %>"
                            >

                        </form>

                    <% } %>


                    <%
                    });
                    %>


                    </tbody>

                </table>

            </div>

        </section>


        <%
        });
        %>


    <% } %>

</div>


<!-- ==========================================================
     ADMIN EDIT MODAL
========================================================== -->

<div
    id="milkEditModal"
    class="milk-edit-modal"
    aria-hidden="true"
>

    <div
        class="milk-edit-backdrop"
        data-close-edit-modal
    ></div>


    <div
        class="milk-edit-dialog"
        role="dialog"
        aria-modal="true"
        aria-labelledby="milkEditTitle"
    >

        <div class="edit-modal-header">

            <div>

                <div class="edit-modal-eyebrow">
                    ADMINISTRATOR
                </div>

                <h2 id="milkEditTitle">
                    Edit Milk Record
                </h2>

                <p>
                    Update the litres or remarks for this record.
                </p>

            </div>


            <button
                type="button"
                class="modal-close-btn"
                id="closeMilkEditButton"
                aria-label="Close"
            >
                ×
            </button>

        </div>


        <form
            id="milkEditForm"
            method="POST"
            action=""
        >

            <div class="edit-modal-body">

                <div class="edit-field">

                    <label for="editLiters">
                        Milk
                    </label>

                    <div class="edit-input-wrapper">

                        <input
                            id="editLiters"
                            name="liters"
                            type="number"
                            step="0.1"
                            min="0"
                            required
                            inputmode="decimal"
                        >

                        <span>
                            Litres
                        </span>

                    </div>

                </div>


                <div class="edit-field">

                    <label for="editRemarks">
                        Remarks
                    </label>

                    <textarea
                        id="editRemarks"
                        name="remarks"
                        rows="4"
                        placeholder="Optional remarks..."
                    ></textarea>

                </div>

            </div>


            <div class="edit-modal-footer">

                <button
                    type="button"
                    class="modal-cancel-btn"
                    id="cancelMilkEditButton"
                >
                    Cancel
                </button>

                <button
                    type="submit"
                    class="modal-save-btn"
                    id="saveMilkEditButton"
                >
                    ✓ Save Changes
                </button>

            </div>

        </form>

    </div>

</div>


<!-- ==========================================================
     PAGE STYLES
========================================================== -->

<style>

/* ==========================================================
   PAGE
========================================================== */

.milk-page {
    width: 100%;
    max-width: 1500px;
    margin: 0 auto;
    padding: 28px 24px 50px;
    box-sizing: border-box;
}


/* ==========================================================
   PAGE HEADER
========================================================== */

.milk-header {
    margin-bottom: 24px;
}

.milk-header h1 {
    margin: 0;
    color: #17231a;
    font-size: 29px;
    font-weight: 800;
    line-height: 1.15;
}

.milk-header p {
    margin: 7px 0 0;
    color: #718078;
    font-size: 14px;
}


/* ==========================================================
   EMPTY STATE
========================================================== */

.milk-empty-state {
    padding: 70px 25px;
    text-align: center;
    background: #ffffff;
    border: 1px solid #e7ebe8;
    border-radius: 20px;
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.04);
}

.empty-animal-icon {
    width: 74px;
    height: 74px;
    margin: 0 auto 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 22px;
    background: #eef8f1;
    font-size: 35px;
}

.milk-empty-state h2 {
    margin: 0 0 8px;
    color: #26322a;
    font-size: 19px;
}

.milk-empty-state p {
    max-width: 420px;
    margin: 0 auto;
    color: #7b8580;
    font-size: 13px;
    line-height: 1.6;
}


/* ==========================================================
   FARM COLLECTION CARD
========================================================== */

.farm-collection-card {
    margin-bottom: 18px;
}

.farm-collection-card:last-child {
    margin-bottom: 0;
}

.collection-card {
    overflow: hidden;
    background: #ffffff;
    border: 1px solid #e5eae6;
    border-radius: 19px;
    box-shadow: 0 8px 30px rgba(27, 55, 35, 0.055);
}


/* ==========================================================
   FARM HEADER
========================================================== */

.collection-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    padding: 18px 20px;
    border-bottom: 1px solid #edf0ed;
}

.collection-title {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #27332b;
    font-size: 17px;
    font-weight: 800;
}

.collection-status {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 8px 12px;
    border-radius: 999px;
    background: #eef9f1;
    color: #357a43;
    font-size: 12px;
    font-weight: 700;
    white-space: nowrap;
}

.collection-status.status-locked {
    background: #f3f4f3;
    color: #7c847f;
}

.status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #3e9952;
}


/* ==========================================================
   TABLE
========================================================== */

.milk-table-wrapper {
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
}

.milk-table {
    width: 100%;
    min-width: 820px;
    border-collapse: collapse;
    table-layout: fixed;
}

.milk-table th {
    padding: 15px 16px;
    background: #fafcfb;
    color: #707b74;
    border-bottom: 1px solid #e8ece9;
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: .7px;
    text-align: left;
}

.milk-table td {
    padding: 16px;
    border-bottom: 1px solid #eef1ef;
    vertical-align: middle;
}

.milk-table tbody tr:last-child td {
    border-bottom: none;
}

.milk-table tbody tr {
    transition: background .15s ease;
}

.milk-table tbody tr:hover {
    background: #fbfdfb;
}


/* ==========================================================
   COLUMN WIDTHS
========================================================== */

.col-animal {
    width: 25%;
}

.col-code {
    width: 12%;
}

.col-milk {
    width: 18%;
}

.col-remarks {
    width: 31%;
}

.col-action {
    width: 14%;
}


/* ==========================================================
   ANIMAL
========================================================== */

.animal-cell {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
}

.animal-avatar {
    width: 43px;
    height: 43px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    background: #eef8f1;
    font-size: 21px;
}

.animal-info {
    min-width: 0;
}

.animal-name {
    display: block;
    overflow: hidden;
    color: #26322a;
    font-size: 15px;
    font-weight: 750;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.animal-label {
    display: block;
    margin-top: 3px;
    color: #8f9993;
    font-size: 11px;
}


/* ==========================================================
   CODE
========================================================== */

.code-badge {
    display: inline-flex;
    align-items: center;
    padding: 7px 10px;
    border-radius: 8px;
    background: #f2f5f3;
    color: #52605a;
    font-family: monospace;
    font-size: 13px;
    font-weight: 700;
}


/* ==========================================================
   MILK INPUT
========================================================== */

.milk-entry-wrapper {
    position: relative;
    width: 125px;
}

.milk-input {
    width: 100%;
    box-sizing: border-box;
    padding: 12px 34px 12px 13px;
    border: 1px solid #dce4de;
    border-radius: 10px;
    outline: none;
    background: #ffffff;
    color: #243128;
    font-size: 15px;
    font-weight: 700;
}

.milk-input:focus {
