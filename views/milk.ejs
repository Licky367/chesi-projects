<!-- =========================================================
     MILK COLLECTION PAGE

     PURPOSE
     ---------------------------------------------------------
     Records today's milk production.

     Farms are displayed as separate tables.

     Each table contains only:
       • Animals belonging to that farm
       • Female animals
       • Animals currently marked isMilking = true

     Each animal has:
       • Morning liters
       • Morning remarks
       • Evening liters
       • Evening remarks

     Existing records:
       • Dairy worker = read-only
       • Admin       = editable
========================================================= -->


<link
    rel="stylesheet"
    href="/css/milk.css"
>


<div class="milk-page">


    <!-- =====================================================
         PAGE HEADER
    ====================================================== -->

    <div class="milk-header">

        <div>

            <h1>
                Record Today's Milk
            </h1>

            <p>
                <%= day %>
            </p>

        </div>


        <div class="milk-role-badge">

            <%= isAdmin ? "Administrator" : "Dairy Worker" %>

        </div>

    </div>



    <!-- =====================================================
         FLASH MESSAGE
    ====================================================== -->

    <% if (typeof success !== "undefined" && success) { %>

        <div class="milk-message milk-success">

            <%= success %>

        </div>

    <% } %>


    <% if (typeof error !== "undefined" && error) { %>

        <div class="milk-message milk-error">

            <%= error %>

        </div>

    <% } %>



    <!-- =====================================================
         NO FARMS
    ====================================================== -->

    <% if (!farms || farms.length === 0) { %>

        <div class="milk-empty">

            <h3>
                No Dairy Farms Available
            </h3>

            <p>
                There are currently no dairy farms available
                for milk collection.
            </p>

        </div>

    <% } %>



    <!-- =====================================================
         COLLECTION FORM
    ====================================================== -->

    <% if (farms && farms.length > 0) { %>


        <form
            action="/milk"
            method="POST"
            id="milkCollectionForm"
        >


            <!-- =================================================
                 FARM TABLES
            ================================================== -->

            <% farms.forEach(function(farm) { %>


                <section
                    class="milk-farm-section"
                    data-farm-id="<%= farm._id %>"
                >


                    <!-- =========================================
                         FARM TITLE
                    ========================================== -->

                    <div class="milk-farm-header">

                        <div>

                            <h2>
                                <%= farm.name %>
                            </h2>

                            <span>
                                Farm Code:
                                <%= farm.code %>
                            </span>

                        </div>


                        <div class="milk-farm-total">

                            <span>
                                Today's Farm Total
                            </span>

                            <strong
                                id="farmTotal_<%= farm._id %>"
                            >
                                <%= Number(farm.total || 0).toFixed(2) %>
                                L
                            </strong>

                        </div>

                    </div>



                    <!-- =========================================
                         NO MILKING ANIMALS
                    ========================================== -->

                    <% if (
                        !farm.animals ||
                        farm.animals.length === 0
                    ) { %>

                        <div class="milk-no-animals">

                            No milking animals are currently
                            registered for this farm.

                        </div>

                    <% } else { %>



                        <!-- =====================================
                             TABLE
                        ====================================== -->

                        <div class="milk-table-wrapper">


                            <table class="milk-table">


                                <thead>

                                    <tr>

                                        <th rowspan="2">
                                            Animal
                                        </th>

                                        <th colspan="2">
                                            Morning
                                        </th>

                                        <th colspan="2">
                                            Evening
                                        </th>

                                    </tr>


                                    <tr>

                                        <th>
                                            Liters
                                        </th>

                                        <th>
                                            Remarks
                                        </th>

                                        <th>
                                            Liters
                                        </th>

                                        <th>
                                            Remarks
                                        </th>

                                    </tr>

                                </thead>



                                <tbody>


                                    <% farm.animals.forEach(function(animal) { %>


                                        <%
                                            const morning =
                                                animal.morning || null;

                                            const evening =
                                                animal.evening || null;

                                            const morningLocked =
                                                !!morning;

                                            const eveningLocked =
                                                !!evening;
                                        %>


                                        <tr
                                            data-animal-id="<%= animal._id %>"
                                            data-farm-id="<%= farm._id %>"
                                        >


                                            <!-- =====================
                                                 ANIMAL
                                            ====================== -->

                                            <td class="milk-animal-cell">

                                                <strong>
                                                    <%= animal.name %>
                                                </strong>

                                                <small>
                                                    #<%= animal.code %>
                                                </small>

                                            </td>



                                            <!-- =====================
                                                 MORNING LITERS
                                            ====================== -->

                                            <td>

                                                <input
                                                    type="number"
                                                    name="records[<%= animal._id %>][morning][liters]"
                                                    class="milk-liters-input"
                                                    min="0"
                                                    step="0.01"
                                                    inputmode="decimal"
                                                    value="<%= morning ? morning.liters : '' %>"
                                                    data-session="morning"

                                                    <% if (
                                                        !isAdmin &&
                                                        morningLocked
                                                    ) { %>

                                                        readonly

                                                    <% } %>
                                                >

                                            </td>



                                            <!-- =====================
                                                 MORNING REMARKS
                                            ====================== -->

                                            <td>

                                                <input
                                                    type="text"
                                                    name="records[<%= animal._id %>][morning][remarks]"
                                                    class="milk-remarks-input"
                                                    value="<%= morning ? morning.remarks : '' %>"
                                                    maxlength="500"

                                                    <% if (
                                                        !isAdmin &&
                                                        morningLocked
                                                    ) { %>

                                                        readonly

                                                    <% } %>
                                                >

                                            </td>



                                            <!-- =====================
                                                 EVENING LITERS
                                            ====================== -->

                                            <td>

                                                <input
                                                    type="number"
                                                    name="records[<%= animal._id %>][evening][liters]"
                                                    class="milk-liters-input"
                                                    min="0"
                                                    step="0.01"
                                                    inputmode="decimal"
                                                    value="<%= evening ? evening.liters : '' %>"
                                                    data-session="evening"

                                                    <% if (
                                                        !isAdmin &&
                                                        eveningLocked
                                                    ) { %>

                                                        readonly

                                                    <% } %>
                                                >

                                            </td>



                                            <!-- =====================
                                                 EVENING REMARKS
                                            ====================== -->

                                            <td>

                                                <input
                                                    type="text"
                                                    name="records[<%= animal._id %>][evening][remarks]"
                                                    class="milk-remarks-input"
                                                    value="<%= evening ? evening.remarks : '' %>"
                                                    maxlength="500"

                                                    <% if (
                                                        !isAdmin &&
                                                        eveningLocked
                                                    ) { %>

                                                        readonly

                                                    <% } %>
                                                >

                                            </td>


                                        </tr>


                                    <% }); %>


                                </tbody>


                            </table>


                        </div>


                    <% } %>


                </section>


            <% }); %>



            <!-- =================================================
                 SUBMIT AREA
            ================================================== -->

            <div class="milk-submit-area">


                <% if (isAdmin) { %>

                    <p class="milk-admin-note">
                        Administrator mode:
                        existing records can be edited.
                    </p>

                <% } else { %>

                    <p class="milk-worker-note">
                        Submitted milk records are read-only
                        for dairy workers.
                    </p>

                <% } %>


                <button
                    type="submit"
                    class="milk-submit-button"
                >

                    <%= isAdmin
                        ? "Save Milk Records"
                        : "Submit Today's Milk"
                    %>

                </button>


            </div>


        </form>


    <% } %>


</div>



<script>

document.addEventListener(
    "DOMContentLoaded",
    function() {

        const form =
            document.getElementById(
                "milkCollectionForm"
            );


        if (!form) {

            return;

        }


        /*
         * -----------------------------------------------------
         * FORM SUBMISSION
         * -----------------------------------------------------
         */

        form.addEventListener(
            "submit",
            function() {

                const button =
                    form.querySelector(
                        ".milk-submit-button"
                    );


                if (button) {

                    button.disabled =
                        true;

                    button.textContent =
                        "Saving...";

                }

            }
        );


        /*
         * -----------------------------------------------------
         * FARM TOTAL PREVIEW
         * -----------------------------------------------------
         *
         * This is only a client-side preview.
         *
         * The authoritative total is calculated again by
         * milkCollectService.js.
         *
         */

        function updateFarmTotal(
            farmSection
        ) {

            let total =
                0;


            const inputs =
                farmSection.querySelectorAll(
                    ".milk-liters-input"
                );


            inputs.forEach(
                function(input) {

                    const value =
                        Number(
                            input.value
                        );


                    if (
                        Number.isFinite(value) &&
                        value >= 0
                    ) {

                        total += value;

                    }

                }
            );


            const totalElement =
                farmSection.querySelector(
                    ".milk-farm-total strong"
                );


            if (totalElement) {

                totalElement.textContent =
                    total.toFixed(2) + " L";

            }

        }


        /*
         * -----------------------------------------------------
         * LIVE TOTALS
         * -----------------------------------------------------
         */

        const farmSections =
            document.querySelectorAll(
                ".milk-farm-section"
            );


        farmSections.forEach(
            function(section) {

                const inputs =
                    section.querySelectorAll(
                        ".milk-liters-input"
                    );


                inputs.forEach(
                    function(input) {

                        input.addEventListener(
                            "input",
                            function() {

                                updateFarmTotal(
                                    section
                                );

                            }
                        );

                    }
                );


                updateFarmTotal(
                    section
                );

            }
        );

    }
);

</script>