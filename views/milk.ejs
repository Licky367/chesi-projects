<%
/* ==========================================================
   MILK COLLECTION PAGE
========================================================== */

const pageError =
    typeof error !== "undefined" && error
        ? error
        : "";

const pageSuccess =
    typeof success !== "undefined"
        ? Boolean(success)
        : false;


/* ==========================================================
   USER
========================================================== */

const currentUser =
    typeof user !== "undefined" && user
        ? user
        : null;

const adminUser =
    Boolean(
        currentUser &&
        currentUser.role === "admin"
    );

const dairyWorker =
    Boolean(
        currentUser &&
        currentUser.role === "dairyWorker"
    );


/* ==========================================================
   SESSION
========================================================== */

const currentSession =
    typeof session !== "undefined" &&
    session
        ? session
        : "closed";


/* ==========================================================
   FARM TABLES
========================================================== */

let milkTables = [];

if (
    typeof milkDairyTables !== "undefined" &&
    Array.isArray(milkDairyTables)
) {

    milkTables = milkDairyTables;

}


/* ==========================================================
   FALLBACK
========================================================== */

else if (
    typeof dairies !== "undefined" &&
    Array.isArray(dairies)
) {

    milkTables = dairies;

}


/* ==========================================================
   SAFE ARRAY
========================================================== */

if (!Array.isArray(milkTables)) {

    milkTables = [];

}


/* ==========================================================
   ACTIVE FARM
========================================================== */

const activeFarm =
    typeof currentDairy !== "undefined" &&
    currentDairy
        ? currentDairy
        : null;

const activeFarmName =
    activeFarm && activeFarm.name
        ? activeFarm.name
        : "Assigned Dairy Farms";


/* ==========================================================
   SESSION PERMISSIONS
========================================================== */

/*
 * Morning:
 * - admin: allowed
 * - dairyWorker: allowed
 *
 * Closed:
 * - admin: allowed to enter/edit morning
 * - dairyWorker: locked
 *
 * Evening:
 * - admin: allowed
 * - dairyWorker: allowed
 */

const morningOpen =
    currentSession === "morning";

const eveningOpen =
    currentSession === "evening";

const adminMorningAccess =
    adminUser &&
    (
        currentSession === "morning" ||
        currentSession === "closed"
    );

const canSubmit =
    morningOpen ||
    eveningOpen ||
    adminMorningAccess;


/* ==========================================================
   ENTRY SESSION
========================================================== */

const entrySession =
    eveningOpen
        ? "evening"
        : "morning";


/* ==========================================================
   SESSION DISPLAY
========================================================== */

let sessionTitle = "Collection Closed";
let sessionIcon = "🔒";
let sessionClass = "session-card-closed";
let sessionBadgeClass = "session-closed";
let sessionBadgeText = "Closed";


if (currentSession === "morning") {

    sessionTitle = "Morning collection";
    sessionIcon = "🌅";
    sessionClass = "session-card-open";
    sessionBadgeClass = "session-morning";
    sessionBadgeText = "Morning";

}


else if (currentSession === "evening") {

    sessionTitle = "Evening collection";
    sessionIcon = "🌆";
    sessionClass = "session-card-evening";
    sessionBadgeClass = "session-evening";
    sessionBadgeText = "Evening";

}


else if (currentSession === "closed") {

    if (adminUser) {

        sessionTitle = "Morning collection";
        sessionIcon = "✏️";
        sessionClass = "session-card-admin";
        sessionBadgeClass = "session-admin";
        sessionBadgeText = "Admin Access";

    }

}


/* ==========================================================
   TOTAL ANIMALS
========================================================== */

let totalAnimals = 0;

milkTables.forEach(function(table) {

    if (
        table &&
        Array.isArray(table.animals)
    ) {

        totalAnimals += table.animals.length;

    }

});

%>


<div class="milk-page">


    <!-- ======================================================
         HEADER
    ======================================================= -->

    <header class="milk-header">

        <div class="milk-header-content">

            <div class="milk-header-icon">
                🥛
            </div>

            <div class="milk-header-text">

                <div class="milk-eyebrow">

                    <% if (adminUser) { %>

                        All Dairy Farms

                    <% } else { %>

                        <%= activeFarmName %>

                    <% } %>

                </div>

                <h1>
                    Milk Collection
                </h1>

            </div>

        </div>


        <div class="milk-session-badge <%= sessionBadgeClass %>">

            <span class="session-dot"></span>

            <span>
                <%= sessionBadgeText %>
            </span>

        </div>

    </header>


    <!-- ======================================================
         SESSION CARD
    ======================================================= -->

    <div class="milk-session-card <%= sessionClass %>">

        <div class="session-card-icon">
            <%= sessionIcon %>
        </div>

        <div class="session-card-content">

            <div class="session-card-title">
                <%= sessionTitle %>
            </div>

        </div>


        <div class="session-time">

            <% if (currentSession === "morning") { %>

                <span>Closes</span>
                <strong>10:00 AM</strong>

            <% } else if (currentSession === "closed") { %>

                <% if (adminUser) { %>

                    <span>Admin access</span>
                    <strong>Morning</strong>

                <% } else { %>

                    <span>Evening</span>
                    <strong>4:00 PM</strong>

                <% } %>

            <% } else if (currentSession === "evening") { %>

                <span>Closes</span>
                <strong>Midnight</strong>

            <% } %>

        </div>

    </div>


    <!-- ======================================================
         NO MILKING ANIMALS
    ======================================================= -->

    <% if (milkTables.length === 0) { %>

        <div class="milk-empty-state">

            <div class="empty-animal-icon">
                🐄
            </div>

            <h2>
                No Animals Currently Being Milked
            </h2>

            <% if (adminUser) { %>

                <p>
                    There are currently no milking animals
                    available across the dairy farms.
                </p>

            <% } else { %>

                <p>
                    None of the dairy farms assigned to you
                    currently have animals marked as being milked.
                </p>

            <% } %>

        </div>


    <% } else { %>


        <!-- ==================================================
             FARM TABLES
        =================================================== -->

        <% milkTables.forEach(function(table, tableIndex) {

            const farm =
                table.farm || null;

            const animals =
                Array.isArray(table.animals)
                    ? table.animals
                    : [];

            const farmName =
                farm && farm.name
                    ? farm.name
                    : "Dairy Farm";

            const farmCode =
                farm &&
                farm.code !== undefined &&
                farm.code !== null
                    ? farm.code
                    : null;

            const farmId =
                farm && farm._id
                    ? String(farm._id)
                    : "";

        %>


        <section
            class="collection-card farm-collection-card"
            data-farm-id="<%= farmId %>"
        >


            <!-- ==============================================
                 FARM HEADER
            =============================================== -->

            <div class="collection-card-header">

                <div>

                    <div class="collection-title">

                        <span class="farm-title-icon">
                            🐄
                        </span>

                        <span>
                            <%= farmName %>
                        </span>

                    </div>

                    <div class="collection-subtitle">

                        <% if (farmCode !== null) { %>

                            Farm #<%= farmCode %>

                            <span class="subtitle-separator">
                                ·
                            </span>

                        <% } %>

                        <%= animals.length %>

                        <%= animals.length === 1
                            ? "animal"
                            : "animals"
                        %>

                    </div>

                </div>


                <div>

                    <% if (canSubmit) { %>

                        <div class="collection-status">

                            <span class="status-dot"></span>

                            <% if (
                                currentSession === "closed" &&
                                adminUser
                            ) { %>

                                Admin Entry

                            <% } else { %>

                                Ready

                            <% } %>

                        </div>

                    <% } else { %>

                        <div class="collection-status status-locked">
                            🔒 Locked
                        </div>

                    <% } %>

                </div>

            </div>


            <!-- ==============================================
                 TABLE
            =============================================== -->

            <div class="milk-table-wrapper">

                <table class="milk-table">

                    <thead>

                        <tr>

                            <th class="col-animal">
                                Animal
                            </th>

                            <th class="col-code">
                                Code
                            </th>

                            <th class="col-milk">
                                Milk
                                <span>(Litres)</span>
                            </th>

                            <th class="col-remarks">
                                Remarks
                            </th>

                            <th class="col-action">
                                Action
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                    <% animals.forEach(function(dairy, animalIndex) {

                        let record =
                            entrySession === "morning"
                                ? dairy.morning
                                : dairy.evening;

                        record =
                            record || null;


                        const animalId =
                            dairy && dairy._id
                                ? String(dairy._id)
                                : "";


                        const recordId =
                            record && record._id
                                ? String(record._id)
                                : "";


                        const formId =
                            "milkRecordForm_" +
                            animalId +
                            "_" +
                            tableIndex +
                            "_" +
                            animalIndex;


                        const canCreateRecord =
                            !record &&
                            canSubmit;


                        const canEditRecord =
                            adminUser &&
                            Boolean(recordId);


                        const remarks =
                            record &&
                            record.remarks
                                ? String(record.remarks)
                                : "";

                    %>


                    <tr
                        class="<%= record
                            ? 'has-record'
                            : 'needs-record'
                        %>"
                        data-animal-id="<%= animalId %>"
                        data-farm-id="<%= farmId %>"
                    >


                        <!-- ==================================
                             ANIMAL
                        =================================== -->

                        <td>

                            <div class="animal-cell">

                                <div class="animal-avatar">
                                    🐄
                                </div>

                                <div class="animal-info">

                                    <span class="animal-name">
                                        <%= dairy.name || "Unnamed Animal" %>
                                    </span>

                                    <span class="animal-label">
                                        Dairy animal
                                    </span>

                                </div>

                            </div>

                        </td>


                        <!-- ==================================
                             CODE
                        =================================== -->

                        <td>

                            <span class="code-badge">
                                #<%= dairy.code %>
                            </span>

                        </td>


                        <!-- ==================================
                             MILK
                        =================================== -->

                        <td>

                            <% if (record) { %>

                                <% if (canEditRecord) { %>

                                    <button
                                        type="button"
                                        class="record-wrapper admin-edit-record js-edit-milk"
                                        data-record-id="<%= recordId %>"
                                        data-liters="<%= Number(record.liters || 0) %>"
                                        data-remarks="<%= remarks.replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;') %>"
                                    >

                                        <span class="milk-value-display">

                                            <span>
                                                <%= Number(
                                                    record.liters || 0
                                                ).toFixed(1) %>
                                            </span>

                                            <small>
                                                L
                                            </small>

                                        </span>

                                        <span class="edit-icon">
                                            ✏️
                                        </span>

                                    </button>

                                <% } else { %>

                                    <div class="record-wrapper">

                                        <div class="milk-value-display">

                                            <span>
                                                <%= Number(
                                                    record.liters || 0
                                                ).toFixed(1) %>
                                            </span>

                                            <small>
                                                L
                                            </small>

                                        </div>

                                    </div>

                                <% } %>


                            <% } else if (canCreateRecord) { %>

                                <div class="milk-entry-wrapper">

                                    <input
                                        class="milk-input"
                                        type="number"
                                        step="0.1"
                                        min="0"
                                        name="liters"
                                        form="<%= formId %>"
                                        placeholder="0.0"
                                        required
                                        inputmode="decimal"
                                    >

                                    <span class="input-unit">
                                        L
                                    </span>

                                </div>


                            <% } else { %>

                                <div class="locked-input">

                                    <span>—</span>

                                    <small>
                                        Locked
                                    </small>

                                </div>

                            <% } %>

                        </td>


                        <!-- ==================================
                             REMARKS
                        =================================== -->

                        <td>

                            <% if (record) { %>

                                <%
                                const displayRemarks =
                                    record.remarks &&
                                    String(record.remarks).trim()
                                        ? record.remarks
                                        : "No remarks";
                                %>


                                <% if (canEditRecord) { %>

                                    <button
                                        type="button"
                                        class="remarks-wrapper admin-edit-record js-edit-milk"
                                        data-record-id="<%= recordId %>"
                                        data-liters="<%= Number(record.liters || 0) %>"
                                        data-remarks="<%= remarks.replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;') %>"
                                    >

                                        <span class="remarks-text">
                                            <%= displayRemarks %>
                                        </span>

                                        <span class="record-badge">
                                            ✓ Already recorded
                                        </span>

                                        <span class="admin-edit-hint">
                                            ✏️ Tap to edit
                                        </span>

                                    </button>


                                <% } else { %>

                                    <div class="remarks-wrapper">

                                        <div class="remarks-text">
                                            <%= displayRemarks %>
                                        </div>

                                        <div class="record-badge">
                                            ✓ Already recorded
                                        </div>

                                    </div>

                                <% } %>


                            <% } else if (canCreateRecord) { %>

                                <textarea
                                    class="remarks-input"
                                    name="remarks"
                                    form="<%= formId %>"
                                    placeholder="Optional remarks..."
                                    rows="2"
                                ></textarea>


                            <% } else { %>

                                <div class="closed-remarks">
                                    🔒
                                </div>

                            <% } %>

                        </td>


                        <!-- ==================================
                             ACTION
                        =================================== -->

                        <td class="action-cell">

                            <% if (record) { %>

                                <% if (canEditRecord) { %>

                                    <button
                                        type="button"
                                        class="row-action-btn admin-action js-edit-milk"
                                        data-record-id="<%= recordId %>"
                                        data-liters="<%= Number(record.liters || 0) %>"
                                        data-remarks="<%= remarks.replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;') %>"
                                    >
                                        ✏️
                                        <span>Edit</span>
                                    </button>

                                <% } else { %>

                                    <div class="read-only-label">

                                        <span>✓</span>

                                        <span>
                                            Read-only
                                        </span>

                                    </div>

                                <% } %>


                            <% } else if (canCreateRecord) { %>

                                <button
                                    type="submit"
                                    form="<%= formId %>"
                                    class="row-action-btn save-action"
                                >
                                    ✓
                                    <span>Save</span>
                                </button>


                            <% } else { %>

                                <div class="read-only-label locked-label">

                                    <span>🔒</span>

                                    <span>
                                        Locked
                                    </span>

                                </div>

                            <% } %>

                        </td>

                    </tr>


                    <!-- ==================================
                         FORM
                    =================================== -->

                    <% if (canCreateRecord) { %>

                        <form
                            id="<%= formId %>"
                            action="/milk"
                            method="POST"
                            class="individual-milk-form"
                        >

                            <input
                                type="hidden"
                                name="farm"
                                value="<%= farmId %>"
                            >

                            <input
                                type="hidden"
                                name="dairy"
                                value="<%= animalId %>"
                            >

                            <input
                                type="hidden"
                                name="session"
                                value="<%= entrySession %>"
                            >

                        </form>

                    <% } %>


                    <% }); %>

                    </tbody>

                </table>

            </div>

        </section>


        <% }); %>

    <% } %>

</div>


<!-- ==========================================================
     RESULT POPUP
========================================================== -->

<% if (pageSuccess || pageError) { %>

<div
    id="milkResultPopup"
    class="milk-result-popup"
    aria-hidden="false"
>

    <div class="milk-result-backdrop"></div>

    <div
        class="milk-result-dialog <%= pageSuccess
            ? 'result-success'
            : 'result-error'
        %>"
        role="alertdialog"
        aria-modal="true"
    >

        <div class="result-icon">
            <%= pageSuccess ? "✓" : "!" %>
        </div>

        <div class="result-content">

            <h2>
                <%= pageSuccess
                    ? "Milk record saved"
                    : "Unable to save record"
                %>
            </h2>

            <p>

                <% if (pageSuccess) { %>

                    Milk record saved successfully.

                <% } else { %>

                    <%= pageError %>

                <% } %>

            </p>

        </div>

        <button
            type="button"
            id="closeMilkResultPopup"
            class="result-ok-button"
        >
            OK
        </button>

    </div>

</div>

<% } %>


<!-- ==========================================================
     ADMIN EDIT MODAL
========================================================== -->

<div
    id="milkEditModal"
    class="milk-edit-modal"
    aria-hidden="true"
>

    <div
        class="milk-edit-backdrop"
        data-close-edit-modal
    ></div>


    <div
        class="milk-edit-dialog"
        role="dialog"
        aria-modal="true"
    >

        <div class="edit-modal-header">

            <div>

                <div class="edit-modal-eyebrow">
                    ADMINISTRATOR
                </div>

                <h2>
                    Edit Milk Record
                </h2>

            </div>


            <button
                type="button"
                class="modal-close-btn"
                id="closeMilkEditButton"
            >
                ×
            </button>

        </div>


        <form
            id="milkEditForm"
            method="POST"
            action=""
        >

            <div class="edit-modal-body">

                <div class="edit-field">

                    <label for="editLiters">
                        Milk
                    </label>

                    <div class="edit-input-wrapper">

                        <input
                            id="editLiters"
                            name="liters"
                            type="number"
                            step="0.1"
                            min="0"
                            required
                        >

                        <span>
                            Litres
                        </span>

                    </div>

                </div>


                <div class="edit-field">

                    <label for="editRemarks">
                        Remarks
                    </label>

                    <textarea
                        id="editRemarks"
                        name="remarks"
                        rows="4"
                        placeholder="Optional remarks..."
                    ></textarea>

                </div>

            </div>


            <div class="edit-modal-footer">

                <button
                    type="button"
                    class="modal-cancel-btn"
                    id="cancelMilkEditButton"
                >
                    Cancel
                </button>

                <button
                    type="submit"
                    class="modal-save-btn"
                    id="saveMilkEditButton"
                >
                    ✓ Save Changes
                </button>

            </div>

        </form>

    </div>

</div>


<script>

(function () {

    "use strict";


    /* ======================================================
       RESULT POPUP
    ====================================================== */

    const resultPopup =
        document.getElementById("milkResultPopup");

    const resultCloseButton =
        document.getElementById("closeMilkResultPopup");


    function closeResultPopup() {

        if (!resultPopup) {
            return;
        }

        resultPopup.style.display = "none";

        resultPopup.setAttribute(
            "aria-hidden",
            "true"
        );

    }


    if (resultCloseButton) {

        resultCloseButton.addEventListener(
            "click",
            closeResultPopup
        );

    }


    /* ======================================================
       EDIT MODAL
    ====================================================== */

    const modal =
        document.getElementById("milkEditModal");

    const form =
        document.getElementById("milkEditForm");

    const litersInput =
        document.getElementById("editLiters");

    const remarksInput =
        document.getElementById("editRemarks");

    const closeButton =
        document.getElementById("closeMilkEditButton");

    const cancelButton =
        document.getElementById("cancelMilkEditButton");

    const backdrop =
        document.querySelector(
            "[data-close-edit-modal]"
        );

    const saveButton =
        document.getElementById("saveMilkEditButton");


    if (
        !modal ||
        !form ||
        !litersInput ||
        !remarksInput
    ) {
        return;
    }


    function openEditModal(
        recordId,
        liters,
        remarks
    ) {

        if (!recordId) {
            return;
        }


        form.action =
            "/milk/" +
            encodeURIComponent(recordId);


        litersInput.value =
            Number(liters || 0);

        remarksInput.value =
            remarks || "";


        modal.classList.add("open");

        modal.setAttribute(
            "aria-hidden",
            "false"
        );

        document.body.classList.add(
            "milk-modal-open"
        );


        setTimeout(function () {

            litersInput.focus();
            litersInput.select();

        }, 50);

    }


    function closeEditModal() {

        modal.classList.remove("open");

        modal.setAttribute(
            "aria-hidden",
            "true"
        );

        document.body.classList.remove(
            "milk-modal-open"
        );

        form.action = "";

        if (saveButton) {

            saveButton.disabled = false;

            saveButton.textContent =
                "✓ Save Changes";

        }

    }


    document
        .querySelectorAll(".js-edit-milk")
        .forEach(function(button) {

            button.addEventListener(
                "click",
                function() {

                    openEditModal(
                        button.dataset.recordId,
                        button.dataset.liters,
                        button.dataset.remarks || ""
                    );

                }
            );

        });


    if (closeButton) {

        closeButton.addEventListener(
            "click",
            closeEditModal
        );

    }


    if (cancelButton) {

        cancelButton.addEventListener(
            "click",
            closeEditModal
        );

    }


    if (backdrop) {

        backdrop.addEventListener(
            "click",
            closeEditModal
        );

    }


    document.addEventListener(
        "keydown",
        function(event) {

            if (
                event.key === "Escape" &&
                modal.classList.contains("open")
            ) {

                closeEditModal();

            }

        }
    );


    form.addEventListener(
        "submit",
        function() {

            if (saveButton) {

                saveButton.disabled = true;

                saveButton.textContent =
                    "Saving...";

            }

        }
    );


    document.addEventListener(
        "submit",
        function(event) {

            const submittedForm =
                event.target;


            if (
                !submittedForm ||
                !submittedForm.classList ||
                !submittedForm.classList.contains(
                    "individual-milk-form"
                )
            ) {

                return;

            }


            const formId =
                submittedForm.id;


            document
                .querySelectorAll(
                    'button[type="submit"][form="' +
                    formId +
                    '"]'
                )
                .forEach(function(button) {

                    button.disabled = true;

                    const span =
                        button.querySelector("span");

                    if (span) {

                        span.textContent =
                            "Saving...";

                    } else {

                        button.textContent =
                            "Saving...";

                    }

                });

        }
    );


})();

</script>