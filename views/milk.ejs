    const remarksInput =
        document.getElementById("editRemarks");

    const closeButton =
        document.getElementById("closeMilkEditButton");

    const cancelButton =
        document.getElementById("cancelMilkEditButton");

    const backdrop =
        document.querySelector("[data-close-edit-modal]");

    const saveButton =
        document.getElementById("saveMilkEditButton");


    if (
        !modal ||
        !form ||
        !litersInput ||
        !remarksInput
    ) {
        return;
    }


    /* ======================================================
       OPEN EDIT MODAL
    ====================================================== */

    function openEditModal(recordId, liters, remarks) {

        if (!recordId) {

            console.error(
                "Cannot edit milk record: record ID missing."
            );

            return;
        }


        /*
         * This exactly matches the controller:
         *
         * exports.updateMilkRecord = async (req, res) => {
         *
         *     const { id } = req.params;
         *
         *     await milkService.editMilkRecord({
         *         recordId: id,
         *         ...
         *     });
         *
         * }
         */

        form.action =
            "/milk/" +
            encodeURIComponent(recordId);


        litersInput.value =
            Number(liters || 0);


        remarksInput.value =
            remarks || "";


        modal.classList.add("open");

        modal.setAttribute(
            "aria-hidden",
            "false"
        );


        document.body.classList.add(
            "milk-modal-open"
        );


        setTimeout(function () {

            litersInput.focus();

            litersInput.select();

        }, 50);
    }


    /* ======================================================
       CLOSE EDIT MODAL
    ====================================================== */

    function closeEditModal() {

        modal.classList.remove("open");

        modal.setAttribute(
            "aria-hidden",
            "true"
        );


        document.body.classList.remove(
            "milk-modal-open"
        );


        form.action = "";

        litersInput.value = "";

        remarksInput.value = "";


        if (saveButton) {

            saveButton.disabled = false;

            saveButton.textContent =
                "✓ Save Changes";
        }
    }


    /* ======================================================
       EDIT BUTTONS
    ====================================================== */

    const editButtons =
        document.querySelectorAll(
            ".js-edit-milk"
        );


    editButtons.forEach(function (button) {

        button.addEventListener(
            "click",
            function () {

                const recordId =
                    button.dataset.recordId;


                const liters =
                    button.dataset.liters;


                const remarks =
                    button.dataset.remarks || "";


                openEditModal(
                    recordId,
                    liters,
                    remarks
                );

            }
        );


        /*
         * Keyboard accessibility.
         */

        button.addEventListener(
            "keydown",
            function (event) {

                if (
                    event.key === "Enter" ||
                    event.key === " "
                ) {

                    event.preventDefault();

                    button.click();
                }

            }
        );

    });


    /* ======================================================
       CLOSE BUTTONS
    ====================================================== */

    if (closeButton) {

        closeButton.addEventListener(
            "click",
            closeEditModal
        );

    }


    if (cancelButton) {

        cancelButton.addEventListener(
            "click",
            closeEditModal
        );

    }


    if (backdrop) {

        backdrop.addEventListener(
            "click",
            closeEditModal
        );

    }


    /* ======================================================
       ESC KEY
    ====================================================== */

    document.addEventListener(
        "keydown",
        function (event) {

            if (
                event.key === "Escape" &&
                modal.classList.contains("open")
            ) {

                closeEditModal();

            }

        }
    );


    /* ======================================================
       PREVENT MODAL DOUBLE SUBMISSION
    ====================================================== */

    form.addEventListener(
        "submit",
        function (event) {

            /*
             * Do not prevent the submission.
             *
             * We only disable the button so that the
             * administrator cannot submit twice.
             */

            if (saveButton) {

                saveButton.disabled = true;

                saveButton.textContent =
                    "Saving...";

            }

        }
    );


    /* ======================================================
       PREVENT DOUBLE SUBMISSION FOR NEW RECORDS
    ====================================================== */

    document.addEventListener(
        "submit",
        function (event) {

            const submittedForm =
                event.target;


            if (
                !submittedForm ||
                !submittedForm.classList ||
                !submittedForm.classList.contains(
                    "individual-milk-form"
                )
            ) {
                return;
            }


            const formId =
                submittedForm.id;


            const buttons =
                document.querySelectorAll(
                    'button[type="submit"][form="' +
                    formId +
                    '"]'
                );


            buttons.forEach(function (button) {

                button.disabled = true;

                button.classList.add(
                    "is-submitting"
                );


                const span =
                    button.querySelector("span");


                if (span) {

                    span.textContent =
                        "Saving...";

                } else {

                    button.textContent =
                        "Saving...";

                }

            });

        }
    );


})();

</script>