<style>

/* =====================================================
   PAGE
===================================================== */

.milk-stats-page {

  width: 100%;

  max-width: 1100px;

  margin: 0 auto;

  padding: 20px 0 40px;

}


/* =====================================================
   HEADER
===================================================== */

.page-header {

  margin-bottom: 20px;

}


.page-header h2 {

  margin: 0 0 6px;

  color: #166534;

  font-size: 26px;

}


.page-header p {

  margin: 0;

  color: #6b7280;

  font-size: 14px;

}


/* =====================================================
   CARD
===================================================== */

.stats-card {

  margin-bottom: 20px;

  padding: 22px;

  border-radius: 15px;

  background: #ffffff;

  box-shadow: 0 6px 20px rgba(0,0,0,0.06);

}


/* =====================================================
   FILTER
===================================================== */

.stats-filter {

  display: flex;

  align-items: flex-end;

  gap: 12px;

  flex-wrap: wrap;

}


.filter-group {

  flex: 1;

  min-width: 180px;

}


.filter-group label {

  display: block;

  margin-bottom: 7px;

  color: #374151;

  font-size: 13px;

  font-weight: 700;

}


.filter-group input,
.filter-group select {

  width: 100%;

  padding: 11px 12px;

  border-radius: 9px;

  border: 1px solid #d1d5db;

  background: #f9fafb;

  font-family: inherit;

  outline: none;

}


.filter-group input:focus,
.filter-group select:focus {

  border-color: #16a34a;

  box-shadow: 0 0 0 3px rgba(22,163,74,0.1);

}


.filter-button {

  padding: 11px 20px;

  border: none;

  border-radius: 9px;

  background: #166534;

  color: white;

  font-weight: 700;

  cursor: pointer;

}


.filter-button:hover {

  background: #14532d;

}


/* =====================================================
   REPORT HEADER
===================================================== */

.report-header {

  display: flex;

  justify-content: space-between;

  align-items: center;

  gap: 15px;

  margin-bottom: 18px;

}


.report-header h3 {

  margin: 0;

  color: #374151;

  font-size: 20px;

}


.report-date {

  color: #6b7280;

  font-size: 13px;

}


/* =====================================================
   TABLE
===================================================== */

.table-wrapper {

  overflow-x: auto;

}


table {

  width: 100%;

  border-collapse: collapse;

}


th,
td {

  padding: 13px 15px;

  border-bottom: 1px solid #e5e7eb;

  text-align: left;

}


th {

  background: #f9fafb;

  color: #6b7280;

  font-size: 12px;

  text-transform: uppercase;

}


td {

  color: #4b5563;

  font-size: 14px;

}


tbody tr:hover {

  background: #f9fafb;

}


.animal-code {

  font-weight: 700;

  color: #166534;

}


.liters-value {

  font-weight: 700;

  color: #166534;

}


/* =====================================================
   MILK SESSION CELLS
===================================================== */

.milk-session-cell {

  min-width: 145px;

}


.milk-session-form {

  margin: 0;

}


.session-label {

  display: block;

  margin-bottom: 5px;

  color: #6b7280;

  font-size: 10px;

  font-weight: 700;

  text-transform: uppercase;

}


.milk-input {

  width: 100%;

  min-width: 105px;

  box-sizing: border-box;

  padding: 9px 10px;

  border-radius: 8px;

  border: 1px solid #d1d5db;

  background: #f9fafb;

  color: #374151;

  font-family: inherit;

  font-size: 14px;

  font-weight: 600;

  outline: none;

  transition: all 0.15s ease;

}


.milk-input::placeholder {

  color: #9ca3af;

  font-weight: 400;

}


.milk-input:focus {

  border-color: #16a34a;

  background: #ffffff;

  box-shadow: 0 0 0 3px rgba(22,163,74,0.10);

}


.milk-input.session-open {

  background: #ffffff;

  border-color: #16a34a;

  cursor: text;

}


.milk-input.session-open:hover {

  border-color: #15803d;

}


.milk-input.session-closed {

  background: #f3f4f6;

  border-color: #e5e7eb;

  color: #6b7280;

  cursor: default;

}


.milk-input.admin-editable {

  background: #ffffff;

  border-color: #d1d5db;

  cursor: pointer;

}


.milk-input.admin-editable:hover {

  border-color: #16a34a;

}


/* =====================================================
   SESSION STATUS
===================================================== */

.session-status {

  display: block;

  margin-top: 4px;

  font-size: 10px;

  color: #9ca3af;

}


.session-status.open {

  color: #166534;

}


.session-status.closed {

  color: #6b7280;

}


/* =====================================================
   SAVE BUTTON
===================================================== */

.session-save-button {

  margin-top: 5px;

  width: 100%;

  padding: 6px 8px;

  border: none;

  border-radius: 6px;

  background: #166534;

  color: #ffffff;

  font-size: 11px;

  font-weight: 700;

  cursor: pointer;

}


.session-save-button:hover {

  background: #14532d;

}


/* =====================================================
   ADMIN EDIT NOTE
===================================================== */

.admin-edit-note {

  display: block;

  margin-top: 4px;

  color: #9ca3af;

  font-size: 9px;

}


/* =====================================================
   TOTAL
===================================================== */

.total-cell {

  min-width: 100px;

}


.daily-total {

  font-size: 15px;

  font-weight: 800;

  color: #166534;

}


/* =====================================================
   SUMMARY
===================================================== */

.summary-grid {

  display: grid;

  grid-template-columns:
    repeat(auto-fit,minmax(170px,1fr));

  gap: 15px;

  margin-top: 22px;

}


.summary-box {

  padding: 17px;

  border-radius: 12px;

  background: #f9fafb;

}


.summary-box span {

  display: block;

  margin-bottom: 7px;

  color: #6b7280;

  font-size: 12px;

}


.summary-box strong {

  color: #166534;

  font-size: 20px;

}


/* =====================================================
   STATUS
===================================================== */

.status-open {

  color: #166534 !important;

}


.status-locked {

  color: #b91c1c !important;

}


/* =====================================================
   SALES
===================================================== */

.sales-section {

  margin-top: 30px;

}


.sales-section h3 {

  margin-bottom: 15px;

  color: #374151;

}


.revenue-total {

  margin-top: 18px;

  padding: 17px;

  border-radius: 12px;

  background: #f0fdf4;

}


.revenue-total span {

  display: block;

  margin-bottom: 5px;

  color: #6b7280;

}


.revenue-total strong {

  color: #166534;

  font-size: 22px;

}


/* =====================================================
   EMPTY STATE
===================================================== */

.empty-state {

  padding: 45px 20px;

  text-align: center;

}


.empty-icon {

  font-size: 42px;

  margin-bottom: 10px;

}


.empty-state h3 {

  margin-bottom: 8px;

  color: #374151;

}


.empty-state p {

  color: #9ca3af;

  font-size: 14px;

}


/* =====================================================
   POPUP
===================================================== */

.milk-message-popup {

  position: fixed;

  top: 20px;

  left: 50%;

  z-index: 9999;

  width: calc(100% - 30px);

  max-width: 420px;

  padding: 18px 20px;

  border-radius: 12px;

  background: #ffffff;

  box-shadow: 0 10px 35px rgba(0,0,0,0.18);

  transform: translate(-50%, -150%);

  opacity: 0;

  pointer-events: none;

  transition:
    transform 0.25s ease,
    opacity 0.25s ease;

}


.milk-message-popup.show {

  transform: translate(-50%, 0);

  opacity: 1;

  pointer-events: auto;

}


.milk-message-popup.success {

  border-left: 5px solid #16a34a;

}


.milk-message-popup.error {

  border-left: 5px solid #dc2626;

}


.milk-message-content {

  display: flex;

  align-items: flex-start;

  gap: 12px;

}


.milk-message-icon {

  font-size: 23px;

  line-height: 1;

}


.milk-message-text {

  flex: 1;

}


.milk-message-text strong {

  display: block;

  margin-bottom: 4px;

  color: #374151;

  font-size: 15px;

}


.milk-message-text span {

  color: #6b7280;

  font-size: 13px;

  line-height: 1.4;

}


.milk-message-close {

  border: none;

  background: transparent;

  color: #9ca3af;

  font-size: 20px;

  line-height: 1;

  cursor: pointer;

}


.milk-message-close:hover {

  color: #374151;

}


/* =====================================================
   MOBILE
===================================================== */

@media(max-width:650px){

  .milk-stats-page {

    padding: 10px 0 30px;

  }


  .stats-card {

    padding: 16px;

  }


  .stats-filter {

    flex-direction: column;

    align-items: stretch;

  }


  .filter-button {

    width: 100%;

  }


  .report-header {

    flex-direction: column;

    align-items: flex-start;

  }


  th,
  td {

    white-space: nowrap;

    padding: 10px;

  }


  .milk-input {

    min-width: 95px;

  }

}

</style>


<!-- =====================================================
     POPUP MESSAGE
===================================================== -->

<div
  id="milkMessagePopup"
  class="milk-message-popup"
>

  <div class="milk-message-content">

    <div
      id="milkMessageIcon"
      class="milk-message-icon"
    >
      ✅
    </div>


    <div class="milk-message-text">

      <strong id="milkMessageTitle">
        Success
      </strong>

      <span id="milkMessageText">
        Milk record submitted successfully.
      </span>

    </div>


    <button
      type="button"
      class="milk-message-close"
      onclick="closeMilkMessage()"
      aria-label="Close"
    >
      ×
    </button>

  </div>

</div>


<div class="milk-stats-page">


<!-- =====================================================
     HEADER
===================================================== -->

<div class="page-header">

  <h2>
    🥛 Milk Statistics
  </h2>


  <p>
    Review milk production, consumption, sales and revenue.
  </p>

</div>


<!-- =====================================================
     FILTER
===================================================== -->

<div class="stats-card">


<form
  method="GET"
  action="/stats"
  class="stats-filter"
>


<div class="filter-group">

<label>
Report Type
</label>


<select name="type">


<option
  value="day"
  <%= typeof type !== "undefined" && type === "day"
    ? "selected"
    : "" %>
>
  Daily
</option>


<option
  value="month"
  <%= typeof type !== "undefined" && type === "month"
    ? "selected"
    : "" %>
>
  Monthly
</option>


</select>

</div>


<div class="filter-group">

<label>
Select Date
</label>


<input
  type="date"
  name="date"
  value="<%= typeof date !== "undefined" ? (date || '') : '' %>"
>


</div>


<div class="filter-group">

<label>
Select Month
</label>


<input
  type="month"
  name="month"
  value="<%= typeof month !== "undefined" ? (month || '') : '' %>"
>


</div>


<button
  type="submit"
  class="filter-button"
>
🔍 View Report
</button>


</form>


</div>


<!-- =====================================================
     DAILY REPORT
===================================================== -->

<% if (typeof type !== "undefined" && type === "day") { %>


<div class="stats-card">


<div class="report-header">

<h3>
Daily Milk Production
</h3>


<span class="report-date">

<%= date || "Today" %>

</span>


</div>


<div class="table-wrapper">


<table>


<thead>

<tr>

<th>
Code
</th>


<th>
Animal
</th>


<th>
Morning
</th>


<th>
Evening
</th>


<th>
Total
</th>

</tr>

</thead>


<tbody>


<%
records
  .filter((record, index) =>
    records.findIndex(item =>
      String(item.dairy?._id) ===
      String(record.dairy?._id)
    ) === index
  )
  .forEach(record => {
%>


<tr>


<!-- =====================================================
     CODE
===================================================== -->

<td>

<span class="animal-code">

<%= record.dairy
  ? record.dairy.code
  : "Unknown" %>

</span>

</td>


<!-- =====================================================
     ANIMAL
===================================================== -->

<td>

<%= record.dairy
  ? record.dairy.name
  : "Unknown Animal" %>

</td>


<!-- =====================================================
     MORNING
===================================================== -->

<td class="milk-session-cell">


<form
  method="POST"
  action="/milk"
  class="milk-session-form"
>


<input
  type="hidden"
  name="dairyId"
  value="<%= record.dairy?._id || '' %>"
>


<input
  type="hidden"
  name="date"
  value="<%= date || '' %>"
>


<input
  type="hidden"
  name="session"
  value="morning"
>


<label class="session-label">
Morning
</label>


<input
  type="number"
  name="liters"
  min="0"
  step="0.01"

  value="<%= (
    records.find(item =>
      String(item.dairy?._id) ===
      String(record.dairy?._id) &&
      (
        String(item.session || '').toLowerCase() === 'morning' ||
        String(item.session || '').toLowerCase() === 'am'
      )
    )?.liters ?? ''
  ) %>"

  placeholder="0.00 L"

  class="milk-input
    <%= (
      typeof user !== 'undefined' &&
      user?.role === 'admin'
    )
      ? 'admin-editable'
      : (
          typeof session !== 'undefined' &&
          String(session).toLowerCase() === 'morning'
        )
          ? 'session-open'
          : 'session-closed'
    %>"

  <%= (
    typeof user !== 'undefined' &&
    user?.role === 'admin'
  )
    ? ''
    : (
        typeof session !== 'undefined' &&
        String(session).toLowerCase() === 'morning'
      )
        ? ''
        : 'readonly'
  %>
>


<%
if (
  typeof user !== 'undefined' &&
  user?.role === 'admin'
) {
%>


<button
  type="submit"
  class="session-save-button"
>
Save
</button>


<%
} else if (
  typeof session !== 'undefined' &&
  String(session).toLowerCase() === 'morning'
) {
%>


<button
  type="submit"
  class="session-save-button"
>
Save
</button>


<span class="session-status open">
🟢 Open
</span>


<%
} else {
%>


<span class="session-status closed">
🔒 Closed
</span>


<%
}
%>


<%
if (
  typeof user !== 'undefined' &&
  user?.role === 'admin' &&
  typeof session !== 'undefined' &&
  String(session).toLowerCase() !== 'morning'
) {
%>


<span class="admin-edit-note">
Admin edit
</span>


<%
}
%>


</form>


</td>


<!-- =====================================================
     EVENING
===================================================== -->

<td class="milk-session-cell">


<form
  method="POST"
  action="/milk"
  class="milk-session-form"
>


<input
  type="hidden"
  name="dairyId"
  value="<%= record.dairy?._id || '' %>"
>


<input
  type="hidden"
  name="date"
  value="<%= date || '' %>"
>


<input
  type="hidden"
  name="session"
  value="evening"
>


<label class="session-label">
Evening
</label>


<input
  type="number"
  name="liters"
  min="0"
  step="0.01"

  value="<%= (
    records.find(item =>
      String(item.dairy?._id) ===
      String(record.dairy?._id) &&
      (
        String(item.session || '').toLowerCase() === 'evening' ||
        String(item.session || '').toLowerCase() === 'pm'
      )
    )?.liters ?? ''
  ) %>"

  placeholder="0.00 L"

  class="milk-input
    <%= (
      typeof user !== 'undefined' &&
      user?.role === 'admin'
    )
      ? 'admin-editable'
      : (
          typeof session !== 'undefined' &&
          String(session).toLowerCase() === 'evening'
        )
          ? 'session-open'
          : 'session-closed'
    %>"

  <%= (
    typeof user !== 'undefined' &&
    user?.role === 'admin'
  )
    ? ''
    : (
        typeof session !== 'undefined' &&
        String(session).toLowerCase() === 'evening'
      )
        ? ''
        : 'readonly'
  %>
>


<%
if (
  typeof user !== 'undefined' &&
  user?.role === 'admin'
) {
%>


<button
  type="submit"
  class="session-save-button"
>
Save
</button>


<%
} else if (
  typeof session !== 'undefined' &&
  String(session).toLowerCase() === 'evening'
) {
%>


<button
  type="submit"
  class="session-save-button"
>
Save
</button>


<span class="session-status open">
🟢 Open
</span>


<%
} else {
%>


<span class="session-status closed">
🔒 Closed
</span>


<%
}
%>


<%
if (
  typeof user !== 'undefined' &&
  user?.role === 'admin' &&
  typeof session !== 'undefined' &&
  String(session).toLowerCase() !== 'evening'
) {
%>


<span class="admin-edit-note">
Admin edit
</span>


<%
}
%>


</form>


</td>


<!-- =====================================================
     DAILY TOTAL
     
     CALCULATED HERE FROM THE TWO SESSION RECORDS.
     NO BACKEND TOTAL IS REQUIRED.
===================================================== -->

<td class="total-cell">


<span
  class="daily-total"
  data-dairy="<%= record.dairy?._id || '' %>"
>


<span class="morning-total-value">
<%= Number(
  records.find(item =>
    String(item.dairy?._id) ===
    String(record.dairy?._id) &&
    (
      String(item.session || '').toLowerCase() === 'morning' ||
      String(item.session || '').toLowerCase() === 'am'
    )
  )?.liters || 0
).toFixed(2) %>
</span>


<span>
+
</span>


<span class="evening-total-value">
<%= Number(
  records.find(item =>
    String(item.dairy?._id) ===
    String(record.dairy?._id) &&
    (
      String(item.session || '').toLowerCase() === 'evening' ||
      String(item.session || '').toLowerCase() === 'pm'
    )
  )?.liters || 0
).toFixed(2) %>
</span>


<span>
=
</span>


<span class="daily-total-number">

<%= (
  Number(
    records.find(item =>
      String(item.dairy?._id) ===
      String(record.dairy?._id) &&
      (
        String(item.session || '').toLowerCase() === 'morning' ||
        String(item.session || '').toLowerCase() === 'am'
      )
    )?.liters || 0
  )
  +
  Number(
    records.find(item =>
      String(item.dairy?._id) ===
      String(record.dairy?._id) &&
      (
        String(item.session || '').toLowerCase() === 'evening' ||
        String(item.session || '').toLowerCase() === 'pm'
      )
    )?.liters || 0
  )
).toFixed(2) %>

</span>

L

</span>


</td>


</tr>


<%
  });
%>


<% if (!records || records.length === 0) { %>


<tr>

<td colspan="5">


<div class="empty-state">


<div class="empty-icon">
🥛
</div>


<h3>
No Milk Records
</h3>


<p>
No milk production records were found for this date.
</p>


</div>


</td>

</tr>


<% } %>


</tbody>

</table>

</div>


<!-- =====================================================
     DAILY SUMMARY
===================================================== -->

<div class="summary-grid">


<div class="summary-box">

<span>
Total Milk
</span>


<strong>

<%= Number(stats?.total || 0) %> L

</strong>

</div>


<div class="summary-box">

<span>
Consumed
</span>


<strong>

<%= Number(stats?.consumed || 0) %> L

</strong>

</div>


<div class="summary-box">

<span>
Available
</span>


<strong>

<%= Number(stats?.available || 0) %> L

</strong>

</div>


<div class="summary-box">

<span>
Price Per Liter
</span>


<strong>

KES <%= Number(stats?.price || 0) %>

</strong>

</div>


<div class="summary-box">

<span>
Total Revenue
</span>


<strong>

KES <%= Number(stats?.cash || 0) %>

</strong>

</div>


<div class="summary-box">

<span>
Status
</span>


<% if (stats?.locked) { %>


<strong class="status-locked">

🔒 Locked

</strong>


<% } else { %>


<strong class="status-open">

🟢 Open

</strong>


<% } %>


</div>


</div>


<!-- =====================================================
     CUSTOMER SALES
===================================================== -->

<% if (sales && sales.length > 0) { %>


<div class="sales-section">


<h3>
Customer Sales Breakdown
</h3>


<div class="table-wrapper">


<table>


<thead>

<tr>

<th>
Customer
</th>

<th>
Liters
</th>

<th>
Cash
</th>

</tr>


</thead>


<tbody>


<% sales.forEach(sale => { %>


<tr>


<td>

<%= sale.customerName || "Unknown Customer" %>

</td>


<td>

<%= Number(sale.liters || 0) %> L

</td>


<td>

KES <%= Number(sale.cash || 0) %>

</td>


</tr>


<% }) %>


</tbody>


</table>


</div>


<div class="revenue-total">


<span>
Total Customer Revenue
</span>


<strong>

KES
<%= sales.reduce(
  (total, sale) =>
    total + Number(sale.cash || 0),
  0
) %>

</strong>


</div>


</div>


<% } %>


</div>


<% } %>


<!-- =====================================================
     MONTHLY REPORT
===================================================== -->

<% if (typeof type !== "undefined" && type === "month") { %>


<div class="stats-card">


<div class="report-header">


<h3>
Monthly Milk Report
</h3>


<span class="report-date">

<%= month || "Current Month" %>

</span>


</div>


<div class="table-wrapper">


<table>


<thead>


<tr>

<th>
Code
</th>


<th>
Animal
</th>


<th>
Total Milk
</th>


<th>
Average
</th>

</tr>


</thead>


<tbody>


<% if (records && records.length > 0) { %>


<% records.forEach(record => { %>


<tr>


<td>

<span class="animal-code">

<%= record.dairy
  ? record.dairy.code
  : "Unknown" %>

</span>

</td>


<td>

<%= record.dairy
  ? record.dairy.name
  : "Unknown Animal" %>

</td>


<td>

<span class="liters-value">

<%= Number(record.total || 0).toFixed(2) %> L

</span>

</td>


<td>

<%= Number(record.avg || 0).toFixed(2) %> L

</td>


</tr>


<% }) %>


