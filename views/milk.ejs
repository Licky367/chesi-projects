<style>

  .milk-page {
    max-width: 1100px;
    margin: 0 auto;
    padding: 20px 0 40px;
  }

  .milk-card {
    overflow: hidden;
    border-radius: 18px;
    background: #fff;
    box-shadow: 0 8px 25px rgba(0,0,0,.07);
  }

  .milk-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 25px;
    border-bottom: 1px solid #e5e7eb;
  }

  .milk-header h2 {
    margin: 0 0 7px;
    color: #166534;
    font-size: 26px;
  }

  .milk-header p {
    margin: 0;
    color: #6b7280;
    font-size: 14px;
  }

  .milk-icon {
    width: 58px;
    height: 58px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 16px;
    background: #dcfce7;
    font-size: 28px;
  }

  .milk-status {
    margin: 20px 25px;
    padding: 14px 16px;
    border-radius: 10px;
    background: #f0fdf4;
    color: #166534;
    font-size: 14px;
    font-weight: 600;
  }

  .milk-status.warning {
    background: #fff7ed;
    color: #9a3412;
  }

  .milk-status.closed {
    background: #f3f4f6;
    color: #4b5563;
  }

  .milk-error {
    margin: 20px 25px;
    padding: 14px 16px;
    border-radius: 10px;
    background: #fef2f2;
    color: #b91c1c;
    font-size: 14px;
    font-weight: 600;
  }

  .milk-success {
    margin: 20px 25px;
    padding: 14px 16px;
    border-radius: 10px;
    background: #f0fdf4;
    color: #166534;
    font-size: 14px;
    font-weight: 600;
  }

  .milk-table-wrapper {
    overflow-x: auto;
    padding: 0 25px;
  }

  .milk-table {
    width: 100%;
    border-collapse: collapse;
  }

  .milk-table th {
    padding: 16px 12px;
    border-bottom: 1px solid #e5e7eb;
    background: #f9fafb;
    color: #6b7280;
    font-size: 12px;
    font-weight: 700;
    text-align: left;
    text-transform: uppercase;
  }

  .milk-table td {
    padding: 16px 12px;
    border-bottom: 1px solid #f0f0f0;
    color: #374151;
    font-size: 14px;
    vertical-align: middle;
  }

  .code-badge {
    display: inline-flex;
    padding: 6px 10px;
    border-radius: 8px;
    background: #f0fdf4;
    color: #166534;
    font-size: 12px;
    font-weight: 700;
  }

  .animal-name {
    color: #111827;
    font-weight: 600;
  }

  .milk-input,
  .remarks-input {
    width: 100%;
    box-sizing: border-box;
    padding: 11px 12px;
    border: 1px solid #d1d5db;
    border-radius: 9px;
    outline: none;
    background: #f9fafb;
    color: #111827;
    font-family: inherit;
    font-size: 14px;
  }

  .milk-input:focus,
  .remarks-input:focus {
    border-color: #16a34a;
    background: #fff;
    box-shadow: 0 0 0 4px rgba(22,163,74,.1);
  }

  .remarks-input {
    min-height: 44px;
    resize: vertical;
  }

  .recorded {
    margin-top: 8px;
    padding: 10px 12px;
    border-radius: 8px;
    background: #f3f4f6;
    color: #4b5563;
    font-size: 13px;
  }

  .recorded strong {
    display: block;
    color: #111827;
    margin-bottom: 3px;
  }

  .system-record {
    color: #9a3412 !important;
  }

  .readonly-input {
    background: #f3f4f6 !important;
    color: #6b7280 !important;
    cursor: not-allowed;
  }

  .admin-edit {
    margin-top: 8px;
  }

  .admin-edit button {
    border: none;
    border-radius: 7px;
    padding: 8px 12px;
    background: #166534;
    color: white;
    cursor: pointer;
    font-size: 12px;
    font-weight: 700;
  }

  .admin-edit button:hover {
    background: #14532d;
  }

  .submit-section {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 20px 25px;
    border-top: 1px solid #e5e7eb;
    background: #fafafa;
  }

  .submit-hint {
    color: #6b7280;
    font-size: 13px;
  }

  .submit-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 13px 22px;
    border: none;
    border-radius: 10px;
    background: linear-gradient(
      135deg,
      #16a34a,
      #15803d
    );
    color: white;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
  }

  .submit-btn:disabled {
    background: #9ca3af;
    cursor: not-allowed;
    transform: none;
    box-shadow: none;
  }

  .empty-state {
    padding: 60px 25px;
    color: #6b7280;
    text-align: center;
  }

  .empty-icon {
    margin-bottom: 12px;
    font-size: 48px;
  }

  .empty-state h3 {
    margin: 0 0 8px;
    color: #374151;
  }

  /* ==================================================
     MODAL
  ================================================== */

  .milk-modal {
    position: fixed;
    inset: 0;
    display: none;
    align-items: center;
    justify-content: center;
    background: rgba(0,0,0,.45);
    z-index: 9999;
    padding: 20px;
  }

  .milk-modal.show {
    display: flex;
  }

  .milk-modal-box {
    width: 100%;
    max-width: 430px;
    background: white;
    border-radius: 16px;
    padding: 24px;
    box-shadow: 0 20px 50px rgba(0,0,0,.25);
  }

  .milk-modal-box h3 {
    margin-top: 0;
    color: #166534;
  }

  .milk-modal-box p {
    color: #6b7280;
    line-height: 1.6;
  }

  .milk-modal-box label {
    display: block;
    margin: 12px 0 6px;
    color: #374151;
    font-size: 13px;
    font-weight: 700;
  }

  .modal-actions {
    display: flex;
    gap: 10px;
    margin-top: 20px;
  }

  .modal-actions button {
    flex: 1;
    padding: 12px;
    border: none;
    border-radius: 9px;
    cursor: pointer;
    font-weight: 700;
  }

  .modal-ok {
    background: #166534;
    color: white;
  }

  @media(max-width:650px) {

    .milk-page {
      padding-top: 10px;
    }

    .milk-header {
      align-items: flex-start;
      padding: 20px;
    }

    .milk-header h2 {
      font-size: 23px;
    }

    .milk-icon {
      width: 48px;
      height: 48px;
      font-size: 23px;
      flex-shrink: 0;
    }

    .milk-table-wrapper {
      padding: 0 10px;
    }

    .milk-table th,
    .milk-table td {
      padding: 8px 4px;
      font-size: 12px;
    }

    .milk-input,
    .remarks-input {
      padding: 8px;
      font-size: 12px;
    }

    .submit-section {
      flex-direction: column;
      align-items: stretch;
      padding: 18px;
    }

    .submit-btn {
      width: 100%;
      justify-content: center;
    }

    .milk-status,
    .milk-error,
    .milk-success {
      margin-left: 15px;
      margin-right: 15px;
    }

  }

</style><%
/*

* ==========================================================
* SAFE DEFAULTS
* ==========================================================
* 
* The controller may not send every optional variable.
* Do NOT directly use an undefined EJS variable.
  */

const pageError =
typeof error !== "undefined"
? error
: "";

const pageSuccess =
typeof success !== "undefined"
? Boolean(success)
: false;

const currentSession =
typeof session !== "undefined"
? session
: "";

const adminUser =
typeof isAdmin !== "undefined"
? Boolean(isAdmin)
: (
typeof user !== "undefined" &&
user &&
user.role === "admin"
);

const milkDairies =
Array.isArray(dairies)
? dairies
: [];

%>

<div class="milk-page">  <div class="milk-card"><!-- ==================================================
     HEADER
================================================== -->

<div class="milk-header">

  <div>

    <h2>
      🥛 Milk Collection
    </h2>

    <p>
      Record milk production for each dairy animal.
    </p>

  </div>

  <div class="milk-icon">
    🥛
  </div>

</div>


<!-- ==================================================
     ERROR
================================================== -->

<% if (pageError) { %>

  <div class="milk-error">

    ⚠️ <%= pageError %>

  </div>

<% } %>


<!-- ==================================================
     SUCCESS
================================================== -->

<% if (pageSuccess) { %>

  <div class="milk-success">

    ✓ Milk record saved successfully.

  </div>

<% } %>


<!-- ==================================================
     SESSION STATUS
================================================== -->

<% if (currentSession === "morning") { %>

  <div class="milk-status">

    🌅 <strong>Morning session is open.</strong>

    Submit one record per animal before
    4:00 PM.

  </div>

<% } else if (currentSession === "evening") { %>

  <div class="milk-status">

    🌆 <strong>Evening session is open.</strong>

    Submit one record per animal before
    midnight.

  </div>

<% } else { %>

  <div class="milk-status warning">

    ⏰ Milk collection is currently closed.

    Morning records can be handled before
    4:00 PM, while evening records close at
    the end of the day.

    <% if (!adminUser) { %>

      Contact an administrator if a correction
      is required.

    <% } %>

  </div>

<% } %>


<!-- ==================================================
     ANIMALS
================================================== -->

<% if (milkDairies.length === 0) { %>

  <div class="empty-state">

    <div class="empty-icon">
      🐄
    </div>

    <h3>
      No Animals Currently Being Milked
    </h3>

    <p>
      There are no active dairy animals available.
    </p>

  </div>

<% } else { %>


  <!-- ==================================================
       FORM
  ================================================== -->

  <form
    action="/milk"
    method="POST"
    id="milkForm"
  >

    <div class="milk-table-wrapper">

      <table class="milk-table">

        <thead>

          <tr>

            <th>
              Code
            </th>

            <th>
              Name
            </th>

            <th>
              Milk (L)
            </th>

            <th>
              Remarks
            </th>

          </tr>

        </thead>

        <tbody>

          <% milkDairies.forEach((dairy, index) => {

            let record = null;

            if (currentSession === "morning") {

              record = dairy.morning || null;

            } else if (currentSession === "evening") {

              record = dairy.evening || null;

            } else {

              record =
                dairy.morning ||
                dairy.evening ||
                null;

            }

          %>

            <tr>

              <!-- ==================================================
                   CODE
              ================================================== -->

              <td>

                <span class="code-badge">

                  #<%= dairy.code %>

                </span>

              </td>


              <!-- ==================================================
                   NAME
              ================================================== -->

              <td>

                <span class="animal-name">

                  <%= dairy.name %>

                </span>

              </td>


              <!-- ==================================================
                   MILK
              ================================================== -->

              <td>

                <% if (record) { %>

                  <input
                    class="milk-input readonly-input"
                    type="number"
                    value="<%= Number(record.liters || 0) %>"
                    readonly
                  >

                <% } else if (currentSession) { %>

                  <input
                    class="milk-input"
                    type="number"
                    step="0.1"
                    min="0"
                    name="records[<%= index %>][liters]"
                    placeholder="0.0"
                    required
                  >

                  <input
                    type="hidden"
                    name="records[<%= index %>][dairy]"
                    value="<%= dairy._id %>"
                  >

                <% } else { %>

                  <input
                    class="milk-input readonly-input"
                    type="number"
                    value="0"
                    readonly
                  >

                <% } %>

              </td>


              <!-- ==================================================
                   REMARKS
              ================================================== -->

              <td>

                <% if (record) { %>

                  <textarea
                    class="remarks-input readonly-input"
                    readonly
                  ><%= record.remarks || "" %></textarea>


                  <div class="recorded">

                    <% if (
                      record.recordedByType === "system"
                    ) { %>

                      <strong class="system-record">
                        System
                      </strong>

                      Automatically recorded as
                      Not Milked.

                    <% } else { %>

                      <strong>
                        Recorded
                      </strong>

                      This animal has already been
                      recorded for this session.

                    <% } %>

                  </div>


                  <!-- ==================================================
                       ADMIN EDIT
                  ================================================== -->

                  <% if (
                    adminUser &&
                    record._id
                  ) { %>

                    <div class="admin-edit">

                      <button
                        type="button"
                        onclick="openEditModal(
                          '<%= record._id %>',
                          '<%= Number(record.liters || 0) %>',
                          <%- JSON.stringify(record.remarks || "") %>
                        )"
                      >

                        ✏️ Edit Record

                      </button>

                    </div>

                  <% } %>


                <% } else if (currentSession) { %>

                  <textarea
                    class="remarks-input"
                    name="records[<%= index %>][remarks]"
                    placeholder="Optional remarks..."
                  ></textarea>

                <% } else { %>

                  <textarea
                    class="remarks-input readonly-input"
                    readonly
                  >Collection closed.</textarea>

                <% } %>

              </td>

            </tr>

          <% }); %>

        </tbody>

      </table>

    </div>


    <!-- ==================================================
         SUBMIT
    ================================================== -->

    <div class="submit-section">

      <div class="submit-hint">

        <% if (currentSession === "morning") { %>

          🌅 Morning records must be submitted
          before 4:00 PM.

        <% } else if (currentSession === "evening") { %>

          🌆 Evening records can be submitted
          from 4:00 PM until midnight.

        <% } else { %>

          🔒 The current collection window is closed.

        <% } %>

      </div>


      <button
        type="submit"
        class="submit-btn"
        <% if (!currentSession) { %>
          disabled
        <% } %>
      >

        ✓ Submit Milk Records

      </button>

    </div>

  </form>

<% } %>

  </div></div><!-- ==================================================
     ADMIN EDIT MODAL
================================================== --><div
  id="editMilkModal"
  class="milk-modal"
>  <div class="milk-modal-box"><h3>
  ✏️ Edit Milk Record
</h3>

<p>
  You are editing an existing milk record.
  Changes will be recorded under your administrator
  account.
</p>

<form
  id="editMilkForm"
  method="POST"
>

  <label for="editLiters">
    Milk (Liters)
  </label>

  <input
    id="editLiters"
    class="milk-input"
    type="number"
    step="0.1"
    min="0"
    name="liters"
    required
  >


  <label for="editRemarks">
    Remarks
  </label>

  <textarea
    id="editRemarks"
    class="remarks-input"
    name="remarks"
  ></textarea>


  <div class="modal-actions">

    <button
      type="button"
      onclick="closeEditModal()"
    >
      Cancel
    </button>

    <button
      type="submit"
      class="modal-ok"
    >
      Save Changes
    </button>

  </div>

</form>

  </div></div><script>

  // ==================================================
  // ADMIN EDIT MODAL
  // ==================================================

  function openEditModal(
    id,
    liters,
    remarks
  ) {

    const modal =
      document.getElementById(
        "editMilkModal"
      );

    const form =
      document.getElementById(
        "editMilkForm"
      );

    const litersInput =
      document.getElementById(
        "editLiters"
      );

    const remarksInput =
      document.getElementById(
        "editRemarks"
      );

    if (
      !modal ||
      !form ||
      !litersInput ||
      !remarksInput
    ) {

      return;

    }

    form.action =
      "/milk/edit/" + id;

    litersInput.value =
      liters;

    remarksInput.value =
      remarks || "";

    modal.classList.add(
      "show"
    );

  }


  // ==================================================
  // CLOSE MODAL
  // ==================================================

  function closeEditModal() {

    const modal =
      document.getElementById(
        "editMilkModal"
      );

    if (modal) {

      modal.classList.remove(
        "show"
      );

    }

  }


  // ==================================================
  // OUTSIDE CLICK
  // ==================================================

  const editMilkModal =
    document.getElementById(
      "editMilkModal"
    );

  if (editMilkModal) {

    editMilkModal.addEventListener(
      "click",
      function(event) {

        if (
          event.target === editMilkModal
        ) {

          closeEditModal();

        }

      }
    );

  }


  // ==================================================
  // ESCAPE KEY
  // ==================================================

  document.addEventListener(
    "keydown",
    function(event) {

      if (
        event.key === "Escape"
      ) {

        closeEditModal();

      }

    }
  );

</script>