    <symbol id="milk-sun" viewBox="0 0 24 24">
        <circle cx="12" cy="12" r="4"/>
        <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
    </symbol>

    <symbol id="milk-moon" viewBox="0 0 24 24">
        <path d="M21 14.8A8.5 8.5 0 0 1 9.2 3 8.5 8.5 0 1 0 21 14.8z"/>
    </symbol>

    <symbol id="milk-check" viewBox="0 0 24 24">
        <path d="m5 12 4 4L19 6"/>
    </symbol>

    <symbol id="milk-edit" viewBox="0 0 24 24">
        <path d="M12 20h9"/>
        <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4z"/>
    </symbol>

    <symbol id="milk-clock" viewBox="0 0 24 24">
        <circle cx="12" cy="12" r="9"/>
        <path d="M12 7v5l3 2"/>
    </symbol>

    <symbol id="milk-x" viewBox="0 0 24 24">
        <path d="m7 7 10 10M17 7 7 17"/>
    </symbol>

    <symbol id="milk-save" viewBox="0 0 24 24">
        <path d="M5 4h12l2 2v14H5z"/>
        <path d="M8 4v5h8V4"/>
        <path d="M8 20v-6h8v6"/>
    </symbol>

    <symbol id="milk-alert" viewBox="0 0 24 24">
        <path d="M10.3 4.5 2.8 18a2 2 0 0 0 1.7 3h15a2 2 0 0 0 1.7-3L13.7 4.5a2 2 0 0 0-3.4 0z"/>
        <path d="M12 9v4"/>
        <path d="M12 17h.01"/>
    </symbol>

</svg>


<!-- ==========================================================
     PAGE
========================================================== -->

<div class="milk-page">


    <!-- ======================================================
         HERO
    ======================================================= -->

    <section class="milk-hero">

        <div class="milk-hero-content">

            <div class="milk-title-wrap">

                <div class="milk-title-icon">

                    <svg
                        class="milk-icon milk-icon-lg"
                        aria-hidden="true"
                    >
                        <use href="#milk-droplet"></use>
                    </svg>

                </div>

                <div>

                    <h1 class="milk-title">
                        Milk Collection
                    </h1>

                    <p class="milk-subtitle">
                        Record the milk produced by each milking
                        animal during the current collection session.
                    </p>

                </div>

            </div>


            <div class="milk-session-box">

                <span class="milk-session-label">
                    Current session
                </span>

                <span class="milk-session-value">

                    <span
                        class="milk-session-dot <%= session === 'closed' ? 'closed' : '' %>"
                    ></span>

                    <%= session === "morning"
                        ? "Morning Collection"
                        : session === "evening"
                            ? "Evening Collection"
                            : "Collection Closed"
                    %>

                </span>

            </div>

        </div>

    </section>


    <!-- ======================================================
         SESSION INFORMATION
    ======================================================= -->

    <section class="milk-session-info">


        <div class="milk-info-card">

            <div class="milk-info-icon">

                <svg
                    class="milk-icon"
                    aria-hidden="true"
                >
                    <use href="#milk-clock"></use>
                </svg>

            </div>

            <div>

                <div class="milk-info-label">
                    Collection window
                </div>

                <div class="milk-info-value">

                    <% if (session === "morning") { %>

                        Morning · Until 10:00 AM

                    <% } else if (session === "evening") { %>

                        Evening · From 4:00 PM

                    <% } else { %>

                        Currently closed

                    <% } %>

                </div>

            </div>

        </div>


        <div class="milk-info-card">

            <div class="milk-info-icon">

                <svg
                    class="milk-icon"
                    aria-hidden="true"
                >
                    <use href="#milk-cow"></use>
                </svg>

            </div>

            <div>

                <div class="milk-info-label">
                    Milking animals
                </div>

                <div class="milk-info-value">
                    <%= dairies.length %> registered
                </div>

            </div>

        </div>


        <div class="milk-info-card">

            <div class="milk-info-icon">

                <svg
                    class="milk-icon"
                    aria-hidden="true"
                >
                    <use href="#milk-check"></use>
                </svg>

            </div>

            <div>

                <div class="milk-info-label">
                    Access
                </div>

                <div class="milk-info-value">
                    <%= isAdmin ? "Administrator" : "Milk Worker" %>
                </div>

            </div>

        </div>

    </section>


    <!-- ======================================================
         TABLE HEADER
    ======================================================= -->

    <div class="milk-section-header">

        <h2 class="milk-section-title">
            Today's Milk Records
        </h2>

        <span class="milk-section-count">

            <%= dairies.length %>

            <%= dairies.length === 1
                ? "animal"
                : "animals"
            %>

        </span>

    </div>


    <% if (!dairies.length) { %>


        <!-- ==================================================
             EMPTY STATE
        =================================================== -->

        <section class="milk-empty">

            <div class="milk-empty-icon">

                <svg
                    class="milk-icon milk-icon-lg"
                    aria-hidden="true"
                >
                    <use href="#milk-cow"></use>
                </svg>

            </div>

            <h3 class="milk-empty-title">
                No milking animals
            </h3>

            <p class="milk-empty-text">
                There are currently no dairy animals marked as
                actively milking.
            </p>

        </section>


    <% } else { %>


        <!-- ==================================================
             MILK TABLE
        =================================================== -->

        <section class="milk-table-wrapper">

            <table class="milk-table">

                <thead>

                    <tr>

                        <th class="milk-column-animal">
                            Animal
                        </th>

                        <th class="milk-column-code">
                            Code
                        </th>

                        <th class="milk-column-session">
                            Morning
                        </th>

                        <th class="milk-column-session">
                            Evening
                        </th>

                    </tr>

                </thead>


                <tbody>


                    <% dairies.forEach((dairy) => { %>

                        <tr>


                            <!-- ==================================
                                 ANIMAL
                            =================================== -->

                            <td>

                                <div class="milk-animal-cell">

                                    <div class="milk-animal-avatar">

                                        <svg
                                            class="milk-icon"
                                            aria-hidden="true"
                                        >
                                            <use href="#milk-cow"></use>
                                        </svg>

                                    </div>


                                    <div class="milk-animal-details">

                                        <h3 class="milk-animal-name">

                                            <%= dairy.name ||
                                                `Dairy Animal ${dairy.code ?? ""}`
                                            %>

                                        </h3>


                                        <div class="milk-animal-status">

                                            <span
                                                class="milk-animal-status-dot"
                                            ></span>

                                            Milking

                                        </div>

                                    </div>

                                </div>

                            </td>


                            <!-- ==================================
                                 CODE
                            =================================== -->

                            <td class="milk-code-cell">

                                <% if (
                                    dairy.code !== undefined &&
                                    dairy.code !== null
                                ) { %>

                                    <span class="milk-code-value">
                                        <%= dairy.code %>
                                    </span>

                                <% } else { %>

                                    <span class="milk-code-value">
                                        —
                                    </span>

                                <% } %>

                            </td>


                            <!-- ==================================
                                 MORNING
                            =================================== -->

                            <td>

                                <div class="milk-session-cell">

                                    <div class="milk-session-cell-header">

                                        <div class="milk-session-cell-title">

                                            <span
                                                class="milk-session-heading-icon morning"
                                            >

                                                <svg
                                                    class="milk-icon"
                                                    aria-hidden="true"
                                                >
                                                    <use href="#milk-sun"></use>
                                                </svg>

                                            </span>

                                            Morning

                                        </div>


                                        <% if (dairy.morningRecorded) { %>

                                            <span
                                                class="milk-recorded-badge"
                                            >
                                                Recorded
                                            </span>

                                        <% } %>

                                    </div>


                                    <% if (dairy.morningRecorded) { %>


                                        <div class="milk-recorded-box">

                                            <div class="milk-recorded-value">

                                                <span
                                                    class="milk-recorded-number"
                                                >
                                                    <%= Number(
                                                        dairy.morningLiters || 0
                                                    ).toFixed(2) %>
                                                </span>

                                                <span
                                                    class="milk-recorded-unit"
                                                >
                                                    litres
                                                </span>

                                            </div>


                                            <% if (
                                                dairy.morning &&
                                                dairy.morning.remarks
                                            ) { %>

                                                <div
                                                    class="milk-recorded-remarks"
                                                >
                                                    <%= dairy.morning.remarks %>
                                                </div>

                                            <% } %>

                                        </div>


                                        <% if (
                                            isAdmin &&
                                            dairy.morning &&
                                            dairy.morning._id
                                        ) { %>

                                            <div class="milk-admin-edit">

                                                <button
                                                    type="button"
                                                    class="milk-edit-button"
                                                    data-record-id="<%= dairy.morning._id %>"
                                                    data-liters="<%= dairy.morningLiters ?? 0 %>"
                                                    data-remarks="<%= dairy.morning.remarks || '' %>"
                                                    data-session="Morning"
                                                    onclick="openMilkEditModal(this)"
                                                >

                                                    <svg
                                                        class="milk-icon"
                                                        aria-hidden="true"
                                                    >
                                                        <use href="#milk-edit"></use>
                                                    </svg>

                                                    Edit morning record

                                                </button>

                                            </div>

                                        <% } %>


                                    <% } else if (session === "morning") { %>


                                        <form
                                            class="milk-form"
                                            method="POST"
                                            action="/milk"
                                            onsubmit="return validateMilkForm(this)"
                                        >

                                            <input
                                                type="hidden"
                                                name="dairy"
                                                value="<%= dairy._id %>"
                                            >

                                            <input
                                                type="hidden"
                                                name="session"
                                                value="morning"
                                            >


                                            <div class="milk-input-wrap">

                                                <input
                                                    class="milk-input"
                                                    type="number"
                                                    name="liters"
                                                    min="0"
                                                    step="0.01"
                                                    inputmode="decimal"
                                                    placeholder="Enter litres"
                                                    required
                                                >

                                                <span class="milk-input-unit">
                                                    L
                                                </span>

                                            </div>


                                            <div class="milk-remarks-input">

                                                <input
                                                    class="milk-input"
                                                    type="text"
                                                    name="remarks"
                                                    maxlength="250"
                                                    placeholder="Remarks (optional)"
                                                >

                                            </div>


                                            <button
                                                type="submit"
                                                class="milk-submit"
                                            >

                                                <svg
                                                    class="milk-icon"
                                                    aria-hidden="true"
                                                >
                                                    <use href="#milk-save"></use>
                                                </svg>

                                                Save morning milk

                                            </button>

                                        </form>


                                    <% } else { %>


                                        <div class="milk-closed-box">

                                            <% if (session === "evening") { %>

                                                <strong>
                                                    Morning collection is closed.
                                                </strong>

                                                Existing morning records remain
                                                available for review.

                                            <% } else { %>

                                                <strong>
                                                    Morning collection is closed.
                                                </strong>

                                                It will reopen at midnight.

                                            <% } %>

                                        </div>


                                        <% if (
                                            isAdmin &&
                                            dairy.morning &&
                                            dairy.morning._id
                                        ) { %>

                                            <div class="milk-admin-edit">

                                                <button
                                                    type="button"
                                                    class="milk-edit-button"
                                                    data-record-id="<%= dairy.morning._id %>"
                                                    data-liters="<%= dairy.morningLiters ?? 0 %>"
                                                    data-remarks="<%= dairy.morning.remarks || '' %>"
                                                    data-session="Morning"
                                                    onclick="openMilkEditModal(this)"
                                                >

                                                    <svg
                                                        class="milk-icon"
                                                        aria-hidden="true"
                                                    >
                                                        <use href="#milk-edit"></use>
                                                    </svg>

                                                    Edit morning record

                                                </button>

                                            </div>

                                        <% } %>

                                    <% } %>

                                </div>

                            </td>


                            <!-- ==================================
                                 EVENING
                            =================================== -->

                            <td>

                                <div class="milk-session-cell">

                                    <div class="milk-session-cell-header">

                                        <div class="milk-session-cell-title">

                                            <span
                                                class="milk-session-heading-icon evening"
                                            >

                                                <svg
                                                    class="milk-icon"
                                                    aria-hidden="true"
                                                >
                                                    <use href="#milk-moon"></use>
                                                </svg>

                                            </span>

                                            Evening

                                        </div>


                                        <% if (dairy.eveningRecorded) { %>

                                            <span
                                                class="milk-recorded-badge"
                                            >
                                                Recorded
                                            </span>

                                        <% } %>

                                    </div>


                                    <% if (dairy.eveningRecorded) { %>


                                        <div class="milk-recorded-box">

                                            <div class="milk-recorded-value">

                                                <span
                                                    class="milk-recorded-number"
                                                >
                                                    <%= Number(
                                                        dairy.eveningLiters || 0
                                                    ).toFixed(2) %>
                                                </span>

                                                <span
                                                    class="milk-recorded-unit"
                                                >
                                                    litres
                                                </span>

                                            </div>


                                            <% if (
                                                dairy.evening &&
                                                dairy.evening.remarks
                                            ) { %>

                                                <div
                                                    class="milk-recorded-remarks"
                                                >
                                                    <%= dairy.evening.remarks %>
                                                </div>

                                            <% } %>

                                        </div>


                                        <% if (
                                            isAdmin &&
                                            dairy.evening &&
                                            dairy.evening._id
                                        ) { %>

                                            <div class="milk-admin-edit">

                                                <button
                                                    type="button"
                                                    class="milk-edit-button"
                                                    data-record-id="<%= dairy.evening._id %>"
                                                    data-liters="<%= dairy.eveningLiters ?? 0 %>"
                                                    data-remarks="<%= dairy.evening.remarks || '' %>"
                                                    data-session="Evening"
                                                    onclick="openMilkEditModal(this)"
                                                >

                                                    <svg
                                                        class="milk-icon"
                                                        aria-hidden="true"
                                                    >
                                                        <use href="#milk-edit"></use>
                                                    </svg>

                                                    Edit evening record

                                                </button>

                                            </div>

                                        <% } %>


                                    <% } else if (session === "evening") { %>


                                        <form
                                            class="milk-form"
                                            method="POST"
                                            action="/milk"
                                            onsubmit="return validateMilkForm(this)"
                                        >

                                            <input
                                                type="hidden"
                                                name="dairy"
                                                value="<%= dairy._id %>"
                                            >

                                            <input
                                                type="hidden"
                                                name="session"
                                                value="evening"
                                            >


                                            <div class="milk-input-wrap">

                                                <input
                                                    class="milk-input"
                                                    type="number"
                                                    name="liters"
                                                    min="0"
                                                    step="0.01"
                                                    inputmode="decimal"
                                                    placeholder="Enter litres"
                                                    required
                                                >

                                                <span class="milk-input-unit">
                                                    L
                                                </span>

                                            </div>


                                            <div class="milk-remarks-input">

                                                <input
                                                    class="milk-input"
                                                    type="text"
                                                    name="remarks"
                                                    maxlength="250"
                                                    placeholder="Remarks (optional)"
                                                >

                                            </div>


                                            <button
                                                type="submit"
                                                class="milk-submit"
                                            >

                                                <svg
                                                    class="milk-icon"
                                                    aria-hidden="true"
                                                >
                                                    <use href="#milk-save"></use>
                                                </svg>

                                                Save evening milk

                                            </button>

                                        </form>


                                    <% } else { %>


                                        <div class="milk-closed-box">

                                            <% if (session === "morning") { %>

                                                <strong>
                                                    Evening collection has not opened.
                                                </strong>

                                                It opens at 4:00 PM.

                                            <% } else { %>

                                                <strong>
                                                    Evening collection is closed.
                                                </strong>

                                                It will reopen at 4:00 PM.

                                            <% } %>

                                        </div>


                                        <% if (
                                            isAdmin &&
                                            dairy.evening &&
                                            dairy.evening._id
                                        ) { %>

                                            <div class="milk-admin-edit">

                                                <button
                                                    type="button"
                                                    class="milk-edit-button"
                                                    data-record-id="<%= dairy.evening._id %>"
                                                    data-liters="<%= dairy.eveningLiters ?? 0 %>"
                                                    data-remarks="<%= dairy.evening.remarks || '' %>"
                                                    data-session="Evening"
                                                    onclick="openMilkEditModal(this)"
                                                >

                                                    <svg
                                                        class="milk-icon"
                                                        aria-hidden="true"
                                                    >
                                                        <use href="#milk-edit"></use>
                                                    </svg>

                                                    Edit evening record

                                                </button>

                                            </div>

                                        <% } %>

                                    <% } %>

                                </div>

                            </td>

                        </tr>

                    <% }) %>

                </tbody>

            </table>

        </section>


    <% } %>


</div>


<!-- ==========================================================
     SERVER RESULT POPUP

     IMPORTANT:
     ----------------------------------------------------------
     This block is rendered ONLY when there is a genuine
     success result or a genuine error message.

     Opening /milk normally will not render this popup.
========================================================== -->

<%
    if (
        success === true ||
        success === "1" ||
        (
            typeof error !== "undefined" &&
            error !== null &&
            error !== false &&
            String(error).trim() !== "" &&
            String(error).trim() !== "undefined"
        )
    ) {
%>

<div
    id="milkResultPopup"
    class="milk-result-popup active <%= (
        typeof error !== "undefined" &&
        error !== null &&
        error !== false &&
        String(error).trim() !== "" &&
        String(error).trim() !== "undefined"
    ) ? "error" : "success" %>"
    aria-hidden="false"
>

    <div
        class="milk-result-card"
        role="dialog"
        aria-modal="true"
        aria-labelledby="milkResultTitle"
    >

        <div
            class="milk-result-icon <%= (
                typeof error !== "undefined" &&
                error !== null &&
                error !== false &&
                String(error).trim() !== "" &&
                String(error).trim() !== "undefined"
            ) ? "error" : "success" %>"
        >

            <svg
                class="milk-icon"
                aria-hidden="true"
            >

                <use
                    href="<%= (
                        typeof error !== "undefined" &&
                        error !== null &&
                        error !== false &&
                        String(error).trim() !== "" &&
                        String(error).trim() !== "undefined"
                    )
                        ? "#milk-alert"
                        : "#milk-check"
                    %>"
                ></use>

            </svg>

        </div>


        <h2
            id="milkResultTitle"
            class="milk-result-title"
        >

            <%= (
                typeof error !== "undefined" &&
                error !== null &&
                error !== false &&
                String(error).trim() !== "" &&
                String(error).trim() !== "undefined"
            )
                ? "Unable to save milk record."
                : "Milk record saved successfully."
            %>

        </h2>


        <p class="milk-result-message">

            <%= (
                typeof error !== "undefined" &&
                error !== null &&
                error !== false &&
                String(error).trim() !== "" &&
                String(error).trim() !== "undefined"
            )
                ? String(error)
                : "The collection record has been recorded successfully."
            %>

        </p>


        <button
            type="button"
            class="milk-result-button"
            onclick="closeMilkResultPopup()"
        >
            OK
        </button>

    </div>

</div>

<% } %>


<!-- ==========================================================
     ADMIN EDIT MODAL
========================================================== -->

<% if (isAdmin) { %>

<div
    id="milkEditModal"
    class="milk-modal"
    aria-hidden="true"
>

    <div
        class="milk-modal-card"
        role="dialog"
        aria-modal="true"
        aria-labelledby="milkEditTitle"
    >

        <div class="milk-modal-header">

            <div>

                <h2
                    id="milkEditTitle"
                    class="milk-modal-title"
                >
                    Edit milk record
                </h2>

                <p
                    id="milkEditSubtitle"
                    class="milk-modal-subtitle"
                >
                    Administrator record adjustment
                </p>

            </div>


            <button
                type="button"
                class="milk-modal-close"
                onclick="closeMilkEditModal()"
                aria-label="Close"
            >

                <svg
                    class="milk-icon"
                    aria-hidden="true"
                >
                    <use href="#milk-x"></use>
                </svg>

            </button>

        </div>


        <form
            id="milkEditForm"
            method="POST"
        >

            <label
                for="milkEditLiters"
                class="milk-field-label"
            >
                Milk quantity
            </label>

            <div class="milk-input-wrap">

                <input
                    id="milkEditLiters"
                    class="milk-input"
                    type="number"
                    name="liters"
                    min="0"
                    step="0.01"
                    inputmode="decimal"
                    required
                >

                <span class="milk-input-unit">
                    L
                </span>

            </div>


            <div class="milk-remarks-input">

                <label
                    for="milkEditRemarks"
                    class="milk-field-label"
                >
                    Remarks
                </label>

                <input
                    id="milkEditRemarks"
                    class="milk-input"
                    type="text"
                    name="remarks"
                    maxlength="250"
                    placeholder="Optional remarks"
                >

            </div>


            <div class="milk-modal-actions">

                <button
                    type="button"
                    class="milk-modal-cancel"
                    onclick="closeMilkEditModal()"
                >
                    Cancel
                </button>

                <button
                    type="submit"
                    class="milk-modal-save"
                >
                    Save changes
                </button>

            </div>

        </form>

    </div>

</div>

<% } %>


<script>

/* ==========================================================
   MILK FORM VALIDATION
========================================================== */

function validateMilkForm(form) {

    const input =
        form.querySelector(
            'input[name="liters"]'
        );

    if (!input) {
        return false;
    }


    const value =
        Number(input.value);


    if (
        input.value === "" ||
        !Number.isFinite(value) ||
        value < 0
    ) {

        showMilkValidationPopup(
            "Please enter a valid milk quantity."
        );

        input.focus();

        return false;
    }


    return true;

}


/* ==========================================================
   VALIDATION POPUP
========================================================== */

function showMilkValidationPopup(message) {

    let popup =
        document.getElementById(
            "milkValidationPopup"
        );


    if (!popup) {

        popup =
            document.createElement(
                "div"
            );

        popup.id =
            "milkValidationPopup";

        popup.className =
            "milk-result-popup error";


        popup.innerHTML = `
            <div
                class="milk-result-card"
                role="dialog"
                aria-modal="true"
                aria-labelledby="milkValidationTitle"
            >

                <div class="milk-result-icon error">

                    <svg
                        class="milk-icon"
                        aria-hidden="true"
                    >
                        <use href="#milk-alert"></use>
                    </svg>

                </div>


                <h2
                    id="milkValidationTitle"
                    class="milk-result-title"
                >
                    Invalid milk quantity
                </h2>


                <p class="milk-result-message"></p>


                <button
                    type="button"
                    class="milk-result-button"
                >
                    OK
                </button>

            </div>
        `;


        document.body.appendChild(
            popup
        );


        const button =
            popup.querySelector(
                ".milk-result-button"
            );


        button.addEventListener(
            "click",
            function() {

                popup.classList.remove(
                    "active"
                );

                popup.setAttribute(
                    "aria-hidden",
                    "true"
                );

            }
        );

    }


    const messageElement =
        popup.querySelector(
            ".milk-result-message"
        );


    if (messageElement) {

        messageElement.textContent =
            message;

    }


    popup.classList.add(
        "active"
    );

    popup.setAttribute(
        "aria-hidden",
        "false"
    );

}


/* ==========================================================
   CLOSE SERVER RESULT POPUP
========================================================== */

function closeMilkResultPopup() {

    const popup =
        document.getElementById(
            "milkResultPopup"
        );


    if (!popup) {
        return;
    }


    popup.classList.remove(
        "active"
    );

    popup.setAttribute(
        "aria-hidden",
        "true"
    );


    /*
    ----------------------------------------------------------
    Remove only the result parameters.
    ----------------------------------------------------------
    */

    const url =
        new URL(
            window.location.href
        );


    url.searchParams.delete(
        "success"
    );

    url.searchParams.delete(
        "error"
    );


    /*
    ----------------------------------------------------------
    Replace the current URL first.
    ----------------------------------------------------------
    */

    window.history.replaceState(
        {},
        document.title,
        url.pathname +
        (
            url.search
                ? url.search
                : ""
        ) +
        (
            url.hash
                ? url.hash
                : ""
        )
    );


    /*
    ----------------------------------------------------------
    Reload the page so the newly saved milk data is displayed.
    ----------------------------------------------------------
    */

    window.location.reload();

}


/* ==========================================================
   ADMIN EDIT MODAL
========================================================== */

function openMilkEditModal(button) {

    const modal =
        document.getElementById(
            "milkEditModal"
        );

    const form =
        document.getElementById(
            "milkEditForm"
        );

    const litersInput =
        document.getElementById(
            "milkEditLiters"
        );

    const remarksInput =
        document.getElementById(
            "milkEditRemarks"
        );

    const subtitle =
        document.getElementById(
            "milkEditSubtitle"
        );


    if (
        !modal ||
        !form ||
        !litersInput ||
        !remarksInput ||
        !button
    ) {
        return;
    }


    const recordId =
        button.dataset.recordId;

    const liters =
        button.dataset.liters;

    const remarks =
        button.dataset.remarks;

    const sessionName =
        button.dataset.session;


    if (!recordId) {
        return;
    }


    form.action =
        "/milk/" +
        encodeURIComponent(
            recordId
        );


    litersInput.value =
        liters || "";


    remarksInput.value =
        remarks || "";


    if (subtitle) {

        subtitle.textContent =
            "Editing " +
            sessionName +
            " milk record";

    }


    modal.classList.add(
        "active"
    );

    modal.setAttribute(
        "aria-hidden",
        "false"
    );


    setTimeout(
        function() {

            litersInput.focus();

            litersInput.select();

        },
        50
    );

}


/* ==========================================================
   CLOSE EDIT MODAL
========================================================== */

function closeMilkEditModal() {

    const modal =
        document.getElementById(
            "milkEditModal"
        );


    if (!modal) {
        return;
    }


    modal.classList.remove(
        "active"
    );

    modal.setAttribute(
        "aria-hidden",
        "true"
    );

}


/* ==========================================================
   CLICK OUTSIDE EDIT MODAL
========================================================== */

document.addEventListener(
    "click",
    function(event) {

        const modal =
            document.getElementById(
                "milkEditModal"
            );


        if (
            modal &&
            event.target === modal
        ) {

            closeMilkEditModal();

        }

    }
);


/* ==========================================================
   ESCAPE KEY
========================================================== */

document.addEventListener(
    "keydown",
    function(event) {

        if (
            event.key !== "Escape"
        ) {
            return;
        }


        closeMilkEditModal();


        const resultPopup =
            document.getElementById(
                "milkResultPopup"
            );


        if (
            resultPopup &&
            resultPopup.classList.contains(
                "active"
            )
        ) {

            closeMilkResultPopup();

        }

    }
);


/* ==========================================================
   PREVENT DOUBLE SUBMISSION
========================================================== */

document.addEventListener(
    "submit",
    function(event) {

        const form =
            event.target;


        if (
            !form.classList.contains(
                "milk-form"
            )
        ) {
            return;
        }


        if (
            form.dataset.submitted === "true"
        ) {

            event.preventDefault();

            return;

        }


        const button =
            form.querySelector(
                ".milk-submit"
            );


        if (!button) {
            return;
        }


        form.dataset.submitted =
            "true";

        button.disabled =
            true;


        button.innerHTML =
            "Saving...";

    }
);

</script>