<% /*
==========================================================
MILK COLLECTION PAGE
==========================================================

EXPECTED CONTROLLER DATA:

    dairies
    session
    isAdmin
    success
    error
    user

SESSION VALUES:

    "morning"  = 00:00 - 10:00
    "closed"   = 10:00 - 16:00
    "evening"  = 16:00 - 00:00

IMPORTANT BUSINESS RULES:

    • A user may submit only once per cow per session.
    • Morning submissions: 00:00 - 10:00.
    • Submission is closed: 10:00 - 16:00.
    • Evening submissions: 16:00 - midnight.
    • Once submitted, normal users cannot edit.
    • Admins can edit existing records.
    • Admins can edit morning records even during
      the 10:00 - 16:00 closed period.
    • The EJS displays the current/relevant session only.
    • The service/controller remains responsible for
      enforcing all business rules.

Each dairy may have:

    dairy.morning
    dairy.evening

==========================================================
SAFE DEFAULTS
==========================================================
*/

const pageError =
    typeof error !== "undefined"
        ? error
        : "";

const pageSuccess =
    typeof success !== "undefined"
        ? Boolean(success)
        : false;

const currentSession =
    typeof session !== "undefined"
        ? session
        : "";

const adminUser =
    typeof isAdmin !== "undefined"
        ? Boolean(isAdmin)
        : (
            typeof user !== "undefined" &&
            user &&
            user.role === "admin"
        );

const milkDairies =
    typeof dairies !== "undefined" &&
    Array.isArray(dairies)
        ? dairies
        : [];

%>


<!-- ==========================================================
     PAGE
========================================================== -->

<div class="milk-page">


    <!-- ======================================================
         HEADER
    ====================================================== -->

    <div class="milk-header">

        <div class="milk-header-content">

            <div class="milk-header-icon">
                🥛
            </div>

            <div>

                <h2 class="milk-title">
                    Milk Collection
                </h2>

                <p class="milk-subtitle">
                    Record milk production for each dairy animal.
                </p>

            </div>

        </div>

        <div class="milk-session-badge">

            <% if (currentSession === "morning") { %>

                <span class="session-dot morning"></span>
                Morning

            <% } else if (currentSession === "evening") { %>

                <span class="session-dot evening"></span>
                Evening

            <% } else { %>

                <span class="session-dot closed"></span>
                Closed

            <% } %>

        </div>

    </div>



    <!-- ======================================================
         ERROR
    ====================================================== -->

    <% if (pageError) { %>

        <div class="milk-alert milk-alert-error">

            <span class="milk-alert-icon">
                ⚠️
            </span>

            <span>
                <%= pageError %>
            </span>

        </div>

    <% } %>



    <!-- ======================================================
         SUCCESS
    ====================================================== -->

    <% if (pageSuccess) { %>

        <div class="milk-alert milk-alert-success">

            <span class="milk-alert-icon">
                ✓
            </span>

            <span>
                Milk record saved successfully.
            </span>

        </div>

    <% } %>



    <!-- ======================================================
         SESSION INFORMATION
    ====================================================== -->

    <div class="milk-session-card">

        <% if (currentSession === "morning") { %>

            <div class="session-icon morning-icon">
                🌅
            </div>

            <div class="session-info">

                <strong>
                    Morning collection is open
                </strong>

                <span>
                    Submit one record per cow before
                    <strong>10:00 AM</strong>.
                </span>

            </div>

        <% } else if (currentSession === "closed") { %>

            <div class="session-icon closed-icon">
                ⏰
            </div>

            <div class="session-info">

                <strong>
                    Collection is temporarily closed
                </strong>

                <span>
                    Morning collection closed at
                    <strong>10:00 AM</strong>.
                    Evening collection opens at
                    <strong>4:00 PM</strong>.
                </span>

                <% if (adminUser) { %>

                    <span class="admin-session-note">
                        Administrator access:
                        existing morning records can still
                        be edited during this period.
                    </span>

                <% } else { %>

                    <span class="admin-session-note">
                        Contact an administrator if a correction
                        is required.
                    </span>

                <% } %>

            </div>

        <% } else if (currentSession === "evening") { %>

            <div class="session-icon evening-icon">
                🌆
            </div>

            <div class="session-info">

                <strong>
                    Evening collection is open
                </strong>

                <span>
                    Submit one record per cow before
                    <strong>midnight</strong>.
                </span>

            </div>

        <% } else { %>

            <div class="session-icon closed-icon">
                ⏰
            </div>

            <div class="session-info">

                <strong>
                    Collection window unavailable
                </strong>

                <span>
                    Please contact an administrator if
                    this continues.
                </span>

            </div>

        <% } %>

    </div>



    <!-- ======================================================
         EMPTY STATE
    ====================================================== -->

    <% if (milkDairies.length === 0) { %>

        <div class="milk-empty">

            <div class="milk-empty-icon">
                🐄
            </div>

            <h3>
                No Animals Currently Being Milked
            </h3>

            <p>
                There are no active dairy animals
                available for milk collection.
            </p>

        </div>

    <% } else { %>



        <!-- ==================================================
             MILK FORM
        ================================================== -->

        <form
            action="/milk"
            method="POST"
            id="milkForm"
            class="milk-form"
        >


            <!-- ==============================================
                 TABLE CARD
            =============================================== -->

            <div class="milk-table-card">

                <div class="milk-table-header">

                    <div>

                        <h3>
                            Dairy Animals
                        </h3>

                        <p>
                            Enter the milk collected from
                            each animal.
                        </p>

                    </div>

                    <div class="animal-count">

                        <%= milkDairies.length %>

                        <span>
                            animals
                        </span>

                    </div>

                </div>


                <div class="milk-table-wrapper">

                    <table class="milk-table">

                        <thead>

                            <tr>

                                <th>
                                    Code
                                </th>

                                <th>
                                    Animal
                                </th>

                                <th>
                                    Milk (L)
                                </th>

                                <th>
                                    Remarks
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            <% milkDairies.forEach((dairy, index) => {

                                /*
                                ==================================================
                                DETERMINE DISPLAYED RECORD
                                ==================================================

                                Morning:
                                    dairy.morning

                                Evening:
                                    dairy.evening

                                Closed:
                                    dairy.morning

                                We deliberately do NOT use:

                                    dairy.morning || dairy.evening

                                because that could display a record belonging
                                to another collection session.
                                */

                                let record = null;

                                if (
                                    currentSession === "morning"
                                ) {

                                    record =
                                        dairy.morning || null;

                                } else if (
                                    currentSession === "evening"
                                ) {

                                    record =
                                        dairy.evening || null;

                                } else if (
                                    currentSession === "closed"
                                ) {

                                    record =
                                        dairy.morning || null;

                                }

                            %>


                                <tr
                                    class="<%= record ? 'has-record' : 'awaiting-record' %>"
                                >


                                    <!-- ==================================
                                         CODE
                                    =================================== -->

                                    <td>

                                        <span class="code-badge">
                                            #<%= dairy.code %>
                                        </span>

                                    </td>



                                    <!-- ==================================
                                         ANIMAL
                                    =================================== -->

                                    <td>

                                        <div class="animal-cell">

                                            <div class="animal-avatar">
                                                🐄
                                            </div>

                                            <div class="animal-details">

                                                <span class="animal-name">
                                                    <%= dairy.name %>
                                                </span>

                                                <% if (record) { %>

                                                    <span class="animal-status recorded-status">
                                                        ● Recorded
                                                    </span>

                                                <% } else if (
                                                    currentSession === "morning" ||
                                                    currentSession === "evening"
                                                ) { %>

                                                    <span class="animal-status pending-status">
                                                        ● Awaiting record
                                                    </span>

                                                <% } else { %>

                                                    <span class="animal-status closed-status">
                                                        ● Collection closed
                                                    </span>

                                                <% } %>

                                            </div>

                                        </div>

                                    </td>



                                    <!-- ==================================
                                         MILK
                                    =================================== -->

                                    <td>

                                        <div
                                            class="<%= record && adminUser ? 'admin-record-edit' : 'milk-value-wrapper' %>"
                                            <% if (
                                                record &&
                                                adminUser &&
                                                record._id
                                            ) { %>

                                                role="button"
                                                tabindex="0"
                                                title="Tap to edit this record"
                                                onclick="openEditModal(
                                                    '<%= record._id %>',
                                                    '<%= Number(record.liters || 0) %>',
                                                    <%- JSON.stringify(record.remarks || "") %>
                                                )"

                                            <% } %>
                                        >

                                            <% if (record) { %>

                                                <input
                                                    class="milk-input readonly-input"
                                                    type="number"
                                                    value="<%= Number(record.liters || 0) %>"
                                                    readonly
                                                >

                                                <% if (adminUser) { %>

                                                    <span class="edit-indicator">
                                                        ✏️
                                                    </span>

                                                <% } %>

                                            <% } else if (
                                                currentSession === "morning" ||
                                                currentSession === "evening"
                                            ) { %>

                                                <input
                                                    class="milk-input"
                                                    type="number"
                                                    step="0.1"
                                                    min="0"
                                                    name="records[<%= index %>][liters]"
                                                    placeholder="0.0"
                                                    required
                                                >

                                                <input
                                                    type="hidden"
                                                    name="records[<%= index %>][dairy]"
                                                    value="<%= dairy._id %>"
                                                >

                                            <% } else { %>

                                                <input
                                                    class="milk-input readonly-input"
                                                    type="number"
                                                    value="0"
                                                    readonly
                                                >

                                            <% } %>

                                        </div>

                                    </td>



                                    <!-- ==================================
                                         REMARKS
                                    =================================== -->

                                    <td>

                                        <% if (record) { %>


                                            <div
                                                class="<%= record && adminUser ? 'admin-record-edit remarks-edit-area' : 'remarks-view-area' %>"
                                                <% if (
                                                    adminUser &&
                                                    record._id
                                                ) { %>

                                                    role="button"
                                                    tabindex="0"
                                                    title="Tap to edit this record"
                                                    onclick="openEditModal(
                                                        '<%= record._id %>',
                                                        '<%= Number(record.liters || 0) %>',
                                                        <%- JSON.stringify(record.remarks || "") %>
                                                    )"

                                                <% } %>
                                            >

                                                <textarea
                                                    class="remarks-input readonly-input"
                                                    readonly
                                                ><%= record.remarks || "" %></textarea>

                                                <% if (
                                                    record.recordedByType === "system" ||
                                                    record.recordedBySystem
                                                ) { %>

                                                    <div class="recorded system-record">

                                                        <span>
                                                            ⚙️
                                                        </span>

                                                        <span>
                                                            Automatically recorded
                                                            as Not Milked.
                                                        </span>

                                                    </div>

                                                <% } else { %>

                                                    <div class="recorded">

                                                        <span>
                                                            ✓
                                                        </span>

                                                        <span>
                                                            This cow has already
                                                            been recorded for
                                                            this session.
                                                        </span>

                                                    </div>

                                                <% } %>

                                                <% if (adminUser) { %>

                                                    <span class="admin-edit-hint">
                                                        Tap to edit
                                                    </span>

                                                <% } %>

                                            </div>


                                        <% } else if (
                                            currentSession === "morning" ||
                                            currentSession === "evening"
                                        ) %>


                                            <textarea
                                                class="remarks-input"
                                                name="records[<%= index %>][remarks]"
                                                placeholder="Optional remarks..."
                                            ></textarea>


                                        <% } else { %>


                                            <div class="closed-remarks">

                                                <span>
                                                    🔒
                                                </span>

                                                <span>
                                                    No new records can be
                                                    submitted during this period.
                                                </span>

                                            </div>


                                        <% } %>

                                    </td>

                                </tr>


                            <% }); %>

                        </tbody>

                    </table>

                </div>

            </div>



            <!-- ==================================================
                 SUBMIT AREA
            ================================================== -->

            <div class="milk-submit-card">

                <div class="submit-information">

                    <% if (currentSession === "morning") { %>

                        <div class="submit-icon">
                            🌅
                        </div>

                        <div>

                            <strong>
                                Morning collection
                            </strong>

                            <span>
                                Open until 10:00 AM.
                                Each cow can be recorded once.
                            </span>

                        </div>

                    <% } else if (currentSession === "closed") { %>

                        <div class="submit-icon">
                            🔒
                        </div>

                        <div>

                            <strong>
                                Submission is closed
                            </strong>

                            <span>
                                New records are unavailable until
                                4:00 PM.
                            </span>

                            <% if (adminUser) { %>

                                <span class="admin-session-note">
                                    You can still tap an existing
                                    morning record to edit it.
                                </span>

                            <% } %>

                        </div>

                    <% } else if (currentSession === "evening") { %>

                        <div class="submit-icon">
                            🌆
                        </div>

                        <div>

                            <strong>
                                Evening collection
                            </strong>

                            <span>
                                Open until midnight.
                                Each cow can be recorded once.
                            </span>

                        </div>

                    <% } else { %>

                        <div class="submit-icon">
                            🔒
                        </div>

                        <div>

                            <strong>
                                Collection unavailable
                            </strong>

                            <span>
                                The current collection window
                                is unavailable.
                            </span>

                        </div>

                    <% } %>

                </div>


                <button
                    type="submit"
                    class="submit-btn"
                    <% if (
                        currentSession !== "morning" &&
                        currentSession !== "evening"
                    ) { %>
                        disabled
                    <% } %>
                >

                    <span>
                        ✓
                    </span>

                    Submit Milk Records

                </button>

            </div>


        </form>


    <% } %>



</div>