<style>

/* =====================================================
   PAGE
===================================================== */

.milk-stats-page {

  width: 100%;
  max-width: 1100px;
  margin: 0 auto;
  padding: 20px 0 40px;

}


/* =====================================================
   HEADER
===================================================== */

.page-header {
  margin-bottom: 20px;
}

.page-header h2 {

  margin: 0 0 6px;

  color: #166534;

  font-size: 26px;

}

.page-header p {

  margin: 0;

  color: #6b7280;

  font-size: 14px;

}


/* =====================================================
   CARD
===================================================== */

.stats-card {

  margin-bottom: 20px;

  padding: 22px;

  border-radius: 15px;

  background: #ffffff;

  box-shadow: 0 6px 20px rgba(0,0,0,0.06);

}


/* =====================================================
   FILTER
===================================================== */

.stats-filter {

  display: flex;

  align-items: flex-end;

  gap: 12px;

  flex-wrap: wrap;

}

.filter-group {

  flex: 1;

  min-width: 180px;

}

.filter-group label {

  display: block;

  margin-bottom: 7px;

  color: #374151;

  font-size: 13px;

  font-weight: 700;

}

.filter-group input,
.filter-group select {

  width: 100%;

  padding: 11px 12px;

  border-radius: 9px;

  border: 1px solid #d1d5db;

  background: #f9fafb;

  font-family: inherit;

  outline: none;

}

.filter-group input:focus,
.filter-group select:focus {

  border-color: #16a34a;

  box-shadow: 0 0 0 3px rgba(22,163,74,0.1);

}

.filter-button {

  padding: 11px 20px;

  border: none;

  border-radius: 9px;

  background: #166534;

  color: white;

  font-weight: 700;

  cursor: pointer;

}

.filter-button:hover {

  background: #14532d;

}


/* =====================================================
   REPORT HEADER
===================================================== */

.report-header {

  display: flex;

  justify-content: space-between;

  align-items: center;

  gap: 15px;

  margin-bottom: 18px;

}

.report-header h3 {

  margin: 0;

  color: #374151;

  font-size: 20px;

}

.report-date {

  color: #6b7280;

  font-size: 13px;

}


/* =====================================================
   TABLE
===================================================== */

.table-wrapper {

  overflow-x: auto;

}

table {

  width: 100%;

  border-collapse: collapse;

}

th,
td {

  padding: 13px 15px;

  border-bottom: 1px solid #e5e7eb;

  text-align: left;

}

th {

  background: #f9fafb;

  color: #6b7280;

  font-size: 12px;

  text-transform: uppercase;

}

td {

  color: #4b5563;

  font-size: 14px;

}

tbody tr:hover {

  background: #f9fafb;

}

.animal-code {

  font-weight: 700;

  color: #166534;

}


/* =====================================================
   MILK SESSION INPUTS
===================================================== */

.milk-session-form {

  margin: 0;

}

.milk-session-cell {

  min-width: 135px;

}

.milk-input {

  width: 100%;

  min-width: 105px;

  box-sizing: border-box;

  padding: 9px 10px;

  border-radius: 8px;

  border: 1px solid #d1d5db;

  background: #f9fafb;

  color: #374151;

  font-family: inherit;

  font-size: 14px;

  font-weight: 600;

  outline: none;

  transition: all 0.15s ease;

}

.milk-input::placeholder {

  color: #9ca3af;

  font-weight: 400;

}

.milk-input:focus {

  border-color: #16a34a;

  background: #ffffff;

  box-shadow: 0 0 0 3px rgba(22,163,74,0.10);

}

.milk-input.session-closed {

  background: #f3f4f6;

  border-color: #e5e7eb;

  color: #6b7280;

  cursor: default;

}

.milk-input.session-open {

  background: #ffffff;

  border-color: #16a34a;

  cursor: text;

}

.milk-input.session-open:hover {

  border-color: #15803d;

}


/* =====================================================
   SESSION LABEL
===================================================== */

.session-label {

  display: block;

  margin-bottom: 5px;

  color: #6b7280;

  font-size: 10px;

  font-weight: 700;

  text-transform: uppercase;

}

.session-status {

  display: block;

  margin-top: 4px;

  font-size: 10px;

  color: #9ca3af;

}

.session-status.open {

  color: #166534;

}

.session-status.closed {

  color: #6b7280;

}


/* =====================================================
   TOTAL
===================================================== */

.total-cell {

  min-width: 100px;

}

.liters-value {

  font-weight: 700;

  color: #166534;

}

.daily-total {

  font-size: 15px;

  font-weight: 800;

  color: #166534;

}


/* =====================================================
   SAVE BUTTON
===================================================== */

.session-save-button {

  margin-top: 5px;

  width: 100%;

  padding: 6px 8px;

  border: none;

  border-radius: 6px;

  background: #166534;

  color: #ffffff;

  font-size: 11px;

  font-weight: 700;

  cursor: pointer;

}

.session-save-button:hover {

  background: #14532d;

}


/* =====================================================
   ADMIN EDIT INDICATOR
===================================================== */

.admin-edit-note {

  display: block;

  margin-top: 4px;

  color: #9ca3af;

  font-size: 9px;

}


/* =====================================================
   SUMMARY
===================================================== */

.summary-grid {

  display: grid;

  grid-template-columns:
    repeat(auto-fit,minmax(170px,1fr));

  gap: 15px;

  margin-top: 22px;

}

.summary-box {

  padding: 17px;

  border-radius: 12px;

  background: #f9fafb;

}

.summary-box span {

  display: block;

  margin-bottom: 7px;

  color: #6b7280;

  font-size: 12px;

}

.summary-box strong {

  color: #166534;

  font-size: 20px;

}


/* =====================================================
   STATUS
===================================================== */

.status-open {

  color: #166534 !important;

}

.status-locked {

  color: #b91c1c !important;

}


/* =====================================================
   SALES
===================================================== */

.sales-section {

  margin-top: 30px;

}

.sales-section h3 {

  margin-bottom: 15px;

  color: #374151;

}

.revenue-total {

  margin-top: 18px;

  padding: 17px;

  border-radius: 12px;

  background: #f0fdf4;

}

.revenue-total span {

  display: block;

  margin-bottom: 5px;

  color: #6b7280;

}

.revenue-total strong {

  color: #166534;

  font-size: 22px;

}


/* =====================================================
   EMPTY STATE
===================================================== */

.empty-state {

  padding: 45px 20px;

  text-align: center;

}

.empty-icon {

  font-size: 42px;

  margin-bottom: 10px;

}

.empty-state h3 {

  margin-bottom: 8px;

  color: #374151;

}

.empty-state p {

  color: #9ca3af;

  font-size: 14px;

}


/* =====================================================
   POPUP OVERLAY
===================================================== */

.milk-message-overlay {

  position: fixed;

  inset: 0;

  z-index: 9999;

  display: none;

  align-items: center;

  justify-content: center;

  padding: 20px;

  background: rgba(0,0,0,0.35);

  backdrop-filter: blur(2px);

}

.milk-message-overlay.show {

  display: flex;

}


/* =====================================================
   POPUP
===================================================== */

.milk-message-popup {

  width: 100%;

  max-width: 390px;

  padding: 28px 24px 24px;

  border-radius: 16px;

  background: #ffffff;

  box-shadow:
    0 20px 50px rgba(0,0,0,0.18);

  text-align: center;

  animation: milkPopupIn 0.18s ease-out;

}

@keyframes milkPopupIn {

  from {

    opacity: 0;

    transform: scale(0.94);

  }

  to {

    opacity: 1;

    transform: scale(1);

  }

}


/* =====================================================
   POPUP ICON
===================================================== */

.milk-message-icon {

  display: flex;

  align-items: center;

  justify-content: center;

  width: 58px;

  height: 58px;

  margin: 0 auto 15px;

  border-radius: 50%;

  font-size: 27px;

}


/* SUCCESS */

.milk-message-popup.success
.milk-message-icon {

  background: #dcfce7;

  color: #166534;

}


/* FAILURE */

.milk-message-popup.failure
.milk-message-icon {

  background: #fee2e2;

  color: #b91c1c;

}


/* =====================================================
   POPUP TITLE
===================================================== */

.milk-message-popup h3 {

  margin: 0 0 8px;

  color: #374151;

  font-size: 20px;

}


/* =====================================================
   POPUP MESSAGE
===================================================== */

.milk-message-popup p {

  margin: 0 0 22px;

  color: #6b7280;

  font-size: 14px;

  line-height: 1.5;

}


/* =====================================================
   POPUP BUTTON
===================================================== */

.milk-message-button {

  width: 100%;

  padding: 11px 18px;

  border: none;

  border-radius: 9px;

  background: #166534;

  color: #ffffff;

  font-family: inherit;

  font-size: 14px;

  font-weight: 700;

  cursor: pointer;

}

.milk-message-button:hover {

  background: #14532d;

}


/* =====================================================
   MOBILE
===================================================== */

@media(max-width:650px){

  .milk-stats-page {

    padding: 10px 0 30px;

  }

  .stats-card {

    padding: 16px;

  }

  .stats-filter {

    flex-direction: column;

    align-items: stretch;

  }

  .filter-button {

    width: 100%;

  }

  .report-header {

    flex-direction: column;

    align-items: flex-start;

  }

  th,
  td {

    white-space: nowrap;

    padding: 10px;

  }

  .milk-input {

    min-width: 95px;

  }

  .milk-message-popup {

    max-width: 340px;

    padding: 24px 20px 20px;

  }

}

</style>


<!-- =====================================================
     POPUP MESSAGE
===================================================== -->

<%
const popupSuccess =
  typeof success !== "undefined"
    ? success
    : false;

const popupError =
  typeof error !== "undefined"
    ? error
    : false;

const querySuccess =
  typeof query !== "undefined" &&
  query?.success === "1";

const queryError =
  typeof query !== "undefined" &&
  query?.error === "1";

const showSuccessPopup =
  popupSuccess === true ||
  popupSuccess === "1" ||
  querySuccess;

const showErrorPopup =
  popupError === true ||
  popupError === "1" ||
  queryError;
%>


<% if (showSuccessPopup || showErrorPopup) { %>

<div
  id="milkMessageOverlay"
  class="milk-message-overlay"
>


  <div
    class="milk-message-popup
      <%= showErrorPopup ? 'failure' : 'success' %>"
  >


    <div class="milk-message-icon">

      <%= showErrorPopup ? "✕" : "✓" %>

    </div>


    <h3>

      <%= showErrorPopup
        ? "Submission Failed"
        : "Milk Record Submitted" %>

    </h3>


    <p>

      <%= showErrorPopup
        ? "The milk record could not be saved. Please try again."
        : "The milk record was submitted successfully." %>

    </p>


    <button
      type="button"
      id="milkMessageButton"
      class="milk-message-button"
    >
      OK
    </button>


  </div>

</div>

<% } %>


<div class="milk-stats-page">


<!-- =====================================================
     HEADER
===================================================== -->

<div class="page-header">

  <h2>
    🥛 Milk Statistics
  </h2>

  <p>
    Review milk production, consumption, sales and revenue.
  </p>

</div>


<!-- =====================================================
     FILTER
===================================================== -->

<div class="stats-card">

<form
  method="GET"
  action="/stats"
  class="stats-filter"
>

  <div class="filter-group">

    <label>
      Report Type
    </label>

    <select name="type">

      <option
        value="day"
        <%= type === "day" ? "selected" : "" %>
      >
        Daily
      </option>

      <option
        value="month"
        <%= type === "month" ? "selected" : "" %>
      >
        Monthly
      </option>

    </select>

  </div>


  <div class="filter-group">

    <label>
      Select Date
    </label>

    <input
      type="date"
      name="date"
      value="<%= date || '' %>"
    >

  </div>


  <div class="filter-group">

    <label>
      Select Month
    </label>

    <input
      type="month"
      name="month"
      value="<%= month || '' %>"
    >

  </div>


  <button
    type="submit"
    class="filter-button"
  >
    🔍 View Report
  </button>

</form>

</div>


<!-- =====================================================
     DAILY REPORT
===================================================== -->

<% if (type === "day") { %>


<div class="stats-card">


<div class="report-header">

  <h3>
    Daily Milk Production
  </h3>

  <span class="report-date">
    <%= date || "Today" %>
  </span>

</div>


<%
/* =====================================================
   DAILY RECORD PREPARATION

   Group records by cow.

   Each cow receives:
   - morning record
   - evening record
   - daily cumulative total
===================================================== */

const dailyMilkByCow = {};

if (records && records.length > 0) {

  records.forEach(record => {

    const dairyId = record.dairy?._id
      ? String(record.dairy._id)
      : `unknown-${record.dairy?.code || "animal"}`;


    if (!dailyMilkByCow[dairyId]) {

      dailyMilkByCow[dairyId] = {

        dairy: record.dairy || null,

        morning: null,

        evening: null

      };

    }


    const session =
      String(
        record.session ||
        record.milkingSession ||
        record.period ||
        ""
      ).toLowerCase();


    if (
      session === "morning" ||
      session === "am"
    ) {

      dailyMilkByCow[dairyId].morning = record;

    }


    else if (
      session === "evening" ||
      session === "pm"
    ) {

      dailyMilkByCow[dairyId].evening = record;

    }

  });

}


const dailyMilkRecords =
  Object.values(dailyMilkByCow);


/* =====================================================
   SESSION STATE
===================================================== */

const currentSession =
  typeof session !== "undefined"
    ? session
    : null;


const isAdmin =
  typeof user !== "undefined" &&
  user?.role === "admin";


const morningWindowOpen =
  typeof morningOpen !== "undefined"
    ? morningOpen
    : currentSession === "morning";


const eveningWindowOpen =
  typeof eveningOpen !== "undefined"
    ? eveningOpen
    : currentSession === "evening";

%>


<div class="table-wrapper">

<table>

<thead>

<tr>

  <th>
    Code
  </th>

  <th>
    Animal
  </th>

  <th>
    Morning
  </th>

  <th>
    Evening
  </th>

  <th>
    Total
  </th>

</tr>

</thead>


<tbody>


<% if (dailyMilkRecords.length > 0) { %>


<% dailyMilkRecords.forEach(record => {

  const dairy =
    record.dairy || null;


  const morning =
    record.morning;


  const evening =
    record.evening;


  const morningLiters =
    Number(morning?.liters || 0);


  const eveningLiters =
    Number(evening?.liters || 0);


  const dailyTotal =
    morningLiters + eveningLiters;


  const dairyId =
    dairy?._id
      ? String(dairy._id)
      : "";


  const morningEditable =
    isAdmin || morningWindowOpen;


  const eveningEditable =
    isAdmin || eveningWindowOpen;

%>


<tr>


<!-- =====================================================
     CODE
===================================================== -->

<td>

  <span class="animal-code">

    <%= dairy
      ? dairy.code
      : "Unknown" %>

  </span>

</td>


<!-- =====================================================
     ANIMAL
===================================================== -->

<td>

  <%= dairy
    ? dairy.name
    : "Unknown Animal" %>

</td>


<!-- =====================================================
     MORNING
===================================================== -->

<td class="milk-session-cell">


<form
  method="POST"
  action="/milk"
  class="milk-session-form"
>


<input
  type="hidden"
  name="dairyId"
  value="<%= dairyId %>"
>


<input
  type="hidden"
  name="date"
  value="<%= date || '' %>"
>


<input
  type="hidden"
  name="session"
  value="morning"
>


<label class="session-label">
  Morning
</label>


<input
  type="number"
  name="liters"
  min="0"
  step="0.01"
  value="<%= morning
    ? Number(morning.liters || 0)
    : '' %>"
  placeholder="0.00 L"
  class="milk-input
    <%= morningWindowOpen || isAdmin
      ? 'session-open'
      : 'session-closed' %>"
  <%= morningEditable ? "" : "readonly" %>
>


<% if (morningEditable) { %>

<button
  type="submit"
  class="session-save-button"
>
  Save
</button>

<% } else { %>

<span class="session-status closed">
  🔒 Closed
</span>

<% } %>


<% if (isAdmin && !morningWindowOpen) { %>

<span class="admin-edit-note">
  Admin edit
</span>

<% } %>


</form>

</td>


<!-- =====================================================
     EVENING
===================================================== -->

<td class="milk-session-cell">


<form
  method="POST"
  action="/milk"
  class="milk-session-form"
>


<input
  type="hidden"
  name="dairyId"
  value="<%= dairyId %>"
>


<input
  type="hidden"
  name="date"
  value="<%= date || '' %>"
>


<input
  type="hidden"
  name="session"
  value="evening"
>


<label class="session-label">
  Evening
</label>


<input
  type="number"
  name="liters"
  min="0"
  step="0.01"
  value="<%= evening
    ? Number(evening.liters || 0)
    : '' %>"
  placeholder="0.00 L"
  class="milk-input
    <%= eveningWindowOpen || isAdmin
      ? 'session-open'
      : 'session-closed' %>"
  <%= eveningEditable ? "" : "readonly" %>
>


<% if (eveningEditable) { %>

<button
  type="submit"
  class="session-save-button"
>
  Save
</button>

<% } else { %>

<span class="session-status closed">
  🔒 Closed
</span>

<% } %>


<% if (isAdmin && !eveningWindowOpen) { %>

<span class="admin-edit-note">
  Admin edit
</span>

<% } %>


</form>

</td>


<!-- =====================================================
     DAILY TOTAL
===================================================== -->

<td class="total-cell">

<span class="daily-total">

  <%= dailyTotal.toFixed(2) %> L

</span>

</td>


</tr>


<% }) %>


<% } else { %>


<tr>

<td colspan="5">


<div class="empty-state">

<div class="empty-icon">
  🥛
</div>

<h3>
  No Milk Records
</h3>

<p>
  No milk production records were found for this date.
</p>

</div>


</td>

</tr>


<% } %>


</tbody>

</table>

</div>


<!-- =====================================================
     DAILY SUMMARY
===================================================== -->

<div class="summary-grid">


<div class="summary-box">

<span>
  Total Milk
</span>

<strong>
  <%= Number(stats?.total || 0) %> L
</strong>

</div>


<div class="summary-box">

<span>
  Consumed
</span>

<strong>
  <%= Number(stats?.consumed || 0) %> L
</strong>

</div>


<div class="summary-box">

<span>
  Available
</span>

<strong>
  <%= Number(stats?.available || 0) %> L
</strong>

</div>


<div class="summary-box">

<span>
  Price Per Liter
</span>

<strong>
  KES <%= Number(stats?.price || 0) %>
</strong>

</div>


<div class="summary-box">

<span>
  Total Revenue
</span>

<strong>
  KES <%= Number(stats?.cash || 0) %>
</strong>

</div>


<div class="summary-box">

<span>
  Status
</span>


<% if (stats?.locked) { %>

<strong class="status-locked">
  🔒 Locked
</strong>

<% } else { %>

<strong class="status-open">
  🟢 Open
</strong>

<% } %>


</div>


</div>


<!-- =====================================================
     CUSTOMER SALES
===================================================== -->

<% if (sales && sales.length > 0) { %>


<div class="sales-section">


<h3>
  Customer Sales Breakdown
</h3>


<div class="table-wrapper">


<table>

<thead>

<tr>

<th>
  Customer
</th>

<th>
  Liters
</th>

<th>
  Cash
</th>

</tr>

</thead>


<tbody>


<% sales.forEach(sale => { %>


<tr>

<td>
  <%= sale.customerName || "Unknown Customer" %>
</td>


<td>
  <%= Number(sale.liters || 0) %> L
</td>


<td>
  KES <%= Number(sale.cash || 0) %>
</td>

</tr>


<% }) %>


</tbody>

</table>

</div>


<%

const totalCustomerRevenue =
  sales.reduce(

    (total, sale) =>

      total + Number(sale.cash || 0),

    0

  );

%>


<div class="revenue-total">

<span>
  Total Customer Revenue
</span>

<strong>
  KES <%= totalCustomerRevenue %>
</strong>

</div>


</div>


<% } %>


</div>


<% } %>


<!-- =====================================================
     MONTHLY REPORT
===================================================== -->

<% if (type === "month") { %>


<div class="stats-card">


<div class="report-header">

<h3>
  Monthly Milk Report
</h3>

<span class="report-date">
  <%= month || "Current Month" %>
</span>

</div>


<div class="table-wrapper">


<table>

<thead>

<tr>

<th>
  Code
</th>

<th>
  Animal
</th>

<th>
  Total Milk
</th>

<th>
  Average
</th>

</tr>

</thead>


<tbody>


<% if (records && records.length > 0) { %>


<% records.forEach(record => { %>


<tr>


<td>

<span class="animal-code">

<%= record.dairy
  ? record.dairy.code
  : "Unknown" %>

</span>

</td>


<td>

<%= record.dairy
  ? record.dairy.name
  : "Unknown Animal" %>

</td>


<td>

<span class="liters-value">

<%= Number(record.total || 0).toFixed(2) %> L

</span>

</td>


<td>

<%= Number(record.avg || 0).toFixed(2) %> L

</td>


</tr>


<% }) %>


<% } else { %>


<tr>

<td colspan="4">


<div class="empty-state">

<div class="empty-icon">
  📊
</div>

<h3>
  No Monthly Records
</h3>

<p>
  No milk production records were found for this month.
</p>

</div>


</td>

</tr>


<% } %>


</tbody>

</table>

</div>


<div class="summary-grid">


<div class="summary-box">

<span>
  Total Milk
</span>

<strong>
  <%= Number(stats?.total || 0).toFixed(2) %> L
</strong>

</div>


<div class="summary-box">

<span>
  Total Sold
</span>

<strong>
  <%= Number(stats?.consumed || 0).toFixed(2) %> L
</strong>

</div>


