<% /*
==========================================================
MILK COLLECTION PAGE

FILE:
views/milk.ejs

PURPOSE:
----------------------------------------------------------
• Display all currently milking dairy animals
• Display morning / evening milk records
• Allow normal users to submit milk
• Allow administrators to edit existing records
• Show current collection session
• Show submission status
• Show validation / success messages

EXPECTED CONTROLLER DATA:
----------------------------------------------------------
dairies
session
isAdmin
user
success
error

EACH DAIRY MAY CONTAIN:
----------------------------------------------------------
dairy._id
dairy.name
dairy.code
dairy.isMilking

dairy.morning
dairy.evening

dairy.morningRecorded
dairy.eveningRecorded

dairy.morningLiters
dairy.eveningLiters

SESSION VALUES:
----------------------------------------------------------
morning
closed
evening

==========================================================
*/ %>


<style>

/* ==========================================================
   PAGE
========================================================== */

.milk-page {
    width: 100%;
    max-width: 1180px;
    margin: 0 auto;
    padding: 22px 16px 50px;
    box-sizing: border-box;
    color: #183528;
    font-family:
        Inter,
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;
}


/* ==========================================================
   SVG ICON
========================================================== */

.milk-icon {
    width: 20px;
    height: 20px;
    display: inline-block;
    flex: 0 0 auto;
    stroke: currentColor;
    stroke-width: 2;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
}

.milk-icon-lg {
    width: 26px;
    height: 26px;
}


/* ==========================================================
   HERO
========================================================== */

.milk-hero {
    position: relative;
    overflow: hidden;
    background:
        linear-gradient(
            135deg,
            #f1f9f3 0%,
            #ffffff 52%,
            #edf7f0 100%
        );
    border: 1px solid #d8eadc;
    border-radius: 24px;
    padding: 28px;
    margin-bottom: 18px;
    box-shadow:
        0 8px 30px rgba(31, 92, 52, 0.07);
}

.milk-hero::after {
    content: "";
    position: absolute;
    width: 210px;
    height: 210px;
    right: -75px;
    top: -85px;
    border-radius: 50%;
    background: rgba(50, 137, 75, 0.07);
}

.milk-hero-content {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 22px;
}

.milk-title-wrap {
    display: flex;
    align-items: flex-start;
    gap: 15px;
}

.milk-title-icon {
    width: 52px;
    height: 52px;
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #23733d;
    background: #dff1e3;
    flex: 0 0 auto;
}

.milk-title {
    margin: 0;
    font-size: clamp(25px, 4vw, 34px);
    line-height: 1.1;
    font-weight: 800;
    letter-spacing: -0.7px;
    color: #163b27;
}

.milk-subtitle {
    margin: 8px 0 0;
    color: #61786a;
    font-size: 14px;
    line-height: 1.6;
    max-width: 680px;
}


/* ==========================================================
   SESSION BADGE
========================================================== */

.milk-session-box {
    position: relative;
    z-index: 1;
    min-width: 155px;
    padding: 13px 16px;
    border-radius: 16px;
    background: #ffffff;
    border: 1px solid #dce9df;
    box-shadow: 0 5px 18px rgba(31, 92, 52, 0.06);
}

.milk-session-label {
    display: block;
    margin-bottom: 6px;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: .7px;
    font-weight: 700;
    color: #799080;
}

.milk-session-value {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 15px;
    font-weight: 800;
    color: #286d3e;
}

.milk-session-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #35a957;
    box-shadow: 0 0 0 4px #e4f5e8;
}

.milk-session-dot.closed {
    background: #89968d;
    box-shadow: 0 0 0 4px #edf0ee;
}


/* ==========================================================
   ALERTS
========================================================== */

.milk-alert {
    display: flex;
    align-items: flex-start;
    gap: 11px;
    padding: 14px 16px;
    border-radius: 14px;
    margin-bottom: 16px;
    font-size: 14px;
    line-height: 1.5;
}

.milk-alert.success {
    color: #236438;
    background: #edf8ef;
    border: 1px solid #cfe9d4;
}

.milk-alert.error {
    color: #9a3e35;
    background: #fff3f1;
    border: 1px solid #f1d1cd;
}

.milk-alert strong {
    font-weight: 800;
}


/* ==========================================================
   SESSION INFORMATION
========================================================== */

.milk-session-info {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin-bottom: 20px;
}

.milk-info-card {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 15px;
    background: #ffffff;
    border: 1px solid #e0ebe3;
    border-radius: 16px;
}

.milk-info-icon {
    width: 40px;
    height: 40px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #2e7d46;
    background: #edf7ef;
}

.milk-info-label {
    font-size: 11px;
    color: #7a8c81;
    text-transform: uppercase;
    letter-spacing: .5px;
    font-weight: 700;
}

.milk-info-value {
    margin-top: 2px;
    font-size: 14px;
    color: #294d38;
    font-weight: 750;
}


/* ==========================================================
   SECTION HEADER
========================================================== */

.milk-section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    margin: 25px 0 12px;
}

.milk-section-title {
    margin: 0;
    font-size: 18px;
    font-weight: 800;
    color: #183b28;
}

.milk-section-count {
    padding: 5px 10px;
    border-radius: 999px;
    background: #edf7ef;
    color: #2b7541;
    font-size: 12px;
    font-weight: 800;
}


/* ==========================================================
   ANIMAL LIST
========================================================== */

.milk-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
}


/* ==========================================================
   ANIMAL CARD
========================================================== */

.milk-animal-card {
    background: #ffffff;
    border: 1px solid #dfeae2;
    border-radius: 19px;
    overflow: hidden;
    box-shadow:
        0 5px 20px rgba(31, 92, 52, 0.045);
    transition:
        border-color .2s ease,
        box-shadow .2s ease,
        transform .2s ease;
}

.milk-animal-card:hover {
    border-color: #c5ddcb;
    box-shadow:
        0 8px 26px rgba(31, 92, 52, 0.075);
}


/* ==========================================================
   ANIMAL HEADER
========================================================== */

.milk-animal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    padding: 15px 17px;
    background: #fbfdfb;
    border-bottom: 1px solid #edf2ee;
}

.milk-animal-identity {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
}

.milk-animal-avatar {
    width: 43px;
    height: 43px;
    flex: 0 0 auto;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #e4f2e7;
    color: #287442;
}

.milk-animal-name {
    margin: 0;
    color: #1e432e;
    font-size: 15px;
    font-weight: 800;
}

.milk-animal-code {
    margin-top: 3px;
    color: #829188;
    font-size: 12px;
}

.milk-milking-status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 10px;
    border-radius: 999px;
    color: #27703d;
    background: #edf8ef;
    font-size: 11px;
    font-weight: 800;
    white-space: nowrap;
}

.milk-milking-status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #39a656;
}


/* ==========================================================
   SESSION COLUMNS
========================================================== */

.milk-session-columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
}

.milk-session-column {
    padding: 18px;
    min-width: 0;
}

.milk-session-column + .milk-session-column {
    border-left: 1px solid #edf1ee;
}

.milk-session-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 13px;
}

.milk-session-heading-left {
    display: flex;
    align-items: center;
    gap: 8px;
}

.milk-session-heading-icon {
    width: 31px;
    height: 31px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.milk-session-heading-icon.morning {
    background: #fff5d9;
    color: #9b741d;
}

.milk-session-heading-icon.evening {
    background: #edf0fb;
    color: #596ca8;
}

.milk-session-heading-title {
    font-size: 13px;
    font-weight: 800;
    color: #345340;
}

.milk-recorded-badge {
    padding: 4px 8px;
    border-radius: 999px;
    background: #eaf6ed;
    color: #2c7743;
    font-size: 10px;
    font-weight: 800;
}


/* ==========================================================
   RECORDED VALUE
========================================================== */

.milk-recorded-box {
    padding: 15px;
    border-radius: 14px;
    background: #f5faf6;
    border: 1px solid #dcecdf;
}

.milk-recorded-value {
    display: flex;
    align-items: baseline;
    gap: 5px;
}

.milk-recorded-number {
    font-size: 26px;
    font-weight: 850;
    line-height: 1;
    color: #216438;
}

.milk-recorded-unit {
    font-size: 12px;
    color: #718378;
    font-weight: 700;
}

.milk-recorded-remarks {
    margin-top: 8px;
    font-size: 11px;
    line-height: 1.45;
    color: #718178;
}


/* ==========================================================
   FORM
========================================================== */

.milk-form {
    width: 100%;
}

.milk-field-label {
    display: block;
    margin-bottom: 7px;
    color: #53695b;
    font-size: 11px;
    font-weight: 750;
}

.milk-input-wrap {
    position: relative;
}

.milk-input {
    width: 100%;
    height: 45px;
    box-sizing: border-box;
    border: 1px solid #d5e2d8;
    border-radius: 12px;
    background: #ffffff;
    color: #193d29;
    outline: none;
    padding: 0 55px 0 13px;
    font-size: 15px;
    font-weight: 650;
    transition:
        border-color .2s ease,
        box-shadow .2s ease;
}

.milk-input:focus {
    border-color: #5ca76d;
    box-shadow:
        0 0 0 3px rgba(71, 150, 88, .11);
}

.milk-input::placeholder {
    color: #a3afa7;
    font-weight: 500;
}

.milk-input-unit {
    position: absolute;
    right: 13px;
    top: 50%;
    transform: translateY(-50%);
    color: #87968c;
    font-size: 11px;
    font-weight: 750;
    pointer-events: none;
}

.milk-remarks-input {
    margin-top: 9px;
}

.milk-remarks-input .milk-input {
    padding-right: 13px;
    font-size: 12px;
}


/* ==========================================================
   SUBMIT BUTTON
========================================================== */

.milk-submit {
    width: 100%;
    min-height: 43px;
    margin-top: 10px;
    border: 0;
    border-radius: 12px;
    background: #2f8448;
    color: #ffffff;
    font-size: 13px;
    font-weight: 800;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    transition:
        background .2s ease,
        transform .15s ease,
        box-shadow .2s ease;
    box-shadow:
        0 5px 14px rgba(47, 132, 72, .17);
}

.milk-submit:hover {
    background: #256f3b;
}

.milk-submit:active {
    transform: translateY(1px);
}

.milk-submit:disabled {
    cursor: not-allowed;
    opacity: .65;
}


/* ==========================================================
   CLOSED STATE
========================================================== */

.milk-closed-box {
    padding: 14px;
    border-radius: 13px;
    border: 1px dashed #d5dfd8;
    background: #fafcfb;
    color: #7a8980;
    font-size: 12px;
    line-height: 1.5;
}

.milk-closed-box strong {
    color: #53665a;
}


/* ==========================================================
   ADMIN EDIT
========================================================== */

.milk-admin-edit {
    margin-top: 10px;
}

.milk-edit-button {
    width: 100%;
    min-height: 41px;
    border: 1px solid #cfe1d3;
    border-radius: 11px;
    background: #ffffff;
    color: #2d7041;
    cursor: pointer;
    font-size: 12px;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    transition: .2s ease;
}

.milk-edit-button:hover {
    background: #f1f8f3;
    border-color: #a8cdb0;
}


/* ==========================================================
   EMPTY STATE
========================================================== */

.milk-empty {
    text-align: center;
    padding: 55px 20px;
    background: #ffffff;
    border: 1px dashed #cfddd2;
    border-radius: 20px;
}

.milk-empty-icon {
    width: 60px;
    height: 60px;
    margin: 0 auto 14px;
    border-radius: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #559066;
    background: #edf7ef;
}

.milk-empty-title {
    margin: 0;
    color: #365442;
    font-size: 16px;
    font-weight: 800;
}

.milk-empty-text {
    margin: 7px auto 0;
    max-width: 450px;
    color: #849188;
    font-size: 13px;
    line-height: 1.55;
}


/* ==========================================================
   EDIT MODAL
========================================================== */

.milk-modal {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 18px;
    background: rgba(18, 43, 28, .38);
    backdrop-filter: blur(4px);
}

.milk-modal.active {
    display: flex;
}

.milk-modal-card {
    width: 100%;
    max-width: 450px;
    background: #ffffff;
    border-radius: 21px;
    padding: 22px;
    box-sizing: border-box;
    box-shadow:
        0 25px 70px rgba(15, 43, 25, .22);
    animation: milkModalIn .18s ease-out;
}

@keyframes milkModalIn {
    from {
        opacity: 0;
        transform: translateY(8px) scale(.98);
    }

    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }
}

.milk-modal-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 15px;
    margin-bottom: 20px;
}

.milk-modal-title {
    margin: 0;
    color: #183d28;
    font-size: 19px;
    font-weight: 850;
}

.milk-modal-subtitle {
    margin: 5px 0 0;
    color: #7a897f;
    font-size: 12px;
}

.milk-modal-close {
    width: 35px;
    height: 35px;
    border: 0;
    border-radius: 10px;
    background: #f0f5f1;
    color: #52645a;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
}

.milk-modal-close:hover {
    background: #e5eee7;
}

.milk-modal-actions {
    display: flex;
    gap: 9px;
    margin-top: 17px;
}

.milk-modal-cancel,
.milk-modal-save {
    flex: 1;
    min-height: 43px;
    border-radius: 11px;
    font-size: 12px;
    font-weight: 800;
    cursor: pointer;
}

.milk-modal-cancel {
    border: 1px solid #d9e3dc;
    background: #ffffff;
    color: #5e6f65;
}

.milk-modal-save {
    border: 0;
    background: #2f8448;
    color: #ffffff;
}


/* ==========================================================
   RESPONSIVE
========================================================== */

@media (max-width: 760px) {

    .milk-page {
        padding: 14px 11px 35px;
    }

    .milk-hero {
        padding: 21px 17px;
        border-radius: 19px;
    }

    .milk-hero-content {
        align-items: flex-start;
        flex-direction: column;
    }

    .milk-session-box {
        width: 100%;
        box-sizing: border-box;
    }

    .milk-session-info {
        grid-template-columns: 1fr;
    }

    .milk-session-columns {
        grid-template-columns: 1fr;
    }

    .milk-session-column + .milk-session-column {
        border-left: 0;
        border-top: 1px solid #edf1ee;
    }

    .milk-animal-header {
        padding: 13px;
    }

    .milk-session-column {
        padding: 15px;
    }

}


@media (max-width: 430px) {

    .milk-title-wrap {
        gap: 11px;
    }

    .milk-title-icon {
        width: 45px;
        height: 45px;
        border-radius: 13px;
    }

    .milk-title {
        font-size: 24px;
    }

    .milk-subtitle {
        font-size: 13px;
    }

    .milk-milking-status {
        padding: 5px 8px;
        font-size: 10px;
    }

}


/* ==========================================================
   REDUCE MOTION
========================================================== */

@media (prefers-reduced-motion: reduce) {

    .milk-animal-card,
    .milk-submit,
    .milk-edit-button {
        transition: none;
    }

    .milk-modal-card {
        animation: none;
    }

}

</style>


<!-- ==========================================================
     SVG ICON DEFINITIONS
========================================================== -->

<svg
    xmlns="http://www.w3.org/2000/svg"
    style="display:none;"
    aria-hidden="true"
>

    <symbol
        id="milk-cow"
        viewBox="0 0 24 24"
    >
        <path d="M4 9.5h16v8a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2z"/>
        <path d="M7 9.5V7a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v2.5"/>
        <path d="M8 5 6 3M16 5l2-2"/>
        <path d="M8 13h.01M16 13h.01"/>
        <path d="M10 16c1.2 1 2.8 1 4 0"/>
    </symbol>


    <symbol
        id="milk-droplet"
        viewBox="0 0 24 24"
    >
        <path d="M12 3s6 6.1 6 11a6 6 0 0 1-12 0c0-4.9 6-11 6-11z"/>
        <path d="M9.5 15.5a3 3 0 0 0 3 2.5"/>
    </symbol>


    <symbol
        id="milk-sun"
        viewBox="0 0 24 24"
    >
        <circle cx="12" cy="12" r="4"/>
        <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
    </symbol>


    <symbol
        id="milk-moon"
        viewBox="0 0 24 24"
    >
        <path d="M21 14.8A8.5 8.5 0 0 1 9.2 3 8.5 8.5 0 1 0 21 14.8z"/>
    </symbol>


    <symbol
        id="milk-check"
        viewBox="0 0 24 24"
    >
        <path d="m5 12 4 4L19 6"/>
    </symbol>


    <symbol
        id="milk-edit"
        viewBox="0 0 24 24"
    >
        <path d="M12 20h9"/>
        <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4z"/>
    </symbol>


    <symbol
        id="milk-clock"
        viewBox="0 0 24 24"
    >
        <circle cx="12" cy="12" r="9"/>
        <path d="M12 7v5l3 2"/>
    </symbol>


    <symbol
        id="milk-info"
        viewBox="0 0 24 24"
    >
        <circle cx="12" cy="12" r="9"/>
        <path d="M12 11v5"/>
        <path d="M12 8h.01"/>
    </symbol>


    <symbol
        id="milk-x"
        viewBox="0 0 24 24"
    >
        <path d="m7 7 10 10M17 7 7 17"/>
    </symbol>


    <symbol
        id="milk-save"
        viewBox="0 0 24 24"
    >
        <path d="M5 4h12l2 2v14H5z"/>
        <path d="M8 4v5h8V4"/>
        <path d="M8 20v-6h8v6"/>
    </symbol>


    <symbol
        id="milk-alert"
        viewBox="0 0 24 24"
    >
        <path d="M10.3 4.5 2.8 18a2 2 0 0 0 1.7 3h15a2 2 0 0 0 1.7-3L13.7 4.5a2 2 0 0 0-3.4 0z"/>
        <path d="M12 9v4"/>
        <path d="M12 17h.01"/>
    </symbol>

</svg>


<!-- ==========================================================
     PAGE
========================================================== -->

<div class="milk-page">


    <!-- ======================================================
         HERO
    ======================================================= -->

    <section class="milk-hero">

        <div class="milk-hero-content">

            <div class="milk-title-wrap">

                <div class="milk-title-icon">

                    <svg
                        class="milk-icon milk-icon-lg"
                        aria-hidden="true"
                    >
                        <use href="#milk-droplet"></use>
                    </svg>

                </div>

                <div>

                    <h1 class="milk-title">
                        Milk Collection
                    </h1>

                    <p class="milk-subtitle">
                        Record the milk produced by each milking
                        animal during the current collection session.
                    </p>

                </div>

            </div>


            <div class="milk-session-box">

                <span class="milk-session-label">
                    Current session
                </span>

                <span class="milk-session-value">

                    <span
                        class="milk-session-dot <%= session === 'closed' ? 'closed' : '' %>"
                    ></span>

                    <%= session === "morning"
                        ? "Morning Collection"
                        : session === "evening"
                            ? "Evening Collection"
                            : "Collection Closed"
                    %>

                </span>

            </div>

        </div>

    </section>


    <!-- ======================================================
         ALERTS
    ======================================================= -->

    <% if (success) { %>

        <div
            class="milk-alert success"
            role="status"
        >

            <svg
                class="milk-icon"
                aria-hidden="true"
            >
                <use href="#milk-check"></use>
            </svg>

            <div>
                <strong>Milk record saved successfully.</strong>
                The collection record has been recorded.
            </div>

        </div>

    <% } %>


    <% if (error) { %>

        <div
            class="milk-alert error"
            role="alert"
        >

            <svg
                class="milk-icon"
                aria-hidden="true"
            >
                <use href="#milk-alert"></use>
            </svg>

            <div>
                <strong>Unable to save milk record.</strong>
                <%= error %>
            </div>

        </div>

    <% } %>


    <!-- ======================================================
         SESSION INFORMATION
    ======================================================= -->

    <section class="milk-session-info">


        <div class="milk-info-card">

            <div class="milk-info-icon">

                <svg
                    class="milk-icon"
                    aria-hidden="true"
                >
                    <use href="#milk-clock"></use>
                </svg>

            </div>

            <div>

                <div class="milk-info-label">
                    Collection window
                </div>

                <div class="milk-info-value">

                    <% if (session === "morning") { %>
                        Morning · Until 10:00 AM
                    <% } else if (session === "evening") { %>
                        Evening · From 4:00 PM
                    <% } else { %>
                        Currently closed
                    <% } %>

                </div>

            </div>

        </div>


        <div class="milk-info-card">

            <div class="milk-info-icon">

                <svg
                    class="milk-icon"
                    aria-hidden="true"
                >
                    <use href="#milk-cow"></use>
                </svg>

            </div>

            <div>

                <div class="milk-info-label">
                    Milking animals
                </div>

                <div class="milk-info-value">
                    <%= dairies.length %> registered
                </div>

            </div>

        </div>


        <div class="milk-info-card">

            <div class="milk-info-icon">

                <svg
                    class="milk-icon"
                    aria-hidden="true"
                >
                    <use href="#milk-check"></use>
                </svg>

            </div>

            <div>

                <div class="milk-info-label">
                    Access
                </div>

                <div class="milk-info-value">
                    <%= isAdmin ? "Administrator" : "Milk Worker" %>
                </div>

            </div>

        </div>


    </section>


    <!-- ======================================================
         ANIMAL SECTION
    ======================================================= -->

    <div class="milk-section-header">

        <h2 class="milk-section-title">
            Today's Milk Records
        </h2>

        <span class="milk-section-count">
            <%= dairies.length %>
            <%= dairies.length === 1 ? "animal" : "animals" %>
        </span>

    </div>


    <% if (!dairies.length) { %>

        <!-- ==================================================
             EMPTY STATE
        =================================================== -->

        <section class="milk-empty">

            <div class="milk-empty-icon">

                <svg
                    class="milk-icon milk-icon-lg"
                    aria-hidden="true"
                >
                    <use href="#milk-cow"></use>
                </svg>

            </div>

            <h3 class="milk-empty-title">
                No milking animals
            </h3>

            <p class="milk-empty-text">
                There are currently no dairy animals marked as
                actively milking.
            </p>

        </section>

    <% } else { %>


        <section class="milk-list">


            <% dairies.forEach((dairy) => { %>

                <article class="milk-animal-card">


                    <!-- ======================================
                         ANIMAL HEADER
                    ======================================= -->

                    <header class="milk-animal-header">

                        <div class="milk-animal-identity">

                            <div class="milk-animal-avatar">

                                <svg
                                    class="milk-icon"
                                    aria-hidden="true"
                                >
                                    <use href="#milk-cow"></use>
                                </svg>

                            </div>

                            <div>

                                <h3 class="milk-animal-name">

                                    <%= dairy.name ||
                                        `Dairy Animal ${dairy.code ?? ""}`
                                    %>

                                </h3>

                                <div class="milk-animal-code">

                                    <% if (dairy.code !== undefined &&
                                           dairy.code !== null) { %>

                                        Animal code:
                                        <strong>
                                            <%= dairy.code %>
                                        </strong>

                                    <% } else { %>

                                        Dairy animal

                                    <% } %>

                                </div>

                            </div>

                        </div>


                        <span class="milk-milking-status">

                            <span class="milk-milking-status-dot"></span>

                            Milking

                        </span>

                    </header>


                    <!-- ======================================
                         MORNING / EVENING
                    ======================================= -->

                    <div class="milk-session-columns">


                        <!-- ==================================
                             MORNING
                        =================================== -->

                        <div class="milk-session-column">

                            <div class="milk-session-heading">

                                <div class="milk-session-heading-left">

                                    <span class="milk-session-heading-icon morning">

                                        <svg
                                            class="milk-icon"
                                            aria-hidden="true"
                                        >
                                            <use href="#milk-sun"></use>
                                        </svg>

                                    </span>

                                    <span class="milk-session-heading-title">
                                        Morning
                                    </span>

                                </div>


                                <% if (dairy.morningRecorded) { %>

                                    <span class="milk-recorded-badge">
                                        Recorded
                                    </span>

                                <% } %>

                            </div>


                            <% if (dairy.morningRecorded) { %>

                                <!-- ==========================
                                     RECORDED MORNING
                                =========================== -->

                                <div class="milk-recorded-box">

                                    <div class="milk-recorded-value">

                                        <span class="milk-recorded-number">
                                            <%= Number(
                                                dairy.morningLiters || 0
                                            ).toFixed(2) %>
                                        </span>

                                        <span class="milk-recorded-unit">
                                            litres
                                        </span>

                                    </div>


                                    <% if (
                                        dairy.morning &&
                                        dairy.morning.remarks
                                    ) { %>

                                        <div class="milk-recorded-remarks">
                                            <%= dairy.morning.remarks %>
                                        </div>

                                    <% } %>

                                </div>


                                <% if (
                                    isAdmin &&
                                    (
                                        session === "morning" ||
                                        session === "closed"
                                    ) &&
                                    dairy.morning &&
                                    dairy.morning._id
                                ) { %>

                                    <div class="milk-admin-edit">

                                        <button
                                            type="button"
                                            class="milk-edit-button"
                                            onclick="openMilkEditModal(
                                                '<%= dairy.morning._id %>',
                                                '<%= dairy.morningLiters ?? 0 %>',
                                                '<%= String(dairy.morning.remarks || '').replace(/'/g, '&#39;') %>',
                                                'Morning'
                                            )"
                                        >

                                            <svg
                                                class="milk-icon"
                                                aria-hidden="true"
                                            >
                                                <use href="#milk-edit"></use>
                                            </svg>

                                            Edit morning record

                                        </button>

                                    </div>

                                <% } %>


                            <% } else if (session === "morning") { %>


                                <!-- ==========================
                                     MORNING FORM
                                =========================== -->

