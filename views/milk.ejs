<%
/* ==========================================================
   MILK COLLECTION PAGE
========================================================== */

const pageError =
    typeof error !== "undefined" && error
        ? error
        : "";

const pageSuccess =
    typeof success !== "undefined"
        ? Boolean(success)
        : false;


/* ==========================================================
   SESSION
========================================================== */

const currentSession =
    typeof session !== "undefined" && session
        ? session
        : "";


/* ==========================================================
   USER
========================================================== */

const currentUser =
    typeof user !== "undefined" && user
        ? user
        : null;

const adminUser =
    Boolean(
        currentUser &&
        currentUser.role === "admin"
    );

const dairyWorker =
    Boolean(
        currentUser &&
        currentUser.role === "dairyWorker"
    );


/* ==========================================================
   ACTIVE FARM
========================================================== */

const activeFarm =
    typeof currentDairy !== "undefined" && currentDairy
        ? currentDairy
        : (
            typeof currentFarm !== "undefined" && currentFarm
                ? currentFarm
                : null
        );


const activeFarmName =
    activeFarm && activeFarm.name
        ? activeFarm.name
        : "Dairy Farm";


const activeFarmId =
    activeFarm && activeFarm._id
        ? String(activeFarm._id)
        : "";


/* ==========================================================
   MILK TABLE DATA
========================================================== */

let milkTables = [];


/*
 * Preferred structure:
 *
 * milkDairyTables = [
 *
 *   {
 *      farm: {
 *          _id,
 *          name,
 *          code
 *      },
 *
 *      animals: [
 *          {
 *              _id,
 *              name,
 *              code,
 *              isMilking,
 *              morning,
 *              evening
 *          }
 *      ]
 *   }
 *
 * ]
 */


if (
    typeof milkDairyTables !== "undefined" &&
    Array.isArray(milkDairyTables)
) {

    milkTables = milkDairyTables;

}


/* ==========================================================
   FALLBACK
========================================================== */

else if (
    typeof dairies !== "undefined" &&
    Array.isArray(dairies)
) {

    const grouped =
        new Map();


    dairies.forEach(function (animal) {

        if (!animal) {
            return;
        }


        if (animal.isMilking !== true) {
            return;
        }


        const farm =
            animal.farm ||
            animal.dairyFarm ||
            animal.farmInfo ||
            null;


        const farmId =
            farm && farm._id
                ? String(farm._id)
                : "unassigned";


        if (!grouped.has(farmId)) {

            grouped.set(
                farmId,
                {
                    farm: farm,
                    animals: []
                }
            );

        }


        grouped
            .get(farmId)
            .animals
            .push(animal);

    });


    milkTables =
        Array.from(
            grouped.values()
        );

}


/* ==========================================================
   ENSURE ARRAY
========================================================== */

if (!Array.isArray(milkTables)) {

    milkTables = [];

}


/* ==========================================================
   DAIRY WORKER FARM RESTRICTION
========================================================== */

if (dairyWorker && activeFarmId) {

    milkTables =
        milkTables.filter(function (table) {

            if (!table || !table.farm) {
                return false;
            }


            const tableFarmId =
                table.farm._id
                    ? String(table.farm._id)
                    : "";


            return (
                tableFarmId === activeFarmId
            );

        });

}


/* ==========================================================
   REMOVE EMPTY TABLES
========================================================== */

milkTables =
    milkTables.filter(function (table) {

        return (
            table &&
            Array.isArray(table.animals) &&
            table.animals.length > 0
        );

    });


/* ==========================================================
   SESSION PERMISSIONS
========================================================== */

/*
 * Normal collection:
 *
 * morning  -> morning collection
 * evening  -> evening collection
 *
 * Admin:
 *
 * closed -> can still enter/edit morning records
 *
 * Other users:
 *
 * closed -> locked
 */

const adminMorningWindow =
    adminUser &&
    (
        currentSession === "morning" ||
        currentSession === "closed"
    );


const canSubmit =
    currentSession === "morning" ||
    currentSession === "evening" ||
    adminMorningWindow;


/* ==========================================================
   ACTIVE ENTRY SESSION
========================================================== */

const entrySession =
    currentSession === "evening"
        ? "evening"
        : "morning";


/* ==========================================================
   TOTAL ANIMALS
========================================================== */

let totalAnimals = 0;


milkTables.forEach(function (table) {

    if (Array.isArray(table.animals)) {

        totalAnimals +=
            table.animals.length;

    }

});


/* ==========================================================
   SESSION DISPLAY
========================================================== */

let sessionTitle =
    "Collection Closed";

let sessionIcon =
    "🔒";

let sessionClass =
    "session-card-closed";

let sessionBadgeClass =
    "session-closed";

let sessionBadgeText =
    "Closed";


if (currentSession === "morning") {

    sessionTitle =
        "Morning collection";

    sessionIcon =
        "🌅";

    sessionClass =
        "session-card-open";

    sessionBadgeClass =
        "session-morning";

    sessionBadgeText =
        "Morning";

}


else if (currentSession === "closed") {

    if (adminUser) {

        sessionTitle =
            "Morning collection";

        sessionIcon =
            "✏️";

        sessionClass =
            "session-card-admin";

        sessionBadgeClass =
            "session-admin";

        sessionBadgeText =
            "Admin Access";

    }

    else {

        sessionTitle =
            "Collection closed";

        sessionIcon =
            "⏰";

        sessionClass =
            "session-card-closed";

        sessionBadgeClass =
            "session-closed";

        sessionBadgeText =
            "Closed";

    }

}


else if (currentSession === "evening") {

    sessionTitle =
        "Evening collection";

    sessionIcon =
        "🌆";

    sessionClass =
        "session-card-evening";

    sessionBadgeClass =
        "session-evening";

    sessionBadgeText =
        "Evening";

}


else {

    sessionTitle =
        "Collection unavailable";

}


/* ==========================================================
   DATE LABEL
========================================================== */

const todayLabel =
    new Date().toLocaleDateString(
        "en-KE",
        {
            weekday: "long",
            day: "numeric",
            month: "long",
            year: "numeric"
        }
    );

%>


<!-- ==========================================================
     MILK COLLECTION PAGE
========================================================== -->

<div class="milk-page">


    <!-- ======================================================
         HEADER
    ======================================================= -->

    <header class="milk-header">

        <div class="milk-header-content">

            <div class="milk-header-icon">
                🥛
            </div>


            <div class="milk-header-text">

                <% if (adminUser) { %>

                    <div class="milk-eyebrow">
                        ALL DAIRY FARMS
                    </div>

                <% } else { %>

                    <div class="milk-eyebrow">
                        <%= activeFarmName %>
                    </div>

                <% } %>


                <h1>
                    Milk Collection
                </h1>


                <div class="milk-date">
                    <%= todayLabel %>
                </div>

            </div>

        </div>


        <div
            class="milk-session-badge <%= sessionBadgeClass %>"
        >

            <span class="session-dot"></span>

            <span>
                <%= sessionBadgeText %>
            </span>

        </div>

    </header>


    <!-- ======================================================
         SESSION STATUS
    ======================================================= -->

    <div
        class="milk-session-card <%= sessionClass %>"
    >

        <div class="session-card-icon">
            <%= sessionIcon %>
        </div>


        <div class="session-card-content">

            <div class="session-card-title">
                <%= sessionTitle %>
            </div>


            <div class="session-card-description">

                <% if (currentSession === "morning") { %>

                    Record today's morning milk production.

                <% } else if (currentSession === "evening") { %>

                    Record today's evening milk production.

                <% } else if (currentSession === "closed" && adminUser) { %>

                    Administrator access to morning collection records.

                <% } else { %>

                    Milk collection is currently closed.

                <% } %>

            </div>

        </div>


        <div class="session-time">

            <% if (currentSession === "morning") { %>

                <span>
                    Closes
                </span>

                <strong>
                    10:00 AM
                </strong>

            <% } else if (currentSession === "closed") { %>

                <span>
                    Evening
                </span>

                <strong>
                    4:00 PM
                </strong>

            <% } else if (currentSession === "evening") { %>

                <span>
                    Closes
                </span>

                <strong>
                    Midnight
                </strong>

            <% } %>

        </div>

    </div>


    <!-- ======================================================
         SUMMARY
    ======================================================= -->

    <% if (milkTables.length > 0) { %>

        <div class="milk-summary">

            <div class="milk-summary-item">

                <span class="summary-icon">
                    🐄
                </span>

                <div>

                    <strong>
                        <%= totalAnimals %>
                    </strong>

                    <span>
                        <%= totalAnimals === 1
                            ? "Milking animal"
                            : "Milking animals"
                        %>
                    </span>

                </div>

            </div>


            <div class="milk-summary-item">

                <span class="summary-icon">
                    📝
                </span>

                <div>

                    <strong>
                        <%= milkTables.length %>
                    </strong>

                    <span>
                        <%= milkTables.length === 1
                            ? "Dairy farm"
                            : "Dairy farms"
                        %>
                    </span>

                </div>

            </div>


            <div class="milk-summary-item">

                <span class="summary-icon">
                    <%= entrySession === "morning"
                        ? "🌅"
                        : "🌆"
                    %>
                </span>

                <div>

                    <strong>
                        <%= entrySession === "morning"
                            ? "Morning"
                            : "Evening"
                        %>
                    </strong>

                    <span>
                        Collection session
                    </span>

                </div>

            </div>

        </div>

    <% } %>


    <!-- ======================================================
         NO ANIMALS
    ======================================================= -->

    <% if (milkTables.length === 0) { %>


        <div class="milk-empty-state">

            <div class="empty-animal-icon">
                🐄
            </div>


            <h2>
                No Animals Currently Being Milked
            </h2>


            <% if (adminUser) { %>

                <p>
                    There are currently no milking animals
                    available across the dairy farms.
                </p>

            <% } else { %>

                <p>
                    There are currently no milking animals
                    available for
                    <strong><%= activeFarmName %></strong>.
                </p>

            <% } %>

        </div>


    <% } else { %>


        <!-- ==================================================
             FARM TABLES
        =================================================== -->

        <%
        milkTables.forEach(function (table, tableIndex) {

            const farm =
                table.farm || null;


            const animals =
                Array.isArray(table.animals)
                    ? table.animals
                    : [];


            const farmName =
                farm && farm.name
                    ? farm.name
                    : "Dairy Farm";


            const farmCode =
                farm &&
                farm.code !== undefined &&
                farm.code !== null
                    ? farm.code
                    : null;


            const farmId =
                farm && farm._id
                    ? String(farm._id)
                    : "";


            const farmFormIds = [];

        %>


            <!-- ==================================================
                 FARM COLLECTION CARD
            =================================================== -->

            <section
                class="collection-card farm-collection-card"
                data-farm-id="<%= farmId %>"
            >


                <!-- ==============================================
                     FARM HEADER
                =============================================== -->

                <div class="collection-card-header">

                    <div>

                        <div class="collection-title">

                            <span class="farm-title-icon">
                                🐄
                            </span>

                            <span>
                                <%= farmName %>
                            </span>

                        </div>


                        <div class="collection-subtitle">

                            <% if (farmCode !== null) { %>

                                Farm #<%= farmCode %>

                                <span class="subtitle-separator">
                                    ·
                                </span>

                            <% } %>


                            <%= animals.length %>

                            <%= animals.length === 1
                                ? "animal"
                                : "animals"
                            %>

                        </div>

                    </div>


                    <% if (canSubmit) { %>

                        <div class="collection-status">

                            <span class="status-dot"></span>


                            <% if (
                                currentSession === "closed" &&
                                adminUser
                            ) { %>

                                Admin Entry

                            <% } else { %>

                                Ready

                            <% } %>

                        </div>

                    <% } else { %>

                        <div class="collection-status status-locked">

                            🔒 Locked

                        </div>

                    <% } %>

                </div>


                <!-- ==============================================
                     FARM TABLE
                =============================================== -->

                <div class="milk-table-wrapper">

                    <table class="milk-table">

                        <thead>

                            <tr>

                                <th class="col-animal">
                                    Animal
                                </th>

                                <th class="col-code">
                                    Code
                                </th>

                                <th class="col-milk">
                                    Milk
                                    <span>(Litres)</span>
                                </th>

                                <th class="col-remarks">
                                    Remarks
                                </th>

                                <th class="col-action">
                                    Action
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                        <%
                        animals.forEach(function (dairy, animalIndex) {

                            let record = null;


                            if (entrySession === "morning") {

                                record =
                                    dairy.morning || null;

                            } else {

                                record =
                                    dairy.evening || null;

                            }


                            const canCreateRecord =
                                !record &&
                                canSubmit;


                            const canEditRecord =
                                adminUser &&
                                record &&
                                record._id;


                            const formId =
                                "milkRecordForm_" +
                                String(
                                    dairy._id
                                ) +
                                "_" +
                                String(tableIndex) +
                                "_" +
                                String(animalIndex);


                            farmFormIds.push(formId);


                            const animalId =
                                dairy && dairy._id
                                    ? String(dairy._id)
                                    : "";


                            const recordId =
                                record && record._id
                                    ? String(record._id)
                                    : "";


                            const safeRemarks =
                                String(
                                    record &&
                                    record.remarks
                                        ? record.remarks
                                        : ""
                                )
                                .replace(/&/g, "&amp;")
                                .replace(/"/g, "&quot;")
                                .replace(/</g, "&lt;")
                                .replace(/>/g, "&gt;");

                        %>


                            <!-- ==================================
                                 ANIMAL ROW
                            =================================== -->

                            <tr
                                class="<%= record
                                    ? 'has-record'
                                    : 'needs-record'
                                %>"
                                data-animal-id="<%= animalId %>"
                                data-farm-id="<%= farmId %>"
                            >


                                <!-- =================================
                                     ANIMAL
                                ================================== -->

                                <td>

                                    <div class="animal-cell">

                                        <div class="animal-avatar">
                                            🐄
                                        </div>


                                        <div class="animal-info">

                                            <span class="animal-name">
                                                <%= dairy.name || "Unnamed Animal" %>
                                            </span>

                                            <span class="animal-label">
                                                Dairy animal
                                            </span>

                                        </div>

                                    </div>

                                </td>


                                <!-- =================================
                                     CODE
                                ================================== -->

                                <td>

                                    <span class="code-badge">
                                        #<%= dairy.code %>
                                    </span>

                                </td>


                                <!-- =================================
                                     MILK
                                ================================== -->

                                <td>

                                    <% if (record) { %>


                                        <% if (canEditRecord) { %>

                                            <button
                                                type="button"
                                                class="record-wrapper admin-edit-record js-edit-milk"
                                                data-record-id="<%= recordId %>"
                                                data-animal-id="<%= animalId %>"
                                                data-farm-id="<%= farmId %>"
                                                data-liters="<%= Number(record.liters || 0) %>"
                                                data-remarks="<%= safeRemarks %>"
                                                title="Edit milk record"
                                                aria-label="Edit milk record"
                                            >

                                                <span class="milk-value-display">

                                                    <span>
                                                        <%= Number(
                                                            record.liters || 0
                                                        ).toFixed(1) %>
                                                    </span>

                                                    <small>
                                                        L
                                                    </small>

                                                </span>


                                                <span class="edit-icon">
                                                    ✏️
                                                </span>

                                            </button>


                                        <% } else { %>


                                            <div class="record-wrapper">

                                                <div class="milk-value-display">

                                                    <span>
                                                        <%= Number(
                                                            record.liters || 0
                                                        ).toFixed(1) %>
                                                    </span>

                                                    <small>
                                                        L
                                                    </small>

                                                </div>

                                            </div>

                                        <% } %>


                                    <% } else if (canCreateRecord) { %>


                                        <div class="milk-entry-wrapper">

                                            <input
                                                class="milk-input"
                                                type="number"
                                                step="0.1"
                                                min="0"
                                                name="liters"
                                                form="<%= formId %>"
                                                placeholder="0.0"
                                                required
                                                inputmode="decimal"
                                                autocomplete="off"
                                            >

                                            <span class="input-unit">
                                                L
                                            </span>

                                        </div>


                                    <% } else { %>


                                        <div class="locked-input">

                                            <span>
                                                —
                                            </span>

                                            <small>
                                                Locked
                                            </small>

                                        </div>

                                    <% } %>

                                </td>


                                <!-- =================================
                                     REMARKS
                                ================================== -->

                                <td>

                                    <% if (record) { %>

                                        <%
                                        const displayRemarks =
                                            record.remarks &&
                                            String(record.remarks).trim()
                                                ? record.remarks
                                                : "No remarks";
                                        %>


                                        <% if (canEditRecord) { %>

                                            <button
                                                type="button"
                                                class="remarks-wrapper admin-edit-record js-edit-milk"
                                                data-record-id="<%= recordId %>"
                                                data-animal-id="<%= animalId %>"
                                                data-farm-id="<%= farmId %>"
                                                data-liters="<%= Number(record.liters || 0) %>"
                                                data-remarks="<%= safeRemarks %>"
                                                title="Edit milk record"
                                            >

                                                <span class="remarks-text">
                                                    <%= displayRemarks %>
                                                </span>


                                                <% if (
                                                    record.recordedByType === "system" ||
                                                    record.recordedBySystem
                                                ) { %>

                                                    <span class="record-badge system-record">

                                                        <span>
                                                            ⚙️
                                                        </span>

                                                        Automatically recorded
                                                        as Not Milked.

                                                    </span>

                                                <% } else { %>

                                                    <span class="record-badge">

                                                        <span>
                                                            ✓
                                                        </span>

                                                        Already recorded

                                                    </span>

                                                <% } %>


                                                <span class="admin-edit-hint">
                                                    ✏️ Tap to edit
                                                </span>

                                            </button>


                                        <% } else { %>


                                            <div class="remarks-wrapper">

                                                <div class="remarks-text">
                                                    <%= displayRemarks %>
                                                </div>


                                                <% if (
                                                    record.recordedByType === "system" ||
                                                    record.recordedBySystem
                                                ) { %>

                                                    <div class="record-badge system-record">

                                                        <span>
                                                            ⚙️
                                                        </span>

                                                        Automatically recorded
                                                        as Not Milked.

                                                    </div>

                                                <% } else { %>

                                                    <div class="record-badge">

                                                        <span>
                                                            ✓
                                                        </span>

                                                        Already recorded

                                                    </div>

                                                <% } %>

                                            </div>


                                        <% } %>


                                    <% } else if (canCreateRecord) { %>


                                        <textarea
                                            class="remarks-input"
                                            name="remarks"
                                            form="<%= formId %>"
                                            placeholder="Optional remarks..."
                                            rows="2"
                                        ></textarea>


                                    <% } else { %>


                                        <div class="closed-remarks">
                                            🔒
                                        </div>

                                    <% } %>

                                </td>


                                <!-- =================================
                                     ACTION
                                ================================== -->

                                <td class="action-cell">

                                    <% if (record) { %>


                                        <% if (canEditRecord) { %>

                                            <button
                                                type="button"
                                                class="row-action-btn admin-action js-edit-milk"
                                                data-record-id="<%= recordId %>"
                                                data-animal-id="<%= animalId %>"
                                                data-farm-id="<%= farmId %>"
                                                data-liters="<%= Number(record.liters || 0) %>"
                                                data-remarks="<%= safeRemarks %>"
                                            >

                                                ✏️

                                                <span>
                                                    Edit
                                                </span>

                                            </button>


                                        <% } else { %>

                                            <div class="read-only-label">

                                                <span>
                                                    ✓
                                                </span>

                                                <span>
                                                    Recorded
                                                </span>

                                            </div>

                                        <% } %>


                                    <% } else if (canCreateRecord) { %>


                                        <button
                                            type="submit"
                                            form="<%= formId %>"
                                            class="row-action-btn save-action"
                                        >

                                            ✓

                                            <span>
                                                Save
                                            </span>

                                        </button>


                                    <% } else { %>


                                        <div class="read-only-label locked-label">

                                            <span>
                                                🔒
                                            </span>

                                            <span>
                                                Locked
                                            </span>

                                        </div>

                                    <% } %>

                                </td>

                            </tr>


                        <%
                        });
                        %>

                        </tbody>

                    </table>

                </div>


                <!-- ==================================================
                     VALID HIDDEN FORMS
                     These are deliberately OUTSIDE the table.
                =================================================== -->

                <div class="individual-milk-forms">

                    <%
                    animals.forEach(function (dairy, animalIndex) {

                        let record = null;


                        if (entrySession === "morning") {

                            record =
                                dairy.morning || null;

                        } else {

                            record =
                                dairy.evening || null;

                        }


                        if (record || !canSubmit) {
                            return;
                        }


                        const animalId =
                            dairy && dairy._id
                                ? String(dairy._id)
                                : "";


                        const formId =
                            "milkRecordForm_" +
                            String(dairy._id) +
                            "_" +
                            String(tableIndex) +
                            "_" +
                            String(animalIndex);

                    %>

                        <form
                            id="<%= formId %>"
                            action="/milk"
                            method="POST"
                            class="individual-milk-form"
                        >

                            <input
                                type="hidden"
                                name="farm"
                                value="<%= farmId %>"
                            >


                            <input
                                type="hidden"
                                name="dairy"
                                value="<%= animalId %>"
                            >


                            <input
                                type="hidden"
                                name="session"
                                value="<%= entrySession %>"
                            >

                        </form>

                    <% }); %>

                </div>

            </section>


        <%
        });
        %>


    <% } %>

</div>


<!-- ==========================================================
     SUCCESS / ERROR POPUP
========================================================== -->

<% if (pageSuccess || pageError) { %>

<div
    id="milkResultPopup"
    class="milk-result-popup"
    aria-hidden="false"
>

    <div class="milk-result-backdrop"></div>


    <div
        class="milk-result-dialog <%= pageSuccess
            ? 'result-success'
            : 'result-error'
        %>"
        role="alertdialog"
        aria-modal="true"
        aria-labelledby="milkResultTitle"
    >

        <div class="result-icon">

            <% if (pageSuccess) { %>
                ✓
            <% } else { %>
                !
            <% } %>

        </div>


        <div class="result-content">

            <h2 id="milkResultTitle">

                <% if (pageSuccess) { %>
                    Milk record saved
                <% } else { %>
                    Unable to save record
                <% } %>

            </h2>


            <p>

                <% if (pageSuccess) { %>

                    Milk record saved successfully.

                <% } else { %>

                    <%= pageError %>

                <% } %>

            </p>

        </div>


        <button
            type="button"
            id="closeMilkResultPopup"
            class="result-ok-button"
        >
            OK
        </button>

    </div>

</div>

<% } %>


<!-- ==========================================================
     ADMIN EDIT MODAL
========================================================== -->

<div
    id="milkEditModal"
    class="milk-edit-modal"
    aria-hidden="true"
>

    <div
        class="milk-edit-backdrop"
        data-close-edit-modal
    ></div>


    <div
        class="milk-edit-dialog"
        role="dialog"
        aria-modal="true"
