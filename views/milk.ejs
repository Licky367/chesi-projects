<style>

  /* =========================
     PAGE
  ========================= */

  .milk-page {
    max-width: 1100px;
    margin: 0 auto;
    padding: 20px 0 40px;
  }

  /* =========================
     CARD
  ========================= */

  .milk-card {
    overflow: hidden;
    border-radius: 18px;
    background: #ffffff;
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.07);
  }

  /* =========================
     HEADER
  ========================= */

  .milk-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 25px;
    border-bottom: 1px solid #e5e7eb;
  }

  .milk-header h2 {
    margin: 0 0 7px;
    color: #166534;
    font-size: 26px;
    font-weight: 700;
  }

  .milk-header p {
    margin: 0;
    color: #6b7280;
    font-size: 14px;
  }

  /* =========================
     HEADER ICON
  ========================= */

  .milk-icon {
    width: 58px;
    height: 58px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    border-radius: 16px;
    background: #dcfce7;
    font-size: 28px;
  }

  /* =========================
     STATUS BAR
  ========================= */

  .milk-session-info {
    padding: 14px 25px;
    background: #f0fdf4;
    border-bottom: 1px solid #dcfce7;
    color: #166534;
    font-size: 13px;
  }

  .milk-session-info strong {
    font-weight: 700;
  }

  /* =========================
     ALERT
  ========================= */

  .milk-alert {
    margin: 18px 25px;
    padding: 14px 16px;
    border-radius: 10px;
    background: #fff7ed;
    border: 1px solid #fed7aa;
    color: #9a3412;
    font-size: 14px;
    line-height: 1.5;
  }

  /* =========================
     TABLE WRAPPER
  ========================= */

  .milk-table-wrapper {
    overflow-x: auto;
    padding: 0 25px;
  }

  /* =========================
     TABLE
  ========================= */

  .milk-table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
  }

  .milk-table th {
    padding: 16px 12px;
    border-bottom: 1px solid #e5e7eb;
    background: #f9fafb;
    color: #6b7280;
    font-size: 12px;
    font-weight: 700;
    text-align: left;
    text-transform: uppercase;
  }

  .milk-table td {
    padding: 16px 12px;
    border-bottom: 1px solid #f0f0f0;
    color: #374151;
    font-size: 14px;
    vertical-align: middle;
  }

  .milk-table tbody tr {
    transition: background .2s ease;
  }

  .milk-table tbody tr:hover {
    background: #fafffb;
  }

  .milk-table tbody tr:last-child td {
    border-bottom: none;
  }

  /* =========================
     CODE BADGE
  ========================= */

  .code-badge {
    display: inline-flex;
    align-items: center;
    padding: 6px 10px;
    border-radius: 8px;
    background: #f0fdf4;
    color: #166534;
    font-size: 12px;
    font-weight: 700;
  }

  /* =========================
     NAME
  ========================= */

  .animal-name {
    color: #111827;
    font-weight: 600;
  }

  /* =========================
     INPUTS
  ========================= */

  .milk-input,
  .remarks-input {
    width: 100%;
    box-sizing: border-box;
    padding: 11px 12px;
    border: 1px solid #d1d5db;
    border-radius: 9px;
    outline: none;
    background: #f9fafb;
    color: #111827;
    font-family: inherit;
    font-size: 14px;
    transition: all .25s ease;
  }

  .milk-input:focus,
  .remarks-input:focus {
    border-color: #16a34a;
    background: #ffffff;
    box-shadow: 0 0 0 4px rgba(22,163,74,.1);
  }

  .milk-input[readonly],
  .remarks-input[readonly] {
    background: #f3f4f6;
    color: #6b7280;
    cursor: not-allowed;
    border-color: #e5e7eb;
  }

  .remarks-input {
    min-height: 44px;
    resize: vertical;
  }

  /* =========================
     LOCKED ROW
  ========================= */

  .milk-row-locked {
    background: #fafafa;
  }

  .milk-row-locked:hover {
    background: #fafafa !important;
  }

  /* =========================
     STATUS
  ========================= */

  .milk-status {
    display: inline-block;
    margin-top: 6px;
    font-size: 11px;
    line-height: 1.4;
  }

  .milk-status.recorded {
    color: #166534;
  }

  .milk-status.locked {
    color: #9a3412;
  }

  .milk-status.system {
    color: #6b7280;
  }

  /* =========================
     SUBMIT SECTION
  ========================= */

  .submit-section {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 20px 25px;
    border-top: 1px solid #e5e7eb;
    background: #fafafa;
  }

  .submit-hint {
    color: #6b7280;
    font-size: 13px;
  }

  .submit-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 13px 22px;
    border: none;
    border-radius: 10px;
    background: linear-gradient(135deg,#16a34a,#15803d);
    color: #fff;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    transition: all .25s ease;
  }

  .submit-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 18px rgba(22,163,74,.25);
  }

  /* =========================
     EMPTY STATE
  ========================= */

  .empty-state {
    padding: 60px 25px;
    color: #6b7280;
    text-align: center;
  }

  .empty-icon {
    margin-bottom: 12px;
    font-size: 48px;
  }

  .empty-state h3 {
    margin: 0 0 8px;
    color: #374151;
    font-size: 19px;
  }

  .empty-state p {
    margin: 0;
    font-size: 14px;
  }

  /* =========================
     SUCCESS MODAL
  ========================= */

  .success-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0,0,0,.45);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    animation: fadeIn .25s ease;
  }

  .success-modal {
    width: 90%;
    max-width: 420px;
    background: #fff;
    border-radius: 18px;
    overflow: hidden;
    text-align: center;
    box-shadow: 0 20px 50px rgba(0,0,0,.25);
    animation: popUp .25s ease;
  }

  .success-top {
    background: linear-gradient(135deg,#16a34a,#15803d);
    padding: 28px 20px;
    color: #fff;
  }

  .success-top .icon {
    font-size: 56px;
    margin-bottom: 10px;
  }

  .success-body {
    padding: 28px 24px;
  }

  .success-body h3 {
    margin: 0 0 12px;
    color: #166534;
    font-size: 24px;
  }

  .success-body p {
    margin: 0;
    color: #6b7280;
    font-size: 15px;
    line-height: 1.6;
  }

  .success-footer {
    padding: 20px 24px 28px;
  }

  .success-btn {
    width: 100%;
    padding: 14px;
    border: none;
    border-radius: 10px;
    background: #16a34a;
    color: #fff;
    font-size: 16px;
    font-weight: 700;
    cursor: pointer;
    transition: .2s;
  }

  .success-btn:hover {
    background: #15803d;
  }

  /* =========================
     ERROR MODAL
  ========================= */

  .error-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0,0,0,.45);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 10000;
  }

  .error-modal {
    width: 90%;
    max-width: 430px;
    background: #fff;
    border-radius: 18px;
    overflow: hidden;
    text-align: center;
    box-shadow: 0 20px 50px rgba(0,0,0,.25);
  }

  .error-top {
    background: #fff7ed;
    padding: 25px;
    color: #9a3412;
  }

  .error-top .icon {
    font-size: 48px;
  }

  .error-body {
    padding: 25px;
  }

  .error-body h3 {
    margin: 0 0 10px;
    color: #9a3412;
    font-size: 21px;
  }

  .error-body p {
    margin: 0;
    color: #6b7280;
    font-size: 14px;
    line-height: 1.6;
  }

  .error-footer {
    padding: 0 25px 25px;
  }

  .error-btn {
    width: 100%;
    padding: 13px;
    border: none;
    border-radius: 10px;
    background: #ea580c;
    color: #fff;
    font-size: 15px;
    font-weight: 700;
    cursor: pointer;
  }

  /* =========================
     ANIMATIONS
  ========================= */

  @keyframes fadeIn {
    from {
      opacity: 0;
    }

    to {
      opacity: 1;
    }
  }

  @keyframes popUp {
    from {
      opacity: 0;
      transform: scale(.85);
    }

    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  /* =========================
     RESPONSIVE
  ========================= */

  @media (max-width:650px) {

    .milk-header {
      align-items: flex-start;
    }

    .milk-header h2 {
      font-size: 23px;
    }

    .milk-icon {
      width: 48px;
      height: 48px;
      font-size: 23px;
    }

    .milk-table-wrapper {
      padding: 0 10px;
      overflow-x: visible;
    }

    .milk-table th,
    .milk-table td {
      padding: 8px 4px;
      font-size: 12px;
      word-break: break-word;
    }

    .code-badge {
      padding: 4px 6px;
      font-size: 10px;
    }

    .milk-input,
    .remarks-input {
      padding: 8px;
      font-size: 12px;
    }

    .submit-section {
      flex-direction: column;
      align-items: stretch;
    }

    .submit-btn {
      width: 100%;
      justify-content: center;
    }

  }

</style>


<div class="milk-page">

  <div class="milk-card">

    <!-- ==================================================
         HEADER
    ================================================== -->

    <div class="milk-header">

      <div>

        <h2>
          🥛 Milk Collection
        </h2>

        <p>
          Record the daily milk production from each dairy animal.
        </p>

      </div>

      <div class="milk-icon">
        🥛
      </div>

    </div>


    <% if (!dairies || dairies.length === 0) { %>

      <div class="empty-state">

        <div class="empty-icon">
          🐄
        </div>

        <h3>
          No Animals Currently Being Milked
        </h3>

        <p>
          There are no active dairy animals available for milk collection.
        </p>

      </div>

    <% } else { %>


      <!-- ==================================================
           SESSION INFORMATION
      ================================================== -->

      <% const currentDairy = dairies[0]; %>

      <div class="milk-session-info">

        <% if (currentDairy.milkSession === "morning") { %>

          <% if (currentDairy.isAdminCorrectionWindow) { %>

            <strong>Morning correction period:</strong>
            Normal submissions are closed.
            Administrators can edit morning records until 4:00 PM.

          <% } else { %>

            <strong>Morning collection:</strong>
            Submit once per animal before 10:00 AM.

          <% } %>

        <% } else { %>

          <strong>Evening collection:</strong>
          Submit once per animal from 4:00 PM until midnight.

        <% } %>

      </div>


      <!-- ==================================================
           ERROR
      ================================================== -->

      <% if (typeof error !== "undefined" && error) { %>

        <div
          class="milk-alert"
          role="alert"
        >

          ⚠️
          <%= error %>

        </div>

      <% } %>


      <!-- ==================================================
           MILK FORM
      ================================================== -->

      <form
        action="/milk"
        method="POST"
        id="milkForm"
      >

        <div class="milk-table-wrapper">

          <table class="milk-table">

            <thead>

              <tr>

                <th>
                  Code
                </th>

                <th>
                  Name
                </th>

                <th>
                  Milk (Liters)
                </th>

                <th>
                  Remarks
                </th>

              </tr>

            </thead>

            <tbody>

              <% dairies.forEach((dairy, index) => { %>

                <%
                  const record =
                    dairy.milkRecord;

                  const isAdmin =
                    user &&
                    user.role === "admin";

                  const isRecorded =
                    !!record;

                  const adminCorrection =
                    isAdmin &&
                    dairy.isAdminCorrectionWindow &&
                    isRecorded;

                  const canEdit =
                    adminCorrection ||
                    (
                      dairy.milkState === "open" &&
                      !isRecorded
                    );

                  const rowLocked =
                    !canEdit;
                %>


                <tr
                  class="<%= rowLocked ? 'milk-row-locked' : '' %>"
                >

                  <!-- ==================================================
                       CODE
                  ================================================== -->

                  <td>

                    <span class="code-badge">

                      #<%= dairy.code %>

                    </span>

                    <input
                      type="hidden"
                      name="records[<%= index %>][dairy]"
                      value="<%= dairy._id %>"
                    >

                  </td>


                  <!-- ==================================================
                       NAME
                  ================================================== -->

                  <td>

                    <span class="animal-name">

                      <%= dairy.name %>

                    </span>

                    <% if (record) { %>

                      <% if (
                        record.remarks === "Not Milked" &&
                        record.liters === 0
                      ) { %>

                        <div class="milk-status system">

                          System record:
                          Not Milked

                        </div>

                      <% } else { %>

                        <div class="milk-status recorded">

                          ✓ Record submitted

                          <% if (adminCorrection) { %>

                            — Admin can edit

                          <% } %>

                        </div>

                      <% } %>

                    <% } else if (!canEdit) { %>

                      <div class="milk-status locked">

                        🔒
                        <%= dairy.milkMessage ||
                            "This entry is closed." %>

                      </div>

                    <% } %>

                  </td>


                  <!-- ==================================================
                       LITERS
                  ================================================== -->

                  <td>

                    <input
                      class="milk-input"
                      type="number"
                      step="0.1"
                      min="0"
                      name="records[<%= index %>][liters]"
                      placeholder="0.0"
                      value="<%= record ? record.liters : '' %>"
                      <%= canEdit ? '' : 'readonly' %>
                    >

                  </td>


                  <!-- ==================================================
                       REMARKS
                  ================================================== -->

                  <td>

                    <textarea
                      class="remarks-input"
                      name="records[<%= index %>][remarks]"
                      placeholder="Optional remarks..."
                      <%= canEdit ? '' : 'readonly' %>
                    ><%= record ? record.remarks : '' %></textarea>

                  </td>

                </tr>

              <% }) %>

            </tbody>

          </table>

        </div>


        <!-- ==================================================
             SUBMIT
        ================================================== -->

        <div class="submit-section">

          <div class="submit-hint">

            <% if (
              user &&
              user.role === "admin" &&
              currentDairy.isAdminCorrectionWindow
            ) { %>

              🛠️ Administrators can correct morning records until 4:00 PM.

            <% } else if (
              currentDairy.milkSession === "morning"
            ) { %>

              💡 Morning milk must be submitted before 10:00 AM.

            <% } else { %>

              💡 Evening milk can be submitted from 4:00 PM until midnight.

            <% } %>

          </div>

          <button
            type="submit"
            class="submit-btn"
          >

            ✓

            <% if (
              user &&
              user.role === "admin" &&
              currentDairy.isAdminCorrectionWindow
            ) { %>

              Save Corrections

            <% } else { %>

              Submit Milk Records

            <% } %>

          </button>

        </div>

      </form>

    <% } %>


    <!-- ==================================================
         SUCCESS POPUP
    ================================================== -->

    <div
      id="successOverlay"
      class="success-overlay"
    >

      <div class="success-modal">

        <div class="success-top">

          <div class="icon">
            ✅
          </div>

        </div>

        <div class="success-body">

          <h3>
            Success
          </h3>

          <p>
            Milk record submitted successfully.
          </p>

        </div>

        <div class="success-footer">

          <button
            type="button"
            id="successOkBtn"
            class="success-btn"
          >
            OK
          </button>

        </div>

      </div>

    </div>


    <!-- ==================================================
         ERROR POPUP
    ================================================== -->

    <% if (
      typeof error !== "undefined" &&
      error
    ) { %>

      <div
        id="errorOverlay"
        class="error-overlay"
        style="display:flex;"
      >

        <div class="error-modal">

          <div class="error-top">

            <div class="icon">
              ⚠️
            </div>

          </div>

          <div class="error-body">

            <h3>
              Milk Record Not Saved
            </h3>

            <p>
              <%= error %>
            </p>

          </div>

          <div class="error-footer">

            <button
              type="button"
              id="errorOkBtn"
              class="error-btn"
            >
              OK
            </button>

          </div>

        </div>

      </div>

    <% } %>

  </div>

</div>


<script>

  // ==================================================
  // SUCCESS
  // ==================================================

  const successOverlay =
    document.getElementById(
      "successOverlay"
    );

  const successOkBtn =
    document.getElementById(
      "successOkBtn"
    );

  <% if (
    typeof success !== "undefined" &&
    success
  ) { %>

    window.addEventListener(
      "load",
      function () {

        if (successOverlay) {

          successOverlay.style.display =
            "flex";

        }

      }
    );

  <% } %>


  if (successOkBtn) {

    successOkBtn.addEventListener(
      "click",
      function () {

        if (successOverlay) {

          successOverlay.style.display =
            "none";

        }

        window.location.replace(
          "/milk"
        );

      }
    );

  }


  // ==================================================
  // ERROR
  // ==================================================

  const errorOverlay =
    document.getElementById(
      "errorOverlay"
    );

  const errorOkBtn =
    document.getElementById(
      "errorOkBtn"
    );

  if (errorOkBtn) {

    errorOkBtn.addEventListener(
      "click",
      function () {

        if (errorOverlay) {

          errorOverlay.style.display =
            "none";

        }

        window.history.replaceState(
          {},
          document.title,
          "/milk"
        );

      }
    );

  }

</script>