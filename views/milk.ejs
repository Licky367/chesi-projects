<% /*

==========================================================
SAFE DEFAULTS

Expected controller data:

dairies
session
isAdmin
success
error
user

The service/controller should attach the appropriate
record for the CURRENT session to each dairy as:

dairy.milkRecord
dairy.recorded

session values:

"morning"
"closed"
"evening"

Rules:

00:00 - 09:59  = Morning
10:00 - 15:59  = Closed
16:00 - 23:59  = Evening

Only the current session's record is displayed as the
active record.

An existing record is never submitted again.

Normal users cannot edit an existing record.

Admins can tap an existing record to edit it, including
morning records during the closed 10:00 AM - 4:00 PM
period.
*/

const pageError =
typeof error !== "undefined"
? error
: "";

const pageSuccess =
typeof success !== "undefined"
? Boolean(success)
: false;

const currentSession =
typeof session !== "undefined"
? session
: "";

const adminUser =
typeof isAdmin !== "undefined"
? Boolean(isAdmin)
: (
typeof user !== "undefined" &&
user &&
user.role === "admin"
);

const milkDairies =
Array.isArray(dairies)
? dairies
: [];

%>

<!-- ==================================================
     HEADER
================================================== --><div class="milk-header"><div>

    <h2>
        🥛 Milk Collection
    </h2>

    <p>
        Record milk production for each dairy animal.
    </p>

</div>

<div class="milk-icon">
    🥛
</div>

</div><!-- ==================================================
     ERROR
================================================== --><% if (pageError) { %>

<div class="milk-error">

    ⚠️
    <%= pageError %>

</div>

<% } %>

<!-- ==================================================
     SUCCESS
================================================== --><% if (pageSuccess) { %>

<div class="milk-success">

    ✓ Milk record saved successfully.

</div>

<% } %>

<!-- ==================================================
     CURRENT TIME WINDOW
================================================== --><% if (currentSession === "morning") { %>

<div class="milk-status">

    🌅

    <strong>
        Morning collection is open.
    </strong>

    Submit one record per cow before
    10:00 AM.

</div>

<% } else if (currentSession === "closed") { %>

<div class="milk-status warning">

    ⏰

    <strong>
        Collection is temporarily closed.
    </strong>

    Morning collection closed at 10:00 AM.
    Evening collection opens at 4:00 PM.

    <% if (adminUser) { %>

        <br>

        <strong>
            Administrator:
        </strong>

        You may still edit existing
        morning records by tapping
        their record.

    <% } else { %>

        <% if (!adminUser) { %>

            <br>

            If a correction is required,
            contact an administrator.

        <% } %>

    <% } %>

</div>

<% } else if (currentSession === "evening") { %>

<div class="milk-status">

    🌆

    <strong>
        Evening collection is open.
    </strong>

    Submit one record per cow before
    midnight.

</div>

<% } else { %>

<div class="milk-status warning">

    ⏰

    <strong>
        Collection window unavailable.
    </strong>

    Please contact an administrator
    if this continues.

</div>

<% } %>

<!-- ==================================================
     ANIMALS
================================================== --><% if (milkDairies.length === 0) { %>

<div class="empty-state">

    <div class="empty-icon">
        🐄
    </div>

    <h3>
        No Animals Currently Being Milked
    </h3>

    <p>
        There are no active dairy animals available.
    </p>

</div>

<% } else { %>

<!-- ==================================================
     MILK FORM
================================================== -->

<form
    action="/milk"
    method="POST"
    id="milkForm"
>

    <div class="milk-table-wrapper">

        <table class="milk-table">

            <thead>

                <tr>

                    <th>
                        Code
                    </th>

                    <th>
                        Name
                    </th>

                    <th>
                        Milk (L)
                    </th>

                    <th>
                        Remarks
                    </th>

                </tr>

            </thead>


            <tbody>

                <% milkDairies.forEach((dairy, index) => {

                    /*
                     * The service has already attached the
                     * CURRENT SESSION record as dairy.milkRecord.
                     *
                     * We deliberately do NOT fall back to
                     * another session's record.
                     */

                    const record =
                        dairy.milkRecord || null;

                %>


                    <tr>


                        <!-- ==================================================
                             CODE
                        ================================================== -->

                        <td>

                            <span class="code-badge">

                                #<%= dairy.code %>

                            </span>

                        </td>


                        <!-- ==================================================
                             NAME
                        ================================================== -->

                        <td>

                            <span class="animal-name">

                                <%= dairy.name %>

                            </span>

                        </td>


                        <!-- ==================================================
                             MILK
                        ================================================== -->

                        <td>


                            <% if (record) { %>


                                <!-- ==================================================
                                     EXISTING RECORD
                                     
                                     Admin can tap this field to edit.
                                     Normal users only see it as readonly.
                                ================================================== -->

                                <div
                                    class="<%= adminUser ? 'admin-edit-record' : '' %>"
                                    <% if (adminUser && record._id) { %>

                                        onclick="openEditModal(
                                            '<%= record._id %>',
                                            '<%= Number(record.liters || 0) %>',
                                            <%- JSON.stringify(record.remarks || "") %>
                                        )"

                                    <% } %>
                                >

                                    <input
                                        class="milk-input readonly-input"
                                        type="number"
                                        value="<%= Number(record.liters || 0) %>"
                                        readonly
                                        tabindex="<%= adminUser ? '0' : '-1' %>"
                                        <% if (adminUser) { %>
                                            title="Tap to edit this milk record"
                                        <% } %>
                                    >

                                    <% if (adminUser) { %>

                                        <div class="admin-edit-hint">

                                            ✏️ Tap to edit

                                        </div>

                                    <% } %>

                                </div>


                            <% } else if (
                                currentSession === "morning" ||
                                currentSession === "evening"
                            ) { %>


                                <!-- ==================================================
                                     NEW RECORD
                                ================================================== -->

                                <input
                                    class="milk-input"
                                    type="number"
                                    step="0.1"
                                    min="0"
                                    name="records[<%= index %>][liters]"
                                    placeholder="0.0"
                                    required
                                >

                                <input
                                    type="hidden"
                                    name="records[<%= index %>][dairy]"
                                    value="<%= dairy._id %>"
                                >


                            <% } else { %>


                                <!-- ==================================================
                                     CLOSED WINDOW
                                ================================================== -->

                                <input
                                    class="milk-input readonly-input"
                                    type="number"
                                    value="0"
                                    readonly
                                >

                            <% } %>


                        </td>


                        <!-- ==================================================
                             REMARKS
                        ================================================== -->

                        <td>


                            <% if (record) { %>


                                <!-- ==================================================
                                     EXISTING RECORD REMARKS
                                ================================================== -->

                                <textarea
                                    class="remarks-input readonly-input"
                                    readonly
                                ><%= record.remarks || "" %></textarea>


                                <div class="recorded">


                                    <% if (
                                        record.recordedBySystem ||
                                        record.recordedByType === "system"
                                    ) { %>


                                        <strong class="system-record">
                                            System
                                        </strong>

                                        Automatically recorded as
                                        Not Milked.


                                    <% } else { %>


                                        <strong>
                                            Recorded
                                        </strong>

                                        This cow has already been
                                        recorded for this session.


                                    <% } %>


                                </div>


                            <% } else if (
                                currentSession === "morning" ||
                                currentSession === "evening"
                            ) { %>


                                <!-- ==================================================
                                     NEW RECORD REMARKS
                                ================================================== -->

                                <textarea
                                    class="remarks-input"
                                    name="records[<%= index %>][remarks]"
                                    placeholder="Optional remarks..."
                                ></textarea>


                            <% } else { %>


                                <!-- ==================================================
                                     CLOSED WINDOW
                                ================================================== -->

                                <textarea
                                    class="remarks-input readonly-input"
                                    readonly
                                >Collection is currently closed.</textarea>


                            <% } %>


                        </td>


                    </tr>


                <% }); %>

            </tbody>

        </table>

    </div>


    <!-- ==================================================
         SUBMIT SECTION
    ================================================== -->

    <div class="submit-section">


        <div class="submit-hint">


            <% if (currentSession === "morning") { %>


                🌅

                Morning collection is open until
                10:00 AM.

                Each cow can be recorded once.


            <% } else if (currentSession === "closed") { %>


                🔒

                Morning collection has closed.

                <% if (adminUser) { %>

                    Administrators can still
                    edit morning records.

                <% } %>

                Evening collection opens at
                4:00 PM.


            <% } else if (currentSession === "evening") { %>


                🌆

                Evening collection is open until
                midnight.

                Each cow can be recorded once.


            <% } else { %>


                🔒

                The current collection window
                is closed.


            <% } %>


        </div>


        <button
            type="submit"
            class="submit-btn"

            <% if (
                currentSession !== "morning" &&
                currentSession !== "evening"
            ) { %>

                disabled

            <% } %>
        >

            ✓ Submit Milk Records

        </button>


    </div>


</form>

<% } %>

<!-- ==========================================================
     ADMIN EDIT MODAL
========================================================== --><% if (adminUser) { %>

<div
    id="editMilkModal"
    class="milk-edit-modal"
    style="display:none;"
>

    <div class="milk-edit-modal-content">


        <div class="milk-edit-modal-header">

            <h3>
                ✏️ Edit Milk Record
            </h3>

            <button
                type="button"
                class="milk-edit-close"
                onclick="closeEditModal()"
            >
                ×
            </button>

        </div>


        <p>

            You are editing an existing milk record.
            Changes will be recorded under your
            administrator account.

        </p>


        <form
            id="editMilkForm"
            method="POST"
        >


            <label for="editLiters">

                Milk (Liters)

            </label>


            <input
                id="editLiters"
                class="milk-input"
                type="number"
                step="0.1"
                min="0"
                name="liters"
                required
            >


            <label for="editRemarks">

                Remarks

            </label>


            <textarea
                id="editRemarks"
                class="remarks-input"
                name="remarks"
            ></textarea>


            <div class="modal-actions">


                <button
                    type="button"
                    onclick="closeEditModal()"
                >

                    Cancel

                </button>


                <button
                    type="submit"
                    class="modal-ok"
                >

                    Save Changes

                </button>


            </div>


        </form>


    </div>

</div>

<% } %>

<!-- ==========================================================
     ADMIN EDIT JAVASCRIPT
========================================================== --><% if (adminUser) { %>

<script>

function openEditModal(
    recordId,
    liters,
    remarks
) {

    const modal =
        document.getElementById(
            "editMilkModal"
        );

    const form =
        document.getElementById(
            "editMilkForm"
        );

    const litersInput =
        document.getElementById(
            "editLiters"
        );

    const remarksInput =
        document.getElementById(
            "editRemarks"
        );


    if (!modal || !form) {

        return;

    }


    /*
     * The controller route is responsible for
     * receiving the record ID and updating it.
     *
     * The ID is inserted only after the admin
     * taps a specific existing record.
     */

    form.action =
        "/milk/" +
        encodeURIComponent(
            recordId
        );


    litersInput.value =
        liters ?? "";


    remarksInput.value =
        remarks ?? "";


    modal.style.display =
        "flex";


    setTimeout(
        () => {

            litersInput.focus();

            litersInput.select();

        },
        50
    );

}


function closeEditModal() {

    const modal =
        document.getElementById(
            "editMilkModal"
        );

    if (!modal) {

        return;

    }


    modal.style.display =
        "none";

}


document.addEventListener(
    "click",
    function(event) {

        const modal =
            document.getElementById(
                "editMilkModal"
            );

        if (!modal) {

            return;

        }


        if (
            event.target ===
            modal
        ) {

            closeEditModal();

        }

    }
);


document.addEventListener(
    "keydown",
    function(event) {

        if (
            event.key !==
            "Escape"
        ) {

            return;

        }


        closeEditModal();

    }
);

</script><% } %>