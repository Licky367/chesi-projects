                                            type="number"
                                            name="liters"
                                            min="0"
                                            step="0.01"
                                            inputmode="decimal"
                                            placeholder="Enter litres"
                                            required
                                        >

                                        <span class="milk-input-unit">
                                            L
                                        </span>

                                    </div>


                                    <div class="milk-remarks-input">

                                        <input
                                            class="milk-input"
                                            type="text"
                                            name="remarks"
                                            maxlength="250"
                                            placeholder="Remarks (optional)"
                                        >

                                    </div>


                                    <button
                                        type="submit"
                                        class="milk-submit"
                                    >

                                        <svg
                                            class="milk-icon"
                                            aria-hidden="true"
                                        >
                                            <use href="#milk-save"></use>
                                        </svg>

                                        Save morning milk

                                    </button>

                                </form>


                            <% } else { %>


                                <div class="milk-closed-box">

                                    <% if (session === "evening") { %>

                                        <strong>
                                            Morning collection is closed.
                                        </strong>

                                        Existing morning records remain
                                        available for review.

                                    <% } else { %>

                                        <strong>
                                            Morning collection is closed.
                                        </strong>

                                        It will reopen at midnight.

                                    <% } %>

                                </div>


                                <% if (
                                    isAdmin &&
                                    dairy.morning &&
                                    dairy.morning._id
                                ) { %>

                                    <div class="milk-admin-edit">

                                        <button
                                            type="button"
                                            class="milk-edit-button"
                                            onclick="openMilkEditModal(
                                                '<%= dairy.morning._id %>',
                                                '<%= dairy.morningLiters ?? 0 %>',
                                                '<%= String(dairy.morning.remarks || '').replace(/'/g, '&#39;') %>',
                                                'Morning'
                                            )"
                                        >

                                            <svg
                                                class="milk-icon"
                                                aria-hidden="true"
                                            >
                                                <use href="#milk-edit"></use>
                                            </svg>

                                            Edit morning record

                                        </button>

                                    </div>

                                <% } %>

                            <% } %>

                        </div>


                        <!-- ==================================
                             EVENING
                        =================================== -->

                        <div class="milk-session-column">

                            <div class="milk-session-heading">

                                <div class="milk-session-heading-left">

                                    <span class="milk-session-heading-icon evening">

                                        <svg
                                            class="milk-icon"
                                            aria-hidden="true"
                                        >
                                            <use href="#milk-moon"></use>
                                        </svg>

                                    </span>

                                    <span class="milk-session-heading-title">
                                        Evening
                                    </span>

                                </div>


                                <% if (dairy.eveningRecorded) { %>

                                    <span class="milk-recorded-badge">
                                        Recorded
                                    </span>

                                <% } %>

                            </div>


                            <% if (dairy.eveningRecorded) { %>

                                <!-- ==========================
                                     RECORDED EVENING
                                =========================== -->

                                <div class="milk-recorded-box">

                                    <div class="milk-recorded-value">

                                        <span class="milk-recorded-number">
                                            <%= Number(
                                                dairy.eveningLiters || 0
                                            ).toFixed(2) %>
                                        </span>

                                        <span class="milk-recorded-unit">
                                            litres
                                        </span>

                                    </div>


                                    <% if (
                                        dairy.evening &&
                                        dairy.evening.remarks
                                    ) { %>

                                        <div class="milk-recorded-remarks">
                                            <%= dairy.evening.remarks %>
                                        </div>

                                    <% } %>

                                </div>


                                <% if (
                                    isAdmin &&
                                    session === "evening" &&
                                    dairy.evening &&
                                    dairy.evening._id
                                ) { %>

                                    <div class="milk-admin-edit">

                                        <button
                                            type="button"
                                            class="milk-edit-button"
                                            onclick="openMilkEditModal(
                                                '<%= dairy.evening._id %>',
                                                '<%= dairy.eveningLiters ?? 0 %>',
                                                '<%= String(dairy.evening.remarks || '').replace(/'/g, '&#39;') %>',
                                                'Evening'
                                            )"
                                        >

                                            <svg
                                                class="milk-icon"
                                                aria-hidden="true"
                                            >
                                                <use href="#milk-edit"></use>
                                            </svg>

                                            Edit evening record

                                        </button>

                                    </div>

                                <% } %>


                            <% } else if (session === "evening") { %>


                                <!-- ==========================
                                     EVENING FORM
                                =========================== -->

                                <form
                                    class="milk-form"
                                    method="POST"
                                    action="/milk"
                                    onsubmit="return validateMilkForm(this)"
                                >

                                    <input
                                        type="hidden"
                                        name="dairy"
                                        value="<%= dairy._id %>"
                                    >

                                    <input
                                        type="hidden"
                                        name="session"
                                        value="evening"
                                    >


                                    <label class="milk-field-label">
                                        Milk quantity
                                    </label>

                                    <div class="milk-input-wrap">

                                        <input
                                            class="milk-input"
                                            type="number"
                                            name="liters"
                                            min="0"
                                            step="0.01"
                                            inputmode="decimal"
                                            placeholder="Enter litres"
                                            required
                                        >

                                        <span class="milk-input-unit">
                                            L
                                        </span>

                                    </div>


                                    <div class="milk-remarks-input">

                                        <input
                                            class="milk-input"
                                            type="text"
                                            name="remarks"
                                            maxlength="250"
                                            placeholder="Remarks (optional)"
                                        >

                                    </div>


                                    <button
                                        type="submit"
                                        class="milk-submit"
                                    >

                                        <svg
                                            class="milk-icon"
                                            aria-hidden="true"
                                        >
                                            <use href="#milk-save"></use>
                                        </svg>

                                        Save evening milk

                                    </button>

                                </form>


                            <% } else { %>


                                <div class="milk-closed-box">

                                    <% if (session === "morning") { %>

                                        <strong>
                                            Evening collection has not opened.
