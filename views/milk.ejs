        border-radius: 13px;
    }

    .milk-title {
        font-size: 24px;
    }

    .milk-subtitle {
        font-size: 13px;
    }

}


/* ==========================================================
   REDUCE MOTION
========================================================== */

@media (prefers-reduced-motion: reduce) {

    .milk-submit,
    .milk-edit-button,
    .milk-result-button {
        transition: none;
    }

    .milk-modal-card,
    .milk-result-card {
        animation: none;
    }

}

