</span>

<strong>
  <%= Number(stats?.available || 0).toFixed(2) %> L
</strong>

</div>


<div class="summary-box">

<span>
  Average Per Animal
</span>

<strong>
  <%= Number(stats?.avg || 0).toFixed(2) %> L
</strong>

</div>


<div class="summary-box">

<span>
  Global Revenue
</span>

<strong>
  KES <%= Number(stats?.cash || 0) %>
</strong>

</div>


</div>

</div>


<% } %>


