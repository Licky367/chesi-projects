<!-- =========================================================
     MILK COLLECTION PAGE

     FILE:
     views/milk.ejs

     PURPOSE
     ---------------------------------------------------------
     Records today's milk production.

     DATA PROVIDED BY:
     controllers/milkCollectController.js

     EXPECTED DATA:
     ---------------------------------------------------------
     day
     month
     farms
     isAdmin
     user
     success
     error

     PERMISSIONS:
     ---------------------------------------------------------
     Admin:
         • Can create records
         • Can edit existing records

     Dairy Worker:
         • Can create records
         • Cannot edit existing records
========================================================= -->


<!-- =========================================================
     SAFE VIEW VARIABLES
========================================================= -->

<%
    /*
     * The controller should normally provide these values.
     *
     * However, EJS throws a ReferenceError if a variable has
     * never been passed into res.render().
     *
     * Therefore we safely check typeof before using them.
     */

    const pageDay =
        typeof day !== "undefined" && day
            ? day
            : new Date().toISOString().slice(0, 10);


    const pageMonth =
        typeof month !== "undefined" && month
            ? month
            : "";


    const pageFarms =
        typeof farms !== "undefined" &&
        Array.isArray(farms)
            ? farms
            : [];


    const pageIsAdmin =
        typeof isAdmin !== "undefined"
            ? Boolean(isAdmin)
            : Boolean(
                typeof user !== "undefined" &&
                user &&
                user.role === "admin"
            );


    const pageSuccess =
        typeof success !== "undefined"
            ? success
            : "";


    const pageError =
        typeof error !== "undefined"
            ? error
            : "";
%>


<!-- =========================================================
     STYLESHEET
========================================================= -->

<link
    rel="stylesheet"
    href="/css/milk.css"
>


<!-- =========================================================
     PAGE
========================================================= -->

<div class="milk-page">


    <!-- =====================================================
         PAGE HEADER
    ====================================================== -->

    <header class="milk-header">

        <div class="milk-header-content">

            <h1>
                Record Today's Milk
            </h1>

            <p class="milk-date">
                <%= pageDay %>
            </p>

        </div>


        <!-- =================================================
             USER ROLE
        ================================================== -->

        <div class="milk-role-badge">

            <% if (pageIsAdmin) { %>

                Administrator

            <% } else { %>

                Dairy Worker

            <% } %>

        </div>

    </header>



    <!-- =====================================================
         FLASH / STATUS MESSAGES
    ====================================================== -->

    <% if (pageSuccess) { %>

        <div
            class="milk-message milk-success"
            role="alert"
        >

            <%= pageSuccess %>

        </div>

    <% } %>


    <% if (pageError) { %>

        <div
            class="milk-message milk-error"
            role="alert"
        >

            <%= pageError %>

        </div>

    <% } %>



    <!-- =====================================================
         NO FARMS
    ====================================================== -->

    <% if (pageFarms.length === 0) { %>

        <section class="milk-empty">

            <h2>
                No Dairy Farms Available
            </h2>

            <p>
                There are currently no dairy farms available
                for milk collection.
            </p>

        </section>

    <% } %>



    <!-- =====================================================
         COLLECTION FORM
    ====================================================== -->

    <% if (pageFarms.length > 0) { %>

        <form
            action="/milk"
            method="POST"
            id="milkCollectionForm"
            autocomplete="off"
        >


            <!-- =================================================
                 FARMS
            ================================================== -->

            <% pageFarms.forEach(function(farm) { %>


                <%
                    /*
                     * Make sure farm.animals is always an array.
                     */

                    const farmAnimals =
                        Array.isArray(farm.animals)
                            ? farm.animals
                            : [];


                    const farmTotal =
                        Number(farm.total || 0);
                %>


                <section
                    class="milk-farm-section"
                    data-farm-id="<%= farm._id %>"
                    data-farm-code="<%= farm.code %>"
                >


                    <!-- =========================================
                         FARM HEADER
                    ========================================== -->

                    <div class="milk-farm-header">


                        <!-- =====================================
                             FARM INFORMATION
                        ====================================== -->

                        <div class="milk-farm-information">

                            <h2>
                                <%= farm.name || "Unnamed Farm" %>
                            </h2>

                            <span class="milk-farm-code">

                                Farm Code:
                                <%= farm.code || "" %>

                            </span>

                        </div>



                        <!-- =====================================
                             FARM TOTAL
                        ====================================== -->

                        <div class="milk-farm-total">

                            <span>
                                Today's Farm Total
                            </span>

                            <strong>
                                <%= farmTotal.toFixed(2) %> L
                            </strong>

                        </div>


                    </div>



                    <!-- =========================================
                         FARM HAS NO MILKING ANIMALS
                    ========================================== -->

                    <% if (farmAnimals.length === 0) { %>


                        <div class="milk-no-animals">

                            No milking animals are currently
                            registered for this farm.

                        </div>


                    <% } else { %>



                        <!-- =====================================
                             TABLE WRAPPER
                        ====================================== -->

                        <div class="milk-table-wrapper">


                            <table class="milk-table">


                                <!-- =================================
                                     TABLE HEADER
                                ================================== -->

                                <thead>

                                    <tr>

                                        <th
                                            rowspan="2"
                                            scope="col"
                                        >
                                            Animal
                                        </th>

                                        <th
                                            colspan="2"
                                            scope="colgroup"
                                        >
                                            Morning
                                        </th>

                                        <th
                                            colspan="2"
                                            scope="colgroup"
                                        >
                                            Evening
                                        </th>

                                    </tr>


                                    <tr>

                                        <th scope="col">
                                            Liters
                                        </th>

                                        <th scope="col">
                                            Remarks
                                        </th>

                                        <th scope="col">
                                            Liters
                                        </th>

                                        <th scope="col">
                                            Remarks
                                        </th>

                                    </tr>

                                </thead>



                                <!-- =================================
                                     TABLE BODY
                                ================================== -->

                                <tbody>


                                    <% farmAnimals.forEach(function(animal) { %>


                                        <%
                                            /*
                                             * Existing morning record.
                                             */

                                            const morning =
                                                animal.morning ||
                                                null;


                                            /*
                                             * Existing evening record.
                                             */

                                            const evening =
                                                animal.evening ||
                                                null;


                                            /*
                                             * Existing records are locked
                                             * for dairy workers.
                                             *
                                             * Administrators may edit them.
                                             */

                                            const morningLocked =
                                                Boolean(morning);


                                            const eveningLocked =
                                                Boolean(evening);


                                            /*
                                             * Existing morning liters.
                                             */

                                            const morningLiters =
                                                morning &&
                                                morning.liters !== undefined &&
                                                morning.liters !== null
                                                    ? morning.liters
                                                    : "";


                                            /*
                                             * Existing morning remarks.
                                             */

                                            const morningRemarks =
                                                morning &&
                                                morning.remarks
                                                    ? morning.remarks
                                                    : "";


                                            /*
                                             * Existing evening liters.
                                             */

                                            const eveningLiters =
                                                evening &&
                                                evening.liters !== undefined &&
                                                evening.liters !== null
                                                    ? evening.liters
                                                    : "";


                                            /*
                                             * Existing evening remarks.
                                             */

                                            const eveningRemarks =
                                                evening &&
                                                evening.remarks
                                                    ? evening.remarks
                                                    : "";
                                        %>


                                        <!-- =================================
                                             ANIMAL ROW
                                        ================================== -->

                                        <tr
                                            class="milk-animal-row"
                                            data-animal-id="<%= animal._id %>"
                                            data-farm-id="<%= farm._id %>"
                                        >


                                            <!-- =============================
                                                 ANIMAL
                                            ============================== -->

                                            <td class="milk-animal-cell">

                                                <div class="milk-animal-name">

                                                    <strong>
                                                        <%= animal.name || "Unnamed Animal" %>
                                                    </strong>

                                                </div>


                                                <small class="milk-animal-code">

                                                    #<%= animal.code || animal.assetCode || "" %>

                                                </small>

                                            </td>



                                            <!-- =============================
                                                 MORNING LITERS
                                            ============================== -->

                                            <td class="milk-liters-cell">

                                                <input
                                                    type="number"
                                                    name="records[<%= animal._id %>][morning][liters]"
                                                    class="milk-liters-input"
                                                    min="0"
                                                    step="0.01"
                                                    inputmode="decimal"
                                                    value="<%= morningLiters %>"
                                                    data-session="morning"
                                                    data-animal-id="<%= animal._id %>"
                                                    aria-label="Morning milk liters for <%= animal.name || 'animal' %>"

                                                    <% if (!pageIsAdmin && morningLocked) { %>
                                                        readonly
                                                        aria-readonly="true"
                                                    <% } %>
                                                >

                                            </td>



                                            <!-- =============================
                                                 MORNING REMARKS
                                            ============================== -->

                                            <td class="milk-remarks-cell">

                                                <input
                                                    type="text"
                                                    name="records[<%= animal._id %>][morning][remarks]"
                                                    class="milk-remarks-input"
                                                    value="<%= morningRemarks %>"
                                                    maxlength="500"
                                                    data-session="morning"
                                                    data-animal-id="<%= animal._id %>"
                                                    aria-label="Morning remarks for <%= animal.name || 'animal' %>"

                                                    <% if (!pageIsAdmin && morningLocked) { %>
                                                        readonly
                                                        aria-readonly="true"
                                                    <% } %>
                                                >

                                            </td>



                                            <!-- =============================
                                                 EVENING LITERS
                                            ============================== -->

                                            <td class="milk-liters-cell">

                                                <input
                                                    type="number"
                                                    name="records[<%= animal._id %>][evening][liters]"
                                                    class="milk-liters-input"
                                                    min="0"
                                                    step="0.01"
                                                    inputmode="decimal"
                                                    value="<%= eveningLiters %>"
                                                    data-session="evening"
                                                    data-animal-id="<%= animal._id %>"
                                                    aria-label="Evening milk liters for <%= animal.name || 'animal' %>"

                                                    <% if (!pageIsAdmin && eveningLocked) { %>
                                                        readonly
                                                        aria-readonly="true"
                                                    <% } %>
                                                >

                                            </td>



                                            <!-- =============================
                                                 EVENING REMARKS
                                            ============================== -->

                                            <td class="milk-remarks-cell">

                                                <input
                                                    type="text"
                                                    name="records[<%= animal._id %>][evening][remarks]"
                                                    class="milk-remarks-input"
                                                    value="<%= eveningRemarks %>"
                                                    maxlength="500"
                                                    data-session="evening"
                                                    data-animal-id="<%= animal._id %>"
                                                    aria-label="Evening remarks for <%= animal.name || 'animal' %>"

                                                    <% if (!pageIsAdmin && eveningLocked) { %>
                                                        readonly
                                                        aria-readonly="true"
                                                    <% } %>
                                                >

                                            </td>


                                        </tr>


                                    <% }); %>


                                </tbody>


                            </table>


                        </div>


                    <% } %>


                </section>


            <% }); %>



            <!-- =================================================
                 SUBMIT AREA
            ================================================== -->

            <div class="milk-submit-area">


                <!-- =============================================
                     PERMISSION MESSAGE
                ============================================== -->

                <% if (pageIsAdmin) { %>


                    <p class="milk-admin-note">

                        Administrator mode:
                        existing milk records can be edited.

                    </p>


                <% } else { %>


                    <p class="milk-worker-note">

                        Existing submitted milk records are
                        read-only for dairy workers.

                    </p>


                <% } %>



                <!-- =============================================
                     SUBMIT BUTTON
                ============================================== -->

                <button
                    type="submit"
                    class="milk-submit-button"
                    id="milkSubmitButton"
                >

                    <% if (pageIsAdmin) { %>

                        Save Milk Records

                    <% } else { %>

                        Submit Today's Milk

                    <% } %>

                </button>


            </div>


        </form>


    <% } %>


</div>



<!-- =========================================================
     PAGE JAVASCRIPT
========================================================= -->

<script>

document.addEventListener(
    "DOMContentLoaded",
    function() {


        /* =====================================================
           COLLECTION FORM
        ====================================================== */

        const form =
            document.getElementById(
                "milkCollectionForm"
            );


        /*
         * There is no form when there are no farms.
         */

        if (!form) {

            return;

        }



        /* =====================================================
           SUBMIT BUTTON
        ====================================================== */

        const submitButton =
            document.getElementById(
                "milkSubmitButton"
            );



        /* =====================================================
           FARM TOTAL
           -----------------------------------------------------
           Client-side preview only.

           The server remains authoritative.
        ====================================================== */

        function updateFarmTotal(
            farmSection
        ) {

            if (!farmSection) {

                return;

            }


            let total =
                0;


            const inputs =
                farmSection.querySelectorAll(
                    ".milk-liters-input"
                );


            inputs.forEach(
                function(input) {

                    const rawValue =
                        input.value;


                    if (rawValue === "") {

                        return;

                    }


                    const value =
                        Number(rawValue);


                    if (
                        Number.isFinite(value) &&
                        value >= 0
                    ) {

                        total += value;

                    }

                }
            );


            const totalElement =
                farmSection.querySelector(
                    ".milk-farm-total strong"
                );


            if (!totalElement) {

                return;

            }


            totalElement.textContent =
                total.toFixed(2) +
                " L";

        }



        /* =====================================================
           UPDATE ALL FARM TOTALS
        ====================================================== */

        const farmSections =
            document.querySelectorAll(
                ".milk-farm-section"
            );


        farmSections.forEach(
            function(farmSection) {

                const inputs =
                    farmSection.querySelectorAll(
                        ".milk-liters-input"
                    );


                inputs.forEach(
                    function(input) {

                        input.addEventListener(
                            "input",
                            function() {

                                updateFarmTotal(
                                    farmSection
                                );

                            }
                        );

                    }
                );


                /*
                 * Calculate initial total.
                 */

                updateFarmTotal(
                    farmSection
                );

            }
        );



        /* =====================================================
           FORM SUBMISSION
        ====================================================== */

        form.addEventListener(
            "submit",
            function(event) {


                /*
                 * Prevent accidental double submission.
                 */

                if (
                    form.dataset.submitting === "true"
                ) {

                    event.preventDefault();

                    return;

                }


                form.dataset.submitting =
                    "true";


                /*
                 * Disable submit button.
                 *
                 * Inputs are deliberately NOT disabled because
                 * disabled inputs are not submitted by browsers.
                 */

                if (submitButton) {

                    submitButton.disabled =
                        true;

                    submitButton.setAttribute(
                        "aria-disabled",
                        "true"
                    );

                    submitButton.textContent =
                        "Saving...";

                }

            }
        );



        /* =====================================================
           PREVENT NEGATIVE CLIENT INPUT
           -----------------------------------------------------
           Server validation remains authoritative.
        ====================================================== */

        const litersInputs =
            form.querySelectorAll(
                ".milk-liters-input"
            );


        litersInputs.forEach(
            function(input) {

                input.addEventListener(
                    "input",
                    function() {

                        const rawValue =
                            input.value;


                        if (rawValue === "") {

                            return;

                        }


                        const value =
                            Number(rawValue);


                        if (
                            Number.isFinite(value) &&
                            value < 0
                        ) {

                            input.value =
                                "";

                        }

                    }
                );

            }
        );


    }
);

</script>