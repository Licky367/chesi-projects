<!-- =========================================================
     MILK RECORDING PAGE

     FILE:
     views/milk.ejs

     PURPOSE
     ---------------------------------------------------------
     Records today's milk production for active milking cows.

     SESSION MODEL
     ---------------------------------------------------------
     MORNING:
         00:00 - 10:00

     CLOSED MORNING:
         10:00 - 16:00

     EVENING:
         16:00 - 00:00

     IMPORTANT
     ---------------------------------------------------------
     Only ONE recording column is displayed.

     During morning:
         The column records morning milk.

     During evening:
         The column records evening milk.

     The previous session remains stored in MongoDB but is
     not displayed in the active recording column.

     ADMIN:
         • Can create records
         • Can edit existing records
         • Can edit closed-session records

     DAIRY WORKER:
         • Can record a new session
         • Cannot edit a submitted record
         • Can enter a morning record during the closed
           morning period
         • Cannot enter/edit morning during evening

     EXPECTED DATA
     ---------------------------------------------------------
     day
     month
     farms
     isAdmin
     user
     success
     error
========================================================= -->


<!-- =========================================================
     SAFE VIEW VARIABLES
========================================================= -->

<%

    /*
     * Safely read controller variables.
     */

    const pageDay =
        typeof day !== "undefined" && day
            ? day
            : new Date().toISOString().slice(0, 10);


    const pageMonth =
        typeof month !== "undefined" && month
            ? month
            : pageDay.slice(0, 7);


    const pageFarms =
        typeof farms !== "undefined" &&
        Array.isArray(farms)
            ? farms
            : [];


    const pageIsAdmin =
        typeof isAdmin !== "undefined"
            ? Boolean(isAdmin)
            : Boolean(
                typeof user !== "undefined" &&
                user &&
                user.role === "admin"
            );


    const pageSuccess =
        typeof success !== "undefined"
            ? success
            : "";


    const pageError =
        typeof error !== "undefined"
            ? error
            : "";


    /*
     * ========================================================
     * NAIROBI CURRENT TIME
     * ========================================================
     *
     * The milk system operates using Africa/Nairobi time.
     *
     * We determine the current hour on the server-rendered
     * page so that the correct session is displayed.
     */

    const now =
        new Date();


    const nairobiTime =
        new Intl.DateTimeFormat(
            "en-GB",
            {
                timeZone: "Africa/Nairobi",
                hour: "2-digit",
                minute: "2-digit",
                hour12: false
            }
        ).format(now);


    const timeParts =
        nairobiTime.split(":");


    const currentHour =
        Number(timeParts[0]);


    const currentMinute =
        Number(timeParts[1]);


    const currentMinutes =
        (
            currentHour * 60
        ) +
        currentMinute;


    /*
     * ========================================================
     * SESSION WINDOWS
     * ========================================================
     */

    const morningStart =
        0;


    const morningEnd =
        10 * 60;


    const eveningStart =
        16 * 60;


    let currentSession =
        "morning";


    let sessionLabel =
        "Morning";


    let sessionStatus =
        "open";


    /*
     * 00:00 - 09:59
     * Morning recording.
     */

    if (
        currentMinutes >= morningStart &&
        currentMinutes < morningEnd
    ) {

        currentSession =
            "morning";

        sessionLabel =
            "Morning";

        sessionStatus =
            "open";

    }


    /*
     * 10:00 - 15:59
     * Morning is closed but the page is still outside
     * the evening recording window.
     */

    else if (
        currentMinutes >= morningEnd &&
        currentMinutes < eveningStart
    ) {

        currentSession =
            "morning";

        sessionLabel =
            "Morning";

        sessionStatus =
            "closed";

    }


    /*
     * 16:00 - 23:59
     * Evening recording.
     */

    else {

        currentSession =
            "evening";

        sessionLabel =
            "Evening";

        sessionStatus =
            "open";

    }


    /*
     * ========================================================
     * SESSION DESCRIPTION
     * ========================================================
     */

    let sessionDescription =
        "";


    if (
        currentSession === "morning" &&
        sessionStatus === "open"
    ) {

        sessionDescription =
            "Morning recording is open until 10:00 AM.";

    }

    else if (
        currentSession === "morning" &&
        sessionStatus === "closed"
    ) {

        sessionDescription =
            "Morning session is closed. New morning records may still be entered before the evening session begins.";

    }

    else {

        sessionDescription =
            "Evening recording is open from 4:00 PM until midnight.";

    }

%>


<!-- =========================================================
     STYLESHEET
========================================================= -->

<link
    rel="stylesheet"
    href="/css/milk.css"
>


<!-- =========================================================
     PAGE
========================================================= -->

<div
    class="milk-page"
    data-day="<%= pageDay %>"
    data-month="<%= pageMonth %>"
    data-session="<%= currentSession %>"
    data-session-status="<%= sessionStatus %>"
    data-is-admin="<%= pageIsAdmin %>"
>


    <!-- =====================================================
         PAGE HEADER
    ====================================================== -->

    <header class="milk-header">

        <div class="milk-header-content">

            <h1>
                Record Today's Milk
            </h1>

            <p class="milk-date">
                <%= pageDay %>
            </p>

        </div>


        <!-- =================================================
             ROLE
        ================================================== -->

        <div class="milk-role-badge">

            <% if (pageIsAdmin) { %>

                Administrator

            <% } else { %>

                Dairy Worker

            <% } %>

        </div>

    </header>



    <!-- =====================================================
         SESSION BAR
    ====================================================== -->

    <section
        class="milk-session-bar"
        aria-label="Milk recording session"
    >

        <div class="milk-session-information">

            <span class="milk-session-label">
                Current Recording
            </span>

            <strong class="milk-session-name">
                <%= sessionLabel %> Session
            </strong>

            <span class="milk-session-time">
                <% if (currentSession === "morning") { %>

                    12:00 AM – 10:00 AM

                <% } else { %>

                    4:00 PM – 12:00 AM

                <% } %>
            </span>

        </div>


        <div
            class="milk-session-status milk-session-status-<%= sessionStatus %>"
        >

            <% if (sessionStatus === "open") { %>

                Session Open

            <% } else { %>

                Morning Session Closed

            <% } %>

        </div>

    </section>



    <!-- =====================================================
         SESSION INFORMATION
    ====================================================== -->

    <div class="milk-session-note">

        <strong>
            <%= sessionLabel %> recording:
        </strong>

        <span>
            <%= sessionDescription %>
        </span>

    </div>



    <!-- =====================================================
         FLASH / STATUS MESSAGES
    ====================================================== -->

    <% if (pageSuccess) { %>

        <div
            class="milk-message milk-success"
            role="alert"
        >

            <%= pageSuccess %>

        </div>

    <% } %>


    <% if (pageError) { %>

        <div
            class="milk-message milk-error"
            role="alert"
        >

            <%= pageError %>

        </div>

    <% } %>



    <!-- =====================================================
         NO FARMS
    ====================================================== -->

    <% if (pageFarms.length === 0) { %>

        <section class="milk-empty">

            <h2>
                No Dairy Farms Available
            </h2>

            <p>
                There are currently no active dairy farms
                available for milk recording.
            </p>

        </section>

    <% } %>



    <!-- =====================================================
         COLLECTION FORM
    ====================================================== -->

    <% if (pageFarms.length > 0) { %>

        <form
            action="/milk"
            method="POST"
            id="milkCollectionForm"
            autocomplete="off"
        >


            <!-- =================================================
                 FARMS
            ================================================== -->

            <% pageFarms.forEach(function(farm) { %>


                <%

                    const farmAnimals =
                        Array.isArray(farm.animals)
                            ? farm.animals
                            : [];


                    /*
                     * Server-provided farm total.
                     *
                     * This is today's total based on all
                     * stored records.
                     */

                    const farmTotal =
                        Number(farm.total || 0);

                %>


                <section
                    class="milk-farm-section"
                    data-farm-id="<%= farm._id %>"
                    data-farm-code="<%= farm.code %>"
                >


                    <!-- =========================================
                         FARM HEADER
                    ========================================== -->

                    <div class="milk-farm-header">


                        <div class="milk-farm-information">

                            <h2>
                                <%= farm.name || "Unnamed Farm" %>
                            </h2>

                            <span class="milk-farm-code">

                                Farm Code:
                                <%= farm.code || "" %>

                            </span>

                        </div>



                        <!-- =====================================
                             FARM TOTAL
                        ====================================== -->

                        <div class="milk-farm-total">

                            <span>
                                Today's Farm Total
                            </span>

                            <strong>
                                <%= farmTotal.toFixed(2) %> L
                            </strong>

                        </div>

                    </div>



                    <!-- =========================================
                         NO ANIMALS
                    ========================================== -->

                    <% if (farmAnimals.length === 0) { %>

                        <div class="milk-no-animals">

                            No milking animals are currently
                            registered for this farm.

                        </div>


                    <% } else { %>



                        <!-- =====================================
                             TABLE
                        ====================================== -->

                        <div class="milk-table-wrapper">

                            <table
                                class="milk-table"
                                data-farm-code="<%= farm.code %>"
                            >


                                <!-- =================================
                                     TABLE HEADER
                                ================================== -->

                                <thead>

                                    <tr>

                                        <th
                                            scope="col"
                                            class="milk-animal-heading"
                                        >
                                            Animal
                                        </th>

                                        <th
                                            scope="col"
                                            class="milk-record-heading"
                                        >

                                            <span>
                                                <%= sessionLabel %> Record
                                            </span>

                                            <small>

                                                Liters / Remarks

                                            </small>

                                        </th>

                                        <th
                                            scope="col"
                                            class="milk-cumulative-heading"
                                        >

                                            Cumulative

                                        </th>

                                    </tr>

                                </thead>



                                <!-- =================================
                                     TABLE BODY
                                ================================== -->

                                <tbody>


                                    <% farmAnimals.forEach(function(animal) { %>


                                        <%

                                            /*
                                             * ==================================================
                                             * SESSION RECORD
                                             * ==================================================
                                             *
                                             * The service supplies:
                                             *
                                             *     animal.morning
                                             *     animal.evening
                                             *
                                             * Only the CURRENT session is shown in the
                                             * recording column.
                                             */

                                            const activeRecord =
                                                currentSession === "morning"

                                                    ? (
                                                        animal.morning ||
                                                        null
                                                    )

                                                    : (
                                                        animal.evening ||
                                                        null
                                                    );


                                            /*
                                             * ==================================================
                                             * EXISTING RECORD
                                             * ==================================================
                                             */

                                            const hasRecord =
                                                Boolean(
                                                    activeRecord
                                                );


                                            /*
                                             * Existing record liters.
                                             */

                                            const activeLiters =
                                                activeRecord &&
                                                activeRecord.liters !== undefined &&
                                                activeRecord.liters !== null

                                                    ? activeRecord.liters

                                                    : "";


                                            /*
                                             * Existing remarks.
                                             */

                                            const activeRemarks =
                                                activeRecord &&
                                                activeRecord.remarks

                                                    ? activeRecord.remarks

                                                    : "";


                                            /*
                                             * ==================================================
                                             * WORKER LOCK
                                             * ==================================================
                                             *
                                             * Once a dairy worker has submitted the current
                                             * session record, it becomes read-only.
                                             *
                                             * Admin is never locked.
                                             */

                                            const recordLocked =
                                                !pageIsAdmin &&
                                                hasRecord;


                                            /*
                                             * ==================================================
                                             * CUMULATIVE
                                             * ==================================================
                                             *
                                             * The service currently supplies morning and
                                             * evening records separately.
                                             *
                                             * Therefore the cumulative value is calculated
                                             * from both stored records.
                                             */

                                            const morningRecord =
                                                animal.morning ||
                                                null;


                                            const eveningRecord =
                                                animal.evening ||
                                                null;


                                            const morningLiters =
                                                morningRecord &&
                                                morningRecord.liters !== undefined &&
                                                morningRecord.liters !== null

                                                    ? Number(
                                                        morningRecord.liters
                                                    )

                                                    : 0;


                                            const eveningLiters =
                                                eveningRecord &&
                                                eveningRecord.liters !== undefined &&
                                                eveningRecord.liters !== null

                                                    ? Number(
                                                        eveningRecord.liters
                                                    )

                                                    : 0;


                                            const cumulative =
                                                (
                                                    Number.isFinite(
                                                        morningLiters
                                                    )
                                                        ? morningLiters
                                                        : 0
                                                ) +

                                                (
                                                    Number.isFinite(
                                                        eveningLiters
                                                    )
                                                        ? eveningLiters
                                                        : 0
                                                );


                                        %>


                                        <!-- =================================
                                             ANIMAL ROW
                                        ================================== -->

                                        <tr
                                            class="milk-animal-row"
                                            data-animal-id="<%= animal._id %>"
                                            data-farm-id="<%= farm._id %>"
                                        >


                                            <!-- =============================
                                                 ANIMAL
                                            ============================== -->

                                            <td class="milk-animal-cell">

                                                <div class="milk-animal-name">

                                                    <strong>
                                                        <%= animal.name || "Unnamed Animal" %>
                                                    </strong>

                                                </div>


                                                <small class="milk-animal-code">

                                                    #<%= animal.code || animal.assetCode || "" %>

                                                </small>

                                            </td>



                                            <!-- =============================
                                                 ACTIVE SESSION RECORD
                                            ============================== -->

                                            <td
                                                class="milk-record-cell"
                                                data-session="<%= currentSession %>"
                                            >


                                                <!-- =============================
                                                     RECORD INPUT
                                                ============================== -->

                                                <div class="milk-record-input-group">


                                                    <label
                                                        class="milk-input-label"
                                                        for="milk-<%= currentSession %>-<%= animal._id %>"
                                                    >

                                                        Liters

                                                    </label>


                                                    <input
                                                        type="number"
                                                        id="milk-<%= currentSession %>-<%= animal._id %>"
                                                        name="records[<%= animal._id %>][<%= currentSession %>][liters]"
                                                        class="milk-liters-input"
                                                        min="0"
                                                        step="0.01"
                                                        inputmode="decimal"
                                                        value="<%= activeLiters %>"
                                                        data-session="<%= currentSession %>"
                                                        data-animal-id="<%= animal._id %>"
                                                        aria-label="<%= sessionLabel %> milk liters for <%= animal.name || 'animal' %>"

                                                        <% if (recordLocked) { %>

                                                            readonly
                                                            aria-readonly="true"

                                                        <% } %>

                                                    >

                                                </div>



                                                <!-- =============================
                                                     REMARKS
                                                ============================== -->

                                                <div class="milk-record-remarks-group">

                                                    <label
                                                        class="milk-input-label"
                                                        for="remarks-<%= currentSession %>-<%= animal._id %>"
                                                    >

                                                        Remarks

                                                    </label>


                                                    <input
                                                        type="text"
                                                        id="remarks-<%= currentSession %>-<%= animal._id %>"
                                                        name="records[<%= animal._id %>][<%= currentSession %>][remarks]"
                                                        class="milk-remarks-input"
                                                        value="<%= activeRemarks %>"
                                                        maxlength="500"
                                                        data-session="<%= currentSession %>"
                                                        data-animal-id="<%= animal._id %>"
                                                        placeholder="Optional remarks"
                                                        aria-label="<%= sessionLabel %> remarks for <%= animal.name || 'animal' %>"

                                                        <% if (recordLocked) { %>

                                                            readonly
                                                            aria-readonly="true"

                                                        <% } %>

                                                    >

                                                </div>



                                                <!-- =============================
                                                     RECORD STATUS
                                                ============================== -->

                                                <div class="milk-record-status">


                                                    <% if (hasRecord) { %>

                                                        <% if (recordLocked) { %>

                                                            <span class="milk-status-locked">

                                                                Submitted — Read Only

                                                            </span>

                                                        <% } else { %>

                                                            <span class="milk-status-recorded">

                                                                Recorded — Admin Editable

                                                            </span>

                                                        <% } %>


                                                    <% } else { %>

                                                        <span class="milk-status-pending">

                                                            Not Recorded

                                                        </span>

                                                    <% } %>


                                                </div>


                                            </td>



                                            <!-- =============================
                                                 CUMULATIVE
                                            ============================== -->

                                            <td class="milk-cumulative-cell">

                                                <strong class="milk-cumulative-value">

                                                    <%= cumulative.toFixed(2) %> L

                                                </strong>


                                                <small class="milk-cumulative-label">

                                                    Today

                                                </small>

                                            </td>


                                        </tr>


                                    <% }); %>


                                </tbody>


                            </table>

                        </div>


                    <% } %>


                </section>


            <% }); %>



            <!-- =================================================
                 SUBMIT AREA
            ================================================== -->

            <div class="milk-submit-area">


                <!-- =============================================
                     WORKER INFORMATION
                ============================================== -->

                <% if (!pageIsAdmin) { %>

                    <p class="milk-worker-note">

                        Once you submit a milk record, it becomes
                        read-only for you. Administrators can still
                        edit submitted records.

                    </p>

                <% } else { %>

                    <p class="milk-admin-note">

                        Administrator mode:
                        existing records can be edited.

                    </p>

                <% } %>



                <!-- =============================================
                     ZERO RECORD INFORMATION
                ============================================== -->

                <p class="milk-zero-note">

                    If a cow is not milked or no record is entered
                    before the session closes, the session is
                    automatically recorded as:

                    <strong>
                        0 L — Not Milked/recorded
                    </strong>

                </p>



                <!-- =============================================
                     SUBMIT BUTTON
                ============================================== -->

                <button
                    type="submit"
                    class="milk-submit-button"
                    id="milkSubmitButton"
                >

                    <% if (pageIsAdmin) { %>

                        Save <%= sessionLabel %> Records

                    <% } else { %>

                        Submit <%= sessionLabel %> Records

                    <% } %>

                </button>


            </div>


        </form>


    <% } %>


</div>



<!-- =========================================================
     PAGE JAVASCRIPT
========================================================= -->

<script>

document.addEventListener(
    "DOMContentLoaded",
    function() {


        /* =====================================================
           FORM
        ====================================================== */

        const form =
            document.getElementById(
                "milkCollectionForm"
            );


        if (!form) {

            return;

        }



        /* =====================================================
           SUBMIT BUTTON
        ====================================================== */

        const submitButton =
            document.getElementById(
                "milkSubmitButton"
            );



        /* =====================================================
           UPDATE FARM TOTAL
           -----------------------------------------------------
           This is only a visual preview.

           The server remains authoritative.
        ====================================================== */

        function updateFarmTotal(
            farmSection
        ) {

            if (!farmSection) {

                return;

            }


            /*
             * The displayed farm total is today's total,
             * therefore both session records contribute.
             *
             * However, because only the active session is
             * editable, the existing server total is used
             * as the starting value.
             *
             * We only add the current visible unsaved values
             * where appropriate.
             */

            let total =
                0;


            const rows =
                farmSection.querySelectorAll(
                    ".milk-animal-row"
                );


            rows.forEach(
                function(row) {

                    const input =
                        row.querySelector(
                            ".milk-liters-input"
                        );


                    if (!input) {

                        return;

                    }


                    const value =
                        Number(
                            input.value
                        );


                    if (
                        Number.isFinite(value) &&
                        value >= 0
                    ) {

                        total += value;

                    }

                }
            );


            /*
             * This is intentionally a preview of the currently
             * displayed session, not the authoritative daily
             * total.
             */

            const totalElement =
                farmSection.querySelector(
                    ".milk-farm-total strong"
                );


            if (!totalElement) {

                return;

            }


            /*
             * Keep the server-rendered total until a user
             * actually changes a field.
             */

            if (
                farmSection.dataset.edited !== "true"
            ) {

                return;

            }


            totalElement.textContent =
                total.toFixed(2) +
                " L";

        }



        /* =====================================================
           INPUT LISTENERS
        ====================================================== */

        const farmSections =
            document.querySelectorAll(
                ".milk-farm-section"
            );


        farmSections.forEach(
            function(farmSection) {


                const inputs =
                    farmSection.querySelectorAll(
                        ".milk-liters-input"
                    );


                inputs.forEach(
                    function(input) {


                        input.addEventListener(
                            "input",
                            function() {


                                farmSection.dataset.edited =
                                    "true";


                                updateFarmTotal(
                                    farmSection
                                );

                            }
                        );


                    }
                );


            }
        );



        /* =====================================================
           PREVENT NEGATIVE VALUES
        ====================================================== */

        const litersInputs =
            form.querySelectorAll(
                ".milk-liters-input"
            );


        litersInputs.forEach(
            function(input) {


                input.addEventListener(
                    "input",
                    function() {


                        const rawValue =
                            input.value;


                        if (
                            rawValue === ""
                        ) {

                            return;

                        }


                        const value =
                            Number(
                                rawValue
                            );


                        if (
                            Number.isFinite(value) &&
                            value < 0
                        ) {

                            input.value =
                                "";

                        }


                    }
                );


            }
        );



        /* =====================================================
           FORM SUBMISSION
        ====================================================== */

        form.addEventListener(
            "submit",
            function(event) {


                /*
                 * Prevent duplicate submissions.
                 */

                if (
                    form.dataset.submitting === "true"
                ) {

                    event.preventDefault();

                    return;

                }


                form.dataset.submitting =
                    "true";


                /*
                 * Disable only the submit button.
                 *
                 * Inputs must NOT be disabled because disabled
                 * inputs are excluded from normal form submission.
                 */

                if (submitButton) {

                    submitButton.disabled =
                        true;


                    submitButton.setAttribute(
                        "aria-disabled",
                        "true"
                    );


                    submitButton.textContent =
                        "Saving...";

                }


            }
        );


    }
);

</script>