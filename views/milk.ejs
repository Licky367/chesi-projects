                                    <% } else { %>

                                        <strong>
                                            Evening collection is closed.
                                        </strong>

                                        It will reopen at 4:00 PM.

                                    <% } %>

                                </div>


                                <% if (
                                    isAdmin &&
                                    dairy.evening &&
                                    dairy.evening._id &&
                                    session === "closed"
                                ) { %>

                                    <div class="milk-admin-edit">

                                        <button
                                            type="button"
                                            class="milk-edit-button"
                                            onclick="openMilkEditModal(
                                                '<%= dairy.evening._id %>',
                                                '<%= dairy.eveningLiters ?? 0 %>',
                                                '<%= String(dairy.evening.remarks || '').replace(/'/g, '&#39;') %>',
                                                'Evening'
                                            )"
                                        >

                                            <svg
                                                class="milk-icon"
                                                aria-hidden="true"
                                            >
                                                <use href="#milk-edit"></use>
                                            </svg>

                                            Edit evening record

