<!-- =========================================================
     MILK RECORDING PAGE

     FILE:
     views/milk.ejs

     TABLE:
     ---------------------------------------------------------
     Name | Input (Litres) | Remarks | Cumulative

     SESSION MODEL
     ---------------------------------------------------------
     MORNING:
         00:00 - 10:00

     CLOSED MORNING:
         10:00 - 16:00

     EVENING:
         16:00 - 00:00

     RULES
     ---------------------------------------------------------
     Only ONE active recording session is displayed.

     MORNING:
         Displays morning records.

     EVENING:
         Displays evening records.

     Previous session remains stored in MongoDB.

     ADMIN:
         • Can create records
         • Can edit existing records
         • Can edit closed-session records

     DAIRY WORKER:
         • Can create a new session record
         • Cannot edit submitted records
         • Can enter missing morning records from 10:00 AM
           until 4:00 PM
         • Cannot edit morning records during evening
========================================================= -->


<!-- =========================================================
     SAFE VIEW VARIABLES
========================================================= -->

<%

    const pageDay =
        typeof day !== "undefined" && day
            ? day
            : new Date().toISOString().slice(0, 10);


    const pageMonth =
        typeof month !== "undefined" && month
            ? month
            : pageDay.slice(0, 7);


    const pageFarms =
        typeof farms !== "undefined" &&
        Array.isArray(farms)
            ? farms
            : [];


    const pageIsAdmin =
        typeof isAdmin !== "undefined"
            ? Boolean(isAdmin)
            : Boolean(
                typeof user !== "undefined" &&
                user &&
                user.role === "admin"
            );


    const pageSuccess =
        typeof success !== "undefined"
            ? success
            : "";


    const pageError =
        typeof error !== "undefined"
            ? error
            : "";



    /* ========================================================
       NAIROBI TIME
    ======================================================== */

    const now =
        new Date();


    const nairobiTime =
        new Intl.DateTimeFormat(
            "en-GB",
            {
                timeZone: "Africa/Nairobi",
                hour: "2-digit",
                minute: "2-digit",
                hour12: false
            }
        ).format(now);


    const timeParts =
        nairobiTime.split(":");


    const currentHour =
        Number(timeParts[0]);


    const currentMinute =
        Number(timeParts[1]);


    const currentMinutes =
        (
            currentHour * 60
        ) +
        currentMinute;



    /* ========================================================
       SESSION WINDOWS
    ======================================================== */

    const morningStart =
        0;


    const morningEnd =
        10 * 60;


    const eveningStart =
        16 * 60;


    let currentSession =
        "morning";


    let sessionLabel =
        "Morning";


    let sessionStatus =
        "open";



    /* ========================================================
       MORNING
       00:00 - 09:59
    ======================================================== */

    if (
        currentMinutes >= morningStart &&
        currentMinutes < morningEnd
    ) {

        currentSession =
            "morning";

        sessionLabel =
            "Morning";

        sessionStatus =
            "open";

    }



    /* ========================================================
       CLOSED MORNING
       10:00 - 15:59
    ======================================================== */

    else if (
        currentMinutes >= morningEnd &&
        currentMinutes < eveningStart
    ) {

        currentSession =
            "morning";

        sessionLabel =
            "Morning";

        sessionStatus =
            "closed";

    }



    /* ========================================================
       EVENING
       16:00 - 23:59
    ======================================================== */

    else {

        currentSession =
            "evening";

        sessionLabel =
            "Evening";

        sessionStatus =
            "open";

    }



    /* ========================================================
       SESSION DESCRIPTION
    ======================================================== */

    let sessionDescription =
        "";


    if (
        currentSession === "morning" &&
        sessionStatus === "open"
    ) {

        sessionDescription =
            "Morning recording is open until 10:00 AM.";

    }

    else if (
        currentSession === "morning" &&
        sessionStatus === "closed"
    ) {

        sessionDescription =
            "Morning session is closed. Missing morning records may still be entered before the evening session begins.";

    }

    else {

        sessionDescription =
            "Evening recording is open from 4:00 PM until midnight.";

    }

%>



<!-- =========================================================
     STYLESHEET
========================================================= -->

<link
    rel="stylesheet"
    href="/css/milk.css"
>



<!-- =========================================================
     PAGE
========================================================= -->

<div
    class="milk-page"
    data-day="<%= pageDay %>"
    data-month="<%= pageMonth %>"
    data-session="<%= currentSession %>"
    data-session-status="<%= sessionStatus %>"
    data-is-admin="<%= pageIsAdmin %>"
>


    <!-- =====================================================
         PAGE HEADER
    ====================================================== -->

    <header class="milk-header">

        <div class="milk-header-content">

            <h1>
                Record Today's Milk
            </h1>

            <p class="milk-date">
                <%= pageDay %>
            </p>

        </div>


        <div class="milk-role-badge">

            <% if (pageIsAdmin) { %>

                Administrator

            <% } else { %>

                Dairy Worker

            <% } %>

        </div>

    </header>



    <!-- =====================================================
         SESSION BAR
    ====================================================== -->

    <section
        class="milk-session-bar"
        aria-label="Milk recording session"
    >

        <div class="milk-session-information">

            <span class="milk-session-label">
                Current Recording
            </span>

            <strong class="milk-session-name">
                <%= sessionLabel %> Session
            </strong>

            <span class="milk-session-time">

                <% if (currentSession === "morning") { %>

                    12:00 AM – 10:00 AM

                <% } else { %>

                    4:00 PM – 12:00 AM

                <% } %>

            </span>

        </div>


        <div
            class="milk-session-status milk-session-status-<%= sessionStatus %>"
        >

            <% if (sessionStatus === "open") { %>

                Session Open

            <% } else { %>

                Morning Session Closed

            <% } %>

        </div>

    </section>



    <!-- =====================================================
         SESSION INFORMATION
    ====================================================== -->

    <div class="milk-session-note">

        <strong>
            <%= sessionLabel %> recording:
        </strong>

        <span>
            <%= sessionDescription %>
        </span>

    </div>



    <!-- =====================================================
         SUCCESS MESSAGE
    ====================================================== -->

    <% if (pageSuccess) { %>

        <div
            class="milk-message milk-success"
            role="alert"
        >

            <%= pageSuccess %>

        </div>

    <% } %>



    <!-- =====================================================
         ERROR MESSAGE
    ====================================================== -->

    <% if (pageError) { %>

        <div
            class="milk-message milk-error"
            role="alert"
        >

            <%= pageError %>

        </div>

    <% } %>



    <!-- =====================================================
         NO FARMS
    ====================================================== -->

    <% if (pageFarms.length === 0) { %>

        <section class="milk-empty">

            <h2>
                No Dairy Farms Available
            </h2>

            <p>
                There are currently no active dairy farms
                available for milk recording.
            </p>

        </section>

    <% } %>



    <!-- =====================================================
         COLLECTION FORM
    ====================================================== -->

    <% if (pageFarms.length > 0) { %>

        <form
            action="/milk"
            method="POST"
            id="milkCollectionForm"
            autocomplete="off"
        >


            <!-- =================================================
                 FARMS
            ================================================== -->

            <% pageFarms.forEach(function(farm) { %>


                <%

                    const farmAnimals =
                        Array.isArray(farm.animals)
                            ? farm.animals
                            : [];


                    const farmTotal =
                        Number(farm.total || 0);

                %>



                <!-- =============================================
                     FARM SECTION
                ============================================== -->

                <section
                    class="milk-farm-section"
                    data-farm-id="<%= farm._id %>"
                    data-farm-code="<%= farm.code %>"
                >


                    <!-- =========================================
                         FARM HEADER
                    ========================================== -->

                    <div class="milk-farm-header">


                        <div class="milk-farm-information">

                            <h2>
                                <%= farm.name || "Unnamed Farm" %>
                            </h2>

                            <span class="milk-farm-code">

                                Farm Code:
                                <%= farm.code || "" %>

                            </span>

                        </div>



                        <!-- =====================================
                             FARM TOTAL
                        ====================================== -->

                        <div class="milk-farm-total">

                            <span>
                                Today's Farm Total
                            </span>

                            <strong>
                                <%= farmTotal.toFixed(2) %> L
                            </strong>

                        </div>

                    </div>



                    <!-- =========================================
                         NO ANIMALS
                    ========================================== -->

                    <% if (farmAnimals.length === 0) { %>

                        <div class="milk-no-animals">

                            No milking animals are currently
                            registered for this farm.

                        </div>


                    <% } else { %>



                        <!-- =====================================
                             TABLE
                        ====================================== -->

                        <div class="milk-table-wrapper">

                            <table
                                class="milk-table"
                                data-farm-code="<%= farm.code %>"
                            >


                                <!-- =================================
                                     TABLE HEADER
                                ================================== -->

                                <thead>

                                    <tr>


                                        <!-- =============================
                                             COLUMN 1 — NAME
                                        ============================== -->

                                        <th
                                            scope="col"
                                            class="milk-animal-heading"
                                        >

                                            Name

                                        </th>



                                        <!-- =============================
                                             COLUMN 2 — INPUT
                                        ============================== -->

                                        <th
                                            scope="col"
                                            class="milk-input-heading"
                                        >

                                            Input

                                            <span>
                                                (Litres)
                                            </span>

                                        </th>



                                        <!-- =============================
                                             COLUMN 3 — REMARKS
                                        ============================== -->

                                        <th
                                            scope="col"
                                            class="milk-remarks-heading"
                                        >

                                            Remarks

                                        </th>



                                        <!-- =============================
                                             COLUMN 4 — CUMULATIVE
                                        ============================== -->

                                        <th
                                            scope="col"
                                            class="milk-cumulative-heading"
                                        >

                                            Cumulative

                                        </th>


                                    </tr>

                                </thead>



                                <!-- =================================
                                     TABLE BODY
                                ================================== -->

                                <tbody>


                                    <% farmAnimals.forEach(function(animal) { %>


                                        <%

                                            /* ==========================================
                                               CURRENT SESSION RECORD
                                            ========================================== */

                                            const activeRecord =
                                                currentSession === "morning"

                                                    ? (
                                                        animal.morning ||
                                                        null
                                                    )

                                                    : (
                                                        animal.evening ||
                                                        null
                                                    );



                                            /* ==========================================
                                               RECORD EXISTS
                                            ========================================== */

                                            const hasRecord =
                                                Boolean(
                                                    activeRecord
                                                );



                                            /* ==========================================
                                               CURRENT LITERS
                                            ========================================== */

                                            const activeLiters =
                                                activeRecord &&
                                                activeRecord.liters !== undefined &&
                                                activeRecord.liters !== null

                                                    ? activeRecord.liters

                                                    : "";



                                            /* ==========================================
                                               CURRENT REMARKS
                                            ========================================== */

                                            const activeRemarks =
                                                activeRecord &&
                                                activeRecord.remarks

                                                    ? activeRecord.remarks

                                                    : "";



                                            /* ==========================================
                                               WORKER LOCK
                                            ========================================== */

                                            const recordLocked =
                                                !pageIsAdmin &&
                                                hasRecord;



                                            /* ==========================================
                                               MORNING RECORD
                                            ========================================== */

                                            const morningRecord =
                                                animal.morning ||
                                                null;



                                            const morningLiters =
                                                morningRecord &&
                                                morningRecord.liters !== undefined &&
                                                morningRecord.liters !== null

                                                    ? Number(
                                                        morningRecord.liters
                                                    )

                                                    : 0;



                                            /* ==========================================
                                               EVENING RECORD
                                            ========================================== */

                                            const eveningRecord =
                                                animal.evening ||
                                                null;



                                            const eveningLiters =
                                                eveningRecord &&
                                                eveningRecord.liters !== undefined &&
                                                eveningRecord.liters !== null

                                                    ? Number(
                                                        eveningRecord.liters
                                                    )

                                                    : 0;



                                            /* ==========================================
                                               SAFE VALUES
                                            ========================================== */

                                            const safeMorning =
                                                Number.isFinite(
                                                    morningLiters
                                                )

                                                    ? morningLiters

                                                    : 0;



                                            const safeEvening =
                                                Number.isFinite(
                                                    eveningLiters
                                                )

                                                    ? eveningLiters

                                                    : 0;



                                            /* ==========================================
                                               DAILY CUMULATIVE
                                            ========================================== */

                                            const cumulative =
                                                safeMorning +
                                                safeEvening;



                                            /* ==========================================
                                               ANIMAL DISPLAY CODE
                                            ========================================== */

                                            const animalCode =
                                                animal.code ||
                                                animal.assetCode ||
                                                "";

                                        %>



                                        <!-- =================================
                                             ANIMAL ROW
                                        ================================== -->

                                        <tr
                                            class="milk-animal-row"
                                            data-animal-id="<%= animal._id %>"
                                            data-farm-id="<%= farm._id %>"
                                        >


                                            <!-- =================================
                                                 COLUMN 1 — NAME
                                            ================================== -->

                                            <td
                                                class="milk-animal-cell"
                                            >

                                                <div
                                                    class="milk-animal-name"
                                                >

                                                    <strong>

                                                        <%= animal.name || "Unnamed Animal" %>

                                                    </strong>

                                                </div>


                                                <% if (animalCode) { %>

                                                    <small
                                                        class="milk-animal-code"
                                                    >

                                                        #<%= animalCode %>

                                                    </small>

                                                <% } %>

                                            </td>



                                            <!-- =================================
                                                 COLUMN 2 — INPUT
                                            ================================== -->

                                            <td
                                                class="milk-input-cell"
                                                data-session="<%= currentSession %>"
                                            >

                                                <input
                                                    type="number"
                                                    id="milk-<%= currentSession %>-<%= animal._id %>"
                                                    name="records[<%= animal._id %>][<%= currentSession %>][liters]"
                                                    class="milk-liters-input"
                                                    min="0"
                                                    step="0.01"
                                                    inputmode="decimal"
                                                    value="<%= activeLiters %>"
                                                    data-session="<%= currentSession %>"
                                                    data-animal-id="<%= animal._id %>"
                                                    placeholder="0.00"
                                                    aria-label="<%= sessionLabel %> milk liters for <%= animal.name || 'animal' %>"

                                                    <% if (recordLocked) { %>

                                                        readonly
                                                        aria-readonly="true"

                                                    <% } %>

                                                >

                                            </td>



                                            <!-- =================================
                                                 COLUMN 3 — REMARKS
                                            ================================== -->

                                            <td
                                                class="milk-remarks-cell"
                                                data-session="<%= currentSession %>"
                                            >


                                                <input
                                                    type="text"
                                                    id="remarks-<%= currentSession %>-<%= animal._id %>"
                                                    name="records[<%= animal._id %>][<%= currentSession %>][remarks]"
                                                    class="milk-remarks-input"
                                                    value="<%= activeRemarks %>"
                                                    maxlength="500"
                                                    data-session="<%= currentSession %>"
                                                    data-animal-id="<%= animal._id %>"
                                                    placeholder="Optional"
                                                    aria-label="<%= sessionLabel %> remarks for <%= animal.name || 'animal' %>"

                                                    <% if (recordLocked) { %>

                                                        readonly
                                                        aria-readonly="true"

                                                    <% } %>

                                                >



                                                <!-- =================================
                                                     STATUS INSIDE REMARKS CELL
                                                ================================== -->

                                                <div
                                                    class="milk-record-status"
                                                >

                                                    <% if (hasRecord) { %>


                                                        <% if (recordLocked) { %>

                                                            <span
                                                                class="milk-status-locked"
                                                            >

                                                                Submitted — Read Only

                                                            </span>


                                                        <% } else { %>

                                                            <span
                                                                class="milk-status-recorded"
                                                            >

                                                                Recorded — Admin Editable

                                                            </span>

                                                        <% } %>


                                                    <% } else { %>

                                                        <span
                                                            class="milk-status-pending"
                                                        >

                                                            Not Recorded

                                                        </span>

                                                    <% } %>

                                                </div>

                                            </td>



                                            <!-- =================================
                                                 COLUMN 4 — CUMULATIVE
                                            ================================== -->

                                            <td
                                                class="milk-cumulative-cell"
                                            >

                                                <strong
                                                    class="milk-cumulative-value"
                                                >

                                                    <%= cumulative.toFixed(2) %> L

                                                </strong>


                                                <small
                                                    class="milk-cumulative-label"
                                                >

                                                    Today

                                                </small>

                                            </td>


                                        </tr>


                                    <% }); %>


                                </tbody>

                            </table>

                        </div>


                    <% } %>


                </section>


            <% }); %>



            <!-- =================================================
                 SUBMIT AREA
            ================================================== -->

            <div class="milk-submit-area">


                <!-- =============================================
                     WORKER NOTE
                ============================================== -->

                <% if (!pageIsAdmin) { %>

                    <p class="milk-worker-note">

                        Once you submit a milk record, it becomes
                        read-only for you. Administrators can still
                        edit submitted records.

                    </p>

                <% } else { %>

                    <p class="milk-admin-note">

                        Administrator mode:
                        existing records can be edited.

                    </p>

                <% } %>



                <!-- =============================================
                     ZERO RECORD NOTE
                ============================================== -->

                <p class="milk-zero-note">

                    If a cow is not milked or no record is entered
                    before the session closes, the session is
                    automatically recorded as:

                    <strong>
                        0 L — Not Milked/recorded
                    </strong>

                </p>



                <!-- =============================================
                     SUBMIT BUTTON
                ============================================== -->

                <button
                    type="submit"
                    class="milk-submit-button"
                    id="milkSubmitButton"
                >

                    <% if (pageIsAdmin) { %>

                        Save <%= sessionLabel %> Records

                    <% } else { %>

                        Submit <%= sessionLabel %> Records

                    <% } %>

                </button>


            </div>


        </form>

    <% } %>


</div>



<!-- =========================================================
     PAGE JAVASCRIPT
========================================================= -->

<script>

document.addEventListener(
    "DOMContentLoaded",
    function () {


        /* =====================================================
           FORM
        ====================================================== */

        const form =
            document.getElementById(
                "milkCollectionForm"
            );


        if (!form) {

            return;

        }



        /* =====================================================
           SUBMIT BUTTON
        ====================================================== */

        const submitButton =
            document.getElementById(
                "milkSubmitButton"
            );



        /* =====================================================
           LITERS INPUTS
        ====================================================== */

        const litersInputs =
            form.querySelectorAll(
                ".milk-liters-input"
            );


        litersInputs.forEach(
            function (input) {


                input.addEventListener(
                    "input",
                    function () {


                        const rawValue =
                            input.value;


                        /*
                         * Empty input is allowed.
                         */

                        if (
                            rawValue === ""
                        ) {

                            return;

                        }


                        const value =
                            Number(
                                rawValue
                            );


                        /*
                         * Prevent invalid or negative values.
                         */

                        if (
                            !Number.isFinite(value) ||
                            value < 0
                        ) {

                            input.value =
                                "";

                        }

                    }
                );

            }
        );



        /* =====================================================
           FORM SUBMISSION
        ====================================================== */

        form.addEventListener(
            "submit",
            function (event) {


                /*
                 * Prevent duplicate submissions.
                 */

                if (
                    form.dataset.submitting === "true"
                ) {

                    event.preventDefault();

                    return;

                }


                form.dataset.submitting =
                    "true";



                /*
                 * Inputs must NOT be disabled.
                 *
                 * Disabled inputs are not included in a normal
                 * browser form submission.
                 */

                if (submitButton) {

                    submitButton.disabled =
                        true;


                    submitButton.setAttribute(
                        "aria-disabled",
                        "true"
                    );


                    submitButton.textContent =
                        "Saving...";

                }

            }
        );

    }
);

</script>