                                    </div>

                                <% } %>

                            <% } %>

                        </div>


                    </div>

                </article>

            <% }) %>


        </section>

    <% } %>


</div>


<!-- ==========================================================
     ADMIN EDIT MODAL
========================================================== -->

<% if (isAdmin) { %>

<div
    id="milkEditModal"
    class="milk-modal"
    aria-hidden="true"
>

    <div
        class="milk-modal-card"
        role="dialog"
        aria-modal="true"
        aria-labelledby="milkEditTitle"
    >

        <div class="milk-modal-header">

            <div>

                <h2
                    id="milkEditTitle"
                    class="milk-modal-title"
                >
                    Edit milk record
                </h2>

                <p
                    id="milkEditSubtitle"
                    class="milk-modal-subtitle"
                >
                    Administrator record adjustment
                </p>

            </div>


            <button
                type="button"
                class="milk-modal-close"
                onclick="closeMilkEditModal()"
                aria-label="Close"
            >

                <svg
                    class="milk-icon"
                    aria-hidden="true"
                >
                    <use href="#milk-x"></use>
                </svg>

            </button>

        </div>


        <form
            id="milkEditForm"
            method="POST"
        >

            <label class="milk-field-label">
                Milk quantity
            </label>

            <div class="milk-input-wrap">

                <input
                    id="milkEditLiters"
                    class="milk-input"
                    type="number"
                    name="liters"
                    min="0"
                    step="0.01"
                    inputmode="decimal"
                    required
                >

                <span class="milk-input-unit">
                    L
                </span>

            </div>


            <div class="milk-remarks-input">

                <label class="milk-field-label">
                    Remarks
                </label>

                <input
                    id="milkEditRemarks"
                    class="milk-input"
                    type="text"
                    name="remarks"
                    maxlength="250"
                    placeholder="Optional remarks"
                >

            </div>


            <div class="milk-modal-actions">

                <button
                    type="button"
                    class="milk-modal-cancel"
                    onclick="closeMilkEditModal()"
                >
                    Cancel
                </button>

                <button
                    type="submit"
                    class="milk-modal-save"
                >
                    Save changes
                </button>

            </div>

        </form>

    </div>

</div>

<% } %>


<script>

/* ==========================================================
   MILK FORM VALIDATION
========================================================== */

function validateMilkForm(form) {

    const input =
        form.querySelector(
            'input[name="liters"]'
        );

    if (!input) {
        return false;
    }

    const value =
        Number(input.value);

    if (
        input.value === "" ||
        !Number.isFinite(value) ||
        value < 0
    ) {

        alert(
            "Please enter a valid milk quantity."
        );

        input.focus();

        return false;
    }

    return true;
}


/* ==========================================================
   ADMIN EDIT MODAL
========================================================== */

function openMilkEditModal(
    recordId,
    liters,
    remarks,
    sessionName
) {

    const modal =
        document.getElementById(
            "milkEditModal"
        );

    const form =
        document.getElementById(
            "milkEditForm"
        );

    const litersInput =
        document.getElementById(
            "milkEditLiters"
        );

    const remarksInput =
        document.getElementById(
            "milkEditRemarks"
        );

    const subtitle =
        document.getElementById(
            "milkEditSubtitle"
        );


    if (
        !modal ||
        !form ||
        !litersInput ||
        !remarksInput
    ) {
        return;
    }


    form.action =
        "/milk/" +
        encodeURIComponent(
            recordId
        );


    litersInput.value =
        liters ?? "";


    remarksInput.value =
        remarks || "";


    if (subtitle) {

        subtitle.textContent =
            "Editing " +
            sessionName +
            " milk record";

    }


    modal.classList.add(
        "active"
    );

    modal.setAttribute(
        "aria-hidden",
        "false"
    );


    setTimeout(
        () => {

            litersInput.focus();

            litersInput.select();

        },
        50
    );

}


/* ==========================================================
   CLOSE MODAL
========================================================== */

function closeMilkEditModal() {

    const modal =
        document.getElementById(
            "milkEditModal"
        );

    if (!modal) {
        return;
    }


    modal.classList.remove(
        "active"
    );

    modal.setAttribute(
        "aria-hidden",
        "true"
    );

}


/* ==========================================================
   CLICK OUTSIDE MODAL
========================================================== */

document.addEventListener(
    "click",
    function(event) {

        const modal =
            document.getElementById(
                "milkEditModal"
            );

        if (
            modal &&
            event.target === modal
        ) {

            closeMilkEditModal();

        }

    }
);


/* ==========================================================
   ESCAPE KEY
========================================================== */

document.addEventListener(
    "keydown",
    function(event) {

        if (
            event.key !== "Escape"
        ) {
            return;
        }

        closeMilkEditModal();

    }
);


/* ==========================================================
   PREVENT DOUBLE SUBMISSION
========================================================== */

document.addEventListener(
    "submit",
    function(event) {

        const form =
            event.target;

        if (
            !form.classList.contains(
                "milk-form"
            )
        ) {
            return;
        }


        const button =
            form.querySelector(
                ".milk-submit"
            );

        if (!button) {
            return;
        }


        if (
            form.dataset.submitted === "true"
        ) {

            event.preventDefault();

            return;

        }


        form.dataset.submitted =
            "true";

        button.disabled =
            true;


        const originalText =
            button.innerHTML;


        button.innerHTML =
            "Saving...";


        setTimeout(
            () => {

                /*
                 * If the request does not navigate away,
                 * restore the button.
                 */

                button.disabled =
                    false;

                button.innerHTML =
                    originalText;

                form.dataset.submitted =
                    "false";

            },
            10000
        );

    }
);

</script>