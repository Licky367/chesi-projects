<!-- =========================================================
     MILK RECORDING PAGE
     FILE: views/milk.ejs
========================================================= -->


<%
    /* ========================================================
       SAFE VIEW VARIABLES
    ======================================================== */

    const pageDay =
        typeof day !== "undefined" && day
            ? day
            : new Date().toISOString().slice(0, 10);


    const pageMonth =
        typeof month !== "undefined" && month
            ? month
            : pageDay.slice(0, 7);


    const pageFarms =
        typeof farms !== "undefined" &&
        Array.isArray(farms)
            ? farms
            : [];


    const pageIsAdmin =
        typeof isAdmin !== "undefined"
            ? Boolean(isAdmin)
            : Boolean(
                typeof user !== "undefined" &&
                user &&
                user.role === "admin"
            );


    const pageSuccess =
        typeof success !== "undefined"
            ? success
            : "";


    const pageError =
        typeof error !== "undefined"
            ? error
            : "";


    /* ========================================================
       NAIROBI TIME
    ======================================================== */

    const now = new Date();

    const nairobiTime =
        new Intl.DateTimeFormat(
            "en-GB",
            {
                timeZone: "Africa/Nairobi",
                hour: "2-digit",
                minute: "2-digit",
                hour12: false
            }
        ).format(now);


    const timeParts =
        nairobiTime.split(":");


    const currentHour =
        Number(timeParts[0]);


    const currentMinute =
        Number(timeParts[1]);


    const currentMinutes =
        (currentHour * 60) +
        currentMinute;


    /* ========================================================
       SESSION
    ======================================================== */

    const morningEnd = 10 * 60;
    const eveningStart = 16 * 60;


    let currentSession = "morning";
    let sessionLabel = "Morning";
    let sessionStatus = "open";


    if (
        currentMinutes >= 0 &&
        currentMinutes < morningEnd
    ) {

        currentSession = "morning";
        sessionLabel = "Morning";
        sessionStatus = "open";

    }

    else if (
        currentMinutes >= morningEnd &&
        currentMinutes < eveningStart
    ) {

        currentSession = "morning";
        sessionLabel = "Closed";
        sessionStatus = "closed";

    }

    else {

        currentSession = "evening";
        sessionLabel = "Evening";
        sessionStatus = "open";

    }
%>


<link
    rel="stylesheet"
    href="/css/milk.css"
>


<style>

/* =========================================================
   MILK PAGE
   SALES PAGE THEME
========================================================= */

.milk-page{

    width:100%;

    max-width:1100px;

    margin:0 auto;

    padding:20px 18px 50px;

    box-sizing:border-box;

}


/* =========================================================
   HEADER
========================================================= */

.milk-header{

    margin:0 0 20px;

}


.milk-header-content{

    display:flex;

    align-items:flex-end;

    justify-content:space-between;

    gap:20px;

}


.milk-header h1{

    margin:0;

    color:#166534;

    font-size:25px;

    line-height:1.2;

    font-weight:700;

}


.milk-date{

    margin:5px 0 0;

    color:#6b7280;

    font-size:13px;

    line-height:1.4;

}


.milk-date .session{

    color:#166534;

    font-weight:700;

}


/* =========================================================
   MESSAGES
========================================================= */

.milk-message{

    margin:0 0 15px;

    padding:11px 14px;

    border-radius:8px;

    font-size:13px;

    line-height:1.4;

}


.milk-success{

    border:1px solid #bbf7d0;

    background:#f0fdf4;

    color:#166534;

}


.milk-error{

    border:1px solid #fecaca;

    background:#fef2f2;

    color:#b91c1c;

}


/* =========================================================
   FARM SECTION
========================================================= */

.milk-farm-section{

    margin:0 0 18px;

    background:#ffffff;

    border:1px solid #e5e7eb;

    border-radius:10px;

    overflow:hidden;

    box-shadow:0 2px 8px rgba(0,0,0,.04);

}


/* =========================================================
   FARM HEADER
========================================================= */

.milk-farm-header{

    display:flex;

    align-items:center;

    justify-content:space-between;

    gap:15px;

    padding:14px 16px;

    background:#f8faf9;

    border-bottom:1px solid #e5e7eb;

}


.milk-farm-information{

    min-width:0;

}


.milk-farm-information h2{

    margin:0;

    color:#374151;

    font-size:16px;

    line-height:1.3;

    font-weight:700;

}


.milk-farm-code{

    display:block;

    margin-top:3px;

    color:#9ca3af;

    font-size:11px;

}


.milk-farm-total{

    flex-shrink:0;

    text-align:right;

}


.milk-farm-total span{

    display:block;

    margin-bottom:2px;

    color:#9ca3af;

    font-size:10px;

}


.milk-farm-total strong{

    display:block;

    color:#166534;

    font-size:15px;

    font-weight:700;

}


/* =========================================================
   TABLE WRAPPER
========================================================= */

.milk-table-wrapper{

    width:100%;

    overflow-x:auto;

    -webkit-overflow-scrolling:touch;

}


/* =========================================================
   TABLE
========================================================= */

.milk-table{

    width:100%;

    min-width:650px;

    border-collapse:collapse;

    table-layout:fixed;

}


/* =========================================================
   TABLE HEAD
========================================================= */

.milk-table th{

    padding:11px 14px;

    background:#f9fafb;

    border-bottom:1px solid #e5e7eb;

    color:#6b7280;

    font-size:10px;

    font-weight:700;

    text-transform:uppercase;

    letter-spacing:.04em;

    text-align:left;

    white-space:nowrap;

}


/* =========================================================
   COLUMN WIDTHS
========================================================= */

.milk-animal-heading{

    width:24%;

}


.milk-input-heading{

    width:17%;

}


.milk-remarks-heading{

    width:41%;

}


.milk-cumulative-heading{

    width:18%;

}


/* =========================================================
   TABLE CELLS
========================================================= */

.milk-table td{

    padding:10px 14px;

    border-bottom:1px solid #f1f5f2;

    vertical-align:middle;

    color:#4b5563;

    font-size:13px;

}


.milk-table tbody tr:last-child td{

    border-bottom:none;

}


.milk-table tbody tr{

    transition:background .15s ease;

}


.milk-table tbody tr:hover{

    background:#fcfffd;

}


/* =========================================================
   ANIMAL
========================================================= */

.milk-animal-name{

    color:#1f2937;

    font-size:13px;

    line-height:1.3;

}


.milk-animal-name strong{

    font-weight:650;

}


.milk-animal-code{

    display:block;

    margin-top:3px;

    color:#9ca3af;

    font-size:10px;

}


/* =========================================================
   LITERS INPUT
========================================================= */

.milk-liters-input{

    width:100%;

    height:34px;

    padding:6px 9px;

    box-sizing:border-box;

    border:1px solid #d1d5db;

    border-radius:7px;

    background:#ffffff;

    color:#111827;

    font-family:inherit;

    font-size:12px;

    outline:none;

    transition:

        border-color .15s ease,

        box-shadow .15s ease,

        background .15s ease;

}


.milk-liters-input:focus{

    border-color:#16a34a;

    box-shadow:0 0 0 3px rgba(22,163,74,.10);

}


.milk-liters-input[readonly]{

    background:#f3f4f6;

    color:#6b7280;

    cursor:not-allowed;

}


/* =========================================================
   REMARKS INPUT
========================================================= */

.milk-remarks-input{

    width:100%;

    height:34px;

    padding:6px 9px;

    box-sizing:border-box;

    border:1px solid #d1d5db;

    border-radius:7px;

    background:#ffffff;

    color:#111827;

    font-family:inherit;

    font-size:12px;

    outline:none;

    transition:

        border-color .15s ease,

        box-shadow .15s ease,

        background .15s ease;

}


.milk-remarks-input:focus{

    border-color:#16a34a;

    box-shadow:0 0 0 3px rgba(22,163,74,.10);

}


.milk-remarks-input[readonly]{

    background:#f3f4f6;

    color:#6b7280;

    cursor:not-allowed;

}


/* =========================================================
   STATUS
========================================================= */

.milk-record-status{

    margin-top:4px;

    min-height:13px;

    line-height:1.2;

}


.milk-status-recorded,
.milk-status-locked,
.milk-status-pending{

    font-size:9px;

    font-weight:600;

}


.milk-status-recorded{

    color:#166534;

}


.milk-status-locked{

    color:#6b7280;

}


.milk-status-pending{

    color:#9ca3af;

}


/* =========================================================
   CUMULATIVE
========================================================= */

.milk-cumulative-cell{

    text-align:right;

}


.milk-cumulative-value{

    display:block;

    color:#166534;

    font-size:14px;

    font-weight:700;

}


.milk-cumulative-label{

    display:block;

    margin-top:2px;

    color:#9ca3af;

    font-size:9px;

}


/* =========================================================
   NO ANIMALS
========================================================= */

.milk-no-animals{

    padding:20px 15px;

    color:#9ca3af;

    font-size:12px;

    text-align:center;

}


/* =========================================================
   NO FARMS
========================================================= */

.milk-empty{

    padding:45px 20px;

    border:1px solid #e5e7eb;

    border-radius:10px;

    background:#ffffff;

    box-shadow:0 2px 8px rgba(0,0,0,.04);

    text-align:center;

}


.milk-empty h2{

    margin:0 0 7px;

    color:#374151;

    font-size:17px;

}


.milk-empty p{

    margin:0;

    color:#9ca3af;

    font-size:13px;

    line-height:1.5;

}


/* =========================================================
   SUBMIT AREA
========================================================= */

.milk-submit-area{

    display:flex;

    justify-content:flex-end;

    margin-top:20px;

    padding-top:15px;

    border-top:1px solid #e5e7eb;

}


.milk-submit-button{

    display:inline-flex;

    align-items:center;

    justify-content:center;

    min-height:38px;

    padding:0 20px;

    border:none;

    border-radius:7px;

    background:#166534;

    color:#ffffff;

    font-family:inherit;

    font-size:13px;

    font-weight:700;

    cursor:pointer;

    transition:

        background .15s ease,

        transform .1s ease,

        opacity .15s ease;

}


.milk-submit-button:hover{

    background:#14532d;

}


.milk-submit-button:active{

    transform:translateY(1px);

}


.milk-submit-button:disabled{

    background:#9ca3af;

    cursor:not-allowed;

    transform:none;

}


/* =========================================================
   RESPONSIVE
========================================================= */

@media(max-width:700px){

    .milk-page{

        padding:15px 10px 35px;

    }


    .milk-header{

        margin-bottom:15px;

    }


    .milk-header-content{

        align-items:flex-start;

        flex-direction:column;

        gap:3px;

    }


    .milk-header h1{

        font-size:22px;

    }


    .milk-date{

        font-size:12px;

    }


    .milk-farm-section{

        margin-bottom:12px;

        border-radius:8px;

    }


    .milk-farm-header{

        padding:11px 12px;

    }


    .milk-farm-information h2{

        font-size:14px;

    }


    .milk-farm-code{

        font-size:10px;

    }


    .milk-farm-total span{

        font-size:9px;

    }


    .milk-farm-total strong{

        font-size:13px;

    }


    .milk-table{

        min-width:600px;

    }


    .milk-table th{

        padding:9px 10px;

        font-size:9px;

    }


    .milk-table td{

        padding:8px 10px;

        font-size:11px;

    }


    .milk-animal-name{

        font-size:11px;

    }


    .milk-animal-code{

        font-size:9px;

    }


    .milk-liters-input,
    .milk-remarks-input{

        height:32px;

        font-size:11px;

    }


    .milk-cumulative-value{

        font-size:12px;

    }


    .milk-submit-area{

        margin-top:14px;

        padding-top:12px;

    }


    .milk-submit-button{

        width:100%;

        min-height:38px;

    }

}


/* =========================================================
   VERY SMALL SCREENS
========================================================= */

@media(max-width:380px){

    .milk-page{

        padding-left:7px;

        padding-right:7px;

    }


    .milk-table{

        min-width:560px;

    }

}

</style>


<div
    class="milk-page"
    data-day="<%= pageDay %>"
    data-month="<%= pageMonth %>"
    data-session="<%= currentSession %>"
    data-session-status="<%= sessionStatus %>"
    data-is-admin="<%= pageIsAdmin %>"
>


    <!-- =====================================================
         PAGE HEADER
    ====================================================== -->

    <header class="milk-header">

        <div class="milk-header-content">

            <div>

                <h1>
                    Record Today's Milk
                </h1>

                <p class="milk-date">

                    <%= pageDay %>

                    <span class="session">
                        (<%= sessionLabel %>)
                    </span>

                </p>

            </div>

        </div>

    </header>



    <!-- =====================================================
         MESSAGES
    ====================================================== -->

    <% if (pageSuccess) { %>

        <div
            class="milk-message milk-success"
            role="alert"
        >

            <%= pageSuccess %>

        </div>

    <% } %>


    <% if (pageError) { %>

        <div
            class="milk-message milk-error"
            role="alert"
        >

            <%= pageError %>

        </div>

    <% } %>



    <!-- =====================================================
         NO FARMS
    ====================================================== -->

    <% if (pageFarms.length === 0) { %>

        <section class="milk-empty">

            <h2>
                No Dairy Farms Available
            </h2>

            <p>
                There are currently no active dairy farms
                available for milk recording.
            </p>

        </section>

    <% } %>



    <!-- =====================================================
         COLLECTION FORM
    ====================================================== -->

    <% if (pageFarms.length > 0) { %>

        <form
            action="/milk"
            method="POST"
            id="milkCollectionForm"
            autocomplete="off"
        >


            <!-- =================================================
                 FARMS
            ================================================== -->

            <% pageFarms.forEach(function(farm) { %>

                <%

                    const farmAnimals =
                        Array.isArray(farm.animals)
                            ? farm.animals
                            : [];


                    const farmTotal =
                        Number(farm.total || 0);

                %>


                <!-- =============================================
                     FARM
                ============================================== -->

                <section
                    class="milk-farm-section"
                    data-farm-id="<%= farm._id %>"
                    data-farm-code="<%= farm.code %>"
                >


                    <!-- =========================================
                         FARM HEADER
                    ========================================== -->

                    <div class="milk-farm-header">

                        <div class="milk-farm-information">

                            <h2>
                                <%= farm.name || "Unnamed Farm" %>
                            </h2>

                            <span class="milk-farm-code">

                                Farm Code:
                                <%= farm.code || "" %>

                            </span>

                        </div>


                        <div class="milk-farm-total">

                            <span>
                                Farm Total
                            </span>

                            <strong>
                                <%= farmTotal.toFixed(2) %> L
                            </strong>

                        </div>

                    </div>



                    <!-- =========================================
                         NO ANIMALS
                    ========================================== -->

                    <% if (farmAnimals.length === 0) { %>

                        <div class="milk-no-animals">

                            No milking animals are currently
                            registered for this farm.

                        </div>


                    <% } else { %>


                        <!-- =====================================
                             TABLE
                        ====================================== -->

                        <div class="milk-table-wrapper">

                            <table
                                class="milk-table"
                                data-farm-code="<%= farm.code %>"
                            >

                                <thead>

                                    <tr>

                                        <th
                                            scope="col"
                                            class="milk-animal-heading"
                                        >
                                            Name
                                        </th>

                                        <th
                                            scope="col"
                                            class="milk-input-heading"
                                        >
                                            Input
                                            <span>(L)</span>
                                        </th>

                                        <th
                                            scope="col"
                                            class="milk-remarks-heading"
                                        >
                                            Remarks
                                        </th>

                                        <th
                                            scope="col"
                                            class="milk-cumulative-heading"
                                        >
                                            Cumulative
                                        </th>

                                    </tr>

                                </thead>


                                <tbody>


                                    <% farmAnimals.forEach(function(animal) { %>

                                        <%

                                            const activeRecord =
                                                currentSession === "morning"

                                                    ? (
                                                        animal.morning ||
                                                        null
                                                    )

                                                    : (
                                                        animal.evening ||
                                                        null
                                                    );


                                            const hasRecord =
                                                Boolean(activeRecord);


                                            const activeLiters =
                                                activeRecord &&
                                                activeRecord.liters !== undefined &&
                                                activeRecord.liters !== null

                                                    ? activeRecord.liters

                                                    : "";


                                            const activeRemarks =
                                                activeRecord &&
                                                activeRecord.remarks

                                                    ? activeRecord.remarks

                                                    : "";


                                            const recordLocked =
                                                !pageIsAdmin &&
                                                hasRecord;


                                            const morningRecord =
                                                animal.morning ||
                                                null;


                                            const morningLiters =
                                                morningRecord &&
                                                morningRecord.liters !== undefined &&
                                                morningRecord.liters !== null

                                                    ? Number(
                                                        morningRecord.liters
                                                    )

                                                    : 0;


                                            const eveningRecord =
                                                animal.evening ||
                                                null;


                                            const eveningLiters =
                                                eveningRecord &&
                                                eveningRecord.liters !== undefined &&
                                                eveningRecord.liters !== null

                                                    ? Number(
                                                        eveningRecord.liters
                                                    )

                                                    : 0;


                                            const safeMorning =
                                                Number.isFinite(morningLiters)
                                                    ? morningLiters
                                                    : 0;


                                            const safeEvening =
                                                Number.isFinite(eveningLiters)
                                                    ? eveningLiters
                                                    : 0;


                                            const cumulative =
                                                safeMorning +
                                                safeEvening;


                                            const animalCode =
                                                animal.code ||
                                                animal.assetCode ||
                                                "";

                                        %>


                                        <tr
                                            class="milk-animal-row"
                                            data-animal-id="<%= animal._id %>"
                                            data-farm-id="<%= farm._id %>"
                                        >


                                            <!-- =========================
                                                 NAME
                                            ========================== -->

                                            <td class="milk-animal-cell">

                                                <div class="milk-animal-name">

                                                    <strong>
                                                        <%= animal.name || "Unnamed Animal" %>
                                                    </strong>

                                                </div>


                                                <% if (animalCode) { %>

                                                    <small class="milk-animal-code">

                                                        #<%= animalCode %>

                                                    </small>

                                                <% } %>

                                            </td>



                                            <!-- =========================
                                                 INPUT
                                            ========================== -->

                                            <td
                                                class="milk-input-cell"
                                                data-session="<%= currentSession %>"
                                            >

                                                <input
                                                    type="number"
                                                    id="milk-<%= currentSession %>-<%= animal._id %>"
                                                    name="records[<%= animal._id %>][<%= currentSession %>][liters]"
                                                    class="milk-liters-input"
                                                    min="0"
                                                    step="0.01"
                                                    inputmode="decimal"
                                                    value="<%= activeLiters %>"
                                                    data-session="<%= currentSession %>"
                                                    data-animal-id="<%= animal._id %>"
                                                    placeholder="0.00"
                                                    aria-label="<%= sessionLabel %> milk liters for <%= animal.name || 'animal' %>"

                                                    <% if (recordLocked) { %>
                                                        readonly
                                                        aria-readonly="true"
                                                    <% } %>
                                                >

                                            </td>



                                            <!-- =========================
                                                 REMARKS
                                            ========================== -->

                                            <td
                                                class="milk-remarks-cell"
                                                data-session="<%= currentSession %>"
                                            >

                                                <input
                                                    type="text"
                                                    id="remarks-<%= currentSession %>-<%= animal._id %>"
                                                    name="records[<%= animal._id %>][<%= currentSession %>][remarks]"
                                                    class="milk-remarks-input"
                                                    value="<%= activeRemarks %>"
                                                    maxlength="500"
                                                    data-session="<%= currentSession %>"
                                                    data-animal-id="<%= animal._id %>"
                                                    placeholder="Optional"
                                                    aria-label="<%= sessionLabel %> remarks for <%= animal.name || 'animal' %>"

                                                    <% if (recordLocked) { %>
                                                        readonly
                                                        aria-readonly="true"
                                                    <% } %>
                                                >


                                                <div class="milk-record-status">

                                                    <% if (hasRecord) { %>

                                                        <% if (recordLocked) { %>

                                                            <span class="milk-status-locked">
                                                                Submitted — Read Only
                                                            </span>

                                                        <% } else { %>

                                                            <span class="milk-status-recorded">
                                                                Recorded — Admin Editable
                                                            </span>

                                                        <% } %>

                                                    <% } else { %>

                                                        <span class="milk-status-pending">
                                                            Not Recorded
                                                        </span>

                                                    <% } %>

                                                </div>

                                            </td>



                                            <!-- =========================
                                                 CUMULATIVE
                                            ========================== -->

                                            <td class="milk-cumulative-cell">

                                                <strong class="milk-cumulative-value">

                                                    <%= cumulative.toFixed(2) %> L

                                                </strong>

                                                <small class="milk-cumulative-label">
                                                    Today
                                                </small>

                                            </td>


                                        </tr>


                                    <% }); %>


                                </tbody>

                            </table>

                        </div>


                    <% } %>

                </section>


            <% }); %>



            <!-- =================================================
                 BOTTOM SAVE BUTTON
            ================================================== -->

            <div class="milk-submit-area">

                <button
                    type="submit"
                    class="milk-submit-button"
                    id="milkSubmitButton"
                >

                    <% if (pageIsAdmin) { %>

                        Save <%= sessionLabel %> Records

                    <% } else { %>

                        Submit <%= sessionLabel %> Records

                    <% } %>

                </button>

            </div>


        </form>

    <% } %>


</div>



<!-- =========================================================
     JAVASCRIPT
========================================================= -->

<script>

document.addEventListener(
    "DOMContentLoaded",
    function () {


        const form =
            document.getElementById(
                "milkCollectionForm"
            );


        if (!form) {
            return;
        }


        const submitButton =
            document.getElementById(
                "milkSubmitButton"
            );


        const litersInputs =
            form.querySelectorAll(
                ".milk-liters-input"
            );


        litersInputs.forEach(
            function (input) {

                input.addEventListener(
                    "input",
                    function () {

                        const rawValue =
                            input.value;


                        if (
                            rawValue === ""
                        ) {
                            return;
                        }


                        const value =
                            Number(rawValue);


                        if (
                            !Number.isFinite(value) ||
                            value < 0
                        ) {

                            input.value = "";

                        }

                    }
                );

            }
        );


        form.addEventListener(
            "submit",
            function (event) {


                if (
                    form.dataset.submitting === "true"
                ) {

                    event.preventDefault();

                    return;

                }


                form.dataset.submitting =
                    "true";


                /*
                 * Do NOT disable the input fields here.
                 * Disabled form controls are excluded from
                 * normal form submission.
                 */

                if (submitButton) {

                    submitButton.disabled =
                        true;

                    submitButton.setAttribute(
                        "aria-disabled",
                        "true"
                    );

                    submitButton.textContent =
                        "Saving...";

                }

            }
        );

    }
);

</script>