<% /* =========================================================
     ASSET BAR

     FILE:
     views/dairy/assetBar.ejs

     PURPOSE:
     ----------------------------------------------------------
     Displays properties belonging ONLY to the currently
     viewed Dairy Farm.

     IMPORTANT:
     ----------------------------------------------------------
     The "View Assets" button belongs to the parent page.

     Parent button:
         #viewPropertyButton

     This partial contains ONLY:

         • Overlay
         • Right-side asset sidebar
         • Farm information
         • Category switcher
         • Animals
         • Structures / Machines / Tools
         • Sidebar JavaScript

     LAYOUT:
     ----------------------------------------------------------
     Main layout has:

         Header      = 70px
         Top menu    = 50px
         Footer      = 50px

     Therefore the asset sidebar is constrained between:

         top: 120px
         bottom: 50px

     It will NOT overlap:

         • Main header
         • Top menu
         • Main footer

     CLASSIFICATION:
     ----------------------------------------------------------
     code > 0
         = Animal

     code === null / undefined
         = Structure / Machine / Tool

     NAVIGATION:
     ----------------------------------------------------------
     Every displayed Dairy record links directly to:

         /dairy/<%= dairy._id %>

     IMPORTANT:
     ----------------------------------------------------------
     There is NO asset._id reference in this file.

     Each sidebar record is a Dairy record.
========================================================= */ %>


<% /* =========================================================
   PREPARE ASSET DATA
========================================================= */

const availableAssets =
    Array.isArray(assetDairies)
        ? assetDairies.filter(dairy => !!dairy)
        : [];


/* =========================================================
   ANIMALS

   code > 0
========================================================= */

const animalDairies =
    availableAssets.filter(dairy => {

        return (

            dairy.code !== null &&

            dairy.code !== undefined &&

            Number(dairy.code) > 0

        );

    });


/* =========================================================
   STRUCTURES / MACHINES / TOOLS

   code === null / undefined
========================================================= */

const structureDairies =
    availableAssets.filter(dairy => {

        return (

            dairy.code === null ||

            dairy.code === undefined

        );

    });

%>


<!-- =========================================================
     SIDEBAR OVERLAY

     Hidden until the View Assets button is clicked.
========================================================= -->

<div
    id="assetBarOverlay"
    class="asset-bar-overlay"
    aria-hidden="true"
></div>


<!-- =========================================================
     ASSET SIDEBAR

     Positioned below:

         Header + Top Menu = 120px

     and above:

         Footer = 50px

     CSS should therefore use:

         top: 120px;
         bottom: 50px;
========================================================= -->

<aside
    id="assetBar"
    class="asset-bar"
    aria-label="Assets"
    aria-hidden="true"
>


    <!-- =====================================================
         CATEGORY SWITCHER

         Deliberately placed at the very top.

         No sidebar title.
         No sidebar header.
         No close button.
    ====================================================== -->

    <div
        class="asset-bar-tabs"
        role="tablist"
        aria-label="Asset categories"
    >


        <!-- =================================================
             ANIMALS
        ================================================== -->

        <button
            type="button"
            id="assetAnimalsTab"
            class="asset-bar-tab active"
            data-asset-category="animals"
            role="tab"
            aria-selected="true"
            aria-controls="assetAnimals"
        >

            <span class="asset-bar-tab-title">
                Animals
            </span>

            <span class="asset-bar-tab-count">
                <%= animalDairies.length %>
            </span>

        </button>


        <!-- =================================================
             STRUCTURES
        ================================================== -->

        <button
            type="button"
            id="assetStructuresTab"
            class="asset-bar-tab"
            data-asset-category="structures"
            role="tab"
            aria-selected="false"
            aria-controls="assetStructures"
        >

            <span class="asset-bar-tab-title">
                Structures
            </span>

            <span class="asset-bar-tab-subtitle">
                Machines &amp; Tools
            </span>

            <span class="asset-bar-tab-count">
                <%= structureDairies.length %>
            </span>

        </button>


    </div>


    <!-- =====================================================
         CURRENT FARM INFORMATION
    ====================================================== -->

    <% if (
        dairy &&
        dairy.code !== null &&
        dairy.code !== undefined &&
        Number(dairy.code) < 0
    ) { %>

        <div class="asset-bar-farm">

            <span class="asset-bar-farm-label">
                FARM
            </span>

            <span class="asset-bar-farm-name">
                <%= dairy.name %>
            </span>

            <span class="asset-bar-farm-code">
                Farm #<%= dairy.code %>
            </span>

        </div>

    <% } %>


    <!-- =====================================================
         ASSET CONTENT

         This area scrolls independently.
    ====================================================== -->

    <div class="asset-bar-content">


        <!-- =================================================
             ANIMALS
        ================================================== -->

        <section
            id="assetAnimals"
            class="asset-bar-section active"
            data-asset-section="animals"
            role="tabpanel"
            aria-labelledby="assetAnimalsTab"
        >


            <!-- =============================================
                 SECTION HEADER
            ============================================== -->

            <div class="asset-bar-section-header">

                <div>

                    <span class="asset-bar-section-label">
                        LIVESTOCK
                    </span>

                    <h3>
                        Animals
                    </h3>

                </div>


                <span class="asset-bar-count">
                    <%= animalDairies.length %>
                </span>

            </div>


            <!-- =============================================
                 ANIMAL LIST
            ============================================== -->

            <div class="asset-bar-list">


                <% if (animalDairies.length) { %>


                    <% animalDairies.forEach(dairy => { %>


                        <!-- =================================
                             ANIMAL

                             THIS IS A DAIRY RECORD.

                             EXACT ROUTE:
                             /dairy/<%= dairy._id %>
                        ================================== -->

                        <a
                            href="/dairy/<%= dairy._id %>"
                            class="asset-bar-item asset-bar-animal"
                            data-asset-code="<%= dairy.code %>"
                            data-asset-parent-code="<%= dairy.assetCode || '' %>"
                            data-asset-type="animal"
                        >


                            <!-- =============================
                                 IMAGE
                            ============================== -->

                            <span
                                class="asset-bar-item-image"
                            >

                                <img
                                    src="<%= dairy.displayImage %>"
                                    alt="<%= dairy.name %>"
                                    loading="lazy"
                                >

                            </span>


                            <!-- =============================
                                 DETAILS
                            ============================== -->

                            <span
                                class="asset-bar-item-details"
                            >


                                <span
                                    class="asset-bar-item-name"
                                >
                                    <%= dairy.name %>
                                </span>


                                <span
                                    class="asset-bar-item-code"
                                >
                                    Animal #<%= dairy.code %>
                                </span>


                                <% if (dairy.type) { %>

                                    <span
                                        class="asset-bar-item-meta"
                                    >
                                        <%= dairy.type %>
                                    </span>

                                <% } %>


                                <% if (dairy.gender) { %>

                                    <span
                                        class="asset-bar-item-meta"
                                    >
                                        <%= dairy.gender %>
                                    </span>

                                <% } %>


                            </span>


                            <!-- =============================
                                 ARROW
                            ============================== -->

                            <span
                                class="asset-bar-item-arrow"
                                aria-hidden="true"
                            >
                                ›
                            </span>


                        </a>


                    <% }); %>


                <% } else { %>


                    <div class="asset-bar-empty">

                        <span
                            class="asset-bar-empty-icon"
                            aria-hidden="true"
                        >
                            —
                        </span>

                        <span>
                            No animals found for this dairy farm.
                        </span>

                    </div>


                <% } %>


            </div>


        </section>


        <!-- =================================================
             STRUCTURES / MACHINES / TOOLS
        ================================================== -->

        <section
            id="assetStructures"
            class="asset-bar-section"
            data-asset-section="structures"
            role="tabpanel"
            aria-labelledby="assetStructuresTab"
            hidden
        >


            <!-- =============================================
                 SECTION HEADER
            ============================================== -->

            <div class="asset-bar-section-header">

                <div>

                    <span class="asset-bar-section-label">
                        FARM PROPERTY
                    </span>

                    <h3>
                        Structures &amp; Equipment
                    </h3>

                </div>


                <span class="asset-bar-count">
                    <%= structureDairies.length %>
                </span>

            </div>


            <!-- =============================================
                 STRUCTURE LIST
            ============================================== -->

            <div class="asset-bar-list">


                <% if (structureDairies.length) { %>


                    <% structureDairies.forEach(dairy => { %>


                        <!-- =================================
                             STRUCTURE

                             THIS IS ALSO A DAIRY RECORD.

                             EXACT ROUTE:
                             /dairy/<%= dairy._id %>
                        ================================== -->

                        <a
                            href="/dairy/<%= dairy._id %>"
                            class="asset-bar-item asset-bar-structure"
                            data-asset-parent-code="<%= dairy.assetCode || '' %>"
                            data-asset-type="structure"
                        >


                            <!-- =============================
                                 IMAGE
                            ============================== -->

                            <span
                                class="asset-bar-item-image"
                            >

                                <img
                                    src="<%= dairy.displayImage %>"
                                    alt="<%= dairy.name %>"
                                    loading="lazy"
                                >

                            </span>


                            <!-- =============================
                                 DETAILS
                            ============================== -->

                            <span
                                class="asset-bar-item-details"
                            >


                                <span
                                    class="asset-bar-item-name"
                                >
                                    <%= dairy.name %>
                                </span>


                                <% if (dairy.type) { %>

                                    <span
                                        class="asset-bar-item-meta"
                                    >
                                        <%= dairy.type %>
                                    </span>

                                <% } %>


                                <% if (dairy.location) { %>

                                    <span
                                        class="asset-bar-item-meta"
                                    >
                                        <%= dairy.location %>
                                    </span>

                                <% } %>


                            </span>


                            <!-- =============================
                                 ARROW
                            ============================== -->

                            <span
                                class="asset-bar-item-arrow"
                                aria-hidden="true"
                            >
                                ›
                            </span>


                        </a>


                    <% }); %>


                <% } else { %>


                    <div class="asset-bar-empty">

                        <span
                            class="asset-bar-empty-icon"
                            aria-hidden="true"
                        >
                            —
                        </span>

                        <span>
                            No structures, machines or tools
                            found for this dairy farm.
                        </span>

                    </div>


                <% } %>


            </div>


        </section>


    </div>


</aside>


<!-- =========================================================
     ASSET BAR JAVASCRIPT

     Parent page provides:

         #viewPropertyButton

     This script controls:

         • Opening
         • Closing through overlay
         • Escape key
         • Animals / Structures switching
         • Background scrolling

     NOTE:
     There is intentionally NO close button.

     The sidebar can be closed by:

         1. Tapping the View Assets button again
         2. Tapping the overlay
         3. Pressing Escape
========================================================= -->

<script>

document.addEventListener(
    "DOMContentLoaded",
    function() {


        /* =================================================
           ELEMENTS
        ================================================= */

        const assetBar =
            document.getElementById(
                "assetBar"
            );


        const overlay =
            document.getElementById(
                "assetBarOverlay"
            );


        const openButton =
            document.getElementById(
                "viewPropertyButton"
            );


        const tabs =
            document.querySelectorAll(
                ".asset-bar-tab"
            );


        const sections =
            document.querySelectorAll(
                ".asset-bar-section"
            );


        /* =================================================
           SAFETY CHECK
        ================================================= */

        if (!assetBar) {

            console.warn(
                "Asset Bar: #assetBar was not found."
            );

            return;

        }


        if (!openButton) {

            console.warn(
                "Asset Bar: #viewPropertyButton was not found."
            );

            return;

        }


        /* =================================================
           CATEGORY SWITCHING
        ================================================= */

        function setCategory(category) {


            if (!category) {

                return;

            }


            /* =============================================
               UPDATE TABS
            ============================================== */

            tabs.forEach(
                function(tab) {


                    const isActive =
                        tab.dataset.assetCategory ===
                        category;


                    tab.classList.toggle(
                        "active",
                        isActive
                    );


                    tab.setAttribute(
                        "aria-selected",
                        String(isActive)
                    );


                }
            );


            /* =============================================
               UPDATE SECTIONS
            ============================================== */

            sections.forEach(
                function(section) {


                    const isActive =
                        section.dataset.assetSection ===
                        category;


                    section.classList.toggle(
                        "active",
                        isActive
                    );


                    section.hidden =
                        !isActive;


                }
            );


        }


        /* =================================================
           OPEN SIDEBAR
        ================================================= */

        function openAssetBar() {


            /*
             * Animals are always the first category
             * displayed when the sidebar opens.
             */

            setCategory(
                "animals"
            );


            /*
             * Show sidebar.
             */

            assetBar.classList.add(
                "active"
            );


            /*
             * Show overlay.
             */

            if (overlay) {

                overlay.classList.add(
                    "active"
                );

            }


            /*
             * Accessibility state.
             */

            assetBar.setAttribute(
                "aria-hidden",
                "false"
            );


            openButton.setAttribute(
                "aria-expanded",
                "true"
            );


            if (overlay) {

                overlay.setAttribute(
                    "aria-hidden",
                    "false"
                );

            }


            /*
             * Prevent the page behind the sidebar
             * from scrolling.
             */

            document.body.classList.add(
                "asset-bar-open"
            );


        }


        /* =================================================
           CLOSE SIDEBAR
        ================================================= */

        function closeAssetBar() {


            /*
             * Hide sidebar.
             */

            assetBar.classList.remove(
                "active"
            );


            /*
             * Hide overlay.
             */

            if (overlay) {

                overlay.classList.remove(
                    "active"
                );

            }


            /*
             * Accessibility state.
             */

            assetBar.setAttribute(
                "aria-hidden",
                "true"
            );


            openButton.setAttribute(
                "aria-expanded",
                "false"
            );


            if (overlay) {

                overlay.setAttribute(
                    "aria-hidden",
                    "true"
                );

            }


            /*
             * Restore page scrolling.
             */

            document.body.classList.remove(
                "asset-bar-open"
            );


        }


        /* =================================================
           VIEW ASSETS BUTTON

           Tapping it opens the sidebar.

           Tapping it again closes the sidebar.
        ================================================= */

        openButton.addEventListener(
            "click",
            function(event) {


                event.preventDefault();


                if (
                    assetBar.classList.contains(
                        "active"
                    )
                ) {

                    closeAssetBar();

                } else {

                    openAssetBar();

                }


            }
        );


        /* =================================================
           OVERLAY CLICK

           Clicking outside the sidebar closes it.
        ================================================= */

        if (overlay) {


            overlay.addEventListener(
                "click",
                function() {


                    closeAssetBar();


                }
            );


        }


        /* =================================================
           ESCAPE KEY
        ================================================= */

        document.addEventListener(
            "keydown",
            function(event) {


                if (
                    event.key === "Escape" &&
                    assetBar.classList.contains(
                        "active"
                    )
                ) {


                    closeAssetBar();


                }


            }
        );


        /* =================================================
           CATEGORY TAB CLICK
        ================================================= */

        tabs.forEach(
            function(tab) {


                tab.addEventListener(
                    "click",
                    function(event) {


                        event.preventDefault();


                        const category =
                            tab.dataset.assetCategory;


                        if (!category) {

                            return;

                        }


                        setCategory(
                            category
                        );


                    }
                );


            }
        );


    }

);

</script>