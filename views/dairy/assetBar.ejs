<% /* =========================================================
ASSET BAR

FILE:
views/dairy/assetBar.ejs

PURPOSE:

Displays properties belonging ONLY to the currently
viewed Dairy Farm.

IMPORTANT:

The "View Assets" button belongs to the parent page.

Parent button:

 #viewPropertyButton

This partial contains ONLY:

 • Overlay
 • Right-side asset sidebar
 • Farm information
 • Category switcher
 • Animals
 • Structures / Machines / Tools
 • Sidebar JavaScript
 • Sidebar styles

NAVIGATION:

Every animal, structure, machine or tool displayed here
is a Dairy record.

Clicking an asset navigates to:

 /dairy/<asset._id>

The /dairy/:id route determines which page to render:

 code < 0
     = update.ejs

 code > 0
     = dairySet.ejs

 code === null / undefined
     = dairySet.ejs

CLASSIFICATION:

 code > 0
     = Animal

 code === null / undefined
     = Structure / Machine / Tool

========================================================= */ %>

<%
/* =========================================================
PREPARE ASSET DATA
========================================================= */

const availableAssets =
Array.isArray(assetDairies)
? assetDairies.filter(asset => !!asset)
: [];

/* =========================================================
ANIMALS

code > 0
========================================================= */

const animalDairies =
availableAssets.filter(asset => {

return (
    asset.code !== null &&
    asset.code !== undefined &&
    Number(asset.code) > 0
);

});

/* =========================================================
STRUCTURES / MACHINES / TOOLS

code === null / undefined
========================================================= */

const structureDairies =
availableAssets.filter(asset => {

return (
    asset.code === null ||
    asset.code === undefined
);

});

%>

<!-- =========================================================
     ASSET BAR OVERLAY

     Hidden until the sidebar is opened.
========================================================= --><div
    id="assetBarOverlay"
    class="asset-bar-overlay"
    aria-hidden="true"
></div><!-- =========================================================
     ASSET SIDEBAR

     Positioned between:

         top: 120px
         bottom: 50px
========================================================= --><aside
    id="assetBar"
    class="asset-bar"
    aria-label="Farm Assets"
    aria-hidden="true"
><!-- =====================================================
     SIDEBAR TOP AREA
====================================================== --><div class="asset-bar-top"><!-- =================================================
     TITLE
================================================== -->

<div class="asset-bar-heading">

    <span class="asset-bar-heading-label">
        FARM ASSETS
    </span>

    <h2>
        Your Assets
    </h2>

</div>


<!-- =================================================
     CLOSE BUTTON
================================================== -->

<button
    type="button"
    id="closeAssetBar"
    class="asset-bar-close"
    aria-label="Close Assets"
    title="Close Assets"
>

    <span aria-hidden="true">
        ×
    </span>

</button>

</div><!-- =====================================================
     CURRENT FARM
====================================================== --><% if (
dairy &&
dairy.code !== null &&
dairy.code !== undefined &&
Number(dairy.code) < 0
) { %>

<div class="asset-bar-farm">


    <span class="asset-bar-farm-label">
        FARM
    </span>


    <span class="asset-bar-farm-name">
        <%= dairy.name %>
    </span>


    <span class="asset-bar-farm-code">
        Farm #<%= dairy.code %>
    </span>


</div>

<% } %>

<!-- =====================================================
     CATEGORY SWITCHER
====================================================== --><div
    class="asset-bar-tabs"
    role="tablist"
    aria-label="Asset categories"
><!-- =================================================
     ANIMALS
================================================== -->

<button
    type="button"
    id="assetAnimalsTab"
    class="asset-bar-tab active"
    data-asset-category="animals"
    role="tab"
    aria-selected="true"
    aria-controls="assetAnimals"
>

    <span class="asset-bar-tab-title">
        Animals
    </span>

    <span class="asset-bar-tab-count">
        <%= animalDairies.length %>
    </span>

</button>


<!-- =================================================
     STRUCTURES
================================================== -->

<button
    type="button"
    id="assetStructuresTab"
    class="asset-bar-tab"
    data-asset-category="structures"
    role="tab"
    aria-selected="false"
    aria-controls="assetStructures"
>

    <span class="asset-bar-tab-title">
        Structures
    </span>

    <span class="asset-bar-tab-subtitle">
        Machines &amp; Tools
    </span>

    <span class="asset-bar-tab-count">
        <%= structureDairies.length %>
    </span>

</button>

</div><!-- =====================================================
     ASSET CONTENT
====================================================== --><div class="asset-bar-content"><!-- =================================================
     ANIMALS
================================================== -->

<section
    id="assetAnimals"
    class="asset-bar-section active"
    data-asset-section="animals"
    role="tabpanel"
    aria-labelledby="assetAnimalsTab"
>


    <!-- =============================================
         SECTION HEADER
    ============================================== -->

    <div class="asset-bar-section-header">


        <div>

            <span class="asset-bar-section-label">
                LIVESTOCK
            </span>

            <h3>
                Animals
            </h3>

        </div>


        <span class="asset-bar-count">
            <%= animalDairies.length %>
        </span>


    </div>


    <!-- =============================================
         ANIMAL LIST
    ============================================== -->

    <div class="asset-bar-list">


        <% if (animalDairies.length) { %>


            <% animalDairies.forEach(animal => { %>


                <!-- =================================
                     ANIMAL LINK

                     Every animal is a Dairy record.

                     Route:

                         /dairy/<animal._id>

                     The controller decides whether
                     dairySet.ejs or another page
                     should be rendered.
                ================================== -->

                <a
                    href="/dairy/<%= animal._id %>"
                    class="asset-bar-item asset-bar-animal"
                    data-asset-id="<%= animal._id %>"
                    data-asset-code="<%= animal.code %>"
                    data-asset-parent-code="<%= animal.assetCode || '' %>"
                    data-asset-type="animal"
                >


                    <!-- =================================
                         IMAGE
                    ================================== -->

                    <span
                        class="asset-bar-item-image"
                    >

                        <img
                            src="<%= animal.displayImage %>"
                            alt="<%= animal.name %>"
                            loading="lazy"
                        >

                    </span>


                    <!-- =================================
                         DETAILS
                    ================================== -->

                    <span
                        class="asset-bar-item-details"
                    >


                        <span
                            class="asset-bar-item-name"
                        >
                            <%= animal.name %>
                        </span>


                        <span
                            class="asset-bar-item-code"
                        >
                            Animal #<%= animal.code %>
                        </span>


                        <% if (animal.type) { %>

                            <span
                                class="asset-bar-item-meta"
                            >
                                <%= animal.type %>
                            </span>

                        <% } %>


                        <% if (animal.gender) { %>

                            <span
                                class="asset-bar-item-meta"
                            >
                                <%= animal.gender %>
                            </span>

                        <% } %>


                    </span>


                    <!-- =================================
                         ARROW
                    ================================== -->

                    <span
                        class="asset-bar-item-arrow"
                        aria-hidden="true"
                    >
                        ›
                    </span>


                </a>


            <% }); %>


        <% } else { %>


            <div class="asset-bar-empty">


                <span
                    class="asset-bar-empty-icon"
                    aria-hidden="true"
                >
                    —
                </span>


                <span>
                    No animals found for this dairy farm.
                </span>


            </div>


        <% } %>


    </div>


</section>


<!-- =================================================
     STRUCTURES / MACHINES / TOOLS
================================================== -->

<section
    id="assetStructures"
    class="asset-bar-section"
    data-asset-section="structures"
    role="tabpanel"
    aria-labelledby="assetStructuresTab"
    hidden
>


    <!-- =============================================
         SECTION HEADER
    ============================================== -->

    <div class="asset-bar-section-header">


        <div>

            <span class="asset-bar-section-label">
                FARM PROPERTY
            </span>

            <h3>
                Structures &amp; Equipment
            </h3>

        </div>


        <span class="asset-bar-count">
            <%= structureDairies.length %>
        </span>


    </div>


    <!-- =============================================
         STRUCTURE LIST
    ============================================== -->

    <div class="asset-bar-list">


        <% if (structureDairies.length) { %>


            <% structureDairies.forEach(asset => { %>


                <!-- =================================
                     STRUCTURE / EQUIPMENT LINK

                     Every item is a Dairy record.

                     Route:

                         /dairy/<asset._id>

                     code === null is handled by
                     the /dairy/:id controller and
                     rendered with dairySet.ejs.
                ================================== -->

                <a
                    href="/dairy/<%= asset._id %>"
                    class="asset-bar-item asset-bar-structure"
                    data-asset-id="<%= asset._id %>"
                    data-asset-parent-code="<%= asset.assetCode || '' %>"
                    data-asset-type="structure"
                >


                    <!-- =================================
                         IMAGE
                    ================================== -->

                    <span
                        class="asset-bar-item-image"
                    >

                        <img
                            src="<%= asset.displayImage %>"
                            alt="<%= asset.name %>"
                            loading="lazy"
                        >

                    </span>


                    <!-- =================================
                         DETAILS
                    ================================== -->

                    <span
                        class="asset-bar-item-details"
                    >


                        <span
                            class="asset-bar-item-name"
                        >
                            <%= asset.name %>
                        </span>


                        <% if (asset.type) { %>

                            <span
                                class="asset-bar-item-meta"
                            >
                                <%= asset.type %>
                            </span>

                        <% } %>


                        <% if (asset.location) { %>

                            <span
                                class="asset-bar-item-meta"
                            >
                                <%= asset.location %>
                            </span>

                        <% } %>


                    </span>


                    <!-- =================================
                         ARROW
                    ================================== -->

                    <span
                        class="asset-bar-item-arrow"
                        aria-hidden="true"
                    >
                        ›
                    </span>


                </a>


            <% }); %>


        <% } else { %>


            <div class="asset-bar-empty">


                <span
                    class="asset-bar-empty-icon"
                    aria-hidden="true"
                >
                    —
                </span>


                <span>
                    No structures, machines or tools
                    found for this dairy farm.
                </span>


            </div>


        <% } %>


    </div>


</section>

</div></aside><!-- =========================================================
     ASSET BAR JAVASCRIPT

     Controls:

         • Opening
         • Closing
         • Overlay
         • Escape key
         • Category switching

     Asset navigation itself is handled by normal
     <a href="/dairy/:id"> links.
========================================================= --><script>

document.addEventListener(
    "DOMContentLoaded",
    function() {


        /* =================================================
           ELEMENTS
        ================================================= */

        const assetBar =
            document.getElementById(
                "assetBar"
            );


        const overlay =
            document.getElementById(
                "assetBarOverlay"
            );


        const openButton =
            document.getElementById(
                "viewPropertyButton"
            );


        const closeButton =
            document.getElementById(
                "closeAssetBar"
            );


        const tabs =
            document.querySelectorAll(
                ".asset-bar-tab"
            );


        const sections =
            document.querySelectorAll(
                ".asset-bar-section"
            );


        /* =================================================
           SAFETY CHECK
        ================================================= */

        if (!assetBar) {

            console.warn(
                "Asset Bar: #assetBar was not found."
            );

            return;

        }


        if (!openButton) {

            console.warn(
                "Asset Bar: #viewPropertyButton was not found."
            );

            return;

        }


        /* =================================================
           CATEGORY SWITCHING
        ================================================= */

        function setCategory(category) {


            if (!category) {

                return;

            }


            tabs.forEach(
                function(tab) {


                    const isActive =
                        tab.dataset.assetCategory ===
                        category;


                    tab.classList.toggle(
                        "active",
                        isActive
                    );


                    tab.setAttribute(
                        "aria-selected",
                        String(isActive)
                    );


                }
            );


            sections.forEach(
                function(section) {


                    const isActive =
                        section.dataset.assetSection ===
                        category;


                    section.classList.toggle(
                        "active",
                        isActive
                    );


                    section.hidden =
                        !isActive;


                }
            );


        }


        /* =================================================
           DEFAULT CATEGORY
        ================================================= */

        function resetCategory() {

            setCategory(
                "animals"
            );

        }


        /* =================================================
           OPEN SIDEBAR
        ================================================= */

        function openAssetBar() {


            resetCategory();


            assetBar.classList.add(
                "active"
            );


            if (overlay) {

                overlay.classList.add(
                    "active"
                );

            }


            assetBar.setAttribute(
                "aria-hidden",
                "false"
            );


            openButton.setAttribute(
                "aria-expanded",
                "true"
            );


            if (overlay) {

                overlay.setAttribute(
                    "aria-hidden",
                    "false"
                );

            }


            document.body.classList.add(
                "asset-bar-open"
            );


            if (closeButton) {

                setTimeout(
                    function() {

                        closeButton.focus();

                    },
                    50
                );

            }


        }


        /* =================================================
           CLOSE SIDEBAR
        ================================================= */

        function closeAssetBar() {


            assetBar.classList.remove(
                "active"
            );


            if (overlay) {

                overlay.classList.remove(
                    "active"
                );

            }


            assetBar.setAttribute(
                "aria-hidden",
                "true"
            );


            openButton.setAttribute(
                "aria-expanded",
                "false"
            );


            if (overlay) {

                overlay.setAttribute(
                    "aria-hidden",
                    "true"
                );

            }


            document.body.classList.remove(
                "asset-bar-open"
            );


            if (openButton) {

                openButton.focus();

            }


        }


        /* =================================================
           VIEW ASSETS BUTTON
        ================================================= */

        openButton.addEventListener(
            "click",
            function(event) {


                event.preventDefault();


                if (
                    assetBar.classList.contains(
                        "active"
                    )
                ) {

                    closeAssetBar();

                } else {

                    openAssetBar();

                }


            }
        );


        /* =================================================
           CLOSE BUTTON
        ================================================= */

        if (closeButton) {

            closeButton.addEventListener(
                "click",
                function(event) {


                    event.preventDefault();


                    closeAssetBar();


                }
            );

        }


        /* =================================================
           OVERLAY CLICK
        ================================================= */

        if (overlay) {

            overlay.addEventListener(
                "click",
                function() {


                    closeAssetBar();


                }
            );

        }


        /* =================================================
           ESCAPE KEY
        ================================================= */

        document.addEventListener(
            "keydown",
            function(event) {


                if (
                    event.key === "Escape" &&
                    assetBar.classList.contains(
                        "active"
                    )
                ) {

                    closeAssetBar();

                }


            }
        );


        /* =================================================
           CATEGORY TAB CLICK
        ================================================= */

        tabs.forEach(
            function(tab) {


                tab.addEventListener(
                    "click",
                    function(event) {


                        event.preventDefault();


                        const category =
                            tab.dataset.assetCategory;


                        setCategory(
                            category
                        );


                    }
                );


            }
        );


        /* =================================================
           INITIAL STATE

           Sidebar is closed when the page loads.
========================================================= */

        assetBar.classList.remove(
            "active"
        );


        if (overlay) {

            overlay.classList.remove(
                "active"
            );

        }


        assetBar.setAttribute(
            "aria-hidden",
            "true"
        );


        if (overlay) {

            overlay.setAttribute(
                "aria-hidden",
                "true"
            );

        }


        openButton.setAttribute(
            "aria-expanded",
            "false"
        );


        document.body.classList.remove(
            "asset-bar-open"
        );


    }

);

</script><!-- =========================================================
     ASSET BAR STYLES
========================================================= --><style>

/* =========================================================
   ASSET BAR OVERLAY
========================================================= */

.asset-bar-overlay{

    position:fixed;

    top:120px;

    left:0;

    right:0;

    bottom:50px;

    background:rgba(0,0,0,.38);

    opacity:0;

    visibility:hidden;

    pointer-events:none;

    transition:
        opacity .25s ease,
        visibility .25s ease;

    z-index:1003;

}


.asset-bar-overlay.active{

    opacity:1;

    visibility:visible;

    pointer-events:auto;

}


/* =========================================================
   ASSET SIDEBAR
========================================================= */

.asset-bar{

    position:fixed;

    top:120px;

    right:0;

    bottom:50px;

    width:380px;

    max-width:calc(100vw - 20px);

    background:#fff;

    box-shadow:
        -6px 0 24px rgba(0,0,0,.18);

    transform:translateX(100%);

    visibility:hidden;

    pointer-events:none;

    transition:
        transform .28s ease,
        visibility .28s ease;

    z-index:1004;

    display:flex;

    flex-direction:column;

    overflow:hidden;

}


.asset-bar.active{

    transform:translateX(0);

    visibility:visible;

    pointer-events:auto;

}


/* =========================================================
   SIDEBAR TOP
========================================================= */

.asset-bar-top{

    flex-shrink:0;

    display:flex;

    align-items:center;

    justify-content:space-between;

    gap:12px;

    padding:16px 16px 13px;

    border-bottom:1px solid #e8ece9;

}


/* =========================================================
   HEADING
========================================================= */

.asset-bar-heading{

    min-width:0;

}


.asset-bar-heading-label{

    display:block;

    font-size:10px;

    font-weight:700;

    letter-spacing:1.3px;

    color:#0b5d1e;

    margin-bottom:3px;

}


.asset-bar-heading h2{

    margin:0;

    font-size:21px;

    line-height:1.2;

    color:#18301f;

}


/* =========================================================
   CLOSE BUTTON
========================================================= */

.asset-bar-close{

    flex:0 0 38px;

    width:38px;

    height:38px;

    border:none;

    border-radius:50%;

    background:#f0f3f1;

    color:#17351f;

    display:flex;

    align-items:center;

    justify-content:center;

    cursor:pointer;

    font-size:27px;

    line-height:1;

    transition:
        background .2s ease,
        color .2s ease,
        transform .2s ease;

}


.asset-bar-close:hover{

    background:#0b5d1e;

    color:#fff;

    transform:rotate(90deg);

}


.asset-bar-close:focus-visible{

    outline:3px solid rgba(11,93,30,.3);

    outline-offset:2px;

}


/* =========================================================
   FARM INFORMATION
========================================================= */

.asset-bar-farm{

    flex-shrink:0;

    padding:11px 16px;

    background:#f4f8f5;

    border-bottom:1px solid #e4ebe6;

}


.asset-bar-farm-label{

    display:block;

    font-size:9px;

    font-weight:700;

    letter-spacing:1.2px;

    color:#6b756e;

}


.asset-bar-farm-name{

    display:block;

    margin-top:2px;

    font-size:14px;

    font-weight:700;

    color:#17351f;

    white-space:nowrap;

    overflow:hidden;

    text-overflow:ellipsis;

}


.asset-bar-farm-code{

    display:block;

    margin-top:2px;

    font-size:11px;

    color:#6b756e;

}


/* =========================================================
   CATEGORY SWITCHER
========================================================= */

.asset-bar-tabs{

    flex-shrink:0;

    display:grid;

    grid-template-columns:1fr 1fr;

    gap:6px;

    padding:10px 12px;

    background:#fff;

    border-bottom:1px solid #e8ece9;

}


/* =========================================================
   TAB
========================================================= */

.asset-bar-tab{

    position:relative;

    min-height:48px;

    padding:8px 34px 8px 11px;

    border:1px solid #dfe6e1;

    border-radius:9px;

    background:#f8faf9;

    color:#536058;

    text-align:left;

    cursor:pointer;

    transition:
        background .2s ease,
        border-color .2s ease,
        color .2s ease;

}


.asset-bar-tab:hover{

    border-color:#0b5d1e;

}


.asset-bar-tab.active{

    background:#0b5d1e;

    border-color:#0b5d1e;

    color:#fff;

}


.asset-bar-tab-title{

    display:block;

    font-size:13px;

    font-weight:700;

}


.asset-bar-tab-subtitle{

    display:block;

    margin-top:2px;

    font-size:9px;

    opacity:.78;

}


.asset-bar-tab-count{

    position:absolute;

    top:50%;

    right:9px;

    transform:translateY(-50%);

    min-width:22px;

    height:22px;

    padding:0 5px;

    border-radius:11px;

    background:#e6ece8;

    color:#314237;

    display:flex;

    align-items:center;

    justify-content:center;

    font-size:10px;

    font-weight:700;

}


.asset-bar-tab.active .asset-bar-tab-count{

    background:rgba(255,255,255,.2);

    color:#fff;

}


/* =========================================================
   CONTENT
========================================================= */

.asset-bar-content{

    flex:1;

    min-height:0;

    overflow-y:auto;

    overflow-x:hidden;

    padding:0 12px 18px;

}


/* =========================================================
   SECTION
========================================================= */

.asset-bar-section{

    padding-top:14px;

}


.asset-bar-section[hidden]{

    display:none !important;

}


/* =========================================================
   SECTION HEADER
========================================================= */

.asset-bar-section-header{

    display:flex;

    align-items:center;

    justify-content:space-between;

    gap:10px;

    margin-bottom:10px;

}


.asset-bar-section-label{

    display:block;

    font-size:9px;

    font-weight:700;

    letter-spacing:1px;

    color:#6d786f;

}


.asset-bar-section-header h3{

    margin:2px 0 0;

    font-size:17px;

    color:#193322;

}


.asset-bar-count{

    min-width:28px;

    height:28px;

    padding:0 7px;

    border-radius:14px;

    background:#e9f1eb;

    color:#0b5d1e;

    display:flex;

    align-items:center;

    justify-content:center;

    font-size:11px;

    font-weight:700;

}


/* =========================================================
   ASSET LIST
========================================================= */

.asset-bar-list{

    display:flex;

    flex-direction:column;

    gap:7px;

}


/* =========================================================
   ASSET ITEM

   These are now <a> elements rather than <button>
   elements because they navigate to /dairy/:id.
========================================================= */

.asset-bar-item{

    width:100%;

    display:flex;

    align-items:center;

    gap:10px;

    padding:9px;

    border:1px solid #e5eae6;

    border-radius:10px;

    background:#fff;

    text-align:left;

    cursor:pointer;

    text-decoration:none;

    box-sizing:border-box;

    transition:
        border-color .2s ease,
        background .2s ease,
        transform .15s ease;

}


.asset-bar-item:hover{

    background:#f6faf7;

    border-color:#b8cdbd;

    transform:translateX(-2px);

}


.asset-bar-item:focus-visible{

    outline:3px solid rgba(11,93,30,.22);

    outline-offset:1px;

}


/* =========================================================
   IMAGE
========================================================= */

.asset-bar-item-image{

    flex:0 0 48px;

    width:48px;

    height:48px;

    border-radius:8px;

    overflow:hidden;

    background:#edf1ee;

}


.asset-bar-item-image img{

    width:100%;

    height:100%;

    display:block;

    object-fit:cover;

}


/* =========================================================
   DETAILS
========================================================= */

.asset-bar-item-details{

    min-width:0;

    flex:1;

    display:flex;

    flex-direction:column;

    gap:2px;

}


.asset-bar-item-name{

    font-size:13px;

    font-weight:700;

    color:#193322;

    overflow:hidden;

    text-overflow:ellipsis;

    white-space:nowrap;

}


.asset-bar-item-code{

    font-size:10px;

    font-weight:600;

    color:#0b5d1e;

