<% /*
==========================================================
ASSET BAR

FILE:
views/dairy/assetBar.ejs

PURPOSE:
----------------------------------------------------------
• Displays properties belonging ONLY to the currently
  viewed dairy farm.
• Allows a dairyWorker with multiple assigned farms
  to switch between those farms.
• Provides four asset categories:

      1. Animals
      2. Cow Shades
      3. Animal Feeds
      4. Tools

• Every asset opens:

      /dairy/<asset._id>

• Farm switching opens:

      /dairy/<farm._id>

CLASSIFICATION:
----------------------------------------------------------

Animals:
    code > 0
    OR
    recordType === "animal"

    NOTE:
    recordType is NOT the only criterion.

Animal gender:
    code % 2 !== 0
        = Male

    code % 2 === 0
        = Female

    Gender is DISPLAYED instead of the animal code.

Cow Shades:
    roomNumber > 0

Animal Feeds:
    roomNumber < 0

Tools:
    code is missing
    AND
    roomNumber is missing
    AND
    dwellNumber is missing

LAYOUT SAFETY:
----------------------------------------------------------
• Does NOT modify .page
• Does NOT modify .main-content
• Does NOT modify .dashboard-sidebar
• Does NOT move the header
• Does NOT change global body positioning
• Overlay starts below the existing top navigation
• Sidebar stays inside the available page viewport

EXPECTED DATA:
----------------------------------------------------------
• dairy
• assetDairies
• assignedFarms
==========================================================
*/ %>


<%
/* ==========================================================
   PREPARE ASSET DATA
========================================================== */

const availableAssets =
    Array.isArray(assetDairies)
        ? assetDairies.filter(asset => !!asset)
        : [];


/* ==========================================================
   HELPER:
   CHECK WHETHER A VALUE IS MISSING
========================================================== */

function isMissing(value) {

    return (
        value === null ||
        value === undefined ||
        value === ""
    );

}


/* ==========================================================
   HELPER:
   CHECK FOR POSITIVE CODE
========================================================== */

function hasPositiveCode(asset) {

    if (!asset) {

        return false;

    }

    if (isMissing(asset.code)) {

        return false;

    }

    const code =
        Number(asset.code);

    return (
        Number.isFinite(code) &&
        code > 0
    );

}


/* ==========================================================
   HELPER:
   CHECK FOR ANIMAL RECORD TYPE
========================================================== */

function hasAnimalRecordType(asset) {

    if (!asset) {

        return false;

    }

    return (
        typeof asset.recordType === "string" &&
        asset.recordType
            .trim()
            .toLowerCase() === "animal"
    );

}


/* ==========================================================
   HELPER:
   DETERMINE WHETHER AN ASSET IS AN ANIMAL
----------------------------------------------------------
   Animal if:

       code > 0

   OR

       recordType === "animal"

   IMPORTANT:
   recordType alone is NOT used as the sole classification
   rule. It is one of the two accepted animal criteria.
========================================================== */

function isAnimal(asset) {

    return (
        hasPositiveCode(asset) ||
        hasAnimalRecordType(asset)
    );

}


/* ==========================================================
   HELPER:
   DETERMINE ANIMAL GENDER

----------------------------------------------------------
   Positive / numeric animal code:

       ODD
           = Male

       EVEN
           = Female

   Example:

       code 1  = Male
       code 2  = Female
       code 3  = Male
       code 4  = Female

   If no valid numeric code exists, return empty string.
========================================================== */

function getAnimalGender(asset) {

    if (!asset || isMissing(asset.code)) {

        return "";

    }

    const code =
        Number(asset.code);

    if (!Number.isFinite(code)) {

        return "";

    }

    return (
        Math.abs(code) % 2 !== 0
            ? "Male"
            : "Female"
    );

}


/* ==========================================================
   ANIMALS

   An asset is an animal when:

       code > 0

   OR

       recordType === "animal"
========================================================== */

const animalDairies =
    availableAssets.filter(asset => {

        return isAnimal(asset);

    });


/* ==========================================================
   COW SHADES

   Cow shades have a POSITIVE roomNumber.
========================================================== */

const cowShadeDairies =
    availableAssets.filter(asset => {

        return (
            !isAnimal(asset) &&
            !isMissing(asset.roomNumber) &&
            Number(asset.roomNumber) > 0
        );

    });


/* ==========================================================
   ANIMAL FEEDS

   Animal feed facilities have a NEGATIVE roomNumber.
========================================================== */

const animalFeedDairies =
    availableAssets.filter(asset => {

        return (
            !isAnimal(asset) &&
            !isMissing(asset.roomNumber) &&
            Number(asset.roomNumber) < 0
        );

    });


/* ==========================================================
   TOOLS

   Tools have:

       no code
       AND
       no roomNumber
       AND
       no dwellNumber
========================================================== */

const toolDairies =
    availableAssets.filter(asset => {

        return (
            !isAnimal(asset) &&
            isMissing(asset.code) &&
            isMissing(asset.roomNumber) &&
            isMissing(asset.dwellNumber)
        );

    });


/* ==========================================================
   ASSIGNED FARMS

   Always fall back to an empty array so the partial
   cannot crash if assignedFarms is not supplied.
========================================================== */

const workerAssignedFarms =
    Array.isArray(assignedFarms)
        ? assignedFarms.filter(farm => !!farm)
        : [];


/* ==========================================================
   FARM SWITCHER

   Only show the switcher when there is more than one
   assigned farm.
========================================================== */

const canSwitchFarms =
    workerAssignedFarms.length > 1;


/* ==========================================================
   CURRENT FARM CHECK
========================================================== */

const isCurrentFarm =
    dairy &&
    dairy._id
        ? true
        : false;

%>


<!-- ==========================================================
     ASSET BAR OVERLAY
========================================================== -->

<div
    id="assetBarOverlay"
    class="asset-bar-component__overlay"
    aria-hidden="true"
></div>


<!-- ==========================================================
     ASSET SIDEBAR
========================================================== -->

<aside
    id="assetBar"
    class="asset-bar-component"
    aria-label="Farm assets"
    aria-hidden="true"
>


    <!-- ======================================================
         HEADER
    ======================================================= -->

    <header class="asset-bar-component__header">

        <div class="asset-bar-component__heading">

            <span class="asset-bar-component__eyebrow">
                FARM ASSETS
            </span>

            <h2 class="asset-bar-component__title">
                Your Assets
            </h2>

        </div>


        <button
            type="button"
            id="closeAssetBar"
            class="asset-bar-component__close"
            aria-label="Close assets"
            title="Close assets"
        >

            <span aria-hidden="true">
                ×
            </span>

        </button>

    </header>


    <!-- ======================================================
         CURRENT FARM
    ======================================================= -->

    <% if (
        dairy &&
        dairy.code !== null &&
        dairy.code !== undefined &&
        Number(dairy.code) < 0
    ) { %>


        <section
            class="asset-bar-component__farm"
            aria-label="Current dairy farm"
        >


            <!-- ==============================================
                 CURRENT FARM INFORMATION
            =============================================== -->

            <div class="asset-bar-component__current-farm">

                <span class="asset-bar-component__farm-label">
                    CURRENT FARM
                </span>

                <span class="asset-bar-component__farm-name">
                    <%= dairy.name %>
                </span>

                <span class="asset-bar-component__farm-code">
                    Farm #<%= dairy.code %>
                </span>

            </div>


            <!-- ==============================================
                 FARM SWITCHER
            =============================================== -->

            <% if (canSwitchFarms) { %>

                <div class="asset-bar-component__farm-switcher">

                    <button
                        type="button"
                        id="farmSwitchButton"
                        class="asset-bar-component__switch-button"
                        aria-label="Switch dairy farm"
                        aria-expanded="false"
                        aria-controls="assignedFarmList"
                    >

                        <span
                            class="asset-bar-component__switch-icon"
                            aria-hidden="true"
                        >
                            ⇄
                        </span>

                        <span>
                            Switch Farm
                        </span>

                    </button>


                    <!-- ======================================
                         ASSIGNED FARM LIST
                    ======================================= -->

                    <div
                        id="assignedFarmList"
                        class="asset-bar-component__farm-list"
                        hidden
                    >

                        <div
                            class="asset-bar-component__farm-list-title"
                        >
                            YOUR ASSIGNED FARMS
                        </div>


                        <div
                            class="asset-bar-component__farm-options"
                        >

                            <% workerAssignedFarms.forEach(farm => { %>

                                <a
                                    href="/dairy/<%= farm._id %>"
                                    class="asset-bar-component__farm-option <%= (
                                        dairy &&
                                        dairy._id &&
                                        farm._id &&
                                        dairy._id.toString() ===
                                        farm._id.toString()
                                    ) ? 'is-current' : '' %>"
                                >

                                    <span
                                        class="asset-bar-component__farm-option-icon"
                                        aria-hidden="true"
                                    >

                                        <%= (
                                            dairy &&
                                            dairy._id &&
                                            farm._id &&
                                            dairy._id.toString() ===
                                            farm._id.toString()
                                        ) ? '✓' : '⌂' %>

                                    </span>


                                    <span
                                        class="asset-bar-component__farm-option-details"
                                    >

                                        <span
                                            class="asset-bar-component__farm-option-name"
                                        >
                                            <%= farm.name %>
                                        </span>


                                        <% if (
                                            farm.code !== null &&
                                            farm.code !== undefined
                                        ) { %>

                                            <span
                                                class="asset-bar-component__farm-option-code"
                                            >
                                                Farm #<%= farm.code %>
                                            </span>

                                        <% } %>

                                    </span>


                                    <% if (
                                        dairy &&
                                        dairy._id &&
                                        farm._id &&
                                        dairy._id.toString() ===
                                        farm._id.toString()
                                    ) { %>

                                        <span
                                            class="asset-bar-component__current-label"
                                        >
                                            CURRENT
                                        </span>

                                    <% } %>

                                </a>

                            <% }); %>

                        </div>

                    </div>

                </div>

            <% } %>

        </section>

    <% } %>


    <!-- ======================================================
         CATEGORY TABS
    ======================================================= -->

    <div
        class="asset-bar-component__tabs"
        role="tablist"
        aria-label="Asset categories"
    >


        <!-- ==================================================
             ANIMALS TAB
        =================================================== -->

        <button
            type="button"
            id="assetAnimalsTab"
            class="asset-bar-component__tab is-active"
            data-asset-category="animals"
            role="tab"
            aria-selected="true"
            aria-controls="assetAnimals"
        >

            <span class="asset-bar-component__tab-title">
                Animals
            </span>

            <span class="asset-bar-component__tab-count">
                <%= animalDairies.length %>
            </span>

        </button>


        <!-- ==================================================
             COW SHADES TAB
        =================================================== -->

        <button
            type="button"
            id="assetCowShadesTab"
            class="asset-bar-component__tab"
            data-asset-category="cow-shades"
            role="tab"
            aria-selected="false"
            aria-controls="assetCowShades"
        >

            <span class="asset-bar-component__tab-title">
                Cow Shades
            </span>

            <span class="asset-bar-component__tab-count">
                <%= cowShadeDairies.length %>
            </span>

        </button>


        <!-- ==================================================
             ANIMAL FEEDS TAB
        =================================================== -->

        <button
            type="button"
            id="assetAnimalFeedsTab"
            class="asset-bar-component__tab"
            data-asset-category="animal-feeds"
            role="tab"
            aria-selected="false"
            aria-controls="assetAnimalFeeds"
        >

            <span class="asset-bar-component__tab-title">
                Animal Feeds
            </span>

            <span class="asset-bar-component__tab-count">
                <%= animalFeedDairies.length %>
            </span>

        </button>


        <!-- ==================================================
             TOOLS TAB
        =================================================== -->

        <button
            type="button"
            id="assetToolsTab"
            class="asset-bar-component__tab"
            data-asset-category="tools"
            role="tab"
            aria-selected="false"
            aria-controls="assetTools"
        >

            <span class="asset-bar-component__tab-title">
                Tools
            </span>

            <span class="asset-bar-component__tab-count">
                <%= toolDairies.length %>
            </span>

        </button>

    </div>


    <!-- ======================================================
         SCROLLABLE CONTENT
    ======================================================= -->

    <div class="asset-bar-component__content">


        <!-- ==================================================
             ANIMALS
        =================================================== -->

        <section
            id="assetAnimals"
            class="asset-bar-component__section is-active"
            data-asset-section="animals"
            role="tabpanel"
            aria-labelledby="assetAnimalsTab"
        >

            <div class="asset-bar-component__section-header">

                <div>

                    <span class="asset-bar-component__section-label">
                        LIVESTOCK
                    </span>

                    <h3>
                        Animals
                    </h3>

                </div>

                <span class="asset-bar-component__section-count">
                    <%= animalDairies.length %>
                </span>

            </div>


            <div class="asset-bar-component__list">

                <% if (animalDairies.length > 0) { %>

                    <% animalDairies.forEach(animal => { %>

                        <a
                            href="/dairy/<%= animal._id %>"
                            class="asset-bar-component__item"
                            data-asset-id="<%= animal._id %>"
                            data-asset-code="<%= animal.code || '' %>"
                            data-asset-gender="<%= getAnimalGender(animal) %>"
                            data-asset-type="animal"
                        >

                            <span
                                class="asset-bar-component__item-image"
                            >

                                <% if (animal.displayImage) { %>

                                    <img
                                        src="<%= animal.displayImage %>"
                                        alt="<%= animal.name %>"
                                        loading="lazy"
                                    >

                                <% } else { %>

                                    <span
                                        class="asset-bar-component__image-placeholder"
                                        aria-hidden="true"
                                    >
                                        🐄
                                    </span>

                                <% } %>

                            </span>


                            <span
                                class="asset-bar-component__item-details"
                            >

                                <span
                                    class="asset-bar-component__item-name"
                                >
                                    <%= animal.name %>
                                </span>


                                <!-- ==================================
                                     GENDER

                                     code odd  = Male
                                     code even = Female
                                =================================== -->

                                <% const animalGender =
                                    getAnimalGender(animal); %>


                                <% if (animalGender) { %>

                                    <span
                                        class="asset-bar-component__item-code"
                                    >
                                        <%= animalGender %>
                                    </span>

                                <% } %>


                                <% if (animal.type) { %>

                                    <span
                                        class="asset-bar-component__item-meta"
                                    >
                                        <%= animal.type %>
                                    </span>

                                <% } %>


                            </span>


                            <span
                                class="asset-bar-component__item-arrow"
                                aria-hidden="true"
                            >
                                ›
                            </span>

                        </a>

                    <% }); %>

                <% } else { %>

                    <div class="asset-bar-component__empty">

                        <span
                            class="asset-bar-component__empty-icon"
                            aria-hidden="true"
                        >
                            🐄
                        </span>

                        <span>
                            No animals found for this dairy farm.
                        </span>

                    </div>

                <% } %>

            </div>

        </section>


        <!-- ==================================================
             COW SHADES
        =================================================== -->

        <section
            id="assetCowShades"
            class="asset-bar-component__section"
            data-asset-section="cow-shades"
            role="tabpanel"
            aria-labelledby="assetCowShadesTab"
            hidden
        >

            <div class="asset-bar-component__section-header">

                <div>

                    <span class="asset-bar-component__section-label">
                        FARM FACILITIES
                    </span>

                    <h3>
                        Cow Shades
                    </h3>

                </div>

                <span class="asset-bar-component__section-count">
                    <%= cowShadeDairies.length %>
                </span>

            </div>


            <div class="asset-bar-component__list">

                <% if (cowShadeDairies.length > 0) { %>

                    <% cowShadeDairies.forEach(shade => { %>

                        <a
                            href="/dairy/<%= shade._id %>"
                            class="asset-bar-component__item"
                            data-asset-id="<%= shade._id %>"
                            data-asset-room-number="<%= shade.roomNumber %>"
                            data-asset-type="cow-shade"
                        >

                            <span
                                class="asset-bar-component__item-image"
                            >

                                <% if (shade.displayImage) { %>

                                    <img
                                        src="<%= shade.displayImage %>"
                                        alt="<%= shade.name %>"
                                        loading="lazy"
                                    >

                                <% } else { %>

                                    <span
                                        class="asset-bar-component__image-placeholder"
                                        aria-hidden="true"
                                    >
                                        🏠
                                    </span>

                                <% } %>

                            </span>


                            <span
                                class="asset-bar-component__item-details"
                            >

                                <span
                                    class="asset-bar-component__item-name"
                                >
                                    <%= shade.name %>
                                </span>


                                <span
                                    class="asset-bar-component__item-code"
                                >
                                    Shade #<%= shade.roomNumber %>
                                </span>


                                <% if (shade.type) { %>

                                    <span
                                        class="asset-bar-component__item-meta"
                                    >
                                        <%= shade.type %>
                                    </span>

                                <% } %>


                                <% if (shade.location) { %>

                                    <span
                                        class="asset-bar-component__item-meta"
                                    >
                                        <%= shade.location %>
                                    </span>

                                <% } %>

                            </span>


                            <span
                                class="asset-bar-component__item-arrow"
                                aria-hidden="true"
                            >
                                ›
                            </span>

                        </a>

                    <% }); %>

                <% } else { %>

                    <div class="asset-bar-component__empty">

                        <span
                            class="asset-bar-component__empty-icon"
                            aria-hidden="true"
                        >
                            🏠
                        </span>

                        <span>
                            No cow shades found for this dairy farm.
                        </span>

                    </div>

                <% } %>

            </div>

        </section>


        <!-- ==================================================
             ANIMAL FEEDS
        =================================================== -->

        <section
            id="assetAnimalFeeds"
            class="asset-bar-component__section"
            data-asset-section="animal-feeds"
            role="tabpanel"
            aria-labelledby="assetAnimalFeedsTab"
            hidden
        >

            <div class="asset-bar-component__section-header">

                <div>

                    <span class="asset-bar-component__section-label">
                        FEED FACILITIES
                    </span>

                    <h3>
                        Animal Feeds
                    </h3>

                </div>

                <span class="asset-bar-component__section-count">
                    <%= animalFeedDairies.length %>
                </span>

            </div>


            <div class="asset-bar-component__list">

                <% if (animalFeedDairies.length > 0) { %>

                    <% animalFeedDairies.forEach(feed => { %>

                        <a
                            href="/dairy/<%= feed._id %>"
                            class="asset-bar-component__item"
                            data-asset-id="<%= feed._id %>"
                            data-asset-room-number="<%= feed.roomNumber %>"
                            data-asset-type="animal-feed"
                        >

                            <span
                                class="asset-bar-component__item-image"
                            >

                                <% if (feed.displayImage) { %>

                                    <img
                                        src="<%= feed.displayImage %>"
                                        alt="<%= feed.name %>"
                                        loading="lazy"
                                    >

                                <% } else { %>

                                    <span
                                        class="asset-bar-component__image-placeholder"
                                        aria-hidden="true"
                                    >
                                        🌾
                                    </span>

                                <% } %>

                            </span>


                            <span
                                class="asset-bar-component__item-details"
                            >

                                <span
                                    class="asset-bar-component__item-name"
                                >
                                    <%= feed.name %>
                                </span>


                                <span
                                    class="asset-bar-component__item-code"
                                >
                                    Feed #<%= feed.roomNumber %>
                                </span>


                                <% if (feed.type) { %>

                                    <span
                                        class="asset-bar-component__item-meta"
                                    >
                                        <%= feed.type %>
                                    </span>

                                <% } %>


                                <% if (feed.location) { %>

                                    <span
                                        class="asset-bar-component__item-meta"
                                    >
                                        <%= feed.location %>
                                    </span>

                                <% } %>

                            </span>


                            <span
                                class="asset-bar-component__item-arrow"
                                aria-hidden="true"
                            >
                                ›
                            </span>

                        </a>

                    <% }); %>

                <% } else { %>

                    <div class="asset-bar-component__empty">

                        <span
                            class="asset-bar-component__empty-icon"
                            aria-hidden="true"
                        >
                            🌾
                        </span>

                        <span>
                            No animal feed facilities found
                            for this dairy farm.
                        </span>

                    </div>

                <% } %>

            </div>

        </section>


        <!-- ==================================================
             TOOLS
        =================================================== -->

        <section
            id="assetTools"
            class="asset-bar-component__section"
            data-asset-section="tools"
            role="tabpanel"
            aria-labelledby="assetToolsTab"
            hidden
        >

            <div class="asset-bar-component__section-header">

                <div>

                    <span class="asset-bar-component__section-label">
                        FARM EQUIPMENT
                    </span>

                    <h3>
                        Tools
                    </h3>

                </div>

                <span class="asset-bar-component__section-count">
                    <%= toolDairies.length %>
                </span>

            </div>


            <div class="asset-bar-component__list">

                <% if (toolDairies.length > 0) { %>

                    <% toolDairies.forEach(tool => { %>

                        <a
                            href="/dairy/<%= tool._id %>"
                            class="asset-bar-component__item"
                            data-asset-id="<%= tool._id %>"
                            data-asset-type="tool"
                        >

                            <span
                                class="asset-bar-component__item-image"
                            >

                                <% if (tool.displayImage) { %>

                                    <img
                                        src="<%= tool.displayImage %>"
                                        alt="<%= tool.name %>"
                                        loading="lazy"
                                    >

                                <% } else { %>

                                    <span
                                        class="asset-bar-component__image-placeholder"
                                        aria-hidden="true"
                                    >
                                        🔧
                                    </span>

                                <% } %>

                            </span>


                            <span
                                class="asset-bar-component__item-details"
                            >

                                <span
                                    class="asset-bar-component__item-name"
                                >
                                    <%= tool.name %>
                                </span>


                                <% if (tool.type) { %>

                                    <span
                                        class="asset-bar-component__item-meta"
                                    >
                                        <%= tool.type %>
                                    </span>

                                <% } %>


                                <% if (tool.location) { %>

                                    <span
                                        class="asset-bar-component__item-meta"
                                    >
                                        <%= tool.location %>
                                    </span>

                                <% } %>

                            </span>


                            <span
                                class="asset-bar-component__item-arrow"
                                aria-hidden="true"
                            >
                                ›
                            </span>

                        </a>

                    <% }); %>

                <% } else { %>

                    <div class="asset-bar-component__empty">

                        <span
                            class="asset-bar-component__empty-icon"
                            aria-hidden="true"
                        >
                            🔧
                        </span>

                        <span>
                            No tools found for this dairy farm.
                        </span>

                    </div>

                <% } %>

            </div>

        </section>

    </div>

</aside>


<!-- ==========================================================
     ASSET BAR JAVASCRIPT
========================================================== -->

<script>
(function () {

    "use strict";


    /* ======================================================
       INITIALIZE AFTER DOM IS READY
    ======================================================= */

    function initializeAssetBar() {


        /* ==================================================
           ELEMENTS
        =================================================== */

        const assetBar =
            document.getElementById(
                "assetBar"
            );


        const overlay =
            document.getElementById(
                "assetBarOverlay"
            );


        const openButton =
            document.getElementById(
                "viewPropertyButton"
            );


        const closeButton =
            document.getElementById(
                "closeAssetBar"
            );


        const farmSwitchButton =
            document.getElementById(
                "farmSwitchButton"
            );


        const assignedFarmList =
            document.getElementById(
                "assignedFarmList"
            );


        const tabs =
            document.querySelectorAll(
                ".asset-bar-component__tab"
            );


        const sections =
            document.querySelectorAll(
                ".asset-bar-component__section"
            );


        /* ==================================================
           REQUIRED ELEMENT CHECK
        =================================================== */

        if (!assetBar) {

            return;

        }


        /* ==================================================
           CATEGORY SWITCHING
        =================================================== */

        function setCategory(category) {


            if (!category) {

                return;

            }


            tabs.forEach(
                function (tab) {

                    const isActive =
                        tab.dataset.assetCategory ===
                        category;


                    tab.classList.toggle(
                        "is-active",
                        isActive
                    );


                    tab.setAttribute(
                        "aria-selected",
                        String(isActive)
                    );

                }
            );


            sections.forEach(
                function (section) {

                    const isActive =
                        section.dataset.assetSection ===
                        category;


                    section.classList.toggle(
                        "is-active",
                        isActive
                    );


                    section.hidden =
                        !isActive;

                }
            );

        }


        /* ==================================================
           OPEN ASSET BAR
        =================================================== */

        function openAssetBar() {


            setCategory(
                "animals"
            );


            if (assignedFarmList) {

                assignedFarmList.hidden =
                    true;

            }


            if (farmSwitchButton) {

                farmSwitchButton.setAttribute(
                    "aria-expanded",
                    "false"
                );

            }


            assetBar.classList.add(
                "is-open"
            );


            if (overlay) {

                overlay.classList.add(
                    "is-active"
                );

            }


            assetBar.setAttribute(
                "aria-hidden",
                "false"
            );


            if (overlay) {

                overlay.setAttribute(
                    "aria-hidden",
                    "false"
                );

            }


            if (openButton) {

                openButton.setAttribute(
                    "aria-expanded",
                    "true"
                );

            }


            document.documentElement.classList.add(
                "asset-bar-component--open"
            );

        }


        /* ==================================================
           CLOSE ASSET BAR
        =================================================== */

        function closeAssetBar() {


            assetBar.classList.remove(
                "is-open"
            );


            if (overlay) {

                overlay.classList.remove(
                    "is-active"
                );

            }


            assetBar.setAttribute(
                "aria-hidden",
                "true"
            );


            if (overlay) {

                overlay.setAttribute(
                    "aria-hidden",
                    "true"
                );

            }


            if (openButton) {

                openButton.setAttribute(
                    "aria-expanded",
                    "false"
                );

            }


            if (assignedFarmList) {

                assignedFarmList.hidden =
                    true;

            }


            if (farmSwitchButton) {

                farmSwitchButton.setAttribute(
                    "aria-expanded",
                    "false"
                );

            }


            document.documentElement.classList.remove(
                "asset-bar-component--open"
            );

        }


        /* ==================================================
           VIEW PROPERTY BUTTON
        =================================================== */

        if (openButton) {

            openButton.addEventListener(
                "click",
                function (event) {

                    event.preventDefault();

                    event.stopPropagation();


                    if (
                        assetBar.classList.contains(
                            "is-open"
                        )
                    ) {

                        closeAssetBar();

                    } else {

                        openAssetBar();

                    }

                }
            );

        }


        /* ==================================================
           CLOSE BUTTON
        =================================================== */

        if (closeButton) {

            closeButton.addEventListener(
                "click",
                function (event) {

                    event.preventDefault();

                    event.stopPropagation();

                    closeAssetBar();

                }
            );

        }


        /* ==================================================
           OVERLAY
        =================================================== */

        if (overlay) {

            overlay.addEventListener(
                "click",
                function () {

                    closeAssetBar();

                }
            );

        }


        /* ==================================================
           FARM SWITCHER
        =================================================== */

        if (
            farmSwitchButton &&
            assignedFarmList
        ) {

            farmSwitchButton.addEventListener(
                "click",
                function (event) {

                    event.preventDefault();

                    event.stopPropagation();


                    const currentlyHidden =
                        assignedFarmList.hidden;


                    assignedFarmList.hidden =
                        !currentlyHidden;


                    farmSwitchButton.setAttribute(
                        "aria-expanded",
                        String(currentlyHidden)
                    );

                }
            );

        }


        /* ==================================================
           CATEGORY TABS
        =================================================== */

        tabs.forEach(
            function (tab) {

                tab.addEventListener(
                    "click",
                    function (event) {

                        event.preventDefault();

                        event.stopPropagation();


                        const category =
                            tab.dataset.assetCategory;


                        setCategory(
                            category
                        );

                    }
                );

            }
        );


        /* ==================================================
           ESCAPE KEY
        =================================================== */

        document.addEventListener(
            "keydown",
            function (event) {

                if (
                    event.key === "Escape" &&
                    assetBar.classList.contains(
                        "is-open"
                    )
                ) {

                    closeAssetBar();

                }

            }
        );


        /* ==================================================
           INITIAL STATE
        =================================================== */

        assetBar.classList.remove(
            "is-open"
        );


        assetBar.setAttribute(
            "aria-hidden",
            "true"
        );


        if (overlay) {

            overlay.classList.remove(
                "is-active"
            );


            overlay.setAttribute(
                "aria-hidden",
                "true"
            );

        }


        if (openButton) {

            openButton.setAttribute(
                "aria-expanded",
                "false"
            );

        }


        setCategory(
            "animals"
        );

    }


    /* ======================================================
       DOM READY
    ======================================================= */

    if (
        document.readyState ===
        "loading"
    ) {

        document.addEventListener(
            "DOMContentLoaded",
            initializeAssetBar
        );

    } else {

        initializeAssetBar();

    }


})();
</script>


