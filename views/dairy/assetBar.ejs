<!-- =========================================================
     ASSET BAR
     
     FILE:
     views/dairy/assetBar.ejs

     PURPOSE:
     Display properties belonging ONLY to the currently
     viewed Dairy Farm.

     DATA EXPECTED:

     dairy
         = Current Dairy Farm

     dairies
         = Available Dairy / Asset records


     CLASSIFICATION:

     Current Dairy Farm:
         dairy.code < 0

     Animal:
         code > 0
         assetCode === current Dairy Farm code

     Structure / Machine / Tool:
         code === null / undefined
         assetCode === current Dairy Farm code


     EXCLUDED:

     Other Dairy Farms:
         code < 0

     Standalone Structures:
         code === null / undefined
         assetCode === null / undefined

     ========================================================= --><!-- =========================================================
     DETERMINE CURRENT DAIRY FARM CODE
========================================================= --><%
const currentFarmCode =
dairy &&
dairy.code !== null &&
dairy.code !== undefined &&
Number(dairy.code) < 0

        ? Number(dairy.code)

        : null;

%>

<!-- =========================================================
     FILTER ASSETS BELONGING TO CURRENT DAIRY FARM
========================================================= --><%
const farmAssets =
currentFarmCode !== null && Array.isArray(dairies)

        ? dairies.filter(asset => {

            if (!asset) {
                return false;
            }

            if (
                asset.assetCode === null ||
                asset.assetCode === undefined
            ) {
                return false;
            }

            return (
                Number(asset.assetCode) ===
                currentFarmCode
            );

        })

        : [];

%>

<!-- =========================================================
     ANIMALS
     
     Positive code.
     
     Must belong to current Dairy Farm through assetCode.
========================================================= --><%
const animalDairies =
farmAssets.filter(asset => {

        return (
            asset.code !== null &&
            asset.code !== undefined &&
            Number(asset.code) > 0
        );

    });

%>

<!-- =========================================================
     STRUCTURES / MACHINES / TOOLS
     
     No code.
     
     Must belong to current Dairy Farm through assetCode.
========================================================= --><%
const structureDairies =
farmAssets.filter(asset => {

        return (
            asset.code === null ||
            asset.code === undefined
        );

    });

%>

<!-- =========================================================
     VIEW PROPERTY BUTTON
========================================================= --><button
type="button"
id="viewPropertyButton"
class="asset-bar-trigger"
aria-controls="assetBar"
aria-expanded="false"

«»

<span
    class="asset-bar-trigger-icon"
    aria-hidden="true"
>
    ◉
</span>

<span class="asset-bar-trigger-text">
    View Property
</span>

</button><!-- =========================================================
     SIDEBAR OVERLAY

     Hidden by default.

     Clicking outside the sidebar closes it.
========================================================= --><div
    id="assetBarOverlay"
    class="asset-bar-overlay"
    aria-hidden="true"
></div><!-- =========================================================
     ASSET SIDEBAR
========================================================= --><aside
    id="assetBar"
    class="asset-bar"
    aria-label="Property"
    aria-hidden="true"
><!-- =====================================================
     SIDEBAR HEADER
====================================================== -->

<div class="asset-bar-header">


    <div class="asset-bar-heading">

        <span class="asset-bar-heading-label">
            PROPERTY
        </span>

        <h2>
            Your Assets
        </h2>

    </div>


    <!-- =================================================
         CLOSE BUTTON
    ================================================== -->

    <button
        type="button"
        id="closeAssetBar"
        class="asset-bar-close"
        aria-label="Close Property"
    >

        <span aria-hidden="true">
            ×
        </span>

    </button>


</div>


<!-- =====================================================
     CURRENT FARM INFORMATION
====================================================== -->

<% if (currentFarmCode !== null) { %>

    <div class="asset-bar-farm">

        <span class="asset-bar-farm-label">
            FARM
        </span>

        <span class="asset-bar-farm-name">
            <%= dairy.name %>
        </span>

        <span class="asset-bar-farm-code">
            Farm #<%= currentFarmCode %>
        </span>

    </div>

<% } %>


<!-- =====================================================
     CATEGORY SWITCHER
====================================================== -->

<div
    class="asset-bar-tabs"
    role="tablist"
    aria-label="Property categories"
>


    <!-- ================================================
         ANIMALS TAB
    ================================================= -->

    <button
        type="button"
        class="asset-bar-tab active"
        data-asset-category="animals"
        role="tab"
        aria-selected="true"
        aria-controls="assetAnimals"
    >

        <span class="asset-bar-tab-title">
            Animals
        </span>

    </button>


    <!-- ================================================
         STRUCTURES TAB
    ================================================= -->

    <button
        type="button"
        class="asset-bar-tab"
        data-asset-category="structures"
        role="tab"
        aria-selected="false"
        aria-controls="assetStructures"
    >

        <span class="asset-bar-tab-title">
            Structures
        </span>

        <span class="asset-bar-tab-subtitle">
            Machines &amp; Tools
        </span>

    </button>


</div>


<!-- =====================================================
     SIDEBAR CONTENT
====================================================== -->

<div class="asset-bar-content">


    <!-- =================================================
         ANIMALS
    ================================================== -->

    <section
        id="assetAnimals"
        class="asset-bar-section active"
        data-asset-section="animals"
        role="tabpanel"
        aria-label="Animals"
    >


        <!-- =============================================
             SECTION HEADER
        ============================================== -->

        <div class="asset-bar-section-header">


            <div>

                <span class="asset-bar-section-label">
                    LIVESTOCK
                </span>

                <h3>
                    Animals
                </h3>

            </div>


            <span class="asset-bar-count">
                <%= animalDairies.length %>
            </span>


        </div>


        <!-- =============================================
             ANIMAL LIST
        ============================================== -->

        <div class="asset-bar-list">


            <% if (animalDairies.length) { %>


                <% animalDairies.forEach(animal => { %>


                    <!-- =================================
                         ANIMAL
                    ================================== -->

                    <button
                        type="button"
                        class="asset-bar-item asset-bar-animal"
                        data-asset-id="<%= animal._id %>"
                        data-asset-code="<%= animal.code %>"
                        data-asset-parent-code="<%= animal.assetCode %>"
                        data-asset-type="animal"
                    >


                        <!-- =============================
                             IMAGE
                        ============================== -->

                        <span
                            class="asset-bar-item-image"
                        >

                            <img
                                src="<%= animal.displayImage %>"
                                alt="<%= animal.name %>"
                                loading="lazy"
                            >

                        </span>


                        <!-- =============================
                             INFORMATION
                        ============================== -->

                        <span
                            class="asset-bar-item-details"
                        >


                            <span
                                class="asset-bar-item-name"
                            >
                                <%= animal.name %>
                            </span>


                            <span
                                class="asset-bar-item-code"
                            >
                                Animal #<%= animal.code %>
                            </span>


                            <% if (animal.type) { %>

                                <span
                                    class="asset-bar-item-meta"
                                >
                                    <%= animal.type %>
                                </span>

                            <% } %>


                            <% if (animal.gender) { %>

                                <span
                                    class="asset-bar-item-meta"
                                >
                                    <%= animal.gender %>
                                </span>

                            <% } %>


                        </span>


                        <!-- =============================
                             ARROW
                        ============================== -->

                        <span
                            class="asset-bar-item-arrow"
                            aria-hidden="true"
                        >
                            ›
                        </span>


                    </button>


                <% }); %>


            <% } else { %>


                <!-- =====================================
                     NO ANIMALS
                ====================================== -->

                <div class="asset-bar-empty">

                    <span
                        class="asset-bar-empty-icon"
                        aria-hidden="true"
                    >
                        —
                    </span>

                    <span>
                        No animals found for this dairy farm.
                    </span>

                </div>


            <% } %>


        </div>


    </section>


    <!-- =================================================
         STRUCTURES / MACHINES / TOOLS
    ================================================== -->

    <section
        id="assetStructures"
        class="asset-bar-section"
        data-asset-section="structures"
        role="tabpanel"
        aria-label="Structures, Machines and Tools"
        hidden
    >


        <!-- =============================================
             SECTION HEADER
        ============================================== -->

        <div class="asset-bar-section-header">


            <div>

                <span class="asset-bar-section-label">
                    FARM PROPERTY
                </span>

                <h3>
                    Structures &amp; Equipment
                </h3>

            </div>


            <span class="asset-bar-count">
                <%= structureDairies.length %>
            </span>


        </div>


        <!-- =============================================
             STRUCTURE LIST
        ============================================== -->

        <div class="asset-bar-list">


            <% if (structureDairies.length) { %>


                <% structureDairies.forEach(asset => { %>


                    <!-- =================================
                         STRUCTURE / MACHINE / TOOL
                    ================================== -->

                    <button
                        type="button"
                        class="asset-bar-item asset-bar-structure"
                        data-asset-id="<%= asset._id %>"
                        data-asset-parent-code="<%= asset.assetCode %>"
                        data-asset-type="structure"
                    >


                        <!-- =============================
                             IMAGE
                        ============================== -->

                        <span
                            class="asset-bar-item-image"
                        >

                            <img
                                src="<%= asset.displayImage %>"
                                alt="<%= asset.name %>"
                                loading="lazy"
                            >

                        </span>


                        <!-- =============================
                             INFORMATION
                        ============================== -->

                        <span
                            class="asset-bar-item-details"
                        >


                            <span
                                class="asset-bar-item-name"
                            >
                                <%= asset.name %>
                            </span>


                            <% if (asset.type) { %>

                                <span
                                    class="asset-bar-item-meta"
                                >
                                    <%= asset.type %>
                                </span>

                            <% } %>


                            <% if (asset.location) { %>

                                <span
                                    class="asset-bar-item-meta"
                                >
                                    <%= asset.location %>
                                </span>

                            <% } %>


                        </span>


                        <!-- =============================
                             ARROW
                        ============================== -->

                        <span
                            class="asset-bar-item-arrow"
                            aria-hidden="true"
                        >
                            ›
                        </span>


                    </button>


                <% }); %>


            <% } else { %>


                <!-- =====================================
                     NO STRUCTURES
                ====================================== -->

                <div class="asset-bar-empty">

                    <span
                        class="asset-bar-empty-icon"
                        aria-hidden="true"
                    >
                        —
                    </span>

                    <span>
                        No structures, machines or tools
                        found for this dairy farm.
                    </span>

                </div>


            <% } %>


        </div>


    </section>


</div>


<!-- =====================================================
     SIDEBAR FOOTER
====================================================== -->

<div class="asset-bar-footer">

    <span>
        Select a property to view its details.
    </span>

</div>

</aside>