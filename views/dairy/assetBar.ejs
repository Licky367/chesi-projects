<% /* ===================.======================================
ASSET BAR

FILE:
views/dairy/assetBar.ejs

PURPOSE:

Displays properties belonging ONLY to the currently
viewed Dairy Farm.

Also allows a dairyWorker with multiple assigned
dairy farms to switch between those farms.

NAVIGATION:

Every animal, structure, machine or tool:

    /dairy/<asset._id>

Farm switching:

    /dairy/<farm._id>

========================================================= */ %>


<%
/* =========================================================
PREPARE ASSET DATA
========================================================= */

const availableAssets =
Array.isArray(assetDairies)
? assetDairies.filter(asset => !!asset)
: [];


/* =========================================================
ANIMALS

code > 0
========================================================= */

const animalDairies =
availableAssets.filter(asset => {

    return (
        asset.code !== null &&
        asset.code !== undefined &&
        Number(asset.code) > 0
    );

});


/* =========================================================
STRUCTURES / MACHINES / TOOLS

code === null / undefined
========================================================= */

const structureDairies =
availableAssets.filter(asset => {

    return (
        asset.code === null ||
        asset.code === undefined
    );

});


/* =========================================================
ASSIGNED FARMS

The parent page should provide:

    assignedFarms

Each item should be a Dairy document.

If unavailable, use an empty array so that the
asset bar does not crash.
========================================================= */

const workerAssignedFarms =
Array.isArray(assignedFarms)
? assignedFarms.filter(farm => !!farm)
: [];


/* =========================================================
SHOW FARM SWITCHER ONLY WHEN:

    More than one farm is assigned.
========================================================= */

const canSwitchFarms =
workerAssignedFarms.length > 1;

%>


<!-- =========================================================
     ASSET BAR OVERLAY
========================================================= -->

<div
    id="assetBarOverlay"
    class="asset-bar-overlay"
    aria-hidden="true"
></div>


<!-- =========================================================
     ASSET SIDEBAR
========================================================= -->

<aside
    id="assetBar"
    class="asset-bar"
    aria-label="Farm Assets"
    aria-hidden="true"
>


<!-- =====================================================
     SIDEBAR TOP AREA
====================================================== -->

<div class="asset-bar-top">

    <div class="asset-bar-heading">

        <span class="asset-bar-heading-label">
            FARM ASSETS
        </span>

        <h2>
            Your Assets
        </h2>

    </div>


    <button
        type="button"
        id="closeAssetBar"
        class="asset-bar-close"
        aria-label="Close Assets"
        title="Close Assets"
    >

        <span aria-hidden="true">
            ×
        </span>

    </button>

</div>


<!-- =====================================================
     CURRENT FARM
====================================================== -->

<% if (
    dairy &&
    dairy.code !== null &&
    dairy.code !== undefined &&
    Number(dairy.code) < 0
) { %>

<div class="asset-bar-farm">


    <!-- =================================================
         CURRENT FARM INFORMATION
    ================================================== -->

    <div class="asset-bar-current-farm">

        <span class="asset-bar-farm-label">
            CURRENT FARM
        </span>


        <span class="asset-bar-farm-name">
            <%= dairy.name %>
        </span>


        <span class="asset-bar-farm-code">
            Farm #<%= dairy.code %>
        </span>

    </div>


    <!-- =================================================
         FARM SWITCHER

         Only appears when the worker has more than
         one assigned farm.
    ================================================== -->

    <% if (canSwitchFarms) { %>

        <div class="asset-bar-farm-switcher">


            <!-- =========================================
                 SWAP BUTTON
            ========================================== -->

            <button
                type="button"
                id="farmSwitchButton"
                class="farm-switch-button"
                aria-label="Switch Dairy Farm"
                aria-expanded="false"
                aria-controls="assignedFarmList"
                title="Switch Dairy Farm"
            >

                <!-- Swap icon -->

                <span
                    class="farm-switch-icon"
                    aria-hidden="true"
                >
                    ⇄
                </span>

                <span class="farm-switch-text">
                    Switch Farm
                </span>

            </button>


            <!-- =========================================
                 ASSIGNED FARM LIST
            ========================================== -->

            <div
                id="assignedFarmList"
                class="assigned-farm-list"
                hidden
            >

                <div class="assigned-farm-list-header">

                    <span>
                        YOUR ASSIGNED FARMS
                    </span>

                </div>


                <div class="assigned-farm-options">

                    <% workerAssignedFarms.forEach(farm => { %>


                        <a
                            href="/dairy/<%= farm._id %>"
                            class="assigned-farm-option
                            <%= dairy._id.toString() === farm._id.toString()
                                ? 'current'
                                : '' %>"
                        >


                            <span class="assigned-farm-option-icon">
                                <span aria-hidden="true">
                                    <%= dairy._id.toString() === farm._id.toString()
                                        ? '✓'
                                        : '⌂' %>
                                </span>
                            </span>


                            <span class="assigned-farm-option-details">

                                <span class="assigned-farm-option-name">
                                    <%= farm.name %>
                                </span>


                                <% if (
                                    farm.code !== null &&
                                    farm.code !== undefined
                                ) { %>

                                    <span class="assigned-farm-option-code">
                                        Farm #<%= farm.code %>
                                    </span>

                                <% } %>

                            </span>


                            <% if (
                                dairy._id.toString() ===
                                farm._id.toString()
                            ) { %>

                                <span class="assigned-farm-current">
                                    CURRENT
                                </span>

                            <% } %>


                        </a>


                    <% }); %>

                </div>

            </div>

        </div>

    <% } %>


</div>

<% } %>


<!-- =====================================================
     CATEGORY SWITCHER
====================================================== -->

<div
    class="asset-bar-tabs"
    role="tablist"
    aria-label="Asset categories"
>


<!-- =================================================
     ANIMALS
================================================== -->

<button
    type="button"
    id="assetAnimalsTab"
    class="asset-bar-tab active"
    data-asset-category="animals"
    role="tab"
    aria-selected="true"
    aria-controls="assetAnimals"
>

    <span class="asset-bar-tab-title">
        Animals
    </span>

    <span class="asset-bar-tab-count">
        <%= animalDairies.length %>
    </span>

</button>


<!-- =================================================
     STRUCTURES
================================================== -->

<button
    type="button"
    id="assetStructuresTab"
    class="asset-bar-tab"
    data-asset-category="structures"
    role="tab"
    aria-selected="false"
    aria-controls="assetStructures"
>

    <span class="asset-bar-tab-title">
        Structures
    </span>

    <span class="asset-bar-tab-subtitle">
        Machines &amp; Tools
    </span>

    <span class="asset-bar-tab-count">
        <%= structureDairies.length %>
    </span>

</button>

</div>


<!-- =====================================================
     ASSET CONTENT
====================================================== -->

<div class="asset-bar-content">


<!-- =================================================
     ANIMALS
================================================== -->

<section
    id="assetAnimals"
    class="asset-bar-section active"
    data-asset-section="animals"
    role="tabpanel"
    aria-labelledby="assetAnimalsTab"
>


    <div class="asset-bar-section-header">

        <div>

            <span class="asset-bar-section-label">
                LIVESTOCK
            </span>

            <h3>
                Animals
            </h3>

        </div>


        <span class="asset-bar-count">
            <%= animalDairies.length %>
        </span>

    </div>


    <div class="asset-bar-list">


        <% if (animalDairies.length) { %>


            <% animalDairies.forEach(animal => { %>


                <a
                    href="/dairy/<%= animal._id %>"
                    class="asset-bar-item asset-bar-animal"
                    data-asset-id="<%= animal._id %>"
                    data-asset-code="<%= animal.code %>"
                    data-asset-parent-code="<%= animal.assetCode || '' %>"
                    data-asset-type="animal"
                >


                    <span class="asset-bar-item-image">

                        <img
                            src="<%= animal.displayImage %>"
                            alt="<%= animal.name %>"
                            loading="lazy"
                        >

                    </span>


                    <span class="asset-bar-item-details">

                        <span class="asset-bar-item-name">
                            <%= animal.name %>
                        </span>


                        <span class="asset-bar-item-code">
                            Animal #<%= animal.code %>
                        </span>


                        <% if (animal.type) { %>

                            <span class="asset-bar-item-meta">
                                <%= animal.type %>
                            </span>

                        <% } %>


                        <% if (animal.gender) { %>

                            <span class="asset-bar-item-meta">
                                <%= animal.gender %>
                            </span>

                        <% } %>

                    </span>


                    <span
                        class="asset-bar-item-arrow"
                        aria-hidden="true"
                    >
                        ›
                    </span>


                </a>


            <% }); %>


        <% } else { %>


            <div class="asset-bar-empty">

                <span
                    class="asset-bar-empty-icon"
                    aria-hidden="true"
                >
                    —
                </span>

                <span>
                    No animals found for this dairy farm.
                </span>

            </div>


        <% } %>


    </div>

</section>


<!-- =================================================
     STRUCTURES / MACHINES / TOOLS
================================================== -->

<section
    id="assetStructures"
    class="asset-bar-section"
    data-asset-section="structures"
    role="tabpanel"
    aria-labelledby="assetStructuresTab"
    hidden
>


    <div class="asset-bar-section-header">

        <div>

            <span class="asset-bar-section-label">
                FARM PROPERTY
            </span>

            <h3>
                Structures &amp; Equipment
            </h3>

        </div>


        <span class="asset-bar-count">
            <%= structureDairies.length %>
        </span>

    </div>


    <div class="asset-bar-list">


        <% if (structureDairies.length) { %>


            <% structureDairies.forEach(asset => { %>


                <a
                    href="/dairy/<%= asset._id %>"
                    class="asset-bar-item asset-bar-structure"
                    data-asset-id="<%= asset._id %>"
                    data-asset-parent-code="<%= asset.assetCode || '' %>"
                    data-asset-type="structure"
                >


                    <span class="asset-bar-item-image">

                        <img
                            src="<%= asset.displayImage %>"
                            alt="<%= asset.name %>"
                            loading="lazy"
                        >

                    </span>


                    <span class="asset-bar-item-details">

                        <span class="asset-bar-item-name">
                            <%= asset.name %>
                        </span>


                        <% if (asset.type) { %>

                            <span class="asset-bar-item-meta">
                                <%= asset.type %>
                            </span>

                        <% } %>


                        <% if (asset.location) { %>

                            <span class="asset-bar-item-meta">
                                <%= asset.location %>
                            </span>

                        <% } %>

                    </span>


                    <span
                        class="asset-bar-item-arrow"
                        aria-hidden="true"
                    >
                        ›
                    </span>


                </a>


            <% }); %>


        <% } else { %>


            <div class="asset-bar-empty">

                <span
                    class="asset-bar-empty-icon"
                    aria-hidden="true"
                >
                    —
                </span>

                <span>
                    No structures, machines or tools
                    found for this dairy farm.
                </span>

            </div>


        <% } %>


    </div>

</section>

</div>

</aside>


<!-- =========================================================
     ASSET BAR JAVASCRIPT
========================================================= -->

<script>

document.addEventListener(
    "DOMContentLoaded",
    function() {


        /* =================================================
           ELEMENTS
        ================================================= */

        const assetBar =
            document.getElementById(
                "assetBar"
            );


        const overlay =
            document.getElementById(
                "assetBarOverlay"
            );


        const openButton =
            document.getElementById(
                "viewPropertyButton"
            );


        const closeButton =
            document.getElementById(
                "closeAssetBar"
            );


        const tabs =
            document.querySelectorAll(
                ".asset-bar-tab"
            );


        const sections =
            document.querySelectorAll(
                ".asset-bar-section"
            );


        /* =================================================
           FARM SWITCHER ELEMENTS
        ================================================= */

        const farmSwitchButton =
            document.getElementById(
                "farmSwitchButton"
            );


        const assignedFarmList =
            document.getElementById(
                "assignedFarmList"
            );


        /* =================================================
           SAFETY CHECK
        ================================================= */

        if (!assetBar) {

            console.warn(
                "Asset Bar: #assetBar was not found."
            );

            return;

        }


        if (!openButton) {

            console.warn(
                "Asset Bar: #viewPropertyButton was not found."
            );

            return;

        }


        /* =================================================
           FARM SWITCHER
        ================================================= */

        if (
            farmSwitchButton &&
            assignedFarmList
        ) {

            farmSwitchButton.addEventListener(
                "click",
                function(event) {

                    event.preventDefault();

                    const isOpen =
                        !assignedFarmList.hidden;


                    assignedFarmList.hidden =
                        isOpen;


                    farmSwitchButton.setAttribute(
                        "aria-expanded",
                        String(!isOpen)
                    );

                }
            );

        }


        /* =================================================
           CATEGORY SWITCHING
        ================================================= */

        function setCategory(category) {

            if (!category) {

                return;

            }


            tabs.forEach(
                function(tab) {

                    const isActive =
                        tab.dataset.assetCategory ===
                        category;


                    tab.classList.toggle(
                        "active",
                        isActive
                    );


                    tab.setAttribute(
                        "aria-selected",
                        String(isActive)
                    );

                }
            );


            sections.forEach(
                function(section) {

                    const isActive =
                        section.dataset.assetSection ===
                        category;


                    section.classList.toggle(
                        "active",
                        isActive
                    );


                    section.hidden =
                        !isActive;

                }
            );

        }


        /* =================================================
           DEFAULT CATEGORY
        ================================================= */

        function resetCategory() {

            setCategory(
                "animals"
            );

        }


        /* =================================================
           OPEN SIDEBAR
        ================================================= */

        function openAssetBar() {

            resetCategory();


            if (
                assignedFarmList
            ) {

                assignedFarmList.hidden =
                    true;

            }


            if (
                farmSwitchButton
            ) {

                farmSwitchButton.setAttribute(
                    "aria-expanded",
                    "false"
                );

            }


            assetBar.classList.add(
                "active"
            );


            if (overlay) {

                overlay.classList.add(
                    "active"
                );

            }


            assetBar.setAttribute(
                "aria-hidden",
                "false"
            );


            openButton.setAttribute(
                "aria-expanded",
                "true"
            );


            if (overlay) {

                overlay.setAttribute(
                    "aria-hidden",
                    "false"
                );

            }


            document.body.classList.add(
                "asset-bar-open"
            );


            if (closeButton) {

                setTimeout(
                    function() {

                        closeButton.focus();

                    },
                    50
                );

            }

        }


        /* =================================================
           CLOSE SIDEBAR
        ================================================= */

        function closeAssetBar() {

            assetBar.classList.remove(
                "active"
            );


            if (overlay) {

                overlay.classList.remove(
                    "active"
                );

            }


            assetBar.setAttribute(
                "aria-hidden",
                "true"
            );


            openButton.setAttribute(
                "aria-expanded",
                "false"
            );


            if (overlay) {

                overlay.setAttribute(
                    "aria-hidden",
                    "true"
                );

            }


            document.body.classList.remove(
                "asset-bar-open"
            );


            if (openButton) {

                openButton.focus();

            }

        }


        /* =================================================
           VIEW ASSETS BUTTON
        ================================================= */

        openButton.addEventListener(
            "click",
            function(event) {

                event.preventDefault();


                if (
                    assetBar.classList.contains(
                        "active"
                    )
                ) {

                    closeAssetBar();

                } else {

                    openAssetBar();

                }

            }
        );


        /* =================================================
           CLOSE BUTTON
        ================================================= */

        if (closeButton) {

            closeButton.addEventListener(
                "click",
                function(event) {

                    event.preventDefault();

                    closeAssetBar();

                }
            );

        }


        /* =================================================
           OVERLAY CLICK
        ================================================= */

        if (overlay) {

            overlay.addEventListener(
                "click",
                function() {

                    closeAssetBar();

                }
            );

        }


        /* =================================================
           ESCAPE KEY
        ================================================= */

        document.addEventListener(
            "keydown",
            function(event) {

                if (
                    event.key === "Escape" &&
                    assetBar.classList.contains(
                        "active"
                    )
                ) {

                    closeAssetBar();

                }

            }
        );


        /* =================================================
           CATEGORY TAB CLICK
        ================================================= */

        tabs.forEach(
            function(tab) {

                tab.addEventListener(
                    "click",
                    function(event) {

                        event.preventDefault();


                        const category =
                            tab.dataset.assetCategory;


                        setCategory(
                            category
                        );

                    }
                );

            }
        );


        /* =================================================
           INITIAL STATE
        ================================================= */

        assetBar.classList.remove(
            "active"
        );


        if (overlay) {

            overlay.classList.remove(
                "active"
            );

        }


        assetBar.setAttribute(
            "aria-hidden",
            "true"
        );


        if (overlay) {

            overlay.setAttribute(
                "aria-hidden",
                "true"
            );

        }


        openButton.setAttribute(
            "aria-expanded",
            "false"
        );


        document.body.classList.remove(
            "asset-bar-open"
        );

    }

);

</script>


<!-- =========================================================
     ASSET BAR STYLES
========================================================= -->

<style>

/* =========================================================
   ASSET BAR OVERLAY
========================================================= */

.asset-bar-overlay{

    position:fixed;

    top:120px;

    left:0;

    right:0;

    bottom:50px;

    background:rgba(0,0,0,.38);

    opacity:0;

    visibility:hidden;

    pointer-events:none;

    transition:
        opacity .25s ease,
        visibility .25s ease;

    z-index:1003;

}


.asset-bar-overlay.active{

    opacity:1;

    visibility:visible;

    pointer-events:auto;

}


/* =========================================================
   ASSET SIDEBAR
========================================================= */

.asset-bar{

    position:fixed;

    top:120px;

    right:0;

    bottom:50px;

    width:380px;

    max-width:calc(100vw - 20px);

    background:#fff;

    box-shadow:
        -6px 0 24px rgba(0,0,0,.18);

    transform:translateX(100%);

    visibility:hidden;

    pointer-events:none;

    transition:
        transform .28s ease,
        visibility .28s ease;

    z-index:1004;

    display:flex;

    flex-direction:column;

    overflow:hidden;

}


.asset-bar.active{

    transform:translateX(0);

    visibility:visible;

    pointer-events:auto;

}


/* =========================================================
   SIDEBAR TOP
========================================================= */

.asset-bar-top{

    flex-shrink:0;

    display:flex;

    align-items:center;

    justify-content:space-between;

    gap:12px;

    padding:16px 16px 13px;

    border-bottom:1px solid #e8ece9;

}


.asset-bar-heading{

    min-width:0;

}


.asset-bar-heading-label{

    display:block;

    font-size:10px;

    font-weight:700;

    letter-spacing:1.3px;

    color:#0b5d1e;

    margin-bottom:3px;

}


.asset-bar-heading h2{

    margin:0;

    font-size:21px;

    line-height:1.2;

    color:#18301f;

}


/* =========================================================
   CLOSE BUTTON
========================================================= */

.asset-bar-close{

    flex:0 0 38px;

    width:38px;

    height:38px;

    border:none;

    border-radius:50%;

    background:#f0f3f1;

    color:#17351f;

    display:flex;

    align-items:center;

    justify-content:center;

    cursor:pointer;

    font-size:27px;

    line-height:1;

    transition:
        background .2s ease,
        color .2s ease,
        transform .2s ease;

}


.asset-bar-close:hover{

    background:#0b5d1e;

    color:#fff;

    transform:rotate(90deg);

}


/* =========================================================
   FARM INFORMATION
========================================================= */

.asset-bar-farm{

    flex-shrink:0;

    padding:11px 16px;

    background:#f4f8f5;

    border-bottom:1px solid #e4ebe6;

}


/* =========================================================
   CURRENT FARM
========================================================= */

.asset-bar-current-farm{

    min-width:0;

}


.asset-bar-farm-label{

    display:block;

    font-size:9px;

    font-weight:700;

    letter-spacing:1.2px;

    color:#6b756e;

}


.asset-bar-farm-name{

    display:block;

    margin-top:2px;

    font-size:14px;

    font-weight:700;

    color:#17351f;

    white-space:nowrap;

    overflow:hidden;

    text-overflow:ellipsis;

}


.asset-bar-farm-code{

    display:block;

    margin-top:2px;

    font-size:11px;

    color:#6b756e;

}


/* =========================================================
   FARM SWITCHER
========================================================= */

.asset-bar-farm-switcher{

    position:relative;

    margin-top:9px;

}


/* =========================================================
   SWITCH BUTTON
========================================================= */

.farm-switch-button{

    width:100%;

    min-height:36px;

    padding:7px 10px;

    border:1px solid #cfdad2;

    border-radius:8px;

    background:#fff;

    color:#0b5d1e;

    display:flex;

    align-items:center;

    justify-content:center;

    gap:7px;

    cursor:pointer;

    font-size:11px;

    font-weight:700;

    transition:
        background .2s ease,
        border-color .2s ease,
        color .2s ease;

}


.farm-switch-button:hover{

    background:#0b5d1e;

    border-color:#0b5d1e;

    color:#fff;

}


.farm-switch-icon{

    font-size:18px;

    line-height:1;

}


.farm-switch-text{

    letter-spacing:.2px;

}


/* =========================================================
   ASSIGNED FARM LIST
========================================================= */

.assigned-farm-list{

    margin-top:7px;

    padding:8px;

    border:1px solid #dfe7e1;

    border-radius:9px;

    background:#fff;

    box-shadow:
        0 6px 18px rgba(0,0,0,.08);

}


.assigned-farm-list[hidden]{

    display:none;

}


.assigned-farm-list-header{

    padding:4px 6px 7px;

    font-size:9px;

    font-weight:700;

    letter-spacing:1px;

    color:#778079;

}


.assigned-farm-options{

    display:flex;

    flex-direction:column;

    gap:5px;

}


.assigned-farm-option{

    display:flex;

    align-items:center;

    gap:8px;

    width:100%;

    min-width:0;

    padding:8px;

    box-sizing:border-box;

    border:1px solid transparent;

    border-radius:7px;

    background:#f8faf9;

    color:#17351f;

    text-decoration:none;

    transition:
        background .2s ease,
        border-color .2s ease;

}


.assigned-farm-option:hover{

    background:#eef6f0;

    border-color:#c6d8ca;

}


.assigned-farm-option.current{

    background:#e9f7ef;

    border-color:#bcd5c2;

}


/* =========================================================
   FARM OPTION ICON
========================================================= */

.assigned-farm-option-icon{

    flex:0 0 27px;

    width:27px;

    height:27px;

    border-radius:50%;

    background:#e3ebe5;

    color:#0b5d1e;

    display:flex;

    align-items:center;

    justify-content:center;

    font-size:13px;

    font-weight:700;

}


.assigned-farm-option.current
.assigned-farm-option-icon{

    background:#0b5d1e;

    color:#fff;

}


/* =========================================================
   FARM OPTION DETAILS
========================================================= */

.assigned-farm-option-details{

    min-width:0;

    flex:1;

    display:flex;

    flex-direction:column;

    gap:2px;

