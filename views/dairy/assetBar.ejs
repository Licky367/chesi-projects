<% /* =========================================================
     ASSET BAR

     FILE:
     views/dairy/assetBar.ejs

     PURPOSE:
     ----------------------------------------------------------
     Display properties belonging ONLY to the currently
     viewed Dairy Farm.

     IMPORTANT:
     ----------------------------------------------------------
     The View Assets button belongs to the parent page.

     Parent button:

         #viewPropertyButton

     This partial contains ONLY:

         • Overlay
         • Right-side asset drawer
         • Asset category switcher
         • Animals
         • Structures / Machines / Tools
         • Asset Bar JavaScript

     The drawer intentionally DOES NOT contain:

         • Main page header
         • Main page footer
         • View Assets button
         • Separate sidebar header
         • Separate sidebar footer

     CLASSIFICATION:

     code > 0
         = Animal

     code === null / undefined
         = Structure / Machine / Tool
========================================================= */ %>


<%
/* =========================================================
   PREPARE ASSET DATA
========================================================= */

const availableAssets =
    Array.isArray(assetDairies)
        ? assetDairies.filter(asset => !!asset)
        : [];


/* =========================================================
   ANIMALS

   code > 0
========================================================= */

const animalDairies =
    availableAssets.filter(asset => {

        return (
            asset.code !== null &&
            asset.code !== undefined &&
            Number(asset.code) > 0
        );

    });


/* =========================================================
   STRUCTURES / MACHINES / TOOLS

   code === null / undefined
========================================================= */

const structureDairies =
    availableAssets.filter(asset => {

        return (
            asset.code === null ||
            asset.code === undefined
        );

    });

%>


<!-- =========================================================
     ASSET DRAWER OVERLAY

     Hidden by default.

     It only becomes visible when the View Assets button
     is clicked.
========================================================= -->

<div
    id="assetBarOverlay"
    class="asset-bar-overlay"
    aria-hidden="true"
></div>


<!-- =========================================================
     ASSET DRAWER
     
     This drawer is positioned BETWEEN the main page
     header and footer.

     It does NOT cover the header or footer.
========================================================= -->

<aside
    id="assetBar"
    class="asset-bar"
    aria-label="Farm Assets"
    aria-hidden="true"
>


    <!-- =====================================================
         CATEGORY SWITCHER

         This is intentionally the FIRST element inside
         the drawer.

         There is no separate sidebar header.
    ====================================================== -->

    <div
        class="asset-bar-tabs"
        role="tablist"
        aria-label="Asset categories"
    >


        <!-- =================================================
             ANIMALS
        ================================================== -->

        <button
            type="button"
            id="assetAnimalsTab"
            class="asset-bar-tab active"
            data-asset-category="animals"
            role="tab"
            aria-selected="true"
            aria-controls="assetAnimals"
        >

            <span class="asset-bar-tab-title">
                Animals
            </span>

        </button>


        <!-- =================================================
             STRUCTURES
        ================================================== -->

        <button
            type="button"
            id="assetStructuresTab"
            class="asset-bar-tab"
            data-asset-category="structures"
            role="tab"
            aria-selected="false"
            aria-controls="assetStructures"
        >

            <span class="asset-bar-tab-title">
                Structures
            </span>

            <span class="asset-bar-tab-subtitle">
                Machines &amp; Tools
            </span>

        </button>


    </div>


    <!-- =====================================================
         DRAWER CONTENT
    ====================================================== -->

    <div class="asset-bar-content">


        <!-- =================================================
             ANIMALS
        ================================================== -->

        <section
            id="assetAnimals"
            class="asset-bar-section active"
            data-asset-section="animals"
            role="tabpanel"
            aria-labelledby="assetAnimalsTab"
        >


            <!-- =================================================
                 ANIMAL SECTION HEADER
            ================================================== -->

            <div class="asset-bar-section-header">


                <div>

                    <span class="asset-bar-section-label">
                        LIVESTOCK
                    </span>

                    <h3>
                        Animals
                    </h3>

                </div>


                <span class="asset-bar-count">
                    <%= animalDairies.length %>
                </span>


            </div>


            <!-- =================================================
                 ANIMAL LIST
            ================================================== -->

            <div class="asset-bar-list">


                <% if (animalDairies.length) { %>


                    <% animalDairies.forEach(animal => { %>


                        <button
                            type="button"
                            class="asset-bar-item asset-bar-animal"

                            data-asset-id="<%= animal._id %>"

                            data-asset-code="<%= animal.code %>"

                            data-asset-parent-code="<%= animal.assetCode || '' %>"

                            data-asset-type="animal"
                        >


                            <!-- =================================
                                 IMAGE
                            ================================== -->

                            <span
                                class="asset-bar-item-image"
                            >

                                <img
                                    src="<%= animal.displayImage %>"
                                    alt="<%= animal.name %>"
                                    loading="lazy"
                                >

                            </span>


                            <!-- =================================
                                 INFORMATION
                            ================================== -->

                            <span
                                class="asset-bar-item-details"
                            >


                                <span
                                    class="asset-bar-item-name"
                                >
                                    <%= animal.name %>
                                </span>


                                <span
                                    class="asset-bar-item-code"
                                >
                                    Animal #<%= animal.code %>
                                </span>


                                <% if (animal.type) { %>

                                    <span
                                        class="asset-bar-item-meta"
                                    >
                                        <%= animal.type %>
                                    </span>

                                <% } %>


                                <% if (animal.gender) { %>

                                    <span
                                        class="asset-bar-item-meta"
                                    >
                                        <%= animal.gender %>
                                    </span>

                                <% } %>


                            </span>


                            <!-- =================================
                                 ARROW
                            ================================== -->

                            <span
                                class="asset-bar-item-arrow"
                                aria-hidden="true"
                            >
                                ›
                            </span>


                        </button>


                    <% }); %>


                <% } else { %>


                    <div class="asset-bar-empty">


                        <span
                            class="asset-bar-empty-icon"
                            aria-hidden="true"
                        >
                            —
                        </span>


                        <span>
                            No animals found for this dairy farm.
                        </span>


                    </div>


                <% } %>


            </div>


        </section>


        <!-- =================================================
             STRUCTURES / MACHINES / TOOLS
        ================================================== -->

        <section
            id="assetStructures"
            class="asset-bar-section"
            data-asset-section="structures"
            role="tabpanel"
            aria-labelledby="assetStructuresTab"
            hidden
        >


            <!-- =================================================
                 STRUCTURE SECTION HEADER
            ================================================== -->

            <div class="asset-bar-section-header">


                <div>

                    <span class="asset-bar-section-label">
                        FARM PROPERTY
                    </span>

                    <h3>
                        Structures &amp; Equipment
                    </h3>

                </div>


                <span class="asset-bar-count">
                    <%= structureDairies.length %>
                </span>


            </div>


            <!-- =================================================
                 STRUCTURE LIST
            ================================================== -->

            <div class="asset-bar-list">


                <% if (structureDairies.length) { %>


                    <% structureDairies.forEach(asset => { %>


                        <button
                            type="button"
                            class="asset-bar-item asset-bar-structure"

                            data-asset-id="<%= asset._id %>"

                            data-asset-parent-code="<%= asset.assetCode || '' %>"

                            data-asset-type="structure"
                        >


                            <!-- =================================
                                 IMAGE
                            ================================== -->

                            <span
                                class="asset-bar-item-image"
                            >

                                <img
                                    src="<%= asset.displayImage %>"
                                    alt="<%= asset.name %>"
                                    loading="lazy"
                                >

                            </span>


                            <!-- =================================
                                 INFORMATION
                            ================================== -->

                            <span
                                class="asset-bar-item-details"
                            >


                                <span
                                    class="asset-bar-item-name"
                                >
                                    <%= asset.name %>
                                </span>


                                <% if (asset.type) { %>

                                    <span
                                        class="asset-bar-item-meta"
                                    >
                                        <%= asset.type %>
                                    </span>

                                <% } %>


                                <% if (asset.location) { %>

                                    <span
                                        class="asset-bar-item-meta"
                                    >
                                        <%= asset.location %>
                                    </span>

                                <% } %>


                            </span>


                            <!-- =================================
                                 ARROW
                            ================================== -->

                            <span
                                class="asset-bar-item-arrow"
                                aria-hidden="true"
                            >
                                ›
                            </span>


                        </button>


                    <% }); %>


                <% } else { %>


                    <div class="asset-bar-empty">


                        <span
                            class="asset-bar-empty-icon"
                            aria-hidden="true"
                        >
                            —
                        </span>


                        <span>
                            No structures, machines or tools
                            found for this dairy farm.
                        </span>


                    </div>


                <% } %>


            </div>


        </section>


    </div>


</aside>


<!-- =========================================================
     ASSET BAR JAVASCRIPT

     Parent page provides:

         #viewPropertyButton

     This controls:

         • Opening
         • Closing
         • Overlay
         • Escape key
         • Category switching
         • Accessibility state

     No separate assetBar.js is required.
========================================================= -->

<script>

document.addEventListener(
    "DOMContentLoaded",
    function() {


        /* =================================================
           ELEMENTS
        ================================================= */

        const assetBar =
            document.getElementById(
                "assetBar"
            );


        const overlay =
            document.getElementById(
                "assetBarOverlay"
            );


        const openButton =
            document.getElementById(
                "viewPropertyButton"
            );


        const tabs =
            document.querySelectorAll(
                ".asset-bar-tab"
            );


        const sections =
            document.querySelectorAll(
                ".asset-bar-section"
            );


        const propertyItems =
            document.querySelectorAll(
                ".asset-bar-item"
            );


        /* =================================================
           SAFETY CHECK
        ================================================= */

        if (!assetBar) {

            console.warn(
                "Asset Bar: #assetBar was not found."
            );

            return;

        }


        if (!openButton) {

            console.warn(
                "Asset Bar: #viewPropertyButton was not found."
            );

            return;

        }


        /* =================================================
           CATEGORY SWITCHING
        ================================================= */

        function setCategory(category) {


            if (!category) {

                return;

            }


            tabs.forEach(
                function(tab) {


                    const isActive =
                        tab.dataset.assetCategory ===
                        category;


                    tab.classList.toggle(
                        "active",
                        isActive
                    );


                    tab.setAttribute(
                        "aria-selected",
                        String(isActive)
                    );


                }
            );


            sections.forEach(
                function(section) {


                    const isActive =
                        section.dataset.assetSection ===
                        category;


                    section.classList.toggle(
                        "active",
                        isActive
                    );


                    section.hidden =
                        !isActive;


                }
            );


        }


        /* =================================================
           OPEN ASSET BAR
        ================================================= */

        function openAssetBar() {


            /*
             * Always begin with Animals.
             */

            setCategory(
                "animals"
            );


            /*
             * Activate drawer.
             */

            assetBar.classList.add(
                "active"
            );


            /*
             * Activate overlay.
             */

            if (overlay) {

                overlay.classList.add(
                    "active"
                );

            }


            /*
             * Accessibility.
             */

            assetBar.setAttribute(
                "aria-hidden",
                "false"
            );


            openButton.setAttribute(
                "aria-expanded",
                "true"
            );


            if (overlay) {

                overlay.setAttribute(
                    "aria-hidden",
                    "false"
                );

            }


            /*
             * Prevent background scrolling.
             */

            document.body.classList.add(
                "asset-bar-open"
            );


        }


        /* =================================================
           CLOSE ASSET BAR
        ================================================= */

        function closeAssetBar() {


            assetBar.classList.remove(
                "active"
            );


            if (overlay) {

                overlay.classList.remove(
                    "active"
                );

            }


            assetBar.setAttribute(
                "aria-hidden",
                "true"
            );


            openButton.setAttribute(
                "aria-expanded",
                "false"
            );


            if (overlay) {

                overlay.setAttribute(
                    "aria-hidden",
                    "true"
                );

            }


            document.body.classList.remove(
                "asset-bar-open"
            );


            /*
             * Return focus to the View Assets button.
             */

            openButton.focus();


        }


        /* =================================================
           OPEN BUTTON
        ================================================= */

        openButton.addEventListener(
            "click",
            function(event) {


                event.preventDefault();


                openAssetBar();


            }
        );


        /* =================================================
           OVERLAY CLICK
        ================================================= */

        if (overlay) {

            overlay.addEventListener(
                "click",
                function() {


                    closeAssetBar();


                }
            );

        }


        /* =================================================
           ESCAPE KEY
        ================================================= */

        document.addEventListener(
            "keydown",
            function(event) {


                if (
                    event.key === "Escape" &&
                    assetBar.classList.contains(
                        "active"
                    )
                ) {


                    closeAssetBar();


                }


            }
        );


        /* =================================================
           CATEGORY SWITCHING
        ================================================= */

        tabs.forEach(
            function(tab) {


                tab.addEventListener(
                    "click",
                    function(event) {


                        event.preventDefault();


                        setCategory(
                            tab.dataset.assetCategory
                        );


                    }
                );


            }
        );


        /* =================================================
           PROPERTY ITEM HANDLING
           
           Navigation is intentionally not implemented yet.
        ================================================= */

        propertyItems.forEach(
            function(item) {


                item.addEventListener(
                    "click",
                    function() {


                        assetBar.dataset.selectedId =
                            item.dataset.assetId || "";


                        assetBar.dataset.selectedCode =
                            item.dataset.assetCode || "";


                        assetBar.dataset.selectedType =
                            item.dataset.assetType || "";


                        assetBar.dataset.selectedParentCode =
                            item.dataset.assetParentCode || "";


                    }
                );


            }
        );


    }

);

</script>