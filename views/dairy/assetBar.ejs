<% /* =========================================================
   ASSET BAR
   FILE:
   views/dairy/assetBar.ejs

   ALL ASSETS USE THE SAME DETAIL ROUTE:

       /dairy/<%= dairy._id %>

   This applies to:
       • Animals
       • Structures
       • Machines
       • Tools

   No separate asset route is used.
========================================================= */ %>


<% /* =========================================================
   PREPARE ASSET DATA
========================================================= */ %>

<%
const availableAssets =
    Array.isArray(assetDairies)
        ? assetDairies.filter(asset => !!asset)
        : [];

const animalDairies =
    availableAssets.filter(asset => {

        return (
            asset.code !== null &&
            asset.code !== undefined &&
            Number(asset.code) > 0
        );

    });

const structureDairies =
    availableAssets.filter(asset => {

        return (
            asset.code === null ||
            asset.code === undefined
        );

    });
%>


<!-- =========================================================
     OVERLAY
========================================================= -->

<div
    id="assetBarOverlay"
    class="asset-bar-overlay"
    aria-hidden="true"
></div>


<!-- =========================================================
     ASSET SIDEBAR
========================================================= -->

<aside
    id="assetBar"
    class="asset-bar"
    aria-label="Farm Assets"
    aria-hidden="true"
>


    <!-- =====================================================
         CATEGORY TABS
    ====================================================== -->

    <div
        class="asset-bar-tabs"
        role="tablist"
        aria-label="Asset categories"
    >

        <button
            type="button"
            id="assetAnimalsTab"
            class="asset-bar-tab active"
            data-asset-category="animals"
            role="tab"
            aria-selected="true"
            aria-controls="assetAnimals"
        >

            <span class="asset-bar-tab-title">
                Animals
            </span>

            <span class="asset-bar-tab-count">
                <%= animalDairies.length %>
            </span>

        </button>


        <button
            type="button"
            id="assetStructuresTab"
            class="asset-bar-tab"
            data-asset-category="structures"
            role="tab"
            aria-selected="false"
            aria-controls="assetStructures"
        >

            <span class="asset-bar-tab-title">
                Structures
            </span>

            <span class="asset-bar-tab-subtitle">
                Machines &amp; Tools
            </span>

            <span class="asset-bar-tab-count">
                <%= structureDairies.length %>
            </span>

        </button>

    </div>


    <!-- =====================================================
         CURRENT FARM
    ====================================================== -->

    <% if (
        dairy &&
        dairy.code !== null &&
        dairy.code !== undefined &&
        Number(dairy.code) < 0
    ) { %>

        <div class="asset-bar-farm">

            <span class="asset-bar-farm-label">
                FARM
            </span>

            <span class="asset-bar-farm-name">
                <%= dairy.name %>
            </span>

            <span class="asset-bar-farm-code">
                Farm #<%= dairy.code %>
            </span>

        </div>

    <% } %>


    <!-- =====================================================
         CONTENT
    ====================================================== -->

    <div class="asset-bar-content">


        <!-- =================================================
             ANIMALS
        ================================================== -->

        <section
            id="assetAnimals"
            class="asset-bar-section active"
            data-asset-section="animals"
            role="tabpanel"
            aria-labelledby="assetAnimalsTab"
        >

            <div class="asset-bar-section-header">

                <div>

                    <span class="asset-bar-section-label">
                        LIVESTOCK
                    </span>

                    <h3>
                        Animals
                    </h3>

                </div>

                <span class="asset-bar-count">
                    <%= animalDairies.length %>
                </span>

            </div>


            <div class="asset-bar-list">

                <% if (animalDairies.length) { %>

                    <% animalDairies.forEach(dairy => { %>

                        <!-- =================================
                             ALL ASSETS USE:

                             /dairy/<%= dairy._id %>
                        ================================== -->

                        <a
                            href="/dairy/<%= dairy._id %>"
                            class="asset-bar-item asset-bar-animal"
                            data-asset-code="<%= dairy.code %>"
                            data-asset-parent-code="<%= dairy.assetCode || '' %>"
                            data-asset-type="animal"
                        >

                            <span class="asset-bar-item-image">

                                <img
                                    src="<%= dairy.displayImage %>"
                                    alt="<%= dairy.name %>"
                                    loading="lazy"
                                >

                            </span>


                            <span class="asset-bar-item-details">

                                <span class="asset-bar-item-name">
                                    <%= dairy.name %>
                                </span>

                                <span class="asset-bar-item-code">
                                    Animal #<%= dairy.code %>
                                </span>


                                <% if (dairy.type) { %>

                                    <span class="asset-bar-item-meta">
                                        <%= dairy.type %>
                                    </span>

                                <% } %>


                                <% if (dairy.gender) { %>

                                    <span class="asset-bar-item-meta">
                                        <%= dairy.gender %>
                                    </span>

                                <% } %>

                            </span>


                            <span
                                class="asset-bar-item-arrow"
                                aria-hidden="true"
                            >
                                ›
                            </span>

                        </a>

                    <% }); %>

                <% } else { %>

                    <div class="asset-bar-empty">

                        <span
                            class="asset-bar-empty-icon"
                            aria-hidden="true"
                        >
                            —
                        </span>

                        <span>
                            No animals found for this dairy farm.
                        </span>

                    </div>

                <% } %>

            </div>

        </section>


        <!-- =================================================
             STRUCTURES / MACHINES / TOOLS
        ================================================== -->

        <section
            id="assetStructures"
            class="asset-bar-section"
            data-asset-section="structures"
            role="tabpanel"
            aria-labelledby="assetStructuresTab"
            hidden
        >

            <div class="asset-bar-section-header">

                <div>

                    <span class="asset-bar-section-label">
                        FARM PROPERTY
                    </span>

                    <h3>
                        Structures &amp; Equipment
                    </h3>

                </div>

                <span class="asset-bar-count">
                    <%= structureDairies.length %>
                </span>

            </div>


            <div class="asset-bar-list">

                <% if (structureDairies.length) { %>

                    <% structureDairies.forEach(dairy => { %>

                        <!-- =================================
                             SAME ROUTE AS ANIMALS:

                             /dairy/<%= dairy._id %>
                        ================================== -->

                        <a
                            href="/dairy/<%= dairy._id %>"
                            class="asset-bar-item asset-bar-structure"
                            data-asset-parent-code="<%= dairy.assetCode || '' %>"
                            data-asset-type="structure"
                        >

                            <span class="asset-bar-item-image">

                                <img
                                    src="<%= dairy.displayImage %>"
                                    alt="<%= dairy.name %>"
                                    loading="lazy"
                                >

                            </span>


                            <span class="asset-bar-item-details">

                                <span class="asset-bar-item-name">
                                    <%= dairy.name %>
                                </span>


                                <% if (dairy.type) { %>

                                    <span class="asset-bar-item-meta">
                                        <%= dairy.type %>
                                    </span>

                                <% } %>


                                <% if (dairy.location) { %>

                                    <span class="asset-bar-item-meta">
                                        <%= dairy.location %>
                                    </span>

                                <% } %>

                            </span>


                            <span
                                class="asset-bar-item-arrow"
                                aria-hidden="true"
                            >
                                ›
                            </span>

                        </a>

                    <% }); %>

                <% } else { %>

                    <div class="asset-bar-empty">

                        <span
                            class="asset-bar-empty-icon"
                            aria-hidden="true"
                        >
                            —
                        </span>

                        <span>
                            No structures, machines or tools
                            found for this dairy farm.
                        </span>

                    </div>

                <% } %>

            </div>

        </section>

    </div>

</aside>


<!-- =========================================================
     JAVASCRIPT
========================================================= -->

<script>

document.addEventListener(
    "DOMContentLoaded",
    function() {

        const assetBar =
            document.getElementById(
                "assetBar"
            );

        const overlay =
            document.getElementById(
                "assetBarOverlay"
            );

        const openButton =
            document.getElementById(
                "viewPropertyButton"
            );

        const closeButton =
            document.getElementById(
                "closeAssetBar"
            );

        const tabs =
            document.querySelectorAll(
                ".asset-bar-tab"
            );

        const sections =
            document.querySelectorAll(
                ".asset-bar-section"
            );


        if (!assetBar) {

            console.warn(
                "Asset Bar: #assetBar was not found."
            );

            return;

        }


        if (!openButton) {

            console.warn(
                "Asset Bar: #viewPropertyButton was not found."
            );

            return;

        }


        /* =================================================
           CATEGORY SWITCHING
        ================================================= */

        function setCategory(category) {

            tabs.forEach(
                function(tab) {

                    const active =
                        tab.dataset.assetCategory ===
                        category;

                    tab.classList.toggle(
                        "active",
                        active
                    );

                    tab.setAttribute(
                        "aria-selected",
                        String(active)
                    );

                }
            );


            sections.forEach(
                function(section) {

                    const active =
                        section.dataset.assetSection ===
                        category;

                    section.classList.toggle(
                        "active",
                        active
                    );

                    section.hidden =
                        !active;

                }
            );

        }


        /* =================================================
           OPEN
        ================================================= */

        function openAssetBar() {

            setCategory("animals");

            assetBar.classList.add("active");

            if (overlay) {

                overlay.classList.add("active");

                overlay.setAttribute(
                    "aria-hidden",
                    "false"
                );

            }

            assetBar.setAttribute(
                "aria-hidden",
                "false"
            );

            openButton.setAttribute(
                "aria-expanded",
                "true"
            );

            document.body.classList.add(
                "asset-bar-open"
            );

        }


        /* =================================================
           CLOSE
        ================================================= */

        function closeAssetBar() {

            assetBar.classList.remove(
                "active"
            );

            if (overlay) {

                overlay.classList.remove(
                    "active"
                );

                overlay.setAttribute(
                    "aria-hidden",
                    "true"
                );

            }

            assetBar.setAttribute(
                "aria-hidden",
                "true"
            );

            openButton.setAttribute(
                "aria-expanded",
                "false"
            );

            document.body.classList.remove(
                "asset-bar-open"
            );

            openButton.focus();

        }


        /* =================================================
           OPEN BUTTON
        ================================================= */

        openButton.addEventListener(
            "click",
            function(event) {

                event.preventDefault();

                openAssetBar();

            }
        );


        /* =================================================
           CLOSE BUTTON

           If your CSS/parent page contains
           #closeAssetBar, this will close the bar.
        ================================================= */

        if (closeButton) {

            closeButton.addEventListener(
                "click",
                function(event) {

                    event.preventDefault();

                    closeAssetBar();

                }
            );

        }


        /* =================================================
           OVERLAY
        ================================================= */

        if (overlay) {

            overlay.addEventListener(
                "click",
                closeAssetBar
            );

        }


        /* =================================================
           ESCAPE
        ================================================= */

        document.addEventListener(
            "keydown",
            function(event) {

                if (
                    event.key === "Escape" &&
                    assetBar.classList.contains(
                        "active"
                    )
                ) {

                    closeAssetBar();

                }

            }
        );


        /* =================================================
           CATEGORY TABS
        ================================================= */

        tabs.forEach(
            function(tab) {

                tab.addEventListener(
                    "click",
                    function(event) {

                        event.preventDefault();

                        setCategory(
                            tab.dataset.assetCategory
                        );

                    }
                );

            }
        );

    }
);

</script>