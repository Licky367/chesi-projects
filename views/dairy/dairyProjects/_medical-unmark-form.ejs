<form
    id="unmarkForm-<%= dairy._id %>"
    action="/dairy/<%= dairy._id %>/medical-unmark"
    method="POST"
    class="inline-form"
>

    <input
        type="number"
        name="charges"
        min="0"
        step="0.01"
        placeholder="Charges (KES)"
        required
    >

    <textarea
        name="description"
        rows="3"
        maxlength="1000"
        placeholder="Treatment summary..."
        required
    ></textarea>

    <button
        type="submit"
        class="btn btn-danger"
    >
        Confirm Clearance
    </button>

</form>