<div class="action-buttons">

    <!-- =========================
         THREE-DOT MENU BUTTON
    ========================= -->

    <button
        type="button"
        class="medical-menu-toggle"
        onclick="toggleMedicalMenu('<%= dairy._id %>')"
        aria-label="Medical actions"
        aria-expanded="false"
    >
        ⋮
    </button>


    <!-- =========================
         MEDICAL ACTION MENU
    ========================= -->

    <div
        id="medicalMenu-<%= dairy._id %>"
        class="medical-action-menu"
    >

        <!-- =========================
             MARK MEDICAL
        ========================= -->

        <% if (
            user &&
            (
                user.role === "admin" ||
                user.role === "dairyWorker"
            ) &&
            (
                !dairy.medicalAttention ||
                !dairy.medicalAttention.isMarked
            )
        ) { %>

            <button
                type="button"
                class="medical-action-btn"
                onclick="toggleMarkForm('<%= dairy._id %>')"
            >
                Mark Medical
            </button>

            <%- include("./_medical-mark-form", { dairy }) %>

        <% } %>


        <!-- =========================
             UNMARK MEDICAL
        ========================= -->

        <% if (
            user &&
            user.role === "admin" &&
            dairy.medicalAttention &&
            dairy.medicalAttention.isMarked
        ) { %>

            <button
                type="button"
                class="medical-action-btn"
                onclick="toggleUnmarkForm('<%= dairy._id %>')"
            >
                Unmark Medical
            </button>

            <%- include("./_medical-unmark-form", { dairy }) %>

        <% } %>

    </div>

</div>