<!-- =====================================================
     UPDATE PAGE ASSETS
===================================================== -->

<link
    rel="stylesheet"
    href="/css/update/update.css"
>

<script
    src="/socket.io/socket.io.js"
></script>



<!-- =====================================================
     FIXED UPDATE NAVIGATION
===================================================== -->

<nav
    class="update-fixed-nav"
    aria-label="Dairy update navigation"
>


    <!-- =================================================
         VIEW UPDATES
    ================================================== -->

    <a
        href="/dairy/<%= dairy._id %>/general"
        class="update-nav-link"
        title="View Updates"
        aria-label="View Updates"
    >

        <span
            class="update-nav-icon"
            aria-hidden="true"
        >
            +
        </span>

    </a>



    <!-- =================================================
         VIEW ASSETS
    ================================================== -->

    <button
        type="button"
        id="viewPropertyButton"
        class="update-nav-link update-nav-button"
        aria-controls="assetBar"
        aria-expanded="false"
        title="View Assets"
        aria-label="View Assets"
    >

        <span
            class="update-nav-icon"
            aria-hidden="true"
        >
            ◉
        </span>

    </button>



    <!-- =================================================
         STORAGE
    ================================================== -->

    <a
        href="/storage/<%= dairy._id %>"
        class="update-nav-link"
        title="Storage"
        aria-label="Storage"
    >

        <span
            class="update-nav-icon"
            aria-hidden="true"
        >
            📦
        </span>

    </a>


</nav>



<!-- =====================================================
     UPDATE PAGE
===================================================== -->

<div class="dairy-page update-page-with-fixed-nav">


    <!-- =================================================
         FIXED H1
    ================================================== -->

    <%- include(
        "update/h1",
        {
            dairy: dairy,
            user: user
        }
    ) %>



    <!-- =================================================
         FIXED ASSET CARDS
    ================================================== -->

    <%- include(
        "update/asset-cards",
        {
            dairy: dairy,
            user: user,
            assetDairies: assetDairies || []
        }
    ) %>



    <!-- =================================================
         BOOLEAN MANAGEMENT

         FILE:
             views/update/boolean.ejs

         RENDERED EXACTLY ONCE.
    ================================================== -->

    <%- include(
        "update/boolean",
        {
            dairy: dairy,
            assetDairies: assetDairies || [],
            booleanFields: booleanFields || [],
            booleanAnimals: booleanAnimals || [],
            user: user
        }
    ) %>



    <!-- =================================================
         VIEW MILKING HISTORY
    ================================================== -->

    <%- include(
        "update/milk-history-cards.ejs",
        {
            dairy: dairy,
            user: user,
            assetDairies: assetDairies || []
        }
    ) %>



    <!-- =================================================
         ASSET SIDEBAR
    ================================================== -->

    <%- include(
        "dairy/assetBar",
        {
            dairy: dairy,
            assetDairies: assetDairies || []
        }
    ) %>


</div>



<!-- =====================================================
     FIXED NAVIGATION STYLES
===================================================== -->

<style>

    /* =====================================================
       FIXED TOP NAVIGATION
    ===================================================== */

    .update-fixed-nav {

        position: fixed;

        top: 0;
        left: 0;
        right: 0;

        height: 46px;

        display: flex;

        align-items: center;
        justify-content: center;

        gap: 6px;

        z-index: 9999;

        box-sizing: border-box;

        background: var(--background-color, #ffffff);

        border-bottom:
            1px solid
            var(--border-color, #e5e5e5);

        box-shadow:
            0 2px 8px
            rgba(0, 0, 0, 0.08);

    }



    /* =====================================================
       NAV LINKS
    ===================================================== */

    .update-nav-link {

        width: 42px;
        height: 40px;

        flex: 0 0 42px;

        display: flex;

        align-items: center;
        justify-content: center;

        padding: 0;
        margin: 0;

        border: 0;

        border-radius: 7px;

        background: transparent;

        color: inherit;

        text-decoration: none;

        cursor: pointer;

        box-sizing: border-box;

        -webkit-tap-highlight-color: transparent;

    }



    /* =====================================================
       NAV ICON
    ===================================================== */

    .update-nav-icon {

        display: flex;

        align-items: center;
        justify-content: center;

        width: 100%;
        height: 100%;

        font-size: 21px;

        line-height: 1;

        font-weight: 600;

    }



    /* =====================================================
       BUTTON RESET
    ===================================================== */

    .update-nav-button {

        font-family: inherit;

        appearance: none;
        -webkit-appearance: none;

    }



    /* =====================================================
       HOVER / ACTIVE
    ===================================================== */

    .update-nav-link:hover {

        background:
            rgba(0, 0, 0, 0.06);

    }


    .update-nav-link:active {

        transform: scale(0.94);

    }



    /* =====================================================
       PAGE OFFSET

       Prevents the fixed navigation from covering
       the beginning of the page.
    ===================================================== */

    .update-page-with-fixed-nav {

        padding-top: 46px;

    }



    /* =====================================================
       SMALL SCREENS
    ===================================================== */

    @media (max-width: 600px) {

        .update-fixed-nav {

            height: 44px;

            gap: 4px;

        }


        .update-nav-link {

            width: 40px;
            height: 38px;

            flex-basis: 40px;

        }


        .update-nav-icon {

            font-size: 19px;

        }


        .update-page-with-fixed-nav {

            padding-top: 44px;

        }

    }



    /* =====================================================
       VERY SMALL SCREENS
    ===================================================== */

    @media (max-width: 380px) {

        .update-fixed-nav {

            height: 42px;

        }


        .update-nav-link {

            width: 38px;
            height: 36px;

            flex-basis: 38px;

        }


        .update-nav-icon {

            font-size: 18px;

        }


        .update-page-with-fixed-nav {

            padding-top: 42px;

        }

    }

</style>



<!-- =====================================================
     UPDATE PAGE JAVASCRIPT
===================================================== -->

<script
    src="/js/update/index.js"
    defer
></script>