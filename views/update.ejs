<!-- =====================================================
     UPDATE PAGE

     FILE:
         views/update.ejs

     PURPOSE:
         Dairy update/feed page.

     FIXED TOP ORDER:
         1. Create Post
         2. H1

     FEED ITEMS:
         • Normal Posts
         • Weekly Milk Reports
         • Stock Updates
         • Medical Updates
         • Maintenance Updates
         • Asset Added Updates

     RECURRING FEED INSERTIONS:
         • Asset Cards
         • Create Post

     IMPORTANT:
         Feed items remain in chronological order.
===================================================== -->


<!-- =====================================================
     UPDATE PAGE ASSETS
===================================================== -->

<link
    rel="stylesheet"
    href="/css/update/update.css"
>

<script
    src="/socket.io/socket.io.js"
></script>



<!-- =====================================================
     UPDATE PAGE
===================================================== -->

<div class="dairy-page">


    <!-- =================================================
         TOP PAGE ACTIONS
    ================================================== -->

    <div
        class="dairy-page-actions"
        style="
            display:flex;
            align-items:center;
            justify-content:space-between;
            gap:10px;
            width:100%;
        "
    >


        <!-- =============================================
             TOP-LEFT ADD ASSETS
             
             ADMIN ONLY
        ============================================== -->

        <% if (
            user &&
            user.role === "admin"
        ) { %>

            <a
                href="/networth/structure/<%= dairy._id %>/add"
                class="asset-bar-trigger"
                style="
                    text-decoration:none;
                    display:inline-flex;
                    align-items:center;
                    justify-content:center;
                "
            >

                <span
                    class="asset-bar-trigger-icon"
                    aria-hidden="true"
                >
                    +
                </span>

                <span class="asset-bar-trigger-text">
                    Add Assets
                </span>

            </a>

        <% } else { %>

            <span
                aria-hidden="true"
            ></span>

        <% } %>



        <!-- =============================================
             TOP-RIGHT VIEW ASSETS
        ============================================== -->

        <button
            type="button"
            id="viewPropertyButton"
            class="asset-bar-trigger"
            aria-controls="assetBar"
            aria-expanded="false"
        >

            <span
                class="asset-bar-trigger-icon"
                aria-hidden="true"
            >
                ◉
            </span>

            <span class="asset-bar-trigger-text">
                View Assets
            </span>

        </button>

    </div>



    <!-- =================================================
         FIXED CREATE POST

         ALWAYS FIRST
    ================================================== -->

    <%- include("update/create-post", {
        dairy: dairy,
        user: user,
        assetDairies: assetDairies || []
    }) %>



    <!-- =================================================
         FIXED H1

         ALWAYS SECOND

         NEVER REPEATED
    ================================================== -->

    <%- include("update/h1", {
        dairy: dairy,
        user: user
    }) %>



    <!-- =================================================
         ASSET SIDEBAR

         Independent from feed cards.
    ================================================== -->

    <%- include("dairy/assetBar", {
        dairy: dairy,
        assetDairies: assetDairies || []
    }) %>



    <!-- =================================================
         FEED
    ================================================== -->

    <section
        id="feed"
        class="feed-container"
    >


        <%
            /*
             * =================================================
             * RECURRING INSERTION SETTINGS
             * =================================================
             *
             * These numbers refer to FEED ITEMS.
             *
             * Example:
             *
             *     after item 5
             *     after item 12
             *     after item 20
             *
             * The inserted component alternates:
             *
             *     Asset Cards
             *     Create Post
             *     Asset Cards
             *     Create Post
             *
             * =================================================
             */

            const insertionPattern = [
                5,
                12,
                20,
                28,
                37
            ];


            /*
             * =================================================
             * DETERMINE WHETHER ASSET CARDS EXIST
             * =================================================
             */

            const hasAssetCards =
                Array.isArray(assetDairies) &&
                assetDairies.length > 0;

        %>



        <!-- =================================================
             FEED ITEMS
        ================================================== -->

        <% if (
            Array.isArray(feed) &&
            feed.length > 0
        ) { %>


            <% feed.forEach(function (item, index) { %>


                <%
                    /*
                     * =================================================
                     * FEED POSITION
                     *
                     * Starts at 1 rather than 0.
                     * =================================================
                     */

                    const feedPosition =
                        index + 1;


                    /*
                     * =================================================
                     * CHECK RECURRING INSERTION
                     * =================================================
                     */

                    const shouldInsertHere =
                        insertionPattern.includes(
                            feedPosition
                        );


                    /*
                     * =================================================
                     * FIND INSERTION INDEX
                     *
                     * 0 = first insertion
                     * 1 = second insertion
                     * 2 = third insertion
                     * =================================================
                     */

                    const insertionNumber =
                        insertionPattern.indexOf(
                            feedPosition
                        );


                    /*
                     * =================================================
                     * DETERMINE INSERTED COMPONENT
                     *
                     * Even:
                     *
                     *     Asset Cards
                     *
                     * Odd:
                     *
                     *     Create Post
                     *
                     * If there are no assets, always use
                     * Create Post.
                     * =================================================
                     */

                    let insertAsset =
                        insertionNumber % 2 === 0;


                    if (!hasAssetCards) {

                        insertAsset = false;

                    }

                %}



                <!-- =================================================
                     NORMAL POST
                ================================================== -->

                <% if (item.type === "post") { %>

                    <%- include("update/post", {
                        item: item,
                        user: user
                    }) %>

                <% } %>



                <!-- =================================================
                     WEEKLY MILK REPORT
                ================================================== -->

                <% if (item.type === "milk") { %>

                    <%- include("update/milk", {
                        item: item,
                        user: user
                    }) %>

                <% } %>



                <!-- =================================================
                     STOCK UPDATE
                     
                     IMPORTANT:
                     This was previously missing.

                     feedsService creates:
                     
                         type: "stock"

                     pageService passes the update into feed.

                     This condition finally sends that item to:

                         views/update/stock.ejs
                ================================================== -->

                <% if (item.type === "stock") { %>

                    <%- include("update/stock", {
                        item: item,
                        user: user
                    }) %>

                <% } %>



                <!-- =================================================
                     MEDICAL — MARKED
                ================================================== -->

                <% if (
                    item.type === "medical" &&
                    item.status === "marked"
                ) { %>

                    <%- include("update/medical-marked", {
                        item: item,
                        user: user
                    }) %>

                <% } %>



                <!-- =================================================
                     MEDICAL — CLEARED
                ================================================== -->

                <% if (
                    item.type === "medical" &&
                    item.status === "cleared"
                ) { %>

                    <%- include("update/medical-cleared", {
                        item: item,
                        user: user
                    }) %>

                <% } %>



                <!-- =================================================
                     MAINTENANCE — MARKED
                ================================================== -->

                <% if (
                    item.type === "maintenance" &&
                    item.status === "marked"
                ) { %>

                    <%- include("update/maintenance-marked", {
                        item: item,
                        user: user
                    }) %>

                <% } %>



                <!-- =================================================
                     MAINTENANCE — CLEARED
                ================================================== -->

                <% if (
                    item.type === "maintenance" &&
                    item.status === "cleared"
                ) { %>

                    <%- include("update/maintenance-cleared", {
                        item: item,
                        user: user
                    }) %>

                <% } %>



                <!-- =================================================
                     ASSET ADDED
                ================================================== -->

                <% if (item.type === "assetAdd") { %>

                    <%- include("update/addAsset", {
                        item: item,
                        user: user
                    }) %>

                <% } %>



                <!-- =================================================
                     RECURRING INSERTION
                     
                     Happens AFTER the current feed item.
                ================================================== -->

                <% if (shouldInsertHere) { %>


                    <!-- =============================================
                         RECURRING ASSET CARDS
                    ============================================== -->

                    <% if (insertAsset) { %>

                        <%- include("update/asset-cards", {
                            dairy: dairy,
                            assetDairies: assetDairies || []
                        }) %>


                    <!-- =============================================
                         RECURRING CREATE POST
                    ============================================== -->

                    <% } else { %>

                        <%- include("update/create-post", {
                            dairy: dairy,
                            user: user,
                            assetDairies: assetDairies || []
                        }) %>

                    <% } %>


                <% } %>


            <% }); %>


        <% } else { %>


            <!-- =================================================
                 EMPTY FEED
            ================================================== -->

            <div
                class="feed-empty-state"
                style="
                    width:100%;
                    padding:30px 20px;
                    text-align:center;
                    color:#7b847e;
                "
            >

                <i
                    class="bi bi-journal-text"
                    aria-hidden="true"
                ></i>

                <p>
                    No updates have been recorded yet.
                </p>

            </div>


        <% } %>


    </section>


</div>



<!-- =====================================================
     UPDATE PAGE JAVASCRIPT
===================================================== -->

<script
    src="/js/update/index.js"
    defer
></script>