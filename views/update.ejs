<!-- =====================================================
     UPDATE PAGE ASSETS
===================================================== --><!-- =====================================================
     UPDATE PAGE CSS

     This remains the original Update page stylesheet.

     assetBar.css is imported from update.css.
===================================================== --><link
    rel="stylesheet"
    href="/css/update/update.css"
><!-- =====================================================
     SOCKET.IO

     REQUIRED BY THE ORIGINAL UPDATE PAGE.
===================================================== --><script
    src="/socket.io/socket.io.js"
></script><!-- =====================================================
     UPDATE PAGE
===================================================== --><div class="dairy-page"><!-- ===================================================
     PROFILE
==================================================== -->

<%- include("update/profile-card", {
    dairy: dairy,
    user: user
}) %>


<!-- ===================================================
     CREATE POST
==================================================== -->

<% if (user) { %>

    <%- include("update/create-post", {
        user: user
    }) %>

<% } %>


<!-- ===================================================
     ASSET BAR

     The sidebar receives:

     dairy
         = Current Dairy Farm

     assetDairies
         = Only assets belonging to this
           Dairy Farm.
==================================================== -->

<%- include("dairy/assetBar", {
    dairy: dairy,
    assetDairies: assetDairies || []
}) %>


<!-- ===================================================
     FEED
==================================================== -->

<%- include("update/feed", {
    feed: feed,
    user: user
}) %>

</div><!-- =====================================================
     UPDATE PAGE JAVASCRIPT
===================================================== --><!-- =====================================================
     ASSET BAR JAVASCRIPT

     Must load BEFORE update/index.js because
     update/index.js calls initializeAssetBar().
===================================================== --><script
    src="/js/update/assetBar.js"
    defer
></script><!-- =====================================================
     ORIGINAL UPDATE PAGE ENTRY POINT

     This remains responsible for:

       - Profile Update
       - Post Modal
       - Character Counter
       - Image Preview
       - Feed
       - Feed Images
       - Auto Resize
       - Socket
       - Asset Bar
===================================================== --><script
    src="/js/update/index.js"
    defer
></script>