<!-- =====================================================
     UPDATE PAGE

     FILE:
         views/update.ejs

     PURPOSE:
         Dairy update/feed page.

     FIXED TOP ORDER:
         1. Create Post
         2. H1

     FEED ITEMS:
         • Normal Posts
         • Weekly Milk Reports
         • Stock Updates
         • Medical Updates
         • Maintenance Updates
         • Asset Added Updates

     RECURRING FEED INSERTIONS:
         • Asset Cards
         • Create Post
===================================================== -->


<!-- =====================================================
     UPDATE PAGE ASSETS
===================================================== -->

<link
    rel="stylesheet"
    href="/css/update/update.css"
>

<script
    src="/socket.io/socket.io.js"
></script>



<!-- =====================================================
     UPDATE PAGE
===================================================== -->

<div class="dairy-page">


    <!-- =================================================
         TOP PAGE ACTIONS
    ================================================== -->

    <div
        class="dairy-page-actions"
        style="
            display:flex;
            align-items:center;
            justify-content:space-between;
            gap:10px;
            width:100%;
        "
    >


        <!-- =============================================
             ADD ASSETS
             
             ADMIN ONLY
        ============================================== -->

        <% if (user && user.role === "admin") { %>

            <a
                href="/networth/structure/<%= dairy._id %>/add"
                class="asset-bar-trigger"
                style="
                    text-decoration:none;
                    display:inline-flex;
                    align-items:center;
                    justify-content:center;
                "
            >

                <span
                    class="asset-bar-trigger-icon"
                    aria-hidden="true"
                >
                    +
                </span>

                <span class="asset-bar-trigger-text">
                    Add Assets
                </span>

            </a>

        <% } else { %>

            <span aria-hidden="true"></span>

        <% } %>



        <!-- =============================================
             VIEW ASSETS
        ============================================== -->

        <button
            type="button"
            id="viewPropertyButton"
            class="asset-bar-trigger"
            aria-controls="assetBar"
            aria-expanded="false"
        >

            <span
                class="asset-bar-trigger-icon"
                aria-hidden="true"
            >
                ◉
            </span>

            <span class="asset-bar-trigger-text">
                View Assets
            </span>

        </button>

    </div>



    <!-- =================================================
         FIXED CREATE POST

         ALWAYS FIRST
    ================================================== -->

    <%- include("update/create-post", {
        dairy: dairy,
        user: user,
        assetDairies: assetDairies || []
    }) %>



    <!-- =================================================
         FIXED H1

         ALWAYS SECOND
    ================================================== -->

    <%- include("update/h1", {
        dairy: dairy,
        user: user
    }) %>



    <!-- =================================================
         ASSET SIDEBAR
    ================================================== -->

    <%- include("dairy/assetBar", {
        dairy: dairy,
        assetDairies: assetDairies || []
    }) %>



    <!-- =================================================
         FEED
    ================================================== -->

    <section
        id="feed"
        class="feed-container"
    >


        <!-- =================================================
             FEED EXISTS
        ================================================== -->

        <% if (Array.isArray(feed) && feed.length > 0) { %>


            <%
                const insertionPattern = [
                    5,
                    12,
                    20,
                    28,
                    37
                ];

                const hasAssetCards =
                    Array.isArray(assetDairies) &&
                    assetDairies.length > 0;
            %>



            <!-- =================================================
                 LOOP THROUGH FEED
            ================================================== -->

            <% feed.forEach(function(item, index) { %>


                <%
                    const feedPosition =
                        index + 1;

                    const insertionNumber =
                        insertionPattern.indexOf(
                            feedPosition
                        );

                    const shouldInsertHere =
                        insertionNumber !== -1;

                    let insertAsset =
                        insertionNumber % 2 === 0;

                    if (!hasAssetCards) {
                        insertAsset = false;
                    }
                %>



                <!-- =============================================
                     NORMAL POST
                ============================================== -->

                <% if (item.type === "post") { %>

                    <%- include("update/post", {
                        item: item,
                        user: user
                    }) %>

                <% } %>



                <!-- =============================================
                     WEEKLY MILK REPORT
                ============================================== -->

                <% if (item.type === "milk") { %>

                    <%- include("update/milk", {
                        item: item,
                        user: user
                    }) %>

                <% } %>



                <!-- =============================================
                     STOCK UPDATE
                     
                     THIS IS THE IMPORTANT ADDITION.
                     
                     feedsService creates:
                         type: "stock"

                     This sends the item to:
                         views/update/stock.ejs
                ============================================== -->

                <% if (item.type === "stock") { %>

                    <%- include("update/stock", {
                        item: item,
                        user: user
                    }) %>

                <% } %>



                <!-- =============================================
                     MEDICAL — MARKED
                ============================================== -->

                <% if (
                    item.type === "medical" &&
                    item.status === "marked"
                ) { %>

                    <%- include("update/medical-marked", {
                        item: item,
                        user: user
                    }) %>

                <% } %>



                <!-- =============================================
                     MEDICAL — CLEARED
                ============================================== -->

                <% if (
                    item.type === "medical" &&
                    item.status === "cleared"
                ) { %>

                    <%- include("update/medical-cleared", {
                        item: item,
                        user: user
                    }) %>

                <% } %>



                <!-- =============================================
                     MAINTENANCE — MARKED
                ============================================== -->

                <% if (
                    item.type === "maintenance" &&
                    item.status === "marked"
                ) { %>

                    <%- include("update/maintenance-marked", {
                        item: item,
                        user: user
                    }) %>

                <% } %>



                <!-- =============================================
                     MAINTENANCE — CLEARED
                ============================================== -->

                <% if (
                    item.type === "maintenance" &&
                    item.status === "cleared"
                ) { %>

                    <%- include("update/maintenance-cleared", {
                        item: item,
                        user: user
                    }) %>

                <% } %>



                <!-- =============================================
                     ASSET ADDED
                ============================================== -->

                <% if (item.type === "assetAdd") { %>

                    <%- include("update/addAsset", {
                        item: item,
                        user: user
                    }) %>

                <% } %>



                <!-- =================================================
                     RECURRING INSERTION
                ================================================== -->

                <% if (shouldInsertHere) { %>


                    <!-- =============================================
                         ASSET CARDS
                    ============================================== -->

                    <% if (insertAsset) { %>

                        <%- include("update/asset-cards", {
                            dairy: dairy,
                            assetDairies: assetDairies || []
                        }) %>


                    <!-- =============================================
                         CREATE POST
                    ============================================== -->

                    <% } else { %>

                        <%- include("update/create-post", {
                            dairy: dairy,
                            user: user,
                            assetDairies: assetDairies || []
                        }) %>

                    <% } %>


                <% } %>


            <% }); %>


        <!-- =================================================
             EMPTY FEED
        ================================================== -->

        <% } else { %>


            <div
                class="feed-empty-state"
                style="
                    width:100%;
                    padding:30px 20px;
                    text-align:center;
                    color:#7b847e;
                "
            >

                <i
                    class="bi bi-journal-text"
                    aria-hidden="true"
                ></i>

                <p>
                    No updates have been recorded yet.
                </p>

            </div>


        <% } %>


    </section>


</div>



<!-- =====================================================
     UPDATE PAGE JAVASCRIPT
===================================================== -->

<script
    src="/js/update/index.js"
    defer
></script>