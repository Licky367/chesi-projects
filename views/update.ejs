<!-- ======================================================
     FEED ACTIONS
     LIKE + COMMENTS + DELETE
====================================================== -->

<div
    class="feed-actions"
    data-feed-id="<%= item._id %>"
    data-feed-type="<%= type || 'post' %>"
>

    <!-- ==================================================
         LIKE
    ================================================== -->

    <button
        class="like-btn"
        data-id="<%= item._id %>"
        data-type="<%= type || 'post' %>"
        type="button"
        aria-label="Like"
    >

        <i class="bi bi-hand-thumbs-up-fill"></i>

        <span class="like-count">
            <%= item.likes || 0 %>
        </span>

    </button>


    <!-- ==================================================
         COMMENTS
    ================================================== -->

    <button
        class="toggle-comments"
        type="button"
        aria-label="Comments"
    >

        <i class="bi bi-chat-dots-fill"></i>

        <span class="comment-count">
            <%= item.comments
                ? item.comments.length
                : 0 %>
        </span>

    </button>

</div>


<script>

/* =========================================================
   FEED ACTIONS
   SELF-CONTAINED FEED INTERACTIONS

   Handles:
   - Like
   - Open comments
   - Close comments
   - Save comments
   - Delete posts
   - Delete comments
========================================================= */


/* =========================================================
   LIKE
========================================================= */

async function handleFeedLike(button){

    if(!button){

        return;

    }


    const id =
        button.dataset.id;


    const type =
        button.dataset.type ||
        "post";


    if(!id){

        console.error(
            "FEED LIKE: Missing item ID."
        );

        return;

    }


    if(button.disabled){

        return;

    }


    button.disabled = true;


    try{

        const url =
            type === "post"
                ? `/post/${id}/like`
                : `/${type}/${id}/like`;


        const response =
            await fetch(
                url,
                {
                    method: "POST",

                    headers: {
                        "Accept":
                            "application/json"
                    }
                }
            );


        const result =
            await response.json();


        if(!response.ok){

            throw new Error(
                result.message ||
                `Request failed (${response.status})`
            );

        }


        if(!result.success){

            throw new Error(
                result.message ||
                "Unable to like."
            );

        }


        const count =
            button.querySelector(
                ".like-count"
            );


        if(count){

            count.textContent =
                result.likes ?? 0;

        }


        button.classList.toggle(
            "liked",
            result.liked === true
        );

    }
    catch(error){

        console.error(
            "FEED LIKE ERROR:",
            error
        );


        feedActionMessage(
            error.message ||
            "Unable to like."
        );

    }
    finally{

        button.disabled = false;

    }

}


/* =========================================================
   OPEN COMMENTS
========================================================= */

function handleFeedComments(button){

    if(!button){

        return;

    }


    const card =
        button.closest(
            ".feed-card"
        );


    if(!card){

        console.error(
            "FEED COMMENTS: Feed card not found."
        );

        return;

    }


    const modal =
        card.querySelector(
            ".comment-modal"
        );


    if(!modal){

        console.error(
            "FEED COMMENTS: Comment modal not found."
        );

        return;

    }


    modal.classList.add(
        "active"
    );


    document.body.style.overflow =
        "hidden";


    const textarea =
        modal.querySelector(
            ".comment-form textarea"
        );


    setTimeout(
        () => {

            textarea?.focus();

        },
        100
    );

}


/* =========================================================
   CLOSE COMMENT MODAL
========================================================= */

function closeFeedCommentModal(modal){

    if(!modal){

        return;

    }


    modal.classList.remove(
        "active"
    );


    document.body.style.overflow =
        "";

}


/* =========================================================
   SAVE COMMENT
========================================================= */

async function handleFeedCommentSubmit(
    form
){

    if(!form){

        return;

    }


    const textarea =
        form.querySelector(
            "textarea"
        );


    if(!textarea){

        return;

    }


    const text =
        textarea.value.trim();


    if(!text){

        textarea.focus();

        return;

    }


    const id =
        form.dataset.id;


    const type =
        form.dataset.type ||
        "post";


    if(!id){

        console.error(
            "FEED COMMENT: Missing item ID.",
            form
        );


        feedActionMessage(
            "Unable to identify this feed item."
        );

        return;

    }


    const submitButton =
        form.querySelector(
            'button[type="submit"]'
        );


    if(
        submitButton &&
        submitButton.disabled
    ){

        return;

    }


    if(submitButton){

        submitButton.disabled =
            true;

    }


    try{

        const url =
            type === "post"
                ? `/post/${id}/comment`
                : `/${type}/${id}/comment`;


        console.log(
            "FEED COMMENT REQUEST:",
            url
        );


        const response =
            await fetch(
                url,
                {

                    method: "POST",

                    headers: {

                        "Content-Type":
                            "application/json",

                        "Accept":
                            "application/json"

                    },

                    body:
                        JSON.stringify({
                            text
                        })

                }
            );


        const result =
            await response.json();


        console.log(
            "FEED COMMENT RESPONSE:",
            result
        );


        if(!response.ok){

            throw new Error(
                result.message ||
                `Request failed (${response.status})`
            );

        }


        if(!result.success){

            throw new Error(
                result.message ||
                "Unable to save comment."
            );

        }


        /*
         * If the server returns the created comment,
         * immediately add it to the current modal.
         *
         * Otherwise reload the page so the newly
         * saved comment is rendered by EJS.
         */

        if(result.comment){

            addFeedComment(
                form,
                result.comment
            );

            updateFeedCommentCount(
                form,
                1
            );

        }
        else{

            location.reload();

            return;

        }


        textarea.value = "";


        textarea.style.height =
            "auto";


    }
    catch(error){

        console.error(
            "FEED COMMENT ERROR:",
            error
        );


        feedActionMessage(
            error.message ||
            "Unable to save comment."
        );

    }
    finally{

        if(submitButton){

            submitButton.disabled =
                false;

        }

    }

}


/* =========================================================
   ADD COMMENT TO CURRENT COMMENT LIST
========================================================= */

function addFeedComment(
    form,
    comment
){

    const modal =
        form.closest(
            ".comment-modal"
        );


    if(!modal){

        return;

    }


    const commentSection =
        modal.querySelector(
            ".comment-section"
        );


    if(!commentSection){

        /*
         * The server has already saved the comment.
         * If the expected comment container doesn't exist,
         * reload so EJS can render it.
         */

        location.reload();

        return;

    }


    const empty =
        commentSection.querySelector(
            ".comment-empty-state"
        );


    empty?.remove();


    const item =
        document.createElement(
            "div"
        );


    item.className =
        "comment-item";


    const user =
        document.createElement(
            "div"
        );


    user.className =
        "comment-user";


    const image =
        document.createElement(
            "img"
        );


    image.className =
        "avatar-xs";


    image.alt =
        comment.userName ||
        "User";


    image.src =
        comment.userImage ||
        `https://ui-avatars.com/api/?name=${
            encodeURIComponent(
                comment.userName ||
                "User"
            )
        }`;


    const content =
        document.createElement(
            "div"
        );


    content.className =
        "comment-content";


    const name =
        document.createElement(
            "strong"
        );


    name.textContent =
        comment.userName ||
        "User";


    const text =
        document.createElement(
            "p"
        );


    text.textContent =
        comment.text ||
        "";


    const date =
        document.createElement(
            "small"
        );


    date.textContent =
        comment.dateText ||
        "";


    content.appendChild(
        name
    );


    content.appendChild(
        text
    );


    content.appendChild(
        date
    );


    user.appendChild(
        image
    );


    user.appendChild(
        content
    );


    item.appendChild(
        user
    );


    commentSection.prepend(
        item
    );

}


/* =========================================================
   DELETE POST
========================================================= */

async function handleFeedDeletePost(
    button
){

    if(!button){

        return;

    }


    const id =
        button.dataset.id;


    if(!id){

        console.error(
            "FEED DELETE: Missing post ID."
        );

        feedActionMessage(
            "Unable to identify this post."
        );

        return;

    }


    const confirmed =
        window.confirm(
            "Delete this post?"
        );


    if(!confirmed){

        return;

    }


    button.disabled = true;


    try{

        const response =
            await fetch(

                `/post/${id}`,

                {

                    method: "DELETE",

                    headers: {

                        "Accept":
                            "application/json"

                    }

                }

            );


        const result =
            await response.json();


        if(!response.ok){

            throw new Error(
                result.message ||
                `Delete failed (${response.status})`
            );

        }


        if(!result.success){

            throw new Error(
                result.message ||
                "Delete failed."
            );

        }


        const card =
            button.closest(
                ".feed-card"
            );


        if(card){

            card.remove();

        }

    }
    catch(error){

        console.error(
            "FEED DELETE POST ERROR:",
            error
        );


        feedActionMessage(
            error.message ||
            "Unable to delete post."
        );

    }
    finally{

        button.disabled = false;

    }

}


/* =========================================================
   DELETE COMMENT
========================================================= */

async function handleFeedDeleteComment(
    button
){

    if(!button){

        return;

    }


    const id =
        button.dataset.id;


    if(!id){

        feedActionMessage(
            "Unable to identify this comment."
        );

        return;

    }


    const confirmed =
        window.confirm(
            "Delete this comment?"
        );


    if(!confirmed){

        return;

    }


    button.disabled = true;


    try{

        const response =
            await fetch(

                `/comment/${id}`,

                {

                    method: "DELETE",

                    headers: {

                        "Accept":
                            "application/json"

                    }

                }

            );


        const result =
            await response.json();


        if(!response.ok){

            throw new Error(
                result.message ||
                `Delete failed (${response.status})`
            );

        }


        if(!result.success){

            throw new Error(
                result.message ||
                "Delete failed."
            );

        }


        const comment =
            button.closest(
                ".comment-item"
            );


        const card =
            button.closest(
                ".feed-card"
            );


        comment?.remove();


        updateFeedCommentCount(
            card,
            -1
        );

    }
    catch(error){

        console.error(
            "FEED DELETE COMMENT ERROR:",
            error
        );


        feedActionMessage(
            error.message ||
            "Unable to delete comment."
        );

    }
    finally{

        button.disabled = false;

    }

}


/* =========================================================
   UPDATE COMMENT COUNT
========================================================= */

function updateFeedCommentCount(
    source,
    amount
){

    const card =
        source?.closest
            ? source.closest(
                ".feed-card"
            )
            : null;


    const count =
        card?.querySelector(
            ".comment-count"
        );


    if(!count){

        return;

    }


    const current =
        Number(
            count.textContent || 0
        );


    count.textContent =
        Math.max(
            0,
            current + amount
        );

}


/* =========================================================
   MESSAGE
========================================================= */

function feedActionMessage(
    message
){

    if(
        typeof window.showMessage ===
        "function"
    ){

        window.showMessage(
            message
        );

        return;

    }


    alert(
        message
    );

}


/* =========================================================
   GLOBAL FEED EVENT HANDLER
========================================================= */

if(
    !window.__feedActionsInitialized
){

    window.__feedActionsInitialized =
        true;


    /* =====================================================
       CLICK EVENTS
    ===================================================== */

    document.addEventListener(
        "click",
        event => {


            /* =============================================
               LIKE
            ============================================= */

            const likeButton =
                event.target.closest(
                    ".like-btn"
                );


            if(likeButton){

                event.preventDefault();

                handleFeedLike(
                    likeButton
                );

                return;

            }


            /* =============================================
               OPEN COMMENTS
            ============================================= */

            const commentButton =
                event.target.closest(
                    ".toggle-comments"
                );


            if(commentButton){

                event.preventDefault();

                handleFeedComments(
                    commentButton
                );

                return;

            }


            /* =============================================
               CLOSE COMMENT MODAL
            ============================================= */

            const closeButton =
                event.target.closest(
                    ".close-comment-modal"
                );


            if(closeButton){

                event.preventDefault();

                closeFeedCommentModal(
                    closeButton.closest(
                        ".comment-modal"
                    )
                );

                return;

            }


            /* =============================================
               DELETE POST
            ============================================= */

            const deletePostButton =
                event.target.closest(
                    ".delete-post"
                );


            if(deletePostButton){

                event.preventDefault();

                handleFeedDeletePost(
                    deletePostButton
                );

                return;

            }


            /* =============================================
               DELETE COMMENT
            ============================================= */

            const deleteCommentButton =
                event.target.closest(
                    ".delete-comment"
                );


            if(deleteCommentButton){

                event.preventDefault();

                handleFeedDeleteComment(
                    deleteCommentButton
                );

                return;

            }


            /* =============================================
               CLICK OUTSIDE COMMENT MODAL
            ============================================= */

            const modal =
                event.target.closest(
                    ".comment-modal"
                );


            if(
                modal &&
                event.target === modal
            ){

                closeFeedCommentModal(
                    modal
                );

            }

        }
    );


    /* =====================================================
       FORM SUBMISSION
    ===================================================== */

    document.addEventListener(
        "submit",
        event => {

            const form =
                event.target.closest(
                    ".comment-form"
                );


            if(!form){

                return;

            }


            event.preventDefault();


            handleFeedCommentSubmit(
                form
            );

        }
    );


    /* =====================================================
       ESCAPE KEY
    ===================================================== */

    document.addEventListener(
        "keydown",
        event => {

            if(
                event.key !== "Escape"
            ){

                return;

            }


            document
                .querySelectorAll(
                    ".comment-modal.active"
                )
                .forEach(modal => {

                    closeFeedCommentModal(
                        modal
                    );

                });

        }
    );

}

</script>