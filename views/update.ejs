<!-- =====================================================
     UPDATE PAGE ASSETS
===================================================== -->

<link
    rel="stylesheet"
    href="/css/update/update.css"
>

<script src="/socket.io/socket.io.js"></script>


<!-- =====================================================
     UPDATE PAGE
===================================================== -->

<div class="dairy-page">


    <!-- =================================================
         PROFILE
    ================================================== -->

    <%- include("update/profile-card", {
        dairy: dairy,
        user: user
    }) %>


    <!-- =================================================
         CREATE POST
    ================================================== -->

    <% if (user) { %>

        <%- include("update/create-post", {
            user: user
        }) %>

    <% } %>


    <!-- =================================================
         PROPERTY ACTION
         
         This is intentionally on the parent page.
         It can therefore be positioned at the top-right
         of the page/header area.
    ================================================== -->

    <div class="dairy-property-action">

        <button
            type="button"
            id="viewPropertyButton"
            class="asset-bar-trigger"
            aria-controls="assetBar"
            aria-expanded="false"
        >

            <span
                class="asset-bar-trigger-icon"
                aria-hidden="true"
            >
                ◉
            </span>

            <span class="asset-bar-trigger-text">
                View Property
            </span>

        </button>

    </div>


    <!-- =================================================
         ASSET BAR

         The assetBar partial now contains ONLY the
         overlay and right-side sidebar.

         The View Property button is intentionally kept
         on this parent page.
    ================================================== -->

    <%- include("dairy/assetBar", {
        dairy: dairy,
        assetDairies: assetDairies || []
    }) %>


    <!-- =================================================
         FEED
    ================================================== -->

    <%- include("update/feed", {
        feed: feed,
        user: user
    }) %>


</div>


<!-- =====================================================
     UPDATE PAGE JAVASCRIPT
===================================================== -->

<script
    src="/js/update/index.js"
    defer
></script>

<script
    src="/js/assetBar.js"
    defer
></script>