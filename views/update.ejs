<!-- =====================================================
     UPDATE PAGE

     FILE:
         views/update.ejs

     PURPOSE:
         Dairy update/feed page.

     BOOLEAN MANAGEMENT:
     -----------------------------------------------------
     boolean.ejs is an INCLUDE.

     It is rendered directly below asset-cards.ejs.

     The MAIN FEED is currently COMMENTED OUT.
===================================================== -->


<!-- =====================================================
     UPDATE PAGE ASSETS
===================================================== -->

<link
    rel="stylesheet"
    href="/css/update/update.css"
>

<script
    src="/socket.io/socket.io.js"
></script>



<!-- =====================================================
     UPDATE PAGE
===================================================== -->

<div class="dairy-page">


    <!-- =================================================
         TOP PAGE ACTIONS

         THREE EQUAL BUTTON SPACES
    ================================================== -->

    <div class="dairy-page-actions">


        <!-- =============================================
             ADD ASSETS

             ADMIN ONLY
        ============================================== -->

        <% if (user && user.role === "admin") { %>

            <a
                href="/networth/structure/<%= dairy._id %>/add"
                class="asset-bar-trigger top-page-action"
            >

                <span
                    class="asset-bar-trigger-icon"
                    aria-hidden="true"
                >
                    +
                </span>

                <span class="asset-bar-trigger-text">
                    Add Assets
                </span>

            </a>

        <% } else { %>

            <span
                class="top-page-action-placeholder"
                aria-hidden="true"
            ></span>

        <% } %>



        <!-- =============================================
             VIEW ASSETS
        ============================================== -->

        <button
            type="button"
            id="viewPropertyButton"
            class="asset-bar-trigger top-page-action"
            aria-controls="assetBar"
            aria-expanded="false"
        >

            <span
                class="asset-bar-trigger-icon"
                aria-hidden="true"
            >
                ◉
            </span>

            <span class="asset-bar-trigger-text">
                View Assets
            </span>

        </button>



        <!-- =============================================
             FEED STORE
        ============================================== -->

        <a
            href="/storage/<%= dairy._id %>"
            class="asset-bar-trigger top-page-action"
            title="View Feed Store"
        >

            <span
                class="asset-bar-trigger-icon"
                aria-hidden="true"
            >
                📦
            </span>

            <span class="asset-bar-trigger-text">
                STORAGE
            </span>

        </a>


    </div>



    <!-- =================================================
         TOP ACTION LAYOUT
    ================================================== -->

    <style>

        .dairy-page-actions {

            width: 100%;

            display: grid;

            grid-template-columns:
                repeat(3, minmax(0, 1fr));

            align-items: stretch;

            gap: 8px;

            margin-bottom: 12px;

            box-sizing: border-box;

        }


        .dairy-page-actions > .top-page-action,
        .dairy-page-actions > .top-page-action-placeholder {

            width: 100%;

            min-width: 0;

            max-width: 100%;

            box-sizing: border-box;

        }


        .dairy-page-actions
        .top-page-action {

            min-height: 42px;

            margin: 0;

            padding: 7px 8px;

            display: flex;

            align-items: center;

            justify-content: center;

            gap: 5px;

            text-align: center;

            white-space: nowrap;

            overflow: hidden;

            text-decoration: none;

            box-sizing: border-box;

        }


        .dairy-page-actions
        .top-page-action
        .asset-bar-trigger-text {

            min-width: 0;

            overflow: hidden;

            text-overflow: ellipsis;

            white-space: nowrap;

        }


        .dairy-page-actions
        .top-page-action
        .asset-bar-trigger-icon {

            flex: 0 0 auto;

        }


        .top-page-action-placeholder {

            min-height: 42px;

            visibility: hidden;

        }


        @media (max-width: 600px) {

            .dairy-page-actions {

                grid-template-columns:
                    repeat(3, minmax(0, 1fr));

                gap: 5px;

            }


            .dairy-page-actions
            .top-page-action {

                min-height: 40px;

                padding: 6px 4px;

                gap: 3px;

                font-size: 10px;

            }


            .dairy-page-actions
            .asset-bar-trigger-icon {

                font-size: 13px;

            }


            .dairy-page-actions
            .asset-bar-trigger-text {

                font-size: 9px;

            }

        }


        @media (max-width: 380px) {

            .dairy-page-actions {

                gap: 4px;

            }


            .dairy-page-actions
            .top-page-action {

                padding: 6px 2px;

            }


            .dairy-page-actions
            .asset-bar-trigger-icon {

                font-size: 12px;

            }


            .dairy-page-actions
            .asset-bar-trigger-text {

                font-size: 8px;

            }

        }

    </style>

    <!-- =================================================
         BOOLEAN MANAGEMENT

         FILE:
             views/update/boolean.ejs

         RENDERED EXACTLY ONCE.
    ================================================== -->

    <%- include(
        "update/boolean",
        {
            dairy: dairy,
            assetDairies: assetDairies || [],
            booleanFields: booleanFields || [],
            booleanAnimals: booleanAnimals || [],
            user: user
        }
    ) %>

    <!-- =================================================
         FIXED H1

         ALWAYS SECOND
    ================================================== -->

    <%- include(
        "update/h1",
        {
            dairy: dairy,
            user: user
        }
    ) %>
<!-- =================================================
         FIXED CREATE POST
    ================================================== -->

    <%- include(
        "update/asset-cards",
        {
            dairy: dairy,
            user: user,
            assetDairies: assetDairies || []
        }
    ) %>

<!-- =================================================
         FIXED CREATE POST
    ================================================== -->

    <%- include(
        "update/create-post",
        {
            dairy: dairy,
            user: user,
            assetDairies: assetDairies || []
        }
    ) %>



    <!-- =================================================
         BOOLEAN MANAGEMENT

         FILE:
             views/update/boolean.ejs

         RENDERED EXACTLY ONCE.
    ================================================== -->

    <%- include(
        "update/boolean",
        {
            dairy: dairy,
            assetDairies: assetDairies || [],
            booleanFields: booleanFields || [],
            booleanAnimals: booleanAnimals || [],
            user: user
        }
    ) %>
    <!-- =================================================
         ASSET SIDEBAR
    ================================================== -->

    <%- include(
        "dairy/assetBar",
        {
            dairy: dairy,
            assetDairies: assetDairies || []
        }
    ) %>

</div>



<!-- =====================================================
     UPDATE PAGE JAVASCRIPT
===================================================== -->

<script
    src="/js/update/index.js"
    defer
></script>