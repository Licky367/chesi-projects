<!-- =====================================================
     UPDATE PAGE
     
     FILE:
         views/update.ejs

     NOTE:
         The navigation bar is rendered separately through:
             views/update/update-nav.ejs

         layout.ejs already provides the 120px header.
===================================================== -->


<!-- =====================================================
     UPDATE PAGE ASSETS
===================================================== -->

<link
    rel="stylesheet"
    href="/css/update/update.css"
>

<script
    src="/socket.io/socket.io.js"
></script>



<!-- =====================================================
     UPDATE NAVIGATION
===================================================== -->

<%- include(
    "update/update-nav",
    {
        dairy: dairy,
        user: user
    }
) %>



<!-- =====================================================
     UPDATE PAGE CONTENT
     
     The navigation component controls the exact space
     required beneath the fixed navigation.

     No additional top padding is applied here.
===================================================== -->

<div class="dairy-page">
    <!-- =================================================
         BOOLEAN MANAGEMENT
         
         FILE:
             views/update/boolean.ejs

         Rendered exactly once.
    ================================================== -->

    <%- include(
        "update/boolean",
        {
            dairy: dairy,
            assetDairies: assetDairies || [],
            booleanFields: booleanFields || [],
            booleanAnimals: booleanAnimals || [],
            user: user
        }
    ) %>


    <!-- =================================================
  PERO SECTION, PLACED SECOND ON PURPOSE
    ================================================== -->

    <%- include(
        "update/h1",
        {
            dairy: dairy,
            user: user
        }
    ) %>



    <!-- =================================================
         ASSET CARDS
    ================================================== -->

    <%- include(
        "update/asset-cards",
        {
            dairy: dairy,
            user: user,
            assetDairies: assetDairies || []
        }
    ) %>



    <!-- =================================================
         BOOLEAN MANAGEMENT
         
         FILE:
             views/update/boolean.ejs

         Rendered twice on Purpose
    ================================================== -->

    <%- include(
        "update/boolean",
        {
            dairy: dairy,
            assetDairies: assetDairies || [],
            booleanFields: booleanFields || [],
            booleanAnimals: booleanAnimals || [],
            user: user
        }
    ) %>



    <!-- =================================================
         MILKING HISTORY
    ================================================== -->

    <%- include(
        "update/milk-history-cards.ejs",
        {
            dairy: dairy,
            user: user,
            assetDairies: assetDairies || []
        }
    ) %>



    <!-- =================================================
         ASSET SIDEBAR
    ================================================== -->

    <%- include(
        "dairy/assetBar",
        {
            dairy: dairy,
            assetDairies: assetDairies || []
        }
    ) %>


</div>



<!-- =====================================================
     UPDATE PAGE JAVASCRIPT
===================================================== -->

<script
    src="/js/update/index.js"
    defer
></script>