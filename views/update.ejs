<!-- =====================================================
     UPDATE PAGE ASSETS
===================================================== -->

<link
    rel="stylesheet"
    href="/css/update/update.css"
>

<script src="/socket.io/socket.io.js"></script>


<!-- =====================================================
     UPDATE PAGE
===================================================== -->

<div class="dairy-page">


    <!-- =================================================
         TOP PAGE ACTIONS
    ================================================== -->

    <div
        class="dairy-page-actions"
        style="
            display:flex;
            align-items:center;
            justify-content:space-between;
            gap:10px;
            width:100%;
        "
    >


        <!-- =============================================
             TOP-LEFT ADD ASSETS
             
             ADMIN ONLY
        ============================================== -->

        <% if (
            user &&
            user.role === "admin"
        ) { %>


            <a
                href="/networth/structure/<%= dairy._id %>/add"
                class="asset-bar-trigger"
                style="
                    text-decoration:none;
                    display:inline-flex;
                    align-items:center;
                    justify-content:center;
                "
            >

                <span
                    class="asset-bar-trigger-icon"
                    aria-hidden="true"
                >
                    +
                </span>

                <span class="asset-bar-trigger-text">
                    Add Assets
                </span>

            </a>


        <% } else { %>


            <!--
                Empty spacer keeps the View Assets
                button positioned on the right.
            -->

            <span
                aria-hidden="true"
            ></span>


        <% } %>



        <!-- =============================================
             TOP-RIGHT VIEW ASSETS
        ============================================== -->

        <button
            type="button"
            id="viewPropertyButton"
            class="asset-bar-trigger"
            aria-controls="assetBar"
            aria-expanded="false"
        >

            <span
                class="asset-bar-trigger-icon"
                aria-hidden="true"
            >
                ◉
            </span>

            <span class="asset-bar-trigger-text">
                View Assets
            </span>

        </button>


    </div>


    <!-- =================================================
         HERO SECTION
    ================================================== -->

    <%- include("update/h1", {
        dairy: dairy,
        user: user
    }) %>


    <!-- =================================================
         CREATE POST
    ================================================== -->

    <%- include("update/create-post", {
        dairy: dairy,
        user: user
    }) %>


    <!-- =================================================
         ASSET SIDEBAR

         The partial contains:

         • Overlay
         • Sidebar
         • Animals
         • Structures
         • Sidebar JavaScript
    ================================================== -->

    <%- include("dairy/assetBar", {
        dairy: dairy,
        assetDairies: assetDairies || []
    }) %>


    <!-- =================================================
         FEED
    ================================================== -->

    <%- include("update/feed", {
        feed: feed,
        user: user
    }) %>


</div>


<!-- =====================================================
     UPDATE PAGE JAVASCRIPT
===================================================== -->

<script
    src="/js/update/index.js"
    defer
></script>