<!-- =====================================================
     UPDATE PAGE
     
     FILE:
         views/update.ejs

     PURPOSE:
         Dairy update/feed page.

     FIXED TOP ORDER:
         1. Create Post
         2. H1

     RECURRING FEED INSERTIONS:
         • Asset Cards
         • Create Post

     H1:
         • Appears ONLY once
         • Always immediately after Create Post

     IMPORTANT:
         Feed items themselves remain in their existing
         chronological order.
===================================================== -->


<!-- =====================================================
     UPDATE PAGE ASSETS
===================================================== -->

<link
    rel="stylesheet"
    href="/css/update/update.css"
>

<script
    src="/socket.io/socket.io.js"
></script>



<!-- =====================================================
     UPDATE PAGE
===================================================== -->

<div class="dairy-page">


    <!-- =================================================
         TOP PAGE ACTIONS
    ================================================== -->

    <div
        class="dairy-page-actions"
        style="
            display:flex;
            align-items:center;
            justify-content:space-between;
            gap:10px;
            width:100%;
        "
    >


        <!-- =============================================
             TOP-LEFT ADD ASSETS
             
             ADMIN ONLY
        ============================================== -->

        <% if (
            user &&
            user.role === "admin"
        ) { %>


            <a
                href="/networth/structure/<%= dairy._id %>/add"
                class="asset-bar-trigger"
                style="
                    text-decoration:none;
                    display:inline-flex;
                    align-items:center;
                    justify-content:center;
                "
            >

                <span
                    class="asset-bar-trigger-icon"
                    aria-hidden="true"
                >
                    +
                </span>


                <span class="asset-bar-trigger-text">
                    Add Assets
                </span>

            </a>


        <% } else { %>


            <span
                aria-hidden="true"
            ></span>


        <% } %>



        <!-- =============================================
             TOP-RIGHT VIEW ASSETS
        ============================================== -->

        <button
            type="button"
            id="viewPropertyButton"
            class="asset-bar-trigger"
            aria-controls="assetBar"
            aria-expanded="false"
        >

            <span
                class="asset-bar-trigger-icon"
                aria-hidden="true"
            >
                ◉
            </span>


            <span class="asset-bar-trigger-text">
                View Assets
            </span>

        </button>


    </div>



    <!-- =================================================
         FIXED CREATE POST
         
         ALWAYS FIRST
    ================================================== -->

    <%- include("update/create-post", {
        dairy: dairy,
        user: user,
        assetDairies: assetDairies || []
    }) %>



    <!-- =================================================
         FIXED H1
         
         ALWAYS SECOND
         
         NEVER REPEATED
    ================================================== -->

    <%- include("update/h1", {
        dairy: dairy,
        user: user
    }) %>



    <!-- =================================================
         ASSET SIDEBAR
         
         The sidebar remains independent from the
         recurring asset cards.
    ================================================== -->

    <%- include("dairy/assetBar", {
        dairy: dairy,
        assetDairies: assetDairies || []
    }) %>



    <!-- =================================================
         FEED
         
         The feed is rendered manually here rather than
         simply including feed.ejs.

         This allows the parent page to insert:
         
             • asset-card
             • create-post
         
         at intervals between feed records.
    ================================================== -->

    <section
        id="feed"
        class="feed-container"
    >


        <%
            /*
             * =================================================
             * RECURRING INSERTION SETTINGS
             * =================================================
             *
             * These numbers control when the special cards
             * appear.
             *
             * They can be changed easily later.
             *
             * Example:
             *
             *     after 5 posts
             *     after 12 posts
             *     after 20 posts
             *
             * The sequence then repeats.
             *
             * -------------------------------------------------
             *
             * IMPORTANT:
             * The number refers to FEED ITEMS, not only posts.
             *
             * So milk, medical, maintenance, assetAdd, etc.
             * all count as one feed item.
             *
             * =================================================
             */


            const insertionPattern = [
                5,
                12,
                20,
                28,
                37
            ];


            /*
             * -------------------------------------------------
             * Counter
             * -------------------------------------------------
             */

            let feedPosition = 0;


            /*
             * -------------------------------------------------
             * Pattern position
             * -------------------------------------------------
             */

            let insertionIndex = 0;


            /*
             * -------------------------------------------------
             * Determine whether asset cards exist.
             * -------------------------------------------------
             */

            const hasAssetCards =
                Array.isArray(assetDairies) &&
                assetDairies.length > 0;


            /*
             * -------------------------------------------------
             * Alternate recurring component.
             *
             * true  = asset card
             * false = create post
             *
             * This means the recurring sequence becomes:
             *
             *     Asset Cards
             *     Create Post
             *     Asset Cards
             *     Create Post
             *
             * regardless of the spacing.
             * -------------------------------------------------
             */

            let nextRecurringComponent = "asset";


        %>



        <!-- =================================================
             FEED ITEMS
        ================================================== -->

        <% if (
            Array.isArray(feed) &&
            feed.length
        ) { %>


            <% feed.forEach(function (item) { %>


                <%
                    /*
                     * =========================================
                     * ADVANCE FEED POSITION
                     * =========================================
                     */

                    feedPosition++;
                %>



                <!-- =========================================
                     NORMAL POST
                ========================================== -->

                <% if (item.type === "post") { %>

                    <%- include("update/post", {
                        item: item,
                        user: user
                    }) %>

                <% } %>



                <!-- =========================================
                     WEEKLY MILK REPORT
                ========================================== -->

                <% if (item.type === "milk") { %>

                    <%- include("update/milk", {
                        item: item,
                        user: user
                    }) %>

                <% } %>



                <!-- =========================================
                     MEDICAL — MARKED
                ========================================== -->

                <% if (
                    item.type === "medical" &&
                    item.status === "marked"
                ) { %>

                    <%- include("update/medical-marked", {
                        item: item,
                        user: user
                    }) %>

                <% } %>



                <!-- =========================================
                     MEDICAL — CLEARED
                ========================================== -->

                <% if (
                    item.type === "medical" &&
                    item.status === "cleared"
                ) { %>

                    <%- include("update/medical-cleared", {
                        item: item,
                        user: user
                    }) %>

                <% } %>



                <!-- =========================================
                     MAINTENANCE — MARKED
                ========================================== -->

                <% if (
                    item.type === "maintenance" &&
                    item.status === "marked"
                ) { %>

                    <%- include("update/maintenance-marked", {
                        item: item,
                        user: user
                    }) %>

                <% } %>



                <!-- =========================================
                     MAINTENANCE — CLEARED
                ========================================== -->

                <% if (
                    item.type === "maintenance" &&
                    item.status === "cleared"
                ) { %>

                    <%- include("update/maintenance-cleared", {
                        item: item,
                        user: user
                    }) %>

                <% } %>



                <!-- =========================================
                     ASSET ADDED
                ========================================== -->

                <% if (item.type === "assetAdd") { %>

                    <%- include("update/addAsset", {
                        item: item,
                        user: user
                    }) %>

                <% } %>



                <!-- =========================================
                     RECURRING INSERTION
                     
                     Happens AFTER the feed item.
                ========================================== -->

                <%
                    /*
                     * =========================================
                     * CHECK INSERTION POINT
                     * =========================================
                     */

                    const nextInsertion =
                        insertionPattern[insertionIndex];


                    if (
                        nextInsertion &&
                        feedPosition === nextInsertion
                    ) {


                        /*
                         * =====================================
                         * ASSET CARD
                         * =====================================
                         */

                        if (
                            nextRecurringComponent === "asset" &&
                            hasAssetCards
                        ) {

                            insertionIndex++;

                            nextRecurringComponent =
                                "create";
                        }


                        /*
                         * =====================================
                         * CREATE POST
                         * =====================================
                         */

                        else if (
                            nextRecurringComponent === "create"
                        ) {

                            insertionIndex++;

                            nextRecurringComponent =
                                "asset";
                        }

                    }

                %>



                <!-- =========================================
                     RECURRING ASSET CARD
                ========================================== -->

                <%
                    /*
                     * We need a separate check here because
                     * EJS variables above cannot directly
                     * render content during the same logical
                     * block without making the flow harder
                     * to read.
                     *
                     * Determine whether this position is
                     * an insertion point.
                     */

                    const shouldInsertHere =
                        insertionPattern
                            .includes(feedPosition);


                    /*
                     * Find which insertion point this is.
                     */

                    const insertionNumber =
                        insertionPattern.indexOf(
                            feedPosition
                        );
                %>


                <% if (shouldInsertHere) { %>


                    <%
                        /*
                         * Because the insertion component was
                         * selected above, derive the component
                         * from the insertion number.
                         *
                         * Odd/even alternation:
                         *
                         * 0 = asset
                         * 1 = create
                         * 2 = asset
                         * 3 = create
                         *
                         * If no assets exist, create-post is
                         * used instead.
                         */

                        let insertAsset =
                            insertionNumber % 2 === 0;

                        if (!hasAssetCards) {
                            insertAsset = false;
                        }
                    %>



                    <% if (insertAsset) { %>

                        <!-- ===============================
                             RECURRING ASSET CARDS
                        ================================ -->

                        <%- include("update/asset-cards", {
                            dairy: dairy,
                            assetDairies: assetDairies || []
                        }) %>


                    <% } else { %>

                        <!-- ===============================
                             RECURRING CREATE POST
                        ================================ -->

                        <%- include("update/create-post", {
                            dairy: dairy,
                            user: user,
                            assetDairies: assetDairies || []
                        }) %>

                    <% } %>


                <% } %>


            <% }); %>


        <% } else { %>


            <!-- =================================================
                 EMPTY FEED
            ================================================== -->

            <div
                class="feed-empty-state"
                style="
                    width:100%;
                    padding:30px 20px;
                    text-align:center;
                    color:#7b847e;
                "
            >

                <i
                    class="bi bi-journal-text"
                    aria-hidden="true"
                ></i>


                <p>
                    No updates have been recorded yet.
                </p>

            </div>


        <% } %>


    </section>


</div>



<!-- =====================================================
     UPDATE PAGE JAVASCRIPT
===================================================== -->

<script
    src="/js/update/index.js"
    defer
></script>