<!-- =====================================================
     UPDATE PAGE

     FILE:
         views/update.ejs

     PURPOSE:
         Dairy update/feed page.

     BOOLEAN MANAGEMENT:
     -----------------------------------------------------
     boolean.ejs is an INCLUDE.

     It is rendered directly below asset-cards.ejs.

     It is NOT a standalone page.

     Boolean data expected from controller:

         booleanFields
         booleanAnimals

     The Boolean component allows the user to:

         1. Tap the first card.
         2. Open the Boolean-field dropdown.
         3. Select a Boolean field.
         4. View eligible female animals.
         5. Toggle the selected Boolean value.

===================================================== -->


<!-- =====================================================
     UPDATE PAGE ASSETS
===================================================== -->

<link
    rel="stylesheet"
    href="/css/update/update.css"
>

<script
    src="/socket.io/socket.io.js"
></script>



<!-- =====================================================
     UPDATE PAGE
===================================================== -->

<div class="dairy-page">


    <!-- =================================================
         TOP PAGE ACTIONS

         THREE EQUAL BUTTON SPACES
    ================================================== -->

    <div class="dairy-page-actions">


        <!-- =============================================
             ADD ASSETS

             ADMIN ONLY
        ============================================== -->

        <% if (user && user.role === "admin") { %>

            <a
                href="/networth/structure/<%= dairy._id %>/add"
                class="asset-bar-trigger top-page-action"
            >

                <span
                    class="asset-bar-trigger-icon"
                    aria-hidden="true"
                >
                    +
                </span>

                <span class="asset-bar-trigger-text">
                    Add Assets
                </span>

            </a>

        <% } else { %>

            <span
                class="top-page-action-placeholder"
                aria-hidden="true"
            ></span>

        <% } %>



        <!-- =============================================
             VIEW ASSETS
        ============================================== -->

        <button
            type="button"
            id="viewPropertyButton"
            class="asset-bar-trigger top-page-action"
            aria-controls="assetBar"
            aria-expanded="false"
        >

            <span
                class="asset-bar-trigger-icon"
                aria-hidden="true"
            >
                ◉
            </span>

            <span class="asset-bar-trigger-text">
                View Assets
            </span>

        </button>



        <!-- =============================================
             FEED STORE
        ============================================== -->

        <a
            href="/storage/<%= dairy._id %>"
            class="asset-bar-trigger top-page-action"
            title="View Feed Store"
        >

            <span
                class="asset-bar-trigger-icon"
                aria-hidden="true"
            >
                📦
            </span>

            <span class="asset-bar-trigger-text">
                STORAGE
            </span>

        </a>


    </div>



    <!-- =================================================
         TOP ACTION LAYOUT
    ================================================== -->

    <style>

        .dairy-page-actions {

            width: 100%;

            display: grid;

            grid-template-columns:
                repeat(3, minmax(0, 1fr));

            align-items: stretch;

            gap: 8px;

            margin-bottom: 12px;

            box-sizing: border-box;

        }


        .dairy-page-actions > .top-page-action,
        .dairy-page-actions > .top-page-action-placeholder {

            width: 100%;

            min-width: 0;

            max-width: 100%;

            box-sizing: border-box;

        }


        .dairy-page-actions
        .top-page-action {

            min-height: 42px;

            margin: 0;

            padding: 7px 8px;

            display: flex;

            align-items: center;

            justify-content: center;

            gap: 5px;

            text-align: center;

            white-space: nowrap;

            overflow: hidden;

            text-decoration: none;

            box-sizing: border-box;

        }


        .dairy-page-actions
        .top-page-action
        .asset-bar-trigger-text {

            min-width: 0;

            overflow: hidden;

            text-overflow: ellipsis;

            white-space: nowrap;

        }


        .dairy-page-actions
        .top-page-action
        .asset-bar-trigger-icon {

            flex: 0 0 auto;

        }


        .top-page-action-placeholder {

            min-height: 42px;

            visibility: hidden;

        }


        @media (max-width: 600px) {

            .dairy-page-actions {

                grid-template-columns:
                    repeat(3, minmax(0, 1fr));

                gap: 5px;

            }


            .dairy-page-actions
            .top-page-action {

                min-height: 40px;

                padding: 6px 4px;

                gap: 3px;

                font-size: 10px;

            }


            .dairy-page-actions
            .asset-bar-trigger-icon {

                font-size: 13px;

            }


            .dairy-page-actions
            .asset-bar-trigger-text {

                font-size: 9px;

            }

        }


        @media (max-width: 380px) {

            .dairy-page-actions {

                gap: 4px;

            }


            .dairy-page-actions
            .top-page-action {

                padding: 6px 2px;

            }


            .dairy-page-actions
            .asset-bar-trigger-icon {

                font-size: 12px;

            }


            .dairy-page-actions
            .asset-bar-trigger-text {

                font-size: 8px;

            }

        }

    </style>



    <!-- =================================================
         FIXED CREATE POST

         ALWAYS FIRST
    ================================================== -->

    <%- include(
        "update/create-post",
        {
            dairy: dairy,
            user: user,
            assetDairies: assetDairies || []
        }
    ) %>



    <!-- =================================================
         FIXED H1

         ALWAYS SECOND
    ================================================== -->

    <%- include(
        "update/h1",
        {
            dairy: dairy,
            user: user
        }
    ) %>



    <!-- =================================================
         FIXED ASSET CARDS

         ALWAYS DIRECTLY BELOW H1

         IMPORTANT:
         -------------------------------------------------
         asset-cards.ejs is rendered exactly once.

         It is NOT inside the feed loop.
    ================================================== -->

    <%- include(
        "update/asset-cards",
        {
            dairy: dairy,
            assetDairies: assetDairies || []
        }
    ) %>



    <!-- =================================================
         BOOLEAN MANAGEMENT

         FILE:
             views/update/boolean.ejs

         IMPORTANT:
         -------------------------------------------------
         boolean.ejs is an INCLUDE.

         It is NOT a standalone page.

         It is rendered exactly once here.

         The controller supplies:

             booleanFields
             booleanAnimals

         The Boolean component is responsible for:

             - first expandable Boolean card
             - Boolean-field dropdown
             - eligible animal cards
             - Boolean toggle requests
    ================================================== -->

    <%- include(
        "update/boolean",
        {
            dairy: dairy,
            assetDairies: assetDairies || [],
            booleanFields: booleanFields || [],
            booleanAnimals: booleanAnimals || [],
            user: user
        }
    ) %>



    <!-- =================================================
         ANIMAL FEED ITEM LINKS

         Appears directly below boolean.ejs.

         itemLinks is always supplied as an array.
    ================================================== -->

    <%- include(
        "update/storage/itemLink",
        {
            dairy: dairy,
            user: user,
            itemLinks: itemLinks || []
        }
    ) %>



    <!-- =================================================
         ASSET SIDEBAR
    ================================================== -->

    <%- include(
        "dairy/assetBar",
        {
            dairy: dairy,
            assetDairies: assetDairies || []
        }
    ) %>



    <!-- =================================================
         MAIN FEED
    ================================================== -->

    <section
        id="feed"
        class="feed-container"
    >


        <!-- =================================================
             FEED EXISTS
        ================================================== -->

        <% if (
            Array.isArray(feed) &&
            feed.length > 0
        ) { %>


            <!-- =================================================
                 FEED LOOP

                 IMPORTANT:
                 -------------------------------------------------
                 Fixed components are NOT rendered here.

                 This loop renders feed documents only.
            ================================================== -->

            <% feed.forEach(
                function(item, index)
            { %>


                <!-- =============================================
                     NORMAL POST
                ============================================== -->

                <% if (
                    item.type === "post"
                ) { %>

                    <%- include(
                        "update/post",
                        {
                            item: item,
                            user: user
                        }
                    ) %>

                <% } %>



                <!-- =============================================
                     WEEKLY MILK REPORT
                ============================================== -->

                <% if (
                    item.type === "milk"
                ) { %>

                    <%- include(
                        "update/milk",
                        {
                            item: item,
                            user: user
                        }
                    ) %>

                <% } %>



                <!-- =============================================
                     MEDICAL — MARKED
                ============================================== -->

                <% if (
                    item.type === "medical" &&
                    item.status === "marked"
                ) { %>

                    <%- include(
                        "update/medical-marked",
                        {
                            item: item,
                            user: user
                        }
                    ) %>

                <% } %>



                <!-- =============================================
                     MEDICAL — CLEARED
                ============================================== -->

                <% if (
                    item.type === "medical" &&
                    item.status === "cleared"
                ) { %>

                    <%- include(
                        "update/medical-cleared",
                        {
                            item: item,
                            user: user
                        }
                    ) %>

                <% } %>



                <!-- =============================================
                     MAINTENANCE — MARKED
                ============================================== -->

                <% if (
                    item.type === "maintenance" &&
                    item.status === "marked"
                ) { %>

                    <%- include(
                        "update/maintenance-marked",
                        {
                            item: item,
                            user: user
                        }
                    ) %>

                <% } %>



                <!-- =============================================
                     MAINTENANCE — CLEARED
                ============================================== -->

                <% if (
                    item.type === "maintenance" &&
                    item.status === "cleared"
                ) { %>

                    <%- include(
                        "update/maintenance-cleared",
                        {
                            item: item,
                            user: user
                        }
                    ) %>

                <% } %>



                <!-- =============================================
                     STOCK UPDATE

                     EXCEPTION:

                         stock-update.ejs expects:

                             update

                     Therefore this intentionally receives:

                         update: item
                ============================================== -->

                <% if (
                    item.type === "animalFeed"
                ) { %>

                    <%- include(
                        "update/stock-update",
                        {
                            update: item,
                            user: user
                        }
                    ) %>

                <% } %>



                <!-- =============================================
                     ASSET ADDED
                ============================================== -->

                <% if (
                    item.type === "assetAdd"
                ) { %>

                    <%- include(
                        "update/addAsset",
                        {
                            item: item,
                            user: user
                        }
                    ) %>

                <% } %>


            <% }); %>



        <!-- =================================================
             EMPTY FEED
        ================================================== -->

        <% } else { %>


            <div
                class="feed-empty-state"
                style="
                    width:100%;
                    padding:30px 20px;
                    text-align:center;
                    color:#7b847e;
                "
            >

                <i
                    class="bi bi-journal-text"
                    aria-hidden="true"
                ></i>


                <p>
                    No updates have been recorded yet.
                </p>

            </div>


        <% } %>


    </section>


</div>



<!-- =====================================================
     UPDATE PAGE JAVASCRIPT
===================================================== -->

<script
    src="/js/update/index.js"
    defer
></script>