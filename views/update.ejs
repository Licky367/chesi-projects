<!-- =====================================================
     UPDATE PAGE

     FILE:
         views/update.ejs

     PURPOSE:
         Dairy update/feed page.

     FEED CONTRACT:
     -----------------------------------------------------
     Every document inside `feed` is called `item`.

     Every feed-card partial receives:

         item: item

     This applies to:

         post.ejs
         milk.ejs
         medical-marked.ejs
         medical-cleared.ejs
         maintenance-marked.ejs
         maintenance-cleared.ejs
         addAsset.ejs

     IMPORTANT:
     -----------------------------------------------------
     No feed card receives:

         update: item

     No feed card expects a variable named:

         update

     The single naming convention is:

         item

     stock.ejs is deliberately NOT rendered here.

===================================================== -->


<!-- =====================================================
     UPDATE PAGE ASSETS
===================================================== -->

<link
    rel="stylesheet"
    href="/css/update/update.css"
>

<script
    src="/socket.io/socket.io.js"
></script>



<!-- =====================================================
     UPDATE PAGE
===================================================== -->

<div class="dairy-page">


    <!-- =================================================
         TOP PAGE ACTIONS
    ================================================== -->

    <div
        class="dairy-page-actions"
        style="
            display:flex;
            align-items:center;
            justify-content:space-between;
            gap:10px;
            width:100%;
        "
    >


        <!-- =============================================
             ADD ASSETS
             
             ADMIN ONLY
        ============================================== -->

        <% if (user && user.role === "admin") { %>


            <a
                href="/networth/structure/<%= dairy._id %>/add"
                class="asset-bar-trigger"
                style="
                    text-decoration:none;
                    display:inline-flex;
                    align-items:center;
                    justify-content:center;
                "
            >

                <span
                    class="asset-bar-trigger-icon"
                    aria-hidden="true"
                >
                    +
                </span>

                <span class="asset-bar-trigger-text">
                    Add Assets
                </span>

            </a>


        <% } else { %>


            <span aria-hidden="true"></span>


        <% } %>



        <!-- =============================================
             VIEW ASSETS
        ============================================== -->

        <button
            type="button"
            id="viewPropertyButton"
            class="asset-bar-trigger"
            aria-controls="assetBar"
            aria-expanded="false"
        >

            <span
                class="asset-bar-trigger-icon"
                aria-hidden="true"
            >
                ◉
            </span>

            <span class="asset-bar-trigger-text">
                View Assets
            </span>

        </button>


    </div>



    <!-- =================================================
         FIXED CREATE POST

         ALWAYS FIRST
    ================================================== -->

    <%- include("update/create-post", {
        dairy: dairy,
        user: user,
        assetDairies: assetDairies || []
    }) %>



    <!-- =================================================
         FIXED H1

         ALWAYS SECOND
    ================================================== -->

    <%- include("update/h1", {
        dairy: dairy,
        user: user
    }) %>



    <!-- =================================================
         ASSET SIDEBAR
    ================================================== -->

    <%- include("dairy/assetBar", {
        dairy: dairy,
        assetDairies: assetDairies || []
    }) %>



    <!-- =================================================
         MAIN FEED
    ================================================== -->

    <section
        id="feed"
        class="feed-container"
    >


        <!-- =================================================
             FEED EXISTS
        ================================================== -->

        <% if (Array.isArray(feed) && feed.length > 0) { %>


            <%
                /*
                ==================================================
                RECURRING INSERTION POSITIONS
                ==================================================

                These positions only control where the
                recurring UI cards appear.

                They NEVER alter the actual feed array.

                Every real feed document is still rendered
                exactly once.

                ==================================================
                */

                const insertionPattern = [
                    5,
                    12,
                    20,
                    28,
                    37
                ];


                const hasAssetCards =
                    Array.isArray(assetDairies) &&
                    assetDairies.length > 0;
            %>



            <!-- =================================================
                 FEED LOOP
            ================================================== -->

            <% feed.forEach(function(item, index) { %>


                <%
                    /*
                    ==================================================
                    CURRENT FEED POSITION
                    ==================================================
                    */

                    const feedPosition =
                        index + 1;


                    const insertionNumber =
                        insertionPattern.indexOf(
                            feedPosition
                        );


                    const shouldInsertHere =
                        insertionNumber !== -1;


                    let insertAsset =
                        insertionNumber % 2 === 0;


                    if (!hasAssetCards) {

                        insertAsset = false;

                    }
                %>



                <!-- =================================================
                     NORMAL POST

                     CONTRACT:
                         item: item
                ================================================== -->

                <% if (item.type === "post") { %>


                    <%- include(
                        "update/post",
                        {
                            item: item,
                            user: user
                        }
                    ) %>


                <% } %>



                <!-- =================================================
                     WEEKLY MILK REPORT

                     CONTRACT:
                         item: item
                ================================================== -->

                <% if (item.type === "milk") { %>


                    <%- include(
                        "update/milk",
                        {
                            item: item,
                            user: user
                        }
                    ) %>


                <% } %>



                <!-- =================================================
                     MEDICAL — MARKED

                     CONTRACT:
                         item: item
                ================================================== -->

                <% if (
                    item.type === "medical" &&
                    item.status === "marked"
                ) { %>


                    <%- include(
                        "update/medical-marked",
                        {
                            item: item,
                            user: user
                        }
                    ) %>


                <% } %>



                <!-- =================================================
                     MEDICAL — CLEARED

                     CONTRACT:
                         item: item
                ================================================== -->

                <% if (
                    item.type === "medical" &&
                    item.status === "cleared"
                ) { %>


                    <%- include(
                        "update/medical-cleared",
                        {
                            item: item,
                            user: user
                        }
                    ) %>


                <% } %>



                <!-- =================================================
                     MAINTENANCE — MARKED

                     CONTRACT:
                         item: item
                ================================================== -->

                <% if (
                    item.type === "maintenance" &&
                    item.status === "marked"
                ) { %>


                    <%- include(
                        "update/maintenance-marked",
                        {
                            item: item,
                            user: user
                        }
                    ) %>


                <% } %>



                <!-- =================================================
                     MAINTENANCE — CLEARED

                     CONTRACT:
                         item: item
                ================================================== -->

                <% if (
                    item.type === "maintenance" &&
                    item.status === "cleared"
                ) { %>


                    <%- include(
                        "update/maintenance-cleared",
                        {
                            item: item,
                            user: user
                        }
                    ) %>


                <% } %>



                <!-- =================================================
                     ASSET ADDED

                     CONTRACT:
                         item: item
                ================================================== -->

                <% if (item.type === "assetAdd") { %>


                    <%- include(
                        "update/addAsset",
                        {
                            item: item,
                            user: user
                        }
                    ) %>


                <% } %>



                <!-- =================================================
                     RECURRING INSERTION

                     These are NOT feed documents.

                     They do not use item.
                ================================================== -->

                <% if (shouldInsertHere) { %>


                    <!-- =============================================
                         ASSET CARDS
                    ============================================== -->

                    <% if (insertAsset) { %>


                        <%- include(
                            "update/asset-cards",
                            {
                                dairy: dairy,
                                assetDairies:
                                    assetDairies || []
                            }
                        ) %>


                    <!-- =============================================
                         CREATE POST
                    ============================================== -->

                    <% } else { %>


                        <%- include(
                            "update/create-post",
                            {
                                dairy: dairy,
                                user: user,
                                assetDairies:
                                    assetDairies || []
                            }
                        ) %>


                    <% } %>


                <% } %>


            <% }); %>



        <!-- =================================================
             EMPTY FEED
        ================================================== -->

        <% } else { %>


            <div
                class="feed-empty-state"
                style="
                    width:100%;
                    padding:30px 20px;
                    text-align:center;
                    color:#7b847e;
                "
            >

                <i
                    class="bi bi-journal-text"
                    aria-hidden="true"
                ></i>


                <p>
                    No updates have been recorded yet.
                </p>

            </div>


        <% } %>


    </section>


</div>



<!-- =====================================================
     UPDATE PAGE JAVASCRIPT
===================================================== -->

<script
    src="/js/update/index.js"
    defer
></script>