<!-- =====================================================
     UPDATE PAGE ASSETS
===================================================== -->

<link
    rel="stylesheet"
    href="/css/update/update.css"
>

<script src="/socket.io/socket.io.js"></script>


<!-- =====================================================
     UPDATE PAGE
===================================================== -->

<div class="dairy-page">


    <!-- =================================================
         PAGE ACTION BAR

         The View Assets button belongs to the parent page
         and is positioned at the top-right.

         The button controls the asset sidebar defined in:

             views/dairy/assetBar.ejs
    ================================================== -->

    <div class="dairy-page-actions">


        <button
            type="button"
            id="viewPropertyButton"
            class="asset-bar-trigger"
            aria-controls="assetBar"
            aria-expanded="false"
        >


            <span
                class="asset-bar-trigger-icon"
                aria-hidden="true"
            >
                ◉
            </span>


            <span class="asset-bar-trigger-text">
                View Assets
            </span>


        </button>


    </div>


    <!-- =================================================
         PROFILE
    ================================================== -->

    <%- include("update/profile-card", {
        dairy: dairy,
        user: user
    }) %>


    <!-- =================================================
         CREATE POST
    ================================================== -->

    <% if (user) { %>


        <%- include("update/create-post", {
            user: user
        }) %>


    <% } %>


    <!-- =================================================
         ASSET BAR

         Contains:

             • Overlay
             • Right-side asset sidebar
             • Animals
             • Structures / Machines / Tools
             • Asset Bar JavaScript

         The View Assets button above controls this
         sidebar through #viewPropertyButton.
    ================================================== -->

    <%- include("dairy/assetBar", {
        dairy: dairy,
        assetDairies: assetDairies || []
    }) %>


    <!-- =================================================
         FEED
    ================================================== -->

    <%- include("update/feed", {
        feed: feed,
        user: user
    }) %>


</div>


<!-- =====================================================
     UPDATE PAGE JAVASCRIPT
     
     IMPORTANT:
     -----------------------------------------------------
     assetBar.ejs already contains its own JavaScript,
     so assetBar.js is NOT loaded separately here.
===================================================== -->

<script
    src="/js/update/index.js"
    defer
></script>