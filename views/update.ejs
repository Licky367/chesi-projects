<!-- =====================================================
     UPDATE PAGE

     FILE:
         views/update.ejs

     PURPOSE:
         Dairy update/feed page.

     STORAGE:
     -----------------------------------------------------
     Feed Store opens the storage facilities belonging
     to the current dairy.

     Route:

         /storage/:id

     where:

         :id = dairy._id

     The storage service/controller will use the Dairy
     document to resolve:

         dairy.code === storage.farmCode

     FEED CONTRACT:
     -----------------------------------------------------
     Every document inside `feed` is called `item`.

     Every feed-card partial receives:

         item: item

     This applies to:

         post.ejs
         milk.ejs
         medical-marked.ejs
         medical-cleared.ejs
         maintenance-marked.ejs
         maintenance-cleared.ejs
         addAsset.ejs

     IMPORTANT:
     -----------------------------------------------------
     No feed card receives:

         update: item

     No feed card expects a variable named:

         update

     The single naming convention is:

         item

     EXCEPTION:
     -----------------------------------------------------
     stock-update.ejs deliberately expects:

         update

     Therefore animalFeed items are passed as:

         update: item

     stock.ejs is deliberately NOT rendered here.

     ASSET CARDS:
     -----------------------------------------------------
     asset-cards.ejs is a FIXED PAGE COMPONENT.

     It appears immediately below:

         h1.ejs

     It does NOT depend on feed position.

     It is NOT inserted inside the feed loop.

     ANIMAL FEED UPDATE CARDS:
     -----------------------------------------------------
     feed-update-cards.ejs is an independent navigation
     component.

     It does NOT require feed data from the backend.

===================================================== -->


<!-- =====================================================
     UPDATE PAGE ASSETS
===================================================== -->

<link
    rel="stylesheet"
    href="/css/update/update.css"
>

<script
    src="/socket.io/socket.io.js"
></script>



<!-- =====================================================
     UPDATE PAGE
===================================================== -->

<div class="dairy-page">


    <!-- =================================================
         TOP PAGE ACTIONS

         THREE EQUAL BUTTON SPACES
    ================================================== -->

    <div class="dairy-page-actions">


        <!-- =============================================
             ADD ASSETS

             ADMIN ONLY
        ============================================== -->

        <% if (user && user.role === "admin") { %>

            <a
                href="/networth/structure/<%= dairy._id %>/add"
                class="asset-bar-trigger top-page-action"
            >

                <span
                    class="asset-bar-trigger-icon"
                    aria-hidden="true"
                >
                    +
                </span>

                <span class="asset-bar-trigger-text">
                    Add Assets
                </span>

            </a>

        <% } else { %>

            <span
                class="top-page-action-placeholder"
                aria-hidden="true"
            ></span>

        <% } %>



        <!-- =============================================
             VIEW ASSETS
        ============================================== -->

        <button
            type="button"
            id="viewPropertyButton"
            class="asset-bar-trigger top-page-action"
            aria-controls="assetBar"
            aria-expanded="false"
        >

            <span
                class="asset-bar-trigger-icon"
                aria-hidden="true"
            >
                ◉
            </span>

            <span class="asset-bar-trigger-text">
                View Assets
            </span>

        </button>



        <!-- =============================================
             FEED STORE

             CURRENT DAIRY STORAGE

             Route:

                 /storage/:id

             ID:

                 dairy._id
        ============================================== -->

        <a
            href="/storage/<%= dairy._id %>"
            class="asset-bar-trigger top-page-action"
            title="View Feed Store"
        >

            <span
                class="asset-bar-trigger-icon"
                aria-hidden="true"
            >
                📦
            </span>

            <span class="asset-bar-trigger-text">
                STORAGE
            </span>

        </a>


    </div>



    <!-- =================================================
         TOP ACTION LAYOUT

         Keeps all three spaces equal without changing
         the surrounding page layout.
    ================================================== -->

    <style>

        .dairy-page-actions {

            width: 100%;

            display: grid;

            grid-template-columns:
                repeat(3, minmax(0, 1fr));

            align-items: stretch;

            gap: 8px;

            margin-bottom: 12px;

            box-sizing: border-box;

        }


        .dairy-page-actions > .top-page-action,
        .dairy-page-actions > .top-page-action-placeholder {

            width: 100%;

            min-width: 0;

            max-width: 100%;

            box-sizing: border-box;

        }


        .dairy-page-actions
        .top-page-action {

            min-height: 42px;

            margin: 0;

            padding: 7px 8px;

            display: flex;

            align-items: center;

            justify-content: center;

            gap: 5px;

            text-align: center;

            white-space: nowrap;

            overflow: hidden;

            text-decoration: none;

            box-sizing: border-box;

        }


        .dairy-page-actions
        .top-page-action
        .asset-bar-trigger-text {

            min-width: 0;

            overflow: hidden;

            text-overflow: ellipsis;

            white-space: nowrap;

        }


        .dairy-page-actions
        .top-page-action
        .asset-bar-trigger-icon {

            flex: 0 0 auto;

        }


        .top-page-action-placeholder {

            min-height: 42px;

            visibility: hidden;

        }


        /* =================================================
           MOBILE
        ================================================== */

        @media (max-width: 600px) {

            .dairy-page-actions {

                grid-template-columns:
                    repeat(3, minmax(0, 1fr));

                gap: 5px;

            }


            .dairy-page-actions
            .top-page-action {

                min-height: 40px;

                padding: 6px 4px;

                gap: 3px;

                font-size: 10px;

            }


            .dairy-page-actions
            .asset-bar-trigger-icon {

                font-size: 13px;

            }


            .dairy-page-actions
            .asset-bar-trigger-text {

                font-size: 9px;

            }

        }


        /* =================================================
           VERY SMALL SCREENS
        ================================================== */

        @media (max-width: 380px) {

            .dairy-page-actions {

                gap: 4px;

            }


            .dairy-page-actions
            .top-page-action {

                padding: 6px 2px;

            }


            .dairy-page-actions
            .asset-bar-trigger-icon {

                font-size: 12px;

            }


            .dairy-page-actions
            .asset-bar-trigger-text {

                font-size: 8px;

            }

        }

    </style>



    <!-- =================================================
         FIXED CREATE POST

         ALWAYS FIRST
    ================================================== -->

    <%- include("update/create-post", {
        dairy: dairy,
        user: user,
        assetDairies: assetDairies || []
    }) %>



    <!-- =================================================
         FIXED H1

         ALWAYS SECOND
    ================================================== -->

    <%- include("update/h1", {
        dairy: dairy,
        user: user
    }) %>



    <!-- =================================================
         FIXED ASSET CARDS

         ALWAYS DIRECTLY BELOW H1

         IMPORTANT:
         -------------------------------------------------
         asset-cards.ejs is NOT part of the feed loop.

         It is rendered exactly once here.

         Therefore its position is always:

             create-post
                    ↓
                 h1.ejs
                    ↓
             asset-cards.ejs
                    ↓
              itemLink.ejs
                    ↓
                assetBar
                    ↓
                  feed
    ================================================== -->

    <%- include(
        "update/asset-cards",
        {
            dairy: dairy,
            assetDairies: assetDairies || []
        }
    ) %>



    <!-- =================================================
         ANIMAL FEED ITEM LINKS

         Appears directly below asset-cards.ejs.

         The controller passes the generated item links
         through:

             itemLinks

         The itemLink.ejs component renders the
         horizontally scrollable cards.
    ================================================== -->

    <%- include("update/storage/itemLink", {
        dairy: dairy,
        user: user,
        itemLinks: itemLinks || []
    }) %>



    <!-- =================================================
         ASSET SIDEBAR
    ================================================== -->

    <%- include("dairy/assetBar", {
        dairy: dairy,
        assetDairies: assetDairies || []
    }) %>



    <!-- =================================================
         MAIN FEED
    ================================================= -->

    <section
        id="feed"
        class="feed-container"
    >


        <!-- =================================================
             FEED EXISTS
        ================================================== -->

        <% if (Array.isArray(feed) && feed.length > 0) { %>


            <!-- =================================================
                 FEED LOOP

                 IMPORTANT:
                 -------------------------------------------------
                 Only actual feed documents are rendered here.

                 asset-cards.ejs is deliberately NOT rendered
                 inside this loop.

                 create-post.ejs is also deliberately NOT
                 rendered inside this loop.

                 This keeps the fixed page components separate
                 from the feed data.
            ================================================== -->

            <% feed.forEach(function(item, index) { %>


                <!-- =================================================
                     NORMAL POST

                     CONTRACT:
                         item: item
                ================================================== -->

                <% if (item.type === "post") { %>

                    <%- include(
                        "update/post",
                        {
                            item: item,
                            user: user
                        }
                    ) %>

                <% } %>



                <!-- =================================================
                     WEEKLY MILK REPORT

                     CONTRACT:
                         item: item
                ================================================== -->

                <% if (item.type === "milk") { %>

                    <%- include(
                        "update/milk",
                        {
                            item: item,
                            user: user
                        }
                    ) %>

                <% } %>



                <!-- =================================================
                     MEDICAL — MARKED

                     CONTRACT:
                         item: item
                ================================================== -->

                <% if (
                    item.type === "medical" &&
                    item.status === "marked"
                ) { %>

                    <%- include(
                        "update/medical-marked",
                        {
                            item: item,
                            user: user
                        }
                    ) %>

                <% } %>



                <!-- =================================================
                     MEDICAL — CLEARED

                     CONTRACT:
                         item: item
                ================================================== -->

                <% if (
                    item.type === "medical" &&
                    item.status === "cleared"
                ) { %>

                    <%- include(
                        "update/medical-cleared",
                        {
                            item: item,
                            user: user
                        }
                    ) %>

                <% } %>



                <!-- =================================================
                     MAINTENANCE — MARKED

                     CONTRACT:
                         item: item
                ================================================== -->

                <% if (
                    item.type === "maintenance" &&
                    item.status === "marked"
                ) { %>

                    <%- include(
                        "update/maintenance-marked",
                        {
                            item: item,
                            user: user
                        }
                    ) %>

                <% } %>



                <!-- =================================================
                     MAINTENANCE — CLEARED

                     CONTRACT:
                         item: item
                ================================================== -->

                <% if (
                    item.type === "maintenance" &&
                    item.status === "cleared"
                ) { %>

                    <%- include(
                        "update/maintenance-cleared",
                        {
                            item: item,
                            user: user
                        }
                    ) %>

                <% } %>



                <!-- =================================================
                     STOCK UPDATE

                     CONTRACT:
                         update: item

                     stock-update.ejs expects:

                         update

                     This is the intentional exception to the
                     normal feed-card contract.
                ================================================== -->

                <% if (item.type === "animalFeed") { %>

                    <%- include(
                        "update/stock-update",
                        {
                            update: item,
                            user: user
                        }
                    ) %>

                <% } %>



                <!-- =================================================
                     ASSET ADDED

                     CONTRACT:
                         item: item
                ================================================== -->

                <% if (item.type === "assetAdd") { %>

                    <%- include(
                        "update/addAsset",
                        {
                            item: item,
                            user: user
                        }
                    ) %>

                <% } %>


            <% }); %>



        <!-- =================================================
             EMPTY FEED
        ================================================== -->

        <% } else { %>


            <div
                class="feed-empty-state"
                style="
                    width:100%;
                    padding:30px 20px;
                    text-align:center;
                    color:#7b847e;
                "
            >

                <i
                    class="bi bi-journal-text"
                    aria-hidden="true"
                ></i>


                <p>
                    No updates have been recorded yet.
                </p>

            </div>


        <% } %>


    </section>


</div>



<!-- =====================================================
     UPDATE PAGE JAVASCRIPT
===================================================== -->

<script
    src="/js/update/index.js"
    defer
></script>