                                <td>

                                    <div class="farm-name">

                                        <span class="farm-dot"></span>

                                        <strong>
                                            <%= farm.name %>
                                        </strong>

                                    </div>

                                </td>


                                <td>

                                    <span class="liter-value">
                                        <%= farm.produced.toFixed(2) %> L
                                    </span>

                                </td>

                            </tr>

                        <% }); %>


                        <tr class="total-row">

                            <td>
                                Total Production
                            </td>

                            <td>
                                <%= totalProduction.toFixed(2) %> L
                            </td>

                        </tr>

                    </tbody>

                </table>

            </div>

        <% } %>

    </section>



    <!-- =====================================================
         SELL MILK
    ====================================================== -->

    <section class="milk-card">

        <div class="section-heading">

            <div class="section-heading-left">

                <div class="section-kicker">
                    Transaction
                </div>

                <h2>
                    Sell Milk
                </h2>

                <p>
