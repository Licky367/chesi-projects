"views/milk/milksales.ejs"

<!-- =========================================================
     MILK SALES
     FILE: views/milk/milksales.ejs

     PURPOSE:
         Daily milk production, available milk and sales.

     DESIGN:
         Modern green + warm orange agricultural theme.

     FUNCTIONALITY:
         - Admin can update milk price.
         - Displays visible farm production.
         - Calculates milk already sold per farm.
         - Calculates available milk.
         - Allows sales across multiple farms.
         - Prevents duplicate farm allocations.
         - Prevents allocation above available milk.
         - Requires allocation to exactly equal requested liters.
========================================================= -->

<%
    // ========================================================
    // SAFE USER
    // ========================================================

    const pageUser =
        typeof user !== "undefined" && user
            ? user
            : null;


    const pageIsAdmin =
        Boolean(
            pageUser &&
            pageUser.role === "admin"
        );


    // ========================================================
    // MESSAGES
    // ========================================================

    const pageSuccess =
        typeof success !== "undefined" && success
            ? success
            : "";


    const pageError =
        typeof error !== "undefined" && error
            ? error
            : "";


    // ========================================================
    // SUMMARY
    // ========================================================

    const pageSummary =
        typeof summary !== "undefined" && summary
            ? summary
            : null;


    const pageDay =
        pageSummary?.day ||
        new Date()
            .toISOString()
            .slice(0, 10);


    const pagePrice =
        Number.isFinite(
            Number(pageSummary?.price)
        )
            ? Number(pageSummary.price)
            : 50;


    // ========================================================
    // VISIBLE FARMS
    // ========================================================

    const pageFarms =
        Array.isArray(farms)
            ? farms
            : [];


    const farmProduction =
        Array.isArray(
            pageSummary?.farmProduction
        )
            ? pageSummary.farmProduction
            : [];


    const sales =
        Array.isArray(
            pageSummary?.sales
        )
            ? pageSummary.sales
            : [];


    // ========================================================
    // FARM SALES MAP
    // ========================================================

    const farmSalesMap =
        new Map();


    sales.forEach(
        sale => {

            if (
                !sale ||
                !Array.isArray(
                    sale.farmAllocations
                )
            ) {
                return;
            }


            sale.farmAllocations.forEach(
                allocation => {

                    if (
                        !allocation ||
                        !allocation.farm
                    ) {
                        return;
                    }


                    const farmId =
                        allocation.farm.toString();


                    const liters =
                        Number(
                            allocation.liters
                        );


                    if (
                        !Number.isFinite(liters) ||
                        liters < 0
                    ) {
                        return;
                    }


                    farmSalesMap.set(

                        farmId,

                        (
                            farmSalesMap.get(
                                farmId
                            ) || 0
                        ) + liters

                    );

                }
            );

        }
    );


    // ========================================================
    // VISIBLE FARM DATA
    // ========================================================

    const visibleFarmData =
        pageFarms.map(
            farm => {

                const farmId =
                    farm?._id
                        ? farm._id.toString()
                        : "";


                const productionEntry =
                    farmProduction.find(
                        entry =>
                            entry?.farm &&
                            entry.farm.toString() ===
                                farmId
                    );


                const produced =
                    Number.isFinite(
                        Number(
                            productionEntry?.liters
                        )
                    )
                        ? Number(
                            productionEntry.liters
                        )
                        : 0;


                const sold =
                    Number(
                        farmSalesMap.get(
                            farmId
                        )
                    ) || 0;


                const available =
                    Math.max(
                        0,
                        produced - sold
                    );


                return {

                    _id:
                        farm._id,

                    name:
                        farm.name ||
                        "Unnamed Farm",

                    produced,

                    sold,

                    available

                };

            }
        );


    // ========================================================
    // TOTALS
    // ========================================================

    const totalProduction =
        visibleFarmData.reduce(

            (total, farm) =>

                total +
                farm.produced,

            0

        );


    const totalAvailable =
        visibleFarmData.reduce(

            (total, farm) =>

                total +
                farm.available,

            0

        );

%>


<link
    rel="stylesheet"
    href="/css/milk/milksales.css"
>


<div
    class="milk-sales-page"
    data-price="<%= pagePrice %>"
>


    <!-- =====================================================
         HEADER
    ====================================================== -->

    <header class="page-header">

        <div class="header-content">

            <span class="header-kicker">
                DAILY MILK MANAGEMENT
            </span>

            <h1>
                Milk Sales
            </h1>

            <p>
                Manage today's farm production,
                available milk and customer sales.
            </p>

        </div>

        <div class="header-date">

            <span>
                Sales Day
            </span>

            <strong>
                <%= pageDay %>
            </strong>

        </div>

    </header>



    <!-- =====================================================
         MESSAGES
    ====================================================== -->

    <% if (pageSuccess) { %>

        <div class="message success">

            <span class="message-icon">
                ✓
            </span>

            <div>
                <strong>
                    Sale Updated
                </strong>

                <p>
                    <%= pageSuccess %>
                </p>
            </div>

        </div>

    <% } %>


    <% if (pageError) { %>

        <div class="message error">

            <span class="message-icon">
                !
            </span>

            <div>
                <strong>
                    Something went wrong
                </strong>

                <p>
                    <%= pageError %>
                </p>
            </div>

        </div>

    <% } %>



    <!-- =====================================================
         QUICK SUMMARY
    ====================================================== -->

    <section class="overview-grid">

        <div class="overview-card">

            <div class="overview-icon green">
                🥛
            </div>

            <div>

                <span>
                    Total Production
                </span>

                <strong>
                    <%= totalProduction.toFixed(2) %>
                    <small>L</small>
                </strong>

            </div>

        </div>


        <div class="overview-card">

            <div class="overview-icon orange">
                ◉
            </div>

            <div>

                <span>
                    Available for Sale
                </span>

                <strong>
                    <%= totalAvailable.toFixed(2) %>
                    <small>L</small>
                </strong>

            </div>

        </div>


        <div class="overview-card">

            <div class="overview-icon green">
                KSh
            </div>

            <div>

                <span>
                    Price Per Liter
                </span>

                <strong>
                    <%= pagePrice.toFixed(2) %>
                </strong>

            </div>

        </div>

    </section>



    <!-- =====================================================
         ADMIN PRICE CARD
    ====================================================== -->

    <% if (pageIsAdmin) { %>

        <section class="milk-card price-card">

            <div class="section-heading">

                <div>

                    <span class="section-label">
                        ADMINISTRATION
                    </span>

                    <h2>
                        Milk Price
                    </h2>

                    <p>
                        Set the selling price used for today's
                        milk transactions.
                    </p>

                </div>

                <div class="section-icon orange">
                    KSh
                </div>

            </div>


            <form
                action="/milk/sales/price"
                method="POST"
                class="price-form"
            >

                <input
                    type="hidden"
                    name="day"
                    value="<%= pageDay %>"
                >


                <div class="form-group">

                    <label for="price">
                        Price Per Liter
                    </label>

                    <div class="input-prefix">

                        <span>
                            KSh
                        </span>

                        <input
                            type="number"
                            id="price"
                            name="price"
                            class="form-control"
                            min="0"
                            step="0.01"
                            value="<%= pagePrice %>"
                            required
                        >

                    </div>

                </div>


                <button
                    type="submit"
                    class="milk-button"
                >
                    Update Price
                </button>

            </form>

        </section>

    <% } %>



    <!-- =====================================================
         FARM PRODUCTION
    ====================================================== -->

    <section class="milk-card">

        <div class="section-heading">

            <div>

                <span class="section-label">
                    PRODUCTION
                </span>

                <h2>
                    Farm Production
                </h2>

                <p>
                    Milk produced by each visible farm today.
                </p>

            </div>

            <div class="section-icon green">
                🥛
            </div>

        </div>


        <% if (visibleFarmData.length === 0) { %>

            <div class="empty-state">

                <div class="empty-icon">
                    🥛
                </div>

                <strong>
                    No farm production
                </strong>

                <p>
                    No farm production is available for this day.
                </p>

            </div>

        <% } else { %>

            <div class="table-wrapper">

                <table class="milk-table">

                    <thead>

                        <tr>

                            <th>
                                Farm
                            </th>

                            <th>
                                Production
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        <% visibleFarmData.forEach(function(farm) { %>

                            <tr>

                                <td>

                                    <div class="farm-name">

                                        <span class="farm-dot"></span>

                                        <strong>
                                            <%= farm.name %>
                                        </strong>

                                    </div>

                                </td>


                                <td>

                                    <span class="liter-value">
                                        <%= farm.produced.toFixed(2) %>
                                        L
                                    </span>

                                </td>

                            </tr>

                        <% }); %>


                        <tr class="total-row">

                            <td>

                                <strong>
                                    Total Production
                                </strong>

                            </td>

                            <td>

                                <strong>
                                    <%= totalProduction.toFixed(2) %>
                                    L
                                </strong>

                            </td>

                        </tr>

                    </tbody>

                </table>

            </div>

        <% } %>

    </section>



    <!-- =====================================================
         SELL MILK
    ====================================================== -->

    <section class="milk-card sale-card">

        <div class="section-heading">

            <div>

                <span class="section-label">
                    TRANSACTION
                </span>

                <h2>
                    Sell Milk
                </h2>

                <p>
                    Record a customer sale and allocate the milk
                    to the supplying farm or farms.
                </p>

            </div>

            <div class="section-icon orange">
                +
            </div>

        </div>


        <% if (visibleFarmData.length === 0) { %>

            <div class="empty-state">

                <div class="empty-icon">
                    🥛
                </div>

                <strong>
                    No milk available
                </strong>

                <p>
                    No milk-producing farms are available for sale.
                </p>

            </div>

        <% } else { %>


            <form
                action="/milk/sales/sell"
                method="POST"
                id="milkSaleForm"
            >

                <input
                    type="hidden"
                    name="day"
                    value="<%= pageDay %>"
                >


                <!-- =========================================
                     CUSTOMER DETAILS
                ========================================== -->

                <div class="subsection">

                    <div class="subsection-heading">

                        <span class="step-number">
                            01
                        </span>

                        <div>

                            <h3>
                                Customer Details
                            </h3>

                            <p>
                                Enter the customer's information
                                and required quantity.
                            </p>

                        </div>

                    </div>


                    <div class="sales-grid">


                        <div class="form-group">

                            <label for="customerName">
                                Customer Name
                            </label>

                            <input
                                type="text"
                                id="customerName"
                                name="customerName"
                                class="form-control"
                                placeholder="Enter customer name"
                                autocomplete="name"
                                required
                            >

                        </div>


                        <div class="form-group">

                            <label for="saleLiters">
                                Milk Required
                            </label>

                            <div class="input-suffix">

                                <input
                                    type="number"
                                    id="saleLiters"
                                    name="liters"
                                    class="form-control"
                                    min="0.01"
                                    step="0.01"
                                    placeholder="0.00"
                                    required
                                >

                                <span>
                                    L
                                </span>

                            </div>

                        </div>


                        <div class="form-group">

                            <label>
                                Price Per Liter
                            </label>

                            <div class="input-prefix">

                                <span>
                                    KSh
                                </span>

                                <input
                                    type="text"
                                    class="form-control"
                                    value="<%= pagePrice.toFixed(2) %>"
                                    readonly
                                >

                            </div>

                        </div>


                    </div>

                </div>



                <!-- =========================================
                     FARM ALLOCATION
                ========================================== -->

                <div class="subsection allocation-subsection">

                    <div class="subsection-heading">

                        <span class="step-number orange-step">
                            02
                        </span>

                        <div>

                            <h3>
                                Farm Allocation
                            </h3>

                            <p>
                                Select which farm or farms are
                                supplying this customer's milk.
                            </p>

                        </div>

                    </div>


                    <div class="allocation-topbar">

                        <div>

                            <span>
                                Total milk available
                            </span>

                            <strong id="totalAvailable">

                                <%= totalAvailable.toFixed(2) %> L

                            </strong>

                        </div>

                    </div>


                    <div id="allocationContainer">

                        <div class="allocation-row">

                            <div class="form-group">

                                <label>
                                    Farm
                                </label>

                                <select
                                    name="allocations[0][farm]"
                                    class="form-control farm-select"
                                    required
                                >

                                    <option value="">
                                        Select supplying farm
                                    </option>


                                    <% visibleFarmData.forEach(function(farm) { %>

                                        <option
                                            value="<%= farm._id %>"
                                            data-available="<%= farm.available %>"
                                        >

                                            <%= farm.name %>
                                            —
                                            <%= farm.available.toFixed(2) %>
                                            L available

                                        </option>

                                    <% }); %>

                                </select>

                            </div>


                            <div class="form-group">

                                <label>
                                    Liters
                                </label>

                                <div class="input-suffix">

                                    <input
                                        type="number"
                                        name="allocations[0][liters]"
                                        class="form-control allocation-liters"
                                        min="0.01"
                                        step="0.01"
                                        placeholder="0.00"
                                        required
                                    >

                                    <span>
                                        L
                                    </span>

                                </div>

                            </div>

                        </div>

                    </div>


                    <button
                        type="button"
                        class="milk-button secondary-button"
                        id="addFarmButton"
                    >

                        <span class="plus-symbol">
                            +
                        </span>

                        Add Another Farm

                    </button>

                </div>



                <!-- =========================================
                     SALE SUMMARY
                ========================================== -->

                <div class="sale-summary">

                    <div class="summary-item">

                        <span>
                            Customer Requires
                        </span>

                        <strong id="requiredLiters">
                            0.00 L
                        </strong>

                    </div>


                    <div class="summary-item">

                        <span>
                            Allocated
                        </span>

                        <strong id="allocatedLiters">
                            0.00 L
                        </strong>

                    </div>


                    <div class="summary-item cash-row">

                        <span>
                            Total Cash
                        </span>

                        <strong>

                            KSh
                            <span id="saleCash">
                                0.00
                            </span>

                        </strong>

                    </div>

                </div>



                <!-- =========================================
                     FORM ACTION
                ========================================== -->

                <div class="form-action">

                    <button
                        type="submit"
                        class="milk-button complete-button"
                    >

                        Complete Sale

                        <span>
                            →
                        </span>

                    </button>

                </div>


            </form>

        <% } %>

    </section>


</div>



<script>

document.addEventListener(
    "DOMContentLoaded",
    function() {

        const form =
            document.getElementById(
                "milkSaleForm"
            );


        if (!form) {

            return;

        }


        const page =
            document.querySelector(
                ".milk-sales-page"
            );


        const price =
            Number(
                page.dataset.price
            ) || 0;


        const container =
            document.getElementById(
                "allocationContainer"
            );


        const addButton =
            document.getElementById(
                "addFarmButton"
            );


        const saleLitersInput =
            document.getElementById(
                "saleLiters"
            );


        const requiredOutput =
            document.getElementById(
                "requiredLiters"
            );


        const allocatedOutput =
            document.getElementById(
                "allocatedLiters"
            );


        const cashOutput =
            document.getElementById(
                "saleCash"
            );


        // ==================================================
        // UPDATE SUMMARY
        // ==================================================

        function updateSummary() {

            const required =
                Number(
                    saleLitersInput.value
                ) || 0;


            let allocated =
                0;


            form
                .querySelectorAll(
                    ".allocation-liters"
                )
                .forEach(
                    input => {

                        allocated +=
                            Number(
                                input.value
                            ) || 0;

                    }
                );


            requiredOutput.textContent =
                required.toFixed(2) +
                " L";


            allocatedOutput.textContent =
                allocated.toFixed(2) +
                " L";


            cashOutput.textContent =
                (
                    required *
                    price
                ).toFixed(2);


            updateAllocationState(
                required,
                allocated
            );

        }


        // ==================================================
        // ALLOCATION STATE
        // ==================================================

        function updateAllocationState(
            required,
            allocated
        ) {

            const difference =
                required -
                allocated;


            if (
                required > 0 &&
                Math.abs(difference) < 0.001
            ) {

                allocatedOutput.classList.add(
                    "summary-complete"
                );

            } else {

                allocatedOutput.classList.remove(
                    "summary-complete"
                );

            }

        }


        // ==================================================
        // BIND ROW
        // ==================================================

        function bindRow(
            row
        ) {

            const select =
                row.querySelector(
                    ".farm-select"
                );


            const input =
                row.querySelector(
                    ".allocation-liters"
                );


            select.addEventListener(
                "change",
                function() {

                    const option =
                        select.options[
                            select.selectedIndex
                        ];


                    const available =
                        Number(
                            option.dataset.available
                        ) || 0;


                    input.max =
                        available;


                    input.placeholder =
                        available > 0
                            ? "Max " +
                              available.toFixed(2)
                            : "0.00";


                    updateFarmOptions();

                    updateSummary();

                }
            );


            input.addEventListener(
                "input",
                updateSummary
            );

        }


        // ==================================================
        // PREVENT SAME FARM FROM BEING SELECTED
        // ==================================================

        function updateFarmOptions() {

            const selectedValues =
                Array.from(
                    container.querySelectorAll(
                        ".farm-select"
                    )
                )
                .map(
                    select =>
                        select.value
                )
                .filter(
                    value =>
                        value
                );


            container
                .querySelectorAll(
                    ".farm-select"
                )
                .forEach(
                    currentSelect => {

                        const currentValue =
                            currentSelect.value;


                        Array.from(
                            currentSelect.options
                        )
                        .forEach(
                            option => {

                                if (
                                    !option.value
                                ) {

                                    return;

                                }


                                option.disabled =
                                    selectedValues.includes(
                                        option.value
                                    ) &&
                                    option.value !==
                                        currentValue;

                            }
                        );

                    }
                );

        }


        // ==================================================
        // INITIAL BINDING
        // ==================================================

        container
            .querySelectorAll(
                ".allocation-row"
            )
            .forEach(
                bindRow
            );


        saleLitersInput.addEventListener(
            "input",
            updateSummary
        );


        // ==================================================
        // ADD FARM
        // ==================================================

        addButton.addEventListener(
            "click",
            function() {

                const rows =
                    container.querySelectorAll(
                        ".allocation-row"
                    );


                const index =
                    rows.length;


                const firstRow =
                    rows[0];


                if (!firstRow) {

                    return;

                }


                const row =
                    firstRow.cloneNode(
                        true
                    );


                const select =
                    row.querySelector(
                        ".farm-select"
                    );


                const input =
                    row.querySelector(
                        ".allocation-liters"
                    );


                select.name =
                    `allocations[${index}][farm]`;


                input.name =
                    `allocations[${index}][liters]`;


                select.value =
                    "";


                input.value =
                    "";


                input.placeholder =
                    "0.00";


                input.removeAttribute(
                    "max"
                );


                container.appendChild(
                    row
                );


                bindRow(
                    row
                );


                updateFarmOptions();

                updateSummary();

            }
        );


        // ==================================================
        // SUBMIT VALIDATION
        // ==================================================

        form.addEventListener(
            "submit",
            function(event) {

                const required =
                    Number(
                        saleLitersInput.value
                    ) || 0;


                if (
                    required <= 0
                ) {

                    event.preventDefault();

                    alert(
                        "Enter the amount of milk required."
                    );

                    saleLitersInput.focus();

                    return;

                }


                let allocated =
                    0;


                const usedFarms =
                    new Set();


                for (
                    const row
                    of container.querySelectorAll(
                        ".allocation-row"
                    )
                ) {

                    const select =
                        row.querySelector(
                            ".farm-select"
                        );


                    const input =
                        row.querySelector(
                            ".allocation-liters"
                        );


                    const farmId =
                        select.value;


                    const liters =
                        Number(
                            input.value
                        ) || 0;


                    if (
                        !farmId ||
                        liters <= 0
                    ) {

                        event.preventDefault();

                        alert(
                            "Every allocation requires a farm and liters."
                        );

                        return;

                    }


                    if (
                        usedFarms.has(
                            farmId
                        )
                    ) {

                        event.preventDefault();

                        alert(
                            "The same farm cannot be allocated twice."
                        );

                        return;

                    }


                    usedFarms.add(
                        farmId
                    );


                    const option =
                        select.options[
                            select.selectedIndex
                        ];


                    const available =
                        Number(
                            option.dataset.available
                        ) || 0;


                    if (
                        liters > available
                    ) {

                        event.preventDefault();

                        alert(
                            "Allocated liters exceed the available milk for a selected farm."
                        );

                        return;

                    }


                    allocated +=
                        liters;

                }


                if (
                    Math.abs(
                        allocated -
                        required
                    ) > 0.001
                ) {

                    event.preventDefault();

                    alert(
                        "The total allocated milk must exactly equal the customer's required milk."
                    );

                    return;

                }

            }
        );


        // ==================================================
        // INITIAL STATE
        // ==================================================

        updateFarmOptions();

        updateSummary();

    }
);

</script>

"public/css/milk/milksales.css"

/* =========================================================
