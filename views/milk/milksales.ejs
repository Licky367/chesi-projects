<%
    // ========================================================
    // SAFE USER
    // ========================================================

    const pageUser =
        typeof user !== "undefined" && user
            ? user
            : null;

    const pageIsAdmin =
        Boolean(
            pageUser &&
            pageUser.role === "admin"
        );


    // ========================================================
    // MESSAGES
    // ========================================================

    const pageSuccess =
        typeof success !== "undefined" && success
            ? success
            : "";

    const pageError =
        typeof error !== "undefined" && error
            ? error
            : "";


    // ========================================================
    // SUMMARY
    // ========================================================

    const pageSummary =
        typeof summary !== "undefined" && summary
            ? summary
            : null;

    const pageDay =
        pageSummary?.day ||
        new Date()
            .toISOString()
            .slice(0, 10);

    const pagePrice =
        Number.isFinite(
            Number(pageSummary?.price)
        )
            ? Number(pageSummary.price)
            : 50;


    // ========================================================
    // FARMS
    // ========================================================

    const pageFarms =
        Array.isArray(farms)
            ? farms
            : [];

    const farmProduction =
        Array.isArray(
            pageSummary?.farmProduction
        )
            ? pageSummary.farmProduction
            : [];

    const sales =
        Array.isArray(
            pageSummary?.sales
        )
            ? pageSummary.sales
            : [];


    // ========================================================
    // FARM SALES MAP
    // ========================================================

    const farmSalesMap =
        new Map();

    sales.forEach(
        sale => {

            if (
                !sale ||
                !Array.isArray(
                    sale.farmAllocations
                )
            ) {
                return;
            }

            sale.farmAllocations.forEach(
                allocation => {

                    if (
                        !allocation ||
                        !allocation.farm
                    ) {
                        return;
                    }

                    const farmId =
                        allocation.farm.toString();

                    const liters =
                        Number(
                            allocation.liters
                        );

                    if (
                        !Number.isFinite(liters) ||
                        liters < 0
                    ) {
                        return;
                    }

                    farmSalesMap.set(
                        farmId,
                        (
                            farmSalesMap.get(farmId) ||
                            0
                        ) + liters
                    );
                }
            );
        }
    );


    // ========================================================
    // VISIBLE FARM DATA
    // ========================================================

    const visibleFarmData =
        pageFarms.map(
            farm => {

                const farmId =
                    farm?._id
                        ? farm._id.toString()
                        : "";

                const productionEntry =
                    farmProduction.find(
                        entry =>
                            entry?.farm &&
                            entry.farm.toString() ===
                                farmId
                    );

                const produced =
                    Number.isFinite(
                        Number(
                            productionEntry?.liters
                        )
                    )
                        ? Number(
                            productionEntry.liters
                        )
                        : 0;

                const sold =
                    Number(
                        farmSalesMap.get(
                            farmId
                        )
                    ) || 0;

                const available =
                    Math.max(
                        0,
                        produced - sold
                    );

                return {
                    _id: farm._id,
                    name:
                        farm.name ||
                        "Unnamed Farm",
                    produced,
                    sold,
                    available
                };
            }
        );


    // ========================================================
    // TOTALS
    // ========================================================

    const totalProduction =
        visibleFarmData.reduce(
            (total, farm) =>
                total + farm.produced,
            0
        );

    const totalAvailable =
        visibleFarmData.reduce(
            (total, farm) =>
                total + farm.available,
            0
        );
%>


