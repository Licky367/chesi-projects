                            </label>

                            <input
                                type="text"
                                id="customerName"
                                name="customerName"
                                class="form-control"
                                placeholder="Enter customer name"
                                required
                            >

                        </div>


                        <div class="form-group">

                            <label for="saleLiters">
                                Milk Required
                            </label>

                            <div style="position:relative;">

                                <input
                                    type="number"
                                    id="saleLiters"
                                    name="liters"
                                    class="form-control"
                                    min="0.01"
                                    step="0.01"
                                    placeholder="0.00"
                                    style="padding-right:42px;"
                                    required
                                >

                                <span
                                    style="
                                        position:absolute;
                                        right:13px;
                                        top:50%;
                                        transform:translateY(-50%);
                                        color:#748078;
                                        font-size:11px;
                                        font-weight:800;
                                        pointer-events:none;
                                    "
                                >
                                    L
                                </span>

                            </div>

                        </div>


                        <div class="form-group">

                            <label>
                                Price Per Liter
                            </label>

                            <div style="position:relative;">

                                <span
                                    style="
                                        position:absolute;
                                        left:13px;
                                        top:50%;
                                        transform:translateY(-50%);
                                        color:#2e7b4d;
                                        font-size:11px;
                                        font-weight:850;
                                        pointer-events:none;
                                        z-index:2;
                                    "
                                >
                                    KSh
                                </span>

                                <input
                                    type="text"
                                    class="form-control"
                                    value="<%= pagePrice.toFixed(2) %>"
                                    readonly
                                    style="padding-left:48px;"
                                >

                            </div>

                        </div>

                    </div>

                </div>



                <!-- =========================================
                     STEP 02
                ========================================== -->

                <div class="sales-step">

                    <div class="step-heading">

                        <div class="step-number orange">
                            02
                        </div>

                        <div>

                            <h3>
                                Farm Allocation
                            </h3>

                            <p>
                                Select which farm or farms are
                                supplying this customer's milk.
                            </p>

                        </div>

                    </div>


                    <div class="allocation-heading">

                        <div>

                            <h3>
                                Milk Source
                            </h3>

                            <p>
                                Each farm can only be selected once.
                            </p>

                        </div>


                        <div class="available-pill">

                            <span>
                                Total milk available
                            </span>

                            <strong id="totalAvailable">
                                <%= totalAvailable.toFixed(2) %> L
