            </form>

        <% } %>

    </section>

</div>



<script>

document.addEventListener(
    "DOMContentLoaded",
    function() {

        const form =
            document.getElementById(
                "milkSaleForm"
            );

        if (!form) {
            return;
        }


        const page =
            document.querySelector(
                ".milk-sales-page"
            );


        const price =
            Number(
                page.dataset.price
            ) || 0;


        const container =
            document.getElementById(
                "allocationContainer"
            );


        const addButton =
            document.getElementById(
                "addFarmButton"
            );


        const saleLitersInput =
            document.getElementById(
                "saleLiters"
            );


        const requiredOutput =
            document.getElementById(
                "requiredLiters"
            );


        const allocatedOutput =
            document.getElementById(
                "allocatedLiters"
            );


        const cashOutput =
            document.getElementById(
                "saleCash"
            );


        // ==================================================
        // UPDATE SUMMARY
        // ==================================================

        function updateSummary() {

            const required =
                Number(
                    saleLitersInput.value
                ) || 0;


            let allocated = 0;


            form
                .querySelectorAll(
                    ".allocation-liters"
                )
                .forEach(
                    input => {

                        allocated +=
                            Number(
                                input.value
                            ) || 0;

                    }
                );


            requiredOutput.textContent =
                required.toFixed(2) +
                " L";


            allocatedOutput.textContent =
                allocated.toFixed(2) +
                " L";


            cashOutput.textContent =
                "KSh " +
                (
                    required *
                    price
                ).toFixed(2);

        }


        // ==================================================
        // BIND ALLOCATION ROW
        // ==================================================

        function bindRow(row) {

            const select =
                row.querySelector(
                    ".farm-select"
                );


            const input =
                row.querySelector(
                    ".allocation-liters"
                );


            if (!select || !input) {
                return;
            }


            select.addEventListener(
                "change",
                function() {

                    const option =
                        select.options[
                            select.selectedIndex
                        ];


                    const available =
                        Number(
                            option?.dataset?.available
                        ) || 0;


                    if (available > 0) {

                        input.max =
                            available;

                    } else {

                        input.removeAttribute(
                            "max"
                        );

                    }


                    updateSummary();

                }
            );


            input.addEventListener(
                "input",
                updateSummary
            );

        }


        container
            .querySelectorAll(
                ".allocation-row"
            )
            .forEach(
                bindRow
            );


        saleLitersInput.addEventListener(
            "input",
            updateSummary
        );


        // ==================================================
        // ADD FARM
        // ==================================================

        addButton.addEventListener(
            "click",
            function() {

                const rows =
                    container.querySelectorAll(
                        ".allocation-row"
                    );


                const index =
                    rows.length;


                const firstRow =
                    rows[0];


                if (!firstRow) {
                    return;
                }


                const row =
                    firstRow.cloneNode(
                        true
                    );


                const select =
                    row.querySelector(
                        ".farm-select"
                    );


                const input =
                    row.querySelector(
                        ".allocation-liters"
                    );


                select.name =
                    `allocations[${index}][farm]`;


                input.name =
                    `allocations[${index}][liters]`;


                select.value =
                    "";


                input.value =
                    "";


                input.removeAttribute(
                    "max"
                );


                container.appendChild(
                    row
                );


                bindRow(
                    row
                );


                updateSummary();

            }
        );


        // ==================================================
        // SUBMIT VALIDATION
        // ==================================================

        form.addEventListener(
            "submit",
            function(event) {

                const required =
                    Number(
                        saleLitersInput.value
                    ) || 0;


                let allocated = 0;


                const usedFarms =
                    new Set();


                const rows =
                    container.querySelectorAll(
                        ".allocation-row"
                    );


                for (
                    const row
                    of rows
                ) {

                    const select =
                        row.querySelector(
                            ".farm-select"
                        );


                    const input =
                        row.querySelector(
                            ".allocation-liters"
                        );


                    const farmId =
                        select.value;


                    const liters =
                        Number(
                            input.value
                        ) || 0;


                    if (
                        !farmId ||
                        liters <= 0
                    ) {

                        event.preventDefault();

                        alert(
                            "Every allocation requires a farm and liters."
                        );

                        return;

                    }


                    if (
                        usedFarms.has(
                            farmId
                        )
                    ) {

                        event.preventDefault();

                        alert(
                            "The same farm cannot be allocated twice."
                        );

                        return;

                    }


                    usedFarms.add(
                        farmId
                    );


                    const option =
                        select.options[
                            select.selectedIndex
                        ];


                    const available =
                        Number(
                            option?.dataset?.available
                        ) || 0;


                    if (
                        liters >
                        available
                    ) {

                        event.preventDefault();

                        alert(
                            "Allocated liters exceed the available milk for a selected farm."
                        );

                        return;

                    }


                    allocated +=
                        liters;

                }


                if (
                    required <= 0
                ) {

                    event.preventDefault();

                    alert(
                        "Enter the amount of milk required."
                    );

                    return;

                }


                if (
                    Math.abs(
                        allocated -
                        required
                    ) > 0.001
                ) {

                    event.preventDefault();

                    alert(
                        "The total allocated milk must exactly equal the customer's required milk."
                    );

                    return;

                }


                if (
                    allocated >
                    <%= totalAvailable %>
                ) {

                    event.preventDefault();

                    alert(
                        "The allocated milk exceeds the total milk available."
                    );

                    return;

                }

            }
        );


        // ==================================================
        // INITIAL SUMMARY
        // ==================================================

        updateSummary();

    }
);

</script>