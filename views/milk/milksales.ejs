/* =========================================================
   VARIABLES
========================================================= */

:root {

    --milk-green-950: #153b29;
    --milk-green-900: #1b4b34;
    --milk-green-800: #276342;
    --milk-green-700: #347b50;
    --milk-green-600: #459664;

    --milk-green-100: #e7f2eb;
    --milk-green-50: #f3f8f4;

    --milk-orange-800: #ad541b;
    --milk-orange-700: #c76522;
    --milk-orange-600: #df7629;
    --milk-orange-500: #ed8b3d;

    --milk-orange-100: #fff0e2;
    --milk-orange-50: #fff8f1;

    --milk-text: #203229;
    --milk-muted: #738078;

    --milk-white: #ffffff;
    --milk-page: #f7f9f7;

    --milk-border: #e2e9e4;

    --milk-success: #28754b;
    --milk-success-bg: #eaf7ef;

    --milk-danger: #b94040;
    --milk-danger-bg: #fff0f0;

    --milk-shadow:
        0 10px 30px
        rgba(24, 59, 41, .07);

    --milk-shadow-hover:
        0 16px 40px
        rgba(24, 59, 41, .10);

    --milk-radius: 20px;
}


/* =========================================================
   PAGE
========================================================= */

.milk-sales-page {

    width:
        min(
            1100px,
            calc(100% - 30px)
        );

    margin:
        0 auto;

    padding:
        28px
        0
        60px;

    color:
        var(--milk-text);

    font-family:
        Inter,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;
}


/* =========================================================
   HEADER
========================================================= */

.milk-sales-page .page-header {

    position: relative;

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 25px;

    min-height: 145px;

    box-sizing: border-box;

    margin-bottom: 22px;

    padding:
        28px
        30px;

    overflow: hidden;

    border-radius: 25px;

    background:
        linear-gradient(
            135deg,
            var(--milk-green-950),
            var(--milk-green-800)
        );

    box-shadow:
        0 18px 40px
        rgba(21,59,41,.18);
}


.milk-sales-page .page-header::before {

    content: "";

    position: absolute;

    width: 250px;
    height: 250px;

    right: -90px;
    top: -125px;

    border-radius: 50%;

    background:
        rgba(237,139,61,.18);
}


.milk-sales-page .page-header::after {

    content: "";

    position: absolute;

    width: 130px;
    height: 130px;

    right: 100px;
    bottom: -85px;

    border-radius: 50%;

    background:
        rgba(255,255,255,.04);
}


.milk-sales-page .header-content,
.milk-sales-page .header-date {

    position: relative;

    z-index: 2;
}


.milk-sales-page .header-kicker {

    display: block;

    margin-bottom: 5px;

    color:
        rgba(255,255,255,.55);

    font-size: 10px;

    font-weight: 800;

    letter-spacing: 1.3px;
}


.milk-sales-page .page-header h1 {

    margin: 0;

    color: #fff;

    font-size:
        clamp(
            29px,
            5vw,
            40px
        );

    line-height: 1.05;

    font-weight: 850;

    letter-spacing: -1.2px;
}


.milk-sales-page .page-header p {

    margin:
        8px
        0
        0;

    color:
        rgba(255,255,255,.72);

    font-size: 13px;

    line-height: 1.5;
}


.milk-sales-page .header-date {

    display: flex;

    flex-direction: column;

    align-items: flex-end;

    gap: 5px;

    min-width: 120px;
}


.milk-sales-page .header-date span {

    color:
        rgba(255,255,255,.55);

    font-size: 10px;

    font-weight: 800;

    text-transform: uppercase;

    letter-spacing: .8px;
}


.milk-sales-page .header-date strong {

    padding:
        9px
        12px;

    border:
        1px solid
        rgba(255,255,255,.13);

    border-radius: 10px;

    color: #fff;

    background:
        rgba(255,255,255,.08);

    font-size: 13px;
}


/* =========================================================
   OVERVIEW
========================================================= */

.milk-sales-page .overview-grid {

    display: grid;

    grid-template-columns:
        repeat(3, 1fr);

    gap: 15px;

    margin-bottom: 22px;
}


.milk-sales-page .overview-card {

    display: flex;

    align-items: center;

    gap: 14px;

    padding:
        17px;

    background:
        var(--milk-white);

    border:
        1px solid
        var(--milk-border);

    border-radius: 17px;

    box-shadow:
        var(--milk-shadow);
}


.milk-sales-page .overview-icon {

    display: flex;

    align-items: center;

    justify-content: center;

    flex-shrink: 0;

    width: 45px;
    height: 45px;

    border-radius: 13px;

    font-size: 17px;

    font-weight: 850;
}


.milk-sales-page .overview-icon.green {

    color:
        var(--milk-green-800);

    background:
        var(--milk-green-100);
}


.milk-sales-page .overview-icon.orange {

    color:
        var(--milk-orange-700);

    background:
        var(--milk-orange-100);
}


.milk-sales-page .overview-card span {

    display: block;

    margin-bottom: 3px;

    color:
        var(--milk-muted);

    font-size: 10px;

    font-weight: 750;

    text-transform: uppercase;

    letter-spacing: .45px;
}


.milk-sales-page .overview-card strong {

    color:
        var(--milk-green-950);

    font-size: 20px;

    font-weight: 850;
}


.milk-sales-page .overview-card small {

    color:
        var(--milk-muted);

    font-size: 11px;

    font-weight: 700;
}


/* =========================================================
   MESSAGES
========================================================= */

.milk-sales-page .message {

    display: flex;

    align-items: flex-start;

    gap: 12px;

    margin-bottom: 18px;

    padding:
        14px
        16px;

    border:
        1px solid
        transparent;

    border-radius: 14px;
}


.milk-sales-page .message.success {

    color:
        var(--milk-success);

    background:
        var(--milk-success-bg);

    border-color:
        rgba(40,117,75,.14);
}


.milk-sales-page .message.error {

    color:
        var(--milk-danger);

    background:
        var(--milk-danger-bg);

    border-color:
        rgba(185,64,64,.14);
}


.milk-sales-page .message-icon {

    display: flex;

    align-items: center;

    justify-content: center;

    flex-shrink: 0;

    width: 27px;
    height: 27px;

    border-radius: 50%;

    color: #fff;

    background:
        currentColor;

    font-size: 13px;

    font-weight: 900;
}


.milk-sales-page .message.success .message-icon {

    color:
        var(--milk-success);
}


.milk-sales-page .message.error .message-icon {

    color:
        var(--milk-danger);
}


.milk-sales-page .message strong {

    display: block;

    margin-bottom: 2px;

    font-size: 13px;
}


.milk-sales-page .message p {

    margin: 0;

    color: inherit;

    opacity: .82;

    font-size: 12px;
}


/* =========================================================
   CARD
========================================================= */

.milk-sales-page .milk-card {

    margin-bottom: 22px;

    padding:
        25px;

    background:
        var(--milk-white);

    border:
        1px solid
        var(--milk-border);

    border-radius:
        var(--milk-radius);

    box-shadow:
        var(--milk-shadow);

    transition:
        box-shadow .2s ease;
}


.milk-sales-page .milk-card:hover {

    box-shadow:
        var(--milk-shadow-hover);
}


/* =========================================================
   SECTION HEADING
========================================================= */

.milk-sales-page .section-heading {

    display: flex;

    align-items: flex-start;

    justify-content: space-between;

    gap: 18px;

    margin-bottom: 22px;
}


.milk-sales-page .section-label {

    display: block;

    margin-bottom: 5px;

    color:
        var(--milk-orange-700);

    font-size: 9px;

    font-weight: 850;

    letter-spacing: 1px;
}


.milk-sales-page .section-heading h2 {

    margin: 0;

    color:
        var(--milk-green-950);

    font-size: 20px;

    font-weight: 850;

    letter-spacing: -.4px;
}


.milk-sales-page .section-heading p {

    margin:
        5px
        0
        0;

    color:
        var(--milk-muted);

    font-size: 12px;

    line-height: 1.5;
}


.milk-sales-page .section-icon {

    display: flex;

    align-items: center;

    justify-content: center;

    flex-shrink: 0;

    width: 43px;
    height: 43px;

    border-radius: 12px;

    font-size: 14px;

    font-weight: 850;
}


.milk-sales-page .section-icon.green {

    color:
        var(--milk-green-800);

    background:
        var(--milk-green-100);
}


.milk-sales-page .section-icon.orange {

    color:
        var(--milk-orange-700);

    background:
        var(--milk-orange-100);
}


/* =========================================================
   FORMS
========================================================= */

.milk-sales-page .form-group {

    display: flex;

    flex-direction: column;

    gap: 7px;
}


.milk-sales-page label {

    color:
        var(--milk-green-950);

    font-size: 12px;

    font-weight: 750;
}


.milk-sales-page .form-control {

    width: 100%;

    min-height: 46px;

    box-sizing: border-box;

    padding:
        11px
        13px;

    color:
        var(--milk-text);

    background:
        #fcfdfc;

    border:
        1px solid
        var(--milk-border);

    border-radius: 11px;

    outline: none;

    font-family: inherit;

    font-size: 13px;

    transition:
        border-color .2s ease,
        box-shadow .2s ease,
        background .2s ease;
}


.milk-sales-page .form-control:hover {

    border-color:
        #c9d7cf;
}


.milk-sales-page .form-control:focus {

    background: #fff;

    border-color:
        var(--milk-green-600);

    box-shadow:
        0 0 0 4px
        rgba(69,150,100,.11);
}


.milk-sales-page .form-control::placeholder {

    color:
        #a4aea8;
}


.milk-sales-page input[readonly] {

    color:
        var(--milk-green-900);

    background:
        var(--milk-green-50);

    font-weight: 750;
}


/* =========================================================
   INPUT PREFIX / SUFFIX
========================================================= */

.milk-sales-page .input-prefix,
.milk-sales-page .input-suffix {

    position: relative;
}


.milk-sales-page .input-prefix > span {

    position: absolute;

    left: 13px;
    top: 50%;

    z-index: 2;

    transform:
        translateY(-50%);

    color:
        var(--milk-green-700);

    font-size: 12px;

    font-weight: 800;
}


.milk-sales-page .input-prefix .form-control {

    padding-left: 43px;
}


.milk-sales-page .input-suffix > span {

    position: absolute;

    right: 13px;
    top: 50%;

    z-index: 2;

    transform:
        translateY(-50%);

    color:
        var(--milk-muted);

    font-size: 12px;

    font-weight: 800;
}


.milk-sales-page .input-suffix .form-control {

    padding-right: 35px;
}


/* =========================================================
   PRICE FORM
========================================================= */

.milk-sales-page .price-form {

    display: grid;

    grid-template-columns:
        minmax(180px, 280px)
        auto;

    align-items: end;

    gap: 15px;
}


/* =========================================================
   BUTTON
========================================================= */

.milk-sales-page .milk-button {

    display: inline-flex;

    align-items: center;

    justify-content: center;

    gap: 8px;

    min-height: 46px;

    box-sizing: border-box;

    padding:
        11px
        19px;

    border: 0;

    border-radius: 11px;

    color: #fff;

    background:
        linear-gradient(
            135deg,
            var(--milk-green-800),
            var(--milk-green-600)
        );

    box-shadow:
        0 7px 17px
        rgba(39,99,66,.18);

    cursor: pointer;

    font-family: inherit;

    font-size: 13px;

    font-weight: 800;

    transition:
        transform .18s ease,
        box-shadow .18s ease,
        filter .18s ease;
}


.milk-sales-page .milk-button:hover {

    transform:
        translateY(-1px);

    box-shadow:
        0 10px 23px
        rgba(39,99,66,.23);

    filter:
        brightness(1.03);
}


.milk-sales-page .milk-button:active {

    transform:
        translateY(0);
}


.milk-sales-page .secondary-button {

    color:
        var(--milk-orange-700);

    background:
        var(--milk-orange-50);

    border:
        1px solid
        #f0d1b7;

    box-shadow: none;
}


.milk-sales-page .secondary-button:hover {

    color:
        var(--milk-orange-800);

    background:
        var(--milk-orange-100);

    box-shadow: none;

    filter: none;
}


.milk-sales-page .plus-symbol {

    font-size: 18px;

    line-height: 1;
}


/* =========================================================
   TABLE
========================================================= */

.milk-sales-page .table-wrapper {

    width: 100%;

    overflow-x: auto;

    border:
        1px solid
        var(--milk-border);

    border-radius: 14px;
}


.milk-sales-page .milk-table {

    width: 100%;

    min-width: 480px;

    border-collapse: collapse;
}


.milk-sales-page .milk-table th {

    padding:
        13px
        16px;

    text-align: left;

    color:
        var(--milk-green-950);

    background:
        var(--milk-green-50);

    border-bottom:
        1px solid
        var(--milk-border);

    font-size: 10px;

    font-weight: 850;

    text-transform: uppercase;

    letter-spacing: .65px;
}


.milk-sales-page .milk-table td {

    padding:
        15px
        16px;

    border-bottom:
        1px solid
        #edf1ee;

    font-size: 13px;
}


.milk-sales-page .milk-table tbody tr:last-child td {

    border-bottom: 0;
}


.milk-sales-page .milk-table tbody tr:not(.total-row):hover {

    background:
        #fafcfb;
}


.milk-sales-page .farm-name {

    display: flex;

    align-items: center;

    gap: 9px;
}


.milk-sales-page .farm-dot {

    width: 7px;
    height: 7px;

    flex-shrink: 0;

    border-radius: 50%;

    background:
        var(--milk-green-600);
}


.milk-sales-page .farm-name strong {

    color:
        var(--milk-text);

    font-size: 13px;
}


.milk-sales-page .liter-value {

    color:
        var(--milk-green-800);

    font-weight: 800;
}


.milk-sales-page .total-row {

    background:
        var(--milk-orange-50);
}


.milk-sales-page .total-row td {

    color:
        var(--milk-orange-700);

    border-top:
        1px solid
        #f1dcc9;
}


/* =========================================================
   EMPTY
========================================================= */

.milk-sales-page .empty-state {

    display: flex;

    flex-direction: column;

    align-items: center;

    justify-content: center;

    padding:
        32px
        20px;

    text-align: center;

    border:
        1px dashed
        #cad8ce;

    border-radius: 15px;

    background:
        var(--milk-green-50);
}


.milk-sales-page .empty-icon {

    display: flex;

    align-items: center;

    justify-content: center;

    width: 46px;
    height: 46px;

    margin-bottom: 10px;

    border-radius: 50%;

    background:
        var(--milk-green-100);

    font-size: 19px;
}


.milk-sales-page .empty-state strong {

    color:
        var(--milk-green-900);

    font-size: 14px;
}


.milk-sales-page .empty-state p {

    margin:
        5px
        0
        0;

    color:
        var(--milk-muted);

    font-size: 12px;
}


/* =========================================================
   SUBSECTION
========================================================= */

.milk-sales-page .subsection {

    margin-top: 4px;

    padding-bottom: 25px;
}


.milk-sales-page .subsection + .subsection {

    padding-top: 25px;

    border-top:
        1px solid
        var(--milk-border);
}


.milk-sales-page .subsection-heading {

    display: flex;

    align-items: flex-start;

    gap: 11px;

    margin-bottom: 18px;
}


.milk-sales-page .step-number {

    display: flex;

    align-items: center;

    justify-content: center;

    flex-shrink: 0;

    width: 31px;
    height: 31px;

    border-radius: 9px;

    color:
        var(--milk-green-800);

    background:
        var(--milk-green-100);

    font-size: 10px;

    font-weight: 850;
}


.milk-sales-page .orange-step {

    color:
        var(--milk-orange-700);

    background:
        var(--milk-orange-100);
}


.milk-sales-page .subsection-heading h3 {

    margin: 1px 0 0;

    color:
        var(--milk-green-950);

    font-size: 15px;

    font-weight: 850;
}


.milk-sales-page .subsection-heading p {

    margin:
        4px
        0
        0;

    color:
        var(--milk-muted);

    font-size: 11px;

    line-height: 1.45;
}


/* =========================================================
   SALES GRID
========================================================= */

.milk-sales-page .sales-grid {

    display: grid;

    grid-template-columns:
        1.4fr
        1fr
        1fr;

    gap: 15px;
}


/* =========================================================
   ALLOCATION
========================================================= */

.milk-sales-page .allocation-subsection {

    margin-top: 0;
}


.milk-sales-page .allocation-topbar {

    display: flex;

    justify-content: flex-end;

    margin-bottom: 13px;
}


.milk-sales-page .allocation-topbar > div {

    display: flex;

    align-items: center;

    gap: 9px;

    padding:
        8px
        11px;

    border-radius: 9px;

    background:
        var(--milk-orange-50);
}


.milk-sales-page .allocation-topbar span {

    color:
        var(--milk-muted);

    font-size: 10px;

    font-weight: 700;
}


.milk-sales-page .allocation-topbar strong {

    color:
        var(--milk-orange-700);

    font-size: 12px;

    font-weight: 850;
}


/* =========================================================
   ALLOCATION ROW
========================================================= */

.milk-sales-page .allocation-row {

    display: grid;

    grid-template-columns:
        minmax(0, 1fr)
        170px;

    gap: 15px;

    margin-bottom: 12px;

    padding:
        15px;

    background:
        #fbfcfb;

    border:
        1px solid
        var(--milk-border);

    border-radius: 14px;

    box-shadow:
        0 3px 10px
        rgba(24,59,41,.025);
}


.milk-sales-page .allocation-row:hover {

    border-color:
        #d3ded7;
}


/* =========================================================
   SALE SUMMARY
========================================================= */

.milk-sales-page .sale-summary {

    display: grid;

    grid-template-columns:
        repeat(3, 1fr);

    overflow: hidden;

    margin-top: 4px;

    border:
        1px solid
        var(--milk-border);

    border-radius: 15px;

    background:
        #fff;
}


.milk-sales-page .summary-item {

    display: flex;

    flex-direction: column;

    gap: 5px;

    padding:
        16px
        18px;

    border-right:
        1px solid
        var(--milk-border);
}


.milk-sales-page .summary-item:last-child {

    border-right: 0;
}


.milk-sales-page .summary-item > span {

    color:
        var(--milk-muted);

    font-size: 9px;

    font-weight: 800;

    text-transform: uppercase;

    letter-spacing: .55px;
}


.milk-sales-page .summary-item strong {

    color:
        var(--milk-green-900);

    font-size: 19px;

    font-weight: 850;
}


.milk-sales-page .summary-complete {

    color:
        var(--milk-success) !important;
}


.milk-sales-page .cash-row {

    background:
        var(--milk-orange-50);
}


.milk-sales-page .cash-row strong {

    color:
        var(--milk-orange-700);
}


/* =========================================================
   FORM ACTION
========================================================= */

.milk-sales-page .form-action {

    display: flex;

    justify-content: flex-end;

    margin-top: 21px;

    padding-top: 20px;

    border-top:
        1px solid
        var(--milk-border);
}


.milk-sales-page .complete-button {

    min-width: 175px;
}


.milk-sales-page .complete-button > span {

    font-size: 17px;

    line-height: 1;

    transition:
        transform .18s ease;
}


.milk-sales-page .complete-button:hover > span {

    transform:
        translateX(3px);
}


/* =========================================================
   SELECT
========================================================= */

.milk-sales-page select.form-control {

    cursor: pointer;

    appearance: auto;
}


.milk-sales-page option:disabled {

    color:
        #adb6b0;
}


/* =========================================================
   TABLET
========================================================= */

@media (max-width: 850px) {

    .milk-sales-page {

        width:
            min(
                100% - 22px,
                720px
            );
    }


    .milk-sales-page .overview-grid {

        grid-template-columns:
            repeat(3, 1fr);

        gap: 10px;
    }


    .milk-sales-page .overview-card {

        padding: 13px;

        gap: 10px;
    }


    .milk-sales-page .overview-icon {

        width: 38px;
        height: 38px;
    }


    .milk-sales-page .overview-card strong {

        font-size: 17px;
    }


    .milk-sales-page .sales-grid {

        grid-template-columns:
            repeat(2, 1fr);
    }


    .milk-sales-page .sales-grid
    .form-group:first-child {

        grid-column:
            1 / -1;
    }

}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 620px) {

    .milk-sales-page {

        width:
            calc(100% - 18px);

        padding:
            12px
            0
            40px;
    }


    .milk-sales-page .page-header {

        min-height: 0;

        flex-direction: column;

        align-items: flex-start;

        margin-bottom: 15px;

        padding:
            22px
            20px;

        border-radius: 19px;
    }


    .milk-sales-page .header-date {

        align-items: flex-start;

        width: 100%;
    }


    .milk-sales-page .overview-grid {

        grid-template-columns:
            1fr;

        gap: 9px;

        margin-bottom: 15px;
    }


    .milk-sales-page .overview-card {

        padding: 13px 15px;
    }


    .milk-sales-page .milk-card {

        margin-bottom: 15px;

        padding:
            17px;

        border-radius: 17px;
    }


    .milk-sales-page .section-heading {

        margin-bottom: 18px;
    }


    .milk-sales-page .section-heading h2 {

        font-size: 18px;
    }


    .milk-sales-page .section-icon {

        width: 38px;
        height: 38px;
    }


    /* Price */

    .milk-sales-page .price-form {

        grid-template-columns: 1fr;

        gap: 13px;
    }


    .milk-sales-page .price-form
    .milk-button {

        width: 100%;
    }


    /* Customer */

    .milk-sales-page .sales-grid {

        grid-template-columns: 1fr;

        gap: 13px;
    }


    .milk-sales-page .sales-grid
    .form-group:first-child {

        grid-column: auto;
    }


    /* Allocation */

    .milk-sales-page .allocation-topbar {

        justify-content: stretch;
    }


    .milk-sales-page .allocation-topbar > div {

        width: 100%;

        box-sizing: border-box;

        justify-content: space-between;
    }


    .milk-sales-page .allocation-row {

        grid-template-columns: 1fr;

        gap: 12px;

        padding: 13px;

        border-radius: 12px;
    }


    .milk-sales-page .secondary-button {

        width: 100%;
    }


    /* Summary */

    .milk-sales-page .sale-summary {

        grid-template-columns: 1fr;

        border-radius: 13px;
    }


    .milk-sales-page .summary-item {

        border-right: 0;

        border-bottom:
            1px solid
            var(--milk-border);
    }


    .milk-sales-page .summary-item:last-child {

        border-bottom: 0;
    }


    .milk-sales-page .summary-item strong {

        font-size: 18px;
    }


    /* Action */

    .milk-sales-page .form-action {

        display: block;
    }


    .milk-sales-page .complete-button {

        width: 100%;
    }


    /* Table */

    .milk-sales-page .table-wrapper {

        border-radius: 12px;
    }

}


/* =========================================================
   SMALL MOBILE
========================================================= */

@media (max-width: 380px) {

    .milk-sales-page {

        width:
            calc(100% - 12px);
    }


    .milk-sales-page .milk-card {

        padding: 14px;
    }


    .milk-sales-page .page-header {

        padding: 19px;
    }


    .milk-sales-page .page-header h1 {

        font-size: 26px;
    }


    .milk-sales-page .section-heading p {

        font-size: 11px;
    }


    .milk-sales-page .allocation-row {

        padding: 11px;
    }


    .milk-sales-page .form-control {

        min-height: 44px;

        font-size: 12px;
    }

}