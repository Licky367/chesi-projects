        <div class="overview-card">

            <div class="overview-icon orange">
                ◉
            </div>

            <div class="overview-text">

                <span>
                    Available for Sale
                </span>

                <strong>
                    <%= totalAvailable.toFixed(2) %> L
                </strong>

            </div>

        </div>


        <div class="overview-card">

            <div class="overview-icon orange">
                KSh
            </div>

            <div class="overview-text">

                <span>
                    Price Per Liter
                </span>

                <strong>
                    <%= pagePrice.toFixed(2) %>
                </strong>

