                        </div>

                        <div>

                            <h3>
                                Customer Details
                            </h3>

                            <p>
                                Enter the customer's information
                                and required quantity.
                            </p>

                        </div>

                    </div>


                    <div class="sales-grid">


                        <div class="form-group">

                            <label for="customerName">
