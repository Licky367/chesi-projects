        <div class="section-heading">

            <div class="section-heading-left">

                <div class="section-kicker">
                    Production
                </div>

                <h2>
                    Farm Production
                </h2>

                <p>
                    Milk produced by each visible farm today.
                </p>

            </div>

            <div class="section-badge">
                🥛
            </div>

        </div>


        <% if (visibleFarmData.length === 0) { %>

