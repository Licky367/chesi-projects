<!-- =========================================================
     MILK SALES
     FILE:
         views/milk/milksales.ejs

     STANDALONE PAGE
     ---------------------------------------------------------
     - No external CSS
     - All CSS contained in this file
     - Uses backend summary data
     - Uses backend farm availability where supplied
     - Client-side validation prevents over-allocation
     - Server-side validation remains authoritative
========================================================= -->


<%
/* =========================================================
   SAFE PAGE DATA
========================================================= */

const pageUser =
    typeof user !== "undefined" && user
        ? user
        : null;


const pageIsAdmin =
    Boolean(
        pageUser &&
        pageUser.role === "admin"
    );


const pageSuccess =
    typeof success !== "undefined" && success
        ? success
        : "";


const pageError =
    typeof error !== "undefined" && error
        ? error
        : "";


/* =========================================================
   SUMMARY
========================================================= */

const pageSummary =
    typeof summary !== "undefined" && summary
        ? summary
        : {};


const pageDay =
    pageSummary.day ||
    (
        typeof day !== "undefined" && day
            ? day
            : new Date()
                .toISOString()
                .slice(0, 10)
    );


const pagePrice =
    Number.isFinite(
        Number(
            typeof price !== "undefined"
                ? price
                : pageSummary.price
        )
    )
        ? Number(
            typeof price !== "undefined"
                ? price
                : pageSummary.price
        )
        : 50;


/* =========================================================
   BACKEND TOTALS
========================================================= */

const backendProduced =
    Number.isFinite(
        Number(
            typeof produced !== "undefined"
                ? produced
                : pageSummary.produced
        )
    )
        ? Number(
            typeof produced !== "undefined"
                ? produced
                : pageSummary.produced
        )
        : 0;


const backendConsumed =
    Number.isFinite(
        Number(
            typeof consumed !== "undefined"
                ? consumed
                : pageSummary.consumed
        )
    )
        ? Number(
            typeof consumed !== "undefined"
                ? consumed
                : pageSummary.consumed
        )
        : 0;


const backendCash =
    Number.isFinite(
        Number(
            typeof cash !== "undefined"
                ? cash
                : pageSummary.cash
        )
    )
        ? Number(
            typeof cash !== "undefined"
                ? cash
                : pageSummary.cash
        )
        : 0;


/*
 * IMPORTANT:
 *
 * `available` should come from the controller once we align it.
 *
 * Fallback:
 *
 * produced - consumed
 *
 * This fallback is only for compatibility.
 */

const backendAvailable =
    Number.isFinite(
        Number(
            typeof available !== "undefined"
                ? available
                : pageSummary.available
        )
    )
        ? Math.max(
            0,
            Number(
                typeof available !== "undefined"
                    ? available
                    : pageSummary.available
            )
        )
        : Math.max(
            0,
            backendProduced -
            backendConsumed
        );


/* =========================================================
   FARMS
========================================================= */

const pageFarms =
    Array.isArray(farms)
        ? farms
        : [];


/* =========================================================
   FARM PRODUCTION
========================================================= */

const farmProduction =
    Array.isArray(
        pageSummary.farmProduction
    )
        ? pageSummary.farmProduction
        : [];


/* =========================================================
   SALES
========================================================= */

const sales =
    Array.isArray(
        pageSummary.sales
    )
        ? pageSummary.sales
        : [];


/* =========================================================
   FARM SALES MAP
========================================================= */

const farmSalesMap =
    new Map();


sales.forEach(
    sale => {

        if (
            !sale ||
            !Array.isArray(
                sale.farmAllocations
            )
        ) {
            return;
        }


        sale.farmAllocations.forEach(
            allocation => {

                if (
                    !allocation ||
                    !allocation.farm
                ) {
                    return;
                }


                const farmId =
                    allocation.farm.toString();


                const liters =
                    Number(
                        allocation.liters
                    );


                if (
                    !Number.isFinite(liters) ||
                    liters < 0
                ) {
                    return;
                }


                farmSalesMap.set(
                    farmId,
                    (
                        farmSalesMap.get(
                            farmId
                        ) || 0
                    ) + liters
                );

            }
        );

    }
);


/* =========================================================
   BACKEND FARM AVAILABILITY
=========================================================

   The controller may provide:

       farmAvailability

   Supported forms:

       Map
       Array
       Object

   Each item may contain:

       farm
       farmId
       _id
       produced
       sold
       available
========================================================= */

const rawFarmAvailability =
    typeof farmAvailability !== "undefined"
        ? farmAvailability
        : null;


function getBackendFarmAvailability(
    farmId
) {

    if (!rawFarmAvailability) {
        return null;
    }


    const id =
        farmId.toString();


    /* -----------------------------------------------------
       ARRAY
    ----------------------------------------------------- */

    if (
        Array.isArray(
            rawFarmAvailability
        )
    ) {

        const item =
            rawFarmAvailability.find(
                entry => {

                    if (!entry) {
                        return false;
                    }


                    const entryId =
                        entry.farm ||
                        entry.farmId ||
                        entry._id;


                    return (
                        entryId &&
                        entryId.toString() === id
                    );

                }
            );


        if (item) {

            const value =
                Number(
                    item.available
                );


            if (
                Number.isFinite(value)
            ) {

                return Math.max(
                    0,
                    value
                );

            }

        }

    }


    /* -----------------------------------------------------
       OBJECT
    ----------------------------------------------------- */

    if (
        typeof rawFarmAvailability ===
        "object" &&
        !Array.isArray(
            rawFarmAvailability
        )
    ) {

        const value =
            rawFarmAvailability[id];


        if (
            value !== undefined
        ) {

            if (
                typeof value === "object"
            ) {

                const available =
                    Number(
                        value.available
                    );


                if (
                    Number.isFinite(
                        available
                    )
                ) {

                    return Math.max(
                        0,
                        available
                    );

                }

            }


            const numeric =
                Number(
                    value
                );


            if (
                Number.isFinite(
                    numeric
                )
            ) {

                return Math.max(
                    0,
                    numeric
                );

            }

        }

    }


    return null;

}


/* =========================================================
   VISIBLE FARM DATA
========================================================= */

const visibleFarmData =
    pageFarms.map(
        farm => {

            const farmId =
                farm?._id
                    ? farm._id.toString()
                    : "";


            const productionEntry =
                farmProduction.find(
                    entry =>
                        entry?.farm &&
                        entry.farm.toString() ===
                            farmId
                );


            const produced =
                Number.isFinite(
                    Number(
                        productionEntry?.liters
                    )
                )
                    ? Number(
                        productionEntry.liters
                    )
                    : 0;


            const sold =
                Number(
                    farmSalesMap.get(
                        farmId
                    )
                ) || 0;


            /*
             * Prefer backend farm availability.
             *
             * Only fall back to local calculation
             * when the controller has not supplied it.
             */

            const backendFarmAvailable =
                getBackendFarmAvailability(
                    farmId
                );


            const calculatedAvailable =
                Math.max(
                    0,
                    produced -
                    sold
                );


            const available =
                backendFarmAvailable !== null
                    ? backendFarmAvailable
                    : calculatedAvailable;


            return {

                _id:
                    farm._id,

                name:
                    farm.name ||
                    "Unnamed Farm",

                code:
                    farm.code,

                produced,

                sold,

                available:
                    Math.max(
                        0,
                        Number(
                            available
                        ) || 0
                    )

            };

        }
    );


/* =========================================================
   TOTALS
========================================================= */

const visibleFarmProduction =
    visibleFarmData.reduce(
        (
            total,
            farm
        ) =>
            total +
            farm.produced,
        0
    );


const visibleFarmSold =
    visibleFarmData.reduce(
        (
            total,
            farm
        ) =>
            total +
            farm.sold,
        0
    );


const visibleFarmAvailable =
    visibleFarmData.reduce(
        (
            total,
            farm
        ) =>
            total +
            farm.available,
        0
    );


/*
 * IMPORTANT:
 *
 * Overall available must come from the backend.
 *
 * The farm total is useful for displaying the
 * breakdown, but `pageAvailable` is the authoritative
 * page-level limit.
 */

const pageAvailable =
    Math.max(
        0,
        Number(
            backendAvailable
        ) || 0
    );


/* =========================================================
   SALES TOTALS
========================================================= */

const salesCount =
    sales.length;


const pageAvailablePercentage =
    backendProduced > 0
        ? Math.min(
            100,
            Math.max(
                0,
                (
                    pageAvailable /
                    backendProduced
                ) * 100
            )
        )
        : 0;

%>


