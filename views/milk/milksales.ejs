    padding:
        15px 16px;

    border-bottom:
        1px solid
        #edf1ee;

    font-size: 13px;
}


.milk-sales-page .milk-table tbody tr:last-child td {

    border-bottom:
        0;
}


.milk-sales-page .milk-table tbody tr:not(.total-row):hover {

    background:
        #fafcfb;
}


.milk-sales-page .farm-name {

    display: flex;

    align-items:
        center;

    gap: 9px;

    font-weight:
        750;
}


.milk-sales-page .farm-dot {

    width: 7px;
    height: 7px;

    flex-shrink: 0;

    border-radius: 50%;

    background:
        var(--green-600);
}


.milk-sales-page .liter-value {

    color:
        var(--green-800);

    font-weight:
        850;
}


.milk-sales-page .available-value {

    color:
        var(--orange-700);

    font-weight:
        850;
}


.milk-sales-page .sold-value {

    color:
        var(--muted);

    font-weight:
        750;
}


.milk-sales-page .total-row {

    background:
        var(--orange-50);
}


.milk-sales-page .total-row td {

    color:
        var(--orange-700);

    border-top:
        1px solid
        #f1dcc9;

    font-weight:
        850;
}


/* =========================================================
   EMPTY
========================================================= */

.milk-sales-page .empty-state {

    margin: 0;

    padding:
        30px 20px;

    text-align:
        center;

    color:
        var(--muted);

    background:
        var(--green-50);

    border:
        1px dashed
        #cbd9d0;

    border-radius:
        14px;

    font-size:
        12px;
}


/* =========================================================
   SALES STEPS
========================================================= */

.milk-sales-page .sales-step {

    margin-top:
        3px;

    padding-bottom:
        25px;
}


.milk-sales-page .sales-step + .sales-step {

    padding-top:
        25px;

    border-top:
        1px solid
        var(--border);
}


.milk-sales-page .step-heading {

    display: flex;

    gap:
        11px;

    margin-bottom:
        18px;
}


.milk-sales-page .step-number {

    display: flex;

    align-items:
        center;

    justify-content:
        center;

    flex-shrink: 0;

    width: 31px;
    height: 31px;

    border-radius:
        9px;

    color:
        var(--green-800);

    background:
        var(--green-100);

    font-size:
        10px;

    font-weight:
        900;
}


.milk-sales-page .step-number.orange {

    color:
        var(--orange-700);

    background:
        var(--orange-100);
}


.milk-sales-page .step-heading h3 {

    margin:
        1px 0 0;

    color:
        var(--green-950);

    font-size:
        15px;

    font-weight:
        850;
}


.milk-sales-page .step-heading p {

    margin:
        4px 0 0;

    color:
        var(--muted);

    font-size:
        11px;

    line-height:
        1.45;
}


/* =========================================================
   CUSTOMER GRID
========================================================= */

.milk-sales-page .sales-grid {

    display: grid;

    grid-template-columns:
        1.4fr
        1fr
        1fr;

    gap:
        14px;
}


/* =========================================================
   ALLOCATION
========================================================= */

.milk-sales-page .allocation-heading {

    display: flex;

    align-items:
        center;

    justify-content:
        space-between;

    gap:
        15px;

    margin-bottom:
        13px;
}


.milk-sales-page .allocation-heading h3 {

    margin: 0;

    color:
        var(--green-950);

    font-size:
        14px;

    font-weight:
        850;
}


.milk-sales-page .allocation-heading p {

    margin:
        4px 0 0;

    color:
        var(--muted);

    font-size:
        11px;
}


.milk-sales-page .available-pill {

    display: flex;

    align-items:
        center;

    gap:
        7px;

    flex-shrink:
        0;

    padding:
        8px 11px;

    border-radius:
        9px;

    background:
        var(--orange-50);
}


.milk-sales-page .available-pill span {

    color:
        var(--muted);

    font-size:
        9px;

    font-weight:
        750;
}


.milk-sales-page .available-pill strong {

    color:
        var(--orange-700);

    font-size:
        12px;

    font-weight:
        900;
}


/* =========================================================
   ALLOCATION TOTAL STATUS
========================================================= */

.milk-sales-page .allocation-status {

    margin:
        0 0 13px;

    padding:
        10px 12px;

    border-radius:
        10px;

    color:
        var(--muted);

    background:
        #f7f9f7;

    font-size:
        11px;

    font-weight:
        700;
}


.milk-sales-page .allocation-status.good {

    color:
        var(--green-800);

    background:
        var(--green-50);
}


.milk-sales-page .allocation-status.warning {

    color:
        var(--orange-800);

    background:
        var(--orange-50);
}


.milk-sales-page .allocation-status.danger {

    color:
        var(--red-700);

    background:
        var(--red-100);
}


/* =========================================================
   ALLOCATION ROW
========================================================= */

.milk-sales-page .allocation-row {

    display: grid;

    grid-template-columns:
        minmax(0,1fr)
        170px;

    gap:
        14px;

    margin-bottom:
        11px;

    padding:
        14px;

    background:
        #fbfcfb;

    border:
        1px solid
        var(--border);

    border-radius:
        14px;

    transition:
        border-color .18s ease,
        box-shadow .18s ease;
}


.milk-sales-page .allocation-row:hover {

    border-color:
        #d2ded6;

    box-shadow:
        0 5px 16px
        rgba(
            18,
            60,
            41,
            .035
        );
}


/* =========================================================
   FARM AVAILABILITY NOTE
========================================================= */

.milk-sales-page .farm-availability {

    display: flex;

    justify-content:
        space-between;

    gap:
        10px;

    margin-top:
        6px;

    color:
        var(--muted);

    font-size:
        10px;
}


.milk-sales-page .farm-availability strong {

    color:
        var(--green-800);

    font-weight:
        850;
}


/* =========================================================
   ADD FARM
========================================================= */

.milk-sales-page .add-farm-wrap {

    margin-top:
        5px;
}


/* =========================================================
   SUMMARY
========================================================= */

.milk-sales-page .sale-summary {

    display: grid;

    grid-template-columns:
        repeat(
            3,
            minmax(0,1fr)
        );

    overflow:
        hidden;

    margin-top:
        4px;

    border:
        1px solid
        var(--border);

    border-radius:
        15px;

    background:
        #fff;
}


.milk-sales-page .summary-item {

    display: flex;

    flex-direction:
        column;

    gap:
        5px;

    padding:
        16px 18px;

    border-right:
        1px solid
        var(--border);
}


.milk-sales-page .summary-item:last-child {

    border-right:
        0;
}


.milk-sales-page .summary-item span {

    color:
        var(--muted);

    font-size:
        9px;

    font-weight:
        850;

    letter-spacing:
        .55px;

    text-transform:
        uppercase;
}


.milk-sales-page .summary-item strong {

    color:
        var(--green-900);

    font-size:
        19px;

    font-weight:
        900;
}


.milk-sales-page .cash-item {

    background:
        var(--orange-50);
}


.milk-sales-page .cash-item strong {

    color:
        var(--orange-700);
}


/* =========================================================
   SUBMIT
========================================================= */

.milk-sales-page .form-action {

    display: flex;

    justify-content:
        flex-end;

    margin-top:
        20px;

    padding-top:
        20px;

    border-top:
        1px solid
        var(--border);
}


.milk-sales-page .complete-button {

    min-width:
        180px;
}


.milk-sales-page .complete-arrow {

    font-size:
        17px;

    transition:
        transform .18s ease;
}


.milk-sales-page .complete-button:hover
.complete-arrow {

    transform:
        translateX(3px);
}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 900px) {

    .milk-sales-page .overview-grid {

        grid-template-columns:
            repeat(
                2,
                minmax(0,1fr)
            );
    }

}


@media (max-width: 760px) {

    .milk-sales-page {

        width:
            calc(100% - 20px);

        padding-top:
            15px;
    }


    .milk-sales-page .sales-hero {

        flex-direction:
            column;

        align-items:
            flex-start;

        min-height:
            0;

        padding:
            23px 20px;

        border-radius:
            19px;
    }


    .milk-sales-page .hero-date {

        align-items:
            flex-start;

        width:
            100%;
    }


    .milk-sales-page .overview-grid {

        grid-template-columns:
            1fr;

        gap:
            9px;
    }


    .milk-sales-page .milk-card {

        padding:
            18px;

        border-radius:
            17px;
    }


    .milk-sales-page .price-form {

        grid-template-columns:
            1fr;
    }


    .milk-sales-page .price-form .milk-button {

        width:
            100%;
    }


    .milk-sales-page .sales-grid {

        grid-template-columns:
            1fr;
    }


    .milk-sales-page .allocation-heading {

        align-items:
            flex-start;

        flex-direction:
            column;
    }


    .milk-sales-page .available-pill {

        width:
            100%;

        justify-content:
            space-between;
    }


    .milk-sales-page .allocation-row {

        grid-template-columns:
            1fr;

        padding:
            13px;
    }


    .milk-sales-page .secondary-button {

        width:
            100%;
    }


    .milk-sales-page .sale-summary {

        grid-template-columns:
            1fr;
    }


    .milk-sales-page .summary-item {

        border-right:
            0;

        border-bottom:
            1px solid
            var(--border);
    }


    .milk-sales-page .summary-item:last-child {

        border-bottom:
            0;
    }


    .milk-sales-page .form-action {

        display:
            block;
    }


    .milk-sales-page .complete-button {

        width:
            100%;
    }

}


@media (max-width: 400px) {

    .milk-sales-page {

        width:
            calc(100% - 12px);
    }


    .milk-sales-page .milk-card {

        padding:
            14px;
    }


    .milk-sales-page .sales-hero {

        padding:
            20px 17px;
    }


    .milk-sales-page .sales-hero h1 {

        font-size:
            27px;
    }


    .milk-sales-page .form-control {

        min-height:
            44px;

        font-size:
            12px;
    }


    .milk-sales-page .allocation-row {

        padding:
            11px;
    }

}

</style>


<div
    class="milk-sales-page"
    data-price="<%= pagePrice %>"
    data-total-available="<%= pageAvailable %>"
>


    <!-- =====================================================
         HERO
    ====================================================== -->

    <header class="sales-hero">

        <div class="hero-content">

            <div class="hero-kicker">
                Daily Milk Management
            </div>

            <h1>
                Milk Sales
            </h1>

            <p class="hero-description">
                Manage today's production, available milk,
                customers and farm allocations.
            </p>

        </div>


        <div class="hero-date">

            <span>
                Sales Day
            </span>

            <strong>
                <%= pageDay %>
            </strong>

        </div>

    </header>



    <!-- =====================================================
         MESSAGES
    ====================================================== -->

    <% if (pageSuccess) { %>

        <div class="message success">

            <span class="message-icon">
                ✓
            </span>

            <span>
                <%= pageSuccess %>
            </span>

        </div>

    <% } %>


    <% if (pageError) { %>

        <div class="message error">

            <span class="message-icon">
                !
            </span>

            <span>
                <%= pageError %>
            </span>

        </div>

    <% } %>



    <!-- =====================================================
         OVERVIEW
    ====================================================== -->

    <div class="overview-grid">


        <div class="overview-card">

            <div class="overview-icon green">
                🥛
            </div>

            <div class="overview-text">

                <span>
                    Produced
                </span>

                <strong>
                    <%= backendProduced.toFixed(2) %> L
                </strong>

            </div>

        </div>


        <div class="overview-card">

            <div class="overview-icon orange">
                ◉
            </div>

            <div class="overview-text">

                <span>
                    Available
                </span>

                <strong>
                    <%= pageAvailable.toFixed(2) %> L
                </strong>

            </div>

        </div>


        <div class="overview-card">

            <div class="overview-icon green">
                ↗
            </div>

            <div class="overview-text">

                <span>
                    Sold
                </span>

                <strong>
                    <%= backendConsumed.toFixed(2) %> L
                </strong>

            </div>

        </div>


        <div class="overview-card">

            <div class="overview-icon orange">
                KSh
            </div>

            <div class="overview-text">

                <span>
                    Sales Value
                </span>

                <strong>
                    KSh <%= backendCash.toFixed(2) %>
                </strong>

            </div>

        </div>

    </div>



    <!-- =====================================================
         AVAILABILITY
    ====================================================== -->

    <section class="availability-card">

        <div class="availability-top">

            <span>
                Milk Available For Sale
            </span>

            <strong>
                <%= pageAvailable.toFixed(2) %>
                L
            </strong>

        </div>


        <div class="availability-track">

            <div class="availability-fill"></div>

        </div>

    </section>



    <!-- =====================================================
         ADMIN PRICE
    ====================================================== -->

    <% if (pageIsAdmin) { %>

        <section class="milk-card">

            <div class="section-heading">

                <div class="section-heading-left">

                    <div class="section-kicker">
                        Pricing
                    </div>

                    <h2>
                        Milk Price
                    </h2>

                    <p>
                        Set the selling price per liter
                        for this sales day.
                    </p>

                </div>

                <div class="section-badge">
                    KSh
                </div>

            </div>


            <form
                action="/milk/sales/price"
                method="POST"
                class="price-form"
            >

                <input
                    type="hidden"
                    name="day"
                    value="<%= pageDay %>"
                >


                <div class="form-group">

                    <label for="price">
                        Price Per Liter
                    </label>

                    <input
                        type="number"
                        id="price"
                        name="price"
                        class="form-control"
                        min="0"
                        step="0.01"
                        value="<%= pagePrice %>"
                        required
                    >

                </div>


                <button
                    type="submit"
                    class="milk-button"
                >
                    Update Price
                </button>

            </form>

        </section>

    <% } %>



    <!-- =====================================================
         FARM PRODUCTION
    ====================================================== -->

    <section class="milk-card">

        <div class="section-heading">

            <div class="section-heading-left">

                <div class="section-kicker">
                    Production
                </div>

                <h2>
                    Farm Production
                </h2>

                <p>
                    Production, sold milk and remaining
                    availability for every visible farm.
                </p>

            </div>

            <div class="section-badge">
                🥛
            </div>

        </div>


        <% if (visibleFarmData.length === 0) { %>

            <p class="empty-state">
                No farm production is available.
            </p>

        <% } else { %>

            <div class="table-wrapper">

                <table class="milk-table">

                    <thead>

                        <tr>

                            <th>
                                Farm
                            </th>

                            <th>
                                Produced
                            </th>

                            <th>
                                Sold
                            </th>

                            <th>
                                Available
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        <% visibleFarmData.forEach(function(farm) { %>

                            <tr>

                                <td>

                                    <div class="farm-name">

                                        <span class="farm-dot"></span>

                                        <strong>
                                            <%= farm.name %>
                                        </strong>

                                    </div>

                                </td>


                                <td>

                                    <span class="liter-value">
                                        <%= farm.produced.toFixed(2) %> L
                                    </span>

                                </td>


                                <td>

                                    <span class="sold-value">
                                        <%= farm.sold.toFixed(2) %> L
                                    </span>

                                </td>


                                <td>

                                    <span class="available-value">
                                        <%= farm.available.toFixed(2) %> L
                                    </span>

                                </td>

                            </tr>

                        <% }); %>


                        <tr class="total-row">

                            <td>
                                Farm Totals
                            </td>

                            <td>
                                <%= visibleFarmProduction.toFixed(2) %> L
                            </td>

                            <td>
                                <%= visibleFarmSold.toFixed(2) %> L
                            </td>

                            <td>
                                <%= visibleFarmAvailable.toFixed(2) %> L
                            </td>

                        </tr>

                    </tbody>

                </table>

            </div>

        <% } %>

    </section>



    <!-- =====================================================
         SELL MILK
    ====================================================== -->

    <section class="milk-card">

        <div class="section-heading">

            <div class="section-heading-left">

                <div class="section-kicker">
                    Transaction
                </div>

                <h2>
                    Sell Milk
                </h2>

                <p>
                    Record a customer sale and allocate
                    the milk to one or more supplying farms.
                </p>

            </div>

            <div class="section-badge">
                💰
            </div>

        </div>


        <% if (pageAvailable <= 0) { %>

            <p class="empty-state">
                There is currently no milk available for sale.
            </p>

        <% } else if (visibleFarmData.length === 0) { %>

            <p class="empty-state">
                No milk-producing farms are available for sale.
            </p>

        <% } else { %>


            <form
                action="/milk/sales/sell"
                method="POST"
                id="milkSaleForm"
                novalidate
            >

                <input
                    type="hidden"
                    name="day"
                    value="<%= pageDay %>"
                >


                <!-- =========================================
                     STEP 01
                ========================================== -->

                <div class="sales-step">

                    <div class="step-heading">

                        <div class="step-number">
                            01
                        </div>

                        <div>

                            <h3>
                                Customer Details
                            </h3>

                            <p>
                                Enter the customer and
                                required quantity.
                            </p>

                        </div>

                    </div>


                    <div class="sales-grid">


                        <div class="form-group">

                            <label for="customerName">
                                Customer Name
                            </label>

                            <input
                                type="text"
                                id="customerName"
                                name="customerName"
                                class="form-control"
                                placeholder="Enter customer name"
                                required
                            >

                        </div>


                        <div class="form-group">

                            <label for="saleLiters">
                                Milk Required
                            </label>

                            <div style="position:relative;">

                                <input
                                    type="number"
                                    id="saleLiters"
                                    name="liters"
                                    class="form-control"
                                    min="0.01"
                                    max="<%= pageAvailable %>"
                                    step="0.01"
                                    placeholder="0.00"
                                    style="padding-right:42px;"
                                    required
                                >

                                <span
                                    style="
                                        position:absolute;
                                        right:13px;
                                        top:50%;
                                        transform:translateY(-50%);
                                        color:#748078;
                                        font-size:11px;
                                        font-weight:800;
                                        pointer-events:none;
                                    "
                                >
                                    L
                                </span>

                            </div>

                        </div>


                        <div class="form-group">

                            <label>
                                Price Per Liter
                            </label>

                            <div style="position:relative;">

                                <span
                                    style="
                                        position:absolute;
                                        left:13px;
                                        top:50%;
                                        transform:translateY(-50%);
                                        color:#2e7b4d;
                                        font-size:11px;
                                        font-weight:850;
                                        pointer-events:none;
                                        z-index:2;
                                    "
                                >
                                    KSh
                                </span>

                                <input
                                    type="text"
                                    class="form-control"
                                    value="<%= pagePrice.toFixed(2) %>"
                                    readonly
                                    style="padding-left:48px;"
                                >

                            </div>

                        </div>

                    </div>

                </div>



                <!-- =========================================
                     STEP 02
                ========================================== -->

                <div class="sales-step">

                    <div class="step-heading">

                        <div class="step-number orange">
                            02
                        </div>

                        <div>

                            <h3>
                                Farm Allocation
                            </h3>

                            <p>
                                Select the farms supplying this
                                sale. Each farm can only be used once.
                            </p>

                        </div>

                    </div>


                    <div class="allocation-heading">

                        <div>

                            <h3>
                                Milk Source
                            </h3>

                            <p>
                                Farm availability is calculated
                                from today's production and sales.
                            </p>

                        </div>


                        <div class="available-pill">

                            <span>
                                Total available
                            </span>

                            <strong id="totalAvailable">
                                <%= pageAvailable.toFixed(2) %> L
                            </strong>

                        </div>

                    </div>


                    <div
                        id="allocationStatus"
                        class="allocation-status"
                    >
                        Enter the customer's required quantity.
                    </div>


                    <div id="allocationContainer">

                        <div class="allocation-row">

                            <div class="form-group">

                                <label>
                                    Farm
                                </label>

                                <select
                                    name="allocations[0][farm]"
                                    class="form-control farm-select"
                                    required
                                >

                                    <option value="">
                                        Select supplying farm
                                    </option>


                                    <% visibleFarmData.forEach(function(farm) { %>

                                        <option
                                            value="<%= farm._id %>"
                                            data-available="<%= farm.available.toFixed(2) %>"
                                        >

                                            <%= farm.name %>
                                            —
                                            <%= farm.available.toFixed(2) %>
                                            L available

                                        </option>

                                    <% }); %>

                                </select>


                                <div class="farm-availability">

                                    <span>
                                        Available from farm
                                    </span>

                                    <strong class="row-available">
                                        0.00 L
                                    </strong>

                                </div>

                            </div>


                            <div class="form-group">

                                <label>
                                    Liters
                                </label>

                                <div style="position:relative;">

                                    <input
                                        type="number"
                                        name="allocations[0][liters]"
                                        class="form-control allocation-liters"
                                        min="0.01"
                                        step="0.01"
                                        placeholder="0.00"
                                        style="padding-right:35px;"
                                        required
                                    >

                                    <span
                                        style="
                                            position:absolute;
                                            right:13px;
                                            top:50%;
                                            transform:translateY(-50%);
                                            color:#748078;
                                            font-size:11px;
                                            font-weight:800;
                                            pointer-events:none;
                                        "
                                    >
                                        L
                                    </span>

                                </div>

                            </div>

                        </div>

                    </div>


                    <div class="add-farm-wrap">

                        <button
                            type="button"
                            class="milk-button secondary-button"
                            id="addFarmButton"
                        >
                            +&nbsp; Add Another Farm
                        </button>

                    </div>

                </div>



                <!-- =========================================
                     SALE SUMMARY
                ========================================== -->

                <div class="sale-summary">

                    <div class="summary-item">

                        <span>
                            Customer Requires
                        </span>

                        <strong id="requiredLiters">
                            0.00 L
                        </strong>

                    </div>


                    <div class="summary-item">

                        <span>
                            Allocated
                        </span>

                        <strong id="allocatedLiters">
                            0.00 L
                        </strong>

                    </div>


                    <div class="summary-item cash-item">

                        <span>
                            Total Cash
                        </span>

                        <strong id="saleCash">
                            KSh 0.00
                        </strong>

                    </div>

                </div>



                <!-- =========================================
                     COMPLETE
                ========================================== -->

                <div class="form-action">

                    <button
                        type="submit"
                        class="milk-button complete-button"
                        id="completeSaleButton"
                        disabled
                    >

                        Complete Sale

                        <span class="complete-arrow">
                            →
                        </span>

                    </button>

                </div>

            </form>

        <% } %>

    </section>

</div>



<script>

document.addEventListener(
    "DOMContentLoaded",
    function() {

        const form =
            document.getElementById(
                "milkSaleForm"
            );


        if (!form) {
            return;
        }


        /* =================================================
           PAGE DATA
        ================================================= */

        const page =
            document.querySelector(
                ".milk-sales-page"
            );


        const price =
            Number(
                page.dataset.price
            ) || 0;


        const totalAvailable =
            Math.max(
                0,
                Number(
                    page.dataset.totalAvailable
                ) || 0
            );


        /* =================================================
           ELEMENTS
        ================================================= */

        const container =
            document.getElementById(
                "allocationContainer"
            );


        const addButton =
            document.getElementById(
                "addFarmButton"
            );


        const saleLitersInput =
            document.getElementById(
                "saleLiters"
            );


        const requiredOutput =
            document.getElementById(
                "requiredLiters"
            );


        const allocatedOutput =
            document.getElementById(
                "allocatedLiters"
            );


        const cashOutput =
            document.getElementById(
                "saleCash"
            );


        const statusOutput =
            document.getElementById(
                "allocationStatus"
            );


        const submitButton =
            document.getElementById(
                "completeSaleButton"
            );


        /* =================================================
           ROUND
        ================================================= */

        function round(value) {

            return Math.round(
                (
                    Number(value) || 0
                ) * 100
            ) / 100;

        }


        /* =================================================
           GET REQUIRED
        ================================================= */

        function getRequired() {

            return Math.max(
                0,
                Number(
                    saleLitersInput.value
                ) || 0
            );

        }


        /* =================================================
           GET ALLOCATED
        ================================================= */

        function getAllocated() {

            let total = 0;


            container
                .querySelectorAll(
                    ".allocation-liters"
                )
                .forEach(
                    input => {

                        total +=
                            Number(
                                input.value
                            ) || 0;

                    }
                );


            return round(total);

        }


        /* =================================================
           GET SELECTED FARMS
        ================================================= */

        function getRows() {

            return Array.from(
                container.querySelectorAll(
                    ".allocation-row"
                )
            );

        }


        /* =================================================
           UPDATE FARM AVAILABILITY
        ================================================= */

        function updateRowAvailability(
            row
        ) {

            const select =
                row.querySelector(
                    ".farm-select"
                );


            const input =
                row.querySelector(
                    ".allocation-liters"
                );


            const output =
                row.querySelector(
                    ".row-available"
                );


            if (
                !select ||
                !input
            ) {

                return;

            }


            const option =
                select.options[
                    select.selectedIndex
                ];


            const available =
                Math.max(
                    0,
                    Number(
                        option?.dataset?.available
                    ) || 0
                );


            if (output) {

                output.textContent =
                    available.toFixed(2) +
                    " L";

            }


            if (available > 0) {

                input.max =
                    available.toFixed(2);

            } else {

                input.removeAttribute(
                    "max"
                );

            }


            /*
             * If the farm changes and the existing
             * liters exceed the newly selected farm,
             * immediately cap the value.
             */

            const current =
                Number(
                    input.value
                ) || 0;


            if (
                current > available
            ) {

                input.value =
                    available > 0
                        ? available.toFixed(2)
                        : "";

            }

        }


        /* =================================================
           VALIDATE FORM STATE
        ================================================= */

        function validateState() {

            const required =
                round(
                    getRequired()
                );


            const allocated =
                round(
                    getAllocated()
                );


            let valid =
                true;


            let message =
                "Enter the customer's required quantity.";


            /*
             * ---------------------------------------------
             * REQUIRED QUANTITY
             * ---------------------------------------------
             */

            if (
                required <= 0
            ) {

                valid =
                    false;

                message =
                    "Enter the customer's required quantity.";

            }


            /*
             * ---------------------------------------------
             * TOTAL AVAILABLE
             * ---------------------------------------------
             */

            else if (
                required >
                totalAvailable + 0.001
            ) {

                valid =
                    false;

                message =
                    "The customer's requested quantity exceeds the total milk available.";

            }


            /*
             * ---------------------------------------------
             * ALLOCATIONS
             * ---------------------------------------------
             */

            const usedFarms =
                new Set();


            for (
                const row
                of getRows()
            ) {

                const select =
                    row.querySelector(
                        ".farm-select"
                    );


                const input =
                    row.querySelector(
                        ".allocation-liters"
                    );


                if (
                    !select ||
                    !input
                ) {

                    continue;

                }


                const farmId =
                    select.value;


                const liters =
                    round(
                        Number(
                            input.value
                        ) || 0
                    );


                if (
                    !farmId &&
                    liters <= 0
                ) {

                    valid =
                        false;

                    message =
                        "Every allocation row must contain a farm and quantity.";

                    break;

                }


                if (
                    !farmId
                ) {

                    valid =
                        false;

                    message =
                        "Select a farm for every allocation.";

                    break;

                }


                if (
                    liters <= 0
                ) {

                    valid =
                        false;

                    message =
                        "Every selected farm must have a positive allocation.";

                    break;

                }


                /*
                 * Duplicate farm
                 */

                if (
                    usedFarms.has(
                        farmId
                    )
                ) {

                    valid =
                        false;

                    message =
                        "The same farm cannot be allocated more than once.";

                    break;

                }


                usedFarms.add(
                    farmId
                );


                /*
                 * Farm-specific availability
                 */

                const option =
                    select.options[
                        select.selectedIndex
                    ];


                const farmAvailable =
                    Math.max(
                        0,
                        Number(
                            option?.dataset?.available
                        ) || 0
                    );


                if (
                    liters >
                    farmAvailable + 0.001
                ) {

                    valid =
                        false;

                    message =
                        "One of the farm allocations exceeds that farm's available milk.";

                    break;

                }

            }


            /*
             * ---------------------------------------------
             * TOTAL ALLOCATION
             * ---------------------------------------------
             */

            if (
                valid &&
                allocated >
                totalAvailable + 0.001
            ) {

                valid =
                    false;

                message =
                    "The total allocated milk exceeds the total milk available.";

            }


            /*
             * ---------------------------------------------
             * EXACT MATCH
             * ---------------------------------------------
             */

            if (
                valid &&
                Math.abs(
                    allocated -
                    required
                ) > 0.001
            ) {

                valid =
                    false;


                if (
                    allocated <
                    required
                ) {

                    message =
                        (
                            required -
                            allocated
                        ).toFixed(2) +
                        " L still needs to be allocated.";

                } else {

                    message =
                        (
                            allocated -
                            required
                        ).toFixed(2) +
                        " L has been allocated too much.";

                }

            }


            /*
             * ---------------------------------------------
             * UPDATE STATUS
             * ---------------------------------------------
             */

            statusOutput.classList.remove(
                "good",
                "warning",
                "danger"
            );


            if (
                required >
                totalAvailable + 0.001
            ) {

                statusOutput.classList.add(
                    "danger"
                );

            }

            else if (
                allocated >
                totalAvailable + 0.001
            ) {

                statusOutput.classList.add(
                    "danger"
                );

            }

            else if (
                allocated >
                required
            ) {

                statusOutput.classList.add(
                    "danger"
                );

            }

            else if (
                allocated <
                required
            ) {

                statusOutput.classList.add(
                    "warning"
                );

            }

            else if (
                required > 0 &&
                allocated === required
            ) {

                statusOutput.classList.add(
                    "good"
                );

            }


            statusOutput.textContent =
                valid
                    ? "Allocation is ready. The sale can be submitted."
                    : message;


            /*
             * ---------------------------------------------
             * SUBMIT BUTTON
             * ---------------------------------------------
             */

            submitButton.disabled =
                !valid;


            return valid;

        }


        /* =================================================
           UPDATE SUMMARY
        ================================================= */

        function updateSummary() {

            const required =
                round(
                    getRequired()
                );


            const allocated =
                round(
                    getAllocated()
                );


            requiredOutput.textContent =
                required.toFixed(2) +
                " L";


            allocatedOutput.textContent =
                allocated.toFixed(2) +
                " L";


            cashOutput.textContent =
                "KSh " +
                (
                    required *
                    price
                ).toFixed(2);


            validateState();

        }


        /* =================================================
           BIND ROW
        ================================================= */

        function bindRow(row) {

            const select =
                row.querySelector(
                    ".farm-select"
                );


            const input =
                row.querySelector(
                    ".allocation-liters"
                );


            if (
                !select ||
                !input
            ) {

                return;

            }


            select.addEventListener(
                "change",
                function() {

                    updateRowAvailability(
                        row
                    );

                    updateSummary();

                }
            );


            input.addEventListener(
                "input",
                function() {

                    const option =
                        select.options[
                            select.selectedIndex
                        ];


                    const available =
                        Math.max(
                            0,
                            Number(
                                option?.dataset?.available
                            ) || 0
                        );


                    const value =
                        Number(
                            input.value
                        ) || 0;


                    /*
                     * Immediately prevent an individual
                     * farm allocation from exceeding its
                     * available milk.
                     */

                    if (
                        value >
                        available
                    ) {

                        input.value =
                            available.toFixed(2);

                    }


                    updateSummary();

                }
            );


            updateRowAvailability(
                row
            );

        }


        /* =================================================
           INITIAL ROWS
        ================================================= */

        container
            .querySelectorAll(
                ".allocation-row"
            )
            .forEach(
                bindRow
            );


        /* =================================================
           CUSTOMER INPUT
        ================================================= */

        saleLitersInput.addEventListener(
            "input",
            function() {

                const required =
                    getRequired();


                /*
                 * Browser-level maximum enforcement.
                 */

                if (
                    required >
                    totalAvailable
                ) {

                    saleLitersInput.classList.add(
                        "invalid"
                    );

                } else {

                    saleLitersInput.classList.remove(
                        "invalid"
                    );

                }


                updateSummary();

            }
        );


        /* =================================================
           ADD FARM
        ================================================= */

        addButton.addEventListener(
            "click",
            function() {

                const rows =
                    getRows();


                const index =
                    rows.length;


                const firstRow =
                    rows[0];


                if (!firstRow) {

                    return;

                }


                /*
                 * Do not allow more rows than farms.
                 */

                if (
                    index >=
                    <%= visibleFarmData.length %>
                ) {

                    alert(
                        "All available farms have already been added."
                    );

                    return;

                }


                const row =
                    firstRow.cloneNode(
                        true
                    );


                const select =
                    row.querySelector(
                        ".farm-select"
                    );


                const input =
                    row.querySelector(
                        ".allocation-liters"
                    );


                const availability =
                    row.querySelector(
                        ".row-available"
                    );


                select.name =
                    `allocations[${index}][farm]`;


                input.name =
                    `allocations[${index}][liters]`;


                select.value =
                    "";


                input.value =
                    "";


                input.removeAttribute(
                    "max"
                );


                if (availability) {

                    availability.textContent =
                        "0.00 L";

                }


                /*
                 * Disable farms already selected
                 * in other rows.
                 */

                select
                    .querySelectorAll(
                        "option"
                    )
                    .forEach(
                        option => {

                            option.disabled =
                                false;

                        }
                    );


                container.appendChild(
                    row
                );


                bindRow(
                    row
                );


                updateSelectedFarmOptions();

                updateSummary();

            }
        );


        /* =================================================
           PREVENT DUPLICATE FARM SELECTIONS
        ================================================= */

        function updateSelectedFarmOptions() {

            const selects =
                container.querySelectorAll(
                    ".farm-select"
                );


            const selected =
                new Set();


            selects.forEach(
                select => {

                    if (
                        select.value
                    ) {

                        selected.add(
                            select.value
                        );

                    }

                }
            );


            selects.forEach(
                select => {

                    const current =
                        select.value;


                    select
                        .querySelectorAll(
                            "option"
                        )
                        .forEach(
                            option => {

                                if (
                                    !option.value
                                ) {

                                    return;

                                }


                                option.disabled =
                                    option.value !==
                                    current &&
                                    selected.has(
                                        option.value
                                    );

                            }
                        );

                }
            );

        }


        /* =================================================
           UPDATE SELECTS WHEN FARM CHANGES
        ================================================= */

        container.addEventListener(
            "change",
            function(event) {

                if (
                    event.target.classList.contains(
                        "farm-select"
                    )
                ) {

                    updateSelectedFarmOptions();

                }

            }
        );


        /* =================================================
           FINAL SUBMIT VALIDATION
           -----------------------------------------------
           This is intentionally repeated here.
           The server remains authoritative.
        ================================================= */

        form.addEventListener(
            "submit",
            function(event) {

                /*
                 * Never allow submission if the complete
                 * client-side validation fails.
                 */

                if (
                    !validateState()
                ) {

                    event.preventDefault();

                    return;

                }


                const required =
                    round(
                        getRequired()
                    );


                const allocated =
                    round(
                        getAllocated()
                    );


                /*
                 * HARD TOTAL AVAILABLE CHECK
                 */

                if (
                    required >
                    totalAvailable + 0.001
                ) {

                    event.preventDefault();

                    alert(
                        "The customer's requested milk exceeds the total available milk."
                    );

                    return;

                }


                if (
                    allocated >
                    totalAvailable + 0.001
                ) {

                    event.preventDefault();

                    alert(
                        "The total allocated milk exceeds the total available milk."
                    );

                    return;

                }


                /*
                 * EXACT MATCH
                 */

                if (
                    Math.abs(
                        allocated -
                        required
                    ) > 0.001
                ) {

                    event.preventDefault();

                    alert(
                        "The total allocated milk must exactly equal the customer's required milk."
                    );

                    return;

                }


                /*
                 * FARM CHECK
                 */

                const usedFarms =
                    new Set();


                for (
                    const row
                    of getRows()
                ) {

                    const select =
                        row.querySelector(
                            ".farm-select"
                        );


                    const input =
                        row.querySelector(
                            ".allocation-liters"
                        );


                    const farmId =
                        select.value;


                    const liters =
                        round(
                            Number(
                                input.value
                            ) || 0
                        );


                    if (
                        !farmId ||
                        liters <= 0
                    ) {

                        event.preventDefault();

                        alert(
                            "Every allocation requires a farm and a positive quantity."
                        );

                        return;

                    }


                    if (
                        usedFarms.has(
                            farmId
                        )
                    ) {

                        event.preventDefault();

                        alert(
                            "The same farm cannot be allocated more than once."
                        );

                        return;

                    }


                    usedFarms.add(
                        farmId
                    );


                    const option =
                        select.options[
                            select.selectedIndex
                        ];


                    const farmAvailable =
                        Math.max(
                            0,
                            Number(
                                option?.dataset?.available
                            ) || 0
                        );


                    if (
                        liters >
                        farmAvailable + 0.001
                    ) {

                        event.preventDefault();

                        alert(
                            "One of the farm allocations exceeds that farm's available milk."
                        );

                        return;

                    }

                }

            }
        );


        /* =================================================
           INITIAL STATE
        ================================================= */

        updateSelectedFarmOptions();

        updateSummary();

    }
);

</script>