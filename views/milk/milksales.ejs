        width: 100%;
    }

    .milk-sales-page .sale-summary {
        grid-template-columns: 1fr;
    }

    .milk-sales-page .summary-item {
        border-right: 0;

        border-bottom:
            1px solid
            var(--border);
    }

    .milk-sales-page .summary-item:last-child {
        border-bottom: 0;
    }

    .milk-sales-page .form-action {
        display: block;
    }

    .milk-sales-page .complete-button {
        width: 100%;
    }
}


/* =========================================================
   SMALL MOBILE
========================================================= */

@media (max-width: 400px) {

    .milk-sales-page {
        width: calc(100% - 12px);
    }

    .milk-sales-page .milk-card {
        padding: 14px;
    }

    .milk-sales-page .sales-hero {
        padding: 20px 17px;
    }

    .milk-sales-page .sales-hero h1 {
        font-size: 27px;
    }

    .milk-sales-page .form-control {
        min-height: 44px;
        font-size: 12px;
    }

    .milk-sales-page .allocation-row {
        padding: 11px;
    }
}

</style>


<div
    class="milk-sales-page"
    data-price="<%= pagePrice %>"
>


    <!-- =====================================================
         HERO
    ====================================================== -->

    <header class="sales-hero">

        <div class="hero-content">

            <div class="hero-kicker">
