<% /*
==========================================================
DAIRY SET PAGE

FILE:
    views/dairySet.ejs

PURPOSE:
    Display the profile page for a Dairy asset or
    structure.

    When the current Dairy record is an AgroStore,
    its inventory is displayed using:

        update/storage/animal-feed-updates.ejs

IMPORTANT AGROSTORE LOGIC:

    /dairy/:id
        |
        | id = AgroStore._id
        v
    AgroStore
        |
        | roomNumber
        v
    Dairy.dwellNumber
        |
        v
    animalFeeds

The AgroStore itself is NOT an inventory item.

The normal `feed` variable remains the normal Update feed
for the current Dairy record and is not used as AgroStore
inventory.
==========================================================
*/ %>


<div class="dairy-page">


    <!-- =================================================
         UPDATE CARDS
    ================================================== -->

    <% if (user) { %>

        <%- include("update/update-cards", {
            user: user
        }) %>

    <% } %>



    <!-- =================================================
         PROFILE
    ================================================== -->

    <% if (dairy && dairy.code != null) { %>

        <%- include("update/profile-card", {
            dairy: dairy,
            user: user
        }) %>

    <% } %>



    <!-- =================================================
         AGROSTORE INVENTORY
         
         An AgroStore is identified by its negative
         roomNumber.

         The backend of /dairy/:id supplies:

             animalFeeds

         These are the Dairy records whose:

             dwellNumber === dairy.roomNumber

         `dairy` is the AgroStore itself.
         
         `animalFeeds` contains its inventory.
    ================================================== -->

    <% if (
        dairy &&
        dairy.roomNumber != null &&
        Number(dairy.roomNumber) < 0
    ) { %>


        <%- include("update/storage/animal-feed-updates", {

            agroStore:
                dairy,

            storageId:
                dairy._id,

            animalFeeds:
                animalFeeds || []

        }) %>


    <% } %>



</div>