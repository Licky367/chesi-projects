<%
/*
==========================================================
DAIRY SET PAGE

FILE:
    views/dairySet.ejs

PURPOSE:
    Display the profile page for a Dairy asset or
    structure.

CONTENT ITEM LOGIC:

    ONLY a Dairy record with a valid dwellNumber
    is treated as a storage content item.

        dairy.dwellNumber exists
            ↓
        views/update/content-item.ejs

    If dairy.dwellNumber does NOT exist:

        content-item.ejs
            ↓
        NOT INCLUDED

IMPORTANT:

    content-item.ejs
        = STORAGE CONTENT ITEM DISPLAY CARD

    content-item-update.ejs
        = STOCK UPDATE SECTION

    Both are located in:

        views/update/

==========================================================
*/
%>


<%
/* =========================================================
   SAFE CONTENT ITEM
========================================================= */

const safeContentItem =
    typeof contentItem !== "undefined" &&
    contentItem
        ? contentItem
        : dairy;


/* =========================================================
   SAFE STORAGE
========================================================= */

const safeStorage =
    typeof storage !== "undefined"
        ? storage
        : null;


/* =========================================================
   SAFE MESSAGES
========================================================= */

const safeSuccessMessage =
    typeof successMessage !== "undefined"
        ? successMessage
        : null;


const safePageError =
    typeof pageError !== "undefined"
        ? pageError
        : null;


/* =========================================================
   SAFE LATEST STOCK UPDATE
========================================================= */

const safeLatestStockUpdate =
    typeof latestStockUpdate !== "undefined"
        ? latestStockUpdate
        : null;


/* =========================================================
   CONTENT ITEM CHECK

   ONLY Dairy records with a real dwellNumber
   are storage content items.
========================================================= */

const hasDwellNumber =
    dairy &&
    dairy.dwellNumber !== null &&
    dairy.dwellNumber !== undefined &&
    String(
        dairy.dwellNumber
    ).trim() !== "";

%>


<div class="dairy-page">


    <!-- =================================================
         UPDATE CARDS
    ================================================== -->

    <% if (user) { %>

        <%- include(
            "update/update-cards",
            {
                user:
                    user
            }
        ) %>

    <% } %>



    <!-- =================================================
         STORAGE CONTENT ITEM

         IMPORTANT:

         content-item.ejs is included ONLY when
         this Dairy record has a dwellNumber.

         Dairies without dwellNumber NEVER receive
         this include.
    ================================================== -->

    <% if (hasDwellNumber) { %>

        <%- include(
            "update/content-item",
            {
                dairy:
                    dairy,

                storage:
                    safeStorage,

                item:
                    safeContentItem,

                user:
                    user,

                successMessage:
                    safeSuccessMessage,

                pageError:
                    safePageError,

                latestStockUpdate:
                    safeLatestStockUpdate
            }
        ) %>

    <% } %>



    <!-- =================================================
         PROFILE
    ================================================== -->

    <% if (
        dairy &&
        dairy.code != null
    ) { %>

        <%- include(
            "update/profile-card",
            {
                dairy:
                    dairy,

                user:
                    user
            }
        ) %>

    <% } %>


</div>