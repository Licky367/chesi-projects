<% /*
==========================================================
DAIRY SET PAGE

FILE:
    views/dairySet.ejs

PURPOSE:
    Display the profile page for a Dairy asset or
    structure.

    CONTENT ITEM UPDATE LOGIC:

        The current Dairy record is treated as a
        storage content item when it has a dwellNumber.

        Therefore:

            dairy.dwellNumber != null
                ↓
            include content-update.ejs

    DATABASE UPDATE:

        content-update.ejs
            ↓
        contentItemController.js
            ↓
        contentItemService.js
            ↓
        Dairy

IMPORTANT:

    content-item.ejs
        = DISPLAY CARD ONLY

    content-update.ejs
        = STOCK UPDATE HISTORY + UPDATE MODAL

    Both files are located in:

        views/update/
==========================================================
*/ %>


<%
/* =========================================================
   SAFE CONTENT ITEM
========================================================= */

const safeContentItem =
    typeof contentItem !== "undefined" &&
    contentItem
        ? contentItem
        : dairy;


/* =========================================================
   SAFE STORAGE
========================================================= */

const safeStorage =
    typeof storage !== "undefined"
        ? storage
        : null;


/* =========================================================
   SAFE MESSAGES
========================================================= */

const safeSuccessMessage =
    typeof successMessage !== "undefined"
        ? successMessage
        : null;


const safePageError =
    typeof pageError !== "undefined"
        ? pageError
        : null;


/* =========================================================
   SAFE LATEST STOCK UPDATE
========================================================= */

const safeLatestStockUpdate =
    typeof latestStockUpdate !== "undefined"
        ? latestStockUpdate
        : null;


/* =========================================================
   CONTENT ITEM CHECK
========================================================= */

const hasDwellNumber =
    dairy &&
    dairy.dwellNumber !== null &&
    dairy.dwellNumber !== undefined &&
    String(
        dairy.dwellNumber
    ).trim() !== "";

%>


<div class="dairy-page">


    <!-- =================================================
         UPDATE CARDS
    ================================================== -->

    <% if (user) { %>

        <%- include("update/update-cards", {

            user:
                user

        }) %>

    <% } %>



    <!-- =================================================
         PROFILE
    ================================================== -->

    <% if (
        dairy &&
        dairy.code != null
    ) { %>

        <%- include("update/profile-card", {

            dairy:
                dairy,

            user:
                user

        }) %>

    <% } %>



    <!-- =================================================
         STORAGE CONTENT ITEM
    ==================================================

         A Dairy record with a dwellNumber is a
         storage content item.

         Therefore content-item.ejs is displayed only
         when dwellNumber exists.
    ================================================== -->

    <% if (hasDwellNumber) { %>


        <!-- =============================================
             CONTENT ITEM DISPLAY CARD
        ============================================== -->

        <%- include("update/content-item", {

            dairy:
                dairy,

            storage:
                safeStorage,

            item:
                safeContentItem,

            user:
                user,

            successMessage:
                safeSuccessMessage,

            pageError:
                safePageError,

            latestStockUpdate:
                safeLatestStockUpdate

        }) %>



        <!-- =============================================
             CONTENT UPDATE HISTORY + UPDATE MODAL
        ============================================== -->

        <%- include("update/content-update", {

            dairy:
                dairy,

            storage:
                safeStorage,

            item:
                safeContentItem,

            user:
                user,

            latestStockUpdate:
                safeLatestStockUpdate

        }) %>


    <% } %>


</div>