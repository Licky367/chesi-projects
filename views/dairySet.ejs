<% /*
==========================================================
DAIRY SET PAGE

FILE:
    views/dairySet.ejs

PURPOSE:
    Display the profile page for a Dairy asset or
    structure.

    The content-item card is displayed ONLY when the
    current dairy has a dwellNumber.

    DATABASE UPDATE:

        contentItemController.js
            ↓
        contentItemService.js
            ↓
        Dairy
==========================================================
*/ %>


<%
/* =========================================================
   SAFE CONTENT ITEM
========================================================= */

const safeContentItem =
    typeof contentItem !== "undefined" &&
    contentItem
        ? contentItem
        : dairy;


/* =========================================================
   SAFE STORAGE
========================================================= */

const safeStorage =
    typeof storage !== "undefined"
        ? storage
        : null;


/* =========================================================
   SAFE MESSAGES
========================================================= */

const safeSuccessMessage =
    typeof successMessage !== "undefined"
        ? successMessage
        : null;


const safePageError =
    typeof pageError !== "undefined"
        ? pageError
        : null;


/* =========================================================
   SAFE LATEST STOCK UPDATE
========================================================= */

const safeLatestStockUpdate =
    typeof latestStockUpdate !== "undefined"
        ? latestStockUpdate
        : null;

%>


<div class="dairy-page">


    <!-- =================================================
         UPDATE CARDS
    ================================================== -->

    <% if (user) { %>

        <%- include("update/update-cards", {
            user: user
        }) %>

    <% } %>



    <!-- =================================================
         PROFILE
    ================================================== -->

    <% if (
        dairy &&
        dairy.code != null
    ) { %>

        <%- include("update/profile-card", {
            dairy: dairy,
            user: user
        }) %>

    <% } %>



    <!-- =================================================
         CONTENT ITEM CARD
    ==================================================

         IMPORTANT:

         The ONLY condition for displaying this card
         is that the current Dairy has a dwellNumber.

         We do NOT require:

             contentItem
             storage
             storage._id
             contentItem._id

         here.

         The card is part of dairySet.ejs.

         Database updates are handled by:

             contentItemController.js
    ================================================== -->

    <% if (
        dairy &&
        dairy.dwellNumber != null &&
        String(
            dairy.dwellNumber
        ).trim() !== ""
    ) { %>


        <%- include("update/content-item", {

            dairy:
                dairy,

            storage:
                safeStorage,

            item:
                safeContentItem,

            user:
                user,

            successMessage:
                safeSuccessMessage,

            pageError:
                safePageError,

            latestStockUpdate:
                safeLatestStockUpdate,

            contentItemUpdateAction:
                typeof contentItemUpdateAction !== "undefined"
                    ? contentItemUpdateAction
                    : "/dairy/" + dairy._id + "/content-item"

        }) %>


    <% } %>


</div>