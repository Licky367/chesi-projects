<%
/*
==========================================================
DAIRY SET PAGE

FILE:
    views/dairySet.ejs

PURPOSE:
    Display the profile page for a Dairy asset or structure.

CONTENT ITEM LOGIC:
    ONLY a Dairy record with a NEGATIVE dwellNumber
    is treated as a storage content item.

        dairy.dwellNumber < 0
            ↓
        content-item.ejs
            ↓
        content-update.ejs

    null / undefined / 0 / positive
            ↓
        No storage content item.

    negative
            ↓
        Storage content item is included.

INCLUDES:
    views/update/update-cards.ejs
    views/update/content-item.ejs
    views/update/content-update.ejs
    views/update/profile-card.ejs
    views/update/feed.ejs
==========================================================
*/


/* =========================================================
   SAFE VALUES
========================================================= */

const safeDairy =
    typeof dairy !== "undefined" && dairy
        ? dairy
        : null;

const safeUser =
    typeof user !== "undefined"
        ? user
        : null;

const safeContentItem =
    typeof contentItem !== "undefined" && contentItem
        ? contentItem
        : safeDairy;

const safeStorage =
    typeof storage !== "undefined"
        ? storage
        : null;

const safeSuccessMessage =
    typeof successMessage !== "undefined"
        ? successMessage
        : null;

const safePageError =
    typeof pageError !== "undefined"
        ? pageError
        : null;

const safeLatestStockUpdate =
    typeof latestStockUpdate !== "undefined"
        ? latestStockUpdate
        : null;


/* =========================================================
   STORAGE CONTENT ITEM CHECK

   ONLY a negative dwellNumber qualifies.
========================================================= */

const hasNegativeDwellNumber =
    safeDairy &&
    safeDairy.dwellNumber !== null &&
    safeDairy.dwellNumber !== undefined &&
    Number(safeDairy.dwellNumber) < 0;

%>


<div class="dairy-page">


    <!-- =====================================================
         UPDATE CARDS
    ====================================================== -->

    <% if (safeUser) { %>

        <%- include(
            "update/update-cards",
            {
                user: safeUser
            }
        ) %>

    <% } %>


    <!-- =====================================================
         STORAGE CONTENT ITEM

         ONLY SHOWN WHEN dwellNumber IS NEGATIVE
    ====================================================== -->

    <% if (hasNegativeDwellNumber) { %>

        <%- include(
            "update/content-item",
            {
                dairy: safeDairy,
                storage: safeStorage,
                item: safeContentItem,
                user: safeUser,
                successMessage: safeSuccessMessage,
                pageError: safePageError,
                latestStockUpdate: safeLatestStockUpdate
            }
        ) %>


        <!-- ================================================
             CONTENT UPDATE

             Kept inside the same negative-dwell condition.
             It therefore cannot appear for ordinary Dairy
             records, structures, or positive dwell numbers.
        ================================================= -->

        <%- include(
            "update/content-update",
            {
                dairy: safeDairy,
                storage: safeStorage,
                item: safeContentItem,
                user: safeUser,
                successMessage: safeSuccessMessage,
                pageError: safePageError,
                latestStockUpdate: safeLatestStockUpdate
            }
        ) %>

    <% } %>


    <!-- =====================================================
         PROFILE
    ====================================================== -->

    <% if (safeDairy && safeDairy.code != null) { %>

        <%- include(
            "update/profile-card",
            {
                dairy: safeDairy,
                user: safeUser
            }
        ) %>

    <% } %>


    <!-- =====================================================
         FEED

         Feed is rendered at the bottom of the Dairy page.
    ====================================================== -->

    <% if (safeDairy) { %>

        <%- include(
            "update/feed",
            {
                dairy: safeDairy,
                user: safeUser,
                storage: safeStorage,
                successMessage: safeSuccessMessage,
                pageError: safePageError
            }
        ) %>

    <% } %>


</div>