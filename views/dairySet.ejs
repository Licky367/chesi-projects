<!-- =====================================================
     DAIRY SET PAGE

     FILE:
         views/dairy/dairySet.ejs

     ROUTE:
         /dairy/assets/<%= dairy._id %>

     MAINTENANCE RULES:
     -----------------------------------------------------
     1. Maintenance composers are only available to:
            - admin
            - dairyWorker

     2. Maintenance composers are only available for
        dairies WITHOUT a code.

     3. maintComposer.ejs appears when maintenance is NOT
        currently required.

     4. maintenanceClearComposer.ejs appears when
        maintenance IS currently required.

     MILKING STATUS:
     -----------------------------------------------------
     5. Milking status card is only available to:
            - admin
            - dairyWorker

        AND only when the dairy code is:
            - positive
            - even

        Examples:
            2  -> SHOW
            4  -> SHOW
            6  -> SHOW
            8  -> SHOW

            1  -> HIDE
            3  -> HIDE
            5  -> HIDE
            0  -> HIDE
           -2  -> HIDE
           null -> HIDE

     6. The milking status card appears directly below
        the create-post card.
===================================================== -->


<!-- =====================================================
     UPDATE PAGE ASSETS
===================================================== -->

<link
    rel="stylesheet"
    href="/css/update/update.css"
>

<script src="/socket.io/socket.io.js"></script>


<!-- =====================================================
     UPDATE PAGE
===================================================== -->

<div class="dairy-page">


    <!-- =================================================
         PROFILE
    ================================================== -->

    <%- include("update/profile-card", {
        dairy: dairy,
        user: user
    }) %>



    <!-- =================================================
         CREATE POST
    ================================================== -->

    <% if (user) { %>

        <%- include("update/create", {
            user: user
        }) %>

    <% } %>



    <!-- =================================================
         MILKING STATUS
         
         Available only to:
         - admin
         - dairyWorker

         AND ONLY when:
         - code is positive
         - code is even
    ================================================== -->

    <% if (
        user &&
        (
            user.role === "admin" ||
            user.role === "dairyWorker"
        ) &&
        typeof dairy.code === "number" &&
        dairy.code > 0 &&
        dairy.code % 2 === 0
    ) { %>

        <%- include("update/milk-status", {
            dairy: dairy,
            user: user
        }) %>

    <% } %>



    <!-- =================================================
         MAINTENANCE COMPOSERS
         
         Conditions:
         -------------------------------------------------
         - User must be admin or dairyWorker
         - Dairy must NOT have a code
         - Show MARK composer when maintenance is not
           required
         - Show CLEAR composer when maintenance is required
    ================================================== -->

    <% if (
        user &&
        (
            user.role === "admin" ||
            user.role === "dairyWorker"
        ) &&
        (
            dairy.code === undefined ||
            dairy.code === null ||
            dairy.code === ""
        )
    ) { %>


        <!-- =============================================
             MARK MAINTENANCE

             Only when maintenance is NOT required.
        ============================================== -->

        <% if (dairy.needsMaintenance !== true) { %>

            <%- include("update/maintComposer", {
                user: user,
                dairy: dairy
            }) %>

        <% } %>



        <!-- =============================================
             CLEAR MAINTENANCE

             Only when maintenance IS required.
        ============================================== -->

        <% if (dairy.needsMaintenance === true) { %>

            <%- include("update/maintenanceClearComposer", {
                user: user,
                dairy: dairy
            }) %>

        <% } %>


    <% } %>


</div>



<!-- =====================================================
     UPDATE PAGE JAVASCRIPT
===================================================== -->

<script
    src="/js/update/index.js"
    defer
></script>