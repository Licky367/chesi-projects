<div class="dairy-page">


    <!-- =================================================
         UPDATE CARDS
    ================================================== -->

    <% if (user) { %>

        <%- include("update/update-cards", {
            user: user
        }) %>

    <% } %>


    <!-- =================================================
         PROFILE
    ================================================== -->

    <% if (dairy && dairy.code != null) { %>

        <%- include("update/profile-card", {
            dairy: dairy,
            user: user
        }) %>

    <% } %>


    <!-- =================================================
         AGROSTORE ANIMAL FEED CARD
         
         ONLY DISPLAY WHEN THIS DAIRY RECORD HAS A
         NEGATIVE roomNumber.
         
         Negative roomNumber identifies an AgroStore.
    ================================================== -->

    <% if (
        dairy &&
        dairy.roomNumber != null &&
        Number(dairy.roomNumber) < 0
    ) { %>

        <%- include("update/storage/animal-feed-card", {
            feed: dairy,
            storageId: dairy._id,
            agroStore: dairy
        }) %>

    <% } %>


</div>