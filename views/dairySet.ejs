<div class="dairy-page">

    <!-- =====================================================
         FIXED EDIT DETAILS LINK
    ====================================================== -->

    <% if (safeDairy && safeDairy._id) { %>

        <a
            href="/networth/assets/<%= safeDairy._id %>"
            class="fixed-edit-details"
        >
            Edit Details
        </a>

    <% } %>


    <!-- =====================================================
         UPDATE CARDS
    ====================================================== -->

    <% if (safeUser) { %>

        <%- include("update/update-cards", {
            user: safeUser
        }) %>

    <% } %>


    <!-- =====================================================
         STORAGE CONTENT UPDATE
    ====================================================== -->

    <% if (hasNegativeDwellNumber && safeContentItem) { %>

        <%- include("update/content-update", {
            dairy: safeDairy,
            storage: safeStorage,
            item: safeContentItem,
            user: safeUser,
            successMessage: safeSuccessMessage,
            pageError: safePageError,
            latestStockUpdate: safeLatestStockUpdate
        }) %>

    <% } %>


    <!-- =====================================================
         PROFILE CARD
    ====================================================== -->

    <% if (safeDairy && safeDairy.code != null) { %>

        <%- include("update/profile-card", {
            dairy: safeDairy,
            user: safeUser
        }) %>

    <% } %>
</div>


<style>
/* ==========================================================
   FIXED EDIT DETAILS LINK
========================================================== */

.fixed-edit-details {
    position: fixed;
    top: 15px;
    right: 15px;

    z-index: 9999;

    display: inline-block;

    padding: 10px 16px;

    text-decoration: none;

    font-size: 14px;
    font-weight: 600;

    border-radius: 8px;

    background: #000;
    color: #fff;

    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.2);
}

.fixed-edit-details:hover {
    opacity: 0.85;
}
</style>