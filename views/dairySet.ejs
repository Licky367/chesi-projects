<!-- =====================================================
     DAIRY SET PAGE

     FILE:
         views/dairy/dairySet.ejs

     ROUTE:
         /dairy/assets/<%= dairy._id %>
===================================================== -->


<!-- =====================================================
     UPDATE PAGE ASSETS
===================================================== -->

<link
    rel="stylesheet"
    href="/css/update/update.css"
>

<script src="/socket.io/socket.io.js"></script>


<!-- =====================================================
     UPDATE PAGE
===================================================== -->

<div class="dairy-page">


    <!-- =================================================
         UPDATE CARDS
    ================================================== -->

    <% if (user) { %>

        <%- include("update/update-cards", {
            user: user
        }) %>

    <% } %>


    <!-- =================================================
         PROFILE CARD

         SHOW ONLY WHEN DAIRY HAS A CODE.

         A code of 0 is still considered a valid code,
         therefore do NOT use:
             <% if (dairy.code) { %>

         Instead, explicitly exclude null and undefined.
    ================================================== -->

    <% if (
        dairy &&
        dairy.code !== null &&
        dairy.code !== undefined
    ) { %>

        <%- include("update/profile-card", {
            dairy: dairy,
            user: user
        }) %>

    <% } %>


</div>


<!-- =====================================================
     UPDATE PAGE JAVASCRIPT
===================================================== -->

<script
    src="/js/update/index.js"
    defer
></script>