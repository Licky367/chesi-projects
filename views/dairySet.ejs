<!-- =====================================================
     DAIRY SET PAGE
     
     FILE:
         views/dairy/dairySet.ejs
     
     ROUTE:
         /dairy/assets/<%= dairy._id %>
===================================================== -->


<!-- =====================================================
     UPDATE PAGE ASSETS
===================================================== -->

<link
    rel="stylesheet"
    href="/css/update/update.css"
>

<script src="/socket.io/socket.io.js"></script>


<!-- =====================================================
     UPDATE PAGE
===================================================== -->

<div class="dairy-page">


    <!-- =================================================
         PROFILE
    ================================================== -->

    <%- include("update/profile-card", {
        dairy: dairy,
        user: user
    }) %>


    <!-- =================================================
         CREATE POST
    ================================================== -->

    <% if (user) { %>

        <%- include("update/create-post", {
            user: user
        }) %>

    <% } %>


    <!-- =================================================
         MAINTENANCE COMPOSER
         
         Only displayed when the dairy has NO code.
    ================================================== -->

    <% if (
        user &&
        (
            dairy.code === undefined ||
            dairy.code === null ||
            dairy.code === ""
        )
    ) { %>

        <%- include("update/maintComposer", {
            user: user,
            dairy: dairy
        }) %>

    <% } %>


    <!-- =================================================
         FEED
    ================================================== -->

    <%- include("update/feed", {
        feed: feed,
        user: user
    }) %>


</div>


<!-- =====================================================
     UPDATE PAGE JAVASCRIPT
===================================================== -->

<script
    src="/js/update/index.js"
    defer
></script>