<% /*
==========================================================
DAIRY SET PAGE

FILE:
    views/dairySet.ejs

PURPOSE:
    Display the profile page for a Dairy asset or
    structure.

    The content-item card is displayed ONLY when the
    current dairy has a dwellNumber.

    DATABASE UPDATE:

        content-item-update.ejs
            ↓
        contentItemController.js
            ↓
        contentItemService.js
            ↓
        Dairy

IMPORTANT:

    content-item.ejs
        = DISPLAY CARD ONLY

    content-item-update.ejs
        = UPDATE FORM ONLY

    Both files are located in:

        views/update/
==========================================================
*/ %>


<%
/* =========================================================
   SAFE CONTENT ITEM
========================================================= */

const safeContentItem =
    typeof contentItem !== "undefined" &&
    contentItem
        ? contentItem
        : dairy;


/* =========================================================
   SAFE STORAGE
========================================================= */

const safeStorage =
    typeof storage !== "undefined"
        ? storage
        : null;


/* =========================================================
   SAFE MESSAGES
========================================================= */

const safeSuccessMessage =
    typeof successMessage !== "undefined"
        ? successMessage
        : null;


const safePageError =
    typeof pageError !== "undefined"
        ? pageError
        : null;


/* =========================================================
   SAFE LATEST STOCK UPDATE
========================================================= */

const safeLatestStockUpdate =
    typeof latestStockUpdate !== "undefined"
        ? latestStockUpdate
        : null;

%>


<div class="dairy-page">


    <!-- =================================================
         UPDATE CARDS
    ================================================== -->

    <% if (user) { %>

        <%- include("update/update-cards", {
            user: user
        }) %>

    <% } %>



    <!-- =================================================
         PROFILE
    ================================================== -->

    <% if (
        dairy &&
        dairy.code != null
    ) { %>

        <%- include("update/profile-card", {
            dairy: dairy,
            user: user
        }) %>

    <% } %>



    <!-- =================================================
         CONTENT ITEM
    ==================================================

         The content-item display is controlled ONLY
         by dwellNumber.

         No condition is placed here requiring:

             contentItem
             storage
             storage._id
             contentItem._id

         The content-item card itself handles its
         display data.

         The update form is a SEPARATE INCLUDE:

             update/content-item-update.ejs

         Therefore the card and its update form remain
         separate components.
    ================================================== -->

    <% if (
        dairy &&
        dairy.dwellNumber != null &&
        String(
            dairy.dwellNumber
        ).trim() !== ""
    ) { %>


        <!-- =============================================
             CONTENT ITEM CARD
        ============================================== -->

        <%- include("update/content-item", {

            dairy:
                dairy,

            storage:
                safeStorage,

            item:
                safeContentItem,

            user:
                user,

            successMessage:
                safeSuccessMessage,

            pageError:
                safePageError,

            latestStockUpdate:
                safeLatestStockUpdate

        }) %>


    <% } %>


</div>