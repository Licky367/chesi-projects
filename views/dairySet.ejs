<!-- =====================================================
     DAIRY SET PAGE

     FILE:
         views/dairy/dairySet.ejs

     ROUTE:
         /dairy/assets/<%= dairy._id %>

     PROFILE CARD:
     -----------------------------------------------------
     profile-card.ejs is displayed ONLY when dairy has
     a defined code.

     Valid:
         0
         1
         2
         -1
         -2
         etc.

     Hidden:
         null
         undefined
===================================================== -->


<!-- =====================================================
     UPDATE PAGE ASSETS
===================================================== -->

<link
    rel="stylesheet"
    href="/css/update/update.css"
>

<script src="/socket.io/socket.io.js"></script>


<!-- =====================================================
     UPDATE PAGE
===================================================== -->

<div class="dairy-page">


    <!-- =================================================
         UPDATE CARDS
    ================================================== -->

    <% if (user) { %>

        <%- include("update/update-cards", {
            user: user
        }) %>

    <% } %>


    <!-- =================================================
         PROFILE
         
         Show profile-card ONLY when dairy.code exists.
         
         IMPORTANT:
         != null checks BOTH null and undefined while
         still allowing valid values such as 0.
    ================================================== -->

    <% if (dairy && dairy.code != null) { %>

        <%- include("update/profile-card", {
            dairy: dairy,
            user: user
        }) %>

    <% } %>


</div>


<!-- =====================================================
     UPDATE PAGE JAVASCRIPT
===================================================== -->

<script
    src="/js/update/index.js"
    defer
></script>