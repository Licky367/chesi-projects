<% /*
==========================================================
DAIRY SET PAGE

FILE:
    views/dairySet.ejs

PURPOSE:
    Display the profile page for a Dairy asset or
    structure.

    CONTENT ITEM LOGIC:

        dairy.dwellNumber != null
            ↓
        views/update/content-item.ejs

    The content item card is displayed immediately
    after the update-cards section.

IMPORTANT:

    content-item.ejs
        = STORAGE CONTENT ITEM DISPLAY CARD

    content-item-update.ejs
        = STOCK UPDATE SECTION

    Both are located in:

        views/update/
==========================================================
*/ %>


<%
/* =========================================================
   SAFE CONTENT ITEM
========================================================= */

const safeContentItem =
    typeof contentItem !== "undefined" &&
    contentItem
        ? contentItem
        : dairy;


/* =========================================================
   SAFE STORAGE
========================================================= */

const safeStorage =
    typeof storage !== "undefined"
        ? storage
        : null;


/* =========================================================
   SAFE MESSAGES
========================================================= */

const safeSuccessMessage =
    typeof successMessage !== "undefined"
        ? successMessage
        : null;


const safePageError =
    typeof pageError !== "undefined"
        ? pageError
        : null;


/* =========================================================
   SAFE LATEST STOCK UPDATE
========================================================= */

const safeLatestStockUpdate =
    typeof latestStockUpdate !== "undefined"
        ? latestStockUpdate
        : null;


/* =========================================================
   CONTENT ITEM CHECK
========================================================= */

const hasDwellNumber =
    dairy &&
    dairy.dwellNumber !== null &&
    dairy.dwellNumber !== undefined &&
    String(
        dairy.dwellNumber
    ).trim() !== "";

%>


<div class="dairy-page">


    <!-- =================================================
         UPDATE CARDS
    ================================================== -->

    <% if (user) { %>

        <%- include("update/update-cards", {

            user:
                user

        }) %>

    <% } %>



    <!-- =================================================
         STORAGE CONTENT ITEM
    ==================================================

         If this Dairy record has a dwellNumber,
         it is treated as a storage content item.

         content-item.ejs is therefore rendered
         immediately after update-cards.ejs.
    ================================================== -->

    <% if (hasDwellNumber) { %>

        <%- include("update/content-item", {

            dairy:
                dairy,

            storage:
                safeStorage,

            item:
                safeContentItem,

            user:
                user,

            successMessage:
                safeSuccessMessage,

            pageError:
                safePageError,

            latestStockUpdate:
                safeLatestStockUpdate

        }) %>

    <% } %>



    <!-- =================================================
         PROFILE
    ================================================== -->

    <% if (
        dairy &&
        dairy.code != null
    ) { %>

        <%- include("update/profile-card", {

            dairy:
                dairy,

            user:
                user

        }) %>

    <% } %>


</div>