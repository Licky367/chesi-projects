<%
/*
============================================================
DAIRY SET PAGE

FILE:
    views/dairySet.ejs

PURPOSE:
    Display the appropriate Dairy page content.

RULES:
------------------------------------------------------------

1. NEGATIVE DWELL NUMBER
   If:
       dairy.dwellNumber < 0

   Include:
       update/update-cards.ejs
       update/content-item.ejs


2. POSITIVE CODE
   If:
       dairy.code > 0

   Include:
       update/update-cards.ejs
       update/profile-card.ejs


IMPORTANT:
------------------------------------------------------------

dwellNumber is ONLY used to identify a storage
content item.

Normal Dairy update cards are NOT dependent on
dwellNumber.

============================================================
*/
%>


<%
/* =========================================================
   SAFETY CHECK
========================================================= */

const hasNegativeDwellNumber =
    dairy &&
    dairy.dwellNumber !== null &&
    dairy.dwellNumber !== undefined &&
    Number(dairy.dwellNumber) < 0;


const hasPositiveCode =
    dairy &&
    dairy.code !== null &&
    dairy.code !== undefined &&
    Number(dairy.code) > 0;

%>


<% if (dairy) { %>

    <!-- =====================================================
         NEGATIVE DWELL NUMBER

         Storage content item.

         Includes:
             update-cards
             content-item
    ====================================================== -->

    <% if (hasNegativeDwellNumber) { %>

        <%- include(
            "update/update-cards",
            {
                dairy: dairy,
                user: user,
                itemLinks: itemLinks
            }
        ) %>


        <%- include(
            "update/content-item",
            {
                dairy: dairy,
                storage: storage,
                item: contentItem || dairy,
                user: user,
                successMessage: successMessage,
                pageError: pageError,
                latestStockUpdate: latestStockUpdate
            }
        ) %>

    <% } %>



    <!-- =====================================================
         POSITIVE CODE

         Normal Dairy asset/animal.

         Includes:
             update-cards
             profile-card
    ====================================================== -->

    <% if (hasPositiveCode) { %>

        <%- include(
            "update/update-cards",
            {
                dairy: dairy,
                user: user,
                itemLinks: itemLinks
            }
        ) %>


        <%- include(
            "update/profile-card",
            {
                dairy: dairy,
                user: user
            }
        ) %>

    <% } %>

<% } %>