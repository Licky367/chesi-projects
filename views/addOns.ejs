<%
// ==========================================================
// views/addOns.ejs
// ==========================================================
//
// FINANCIAL ADD-ONS PAGE
//
// DATA PROVIDED:
//
//     dairy
//     assetDairies
//     user
//
// COMPONENTS:
//
//     addOns/s1.ejs
//     addOns/s.revenue.ejs
//     addOns/s.liability.ejs
//
// STYLES:
//
//     /css/update/addOns.css
//
// ==========================================================
%>


<div class="addons-page">


    <!-- ==================================================
         PAGE INTRO / WELCOME
         ================================================== -->

    <section
        class="addons-section addons-welcome-section"
        aria-label="Financial records overview"
    >

        <%- include(
            "addOns/s1.ejs",
            {
                dairy: dairy,
                user: user
            }
        ) %>

    </section>



    <!-- ==================================================
         FINANCIAL ENTRY AREA
         ================================================== -->

    <section
        class="addons-financial-section"
        aria-label="Financial records"
    >

        <div class="addons-section-heading">

            <div class="addons-heading-copy">

                <span class="addons-heading-eyebrow">
                    FINANCIAL ACTIVITY
                </span>

                <h1>
                    Record Financial Information
                </h1>

                <p>
                    Keep track of income generated and financial
                    obligations associated with
                    <strong><%= dairy.name %></strong>.
                </p>

            </div>

        </div>



        <!-- ==================================================
             REVENUE + LIABILITY
             ================================================== -->

        <div class="addons-financial-grid">


            <!-- ============================
                 REVENUE
                 ============================ -->

            <article class="addons-financial-item addons-revenue-item">

                <%- include(
                    "addOns/s.revenue.ejs",
                    {
                        dairy: dairy,
                        user: user
                    }
                ) %>

            </article>



            <!-- ============================
                 LIABILITY
                 ============================ -->

            <article class="addons-financial-item addons-liability-item">

                <%- include(
                    "addOns/s.liability.ejs",
                    {
                        dairy: dairy,
                        user: user
                    }
                ) %>

            </article>


        </div>

    </section>


</div>