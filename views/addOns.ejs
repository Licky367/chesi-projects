<%
// ==========================================================
// views/addOns.ejs
// =========================================================
//
// FINANCIAL ADD-ONS PAGE
//
// DATA PROVIDED:
//
//     dairy
//     assetDairies
//     user
//
// COMPONENTS:
//
//     addOns/s1.ejs
//     addOns/s.revenue.ejs
//     addOns/s.liability.ejs
//
// STYLES:
//
//     /css/update/addOns.css
//
// ==========================================================
%>


<div class="addons-page">

    <!-- =====================================================
         FIXED EDIT DETAILS
         ADMIN ONLY
    ====================================================== -->

    <% if (user.role === "admin") { %>

        <a
            href="/networth/asset/<%= dairy._id %>"
            class="fixed-edit-details"
        >
            Edit Details
        </a>

    <% } %>


    <!-- ==================================================
         PAGE INTRO / WELCOME
         ================================================== -->

    <section
        class="addons-section addons-welcome-section"
        aria-label="Financial records overview"
    >

        <%- include(
            "addOns/s1.ejs",
            {
                dairy: dairy,
                user: user
            }
        ) %>

    </section>



    <!-- ==================================================
         FINANCIAL ENTRY AREA
         ================================================== -->

    <section
        class="addons-financial-section"
        aria-label="Financial records"
    >

        <div class="addons-section-heading">

            <div class="addons-heading-copy">

                <span class="addons-heading-eyebrow">
                    FINANCIAL ACTIVITY
                </span>

                <h1>
                    Record Financial Information
                </h1>

                <p>
                    Keep track of income generated and financial
                    obligations associated with
                    <strong><%= dairy.name %></strong>.
                </p>

            </div>

        </div>



        <!-- ==================================================
             REVENUE + LIABILITY
             ================================================== -->

        <div class="addons-financial-grid">


            <!-- ============================
                 REVENUE
                 ============================ -->

            <article class="addons-financial-item addons-revenue-item">

                <%- include(
                    "addOns/s.revenue.ejs",
                    {
                        dairy: dairy,
                        user: user
                    }
                ) %>

            </article>



            <!-- ============================
                 LIABILITY
                 ============================ -->

            <article class="addons-financial-item addons-liability-item">

                <%- include(
                    "addOns/s.liability.ejs",
                    {
                        dairy: dairy,
                        user: user
                    }
                ) %>

            </article>


        </div>

    </section>


</div>
<style>
/* ==========================================================
   FIXED EDIT DETAILS
========================================================== */

.fixed-edit-details {
    position: fixed;

    top: 135px;
    right: 15px;

    z-index: 9999;

    display: inline-block;

    padding: 10px 16px;

    text-decoration: none;

    font-size: 14px;
    font-weight: 600;

    border-radius: 8px;

    background: #000;
    color: #fff;

    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.2);
}

.fixed-edit-details:hover {
    opacity: 0.85;
}
</style>