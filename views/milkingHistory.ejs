<div class="milking-page">


  <!-- =====================================================
       PAGE HEADER
  ====================================================== -->

  <div class="page-header">

    <h2>
      🍼 Milking History
    </h2>

    <p>
      Review recorded milk production for this dairy animal.
    </p>

  </div>



  <!-- =====================================================
       MONTH FILTER
  ====================================================== -->

  <div class="filter-card">

    <form
      method="GET"
      class="filter-form"
    >

      <div class="filter-group">

        <label for="month">
          Select Month
        </label>

        <input
          id="month"
          type="month"
          name="month"
          value="<%= selectedMonth || '' %>"
        >

      </div>


      <button
        type="submit"
        class="search-button"
      >
        🔍 Search
      </button>

    </form>

  </div>



  <!-- =====================================================
       NO DATA
  ====================================================== -->

  <% if (!hasData) { %>

    <div class="empty-state">

      <div class="empty-icon">
        🐄
      </div>

      <h3>
        No Milking History
      </h3>

      <p>

        No milk collection records were found for

        <%= dairy?.name || "this dairy animal" %>

        during the selected month.

      </p>

    </div>


  <% } else { %>



    <!-- =================================================
         MONTH SUMMARY
    ================================================== -->

    <div class="summary-card">

      <div class="summary-icon">
        🥛
      </div>


      <div>

        <span>
          Monthly Total
        </span>

        <strong>
          <%= monthlyTotal %> L
        </strong>

      </div>

    </div>



    <!-- =================================================
         DAILY HISTORY
    ================================================== -->

    <div class="history-list">

      <% Object.keys(grouped).forEach(day => { %>

        <div class="day-card">


          <!-- =============================================
               DAY HEADER
          ============================================== -->

          <div class="day-header">

            <div>

              <h3>
                📅 <%= day %>
              </h3>

              <span>

                <%= grouped[day].entries.length %>

                record<%=

                  grouped[day].entries.length === 1

                    ? ""

                    : "s"

                %>

              </span>

            </div>


            <div class="daily-total">

              <small>
                Daily Total
              </small>

              <strong>
                <%= grouped[day].total %> L
              </strong>

            </div>

          </div>



          <!-- =============================================
               RECORDS TABLE
          ============================================== -->

          <div class="table-wrapper">

            <table>

              <thead>

                <tr>

                  <th>
                    Time
                  </th>

                  <th>
                    Liters
                  </th>

                  <th>
                    Remarks
                  </th>

                  <th>
                    Recorded By
                  </th>

                </tr>

              </thead>


              <tbody>

                <% grouped[day].entries.forEach(entry => { %>

                  <tr>

                    <td>

                      <span class="time-badge">

                        <%= new Date(

                          entry.date

                        ).toLocaleTimeString(

                          [],

                          {

                            hour: "2-digit",

                            minute: "2-digit"

                          }

                        ) %>

                      </span>

                    </td>


                    <td>

                      <strong class="liters-value">

                        <%= entry.liters %> L

                      </strong>

                    </td>


                    <td>

                      <%= entry.remarks || "-" %>

                    </td>


                    <td>

                      <div class="recorded-by">

                        <div class="user-dot">

                          <%= (

                            entry.recordedBy?.name ||

                            "U"

                          )

                            .charAt(0)

                            .toUpperCase() %>

                        </div>


                        <span>

                          <%=

                            entry.recordedBy?.name ||

                            "Unknown"

                          %>

                        </span>

                      </div>

                    </td>

                  </tr>

                <% }) %>

              </tbody>

            </table>

          </div>

        </div>

      <% }) %>

    </div>



    <!-- =================================================
         MONTHLY TOTAL
    ================================================== -->

    <div class="monthly-total-card">

      <div class="monthly-total-icon">
        📊
      </div>


      <div>

        <span>
          Total Milk Collected This Month
        </span>


        <strong>
          <%= monthlyTotal %> Liters
        </strong>

      </div>

    </div>


  <% } %>


</div>



<style>

/* =====================================================
   PAGE
===================================================== */

.milking-page {

  width: 100%;

  max-width: 1000px;

  margin: 0 auto;

  padding: 20px 0 40px;

}


/* =====================================================
   HEADER
===================================================== */

.page-header {

  margin-bottom: 20px;

}


.page-header h2 {

  margin: 0 0 6px;

  color: #166534;

  font-size: 26px;

}


.page-header p {

  margin: 0;

  color: #6b7280;

  font-size: 14px;

}


/* =====================================================
   FILTER
===================================================== */

.filter-card {

  margin-bottom: 22px;

  padding: 18px;

  border-radius: 15px;

  background: #ffffff;

  box-shadow:
    0 6px 20px rgba(0, 0, 0, 0.06);

}


.filter-form {

  display: flex;

  align-items: flex-end;

  gap: 12px;

}


.filter-group {

  flex: 1;

}


.filter-group label {

  display: block;

  margin-bottom: 7px;

  color: #374151;

  font-size: 13px;

  font-weight: 700;

}


.filter-group input {

  width: 100%;

  box-sizing: border-box;

  padding: 11px 12px;

  border: 1px solid #d1d5db;

  border-radius: 9px;

  outline: none;

  background: #f9fafb;

  font-family: inherit;

}


.filter-group input:focus {

  border-color: #16a34a;

  box-shadow:
    0 0 0 3px rgba(22, 163, 74, 0.1);

}


.search-button {

  padding: 11px 18px;

  border: none;

  border-radius: 9px;

  background: #166534;

  color: #ffffff;

  font-weight: 700;

  cursor: pointer;

  transition: 0.2s ease;

}


.search-button:hover {

  background: #14532d;

  transform: translateY(-1px);

}


/* =====================================================
   SUMMARY
===================================================== */

.summary-card {

  display: flex;

  align-items: center;

  gap: 15px;

  margin-bottom: 20px;

  padding: 18px;

  border-radius: 15px;

  background:
    linear-gradient(
      135deg,
      #f0fdf4,
      #ffffff
    );

  box-shadow:
    0 6px 18px rgba(0, 0, 0, 0.05);

}


.summary-icon {

  display: flex;

  align-items: center;

  justify-content: center;

  width: 50px;

  height: 50px;

  border-radius: 12px;

  background: #dcfce7;

  font-size: 25px;

}


.summary-card span {

  display: block;

  margin-bottom: 4px;

  color: #6b7280;

  font-size: 13px;

}


.summary-card strong {

  color: #166534;

  font-size: 23px;

}


/* =====================================================
   DAY CARD
===================================================== */

.day-card {

  overflow: hidden;

  margin-bottom: 20px;

  border-radius: 15px;

  background: #ffffff;

  box-shadow:
    0 6px 20px rgba(0, 0, 0, 0.06);

}


.day-header {

  display: flex;

  align-items: center;

  justify-content: space-between;

  gap: 15px;

  padding: 17px 20px;

  border-bottom: 1px solid #e5e7eb;

  background: #f9fafb;

}


.day-header h3 {

  margin: 0 0 4px;

  color: #374151;

  font-size: 17px;

}


.day-header span {

  color: #9ca3af;

  font-size: 12px;

}


.daily-total {

  text-align: right;

}


.daily-total small {

  display: block;

  margin-bottom: 3px;

  color: #6b7280;

  font-size: 11px;

}


.daily-total strong {

  color: #166534;

  font-size: 18px;

}


/* =====================================================
   TABLE
===================================================== */

.table-wrapper {

  overflow-x: auto;

}


table {

  width: 100%;

  border-collapse: collapse;

}


th,

td {

  padding: 13px 15px;

  border-bottom: 1px solid #f0f0f0;

  text-align: left;

}


th {

  color: #6b7280;

  font-size: 12px;

  font-weight: 700;

  text-transform: uppercase;

}


td {

  color: #4b5563;

  font-size: 13px;

}


tbody tr:last-child td {

  border-bottom: none;

}


tbody tr:hover {

  background: #f9fafb;

}


.time-badge {

  display: inline-block;

  padding: 5px 8px;

  border-radius: 6px;

  background: #f3f4f6;

  color: #4b5563;

  font-size: 12px;

}


.liters-value {

  color: #166534;

}


.recorded-by {

  display: flex;

  align-items: center;

  gap: 8px;

}


.user-dot {

  display: flex;

  align-items: center;

  justify-content: center;

  width: 28px;

  height: 28px;

  border-radius: 50%;

  background: #dcfce7;

  color: #166534;

  font-size: 12px;

  font-weight: 700;

}


/* =====================================================
   MONTHLY TOTAL
===================================================== */

.monthly-total-card {

  display: flex;

  align-items: center;

  gap: 15px;

  margin-top: 25px;

  padding: 20px;

  border-radius: 15px;

  background:
    linear-gradient(
      135deg,
      #166534,
      #15803d
    );

  color: #ffffff;

  box-shadow:
    0 8px 20px rgba(22, 101, 52, 0.2);

}


.monthly-total-icon {

  font-size: 30px;

}


.monthly-total-card span {

  display: block;

  margin-bottom: 5px;

  opacity: 0.85;

  font-size: 13px;

}


.monthly-total-card strong {

  font-size: 24px;

}


/* =====================================================
   EMPTY STATE
===================================================== */

.empty-state {

  padding: 50px 20px;

  border-radius: 15px;

  background: #ffffff;

  text-align: center;

  box-shadow:
    0 6px 20px rgba(0, 0, 0, 0.06);

}


.empty-icon {

  margin-bottom: 10px;

  font-size: 45px;

}


.empty-state h3 {

  margin: 0 0 8px;

  color: #374151;

}


.empty-state p {

  margin: 0;

  color: #9ca3af;

  font-size: 14px;

}


/* =====================================================
   MOBILE
===================================================== */

@media (max-width: 650px) {

  .milking-page {

    padding: 10px 0 30px;

  }


  .filter-form {

    align-items: stretch;

    flex-direction: column;

  }


  .search-button {

    width: 100%;

  }


  .day-header {

    align-items: flex-start;

    flex-direction: column;

  }


  .daily-total {

    text-align: left;

  }


  th,

  td {

    padding: 10px;

    white-space: nowrap;

  }


  .monthly-total-card {

    align-items: flex-start;

  }

}

</style>