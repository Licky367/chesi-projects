<style>

  /* =========================================================
     SALES PAGE
  ========================================================= */

  .sales-page{
    max-width:1100px;
    margin:0 auto;
    padding:20px 0 40px;
  }


  /* =========================================================
     CARD
  ========================================================= */

  .sales-card{
    background:#fff;
    border-radius:18px;
    padding:24px;
    margin-bottom:20px;
    box-shadow:0 8px 25px rgba(0,0,0,.06);
  }


  /* =========================================================
     TITLE
  ========================================================= */

  .sales-title{
    display:flex;
    align-items:center;
    gap:12px;
    margin-bottom:22px;
    color:#166534;
    font-size:22px;
    font-weight:700;
  }

  .sales-title-icon{
    width:42px;
    height:42px;
    border-radius:12px;
    background:#dcfce7;
    display:flex;
    align-items:center;
    justify-content:center;
    flex-shrink:0;
  }

  .sales-title-icon i{
    font-size:20px;
    color:#15803d;
  }


  /* =========================================================
     FORM
  ========================================================= */

  .sales-row{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
    gap:18px;
  }

  .sales-field{
    display:flex;
    flex-direction:column;
    gap:7px;
  }

  .sales-field label{
    font-size:13px;
    color:#374151;
    font-weight:600;
  }

  .sales-input{
    width:100%;
    padding:12px 14px;
    border:1px solid #d1d5db;
    border-radius:9px;
    background:#f9fafb;
    font-size:14px;
    outline:none;
    transition:.25s;
    box-sizing:border-box;
  }

  .sales-input:focus{
    border-color:#16a34a;
    background:#fff;
    box-shadow:0 0 0 4px rgba(22,163,74,.10);
  }

  .sales-input[readonly]{
    background:#f3f4f6;
    cursor:not-allowed;
  }


  /* =========================================================
     BUTTONS
  ========================================================= */

  .sales-btn{
    border:none;
    border-radius:9px;
    padding:12px 18px;
    background:linear-gradient(135deg,#16a34a,#15803d);
    color:#fff;
    font-size:14px;
    font-weight:700;
    cursor:pointer;
    transition:.25s;
  }

  .sales-btn:hover{
    transform:translateY(-2px);
    box-shadow:0 8px 18px rgba(22,163,74,.22);
  }

  .sales-btn:disabled{
    background:#d1d5db;
    color:#6b7280;
    cursor:not-allowed;
    transform:none;
    box-shadow:none;
  }

  .omit-btn{
    border:none;
    border-radius:8px;
    padding:8px 12px;
    background:#fee2e2;
    color:#b91c1c;
    font-weight:700;
    cursor:pointer;
  }

  .omit-btn:hover{
    background:#fecaca;
  }


  /* =========================================================
     TABLE
  ========================================================= */

  .sales-table-wrapper{
    overflow-x:auto;
  }

  .sales-table{
    width:100%;
    min-width:700px;
    border-collapse:collapse;
  }

  .sales-table th{
    padding:14px 12px;
    background:#f9fafb;
    border-bottom:1px solid #e5e7eb;
    text-align:left;
    font-size:12px;
    text-transform:uppercase;
    color:#6b7280;
  }

  .sales-table td{
    padding:12px;
    border-bottom:1px solid #f0f0f0;
    vertical-align:middle;
  }

  .sales-table tbody tr:hover{
    background:#fbfffc;
  }


  /* =========================================================
     BADGES
  ========================================================= */

  .badge{
    display:inline-flex;
    align-items:center;
    padding:6px 10px;
    border-radius:999px;
    font-size:11px;
    font-weight:700;
    gap:6px;
  }

  .badge-green{
    background:#dcfce7;
    color:#166534;
  }

  .badge-blue{
    background:#dbeafe;
    color:#1d4ed8;
  }

  .badge-gray{
    background:#f3f4f6;
    color:#6b7280;
  }

  .badge-orange{
    background:#ffedd5;
    color:#c2410c;
  }


  /* =========================================================
     FARM SELECT
  ========================================================= */

  .farm-select{
    width:100%;
    padding:12px 14px;
    border:1px solid #d1d5db;
    border-radius:9px;
    background:#f9fafb;
    font-size:14px;
    outline:none;
    cursor:pointer;
  }

  .farm-select:focus{
    border-color:#16a34a;
    background:#fff;
    box-shadow:0 0 0 4px rgba(22,163,74,.10);
  }


  /* =========================================================
     FARM AVAILABILITY
  ========================================================= */

  .farm-availability{
    margin-top:18px;
    padding:15px;
    border-radius:12px;
    background:#f0fdf4;
    border:1px solid #dcfce7;
  }

  .farm-availability-title{
    font-size:12px;
    color:#166534;
    font-weight:700;
    margin-bottom:8px;
  }

  .farm-availability-value{
    font-size:24px;
    font-weight:800;
    color:#15803d;
  }


  /* =========================================================
     PRICE INFO
  ========================================================= */

  .price-info{
    margin-top:15px;
    background:#fefce8;
    padding:10px 14px;
    border-radius:10px;
    color:#854d0e;
    font-size:13px;
  }

  .price-info i{
    margin-right:6px;
  }


  /* =========================================================
     STANDING ORDER FORM
  ========================================================= */

  .standing-sale-form{
    display:flex;
    align-items:center;
    gap:12px;
    flex-wrap:wrap;
  }

  .standing-sale-form .sales-input{
    width:120px;
  }


  /* =========================================================
     TOTAL BOX
  ========================================================= */

  .total-box{
    display:flex;
    justify-content:space-between;
    align-items:center;
    border-left:5px solid #16a34a;
    font-size:18px;
    font-weight:700;
  }

  .total-number{
    color:#166534;
    font-size:28px;
    font-weight:800;
  }


  /* =========================================================
     FARM TOTALS
  ========================================================= */

  .farm-total-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
    gap:14px;
  }

  .farm-total{
    padding:16px;
    border:1px solid #e5e7eb;
    border-radius:12px;
    background:#fafafa;
  }

  .farm-total-name{
    font-weight:700;
    color:#166534;
    margin-bottom:12px;
  }

  .farm-total-row{
    display:flex;
    justify-content:space-between;
    gap:12px;
    font-size:13px;
    padding:5px 0;
  }

  .farm-total-row span:first-child{
    color:#6b7280;
  }

  .farm-total-row strong{
    color:#111827;
  }


  /* =========================================================
     EMPTY
  ========================================================= */

  .empty{
    text-align:center;
    padding:35px;
    color:#6b7280;
  }


  /* =========================================================
     RESPONSIVE
  ========================================================= */

  @media(max-width:650px){

    .sales-page{
      padding:15px 10px 30px;
    }

    .sales-card{
      padding:18px;
    }

    .sales-title{
      font-size:20px;
    }

    .total-box{
      flex-direction:column;
      align-items:flex-start;
      gap:12px;
    }

  }

</style>


<div class="sales-page">


  <!-- =======================================================
       1. MILK PRICE
  ======================================================= -->

  <div class="sales-card">

    <div class="sales-title">

      <div class="sales-title-icon">
        <i class="fas fa-sack-dollar"></i>
      </div>

      <span>Milk Price</span>

    </div>


    <form
      method="POST"
      action="/sales/price"
    >

      <div class="sales-row">

        <div class="sales-field">

          <label>
            Current Price (KES/L)
          </label>

          <input
            class="sales-input"
            type="number"
            name="price"
            min="0"
            step="0.1"
            value="<%= Number(currentPrice || 0) %>"
            <%= user?.role === "admin" ? "" : "readonly" %>
          >

        </div>

      </div>


      <% if (user?.role === "admin") { %>

        <button
          type="submit"
          class="sales-btn"
          style="margin-top:18px;"
        >

          <i class="fas fa-floppy-disk"></i>

          Save Price

        </button>

      <% } else { %>

        <div class="price-info">

          <i class="fas fa-lock"></i>

          Only administrators can change milk price.

        </div>

      <% } %>

    </form>

  </div>



  <!-- =======================================================
       2. FARM MILK POSITION
  ======================================================= -->

  <div class="sales-card">

    <div class="sales-title">

      <div class="sales-title-icon">
        <i class="fas fa-cow"></i>
      </div>

      <span>Farm Milk Position</span>

    </div>


    <% if (farmTotals && farmTotals.length) { %>

      <div class="farm-total-grid">

        <% farmTotals.forEach(farm => { %>

          <div class="farm-total">

            <div class="farm-total-name">

              <%= farm.farmName %>

            </div>


            <div class="farm-total-row">

              <span>Production</span>

              <strong>
                <%= Number(farm.production || 0).toFixed(2) %> L
              </strong>

            </div>


            <div class="farm-total-row">

              <span>Sold</span>

              <strong>
                <%= Number(farm.sold || 0).toFixed(2) %> L
              </strong>

            </div>


            <div class="farm-total-row">

              <span>Available</span>

              <strong>
                <%= Number(farm.available || 0).toFixed(2) %> L
              </strong>

            </div>


            <div class="farm-total-row">

              <span>Revenue</span>

              <strong>
                KES <%= Number(farm.revenue || 0).toFixed(2) %>
              </strong>

            </div>

          </div>

        <% }) %>

      </div>


    <% } else { %>

      <div class="empty">

        <i class="fas fa-warehouse"></i>

        No dairy farms are available for your account.

      </div>

    <% } %>

  </div>



  <!-- =======================================================
       3. STANDING ORDERS
  ======================================================= -->

  <div class="sales-card">

    <div class="sales-title">

      <div class="sales-title-icon">
        <i class="fas fa-repeat"></i>
      </div>

      <span>
        Standing Orders
      </span>

    </div>


    <% if (standingOrders && standingOrders.length) { %>

      <div class="sales-table-wrapper">

        <table class="sales-table">

          <thead>

            <tr>

              <th>Customer</th>

              <th>Liters</th>

              <th>Status</th>

              <th>Farm</th>

              <th>Daily Sale</th>

              <% if (user?.role === "admin") { %>

                <th>Action</th>

              <% } %>

            </tr>

          </thead>


          <tbody>

            <% standingOrders.forEach(order => { %>

              <tr>

                <td>

                  <strong>
                    <%= order.customerName %>
                  </strong>

                </td>


                <td>

                  <%= Number(
                    order.liters || 0
                  ).toFixed(2) %> L

                </td>


                <td>

                  <% if (order.isFuture) { %>

                    <span class="badge badge-blue">

                      <i class="fas fa-clock"></i>

                      Effective Tomorrow

                    </span>

                  <% } else if (order.saleRecordedToday) { %>

                    <span class="badge badge-green">

                      <i class="fas fa-circle-check"></i>

                      Recorded Today

                    </span>

                  <% } else { %>

                    <span class="badge badge-gray">

                      <i class="fas fa-hourglass-half"></i>

                      Ready

                    </span>

                  <% } %>

                </td>


                <!-- =================================================
                     FARM SELECTION
                ================================================== -->

                <td>

                  <select
                    class="farm-select standing-farm-select"
                    required
                  >

                    <option value="">
                      Select farm
                    </option>

                    <% farmTotals.forEach(farm => { %>

                      <option
                        value="<%= farm.farmId %>"
                        data-available="<%= Number(farm.available || 0) %>"
                      >

                        <%= farm.farmName %>
                        —
                        <%= Number(farm.available || 0).toFixed(2) %> L available

                      </option>

                    <% }) %>

                  </select>

                </td>


                <!-- =================================================
                     STANDING ORDER SALE
                ================================================== -->

                <td>

                  <form
                    method="POST"
                    action="/sales/standing-order"
                    class="standing-sale-form"
                  >

                    <input
                      type="hidden"
                      name="standingOrderId"
                      value="<%= order._id %>"
                    >


                    <input
                      type="hidden"
                      name="farmId"
                      value=""
                    >


                    <input
                      class="sales-input"
                      type="number"
                      name="liters"
                      step="0.1"
                      min="0"
                      value="<%= Number(order.liters || 0) %>"
                      readonly
                    >


                    <% if (order.isFuture) { %>

                      <button
                        type="button"
                        class="sales-btn"
                        disabled
                      >

                        <i class="fas fa-ban"></i>

                        Not Active

                      </button>


                    <% } else if (order.saleRecordedToday) { %>

                      <button
                        type="button"
                        class="sales-btn"
                        disabled
                      >

                        <i class="fas fa-circle-check"></i>

                        Recorded

                      </button>


                    <% } else { %>

                      <button
                        type="submit"
                        class="sales-btn"
                      >

                        <i class="fas fa-paper-plane"></i>

                        Submit Sale

                      </button>

                    <% } %>

                  </form>

                </td>


                <% if (user?.role === "admin") { %>

                  <td>

                    <form
                      method="POST"
                      action="/sales/standing-order/omit"
                      onsubmit="return confirm('Omit this standing order?');"
                    >

                      <input
                        type="hidden"
                        name="id"
                        value="<%= order._id %>"
                      >


                      <button
                        type="submit"
                        class="omit-btn"
                      >

                        <i class="fas fa-trash-can"></i>

                        Omit

                      </button>

                    </form>

                  </td>

                <% } %>

              </tr>

            <% }) %>

          </tbody>

        </table>

      </div>


    <% } else { %>

      <div class="empty">

        <i class="fas fa-box-open"></i>

        No standing orders available.

      </div>

    <% } %>

  </div>



  <!-- =======================================================
       4. ADD STANDING ORDER
  ======================================================= -->

  <div class="sales-card">

    <div class="sales-title">

      <div class="sales-title-icon">
        <i class="fas fa-repeat"></i>
      </div>

      <span>
        Add Standing Order
      </span>

    </div>


    <form
      method="POST"
      action="/sales/standing-order/add"
    >

      <div class="sales-row">

        <div class="sales-field">

          <label>
            Customer Name
          </label>

          <input
            class="sales-input"
            type="text"
            name="customerName"
            placeholder="Customer name"
            required
          >

        </div>


        <div class="sales-field">

          <label>
            Default Liters Per Day
          </label>

          <input
            class="sales-input"
            type="number"
            name="liters"
            step="0.1"
            min="0"
            placeholder="Liters"
            required
          >

        </div>

      </div>


      <button
        type="submit"
        class="sales-btn"
        style="margin-top:18px;"
      >

        <i class="fas fa-circle-plus"></i>

        Add Standing Order

      </button>

    </form>

  </div>



  <!-- =======================================================
       5. MANUAL SALE
  ======================================================= -->

  <div class="sales-card">

    <div class="sales-title">

      <div class="sales-title-icon">
        <i class="fas fa-cart-shopping"></i>
      </div>

      <span>
        Manual Sale
      </span>

    </div>


    <% if (farmTotals && farmTotals.length) { %>

      <form
        method="POST"
        action="/sales/manual"
        class="manual-sale-form"
      >

        <div class="sales-row">

          <div class="sales-field">

            <label>
              Dairy Farm
            </label>

            <select
              class="farm-select"
              name="farmId"
              id="manualFarmId"
              required
            >

              <option value="">
                Select farm
              </option>

              <% farmTotals.forEach(farm => { %>

                <option
                  value="<%= farm.farmId %>"
                  data-available="<%= Number(farm.available || 0) %>"
                >

                  <%= farm.farmName %>
                  —
                  <%= Number(farm.available || 0).toFixed(2) %> L available

                </option>

              <% }) %>

            </select>

          </div>


          <div class="sales-field">

            <label>
              Customer Name
            </label>

            <input
              class="sales-input"
              type="text"
              name="customerName"
              placeholder="Customer name"
              required
            >

          </div>


          <div class="sales-field">

            <label>
              Liters
            </label>

            <input
              class="sales-input"
              type="number"
              name="liters"
              step="0.1"
              min="0"
              required
            >

          </div>

        </div>


        <div
          class="farm-availability"
          id="manualFarmAvailability"
          style="display:none;"
        >

          <div class="farm-availability-title">

            Available Milk For Selected Farm

          </div>


          <div
            class="farm-availability-value"
            id="manualAvailableValue"
          >

            0.00 L

          </div>

        </div>


        <button
          type="submit"
          class="sales-btn"
          style="margin-top:18px;"
        >

          <i class="fas fa-circle-plus"></i>

          Record Manual Sale

        </button>

      </form>


    <% } else { %>

      <div class="empty">

        <i class="fas fa-cow"></i>

        No dairy farm is available for recording a sale.

      </div>

    <% } %>

  </div>



  <!-- =======================================================
       6. TODAY'S MANUAL SALES
  ======================================================= -->

  <div class="sales-card">

    <div class="sales-title">

      <div class="sales-title-icon">
        <i class="fas fa-clipboard-list"></i>
      </div>

      <span>
        Today's Manual Sales
      </span>

    </div>


    <% if (manualSales && manualSales.length) { %>

      <div class="sales-table-wrapper">

        <table class="sales-table">

          <thead>

            <tr>

              <th>
                Customer
              </th>

              <th>
                Liters
              </th>

              <th>
                Price
              </th>

              <th>
                Cash
              </th>

              <th>
                Farm
              </th>

            </tr>

          </thead>


          <tbody>

            <% manualSales.forEach(sale => { %>

              <tr>

                <td>

                  <strong>
                    <%= sale.customerName %>
                  </strong>

                </td>


                <td>

                  <%= Number(
                    sale.liters || 0
                  ).toFixed(2) %> L

                </td>


                <td>

                  KES
                  <%= Number(
                    sale.price || currentPrice || 0
                  ).toFixed(2) %>

                </td>


                <td>

                  <strong>

                    KES
                    <%= Number(
                      sale.cash || 0
                    ).toFixed(2) %>

                  </strong>

                </td>


                <td>

                  <span class="badge badge-green">

                    <i class="fas fa-cow"></i>

                    <% 
                      const saleFarm =
                        farmTotals.find(
                          farm =>
                            String(farm.farmId) ===
                            String(sale.farm)
                        );
                    %>

                    <%= saleFarm
                      ? saleFarm.farmName
                      : "Farm"
                    %>

                  </span>

                </td>

              </tr>

            <% }) %>

          </tbody>

        </table>

      </div>


    <% } else { %>

      <div class="empty">

        <i class="fas fa-box-open"></i>

        No manual sales recorded today.

      </div>

    <% } %>

  </div>



  <!-- =======================================================
       7. DAILY SUMMARY
  ======================================================= -->

  <div class="sales-card">

    <div class="sales-title">

      <div class="sales-title-icon">
        <i class="fas fa-chart-column"></i>
      </div>

      <span>
        Today's Milk Summary
      </span>

    </div>


    <div class="farm-total-grid">

      <div class="farm-total">

        <div class="farm-total-name">
          Total Production
        </div>

        <div class="farm-total-row">

          <span>Milk produced</span>

          <strong>
            <%= Number(
              totalProduction || 0
            ).toFixed(2) %> L
          </strong>

        </div>

      </div>


      <div class="farm-total">

        <div class="farm-total-name">
          Total Sold
        </div>

        <div class="farm-total-row">

          <span>Milk sold</span>

          <strong>
            <%= Number(
              totalSales || 0
            ).toFixed(2) %> L
          </strong>

        </div>

      </div>


      <div class="farm-total">

        <div class="farm-total-name">
          Available Milk
        </div>

        <div class="farm-total-row">

          <span>Remaining</span>

          <strong>
            <%= Number(
              availableMilk || 0
            ).toFixed(2) %> L
          </strong>

        </div>

      </div>


      <div class="farm-total">

        <div class="farm-total-name">
          Revenue
        </div>

        <div class="farm-total-row">

          <span>Cash collected</span>

          <strong>
            KES
            <%= Number(
              totalRevenue || 0
            ).toFixed(2) %>
          </strong>

        </div>

      </div>

    </div>

  </div>



  <!-- =======================================================
       8. AVAILABLE MILK
  ======================================================= -->

  <div class="price-info">

    <i class="fas fa-bottle-water"></i>

    Available Milk:

    <strong>

      <%= Number(
        availableMilk || 0
      ).toFixed(2) %> L

    </strong>

  </div>



  <!-- =======================================================
       9. TOTAL SALES
  ======================================================= -->

  <div class="sales-card total-box">

    <span>

      <i class="fas fa-bottle-water"></i>

      Total Sold Today

    </span>


    <span class="total-number">

      <%= Number(
        totalSales || 0
      ).toFixed(2) %> L

    </span>

  </div>


</div>



<script>

  /* =========================================================
     FARM DATA FROM milkService.getSalesPageData()
  ========================================================= */

  const farmTotals =
    <%- JSON.stringify(
      (farmTotals || []).map(farm => ({
        farmId: String(farm.farmId),
        farmCode: farm.farmCode,
        farmName: farm.farmName,
        production: Number(farm.production || 0),
        sold: Number(farm.sold || 0),
        available: Number(farm.available || 0),
        revenue: Number(farm.revenue || 0)
      }))
    ) %>;


  /* =========================================================
     MANUAL SALE
  ========================================================= */

  const manualForm =
    document.querySelector(
      "form[action='/sales/manual']"
    );


  const manualFarm =
    document.getElementById(
      "manualFarmId"
    );


  const manualAvailableBox =
    document.getElementById(
      "manualFarmAvailability"
    );


  const manualAvailableValue =
    document.getElementById(
      "manualAvailableValue"
    );


  function getSelectedFarmAvailability(
    select
  ){

    if (!select){
      return 0;
    }


    const option =
      select.options[
        select.selectedIndex
      ];


    if (!option){
      return 0;
    }


    return Number(
      option.dataset.available || 0
    );

  }


  if (manualFarm){

    manualFarm.addEventListener(
      "change",
      function(){

        const available =
          getSelectedFarmAvailability(
            this
          );


        if (
          !this.value
        ){

          manualAvailableBox.style.display =
            "none";

          return;

        }


        manualAvailableBox.style.display =
          "block";


        manualAvailableValue.textContent =
          available.toFixed(2) +
          " L";

      }
    );

  }


  if (manualForm){

    manualForm.addEventListener(
      "submit",
      function(e){

        const farmId =
          this.querySelector(
            "[name='farmId']"
          ).value;


        if (!farmId){

          e.preventDefault();

          alert(
            "Please select the dairy farm."
          );

          return;

        }


        const liters =
          Number(
            this.querySelector(
              "[name='liters']"
            ).value
          );


        const available =
          getSelectedFarmAvailability(
            manualFarm
          );


        if (
          !Number.isFinite(liters) ||
          liters <= 0
        ){

          e.preventDefault();

          alert(
            "Please enter a valid milk quantity."
          );

          return;

        }


        if (
          liters > available
        ){

          e.preventDefault();

          alert(
            "❌ Insufficient milk available for this farm.\n\n" +
            "Available: " +
            available.toFixed(2) +
            " L\n" +
            "Requested: " +
            liters.toFixed(2) +
            " L"
          );

          return;

        }


        const customer =
          this.querySelector(
            "[name='customerName']"
          ).value;


        const proceed =
          confirm(
            "🛒 Confirm Manual Sale\n\n" +
            "Customer: " +
            customer +
            "\n" +
            "Milk: " +
            liters.toFixed(2) +
            " L\n" +
            "Available after sale: " +
            (available - liters).toFixed(2) +
            " L\n\n" +
            "Press OK to continue."
          );


        if (!proceed){

          e.preventDefault();

          return;

        }


        const button =
          this.querySelector(
            "button[type='submit']"
          );


        if (button){

          button.disabled =
            true;

          button.innerHTML =
            '<i class="fas fa-spinner fa-spin"></i> Recording...';

        }

      }
    );

  }



  /* =========================================================
     STANDING ORDER SALES
  ========================================================= */

  document
    .querySelectorAll(
      "form[action='/sales/standing-order']"
    )
    .forEach(
      form => {

        const row =
          form.closest("tr");


        const farmSelect =
          row?.querySelector(
            ".standing-farm-select"
          );


        const farmIdInput =
          form.querySelector(
            "[name='farmId']"
          );


        if (farmSelect){

          farmSelect.addEventListener(
            "change",
            function(){

              farmIdInput.value =
                this.value || "";

            }
          );

        }


        form.addEventListener(
          "submit",
          function(e){

            const farmId =
              farmIdInput.value;


            if (!farmId){

              e.preventDefault();

              alert(
                "Please select the dairy farm."
              );

              return;

            }


            const liters =
              Number(
                this.querySelector(
                  "[name='liters']"
                ).value
              );


            const available =
              getSelectedFarmAvailability(
                farmSelect
              );


            if (
              !Number.isFinite(liters) ||
              liters <= 0
            ){

              e.preventDefault();

              alert(
                "Invalid standing order quantity."
              );

              return;

            }


            if (
              liters > available
            ){

              e.preventDefault();

              alert(
                "❌ Insufficient milk available for this farm.\n\n" +
                "Available: " +
                available.toFixed(2) +
                " L\n" +
                "Required: " +
                liters.toFixed(2) +
                " L"
              );

              return;

            }


            const customer =
              row.querySelector(
                "td:first-child strong"
              )?.textContent.trim() ||
              "Customer";


            const proceed =
              confirm(
                "🔄 Confirm Standing Order Sale\n\n" +
                "Customer: " +
                customer +
                "\n" +
                "Milk: " +
                liters.toFixed(2) +
                " L\n" +
                "Available after sale: " +
                (available - liters).toFixed(2) +
                " L\n\n" +
                "Press OK to continue."
              );


            if (!proceed){

              e.preventDefault();

              return;

            }


            const button =
              this.querySelector(
                "button[type='submit']"
              );


            if (button){

              button.disabled =
                true;

              button.style.background =
                "#9ca3af";

              button.style.cursor =
                "not-allowed";

              button.innerHTML =
                '<i class="fas fa-spinner fa-spin"></i> Recording...';

            }

          }
        );

      }
    );

</script>