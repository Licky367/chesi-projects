<style>
/* ==========================================================
   NET WORTH PAGE
========================================================== */

.financial-page.networth-page {
    max-width: 1050px;

    margin: 0 auto;

    padding: 25px 18px 55px;

    box-sizing: border-box;
}


/* ==========================================================
   SECTIONS
========================================================== */

.networth-section {
    margin-bottom: 32px;
}


.networth-section:last-child {
    margin-bottom: 0;
}


/* ==========================================================
   SECTION HEADER
========================================================== */

.networth-section-header {
    display: flex;

    align-items: flex-start;

    justify-content: space-between;

    margin-bottom: 13px;
}


.networth-section-header h2 {
    display: flex;

    align-items: center;

    gap: 10px;

    margin: 0 0 5px;

    color: #24352c;

    font-size: 19px;

    font-weight: 750;

    line-height: 1.3;
}


.networth-section-header h2::before {
    content: "";

    display: block;

    width: 4px;

    height: 20px;

    border-radius: 5px;

    background: #2f8f55;
}


.networth-section-header p {
    margin: 0;

    color: #7a877f;

    font-size: 13px;

    line-height: 1.5;
}


/* ==========================================================
   LIST
========================================================== */

.networth-list {
    display: flex;

    flex-direction: column;

    gap: 9px;
}


/* ==========================================================
   LIST ITEM
========================================================== */

.networth-list-item {
    position: relative;

    display: flex;

    align-items: center;

    min-height: 62px;

    padding: 0 17px;

    box-sizing: border-box;

    border: 1px solid #e4ebe6;

    border-radius: 13px;

    background: #ffffff;

    color: #26362d;

    text-decoration: none;

    box-shadow:
        0 2px 8px rgba(25, 70, 43, 0.035);

    transition:
        border-color 0.2s ease,
        background 0.2s ease,
        box-shadow 0.2s ease,
        transform 0.2s ease;
}


/* ==========================================================
   DEFAULT ASSET ICON
========================================================== */

.networth-list-item::before {
    content: "◆";

    flex-shrink: 0;

    display: flex;

    align-items: center;

    justify-content: center;

    width: 36px;

    height: 36px;

    margin-right: 13px;

    border-radius: 10px;

    background: #edf8f0;

    color: #2d8050;

    font-size: 12px;
}


/* ==========================================================
   STRUCTURE / FACILITY ICON
========================================================== */

.networth-structure-item::before {
    content: "▦";

    font-size: 18px;
}


/* ==========================================================
   NAME
========================================================== */

.networth-list-name {
    flex: 1;

    min-width: 0;

    overflow: hidden;

    color: #293a31;

    font-size: 14px;

    font-weight: 650;

    line-height: 1.4;

    text-overflow: ellipsis;

    white-space: nowrap;
}


/* ==========================================================
   ARROW
========================================================== */

.networth-list-item::after {
    content: "›";

    flex-shrink: 0;

    margin-left: 12px;

    color: #91a098;

    font-size: 24px;

    line-height: 1;

    transition:
        color 0.2s ease,
        transform 0.2s ease;
}


/* ==========================================================
   HOVER
========================================================== */

.networth-list-item:hover {
    border-color: #b8d9c3;

    background: #fbfefc;

    box-shadow:
        0 6px 18px rgba(31, 111, 70, 0.08);

    transform: translateY(-1px);
}


.networth-list-item:hover::before {
    background: #dff1e5;

    color: #216b3e;
}


.networth-list-item:hover::after {
    color: #267345;

    transform: translateX(3px);
}


/* ==========================================================
   EMPTY STATE
========================================================== */

.networth-empty {
    display: flex;

    align-items: center;

    justify-content: center;

    flex-direction: column;

    min-height: 130px;

    padding: 25px;

    box-sizing: border-box;

    border: 1px dashed #cddbd2;

    border-radius: 14px;

    background: #fbfdfb;

    color: #829087;

    font-size: 14px;

    line-height: 1.5;

    text-align: center;
}


.networth-empty::before {
    content: "◇";

    display: flex;

    align-items: center;

    justify-content: center;

    width: 40px;

    height: 40px;

    margin-bottom: 10px;

    border-radius: 50%;

    background: #edf7f0;

    color: #59936e;

    font-size: 22px;
}


/* ==========================================================
   MOBILE
========================================================== */

@media (max-width: 700px) {

    .financial-page.networth-page {
        padding: 18px 14px 45px;
    }


    .networth-section {
        margin-bottom: 27px;
    }


    .networth-section-header h2 {
        font-size: 18px;
    }


    .networth-section-header p {
        font-size: 12.5px;
    }


    .networth-list-item {
        min-height: 58px;

        padding: 0 13px;
    }


    .networth-list-item::before {
        width: 34px;

        height: 34px;

        margin-right: 11px;
    }


    .networth-list-name {
        font-size: 14px;
    }

}


/* ==========================================================
   SMALL PHONES
========================================================== */

@media (max-width: 400px) {

    .financial-page.networth-page {
        padding-left: 10px;

        padding-right: 10px;
    }


    .networth-section-header h2 {
        font-size: 17px;
    }


    .networth-list-item {
        min-height: 56px;
    }

}
</style>


<div class="financial-page networth-page">

    <!-- =====================================================
         DAIRY FARMS
         
         Handled in:
             networth/dairy-farms.ejs
    ====================================================== -->

    <%- include("networth/dairy-farms") %>


    <!-- =====================================================
         STANDALONE ASSETS
         
         Handled in:
             networth/standalone.ejs
    ====================================================== -->

    <%- include("networth/standalone") %>

</div>