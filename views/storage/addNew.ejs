<% /*
============================================================
ADD ITEM DIRECTLY TO STORAGE
============================================================

URL:

    GET  /storage/:dairyId/contents/:storageId/add
    POST /storage/:dairyId/contents/:storageId/add

STORAGE IS DETERMINED SERVER-SIDE.

If storage.type === "agroStore":

    recordType = structure
    type       = feeds

    Additional fields:

        quantity
        unit

If storage.type === "room":

    recordType may be:

        animal
        structure

    Dairy Farm selection is NOT displayed because the
    parent farm is already known from the URL.

IMPORTANT:

    The browser does not choose the destination storage.

    The server determines:

        dairy
        storage
        storage type
        roomNumber

    and assigns:

        assetCode   = parentFarm.code
        dwellNumber = storage.roomNumber

============================================================
EXPECTED BACKEND VARIABLES
------------------------------------------------------------

dairy:
    Parent Dairy Farm document.

storage:
    Selected storage structure.

dairyBreeds:
    Breed values supplied by backend.

storageType:
    "room"
    OR
    "agroStore"

============================================================
*/ %>


<%

const breeds =
    Array.isArray(dairyBreeds)
        ? dairyBreeds
        : [];


const selectedStorageType =
    String(
        storageType ||
        storage?.type ||
        ""
    )
    .trim();


const isAgroStore =
    selectedStorageType.toLowerCase() ===
    "agrostore";


const isRoom =
    selectedStorageType.toLowerCase() ===
    "room";


%>


<style>

/* ==========================================================
   PAGE
========================================================== */

.storage-add-page {

    max-width: 900px;

    margin: 0 auto;

    padding: 24px 16px 60px;

}


/* ==========================================================
   HEADER
========================================================== */

.storage-add-header {

    margin-bottom: 24px;

}

.storage-add-header-top {

    display: flex;

    align-items: center;

    margin-bottom: 18px;

}

.storage-back-link {

    display: inline-flex;

    align-items: center;

    gap: 7px;

    color: #15803d;

    text-decoration: none;

    font-weight: 700;

    font-size: 14px;

}

.storage-back-link:hover {

    color: #166534;

    text-decoration: underline;

}

.storage-add-header h1 {

    margin: 0;

    color: #172033;

    font-size: 30px;

    line-height: 1.2;

}

.storage-add-header p {

    margin: 8px 0 0;

    color: #6b7280;

    font-size: 15px;

    line-height: 1.6;

}


/* ==========================================================
   STORAGE INFORMATION
========================================================== */

.storage-context-card {

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 16px;

    margin-bottom: 20px;

    padding: 18px;

    border-radius: 16px;

    background: #f0fdf4;

    border: 1px solid #bbf7d0;

}

.storage-context-main {

    min-width: 0;

}

.storage-context-title {

    margin: 0;

    color: #166534;

    font-size: 18px;

    font-weight: 800;

}

.storage-context-description {

    margin: 5px 0 0;

    color: #4b5563;

    font-size: 13px;

    line-height: 1.5;

}

.storage-context-type {

    flex-shrink: 0;

    padding: 8px 12px;

    border-radius: 999px;

    background: #dcfce7;

    color: #166534;

    font-size: 12px;

    font-weight: 800;

}


/* ==========================================================
   MAIN CARD
========================================================== */

.storage-add-card {

    background: #ffffff;

    border: 1px solid #e5e7eb;

    border-radius: 22px;

    padding: 26px;

    box-shadow:
        0 8px 30px rgba(15, 23, 42, 0.08);

}


/* ==========================================================
   FORM STATUS
========================================================== */

.form-save-status {

    display: none;

    margin-bottom: 20px;

    padding: 13px 15px;

    border-radius: 12px;

    font-size: 14px;

    font-weight: 600;

    line-height: 1.5;

}

.form-save-status.success {

    display: block;

    background: #ecfdf5;

    color: #047857;

    border: 1px solid #a7f3d0;

}

.form-save-status.error {

    display: block;

    background: #fef2f2;

    color: #b91c1c;

    border: 1px solid #fecaca;

}


/* ==========================================================
   MODE CARD
========================================================== */

.storage-mode-card {

    margin-bottom: 24px;

    padding: 18px;

    border-radius: 16px;

    background: #f8fafc;

    border: 1px solid #e2e8f0;

}

.storage-mode-title {

    color: #172033;

    font-size: 15px;

    font-weight: 800;

    margin-bottom: 5px;

}

.storage-mode-description {

    color: #64748b;

    font-size: 13px;

    line-height: 1.5;

}


/* ==========================================================
   FORM GROUP
========================================================== */

.form-group {

    margin-bottom: 20px;

}

.form-group label {

    display: block;

    margin-bottom: 8px;

    color: #273449;

    font-size: 14px;

    font-weight: 700;

}

.form-group input,
.form-group select,
.form-group textarea {

    width: 100%;

    box-sizing: border-box;

    border: 1px solid #d9dee7;

    border-radius: 12px;

    background: #ffffff;

    color: #172033;

    font-size: 15px;

    padding: 12px 13px;

    outline: none;

    transition:
        border-color .2s ease,
        box-shadow .2s ease,
        background .2s ease;

}

.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus {

    border-color: #16a34a;

    box-shadow:
        0 0 0 3px rgba(22, 163, 74, 0.12);

}

.form-group textarea {

    min-height: 120px;

    resize: vertical;

}

.form-group input:disabled,
.form-group select:disabled {

    background: #f4f6f8;

    color: #9aa2ad;

    cursor: not-allowed;

}


/* ==========================================================
   PROFILE IMAGE
========================================================== */

.profile-image-section {

    display: flex;

    flex-direction: column;

    align-items: center;

    text-align: center;

    padding-bottom: 28px;

    margin-bottom: 24px;

    border-bottom: 1px solid #edf0f4;

}

.profile-image-preview {

    width: 125px;

    height: 125px;

    border-radius: 50%;

    overflow: hidden;

    display: flex;

    align-items: center;

    justify-content: center;

    background: #f0fdf4;

    border: 4px solid #ffffff;

    box-shadow:
        0 4px 18px rgba(0, 0, 0, 0.10);

    margin-bottom: 14px;

}

.profile-image-preview img {

    width: 100%;

    height: 100%;

    object-fit: cover;

}

.profile-image-placeholder {

    font-size: 48px;

}

.profile-image-title {

    color: #172033;

    font-size: 17px;

    font-weight: 700;

}

.profile-image-description {

    margin: 5px 0 14px;

    color: #7b8494;

    font-size: 13px;

}

.profile-image-input {

    width: 100%;

    max-width: 300px;

    font-size: 13px;

}


/* ==========================================================
   RECORD TYPE
========================================================== */

.record-type-card {

    padding: 18px;

    margin-bottom: 24px;

    border-radius: 16px;

    background: #f0fdf4;

    border: 1px solid #bbf7d0;

}

.record-type-card .form-group {

    margin-bottom: 0;

}


/* ==========================================================
   RECORD SECTIONS
========================================================== */

.record-section {

    display: none;

    padding: 18px;

    margin-bottom: 18px;

    border-radius: 16px;

    background: #fbfefc;

    border: 1px solid #dcfce7;

}

.record-section.visible {

    display: block;

}

.record-section::before {

    content: "";

    display: block;

    width: 36px;

    height: 3px;

    margin-bottom: 15px;

    border-radius: 5px;

    background: #16a34a;

}


/* ==========================================================
   FORM GRID
========================================================== */

.form-grid {

    display: grid;

    grid-template-columns:
        repeat(2, minmax(0, 1fr));

    gap: 18px;

}

.form-grid .form-group {

    margin-bottom: 0;

}


/* ==========================================================
   HELP TEXT
========================================================== */

.code-help {

    margin-bottom: 8px;

    color: #7b8494;

    font-size: 12px;

    line-height: 1.5;

}


/* ==========================================================
   ACTIONS
========================================================== */

.form-actions {

    display: flex;

    justify-content: flex-end;

    align-items: center;

    gap: 12px;

    margin-top: 28px;

    padding-top: 22px;

    border-top: 1px solid #edf0f4;

}

.button {

    display: inline-flex;

    align-items: center;

    justify-content: center;

    min-height: 46px;

    padding: 0 20px;

    border-radius: 12px;

    border: none;

    text-decoration: none;

    cursor: pointer;

    font-size: 14px;

    font-weight: 700;

    transition:
        transform .15s ease,
        opacity .15s ease,
        box-shadow .15s ease;

}

.button:hover {

    transform: translateY(-1px);

}

.button:disabled {

    opacity: .65;

    cursor: not-allowed;

    transform: none;

}

.button-secondary {

    background: #f1f4f8;

    color: #374151;

}

.button-primary {

    background: #16a34a;

    color: #ffffff;

    box-shadow:
        0 5px 14px rgba(22, 163, 74, 0.22);

}

.button-primary:hover {

    background: #15803d;

}


/* ==========================================================
   MOBILE
========================================================== */

@media (max-width: 700px) {

    .storage-add-page {

        padding:
            18px 12px 40px;

    }

    .storage-add-card {

        padding: 18px;

        border-radius: 18px;

    }

    .storage-add-header h1 {

        font-size: 25px;

    }

    .storage-context-card {

        flex-direction: column;

        align-items: flex-start;

    }

    .form-grid {

        grid-template-columns: 1fr;

        gap: 0;

    }

    .form-actions {

        flex-direction: column-reverse;

        align-items: stretch;

    }

    .button {

        width: 100%;

    }

}

</style>


<div class="storage-add-page">


    <!-- ======================================================
         HEADER
    ====================================================== -->

    <div class="storage-add-header">

        <div class="storage-add-header-top">

            <a
                href="/storage/<%= dairy._id %>/contents/<%= storage._id %>"
                class="storage-back-link"
            >
                ← <%= storage.name || "Storage Contents" %>
            </a>

        </div>

        <h1>
            Add Item to Storage
        </h1>

        <p>
            Add a new item directly to this storage facility.
        </p>

    </div>


    <!-- ======================================================
         STORAGE CONTEXT
    ====================================================== -->

    <div class="storage-context-card">

        <div class="storage-context-main">

            <div class="storage-context-title">

                <%= storage.name || "Storage Facility" %>

            </div>

            <p class="storage-context-description">

                Dairy Farm:
                <strong>
                    <%= dairy.name || "Dairy Farm" %>
                </strong>

                &nbsp; • &nbsp;

                Room Number:
                <strong>
                    <%= storage.roomNumber %>
                </strong>

            </p>

        </div>


        <div class="storage-context-type">

            <% if (isAgroStore) { %>

                AgroStore

            <% } else { %>

                Storage Room

            <% } %>

        </div>

    </div>


    <!-- ======================================================
         MAIN CARD
    ====================================================== -->

    <div class="storage-add-card">


        <form
            id="storageAddForm"
            action="/storage/<%= dairy._id %>/contents/<%= storage._id %>/add"
            method="POST"
            enctype="multipart/form-data"
        >


            <!-- ==================================================
                 FORM STATUS
            ================================================== -->

            <div
                id="formSaveStatus"
                class="form-save-status"
                role="status"
                aria-live="polite"
            ></div>


            <!-- ==================================================
                 PROFILE IMAGE
            ================================================== -->

            <div class="profile-image-section">

                <div class="profile-image-preview">

                    <img
                        id="profileImagePreview"
                        src=""
                        alt="Profile image preview"
                        style="display:none;"
                    >

                    <span
                        id="profileImagePlaceholder"
                        class="profile-image-placeholder"
                    >

                        <% if (isAgroStore) { %>
                            🌾
                        <% } else { %>
                            🐄
                        <% } %>

                    </span>

                </div>

                <div class="profile-image-title">
                    Profile Image
                </div>

                <p class="profile-image-description">
                    Optional. Choose an image for this item.
                </p>

                <input
                    type="file"
                    id="profileImage"
                    name="profileImage"
                    class="profile-image-input"
                    accept="image/jpeg,image/jpg,image/png,image/webp"
                >

            </div>


            <!-- ==================================================
                 AGROSTORE MODE
            ================================================== -->

            <% if (isAgroStore) { %>


                <!-- ==================================================
                     FIXED RECORD TYPE
                ================================================== -->

                <div class="record-type-card">

                    <div class="form-group">

                        <label>
                            Record Type
                        </label>

                        <input
                            type="text"
                            value="Structure / Facility"
                            disabled
                        >

                    </div>

                </div>


                <!-- ==================================================
                     FIXED FEED TYPE
                ================================================== -->

                <div class="record-section visible">

                    <div class="form-group">

                        <label>
                            Item Type
                        </label>

                        <input
                            type="text"
                            value="Feeds"
                            disabled
                        >

                    </div>

                </div>


                <!-- ==================================================
                     HIDDEN SERVER-EXPECTED VALUES
                ================================================== -->

                <input
                    type="hidden"
                    name="recordType"
                    value="structure"
                >

                <input
                    type="hidden"
                    name="type"
                    value="feeds"
                >


                <!-- ==================================================
                     FEED QUANTITY
                ================================================== -->

                <div class="form-grid">

                    <div class="form-group">

                        <label for="quantity">
                            Quantity
                        </label>

                        <input
                            type="number"
                            id="quantity"
                            name="quantity"
                            min="0"
                            step="0.01"
                            required
                            placeholder="Enter quantity"
                        >

                    </div>


                    <div class="form-group">

                        <label for="unit">
                            Unit
                        </label>

                        <input
                            type="text"
                            id="unit"
                            name="unit"
                            required
                            autocomplete="off"
                            placeholder="e.g. kg, bags, bales"
                        >

                    </div>

                </div>


            <% } else if (isRoom) { %>


                <!-- ==================================================
                     ROOM MODE
                ================================================== -->

                <div class="record-type-card">

                    <div class="form-group">

                        <label for="recordType">
                            What are you adding?
                        </label>

                        <select
                            id="recordType"
                            name="recordType"
                            required
                        >

                            <option value="">
                                Select record type
                            </option>

                            <option value="animal">
                                Animal
                            </option>

                            <option value="structure">
                                Structure / Facility
                            </option>

                        </select>

                    </div>

                </div>


                <!-- ==================================================
                     RECORD TYPE INFORMATION
                ================================================== -->

                <div
                    id="recordTypeInfo"
                    class="storage-mode-card"
                    style="display:none;"
                ></div>


                <!-- ==================================================
                     STRUCTURE TYPE
                ================================================== -->

                <div
                    id="structureTypeGroup"
                    class="form-group record-section"
                >

                    <label for="structureType">
                        Type
                    </label>

                    <select
                        id="structureType"
                        name="type"
                        disabled
                    >

                        <option value="">
                            Select type
                        </option>

                        <option value="machine">
                            Machine
                        </option>

                        <option value="equipment">
                            Equipment
                        </option>

                        <option value="tool">
                            Tool
                        </option>

                        <option value="building">
                            Building
                        </option>

                        <option value="cowshed">
                            Cowshed
                        </option>

                        <option value="milkingParlour">
                            Milking Parlour
                        </option>

                        <option value="feedStore">
                            Feed Store
                        </option>

                        <option value="hayShed">
                            Hay Shed
                        </option>

                        <option value="waterSystem">
                            Water System
                        </option>

                        <option value="fencing">
                            Fencing
                        </option>

                        <option value="vehicle">
                            Vehicle
                        </option>

                        <option value="generator">
                            Generator
                        </option>

                        <option value="solarSystem">
                            Solar System
                        </option>

                        <option value="other">
                            Other
                        </option>

                    </select>

                </div>


                <!-- ==================================================
                     ANIMAL GENDER
                ================================================== -->

                <div
                    id="animalGenderGroup"
                    class="form-group record-section"
                >

                    <label for="gender">
                        Gender
                    </label>

                    <select
                        id="gender"
                        name="gender"
                        disabled
                    >

                        <option value="">
                            Select gender
                        </option>

                        <option value="male">
                            Male
                        </option>

                        <option value="female">
                            Female
                        </option>

                    </select>

                </div>


                <!-- ==================================================
                     DATE OF BIRTH
                ================================================== -->

                <div
                    id="dateOfBirthGroup"
                    class="form-group record-section"
                >

                    <label for="dateOfBirth">
                        Date of Birth
                    </label>

                    <input
                        type="date"
                        id="dateOfBirth"
                        name="dateOfBirth"
                        disabled
                    >

                </div>


                <!-- ==================================================
                     BREED
                ================================================== -->

                <div
                    id="animalBreedGroup"
                    class="form-group record-section"
                >

                    <label for="breed">
                        Breed
                    </label>

                    <select
                        id="breed"
                        name="type"
                        disabled
                    >

                        <option value="">
                            Select breed
                        </option>

                        <%
                        breeds.forEach(function(breed) {
                        %>

                            <option
                                value="<%= breed %>"
                            >
                                <%= breed %>
                            </option>

                        <%
                        });
                        %>

                    </select>

                </div>


                <!-- ==================================================
                     ANIMAL MASS
                ================================================== -->

                <div
                    id="massGroup"
                    class="form-group record-section"
                >

                    <label for="mass">
                        Mass (kg)
                    </label>

                    <input
                        type="number"
                        id="mass"
                        name="mass"
                        min="0"
                        step="0.01"
                        placeholder="Enter animal mass"
                        disabled
                    >

                </div>


            <% } %>


            <!-- ==================================================
                 NAME
            ================================================== -->

            <div class="form-group">

                <label for="name">
                    Name
                </label>

                <input
                    type="text"
                    id="name"
                    name="name"
                    required
                    autocomplete="off"
                    placeholder="<%= isAgroStore ? 'Enter feed name' : 'Enter item name' %>"
                >

            </div>


            <!-- ==================================================
                 MASS FOR AGROSTORE FEED
            ================================================== -->

            <% if (isAgroStore) { %>

                <div class="form-group">

                    <label for="mass">
                        Mass (kg)
                    </label>

                    <input
                        type="number"
                        id="mass"
                        name="mass"
                        min="0"
                        step="0.01"
                        placeholder="Optional"
                    >

                </div>

            <% } %>


            <!-- ==================================================
                 COMMON FINANCIAL INFORMATION
            ================================================== -->

            <div class="form-grid">


                <div class="form-group">

                    <label for="buyingPrice">
                        Buying Price
                    </label>

                    <input
                        type="number"
                        id="buyingPrice"
                        name="buyingPrice"
                        min="0"
                        step="0.01"
                        placeholder="Enter buying price"
                    >

                </div>


                <div class="form-group">

                    <label for="currentWorth">
                        Current Worth
                    </label>

                    <input
                        type="number"
                        id="currentWorth"
                        name="currentWorth"
                        min="0"
                        step="0.01"
                        placeholder="Enter current worth"
                    >

                </div>


            </div>


            <!-- ==================================================
                 DESCRIPTION
            ================================================== -->

            <div class="form-group">

                <label for="description">
                    Description
                </label>

                <textarea
                    id="description"
                    name="description"
                    placeholder="Describe this item..."
                ></textarea>

            </div>


            <!-- ==================================================
                 CONDITION
            ================================================== -->

            <div class="form-group">

                <label for="condition">
                    Condition
                </label>

                <input
                    type="text"
                    id="condition"
                    name="condition"
                    placeholder="e.g. New, Good, Needs Repair"
                >

            </div>


            <!-- ==================================================
                 LOCATION
            ================================================== -->

            <div class="form-group">

                <label for="location">
                    Physical Location
                </label>

                <input
                    type="text"
                    id="location"
                    name="location"
                    placeholder="Optional physical location"
                >

            </div>


            <!-- ==================================================
                 STATUS
            ================================================== -->

            <div class="form-group">

                <label for="status">
                    Status
                </label>

                <select
                    id="status"
                    name="status"
                >

                    <option
                        value="active"
                        selected
                    >
                        Active
                    </option>

                    <option value="sold">
                        Sold
                    </option>

                    <option value="disposed">
                        Disposed
                    </option>

                    <option value="inactive">
                        Inactive
                    </option>

                </select>

            </div>


            <!-- ==================================================
                 ACTIONS
            ================================================== -->

            <div class="form-actions">

                <a
                    href="/storage/<%= dairy._id %>/contents/<%= storage._id %>"
                    class="button button-secondary"
                >
                    Cancel
                </a>

                <button
                    type="submit"
                    id="saveStorageItemButton"
                    class="button button-primary"
                >
                    Add to Storage
                </button>

            </div>


        </form>

    </div>

</div>


<script>

document.addEventListener(
    "DOMContentLoaded",
    function () {


        const form =
            document.getElementById(
                "storageAddForm"
            );


        const statusBox =
            document.getElementById(
                "formSaveStatus"
            );


        const saveButton =
            document.getElementById(
                "saveStorageItemButton"
            );


        const profileImage =
            document.getElementById(
                "profileImage"
            );


        const profileImagePreview =
            document.getElementById(
                "profileImagePreview"
            );


        const profileImagePlaceholder =
            document.getElementById(
                "profileImagePlaceholder"
            );


        /* ==================================================
           HELPERS
        ================================================== */

        function clearStatus() {

            if (!statusBox) {

                return;

            }

            statusBox.textContent =
                "";

            statusBox.className =
                "form-save-status";

        }


        function showError(
            message
        ) {

            if (!statusBox) {

                return;

            }

            statusBox.textContent =
                message;

            statusBox.className =
                "form-save-status error";

        }


        /* ==================================================
           IMAGE PREVIEW
        ================================================== */

        if (profileImage) {

            profileImage.addEventListener(
                "change",
                function () {

                    clearStatus();


                    const file =
                        this.files &&
                        this.files[0];


                    if (!file) {

                        profileImagePreview
                            .style
                            .display =
                            "none";

                        profileImagePlaceholder
                            .style
                            .display =
                            "inline";

                        return;

                    }


                    if (
                        !file.type.startsWith(
                            "image/"
                        )
                    ) {

                        showError(
                            "Please select a valid image file."
                        );

                        this.value =
                            "";

                        return;

                    }


                    const reader =
                        new FileReader();


                    reader.onload =
                        function (event) {

                            profileImagePreview
                                .src =
                                event.target.result;

                            profileImagePreview
                                .style
                                .display =
                                "block";

                            profileImagePlaceholder
                                .style
                                .display =
                                "none";

                        };


                    reader.readAsDataURL(
                        file
                    );

                }
            );

        }


        /* ==================================================
           ROOM-ONLY JAVASCRIPT
        ================================================== */

        const recordType =
            document.getElementById(
                "recordType"
            );


        if (!recordType) {

            /* AgroStore page has fixed record type. */

            form.addEventListener(
                "submit",
                function (event) {

                    clearStatus();


                    const name =
                        document
                            .getElementById(
                                "name"
                            )
                            .value
                            .trim();


                    const quantity =
                        document
                            .getElementById(
                                "quantity"
                            )
                            .value;


                    const unit =
                        document
                            .getElementById(
                                "unit"
                            )
                            .value
                            .trim();


                    if (!name) {

                        event.preventDefault();

                        showError(
                            "Feed name is required."
                        );

                        return;

                    }


                    if (
                        quantity === "" ||
                        Number(quantity) < 0 ||
                        !Number.isFinite(
                            Number(quantity)
                        )
                    ) {

                        event.preventDefault();

                        showError(
                            "Please enter a valid feed quantity."
                        );

                        return;

                    }


                    if (!unit) {

                        event.preventDefault();

                        showError(
                            "Feed unit is required."
                        );

                        return;

                    }


                    saveButton.disabled =
                        true;

                    saveButton.textContent =
                        "Adding Feed...";

                }
            );

            return;

        }


        /* ==================================================
           ROOM CONDITIONAL SECTIONS
        ================================================== */

        const structureTypeGroup =
            document.getElementById(
                "structureTypeGroup"
            );


        const animalGenderGroup =
            document.getElementById(
                "animalGenderGroup"
            );


        const dateOfBirthGroup =
            document.getElementById(
                "dateOfBirthGroup"
            );


        const animalBreedGroup =
            document.getElementById(
                "animalBreedGroup"
            );


        const massGroup =
            document.getElementById(
                "massGroup"
            );


        const structureType =
            document.getElementById(
                "structureType"
            );


        const gender =
            document.getElementById(
                "gender"
            );


        const dateOfBirth =
            document.getElementById(
                "dateOfBirth"
            );


        const breed =
            document.getElementById(
                "breed"
            );


        const mass =
            document.getElementById(
                "mass"
            );


        const recordTypeInfo =
            document.getElementById(
                "recordTypeInfo"
            );


        function hideField(
            group,
            field
        ) {

            if (!group || !field) {

                return;

            }

            group.classList.remove(
                "visible"
            );

            field.disabled =
                true;

            field.required =
                false;

            if (
                field.tagName ===
                "SELECT"
            ) {

                field.selectedIndex =
                    0;

            } else {

                field.value =
                    "";

            }

        }


        function showField(
            group,
            field,
            required
        ) {

            if (!group || !field) {

                return;

            }

            group.classList.add(
                "visible"
            );

            field.disabled =
                false;

            field.required =
                Boolean(required);

        }


        function updateRoomRecordType() {

            const value =
                recordType.value;


            hideField(
                structureTypeGroup,
                structureType
            );


            hideField(
                animalGenderGroup,
                gender
            );


            hideField(
                dateOfBirthGroup,
                dateOfBirth
            );


            hideField(
                animalBreedGroup,
                breed
            );


            hideField(
                massGroup,
                mass
            );


            if (recordTypeInfo) {

                recordTypeInfo.style.display =
                    "none";

                recordTypeInfo.textContent =
                    "";

            }


            if (
                value ===
                "animal"
            ) {

                showField(
                    animalGenderGroup,
                    gender,
                    true
                );


                showField(
                    dateOfBirthGroup,
                    dateOfBirth,
                    true
                );


                showField(
                    animalBreedGroup,
                    breed,
                    true
                );


                showField(
                    massGroup,
                    mass,
                    false
                );


                if (recordTypeInfo) {

                    recordTypeInfo.style.display =
                        "block";

                    recordTypeInfo.textContent =
                        "This animal will automatically belong to the selected Dairy Farm and this storage room.";

                }

            }


            if (
                value ===
                "structure"
            ) {

                showField(
                    structureTypeGroup,
                    structureType,
                    true
                );


                if (recordTypeInfo) {

                    recordTypeInfo.style.display =
                        "block";

                    recordTypeInfo.textContent =
                        "This structure will automatically belong to the selected Dairy Farm and this storage room.";

                }

            }

        }


        recordType.addEventListener(
            "change",
            function () {

                clearStatus();

                updateRoomRecordType();

            }
        );


        /* ==================================================
           ROOM SUBMISSION
        ================================================== */

        form.addEventListener(
            "submit",
            function (event) {

                clearStatus();


                const selectedType =
                    recordType.value;


                const name =
                    document
                        .getElementById(
                            "name"
                        )
                        .value
                        .trim();


                if (!selectedType) {

                    event.preventDefault();

                    showError(
                        "Please select what you are adding."
                    );

                    return;

                }


                if (!name) {

                    event.preventDefault();

                    showError(
                        "Name is required."
                    );

                    return;

                }


                if (
                    selectedType ===
                    "animal"
                ) {

                    if (!gender.value) {

                        event.preventDefault();

                        showError(
                            "Please select the animal gender."
                        );

                        return;

                    }


                    if (!dateOfBirth.value) {

                        event.preventDefault();

                        showError(
                            "Please enter the animal Date of Birth."
                        );

                        return;

                    }


                    if (!breed.value) {

                        event.preventDefault();

                        showError(
                            "Please select the animal breed."
                        );

                        return;

                    }


                    if (
                        mass.value !== "" &&
                        Number(mass.value) < 0
                    ) {

                        event.preventDefault();

                        showError(
                            "Animal mass cannot be negative."
                        );

                        return;

                    }

                }


                if (
                    selectedType ===
                    "structure"
                ) {

                    if (
                        !structureType.value
                    ) {

                        event.preventDefault();

                        showError(
                            "Please select the structure type."
                        );

                        return;

                    }

                }


                const buyingPrice =
                    document
                        .getElementById(
                            "buyingPrice"
                        )
                        .value;


                const currentWorth =
                    document
                        .getElementById(
                            "currentWorth"
                        )
                        .value;


                if (
                    buyingPrice !== "" &&
                    Number(buyingPrice) < 0
                ) {

                    event.preventDefault();

                    showError(
                        "Buying Price cannot be negative."
                    );

                    return;

                }


                if (
                    currentWorth !== "" &&
                    Number(currentWorth) < 0
                ) {

                    event.preventDefault();

                    showError(
                        "Current Worth cannot be negative."
                    );

                    return;

                }


                saveButton.disabled =
                    true;

                saveButton.textContent =
                    "Adding to Storage...";

            }
        );


        updateRoomRecordType();

    }
);

</script>