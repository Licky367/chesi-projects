<%
/*
==============================================================
STORAGE CONTENT ITEM DETAILS
==============================================================

FILE:
    views/storage/content-item.ejs

PURPOSE:
    Display detailed information about one item contained
    inside an AgroStore.

ROUTE:

    /storage/:dairyId/contents/:storageId/details/:itemId

EXPECTED VARIABLES:

    dairy
    storage
    item

OPTIONAL:

    successMessage
    pageError

The page intentionally uses the same data fields displayed
inside storage/contents.ejs, but presents them in a more
organized detail layout.
==============================================================
*/


/* ============================================================
   SAFE DATA
============================================================ */

const contentItem =
    item || {};

const currentStorage =
    storage || {};

const currentDairy =
    dairy || {};


/* ============================================================
   STORAGE TYPE
============================================================ */

const storageType =
    currentStorage &&
    currentStorage.type
        ? String(currentStorage.type).trim()
        : "";


/* ============================================================
   STORAGE NAME
============================================================ */

const storageName =
    (
        currentStorage &&
        currentStorage.displayName
    )
        ||
    (
        currentStorage &&
        currentStorage.name
    )
        ||
    (
        storageType === "agroStore"
            ? "AgroStore"
            : (
                currentStorage &&
                currentStorage.roomNumber !== null &&
                currentStorage.roomNumber !== undefined
                    ? "Room " + currentStorage.roomNumber
                    : "Storage"
            )
    );


/* ============================================================
   STORAGE ROOM NUMBER
============================================================ */

const storageRoomNumber =
    (
        currentStorage &&
        currentStorage.roomNumber !== null &&
        currentStorage.roomNumber !== undefined
    )
        ? currentStorage.roomNumber
        : "—";


/* ============================================================
   HELPERS
============================================================ */

function displayValue(value) {

    return (
        value !== null &&
        value !== undefined &&
        String(value).trim() !== ""
    )
        ? value
        : "—";

}


/* ============================================================
   ITEM CLASSIFICATION
============================================================ */

const itemType =
    String(
        contentItem.type || ""
    ).trim();


const itemRecordType =
    String(
        contentItem.recordType || ""
    ).trim();


const itemCode =
    Number(
        contentItem.code
    );


const itemIsAnimal =
    contentItem.code !== null &&
    contentItem.code !== undefined &&
    !Number.isNaN(itemCode) &&
    itemCode > 0;


const itemIsFeed =
    itemType === "feeds";


const itemIsAgroStore =
    itemType === "agroStore";


/* ============================================================
   DISPLAY CLASSIFICATION
============================================================ */

let itemCategory =
    "Asset";

let itemIcon =
    "📦";

let itemCategoryClass =
    "asset-badge";


if (itemIsFeed) {

    itemCategory =
        "Feed";

    itemIcon =
        "🌾";

    itemCategoryClass =
        "feed-badge";

} else if (itemIsAnimal) {

    itemCategory =
        "Animal";

    itemIcon =
        "🐄";

    itemCategoryClass =
        "animal-badge";

} else if (itemIsAgroStore) {

    itemCategory =
        "AgroStore";

    itemIcon =
        "🌾";

    itemCategoryClass =
        "feed-badge";

}


/* ============================================================
   QUANTITY
============================================================ */

const hasQuantity =
    contentItem.quantity !== null &&
    contentItem.quantity !== undefined;


const quantityValue =
    hasQuantity
        ? Number(contentItem.quantity || 0)
        : null;


/* ============================================================
   CURRENT WORTH
============================================================ */

const hasCurrentWorth =
    contentItem.currentWorth !== null &&
    contentItem.currentWorth !== undefined;


const currentWorthValue =
    hasCurrentWorth
        ? Number(contentItem.currentWorth || 0)
        : null;


/* ============================================================
   FARM NAME
============================================================ */

const dairyName =
    currentDairy.name ||
    currentDairy.displayName ||
    "Dairy Farm";

%>


<style>

/* ============================================================
   PAGE
============================================================ */

.storage-content-item-page{
    width:100%;
    max-width:1000px;
    margin:0 auto;
    padding:20px 16px 65px;
    box-sizing:border-box;
}


/* ============================================================
   TOP NAVIGATION
============================================================ */

.content-item-navigation{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:12px;
    margin-bottom:18px;
}

.content-item-back{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    gap:7px;
    min-height:38px;
    padding:0 13px;
    border:1px solid #dfe7e1;
    border-radius:10px;
    background:#fff;
    color:#31533d;
    font-size:12px;
    font-weight:750;
    text-decoration:none;
    transition:.18s ease;
}

.content-item-back:hover{
    border-color:#bdd2c2;
    background:#f8fbf8;
}

.content-item-location{
    color:#829087;
    font-size:10px;
    font-weight:700;
    text-align:right;
}


/* ============================================================
   MAIN CARD
============================================================ */

.content-item-card{
    overflow:hidden;
    background:#fff;
    border:1px solid #e1e9e3;
    border-radius:18px;
    box-shadow:0 5px 22px rgba(24,45,31,.045);
}


/* ============================================================
   HERO
============================================================ */

.content-item-hero{
    display:flex;
    align-items:center;
    gap:16px;
    padding:22px;
    background:
        linear-gradient(
            135deg,
            #f7fbf8 0%,
            #ffffff 70%
        );
    border-bottom:1px solid #e5ece7;
}

.content-item-icon{
    flex:none;
    width:68px;
    height:68px;
    display:flex;
    align-items:center;
    justify-content:center;
    border-radius:18px;
    background:#edf5ef;
    font-size:32px;
}

.content-item-hero-information{
    min-width:0;
    flex:1;
}

.content-item-eyebrow{
    margin:0 0 5px;
    color:#7c8a82;
    font-size:9px;
    font-weight:850;
    letter-spacing:.11em;
    text-transform:uppercase;
}

.content-item-title{
    margin:0;
    color:#203328;
    font-size:25px;
    line-height:1.2;
    font-weight:850;
    letter-spacing:-.035em;
    word-break:break-word;
}

.content-item-id{
    margin:7px 0 0;
    color:#8a958e;
    font-size:10px;
    word-break:break-all;
}


/* ============================================================
   BADGES
============================================================ */

.content-item-badges{
    display:flex;
    align-items:center;
    flex-wrap:wrap;
    gap:7px;
    margin-top:11px;
}

.content-item-badge{
    display:inline-flex;
    align-items:center;
    min-height:23px;
    padding:0 9px;
    border-radius:999px;
    font-size:9px;
    font-weight:850;
    letter-spacing:.06em;
    text-transform:uppercase;
}

.animal-badge{
    background:#edf7ef;
    color:#347148;
}

.feed-badge{
    background:#edf7ef;
    color:#2d7243;
}

.asset-badge{
    background:#f1f3f3;
    color:#68746d;
}

.status-badge{
    background:#f4f7f5;
    color:#536359;
}


/* ============================================================
   BODY
============================================================ */

.content-item-body{
    padding:21px;
}


/* ============================================================
   SECTION
============================================================ */

.detail-section{
    margin-bottom:23px;
}

.detail-section:last-child{
    margin-bottom:0;
}

.detail-section-heading{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:10px;
    margin-bottom:11px;
}

.detail-section-title{
    margin:0;
    color:#2a3d30;
    font-size:14px;
    font-weight:850;
    letter-spacing:-.015em;
}

.detail-section-line{
    flex:1;
    height:1px;
    background:#e9eeea;
}


/* ============================================================
   DETAIL GRID
============================================================ */

.detail-grid{
    display:grid;
    grid-template-columns:
        repeat(
            2,
            minmax(0,1fr)
        );
    gap:9px;
}

.detail-box{
    min-width:0;
    padding:12px 13px;
    background:#fafcfb;
    border:1px solid #e6ece8;
    border-radius:11px;
}

.detail-label{
    display:block;
    margin-bottom:5px;
    color:#89948d;
    font-size:9px;
    font-weight:800;
    letter-spacing:.04em;
    text-transform:uppercase;
}

.detail-value{
    display:block;
    color:#35483b;
    font-size:12px;
    line-height:1.45;
    font-weight:750;
    word-break:break-word;
}

.detail-value.muted{
    color:#8a958e;
    font-weight:600;
}


/* ============================================================
   HIGHLIGHT GRID
============================================================ */

.highlight-grid{
    display:grid;
    grid-template-columns:
        repeat(
            3,
            minmax(0,1fr)
        );
    gap:10px;
}

.highlight-box{
    padding:14px;
    background:#f7faf8;
    border:1px solid #dfe9e2;
    border-radius:12px;
}

.highlight-label{
    display:block;
    margin-bottom:6px;
    color:#849188;
    font-size:9px;
    font-weight:800;
    text-transform:uppercase;
    letter-spacing:.05em;
}

.highlight-value{
    display:block;
    color:#294333;
    font-size:17px;
    line-height:1.2;
    font-weight:850;
}

.highlight-unit{
    margin-left:3px;
    color:#738078;
    font-size:10px;
    font-weight:700;
}


/* ============================================================
   STORAGE BOX
============================================================ */

.storage-location-card{
    display:flex;
    align-items:center;
    gap:12px;
    padding:14px;
    background:#f7faf8;
    border:1px solid #dfe9e2;
    border-radius:12px;
}

.storage-location-icon{
    flex:none;
    width:42px;
    height:42px;
    display:flex;
    align-items:center;
    justify-content:center;
    border-radius:11px;
    background:#eaf3ec;
    font-size:20px;
}

.storage-location-information{
    min-width:0;
}

.storage-location-name{
    margin:0;
    color:#2d4535;
    font-size:13px;
    font-weight:850;
}

.storage-location-meta{
    margin:4px 0 0;
    color:#7d8981;
    font-size:10px;
}


/* ============================================================
   ANIMAL SECTION
============================================================ */

.animal-detail-grid{
    display:grid;
    grid-template-columns:
        repeat(
            3,
            minmax(0,1fr)
        );
    gap:9px;
}


/* ============================================================
   DESCRIPTION
============================================================ */

.description-box{
    padding:14px;
    background:#fafcfb;
    border:1px solid #e5ebe7;
    border-radius:12px;
}

.description-text{
    margin:0;
    color:#59685f;
    font-size:11px;
    line-height:1.7;
    white-space:pre-wrap;
    word-break:break-word;
}


/* ============================================================
   EMPTY DESCRIPTION
============================================================ */

.no-description{
    color:#8b958f;
    font-size:11px;
    font-style:italic;
}


/* ============================================================
   FOOTER
============================================================ */

.content-item-footer{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:12px;
    padding:16px 21px;
    background:#fafcfb;
    border-top:1px solid #e5ebe7;
}

.footer-farm{
    min-width:0;
}

.footer-label{
    display:block;
    margin-bottom:3px;
    color:#8a958e;
    font-size:9px;
    font-weight:800;
    text-transform:uppercase;
    letter-spacing:.05em;
}

.footer-farm-name{
    color:#415449;
    font-size:11px;
    font-weight:750;
    word-break:break-word;
}


/* ============================================================
   BACK BUTTON
============================================================ */

.content-item-footer-button{
    flex:none;
    display:inline-flex;
    align-items:center;
    justify-content:center;
    min-height:36px;
    padding:0 13px;
    border:1px solid #286e41;
    border-radius:9px;
    background:#2d7b48;
    color:#fff;
    font-size:11px;
    font-weight:800;
    text-decoration:none;
    transition:.18s ease;
}

.content-item-footer-button:hover{
    background:#256b3d;
    border-color:#256b3d;
    color:#fff;
}


/* ============================================================
   MESSAGES
============================================================ */

.content-item-message{
    display:flex;
    align-items:center;
    gap:9px;
    margin-bottom:16px;
    padding:11px 13px;
    border-radius:10px;
    font-size:12px;
    font-weight:650;
}

.content-item-success{
    background:#f1f8f3;
    border:1px solid #d8e9dc;
    color:#28603a;
}

.content-item-error{
    background:#fff5f4;
    border:1px solid #efd9d6;
    color:#9a443b;
}


/* ============================================================
   MOBILE
============================================================ */

@media (max-width:700px){

    .storage-content-item-page{
        padding:13px 11px 45px;
    }

    .content-item-navigation{
        align-items:flex-start;
        flex-direction:column;
    }

    .content-item-location{
        text-align:left;
    }

    .content-item-hero{
        align-items:flex-start;
        padding:17px;
    }

    .content-item-icon{
        width:55px;
        height:55px;
        border-radius:15px;
        font-size:27px;
    }

    .content-item-title{
        font-size:21px;
    }

    .content-item-body{
        padding:16px;
    }

    .detail-grid{
        grid-template-columns:1fr;
    }

    .highlight-grid{
        grid-template-columns:
            repeat(
                2,
                minmax(0,1fr)
            );
    }

    .animal-detail-grid{
        grid-template-columns:
            repeat(
                2,
                minmax(0,1fr)
            );
    }

    .content-item-footer{
        align-items:stretch;
        flex-direction:column;
        padding:15px 16px;
    }

    .content-item-footer-button{
        width:100%;
        box-sizing:border-box;
    }

}


@media (max-width:430px){

    .content-item-hero{
        gap:11px;
    }

    .content-item-icon{
        width:48px;
        height:48px;
        font-size:23px;
    }

    .content-item-title{
        font-size:19px;
    }

    .highlight-grid{
        grid-template-columns:1fr;
    }

    .animal-detail-grid{
        grid-template-columns:1fr;
    }

}
</style>


<div class="storage-content-item-page">


    <!-- ========================================================
         NAVIGATION
    ========================================================= -->

    <div class="content-item-navigation">

        <a
            href="/storage/<%= currentDairy._id %>/contents/<%= currentStorage._id %>"
            class="content-item-back"
        >
            ← Back to Contents
        </a>


        <div class="content-item-location">

            <%= dairyName %>

            &nbsp; / &nbsp;

            <%= storageName %>

        </div>

    </div>


    <!-- ========================================================
         MESSAGES
    ========================================================= -->

    <% if (successMessage) { %>

        <div class="content-item-message content-item-success">

            <span>✓</span>

            <span>
                <%= successMessage %>
            </span>

        </div>

    <% } %>


    <% if (pageError) { %>

        <div class="content-item-message content-item-error">

            <span>!</span>

            <span>
                <%= pageError %>
            </span>

        </div>

    <% } %>


    <!-- ========================================================
         MAIN CARD
    ========================================================= -->

    <article class="content-item-card">


        <!-- ====================================================
             HERO
        ==================================================== -->

        <div class="content-item-hero">


            <div class="content-item-icon">

                <%= itemIcon %>

            </div>


            <div class="content-item-hero-information">

                <p class="content-item-eyebrow">

                    Storage Content

                </p>


                <h1 class="content-item-title">

                    <%= contentItem.name || "Unnamed Item" %>

                </h1>


                <p class="content-item-id">

                    ID:
                    <%= displayValue(contentItem._id) %>

                </p>


                <div class="content-item-badges">

                    <span
                        class="content-item-badge <%= itemCategoryClass %>"
                    >

                        <%= itemCategory %>

                    </span>


                    <% if (contentItem.status) { %>

                        <span
                            class="content-item-badge status-badge"
                        >

                            <%= contentItem.status %>

                        </span>

                    <% } %>

                </div>

            </div>

        </div>


        <!-- ====================================================
             BODY
        ==================================================== -->

        <div class="content-item-body">


            <!-- ==================================================
                 BASIC INFORMATION
            ================================================== -->

            <section class="detail-section">

                <div class="detail-section-heading">

                    <h2 class="detail-section-title">
                        Basic Information
                    </h2>

                    <span class="detail-section-line"></span>

                </div>


                <div class="detail-grid">


                    <div class="detail-box">

                        <span class="detail-label">
                            Name
                        </span>

                        <span class="detail-value">

                            <%= displayValue(contentItem.name) %>

                        </span>

                    </div>


                    <div class="detail-box">

                        <span class="detail-label">
                            Type
                        </span>

                        <span class="detail-value">

                            <%= displayValue(contentItem.type) %>

                        </span>

                    </div>


                    <div class="detail-box">

                        <span class="detail-label">
                            Record Type
                        </span>

                        <span class="detail-value">

                            <%= displayValue(contentItem.recordType) %>

                        </span>

                    </div>


                    <div class="detail-box">

                        <span class="detail-label">
                            Status
                        </span>

                        <span class="detail-value">

                            <%= displayValue(contentItem.status) %>

                        </span>

                    </div>


                    <div class="detail-box">

                        <span class="detail-label">
                            Code
                        </span>

                        <span class="detail-value">

                            <%= displayValue(contentItem.code) %>

                        </span>

                    </div>


                    <div class="detail-box">

                        <span class="detail-label">
                            Asset Code
                        </span>

                        <span class="detail-value">

                            <%= displayValue(contentItem.assetCode) %>

                        </span>

                    </div>

                </div>

            </section>


            <!-- ==================================================
                 STORAGE INFORMATION
            ================================================== -->

            <section class="detail-section">

                <div class="detail-section-heading">

                    <h2 class="detail-section-title">
                        Storage Information
                    </h2>

                    <span class="detail-section-line"></span>

                </div>


                <div class="storage-location-card">


                    <div class="storage-location-icon">

                        <% if (storageType === "agroStore") { %>
                            🌾
                        <% } else { %>
                            📦
                        <% } %>

                    </div>


                    <div class="storage-location-information">

                        <h3 class="storage-location-name">

                            <%= storageName %>

                        </h3>


                        <p class="storage-location-meta">

                            Storage Type:
                            <strong>
                                <%= displayValue(currentStorage.type) %>
                            </strong>

                            &nbsp;&nbsp;•&nbsp;&nbsp;

                            Room / Dwell Number:
                            <strong>
                                <%= displayValue(storageRoomNumber) %>
                            </strong>

                        </p>

                    </div>

                </div>


                <div
                    class="detail-grid"
                    style="margin-top:9px;"
                >

                    <div class="detail-box">

                        <span class="detail-label">
                            Item Dwell Number
                        </span>

                        <span class="detail-value">

                            <%= displayValue(contentItem.dwellNumber) %>

                        </span>

                    </div>


                    <div class="detail-box">

                        <span class="detail-label">
                            Storage ID
                        </span>

                        <span class="detail-value">

                            <%= displayValue(currentStorage._id) %>

                        </span>

                    </div>

                </div>

            </section>


            <!-- ==================================================
                 QUANTITY / VALUE
            ================================================== -->

            <section class="detail-section">

                <div class="detail-section-heading">

                    <h2 class="detail-section-title">
                        Quantity & Value
                    </h2>

                    <span class="detail-section-line"></span>

                </div>


                <div class="highlight-grid">


                    <div class="highlight-box">

                        <span class="highlight-label">
                            Quantity
                        </span>

                        <span class="highlight-value">

                            <% if (hasQuantity) { %>

                                <%= quantityValue.toLocaleString() %>

                                <span class="highlight-unit">
                                    <%= contentItem.unit || "unit" %>
                                </span>

                            <% } else { %>

                                —

                            <% } %>

                        </span>

                    </div>


                    <div class="highlight-box">

                        <span class="highlight-label">
                            Unit
                        </span>

                        <span class="highlight-value">

                            <%= contentItem.unit || "—" %>

                        </span>

                    </div>


                    <div class="highlight-box">

                        <span class="highlight-label">
                            Current Worth
                        </span>

                        <span class="highlight-value">

                            <% if (hasCurrentWorth) { %>

                                <%= currentWorthValue.toLocaleString() %>

                            <% } else { %>

                                —

                            <% } %>

                        </span>

                    </div>

                </div>

            </section>


            <!-- ==================================================
                 CONDITION
            ================================================== -->

            <% if (contentItem.condition) { %>

                <section class="detail-section">

                    <div class="detail-section-heading">

                        <h2 class="detail-section-title">
                            Condition
                        </h2>

                        <span class="detail-section-line"></span>

                    </div>


                    <div class="detail-box">

                        <span class="detail-label">
                            Current Condition
                        </span>

                        <span class="detail-value">

                            <%= contentItem.condition %>

                        </span>

                    </div>

                </section>

            <% } %>


            <!-- ==================================================
                 ANIMAL INFORMATION
            ================================================== -->

            <% if (itemIsAnimal) { %>

                <section class="detail-section">

                    <div class="detail-section-heading">

                        <h2 class="detail-section-title">
                            Animal Information
                        </h2>

                        <span class="detail-section-line"></span>

                    </div>


                    <div class="animal-detail-grid">


                        <div class="detail-box">

                            <span class="detail-label">
                                Gender
                            </span>

                            <span class="detail-value">

                                <%= displayValue(contentItem.gender) %>

                            </span>

                        </div>


                        <div class="detail-box">

                            <span class="detail-label">
                                Age
                            </span>

                            <span class="detail-value">

                                <%= displayValue(contentItem.ageText) %>

                            </span>

                        </div>


                        <div class="detail-box">

                            <span class="detail-label">
                                Milking
                            </span>

                            <span class="detail-value">

                                <% if (contentItem.isMilking) { %>

                                    Yes

                                <% } else { %>

                                    No

                                <% } %>

                            </span>

                        </div>


                        <div class="detail-box">

                            <span class="detail-label">
                                Code
                            </span>

                            <span class="detail-value">

                                <%= displayValue(contentItem.code) %>

                            </span>

                        </div>


                        <div class="detail-box">

                            <span class="detail-label">
                                Asset Code
                            </span>

                            <span class="detail-value">

                                <%= displayValue(contentItem.assetCode) %>

                            </span>

                        </div>


                        <div class="detail-box">

                            <span class="detail-label">
                                Dwell Number
                            </span>

                            <span class="detail-value">

                                <%= displayValue(contentItem.dwellNumber) %>

                            </span>

                        </div>

                    </div>

                </section>

            <% } %>


            <!-- ==================================================
                 DESCRIPTION
            ================================================== -->

            <section class="detail-section">

                <div class="detail-section-heading">

                    <h2 class="detail-section-title">
                        Description
                    </h2>

                    <span class="detail-section-line"></span>

                </div>


                <div class="description-box">

                    <% if (contentItem.description) { %>

                        <p class="description-text">

                            <%= contentItem.description %>

                        </p>

                    <% } else { %>

                        <span class="no-description">

                            No description has been provided for
                            this item.

                        </span>

                    <% } %>

                </div>

            </section>


        </div>


        <!-- ====================================================
             FOOTER
        ==================================================== -->

        <footer class="content-item-footer">


            <div class="footer-farm">

                <span class="footer-label">
                    Dairy Farm
                </span>


                <span class="footer-farm-name">

                    <%= dairyName %>

                </span>

            </div>


            <a
                href="/storage/<%= currentDairy._id %>/contents/<%= currentStorage._id %>"
                class="content-item-footer-button"
            >
                ← Back to <%= storageName %>
            </a>


        </footer>


    </article>


</div>