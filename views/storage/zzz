<!-- ==========================================================
     views/storage/add.ejs
     ADD STORAGE FACILITY
     ==========================================================

     ROUTES:

         GET  /storage/:id/add
         POST /storage/:id/add

     :id = parent Dairy._id

     USER ENTERS:

         name
         type

     SERVER DETERMINES:

         farmCode
         roomNumber

========================================================== -->


<style>

    /* ======================================================
       PAGE
    ====================================================== */

    .storage-add-page {
        max-width: 900px;
        margin: 0 auto;
        padding: 25px 18px 50px;
        color: #183b24;
    }


    /* ======================================================
       HEADER
    ====================================================== */

    .storage-add-header {
        margin-bottom: 24px;
    }

    .storage-back-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 20px;
        color: #0b5d1e;
        text-decoration: none;
        font-size: 14px;
        font-weight: 700;
        transition: 0.2s ease;
    }

    .storage-back-link:hover {
        color: #084817;
        transform: translateX(-2px);
    }


    .storage-header-content {
        display: flex;
        align-items: center;
        gap: 17px;
        padding: 25px;
        border-radius: 18px;
        background:
            linear-gradient(
                135deg,
                #0b5d1e,
                #168534
            );
        color: #ffffff;
        box-shadow:
            0 10px 28px rgba(11, 93, 30, 0.18);
    }


    .storage-header-icon {
        width: 62px;
        height: 62px;
        min-width: 62px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 16px;
        background: rgba(255,255,255,0.16);
        border: 1px solid rgba(255,255,255,0.25);
        font-size: 30px;
    }


    .storage-header-content h1 {
        margin: 0 0 6px;
        font-size: 26px;
        line-height: 1.2;
        font-weight: 800;
    }


    .storage-header-content p {
        margin: 0;
        font-size: 14px;
        line-height: 1.6;
        opacity: 0.92;
    }


    .storage-header-content strong {
        color: #ffffff;
    }


    /* ======================================================
       ERROR
    ====================================================== */

    .storage-alert {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        padding: 14px 16px;
        margin-bottom: 20px;
        border-radius: 12px;
        font-size: 14px;
        line-height: 1.5;
    }


    .storage-alert-error {
        background: #fff1f1;
        color: #9f1d1d;
        border: 1px solid #f3c2c2;
    }


    /* ======================================================
       FORM CARD
    ====================================================== */

    .storage-form-card {
        overflow: hidden;
        background: #ffffff;
        border: 1px solid #dce9df;
        border-radius: 18px;
        box-shadow:
            0 8px 25px rgba(15, 60, 28, 0.07);
    }


    .storage-form-heading {
        padding: 24px 25px 20px;
        background: #fbfefb;
        border-bottom: 1px solid #e5eee8;
    }


    .storage-form-heading h2 {
        margin: 0 0 5px;
        color: #0b5d1e;
        font-size: 20px;
        font-weight: 800;
    }


    .storage-form-heading p {
        margin: 0;
        color: #6b7d71;
        font-size: 14px;
    }


    /* ======================================================
       FORM
    ====================================================== */

    .storage-form {
        padding: 25px;
    }


    .form-group {
        margin-bottom: 26px;
    }


    .form-group > label {
        display: block;
        margin-bottom: 9px;
        color: #234d30;
        font-size: 14px;
        font-weight: 750;
    }


    .required {
        color: #c62828;
    }


    /* ======================================================
       NAME INPUT
    ====================================================== */

    .form-group input[type="text"] {
        width: 100%;
        box-sizing: border-box;
        padding: 13px 15px;
        outline: none;
        border: 1px solid #cdded2;
        border-radius: 11px;
        background: #ffffff;
        color: #183b24;
        font-size: 15px;
        transition:
            border-color 0.2s ease,
            box-shadow 0.2s ease;
    }


    .form-group input[type="text"]:focus {
        border-color: #0b5d1e;
        box-shadow:
            0 0 0 4px rgba(11, 93, 30, 0.09);
    }


    .form-group input::placeholder {
        color: #9aaa9f;
    }


    .form-group small {
        display: block;
        margin-top: 7px;
        color: #7a8c80;
        font-size: 12px;
        line-height: 1.5;
    }


    /* ======================================================
       TYPE OPTIONS
    ====================================================== */

    .storage-type-options {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 14px;
    }


    .storage-type-option {
        position: relative;
        display: block;
        cursor: pointer;
    }


    .storage-type-option input {
        position: absolute;
        opacity: 0;
        pointer-events: none;
    }


    .storage-type-card {
        min-height: 95px;
        box-sizing: border-box;
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 17px;
        background: #ffffff;
        border: 1.5px solid #d4e2d8;
        border-radius: 14px;
        transition:
            border-color 0.2s ease,
            background 0.2s ease,
            box-shadow 0.2s ease,
            transform 0.2s ease;
    }


    .storage-type-card:hover {
        background: #f8fcf9;
        border-color: #76a985;
        transform: translateY(-1px);
    }


    .storage-type-option input:checked
    + .storage-type-card {
        background: #f0f9f2;
        border-color: #0b5d1e;
        box-shadow:
            0 5px 16px rgba(11, 93, 30, 0.10);
    }


    .storage-option-icon {
        width: 48px;
        height: 48px;
        min-width: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        background: #e9f5ec;
        font-size: 24px;
    }


    .storage-option-content {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }


    .storage-option-content strong {
        color: #174b27;
        font-size: 15px;
    }


    .storage-option-content small {
        margin: 0;
        color: #718177;
        font-size: 12px;
        line-height: 1.4;
    }


    /* ======================================================
       ACTIONS
    ====================================================== */

    .storage-form-actions {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 11px;
        padding-top: 21px;
        border-top: 1px solid #e5eee8;
    }


    .storage-btn {
        min-height: 44px;
        box-sizing: border-box;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 10px 19px;
        border-radius: 10px;
        text-decoration: none;
        cursor: pointer;
        font-family: inherit;
        font-size: 14px;
        font-weight: 750;
        transition:
            transform 0.2s ease,
            box-shadow 0.2s ease,
            background 0.2s ease;
    }


    .storage-btn-secondary {
        color: #496052;
        background: #edf2ee;
        border: 1px solid #d8e1da;
    }


    .storage-btn-secondary:hover {
        background: #e3eae5;
        transform: translateY(-1px);
    }


    .storage-btn-primary {
        color: #ffffff;
        background: #0b5d1e;
        border: none;
        box-shadow:
            0 5px 14px rgba(11, 93, 30, 0.20);
    }


    .storage-btn-primary:hover {
        background: #084817;
        transform: translateY(-1px);
        box-shadow:
            0 7px 18px rgba(11, 93, 30, 0.25);
    }


    .storage-btn-primary span {
        font-size: 20px;
        line-height: 1;
    }


    /* ======================================================
       PARENT FARM CARD
    ====================================================== */

    .storage-farm-card {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-top: 18px;
        padding: 18px 20px;
        background: #ffffff;
        border: 1px solid #dce9df;
        border-radius: 15px;
        box-shadow:
            0 5px 18px rgba(15, 60, 28, 0.05);
    }


    .storage-farm-icon {
        width: 48px;
        height: 48px;
        min-width: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        background: #eaf6ed;
        font-size: 23px;
    }


    .storage-farm-details {
        display: flex;
        flex-direction: column;
        gap: 3px;
    }


    .storage-farm-label {
        color: #7a8c80;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }


    .storage-farm-details strong {
        color: #174b27;
        font-size: 15px;
    }


    .storage-farm-code {
        color: #687a6e;
        font-size: 12px;
    }


    /* ======================================================
       MOBILE
    ====================================================== */

    @media (max-width: 650px) {

        .storage-add-page {
            padding: 17px 12px 35px;
        }


        .storage-header-content {
            padding: 20px 17px;
            border-radius: 15px;
        }


        .storage-header-icon {
            width: 50px;
            height: 50px;
            min-width: 50px;
            font-size: 24px;
            border-radius: 13px;
        }


        .storage-header-content h1 {
            font-size: 21px;
        }


        .storage-header-content p {
            font-size: 13px;
        }


        .storage-form {
            padding: 19px 16px;
        }


        .storage-form-heading {
            padding: 20px 16px 17px;
        }


        .storage-type-options {
            grid-template-columns: 1fr;
        }


        .storage-form-actions {
            flex-direction: column-reverse;
            align-items: stretch;
        }


        .storage-btn {
            width: 100%;
        }


        .storage-farm-card {
            padding: 15px;
        }

    }


    /* ======================================================
       VERY SMALL SCREENS
    ====================================================== */

    @media (max-width: 380px) {

        .storage-header-content {
            align-items: flex-start;
        }


        .storage-header-icon {
            width: 44px;
            height: 44px;
            min-width: 44px;
        }


        .storage-header-content h1 {
            font-size: 19px;
        }


        .storage-option-icon {
            width: 42px;
            height: 42px;
            min-width: 42px;
        }

    }

</style>


<div class="storage-add-page">


    <!-- ======================================================
         HEADER
    ====================================================== -->

    <div class="storage-add-header">

        <!-- IMPORTANT:
             dairy._id is the parent farm MongoDB ID.
             Never use dairy.code here.
        -->

        <a
            href="/storage/<%= dairy._id %>"
            class="storage-back-link"
        >

            <span>←</span>

            <span>
                Back to Storage
            </span>

        </a>


        <div class="storage-header-content">

            <div class="storage-header-icon">
                📦
            </div>

            <div>

                <h1>
                    Add Storage Facility
                </h1>

                <p>
                    Add a new storage facility to
                    <strong>
                        <%= dairy.name %>
                    </strong>
                </p>

            </div>

        </div>

    </div>


    <!-- ======================================================
         ERROR
    ====================================================== -->

    <% if (
        typeof error !== "undefined" &&
        error
    ) { %>

        <div
            class="storage-alert storage-alert-error"
            role="alert"
        >

            <span>⚠️</span>

            <span>
                <%= error %>
            </span>

        </div>

    <% } %>


    <!-- ======================================================
         FORM CARD
    ====================================================== -->

    <div class="storage-form-card">


        <div class="storage-form-heading">

            <h2>
                Storage Details
            </h2>

            <p>
                Enter the name and select the storage type.
            </p>

        </div>


        <!-- ==================================================
             FORM
        =================================================== -->

        <form
            action="/storage/<%= dairy._id %>/add"
            method="POST"
            class="storage-form"
        >


            <!-- ==============================================
                 NAME
            =============================================== -->

            <div class="form-group">

                <label for="name">

                    Storage Name

                    <span class="required">
                        *
                    </span>

                </label>


                <input
                    type="text"
                    id="name"
                    name="name"
                    value="<%= (
                        typeof formData !== 'undefined' &&
                        formData
                    ) ? (formData.name || '') : '' %>"
                    placeholder="e.g. Main Feed Store"
                    maxlength="200"
                    required
                    autocomplete="off"
                >


                <small>
                    Give the storage facility a clear name.
                </small>

            </div>


            <!-- ==============================================
                 TYPE
            =============================================== -->

            <div class="form-group">

                <label>

                    Storage Type

                    <span class="required">
                        *
                    </span>

                </label>


                <div class="storage-type-options">


                    <!-- ======================================
                         ROOM
                    ======================================= -->

                    <label
                        class="storage-type-option"
                        for="type-room"
                    >

                        <input
                            type="radio"
                            id="type-room"
                            name="type"
                            value="room"
                            <%= (
                                typeof formData === 'undefined' ||
                                !formData ||
                                !formData.type ||
                                formData.type === "room"
                            )
                                ? "checked"
                                : "" %>
                            required
                        >


                        <span class="storage-type-card">

                            <span class="storage-option-icon">
                                🚪
                            </span>

                            <span class="storage-option-content">

                                <strong>
                                    Room
                                </strong>

                                <small>
                                    Storage room
                                </small>

                            </span>

                        </span>

                    </label>


                    <!-- ======================================
                         AGROSTORE
                    ======================================= -->

                    <label
                        class="storage-type-option"
                        for="type-agroStore"
                    >

                        <input
                            type="radio"
                            id="type-agroStore"
                            name="type"
                            value="agroStore"
                            <%= (
                                typeof formData !== 'undefined' &&
                                formData &&
                                formData.type === "agroStore"
                            )
                                ? "checked"
                                : "" %>
                        >


                        <span class="storage-type-card">

                            <span class="storage-option-icon">
                                🌾
                            </span>

                            <span class="storage-option-content">

                                <strong>
                                    AgroStore
                                </strong>

                                <small>
                                    Agricultural storage
                                </small>

                            </span>

                        </span>

                    </label>


                </div>

            </div>


            <!-- ==================================================
                 ACTIONS
            =================================================== -->

            <div class="storage-form-actions">

                <!-- IMPORTANT:
                     This uses parent Dairy._id.
                -->

                <a
                    href="/storage/<%= dairy._id %>"
                    class="storage-btn storage-btn-secondary"
                >
                    Cancel
                </a>


                <button
                    type="submit"
                    class="storage-btn storage-btn-primary"
                >

                    <span>+</span>

                    Add Storage

                </button>

            </div>


        </form>

    </div>


    <!-- ======================================================
         PARENT FARM
    ======================================================= -->

    <div class="storage-farm-card">

        <div class="storage-farm-icon">
            🏡
        </div>


        <div class="storage-farm-details">

            <span class="storage-farm-label">
                Parent Dairy Farm
            </span>


            <strong>
                <%= dairy.name %>
            </strong>


            <!-- This is informational only.
                 The route ID remains dairy._id. -->

            <span class="storage-farm-code">

                Farm Code:
                <%= dairy.code %>

            </span>

        </div>

    </div>


</div>