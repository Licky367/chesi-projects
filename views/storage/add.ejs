<!-- ==========================================================
     views/storage/add.ejs
     ADD STORAGE FACILITY
     ==========================================================

     ROUTES:

         GET  /storage/:id/add
         POST /storage/:id/add

     :id = parent Dairy._id

     USER ENTERS:

         name
         type

     BACKEND DETERMINES:

         recordType = "structure"
         assetCode = parent Dairy.code
         roomNumber

     IMPORTANT:

         The parent Dairy is identified by MongoDB _id
         in the URL.

         The parent relationship stored on the new
         structure record is assetCode = parent Dairy.code.

========================================================== -->


<style>

/* ==========================================================
   PAGE
========================================================== */

.storage-add-page {

    max-width: 900px;

    margin: 0 auto;

    padding: 24px 16px 60px;

}


/* ==========================================================
   HEADER
========================================================== */

.storage-add-header {

    margin-bottom: 24px;

}

.storage-add-header-top {

    display: flex;

    align-items: center;

    margin-bottom: 18px;

}

.storage-back-link {

    display: inline-flex;

    align-items: center;

    gap: 7px;

    color: #15803d;

    text-decoration: none;

    font-weight: 700;

    font-size: 14px;

}

.storage-back-link:hover {

    color: #166534;

    text-decoration: underline;

}

.storage-add-header h1 {

    margin: 0;

    color: #172033;

    font-size: 30px;

    line-height: 1.2;

}

.storage-add-header p {

    margin: 8px 0 0;

    color: #6b7280;

    font-size: 15px;

    line-height: 1.6;

}


/* ==========================================================
   MAIN CARD
========================================================== */

.storage-add-card {

    background: #ffffff;

    border: 1px solid #e5e7eb;

    border-radius: 22px;

    padding: 26px;

    box-shadow:
        0 8px 30px rgba(15, 23, 42, 0.08);

}


/* ==========================================================
   FORM STATUS
========================================================== */

.form-save-status {

    display: none;

    margin-bottom: 20px;

    padding: 13px 15px;

    border-radius: 12px;

    font-size: 14px;

    font-weight: 600;

    line-height: 1.5;

}

.form-save-status.success {

    display: block;

    background: #ecfdf5;

    color: #047857;

    border: 1px solid #a7f3d0;

}

.form-save-status.error {

    display: block;

    background: #fef2f2;

    color: #b91c1c;

    border: 1px solid #fecaca;

}


/* ==========================================================
   BACKEND-CONTROLLED RECORD INFORMATION
========================================================== */

.record-info-card {

    padding: 18px;

    margin-bottom: 24px;

    border-radius: 16px;

    background: #f0fdf4;

    border: 1px solid #bbf7d0;

}

.record-info-grid {

    display: grid;

    grid-template-columns:
        repeat(2, minmax(0, 1fr));

    gap: 18px;

}

.record-info-item {

    display: flex;

    flex-direction: column;

    gap: 5px;

}

.record-info-label {

    color: #6b7280;

    font-size: 12px;

    font-weight: 700;

    text-transform: uppercase;

    letter-spacing: 0.4px;

}

.record-info-value {

    color: #172033;

    font-size: 15px;

    font-weight: 700;

}


/* ==========================================================
   FORM GROUP
========================================================== */

.form-group {

    margin-bottom: 20px;

}

.form-group label {

    display: block;

    margin-bottom: 8px;

    color: #273449;

    font-size: 14px;

    font-weight: 700;

}


/* ==========================================================
   INPUTS
========================================================== */

.form-group input,
.form-group select {

    width: 100%;

    box-sizing: border-box;

    border: 1px solid #d9dee7;

    border-radius: 12px;

    background: #ffffff;

    color: #172033;

    font-size: 15px;

    padding: 12px 13px;

    outline: none;

    transition:
        border-color .2s ease,
        box-shadow .2s ease,
        background .2s ease;

}

.form-group input:focus,
.form-group select:focus {

    border-color: #16a34a;

    box-shadow:
        0 0 0 3px rgba(22, 163, 74, 0.12);

}

.form-group input::placeholder {

    color: #9aa3af;

}

.form-help {

    margin-top: 7px;

    color: #7b8494;

    font-size: 12px;

    line-height: 1.5;

}


/* ==========================================================
   STORAGE TYPE OPTIONS
========================================================== */

.storage-type-options {

    display: grid;

    grid-template-columns:
        repeat(2, minmax(0, 1fr));

    gap: 14px;

}

.storage-type-option {

    position: relative;

    display: block;

    cursor: pointer;

}

.storage-type-option input {

    position: absolute;

    opacity: 0;

    pointer-events: none;

}

.storage-type-card {

    min-height: 95px;

    box-sizing: border-box;

    display: flex;

    align-items: center;

    gap: 14px;

    padding: 17px;

    background: #ffffff;

    border: 1.5px solid #d9dee7;

    border-radius: 14px;

    transition:
        border-color .2s ease,
        background .2s ease,
        box-shadow .2s ease,
        transform .2s ease;

}

.storage-type-card:hover {

    background: #f8fcf9;

    border-color: #76a985;

    transform: translateY(-1px);

}

.storage-type-option input:checked
+ .storage-type-card {

    background: #f0fdf4;

    border-color: #16a34a;

    box-shadow:
        0 5px 16px rgba(22, 163, 74, 0.10);

}

.storage-option-icon {

    width: 48px;

    height: 48px;

    min-width: 48px;

    display: flex;

    align-items: center;

    justify-content: center;

    border-radius: 12px;

    background: #e9f5ec;

    font-size: 24px;

}

.storage-option-content {

    display: flex;

    flex-direction: column;

    gap: 4px;

}

.storage-option-content strong {

    color: #174b27;

    font-size: 15px;

}

.storage-option-content small {

    margin: 0;

    color: #718177;

    font-size: 12px;

    line-height: 1.4;

}


/* ==========================================================
   ACTIONS
========================================================== */

.form-actions {

    display: flex;

    justify-content: flex-end;

    align-items: center;

    gap: 12px;

    margin-top: 28px;

    padding-top: 22px;

    border-top: 1px solid #edf0f4;

}

.button {

    display: inline-flex;

    align-items: center;

    justify-content: center;

    min-height: 46px;

    padding: 0 20px;

    border-radius: 12px;

    border: none;

    text-decoration: none;

    cursor: pointer;

    font-size: 14px;

    font-weight: 700;

    transition:
        transform .15s ease,
        opacity .15s ease,
        box-shadow .15s ease;

}

.button:hover {

    transform: translateY(-1px);

}

.button:disabled {

    opacity: .65;

    cursor: not-allowed;

    transform: none;

}

.button-secondary {

    background: #f1f4f8;

    color: #374151;

}

.button-primary {

    background: #16a34a;

    color: #ffffff;

    box-shadow:
        0 5px 14px rgba(22, 163, 74, 0.22);

}

.button-primary:hover {

    background: #15803d;

    box-shadow:
        0 7px 18px rgba(22, 163, 74, 0.28);

}


/* ==========================================================
   PARENT FARM CARD
========================================================== */

.storage-farm-card {

    display: flex;

    align-items: center;

    gap: 14px;

    margin-top: 18px;

    padding: 18px 20px;

    background: #ffffff;

    border: 1px solid #dce9df;

    border-radius: 15px;

    box-shadow:
        0 5px 18px rgba(15, 60, 28, 0.05);

}

.storage-farm-icon {

    width: 48px;

    height: 48px;

    min-width: 48px;

    display: flex;

    align-items: center;

    justify-content: center;

    border-radius: 12px;

    background: #eaf6ed;

    font-size: 23px;

}

.storage-farm-details {

    display: flex;

    flex-direction: column;

    gap: 3px;

}

.storage-farm-label {

    color: #7a8c80;

    font-size: 11px;

    font-weight: 700;

    text-transform: uppercase;

    letter-spacing: 0.5px;

}

.storage-farm-details strong {

    color: #174b27;

    font-size: 15px;

}

.storage-farm-code {

    color: #687a6e;

    font-size: 12px;

}


/* ==========================================================
   MOBILE
========================================================== */

@media (max-width: 700px) {

    .storage-add-page {

        padding:
            18px 12px 40px;

    }

    .storage-add-card {

        padding: 18px;

        border-radius: 18px;

    }

    .storage-add-header h1 {

        font-size: 25px;

    }

    .record-info-grid {

        grid-template-columns: 1fr;

        gap: 12px;

    }

    .storage-type-options {

        grid-template-columns: 1fr;

    }

    .form-actions {

        flex-direction: column-reverse;

        align-items: stretch;

    }

    .button {

        width: 100%;

    }

}


/* ==========================================================
   REDUCED MOTION
========================================================== */

@media (prefers-reduced-motion: reduce) {

    .button,
    .form-group input,
    .form-group select,
    .storage-type-card {

        transition: none;

    }

}

</style>


<div class="storage-add-page">


    <!-- ======================================================
         HEADER
    ====================================================== -->

    <div class="storage-add-header">

        <div class="storage-add-header-top">

            <a
                href="/storage/<%= dairy._id %>"
                class="storage-back-link"
            >

                ← Back to Storage

            </a>

        </div>


        <h1>
            Add Storage Facility
        </h1>


        <p>
            Create a storage facility under
            <strong>
                <%= dairy.name %>
            </strong>.
        </p>

    </div>


    <!-- ======================================================
         MAIN CARD
    ====================================================== -->

    <div class="storage-add-card">


        <!-- ==================================================
             FORM STATUS
        ================================================== -->

        <% if (
            typeof error !== "undefined" &&
            error
        ) { %>

            <div
                id="formSaveStatus"
                class="form-save-status error"
                role="alert"
                aria-live="polite"
            >

                <%= error %>

            </div>

        <% } else { %>

            <div
                id="formSaveStatus"
                class="form-save-status"
                role="status"
                aria-live="polite"
            ></div>

        <% } %>


        <!-- ==================================================
             BACKEND-CONTROLLED RECORD INFORMATION
        ================================================== -->

        <div class="record-info-card">

            <div class="record-info-grid">


                <div class="record-info-item">

                    <span class="record-info-label">
                        Record Type
                    </span>

                    <span class="record-info-value">
                        Structure
                    </span>

                </div>


                <div class="record-info-item">

                    <span class="record-info-label">
                        Parent Dairy Farm
                    </span>

                    <span class="record-info-value">
                        <%= dairy.name %>
                    </span>

                </div>


            </div>

        </div>


        <!-- ==================================================
             FORM
        ================================================== -->

        <form
            id="addStorageForm"
            action="/storage/<%= dairy._id %>/add"
            method="POST"
            class="storage-add-form"
        >


            <!-- ==================================================
                 BACKEND-CONTROLLED VALUES

                 These are included for consistency with the
                 /add form's field naming.

                 IMPORTANT:
                 The server MUST NOT trust these values.
                 It must derive recordType and assetCode from
                 req.params.id and the parent Dairy record.
            ================================================== -->

            <input
                type="hidden"
                name="recordType"
                value="structure"
            >

            <input
                type="hidden"
                name="assetCode"
                value="<%= dairy.code %>"
            >


            <!-- ==================================================
                 NAME
            ================================================== -->

            <div class="form-group">

                <label for="name">
                    Name
                </label>

                <input
                    type="text"
                    id="name"
                    name="name"
                    value="<%= (
                        typeof formData !== 'undefined' &&
                        formData
                    ) ? (formData.name || '') : '' %>"
                    required
                    maxlength="200"
                    autocomplete="off"
                    placeholder="e.g. Main Feed Store"
                >

                <div class="form-help">
                    Enter a clear name for this storage facility.
                </div>

            </div>


            <!-- ==================================================
                 STORAGE TYPE
            ================================================== -->

            <div class="form-group">

                <label>
                    Storage Type
                </label>


                <div class="storage-type-options">


                    <!-- ==========================================
                         ROOM
                    =========================================== -->

                    <label
                        class="storage-type-option"
                        for="type-room"
                    >

                        <input
                            type="radio"
                            id="type-room"
                            name="type"
                            value="room"
                            <%= (
                                typeof formData === "undefined" ||
                                !formData ||
                                !formData.type ||
                                formData.type === "room"
                            )
                                ? "checked"
                                : "" %>
                            required
                        >


                        <span class="storage-type-card">

                            <span class="storage-option-icon">
                                🚪
                            </span>


                            <span class="storage-option-content">

                                <strong>
                                    Room
                                </strong>

                                <small>
                                    Storage room
                                </small>

                            </span>

                        </span>

                    </label>


                    <!-- ==========================================
                         AGROSTORE
                    =========================================== -->

                    <label
                        class="storage-type-option"
                        for="type-agroStore"
                    >

                        <input
                            type="radio"
                            id="type-agroStore"
                            name="type"
                            value="agroStore"
                            <%= (
                                typeof formData !== "undefined" &&
                                formData &&
                                formData.type === "agroStore"
                            )
                                ? "checked"
                                : "" %>
                        >


                        <span class="storage-type-card">

                            <span class="storage-option-icon">
                                🌾
                            </span>


                            <span class="storage-option-content">

                                <strong>
                                    AgroStore
                                </strong>

                                <small>
                                    Agricultural storage
                                </small>

                            </span>

                        </span>

                    </label>


                </div>

            </div>


            <!-- ==================================================
                 ACTIONS
            ================================================== -->

            <div class="form-actions">

                <a
                    href="/storage/<%= dairy._id %>"
                    class="button button-secondary"
                >
                    Cancel
                </a>


                <button
                    type="submit"
                    id="saveStorageButton"
                    class="button button-primary"
                >

                    Add Storage

                </button>

            </div>


        </form>

    </div>


    <!-- ======================================================
         PARENT FARM
    ====================================================== -->

    <div class="storage-farm-card">

        <div class="storage-farm-icon">
            🏡
        </div>


        <div class="storage-farm-details">

            <span class="storage-farm-label">
                Parent Dairy Farm
            </span>


            <strong>
                <%= dairy.name %>
            </strong>


            <span class="storage-farm-code">

                Farm Code:
                <%= dairy.code %>

            </span>

        </div>

    </div>


</div>


<script>

document.addEventListener(
    "DOMContentLoaded",
    function () {


        const form =
            document.getElementById(
                "addStorageForm"
            );


        const saveButton =
            document.getElementById(
                "saveStorageButton"
            );


        const statusBox =
            document.getElementById(
                "formSaveStatus"
            );


        function clearStatus() {

            statusBox.textContent =
                "";

            statusBox.className =
                "form-save-status";

        }


        function showError(
            message
        ) {

            statusBox.textContent =
                message;

            statusBox.className =
                "form-save-status error";

        }


        function validateForm() {

            const name =
                document
                    .getElementById(
                        "name"
                    )
                    .value
                    .trim();


            if (!name) {

                return (
                    "Storage name is required."
                );

            }


            const selectedType =
                form.querySelector(
                    'input[name="type"]:checked'
                );


            if (!selectedType) {

                return (
                    "Please select a storage type."
                );

            }


            return null;

        }


        form.addEventListener(
            "submit",
            function (event) {

                clearStatus();


                const error =
                    validateForm();


                if (error) {

                    event.preventDefault();

                    showError(
                        error
                    );

                    return;

                }


                saveButton.disabled =
                    true;

                saveButton.textContent =
                    "Creating Storage...";

            }
        );


    }
);

</script>