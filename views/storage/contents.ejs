<%
/*
==============================================================
STORAGE CONTENTS
==============================================================

FILE:
    views/storage/contents.ejs

PURPOSE:
    Display the contents of a storage location.

SUPPORTED STORAGE TYPES:

    room
        • Current contents
        • Storage tabs
        • Select contents
        • Omit selected
        • Reshuffle selected
        • Add eligible Dairy records

    agroStore
        • Current contents
        • Add Item button
        • No room-management tabs
        • No selection
        • No reshuffle
        • No omit

==============================================================
*/


/* ============================================================
   USER / ADMIN
============================================================ */

const isAdmin =
    Boolean(
        user &&
        user.role === "admin"
    );


/* ============================================================
   STORAGE TYPE
============================================================ */

const storageType =
    storage && storage.type
        ? String(storage.type).trim()
        : "";

const isNormalRoom =
    storageType === "room";

const isAgroStore =
    storageType === "agroStore";


/* ============================================================
   STORAGE NAME
============================================================ */

const storageName =
    (
        storage &&
        storage.displayName
    )
        ||
    (
        storage &&
        storage.name
    )
        ||
    (
        isAgroStore
            ? "AgroStore"
            : "Room " +
                (
                    storage &&
                    storage.roomNumber !== null &&
                    storage.roomNumber !== undefined
                        ? storage.roomNumber
                        : "—"
                )
    );


/* ============================================================
   STORAGE ROOM NUMBER
============================================================ */

const storageRoomNumber =
    (
        storage &&
        storage.roomNumber !== null &&
        storage.roomNumber !== undefined
    )
        ? storage.roomNumber
        : null;


/* ============================================================
   SAFE ARRAYS
============================================================ */

const suppliedItems =
    Array.isArray(items)
        ? items
        : [];

const availableAddItems =
    Array.isArray(availableItems)
        ? availableItems
        : [];

const storageTargets =
    Array.isArray(targetStorages)
        ? targetStorages
        : [];


/* ============================================================
   HELPERS
============================================================ */

function displayValue(value) {

    return (
        value !== null &&
        value !== undefined &&
        String(value).trim() !== ""
    )
        ? value
        : "—";

}


/* ============================================================
   DISPLAY STORAGE NAME
============================================================ */

function displayStorageName(item) {

    if (item && item.displayName) {

        return item.displayName;

    }

    if (item && item.name) {

        return item.name;

    }

    if (
        item &&
        item.roomNumber !== null &&
        item.roomNumber !== undefined
    ) {

        return "Room " + item.roomNumber;

    }

    if (
        item &&
        item.type === "agroStore"
    ) {

        return "AgroStore";

    }

    return "Storage";

}


/* ============================================================
   ITEM CLASSIFICATION
   DISPLAY ONLY
============================================================ */

function itemIsFeed(item) {

    return Boolean(
        item &&
        String(item.type || "").trim() === "feeds"
    );

}


function itemIsAnimal(item) {

    if (!item) {

        return false;

    }

    const code =
        Number(item.code);

    return (
        item.code !== null &&
        item.code !== undefined &&
        !Number.isNaN(code) &&
        code > 0
    );

}


function itemIsAgroStore(item) {

    return Boolean(
        item &&
        String(item.type || "").trim() === "agroStore"
    );

}


/* ============================================================
   STORAGE RECORD CHECK

   Used to prevent rooms/agrostores themselves from being
   selected as ordinary Dairy contents.
============================================================ */

function isStorageRecord(item) {

    if (!item) {

        return false;

    }

    const recordType =
        String(item.recordType || "").trim();

    const type =
        String(item.type || "").trim();

    return (
        recordType === "structure" ||
        type === "room" ||
        type === "agroStore"
    );

}


/* ============================================================
   VALUE COMPARISON

   Storage numbers / codes may arrive from MongoDB as numbers
   while other values may arrive as strings.

   Compare their trimmed string representations so that:

       2 === "2"

   is treated as equal.
============================================================ */

function sameValue(a, b) {

    if (
        a === null ||
        a === undefined ||
        b === null ||
        b === undefined
    ) {

        return false;

    }

    return (
        String(a).trim() ===
        String(b).trim()
    );

}


/* ============================================================
   ROOM CURRENT CONTENTS
============================================================

   A Dairy record belongs to the current room when:

       item.dwellNumber === storage.roomNumber

   Nothing else is required for room current contents.
============================================================ */

function belongsToCurrentRoom(item) {

    if (!isNormalRoom) {

        return false;

    }

    if (!item) {

        return false;

    }

    if (
        storageRoomNumber === null ||
        storageRoomNumber === undefined
    ) {

        return false;

    }

    return sameValue(
        item.dwellNumber,
        storageRoomNumber
    );

}


/* ============================================================
   AGROSTORE CURRENT CONTENTS
============================================================

   AgroStore rule remains:

       dwellNumber === storage.roomNumber
       AND
       quantity > 0

   No code filter.
   No assetCode filter.
============================================================ */

function belongsToAgroStore(item) {

    if (!isAgroStore) {

        return false;

    }

    if (!item) {

        return false;

    }

    if (
        storageRoomNumber === null ||
        storageRoomNumber === undefined
    ) {

        return false;

    }

    if (
        !sameValue(
            item.dwellNumber,
            storageRoomNumber
        )
    ) {

        return false;

    }

    const quantity =
        Number(item.quantity);

    if (
        Number.isNaN(quantity) ||
        quantity <= 0
    ) {

        return false;

    }

    return true;

}


/* ============================================================
   CURRENT CONTENTS
============================================================ */

const currentItems =
    isAgroStore
        ? suppliedItems.filter(
            function(item) {

                return belongsToAgroStore(item);

            }
        )
        : suppliedItems.filter(
            function(item) {

                return belongsToCurrentRoom(item);

            }
        );


/* ============================================================
   ADD ITEM ELIGIBILITY
   ROOM ONLY
============================================================

   A record can appear in "Add Items" when:

       1. Current storage is a normal room.

       2. item.assetCode === storage.roomNumber

       3. item.dwellNumber !== storage.roomNumber

       4. The item is not itself a storage structure.

   IMPORTANT:

       The previous dairy.code comparison is intentionally
       removed.

       The room's roomNumber is the comparison value.
============================================================ */

function canBeAddedToRoom(item) {

    if (!isNormalRoom) {

        return false;

    }

    if (!isAdmin) {

        return false;

    }

    if (!item) {

        return false;

    }

    if (
        storageRoomNumber === null ||
        storageRoomNumber === undefined
    ) {

        return false;

    }

    /*
    ------------------------------------------------------------
    ASSET CODE MUST MATCH THE ROOM NUMBER
    ------------------------------------------------------------
    */

    if (
        !sameValue(
            item.assetCode,
            storageRoomNumber
        )
    ) {

        return false;

    }


    /*
    ------------------------------------------------------------
    DWELL NUMBER MUST NOT MATCH THE ROOM NUMBER
    ------------------------------------------------------------
    */

    if (
        sameValue(
            item.dwellNumber,
            storageRoomNumber
        )
    ) {

        return false;

    }


    /*
    ------------------------------------------------------------
    DO NOT ADD STORAGE STRUCTURES AS CONTENTS
    ------------------------------------------------------------
    */

    if (
        isStorageRecord(item)
    ) {

        return false;

    }


    return true;

}


/* ============================================================
   FILTERED ROOM ADD ITEMS
============================================================ */

const filteredAddItems =
    isNormalRoom && isAdmin
        ? availableAddItems.filter(
            function(item) {

                return canBeAddedToRoom(item);

            }
        )
        : [];


/* ============================================================
   COUNTS
============================================================ */

const currentItemCount =
    currentItems.length;

const addItemCount =
    filteredAddItems.length;

