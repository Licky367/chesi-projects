                <a
                    href="/storage/<%= dairy._id %>/contents/<%= storage._id %>/add/<%= storageType %>"
                    class="add-storage-item-button"
                >

                    + Add Item

                </a>

            <% } %>


            <a
                href="/storage/<%= dairy._id %>"
                class="back-storage"
            >

                ← Back to Storage

            </a>

        </div>

    </header>


    <!-- ========================================================
         MESSAGES
    ========================================================= -->

    <% if (successMessage) { %>

        <div class="storage-message storage-success">

            <span>✓</span>

            <span>
                <%= successMessage %>
            </span>

        </div>

    <% } %>


    <% if (pageError) { %>

        <div class="storage-message storage-error">

            <span>!</span>

            <span>
                <%= pageError %>
            </span>

        </div>

    <% } %>


    <!-- ========================================================
         ROOM TABS

         ONLY room gets these tabs.
         AgroStore does NOT.
    ========================================================= -->

    <% if (isNormalRoom) { %>

        <nav
            class="storage-tabs"
            aria-label="Storage sections"
        >

            <button
                type="button"
                class="storage-tab active"
                data-storage-tab="contents"
            >

                Current Contents

            </button>


            <button
                type="button"
                class="storage-tab"
                data-storage-tab="add-items"
            >

                Add Items

            </button>

        </nav>

    <% } %>


    <!-- ========================================================
         CURRENT CONTENTS
    ========================================================= -->

    <section
        class="<% if (isNormalRoom) { %>storage-tab-panel active<% } %>"
        <% if (isNormalRoom) { %>
            data-storage-panel="contents"
        <% } %>
    >

        <div class="contents-topbar">

            <h2 class="contents-heading">

                <% if (isAgroStore) { %>

                    Dairy in AgroStore

                <% } else { %>

                    Current Contents

                <% } %>

            </h2>


            <div class="contents-count">

                <strong>
                    <%= currentItemCount %>
                </strong>


                <% if (currentItemCount === 1) { %>

                    item

                <% } else { %>

                    items

                <% } %>

            </div>

        </div>


        <% if (currentItemCount > 0) { %>


            <!-- ==================================================
                 ROOM MANAGEMENT
            ================================================== -->

            <% if (isNormalRoom) { %>

                <form
                    id="contentsManagementForm"
                    method="POST"
                    action="/storage/<%= dairy._id %>/contents/<%= storage._id %>/reshuffle"
                >

                    <div class="contents-management">

                        <div class="management-left">

                            <label class="select-all-wrapper">

                                <input
                                    type="checkbox"
                                    id="selectAllContents"
                                >

                                <span>
                                    Select All
                                </span>

                            </label>


                            <span
                                id="contentsSelectionCount"
                                class="selection-count"
                            >

                                0 selected

                            </span>

                        </div>


                        <div class="management-right">

                            <button
                                type="button"
                                id="openReshuffleButton"
                                class="storage-action-button reshuffle-button"
                                disabled
                            >

                                Reshuffle

                            </button>


                            <button
                                type="button"
                                id="omitButton"
                                class="storage-action-button omit-button"
                                disabled
                            >

                                Omit Selected

                            </button>

                        </div>

                    </div>


                    <!-- ==========================================
                         RESHUFFLE PANEL
                    =========================================== -->

                    <div
                        id="reshufflePanel"
                        class="reshuffle-panel"
                    >

                        <h3 class="reshuffle-heading">

                            Reshuffle Selected Items

                        </h3>


                        <p class="reshuffle-description">

                            Select another compatible storage
                            facility. The selected records will be
                            moved to the destination storage.

                        </p>


                        <div class="reshuffle-form">

                            <div class="reshuffle-select-group">

                                <label for="destinationStorage">

                                    Destination

                                </label>


                                <select
                                    id="destinationStorage"
                                    name="targetStorageId"
                                    class="reshuffle-select"
                                >

                                    <option value="">

                                        Select destination...

                                    </option>


                                    <% if (storageTargets.length > 0) { %>

                                        <% storageTargets.forEach(function(destination) { %>

                                            <option
                                                value="<%= destination._id %>"
                                            >

                                                <%= displayStorageName(destination) %>


                                                <% if (
                                                    destination.roomNumber !== null &&
                                                    destination.roomNumber !== undefined
                                                ) { %>

                                                    — <%= destination.roomNumber %>

                                                <% } %>

                                            </option>

                                        <% }); %>

                                    <% } else { %>

                                        <option
                                            value=""
                                            disabled
                                        >

                                            No other compatible storage available

                                        </option>

                                    <% } %>

                                </select>

                            </div>


                            <button
                                type="submit"
                                id="reshuffleSubmitButton"
                                class="storage-action-button add-button"
                                disabled
                            >

                                Reshuffle Selected

                            </button>


                            <button
                                type="button"
                                id="cancelReshuffleButton"
                                class="storage-action-button omit-button"
                            >

                                Cancel

                            </button>

                        </div>

                    </div>

            <% } %>


            <!-- ==================================================
                 CONTENT LIST
            ================================================== -->

            <div class="contents-list">


                <% currentItems.forEach(function(item) { %>

                    <%
                        const currentItemIsAnimal =
                            itemIsAnimal(item);


                        const currentItemIsFeed =
                            itemIsFeed(item);


                        const currentItemIsAgroStore =
                            itemIsAgroStore(item);
                    %>


                    <article
                        class="content-card <% if (isAgroStore) { %>no-selection<% } %>"
                        data-content-card
                        data-item-id="<%= item._id %>"
                    >


                        <!-- ======================================
                             CHECKBOX
                             ROOM ONLY
                        ======================================= -->

                        <% if (isNormalRoom) { %>

                            <div class="content-checkbox">

                                <input
                                    type="checkbox"
                                    class="content-item-checkbox"
                                    name="itemIds"
                                    value="<%= item._id %>"
                                >

                            </div>

                        <% } %>


                        <!-- ======================================
                             ICON
                        ======================================= -->

                        <div class="content-icon">

                            <% if (currentItemIsFeed) { %>

                                🌾

                            <% } else if (currentItemIsAnimal) { %>

                                🐄

                            <% } else if (currentItemIsAgroStore) { %>

                                🌾

                            <% } else { %>

                                🔧

                            <% } %>

                        </div>


                        <!-- ======================================
                             INFORMATION
                        ====================================== -->

                        <div class="content-information">

                            <div class="content-title-row">

                                <h3>

                                    <%= item.name || "Unnamed Item" %>

                                </h3>


                                <span
                                    class="content-type
                                    <% if (currentItemIsFeed) { %>
                                        feed-type
                                    <% } else if (currentItemIsAnimal) { %>
                                        animal-type
                                    <% } else { %>
                                        asset-type
                                    <% } %>"
                                >

                                    <% if (currentItemIsFeed) { %>

                                        Feed

                                    <% } else if (currentItemIsAnimal) { %>

                                        Animal

                                    <% } else if (currentItemIsAgroStore) { %>

                                        AgroStore

                                    <% } else { %>

                                        Asset

                                    <% } %>

                                </span>

                            </div>


                            <div class="content-meta">

                                <span class="content-meta-item">

                                    <strong>
                                        Code:
                                    </strong>

                                    <%= displayValue(item.code) %>

                                </span>


                                <span class="content-meta-item">

                                    <strong>
                                        Asset Code:
                                    </strong>

                                    <%= displayValue(item.assetCode) %>

                                </span>


                                <span class="content-meta-item">

                                    <strong>
                                        Type:
                                    </strong>

                                    <%= displayValue(item.type) %>

                                </span>


                                <span class="content-meta-item">

                                    <strong>
                                        Status:
                                    </strong>

                                    <%= displayValue(item.status) %>

                                </span>


                                <span class="content-meta-item">

                                    <strong>
                                        Dwell:
                                    </strong>

                                    <%= displayValue(item.dwellNumber) %>

                                </span>


                                <% if (
                                    item.quantity !== null &&
                                    item.quantity !== undefined
                                ) { %>

                                    <span class="content-meta-item">

                                        <strong>
                                            Quantity:
                                        </strong>

                                        <%= Number(
                                            item.quantity || 0
                                        ).toLocaleString() %>

                                        <%= item.unit || "unit" %>

                                    </span>

                                <% } %>


                                <% if (item.condition) { %>

                                    <span class="content-meta-item">

                                        <strong>
                                            Condition:
                                        </strong>

                                        <%= item.condition %>

                                    </span>

                                <% } %>


                                <% if (
                                    item.currentWorth !== null &&
                                    item.currentWorth !== undefined
                                ) { %>

                                    <span class="content-meta-item">

                                        <strong>
                                            Worth:
                                        </strong>

                                        <%= Number(
                                            item.currentWorth || 0
                                        ).toLocaleString() %>

                                    </span>

                                <% } %>

                            </div>


                            <% if (currentItemIsAnimal) { %>

                                <div class="animal-information">

                                    <span>

                                        <strong>
                                            Gender:
                                        </strong>

                                        <%= item.gender || "—" %>

                                    </span>


                                    <span>

                                        <strong>
                                            Age:
                                        </strong>

                                        <%= item.ageText || "—" %>

                                    </span>


                                    <span>

                                        <strong>
                                            Milking:
                                        </strong>

                                        <% if (item.isMilking) { %>

                                            Yes

                                        <% } else { %>

                                            No

                                        <% } %>

                                    </span>

                                </div>

                            <% } %>


                            <% if (item.description) { %>

                                <p class="content-description">

                                    <%= item.description %>

                                </p>

                            <% } %>


                        </div>

                    </article>


                <% }); %>


            </div>


            <% if (isNormalRoom) { %>

                </form>


                <!-- ==============================================
                     OMIT FORM
                =============================================== -->

                <form
                    id="omitForm"
                    method="POST"
                    action="/storage/<%= dairy._id %>/contents/<%= storage._id %>/omit"
                    style="display:none;"
                >

                    <div id="omitInputs"></div>

                </form>

            <% } %>


        <% } else { %>


            <!-- ==================================================
                 EMPTY
            ================================================== -->

            <div class="empty-contents">

                <div class="empty-icon">

                    <% if (isAgroStore) { %>

                        🌾

                    <% } else { %>

                        📦

                    <% } %>

                </div>


                <h3>

                    <% if (isAgroStore) { %>

                        AgroStore is Empty

                    <% } else { %>

                        Storage Room is Empty

                    <% } %>

                </h3>


                <p>

                    <% if (isAgroStore) { %>

                        No Dairy records currently have a
                        <strong>dwellNumber</strong> matching this
                        AgroStore's room number
                        (<strong><%= displayValue(storageRoomNumber) %></strong>).

                    <% } else { %>

                        No records are currently located in this
                        storage room.

                    <% } %>

                </p>

            </div>

        <% } %>

    </section>


    <!-- ========================================================
         ADD ITEMS TAB

         ROOM ONLY

         AgroStore uses the header Add Item button instead.
    ========================================================= -->

    <% if (isNormalRoom) { %>

        <section
            class="storage-tab-panel"
            data-storage-panel="add-items"
        >

            <div class="add-items-section">

                <div class="add-introduction">

                    <h3>
                        Add Items
                    </h3>


                    <p>

                        Only Dairy records belonging to this Dairy
                        Farm, having the same
                        <strong>assetCode</strong> as the parent
                        farm's <strong>dairy.code</strong>, and
                        currently without a <strong>dwellNumber</strong>
                        are available to add.

                        Storage rooms and AgroStores are excluded.

                    </p>

                </div>


                <% if (addItemCount > 0) { %>


                    <!-- ==========================================
                         ADD MANAGEMENT
                    =========================================== -->

                    <div class="contents-management">

                        <div class="management-left">

                            <label class="select-all-wrapper">

                                <input
                                    type="checkbox"
                                    id="selectAllAddItems"
                                >

                                <span>
                                    Select All
                                </span>

                            </label>


                            <span
                                id="addSelectionCount"
                                class="selection-count"
                            >

                                0 selected

                            </span>

                        </div>


                        <div class="management-right">

                            <button
                                type="submit"
                                form="addItemsForm"
                                id="addSelectedButton"
                                class="storage-action-button add-button"
                                disabled
                            >

                                Add Selected

                            </button>

                        </div>

                    </div>


                    <!-- ==========================================
                         ADD FORM
                    =========================================== -->

                    <form
                        method="POST"
                        action="/storage/<%= dairy._id %>/contents/<%= storage._id %>/add"
                        id="addItemsForm"
                    >

                        <div class="add-list">


                            <% filteredAddItems.forEach(function(item) { %>

                                <%
                                    const addRecordIsAnimal =
                                        itemIsAnimal(item);


                                    const addRecordIsFeed =
                                        itemIsFeed(item);


                                    const addRecordIsAgroStore =
                                        itemIsAgroStore(item);
                                %>


                                <article
                                    class="add-card"
                                    data-add-card
                                    data-add-item-id="<%= item._id %>"
                                >


                                    <div class="add-checkbox">

                                        <input
                                            type="checkbox"
                                            class="add-item-checkbox"
                                            name="itemIds"
                                            value="<%= item._id %>"
                                        >

                                    </div>


                                    <div class="add-icon">

                                        <% if (addRecordIsFeed) { %>

                                            🌾

                                        <% } else if (addRecordIsAnimal) { %>

                                            🐄

                                        <% } else if (addRecordIsAgroStore) { %>

                                            🌾

                                        <% } else { %>

                                            🔧

                                        <% } %>

                                    </div>


                                    <div class="add-information">

                                        <div class="add-title">

                                            <h3>

                                                <%= item.name || "Unnamed Item" %>

                                            </h3>


                                            <span
                                                class="content-type
                                                <% if (addRecordIsFeed) { %>
                                                    feed-type
                                                <% } else if (addRecordIsAnimal) { %>
                                                    animal-type
                                                <% } else { %>
                                                    asset-type
                                                <% } %>"
                                            >

                                                <% if (addRecordIsFeed) { %>

                                                    Feed

                                                <% } else if (addRecordIsAnimal) { %>

                                                    Animal

                                                <% } else if (addRecordIsAgroStore) { %>

                                                    AgroStore

                                                <% } else { %>

                                                    Asset

                                                <% } %>

                                            </span>

                                        </div>


                                        <div class="add-meta">

                                            <span>

                                                <strong>
                                                    ID:
                                                </strong>

                                                <%= displayValue(item._id) %>

                                            </span>


                                            <span>

                                                <strong>
                                                    Code:
                                                </strong>

                                                <%= displayValue(item.code) %>

                                            </span>


                                            <span>

                                                <strong>
                                                    Asset Code:
                                                </strong>

                                                <%= displayValue(item.assetCode) %>

                                            </span>


                                            <span>

                                                <strong>
                                                    Type:
                                                </strong>

                                                <%= displayValue(item.type) %>

                                            </span>


                                            <span>

                                                <strong>
                                                    Status:
                                                </strong>

                                                <%= displayValue(item.status) %>

                                            </span>


                                            <span>

                                                <strong>
                                                    Dwell:
                                                </strong>

                                                <%= displayValue(item.dwellNumber) %>

                                            </span>


                                            <% if (
                                                item.quantity !== null &&
                                                item.quantity !== undefined
                                            ) { %>

                                                <span>

                                                    <strong>
                                                        Quantity:
                                                    </strong>

                                                    <%= Number(
                                                        item.quantity || 0
                                                    ).toLocaleString() %>

                                                    <%= item.unit || "unit" %>

                                                </span>

                                            <% } %>

                                        </div>

                                    </div>

                                </article>


                            <% }); %>


                        </div>

                    </form>


                <% } else { %>


                    <div class="empty-contents">

                        <div class="empty-icon">
                            📦
                        </div>


                        <h3>
                            No Dairy Records Available
                        </h3>


                        <p>

                            There are no eligible Dairy records
                            available to add to this storage.

                            Records must have
                            <strong>
                                assetCode = <%= displayValue(
                                    dairy && dairy.code
                                ) %>
                            </strong>,

                            must have no
                            <strong>dwellNumber</strong>, and must
                            not be a storage room or AgroStore.

                        </p>

                    </div>

                <% } %>

            </div>

        </section>

    <% } %>


</div>


<script>

document.addEventListener(
    "DOMContentLoaded",
    function(){


        /* ======================================================
           STORAGE TYPE
        ====================================================== */

        const isNormalRoom =
            <%= isNormalRoom ? "true" : "false" %>;


        const isAgroStore =
            <%= isAgroStore ? "true" : "false" %>;


        /* ======================================================
           ROOM TABS
           
           Tabs exist only when storage.type === "room".
        ====================================================== */

        if (isNormalRoom) {

            const storageTabs =
                document.querySelectorAll(
                    "[data-storage-tab]"
                );


            const storagePanels =
                document.querySelectorAll(
                    "[data-storage-panel]"
                );


            storageTabs.forEach(
                function(tab){

                    tab.addEventListener(
                        "click",
                        function(){

                            const target =
                                tab.getAttribute(
                                    "data-storage-tab"
                                );


                            storageTabs.forEach(
                                function(otherTab){

                                    otherTab.classList.toggle(
                                        "active",
                                        otherTab === tab
                                    );

                                }
                            );


                            storagePanels.forEach(
                                function(panel){

                                    panel.classList.toggle(
                                        "active",
                                        panel.getAttribute(
                                            "data-storage-panel"
                                        ) === target
                                    );

                                }
                            );

                        }
                    );

                }
            );

        }


        /* ======================================================
           AGROSTORE
           
           AgroStore does not use room-management JavaScript.
        ====================================================== */

        if (!isNormalRoom) {

            return;

        }


        /* ======================================================
           CURRENT CONTENT SELECTION
        ====================================================== */

        const selectAllContents =
            document.getElementById(
                "selectAllContents"
            );


        const contentCheckboxes =
            document.querySelectorAll(
                ".content-item-checkbox"
            );


        const contentsSelectionCount =
            document.getElementById(
                "contentsSelectionCount"
            );


        const openReshuffleButton =
            document.getElementById(
                "openReshuffleButton"
            );


        const omitButton =
            document.getElementById(
                "omitButton"
            );


        const reshufflePanel =
            document.getElementById(
                "reshufflePanel"
            );


        const destinationStorage =
            document.getElementById(
                "destinationStorage"
            );


        const reshuffleSubmitButton =
            document.getElementById(
                "reshuffleSubmitButton"
            );


        const cancelReshuffleButton =
            document.getElementById(
                "cancelReshuffleButton"
            );


        const contentsManagementForm =
            document.getElementById(
                "contentsManagementForm"
            );


        const omitForm =
            document.getElementById(
                "omitForm"
            );


        const omitInputs =
            document.getElementById(
                "omitInputs"
            );


        /* ======================================================
           GET SELECTED CURRENT ITEMS
        ====================================================== */

        function getSelectedContents(){

            return Array.from(
                document.querySelectorAll(
                    ".content-item-checkbox:checked"
                )
            );

        }


        /* ======================================================
           UPDATE CURRENT SELECTION
        ====================================================== */

        function updateContentSelection(){

            const selected =
                getSelectedContents();


            const count =
                selected.length;


            if (contentsSelectionCount) {

                contentsSelectionCount.textContent =
                    count + " selected";

            }


            if (openReshuffleButton) {

                openReshuffleButton.disabled =
                    count === 0;

            }


            if (omitButton) {

                omitButton.disabled =
                    count === 0;

            }


            document
                .querySelectorAll(
                    "[data-content-card]"
                )
                .forEach(
                    function(card){

                        const checkbox =
                            card.querySelector(
                                ".content-item-checkbox"
                            );


                        card.classList.toggle(
                            "selected",
                            Boolean(
                                checkbox &&
                                checkbox.checked
                            )
                        );

                    }
                );


            if (selectAllContents) {

                selectAllContents.checked =
                    contentCheckboxes.length > 0 &&
                    count === contentCheckboxes.length;

            }


            updateReshuffleSubmit();

        }


        /* ======================================================
           SELECT ALL CURRENT ITEMS
        ====================================================== */

        if (selectAllContents) {

            selectAllContents.addEventListener(
                "change",
                function(){

                    contentCheckboxes.forEach(
                        function(checkbox){

                            checkbox.checked =
                                selectAllContents.checked;

                        }
                    );


                    updateContentSelection();

                }
            );

        }


        /* ======================================================
           INDIVIDUAL CURRENT ITEM SELECTION
        ====================================================== */

        contentCheckboxes.forEach(
            function(checkbox){

                checkbox.addEventListener(
                    "change",
                    updateContentSelection
                );

            }
        );


        /* ======================================================
           RESHUFFLE BUTTON
        ====================================================== */

        if (openReshuffleButton) {

            openReshuffleButton.addEventListener(
                "click",
                function(){

                    if (
                        openReshuffleButton.disabled
                    ) {

                        return;

                    }


                    if (reshufflePanel) {

                        reshufflePanel.classList.add(
                            "open"
                        );

                    }


                    updateReshuffleSubmit();

                }
            );

        }


        /* ======================================================
           RESHUFFLE SUBMIT STATE
        ====================================================== */

        function updateReshuffleSubmit(){

            if (!reshuffleSubmitButton) {

                return;

            }


            const selected =
                getSelectedContents();


            const destination =
                destinationStorage
                    ? destinationStorage.value
                    : "";


            reshuffleSubmitButton.disabled =
                selected.length === 0 ||
                !destination;

        }


        /* ======================================================
           DESTINATION CHANGE
        ====================================================== */

        if (destinationStorage) {

            destinationStorage.addEventListener(
                "change",
                updateReshuffleSubmit
            );

        }


        /* ======================================================
           CANCEL RESHUFFLE
        ====================================================== */

        if (cancelReshuffleButton) {

            cancelReshuffleButton.addEventListener(
                "click",
                function(){

                    if (reshufflePanel) {

                        reshufflePanel.classList.remove(
                            "open"
                        );

                    }


                    if (destinationStorage) {

                        destinationStorage.value =
                            "";

                    }


                    updateReshuffleSubmit();

                }
            );

        }


        /* ======================================================
           RESHUFFLE SUBMIT VALIDATION
        ====================================================== */

        if (contentsManagementForm) {

            contentsManagementForm.addEventListener(
                "submit",
                function(event){

                    const selected =
                        getSelectedContents();


                    if (
                        selected.length === 0
                    ) {

                        event.preventDefault();

                        return;

                    }


                    if (
                        !destinationStorage ||
                        !destinationStorage.value
                    ) {

                        event.preventDefault();

                        return;

                    }

                }
            );

        }


        /* ======================================================
           OMIT
        ====================================================== */

        if (omitButton) {

            omitButton.addEventListener(
                "click",
                function(){

                    const selected =
                        getSelectedContents();


                    if (
                        selected.length === 0
                    ) {

                        return;

                    }


                    if (
                        !omitForm ||
                        !omitInputs
                    ) {

                        return;

                    }


                    omitInputs.innerHTML =
                        "";


                    selected.forEach(
                        function(checkbox){

                            const input =
                                document.createElement(
                                    "input"
                                );


                            input.type =
                                "hidden";


                            input.name =
                                "itemIds";


                            input.value =
                                checkbox.value;


                            omitInputs.appendChild(
                                input
                            );

                        }
                    );


                    omitForm.submit();

                }
            );

        }


        /* ======================================================
           ADD ITEMS SELECTION
        ====================================================== */

        const selectAllAddItems =
            document.getElementById(
                "selectAllAddItems"
            );


        const addCheckboxes =
            document.querySelectorAll(
                ".add-item-checkbox"
            );


        const addSelectionCount =
            document.getElementById(
                "addSelectionCount"
            );


        const addSelectedButton =
            document.getElementById(
                "addSelectedButton"
            );


        /* ======================================================
           GET SELECTED ADD ITEMS
        ====================================================== */

        function getSelectedAddItems(){

            return Array.from(
                document.querySelectorAll(
                    ".add-item-checkbox:checked"
                )
            );

        }


        /* ======================================================
           UPDATE ADD SELECTION
        ====================================================== */

        function updateAddSelection(){

            const selected =
                getSelectedAddItems();


            const count =
                selected.length;


            if (addSelectionCount) {

                addSelectionCount.textContent =
                    count + " selected";

            }


            if (addSelectedButton) {

                addSelectedButton.disabled =
                    count === 0;

            }


            document
                .querySelectorAll(
                    "[data-add-card]"
                )
                .forEach(
                    function(card){

                        const checkbox =
                            card.querySelector(
                                ".add-item-checkbox"
                            );


                        card.classList.toggle(
                            "selected",
                            Boolean(
                                checkbox &&
                                checkbox.checked
                            )
                        );

                    }
                );


            if (selectAllAddItems) {

                selectAllAddItems.checked =
                    addCheckboxes.length > 0 &&
                    count === addCheckboxes.length;

            }

        }


        /* ======================================================
           SELECT ALL ADD ITEMS
        ====================================================== */

        if (selectAllAddItems) {

            selectAllAddItems.addEventListener(
                "change",
                function(){

                    addCheckboxes.forEach(
                        function(checkbox){

                            checkbox.checked =
                                selectAllAddItems.checked;

                        }
                    );


                    updateAddSelection();

                }
            );

        }


        /* ======================================================
           INDIVIDUAL ADD ITEM SELECTION
        ====================================================== */

        addCheckboxes.forEach(
            function(checkbox){

                checkbox.addEventListener(
                    "change",
                    updateAddSelection
                );

            }
        );


        /* ======================================================
           INITIAL STATE
        ====================================================== */

        updateContentSelection();

        updateReshuffleSubmit();

        updateAddSelection();

    }
);

</script>