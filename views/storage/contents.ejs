<%
/*
==============================================================
STORAGE CONTENTS
==============================================================

FILE:
    views/storage/contents.ejs

PURPOSE:
    Display the contents of a storage location.

SUPPORTED STORAGE TYPES:

    room
        • Current contents
        • Storage tabs
        • Select contents
        • Omit selected
        • Reshuffle selected
        • Add eligible Dairy records
        • Add Item button

    agroStore
        • Current contents
        • Add Item button
        • No room-management tabs
        • No selection
        • No reshuffle
        • No omit
        • No inline Add Items management section
        • Display Dairy animals whose dwellNumber matches
          this AgroStore's roomNumber

IMPORTANT DATABASE VALUES:

    "room"
    "agroStore"

DO NOT change "agroStore" to "agrostore".
==============================================================
*/


/* ============================================================
   STORAGE TYPE
============================================================ */

const storageType =
    storage &&
    storage.type
        ? String(storage.type).trim()
        : "";


const isNormalRoom =
    storageType === "room";


const isAgroStore =
    storageType === "agroStore";


/* ============================================================
   STORAGE NAME
============================================================ */

const storageName =
    (
        storage &&
        storage.displayName
    )
        ||
    (
        storage &&
        storage.name
    )
        ||
    (
        isAgroStore
            ? "AgroStore"
            : "Room " +
                (
                    storage &&
                    storage.roomNumber !== null &&
                    storage.roomNumber !== undefined
                        ? storage.roomNumber
                        : "—"
                )
    );


/* ============================================================
   STORAGE ROOM NUMBER
============================================================ */

const storageRoomNumber =
    (
        storage &&
        storage.roomNumber !== null &&
        storage.roomNumber !== undefined
    )
        ? storage.roomNumber
        : "—";


/* ============================================================
   SAFE DATA ARRAYS
============================================================ */

const suppliedItems =
    Array.isArray(items)
        ? items
        : [];


const availableAddItems =
    Array.isArray(availableItems)
        ? availableItems
        : [];


const storageTargets =
    Array.isArray(targetStorages)
        ? targetStorages
        : [];


/* ============================================================
   HELPERS
============================================================ */

function displayValue(value) {

    return (
        value !== null &&
        value !== undefined &&
        String(value).trim() !== ""
    )
        ? value
        : "—";

}


/* ============================================================
   DISPLAY STORAGE NAME
============================================================ */

function displayStorageName(item) {

    if (
        item &&
        item.displayName
    ) {

        return item.displayName;

    }


    if (
        item &&
        item.name
    ) {

        return item.name;

    }


    if (
        item &&
        item.roomNumber !== null &&
        item.roomNumber !== undefined
    ) {

        return "Room " + item.roomNumber;

    }


    if (
        item &&
        item.type === "agroStore"
    ) {

        return "AgroStore";

    }


    return "Storage";

}


/* ============================================================
   FEED CLASSIFICATION
============================================================ */

function itemIsFeed(item) {

    if (!item) {

        return false;

    }


    return (
        String(item.type || "").trim() === "feeds"
    );

}


/* ============================================================
   ANIMAL CLASSIFICATION
============================================================ */

function itemIsAnimal(item) {

    if (!item) {

        return false;

    }


    const code =
        Number(item.code);


    return (
        item.code !== null &&
        item.code !== undefined &&
        !Number.isNaN(code) &&
        code > 0
    );

}


/* ============================================================
   AGROSTORE CLASSIFICATION
============================================================ */

function itemIsAgroStore(item) {

    if (!item) {

        return false;

    }


    return (
        String(item.type || "").trim() === "agroStore"
    );

}


/* ============================================================
   EMPTY DWELL NUMBER
============================================================ */

function hasEmptyDwellNumber(item) {

    if (!item) {

        return true;

    }


    return (
        item.dwellNumber === null ||
        item.dwellNumber === undefined ||
        String(item.dwellNumber).trim() === ""
    );

}


/* ============================================================
   STORAGE RECORD CHECK
============================================================ */

function isStorageRecord(item) {

    if (!item) {

        return false;

    }


    const recordType =
        String(item.recordType || "").trim();


    const type =
        String(item.type || "").trim();


    if (
        recordType === "structure"
    ) {

        return true;

    }


    if (
        type === "room"
    ) {

        return true;

    }


    if (
        type === "agroStore"
    ) {

        return true;

    }


    return false;

}


/* ============================================================
   AGROSTORE DWELL MATCH
============================================================ */

function agroStoreDwellMatches(item) {

    if (!item) {

        return false;

    }


    if (!itemIsAnimal(item)) {

        return false;

    }


    if (
        storageRoomNumber === null ||
        storageRoomNumber === undefined ||
        String(storageRoomNumber).trim() === "" ||
        String(storageRoomNumber).trim() === "—"
    ) {

        return false;

    }


    if (
        item.dwellNumber === null ||
        item.dwellNumber === undefined ||
        String(item.dwellNumber).trim() === ""
    ) {

        return false;

    }


    return (
        String(item.dwellNumber).trim() ===
        String(storageRoomNumber).trim()
    );

}


/* ============================================================
   CURRENT CONTENTS
============================================================ */

const currentItems =
    isAgroStore
        ? suppliedItems.filter(
            function(item) {

                return agroStoreDwellMatches(item);

            }
        )
        : suppliedItems;


/* ============================================================
   ADD ITEM ELIGIBILITY
============================================================ */

function canBeAddedToStorage(item) {

    if (!isNormalRoom) {

        return false;

    }


    if (!item) {

        return false;

    }


    if (
        !dairy ||
        dairy.code === null ||
        dairy.code === undefined
    ) {

        return false;

    }


    if (
        String(item.assetCode) !==
        String(dairy.code)
    ) {

        return false;

    }


    if (
        !hasEmptyDwellNumber(item)
    ) {

        return false;

    }


    if (
        isStorageRecord(item)
    ) {

        return false;

    }


    return true;

}


/* ============================================================
   FILTERED ADD ITEMS
============================================================ */

const filteredAddItems =
    isNormalRoom
        ? availableAddItems.filter(
            function(item) {

                return canBeAddedToStorage(item);

            }
        )
        : [];


/* ============================================================
   COUNTS
============================================================ */

const currentItemCount =
    currentItems.length;


const addItemCount =
    filteredAddItems.length;

%>


