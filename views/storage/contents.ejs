/*
==============================================================
STORAGE CONTENTS
==============================================================

FILE:
    views/storage/contents.ejs

PURPOSE:
    Main contents-management page for:

        1. Normal Storage Rooms
        2. AgroStore

URL CONTRACT:
    /storage/:dairyId/contents/:itemId

URL IDENTIFIERS:
    :dairyId
        = parent Dairy Farm MongoDB _id

    :itemId
        = storage Dairy MongoDB _id

IMPORTANT STORAGE LOGIC
==============================================================

PARENT FARM:

    dairy._id
        = first ID in URL

    dairy.code
        = authoritative farm relationship code

STORAGE:

    storage._id
        = second ID in URL

    storage.recordType === "structure"

    storage.type
        = "room"
        OR
        = "agroStore"

CONTENT LOCATION:

    item.dwellNumber === storage.roomNumber

FARM OWNERSHIP:

    item.assetCode === dairy.code

ADD ITEMS:

    ONLY Dairy records where:

        item.assetCode === dairy.code

    AND:

        item.dwellNumber is empty

    AND:

        item is NOT a storage structure

    AND:

        item.type !== "room"

    AND:

        item.type !== "agroStore"

OMIT:

    selected item.dwellNumber = null

RESHUFFLE:

    selected item.dwellNumber =
        destinationStorage.roomNumber

RESHUFFLE TARGETS:

    destinationStorage.type === storage.type

    Therefore:

        room
            → room

        agroStore
            → agroStore

==============================================================
*/


/* ============================================================
   STORAGE TYPE
============================================================ */

const storageType = String(
    storage && storage.type
        ? storage.type
        : ""
)
.trim()
.toLowerCase();


const isAgroStore =
    storageType === "agrostore";


const isNormalRoom =
    storageType === "room";


/* ============================================================
   STORAGE NAME
============================================================ */

const storageName =
    (
        storage &&
        storage.displayName
    )
        ||
    (
        storage &&
        storage.name
    )
        ||
    (
        isAgroStore
            ? "AgroStore"
            : "Room " +
                (
                    storage &&
                    (
                        storage.roomNumber !== null &&
                        storage.roomNumber !== undefined
                    )
                        ? storage.roomNumber
                        : "—"
                )
    );


/* ============================================================
   STORAGE ROOM NUMBER
============================================================ */

const storageRoomNumber =
    (
        storage &&
        storage.roomNumber !== null &&
        storage.roomNumber !== undefined
    )
        ? storage.roomNumber
        : "—";


/* ============================================================
   CURRENT TAB
============================================================ */

const currentTab =
    activeTab === "add"
        ? "add"
        : "view";


/* ============================================================
   SAFE DATA ARRAYS
============================================================ */

const currentItems =
    Array.isArray(items)
        ? items
        : [];


const addItems =
    Array.isArray(availableItems)
        ? availableItems
        : [];


const storageTargets =
    Array.isArray(targetStorages)
        ? targetStorages
        : [];


/* ============================================================
   HELPERS
============================================================ */

function displayValue(value) {

    return (
        value !== null &&
        value !== undefined &&
        String(value).trim() !== ""
    )
        ? value
        : "—";

}


/* ============================================================
   STORAGE DISPLAY NAME
============================================================ */

function displayStorageName(item) {

    if (
        item &&
        item.displayName
    ) {

        return item.displayName;

    }


    if (
        item &&
        item.name
    ) {

        return item.name;

    }


    if (
        item &&
        item.roomNumber !== null &&
        item.roomNumber !== undefined
    ) {

        return "Room " + item.roomNumber;

    }


    return "Storage";

}


/* ============================================================
   FEED CLASSIFICATION
============================================================ */

function itemIsFeed(item) {

    return (

        item &&

        String(
            item.type || ""
        )
        .trim()
        .toLowerCase() === "feeds"

    );

}


/* ============================================================
   ANIMAL CLASSIFICATION
============================================================ */

/*
IMPORTANT:

Do NOT name a local variable itemIsAnimal.

The helper itself is called itemIsAnimal().
*/

function itemIsAnimal(item) {

    /*
    ----------------------------------------------------------
    Display classification only.

    Storage allocation is NOT determined from code.

    A positive code is simply rendered as an animal-style
    record for presentation where applicable.
    ----------------------------------------------------------
    */

    if (!item) {

        return false;

    }


    const code =
        Number(
            item.code
        );


    return (

        item.code !== null &&
        item.code !== undefined &&
        !Number.isNaN(code) &&
        code > 0

    );

}


/* ============================================================
   EMPTY DWELL NUMBER CHECK
============================================================ */

function hasEmptyDwellNumber(item) {

    if (!item) {

        return true;

    }


    return (

        item.dwellNumber === null ||

        item.dwellNumber === undefined ||

        String(
            item.dwellNumber
        ).trim() === ""

    );

}


/* ============================================================
   STORAGE RECORD CHECK
============================================================ */

function isStorageRecord(item) {

    if (!item) {

        return false;

    }


    const recordType =
        String(
            item.recordType || ""
        )
        .trim()
        .toLowerCase();


    const type =
        String(
            item.type || ""
        )
        .trim()
        .toLowerCase();


    /*
    ----------------------------------------------------------
    A structure record is a storage/facility record.
    ----------------------------------------------------------
    */

    if (
        recordType === "structure"
    ) {

        return true;

    }


    /*
    ----------------------------------------------------------
    Explicitly exclude room and AgroStore types.
    ----------------------------------------------------------
    */

    if (
        type === "room" ||
        type === "agrostore"
    ) {

        return true;

    }


    return false;

}


/* ============================================================
   ADD ITEM ELIGIBILITY
============================================================ */

/*
Only records satisfying ALL conditions are displayed in
the Add Items tab:

    1. assetCode === parent farm dairy.code
    2. dwellNumber is empty
    3. not a storage structure
    4. not a room
    5. not an AgroStore
*/

function canBeAddedToStorage(item) {

    if (!item) {

        return false;

    }


    /*
    ----------------------------------------------------------
    PARENT FARM OWNERSHIP
    ----------------------------------------------------------
    */

    if (
        dairy &&
        dairy.code !== null &&
        dairy.code !== undefined
    ) {

        if (
            String(item.assetCode) !==
            String(dairy.code)
        ) {

            return false;

        }

    } else {

        return false;

    }


    /*
    ----------------------------------------------------------
    MUST NOT ALREADY HAVE A DWELL NUMBER
    ----------------------------------------------------------
    */

    if (
        !hasEmptyDwellNumber(item)
    ) {

        return false;

    }


    /*
    ----------------------------------------------------------
    MUST NOT BE A STORAGE RECORD
    ----------------------------------------------------------
    */

    if (
        isStorageRecord(item)
    ) {

        return false;

    }


    return true;

}


/* ============================================================
   FILTERED ADD ITEMS
============================================================ */

/*
Do not rely solely on the controller/service to filter this.

The EJS view enforces the display rule as well.

This prevents rooms and AgroStores from appearing in the
Add Items tab even if they accidentally arrive inside
availableItems.
*/

const filteredAddItems =
    addItems.filter(
        function(item) {

            return canBeAddedToStorage(item);

        }
    );


/* ============================================================
   COUNTS
============================================================ */

const currentItemCount =
    currentItems.length;


const addItemCount =
    filteredAddItems.length;

