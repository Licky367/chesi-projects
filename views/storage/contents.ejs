<style>

/* ==========================================================
   STORAGE CONTENTS PAGE
   ========================================================== */

.storage-contents-page {

    max-width: 1200px;

    margin: 0 auto;

    padding: 20px;

    color: #26332a;

}


/* ==========================================================
   HEADER
   ========================================================== */

.contents-header {

    margin-bottom: 22px;

}


.contents-header-top {

    display: flex;

    align-items: flex-start;

    justify-content: space-between;

    gap: 15px;

}


.contents-header h2 {

    margin: 0;

    color: #0b5d1e;

    font-size: 26px;

    font-weight: 700;

}


.contents-subtitle {

    margin: 6px 0 0;

    color: #66736a;

    font-size: 14px;

    line-height: 1.5;

}


/* ==========================================================
   BACK BUTTON
   ========================================================== */

.back-storage {

    display: inline-flex;

    align-items: center;

    justify-content: center;

    padding: 9px 14px;

    border: 1px solid #b8cfbd;

    border-radius: 8px;

    background: #f4faf5;

    color: #0b5d1e;

    text-decoration: none;

    font-size: 13px;

    font-weight: 600;

    white-space: nowrap;

}


.back-storage:hover {

    background: #e6f3e9;

}


/* ==========================================================
   STORAGE REFERENCE
   ========================================================== */

.storage-reference {

    display: flex;

    flex-wrap: wrap;

    gap: 9px;

    margin-top: 14px;

}


.reference-item {

    display: inline-flex;

    align-items: center;

    gap: 6px;

    padding: 7px 11px;

    background: #eaf5ed;

    border: 1px solid #cfe3d3;

    border-radius: 8px;

    color: #0b5d1e;

    font-size: 13px;

    font-weight: 600;

}


.reference-label {

    color: #6b796f;

    font-weight: 500;

}


/* ==========================================================
   SUMMARY
   ========================================================== */

.contents-summary {

    display: flex;

    align-items: center;

    margin: 16px 0;

    color: #637068;

    font-size: 14px;

}


.contents-summary strong {

    color: #0b5d1e;

    font-size: 20px;

    margin-right: 4px;

}


/* ==========================================================
   CONTENT LIST
   ========================================================== */

.contents-list {

    display: grid;

    grid-template-columns:
        repeat(
            auto-fit,
            minmax(320px, 1fr)
        );

    gap: 16px;

}


/* ==========================================================
   CONTENT CARD
   ========================================================== */

.content-card {

    display: flex;

    gap: 15px;

    background: #ffffff;

    border: 1px solid #dce9df;

    border-radius: 14px;

    padding: 18px;

    box-shadow:
        0 5px 16px rgba(11, 93, 30, 0.06);

    transition:
        transform 0.2s ease,
        box-shadow 0.2s ease,
        border-color 0.2s ease;

}


.content-card:hover {

    transform: translateY(-2px);

    border-color: #a9c9b0;

    box-shadow:
        0 8px 22px rgba(11, 93, 30, 0.10);

}


/* ==========================================================
   ICON
   ========================================================== */

.content-icon {

    width: 52px;

    height: 52px;

    min-width: 52px;

    display: flex;

    align-items: center;

    justify-content: center;

    border-radius: 12px;

    background: #eaf5ed;

    border: 1px solid #cfe3d3;

    font-size: 25px;

}


/* ==========================================================
   INFORMATION
   ========================================================== */

.content-information {

    flex: 1;

    min-width: 0;

}


/* ==========================================================
   TITLE ROW
   ========================================================== */

.content-title-row {

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 10px;

    margin-bottom: 14px;

}


.content-title-row h3 {

    margin: 0;

    color: #0b5d1e;

    font-size: 18px;

    font-weight: 700;

    word-break: break-word;

}


/* ==========================================================
   TYPE BADGE
   ========================================================== */

.content-type {

    display: inline-flex;

    align-items: center;

    justify-content: center;

    padding: 5px 9px;

    border-radius: 20px;

    font-size: 11px;

    font-weight: 700;

    white-space: nowrap;

}


.animal-type {

    background: #e8f4eb;

    color: #0b5d1e;

}


.asset-type {

    background: #edf5df;

    color: #4b6716;

}


/* ==========================================================
   DETAILS
   ========================================================== */

.content-details {

    display: grid;

    grid-template-columns:
        repeat(
            3,
            1fr
        );

    gap: 10px;

}


.content-detail {

    display: flex;

    flex-direction: column;

    gap: 3px;

    padding: 9px;

    background: #f7faf8;

    border-radius: 8px;

}


.detail-label {

    color: #7a877e;

    font-size: 11px;

    font-weight: 600;

    text-transform: uppercase;

}


.detail-value {

    color: #26332a;

    font-size: 14px;

    font-weight: 600;

}


.status-active {

    color: #0b5d1e;

}


.status-inactive {

    color: #9a5b00;

}


/* ==========================================================
   DESCRIPTION
   ========================================================== */

.content-description {

    margin: 13px 0 0;

    padding-top: 11px;

    border-top: 1px solid #e5eee7;

    color: #66736a;

    font-size: 13px;

    line-height: 1.5;

}


/* ==========================================================
   EMPTY STATE
   ========================================================== */

.empty-contents {

    background: #ffffff;

    border: 1px dashed #b9cfbd;

    border-radius: 14px;

    padding: 45px 20px;

    text-align: center;

    box-shadow:
        0 4px 14px rgba(11, 93, 30, 0.04);

}


.empty-contents-icon {

    width: 64px;

    height: 64px;

    margin: 0 auto 15px;

    display: flex;

    align-items: center;

    justify-content: center;

    border-radius: 50%;

    background: #eaf5ed;

    font-size: 28px;

}


.empty-contents h3 {

    margin: 0 0 8px;

    color: #0b5d1e;

    font-size: 20px;

}


.empty-contents p {

    margin: 0;

    color: #718078;

    font-size: 14px;

}


/* ==========================================================
   RESPONSIVE
   ========================================================== */

@media (max-width: 700px) {

    .storage-contents-page {

        padding: 15px;

    }


    .contents-header-top {

        flex-direction: column;

    }


    .contents-header h2 {

        font-size: 23px;

    }


    .back-storage {

        width: 100%;

    }


    .contents-list {

        grid-template-columns: 1fr;

    }


    .content-card {

        padding: 15px;

    }


    .content-title-row {

        align-items: flex-start;

        flex-direction: column;

    }


    .content-details {

        grid-template-columns: 1fr;

    }

}


/* ==========================================================
   VERY SMALL SCREENS
   ========================================================== */

@media (max-width: 400px) {

    .content-card {

        gap: 11px;

    }


    .content-icon {

        width: 44px;

        height: 44px;

        min-width: 44px;

        font-size: 21px;

    }


    .content-title-row h3 {

        font-size: 16px;

    }

}

</style>


<div class="page storage-contents-page">


    <!-- ==================================================
         HEADER
         ================================================== -->

    <div class="contents-header">

        <div class="contents-header-top">

            <div>

                <h2>

                    <%= storage.displayName %>

                </h2>


                <p class="contents-subtitle">

                    Items currently allocated to this
                    storage facility.

                </p>

            </div>


            <a
                href="/storage/<%= dairy._id %>"
                class="back-storage"
            >

                ← Back to Storage

            </a>

        </div>


        <!-- ==================================================
             REFERENCES
             ================================================== -->

        <div class="storage-reference">


            <div class="reference-item">

                <span class="reference-label">
                    Farm
                </span>

                <span>
                    <%= dairy.name %>
                </span>

            </div>


            <div class="reference-item">

                <span class="reference-label">
                    Farm Code
                </span>

                <span>
                    <%= dairy.code %>
                </span>

            </div>


            <div class="reference-item">

                <span class="reference-label">

                    <%= storage.isAgroStore
                        ? "AgroStore Number"
                        : "Room Number"
                    %>

                </span>

                <span>

                    <%= storage.isAgroStore
                        ? Math.abs(storage.roomNumber)
                        : storage.roomNumber
                    %>

                </span>

            </div>


            <div class="reference-item">

                <span class="reference-label">
                    Allocation
                </span>

                <span>
                    dwellNumber = <%= storage.roomNumber %>
                </span>

            </div>


        </div>

    </div>


    <!-- ==================================================
         SUMMARY
         ================================================== -->

    <div class="contents-summary">

        <span>

            <strong>
                <%= itemCount %>
            </strong>

            <%= itemCount === 1
                ? "item"
                : "items"
            %>

        </span>

    </div>


    <!-- ==================================================
         CONTENT LIST
         ================================================== -->

    <% if (items && items.length > 0) { %>


        <div class="contents-list">


            <% items.forEach(function (item) { %>


                <div class="content-card">


                    <!-- ======================================
                         ICON
                         ====================================== -->

                    <div class="content-icon">

                        <% if (item.code !== null &&
                               item.code !== undefined &&
                               Number(item.code) > 0) { %>

                            🐄

                        <% } else { %>

                            🔧

                        <% } %>

                    </div>


                    <!-- ======================================
                         INFORMATION
                         ====================================== -->

                    <div class="content-information">


                        <!-- ==================================
                             TITLE
                             ================================== -->

                        <div class="content-title-row">

                            <h3>

                                <%= item.name %>

                            </h3>


                            <span
                                class="content-type <%= (
                                    item.code !== null &&
                                    item.code !== undefined &&
                                    Number(item.code) > 0
                                )
                                    ? "animal-type"
                                    : "asset-type"
                                %>"
                            >

                                <%= (
                                    item.code !== null &&
                                    item.code !== undefined &&
                                    Number(item.code) > 0
                                )
                                    ? "Animal"
                                    : "Asset"
                                %>

                            </span>

                        </div>


                        <!-- ==================================
                             DETAILS
                             ================================== -->

                        <div class="content-details">


                            <!-- ==================================
                                 CODE / ID
                                 ================================== -->

                            <div class="content-detail">

                                <span class="detail-label">

                                    <%= (
                                        item.code !== null &&
                                        item.code !== undefined &&
                                        Number(item.code) > 0
                                    )
                                        ? "Animal Code"
                                        : "Asset"
                                    %>

                                </span>

                                <span class="detail-value">

                                    <%= (
                                        item.code !== null &&
                                        item.code !== undefined
                                    )
                                        ? item.code
                                        : "—"
                                    %>

                                </span>

                            </div>


                            <!-- ==================================
                                 TYPE
                                 ================================== -->

                            <div class="content-detail">

                                <span class="detail-label">

                                    <%= (
                                        item.code !== null &&
                                        item.code !== undefined &&
                                        Number(item.code) > 0
                                    )
                                        ? "Breed"
                                        : "Type"
                                    %>

                                </span>

                                <span class="detail-value">

                                    <%= item.type || "—" %>

                                </span>

                            </div>


                            <!-- ==================================
                                 STATUS
                                 ================================== -->

                            <div class="content-detail">

                                <span class="detail-label">
                                    Status
                                </span>

                                <span
                                    class="detail-value <%= item.status === "active"
                                        ? "status-active"
                                        : "status-inactive"
                                    %>"
                                >

                                    <%= item.status === "active"
                                        ? "Active"
                                        : item.status
                                    %>

                                </span>

                            </div>


                            <!-- ==================================
                                 DWELL NUMBER
                                 ================================== -->

                            <div class="content-detail">

                                <span class="detail-label">
                                    Dwell Number
                                </span>

                                <span class="detail-value">

                                    <%= item.dwellNumber %>

                                </span>

                            </div>


                            <!-- ==================================
                                 CONDITION
                                 ================================== -->

                            <div class="content-detail">

                                <span class="detail-label">
                                    Condition
                                </span>

                                <span class="detail-value">

                                    <%= item.condition || "—" %>

                                </span>

                            </div>


                            <!-- ==================================
                                 VALUE
                                 ================================== -->

                            <div class="content-detail">

                                <span class="detail-label">
                                    Current Worth
                                </span>

                                <span class="detail-value">

                                    <%= Number(
                                        item.currentWorth || 0
                                    ).toLocaleString() %>

                                </span>

                            </div>


                        </div>


                        <!-- ==================================
                             ANIMAL INFORMATION
                             ================================== -->

                        <% if (
                            item.code !== null &&
                            item.code !== undefined &&
                            Number(item.code) > 0
                        ) { %>

                            <p class="content-description">

                                <strong>
                                    Gender:
                                </strong>

                                <%= item.gender || "—" %>


                                &nbsp; • &nbsp;


                                <strong>
                                    Age:
                                </strong>

                                <%= item.ageText || "—" %>


                                &nbsp; • &nbsp;


                                <strong>
                                    Milking:
                                </strong>

                                <%= item.isMilking
                                    ? "Yes"
                                    : "No"
                                %>

                            </p>

                        <% } %>


                        <!-- ==================================
                             DESCRIPTION
                             ================================== -->

                        <% if (item.description) { %>

                            <p class="content-description">

                                <%= item.description %>

                            </p>

                        <% } %>


                    </div>

                </div>


            <% }); %>


        </div>


    <% } else { %>


        <!-- ==================================================
             EMPTY STATE
             ================================================== -->

        <div class="empty-contents">


            <div class="empty-contents-icon">

                <%= storage.isAgroStore
                    ? "🏪"
                    : "🏠"
                %>

            </div>


            <h3>

                No Items Found

            </h3>


            <p>

                There are currently no items allocated to
                <strong>
                    <%= storage.displayName %>
                </strong>.

            </p>


        </div>

    <% } %>


</div>