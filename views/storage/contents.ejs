    }

    .storage-tabs{
        gap:3px;
    }

    .storage-tab{
        padding:0 7px;
    }

    .management-right{
        grid-template-columns:1fr;
    }

    .content-meta{
        display:grid;
        grid-template-columns:1fr 1fr;
        gap:6px;
    }

}
</style>


<div class="storage-contents-page">


    <!-- ========================================================
         HEADER
    ========================================================= -->

    <header class="storage-page-header">

        <div class="storage-header-main">

            <p class="storage-header-eyebrow">

                <% if (isAgroStore) { %>
                    AgroStore
                <% } else { %>
                    Storage Room
                <% } %>

            </p>


            <h1 class="storage-page-title">
                <%= storageName %>
            </h1>


            <p class="storage-page-description">

                <% if (isAgroStore) { %>

                    Dairy records with
                    <strong>
                        dwellNumber = <%= displayValue(storageRoomNumber) %>
                    </strong>
                    and available quantity are displayed here.

                <% } else { %>

                    Dairy records currently assigned to this room.

                <% } %>

            </p>

        </div>


        <div class="storage-header-actions">

            <% if (isAdmin) { %>

                <a
                    href="/storage/<%= dairy._id %>/contents/<%= storage._id %>/add/<%= storageType %>"
                    class="add-storage-item-button"
                >
                    + Add Item
                </a>

            <% } %>

        </div>

    </header>


    <!-- ========================================================
         MESSAGES
    ========================================================= -->

    <% if (successMessage) { %>

        <div class="storage-message storage-success">

            <span>✓</span>

            <span>
                <%= successMessage %>
            </span>

        </div>

    <% } %>


    <% if (pageError) { %>

        <div class="storage-message storage-error">

            <span>!</span>

            <span>
                <%= pageError %>
            </span>

        </div>

    <% } %>


    <!-- ========================================================
         ROOM TABS
    ========================================================= -->

    <% if (isNormalRoom) { %>

        <nav
            class="storage-tabs"
            aria-label="Storage sections"
        >

            <button
                type="button"
                class="storage-tab active"
                data-storage-tab="contents"
            >
                Current Contents
            </button>


            <% if (isAdmin) { %>

                <button
                    type="button"
                    class="storage-tab"
                    data-storage-tab="add-items"
                >
                    Add Items
                </button>

            <% } %>

        </nav>

    <% } %>


    <!-- ========================================================
         CURRENT CONTENTS
    ========================================================= -->

    <section
        class="<% if (isNormalRoom) { %>storage-tab-panel active<% } %>"
        <% if (isNormalRoom) { %>
            data-storage-panel="contents"
        <% } %>
    >

        <div class="contents-topbar">

            <h2 class="contents-heading">

                <% if (isAgroStore) { %>
                    Dairy in AgroStore
                <% } else { %>
                    Current Contents
                <% } %>

            </h2>


            <div class="contents-count">

                <strong>
                    <%= currentItemCount %>
                </strong>

                <% if (currentItemCount === 1) { %>
                    item
                <% } else { %>
                    items
                <% } %>

            </div>

        </div>


        <% if (currentItemCount > 0) { %>


            <% if (isNormalRoom) { %>

                <form
                    id="contentsManagementForm"
                    method="POST"
                    action="/storage/<%= dairy._id %>/contents/<%= storage._id %>/reshuffle"
                >

                    <div class="contents-management">

                        <div class="management-left">

                            <label class="select-all-wrapper">

                                <input
                                    type="checkbox"
                                    id="selectAllContents"
                                >

                                <span>
                                    Select All
                                </span>

                            </label>


                            <span
                                id="contentsSelectionCount"
                                class="selection-count"
                            >
                                0 selected
                            </span>

                        </div>


                        <div class="management-right">

                            <button
                                type="button"
                                id="openReshuffleButton"
                                class="storage-action-button reshuffle-button"
                                disabled
                            >
                                Reshuffle
                            </button>


                            <button
                                type="button"
                                id="omitButton"
                                class="storage-action-button omit-button"
                                disabled
                            >
                                Omit Selected
                            </button>

                        </div>

                    </div>


                    <div
                        id="reshufflePanel"
                        class="reshuffle-panel"
                    >

                        <h3 class="reshuffle-heading">
                            Reshuffle Selected Items
                        </h3>


                        <p class="reshuffle-description">

                            Select another compatible storage
                            facility. The selected records will be
                            moved to the destination storage.

                        </p>


                        <div class="reshuffle-form">

                            <div class="reshuffle-select-group">

                                <label for="destinationStorage">
                                    Destination
                                </label>


                                <select
                                    id="destinationStorage"
                                    name="targetStorageId"
                                    class="reshuffle-select"
                                >

                                    <option value="">
                                        Select destination...
                                    </option>


                                    <% if (storageTargets.length > 0) { %>

                                        <% storageTargets.forEach(function(destination) { %>

                                            <option
                                                value="<%= destination._id %>"
                                            >

                                                <%= displayStorageName(destination) %>

                                                <% if (
                                                    destination.roomNumber !== null &&
                                                    destination.roomNumber !== undefined
                                                ) { %>

                                                    — <%= destination.roomNumber %>

                                                <% } %>

                                            </option>

                                        <% }); %>

                                    <% } else { %>

                                        <option
                                            value=""
                                            disabled
                                        >
                                            No other compatible storage available
                                        </option>

                                    <% } %>

                                </select>

                            </div>


                            <button
                                type="submit"
                                id="reshuffleSubmitButton"
                                class="storage-action-button add-button"
                                disabled
                            >
                                Reshuffle Selected
                            </button>


                            <button
                                type="button"
                                id="cancelReshuffleButton"
                                class="storage-action-button omit-button"
                            >
                                Cancel
                            </button>

                        </div>

                    </div>

            <% } %>


            <!-- ==================================================
                 CONTENT LIST
            ================================================== -->

            <div class="contents-list">

                <% currentItems.forEach(function(item) { %>

                    <%
                        const currentItemIsAnimal =
                            itemIsAnimal(item);

                        const currentItemIsFeed =
                            itemIsFeed(item);

                        const currentItemIsAgroStore =
                            itemIsAgroStore(item);


                        const currentItemUrl =
                            isAgroStore
                                ? "/storage/" +
                                  dairy._id +
                                  "/contents/" +
                                  storage._id +
                                  "/details/" +
                                  item._id
                                : "/dairy/" +
                                  item._id;
                    %>


                    <article
                        class="content-card
                            <% if (isAgroStore) { %>
                                no-selection
                            <% } %>
                            clickable-content"
                        data-content-card
                        data-item-id="<%= item._id %>"
                        data-item-url="<%= currentItemUrl %>"
                    >


                        <% if (isNormalRoom) { %>

                            <div class="content-checkbox">

                                <input
                                    type="checkbox"
                                    class="content-item-checkbox"
                                    name="itemIds"
                                    value="<%= item._id %>"
                                >

                            </div>

                        <% } %>


                        <div class="content-icon">

                            <% if (item.profileImage) { %>

                                <img
                                    src="<%= item.profileImage %>"
                                    alt="<%= item.name || 'Dairy' %>"
                                    style="width:100%;height:100%;object-fit:cover;border-radius:inherit;"
                                >

                            <% } else if (currentItemIsFeed) { %>

                                🌾

                            <% } else if (currentItemIsAnimal) { %>

                                🐄

                            <% } else if (currentItemIsAgroStore) { %>

                                🌾

                            <% } else { %>

                                📦

                            <% } %>

                        </div>


                        <div class="content-information">

                            <div class="content-title-row">

                                <h3>
                                    <%= item.name || "Unnamed Item" %>
                                </h3>


                                <span
                                    class="content-type
                                    <% if (currentItemIsFeed) { %>
                                        feed-type
                                    <% } else if (currentItemIsAnimal) { %>
                                        animal-type
                                    <% } else { %>
                                        asset-type
                                    <% } %>"
                                >

                                    <% if (currentItemIsFeed) { %>
                                        Feed
                                    <% } else if (currentItemIsAnimal) { %>
                                        Animal
                                    <% } else if (currentItemIsAgroStore) { %>
                                        AgroStore
                                    <% } else { %>
                                        Asset
                                    <% } %>

                                </span>

                            </div>

                        </div>

                    </article>

                <% }); %>

            </div>


            <% if (isNormalRoom) { %>

                </form>


                <form
                    id="omitForm"
                    method="POST"
                    action="/storage/<%= dairy._id %>/contents/<%= storage._id %>/omit"
                    style="display:none;"
                >

                    <div id="omitInputs"></div>

                </form>

            <% } %>


        <% } else { %>


            <div class="empty-contents">

                <div class="empty-icon">

                    <% if (isAgroStore) { %>
                        🌾
                    <% } else { %>
                        📦
                    <% } %>

                </div>


                <h3>

                    <% if (isAgroStore) { %>
                        AgroStore is Empty
                    <% } else { %>
                        Storage Room is Empty
                    <% } %>

                </h3>


                <p>

                    <% if (isAgroStore) { %>

                        No Dairy records currently have a
                        <strong>dwellNumber</strong> matching
                        <strong>
                            <%= displayValue(storageRoomNumber) %>
                        </strong>
                        with a quantity greater than zero.

                    <% } else { %>

                        No Dairy records currently have a
                        <strong>dwellNumber</strong> matching
                        this room's
                        <strong>
                            roomNumber <%= displayValue(storageRoomNumber) %>
                        </strong>.

                    <% } %>

                </p>

            </div>

        <% } %>

    </section>


    <!-- ========================================================
         ROOM ADD ITEMS TAB
    ========================================================= -->

    <% if (isNormalRoom && isAdmin) { %>

        <section
            class="storage-tab-panel"
            data-storage-panel="add-items"
        >

            <div class="add-items-section">

                <div class="add-introduction">

                    <h3>
                        Add Items
                    </h3>


                    <p>

                        Available Dairy records whose
                        <strong>assetCode</strong> matches this
                        room's
                        <strong>
                            roomNumber <%= displayValue(storageRoomNumber) %>
                        </strong>
                        and whose
                        <strong>dwellNumber</strong> is not this
                        room.

                    </p>

                </div>


                <% if (addItemCount > 0) { %>


                    <div class="contents-management">

                        <div class="management-left">

                            <label class="select-all-wrapper">

                                <input
                                    type="checkbox"
                                    id="selectAllAddItems"
                                >

                                <span>
                                    Select All
                                </span>

                            </label>


                            <span
                                id="addSelectionCount"
                                class="selection-count"
                            >
                                0 selected
                            </span>

                        </div>


                        <div class="management-right">

                            <button
                                type="submit"
                                form="addItemsForm"
                                id="addSelectedButton"
                                class="storage-action-button add-button"
                                disabled
                            >
                                Add Selected
                            </button>

                        </div>

                    </div>


                    <form
                        method="POST"
                        action="/storage/<%= dairy._id %>/contents/<%= storage._id %>/add"
                        id="addItemsForm"
                    >

                        <div class="add-list">

                            <% filteredAddItems.forEach(function(item) { %>

                                <%
                                    const addRecordIsAnimal =
                                        itemIsAnimal(item);

                                    const addRecordIsFeed =
                                        itemIsFeed(item);

                                    const addRecordIsAgroStore =
                                        itemIsAgroStore(item);
                                %>


                                <article
                                    class="add-card"
                                    data-add-card
                                    data-add-item-id="<%= item._id %>"
                                >

                                    <div class="add-checkbox">

                                        <input
                                            type="checkbox"
                                            class="add-item-checkbox"
                                            name="itemIds"
                                            value="<%= item._id %>"
                                        >

                                    </div>


                                    <div class="add-icon">

                                        <% if (item.profileImage) { %>

                                            <img
                                                src="<%= item.profileImage %>"
                                                alt="<%= item.name || 'Dairy' %>"
                                                style="width:100%;height:100%;object-fit:cover;border-radius:inherit;"
                                            >

                                        <% } else if (addRecordIsFeed) { %>

                                            🌾

                                        <% } else if (addRecordIsAnimal) { %>

                                            🐄

                                        <% } else if (addRecordIsAgroStore) { %>

                                            🌾

                                        <% } else { %>

                                            📦

                                        <% } %>

                                    </div>


                                    <div class="add-information">

                                        <div class="add-title">

                                            <h3>
                                                <%= item.name || "Unnamed Item" %>
                                            </h3>


                                            <span
                                                class="content-type
                                                <% if (addRecordIsFeed) { %>
                                                    feed-type
                                                <% } else if (addRecordIsAnimal) { %>
                                                    animal-type
                                                <% } else { %>
                                                    asset-type
                                                <% } %>"
                                            >

                                                <% if (addRecordIsFeed) { %>
                                                    Feed
                                                <% } else if (addRecordIsAnimal) { %>
                                                    Animal
                                                <% } else if (addRecordIsAgroStore) { %>
                                                    AgroStore
                                                <% } else { %>
                                                    Asset
                                                <% } %>

                                            </span>

                                        </div>

                                    </div>

                                </article>

                            <% }); %>

                        </div>

                    </form>


                <% } else { %>


                    <div class="empty-contents">

                        <div class="empty-icon">
                            📦
                        </div>


                        <h3>
                            No Dairy Records Available
                        </h3>


                        <p>

                            There are no Dairy records whose
                            <strong>assetCode</strong> matches this
                            room and whose
                            <strong>dwellNumber</strong> is different
                            from this room.

                        </p>

                    </div>

                <% } %>

            </div>

        </section>

    <% } %>


</div>


<script>

document.addEventListener(
    "DOMContentLoaded",
    function(){

        const isNormalRoom =
            <%= isNormalRoom ? "true" : "false" %>;


        const isAgroStore =
            <%= isAgroStore ? "true" : "false" %>;


        /* ======================================================
           CURRENT CONTENT ITEM NAVIGATION
        ====================================================== */

        const contentCards =
            document.querySelectorAll(
                "[data-content-card][data-item-url]"
            );


        contentCards.forEach(
            function(card){

                card.addEventListener(
                    "click",
                    function(event){

                        if (
                            event.target &&
                            (
                                event.target.matches(
                                    "input[type='checkbox']"
                                ) ||
                                event.target.closest(
                                    ".content-checkbox"
                                )
                            )
                        ) {

                            return;

                        }


                        if (
                            event.target &&
                            event.target.closest(
                                "button, input, select, textarea, label"
                            )
                        ) {

                            return;

                        }


                        const itemUrl =
                            card.getAttribute(
                                "data-item-url"
                            );


                        if (!itemUrl) {

                            return;

                        }


                        window.location.href =
                            itemUrl;

                    }
                );

            }
        );


        /* ======================================================
           ROOM TABS
        ====================================================== */

        if (isNormalRoom) {

            const storageTabs =
                document.querySelectorAll(
                    "[data-storage-tab]"
                );


            const storagePanels =
                document.querySelectorAll(
                    "[data-storage-panel]"
                );


            storageTabs.forEach(
                function(tab){

                    tab.addEventListener(
                        "click",
                        function(){

                            const target =
                                tab.getAttribute(
                                    "data-storage-tab"
                                );


                            storageTabs.forEach(
                                function(otherTab){

                                    otherTab.classList.toggle(
                                        "active",
                                        otherTab === tab
                                    );

                                }
                            );


                            storagePanels.forEach(
                                function(panel){

                                    panel.classList.toggle(
                                        "active",
                                        panel.getAttribute(
                                            "data-storage-panel"
                                        ) === target
                                    );

                                }
                            );

                        }
                    );

                }
            );

        }


        if (!isNormalRoom) {

            return;

        }


        /* ======================================================
           CURRENT CONTENT SELECTION
        ====================================================== */

        const selectAllContents =
            document.getElementById(
                "selectAllContents"
            );


        const contentCheckboxes =
            document.querySelectorAll(
                ".content-item-checkbox"
            );


        const contentsSelectionCount =
            document.getElementById(
                "contentsSelectionCount"
            );


        const openReshuffleButton =
            document.getElementById(
                "openReshuffleButton"
            );


        const omitButton =
            document.getElementById(
                "omitButton"
            );


        const reshufflePanel =
            document.getElementById(
                "reshufflePanel"
            );


        const destinationStorage =
            document.getElementById(
                "destinationStorage"
            );


        const reshuffleSubmitButton =
            document.getElementById(
                "reshuffleSubmitButton"
            );


        const cancelReshuffleButton =
            document.getElementById(
                "cancelReshuffleButton"
            );


        const contentsManagementForm =
            document.getElementById(
                "contentsManagementForm"
            );


        const omitForm =
            document.getElementById(
                "omitForm"
            );


        const omitInputs =
            document.getElementById(
                "omitInputs"
            );


        function getSelectedContents(){

            return Array.from(
                document.querySelectorAll(
                    ".content-item-checkbox:checked"
                )
            );

        }


        function updateContentSelection(){

            const selected =
                getSelectedContents();


            const count =
                selected.length;


            if (contentsSelectionCount) {

                contentsSelectionCount.textContent =
                    count + " selected";

            }


            if (openReshuffleButton) {

                openReshuffleButton.disabled =
                    count === 0;

            }


            if (omitButton) {

                omitButton.disabled =
                    count === 0;

            }


            document
                .querySelectorAll(
                    "[data-content-card]"
                )
                .forEach(
                    function(card){

                        const checkbox =
                            card.querySelector(
                                ".content-item-checkbox"
                            );


                        card.classList.toggle(
                            "selected",
                            Boolean(
                                checkbox &&
                                checkbox.checked
                            )
                        );

                    }
                );


            if (selectAllContents) {

                selectAllContents.checked =
                    contentCheckboxes.length > 0 &&
                    count === contentCheckboxes.length;

            }


            updateReshuffleSubmit();

        }


        if (selectAllContents) {

            selectAllContents.addEventListener(
                "change",
                function(){

                    contentCheckboxes.forEach(
                        function(checkbox){

                            checkbox.checked =
                                selectAllContents.checked;

                        }
                    );


                    updateContentSelection();

                }
            );

        }


        contentCheckboxes.forEach(
            function(checkbox){

                checkbox.addEventListener(
                    "change",
                    updateContentSelection
                );

            }
        );


        if (openReshuffleButton) {

            openReshuffleButton.addEventListener(
                "click",
                function(){

                    if (
                        openReshuffleButton.disabled
                    ) {

                        return;

                    }


                    if (reshufflePanel) {

                        reshufflePanel.classList.add(
                            "open"
                        );

                    }


                    updateReshuffleSubmit();

                }
            );

        }


        function updateReshuffleSubmit(){

            if (!reshuffleSubmitButton) {

                return;

            }


            const selected =
                getSelectedContents();


            const destination =
                destinationStorage
                    ? destinationStorage.value
                    : "";


            reshuffleSubmitButton.disabled =
                selected.length === 0 ||
                !destination;

        }


        if (destinationStorage) {

            destinationStorage.addEventListener(
                "change",
                updateReshuffleSubmit
            );

        }


        if (cancelReshuffleButton) {

            cancelReshuffleButton.addEventListener(
                "click",
                function(){

                    if (reshufflePanel) {

                        reshufflePanel.classList.remove(
                            "open"
                        );

                    }


                    if (destinationStorage) {

                        destinationStorage.value =
                            "";

                    }


                    updateReshuffleSubmit();

                }
            );

        }


        if (contentsManagementForm) {

            contentsManagementForm.addEventListener(
                "submit",
                function(event){

                    const selected =
                        getSelectedContents();


                    if (
                        selected.length === 0
                    ) {

                        event.preventDefault();

                        return;

                    }


                    if (
                        !destinationStorage ||
                        !destinationStorage.value
                    ) {

                        event.preventDefault();

                    }

                }
            );

        }


        if (omitButton) {

            omitButton.addEventListener(
                "click",
                function(){

                    const selected =
                        getSelectedContents();


                    if (
                        selected.length === 0
                    ) {

                        return;

                    }


                    if (
                        !omitForm ||
                        !omitInputs
                    ) {

                        return;

                    }


                    omitInputs.innerHTML =
                        "";


                    selected.forEach(
                        function(checkbox){

                            const input =
                                document.createElement(
                                    "input"
                                );


                            input.type =
                                "hidden";


                            input.name =
                                "itemIds";


                            input.value =
                                checkbox.value;


                            omitInputs.appendChild(
                                input
                            );

                        }
                    );


                    omitForm.submit();

                }
            );

        }


        /* ======================================================
           ADD ITEMS
        ====================================================== */

        const selectAllAddItems =
            document.getElementById(
                "selectAllAddItems"
            );


        const addCheckboxes =
            document.querySelectorAll(
                ".add-item-checkbox"
            );


        const addSelectionCount =
            document.getElementById(
                "addSelectionCount"
            );


        const addSelectedButton =
            document.getElementById(
                "addSelectedButton"
            );


        function getSelectedAddItems(){

            return Array.from(
                document.querySelectorAll(
                    ".add-item-checkbox:checked"
                )
            );

        }


        function updateAddSelection(){

            const selected =
                getSelectedAddItems();


            const count =
                selected.length;


            if (addSelectionCount) {

                addSelectionCount.textContent =
                    count + " selected";

            }


            if (addSelectedButton) {

                addSelectedButton.disabled =
                    count === 0;

            }


            document
                .querySelectorAll(
                    "[data-add-card]"
                )
                .forEach(
                    function(card){

                        const checkbox =
                            card.querySelector(
                                ".add-item-checkbox"
                            );


                        card.classList.toggle(
                            "selected",
                            Boolean(
                                checkbox &&
                                checkbox.checked
                            )
                        );

                    }
                );


            if (selectAllAddItems) {

                selectAllAddItems.checked =
                    addCheckboxes.length > 0 &&
                    count === addCheckboxes.length;

            }

        }


        if (selectAllAddItems) {

            selectAllAddItems.addEventListener(
                "change",
                function(){

                    addCheckboxes.forEach(
                        function(checkbox){

                            checkbox.checked =
                                selectAllAddItems.checked;

                        }
                    );


                    updateAddSelection();

                }
            );

        }


        addCheckboxes.forEach(
            function(checkbox){

                checkbox.addEventListener(
                    "change",
                    updateAddSelection
                );

            }
        );


        /* ======================================================
           INITIAL STATE
        ====================================================== */

        updateContentSelection();

        updateReshuffleSubmit();

        updateAddSelection();

    }
);

</script>