<%
/*
==============================================================
STORAGE CONTENTS
==============================================================

FILE:
    views/storage/contents.ejs

PURPOSE:
    Main contents-management page for:

        1. Normal Storage Rooms
        2. AgroStore (type === "feeds")

URL CONTRACT:
    /storage/<%= dairy._id %>/contents/<%= item._id %>

==============================================================
*/

const storageType = String(
    storage && storage.type ? storage.type : ""
).trim().toLowerCase();

const isAgroStore = storageType === "feeds";

const storageName =
    (storage && storage.displayName) ||
    (
        isAgroStore
            ? "AgroStore"
            : "Room " + (
                storage && storage.roomNumber
                    ? storage.roomNumber
                    : "—"
            )
    );

const currentTab =
    activeTab === "add"
        ? "add"
        : "view";
%>

<style>

/* ============================================================
   PAGE
============================================================ */

.storage-contents-page{
    width:100%;
    max-width:1050px;
    margin:0 auto;
    padding:18px 16px 60px;
    box-sizing:border-box;
}


/* ============================================================
   HEADER
============================================================ */

.storage-page-header{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:18px;
    margin-bottom:18px;
}

.storage-header-main{
    min-width:0;
}

.storage-header-eyebrow{
    margin:0 0 5px;
    color:#789080;
    font-size:10px;
    font-weight:800;
    letter-spacing:.11em;
    text-transform:uppercase;
}

.storage-page-title{
    margin:0;
    color:#1d2d23;
    font-size:27px;
    line-height:1.15;
    font-weight:800;
    letter-spacing:-.035em;
}

.storage-page-description{
    max-width:620px;
    margin:7px 0 0;
    color:#77837c;
    font-size:13px;
    line-height:1.55;
}

.back-storage{
    flex:none;
    display:inline-flex;
    align-items:center;
    gap:7px;
    min-height:38px;
    padding:0 13px;
    border:1px solid #dfe7e1;
    border-radius:10px;
    background:#fff;
    color:#31533d;
    font-size:12px;
    font-weight:750;
    text-decoration:none;
    transition:.18s ease;
}

.back-storage:hover{
    border-color:#bdd2c2;
    background:#f8fbf8;
}


/* ============================================================
   MESSAGE
============================================================ */

.storage-message{
    display:flex;
    align-items:center;
    gap:9px;
    margin:0 0 16px;
    padding:11px 13px;
    border-radius:10px;
    font-size:12px;
    font-weight:650;
}

.storage-success{
    background:#f1f8f3;
    border:1px solid #d8e9dc;
    color:#28603a;
}

.storage-error{
    background:#fff5f4;
    border:1px solid #efd9d6;
    color:#9a443b;
}


/* ============================================================
   TABS
============================================================ */

.storage-tabs{
    display:flex;
    align-items:center;
    width:100%;
    padding:4px;
    margin-bottom:20px;
    background:#f1f4f2;
    border:1px solid #e2e8e3;
    border-radius:12px;
}

.storage-tab{
    flex:1;
    min-height:40px;
    border:0;
    border-radius:9px;
    background:transparent;
    color:#758078;
    font-size:12px;
    font-weight:800;
    cursor:pointer;
    transition:.18s ease;
}

.storage-tab:hover{
    color:#385342;
}

.storage-tab.active{
    background:#fff;
    color:#245d38;
    box-shadow:0 2px 7px rgba(27,53,36,.08);
}


/* ============================================================
   TAB PANELS
============================================================ */

.storage-tab-panel{
    display:none;
}

.storage-tab-panel.active{
    display:block;
}


/* ============================================================
   CONTENTS TOP BAR
============================================================ */

.contents-topbar{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:12px;
    margin-bottom:13px;
}

.contents-heading{
    margin:0;
    color:#24372a;
    font-size:17px;
    font-weight:800;
    letter-spacing:-.02em;
}

.contents-count{
    color:#87928b;
    font-size:11px;
    font-weight:650;
}

.contents-count strong{
    color:#2e4938;
    font-size:16px;
}


/* ============================================================
   MANAGEMENT BAR
============================================================ */

.contents-management,
.add-management{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:12px;
    margin-bottom:12px;
    padding:10px 12px;
    background:#fff;
    border:1px solid #e2e9e4;
    border-radius:12px;
}

.management-left,
.management-right{
    display:flex;
    align-items:center;
    gap:8px;
}

.select-all-wrapper{
    display:flex;
    align-items:center;
    gap:7px;
    color:#425248;
    font-size:11px;
    font-weight:750;
    cursor:pointer;
}

.select-all-wrapper input{
    width:16px;
    height:16px;
    margin:0;
    accent-color:#2d7a47;
}

.selection-count{
    padding:4px 8px;
    border-radius:7px;
    background:#f3f6f3;
    color:#7a867f;
    font-size:10px;
    font-weight:700;
}

.storage-action-button{
    min-height:34px;
    padding:0 12px;
    border-radius:8px;
    font-size:11px;
    font-weight:800;
    cursor:pointer;
    transition:.16s ease;
}

.storage-action-button:disabled{
    opacity:.4;
    cursor:not-allowed;
}

.storage-action-button:not(:disabled):hover{
    transform:translateY(-1px);
}

.reshuffle-button{
    border:1px solid #d5e5d9;
    background:#f2f8f3;
    color:#2d6840;
}

.omit-button{
    border:1px solid #eedbd7;
    background:#fff6f4;
    color:#9d493e;
}

.add-button{
    border:1px solid #286e41;
    background:#2d7b48;
    color:#fff;
    box-shadow:0 3px 8px rgba(45,123,72,.13);
}


/* ============================================================
   RESHUFFLE PANEL
============================================================ */

.reshuffle-panel{
    display:none;
    margin:0 0 13px;
    padding:15px;
    background:#f7faf8;
    border:1px solid #dbe8de;
    border-radius:13px;
}

.reshuffle-panel.open{
    display:block;
}

.reshuffle-heading{
    margin:0;
    color:#294333;
    font-size:14px;
    font-weight:800;
}

.reshuffle-description{
    margin:5px 0 13px;
    color:#7a867f;
    font-size:11px;
    line-height:1.5;
}

.reshuffle-form{
    display:flex;
    align-items:flex-end;
    gap:8px;
}

.reshuffle-select-group{
    flex:1;
}

.reshuffle-select-group label{
    display:block;
    margin-bottom:5px;
    color:#68766e;
    font-size:10px;
    font-weight:800;
}

.reshuffle-select{
    width:100%;
    height:37px;
    padding:0 10px;
    border:1px solid #d7e2da;
    border-radius:8px;
    background:#fff;
    color:#33483a;
    font-size:11px;
    outline:none;
}

.reshuffle-select:focus{
    border-color:#82aa8e;
}


/* ============================================================
   CONTENT LIST
============================================================ */

.contents-list{
    display:flex;
    flex-direction:column;
    gap:9px;
}


/* ============================================================
   CONTENT CARD
============================================================ */

.content-card{
    display:grid;
    grid-template-columns:auto 44px minmax(0,1fr);
    align-items:start;
    gap:12px;
    padding:14px;
    background:#fff;
    border:1px solid #e3e9e5;
    border-radius:14px;
    box-shadow:0 2px 9px rgba(24,45,31,.025);
    transition:
        border-color .16s ease,
        box-shadow .16s ease,
        background .16s ease;
}

.content-card:hover{
    border-color:#d2dfd5;
    box-shadow:0 5px 16px rgba(24,45,31,.05);
}

.content-card.selected{
    border-color:#8db89a;
    background:#fbfefb;
}

.content-checkbox{
    padding-top:4px;
}

.content-checkbox input{
    width:16px;
    height:16px;
    margin:0;
    accent-color:#2d7a47;
}

.content-icon{
    width:44px;
    height:44px;
    display:flex;
    align-items:center;
    justify-content:center;
    border-radius:12px;
    background:#f1f6f2;
    font-size:21px;
}

.content-information{
    min-width:0;
}

.content-title-row{
    display:flex;
    align-items:center;
    flex-wrap:wrap;
    gap:7px;
}

.content-title-row h3{
    margin:0;
    color:#25382b;
    font-size:15px;
    line-height:1.3;
    font-weight:800;
}

.content-type{
    display:inline-flex;
    align-items:center;
    min-height:20px;
    padding:0 7px;
    border-radius:999px;
    font-size:8px;
    font-weight:850;
    letter-spacing:.07em;
    text-transform:uppercase;
}

.animal-type{
    background:#edf7ef;
    color:#347148;
}

.asset-type{
    background:#f1f3f3;
    color:#68746d;
}

.feed-type{
    background:#edf7ef;
    color:#2d7243;
}


/* ============================================================
   CONTENT META
============================================================ */

.content-meta{
    display:flex;
    align-items:center;
    flex-wrap:wrap;
    gap:5px 13px;
    margin-top:8px;
}

.content-meta-item{
    color:#7b8780;
    font-size:10px;
}

.content-meta-item strong{
    color:#46574c;
    font-weight:750;
}


/* ============================================================
   ANIMAL INFORMATION
============================================================ */

.animal-information{
    display:flex;
    flex-wrap:wrap;
    gap:5px 13px;
    margin-top:8px;
    color:#7c8881;
    font-size:10px;
}

.animal-information strong{
    color:#4a5d50;
}


/* ============================================================
   DESCRIPTION
============================================================ */

.content-description{
    margin:9px 0 0;
    color:#7b8780;
    font-size:10px;
    line-height:1.5;
}


/* ============================================================
   AGROSTORE QUANTITY
============================================================ */

.feed-quantity-section{
    margin-top:13px;
    padding:13px;
    background:#f8fbf8;
    border:1px solid #dfeae1;
    border-radius:11px;
}

.feed-quantity-header{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:10px;
    margin-bottom:10px;
}

.feed-quantity-title{
    color:#68776e;
    font-size:9px;
    font-weight:850;
    letter-spacing:.08em;
    text-transform:uppercase;
}

.feed-current-quantity{
    color:#276b3e;
    font-size:17px;
    font-weight:850;
}

.feed-unit{
    margin-left:3px;
    color:#7b8780;
    font-size:10px;
    font-weight:700;
}

.quantity-form{
    display:grid;
    grid-template-columns:minmax(0,1fr) 105px auto;
    align-items:end;
    gap:7px;
}

.quantity-field label{
    display:block;
    margin-bottom:5px;
    color:#748078;
    font-size:9px;
    font-weight:750;
}

.quantity-input,
.quantity-unit{
    width:100%;
    height:36px;
    box-sizing:border-box;
    padding:0 9px;
    border:1px solid #d6e2d9;
    border-radius:8px;
    background:#fff;
    color:#304438;
    font-size:11px;
    outline:none;
}

.quantity-input:focus,
.quantity-unit:focus{
    border-color:#82aa8e;
    box-shadow:0 0 0 3px rgba(45,122,71,.07);
}

.quantity-save-button{
    height:36px;
    padding:0 14px;
    border:0;
    border-radius:8px;
    background:#2d7b48;
    color:#fff;
    font-size:10px;
    font-weight:800;
    cursor:pointer;
}

.quantity-help{
    margin:8px 0 0;
    color:#8a958e;
    font-size:9px;
    line-height:1.45;
}


/* ============================================================
   EMPTY CONTENT
============================================================ */

.empty-contents{
    padding:45px 20px;
    text-align:center;
    background:#fafcfa;
    border:1px dashed #dce5df;
    border-radius:15px;
}

.empty-icon{
    width:48px;
    height:48px;
    display:flex;
    align-items:center;
    justify-content:center;
    margin:0 auto 11px;
    border-radius:14px;
    background:#f0f6f1;
    font-size:22px;
}

.empty-contents h3{
    margin:0;
    color:#35473b;
    font-size:15px;
    font-weight:800;
}

.empty-contents p{
    max-width:430px;
    margin:6px auto 0;
    color:#849088;
    font-size:11px;
    line-height:1.55;
}


/* ============================================================
   ADD ITEMS
============================================================ */

.add-introduction{
    margin-bottom:13px;
}

.add-introduction h3{
    margin:0;
    color:#26392c;
    font-size:17px;
    font-weight:800;
}

.add-introduction p{
    margin:5px 0 0;
    color:#7b8780;
    font-size:11px;
    line-height:1.5;
}

.add-list{
    display:flex;
    flex-direction:column;
    gap:9px;
}

.add-card{
    display:grid;
    grid-template-columns:auto 42px minmax(0,1fr);
    align-items:start;
    gap:11px;
    padding:13px;
    background:#fff;
    border:1px solid #e3e9e5;
    border-radius:13px;
    transition:
        border-color .16s ease,
        background .16s ease;
}

.add-card:hover{
    border-color:#d0ddd3;
}

.add-card.selected{
    border-color:#8db89a;
    background:#fbfefb;
}

.add-checkbox{
    padding-top:3px;
}

.add-checkbox input{
    width:16px;
    height:16px;
    margin:0;
    accent-color:#2d7a47;
}

.add-icon{
    width:42px;
    height:42px;
    display:flex;
    align-items:center;
    justify-content:center;
    border-radius:11px;
    background:#f2f6f3;
    font-size:20px;
}

.add-information{
    min-width:0;
}

.add-title{
    display:flex;
    align-items:center;
    flex-wrap:wrap;
    gap:7px;
}

.add-title h3{
    margin:0;
    color:#283a2e;
    font-size:14px;
    font-weight:800;
}

.add-meta{
    display:flex;
    flex-wrap:wrap;
    gap:5px 13px;
    margin-top:7px;
}

.add-meta span{
    color:#7d8982;
    font-size:10px;
}

.add-meta strong{
    color:#4a5b50;
}


/* ============================================================
   MOBILE
============================================================ */

@media (max-width:700px){

    .storage-contents-page{
        padding:13px 11px 45px;
    }

    .storage-page-header{
        align-items:flex-start;
        flex-direction:column;
    }

    .back-storage{
        width:100%;
        justify-content:center;
    }

    .storage-page-title{
        font-size:24px;
    }

    .contents-management,
    .add-management{
        align-items:stretch;
        flex-direction:column;
    }

    .management-left,
    .management-right{
        width:100%;
    }

    .management-right{
        display:grid;
        grid-template-columns:1fr 1fr;
    }

    .storage-action-button{
        width:100%;
    }

    .reshuffle-form{
        align-items:stretch;
        flex-direction:column;
    }

    .reshuffle-form .storage-action-button{
        width:100%;
    }

    .content-card{
        grid-template-columns:auto 40px minmax(0,1fr);
        gap:9px;
        padding:12px;
    }

    .content-icon{
        width:40px;
        height:40px;
    }

    .quantity-form{
        grid-template-columns:1fr 95px;
    }

    .quantity-save-button{
        grid-column:1 / -1;
        width:100%;
    }
}


@media (max-width:430px){

    .storage-tabs{
        margin-bottom:16px;
    }

    .storage-tab{
        font-size:11px;
    }

    .management-right{
        grid-template-columns:1fr;
    }

    .content-meta{
        display:grid;
        grid-template-columns:1fr 1fr;
        gap:6px;
    }

    .quantity-form{
        grid-template-columns:1fr;
    }

    .quantity-save-button{
        grid-column:auto;
    }

    .feed-quantity-header{
        align-items:flex-start;
        flex-direction:column;
    }
}

</style>


<div class="storage-contents-page">

    <!-- ========================================================
         HEADER
    ========================================================= -->

    <header class="storage-page-header">

        <div class="storage-header-main">

            <p class="storage-header-eyebrow">
                <% if (isAgroStore) { %>
                    AgroStore
                <% } else { %>
                    Storage
                <% } %>
            </p>

            <h1 class="storage-page-title">
                <%= storageName %>
            </h1>

            <p class="storage-page-description">

                <% if (isAgroStore) { %>

                    Manage feeds currently stored here and
                    update the quantity remaining.

                <% } else { %>

                    View and manage the items currently
                    allocated to this storage room.

                <% } %>

            </p>

        </div>


        <a
            href="/storage/<%= dairy._id %>"
            class="back-storage"
        >
            ← Back to Storage
        </a>

    </header>


    <!-- ========================================================
         MESSAGES
    ========================================================= -->

    <% if (successMessage) { %>

        <div class="storage-message storage-success">

            <span>✓</span>

            <span>
                <%= successMessage %>
            </span>

        </div>

    <% } %>


    <% if (pageError) { %>

        <div class="storage-message storage-error">

            <span>!</span>

            <span>
                <%= pageError %>
            </span>

        </div>

    <% } %>


    <!-- ========================================================
         TABS
    ========================================================= -->

    <div class="storage-tabs">

        <button
            type="button"
            class="storage-tab <% if (currentTab === 'view') { %>active<% } %>"
            data-storage-tab="view"
        >
            View Contents
        </button>


        <button
            type="button"
            class="storage-tab <% if (currentTab === 'add') { %>active<% } %>"
            data-storage-tab="add"
        >
            Add Items
        </button>

    </div>


    <!-- ========================================================
         VIEW CONTENTS TAB
    ========================================================= -->

    <section
        id="storageViewTab"
        class="storage-tab-panel <% if (currentTab === 'view') { %>active<% } %>"
        data-storage-panel="view"
    >

        <div class="contents-topbar">

            <h2 class="contents-heading">
                Current Contents
            </h2>

            <div class="contents-count">

                <strong>
                    <%= itemCount || 0 %>
                </strong>

                <% if (Number(itemCount || 0) === 1) { %>
                    item
                <% } else { %>
                    items
                <% } %>

            </div>

        </div>


        <% if (items && items.length > 0) { %>


            <!-- ==================================================
                 NORMAL STORAGE
            ================================================== -->

            <% if (!isAgroStore) { %>

                <form
                    id="reshuffleForm"
                    method="POST"
                    action="/storage/<%= dairy._id %>/contents/<%= storage._id %>/reshuffle"
                >

                    <div class="contents-management">

                        <div class="management-left">

                            <label class="select-all-wrapper">

                                <input
                                    type="checkbox"
                                    id="selectAllContents"
                                >

                                <span>
                                    Select All
                                </span>

                            </label>


                            <span
                                id="contentsSelectionCount"
                                class="selection-count"
                            >
                                0 selected
                            </span>

                        </div>


                        <div class="management-right">

                            <button
                                type="button"
                                id="openReshuffleButton"
                                class="storage-action-button reshuffle-button"
                                disabled
                            >
                                Reshuffle
                            </button>


                            <button
                                type="button"
                                id="omitButton"
                                class="storage-action-button omit-button"
                                disabled
                            >
                                Omit Selected
                            </button>

                        </div>

                    </div>


                    <div
                        id="reshufflePanel"
                        class="reshuffle-panel"
                    >

                        <h3 class="reshuffle-heading">
                            Reshuffle Selected Items
                        </h3>

                        <p class="reshuffle-description">
                            Move the selected items to another
                            active storage room of the same type.
                        </p>


                        <div class="reshuffle-form">

                            <div class="reshuffle-select-group">

                                <label for="destinationStorage">
                                    Destination
                                </label>

                                <select
                                    id="destinationStorage"
                                    name="targetStorageId"
                                    class="reshuffle-select"
                                >

                                    <option value="">
                                        Select destination...
                                    </option>


                                    <% if (targetStorages && targetStorages.length > 0) { %>

                                        <% targetStorages.forEach(function(destination) { %>

                                            <option
                                                value="<%= destination._id %>"
                                            >
                                                <%= destination.displayName || ("Room " + (destination.roomNumber || "—")) %>
                                            </option>

                                        <% }); %>

                                    <% } else { %>

                                        <option
                                            value=""
                                            disabled
                                        >
                                            No other Rooms available
                                        </option>

                                    <% } %>

                                </select>

                            </div>


                            <button
                                type="submit"
                                id="reshuffleSubmitButton"
                                class="storage-action-button add-button"
                                disabled
                            >
                                Reshuffle Selected
                            </button>


                            <button
                                type="button"
                                id="cancelReshuffleButton"
                                class="storage-action-button omit-button"
                            >
                                Cancel
                            </button>

                        </div>

                    </div>


                    <div class="contents-list">

                        <% items.forEach(function(item) { %>

                            <%
                                const itemCodeNumber = Number(item.code);
                                const isAnimal =
                                    item.code !== null &&
                                    item.code !== undefined &&
                                    !Number.isNaN(itemCodeNumber) &&
                                    itemCodeNumber > 0;
                            %>

                            <article
                                class="content-card"
                                data-content-card
                                data-item-id="<%= item._id %>"
                            >

                                <div class="content-checkbox">

                                    <input
                                        type="checkbox"
                                        class="content-item-checkbox"
                                        name="itemIds"
                                        value="<%= item._id %>"
                                    >

                                </div>


                                <div class="content-icon">

                                    <% if (isAnimal) { %>
                                        🐄
                                    <% } else { %>
                                        🔧
                                    <% } %>

                                </div>


                                <div class="content-information">

                                    <div class="content-title-row">

                                        <h3>
                                            <%= item.name || "Unnamed Item" %>
                                        </h3>


                                        <span
                                            class="content-type <% if (isAnimal) { %>animal-type<% } else { %>asset-type<% } %>"
                                        >

                                            <% if (isAnimal) { %>
                                                Animal
                                            <% } else { %>
                                                Asset
                                            <% } %>

                                        </span>

                                    </div>


                                    <div class="content-meta">

                                        <span class="content-meta-item">

                                            <strong>Code:</strong>

                                            <% if (item.code !== null && item.code !== undefined) { %>
                                                <%= item.code %>
                                            <% } else { %>
                                                —
                                            <% } %>

                                        </span>


                                        <span class="content-meta-item">

                                            <strong>Type:</strong>

                                            <%= item.type || "—" %>

                                        </span>


                                        <span class="content-meta-item">

                                            <strong>Status:</strong>

                                            <%= item.status || "—" %>

                                        </span>


                                        <% if (item.quantity !== null && item.quantity !== undefined) { %>

                                            <span class="content-meta-item">

                                                <strong>Quantity:</strong>

                                                <%= Number(item.quantity || 0).toLocaleString() %>

                                                <%= item.unit || "unit" %>

                                            </span>

                                        <% } %>


                                        <% if (item.condition) { %>

                                            <span class="content-meta-item">

                                                <strong>Condition:</strong>

                                                <%= item.condition %>

                                            </span>

                                        <% } %>


                                        <% if (item.currentWorth !== null && item.currentWorth !== undefined) { %>

                                            <span class="content-meta-item">

                                                <strong>Worth:</strong>

                                                <%= Number(item.currentWorth || 0).toLocaleString() %>

                                            </span>

                                        <% } %>

                                    </div>


                                    <% if (isAnimal) { %>

                                        <div class="animal-information">

                                            <span>
                                                <strong>Gender:</strong>
                                                <%= item.gender || "—" %>
                                            </span>

                                            <span>
                                                <strong>Age:</strong>
                                                <%= item.ageText || "—" %>
                                            </span>

                                            <span>
                                                <strong>Milking:</strong>

                                                <% if (item.isMilking) { %>
                                                    Yes
                                                <% } else { %>
                                                    No
                                                <% } %>

                                            </span>

                                        </div>

                                    <% } %>


                                    <% if (item.description) { %>

                                        <p class="content-description">
                                            <%= item.description %>
                                        </p>

                                    <% } %>

                                </div>

                            </article>

                        <% }); %>

                    </div>

                </form>


                <form
                    id="omitForm"
                    method="POST"
                    action="/storage/<%= dairy._id %>/contents/<%= storage._id %>/omit"
                    style="display:none;"
                >

                    <div id="omitInputs"></div>

                </form>


            <% } else { %>


                <!-- ==================================================
                     AGROSTORE
                ================================================== -->

                <div class="contents-list">

                    <% items.forEach(function(item) { %>

                        <article
                            class="content-card"
                            data-content-card
                            data-item-id="<%= item._id %>"
                        >

                            <div></div>

                            <div class="content-icon">
                                🌾
                            </div>


                            <div class="content-information">

                                <div class="content-title-row">

                                    <h3>
                                        <%= item.name || "Unnamed Feed" %>
                                    </h3>

                                    <span class="content-type feed-type">
                                        Feed
                                    </span>

                                </div>


                                <div class="content-meta">

                                    <span class="content-meta-item">

                                        <strong>Type:</strong>

                                        <%= item.type || "feeds" %>

                                    </span>


                                    <span class="content-meta-item">

                                        <strong>Status:</strong>

                                        <%= item.status || "—" %>

                                    </span>

                                </div>


                                <div class="feed-quantity-section">

                                    <div class="feed-quantity-header">

                                        <span class="feed-quantity-title">
                                            Quantity Remaining
                                        </span>


                                        <span>

                                            <span class="feed-current-quantity">
                                                <%= Number(item.quantity || 0).toLocaleString() %>
                                            </span>

                                            <span class="feed-unit">
                                                <%= item.unit || "unit" %>
                                            </span>

                                        </span>

                                    </div>


                                    <form
                                        class="quantity-form"
                                        method="POST"
                                        action="/storage/<%= dairy._id %>/contents/<%= storage._id %>/quantity"
                                        data-feed-quantity-form
                                    >

                                        <input
                                            type="hidden"
                                            name="itemId"
                                            value="<%= item._id %>"
                                        >


                                        <div class="quantity-field">

                                            <label for="quantity-<%= item._id %>">
                                                New Remaining Quantity
                                            </label>


                                            <input
                                                id="quantity-<%= item._id %>"
                                                class="quantity-input"
                                                type="number"
                                                name="quantity"
                                                min="0"
                                                max="<%= Number(item.quantity || 0) %>"
                                                step="any"
                                                value="<%= item.quantity !== undefined && item.quantity !== null ? item.quantity : 0 %>"
                                                required
                                            >

                                        </div>


                                        <%
                                            const currentUnit = String(
                                                item.unit || ""
                                            ).trim().toLowerCase();
                                        %>


                                        <select
                                            class="quantity-unit"
                                            name="unit"
                                            aria-label="Feed unit"
                                        >

                                            <option
                                                value="kg"
                                                <% if (currentUnit === "kg") { %>selected<% } %>
                                            >
                                                kg
                                            </option>


                                            <option
                                                value="bales"
                                                <% if (currentUnit === "bales") { %>selected<% } %>
                                            >
                                                bales
                                            </option>


                                            <option
                                                value="bags"
                                                <% if (currentUnit === "bags") { %>selected<% } %>
                                            >
                                                bags
                                            </option>


                                            <option
                                                value="litres"
                                                <% if (currentUnit === "litres") { %>selected<% } %>
                                            >
                                                litres
                                            </option>


                                            <option
                                                value="units"
                                                <% if (currentUnit === "units") { %>selected<% } %>
                                            >
                                                units
                                            </option>

                                        </select>


                                        <button
                                            type="submit"
                                            class="quantity-save-button"
                                        >
                                            Save
                                        </button>

                                    </form>


                                    <p class="quantity-help">

                                        Reduce the quantity to record
                                        what is currently remaining.
                                        Setting it to
                                        <strong>0</strong>
                                        automatically removes the feed
                                        from this AgroStore.

                                    </p>

                                </div>


                                <% if (item.description) { %>

                                    <p class="content-description">
                                        <%= item.description %>
                                    </p>

                                <% } %>

                            </div>

                        </article>

                    <% }); %>

                </div>

            <% } %>


        <% } else { %>


            <div class="empty-contents">

                <div class="empty-icon">

                    <% if (isAgroStore) { %>
                        🌾
                    <% } else { %>
                        📦
                    <% } %>

                </div>


                <h3>

                    <% if (isAgroStore) { %>
                        AgroStore is Empty
                    <% } else { %>
                        No Items in This Storage
                    <% } %>

                </h3>


                <p>

                    <% if (isAgroStore) { %>

                        There are currently no feeds with
                        remaining quantity in this AgroStore.

                    <% } else { %>

                        There are currently no items allocated
                        to this storage room.

                    <% } %>

                </p>

            </div>

        <% } %>

    </section>


    <!-- ========================================================
         ADD ITEMS TAB
    ========================================================= -->

    <section
        id="storageAddTab"
        class="storage-tab-panel <% if (currentTab === 'add') { %>active<% } %>"
        data-storage-panel="add"
    >

        <div class="add-introduction">

            <h3>
                Add Items
            </h3>


            <p>

                <% if (isAgroStore) { %>

                    Select unallocated feeds that belong to this farm.

                <% } else { %>

                    Select unallocated animals or assets that belong
                    to this farm.

                <% } %>

            </p>

        </div>


        <% if (availableItems && availableItems.length > 0) { %>


            <div class="add-management">

                <div class="management-left">

                    <label class="select-all-wrapper">

                        <input
                            type="checkbox"
                            id="selectAllAddItems"
                        >

                        <span>
                            Select All
                        </span>

                    </label>


                    <span
                        id="addSelectionCount"
                        class="selection-count"
                    >
                        0 selected
                    </span>

                </div>


                <div class="management-right">

                    <button
                        type="submit"
                        form="addItemsForm"
                        id="addSelectedButton"
                        class="storage-action-button add-button"
                        disabled
                    >
                        Add Selected
                    </button>

                </div>

            </div>


            <form
                method="POST"
                action="/storage/<%= dairy._id %>/contents/<%= storage._id %>/add"
                id="addItemsForm"
            >

                <div class="add-list">

                    <% availableItems.forEach(function(item) { %>

                        <%
                            const availableCodeNumber = Number(item.code);

                            const isAvailableAnimal =
                                item.code !== null &&
                                item.code !== undefined &&
                                !Number.isNaN(availableCodeNumber) &&
                                availableCodeNumber > 0;
                        %>


                        <article
                            class="add-card"
                            data-add-card
                            data-add-item-id="<%= item._id %>"
                        >

                            <div class="add-checkbox">

                                <input
                                    type="checkbox"
                                    class="add-item-checkbox"
                                    name="itemIds"
                                    value="<%= item._id %>"
                                >

                            </div>


                            <div class="add-icon">

                                <% if (isAgroStore) { %>
                                    🌾
                                <% } else if (isAvailableAnimal) { %>
                                    🐄
                                <% } else { %>
                                    🔧
                                <% } %>

                            </div>


                            <div class="add-information">

                                <div class="add-title">

                                    <h3>
                                        <%= item.name || "Unnamed Item" %>
                                    </h3>


                                    <span
                                        class="content-type
                                        <% if (isAgroStore) { %>
                                            feed-type
                                        <% } else if (isAvailableAnimal) { %>
                                            animal-type
                                        <% } else { %>
                                            asset-type
                                        <% } %>"
                                    >

                                        <% if (isAgroStore) { %>
                                            Feed
                                        <% } else if (isAvailableAnimal) { %>
                                            Animal
                                        <% } else { %>
                                            Asset
                                        <% } %>

                                    </span>

                                </div>


                                <div class="add-meta">

                                    <span>

                                        <strong>
                                            Code:
                                        </strong>

                                        <%
                                            const displayCode =
                                                item.assetCode ||
                                                item.code ||
                                                "—";
                                        %>

                                        <%= displayCode %>

                                    </span>


                                    <span>

                                        <strong>
                                            Type:
                                        </strong>

                                        <%= item.type || "—" %>

                                    </span>


                                    <span>

                                        <strong>
                                            Status:
                                        </strong>

                                        <%= item.status || "—" %>

                                    </span>


                                    <% if (item.quantity !== null && item.quantity !== undefined) { %>

                                        <span>

                                            <strong>
                                                Quantity:
                                            </strong>

                                            <%= Number(item.quantity || 0).toLocaleString() %>

                                            <%= item.unit || "unit" %>

                                        </span>

                                    <% } %>

                                </div>

                            </div>

                        </article>

                    <% }); %>

                </div>

            </form>


        <% } else { %>


            <div class="empty-contents">

                <div class="empty-icon">

                    <% if (isAgroStore) { %>
                        🌾
                    <% } else { %>
                        📦
                    <% } %>

                </div>


                <h3>

                    <% if (isAgroStore) { %>
                        No Feeds Available
                    <% } else { %>
                        No Items Available
                    <% } %>

                </h3>


                <p>

                    <% if (isAgroStore) { %>

                        There are currently no unallocated feeds
                        belonging to this farm.

                    <% } else { %>

                        There are currently no unallocated items
                        belonging to this farm.

                    <% } %>

                </p>

            </div>

        <% } %>

    </section>

</div>


<script>

document.addEventListener(
    "DOMContentLoaded",
    function(){

        /* ======================================================
           TABS
        ====================================================== */

        const tabs = document.querySelectorAll(
            "[data-storage-tab]"
        );

        const panels = document.querySelectorAll(
            "[data-storage-panel]"
        );


        tabs.forEach(function(tab){

            tab.addEventListener(
                "click",
                function(){

                    const target =
                        tab.dataset.storageTab;


                    tabs.forEach(function(item){

                        item.classList.toggle(
                            "active",
                            item.dataset.storageTab === target
                        );

                    });


                    panels.forEach(function(panel){

                        panel.classList.toggle(
                            "active",
                            panel.dataset.storagePanel === target
                        );

                    });


                    try {

                        const url =
                            new URL(
                                window.location.href
                            );


                        url.searchParams.set(
                            "tab",
                            target
                        );


                        window.history.replaceState(
                            {},
                            "",
                            url
                        );

                    } catch(error) {

                        /*
                         * URL update is cosmetic only.
                         */

                    }

                }
            );

        });


        /* ======================================================
           NORMAL STORAGE SELECTION
        ====================================================== */

        const selectAllContents =
            document.getElementById(
                "selectAllContents"
            );

        const contentCheckboxes =
            document.querySelectorAll(
                ".content-item-checkbox"
            );

        const contentsSelectionCount =
            document.getElementById(
                "contentsSelectionCount"
            );

        const openReshuffleButton =
            document.getElementById(
                "openReshuffleButton"
            );

        const omitButton =
            document.getElementById(
                "omitButton"
            );

        const reshufflePanel =
            document.getElementById(
                "reshufflePanel"
            );

        const destinationStorage =
            document.getElementById(
                "destinationStorage"
            );

        const reshuffleSubmitButton =
            document.getElementById(
                "reshuffleSubmitButton"
            );

        const cancelReshuffleButton =
            document.getElementById(
                "cancelReshuffleButton"
            );

        const reshuffleForm =
            document.getElementById(
                "reshuffleForm"
            );

        const omitForm =
            document.getElementById(
                "omitForm"
            );

        const omitInputs =
            document.getElementById(
                "omitInputs"
            );


        /* ======================================================
           SELECTED CONTENTS
        ====================================================== */

        function getSelectedContents(){

            return Array.from(
                document.querySelectorAll(
                    ".content-item-checkbox:checked"
                )
            );

        }


        /* ======================================================
           UPDATE CONTENT SELECTION
        ====================================================== */

        function updateContentSelection(){

            const selected =
                getSelectedContents();

            const count =
                selected.length;


            if (contentsSelectionCount) {

                contentsSelectionCount.textContent =
                    count + " selected";

            }


            if (openReshuffleButton) {

                openReshuffleButton.disabled =
                    count === 0;

            }


            if (omitButton) {

                omitButton.disabled =
                    count === 0;

            }


            document
                .querySelectorAll(
                    "[data-content-card]"
                )
                .forEach(function(card){

                    const checkbox =
                        card.querySelector(
                            ".content-item-checkbox"
                        );


                    card.classList.toggle(
                        "selected",
                        Boolean(
                            checkbox &&
                            checkbox.checked
                        )
                    );

                });


            if (selectAllContents) {

                selectAllContents.checked =
                    contentCheckboxes.length > 0 &&
                    count === contentCheckboxes.length;

            }

        }


        /* ======================================================
           SELECT ALL CONTENTS
        ====================================================== */

        if (selectAllContents) {

            selectAllContents.addEventListener(
                "change",
                function(){

                    contentCheckboxes.forEach(
                        function(checkbox){

                            checkbox.checked =
                                selectAllContents.checked;

                        }
                    );


                    updateContentSelection();

                }
            );

        }


        /* ======================================================
           INDIVIDUAL CONTENT CHECKBOXES
        ====================================================== */

        contentCheckboxes.forEach(
            function(checkbox){

                checkbox.addEventListener(
                    "change",
                    updateContentSelection
                );

            }
        );


        /* ======================================================
           RESHUFFLE BUTTON
        ====================================================== */

        function updateReshuffleButton(){

            if (!reshuffleSubmitButton) {
                return;
            }


            const selected =
                getSelectedContents();

            const hasDestination =
                destinationStorage &&
                destinationStorage.value;


            reshuffleSubmitButton.disabled =
                selected.length === 0 ||
                !hasDestination;

        }


        if (openReshuffleButton) {

            openReshuffleButton.addEventListener(
                "click",
                function(){

                    if (openReshuffleButton.disabled) {
                        return;
                    }


                    if (reshufflePanel) {

                        reshufflePanel.classList.add(
                            "open"
                        );

                    }


                    updateReshuffleButton();

                }
            );

        }


        /* ======================================================
           CANCEL RESHUFFLE
        ====================================================== */

        if (cancelReshuffleButton) {

            cancelReshuffleButton.addEventListener(
                "click",
                function(){

                    if (reshufflePanel) {

                        reshufflePanel.classList.remove(
                            "open"
                        );

                    }


                    if (destinationStorage) {

                        destinationStorage.value = "";

                    }


                    updateReshuffleButton();

                }
            );

        }


        /* ======================================================
           DESTINATION CHANGE
        ====================================================== */

        if (destinationStorage) {

            destinationStorage.addEventListener(
                "change",
                updateReshuffleButton
            );

        }


        /* ======================================================
           RESHUFFLE SUBMIT
        ====================================================== */

        if (reshuffleForm) {

            reshuffleForm.addEventListener(
                "submit",
                function(event){

                    const selected =
                        getSelectedContents();


                    if (selected.length === 0) {

                        event.preventDefault();
                        return;

                    }


                    if (
                        !destinationStorage ||
                        !destinationStorage.value
                    ) {

                        event.preventDefault();
                        return;

                    }

                }
            );

        }


        /* ======================================================
           OMIT SELECTED
        ====================================================== */

        if (omitButton) {

            omitButton.addEventListener(
                "click",
                function(){

                    const selected =
                        getSelectedContents();


                    if (
                        selected.length === 0 ||
                        !omitForm ||
                        !omitInputs
                    ) {

                        return;

                    }


                    omitInputs.innerHTML = "";


                    selected.forEach(
                        function(checkbox){

                            const input =
                                document.createElement(
                                    "input"
                                );


                            input.type = "hidden";

                            input.name = "itemIds";

                            input.value =
                                checkbox.value;


                            omitInputs.appendChild(
                                input
                            );

                        }
                    );


                    omitForm.submit();

                }
            );

        }


        /* ======================================================
           ADD ITEMS SELECTION
        ====================================================== */

        const selectAllAddItems =
            document.getElementById(
                "selectAllAddItems"
            );

        const addCheckboxes =
            document.querySelectorAll(
                ".add-item-checkbox"
            );

        const addSelectionCount =
            document.getElementById(
                "addSelectionCount"
            );

        const addSelectedButton =
            document.getElementById(
                "addSelectedButton"
            );


        /* ======================================================
           SELECTED ADD ITEMS
        ====================================================== */

        function getSelectedAddItems(){

            return Array.from(
                document.querySelectorAll(
                    ".add-item-checkbox:checked"
                )
            );

        }


        /* ======================================================
           UPDATE ADD SELECTION
        ====================================================== */

        function updateAddSelection(){

            const selected =
                getSelectedAddItems();

            const count =
                selected.length;


            if (addSelectionCount) {

                addSelectionCount.textContent =
                    count + " selected";

            }


            if (addSelectedButton) {

                addSelectedButton.disabled =
                    count === 0;

            }


            document
                .querySelectorAll(
                    "[data-add-card]"
                )
                .forEach(function(card){

                    const checkbox =
                        card.querySelector(
                            ".add-item-checkbox"
                        );


                    card.classList.toggle(
                        "selected",
                        Boolean(
                            checkbox &&
                            checkbox.checked
                        )
                    );

                });


            if (selectAllAddItems) {

                selectAllAddItems.checked =
                    addCheckboxes.length > 0 &&
                    count === addCheckboxes.length;

            }

        }


        /* ======================================================
           SELECT ALL ADD ITEMS
        ====================================================== */

        if (selectAllAddItems) {

            selectAllAddItems.addEventListener(
                "change",
                function(){

                    addCheckboxes.forEach(
                        function(checkbox){

                            checkbox.checked =
                                selectAllAddItems.checked;

                        }
                    );


                    updateAddSelection();

                }
            );

        }


        /* ======================================================
           INDIVIDUAL ADD CHECKBOXES
        ====================================================== */

        addCheckboxes.forEach(
            function(checkbox){

                checkbox.addEventListener(
                    "change",
                    updateAddSelection
                );

            }
        );


        /* ======================================================
           INITIAL STATE
        ====================================================== */

        updateContentSelection();

        updateReshuffleButton();

        updateAddSelection();

    }
);

</script>