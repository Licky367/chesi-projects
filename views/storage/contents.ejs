<% /*
 * ======================================================
 * STORAGE MODE
 * ======================================================
 *
 * AgroStore is identified by storage type.
 *
 * This is intentionally calculated here so the view
 * does not depend entirely on a virtual such as
 * storage.isAgroStore.
 */

const isAgroStore =
    storage &&
    String(storage.type || "")
        .trim()
        .toLowerCase() === "feeds";
%>


<div class="contents-header-top">

    <div>

        <h2>
            <%= storage.displayName || "Storage" %>
        </h2>

        <p class="contents-subtitle">

            <% if (isAgroStore) { %>

                Manage animal feeds and monitor
                the quantity remaining in this AgroStore.

            <% } else { %>

                Manage items allocated to this Room.

            <% } %>

        </p>

    </div>


    <a
        href="/storage/<%= dairy._id %>"
        class="back-storage"
    >
        ← Back to Storage
    </a>

</div>


<div class="storage-reference">

    <div class="reference-item">

        <span class="reference-label">
            Farm
        </span>

        <span>
            <%= dairy.name %>
        </span>

    </div>


    <div class="reference-item">

        <span class="reference-label">
            Farm Code
        </span>

        <span>
            <%= dairy.code %>
        </span>

    </div>


    <div class="reference-item">

        <span class="reference-label">

            <%= isAgroStore
                ? "AgroStore Number"
                : "Room Number"
            %>

        </span>

        <span>

            <%= isAgroStore
                ? Math.abs(storage.roomNumber)
                : storage.roomNumber
            %>

        </span>

    </div>

</div>


<% if (successMessage) { %>

    <div class="storage-message storage-success">

        <%= successMessage %>

    </div>

<% } %>


<% if (pageError) { %>

    <div class="storage-message storage-error">

        <%= pageError %>

    </div>

<% } %>



<button
    type="button"
    class="storage-tab <%= activeTab === "add" ? "" : "active" %>"
    data-tab="view"
>
    View Contents
</button>


<button
    type="button"
    class="storage-tab <%= activeTab === "add" ? "active" : "" %>"
    data-tab="add"
>
    Add Items
</button>



<div class="contents-summary">

    <span>

        <strong>
            <%= itemCount %>
        </strong>

        <%= itemCount === 1 ? "item" : "items" %>

        currently stored

    </span>

</div>



<% if (items && items.length > 0) { %>

    <!-- =================================================
       NORMAL ROOM MANAGEMENT
       =================================================

       Only non-feed storage gets omit + reshuffle.

       ================================================== -->

    <% if (!isAgroStore) { %>


        <form
            id="reshuffleForm"
            method="POST"
            action="/storage/<%= dairy._id %>/contents/<%= storage._id %>/reshuffle"
        >

            <div class="contents-management">

                <div class="management-left">

                    <label class="select-all-wrapper">

                        <input
                            type="checkbox"
                            id="selectAllContents"
                        >

                        Select All

                    </label>


                    <span
                        id="contentsSelectionCount"
                        class="selection-count"
                    >
                        0 selected
                    </span>

                </div>


                <div class="management-right">

                    <button
                        type="button"
                        id="openReshuffleButton"
                        class="storage-action-button reshuffle-button"
                        disabled
                    >
                        Reshuffle
                    </button>


                    <button
                        type="button"
                        id="omitButton"
                        class="storage-action-button omit-button"
                        disabled
                    >
                        Omit Selected
                    </button>

                </div>

            </div>



            <!-- ==========================================
               RESHUFFLE PANEL
               =========================================== -->

            <div
                id="reshufflePanel"
                class="reshuffle-panel"
            >

                <h3>
                    Reshuffle Selected Items
                </h3>


                <p>
                    Move the selected items to another
                    active Room on this farm.
                </p>


                <div class="reshuffle-form">

                    <div class="reshuffle-select-group">

                        <label for="destinationStorage">
                            Destination
                        </label>


                        <select
                            id="destinationStorage"
                            name="targetStorageId"
                            class="reshuffle-select"
                        >

                            <option value="">
                                Select destination...
                            </option>


                            <% if (
                                targetStorages &&
                                targetStorages.length > 0
                            ) { %>

                                <% targetStorages.forEach(
                                    function(destination)
                                { %>

                                    <option
                                        value="<%= destination._id %>"
                                    >

                                        <%= destination.displayName ||
                                            `Room ${destination.roomNumber}`
                                        %>

                                    </option>

                                <% }); %>

                            <% } else { %>

                                <option
                                    value=""
                                    disabled
                                >
                                    No other Rooms available
                                </option>

                            <% } %>

                        </select>

                    </div>


                    <button
                        type="submit"
                        id="reshuffleSubmitButton"
                        class="storage-action-button add-button"
                        disabled
                    >
                        Reshuffle Selected
                    </button>


                    <button
                        type="button"
                        id="cancelReshuffleButton"
                        class="storage-action-button omit-button"
                    >
                        Cancel
                    </button>

                </div>

            </div>



            <!-- ==========================================
               ROOM CONTENTS
               =========================================== -->

            <div class="contents-list">

                <% items.forEach(function(item) { %>

                    <div
                        class="content-card"
                        data-item-id="<%= item._id %>"
                    >

                        <div class="content-checkbox">

                            <input
                                type="checkbox"
                                class="content-item-checkbox"
                                name="itemIds"
                                value="<%= item._id %>"
                            >

                        </div>


                        <div class="content-icon">

                            <%= (
                                item.code !== null &&
                                item.code !== undefined &&
                                Number(item.code) > 0
                            )
                                ? "🐄"
                                : "🔧"
                            %>

                        </div>


                        <div class="content-information">

                            <div class="content-title-row">

                                <h3>
                                    <%= item.name || "Unnamed Item" %>
                                </h3>


                                <span
                                    class="content-type <%= (
                                        item.code !== null &&
                                        item.code !== undefined &&
                                        Number(item.code) > 0
                                    )
                                        ? "animal-type"
                                        : "asset-type"
                                    %>"
                                >

                                    <%= (
                                        item.code !== null &&
                                        item.code !== undefined &&
                                        Number(item.code) > 0
                                    )
                                        ? "Animal"
                                        : "Asset"
                                    %>

                                </span>

                            </div>



                            <div class="content-details">

                                <div class="content-detail">

                                    <span class="detail-label">
                                        Code
                                    </span>

                                    <span class="detail-value">
                                        <%= item.code ?? "—" %>
                                    </span>

                                </div>


                                <div class="content-detail">

                                    <span class="detail-label">
                                        Type
                                    </span>

                                    <span class="detail-value">
                                        <%= item.type || "—" %>
                                    </span>

                                </div>


                                <div class="content-detail">

                                    <span class="detail-label">
                                        Status
                                    </span>

                                    <span class="detail-value status-active">
                                        <%= item.status || "—" %>
                                    </span>

                                </div>


                                <div class="content-detail">

                                    <span class="detail-label">
                                        Dwell Number
                                    </span>

                                    <span class="detail-value">
                                        <%= item.dwellNumber ?? "—" %>
                                    </span>

                                </div>


                                <div class="content-detail">

                                    <span class="detail-label">
                                        Condition
                                    </span>

                                    <span class="detail-value">
                                        <%= item.condition || "—" %>
                                    </span>

                                </div>


                                <div class="content-detail">

                                    <span class="detail-label">
                                        Quantity
                                    </span>

                                    <span class="detail-value">

                                        <%= Number(
                                            item.quantity || 0
                                        ).toLocaleString() %>

                                        <%= item.unit || "unit" %>

                                    </span>

                                </div>


                                <div class="content-detail">

                                    <span class="detail-label">
                                        Current Worth
                                    </span>

                                    <span class="detail-value">

                                        <%= Number(
                                            item.currentWorth || 0
                                        ).toLocaleString() %>

                                    </span>

                                </div>

                            </div>



                            <% if (
                                item.code !== null &&
                                item.code !== undefined &&
                                Number(item.code) > 0
                            ) { %>

                                <p class="content-description">

                                    <strong>Gender:</strong>
                                    <%= item.gender || "—" %>

                                    &nbsp; • &nbsp;

                                    <strong>Age:</strong>
                                    <%= item.ageText || "—" %>

                                    &nbsp; • &nbsp;

                                    <strong>Milking:</strong>
                                    <%= item.isMilking ? "Yes" : "No" %>

                                </p>

                            <% } %>



                            <% if (item.description) { %>

                                <p class="content-description">
                                    <%= item.description %>
                                </p>

                            <% } %>

                        </div>

                    </div>

                <% }); %>

            </div>

        </form>



        <!-- ==========================================
           HIDDEN OMIT FORM
           =========================================== -->

        <form
            id="omitForm"
            method="POST"
            action="/storage/<%= dairy._id %>/contents/<%= storage._id %>/omit"
            style="display:none;"
        >

            <div id="omitInputs"></div>

        </form>



    <% } else { %>


        <!-- =================================================
           AGROSTORE CONTENTS
           =================================================

           NO OMIT
           NO RESHUFFLE

           ================================================== -->

        <div class="contents-list">

            <% items.forEach(function(item) { %>

                <div
                    class="content-card"
                    data-item-id="<%= item._id %>"
                >

                    <div class="content-icon">
                        🌾
                    </div>


                    <div class="content-information">

                        <div class="content-title-row">

                            <h3>
                                <%= item.name || "Unnamed Feed" %>
                            </h3>


                            <span class="content-type feed-type">
                                Feed
                            </span>

                        </div>



                        <div class="content-details">

                            <div class="content-detail">

                                <span class="detail-label">
                                    Code
                                </span>

                                <span class="detail-value">
                                    <%= item.code ?? "—" %>
                                </span>

                            </div>


                            <div class="content-detail">

                                <span class="detail-label">
                                    Feed Type
                                </span>

                                <span class="detail-value">
                                    <%= item.type || "feeds" %>
                                </span>

                            </div>


                            <div class="content-detail">

                                <span class="detail-label">
                                    Status
                                </span>

                                <span class="detail-value status-active">
                                    <%= item.status || "—" %>
                                </span>

                            </div>


                            <div class="content-detail">

                                <span class="detail-label">
                                    Quantity
                                </span>

                                <span class="detail-value">

                                    <%= Number(
                                        item.quantity || 0
                                    ).toLocaleString() %>

                                    <%= item.unit || "unit" %>

                                </span>

                            </div>

                        </div>



                        <!-- =================================
                           QUANTITY
                           ================================== -->

                        <div class="feed-quantity-section">

                            <div class="feed-quantity-header">

                                <span class="feed-quantity-title">
                                    Quantity Remaining
                                </span>


                                <span>

                                    <span class="feed-current-quantity">

                                        <%= Number(
                                            item.quantity || 0
                                        ).toLocaleString() %>

                                    </span>


                                    <span class="feed-unit">
                                        <%= item.unit || "unit" %>
                                    </span>

                                </span>

                            </div>



                            <form
                                class="quantity-form"
                                method="POST"
                                action="/storage/<%= dairy._id %>/contents/<%= storage._id %>/quantity"
                                data-feed-quantity-form
                            >

                                <input
                                    type="hidden"
                                    name="itemId"
                                    value="<%= item._id %>"
                                >



                                <div class="quantity-field">

                                    <label
                                        for="quantity-<%= item._id %>"
                                    >
                                        New Remaining Quantity
                                    </label>


                                    <input
                                        id="quantity-<%= item._id %>"
                                        class="quantity-input"
                                        type="number"
                                        name="quantity"
                                        min="0"
                                        max="<%= Number(item.quantity || 0) %>"
                                        step="any"
                                        value="<%= item.quantity ?? 0 %>"
                                        required
                                    >

                                </div>



                                <select
                                    class="quantity-unit"
                                    name="unit"
                                    aria-label="Feed unit"
                                >

                                    <%
                                        const currentUnit =
                                            String(
                                                item.unit || ""
                                            )
                                            .trim()
                                            .toLowerCase();
                                    %>


                                    <option
                                        value="kg"
                                        <%= currentUnit === "kg"
                                            ? "selected"
                                            : "" %>
                                    >
                                        kg
                                    </option>


                                    <option
                                        value="bales"
                                        <%= currentUnit === "bales"
                                            ? "selected"
                                            : "" %>
                                    >
                                        bales
                                    </option>


                                    <option
                                        value="bags"
                                        <%= currentUnit === "bags"
                                            ? "selected"
                                            : "" %>
                                    >
                                        bags
                                    </option>


                                    <option
                                        value="litres"
                                        <%= currentUnit === "litres"
                                            ? "selected"
                                            : "" %>
                                    >
                                        litres
                                    </option>


                                    <option
                                        value="units"
                                        <%= currentUnit === "units"
                                            ? "selected"
                                            : "" %>
                                    >
                                        units
                                    </option>

                                </select>



                                <button
                                    type="submit"
                                    class="quantity-save-button"
                                >
                                    Save
                                </button>

                            </form>



                            <p class="quantity-help">

                                Record the amount currently remaining.

                                The quantity can only be reduced from
                                the amount currently stored.

                                Setting the quantity to
                                <strong>0</strong>
                                automatically removes this feed from
                                the AgroStore.

                            </p>

                        </div>



                        <% if (item.description) { %>

                            <p class="content-description">
                                <%= item.description %>
                            </p>

                        <% } %>

                    </div>

                </div>

            <% }); %>

        </div>

    <% } %>



<% } else { %>


    <!-- =================================================
       EMPTY
       ================================================== -->

    <div class="empty-contents">

        <div class="empty-contents-icon">

            <%= isAgroStore ? "🌾" : "🏠" %>

        </div>


        <h3>

            <%= isAgroStore
                ? "AgroStore is Empty"
                : "No Items Found"
            %>

        </h3>


        <p>

            <% if (isAgroStore) { %>

                There are currently no feeds with remaining
                quantity in

                <strong>
                    <%= storage.displayName %>
                </strong>.

            <% } else { %>

                There are currently no items allocated to

                <strong>
                    <%= storage.displayName %>
                </strong>.

            <% } %>

        </p>

    </div>


<% } %>



<div class="add-header">

    <h3>

        Add Items to
        <%= storage.displayName || "Storage" %>

    </h3>


    <p>

        <% if (isAgroStore) { %>

            Select feeds belonging to this farm that are
            currently not allocated to a storage facility.

        <% } else { %>

            Select animals or assets belonging to this farm
            that are currently unallocated.

        <% } %>

    </p>

</div>



<form
    method="POST"
    action="/storage/<%= dairy._id %>/contents/<%= storage._id %>/add"
    id="addItemsForm"
>


    <% if (
        availableItems &&
        availableItems.length > 0
    ) { %>


        <div class="add-management">

            <div class="management-left">

                <label class="select-all-wrapper">

                    <input
                        type="checkbox"
                        id="selectAllAddItems"
                    >

                    Select All

                </label>


                <span
                    id="addSelectionCount"
                    class="selection-count"
                >
                    0 selected
                </span>

            </div>


            <div class="management-right">

                <button
                    type="submit"
                    id="addSelectedButton"
                    class="storage-action-button add-button"
                    disabled
                >
                    Add Selected
                </button>

            </div>

        </div>



        <div class="add-list">

            <% availableItems.forEach(function(item) { %>

                <div
                    class="add-card"
                    data-add-item-id="<%= item._id %>"
                >

                    <div class="add-checkbox">

                        <input
                            type="checkbox"
                            class="add-item-checkbox"
                            name="itemIds"
                            value="<%= item._id %>"
                        >

                    </div>


                    <div class="add-icon">

                        <%= isAgroStore
                            ? "🌾"
                            : (
                                item.code !== null &&
                                item.code !== undefined &&
                                Number(item.code) > 0
                            )
                                ? "🐄"
                                : "🔧"
                        %>

                    </div>


                    <div class="add-information">

                        <div class="add-title">

                            <h3>
                                <%= item.name || "Unnamed Item" %>
                            </h3>


                            <span
                                class="content-type <%= isAgroStore
                                    ? "feed-type"
                                    : (
                                        item.code !== null &&
                                        item.code !== undefined &&
                                        Number(item.code) > 0
                                    )
                                        ? "animal-type"
                                        : "asset-type"
                                %>"
                            >

                                <%= isAgroStore
                                    ? "Feed"
                                    : (
                                        item.code !== null &&
                                        item.code !== undefined &&
                                        Number(item.code) > 0
                                    )
                                        ? "Animal"
                                        : "Asset"
                                %>

                            </span>

                        </div>



                        <div class="add-details">

                            <div class="add-detail">

                                <span class="add-detail-label">
                                    Asset Code
                                </span>

                                <span class="add-detail-value">

                                    <%= item.assetCode ||
                                        item.code ||
                                        "—"
                                    %>

                                </span>

                            </div>


                            <div class="add-detail">

                                <span class="add-detail-label">
                                    Type
                                </span>

                                <span class="add-detail-value">
                                    <%= item.type || "—" %>
                                </span>

                            </div>


                            <div class="add-detail">

                                <span class="add-detail-label">
                                    Status
                                </span>

                                <span class="add-detail-value">
                                    <%= item.status || "—" %>
                                </span>

                            </div>


                            <div class="add-detail">

                                <span class="add-detail-label">
                                    Dwell Number
                                </span>

                                <span class="add-detail-value">
                                    —
                                </span>

                            </div>


                            <div class="add-detail">

                                <span class="add-detail-label">
                                    Quantity
                                </span>

                                <span class="add-detail-value">

                                    <%= Number(
                                        item.quantity || 0
                                    ).toLocaleString() %>

                                    <%= item.unit || "unit" %>

                                </span>

                            </div>


                            <% if (isAgroStore) { %>

                                <div class="add-detail">

                                    <span class="add-detail-label">
                                        Available Quantity
                                    </span>

                                    <span class="add-detail-value">

                                        <%= Number(
                                            item.quantity || 0
                                        ).toLocaleString() %>

                                        <%= item.unit || "unit" %>

                                    </span>

                                </div>

                            <% } %>

                        </div>

                    </div>

                </div>

            <% }); %>

        </div>


    <% } else { %>


        <div class="empty-contents">

            <div class="empty-contents-icon">

                <%= isAgroStore ? "🌾" : "📦" %>

            </div>


            <h3>

                <%= isAgroStore
                    ? "No Feeds Available"
                    : "No Items Available"
                %>

            </h3>


            <p>

                <% if (isAgroStore) { %>

                    There are currently no unallocated feed
                    items belonging to this farm.

                <% } else { %>

                    There are currently no unallocated items
                    belonging to this farm.

                <% } %>

            </p>

        </div>


    <% } %>


</form>