<style>

/* =========================================================
   DAIRY STORAGE
   PREMIUM GREEN + DISTANT ORANGE UI
========================================================= */

.storage-page{
    --green-950:#063b18;
    --green-900:#07551f;
    --green-800:#086326;
    --green-700:#0b702b;
    --green-600:#16803a;
    --green-500:#26934b;

    --green-soft:#edf8f0;
    --green-pale:#f6fbf7;

    --orange-600:#d96b16;
    --orange-500:#ed8127;
    --orange-soft:#fff3e8;

    --text-dark:#17301f;
    --text:#3f5547;
    --muted:#738178;

    --border:#e2ebe4;
    --white:#ffffff;

    max-width:1180px;
    margin:0 auto;
    padding:28px 24px 70px;
    color:var(--text-dark);
}


/* =========================================================
   PAGE HEADER
========================================================= */

.storage-header{
    position:relative;
    overflow:hidden;

    padding:32px 34px;

    border-radius:24px;

    background:
        radial-gradient(
            circle at 90% 20%,
            rgba(237,129,39,.16),
            transparent 24%
        ),
        linear-gradient(
            135deg,
            var(--green-950),
            var(--green-800)
        );

    box-shadow:
        0 18px 45px rgba(5,67,25,.14);

    color:white;
}

.storage-header::before{
    content:"";
    position:absolute;

    width:180px;
    height:180px;

    right:-70px;
    bottom:-95px;

    border-radius:50%;

    border:1px solid rgba(255,255,255,.08);
}

.storage-header::after{
    content:"";
    position:absolute;

    width:100px;
    height:100px;

    right:75px;
    top:-55px;

    border-radius:50%;

    background:rgba(237,129,39,.07);
}

.storage-header-top{
    position:relative;
    z-index:2;

    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:20px;
}

.storage-header h2{
    margin:0;

    font-size:clamp(25px,4vw,36px);
    line-height:1.15;

    font-weight:800;
    letter-spacing:-.6px;
}

.storage-subtitle{
    margin:10px 0 0;

    max-width:620px;

    color:rgba(255,255,255,.76);

    font-size:14px;
    line-height:1.6;
}


/* =========================================================
   STORAGE TABS
========================================================= */

.storage-tabs{
    display:flex;
    gap:10px;

    margin:24px 0 0;

    padding:7px;

    width:max-content;
    max-width:100%;

    border:1px solid var(--border);
    border-radius:16px;

    background:var(--white);

    box-shadow:
        0 8px 25px rgba(15,60,28,.06);
}

.storage-tab{
    display:flex;
    align-items:center;
    justify-content:center;
    gap:9px;

    min-width:145px;

    padding:12px 20px;

    border-radius:11px;

    color:var(--text);

    text-decoration:none;

    font-size:14px;
    font-weight:700;

    transition:
        background .2s ease,
        color .2s ease,
        transform .2s ease,
        box-shadow .2s ease;
}

.storage-tab:hover{
    color:var(--green-800);
    background:var(--green-pale);
}

.storage-tab.active{
    color:white;

    background:
        linear-gradient(
            135deg,
            var(--green-800),
            var(--green-600)
        );

    box-shadow:
        0 6px 16px rgba(8,99,38,.22);
}

.storage-tab.active:hover{
    color:white;
    transform:translateY(-1px);
}


/* =========================================================
   ACTION AREA
========================================================= */

.storage-actions{
    display:flex;
    justify-content:flex-end;

    margin:18px 0 22px;
}

.add-storage-button{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    gap:8px;

    min-width:130px;

    padding:12px 21px;

    border-radius:12px;

    background:
        linear-gradient(
            135deg,
            var(--orange-600),
            var(--orange-500)
        );

    color:white;

    text-decoration:none;

    font-size:14px;
    font-weight:800;

    box-shadow:
        0 8px 20px rgba(217,107,22,.18);

    transition:
        transform .2s ease,
        box-shadow .2s ease;
}

.add-storage-button::before{
    content:"+";

    display:flex;
    align-items:center;
    justify-content:center;

    width:20px;
    height:20px;

    border-radius:50%;

    background:rgba(255,255,255,.18);

    font-size:17px;
    line-height:1;
}

.add-storage-button:hover{
    color:white;

    transform:translateY(-2px);

    box-shadow:
        0 12px 25px rgba(217,107,22,.25);
}


/* =========================================================
   STORAGE LIST
========================================================= */

.storage-list{
    display:grid;

    grid-template-columns:
        repeat(
            auto-fill,
            minmax(290px,1fr)
        );

    gap:18px;

    margin-top:6px;
}


/* =========================================================
   STORAGE CARD
========================================================= */

.storage-card{
    position:relative;

    display:grid;

    grid-template-columns:72px minmax(0,1fr) auto;

    align-items:center;

    gap:16px;

    min-height:116px;

    padding:18px;

    overflow:hidden;

    border:1px solid var(--border);
    border-radius:20px;

    background:var(--white);

    color:inherit;

    text-decoration:none;

    box-shadow:
        0 7px 24px rgba(21,65,35,.055);

    transition:
        transform .22s ease,
        box-shadow .22s ease,
        border-color .22s ease;
}

.storage-card::before{
    content:"";

    position:absolute;

    left:0;
    top:0;
    bottom:0;

    width:4px;

    background:
        linear-gradient(
            to bottom,
            var(--green-700),
            var(--green-500)
        );

    transform:scaleY(.35);

    transform-origin:center;

    transition:transform .22s ease;
}

.storage-card:hover{
    transform:translateY(-4px);

    border-color:#c9dfcf;

    box-shadow:
        0 15px 35px rgba(21,65,35,.11);
}

.storage-card:hover::before{
    transform:scaleY(1);
}


/* =========================================================
   STORAGE ICON
========================================================= */

.storage-icon{
    display:flex;
    align-items:center;
    justify-content:center;

    width:72px;
    height:72px;

    flex-shrink:0;

    overflow:hidden;

    border-radius:18px;

    background:
        linear-gradient(
            145deg,
            var(--green-soft),
            #e2f2e7
        );

    border:1px solid #d7e9db;

    color:var(--green-800);

    font-size:31px;

    box-shadow:
        inset 0 1px 0 rgba(255,255,255,.8);
}

.storage-profile-image{
    width:100%;
    height:100%;

    display:block;

    object-fit:cover;

    transition:transform .35s ease;
}

.storage-card:hover .storage-profile-image{
    transform:scale(1.07);
}


/* =========================================================
   STORAGE INFORMATION
========================================================= */

.storage-information{
    min-width:0;
}

.storage-title{
    margin:0;

    color:var(--text-dark);

    font-size:17px;
    font-weight:800;

    line-height:1.3;

    white-space:nowrap;
    overflow:hidden;
    text-overflow:ellipsis;
}

.storage-title::after{
    content:"Storage";

    display:block;

    margin-top:6px;

    color:var(--muted);

    font-size:11px;
    font-weight:600;

    letter-spacing:.5px;
    text-transform:uppercase;
}


/* =========================================================
   VIEW BUTTON
========================================================= */

.storage-title-actions{
    display:flex;
    align-items:center;
    justify-content:flex-end;
}

.view-storage-button{
    display:inline-flex;
    align-items:center;
    justify-content:center;

    min-width:67px;

    padding:9px 13px;

    border-radius:10px;

    background:var(--green-pale);

    border:1px solid #dcebe0;

    color:var(--green-800);

    font-size:12px;
    font-weight:800;

    transition:
        background .2s ease,
        color .2s ease,
        transform .2s ease;
}

.view-storage-button::after{
    content:"→";

    margin-left:7px;

    font-size:14px;

    transition:transform .2s ease;
}

.storage-card:hover .view-storage-button{
    color:white;

    background:var(--green-700);

    border-color:var(--green-700);
}

.storage-card:hover .view-storage-button::after{
    transform:translateX(3px);
}


/* =========================================================
   EMPTY STATE
========================================================= */

.empty-storage{
    position:relative;

    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;

    min-height:330px;

    margin-top:8px;

    padding:50px 25px;

    overflow:hidden;

    text-align:center;

    border:1px dashed #cbdccf;
    border-radius:24px;

    background:
        radial-gradient(
            circle at 50% 0%,
            rgba(22,128,58,.07),
            transparent 45%
        ),
        var(--green-pale);
}

.empty-storage::before{
    content:"";

    position:absolute;

    width:180px;
    height:180px;

    left:-90px;
    bottom:-90px;

    border-radius:50%;

    background:rgba(237,129,39,.06);
}

.empty-storage::after{
    content:"";

    position:absolute;

    width:120px;
    height:120px;

    right:-55px;
    top:-55px;

    border-radius:50%;

    border:18px solid rgba(22,128,58,.035);
}

.empty-storage-icon{
    position:relative;
    z-index:2;

    display:flex;
    align-items:center;
    justify-content:center;

    width:86px;
    height:86px;

    margin-bottom:20px;

    border-radius:24px;

    background:white;

    border:1px solid #dcebe0;

    color:var(--green-700);

    font-size:37px;

    box-shadow:
        0 12px 28px rgba(18,75,35,.08);
}

.empty-storage h3{
    position:relative;
    z-index:2;

    margin:0;

    color:var(--green-950);

    font-size:21px;
    font-weight:800;
}

.empty-storage p{
    position:relative;
    z-index:2;

    max-width:450px;

    margin:10px auto 0;

    color:var(--muted);

    font-size:14px;
    line-height:1.7;
}


/* =========================================================
   RESPONSIVE
========================================================= */

@media (max-width:760px){

    .storage-page{
        padding:
            18px
            16px
            50px;
    }

    .storage-header{
        padding:25px 22px;

        border-radius:20px;
    }

    .storage-header h2{
        font-size:27px;
    }

    .storage-tabs{
        display:grid;

        grid-template-columns:1fr 1fr;

        width:100%;

        gap:6px;

        padding:6px;

        border-radius:14px;
    }

    .storage-tab{
        min-width:0;

        padding:11px 8px;

        font-size:13px;
    }

    .storage-actions{
        margin-top:16px;
    }

    .add-storage-button{
        width:100%;
    }

    .storage-list{
        grid-template-columns:1fr;

        gap:13px;
    }

    .storage-card{
        grid-template-columns:62px minmax(0,1fr);

        padding:15px;

        min-height:96px;

        border-radius:17px;
    }

    .storage-icon{
        width:62px;
        height:62px;

        border-radius:15px;

        font-size:27px;
    }

    .storage-title-actions{
        grid-column:2;

        justify-content:flex-start;

        margin-top:-5px;
    }

    .view-storage-button{
        padding:7px 11px;
    }

    .empty-storage{
        min-height:300px;

        border-radius:20px;
    }
}


@media (max-width:430px){

    .storage-header{
        padding:22px 19px;
    }

    .storage-header h2{
        font-size:24px;
    }

    .storage-subtitle{
        font-size:13px;
    }

    .storage-tab{
        gap:5px;

        padding:10px 5px;
    }

    .storage-card{
        grid-template-columns:56px minmax(0,1fr);
    }

    .storage-icon{
        width:56px;
        height:56px;
    }
}

</style>


<!-- ==================================================
     DAIRY STORAGE PAGE
================================================== -->

<div class="storage-page">


    <!-- ==================================================
         PAGE HEADER
    ================================================== -->

    <div class="storage-header">

        <div class="storage-header-top">

            <div>

                <h2>
                    <%= dairy && dairy.name
                        ? `${dairy.name} Storage`
                        : "Dairy Storage"
                    %>
                </h2>

                <p class="storage-subtitle">
                    Rooms and AgroStores available for this dairy farm.
                </p>

            </div>

        </div>

    </div>


    <!-- ==================================================
         STORAGE TABS
    ================================================== -->

    <div class="storage-tabs">

        <a
            href="/storage/<%= dairy._id %>?type=room"
            class="storage-tab <%= selectedType === "room" ? "active" : "" %>"
        >
            <span>🏠</span>
            <span>Rooms</span>
        </a>


        <a
            href="/storage/<%= dairy._id %>?type=agroStore"
            class="storage-tab <%= selectedType === "agroStore" ? "active" : "" %>"
        >
            <span>🏪</span>
            <span>AgroStores</span>
        </a>

    </div>


    <!-- ==================================================
         ADD STORAGE
    ================================================== -->

    <% if (user && user.role === "admin") { %>

        <div class="storage-actions">

            <a
                href="/storage/<%= dairy._id %>/add"
                class="add-storage-button"
            >
                Add Storage
            </a>

        </div>

    <% } %>


    <%
        /*
         * ==================================================
         * ACTIVE STORAGE TYPE
         * ==================================================
         */

        const activeStorageType =
            selectedType === "agroStore"
                ? "agroStore"
                : "room";


        const currentStorage =
            Array.isArray(storage)
                ? storage.filter(function (item) {
                    return item &&
                        item.type === activeStorageType;
                })
                : [];
    %>


    <!-- ==================================================
         STORAGE LIST
    ================================================== -->

    <% if (currentStorage.length > 0) { %>

        <div class="storage-list">

            <% currentStorage.forEach(function (item) { %>

                <%
                    const isAgroStore =
                        item.type === "agroStore";


                    const storageName =
                        item.name
                            ? item.name
                            : isAgroStore
                                ? `AgroStore ${Math.abs(item.roomNumber)}`
                                : `Room ${item.roomNumber}`;
                %>


                <!-- ==========================================
                     STORAGE CARD
                ========================================== -->

                <a
                    href="/storage/<%= dairy._id %>/contents/<%= item._id %>"
                    class="storage-card"
                    data-storage-id="<%= item._id %>"
                    data-storage-type="<%= item.type %>"
                >


                    <!-- ======================================
                         STORAGE IMAGE / ICON
                    ====================================== -->

                    <div class="storage-icon">

                        <% if (item.profileImage) { %>

                            <img
                                src="<%= item.profileImage %>"
                                alt="<%= storageName %>"
                                class="storage-profile-image"
                            >

                        <% } else if (isAgroStore) { %>

                            🏪

                        <% } else { %>

                            🏠

                        <% } %>

                    </div>


                    <!-- ======================================
                         STORAGE INFORMATION
                    ====================================== -->

                    <div class="storage-information">

                        <h3 class="storage-title">
                            <%= storageName %>
                        </h3>

                    </div>


                    <!-- ======================================
                         VIEW BUTTON
                    ====================================== -->

                    <div class="storage-title-actions">

                        <span class="view-storage-button">
                            View
                        </span>

                    </div>


                </a>

            <% }); %>

        </div>


    <% } else { %>


        <!-- ==================================================
             EMPTY STATE
        ================================================== -->

        <div class="empty-storage">

            <div class="empty-storage-icon">

                <% if (activeStorageType === "agroStore") { %>

                    🏪

                <% } else { %>

                    🏠

                <% } %>

            </div>


            <h3>

                No
                <%= activeStorageType === "agroStore"
                    ? "AgroStores"
                    : "Rooms"
                %>
                Found

            </h3>


            <p>

                <% if (activeStorageType === "agroStore") { %>

                    There are currently no AgroStores
                    for this dairy farm.

                <% } else { %>

                    There are currently no rooms
                    for this dairy farm.

                <% } %>

            </p>

        </div>

    <% } %>

</div>