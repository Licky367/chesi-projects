<%
/* ==========================================================
   AGROSTORE CONTENTS PAGE
   ==========================================================

   PURPOSE
   ----------------------------------------------------------
   Display the contents of the current AgroStore.

   CURRENT CONTENTS
   ----------------------------------------------------------
   A Dairy is considered CURRENT CONTENT when:

       dairy.dwellNumber === agroStore.roomNumber

   ADD ITEMS
   ----------------------------------------------------------
   A Dairy is available to ADD when:

       dairy.assetCode === agroStore.assetCode

   AND

       dairy.dwellNumber !== agroStore.roomNumber

   ADMIN
   ----------------------------------------------------------
   Only users with:

       user.role === "admin"

   can see the "Add Item" button.

   DISPLAY
   ----------------------------------------------------------
   Each dairy item displays ONLY:

       - profile image / avatar
       - dairy name
       - record type

   ========================================================== */


/* ==========================================================
   SAFE DATA
   ========================================================== */

const currentAgroStore =
    agroStore || storage || null;

const allDairies =
    Array.isArray(dairies)
        ? dairies
        : [];


/* ==========================================================
   ADMIN CHECK
   ========================================================== */

const isAdmin =
    user &&
    user.role === "admin";


/* ==========================================================
   AGROSTORE VALUES
   ========================================================== */

const agroStoreRoomNumber =
    currentAgroStore &&
    currentAgroStore.roomNumber !== null &&
    currentAgroStore.roomNumber !== undefined
        ? currentAgroStore.roomNumber
        : null;

const agroStoreAssetCode =
    currentAgroStore &&
    currentAgroStore.assetCode !== null &&
    currentAgroStore.assetCode !== undefined
        ? currentAgroStore.assetCode
        : null;


/* ==========================================================
   CURRENT CONTENTS
   ----------------------------------------------------------
   Only dairies whose dwellNumber is equal to the
   AgroStore roomNumber.
   ========================================================== */

const currentContents =
    allDairies.filter(function (item) {

        if (!item) {
            return false;
        }

        if (
            agroStoreRoomNumber === null ||
            agroStoreRoomNumber === undefined
        ) {
            return false;
        }

        if (
            item.dwellNumber === null ||
            item.dwellNumber === undefined
        ) {
            return false;
        }

        return String(item.dwellNumber) ===
               String(agroStoreRoomNumber);
    });


/* ==========================================================
   ADD ITEMS
   ----------------------------------------------------------
   Only dairies whose assetCode matches the AgroStore
   assetCode AND whose dwellNumber does not match the
   AgroStore roomNumber.
   ========================================================== */

const addItems =
    allDairies.filter(function (item) {

        if (!item) {
            return false;
        }

        if (
            agroStoreAssetCode === null ||
            agroStoreAssetCode === undefined
        ) {
            return false;
        }

        if (
            item.assetCode === null ||
            item.assetCode === undefined
        ) {
            return false;
        }

        const sameAssetCode =
            String(item.assetCode) ===
            String(agroStoreAssetCode);

        const differentDwellNumber =
            String(item.dwellNumber) !==
            String(agroStoreRoomNumber);

        return (
            sameAssetCode &&
            differentDwellNumber
        );
    });


/* ==========================================================
   PROFILE IMAGE HELPER
   ========================================================== */

function getProfileImage(item) {

    if (
        item &&
        item.profileImage &&
        typeof item.profileImage === "string" &&
        item.profileImage.trim() !== ""
    ) {
        return item.profileImage;
    }

    return null;
}


/* ==========================================================
   NAME HELPER
   ========================================================== */

function getDairyName(item) {

    if (
        item &&
        item.name &&
        String(item.name).trim() !== ""
    ) {
        return item.name;
    }

    if (
        item &&
        item.code !== null &&
        item.code !== undefined
    ) {
        return `Dairy ${item.code}`;
    }

    return "Unnamed Dairy";
}


/* ==========================================================
   RECORD TYPE HELPER
   ========================================================== */

function getRecordType(item) {

    if (!item) {
        return "Dairy";
    }

    /*
     * Prefer an existing recordType/type value when supplied.
     */

    if (
        item.recordType &&
        String(item.recordType).trim() !== ""
    ) {
        return item.recordType;
    }

    if (
        item.type &&
        String(item.type).trim() !== ""
    ) {
        return item.type;
    }

    /*
     * A negative dairy code represents a Dairy Farm.
     * Positive codes represent animals.
     * For this page, the item itself is treated as Dairy
     * when no more specific type is available.
     */

    return "Dairy";
}

%>


<style>

/* ==========================================================
   AGROSTORE CONTENTS PAGE
   ========================================================== */

.storage-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 20px;
    color: #26332a;
}


/* ==========================================================
   PAGE HEADER
   ========================================================== */

.storage-header {
    margin-bottom: 22px;
}

.storage-header-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 15px;
}

.storage-header h2 {
    margin: 0;
    color: #0b5d1e;
    font-size: 26px;
    font-weight: 700;
}

.storage-subtitle {
    margin: 6px 0 0;
    color: #66736a;
    font-size: 14px;
    line-height: 1.5;
}


/* ==========================================================
   FARM INFORMATION
   ========================================================== */

.farm-reference {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-top: 12px;
    padding: 7px 11px;
    background: #eaf5ed;
    border: 1px solid #cfe3d3;
    border-radius: 8px;
    color: #0b5d1e;
    font-size: 13px;
    font-weight: 600;
}

.farm-reference-label {
    color: #6b796f;
    font-weight: 500;
}


/* ==========================================================
   TABS HEADER
   ========================================================== */

.storage-tabs {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 18px;
    padding: 5px;
    background: #f3f8f4;
    border: 1px solid #dce9df;
    border-radius: 10px;
}

.storage-tab {
    flex: 1;
    min-height: 42px;
    padding: 8px 14px;
    border: 1px solid transparent;
    border-radius: 7px;
    background: transparent;
    color: #637068;
    font-size: 14px;
    font-weight: 700;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    transition:
        background 0.2s ease,
        color 0.2s ease,
        border-color 0.2s ease;
}

.storage-tab:hover {
    background: #e6f3e9;
    color: #0b5d1e;
}

.storage-tab.active {
    background: #ffffff;
    border-color: #cfe3d3;
    color: #0b5d1e;
    box-shadow: 0 2px 7px rgba(11, 93, 30, 0.07);
}


/* ==========================================================
   ACTION BAR
   ========================================================== */

.storage-action-bar {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    margin-bottom: 18px;
}


/* ==========================================================
   ADD ITEM BUTTON
   ========================================================== */

.add-item-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 40px;
    padding: 0 17px;
    border: none;
    border-radius: 8px;
    background: #0b5d1e;
    color: #ffffff;
    text-decoration: none;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    transition:
        background 0.2s ease,
        transform 0.15s ease;
}

.add-item-button:hover {
    background: #084817;
}

.add-item-button:active {
    transform: translateY(1px);
}


/* ==========================================================
   SUMMARY
   ========================================================== */

.storage-summary {
    display: flex;
    align-items: center;
    margin: 16px 0;
    color: #637068;
    font-size: 14px;
}

.storage-summary strong {
    color: #0b5d1e;
    font-size: 20px;
    margin-right: 4px;
}


/* ==========================================================
   STORAGE LIST
   ========================================================== */

.storage-list {
    display: grid;
    grid-template-columns:
        repeat(auto-fit, minmax(300px, 1fr));
    gap: 14px;
}


/* ==========================================================
   DAIRY CARD
   ========================================================== */

.storage-card {
    display: flex;
    align-items: center;
    gap: 13px;
    min-width: 0;
    padding: 14px;
    background: #ffffff;
    border: 1px solid #dce9df;
    border-radius: 12px;
    text-decoration: none;
    color: inherit;
    box-shadow:
        0 4px 13px rgba(11, 93, 30, 0.05);
    transition:
        transform 0.2s ease,
        box-shadow 0.2s ease,
        border-color 0.2s ease;
}

.storage-card:hover {
    transform: translateY(-2px);
    border-color: #a9c9b0;
    box-shadow:
        0 7px 18px rgba(11, 93, 30, 0.09);
}


/* ==========================================================
   PROFILE IMAGE
   ========================================================== */

.storage-avatar {
    width: 58px;
    height: 58px;
    min-width: 58px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: #eaf5ed;
    border: 1px solid #cfe3d3;
    color: #0b5d1e;
    font-size: 22px;
    font-weight: 700;
}

.storage-avatar img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
}


/* ==========================================================
   AVATAR FALLBACK
   ========================================================== */

.storage-avatar-fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
}


/* ==========================================================
   INFORMATION
   ========================================================== */

.storage-information {
    min-width: 0;
    flex: 1;
}


/* ==========================================================
   DAIRY NAME
   ========================================================== */

.storage-name {
    margin: 0 0 5px;
    overflow: hidden;
    color: #0b5d1e;
    font-size: 16px;
    font-weight: 700;
    line-height: 1.3;
    text-overflow: ellipsis;
    white-space: nowrap;
}


/* ==========================================================
   RECORD TYPE
   ========================================================== */

.storage-record-type {
    display: inline-flex;
    align-items: center;
    padding: 4px 8px;
    border-radius: 14px;
    background: #edf5ef;
    color: #52705a;
    font-size: 11px;
    font-weight: 700;
}


/* ==========================================================
   EMPTY STATE
   ========================================================== */

.empty-storage {
    background: #ffffff;
    border: 1px dashed #b9cfbd;
    border-radius: 14px;
    padding: 45px 20px;
    text-align: center;
    box-shadow:
        0 4px 14px rgba(11, 93, 30, 0.04);
}

.empty-storage-icon {
    width: 64px;
    height: 64px;
    margin: 0 auto 15px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: #eaf5ed;
    font-size: 28px;
}

.empty-storage h3 {
    margin: 0 0 8px;
    color: #0b5d1e;
    font-size: 20px;
}

.empty-storage p {
    margin: 0;
    color: #718078;
    font-size: 14px;
    line-height: 1.5;
}


/* ==========================================================
   RESPONSIVE
   ========================================================== */

@media (max-width: 700px) {

    .storage-page {
        padding: 15px;
    }

    .storage-header h2 {
        font-size: 23px;
    }

    .storage-tabs {
        gap: 5px;
    }

    .storage-tab {
        min-height: 40px;
        padding: 8px 9px;
        font-size: 12px;
    }

    .storage-list {
        grid-template-columns: 1fr;
    }

    .storage-card {
        padding: 13px;
    }

}


/* ==========================================================
   VERY SMALL SCREENS
   ========================================================== */

@media (max-width: 400px) {

    .storage-tabs {
        flex-direction: column;
    }

    .storage-tab {
        width: 100%;
    }

    .storage-avatar {
        width: 50px;
        height: 50px;
        min-width: 50px;
    }

    .storage-name {
        font-size: 15px;
    }

}

</style>


<div class="page storage-page">


    <!-- ==================================================
         PAGE HEADER
         ================================================== -->

    <div class="storage-header">

        <div class="storage-header-top">

            <div>

                <h2>
                    <%= currentAgroStore && currentAgroStore.name
                        ? currentAgroStore.name
                        : "AgroStore"
                    %>
                </h2>

                <p class="storage-subtitle">
                    Manage the dairies currently assigned to this AgroStore.
                </p>

            </div>

        </div>


        <% if (dairy) { %>

            <div class="farm-reference">

                <span class="farm-reference-label">
                    Farm Code
                </span>

                <span>
                    <%= dairy.code %>
                </span>

            </div>

        <% } %>

    </div>


    <!-- ==================================================
         TABS
         ================================================== -->

    <div class="storage-tabs">

        <a
            href="?tab=current"
            class="storage-tab <%= (!tab || tab === "current")
                ? "active"
                : ""
            %>"
        >
            Current Contents
        </a>


        <a
            href="?tab=add"
            class="storage-tab <%= tab === "add"
                ? "active"
                : ""
            %>"
        >
            Add Items
        </a>

    </div>


    <!-- ==================================================
         CURRENT CONTENTS
         ================================================== -->

    <% if (!tab || tab === "current") { %>


        <div class="storage-action-bar">

            <% if (isAdmin) { %>

                <a
                    href="/storage/<%= dairy._id %>/contents/<%= currentAgroStore._id %>/add"
                    class="add-item-button"
                >
                    Add Item
                </a>

            <% } %>

        </div>


        <div class="storage-summary">

            <span>

                <strong>
                    <%= currentContents.length %>
                </strong>

                <%= currentContents.length === 1
                    ? "item"
                    : "items"
                %>

            </span>

        </div>


        <% if (currentContents.length > 0) { %>

            <div class="storage-list">


                <% currentContents.forEach(function (item) { %>

                    <%
                        const image =
                            getProfileImage(item);

                        const itemName =
                            getDairyName(item);

                        const recordType =
                            getRecordType(item);
                    %>


                    <a
                        href="/dairy/<%= item._id %>"
                        class="storage-card"
                    >


                        <!-- ==================================
                             PROFILE IMAGE / AVATAR
                             ================================== -->

                        <div class="storage-avatar">

                            <% if (image) { %>

                                <img
                                    src="<%= image %>"
                                    alt="<%= itemName %>"
                                >

                            <% } else { %>

                                <span
                                    class="storage-avatar-fallback"
                                    aria-hidden="true"
                                >
                                    🐄
                                </span>

                            <% } %>

                        </div>


                        <!-- ==================================
                             DAIRY INFORMATION
                             ================================== -->

                        <div class="storage-information">

                            <h3 class="storage-name">
                                <%= itemName %>
                            </h3>

                            <span class="storage-record-type">
                                <%= recordType %>
                            </span>

                        </div>


                    </a>


                <% }); %>


            </div>


        <% } else { %>


            <div class="empty-storage">

                <div class="empty-storage-icon">
                    🏪
                </div>

                <h3>
                    No Current Contents
                </h3>

                <p>
                    There are currently no dairies assigned
                    to this AgroStore.
                </p>

            </div>


        <% } %>


    <!-- ==================================================
         ADD ITEMS
         ================================================== -->

    <% } else if (tab === "add") { %>


        <% if (isAdmin) { %>

            <div class="storage-summary">

                <span>

                    <strong>
                        <%= addItems.length %>
                    </strong>

                    <%= addItems.length === 1
                        ? "item available"
                        : "items available"
                    %>

                </span>

            </div>


            <% if (addItems.length > 0) { %>


                <div class="storage-list">


                    <% addItems.forEach(function (item) { %>

                        <%
                            const image =
                                getProfileImage(item);

                            const itemName =
                                getDairyName(item);

                            const recordType =
                                getRecordType(item);
                        %>


                        <a
                            href="/storage/<%= dairy._id %>/contents/<%= currentAgroStore._id %>/add/<%= item._id %>"
                            class="storage-card"
                        >


                            <!-- ==============================
                                 PROFILE IMAGE / AVATAR
                                 ============================== -->

                            <div class="storage-avatar">

                                <% if (image) { %>

                                    <img
                                        src="<%= image %>"
                                        alt="<%= itemName %>"
                                    >

                                <% } else { %>

                                    <span
                                        class="storage-avatar-fallback"
                                        aria-hidden="true"
                                    >
                                        🐄
                                    </span>

                                <% } %>

                            </div>


                            <!-- ==============================
                                 DAIRY INFORMATION
                                 ============================== -->

                            <div class="storage-information">

                                <h3 class="storage-name">
                                    <%= itemName %>
                                </h3>

                                <span class="storage-record-type">
                                    <%= recordType %>
                                </span>

                            </div>


                        </a>


                    <% }); %>


                </div>


            <% } else { %>


                <div class="empty-storage">

                    <div class="empty-storage-icon">
                        ➕
                    </div>

                    <h3>
                        No Items Available
                    </h3>

                    <p>
                        There are no dairies with the same
                        AgroStore asset code outside the
                        current AgroStore room.
                    </p>

                </div>


            <% } %>


        <% } else { %>


            <!-- ==========================================
                 NON-ADMIN ADD ITEMS
                 ========================================== -->

            <div class="empty-storage">

                <div class="empty-storage-icon">
                    🔒
                </div>

                <h3>
                    Admin Access Required
                </h3>

                <p>
                    Only an administrator can add items
                    to this AgroStore.
                </p>

            </div>


        <% } %>


    <% } else { %>


        <!-- ==================================================
             INVALID TAB
             ================================================== -->

        <div class="empty-storage">

            <div class="empty-storage-icon">
                🏪
            </div>

            <h3>
                No Content Found
            </h3>

            <p>
                The requested storage tab does not exist.
            </p>

        </div>


    <% } %>


</div>