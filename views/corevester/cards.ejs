<% /*

PRODUCT HORIZONTAL CARDS

FILE:
views/products-patials/cards.ejs

PURPOSE:
Compact horizontal Product navigator.

Product data is received through:

    products
 
Each card displays:

    - Product image
    - Product name
    - Available units
    - Unit selling price

Clicking the card opens:

    /products/:id

PRODUCT MODEL FIELDS:

image
    Product display image

name
    Product name

units
    Available product quantity

unitSellPrice
    Selling price per unit

isActive
    Determines whether the product is displayed

IMPORTANT:

The controller already handles:

    - Category filtering
    - Search filtering

This partial only handles the presentation
of the products it receives.

CARDS DO NOT OPEN A POST MODAL.

*/ %>

<%
/* ======================================================
SAFE PRODUCT ARRAY
====================================================== */

const productList =
    Array.isArray(products)
        ? products
        : [];


/* ======================================================
   ONLY ACTIVE PRODUCTS
====================================================== */

const availableProducts =
    productList.filter(function (product) {

        if (!product) {
            return false;
        }

        return product.isActive === true;

    });

%>

<% if (availableProducts.length) { %>

<section
    class="product-feed-strip"
    aria-label="Available products"
><!-- =====================================================
     SECTION HEADER
===================================================== -->

<div class="product-feed-strip-header">


    <div class="product-feed-strip-title">

        <strong>
            Products currently available
        </strong>

    </div>


    <div class="product-feed-strip-description">

        Select a product below to view its details.

    </div>

</div>



<!-- =====================================================
     HORIZONTAL PRODUCT SCROLL
===================================================== -->

<div
    class="product-feed-scroll"
    role="list"
    aria-label="Available products"
>


    <% availableProducts.forEach(function (product) { %>

        <%
            /* =================================================
               SAFETY CHECK
            ================================================= */

            if (
                !product ||
                !product._id
            ) {
                return;
            }


            /* =================================================
               PRODUCT NAME
            ================================================= */

            const productName =
                product.name ||
                "Unnamed Product";


            /* =================================================
               PRODUCT IMAGE
            ================================================= */

            const productImage =
                product.image ||
                (
                    "https://ui-avatars.com/api/?name=" +
                    encodeURIComponent(
                        productName
                    ) +
                    "&background=e8f5ee&color=198754"
                );


            /* =================================================
               AVAILABLE UNITS
            ================================================= */

            let productUnitsText = "";


            if (
                product.units !== null &&
                product.units !== undefined &&
                product.units !== ""
            ) {

                const units =
                    Number(product.units);


                if (
                    Number.isFinite(units)
                ) {

                    productUnitsText =
                        units.toLocaleString(
                            "en-KE",
                            {
                                maximumFractionDigits: 2
                            }
                        );

                }

            }


            /* =================================================
               UNIT SELLING PRICE
            ================================================= */

            let productPriceText = "";


            if (
                product.unitSellPrice !== null &&
                product.unitSellPrice !== undefined &&
                product.unitSellPrice !== ""
            ) {

                const unitSellPrice =
                    Number(
                        product.unitSellPrice
                    );


                if (
                    Number.isFinite(unitSellPrice)
                ) {

                    productPriceText =
                        "KES " +
                        unitSellPrice.toLocaleString(
                            "en-KE",
                            {
                                minimumFractionDigits: 2,
                                maximumFractionDigits: 2
                            }
                        );

                }

            }
        %>



        <!-- =================================================
             PRODUCT CARD
        ================================================== -->

        <a
            href="/products/<%= product._id %>"
            class="product-feed-card"
            role="listitem"
            aria-label="View <%= productName %>"
        >


            <!-- =============================================
                 PRODUCT IMAGE
            ============================================== -->

            <div class="product-feed-image-wrap">

                <img
                    src="<%= productImage %>"
                    alt="<%= productName %>"
                    class="product-feed-image"
                    loading="lazy"
                >

            </div>



            <!-- =============================================
                 PRODUCT INFORMATION
            ============================================== -->

            <div class="product-feed-content">


                <!-- =========================================
                     PRODUCT NAME
                ========================================== -->

                <div class="product-feed-name">

                    <%= productName %>

                </div>



                <!-- =========================================
                     PRODUCT TYPE
                ========================================== -->

                <div class="product-feed-type">

                    <span
                        class="product-feed-type-icon"
                        aria-hidden="true"
                    >
                        📦
                    </span>

                    <span>
                        Product
                    </span>

                </div>



                <!-- =========================================
                     AVAILABLE UNITS
                ========================================== -->

                <% if (productUnitsText) { %>

                    <div class="product-feed-quantity">

                        <span
                            class="product-feed-quantity-label"
                        >
                            Available:
                        </span>

                        <span>
                            <%= productUnitsText %>
                        </span>

                    </div>

                <% } %>



                <!-- =========================================
                     UNIT SELLING PRICE
                ========================================== -->

                <% if (productPriceText) { %>

                    <div class="product-feed-price">

                        <span
                            class="product-feed-price-label"
                        >
                            Price:
                        </span>

                        <span>
                            <%= productPriceText %>
                        </span>

                    </div>

                <% } %>


            </div>


        </a>


    <% }); %>


</div>

</section><style>

/* ==========================================================
   PRODUCT STRIP
========================================================== */

