<div style="max-width:1300px; margin:0 auto; padding:20px;">
    <div style="display:flex; justify-content:space-between; flex-wrap:wrap; gap:15px; margin-bottom:20px;"><h1 style="margin:0; font-size:22px; color:#0a4d1e;">Key In Products</h1><div style="background:white; border:1.5px solid #0a4d1e; border-radius:30px; padding:8px 16px; font-size:12px;">STOCK: <%= stockList.length %> | MARKET: <%= products.length %></div></div>
    <div style="display:grid; grid-template-columns:380px 1fr; gap:20px; align-items:start;">
        <div style="background:white; border-radius:16px; border-top:4px solid #0a4d1e; padding:20px;">
            <h3 style="margin:0 0 15px 0; color:#0a4d1e;">NEW MARKET PRODUCT</h3>
            <form onsubmit="createProduct(event)" style="display:flex; flex-direction:column; gap:14px;">
                <div><label style="font-size:11px; font-weight:800;">SELECT FROM STOCK *</label><select id="stockSelect" name="name" required onchange="onStockChange()" style="width:100%; margin-top:6px; padding:12px; border-radius:10px; border:1.5px solid #c5e1a5; background:#f9fbe7;"><option value="">-- Choose Stock --</option><% stockList.forEach(s=>{ %><option value="<%= s.name %>" data-units="<%= s.units %>" data-buy="<%= s.unitBuyPrice %>"><%= s.name %> (<%= s.units %> @ KES <%= s.unitBuyPrice %>)</option><% }) %></select><p id="stockInfo" style="margin:6px 0 0 0; font-size:11px; color:#2e7d32; display:none;"></p></div>
                <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px;"><div><label style="font-size:11px;">CATEGORY *</label><input name="category" required style="width:100%; margin-top:6px; padding:12px; border-radius:10px; border:1.5px solid #ddd;"></div><div><label style="font-size:11px;">UNITS *</label><input type="number" name="units" id="unitsInput" required min="1" style="width:100%; margin-top:6px; padding:12px; border-radius:10px; border:1.5px solid #ddd;"></div></div>
                <div><label style="font-size:11px;">SELLING PRICE *</label><input type="number" name="unitSellPrice" id="sellPrice" required min="0" oninput="updateProfit()" style="width:100%; margin-top:6px; padding:12px; border-radius:10px; border:1.5px solid #ddd;"><p id="profitInfo" style="margin:6px 0 0 0; font-size:11px; display:none;"></p></div>
                <div><label style="font-size:11px;">IMAGE URL</label><input name="image" style="width:100%; margin-top:6px; padding:12px; border-radius:10px; border:1.5px solid #ddd;"></div>
                <button type="submit" style="padding:14px; background:#0a4d1e; color:white; border:none; border-radius:12px; font-weight:800; cursor:pointer;">PUT ON MARKET</button>
            </form>
        </div>
        <div><h3 style="margin:0 0 12px 0; font-size:13px;">ON MARKETPLACE (<%= products.length %>)</h3><div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(220px, 1fr)); gap:14px;"><% products.forEach(p=>{ %><div style="background:white; border-radius:14px; border:1px solid #e8f5e9; overflow:hidden;"><div style="height:130px; background:#f6fbf6; display:flex; align-items:center; justify-content:center; position:relative;"><% if(p.image){ %><img src="<%= p.image %>" style="width:100%; height:100%; object-fit:cover;"><% } else { %><i class="fas fa-box-open" style="font-size:36px; color:#a5d6a7;"></i><% } %><span style="position:absolute; top:8px; left:8px; background:white; border:1px solid #0a4d1e; font-size:10px; padding:3px 8px; border-radius:20px;"><%= p.units %> units</span></div><div style="padding:12px;"><p style="margin:0; font-size:10px; color:#2e7d32;"><%= p.category %></p><p style="margin:4px 0 0 0; font-size:14px; font-weight:700;"><%= p.name %></p></div><div style="padding:0 12px 12px 12px;"><button type="button" onclick="deleteProduct('<%= p._id %>')" style="width:100%; padding:8px; background:white; border:1.5px solid #ffcdd2; color:#c62828; border-radius:8px; cursor:pointer;">REMOVE</button></div></div><% }) %></div></div>
    </div>
</div>
<script>
var currentBuy=0,currentMax=0;
function onStockChange(){ var sel=document.getElementById('stockSelect'); var opt=sel.options[sel.selectedIndex]; if(!opt.value){ document.getElementById('stockInfo').style.display='none'; return; } currentMax=parseInt(opt.dataset.units); currentBuy=parseFloat(opt.dataset.buy); document.getElementById('stockInfo').style.display='block'; document.getElementById('stockInfo').innerHTML='Available: '+currentMax+' | Buy: KES '+currentBuy; document.getElementById('unitsInput').max=currentMax; updateProfit(); }
function updateProfit(){ var sell=parseFloat(document.getElementById('sellPrice').value); var info=document.getElementById('profitInfo'); if(!sell||!currentBuy){ info.style.display='none'; return; } var profit=sell-currentBuy; info.style.display='block'; info.style.color=profit>=0?'#2e7d32':'#c62828'; info.innerHTML='Profit: KES '+profit+' ('+Math.round((profit/currentBuy)*100)+'%)'; }
function createProduct(e){ e.preventDefault(); var fd=Object.fromEntries(new FormData(e.target)); fd.units=parseInt(fd.units); fd.unitSellPrice=parseFloat(fd.unitSellPrice); fetch('/admin/products/create',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(fd)}).then(r=>r.json()).then(d=>{ if(d.success) location.reload(); else alert(d.message); }); }
function deleteProduct(id){ if(!confirm('Remove from market?')) return; fetch('/admin/products/'+id,{method:'DELETE'}).then(r=>r.json()).then(d=>{ if(d.success) location.reload(); else alert(d.message); }); }
</script>