<!-- =========================================================
   HEADER
========================================================= -->

<div class="header">


    <!-- =====================================================
       LOGO
    ====================================================== -->

    <a
        href="<%= homeLink %>"

        class="header-logo-link"

        aria-label="Home"
    >

        <img
            src="/images/cfp-logo.png"

            alt="CFP Logo"

            class="header-logo"
        >

    </a>


    <!-- =====================================================
       HEADER TITLE
    ====================================================== -->

    <div class="header-title">

        <span class="header-title-text">
            <%= headerTitle %>
        </span>

    </div>


</div>