<div style="max-width:1100px; margin:0 auto; padding:20px; box-sizing:border-box;">

    <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px; margin-bottom:18px;">
        <div>
            <h1 style="margin:0; font-size:24px; font-weight:900; color:#0a4d1e;">My Packages</h1>
            <p style="margin:4px 0 0 0; font-size:12px; color:#666;"><%= packages.length %> orders • Packages contain cart items you ordered</p>
        </div>
        <a href="/products" style="padding:10px 18px; background:#0a4d1e; color:white; text-decoration:none; border-radius:30px; font-size:12px; font-weight:700;">+ New Order</a>
    </div>

    <% if(packages.length===0){ %>
        <div style="background:white; border-radius:16px; padding:60px 20px; text-align:center; border:2px dashed #c5e1a5;">
            <i class="fas fa-box-open" style="font-size:48px; color:#a5d6a7;"></i>
            <p style="margin:12px 0 0 0; color:#777; font-size:14px;">No packages yet. Add items to bag and click Order Now.</p>
            <a href="/products" style="display:inline-block; margin-top:14px; padding:10px 20px; background:#0a4d1e; color:white; text-decoration:none; border-radius:20px; font-size:12px; font-weight:700;">Go to Shop</a>
        </div>
    <% } %>

    <div style="display:flex; flex-direction:column; gap:14px;">
        <% packages.forEach(pkg=>{ %>
            <a href="/packages/<%= pkg._id %>" style="text-decoration:none; color:inherit;">
                <div style="background:white; border-radius:14px; border:1px solid #e8f5e9; box-shadow:0 3px 12px rgba(0,0,0,0.05); padding:14px; display:flex; gap:14px; align-items:center; transition:0.2s;" onmouseover="this.style.boxShadow='0 8px 20px rgba(0,0,0,0.08)'" onmouseout="this.style.boxShadow='0 3px 12px rgba(0,0,0,0.05)'">

                    <!-- Icon -->
                    <div style="width:56px; height:56px; background:#e8f5e9; border-radius:12px; display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                        <i class="fas fa-box" style="color:#0a4d1e; font-size:20px;"></i>
                    </div>

                    <div style="flex:1;">
                        <div style="display:flex; justify-content:space-between; align-items:start; gap:10px;">
                            <div>
                                <p style="margin:0; font-size:13px; font-weight:800; color:#111;">Package #<%= pkg._id.toString().slice(-6).toUpperCase() %> • <%= pkg.items.length %> items</p>
                                <p style="margin:2px 0 0 0; font-size:11px; color:#888;"><%= new Date(pkg.createdAt).toLocaleString() %> • <span style="background:<%= pkg.status==='pending'? '#fff3e0' : pkg.status==='confirmed'? '#e8f5e9' : '#e3f2fd' %>; color:<%= pkg.status==='pending'? '#e65100' : pkg.status==='confirmed'? '#0a4d1e' : '#1565c0' %>; padding:2px 8px; border-radius:10px; font-weight:700; text-transform:uppercase;"><%= pkg.status %></span></p>
                            </div>
                            <p style="margin:0; font-size:15px; font-weight:900; color:#0a4d1e;">KES <%= pkg.totalAmount.toLocaleString() %></p>
                        </div>

                        <!-- Items preview - horizontal scroll -->
                        <div style="display:flex; gap:6px; margin-top:8px; overflow-x:auto;">
                            <% pkg.items.slice(0,5).forEach(it=>{ %>
                                <span style="background:#f9fbe7; border:1px solid #e8f5e9; padding:4px 8px; border-radius:20px; font-size:10px; font-weight:600; white-space:nowrap;"><%= it.name %> x<%= it.qty %></span>
                            <% }) %>
                            <% if(pkg.items.length>5){ %><span style="font-size:10px; color:#888; padding:4px;">+<%= pkg.items.length-5 %> more</span><% } %>
                        </div>
                    </div>

                    <i class="fas fa-chevron-right" style="color:#c5e1a5; font-size:12px;"></i>
                </div>
            </a>
        <% }) %>
    </div>
</div>