<style>
.auth-wrap {
  min-height: 80vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30px 18px;
  background: #f8fdf6;
}
.auth-box {
  width: 100%;
  max-width: 410px;
  background: #ffffff;
  padding: 38px 34px 32px;
  border: 1px solid #e8f5e9;
  border-radius: 20px;
  box-shadow: 0 12px 35px rgba(10, 77, 30, 0.10);
}
.brand-icon{
  width:58px; height:58px; margin:0 auto 14px; display:flex; align-items:center; justify-content:center;
  border-radius:50%; background:linear-gradient(135deg,#16a34a,#0a4d1e); overflow:hidden;
}
.brand-icon img{ width:100%; height:100%; object-fit:cover; }
.auth-box h2 {
  margin: 0 0 8px;
  text-align: center;
  color: #0a4d1e;
  font-size: 27px;
  font-weight: 700;
}
.auth-box .sub{
  text-align:center; color:#6d7d70; font-size:14px; margin-bottom:22px;
}
.auth-box h2::after {
  content: ""; display: block; width: 42px; height: 3px;
  margin: 12px auto 0; background: #c5e1a5; border-radius: 10px;
}
#errorBox {
  background: #fff1f1; color: #b42318; border: 1px solid #ffd0d0;
  padding: 11px 13px; border-radius: 10px; margin-bottom: 16px;
  font-size: 14px; line-height: 1.4; display: none;
}
.auth-box input {
  box-sizing: border-box; width: 100%; padding: 13px 14px; margin-bottom: 14px;
  border: 1px solid #d8e5da; border-radius: 10px; background: #fbfefb;
  color: #17351f; font-size: 15px; outline: none;
  transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
}
.auth-box input::placeholder { color: #8a9a8d; }
.auth-box input:focus {
  border-color: #0a4d1e; background: #ffffff;
  box-shadow: 0 0 0 3px rgba(10, 77, 30, 0.09);
}
.auth-box button {
  width: 100%; padding: 13px 16px; margin-top: 3px; background: #0a4d1e;
  color: #ffffff; border: none; border-radius: 10px; cursor: pointer;
  font-size: 15px; font-weight: 700; transition: all 0.2s ease;
}
.auth-box button:hover { background: #083d18; box-shadow: 0 7px 18px rgba(10, 77, 30, 0.18); }
.auth-box button:active { transform: translateY(1px); }
.auth-box button.loading { opacity: 0.75; cursor: not-allowed; pointer-events: none; }
.auth-box p { margin: 18px 0 0; text-align: center; color: #6d7d70; font-size: 14px; }
.auth-box a { color: #0a4d1e; font-weight: 700; text-decoration: none; }
.auth-box a:hover { text-decoration: underline; }
.forgot{ text-align:right; margin:-6px 0 14px; }
.forgot a{ font-size:13px; font-weight:600; color:#5d6d60; }
@media (max-width: 480px) {
  .auth-wrap { min-height: 78vh; padding: 20px 14px; }
  .auth-box { padding: 30px 22px 26px; border-radius: 17px; }
  .auth-box h2 { font-size: 24px; }
}
</style>

<div class="auth-wrap">
  <div class="auth-box">
    <div class="brand-icon"><img src="/images/h1.png" alt="Corevester"></div>
    <h2>Welcome Back</h2>
    <div class="sub">Login to Corevester</div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div id="errorBox" style="display:block;"><%= error %></div>
    <% } else { %>
      <div id="errorBox"></div>
    <% } %>

    <form id="loginForm">
      <input type="email" name="email" placeholder="Email" autocomplete="email" required>
      <input type="password" name="password" placeholder="Password" autocomplete="current-password" required>
      
      <div class="forgot"><a href="/auth/forgot-password">Forgot password?</a></div>

      <button type="submit" id="loginButton">Login</button>
    </form>

    <p>No account? <a href="/auth/signup">Sign up</a></p>
  </div>
</div>

<script>
document.getElementById('loginForm').addEventListener('submit', async (e) => {
  e.preventDefault();
  const box = document.getElementById('errorBox');
  const button = document.getElementById('loginButton');
  box.style.display = 'none';
  box.textContent = '';
  button.classList.add('loading');
  button.textContent = 'Logging in...';

  try {
    const res = await fetch('/auth/login', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
      body: JSON.stringify(Object.fromEntries(new FormData(e.target)))
    });
    const data = await res.json();
    if (data.success) {
      window.location.href = data.redirect || '/';
      return;
    }
    box.textContent = data.message || 'Login failed. Please check your details.';
    box.style.display = 'block';
  } catch (error) {
    box.textContent = 'Unable to connect. Please try again.';
    box.style.display = 'block';
  } finally {
    button.classList.remove('loading');
    button.textContent = 'Login';
  }
});
</script>