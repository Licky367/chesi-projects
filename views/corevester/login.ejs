<%- contentFor('body') %>
<div style="min-height:100vh;background:#f4f6f4;display:flex;align-items:center;justify-content:center;padding:16px;font-family:sans-serif;">
  <div style="width:100%;max-width:420px;background:#fff;border:1.5px solid #e0e9dc;border-radius:20px;padding:24px;box-shadow:0 8px 30px rgba(0,0,0,0.06);">
    <div style="text-align:center;margin-bottom:18px;">
      <div style="width:52px;height:52px;background:#15472E;border-radius:14px;display:inline-flex;align-items:center;justify-content:center;color:#fff;font-weight:900;font-size:22px;">C</div>
      <h1 style="margin:12px 0 4px 0;color:#15472E;font-weight:900;font-size:22px;">Welcome Back</h1>
      <p style="margin:0;color:#777;font-size:13px;">Login to Corevester</p>
    </div>

    <div id="msg" style="display:none;margin-bottom:12px;padding:10px 12px;border-radius:10px;font-size:13px;font-weight:700;"></div>

    <form id="loginForm">
      <label style="font-size:12px;font-weight:800;color:#15472E;">Email</label>
      <input id="email" type="email" required placeholder="you@email.com" style="width:100%;margin:6px 0 12px 0;height:44px;border:2px solid #e0e9dc;border-radius:12px;padding:0 14px;outline:none;box-sizing:border-box;">
      
      <label style="font-size:12px;font-weight:800;color:#15472E;">Password</label>
      <input id="password" type="password" required placeholder="••••••••" style="width:100%;margin:6px 0 18px 0;height:44px;border:2px solid #e0e9dc;border-radius:12px;padding:0 14px;outline:none;box-sizing:border-box;">

      <button type="submit" id="btn" style="width:100%;height:46px;background:#15472E;color:#fff;border:none;border-radius:12px;font-weight:800;font-size:14px;cursor:pointer;">Login</button>
    </form>

    <p style="text-align:center;margin-top:14px;font-size:13px;color:#666;">No account? <a href="/auth/signup" style="color:#15472E;font-weight:800;text-decoration:none;">Sign up</a></p>
  </div>
</div>

<script>
document.getElementById('loginForm').onsubmit = async (e) => {
  e.preventDefault();
  const btn = document.getElementById('btn');
  const msg = document.getElementById('msg');
  btn.textContent='Logging in...'; btn.disabled=true;
  try{
    const res = await fetch('/auth/login',{method:'POST',headers:{'Content-Type':'application/json'},credentials:'include',body:JSON.stringify({
      email: document.getElementById('email').value,
      password: document.getElementById('password').value
    })});
    const data = await res.json();
    if(!data.success) throw new Error(data.message);
    window.location.href = data.redirect;
  }catch(err){
    msg.style.display='block'; msg.style.background='#ffebee'; msg.style.color='#c62828'; msg.textContent=err.message;
    btn.textContent='Login'; btn.disabled=false;
  }
};
</script>