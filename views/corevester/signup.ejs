<div class="signup-page">
  <div class="signup-card">
    <div class="brand">
      <div class="brand-icon">
        <img src="/images/h1.png" alt="Corevester Logo">
      </div>
      <h1>Create Account</h1>
      <p>Join Corevester and get started today</p>
    </div>

    <% if (typeof error!== 'undefined' && error) { %>
      <div class="error"><%= error %></div>
    <% } %>
    <div class="error" id="jsError" style="display:none;"></div>

    <form id="corevesterSignupForm" method="POST" action="/auth/signup" enctype="multipart/form-data">
      <!-- PROFILE IMAGE -->
      <div class="avatar-section">
        <div class="avatar-wrapper" onclick="handleAvatarClick()">
          <img id="avatarPreview" class="avatar" src="https://ui-avatars.com/api/?name=User&background=16a34a&color=fff" alt="Profile Avatar">
          <div class="avatar-edit">📷</div>
        </div>
        <p>Click to add a profile photo</p>
      </div>
      <input type="file" id="fileInput" name="profileImage" accept="image/*" hidden>

      <!-- FULL NAME -->
      <div class="form-group">
        <label for="name">Full Name</label>
        <div class="input-wrapper">
          <span>👤</span>
          <input type="text" id="name" name="fullName" placeholder="Enter your full name" autocomplete="name" required>
        </div>
      </div>

      <!-- EMAIL -->
      <div class="form-group">
        <label for="email">Email Address</label>
        <div class="input-wrapper">
          <span>✉️</span>
          <input type="email" id="email" name="email" placeholder="Enter your email" autocomplete="email" required>
        </div>
      </div>

      <!-- PHONE -->
      <div class="form-group">
        <label for="phone">Phone Number <small>(Optional)</small></label>
        <div class="input-wrapper">
          <span>📱</span>
          <input type="text" id="phone" name="phone" placeholder="Enter your phone number" autocomplete="tel">
        </div>
      </div>

      <!-- PASSWORD -->
      <div class="form-group">
        <label for="password">Password</label>
        <div class="input-wrapper">
          <span>🔒</span>
          <input type="password" id="password" name="password" placeholder="Create a password" autocomplete="new-password" required>
          <button type="button" class="password-toggle" onclick="togglePassword()" aria-label="Show or hide password">👁️</button>
        </div>
      </div>

      <button type="submit" class="signup-btn">Create Account</button>
    </form>

    <div class="login-link">
      Already have an account? <a href="/auth/login">Login here</a>
    </div>
  </div>
</div>

<!-- IMAGE MODAL -->
<div class="modal" id="imageModal">
  <div class="modal-content">
    <button type="button" class="modal-close" onclick="closeModal()" aria-label="Close">×</button>
    <h3>Profile Photo</h3>
    <img id="modalImage" src="" alt="Profile Preview">
    <div class="modal-actions">
      <button type="button" class="choose-btn" onclick="chooseNew()">Choose New</button>
      <button type="button" class="remove-btn" onclick="removeImage()">Remove</button>
    </div>
  </div>
</div>

<style>
.signup-page{ width:100%; min-height:calc(100vh - 80px); display:flex; align-items:center; justify-content:center; padding:30px 20px; }
.signup-card{ width:100%; max-width:460px; background:rgba(255,255,255,0.98); padding:38px 35px; border-radius:22px; box-shadow:0 20px 50px rgba(0,0,0,0.12),0 5px 15px rgba(0,0,0,0.05); animation:signupFadeIn 0.6s ease-in-out; }
.brand{ text-align:center; margin-bottom:25px; }
.brand-icon{ width:70px; height:70px; margin:0 auto 15px; display:flex; align-items:center; justify-content:center; border-radius:50%; background:linear-gradient(135deg,#16a34a,#15803d); overflow:hidden; box-shadow:0 10px 20px rgba(22,163,74,0.25); }
.brand-icon img{ width:100%; height:100%; object-fit:cover; display:block; }
.brand h1{ margin:0 0 8px; color:#166534; font-size:28px; font-weight:700; }
.brand p{ margin:0; color:#6b7280; font-size:14px; }
.error{ margin-bottom:20px; padding:12px 14px; border:1px solid #fecaca; border-radius:10px; background:#fee2e2; color:#b91c1c; font-size:14px; text-align:center; }
.avatar-section{ text-align:center; margin-bottom:22px; }
.avatar-wrapper{ position:relative; width:96px; height:96px; margin:0 auto 8px; cursor:pointer; }
.avatar{ width:96px; height:96px; object-fit:cover; border-radius:50%; border:4px solid #16a34a; transition:all 0.25s ease; }
.avatar-wrapper:hover.avatar{ opacity:0.8; transform:scale(1.04); }
.avatar-edit{ position:absolute; right:0; bottom:0; width:30px; height:30px; display:flex; align-items:center; justify-content:center; border-radius:50%; background:#16a34a; border:3px solid white; font-size:14px; }
.avatar-section p{ margin:0; color:#6b7280; font-size:12px; }
.form-group{ margin-bottom:17px; }
.form-group label{ display:block; margin-bottom:8px; color:#374151; font-size:14px; font-weight:600; }
.form-group label small{ color:#9ca3af; font-size:12px; font-weight:400; }
.input-wrapper{ position:relative; }
.input-wrapper > span{ position:absolute; left:14px; top:50%; transform:translateY(-50%); color:#9ca3af; font-size:17px; pointer-events:none; }
.input-wrapper input{ width:100%; padding:14px 45px; border:1px solid #d1d5db; border-radius:12px; outline:none; background:#f9fafb; color:#111827; font-size:15px; transition:all 0.3s ease; box-sizing:border-box; }
.input-wrapper input:focus{ border-color:#16a34a; background:#ffffff; box-shadow:0 0 0 4px rgba(22,163,74,0.12); }
.password-toggle{ position:absolute; right:14px; top:50%; transform:translateY(-50%); padding:0; border:none; background:transparent; color:#6b7280; cursor:pointer; font-size:17px; }
.password-toggle:hover{ color:#16a34a; }
.signup-btn{ width:100%; margin-top:8px; padding:15px; border:none; border-radius:12px; background:linear-gradient(135deg,#16a34a,#15803d); color:white; font-size:16px; font-weight:700; cursor:pointer; box-shadow:0 8px 18px rgba(22,163,74,0.25); transition:all 0.3s ease; }
.signup-btn:hover{ transform:translateY(-2px); box-shadow:0 12px 24px rgba(22,163,74,0.35); }
.signup-btn:active{ transform:translateY(0); }
.login-link{ margin-top:24px; color:#6b7280; font-size:14px; text-align:center; }
.login-link a{ color:#15803d; font-weight:700; text-decoration:none; }
.login-link a:hover{ text-decoration:underline; }
.modal{ position:fixed; inset:0; display:none; align-items:center; justify-content:center; padding:20px; background:rgba(0,0,0,0.65); z-index:2000; }
.modal.active{ display:flex; }
.modal-content{ position:relative; width:100%; max-width:350px; padding:28px; border-radius:20px; background:white; text-align:center; box-shadow:0 20px 50px rgba(0,0,0,0.25); animation:modalFadeIn 0.25s ease; }
.modal-content h3{ margin:0 0 18px; color:#166534; }
.modal-content img{ width:210px; height:210px; margin-bottom:20px; border-radius:50%; object-fit:cover; border:4px solid #16a34a; }
.modal-close{ position:absolute; top:10px; right:14px; border:none; background:transparent; color:#6b7280; font-size:28px; cursor:pointer; }
.modal-close:hover{ color:#dc2626; }
.modal-actions{ display:flex; justify-content:center; gap:10px; }
.modal-actions button{ padding:10px 16px; border:none; border-radius:8px; color:white; cursor:pointer; font-weight:600; }
.choose-btn{ background:#16a34a; }
.choose-btn:hover{ background:#15803d; }
.remove-btn{ background:#dc2626; }
.remove-btn:hover{ background:#b91c1c; }
@keyframes signupFadeIn{ from{ opacity:0; transform:translateY(20px); } to{ opacity:1; transform:translateY(0); } }
@keyframes modalFadeIn{ from{ opacity:0; transform:scale(0.9); } to{ opacity:1; transform:scale(1); } }
@media(max-width:480px){.signup-card{ padding:32px 24px; }.brand h1{ font-size:24px; } }
</style>

<script>
const avatar = document.getElementById("avatarPreview");
const fileInput = document.getElementById("fileInput");
const modal = document.getElementById("imageModal");
const modalImage = document.getElementById("modalImage");
const defaultAvatar = "https://ui-avatars.com/api/?name=User&background=16a34a&color=fff";
const form = document.getElementById("corevesterSignupForm");
const jsError = document.getElementById("jsError");

function handleAvatarClick(){
  if (!fileInput.files.length) fileInput.click();
  else { modalImage.src = avatar.src; modal.classList.add("active"); }
}
fileInput.addEventListener("change", () => {
  const file = fileInput.files[0];
  if (!file) return;
  avatar.src = URL.createObjectURL(file);
});
function closeModal(){ modal.classList.remove("active"); }
function chooseNew(){ closeModal(); fileInput.click(); }
function removeImage(){ fileInput.value=""; avatar.src=defaultAvatar; closeModal(); }
function togglePassword(){
  const p = document.getElementById("password");
  const btn = document.querySelector(".password-toggle");
  if(p.type==="password"){ p.type="text"; btn.textContent="🙈"; }
  else { p.type="password"; btn.textContent="👁️"; }
}
modal.addEventListener("click",(e)=>{ if(e.target===modal) closeModal(); });
document.addEventListener("keydown",(e)=>{ if(e.key==="Escape" && modal.classList.contains("active")) closeModal(); });

// COREVESTER - AJAX SUBMIT WITH REDIRECT TO /
form.addEventListener("submit", async (e)=>{
  e.preventDefault();
  jsError.style.display="none";
  const formData = new FormData(form);
  // send as FormData for file upload
  try{
    const res = await fetch("/auth/signup", { method:"POST", body: formData, headers: { "X-Requested-With": "XMLHttpRequest" } });
    const data = await res.json().catch(async ()=>{ // fallback if server rendered html
      if(res.redirected) { window.location.href = "/"; return {success:true}; }
      return {success:false, message:"Signup failed"};
    });
    if(data.success || res.ok && res.redirected){
      window.location.href = data.redirect || "/";
    } else {
      jsError.textContent = data.message || "Signup failed";
      jsError.style.display="block";
    }
  }catch(err){
    jsError.textContent = err.message;
    jsError.style.display="block";
  }
});
</script>