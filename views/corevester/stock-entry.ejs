<div style="max-width:1300px; margin:0 auto; padding:20px;">
    <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(160px, 1fr)); gap:12px; margin-bottom:20px;">
        <div style="background:white; border-radius:12px; padding:16px; border-left:4px solid #0a4d1e;"><p style="margin:0; font-size:10px; font-weight:800;">WAREHOUSE ITEMS</p><p style="margin:6px 0 0 0; font-size:26px; font-weight:900;"><%= stats.totalItems %></p></div>
        <div style="background:white; border-radius:12px; padding:16px; border-left:4px solid #ff9800;"><p style="margin:0; font-size:10px; font-weight:800; color:#ff9800;">IN WAREHOUSE</p><p style="margin:6px 0 0 0; font-size:26px; font-weight:900;"><%= stats.totalWarehouseUnits %></p></div>
        <div style="background:white; border-radius:12px; padding:16px; border-left:4px solid #2e7d32;"><p style="margin:0; font-size:10px; font-weight:800; color:#2e7d32;">ON MARKET</p><p style="margin:6px 0 0 0; font-size:26px; font-weight:900;"><%= stats.totalMarketUnits %></p></div>
        <div style="background:#0a4d1e; border-radius:12px; padding:16px; color:white;"><p style="margin:0; font-size:10px; opacity:0.8;">WAREHOUSE VALUE</p><p style="margin:6px 0 0 0; font-size:18px; font-weight:900;">KES <%= stats.totalWarehouseBuyValue.toLocaleString() %></p></div>
    </div>
    <div style="display:grid; grid-template-columns:360px 1fr; gap:20px; align-items:start;">
        <div style="background:white; border-radius:16px; border-top:4px solid #ff9800; padding:20px;">
            <h3 style="margin:0 0 15px 0; color:#0a4d1e;"><i class="fas fa-warehouse" style="color:#ff9800;"></i> ADD TO WAREHOUSE</h3>
            <form onsubmit="addStock(event)" style="display:flex; flex-direction:column; gap:14px;">
                <div><label style="font-size:11px; font-weight:800;">ITEM NAME *</label><input name="name" id="stockName" required placeholder="e.g. Surgical Gloves" style="width:100%; margin-top:6px; padding:12px; border-radius:10px; border:1.5px solid #ddd;"></div>
                <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px;"><div><label style="font-size:11px;">UNITS *</label><input type="number" name="units" required min="1" style="width:100%; margin-top:6px; padding:12px; border-radius:10px; border:1.5px solid #ddd;"></div><div><label style="font-size:11px;">BUY PRICE *</label><input type="number" name="unitBuyPrice" required min="0" step="0.01" style="width:100%; margin-top:6px; padding:12px; border-radius:10px; border:1.5px solid #ddd;"></div></div>
                <button type="submit" style="padding:14px; background:#ff9800; color:white; border:none; border-radius:12px; font-weight:800; cursor:pointer;">ADD TO STOCK</button>
            </form>
        </div>
        <div>
            <div style="display:flex; justify-content:space-between; margin-bottom:12px;"><h3 style="margin:0; font-size:13px;">WAREHOUSE STOCK (<%= stockList.length %>)</h3><input id="searchStock" placeholder="Search..." style="padding:8px 14px; border-radius:20px; border:1.5px solid #ddd;" oninput="filterStock()"></div>
            <div id="stockGrid" style="display:grid; grid-template-columns:repeat(auto-fill, minmax(260px, 1fr)); gap:14px;">
                <% stockList.forEach(s=>{ %>
                    <div class="stock-card" data-name="<%= s.name.toLowerCase() %>" style="background:white; border-radius:14px; border:1px solid #f0f0f0; padding:14px;">
                        <div style="display:flex; justify-content:space-between;"><div style="width:44px; height:44px; background:#fff3e0; border-radius:10px; display:flex; align-items:center; justify-content:center;"><i class="fas fa-box" style="color:#ff9800;"></i></div><div style="display:flex; gap:6px;"><button type="button" onclick="editStock('<%= s._id %>','<%= s.name %>','<%= s.units %>','<%= s.unitBuyPrice %>')" style="width:30px; height:30px; border-radius:8px; border:1px solid #c8e6c9; background:#e8f5e9; cursor:pointer;"><i class="fas fa-pen" style="font-size:11px;"></i></button><button type="button" onclick="deleteStock('<%= s._id %>')" style="width:30px; height:30px; border-radius:8px; border:1px solid #ffcdd2; background:#ffebee; cursor:pointer;"><i class="fas fa-trash" style="font-size:11px;"></i></button></div></div>
                        <h4 style="margin:12px 0 0 0; font-size:14px;"><%= s.name %></h4>
                        <div style="margin-top:10px; display:grid; grid-template-columns:1fr 1fr; gap:8px;"><div style="background:#f9fbe7; border-radius:8px; padding:8px;"><p style="margin:0; font-size:16px; font-weight:900;"><%= s.units %></p></div><div style="background:#e8f5e9; border-radius:8px; padding:8px;"><p style="margin:0; font-size:16px; font-weight:900;"><%= s.onMarket %></p></div></div>
                        <div style="margin-top:10px; font-size:11px;">Buy: <b>KES <%= s.unitBuyPrice %></b> | Value: KES <%= (s.units * s.unitBuyPrice).toLocaleString() %></div>
                    </div>
                <% }) %>
            </div>
        </div>
    </div>
</div>
<div id="editModal" style="position:fixed; inset:0; background:rgba(0,0,0,0.5); z-index:200; display:none; align-items:center; justify-content:center; padding:20px;"><div style="background:white; border-radius:16px; width:100%; max-width:400px; padding:20px;"><h3 style="margin:0 0 15px 0;">Edit Stock</h3><form onsubmit="saveEdit(event)" style="display:flex; flex-direction:column; gap:12px;"><input type="hidden" id="editId"><input id="editName" required style="padding:12px; border-radius:10px; border:1.5px solid #ddd;"><input type="number" id="editUnits" required min="0" style="padding:12px; border-radius:10px; border:1.5px solid #ddd;"><input type="number" id="editBuy" required min="0" step="0.01" style="padding:12px; border-radius:10px; border:1.5px solid #ddd;"><div style="display:flex; gap:10px;"><button type="button" onclick="closeEdit()" style="flex:1; padding:12px; background:white; border:1.5px solid #ddd; border-radius:10px; cursor:pointer;">Cancel</button><button type="submit" style="flex:1; padding:12px; background:#0a4d1e; color:white; border:none; border-radius:10px; cursor:pointer;">Save</button></div></form></div></div>
<script>
function addStock(e){ e.preventDefault(); var data=Object.fromEntries(new FormData(e.target)); fetch('/admin/stock/create',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)}).then(r=>r.json()).then(r=>{ if(r.success) location.reload(); else alert(r.message); }); }
function editStock(id,name,units,buy){ document.getElementById('editId').value=id; document.getElementById('editName').value=name; document.getElementById('editUnits').value=units; document.getElementById('editBuy').value=buy; document.getElementById('editModal').style.display='flex'; }
function closeEdit(){ document.getElementById('editModal').style.display='none'; }
function saveEdit(e){ e.preventDefault(); var id=document.getElementById('editId').value; fetch('/admin/stock/'+id,{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify({name:document.getElementById('editName').value,units:document.getElementById('editUnits').value,unitBuyPrice:document.getElementById('editBuy').value})}).then(r=>r.json()).then(r=>{ if(r.success) location.reload(); else alert(r.message); }); }
function deleteStock(id){ if(!confirm('Delete?')) return; fetch('/admin/stock/'+id,{method:'DELETE'}).then(r=>r.json()).then(r=>{ if(r.success) location.reload(); else alert(r.message); }); }
function filterStock(){ var q=document.getElementById('searchStock').value.toLowerCase(); document.querySelectorAll('.stock-card').forEach(c=>{ c.style.display=c.dataset.name.includes(q)?'block':'none'; }); }
</script>