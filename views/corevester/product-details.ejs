<%- contentFor('body') %>
<div class="container py-4">
    <a href="/products" class="btn btn-outline-secondary btn-sm mb-4">← Back to Marketplace</a>
    <div class="row g-4">
        <div class="col-md-6">
            <img src="<%= product.image||'/images/no-image.png' %>" class="img-fluid rounded shadow-sm w-100" style="max-height:500px;object-fit:contain;background:#f8f9fa">
        </div>
        <div class="col-md-6">
            <h2 class="fw-bold"><%= product.name %></h2>
            <p class="text-muted text-capitalize"><%= product.category %></p>
            <h3 class="my-3">Ksh <%= product.unitSellPrice.toLocaleString() %></h3>
            <p class="<%= product.units<=0?'text-danger':'text-success' %> fw-bold"><%= product.units<=0?'Out of Stock': product.units+' units available' %></p>
            <p class="mt-3"><%= product.description||'No description.' %></p>
            
            <div class="mt-4 d-flex gap-2">
                <div class="input-group" style="max-width:140px;">
                    <button class="btn btn-outline-secondary" id="detailMinus">-</button>
                    <input id="detailQty" type="number" class="form-control text-center" value="1" min="1" max="<%= product.units %>">
                    <button class="btn btn-outline-secondary" id="detailPlus">+</button>
                </div>
                <button class="btn btn-primary flex-grow-1" id="detailAddBtn" data-id="<%= product._id %>" data-stock="<%= product.units %>" <%= product.units<=0?'disabled':'' %>>
                    Add to Cart
                </button>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', ()=>{
    const qtyInput = document.getElementById('detailQty');
    const stock = parseInt(document.getElementById('detailAddBtn').dataset.stock);
    document.getElementById('detailPlus').onclick = ()=>{ if(parseInt(qtyInput.value) < stock) qtyInput.value = parseInt(qtyInput.value)+1; };
    document.getElementById('detailMinus').onclick = ()=>{ if(parseInt(qtyInput.value) > 1) qtyInput.value = parseInt(qtyInput.value)-1; };
    document.getElementById('detailAddBtn').onclick = async (e)=>{
        const res = await fetch('/products/add-to-cart', {
            method:'POST', headers:{'Content-Type':'application/json'},
            body: JSON.stringify({productId:e.target.dataset.id, qty: qtyInput.value})
        });
        const data = await res.json();
        if(!data.success) alert(data.message);
        else { alert('Added to cart'); window.location.href='/products'; }
    };
});
</script>