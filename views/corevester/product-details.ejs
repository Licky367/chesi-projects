<%- contentFor('body') %>
<div style="width:100%;background:#f4f6f4;min-height:100vh;padding-bottom:30px;font-family:sans-serif;">
  <div style="width:100%;max-width:1100px;margin:0 auto;padding:12px 14px;">
    <a href="/products" style="display:inline-flex;align-items:center;gap:8px;border:2px solid #15472E;background:#fff;color:#15472E;border-radius:50px;padding:8px 16px;font-size:12px;font-weight:800;text-decoration:none;">← Back to Marketplace</a>
    <div style="display:flex;flex-wrap:wrap;gap:14px;margin-top:14px;">
      <div style="flex:1 1 340px;min-width:280px;background:#fff;border:1.5px solid #e0e9dc;border-radius:18px;overflow:hidden;">
        <div style="width:100%;height:380px;display:flex;align-items:center;justify-content:center;position:relative;">
          <span style="position:absolute;top:12px;left:12px;background:#fff;border:1.5px solid #15472E;color:#15472E;border-radius:20px;padding:5px 12px;font-size:11px;font-weight:800;z-index:2;"><%= product.units>0? product.units+' left' : 'Out of Stock' %></span>
          <img src="<%= product.image||'/images/no-image.png' %>" style="width:100%;height:100%;object-fit:contain;">
        </div>
      </div>
      <div style="flex:1 1 340px;min-width:280px;">
        <div style="background:#fff;border:1.5px solid #e0e9dc;border-radius:18px;padding:18px;">
          <p style="margin:0;color:#2e7d32;font-weight:800;font-size:11px;letter-spacing:1px;text-transform:uppercase;"><%= product.category %></p>
          <h1 style="margin:6px 0 0 0;color:#15472E;font-weight:900;font-size:24px;"><%= product.name %></h1>
          <p style="margin:10px 0 0 0;color:#15472E;font-weight:900;font-size:22px;">KES <%= Number(product.unitSellPrice||0).toLocaleString() %></p>
          
          <div style="margin-top:18px;display:flex;gap:10px;align-items:center;">
            <input id="inputQty" type="number" value="1" min="1" max="<%= product.units %>" style="width:70px;height:46px;border:2.5px solid #15472E;border-radius:12px;text-align:center;font-weight:900;color:#15472E;font-size:18px;">
            <button id="btnAddCart" type="button" style="flex:1;height:46px;background:#15472E;color:#fff;font-weight:800;border:none;border-radius:12px;cursor:pointer;">ADD TO CART</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div id="loginPopup" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.6);z-index:99999;align-items:center;justify-content:center;padding:16px;">
  <div style="background:#fff;border-radius:18px;max-width:320px;width:100%;padding:24px;text-align:center;">
    <h3 style="margin:0;color:#15472E;">You're not logged in</h3>
    <p style="color:#666;font-size:13px;">Log in to continue</p>
    <div style="display:flex;gap:10px;margin-top:16px;">
      <button type="button" onclick="document.getElementById('loginPopup').style.display='none'" style="flex:1;height:42px;border:1px solid #ccc;background:#fff;border-radius:10px;cursor:pointer;">Cancel</button>
      <a href="/auth/login" style="flex:1;height:42px;background:#15472E;color:#fff;border-radius:10px;display:flex;align-items:center;justify-content:center;text-decoration:none;font-weight:800;">Log In</a>
    </div>
  </div>
</div>

<script>
var isLoggedIn = <%- typeof user !== 'undefined' && user ? 'true' : 'false' %>;
var productId = "<%= product._id %>";

document.getElementById('btnAddCart').addEventListener('click', function(){
  if(!isLoggedIn){
    document.getElementById('loginPopup').style.display = 'flex';
    return;
  }
  var qty = document.getElementById('inputQty').value || 1;
  this.textContent = 'Adding...';
  this.disabled = true;
  var self = this;
  fetch('/products/add-to-cart', {
    method: 'POST',
    headers: {'Content-Type':'application/json'},
    credentials: 'include',
    body: JSON.stringify({productId: productId, qty: parseInt(qty)})
  }).then(r=>r.json()).then(d=>{
    if(d.success){ window.location.href='/cart'; }
    else{ 
      if(d.message==='LOGIN_REQUIRED'){ document.getElementById('loginPopup').style.display='flex'; }
      else{ alert(d.message); }
      self.textContent='ADD TO CART'; self.disabled=false;
    }
  }).catch(()=>{ alert('Error'); self.textContent='ADD TO CART'; self.disabled=false; });
});
</script>