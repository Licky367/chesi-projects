<div style="max-width:1100px; margin:0 auto; padding:20px; box-sizing:border-box;">

    <a href="/products" style="display:inline-flex; align-items:center; gap:6px; text-decoration:none; color:#0a4d1e; font-size:12px; font-weight:700; background:white; border:1.5px solid #e8f5e9; padding:8px 14px; border-radius:20px;">
        <i class="fas fa-arrow-left"></i> Back to Products
    </a>

    <div style="display:grid; grid-template-columns:1fr 1fr; gap:24px; margin-top:20px; background:white; border-radius:20px; border:1px solid #e8f5e9; overflow:hidden; box-shadow:0 6px 20px rgba(0,0,0,0.06);">

        <!-- Image -->
        <div style="background:#f6fbf6; min-height:420px; display:flex; align-items:center; justify-content:center; position:relative;">
            <% if(product.image){ %>
                <img src="<%= product.image %>" style="width:100%; height:100%; max-height:480px; object-fit:cover;" />
            <% } else { %>
                <i class="fas fa-pills" style="font-size:80px; color:#a5d6a7;"></i>
            <% } %>
            <span style="position:absolute; top:14px; left:14px; background:#0a4d1e; color:white; font-size:11px; font-weight:800; padding:6px 12px; border-radius:20px;"><%= product.category %></span>
            <span style="position:absolute; top:14px; right:14px; background:<%= availableUnits>0? 'white' : '#ffebee' %>; color:<%= availableUnits>0? '#0a4d1e' : '#c62828' %>; border:1.5px solid <%= availableUnits>0? '#0a4d1e' : '#ffcdd2' %>; font-size:11px; font-weight:800; padding:6px 12px; border-radius:20px;"><%= availableUnits>0? availableUnits + ' units left' : 'OUT OF STOCK' %></span>
        </div>

        <!-- Info -->
        <div style="padding:24px; display:flex; flex-direction:column;">
            <p style="margin:0; font-size:10px; letter-spacing:2px; color:#2e7d32; font-weight:800;">COREVESTER • <%= product.category.toUpperCase() %></p>
            <h1 style="margin:8px 0 0 0; font-size:28px; font-weight:900; color:#0a1f0f; line-height:1.2;"><%= product.name %></h1>

            <div style="margin-top:16px; display:flex; align-items:baseline; gap:10px;">
                <p style="margin:0; font-size:32px; font-weight:900; color:#0a4d1e;">KES <%= product.unitSellPrice.toLocaleString() %></p>
                <p style="margin:0; font-size:13px; color:#888;">per unit</p>
            </div>

            <div style="margin-top:18px; background:#f9fbe7; border:1px solid #e8f5e9; border-radius:12px; padding:14px;">
                <p style="margin:0; font-size:11px; font-weight:800; color:#0a4d1e; letter-spacing:1px;">STOCK INFO</p>
                <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-top:8px;">
                    <div><p style="margin:0; font-size:11px; color:#888;">Warehouse Stock</p><p style="margin:2px 0 0 0; font-size:14px; font-weight:800;"><%= product.units %> units</p></div>
                    <div><p style="margin:0; font-size:11px; color:#888;">In Your Bag</p><p style="margin:2px 0 0 0; font-size:14px; font-weight:800; color:#ff9800;"><%= inCartQty %> units</p></div>
                </div>
            </div>

            <p style="margin:18px 0 0 0; font-size:13px; line-height:1.6; color:#555;">
                Quality healthcare product from Core Vester Healthcare. Genuine, verified, and ready for delivery. Your health is our priority.
            </p>

            <!-- Qty Selector -->
            <div style="margin-top:22px; display:flex; align-items:center; gap:12px;">
                <span style="font-size:12px; font-weight:700; color:#333;">Qty:</span>
                <div style="display:flex; align-items:center; border:1.5px solid #ddd; border-radius:10px; overflow:hidden;">
                    <button onclick="changeQty(-1)" style="width:36px; height:36px; border:none; background:#f5f5f5; cursor:pointer; font-weight:800;">-</button>
                    <input id="qtyInput" type="number" value="1" min="1" max="<%= availableUnits %>" style="width:50px; height:36px; border:none; text-align:center; font-weight:800; outline:none;" />
                    <button onclick="changeQty(1)" style="width:36px; height:36px; border:none; background:#f5f5f5; cursor:pointer; font-weight:800;">+</button>
                </div>
                <span style="font-size:11px; color:#888;">Max: <%= availableUnits %></span>
            </div>

            <!-- Buttons -->
            <div style="margin-top:22px; display:flex; gap:10px;">
                <button onclick="addToCartDetail()" <%= availableUnits<=0? 'disabled' : '' %> style="flex:1; padding:14px; border-radius:12px; border:1.5px solid #0a4d1e; background:white; color:#0a4d1e; font-weight:800; cursor:pointer; font-size:13px;">
                    <i class="fas fa-shopping-bag"></i> Add to Bag
                </button>
                <button onclick="buyNow()" <%= availableUnits<=0? 'disabled' : '' %> style="flex:1; padding:14px; border-radius:12px; border:none; background:#0a4d1e; color:white; font-weight:800; cursor:pointer; font-size:13px;">
                    Order Now
                </button>
            </div>

            <div style="margin-top:16px; display:flex; gap:8px;">
                <span style="font-size:10px; background:#e8f5e9; color:#0a4d1e; padding:6px 10px; border-radius:20px; font-weight:600;"><i class="fas fa-truck"></i> Fast Delivery</span>
                <span style="font-size:10px; background:#fff3e0; color:#e65100; padding:6px 10px; border-radius:20px; font-weight:600;"><i class="fas fa-shield-alt"></i> Genuine Product</span>
            </div>
        </div>
    </div>
</div>

<script>
function changeQty(d){
    const input = document.getElementById('qtyInput');
    let v = parseInt(input.value) + d;
    if(v < 1) v = 1;
    if(v > <%= availableUnits %>) v = <%= availableUnits %>;
    input.value = v;
}
async function addToCartDetail(){
    const qty = parseInt(document.getElementById('qtyInput').value);
    const res = await fetch('/products/add-to-cart', {
        method:'POST',
        headers:{'Content-Type':'application/json'},
        body: JSON.stringify({ productId: '<%= product._id %>', qty })
    });
    const data = await res.json();
    if(data.success){ alert('Added to bag!'); location.reload(); }
    else alert(data.message);
}
async function buyNow(){
    await addToCartDetail();
    window.location.href = '/products';
    // then user opens cart and clicks Order Now, or direct:
    // setTimeout(()=>{ fetch('/packages/create-from-cart',{method:'POST'}).then(r=>r.json()).then(d=>{ if(d.success) location.href='/packages/'+d.packageId }) }, 500);
}
</script>

<style>
@media(max-width:800px){
    div[style*="grid-template-columns:1fr 1fr"]{ grid-template-columns:1fr!important; }
    div[style*="min-height:420px"]{ min-height:300px!important; }
}
</style>