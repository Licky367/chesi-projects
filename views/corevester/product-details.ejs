<%- contentFor('body') %>
<div style="width:100%;background:#f4f6f4;min-height:100vh;padding-bottom:30px;font-family:sans-serif;">
  <div style="max-width:1100px;margin:0 auto;padding:12px 14px;">
    <a href="/products" style="display:inline-flex;align-items:center;gap:8px;border:2px solid #15472E;background:#fff;color:#15472E;border-radius:50px;padding:8px 16px;font-size:12px;font-weight:800;text-decoration:none;">← Back to Marketplace</a>
    <div style="display:flex;flex-wrap:wrap;gap:14px;margin-top:14px;">
      <div style="flex:1 1 340px;min-width:280px;background:#fff;border:1.5px solid #e0e9dc;border-radius:18px;overflow:hidden;">
        <div style="width:100%;height:380px;background:#eef4e9;display:flex;align-items:center;justify-content:center;position:relative;">
          <span style="position:absolute;top:12px;left:12px;background:#fff;border:1.5px solid #15472E;color:#15472E;border-radius:20px;padding:5px 12px;font-size:11px;font-weight:800;"><%= product.units>0? product.units+' left' : 'Out' %></span>
          <img src="<%= product.image||'/images/no-image.png' %>" style="width:100%;height:100%;object-fit:contain;background:#fff;">
        </div>
      </div>
      <div style="flex:1 1 340px;min-width:280px;">
        <div style="background:#fff;border:1.5px solid #e0e9dc;border-radius:18px;padding:18px;">
          <p style="margin:0;color:#2e7d32;font-weight:800;font-size:11px;letter-spacing:1px;text-transform:uppercase;"><%= product.category %></p>
          <h1 style="margin:6px 0 0 0;color:#15472E;font-weight:900;font-size:24px;"><%= product.name %></h1>
          <p style="margin:10px 0 0 0;color:#15472E;font-weight:900;font-size:22px;">KES <%= Number(product.unitSellPrice||0).toLocaleString() %></p>
          <div style="margin-top:18px;display:flex;gap:10px;align-items:center;">
            <div style="display:flex;align-items:center;border:2.5px solid #15472E;border-radius:12px;overflow:hidden;background:#fff;height:46px;">
              <button type="button" id="btnMinus" style="width:44px;height:46px;border:none;background:#fff;color:#15472E;font-weight:900;font-size:20px;cursor:pointer;">−</button>
              <input id="inputQty" type="number" value="1" min="1" max="<%= product.units %>" style="width:56px;height:46px;border:none;border-left:1.5px solid #e0e9dc;border-right:1.5px solid #e0e9dc;text-align:center;font-weight:900;color:#15472E;font-size:18px;outline:none;">
              <button type="button" id="btnPlus" style="width:44px;height:46px;border:none;background:#fff;color:#15472E;font-weight:900;font-size:20px;cursor:pointer;">+</button>
            </div>
            <button type="button" id="btnAddCart" style="flex:1;height:46px;background:<%= product.units>0?'#15472E':'#ccc' %>;color:#fff;font-weight:800;border:none;border-radius:12px;padding:0 16px;font-size:13px;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:8px;"><i class="fas fa-shopping-cart"></i> ADD TO CART</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div id="loginPopup" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.6);z-index:9999;align-items:center;justify-content:center;padding:16px;">
  <div style="background:#fff;border-radius:18px;max-width:320px;width:100%;padding:24px;text-align:center;">
    <h3 style="margin:0;color:#15472E;">Not logged in</h3>
    <p style="color:#666;font-size:13px;">Please log in to add to cart</p>
    <div style="display:flex;gap:10px;margin-top:16px;">
      <button type="button" id="closeLogin" style="flex:1;height:42px;border:1px solid #ccc;background:#fff;border-radius:10px;cursor:pointer;">Cancel</button>
      <a href="/auth/login?redirect=/products/<%= product._id %>" style="flex:1;height:42px;background:#15472E;color:#fff;border-radius:10px;display:flex;align-items:center;justify-content:center;text-decoration:none;font-weight:800;">Log In</a>
    </div>
  </div>
</div>

<script>
var IS_LOGGED = <%- (typeof user !== 'undefined' && user) ? 'true' : 'false' %>;
(function(){
  var qty = document.getElementById('inputQty');
  var minus = document.getElementById('btnMinus');
  var plus = document.getElementById('btnPlus');
  var add = document.getElementById('btnAddCart');
  var pop = document.getElementById('loginPopup');
  var close = document.getElementById('closeLogin');
  
  minus.onclick = function(){ var v=parseInt(qty.value)||1; if(v>1) qty.value=v-1; };
  plus.onclick = function(){ var m=parseInt(qty.max)||9999; var v=parseInt(qty.value)||1; if(v<m) qty.value=v+1; };
  close.onclick = function(){ pop.style.display='none'; };
  pop.onclick = function(e){ if(e.target===pop) pop.style.display='none'; };

  add.onclick = function(){
    if(!IS_LOGGED){ pop.style.display='flex'; return; }
    var q = parseInt(qty.value)||1;
    add.textContent='Adding...'; add.disabled=true;
    fetch('/products/add-to-cart',{method:'POST',headers:{'Content-Type':'application/json'},credentials:'include',body:JSON.stringify({productId:'<%= product._id %>',qty:q})})
    .then(r=>r.json()).then(d=>{
      if(d.success) window.location.href='/cart';
      else { alert(d.message||'Failed'); add.textContent='ADD TO CART'; add.disabled=false; }
    }).catch(()=>{ add.textContent='ADD TO CART'; add.disabled=false; });
  };
})();
</script>