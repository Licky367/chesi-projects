<!-- views/product-details.ejs - SHARED LAYOUT VERSION -->

<style>
  .back-btn{display:inline-flex;align-items:center;gap:8px;padding:8px 18px;background:#e9d5ff;color:#6b21a8;border-radius:9999px;text-decoration:none;font-weight:600;font-size:14px;margin:12px 0 20px 0;transition:all .2s}
  .back-btn:hover{background:#d8b4fe;transform:translateX(-2px)}
  .product-wrap{display:grid;grid-template-columns:1fr 1fr;gap:32px;background:#fff;border-radius:24px;padding:24px;box-shadow:0 4px 24px rgba(0,0,0,.06)}
  .product-image{width:100%;aspect-ratio:1/1;object-fit:cover;border-radius:16px;background:#f1f5f9}
  .badge{display:inline-block;padding:4px 12px;background:#dcfce7;color:#166534;border-radius:9999px;font-size:12px;font-weight:600;margin-bottom:12px}
  .badge.out{background:#fee2e2;color:#991b1b}
  .product-title{font-size:28px;font-weight:800;margin-bottom:8px}
  .product-category{color:#64748b;font-size:14px;text-transform:uppercase;letter-spacing:.05em;margin-bottom:12px}
  .product-price{font-size:24px;font-weight:800;color:#16a34a;margin:12px 0}
  .qty-row{display:flex;align-items:center;gap:16px;margin:20px 0}
  .qty-control{display:flex;align-items:center;border:1.5px solid #e2e8f0;border-radius:12px;overflow:hidden}
  .qty-control button{width:44px;height:44px;border:none;background:#fff;font-size:20px;font-weight:700;cursor:pointer}
  .qty-control button:hover{background:#f1f5f9}
  .qty-display{width:56px;height:44px;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:16px;border-left:1.5px solid #e2e8f0;border-right:1.5px solid #e2e8f0;background:#fff}
  .btn-add{flex:1;height:48px;background:#16a34a;color:#fff;border:none;border-radius:12px;font-weight:800;font-size:15px;cursor:pointer}
  .btn-add:disabled{background:#94a3b8}
  .section{margin-top:24px;padding-top:20px;border-top:1px solid #f1f5f9}
  .section h3{font-size:16px;font-weight:700;margin-bottom:8px}
  .section p{font-size:14px;line-height:1.6;color:#475569;white-space:pre-line}
  @media(max-width:768px){ .product-wrap{grid-template-columns:1fr} }
</style>

<div class="container" style="max-width:1100px;margin:0 auto;padding:16px">
  <a href="/products" class="back-btn">← Back to Marketplace</a>

  <div class="product-wrap">
    <div>
      <% if(product.image){ %>
        <img src="<%= product.image %>" alt="<%= product.name %>" class="product-image">
      <% } else { %>
        <div class="product-image" style="display:flex;align-items:center;justify-content:center;color:#94a3b8">No Image</div>
      <% } %>
    </div>

    <div>
      <% if(availableUnits > 0){ %>
        <span class="badge">In Stock • <%= availableUnits %> left</span>
      <% } else { %>
        <span class="badge out">Out of Stock</span>
      <% } %>

      <h1 class="product-title"><%= product.name %></h1>
      <div class="product-category"><%= product.category %></div>
      <div class="product-price">KES <%= Number(product.unitSellPrice || 0).toLocaleString() %></div>
      <div style="font-size:14px;color:#64748b;margin-bottom:16px">Available: <b><%= availableUnits %></b> | In cart: <b id="in-cart-qty"><%= inCartQty || 0 %></b></div>

      <div class="qty-row">
        <div class="qty-control">
          <button type="button" id="btn-minus">−</button>
          <div class="qty-display" id="qty-display">1</div>
          <button type="button" id="btn-plus">+</button>
        </div>
        <button type="button" id="btn-add-to-cart" class="btn-add" <%= availableUnits <=0 ? 'disabled' : '' %>>
          <%= inCartQty>0 ? 'UPDATE CART' : 'ADD TO CART' %>
        </button>
      </div>

      <% if(product.description){ %>
        <div class="section"><h3>Description</h3><p><%= product.description %></p></div>
      <% } %>
      <% if(product.usage){ %>
        <div class="section"><h3>Usage</h3><p><%= product.usage %></p></div>
      <% } %>
      <% if(product.precautions){ %>
        <div class="section"><h3>Precautions</h3><p><%= product.precautions %></p></div>
      <% } %>
      <% if(product.specifications){ %>
        <div class="section"><h3>Specifications</h3><p><%= product.specifications %></p></div>
      <% } %>
    </div>
  </div>
</div>

<script>
(function(){
  const productId = "<%= product._id %>";
  const maxUnits = Number("<%= availableUnits %>") || 0;
  const currentInCart = Number("<%= inCartQty || 0 %>") || 0;
  let qty = currentInCart > 0 ? currentInCart : 1;
  const elQty = document.getElementById('qty-display');
  const elMinus = document.getElementById('btn-minus');
  const elPlus = document.getElementById('btn-plus');
  const elAdd = document.getElementById('btn-add-to-cart');
  const elInCart = document.getElementById('in-cart-qty');
  function render(){ qty = Math.max(1, Math.min(qty, maxUnits || 999)); if(elQty) elQty.textContent = qty; }
  elMinus?.addEventListener('click', ()=>{ qty = Math.max(1, qty-1); render(); });
  elPlus?.addEventListener('click', ()=>{ if(maxUnits && qty >= maxUnits){ alert(`Only ${maxUnits} units available`); return; } qty++; render(); });
  elAdd?.addEventListener('click', async ()=>{
    if(maxUnits===0) return alert('Out of stock');
    elAdd.disabled=true; const original=elAdd.textContent; elAdd.textContent="Adding...";
    try{
      const res = await fetch('/products/add-to-cart', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({ productId, qty }) });
      const data = await res.json(); if(!data.success) throw new Error(data.message);
      document.querySelectorAll('[data-cart-count], #cart-count, .cart-count').forEach(b=>{ if(data.cartCount!==undefined) b.textContent=data.cartCount; });
      if(elInCart) elInCart.textContent=qty; elAdd.textContent="Added ✓"; setTimeout(()=>{ elAdd.textContent="UPDATE CART"; elAdd.disabled=false; },1200);
    }catch(e){ alert(e.message); elAdd.textContent=original; elAdd.disabled=false; }
  });
  render();
})();
</script>