<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= typeof title !== 'undefined' ? title : 'COREVESTER - Core Vester Healthcare' %></title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<style>
*{box-sizing:border-box;}
html,body{margin:0;padding:0;width:100%;max-width:100vw;overflow-x:hidden;}
body{font-family:'Segoe UI',sans-serif;background:#f8fdf6;}
img{max-width:100%;}
</style>
</head>
<body>

<!-- HEADER -->
<header style="height:80px;background:#fff;border-top:4px solid #0a4d1e;border-bottom:4px solid #0a4d1e;box-shadow:0 2px 15px rgba(10,77,30,0.08);display:flex;align-items:center;justify-content:space-between;padding:0 14px;position:sticky;top:0;z-index:900;width:100%;">

    <a href="/" style="display:flex;align-items:center;text-decoration:none;flex-shrink:0;">
        <img src="/images/corevester.png" alt="CoreVester" style="height:52px;width:auto;object-fit:contain;display:block;">
    </a>

    <div style="display:flex;align-items:center;gap:10px;flex-shrink:0;">
        <div onclick="openCartSidebar()" style="display:flex;align-items:center;gap:6px;border:1.5px solid #0a4d1e;border-radius:50px;padding:6px 12px;background:#fff;cursor:pointer;">
            <span id="headerCartCount" style="background:#0a4d1e;color:#fff;width:20px;height:20px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:800;"><%= typeof cartCount!=='undefined'? cartCount : 0 %></span>
            <i class="fas fa-shopping-cart" style="color:#0a4d1e;font-size:14px;"></i>
            <span style="font-size:12px;font-weight:700;color:#0a4d1e;">KES <span id="headerCartTotal"><%= typeof cartTotal!=='undefined'? Number(cartTotal).toLocaleString() : 0 %></span></span>
        </div>
        <button type="button" onclick="openMenuSidebar()" style="width:44px;height:44px;border-radius:10px;background:#e8f5e9;border:1.5px solid #0a4d1e;color:#0a4d1e;font-size:18px;cursor:pointer;display:flex;align-items:center;justify-content:center;">
            <i class="fas fa-bars"></i>
        </button>
    </div>
</header>

<!-- OVERLAYS -->
<div id="menuOverlay" onclick="closeMenuSidebar()" style="position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:1000;display:none;"></div>
<div id="cartOverlay" onclick="closeCartSidebar()" style="position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:1000;display:none;"></div>

<!-- MENU SIDEBAR -->
<div id="menuSidebar" style="position:fixed;top:0;right:-100%;width:300px;max-width:85vw;height:100%;background:#fff;border-left:5px solid #0a4d1e;z-index:1100;transition:right 0.3s;display:flex;flex-direction:column;">
    <div style="height:80px;background:#fff;border-bottom:3px solid #0a4d1e;display:flex;align-items:center;justify-content:space-between;padding:0 20px;flex-shrink:0;">
        <span style="font-weight:800;color:#0a4d1e;letter-spacing:2px;">COREVESTER</span>
        <button type="button" onclick="closeMenuSidebar()" style="width:36px;height:36px;border-radius:8px;background:#f1f8e9;border:1px solid #c5e1a5;color:#0a4d1e;cursor:pointer;"><i class="fas fa-times"></i></button>
    </div>
    <nav style="flex:1;padding:20px;display:flex;flex-direction:column;gap:8px;overflow-y:auto;">
        <a href="/" style="padding:14px 16px;border-radius:10px;text-decoration:none;color:#0a4d1e;background:#e8f5e9;font-weight:600;display:flex;gap:12px;align-items:center;"><i class="fas fa-home" style="width:20px;"></i> Home</a>
        <a href="/products" style="padding:14px 16px;border-radius:10px;text-decoration:none;color:#333;font-weight:500;display:flex;gap:12px;align-items:center;"><i class="fas fa-boxes" style="width:20px;color:#0a4d1e;"></i> Products</a>
        <a href="/cart" style="padding:14px 16px;border-radius:10px;text-decoration:none;color:#333;font-weight:500;display:flex;gap:12px;align-items:center;"><i class="fas fa-shopping-cart" style="width:20px;color:#0a4d1e;"></i> My Cart</a>
        <a href="/about" style="padding:14px 16px;border-radius:10px;text-decoration:none;color:#333;display:flex;gap:12px;align-items:center;"><i class="fas fa-info-circle" style="width:20px;color:#0a4d1e;"></i> About</a>
        <a href="/contact" style="padding:14px 16px;border-radius:10px;text-decoration:none;color:#333;display:flex;gap:12px;align-items:center;"><i class="fas fa-phone" style="width:20px;color:#0a4d1e;"></i> Contact</a>
        <div style="height:1px;background:#e8f5e9;margin:8px 0;"></div>
        <% if(typeof user !== 'undefined' && user){ %>
            <% if(user.role === 'admin'){ %>
                <a href="/admin/products" style="padding:14px 16px;border-radius:10px;text-decoration:none;color:#fff;background:#0a4d1e;font-weight:700;display:flex;gap:12px;align-items:center;"><i class="fas fa-user-shield" style="width:20px;"></i> Admin Panel</a>
            <% } %>
            <a href="/auth/logout" style="padding:14px 16px;border-radius:10px;text-decoration:none;color:#b42318;background:#fff1f1;border:1px solid #ffd0d0;font-weight:600;display:flex;gap:12px;align-items:center;"><i class="fas fa-sign-out-alt" style="width:20px;"></i> Logout (<%= user.fullName || user.name %>)</a>
        <% } else { %>
            <a href="/auth/login" style="padding:14px 16px;border-radius:10px;text-decoration:none;color:#fff;background:#0a4d1e;font-weight:700;display:flex;gap:12px;align-items:center;"><i class="fas fa-sign-in-alt" style="width:20px;"></i> Login</a>
            <a href="/auth/signup" style="padding:14px 16px;border-radius:10px;text-decoration:none;color:#0a4d1e;background:#fff;border:1.5px solid #0a4d1e;font-weight:700;display:flex;gap:12px;align-items:center;"><i class="fas fa-user-plus" style="width:20px;"></i> Sign Up</a>
        <% } %>
    </nav>
    <div style="padding:16px;border-top:1px solid #e8f5e9;background:#f9fbe7;">
        <p style="margin:0;font-size:11px;color:#0a4d1e;font-weight:700;">CORE VESTER HEALTHCARE</p>
        <p style="margin:4px 0 0 0;font-size:11px;color:#666;">Medical Equipment & Supplies</p>
    </div>
</div>

<!-- CART SIDEBAR -->
<div id="cartSidebar" style="position:fixed;top:0;right:-100%;width:360px;max-width:90vw;height:100%;background:#fff;border-left:5px solid #0a4d1e;z-index:1100;transition:right 0.3s;display:flex;flex-direction:column;">
  <div style="height:70px;border-bottom:3px solid #0a4d1e;display:flex;align-items:center;justify-content:space-between;padding:0 18px;flex-shrink:0;">
    <b style="color:#0a4d1e;">Your Cart</b>
    <button type="button" onclick="closeCartSidebar()" style="width:32px;height:32px;border-radius:8px;border:1px solid #c5e1a5;background:#f1f8e9;cursor:pointer;"><i class="fas fa-times"></i></button>
  </div>
  <div style="flex:1;overflow-y:auto;padding:16px;" id="globalCartBody">
    <p style="text-align:center;color:#888;margin-top:30px;">Cart empty</p>
  </div>
  <div style="padding:16px;border-top:1px solid #e8f5e9;background:#f9fbe7;flex-shrink:0;">
    <div style="display:flex;justify-content:space-between;margin-bottom:10px;"><b>Total:</b><b style="color:#0a4d1e;">KES <span id="globalCartTotalSide">0</span></b></div>
    <button type="button" id="globalCheckoutBtn" style="width:100%;padding:12px;background:#0a4d1e;color:#fff;border:none;border-radius:8px;font-weight:800;cursor:pointer;">PACKAGE ORDER</button>
  </div>
</div>

<!-- MAIN CONTENT -->
<div style="width:100%;max-width:100vw;overflow-x:hidden;min-height:calc(100vh - 80px);">
    <%- body %>
</div>

<script>
function openMenuSidebar(){
  document.getElementById('menuSidebar').style.right='0';
  document.getElementById('menuOverlay').style.display='block';
}
function closeMenuSidebar(){
  document.getElementById('menuSidebar').style.right='-100%';
  document.getElementById('menuOverlay').style.display='none';
}
function openCartSidebar(){
  closeMenuSidebar();
  document.getElementById('cartSidebar').style.right='0';
  document.getElementById('cartOverlay').style.display='block';
  loadCart();
}
function closeCartSidebar(){
  document.getElementById('cartSidebar').style.right='-100%';
  document.getElementById('cartOverlay').style.display='none';
}
async function loadCart(){
  try{
    const r = await fetch('/products/cart-data',{credentials:'include'});
    const d = await r.json();
    document.getElementById('headerCartCount').innerText = d.count||0;
    document.getElementById('headerCartTotal').innerText = (d.total||0).toLocaleString();
    const sideTotal = document.getElementById('globalCartTotalSide');
    if(sideTotal) sideTotal.innerText = (d.total||0).toLocaleString();
    const body = document.getElementById('globalCartBody');
    if(!d.cart||d.cart.length===0){
      body.innerHTML='<p style="text-align:center;color:#888;margin-top:30px;">Cart empty</p>';
      return;
    }
    let html='';
    d.cart.forEach(i=>{
      html+=`<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;padding-bottom:12px;border-bottom:1px solid #eee;"><div><b style="font-size:13px;">${i.name}</b><br><small>KES ${i.price} x ${i.qty}</small></div><button type="button" onclick="removeItem('${i.productId}')" style="width:28px;height:28px;background:#c62828;color:#fff;border:none;border-radius:6px;cursor:pointer;">×</button></div>`;
    });
    body.innerHTML=html;
  }catch(e){}
}
async function removeItem(id){
  await fetch('/products/remove-from-cart',{method:'POST',headers:{'Content-Type':'application/json'},credentials:'include',body:JSON.stringify({productId:id})});
  loadCart();
}
document.getElementById('globalCheckoutBtn').addEventListener('click', async function(){
  const r=await fetch('/packages/create',{method:'POST',headers:{'Content-Type':'application/json'},credentials:'include',body:JSON.stringify({})});
  const d=await r.json();
  if(d.success) window.location.href='/packages/'+d.packageId;
  else alert(d.message||'Failed');
});
document.addEventListener('keydown', function(e){ if(e.key==='Escape'){ closeMenuSidebar(); closeCartSidebar(); } });
loadCart();
</script>

</body>
</html>