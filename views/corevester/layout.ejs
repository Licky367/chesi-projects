<!DOCTYPE html>
<html lang="en">

<head>
<%- include("layout-partials/meta") %>
</head>

<%
/* =========================================================
   AUTHENTICATION PAGES
========================================================= */
const authPages = [
    "/login",
    "/signup",
    "/forgot-password",
    "/reset-password"
];

const currentPagePath =
    currentPath ||
    (typeof req !== "undefined" && req.path) ||
    "";

const isAuthPage =
    authPages.includes(currentPagePath);
%>

<body class="<%= isAuthPage ? 'auth-page' : 'app-page' %>">

<%
let homeLink = "/";
let headerTitle = "COREVESTER";
%>

<% if(!isAuthPage){ %>
<%- include("layout-partials/header", {
    homeLink: homeLink,
    headerTitle: headerTitle
}) %>
<% } %>

<!-- =========================================================
   MAIN CONTENT
========================================================= -->
<div class="main">
    <%- body %>
</div>

<!-- =========================================================
   FOOTER
========================================================= -->
<%- include("layout-partials/footer") %>

<% if(!isAuthPage){ %>
<script>
const profileBox = document.getElementById("profileBox");
function toggleProfile(event){
    event.stopPropagation();
    if(profileBox){
        profileBox.classList.toggle("active");
    }
}

document.addEventListener("click", function(event){
    if(profileBox &&!profileBox.contains(event.target)){
        profileBox.classList.remove("active");
    }
});

document.addEventListener("keydown", function(event){
    if(event.key === "Escape"){
        if(profileBox){
            profileBox.classList.remove("active");
        }
    }
});
</script>
<% } %>

</body>
</html>