<div style="max-width:1300px; margin:0 auto; padding:20px; box-sizing:border-box;">

    <!-- CART SUMMARY ONLY - stats removed -->
    <div style="display:flex; justify-content:flex-end; margin-bottom:15px;">
        <div style="background:#0a4d1e; border-radius:14px; padding:12px 16px; color:white; display:flex; align-items:center; gap:14px; box-shadow:0 4px 15px rgba(10,77,30,0.2);">
            <div style="text-align:right;">
                <p style="margin:0; font-size:10px; letter-spacing:1px; opacity:0.8;">CART</p>
                <p style="margin:0; font-size:16px; font-weight:800;"><%= cartCount %> items • KES <%= cartTotal.toLocaleString() %></p>
            </div>
            <button onclick="openCart()" style="background:white; color:#0a4d1e; border:none; width:42px; height:42px; border-radius:10px; cursor:pointer; font-size:16px;">
                <i class="fas fa-shopping-bag"></i>
            </button>
        </div>
    </div>

    <!-- CATEGORY FILTER -->
    <div style="display:flex; gap:10px; overflow-x:auto; padding:10px 0 15px 0; scrollbar-width:none; white-space:nowrap;">
        <a href="/products?category=all" style="padding:9px 18px; border-radius:30px; text-decoration:none; font-size:12px; font-weight:700; background:<%= activeCategory==='all'? '#0a4d1e' : 'white' %>; color:<%= activeCategory==='all'? 'white' : '#0a4d1e' %>; border:1.5px solid #0a4d1e; flex-shrink:0;">All</a>
        <% categories.forEach(cat=>{ %>
            <a href="/products?category=<%= cat %>" style="padding:9px 18px; border-radius:30px; text-decoration:none; font-size:12px; font-weight:600; background:<%= activeCategory===cat? '#0a4d1e' : 'white' %>; color:<%= activeCategory===cat? 'white' : '#333' %>; border:1.5px solid <%= activeCategory===cat? '#0a4d1e' : '#ddd' %>; flex-shrink:0; text-transform:capitalize;"><%= cat %></a>
        <% }) %>
    </div>

    <!-- PRODUCTS - 70% WIDTH / 80% HEIGHT -->
    <div style="display:flex; gap:12px; overflow-x:auto; padding:10px 5px 25px 5px; scroll-snap-type:x mandatory;">
        <% if(products.length === 0){ %>
            <div style="width:100%; text-align:center; padding:50px; background:white; border-radius:16px; border:2px dashed #c5e1a5;">
                <p style="color:#777; font-size:13px;">No products found</p>
            </div>
        <% } %>

        <% products.forEach(product=>{ %>
            <!-- CARD CLICKABLE TO /products/details -->
            <a href="/products/<%= product._id %>" style="text-decoration:none; color:inherit; min-width:168px; max-width:168px; flex-shrink:0; scroll-snap-align:start;">
                <div style="background:white; border-radius:14px; border:1px solid #e8f5e9; box-shadow:0 3px 12px rgba(0,0,0,0.05); overflow:hidden; display:flex; flex-direction:column; height:210px; transition:0.2s; cursor:pointer;" onmouseover="this.style.transform='translateY(-4px)'; this.style.boxShadow='0 8px 20px rgba(0,0,0,0.1)'" onmouseout="this.style.transform='none'; this.style.boxShadow='0 3px 12px rgba(0,0,0,0.05)'">

                    <!-- Image - 80% height (was 160px -> now 125px) -->
                    <div style="height:125px; background:#f6fbf6; display:flex; align-items:center; justify-content:center; position:relative; overflow:hidden;">
                        <% if(product.image){ %>
                            <img src="<%= product.image %>" style="width:100%; height:100%; object-fit:cover;" />
                        <% } else { %>
                            <i class="fas fa-pills" style="font-size:28px; color:#a5d6a7;"></i>
                        <% } %>
                        <span style="position:absolute; top:6px; left:6px; background:<%= product.availableUnits>0? '#0a4d1e' : '#c62828' %>; color:white; font-size:9px; font-weight:800; padding:3px 7px; border-radius:20px;">
                            <%= product.availableUnits>0? product.availableUnits + ' left' : 'OUT' %>
                        </span>
                        <% if(product.inCartQty>0){ %>
                            <span style="position:absolute; top:6px; right:6px; background:#ff9800; color:white; font-size:9px; font-weight:800; padding:3px 7px; border-radius:20px;"><%= product.inCartQty %></span>
                        <% } %>
                    </div>

                    <!-- Content - smaller -->
                    <div style="padding:10px; flex:1; display:flex; flex-direction:column;">
                        <p style="margin:0; font-size:8px; color:#2e7d32; font-weight:800; letter-spacing:0.8px; text-transform:uppercase;"><%= product.category %></p>
                        <h3 style="margin:4px 0 0 0; font-size:12px; font-weight:700; color:#111; line-height:1.3; height:30px; overflow:hidden;"><%= product.name %></h3>

                        <div style="margin-top:auto; display:flex; justify-content:space-between; align-items:center; padding-top:8px;">
                            <div>
                                <p style="margin:0; font-size:9px; color:#888;">KES</p>
                                <p style="margin:0; font-size:13px; font-weight:900; color:#0a4d1e;"><%= product.unitSellPrice.toLocaleString() %></p>
                            </div>
                            <button onclick="event.preventDefault(); event.stopPropagation(); addToCart('<%= product._id %>')" <%= product.availableUnits<=0? 'disabled' : '' %> style="width:30px; height:30px; border-radius:8px; border:none; background:<%= product.availableUnits>0? '#0a4d1e' : '#ddd' %>; color:white; cursor:pointer; font-size:12px;">
                                <i class="fas fa-plus"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </a>
        <% }) %>
    </div>
</div>

<!-- CART DRAWER - ORDER NOW -> /packages -->
<div id="cartOverlay" onclick="closeCart()" style="position:fixed; inset:0; background:rgba(0,0,0,0.4); z-index:1300; display:none;"></div>
<div id="cartDrawer" style="position:fixed; top:0; right:-380px; width:360px; max-width:90vw; height:100vh; background:white; z-index:1400; transition:0.35s; display:flex; flex-direction:column; border-left:5px solid #0a4d1e;">

    <div style="height:70px; border-bottom:3px solid #0a4d1e; display:flex; align-items:center; justify-content:space-between; padding:0 20px; flex-shrink:0;">
        <h3 style="margin:0; color:#0a4d1e; font-size:15px;">Bag (<%= cartCount %>)</h3>
        <button onclick="closeCart()" style="width:32px; height:32px; border-radius:8px; border:1px solid #ddd; background:white; cursor:pointer;"><i class="fas fa-times"></i></button>
    </div>

    <div style="flex:1; overflow-y:auto; padding:12px; display:flex; flex-direction:column; gap:10px;">
        <% cart.forEach(item=>{ %>
            <div style="display:flex; gap:10px; background:#f9fbe7; border-radius:10px; padding:8px; border:1px solid #e8f5e9;">
                <div style="width:44px; height:44px; background:white; border-radius:8px; overflow:hidden; display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                    <% if(item.image){ %><img src="<%= item.image %>" style="width:100%; height:100%; object-fit:cover;"><% } else { %><i class="fas fa-box" style="color:#a5d6a7; font-size:14px;"></i><% } %>
                </div>
                <div style="flex:1;">
                    <p style="margin:0; font-size:12px; font-weight:600; line-height:1.2;"><%= item.name %></p>
                    <p style="margin:2px 0 0 0; font-size:11px; color:#0a4d1e; font-weight:700;">KES <%= item.price.toLocaleString() %> x <%= item.qty %></p>
                </div>
                <button onclick="removeFromCart('<%= item.productId %>')" style="background:none; border:none; color:#c62828; cursor:pointer; padding:4px;"><i class="fas fa-trash" style="font-size:12px;"></i></button>
            </div>
        <% }) %>
        <% if(cart.length===0){ %><p style="text-align:center; color:#888; margin-top:40px; font-size:13px;">Your bag is empty</p><% } %>
    </div>

    <div style="padding:16px; border-top:1px solid #eee; background:#fff; flex-shrink:0;">
        <div style="display:flex; justify-content:space-between; margin-bottom:12px;">
            <span style="font-weight:700; font-size:13px;">Total</span>
            <span style="font-weight:900; color:#0a4d1e; font-size:16px;">KES <%= cartTotal.toLocaleString() %></span>
        </div>
        <!-- CHANGED TO ORDER NOW -> /packages -->
        <button onclick="orderNow()" style="width:100%; padding:13px; background:#0a4d1e; color:white; border:none; border-radius:12px; font-weight:800; cursor:pointer; font-size:13px; letter-spacing:0.5px;">ORDER NOW</button>
        <p style="font-size:10px; color:#888; text-align:center; margin-top:8px;">Creates a package in /packages</p>
    </div>
</div>

<script>
async function addToCart(id){
    const res = await fetch('/products/add-to-cart', {
        method:'POST',
        headers:{'Content-Type':'application/json'},
        body: JSON.stringify({productId:id, qty:1})
    });
    const data = await res.json();
    if(data.success) location.reload();
    else alert(data.message);
}
async function removeFromCart(id){
    await fetch('/products/remove-from-cart', {
        method:'POST',
        headers:{'Content-Type':'application/json'},
        body: JSON.stringify({productId:id})
    });
    location.reload();
}
async function orderNow(){
    if(<%= cartCount %>===0){ alert('Cart empty'); return; }
    // Create package from cart
    const res = await fetch('/packages/create-from-cart', { method:'POST' });
    const data = await res.json();
    if(data.success){
        window.location.href = '/packages/' + data.packageId;
    } else {
        alert(data.message);
    }
}
function openCart(){
    document.getElementById('cartDrawer').style.right='0';
    document.getElementById('cartOverlay').style.display='block';
}
function closeCart(){
    document.getElementById('cartDrawer').style.right='-380px';
    document.getElementById('cartOverlay').style.display='none';
}
</script>