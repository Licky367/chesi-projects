<%- contentFor('body') %>
<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">Marketplace</h2>
        <button id="cartBtn" class="btn btn-dark position-relative" style="cursor:pointer;">
            🛒 Cart <span id="cartCount" class="badge bg-danger ms-1"><%= cartCount||0 %></span>
        </button>
    </div>

    <div class="mb-3 d-flex gap-2 overflow-auto pb-2">
        <a href="/products?category=all" class="btn btn-sm <%= activeCategory==='all'?'btn-primary':'btn-outline-primary' %>">All</a>
        <% (categories||[]).forEach(c=>{ %>
            <a href="/products?category=<%= c %>" class="btn btn-sm <%= activeCategory===c?'btn-primary':'btn-outline-primary' %> text-capitalize"><%= c %></a>
        <% }) %>
    </div>

    <div class="row g-3">
        <% if(products.length===0){ %>
            <div class="col-12 text-center py-5"><p>No products found.</p></div>
        <% } %>
        <% products.forEach(p=>{ %>
        <div class="col-6 col-md-4 col-lg-3">
            <div class="card h-100 product-card shadow-sm border-0" data-product-id="<%= p._id %>" style="cursor:pointer;">
                <img src="<%= p.image||'/images/no-image.png' %>" class="card-img-top" style="height:200px;object-fit:cover;">
                <div class="card-body d-flex flex-column">
                    <h6 class="card-title mb-1 text-truncate"><%= p.name %></h6>
                    <small class="text-muted text-capitalize"><%= p.category %></small>
                    <div class="mt-2 d-flex justify-content-between align-items-center">
                        <strong>Ksh <%= p.unitSellPrice.toLocaleString() %></strong>
                        <small class="<%= p.units<=0?'text-danger': p.units<5 ? 'text-warning':'text-success' %>"><%= p.units<=0?'Out': p.units+' left' %></small>
                    </div>
                    <button 
                        class="btn btn-primary btn-sm mt-3 add-to-cart-btn w-100" 
                        data-id="<%= p._id %>"
                        data-name="<%= p.name %>"
                        data-price="<%= p.unitSellPrice %>"
                        data-stock="<%= p.units %>"
                        <%= p.units<=0?'disabled':'' %>
                        style="pointer-events:auto; cursor:pointer; z-index:2; position:relative;"
                    >
                        <%= p.units<=0?'Out of Stock':'Add to Cart' %>
                    </button>
                </div>
            </div>
        </div>
        <% }) %>
    </div>
</div>

<!-- QTY POPUP -->
<div class="modal fade" id="qtyModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered modal-sm">
    <div class="modal-content">
      <div class="modal-body text-center p-4">
        <h6 id="qtyProductName" class="fw-bold"></h6>
        <p class="text-muted small">Available: <span id="qtyAvailable" class="fw-bold"></span></p>
        <div class="d-flex justify-content-center align-items-center gap-3 my-4">
            <button class="btn btn-outline-secondary rounded-circle" id="qtyMinus" style="width:40px;height:40px;">-</button>
            <span id="qtyValue" style="font-size:1.8rem;min-width:50px;font-weight:bold;">1</span>
            <button class="btn btn-outline-secondary rounded-circle" id="qtyPlus" style="width:40px;height:40px;">+</button>
        </div>
        <button class="btn btn-primary w-100" id="qtyConfirm">Add <span id="qtyConfirmCount">1</span> to Cart</button>
        <button class="btn btn-link w-100 mt-2" data-bs-dismiss="modal">Cancel</button>
      </div>
    </div>
  </div>
</div>

<!-- CART MODAL -->
<div class="modal fade" id="cartModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header"><h5 class="fw-bold">Your Cart</h5><button class="btn-close" data-bs-dismiss="modal"></button></div>
      <div class="modal-body" id="cartBody">
        <% if(cart && cart.length){ cart.forEach(item=>{ %>
            <div class="d-flex justify-content-between align-items-center mb-3 cart-item border-bottom pb-2" data-id="<%= item.productId %>">
                <div style="max-width:60%"><strong><%= item.name %></strong><br><small>Ksh <%= item.price %> x <span class="cart-qty"><%= item.qty %></span></small></div>
                <div class="d-flex align-items-center gap-1">
                    <button class="btn btn-sm btn-outline-secondary cart-minus" data-id="<%= item.productId %>">-</button>
                    <button class="btn btn-sm btn-outline-secondary cart-plus" data-id="<%= item.productId %>">+</button>
                    <button class="btn btn-sm btn-danger cart-remove ms-2" data-id="<%= item.productId %>">×</button>
                </div>
            </div>
        <% }) } else { %><p class="text-center text-muted py-4">Cart is empty</p><% } %>
      </div>
      <div class="modal-footer d-block">
        <div class="d-flex justify-content-between mb-3"><strong>Total:</strong><strong id="cartTotal">Ksh <%= (cartTotal||0).toLocaleString() %></strong></div>
        <% if(cart && cart.length){ %><button class="btn btn-success w-100" id="checkoutBtn">Package This Order</button><% } %>
      </div>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', ()=>{
    const qtyModalEl = document.getElementById('qtyModal');
    const cartModalEl = document.getElementById('cartModal');
    const qtyModal = new bootstrap.Modal(qtyModalEl);
    const cartModal = new bootstrap.Modal(cartModalEl);
    let selected = {id:null, stock:0, qty:1};

    // CARD CLICK -> DETAIL (but not when add-to-cart clicked)
    document.querySelectorAll('.product-card').forEach(card=>{
        card.addEventListener('click', (e)=>{
            if(e.target.closest('.add-to-cart-btn')) return;
            window.location.href = '/products/' + card.dataset.productId;
        });
    });

    // ADD TO CART -> QTY POPUP
    document.querySelectorAll('.add-to-cart-btn').forEach(btn=>{
        btn.addEventListener('click', (e)=>{
            e.preventDefault();
            e.stopPropagation();
            selected.id = btn.dataset.id;
            selected.stock = parseInt(btn.dataset.stock);
            selected.qty = 1;
            document.getElementById('qtyProductName').innerText = btn.dataset.name;
            document.getElementById('qtyAvailable').innerText = selected.stock;
            document.getElementById('qtyValue').innerText = 1;
            document.getElementById('qtyConfirmCount').innerText = 1;
            qtyModal.show();
        });
    });

    document.getElementById('qtyPlus').onclick = ()=>{ if(selected.qty < selected.stock){ selected.qty++; updateQty(); } };
    document.getElementById('qtyMinus').onclick = ()=>{ if(selected.qty > 1){ selected.qty--; updateQty(); } };
    function updateQty(){
        document.getElementById('qtyValue').innerText = selected.qty;
        document.getElementById('qtyConfirmCount').innerText = selected.qty;
    }

    document.getElementById('qtyConfirm').onclick = async ()=>{
        try{
            const res = await fetch('/products/add-to-cart', {
                method:'POST', headers:{'Content-Type':'application/json'},
                body: JSON.stringify({productId:selected.id, qty:selected.qty})
            });
            const data = await res.json();
            if(!data.success){ alert(data.message); return; }
            document.getElementById('cartCount').innerText = data.cartCount;
            qtyModal.hide();
            setTimeout(()=>location.reload(), 300);
        }catch(err){ alert(err.message); }
    };

    document.getElementById('cartBtn').addEventListener('click', ()=> cartModal.show());

    async function callCart(url, body){
        const res = await fetch(url, {method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(body)});
        const d = await res.json();
        if(!d.success) alert(d.message); else location.reload();
    }
    document.querySelectorAll('.cart-plus').forEach(b=> b.onclick = ()=> {
        const id=b.dataset.id; const el=document.querySelector(`.cart-item[data-id="${id}"] .cart-qty`); callCart('/products/update-cart-qty', {productId:id, qty: parseInt(el.innerText)+1});
    });
    document.querySelectorAll('.cart-minus').forEach(b=> b.onclick = ()=> {
        const id=b.dataset.id; const el=document.querySelector(`.cart-item[data-id="${id}"] .cart-qty`); callCart('/products/update-cart-qty', {productId:id, qty: parseInt(el.innerText)-1});
    });
    document.querySelectorAll('.cart-remove').forEach(b=> b.onclick = ()=> callCart('/products/remove-from-cart', {productId:b.dataset.id}));

    const checkoutBtn = document.getElementById('checkoutBtn');
    if(checkoutBtn){
        checkoutBtn.onclick = async ()=>{
            const res = await fetch('/packages/create', {method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({})});
            const d = await res.json();
            if(d.success) window.location.href = '/packages/'+d.packageId;
            else alert(d.message);
        };
    }
});
</script>

<style>
.product-card{ transition: transform 0.15s ease, box-shadow 0.15s ease; }
.product-card:hover{ transform:translateY(-4px); box-shadow:0 8px 20px rgba(0,0,0,0.12) !important; }
</style>