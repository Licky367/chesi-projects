    font-size:
        .67rem;

    font-weight:
        950;

    white-space:
        nowrap;

    overflow:
        hidden;

    text-overflow:
        ellipsis;

}



/* ==========================================================
   MAIN
========================================================== */

.market-main {

    width:
        100%;

    max-width:
        1180px;

    margin:
        0
        auto;

    padding:
        15px
        12px
        0;

}



/* ==========================================================
   SECTION HEADING
========================================================== */

.section-heading {

    display:
        flex;

    align-items:
        center;

    justify-content:
        space-between;

    margin-bottom:
        7px;

}


