<%- contentFor('body') %>

<style>

/* =========================================================
   MARKETPLACE
   ========================================================= */

.market-wrap{
    --green-950:#073b1a;
    --green-900:#0a4d1e;
    --green-800:#11652a;
    --green-700:#16803a;
    --green-100:#e9f5ed;
    --green-50:#f3f9f5;

    --orange-600:#e88a1a;
    --orange-100:#fff2df;

    --ink:#17231b;
    --muted:#718078;
    --line:#e4ebe6;
    --surface:#ffffff;
    --page:#f6f8f6;

    min-height:100vh;
    padding-bottom:40px;

    background:
        radial-gradient(
            circle at 100% 0%,
            rgba(22,128,58,.055),
            transparent 28%
        ),
        var(--page);

    color:var(--ink);
}


/* =========================================================
   TOP HEADER
   ========================================================= */

.market-top{
    position:sticky;
    top:0;
    z-index:30;

    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:20px;

    padding:14px 16px;

    background:rgba(255,255,255,.94);
    backdrop-filter:blur(18px);
    -webkit-backdrop-filter:blur(18px);

    border-bottom:1px solid rgba(218,229,220,.9);

    box-shadow:
        0 5px 25px rgba(16,52,29,.055);
}

.market-heading{
    min-width:0;
}

.market-title-row{
    display:flex;
    align-items:center;
    gap:9px;
}

.market-title-mark{
    display:flex;
    align-items:center;
    justify-content:center;

    width:34px;
    height:34px;

    flex:0 0 34px;

    background:var(--green-900);
    color:#fff;

    border-radius:10px;

    font-size:.9rem;

    box-shadow:
        0 5px 12px rgba(10,77,30,.15);
}

.market-title{
    margin:0;

    color:var(--green-950);

    font-size:1.45rem;
    line-height:1;
    font-weight:950;
    letter-spacing:-.7px;
}

.market-sub{
    margin:7px 0 0 43px;

    color:var(--muted);

    font-size:.72rem;
    font-weight:650;
}


/* =========================================================
   HEADER ACTIONS
   ========================================================= */

.market-actions{
    display:flex;
    align-items:center;
    gap:8px;
    flex:0 0 auto;
}

.pill-count{
    display:flex;
    align-items:center;
    gap:8px;

    height:42px;
    padding:4px 12px 4px 5px;

    background:var(--green-50);

    border:1px solid #d6e5d9;
    border-radius:50px;

    color:#557060;

    font-size:.7rem;
    font-weight:800;

    white-space:nowrap;
}

.pill-count b{
    display:flex;
    align-items:center;
    justify-content:center;

    width:32px;
    height:32px;

    background:var(--green-900);
    color:#fff;

    border-radius:50%;

    font-size:.76rem;
}

.cart-main-btn{
    display:flex;
    align-items:center;
    justify-content:center;
    gap:8px;

    min-width:44px;
    height:42px;

    padding:0 14px;

    background:var(--green-900);
    color:#fff;

    border:0;
    border-radius:12px;

    font-size:.7rem;
    font-weight:900;
    letter-spacing:.3px;

    cursor:pointer;

    box-shadow:
        0 6px 15px rgba(10,77,30,.16);

    transition:
        transform .18s ease,
        background .18s ease,
        box-shadow .18s ease;
}

.cart-main-btn:hover{
    background:var(--green-950);
    transform:translateY(-1px);

    box-shadow:
        0 9px 20px rgba(10,77,30,.21);
}

.cart-main-btn:active{
    transform:scale(.96);
}


/* =========================================================
   CATEGORY BAR
   ========================================================= */

.category-shell{
    position:relative;

    background:#fff;

    border-bottom:1px solid var(--line);
}

.category-bar{
    display:flex;
    align-items:center;
    gap:7px;

    overflow-x:auto;

    padding:11px 14px;

    scrollbar-width:none;
    -webkit-overflow-scrolling:touch;
}

.category-bar::-webkit-scrollbar{
    display:none;
}

.cat-pill{
    display:inline-flex;
    align-items:center;
    justify-content:center;

    flex:0 0 auto;

    min-height:35px;
    padding:0 15px;

    background:#fff;
    color:#52665a;

    border:1px solid #dce6df;
    border-radius:50px;

    text-decoration:none;

    font-size:.68rem;
    font-weight:850;

    transition:
        color .16s ease,
        background .16s ease,
        border-color .16s ease,
        transform .16s ease;
}

.cat-pill:hover{
    color:var(--green-900);
    border-color:#bcd1c1;
    background:var(--green-50);
}

.cat-pill.active{
    background:var(--green-900);
    color:#fff;

    border-color:var(--green-900);

    box-shadow:
        0 5px 13px rgba(10,77,30,.14);
}


/* =========================================================
   PRODUCT SECTION
   ========================================================= */

.product-section{
    padding:18px 0 0;
}

.products-intro{
    display:flex;
    align-items:center;
    justify-content:space-between;

    padding:0 14px 13px;
}

.products-label{
    color:#4c6053;

    font-size:.72rem;
    font-weight:850;
    text-transform:uppercase;
    letter-spacing:.55px;
}

.products-count{
    color:#8a978f;

    font-size:.66rem;
    font-weight:700;
}


/* =========================================================
   GRID
   ========================================================= */

.grid-wrap{
    display:grid;

    grid-template-columns:
        repeat(2,minmax(0,1fr));

    gap:11px;

    padding:0 12px;
}

@media(min-width:600px){

    .grid-wrap{
        grid-template-columns:
            repeat(3,minmax(0,1fr));

        gap:15px;
        padding:0 16px;
    }

}

@media(min-width:900px){

    .grid-wrap{
        grid-template-columns:
            repeat(4,minmax(0,1fr));

        gap:17px;
        padding:0 22px;
    }

}

@media(min-width:1250px){

    .grid-wrap{
        grid-template-columns:
            repeat(5,minmax(0,1fr));

        max-width:1450px;
        margin:0 auto;

        gap:19px;
        padding:0 28px;
    }

}


/* =========================================================
   LARGE COLLECTION HORIZONTAL ROW
   ========================================================= */

.prod-scroll{
    display:flex;
    gap:12px;

    overflow-x:auto;

    padding:0 12px 17px;

    scroll-snap-type:x mandatory;

    scrollbar-width:none;
    -webkit-overflow-scrolling:touch;
}

.prod-scroll::-webkit-scrollbar{
    display:none;
}

@media(min-width:768px){

    .prod-scroll{
        gap:16px;
        padding-left:22px;
        padding-right:22px;
    }

}


/* =========================================================
   PRODUCT CARD
   ========================================================= */

.card-box{
    position:relative;

    min-width:calc(50% - 6px);
    max-width:calc(50% - 6px);
    flex:0 0 calc(50% - 6px);

    overflow:hidden;

    background:var(--surface);

    border:1px solid #e0e8e2;
    border-radius:17px;

    cursor:pointer;

    scroll-snap-align:start;

    box-shadow:
        0 3px 12px rgba(26,61,38,.045);

    transition:
        transform .2s ease,
        box-shadow .2s ease,
        border-color .2s ease;
}

.card-box:hover{
    transform:translateY(-4px);

    border-color:#c8d9cc;

    box-shadow:
        0 12px 28px rgba(26,61,38,.10);
}

.grid-wrap .card-box{
    min-width:0;
    max-width:none;
    width:100%;
}

@media(min-width:768px){

    .prod-scroll .card-box{
        min-width:calc(25% - 12px);
        max-width:calc(25% - 12px);
        flex:0 0 calc(25% - 12px);
    }

}


/* =========================================================
   IMAGE
   ========================================================= */

.product-image-wrap{
    position:relative;

    width:100%;

    aspect-ratio:1 / .88;

    overflow:hidden;

    background:
        linear-gradient(
            135deg,
            #edf5ef,
            #e4eee7
        );
}

.product-image{
    display:block;

    width:100%;
    height:100%;

    object-fit:cover;

    transition:
        transform .45s cubic-bezier(.2,.7,.2,1);
}

.card-box:hover .product-image{
    transform:scale(1.055);
}


/* =========================================================
   IMAGE OVERLAY
   ========================================================= */

.product-image-wrap::after{
    content:"";

    position:absolute;
    inset:0;

    pointer-events:none;

    background:
        linear-gradient(
            to bottom,
            rgba(0,0,0,.08),
            transparent 35%,
            transparent 75%,
            rgba(0,0,0,.08)
        );
}


/* =========================================================
   STOCK BADGE
   ========================================================= */

.left-badge{
    position:absolute;

    top:9px;
    left:9px;

    z-index:5;

    display:inline-flex;
    align-items:center;
    gap:5px;

    min-height:25px;

    padding:0 8px;

    background:rgba(255,255,255,.94);

    color:var(--green-900);

    border:1px solid rgba(255,255,255,.7);

    border-radius:50px;

    font-size:.59rem;
    font-weight:900;

    box-shadow:
        0 3px 9px rgba(0,0,0,.10);

    backdrop-filter:blur(6px);
}

.stock-dot{
    width:6px;
    height:6px;

    border-radius:50%;

    background:#23a653;
}

.stock-low .stock-dot{
    background:var(--orange-600);
}

.stock-out{
    color:#a83232;
    background:#fff7f7;
    border-color:#f2d5d5;
}

.stock-out .stock-dot{
    background:#d74444;
}


/* =========================================================
   PRODUCT BODY
   ========================================================= */

.product-body{
    padding:12px 11px 12px;
}

.cat-label{
    margin-bottom:5px;

    color:#799080;

    font-size:.57rem;
    font-weight:900;

    text-transform:uppercase;
    letter-spacing:.65px;
}

.prod-name{
    min-height:35px;

    display:-webkit-box;
    -webkit-line-clamp:2;
    -webkit-box-orient:vertical;

    overflow:hidden;

    color:#1b2820;

    font-size:.84rem;
    line-height:1.3;
    font-weight:850;
}

.prod-price{
    display:flex;
    align-items:baseline;
    gap:3px;

    margin-top:8px;

    color:var(--green-900);

    font-size:1rem;
    line-height:1;

    font-weight:950;
}

.price-label{
    color:#839088;

    font-size:.55rem;
    font-weight:800;

    letter-spacing:.2px;
}


/* =========================================================
   ADD BUTTON
   ========================================================= */

.add-btn{
    display:flex;
    align-items:center;
    justify-content:center;
    gap:6px;

    width:100%;
    min-height:38px;

    margin-top:11px;

    padding:8px 9px;

    background:var(--green-900);
    color:#fff;

    border:0;
    border-radius:10px;

    font-size:.64rem;
    font-weight:900;
    letter-spacing:.15px;

    cursor:pointer;

    box-shadow:
        0 4px 9px rgba(10,77,30,.10);

    transition:
        background .16s ease,
        transform .16s ease,
        box-shadow .16s ease;
}

.add-btn:hover{
    background:var(--green-800);

    box-shadow:
        0 6px 13px rgba(10,77,30,.17);
}

.add-btn:active{
    transform:scale(.975);
}

.add-btn:disabled{
    background:#e4e9e5;
    color:#87928b;

    cursor:not-allowed;
    box-shadow:none;
}


/* =========================================================
   EMPTY PRODUCTS
   ========================================================= */

.market-empty{
    max-width:560px;

    margin:30px auto;
    padding:55px 24px;

    text-align:center;

    background:#fff;

    border:1px dashed #cbd9ce;
    border-radius:20px;

    box-shadow:
        0 5px 20px rgba(25,59,37,.035);

    color:#77847c;
}

.market-empty-icon{
    display:flex;
    align-items:center;
    justify-content:center;

    width:68px;
    height:68px;

    margin:0 auto 15px;

    background:var(--green-50);

    border-radius:20px;

    color:#82a08b;

    font-size:1.5rem;
}

.market-empty strong{
    display:block;

    margin-bottom:6px;

    color:#34463a;

    font-size:.92rem;
    font-weight:900;
}

.market-empty span{
    font-size:.73rem;
}


/* =========================================================
   QUANTITY MODAL
   ========================================================= */

.qty-modal-content{
    overflow:hidden;

    background:#fff;

    border:0;
    border-radius:22px;

    box-shadow:
        0 25px 70px rgba(12,39,21,.20);
}

.qty-modal-header{
    padding:20px 20px 17px;

    text-align:center;

    background:
        linear-gradient(
            135deg,
            #f1f8f3,
            #f9fbf9
        );

    border-bottom:1px solid #e2ebe4;
}

.qty-product-name{
    margin:0;

    color:var(--green-950);

    font-size:1rem;
    font-weight:950;
}

.qty-available{
    margin:6px 0 0;

    color:#77857c;

    font-size:.72rem;
}

.qty-available strong{
    color:var(--green-800);
}

.qty-selector{
    display:flex;
    align-items:center;
    justify-content:center;
    gap:23px;

    margin:22px 0 24px;
}

.qty-control{
    display:flex;
    align-items:center;
    justify-content:center;

    width:45px;
    height:45px;

    padding:0;

    background:#fff;

    border:1.5px solid #c7d9cc;
    border-radius:50%;

    color:var(--green-900);

    font-size:1.25rem;
    font-weight:900;

    cursor:pointer;

    transition:
        background .16s ease,
        border-color .16s ease,
        color .16s ease,
        transform .16s ease;
}

.qty-control:hover{
    background:var(--green-900);
    border-color:var(--green-900);
    color:#fff;
}

.qty-control:active{
    transform:scale(.91);
}

.qty-number{
    min-width:50px;

    color:var(--green-950);

    font-size:2.2rem;
    line-height:1;

    font-weight:950;
}

.qty-confirm{
    min-height:46px;
    margin-top:0;

    border-radius:12px;
}

.qty-cancel{
    width:100%;

    margin-top:7px;

    color:#7b8780 !important;

    font-size:.76rem;
    font-weight:750;

    text-decoration:none !important;
}


/* =========================================================
   CART OFFCANVAS
   ========================================================= */

.cart-sidebar{
    width:min(430px,94vw) !important;

    background:#fff;

    border-left:1px solid #dce7df !important;

    box-shadow:
        -18px 0 50px rgba(16,46,26,.14);
}


/* =========================================================
   CART HEADER
   ========================================================= */

.cart-header{
    display:flex;
    align-items:center;
    justify-content:space-between;

    padding:17px;

    background:
        linear-gradient(
            135deg,
            #f1f8f3,
            #fff
        );

    border-bottom:1px solid #dfe8e2;
}

.cart-title-wrap{
    display:flex;
    align-items:center;
    gap:11px;
}

.cart-title-icon{
    display:flex;
    align-items:center;
    justify-content:center;

    width:41px;
    height:41px;

    background:var(--green-900);
    color:#fff;

    border-radius:12px;

    box-shadow:
        0 5px 13px rgba(10,77,30,.14);
}

.cart-title{
    margin:0;

    color:var(--green-950);

    font-size:1rem;
    font-weight:950;
}

.cart-subtitle{
    margin:3px 0 0;

    color:#7a877f;

    font-size:.65rem;
    font-weight:650;
}


/* =========================================================
   CART BODY
   ========================================================= */

.cart-body{
    padding:10px 16px 20px !important;

    background:#fff;
}

.cart-item{
    display:flex;
    align-items:center;
    gap:12px;

    margin:0;

    padding:14px 0;

    border-bottom:1px solid #edf1ee !important;
}

.cart-item:last-child{
    border-bottom:0 !important;
}

.cart-product-info{
    min-width:0;
    flex:1;
}

.cart-product-name{
    display:block;

    color:#1c2a21;

    font-size:.81rem;
    line-height:1.3;
    font-weight:850;

    overflow:hidden;
    text-overflow:ellipsis;
}

.cart-product-price{
    display:block;

    margin-top:5px;

    color:#7b8880;

    font-size:.68rem;
}

.cart-qty{
    color:var(--green-900);
    font-weight:900;
}


/* =========================================================
   CART CONTROLS
   ========================================================= */

.cart-controls{
    display:flex;
    align-items:center;
    gap:5px;

    flex:0 0 auto;
}

.cart-control{
    display:flex;
    align-items:center;
    justify-content:center;

    width:31px;
    height:31px;

    padding:0;

    background:#fff;

    border:1px solid #d3dfd6;
    border-radius:8px;

    color:var(--green-900);

    font-size:.85rem;
    font-weight:900;

    cursor:pointer;

    transition:
        background .15s ease,
        border-color .15s ease,
        transform .15s ease;
}

.cart-control:hover{
    background:var(--green-50);
    border-color:#a9c4af;
}

.cart-control:active{
    transform:scale(.92);
}

.cart-remove{
    color:#b33333 !important;

    background:#fff7f7 !important;

    border-color:#efd2d2 !important;
}


/* =========================================================
   EMPTY CART
   ========================================================= */

.empty-cart{
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;

    min-height:310px;

    text-align:center;

    color:#8a968f;
}

.empty-cart-icon{
    display:flex;
    align-items:center;
    justify-content:center;

    width:72px;
    height:72px;

    margin-bottom:14px;

    background:
        linear-gradient(
            135deg,
            #f0f6f2,
            #e9f2eb
        );

    border-radius:22px;

    color:#89a092;

    font-size:1.45rem;
}

.empty-cart strong{
    color:#45554b;

    font-size:.88rem;
    font-weight:900;
}

.empty-cart span{
    margin-top:5px;

    color:#89948d;

    font-size:.7rem;
}


/* =========================================================
   CART FOOTER
   ========================================================= */

.cart-footer{
    padding:16px;

    background:
        linear-gradient(
            to bottom,
            #f8faf8,
            #f1f6f2
        );

    border-top:1px solid #dce7df;

    box-shadow:
        0 -5px 18px rgba(24,60,37,.035);
}

.cart-total{
    display:flex;
    align-items:center;
    justify-content:space-between;

    margin-bottom:12px;

    color:#59685f;

    font-size:.78rem;
    font-weight:800;
}

.cart-total strong{
    color:var(--green-950);

    font-size:1.08rem;
    font-weight:950;
}

.checkout-btn{
    min-height:47px;

    margin-top:0;

    border-radius:12px;
}


/* =========================================================
   MOBILE
   ========================================================= */

@media(max-width:575px){

    .market-top{
        padding:12px;
    }

    .market-title-mark{
        width:31px;
        height:31px;
        flex-basis:31px;

        border-radius:9px;
    }

    .market-title{
        font-size:1.28rem;
    }

    .market-sub{
        margin-left:40px;
        margin-top:6px;

        font-size:.64rem;
    }

    .pill-count{
        display:none;
    }

    .cart-main-btn{
        width:42px;
        min-width:42px;

        padding:0;

        font-size:0;
    }

    .cart-main-btn i{
        font-size:.9rem;
    }

    .category-bar{
        padding:10px 12px;
    }

    .cat-pill{
        min-height:34px;
        padding:0 13px;

        font-size:.63rem;
    }

    .product-section{
        padding-top:15px;
    }

    .products-intro{
        padding-left:12px;
        padding-right:12px;
    }

    .products-label{
        font-size:.65rem;
    }

    .products-count{
        font-size:.61rem;
    }

    .product-image-wrap{
        aspect-ratio:1 / .91;
    }

    .product-body{
        padding:10px;
    }

    .cat-label{
        font-size:.52rem;
    }

    .prod-name{
        font-size:.77rem;
        min-height:32px;
    }

    .prod-price{
        font-size:.88rem;
    }

    .add-btn{
        min-height:36px;

        margin-top:9px;

        font-size:.58rem;
    }

    .left-badge{
        top:7px;
        left:7px;

        min-height:23px;
        padding:0 7px;

        font-size:.53rem;
    }

}


/* =========================================================
   ACCESSIBILITY
   ========================================================= */

button:focus-visible,
a:focus-visible{
    outline:3px solid rgba(22,128,58,.24);
    outline-offset:3px;
}


/* =========================================================
   REDUCED MOTION
   ========================================================= */

@media(prefers-reduced-motion:reduce){

    .card-box,
    .product-image,
    .add-btn,
    .cart-main-btn,
    .qty-control,
    .cart-control{
        transition:none !important;
    }

}


/* =========================================================
   TOUCH DEVICES
   ========================================================= */

@media(hover:none){

    .card-box:hover{
        transform:none;
        box-shadow:
            0 3px 12px rgba(26,61,38,.045);
    }

    .card-box:hover .product-image{
        transform:none;
    }

}

</style><div class="market-wrap"><!-- =====================================================
     MARKETPLACE HEADER
====================================================== -->

<header class="market-top">

    <div class="market-heading">

        <div class="market-title-row">

            <div class="market-title-mark">
                <i class="fas fa-store"></i>
            </div>

            <h1 class="market-title">
                Marketplace
            </h1>

        </div>

        <div class="market-sub">

            <%= products.length %>
            <%= products.length === 1 ? 'product' : 'products' %>
            available

        </div>

    </div>


    <div class="market-actions">

        <div class="pill-count">

            <b id="cartCount">
                <%= cartCount || 0 %>
            </b>

            <span>

                Cart · KES

                <span id="cartTotalText">
                    <%= (cartTotal || 0).toLocaleString() %>
                </span>

            </span>

        </div>


        <button
            type="button"
            id="cartBtn"
            class="cart-main-btn"
            aria-label="Open shopping cart"
        >

            <i class="fas fa-shopping-bag"></i>

            <span>
                CART
            </span>

        </button>

    </div>

</header>


<!-- =====================================================
     CATEGORY NAVIGATION
====================================================== -->

<div class="category-shell">

    <nav
        class="category-bar"
        aria-label="Product categories"
    >

        <a
            href="/products?category=all"
            class="cat-pill <%= activeCategory === 'all' ? 'active' : '' %>"
        >
            All
        </a>


        <% (categories || []).forEach(c => { %>

            <a
                href="/products?category=<%= c %>"
                class="cat-pill text-capitalize <%= activeCategory === c ? 'active' : '' %>"
            >

                <%= c %>

            </a>

        <% }) %>

    </nav>

</div>


<!-- =====================================================
     PRODUCTS
====================================================== -->

<main class="product-section">


    <% if (!products || !products.length) { %>


        <div class="market-empty">

            <div class="market-empty-icon">
                <i class="fas fa-box-open"></i>
            </div>

            <strong>
                No products available
            </strong>

            <span>
                There are currently no products in this category.
            </span>

        </div>


    <% } else { %>


        <div class="products-intro">

            <span class="products-label">
                Available products
            </span>

            <span class="products-count">
                <%= products.length %> items
            </span>

        </div>


        <% if (products.length < 20) { %>


            <!-- =================================================
                 STANDARD GRID
            ================================================== -->

            <div class="grid-wrap">


                <% products.forEach(p => { %>

                    <%

                        const stock =
                            Number(p.units || 0);

                        let stockClass = '';

                        if(stock <= 0){

                            stockClass =
                                'stock-out';

                        }else if(stock <= 5){

                            stockClass =
                                'stock-low';

                        }

                    %>


                    <article
                        class="card-box"
                        data-product-id="<%= p._id %>"
                    >


                        <!-- IMAGE -->

                        <div class="product-image-wrap">

                            <span
                                class="left-badge <%= stockClass %>"
                            >

                                <span
                                    class="stock-dot"
                                ></span>

                                <% if(stock <= 0){ %>

                                    Out of stock

                                <% } else if(stock <= 5){ %>

                                    Only <%= stock %> left

                                <% } else { %>

                                    <%= stock %> available

                                <% } %>

                            </span>


                            <img
                                src="<%= p.image || '/images/no-image.png' %>"
                                alt="<%= p.name %>"
                                class="product-image"
                                loading="lazy"
                            >

                        </div>


                        <!-- PRODUCT INFORMATION -->

                        <div class="product-body">

                            <div class="cat-label">
                                <%= p.category %>
                            </div>


                            <div class="prod-name">
                                <%= p.name %>
                            </div>


                            <div class="prod-price">

                                <span class="price-label">
                                    KES
                                </span>

                                <%= Number(
                                    p.unitSellPrice || 0
                                ).toLocaleString() %>

                            </div>


                            <button
                                type="button"
                                class="add-btn add-to-cart-btn"
                                data-id="<%= p._id %>"
                                data-name="<%= p.name %>"
                                data-stock="<%= stock %>"
                                <%= stock <= 0 ? 'disabled' : '' %>
                            >

                                <i
                                    class="fas <%= stock <= 0
                                        ? 'fa-ban'
                                        : 'fa-cart-plus'
                                    %>"
                                ></i>


                                <%= stock <= 0
                                    ? 'OUT OF STOCK'
                                    : 'ADD TO CART'
                                %>

                            </button>

                        </div>

                    </article>

                <% }) %>


            </div>


        <% } else { %>


            <!-- =================================================
                 LARGE PRODUCT COLLECTION
            ================================================== -->

            <%

                const chunkSize = 10;

                for(
                    let i = 0;
                    i < products.length;
                    i += chunkSize
                ){

                    const chunk =
                        products.slice(
                            i,
                            i + chunkSize
                        );

            %>


                <div class="prod-scroll">


                    <% chunk.forEach(p => { %>

                        <%

                            const stock =
                                Number(p.units || 0);

                            let stockClass = '';

                            if(stock <= 0){

                                stockClass =
                                    'stock-out';

                            }else if(stock <= 5){

                                stockClass =
                                    'stock-low';

                            }

                        %>


                        <article
                            class="card-box"
                            data-product-id="<%= p._id %>"
                        >


                            <!-- IMAGE -->

                            <div class="product-image-wrap">

                                <span
                                    class="left-badge <%= stockClass %>"
                                >

                                    <span
                                        class="stock-dot"
                                    ></span>

                                    <% if(stock <= 0){ %>

                                        Out

                                    <% } else { %>

                                        <%= stock %> left

                                    <% } %>

                                </span>


                                <img
                                    src="<%= p.image || '/images/no-image.png' %>"
                                    alt="<%= p.name %>"
                                    class="product-image"
                                    loading="lazy"
                                >

                            </div>


                            <!-- BODY -->

                            <div class="product-body">

                                <div class="cat-label">
                                    <%= p.category %>
                                </div>


                                <div class="prod-name">
                                    <%= p.name %>
                                </div>


                                <div class="prod-price">

                                    <span class="price-label">
                                        KES
                                    </span>

                                    <%= Number(
                                        p.unitSellPrice || 0
                                    ).toLocaleString() %>

                                </div>


                                <button
                                    type="button"
                                    class="add-btn add-to-cart-btn"
                                    data-id="<%= p._id %>"
                                    data-name="<%= p.name %>"
                                    data-stock="<%= stock %>"
                                    <%= stock <= 0 ? 'disabled' : '' %>
                                >

                                    <i
                                        class="fas <%= stock <= 0
                                            ? 'fa-ban'
                                            : 'fa-cart-plus'
                                        %>"
                                    ></i>

                                    <%= stock <= 0
                                        ? 'OUT'
                                        : 'ADD CART'
                                    %>

                                </button>

                            </div>

                        </article>


                    <% }) %>


                </div>


            <% } %>


        <% } %>


    <% } %>


</main>

</div><!-- =========================================================
     QUANTITY MODAL
========================================================= --><div
    class="modal fade"
    id="qtyModal"
    tabindex="-1"
    aria-hidden="true"
><div class="modal-dialog modal-dialog-centered modal-sm">

    <div class="modal-content qty-modal-content">


        <div class="qty-modal-header">

            <h6
                class="qty-product-name"
                id="qtyProductName"
            ></h6>

            <p class="qty-available">

                Available:

                <strong id="qtyAvailable"></strong>

            </p>

        </div>


        <div class="modal-body text-center p-4">


            <div class="qty-selector">

                <button
                    type="button"
                    class="qty-control"
                    id="qtyMinus"
                    aria-label="Decrease quantity"
                >
                    −
                </button>


                <span
                    id="qtyValue"
                    class="qty-number"
                >
                    1
                </span>


                <button
                    type="button"
                    class="qty-control"
                    id="qtyPlus"
                    aria-label="Increase quantity"
                >
                    +
                </button>

            </div>


            <button
                type="button"
                class="add-btn qty-confirm"
                id="qtyConfirm"
            >

                <i class="fas fa-cart-plus"></i>

                ADD

                <span id="qtyConfirmCount">
                    1
                </span>

                TO CART

            </button>


            <button
                type="button"
                class="btn btn-link qty-cancel"
                data-bs-dismiss="modal"
            >
                Cancel
            </button>


        </div>

    </div>

</div>

</div><!-- =========================================================
     CART SIDEBAR
========================================================= --><div
    class="offcanvas offcanvas-end cart-sidebar"
    tabindex="-1"
    id="cartSidebar"
    aria-labelledby="cartSidebarLabel"
><!-- HEADER -->

<div class="cart-header">

    <div class="cart-title-wrap">

        <div class="cart-title-icon">
            <i class="fas fa-shopping-bag"></i>
        </div>

        <div>

            <h5
                class="cart-title"
                id="cartSidebarLabel"
            >
                Your Cart
            </h5>

            <p class="cart-subtitle">
                Review your selected products
            </p>

        </div>

    </div>


    <button
        type="button"
        class="btn-close"
        data-bs-dismiss="offcanvas"
        aria-label="Close"
    ></button>

</div>


<!-- BODY -->

<div class="offcanvas-body cart-body">


    <% if(cart && cart.length){ %>


        <% cart.forEach(item => { %>


            <div
                class="cart-item"
                data-id="<%= item.productId %>"
            >


                <div class="cart-product-info">

                    <span class="cart-product-name">
                        <%= item.name %>
                    </span>


                    <span class="cart-product-price">

                        KES
                        <%= Number(
                            item.price || 0
                        ).toLocaleString() %>

                        ×

                        <span class="cart-qty">
                            <%= item.qty %>
                        </span>

                    </span>

                </div>


                <div class="cart-controls">


                    <button
                        type="button"
                        class="cart-control cart-minus"
                        data-id="<%= item.productId %>"
                        aria-label="Decrease quantity"
                    >
                        −
                    </button>


                    <button
                        type="button"
                        class="cart-control cart-plus"
                        data-id="<%= item.productId %>"
                        aria-label="Increase quantity"
                    >
                        +
                    </button>


                    <button
                        type="button"
                        class="cart-control cart-remove"
                        data-id="<%= item.productId %>"
                        aria-label="Remove product"
                    >
                        ×
                    </button>


                </div>

            </div>


        <% }) %>


    <% } else { %>


        <div class="empty-cart">

            <div class="empty-cart-icon">

                <i class="fas fa-shopping-bag"></i>

            </div>

            <strong>
                Your cart is empty
            </strong>

            <span>
                Add products to begin your order.
            </span>

        </div>


    <% } %>


</div>


<!-- FOOTER -->

<div class="cart-footer">


    <div class="cart-total">

        <span>
            Cart total
        </span>

        <strong>

            KES
            <%= (cartTotal || 0).toLocaleString() %>

        </strong>

    </div>


    <% if(cart && cart.length){ %>


        <button
            type="button"
            class="add-btn checkout-btn"
            id="checkoutBtn"
        >

            <i class="fas fa-box"></i>

            PACKAGE ORDER

        </button>


    <% } %>


</div>

</div><script>

document.addEventListener('DOMContentLoaded', () => {


    /* =====================================================
       ELEMENTS
    ===================================================== */

    const qtyModalElement =
        document.getElementById('qtyModal');

    const cartSidebarElement =
        document.getElementById('cartSidebar');


    const qtyModal =
        new bootstrap.Modal(
            qtyModalElement
        );


    const cartSidebar =
        new bootstrap.Offcanvas(
            cartSidebarElement
        );


    /* =====================================================
       SELECTED PRODUCT
    ===================================================== */

    let selected = {

        id:null,

        stock:0,

        qty:1

    };


    /* =====================================================
       PRODUCT CARD CLICK
    ===================================================== */

    document
        .querySelectorAll('.card-box')
        .forEach(card => {

            card.addEventListener(
                'click',
                event => {

                    if(
                        event.target.closest(
                            '.add-to-cart-btn'
                        )
                    ){

                        return;

                    }


                    const productId =
                        card.dataset.productId;


                    if(productId){

                        window.location.href =
                            '/products/' +
                            productId;

                    }

                }
            );

        });


    /* =====================================================
       ADD TO CART
    ===================================================== */

    document
        .querySelectorAll('.add-to-cart-btn')
        .forEach(btn => {

            btn.addEventListener(
                'click',
                event => {

                    event.preventDefault();

                    event.stopPropagation();


                    selected.id =
                        btn.dataset.id;


                    selected.stock =
                        parseInt(
                            btn.dataset.stock,
                            10
                        ) || 0;


                    selected.qty = 1;


                    document
                        .getElementById(
                            'qtyProductName'
                        )
                        .innerText =
                            btn.dataset.name;


                    document
                        .getElementById(
                            'qtyAvailable'
                        )
                        .innerText =
                            selected.stock;


                    updateQuantityDisplay();


                    qtyModal.show();

                }
            );

        });


    /* =====================================================
       QUANTITY DISPLAY
    ===================================================== */

    function updateQuantityDisplay(){

        document
            .getElementById(
                'qtyValue'
            )
            .innerText =
                selected.qty;


        document
            .getElementById(
                'qtyConfirmCount'
            )
            .innerText =
                selected.qty;

    }


    /* =====================================================
       PLUS
    ===================================================== */

    document
        .getElementById('qtyPlus')
        .addEventListener(
            'click',
            () => {

                if(
                    selected.qty <
                    selected.stock
                ){

                    selected.qty++;

                    updateQuantityDisplay();

                }

            }
        );


    /* =====================================================
       MINUS
    ===================================================== */

    document
        .getElementById('qtyMinus')
        .addEventListener(
            'click',
            () => {

                if(
                    selected.qty > 1
                ){

                    selected.qty--;

                    updateQuantityDisplay();

                }

            }
        );


    /* =====================================================
       CONFIRM ADD
    ===================================================== */

    document
        .getElementById('qtyConfirm')
        .addEventListener(
            'click',
            async () => {

                const button =
                    document.getElementById(
                        'qtyConfirm'
                    );


                button.disabled = true;


                try{

                    const response =
                        await fetch(
                            '/products/add-to-cart',
                            {

                                method:'POST',

                                headers:{
                                    'Content-Type':
                                        'application/json'
                                },

                                body:
                                    JSON.stringify({

                                        productId:
                                            selected.id,

                                        qty:
                                            selected.qty

                                    })

                            }
                        );


                    const data =
                        await response.json();


                    if(!data.success){

                        alert(
                            data.message ||
                            'Unable to add product to cart.'
                        );

                        button.disabled = false;

                        return;

                    }


                    qtyModal.hide();

                    location.reload();


                }catch(error){

                    console.error(error);

                    alert(
                        'Unable to connect to the server.'
                    );

                    button.disabled = false;

                }

            }
        );


    /* =====================================================
       OPEN CART
    ===================================================== */

    document
        .getElementById('cartBtn')
        .addEventListener(
            'click',
            () => {

                cartSidebar.show();

            }
        );


    /* =====================================================
       CART REQUEST
    ===================================================== */

    async function callCart(
        url,
        body
    ){

        try{

            const response =
                await fetch(
                    url,
                    {

                        method:'POST',

                        headers:{
                            'Content-Type':
                                'application/json'
                        },

                        body:
                            JSON.stringify(body)

                    }
                );


            const data =
                await response.json();


            if(!data.success){

                alert(
                    data.message ||
                    'Cart update failed.'
                );

                return false;

            }


            location.reload();

            return true;


        }catch(error){

            console.error(error);

            alert(
                'Unable to connect to the server.'
            );

            return false;

        }

    }


    /* =====================================================
       CART PLUS
    ===================================================== */

    document
        .querySelectorAll('.cart-plus')
        .forEach(button => {

            button.addEventListener(
                'click',
                () => {

                    const id =
                        button.dataset.id;


                    const quantityElement =
                        document.querySelector(
                            `.cart-item[data-id="${id}"] .cart-qty`
                        );


                    if(!quantityElement){

                        return;

                    }


                    const currentQuantity =
                        parseInt(
                            quantityElement.innerText,
                            10
                        ) || 0;


                    callCart(
                        '/products/update-cart-qty',
                        {

                            productId:id,

                            qty:
                                currentQuantity + 1

                        }
                    );

                }
            );

        });


    /* =====================================================
       CART MINUS
    ===================================================== */

    document
        .querySelectorAll('.cart-minus')
        .forEach(button => {

            button.addEventListener(
                'click',
                () => {

                    const id =
                        button.dataset.id;


                    const quantityElement =
                        document.querySelector(
                            `.cart-item[data-id="${id}"] .cart-qty`
                        );


                    if(!quantityElement){

                        return;

                    }


                    const currentQuantity =
                        parseInt(
                            quantityElement.innerText,
                            10
                        ) || 0;


                    if(
                        currentQuantity <= 1
                    ){

                        callCart(
                            '/products/remove-from-cart',
                            {
                                productId:id
                            }
                        );

                        return;

                    }


                    callCart(
                        '/products/update-cart-qty',
                        {

                            productId:id,

                            qty:
                                currentQuantity - 1

                        }
                    );

                }
            );

        });


    /* =====================================================
       REMOVE FROM CART
    ===================================================== */

    document
        .querySelectorAll('.cart-remove')
        .forEach(button => {

            button.addEventListener(
                'click',
                () => {

                    callCart(
                        '/products/remove-from-cart',
                        {

                            productId:
                                button.dataset.id

                        }
                    );

                }
            );

        });


    /* =====================================================
       PACKAGE ORDER
    ===================================================== */

    const checkoutButton =
        document.getElementById(
            'checkoutBtn'
        );


    if(checkoutButton){

        checkoutButton.addEventListener(
            'click',
            async () => {

                checkoutButton.disabled = true;


                try{

                    const response =
                        await fetch(
                            '/packages/create',
                            {

                                method:'POST',

                                headers:{
                                    'Content-Type':
                                        'application/json'
                                },

                                body:
                                    JSON.stringify({})

                            }
                        );


                    const data =
                        await response.json();


                    if(
                        data.success &&
                        data.packageId
                    ){

                        window.location.href =
                            '/packages/' +
                            data.packageId;

                        return;

                    }


                    alert(
                        data.message ||
                        'Unable to create package order.'
                    );


                    checkoutButton.disabled =
                        false;


                }catch(error){

                    console.error(error);

                    alert(
                        'Unable to connect to the server.'
                    );


                    checkoutButton.disabled =
                        false;

                }

            }
        );

    }


});

</script>