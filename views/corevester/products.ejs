    display:
        flex;

    align-items:
        center;

    gap:
        6px;

}


.section-heading-left i {

    color:
        var(--green);

    font-size:
        .66rem;

}


.section-heading-title {

    margin:
        0;

    color:
        #304237;

    font-size:
        .68rem;

    font-weight:
        950;

    text-transform:
        uppercase;

    letter-spacing:
        .65px;

}



/* ==========================================================
   CATEGORY SECTION
========================================================== */

.category-section {

    width:
        100%;

    margin-bottom:
        15px;

}


.category-bar {

    width:
        100%;

    display:
        flex;

    gap:
        6px;

    overflow-x:
        auto;

    overflow-y:
        hidden;

    padding:
        2px
        1px
        5px;

    scrollbar-width:
        none;

    -webkit-overflow-scrolling:
        touch;

}


.category-bar::-webkit-scrollbar {

    display:
        none;

}


.category-pill {

    flex:
        0 0
        auto;

    min-height:
        31px;

    display:
        inline-flex;

    align-items:
        center;

    justify-content:
        center;

    padding:
        0
        12px;

    border:
        1px solid
        #d1e0d5;

    border-radius:
        50px;

    background:
        #fff;

    color:
        #3d5848;

    text-decoration:
        none;

    font-size:
        .59rem;

    font-weight:
        900;

    white-space:
        nowrap;

}


.category-pill.active {

    background:
        var(--green);

    border-color:
        var(--green);

    color:
        #fff;

}



/* ==========================================================
   PRODUCTS HEADING
========================================================== */

.products-heading {

    display:
        flex;

    align-items:
        center;

    justify-content:
        space-between;

    margin-bottom:
        8px;

}


.products-count {

    color:
        #7b8981;

    font-size:
        .58rem;

    font-weight:
        700;

}


.products-count strong {

    color:
        var(--green);

    font-weight:
        950;

}



/* ==========================================================
   PRODUCT SCROLL AREA

   IMPORTANT:

   This is NOT a grid.

   The outer element provides horizontal scrolling.
========================================================== */

.product-scroll {

    width:
        100%;

    overflow-x:
        auto;

    overflow-y:
        hidden;

    padding:
        2px
        2px
        10px;

    -webkit-overflow-scrolling:
        touch;

    scrollbar-width:
        none;

}


.product-scroll::-webkit-scrollbar {

    display:
        none;

}



/* ==========================================================
   PRODUCT LIST

   FLEXBOX ONLY.

   Four cards per row.

   The fifth card moves down naturally.

   No product-count limit exists.
========================================================== */

.product-list {

    display:
        flex;

    flex-direction:
        row;

    flex-wrap:
        wrap;

    align-content:
        flex-start;

    align-items:
        flex-start;

    justify-content:
        flex-start;

    gap:
        10px;

    width:
        464px;

    min-width:
        464px;

}



/* ==========================================================
   PRODUCT CARD

   MOBILE BASE:

       108px × 155px

========================================================== */

.product-card {

    position:
        relative;

    flex:
        0 0
        108px;

    width:
        108px;

    height:
        155px;

    min-width:
        108px;

    max-width:
        108px;

    min-height:
        155px;

    max-height:
        155px;

    display:
        flex;

    flex-direction:
        column;

    overflow:
        hidden;

    border:
        1px solid
        #e4e9e6;

    border-radius:
        14px;

    background:
        #ffffff;

    box-shadow:
        0 2px 8px
        rgba(20,40,28,.06);

    text-decoration:
        none;

    cursor:
        pointer;

    transition:
        transform .16s ease,
        box-shadow .16s ease;

}


.product-card:hover {

    transform:
        translateY(-2px);

    box-shadow:
        0 5px 14px
        rgba(20,40,28,.10);

}


.product-card:active {

    transform:
        scale(.97);

}



/* ==========================================================
   PRODUCT IMAGE
========================================================== */

.product-image-wrap {

    position:
        relative;

    width:
        100%;

    height:
        76px;

    flex:
        0 0
        76px;

    overflow:
        hidden;

    background:
        #eef3ef;

}


.product-image {

    width:
        100%;

    height:
        100%;

    display:
        block;

    object-fit:
        cover;

}



/* ==========================================================
   STOCK BADGE
========================================================== */

.stock-badge {

    position:
        absolute;

    top:
        4px;

    left:
        4px;

    right:
        4px;

    z-index:
        2;

    min-height:
        16px;

    display:
        flex;

    align-items:
        center;

    gap:
        3px;

    padding:
        2px
        4px;

    border:
        1px solid
        rgba(25,135,84,.12);

    border-radius:
        20px;

    background:
        rgba(255,255,255,.94);

    color:
        var(--green);

    font-size:
        7px;

    font-weight:
        900;

    white-space:
        nowrap;

    overflow:
        hidden;

    text-overflow:
        ellipsis;

}


.stock-dot {

    flex:
        0 0
        4px;

    width:
        4px;

    height:
