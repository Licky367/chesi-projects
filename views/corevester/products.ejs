<%- contentFor('body') %>

<style>

/* ==========================================================
   PRODUCTS / MARKETPLACE
   ========================================================== */

.marketplace{
    --green:#0a4d1e;
    --green-dark:#073b17;
    --green-soft:#edf7ef;
    --green-pale:#f6fbf7;

    --orange:#e58a22;
    --orange-soft:#fff5e8;

    --ink:#17221b;
    --muted:#718078;
    --line:#dfe9e1;
    --line-soft:#ebf1ec;

    min-height:100vh;
    background:#f7faf7;
    color:var(--ink);

    padding-bottom:50px;
}


/* ==========================================================
   HERO
   ========================================================== */

.market-hero{
    position:relative;
    overflow:hidden;

    padding:22px 16px 18px;

    background:
        radial-gradient(
            circle at 100% 0%,
            rgba(10,77,30,.09),
            transparent 34%
        ),
        linear-gradient(
            180deg,
            #ffffff 0%,
            #f7fbf8 100%
        );

    border-bottom:1px solid var(--line);
}

.market-hero-inner{
    width:min(1250px,100%);
    margin:0 auto;
}

.market-title-row{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:18px;
}

.market-heading{
    min-width:0;
}

.market-eyebrow{
    display:flex;
    align-items:center;
    gap:7px;

    margin-bottom:5px;

    color:#568064;

    font-size:.67rem;
    font-weight:900;

    text-transform:uppercase;
    letter-spacing:1.4px;
}

.market-eyebrow i{
    color:var(--green);
}

.market-title{
    margin:0;

    color:var(--green);

    font-size:clamp(1.65rem,4vw,2.35rem);
    font-weight:950;

    letter-spacing:-1px;
    line-height:1.05;
}

.market-description{
    margin:7px 0 0;

    color:var(--muted);

    font-size:.78rem;
    font-weight:600;

    line-height:1.45;
}


/* ==========================================================
   CART BUTTON
   ========================================================== */

.market-cart-button{
    flex:0 0 auto;

    display:inline-flex;
    align-items:center;
    justify-content:center;
    gap:9px;

    min-width:116px;
    min-height:48px;

    padding:0 16px;

    border:0;
    border-radius:15px;

    background:var(--green);
    color:#fff;

    font-size:.76rem;
    font-weight:900;

    cursor:pointer;

    box-shadow:
        0 8px 18px rgba(10,77,30,.18);

    transition:
        transform .18s ease,
        background .18s ease,
        box-shadow .18s ease;
}

.market-cart-button i{
    font-size:1rem;
}

.market-cart-button:hover{
    background:var(--green-dark);

    transform:translateY(-2px);

    box-shadow:
        0 11px 24px rgba(10,77,30,.24);
}

.market-cart-button:active{
    transform:scale(.97);
}


/* ==========================================================
   THREE SUMMARY CARDS
   ========================================================== */

.market-summary{
    width:min(1250px,100%);

    margin:18px auto 0;

    display:grid;

    grid-template-columns:
        repeat(3,minmax(0,1fr));

    gap:10px;
}

.summary-card{
    position:relative;

    min-width:0;

    display:flex;
    align-items:center;

    gap:10px;

    padding:12px;

    background:#fff;

    border:1px solid var(--line);

    border-radius:15px;

    box-shadow:
        0 3px 12px rgba(20,55,31,.045);

    overflow:hidden;
}

.summary-card::after{
    content:"";

    position:absolute;

    right:-20px;
    bottom:-25px;

    width:65px;
    height:65px;

    border-radius:50%;

    background:rgba(10,77,30,.035);
}

.summary-icon{
    flex:0 0 38px;

    width:38px;
    height:38px;

    display:flex;
    align-items:center;
    justify-content:center;

    border-radius:11px;

    background:var(--green-soft);
    color:var(--green);

    font-size:.9rem;
}

.summary-card:nth-child(2) .summary-icon{
    background:#f1f5f2;
}

.summary-card:nth-child(3) .summary-icon{
    background:var(--orange-soft);
    color:#c66f12;
}

.summary-info{
    min-width:0;
}

.summary-label{
    display:block;

    margin-bottom:2px;

    color:#7b8981;

    font-size:.58rem;
    font-weight:900;

    text-transform:uppercase;
    letter-spacing:.65px;
}

.summary-value{
    display:block;

    color:var(--green);

    font-size:1rem;
    font-weight:950;

    line-height:1.1;

    white-space:nowrap;
    overflow:hidden;
    text-overflow:ellipsis;
}

.summary-card:nth-child(3) .summary-value{
    color:#bd6810;
}


/* ==========================================================
   MAIN CONTENT
   ========================================================== */

.market-main{
    width:min(1250px,100%);

    margin:0 auto;

    padding:18px 14px 0;
}


/* ==========================================================
   CATEGORY BAR
   ========================================================== */

.category-section{
    margin-bottom:18px;
}

.section-heading{
    display:flex;
    align-items:center;
    justify-content:space-between;

    margin-bottom:9px;
}

.section-heading-left{
    display:flex;
    align-items:center;
    gap:7px;
}

.section-heading-left i{
    color:var(--green);

    font-size:.75rem;
}

.section-heading-title{
    margin:0;

    color:#33463a;

    font-size:.72rem;
    font-weight:950;

    text-transform:uppercase;
    letter-spacing:.8px;
}

.category-bar{
    display:flex;
    align-items:center;

    gap:8px;

    overflow-x:auto;

    padding:2px 1px 7px;

    scrollbar-width:none;

    -webkit-overflow-scrolling:touch;
}

.category-bar::-webkit-scrollbar{
    display:none;
}

.category-pill{
    flex:0 0 auto;

    display:inline-flex;
    align-items:center;
    justify-content:center;

    min-height:38px;

    padding:0 16px;

    border:1px solid #cfe0d3;
    border-radius:50px;

    background:#fff;
    color:#365541;

    text-decoration:none;

    font-size:.71rem;
    font-weight:900;

    transition:
        background .18s ease,
        color .18s ease,
        border-color .18s ease,
        transform .18s ease;
}

.category-pill:hover{
    border-color:var(--green);
    color:var(--green);

    transform:translateY(-1px);
}

.category-pill.active{
    background:var(--green);
    color:#fff;

    border-color:var(--green);

    box-shadow:
        0 5px 13px rgba(10,77,30,.16);
}


/* ==========================================================
   PRODUCT SECTION HEADER
   ========================================================== */

.products-heading{
    display:flex;
    align-items:center;
    justify-content:space-between;

    margin:4px 0 11px;
}

.products-count{
    display:inline-flex;
    align-items:center;
    gap:7px;

    color:#718078;

    font-size:.68rem;
    font-weight:700;
}

.products-count strong{
    color:var(--green);
    font-weight:950;
}


/* ==========================================================
   PRODUCT GRID
   ========================================================== */

.product-grid{
    display:grid;

    grid-template-columns:
        repeat(2,minmax(0,1fr));

    gap:12px;
}


/* ==========================================================
   PRODUCT CARD
   ========================================================== */

.product-card{
    position:relative;

    min-width:0;

    display:flex;
    flex-direction:column;

    overflow:hidden;

    background:#fff;

    border:1px solid var(--line);

    border-radius:17px;

    box-shadow:
        0 3px 13px rgba(18,54,29,.055);

    cursor:pointer;

    transition:
        transform .2s ease,
        box-shadow .2s ease,
        border-color .2s ease;
}

.product-card:hover{
    transform:translateY(-3px);

    border-color:#c9ddce;

    box-shadow:
        0 11px 27px rgba(18,54,29,.11);
}


/* ==========================================================
   PRODUCT IMAGE
   ========================================================== */

.product-image{
    position:relative;

    width:100%;

    aspect-ratio:1 / .87;

    overflow:hidden;

    background:
        linear-gradient(
            135deg,
            #eef6f0,
            #f7faf7
        );
}

.product-image img{
    width:100%;
    height:100%;

    display:block;

    object-fit:cover;

    transition:
        transform .35s ease;
}

.product-card:hover .product-image img{
    transform:scale(1.045);
}


/* ==========================================================
   STOCK BADGE
   ========================================================== */

.stock-badge{
    position:absolute;

    top:10px;
    left:10px;

    z-index:3;

    display:inline-flex;
    align-items:center;
    gap:6px;

    min-height:27px;

    padding:0 9px;

    background:rgba(255,255,255,.96);

    border:1px solid rgba(10,77,30,.18);

    border-radius:50px;

    color:var(--green);

    font-size:.62rem;
    font-weight:950;

    box-shadow:
        0 3px 9px rgba(0,0,0,.09);
}

.stock-dot{
    width:6px;
    height:6px;

    border-radius:50%;

    background:#25a34a;
}

.stock-low .stock-dot{
    background:#e29a20;
}

.stock-low{
    color:#a86a0b;
    border-color:#efd9ad;
}

.stock-out{
    color:#a52c2c;
    border-color:#efcaca;
}

.stock-out .stock-dot{
    background:#d63939;
}


/* ==========================================================
   PRODUCT INFORMATION
   ========================================================== */

.product-details{
    display:flex;
    flex-direction:column;

    flex:1;

    padding:12px 11px 11px;
}

.product-category{
    margin:0 0 4px;

    color:#3e7b50;

    font-size:.59rem;
    font-weight:950;

    text-transform:uppercase;
    letter-spacing:.65px;
}

.product-name{
    margin:0;

    min-height:36px;

    color:#18221c;

    font-size:.88rem;
    font-weight:850;

    line-height:1.25;

    display:-webkit-box;
    -webkit-box-orient:vertical;
    -webkit-line-clamp:2;

    overflow:hidden;
}

.product-price{
    display:flex;
    align-items:baseline;
    gap:4px;

    margin-top:9px;

    color:var(--green);

    font-size:1rem;
    font-weight:950;
}

.currency{
    font-size:.58rem;
    font-weight:900;
}


/* ==========================================================
   ADD BUTTON
   ========================================================== */

.add-to-cart-btn{
    width:100%;

    display:flex;
    align-items:center;
    justify-content:center;
    gap:7px;

    min-height:40px;

    margin-top:10px;

    border:0;
    border-radius:10px;

    background:var(--green);
    color:#fff;

    font-size:.67rem;
    font-weight:950;

    cursor:pointer;

    transition:
        background .18s ease,
        transform .18s ease,
        box-shadow .18s ease;
}

.add-to-cart-btn:hover{
    background:var(--green-dark);

    box-shadow:
        0 5px 12px rgba(10,77,30,.17);
}

.add-to-cart-btn:active{
    transform:scale(.98);
}

.add-to-cart-btn:disabled{
    background:#e0e6e2;
    color:#7e8982;

    cursor:not-allowed;

    box-shadow:none;
}


/* ==========================================================
   EMPTY STATE
   ========================================================== */

.empty-market{
    position:relative;

    overflow:hidden;

    min-height:390px;

    display:flex;
    align-items:center;
    justify-content:center;

    padding:35px 20px;

    background:#fff;

    border:1px solid var(--line);

    border-radius:22px;

    text-align:center;

    box-shadow:
        0 5px 20px rgba(18,54,29,.045);
}

.empty-market::before{
    content:"";

    position:absolute;

    width:220px;
    height:220px;

    top:-110px;
    right:-80px;

    border-radius:50%;

    background:rgba(10,77,30,.045);
}

.empty-market::after{
    content:"";

    position:absolute;

    width:170px;
    height:170px;

    bottom:-90px;
    left:-70px;

    border-radius:50%;

    background:rgba(229,138,34,.045);
}

.empty-inner{
    position:relative;
    z-index:2;

    max-width:430px;
}

.empty-icon{
    width:92px;
    height:92px;

    margin:0 auto 19px;

    display:flex;
    align-items:center;
    justify-content:center;

    border-radius:27px;

    background:
        linear-gradient(
            145deg,
            #eaf6ed,
            #f6faf7
        );

    color:var(--green);

    font-size:2rem;

    box-shadow:
        inset 0 0 0 1px #dceade;
}

.empty-market h3{
    margin:0;

    color:#213329;

    font-size:1.15rem;
    font-weight:950;

    letter-spacing:-.25px;
}

.empty-market p{
    margin:8px auto 0;

    color:#7a877f;

    font-size:.77rem;
    font-weight:600;

    line-height:1.55;
}

.empty-action{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    gap:7px;

    min-height:42px;

    margin-top:18px;

    padding:0 17px;

    background:var(--green);
    color:#fff;

    border-radius:11px;

    text-decoration:none;

    font-size:.7rem;
    font-weight:900;

    box-shadow:
        0 6px 14px rgba(10,77,30,.15);
}

.empty-action:hover{
    background:var(--green-dark);
    color:#fff;
}


/* ==========================================================
   QUANTITY MODAL
   ========================================================== */

.qty-modal{
    overflow:hidden;

    border:0;
    border-radius:22px;

    box-shadow:
        0 25px 65px rgba(0,0,0,.2);
}

.qty-header{
    padding:20px;

    background:
        linear-gradient(
            145deg,
            #f0f8f2,
            #fafcfb
        );

    border-bottom:1px solid var(--line);

    text-align:center;
}

.qty-icon{
    width:44px;
    height:44px;

    margin:0 auto 9px;

    display:flex;
    align-items:center;
    justify-content:center;

    border-radius:13px;

    background:var(--green);

    color:#fff;

    font-size:.95rem;
}

.qty-product-name{
    margin:0;

    color:var(--green);

    font-size:1rem;
    font-weight:950;
}

.qty-available{
    margin:5px 0 0;

    color:#7a877f;

    font-size:.7rem;
    font-weight:600;
}

.qty-available strong{
    color:#33483a;
}

.qty-body{
    padding:22px 20px 18px;
}

.qty-selector{
    display:flex;
    align-items:center;
    justify-content:center;

    gap:25px;

    margin:4px 0 22px;
}

.qty-control{
    width:45px;
    height:45px;

    display:flex;
    align-items:center;
    justify-content:center;

    padding:0;

    border:2px solid var(--green);
    border-radius:50%;

    background:#fff;
    color:var(--green);

    font-size:1.3rem;
    font-weight:950;

    cursor:pointer;

    transition:
        background .16s ease,
        color .16s ease,
        transform .16s ease;
}

.qty-control:hover{
    background:var(--green);
    color:#fff;
}

.qty-control:active{
    transform:scale(.92);
}

.qty-number{
    min-width:55px;

    color:var(--green);

    font-size:2.15rem;
    font-weight:950;

    line-height:1;

    text-align:center;
}

.qty-confirm{
    margin-top:0;
    min-height:47px;
}

.qty-cancel{
    display:block;

    width:100%;

    margin-top:7px;

    color:#7a867f !important;

    font-size:.74rem;
    font-weight:800;

    text-decoration:none !important;
}


/* ==========================================================
   CART OFFCANVAS
   ========================================================== */

.cart-sidebar{
    width:min(430px,94vw) !important;

    border-left:1px solid var(--line) !important;

    box-shadow:
        -15px 0 45px rgba(0,0,0,.13);
}

.cart-header{
    display:flex;
    align-items:center;
    justify-content:space-between;

    gap:12px;

    padding:17px;

    background:
        linear-gradient(
            145deg,
            #f0f8f2,
            #fff
        );

    border-bottom:1px solid var(--line);
}

.cart-heading{
    display:flex;
    align-items:center;
    gap:10px;

    min-width:0;
}

.cart-icon{
    flex:0 0 42px;

    width:42px;
    height:42px;

    display:flex;
    align-items:center;
    justify-content:center;

    border-radius:13px;

    background:var(--green);

    color:#fff;

    font-size:1rem;
}

.cart-title{
    margin:0;

    color:var(--green);

    font-size:1rem;
    font-weight:950;
}

.cart-subtitle{
    margin:3px 0 0;

    color:#7c8981;

    font-size:.66rem;
    font-weight:600;
}

.cart-body{
    padding:13px !important;

    background:#fff;
}

.cart-item{
    display:flex;
    align-items:center;

    gap:10px;

    padding:13px 3px;

    border-bottom:1px solid var(--line-soft);
}

.cart-item:last-child{
    border-bottom:0;
}

.cart-product-info{
    flex:1;
    min-width:0;
}

.cart-product-name{
    display:block;

    color:#203027;

    font-size:.79rem;
    font-weight:850;

    line-height:1.3;

    overflow:hidden;
    text-overflow:ellipsis;
    white-space:nowrap;
}

.cart-product-price{
    display:block;

    margin-top:4px;

    color:#7b8980;

    font-size:.67rem;
    font-weight:600;
}

.cart-product-price strong{
    color:var(--green);
}

.cart-controls{
    flex:0 0 auto;

    display:flex;
    align-items:center;

    gap:4px;
}

.cart-control{
    width:31px;
    height:31px;

    display:flex;
    align-items:center;
    justify-content:center;

    padding:0;

    border:1px solid #cedbd1;
    border-radius:8px;

    background:#fff;
    color:var(--green);

    font-size:.82rem;
    font-weight:950;

    cursor:pointer;

    transition:
        background .15s ease,
        border-color .15s ease;
}

.cart-control:hover{
    background:var(--green-soft);

    border-color:var(--green);
}

.cart-remove{
    color:#b52d2d;

    border-color:#efcece;

    background:#fff8f8;
}

.cart-qty{
    min-width:22px;

    color:#25352b;

    font-size:.73rem;
    font-weight:950;

    text-align:center;
}


/* ==========================================================
   EMPTY CART
   ========================================================== */

.empty-cart{
    min-height:310px;

    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;

    text-align:center;

    padding:30px 20px;
}

.empty-cart-icon{
    width:76px;
    height:76px;

    margin-bottom:14px;

    display:flex;
    align-items:center;
    justify-content:center;

    border-radius:24px;

    background:#f0f6f1;

    color:#8ba094;

    font-size:1.55rem;
}

.empty-cart strong{
    color:#415148;

    font-size:.88rem;
    font-weight:900;
}

.empty-cart span{
    margin-top:5px;

    color:#87938c;

    font-size:.7rem;
    font-weight:600;
}


/* ==========================================================
   CART FOOTER
   ========================================================== */

.cart-footer{
    padding:16px;

    background:#f5f9f6;

    border-top:1px solid var(--line);
}

.cart-total{
    display:flex;
    align-items:center;
    justify-content:space-between;

    margin-bottom:12px;

    color:#65736b;

    font-size:.76rem;
    font-weight:800;
}

.cart-total strong{
    color:var(--green);

    font-size:1.08rem;
    font-weight:950;
}

.checkout-btn{
    min-height:47px;
}


/* ==========================================================
   RESPONSIVE
   ========================================================== */

@media(min-width:700px){

    .market-hero{
        padding:27px 22px 21px;
    }

    .market-main{
        padding-left:20px;
        padding-right:20px;
    }

    .product-grid{
        grid-template-columns:
            repeat(4,minmax(0,1fr));

        gap:15px;
    }

    .product-image{
        aspect-ratio:1 / .82;
    }

}

@media(min-width:1100px){

    .market-hero{
        padding-left:30px;
        padding-right:30px;
    }

    .market-main{
        padding-left:24px;
        padding-right:24px;
    }

    .product-grid{
        grid-template-columns:
            repeat(5,minmax(0,1fr));

        gap:17px;
    }

}


/* ==========================================================
   SMALL MOBILE
   ========================================================== */

@media(max-width:575px){

    .market-hero{
        padding:18px 12px 15px;
    }

    .market-title-row{
        align-items:center;
    }

    .market-title{
        font-size:1.55rem;
    }

    .market-description{
        font-size:.69rem;
    }

    .market-cart-button{
        min-width:48px;
        width:48px;
        height:48px;

        padding:0;

        border-radius:14px;
    }

    .market-cart-button span{
        display:none;
    }

    .market-summary{
        gap:7px;

        margin-top:15px;
    }

    .summary-card{
        flex-direction:column;
        align-items:flex-start;

        gap:7px;

        padding:10px;

        border-radius:13px;
    }

    .summary-icon{
        width:31px;
        height:31px;

        flex-basis:31px;

        border-radius:9px;

        font-size:.75rem;
    }

    .summary-label{
        font-size:.5rem;
        letter-spacing:.4px;
    }

    .summary-value{
        font-size:.78rem;
    }

    .market-main{
        padding-left:11px;
        padding-right:11px;
    }

    .category-pill{
        min-height:36px;

        padding:0 14px;

        font-size:.67rem;
    }

    .product-grid{
        gap:10px;
    }

    .product-details{
        padding:10px 9px 10px;
    }

    .product-name{
        font-size:.79rem;
        min-height:33px;
    }

    .product-price{
        font-size:.92rem;
    }

    .add-to-cart-btn{
        min-height:38px;

        font-size:.61rem;
    }

    .stock-badge{
        top:8px;
        left:8px;

        min-height:25px;

        padding:0 8px;

        font-size:.57rem;
    }

}


/* ==========================================================
   ACCESSIBILITY
   ========================================================== */

button:focus-visible,
a:focus-visible{
    outline:3px solid rgba(10,77,30,.24);
    outline-offset:3px;
}

@media(prefers-reduced-motion:reduce){

    *,
    *::before,
    *::after{
        scroll-behavior:auto !important;
        transition:none !important;
        animation:none !important;
    }

}

</style>


<div class="marketplace">


    <!-- ======================================================
         MARKETPLACE HERO
         ====================================================== -->

    <section class="market-hero">

        <div class="market-hero-inner">

            <div class="market-title-row">

                <div class="market-heading">

                    <div class="market-eyebrow">
                        <i class="fas fa-store"></i>
                        Marketplace
                    </div>

                    <h1 class="market-title">
                        Shop our products
                    </h1>

                    <p class="market-description">
                        Browse available products and add what you need
                        to your cart.
                    </p>

                </div>


                <!-- CART BUTTON -->

                <button
                    type="button"
                    id="cartBtn"
                    class="market-cart-button"
                    aria-label="Open shopping cart"
                >

                    <i class="fas fa-shopping-cart"></i>

                    <span>
                        CART
                    </span>

                </button>

            </div>


            <!-- ==================================================
                 THREE SUMMARY CARDS
                 ================================================== -->

            <div class="market-summary">


                <!-- PRODUCTS AVAILABLE -->

                <div class="summary-card">

                    <div class="summary-icon">
                        <i class="fas fa-box-open"></i>
                    </div>

                    <div class="summary-info">

                        <span class="summary-label">
                            Available
                        </span>

                        <span class="summary-value">
                            <%= products.length %>
                            <%= products.length === 1
                                ? 'Product'
                                : 'Products'
                            %>
                        </span>

                    </div>

                </div>


                <!-- CART ITEMS -->

                <div class="summary-card">

                    <div class="summary-icon">
                        <i class="fas fa-shopping-basket"></i>
                    </div>

                    <div class="summary-info">

                        <span class="summary-label">
                            In Cart
                        </span>

                        <span
                            class="summary-value"
                            id="cartCount"
                        >
                            <%= cartCount || 0 %>
                            <%= (cartCount || 0) === 1
                                ? 'Item'
                                : 'Items'
                            %>
                        </span>

                    </div>

                </div>


                <!-- CART VALUE -->

                <div class="summary-card">

                    <div class="summary-icon">
                        <i class="fas fa-coins"></i>
                    </div>

                    <div class="summary-info">

                        <span class="summary-label">
                            Cart Value
                        </span>

                        <span
                            class="summary-value"
                            id="cartTotalText"
                        >
                            KES
                            <%= Number(
                                cartTotal || 0
                            ).toLocaleString() %>
                        </span>

                    </div>

                </div>

            </div>

        </div>

    </section>



    <!-- ======================================================
         MAIN
         ====================================================== -->

    <main class="market-main">


        <!-- ==================================================
             CATEGORIES
             ================================================== -->

        <section class="category-section">

            <div class="section-heading">

                <div class="section-heading-left">

                    <i class="fas fa-layer-group"></i>

                    <h2 class="section-heading-title">
                        Categories
                    </h2>

                </div>

            </div>


            <nav
                class="category-bar"
                aria-label="Product categories"
            >

                <a
                    href="/products?category=all"
                    class="category-pill
                        <%= activeCategory === 'all'
                            ? 'active'
                            : '' %>"
                >
                    All
                </a>


                <% (categories || []).forEach(category => { %>

                    <a
                        href="/products?category=<%= category %>"
                        class="category-pill text-capitalize
                            <%= activeCategory === category
                                ? 'active'
                                : '' %>"
                    >
                        <%= category %>
                    </a>

                <% }) %>

            </nav>

        </section>



        <!-- ==================================================
             PRODUCTS
             ================================================== -->

        <section>

            <% if(!products || !products.length){ %>


                <!-- ==========================================
                     PREMIUM EMPTY STATE
                     ========================================== -->

                <div class="empty-market">

                    <div class="empty-inner">

                        <div class="empty-icon">
                            <i class="fas fa-store-slash"></i>
                        </div>

                        <h3>
                            Nothing available here yet
                        </h3>

                        <p>

                            <% if(activeCategory && activeCategory !== 'all'){ %>

                                We don't currently have any
                                products in the
                                <strong>
                                    <%= activeCategory %>
                                </strong>
                                category.

                            <% } else { %>

                                There are currently no products
                                available in the marketplace.
                                Please check again later.

                            <% } %>

                        </p>


                        <% if(
                            activeCategory &&
                            activeCategory !== 'all'
                        ){ %>

                            <a
                                href="/products?category=all"
                                class="empty-action"
                            >
                                <i class="fas fa-store"></i>
                                VIEW ALL PRODUCTS
                            </a>

                        <% } %>

                    </div>

                </div>


            <% } else { %>


                <!-- ==========================================
                     PRODUCT HEADER
                     ========================================== -->

                <div class="products-heading">

                    <div class="section-heading-left">

                        <i class="fas fa-boxes-stacked"></i>

                        <h2 class="section-heading-title">
                            Products
                        </h2>

                    </div>


                    <div class="products-count">

                        Showing

                        <strong>
                            <%= products.length %>
                        </strong>

                        available

                    </div>

                </div>


                <!-- ==========================================
                     PRODUCT GRID
                     ========================================== -->

                <div class="product-grid">


                    <% products.forEach(product => { %>

                        <%
                            const stock =
                                Number(product.units || 0);

                            let stockClass = '';

                            if(stock <= 0){
                                stockClass = 'stock-out';
                            }
                            else if(stock <= 5){
                                stockClass = 'stock-low';
                            }
                        %>


                        <!-- PRODUCT CARD -->

                        <article
                            class="product-card"
                            data-product-id="<%= product._id %>"
                        >


                            <!-- IMAGE -->

                            <div class="product-image">

                                <span
                                    class="stock-badge <%= stockClass %>"
                                >

                                    <span class="stock-dot"></span>

                                    <% if(stock <= 0){ %>

                                        Out of stock

                                    <% } else if(stock <= 5){ %>

                                        Only <%= stock %> left

                                    <% } else { %>

                                        <%= stock %> available

                                    <% } %>

                                </span>


                                <img
                                    src="<%= product.image || '/images/no-image.png' %>"
                                    alt="<%= product.name %>"
                                    loading="lazy"
                                    onerror="this.src='/images/no-image.png';"
                                >

                            </div>


                            <!-- DETAILS -->

                            <div class="product-details">


                                <p class="product-category">
                                    <%= product.category || 'General' %>
                                </p>


                                <h3 class="product-name">
                                    <%= product.name %>
                                </h3>


                                <div class="product-price">

                                    <span class="currency">
                                        KES
                                    </span>

                                    <%= Number(
                                        product.unitSellPrice || 0
                                    ).toLocaleString() %>

                                </div>


                                <!-- ADD TO CART -->

                                <button
                                    type="button"
                                    class="add-to-cart-btn"
                                    data-id="<%= product._id %>"
                                    data-name="<%= product.name %>"
                                    data-stock="<%= stock %>"

                                    <%= stock <= 0
                                        ? 'disabled'
                                        : '' %>
                                >

                                    <i class="fas
                                        <%= stock <= 0
                                            ? 'fa-ban'
                                            : 'fa-cart-plus' %>"
                                    ></i>

                                    <%= stock <= 0
                                        ? 'OUT OF STOCK'
                                        : 'ADD TO CART' %>

                                </button>

                            </div>

                        </article>

                    <% }) %>


                </div>

            <% } %>

        </section>


    </main>

</div>



<!-- ==========================================================
     QUANTITY MODAL
     ========================================================== -->

<div
    class="modal fade"
    id="qtyModal"
    tabindex="-1"
    aria-hidden="true"
>

    <div class="modal-dialog modal-dialog-centered modal-sm">

        <div class="modal-content qty-modal">


            <!-- HEADER -->

            <div class="qty-header">

                <div class="qty-icon">
                    <i class="fas fa-cart-plus"></i>
                </div>

                <h3
                    class="qty-product-name"
                    id="qtyProductName"
                ></h3>

                <p class="qty-available">

                    Available:

                    <strong id="qtyAvailable">
                        0
                    </strong>

                </p>

            </div>


            <!-- BODY -->

            <div class="qty-body">

                <div class="qty-selector">


                    <button
                        type="button"
                        class="qty-control"
                        id="qtyMinus"
                        aria-label="Decrease quantity"
                    >
                        −
                    </button>


                    <span
                        id="qtyValue"
                        class="qty-number"
                    >
                        1
                    </span>


                    <button
                        type="button"
                        class="qty-control"
                        id="qtyPlus"
                        aria-label="Increase quantity"
                    >
                        +
                    </button>


                </div>


                <button
                    type="button"
                    class="add-to-cart-btn qty-confirm"
                    id="qtyConfirm"
                >

                    <i class="fas fa-cart-plus"></i>

                    ADD

                    <span id="qtyConfirmCount">
                        1
                    </span>

                    TO CART

                </button>


                <button
                    type="button"
                    class="btn btn-link qty-cancel"
                    data-bs-dismiss="modal"
                >
                    Cancel
                </button>

            </div>

        </div>

    </div>

</div>



<!-- ==========================================================
     CART SIDEBAR
     ========================================================== -->

<div
    class="offcanvas offcanvas-end cart-sidebar"
    tabindex="-1"
    id="cartSidebar"
    aria-labelledby="cartSidebarLabel"
>


    <!-- HEADER -->

    <div class="cart-header">

        <div class="cart-heading">

            <div class="cart-icon">
                <i class="fas fa-shopping-basket"></i>
            </div>

            <div>

                <h5
                    class="cart-title"
                    id="cartSidebarLabel"
                >
                    Your Cart
                </h5>

                <p class="cart-subtitle">
                    Review your selected products
                </p>

            </div>

        </div>


        <button
            type="button"
            class="btn-close"
            data-bs-dismiss="offcanvas"
            aria-label="Close"
        ></button>

    </div>



    <!-- BODY -->

    <div class="offcanvas-body cart-body">


        <% if(cart && cart.length){ %>


            <% cart.forEach(item => { %>

                <div
                    class="cart-item"
                    data-id="<%= item.productId %>"
                >


                    <div class="cart-product-info">

                        <span class="cart-product-name">
                            <%= item.name %>
                        </span>


                        <span class="cart-product-price">

                            KES

                            <strong>
                                <%= Number(
                                    item.price || 0
                                ).toLocaleString() %>
                            </strong>

                            ×

                            <span class="cart-qty">
                                <%= item.qty %>
                            </span>

                        </span>

                    </div>


                    <div class="cart-controls">


                        <button
                            type="button"
                            class="cart-control cart-minus"
                            data-id="<%= item.productId %>"
                            aria-label="Decrease quantity"
                        >
                            −
                        </button>


                        <button
                            type="button"
                            class="cart-control cart-plus"
                            data-id="<%= item.productId %>"
                            aria-label="Increase quantity"
                        >
                            +
                        </button>


                        <button
                            type="button"
                            class="cart-control cart-remove"
                            data-id="<%= item.productId %>"
                            aria-label="Remove product"
                        >
                            ×
                        </button>


                    </div>

                </div>

            <% }) %>


        <% } else { %>


            <!-- EMPTY CART -->

            <div class="empty-cart">

                <div class="empty-cart-icon">
                    <i class="fas fa-shopping-basket"></i>
                </div>

                <strong>
                    Your cart is empty
                </strong>

                <span>
                    Products you add will appear here.
                </span>

            </div>


        <% } %>


    </div>



    <!-- FOOTER -->

    <div class="cart-footer">

        <div class="cart-total">

            <span>
                Cart total
            </span>

            <strong>

                KES

                <%= Number(
                    cartTotal || 0
                ).toLocaleString() %>

            </strong>

        </div>


        <% if(cart && cart.length){ %>

            <button
                type="button"
                class="add-to-cart-btn checkout-btn"
                id="checkoutBtn"
            >

                <i class="fas fa-box"></i>

                PACKAGE ORDER

            </button>

        <% } %>

    </div>


</div>



<script>

document.addEventListener('DOMContentLoaded', () => {


    /* ======================================================
       BOOTSTRAP COMPONENTS
       ====================================================== */

    const qtyModalElement =
        document.getElementById('qtyModal');

    const cartSidebarElement =
        document.getElementById('cartSidebar');


    const qtyModal =
        new bootstrap.Modal(qtyModalElement);


    const cartSidebar =
        new bootstrap.Offcanvas(cartSidebarElement);



    /* ======================================================
       SELECTED PRODUCT
       ====================================================== */

    let selected = {

        id:null,

        name:'',

        stock:0,

        qty:1

    };



    /* ======================================================
       PRODUCT CARD NAVIGATION
       ====================================================== */

    document
        .querySelectorAll('.product-card')
        .forEach(card => {

            card.addEventListener(
                'click',
                event => {

                    if(
                        event.target.closest(
                            '.add-to-cart-btn'
                        )
                    ){
                        return;
                    }


                    const productId =
                        card.dataset.productId;


                    if(productId){

                        window.location.href =
                            '/products/' +
                            productId;

                    }

                }
            );

        });



    /* ======================================================
       ADD TO CART
       ====================================================== */

    document
        .querySelectorAll('.add-to-cart-btn')
        .forEach(button => {

            /*
             * Do not attach the quantity-modal behaviour
             * to the checkout button.
             */

            if(
                button.id === 'qtyConfirm' ||
                button.id === 'checkoutBtn'
            ){
                return;
            }


            button.addEventListener(
                'click',
                event => {

                    event.preventDefault();

                    event.stopPropagation();


                    selected.id =
                        button.dataset.id;


                    selected.name =
                        button.dataset.name;


                    selected.stock =
                        parseInt(
                            button.dataset.stock,
                            10
                        ) || 0;


                    selected.qty = 1;


                    document
                        .getElementById(
                            'qtyProductName'
                        )
                        .innerText =
                            selected.name;


                    document
                        .getElementById(
                            'qtyAvailable'
                        )
                        .innerText =
                            selected.stock;


                    updateQuantityDisplay();


                    qtyModal.show();

                }
            );

        });



    /* ======================================================
       QUANTITY DISPLAY
       ====================================================== */

    function updateQuantityDisplay(){

        document
            .getElementById('qtyValue')
            .innerText =
                selected.qty;


        document
            .getElementById('qtyConfirmCount')
            .innerText =
                selected.qty;

    }



    /* ======================================================
       QUANTITY PLUS
       ====================================================== */

    document
        .getElementById('qtyPlus')
        .addEventListener(
            'click',
            () => {

                if(
                    selected.qty <
                    selected.stock
                ){

                    selected.qty++;

                    updateQuantityDisplay();

                }

            }
        );



    /* ======================================================
       QUANTITY MINUS
       ====================================================== */

    document
        .getElementById('qtyMinus')
        .addEventListener(
            'click',
            () => {

                if(
                    selected.qty > 1
                ){

                    selected.qty--;

                    updateQuantityDisplay();

                }

            }
        );



    /* ======================================================
       CONFIRM ADD TO CART
       ====================================================== */

    document
        .getElementById('qtyConfirm')
        .addEventListener(
            'click',
            async () => {

                const button =
                    document.getElementById(
                        'qtyConfirm'
                    );


                button.disabled = true;


                try{

                    const response =
                        await fetch(
                            '/products/add-to-cart',
                            {
                                method:'POST',

                                headers:{
                                    'Content-Type':
                                        'application/json'
                                },

                                body:JSON.stringify({

                                    productId:
                                        selected.id,

                                    qty:
                                        selected.qty

                                })
                            }
                        );


                    const data =
                        await response.json();


                    if(!data.success){

                        alert(
                            data.message ||
                            'Unable to add product to cart.'
                        );


                        button.disabled = false;

                        return;

                    }


                    qtyModal.hide();


                    location.reload();


                }
                catch(error){

                    console.error(error);


                    alert(
                        'Unable to connect to the server.'
                    );


                    button.disabled = false;

                }

            }
        );



    /* ======================================================
       OPEN CART
       ====================================================== */

    document
        .getElementById('cartBtn')
        .addEventListener(
            'click',
            () => {

                cartSidebar.show();

            }
        );



    /* ======================================================
       CART REQUEST
       ====================================================== */

    async function callCart(
        url,
        body
    ){

        try{

            const response =
                await fetch(
                    url,
                    {
                        method:'POST',

                        headers:{
                            'Content-Type':
                                'application/json'
                        },

                        body:
                            JSON.stringify(body)
                    }
                );


            const data =
                await response.json();


            if(!data.success){

                alert(
                    data.message ||
                    'Cart update failed.'
                );

                return false;

            }


            location.reload();

            return true;

        }
        catch(error){

            console.error(error);


            alert(
                'Unable to connect to the server.'
            );


            return false;

        }

    }



    /* ======================================================
       CART PLUS
       ====================================================== */

    document
        .querySelectorAll('.cart-plus')
        .forEach(button => {

            button.addEventListener(
                'click',
                () => {

                    const id =
                        button.dataset.id;


                    const quantityElement =
                        document.querySelector(
                            `.cart-item[data-id="${id}"] .cart-qty`
                        );


                    if(!quantityElement){
                        return;
                    }


                    const currentQuantity =
                        parseInt(
                            quantityElement.innerText,
                            10
                        ) || 0;


                    callCart(
                        '/products/update-cart-qty',
                        {
                            productId:id,

                            qty:
                                currentQuantity + 1
                        }
                    );

                }
            );

        });



    /* ======================================================
       CART MINUS
       ====================================================== */

    document
        .querySelectorAll('.cart-minus')
        .forEach(button => {

            button.addEventListener(
                'click',
                () => {

                    const id =
                        button.dataset.id;


                    const quantityElement =
                        document.querySelector(
                            `.cart-item[data-id="${id}"] .cart-qty`
                        );


                    if(!quantityElement){
                        return;
                    }


                    const currentQuantity =
                        parseInt(
                            quantityElement.innerText,
                            10
                        ) || 0;


                    if(currentQuantity <= 1){

                        callCart(
                            '/products/remove-from-cart',
                            {
                                productId:id
                            }
                        );

                        return;

                    }


                    callCart(
                        '/products/update-cart-qty',
                        {
                            productId:id,

                            qty:
                                currentQuantity - 1
                        }
                    );

                }
            );

        });



    /* ======================================================
       REMOVE FROM CART
       ====================================================== */

    document
        .querySelectorAll('.cart-remove')
        .forEach(button => {

            button.addEventListener(
                'click',
                () => {

                    callCart(
                        '/products/remove-from-cart',
                        {
                            productId:
                                button.dataset.id
                        }
                    );

                }
            );

        });



    /* ======================================================
       PACKAGE ORDER
       ====================================================== */

    const checkoutButton =
        document.getElementById(
            'checkoutBtn'
        );


    if(checkoutButton){

        checkoutButton.addEventListener(
            'click',
            async () => {

                checkoutButton.disabled = true;


                try{

                    const response =
                        await fetch(
                            '/packages/create',
                            {
                                method:'POST',

                                headers:{
                                    'Content-Type':
                                        'application/json'
                                },

                                body:
                                    JSON.stringify({})
                            }
                        );


                    const data =
                        await response.json();


                    if(
                        data.success &&
                        data.packageId
                    ){

                        window.location.href =
                            '/packages/' +
                            data.packageId;

                        return;

                    }


                    alert(
                        data.message ||
                        'Unable to create package order.'
                    );


                    checkoutButton.disabled = false;

                }
                catch(error){

                    console.error(error);


                    alert(
                        'Unable to connect to the server.'
                    );


                    checkoutButton.disabled = false;

                }

            }
        );

    }

});

</script>