</div>

</div><!-- =========================================================
     CART SIDEBAR
========================================================= --><div
    class="offcanvas offcanvas-end cart-sidebar"
    tabindex="-1"
    id="cartSidebar"
    aria-labelledby="cartSidebarLabel"
><div class="cart-header">

    <div class="cart-title-wrap">

        <div class="cart-title-icon">

            <i class="fas fa-shopping-bag"></i>

        </div>


        <div>

            <h5
                class="cart-title"
                id="cartSidebarLabel"
            >
                Your Cart
            </h5>

            <p class="cart-subtitle">
                Review your selected products
            </p>

        </div>

    </div>


    <button
        type="button"
        class="btn-close"
        data-bs-dismiss="offcanvas"
        aria-label="Close"
    ></button>

</div>


<div class="offcanvas-body cart-body">


    <% if(cart && cart.length){ %>


        <% cart.forEach(item => { %>


            <div
                class="cart-item"
                data-id="<%= item.productId %>"
            >

                <div class="cart-product-info">

                    <span class="cart-product-name">
                        <%= item.name %>
                    </span>


                    <span class="cart-product-price">

                        KES
                        <%= Number(
                            item.price || 0
                        ).toLocaleString() %>

                        ×

                        <span class="cart-qty">
                            <%= item.qty %>
                        </span>

                    </span>

                </div>


                <div class="cart-controls">

                    <button
                        type="button"
                        class="cart-control cart-minus"
                        data-id="<%= item.productId %>"
                        aria-label="Decrease quantity"
                    >
                        −
                    </button>


                    <button
                        type="button"
                        class="cart-control cart-plus"
                        data-id="<%= item.productId %>"
                        aria-label="Increase quantity"
                    >
                        +
                    </button>


                    <button
                        type="button"
                        class="cart-control cart-remove"
                        data-id="<%= item.productId %>"
                        aria-label="Remove product"
                    >
                        ×
                    </button>

                </div>

            </div>


        <% }) %>


    <% } else { %>


        <div class="empty-cart">

            <div class="empty-cart-icon">

                <i class="fas fa-shopping-bag"></i>

            </div>

            <strong>
                Your cart is empty
            </strong>

            <span>
                Add products from the marketplace
                to build your order.
            </span>

        </div>


    <% } %>


</div>


<div class="cart-footer">

    <div class="cart-total">

        <span>
            Cart total
        </span>

        <strong>
            KES
            <%= (cartTotal || 0).toLocaleString() %>
        </strong>

    </div>


    <% if(cart && cart.length){ %>

        <button
            type="button"
            class="add-btn checkout-btn"
            id="checkoutBtn"
        >

            <i class="fas fa-box"></i>

            PACKAGE ORDER

        </button>

    <% } %>

</div>

</div><script>

document.addEventListener('DOMContentLoaded', () => {


    /* =====================================================
       ELEMENTS
    ===================================================== */

    const qtyModalElement =
        document.getElementById('qtyModal');

    const cartSidebarElement =
        document.getElementById('cartSidebar');


    const qtyModal =
        new bootstrap.Modal(
            qtyModalElement
        );


    const cartSidebar =
        new bootstrap.Offcanvas(
            cartSidebarElement
        );


    /* =====================================================
       SELECTED PRODUCT
    ===================================================== */

    let selected = {
        id:null,
        stock:0,
        qty:1
    };


    /* =====================================================
       PRODUCT CARD CLICK
    ===================================================== */

    document
        .querySelectorAll('.card-box')
        .forEach(card => {

            card.addEventListener(
                'click',
                event => {

                    if(
                        event.target.closest(
                            '.add-to-cart-btn'
                        )
                    ){
                        return;
                    }


                    const productId =
                        card.dataset.productId;


                    if(productId){

                        window.location.href =
                            '/products/' +
                            productId;

                    }

                }
            );

        });


    /* =====================================================
       ADD TO CART
    ===================================================== */

    document
        .querySelectorAll('.add-to-cart-btn')
        .forEach(btn => {

            btn.addEventListener(
                'click',
                event => {

                    event.preventDefault();
                    event.stopPropagation();


                    selected.id =
                        btn.dataset.id;


                    selected.stock =
                        parseInt(
                            btn.dataset.stock,
                            10
                        ) || 0;


                    selected.qty = 1;


                    document
                        .getElementById(
                            'qtyProductName'
                        )
                        .innerText =
                            btn.dataset.name;


                    document
                        .getElementById(
                            'qtyAvailable'
                        )
                        .innerText =
                            selected.stock;


                    updateQuantityDisplay();


                    qtyModal.show();

                }
            );

        });


    /* =====================================================
       QUANTITY DISPLAY
    ===================================================== */

    function updateQuantityDisplay(){

        document
            .getElementById('qtyValue')
            .innerText =
                selected.qty;


        document
            .getElementById('qtyConfirmCount')
            .innerText =
                selected.qty;

    }


    /* =====================================================
       QUANTITY PLUS
    ===================================================== */

    document
        .getElementById('qtyPlus')
        .addEventListener(
            'click',
            () => {

                if(
                    selected.qty <
                    selected.stock
                ){

                    selected.qty++;

                    updateQuantityDisplay();

                }

            }
        );


    /* =====================================================
       QUANTITY MINUS
    ===================================================== */

    document
        .getElementById('qtyMinus')
        .addEventListener(
            'click',
            () => {

                if(selected.qty > 1){

                    selected.qty--;

                    updateQuantityDisplay();

                }

            }
        );


    /* =====================================================
       CONFIRM ADD TO CART
    ===================================================== */

    document
        .getElementById('qtyConfirm')
        .addEventListener(
            'click',
            async () => {

                const button =
                    document.getElementById(
                        'qtyConfirm'
                    );


                button.disabled = true;


                try{

                    const response =
                        await fetch(
                            '/products/add-to-cart',
                            {
                                method:'POST',

                                headers:{
                                    'Content-Type':
                                        'application/json'
                                },

                                body:
                                    JSON.stringify({
                                        productId:
                                            selected.id,

                                        qty:
                                            selected.qty
                                    })
                            }
                        );


                    const data =
                        await response.json();


                    if(!data.success){

                        alert(
                            data.message ||
                            'Unable to add product to cart.'
                        );

                        button.disabled = false;

                        return;

                    }


                    qtyModal.hide();

                    location.reload();


                }catch(error){

                    console.error(error);

                    alert(
                        'Unable to connect to the server.'
                    );

                    button.disabled = false;

                }

            }
        );


    /* =====================================================
       OPEN CART SIDEBAR
    ===================================================== */

    document
        .getElementById('cartBtn')
        .addEventListener(
            'click',
            () => {

                cartSidebar.show();

            }
        );


    /* =====================================================
       CART REQUEST
    ===================================================== */

    async function callCart(url, body){

        try{

            const response =
                await fetch(
                    url,
                    {
                        method:'POST',

                        headers:{
                            'Content-Type':
                                'application/json'
                        },

                        body:
                            JSON.stringify(body)
                    }
                );


            const data =
                await response.json();


            if(!data.success){

                alert(
                    data.message ||
                    'Cart update failed.'
                );

                return false;

            }


            location.reload();

            return true;


        }catch(error){

            console.error(error);

            alert(
                'Unable to connect to the server.'
            );

            return false;

        }

    }


    /* =====================================================
       CART PLUS
    ===================================================== */

    document
        .querySelectorAll('.cart-plus')
        .forEach(button => {

            button.addEventListener(
                'click',
                () => {

                    const id =
                        button.dataset.id;


                    const quantityElement =
                        document.querySelector(
                            `.cart-item[data-id="${id}"] .cart-qty`
                        );


                    if(!quantityElement){
                        return;
                    }


                    const currentQuantity =
                        parseInt(
                            quantityElement.innerText,
                            10
                        ) || 0;


                    callCart(
                        '/products/update-cart-qty',
                        {
                            productId:id,

                            qty:
                                currentQuantity + 1
                        }
                    );

                }
            );

        });


    /* =====================================================
       CART MINUS
    ===================================================== */

    document
        .querySelectorAll('.cart-minus')
        .forEach(button => {

            button.addEventListener(
                'click',
                () => {

                    const id =
                        button.dataset.id;


                    const quantityElement =
                        document.querySelector(
                            `.cart-item[data-id="${id}"] .cart-qty`
                        );


                    if(!quantityElement){
                        return;
                    }


                    const currentQuantity =
                        parseInt(
                            quantityElement.innerText,
                            10
                        ) || 0;


                    if(currentQuantity <= 1){

                        callCart(
                            '/products/remove-from-cart',
                            {
                                productId:id
                            }
                        );

                        return;

                    }


                    callCart(
                        '/products/update-cart-qty',
                        {
                            productId:id,

                            qty:
                                currentQuantity - 1
                        }
                    );

                }
            );

        });


    /* =====================================================
       REMOVE FROM CART
    ===================================================== */

    document
        .querySelectorAll('.cart-remove')
        .forEach(button => {

            button.addEventListener(
                'click',
                () => {

                    callCart(
                        '/products/remove-from-cart',
                        {
                            productId:
                                button.dataset.id
                        }
                    );

                }
            );

        });


    /* =====================================================
       PACKAGE ORDER
    ===================================================== */

    const checkoutButton =
        document.getElementById(
            'checkoutBtn'
        );


    if(checkoutButton){

        checkoutButton.addEventListener(
            'click',
            async () => {

                checkoutButton.disabled = true;


                try{

                    const response =
                        await fetch(
                            '/packages/create',
                            {
                                method:'POST',

                                headers:{
                                    'Content-Type':
                                        'application/json'
                                },

                                body:
                                    JSON.stringify({})
                            }
                        );


                    const data =
                        await response.json();


                    if(
                        data.success &&
                        data.packageId
                    ){

                        window.location.href =
                            '/packages/' +
                            data.packageId;

                        return;

                    }


                    alert(
                        data.message ||
                        'Unable to create package order.'
                    );


                    checkoutButton.disabled =
                        false;


                }catch(error){

                    console.error(error);

                    alert(
                        'Unable to connect to the server.'
                    );


                    checkoutButton.disabled =
                        false;

                }

            }
        );

    }


});

</script>