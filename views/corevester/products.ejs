        </div>


    </section>


    <!-- =================================================
         CATEGORY NAVIGATION
    ================================================== -->

    <div class="category-shell">

        <nav
            class="category-bar"
            aria-label="Product categories"
        >

            <a
                href="/products?category=all"
                class="cat-pill <%= activeCategory === 'all' ? 'active' : '' %>"
            >
                All
            </a>


            <% (categories || []).forEach(c => { %>

                <a
                    href="/products?category=<%= c %>"
                    class="cat-pill text-capitalize <%= activeCategory === c ? 'active' : '' %>"
                >

                    <%= c %>

                </a>

            <% }) %>

        </nav>

    </div>


    <!-- =================================================
         PRODUCT AREA
    ================================================== -->

    <main class="product-section">


        <% if (!products || !products.length) { %>


            <!-- =================================================
                 PREMIUM EMPTY STATE
            ================================================== -->

            <div class="market-empty">

                <div class="empty-visual">

                    <i class="fas fa-store-slash"></i>

                </div>


                <h3>
                    Nothing here just yet
                </h3>


                <p>
                    There are currently no products available
                    in this category. Try another category to
                    discover what's available.
                </p>


                <% if(activeCategory !== 'all'){ %>

                    <a
                        href="/products?category=all"
                        class="empty-action"
                    >

                        <i class="fas fa-layer-group"></i>

                        VIEW ALL PRODUCTS

                    </a>

                <% } %>

            </div>


        <% } else { %>


            <!-- =================================================
                 PRODUCT HEADING
            ================================================== -->

            <div class="products-heading">

                <div class="products-heading-left">

                    <h2>
                        Available products
                    </h2>

                    <p>
                        Select a product to view details
                        or add it to your cart.
                    </p>

                </div>

                <span class="products-count">

                    <%= products.length %>
                    <%= products.length === 1
                        ? 'item'
                        : 'items'
                    %>

                </span>

            </div>


            <% if(products.length < 20){ %>


                <!-- =================================================
                     NORMAL GRID
                ================================================== -->

                <div class="grid-wrap">


                    <% products.forEach(p => { %>

                        <%

                            const stock =
                                Number(p.units || 0);

                            let stockClass = '';

                            if(stock <= 0){

                                stockClass =
                                    'stock-out';

                            }else if(stock <= 5){

                                stockClass =
                                    'stock-low';

                            }

                        %>


                        <article
                            class="card-box"
                            data-product-id="<%= p._id %>"
                        >


                            <div class="product-image-wrap">

                                <span
                                    class="left-badge <%= stockClass %>"
                                >

                                    <span class="stock-dot"></span>

                                    <% if(stock <= 0){ %>

                                        Out of stock

                                    <% }else if(stock <= 5){ %>

                                        Only <%= stock %> left

                                    <% }else{ %>

                                        <%= stock %> available

                                    <% } %>

                                </span>


                                <img
                                    src="<%= p.image || '/images/no-image.png' %>"
                                    alt="<%= p.name %>"
                                    class="product-image"
                                    loading="lazy"
                                >

                            </div>


                            <div class="product-body">

                                <div class="cat-label">
                                    <%= p.category %>
                                </div>


                                <div class="prod-name">
                                    <%= p.name %>
                                </div>


                                <div class="prod-price">

                                    <span class="price-label">
                                        KES
                                    </span>

                                    <%= Number(
                                        p.unitSellPrice || 0
                                    ).toLocaleString() %>

                                </div>


                                <button
                                    type="button"
                                    class="add-btn add-to-cart-btn"
                                    data-id="<%= p._id %>"
                                    data-name="<%= p.name %>"
                                    data-stock="<%= stock %>"
                                    <%= stock <= 0
                                        ? 'disabled'
                                        : ''
                                    %>
                                >

                                    <i
                                        class="fas <%= stock <= 0
                                            ? 'fa-ban'
                                            : 'fa-cart-plus'
                                        %>"
                                    ></i>

                                    <%= stock <= 0
                                        ? 'OUT OF STOCK'
                                        : 'ADD TO CART'
                                    %>

                                </button>

                            </div>

                        </article>


                    <% }) %>


                </div>


            <% } else { %>


                <!-- =================================================
                     LARGE COLLECTION
                ================================================== -->

                <%

                    const chunkSize = 10;

                    for(
                        let i = 0;
                        i < products.length;
                        i += chunkSize
                    ){

                        const chunk =
                            products.slice(
                                i,
                                i + chunkSize
                            );

                %>


                    <div class="prod-scroll">


                        <% chunk.forEach(p => { %>

                            <%

                                const stock =
                                    Number(p.units || 0);

                                let stockClass = '';

                                if(stock <= 0){

                                    stockClass =
                                        'stock-out';

                                }else if(stock <= 5){

                                    stockClass =
                                        'stock-low';

                                }

                            %>


                            <article
                                class="card-box"
                                data-product-id="<%= p._id %>"
                            >


                                <div class="product-image-wrap">

                                    <span
                                        class="left-badge <%= stockClass %>"
                                    >

                                        <span class="stock-dot"></span>

                                        <% if(stock <= 0){ %>

                                            Out

                                        <% }else{ %>

                                            <%= stock %> left

                                        <% } %>

                                    </span>


                                    <img
                                        src="<%= p.image || '/images/no-image.png' %>"
                                        alt="<%= p.name %>"
                                        class="product-image"
                                        loading="lazy"
                                    >

                                </div>


                                <div class="product-body">

                                    <div class="cat-label">
                                        <%= p.category %>
                                    </div>


                                    <div class="prod-name">
                                        <%= p.name %>
                                    </div>


                                    <div class="prod-price">

                                        <span class="price-label">
                                            KES
                                        </span>

                                        <%= Number(
                                            p.unitSellPrice || 0
                                        ).toLocaleString() %>

                                    </div>


                                    <button
                                        type="button"
                                        class="add-btn add-to-cart-btn"
                                        data-id="<%= p._id %>"
                                        data-name="<%= p.name %>"
                                        data-stock="<%= stock %>"
                                        <%= stock <= 0
                                            ? 'disabled'
                                            : ''
                                        %>
                                    >

                                        <i
                                            class="fas <%= stock <= 0
                                                ? 'fa-ban'
                                                : 'fa-cart-plus'
                                            %>"
                                        ></i>

                                        <%= stock <= 0
                                            ? 'OUT'
                                            : 'ADD CART'
                                        %>

                                    </button>

                                </div>

                            </article>


                        <% }) %>


                    </div>


                <% } %>


            <% } %>


        <% } %>


    </main>


</div>

</div><!-- =========================================================
     QUANTITY MODAL
========================================================= --><div
    class="modal fade"
    id="qtyModal"
    tabindex="-1"
    aria-hidden="true"
><div class="modal-dialog modal-dialog-centered modal-sm">

    <div class="modal-content qty-modal-content">

        <div class="qty-modal-header">

            <h6
                class="qty-product-name"
                id="qtyProductName"
            ></h6>

            <p class="qty-available">

                Available:

                <strong id="qtyAvailable"></strong>

            </p>

        </div>


