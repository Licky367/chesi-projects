<!-- =========================================================
     views/products.ejs
     =========================================================

     CORE VESTER HEALTHCARE
     PRODUCT MARKETPLACE

     EXPECTED DATA:
         products
             Array of Product documents

     PRODUCT FIELDS:
         name
         category
         image
         units
         unitSellPrice
         description
         isActive
         isOutOfStock (virtual)

     DISPLAY:
         One card per product
         One horizontal scrollable row per category
     ========================================================= -->


<style>

    /* =========================================================
       CORE VESTER THEME
       ========================================================= */

    :root {
        --core-green: #0a4d1e;
        --core-green-dark: #063b17;
        --core-green-light: #e8f5e9;
        --core-green-soft: #f1f8e9;

        --core-background: #f8fdf6;
        --core-border: #dcebdc;

        --core-text: #18351f;
        --core-muted: #6b756d;

        --core-white: #ffffff;
    }


    /* =========================================================
       PAGE
       ========================================================= */

    .products-page {
        min-height: calc(100vh - 80px);

        background: var(--core-background);

        padding-bottom: 45px;

        font-family: "Segoe UI", sans-serif;

        color: var(--core-text);

        box-sizing: border-box;
    }


    /* =========================================================
       HERO
       ========================================================= */

    .products-hero {
        position: relative;

        overflow: hidden;

        background: linear-gradient(
            135deg,
            #ffffff 0%,
            #f8fdf6 65%,
            #f1f8e9 100%
        );

        border-bottom: 1px solid var(--core-border);

        padding: 30px 24px 28px;

        box-sizing: border-box;
    }

    .products-hero::after {
        content: "";

        position: absolute;

        width: 230px;
        height: 230px;

        right: -90px;
        top: -110px;

        border-radius: 50%;

        background: rgba(10, 77, 30, 0.035);

        pointer-events: none;
    }

    .products-hero-inner {
        position: relative;

        z-index: 1;

        max-width: 1250px;

        margin: 0 auto;
    }

    .products-hero h1 {
        margin: 0;

        color: var(--core-green);

        font-size: 30px;

        font-weight: 800;

        letter-spacing: -0.5px;
    }

    .products-hero p {
        margin: 7px 0 0;

        color: #536058;

        font-size: 14px;

        line-height: 1.5;
    }


    /* =========================================================
       PRODUCTS CONTAINER
       ========================================================= */

    .products-container {
        max-width: 1250px;

        margin: 0 auto;

        padding: 28px 20px 0;

        box-sizing: border-box;
    }


    /* =========================================================
       CATEGORY
       ========================================================= */

    .product-category {
        margin-bottom: 34px;
    }

    .product-category:last-child {
        margin-bottom: 0;
    }


    /* =========================================================
       CATEGORY HEADER
       ========================================================= */

    .category-header {
        display: flex;

        align-items: center;

        justify-content: space-between;

        gap: 15px;

        margin-bottom: 13px;

        padding: 0 3px;

        box-sizing: border-box;
    }

    .category-title-wrapper {
        min-width: 0;

        display: flex;

        align-items: center;

        gap: 10px;
    }

    .category-icon {
        width: 34px;
        height: 34px;

        flex: 0 0 34px;

        display: flex;

        align-items: center;

        justify-content: center;

        background: var(--core-green-light);

        color: var(--core-green);

        border-radius: 10px;

        font-size: 15px;
    }

    .category-title {
        margin: 0;

        color: #17351f;

        font-size: 19px;

        font-weight: 750;

        text-transform: capitalize;

        white-space: nowrap;

        overflow: hidden;

        text-overflow: ellipsis;
    }

    .category-count {
        color: #778078;

        font-size: 12px;

        font-weight: 500;

        margin-left: 3px;
    }

    .category-scroll-hint {
        display: flex;

        align-items: center;

        gap: 5px;

        color: var(--core-green);

        font-size: 12px;

        font-weight: 700;

        white-space: nowrap;
    }

    .category-scroll-hint i {
        font-size: 11px;
    }


    /* =========================================================
       HORIZONTAL PRODUCT ROW
       ========================================================= */

    .product-row {
        display: flex;

        gap: 13px;

        width: 100%;

        max-width: 100%;

        overflow-x: auto;

        overflow-y: hidden;

        padding: 3px 3px 12px;

        box-sizing: border-box;

        scroll-snap-type: x mandatory;

        scroll-behavior: smooth;

        -webkit-overflow-scrolling: touch;

        scrollbar-width: thin;

        scrollbar-color:
            rgba(10, 77, 30, 0.35)
            transparent;
    }

    .product-row::-webkit-scrollbar {
        height: 5px;
    }

    .product-row::-webkit-scrollbar-track {
        background: transparent;
    }

    .product-row::-webkit-scrollbar-thumb {
        background: rgba(10, 77, 30, 0.28);

        border-radius: 20px;
    }

    .product-row::-webkit-scrollbar-thumb:hover {
        background: rgba(10, 77, 30, 0.45);
    }


    /* =========================================================
       PRODUCT CARD
       ========================================================= */

    .product-card {
        position: relative;

        flex: 0 0 205px;

        width: 205px;

        min-width: 205px;

        max-width: 205px;

        background: var(--core-white);

        border: 1px solid #e1e8e2;

        border-radius: 15px;

        overflow: hidden;

        scroll-snap-align: start;

        box-shadow:
            0 2px 8px rgba(10, 77, 30, 0.06);

        transition:
            transform 0.2s ease,
            box-shadow 0.2s ease,
            border-color 0.2s ease;

        box-sizing: border-box;
    }

    .product-card:hover {
        transform: translateY(-3px);

        border-color: rgba(10, 77, 30, 0.20);

        box-shadow:
            0 8px 22px rgba(10, 77, 30, 0.12);
    }


    /* =========================================================
       PRODUCT IMAGE CONTAINER
       =========================================================

       IMPORTANT:
       ---------------------------------------------------------
       This container strictly controls the image area.

       An image can be 100px, 1000px, or 10,000px wide,
       but it cannot escape this box.
       ========================================================= */

    .product-image-wrapper {
        position: relative;

        width: 100%;

        height: 158px;

        min-height: 158px;

        max-height: 158px;

        background: #f7faf7;

        overflow: hidden;

        display: flex;

        align-items: center;

        justify-content: center;

        box-sizing: border-box;
    }


    /* =========================================================
       PRODUCT IMAGE
       =========================================================

       IMPORTANT:
       ---------------------------------------------------------
       "contain" keeps the complete product visible.

       !important prevents external/global img CSS from
       overriding these dimensions.
       ========================================================= */

    .product-image-wrapper .product-image {
        display: block !important;

        width: 100% !important;

        height: 100% !important;

        max-width: 100% !important;

        max-height: 100% !important;

        min-width: 0 !important;

        min-height: 0 !important;

        object-fit: contain !important;

        object-position: center center !important;

        margin: 0 !important;

        padding: 0 !important;

        box-sizing: border-box !important;
    }


    /* =========================================================
       NO IMAGE
       ========================================================= */

    .product-no-image {
        width: 100%;

        height: 100%;

        min-height: 0;

        display: flex;

        flex-direction: column;

        align-items: center;

        justify-content: center;

        color: #9ba59d;

        box-sizing: border-box;
    }

    .product-no-image i {
        font-size: 31px;

        margin-bottom: 7px;
    }

    .product-no-image span {
        font-size: 11px;
    }


    /* =========================================================
       STOCK BADGE
       ========================================================= */

    .stock-badge {
        position: absolute;

        top: 9px;

        right: 9px;

        padding: 5px 8px;

        border-radius: 8px;

        background: rgba(255, 255, 255, 0.94);

        color: var(--core-green);

        font-size: 10px;

        font-weight: 750;

        box-shadow:
            0 2px 7px rgba(0, 0, 0, 0.08);

        z-index: 2;
    }

    .stock-badge.out-of-stock {
        background: #fff1f1;

        color: #a52828;
    }


    /* =========================================================
       PRODUCT CONTENT
       ========================================================= */

    .product-content {
        padding: 11px 11px 12px;

        box-sizing: border-box;
    }

    .product-name {
        margin: 0;

        color: #183a22;

        font-size: 14px;

        font-weight: 750;

        line-height: 1.25;

        display: -webkit-box;

        -webkit-line-clamp: 2;

        -webkit-box-orient: vertical;

        overflow: hidden;

        min-height: 35px;
    }

    .product-description {
        margin: 5px 0 9px;

        color: var(--core-muted);

        font-size: 11px;

        line-height: 1.4;

        display: -webkit-box;

        -webkit-line-clamp: 2;

        -webkit-box-orient: vertical;

        overflow: hidden;

        min-height: 30px;
    }


    /* =========================================================
       PRODUCT BOTTOM
       ========================================================= */

    .product-bottom {
        display: flex;

        align-items: center;

        justify-content: space-between;

        gap: 7px;
    }

    .product-price-label {
        display: block;

        color: #879088;

        font-size: 9px;

        font-weight: 500;

        margin-bottom: 1px;
    }

    .product-price {
        color: var(--core-green);

        font-size: 13px;

        font-weight: 800;

        white-space: nowrap;
    }


    /* =========================================================
       PRODUCT ACTION
       ========================================================= */

    .product-action {
        width: 34px;

        height: 34px;

        flex: 0 0 34px;

        display: flex;

        align-items: center;

        justify-content: center;

        border: 0;

        border-radius: 9px;

        background: var(--core-green-soft);

        color: var(--core-green);

        cursor: pointer;

        font-size: 14px;

        transition:
            background 0.2s ease,
            color 0.2s ease,
            transform 0.15s ease;
    }

    .product-action:hover {
        background: var(--core-green);

        color: #ffffff;
    }

    .product-action:active {
        transform: scale(0.92);
    }

    .product-action.disabled {
        background: #f0f1f0;

        color: #9a9e9b;

        cursor: not-allowed;
    }

    .product-action.disabled:hover {
        background: #f0f1f0;

        color: #9a9e9b;
    }


    /* =========================================================
       OUT OF STOCK
       ========================================================= */

    .product-card.is-out-of-stock {
        opacity: 0.82;
    }

    .product-card.is-out-of-stock .product-image {
        filter: grayscale(12%);
    }


    /* =========================================================
       CATEGORY DIVIDER
       ========================================================= */

    .category-divider {
        height: 1px;

        margin: 0 3px 30px;

        background: #dfe9e0;
    }

    .product-category:last-child .category-divider {
        display: none;
    }


    /* =========================================================
       EMPTY STATE
       ========================================================= */

    .products-empty {
        max-width: 520px;

        margin: 50px auto;

        padding: 40px 25px;

        background: #ffffff;

        border: 1px solid var(--core-border);

        border-radius: 18px;

        text-align: center;

        box-shadow:
            0 4px 18px rgba(10, 77, 30, 0.06);

        box-sizing: border-box;
    }

    .products-empty-icon {
        width: 62px;

        height: 62px;

        margin: 0 auto 15px;

        display: flex;

        align-items: center;

        justify-content: center;

        border-radius: 17px;

        background: var(--core-green-light);

        color: var(--core-green);

        font-size: 25px;
    }

    .products-empty h2 {
        margin: 0 0 7px;

        color: var(--core-green);

        font-size: 19px;
    }

    .products-empty p {
        margin: 0;

        color: #707a72;

        font-size: 13px;

        line-height: 1.5;
    }


    /* =========================================================
       MOBILE
       ========================================================= */

    @media (max-width: 600px) {

        .products-page {
            padding-bottom: 30px;
        }

        .products-hero {
            padding: 24px 17px 23px;
        }

        .products-hero h1 {
            font-size: 25px;
        }

        .products-hero p {
            font-size: 13px;
        }

        .products-container {
            padding: 23px 13px 0;
        }

        .product-category {
            margin-bottom: 27px;
        }

        .category-header {
            padding: 0 3px;

            margin-bottom: 11px;
        }

        .category-icon {
            width: 31px;

            height: 31px;

            flex-basis: 31px;

            border-radius: 9px;
        }

        .category-title {
            font-size: 17px;
        }

        .category-scroll-hint {
            font-size: 0;
        }

        .category-scroll-hint i {
            font-size: 14px;
        }

        .product-row {
            gap: 11px;

            padding-left: 2px;

            padding-right: 2px;
        }


        /* -----------------------------------------
           MOBILE CARD
           ----------------------------------------- */

        .product-card {
            flex-basis: 175px;

            width: 175px;

            min-width: 175px;

            max-width: 175px;

            border-radius: 14px;
        }


        /* -----------------------------------------
           MOBILE IMAGE
           ----------------------------------------- */

        .product-image-wrapper {
            width: 100%;

            height: 145px;

            min-height: 145px;

            max-height: 145px;
        }

        .product-image-wrapper .product-image {
            width: 100% !important;

            height: 100% !important;

            max-width: 100% !important;

            max-height: 100% !important;
        }

        .product-content {
            padding: 10px;
        }

        .product-name {
            font-size: 13px;
        }

        .product-description {
            font-size: 10.5px;
        }

        .product-price {
            font-size: 12px;
        }

        .product-action {
            width: 32px;

            height: 32px;

            flex-basis: 32px;
        }
    }


    /* =========================================================
       VERY SMALL PHONES
       ========================================================= */

    @media (max-width: 380px) {

        .product-card {
            flex-basis: 160px;

            width: 160px;

            min-width: 160px;

            max-width: 160px;
        }

        .product-image-wrapper {
            height: 132px;

            min-height: 132px;

            max-height: 132px;
        }
    }


    /* =========================================================
       REDUCED MOTION
       ========================================================= */

    @media (prefers-reduced-motion: reduce) {

        .product-row {
            scroll-behavior: auto;
        }

        .product-card,
        .product-image,
        .product-action {
            transition: none;
        }
    }

</style>


<!-- =========================================================
     PRODUCTS PAGE
     ========================================================= -->

<div class="products-page">


    <!-- =====================================================
         PAGE INTRO
         ===================================================== -->

    <section class="products-hero">

        <div class="products-hero-inner">

            <h1>
                Our Products
            </h1>

            <p>
                Quality medical equipment and hospital supplies
                you can trust.
            </p>

        </div>

    </section>


    <!-- =====================================================
         PRODUCTS
         ===================================================== -->

    <main class="products-container">

        <%
            /*
             * =================================================
             * GROUP PRODUCTS BY CATEGORY
             * =================================================
             */

            const groupedProducts = {};

            if (Array.isArray(products)) {

                products
                    .filter(product =>
                        product &&
                        product.isActive !== false
                    )
                    .forEach(product => {

                        const category =
                            String(
                                product.category || "other"
                            )
                            .trim()
                            .toLowerCase();

                        if (!groupedProducts[category]) {
                            groupedProducts[category] = [];
                        }

                        groupedProducts[category].push(product);
                    });
            }


            /*
             * =================================================
             * CATEGORY ICONS
             * =================================================
             */

            const categoryIcons = {

                "medical equipment":
                    "fa-stethoscope",

                "hospital supplies":
                    "fa-kit-medical",

                "consumables":
                    "fa-syringe",

                "medicines":
                    "fa-pills",

                "pharmaceuticals":
                    "fa-pills",

                "diagnostics":
                    "fa-microscope",

                "surgical":
                    "fa-user-doctor",

                "laboratory":
                    "fa-flask",

                "laboratory equipment":
                    "fa-flask",

                "dental":
                    "fa-tooth",

                "personal care":
                    "fa-hand-holding-medical",

                "other":
                    "fa-boxes-stacked"
            };
        %>


        <% if (Object.keys(groupedProducts).length === 0) { %>


            <!-- =================================================
                 EMPTY STATE
                 ================================================= -->

            <div class="products-empty">

                <div class="products-empty-icon">

                    <i class="fas fa-box-open"></i>

                </div>

                <h2>
                    No Products Available
                </h2>

                <p>
                    There are currently no products available.
                    Please check again later.
                </p>

            </div>


        <% } else { %>


            <!-- =================================================
                 CATEGORY ROWS
                 ================================================= -->

            <% Object.entries(groupedProducts).forEach(
                ([category, categoryProducts]) => {
            %>


                <section class="product-category">


                    <!-- =========================================
                         CATEGORY HEADER
                         ========================================= -->

                    <div class="category-header">


                        <div class="category-title-wrapper">


                            <div class="category-icon">

                                <i class="fas
                                    <%= categoryIcons[category]
                                        || 'fa-boxes-stacked' %>">
                                </i>

                            </div>


                            <h2 class="category-title">

                                <%= category %>

                                <span class="category-count">
                                    (<%= categoryProducts.length %>)
                                </span>

                            </h2>


                        </div>


                        <% if (categoryProducts.length > 2) { %>

                            <div class="category-scroll-hint">

                                <span>
                                    Scroll
                                </span>

                                <i class="fas fa-chevron-right"></i>

                            </div>

                        <% } %>


                    </div>


                    <!-- =========================================
                         HORIZONTAL PRODUCT ROW
                         ========================================= -->

                    <div
                        class="product-row"
                        data-category="<%= category %>"
                    >


                        <% categoryProducts.forEach(product => { %>


                            <!-- =================================
                                 PRODUCT CARD
                                 ================================= -->

                            <article
                                class="
                                    product-card
                                    <%= product.units <= 0
                                        ? 'is-out-of-stock'
                                        : '' %>
                                "
                                data-product-id="<%= product._id %>"
                            >


                                <!-- =============================
                                     IMAGE AREA
                                     ============================= -->

                                <div class="product-image-wrapper">


                                    <% if (product.image) { %>


                                        <img
                                            class="product-image"
                                            src="<%= product.image %>"
                                            alt="<%= product.name %>"
                                            loading="lazy"
                                            onerror="
                                                this.style.display='none';
                                                this.nextElementSibling.style.display='flex';
                                            "
                                        >


                                        <div
                                            class="product-no-image"
                                            style="display:none;"
                                        >

                                            <i class="fas fa-image"></i>

                                            <span>
                                                Image unavailable
                                            </span>

                                        </div>


                                    <% } else { %>


                                        <div class="product-no-image">

                                            <i class="fas fa-box-open"></i>

                                            <span>
                                                No image available
                                            </span>

                                        </div>


                                    <% } %>


                                    <!-- =========================
                                         STOCK
                                         ========================= -->

                                    <% if (product.units <= 0) { %>


                                        <span
                                            class="
                                                stock-badge
                                                out-of-stock
                                            "
                                        >
                                            Out of stock
                                        </span>


                                    <% } else { %>


                                        <span class="stock-badge">

                                            <%= product.units %>
                                            units

                                        </span>


                                    <% } %>


                                </div>


                                <!-- =============================
                                     PRODUCT CONTENT
                                     ============================= -->

                                <div class="product-content">


                                    <h3 class="product-name">

                                        <%= product.name %>

                                    </h3>


                                    <p class="product-description">

                                        <%= product.description
                                            || "Quality healthcare product." %>

                                    </p>


                                    <!-- =========================
                                         PRICE + ACTION
                                         ========================= -->

                                    <div class="product-bottom">


                                        <!-- =====================
                                             PRICE
                                             ===================== -->

                                        <div>

                                            <span
                                                class="
                                                    product-price-label
                                                "
                                            >
                                                Price
                                            </span>


                                            <span class="product-price">

                                                KSh
                                                <%= Number(
                                                    product.unitSellPrice || 0
                                                ).toLocaleString("en-KE") %>

                                            </span>

                                        </div>


                                        <!-- =====================
                                             CART BUTTON
                                             ===================== -->

                                        <% if (product.units > 0) { %>


                                            <button
                                                type="button"
                                                class="product-action"
                                                title="Add to cart"
                                                aria-label="
                                                    Add
                                                    <%= product.name %>
                                                    to cart
                                                "
                                                data-product-id="
                                                    <%= product._id %>
                                                "
                                            >

                                                <i
                                                    class="
                                                        fas
                                                        fa-cart-plus
                                                    "
                                                ></i>

                                            </button>


                                        <% } else { %>


                                            <button
                                                type="button"
                                                class="
                                                    product-action
                                                    disabled
                                                "
                                                disabled
                                                title="Out of stock"
                                                aria-label="
                                                    <%= product.name %>
                                                    is out of stock
                                                "
                                            >

                                                <i
                                                    class="
                                                        fas
                                                        fa-ban
                                                    "
                                                ></i>

                                            </button>


                                        <% } %>


                                    </div>


                                </div>


                            </article>


                        <% }) %>


                    </div>


                    <!-- =========================================
                         CATEGORY DIVIDER
                         ========================================= -->

                    <div class="category-divider"></div>


                </section>


            <% }) %>


        <% } %>


    </main>


</div>


<!-- =========================================================
     HORIZONTAL SCROLL BEHAVIOUR
     ========================================================= -->

<script>

(function () {

    const rows =
        document.querySelectorAll(".product-row");


    rows.forEach(function (row) {

        let isDown = false;

        let startX = 0;

        let scrollLeft = 0;


        /* =====================================================
           MOUSE DRAG
           ===================================================== */

        row.addEventListener(
            "mousedown",
            function (event) {

                if (
                    row.scrollWidth <=
                    row.clientWidth
                ) {
                    return;
                }

                isDown = true;

                row.style.cursor = "grabbing";

                startX =
                    event.pageX -
                    row.offsetLeft;

                scrollLeft =
                    row.scrollLeft;
            }
        );


        row.addEventListener(
            "mouseleave",
            function () {

                isDown = false;

                row.style.cursor = "";

            }
        );


        row.addEventListener(
            "mouseup",
            function () {

                isDown = false;

                row.style.cursor = "";

            }
        );


        row.addEventListener(
            "mousemove",
            function (event) {

                if (!isDown) {
                    return;
                }

                event.preventDefault();


                const x =
                    event.pageX -
                    row.offsetLeft;


                const walk =
                    (x - startX) * 1.25;


                row.scrollLeft =
                    scrollLeft - walk;

            }
        );


        /* =====================================================
           MOUSE WHEEL
           ===================================================== */

        row.addEventListener(
            "wheel",
            function (event) {

                if (
                    row.scrollWidth >
                    row.clientWidth &&
                    Math.abs(event.deltaY) >
                    Math.abs(event.deltaX)
                ) {

                    event.preventDefault();

                    row.scrollLeft +=
                        event.deltaY;
                }

            },
            {
                passive: false
            }
        );

    });

})();

</script>