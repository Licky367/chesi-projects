<script>

document.addEventListener(
    'DOMContentLoaded',
    function () {


        /* ==================================================
           BOOTSTRAP
        ================================================== */

        const qtyModalElement =
            document.getElementById('qtyModal');


        const cartSidebarElement =
            document.getElementById('cartSidebar');


        const qtyModal =
            new bootstrap.Modal(
                qtyModalElement
            );


        const cartSidebar =
            new bootstrap.Offcanvas(
                cartSidebarElement
            );



        /* ==================================================
           SELECTED PRODUCT
        ================================================== */

        let selected = {

            id:
                null,

            name:
                '',

            stock:
                0,

            qty:
                1

        };



        /* ==================================================
           PRODUCT CARD NAVIGATION
        ================================================== */

        document
            .querySelectorAll('.product-card')
            .forEach(function (card) {


                card.addEventListener(
                    'click',
                    function (event) {


                        if (
                            event.target.closest(
                                '.add-to-cart-btn'
                            )
                        ) {

                            return;

                        }


                        const productId =
                            card.dataset.productId;


                        if (productId) {

                            window.location.href =
                                '/products/' +
                                productId;

                        }

                    }
                );

            });



        /* ==================================================
           ADD TO CART
        ================================================== */

        document
            .querySelectorAll(
                '.product-card .add-to-cart-btn'
            )
            .forEach(function (button) {


                button.addEventListener(
                    'click',
                    function (event) {


                        event.preventDefault();

                        event.stopPropagation();


                        selected.id =
                            button.dataset.id;


                        selected.name =
                            button.dataset.name;


                        selected.stock =
                            parseInt(
                                button.dataset.stock,
                                10
                            ) || 0;


                        selected.qty =
                            1;


                        document.getElementById(
                            'qtyProductName'
                        ).innerText =
                            selected.name;


                        document.getElementById(
                            'qtyAvailable'
                        ).innerText =
                            selected.stock;


                        updateQuantityDisplay();


                        qtyModal.show();

                    }
                );

            });



        /* ==================================================
           QUANTITY DISPLAY
        ================================================== */

        function updateQuantityDisplay() {

            document.getElementById(
                'qtyValue'
            ).innerText =
                selected.qty;


            document.getElementById(
                'qtyConfirmCount'
            ).innerText =
                selected.qty;

        }



        /* ==================================================
           PLUS
        ================================================== */

        document.getElementById(
            'qtyPlus'
        ).addEventListener(
            'click',
            function () {


                if (
                    selected.qty <
                    selected.stock
                ) {

                    selected.qty++;

                    updateQuantityDisplay();

                }

            }
        );



        /* ==================================================
           MINUS
        ================================================== */

        document.getElementById(
            'qtyMinus'
        ).addEventListener(
            'click',
            function () {


                if (
                    selected.qty > 1
                ) {

                    selected.qty--;

                    updateQuantityDisplay();

                }

            }
        );



        /* ==================================================
           CONFIRM ADD
        ================================================== */

        document.getElementById(
            'qtyConfirm'
        ).addEventListener(
            'click',
            async function () {


                const button =
                    document.getElementById(
                        'qtyConfirm'
                    );


                button.disabled =
                    true;


                try {


                    const response =
                        await fetch(
                            '/products/add-to-cart',
                            {
                                method:
                                    'POST',

                                headers: {
                                    'Content-Type':
                                        'application/json'
                                },

                                body:
                                    JSON.stringify({

                                        productId:
                                            selected.id,

                                        qty:
                                            selected.qty

                                    })

                            }
                        );


                    const data =
                        await response.json();


                    if (!data.success) {

                        alert(
                            data.message ||
                            'Unable to add product to cart.'
                        );


                        button.disabled =
                            false;

                        return;

                    }


                    qtyModal.hide();

                    location.reload();


                }
                catch (error) {

                    console.error(error);


                    alert(
                        'Unable to connect to the server.'
                    );


                    button.disabled =
                        false;

                }

            }
        );



        /* ==================================================
           OPEN CART
        ================================================== */

        document.getElementById(
            'cartBtn'
        ).addEventListener(
            'click',
            function () {

                cartSidebar.show();

            }
        );



        /* ==================================================
           CART REQUEST
        ================================================== */

        async function callCart(
            url,
            body
        ) {


            try {


                const response =
                    await fetch(
                        url,
                        {
                            method:
                                'POST',

                            headers: {
                                'Content-Type':
                                    'application/json'
                            },

                            body:
                                JSON.stringify(body)

                        }
                    );


                const data =
                    await response.json();


                if (!data.success) {

                    alert(
                        data.message ||
                        'Cart update failed.'
                    );

                    return false;

                }


                location.reload();

                return true;


            }
            catch (error) {

                console.error(error);


                alert(
                    'Unable to connect to the server.'
                );


                return false;

            }

        }



        /* ==================================================
           CART PLUS
        ================================================== */

        document
            .querySelectorAll('.cart-plus')
            .forEach(function (button) {


                button.addEventListener(
                    'click',
                    function () {


                        const id =
                            button.dataset.id;


                        const quantityElement =
                            document.querySelector(
                                `.cart-item[data-id="${id}"] .cart-qty`
                            );


                        if (!quantityElement) {

                            return;

                        }


                        const currentQuantity =
                            parseInt(
                                quantityElement.innerText,
                                10
                            ) || 0;


                        callCart(
                            '/products/update-cart-qty',
                            {

                                productId:
                                    id,

                                qty:
                                    currentQuantity + 1

                            }
                        );

                    }
                );

            });



        /* ==================================================
           CART MINUS
        ================================================== */

        document
            .querySelectorAll('.cart-minus')
            .forEach(function (button) {


                button.addEventListener(
                    'click',
                    function () {


                        const id =
                            button.dataset.id;


                        const quantityElement =
                            document.querySelector(
                                `.cart-item[data-id="${id}"] .cart-qty`
                            );


                        if (!quantityElement) {

                            return;

                        }


                        const currentQuantity =
                            parseInt(
                                quantityElement.innerText,
                                10
                            ) || 0;


                        if (
                            currentQuantity <= 1
                        ) {

                            callCart(
                                '/products/remove-from-cart',
                                {
                                    productId:
                                        id
                                }
                            );

                            return;

                        }


                        callCart(
                            '/products/update-cart-qty',
                            {

                                productId:
                                    id,

                                qty:
                                    currentQuantity - 1

                            }
                        );

                    }
                );

            });



        /* ==================================================
           REMOVE FROM CART
        ================================================== */

        document
            .querySelectorAll('.cart-remove')
            .forEach(function (button) {


                button.addEventListener(
                    'click',
                    function () {


                        callCart(
                            '/products/remove-from-cart',
                            {

                                productId:
                                    button.dataset.id

                            }
                        );

                    }
                );

            });



        /* ==================================================
           PACKAGE ORDER
        ================================================== */

        const checkoutButton =
            document.getElementById(
                'checkoutBtn'
            );


        if (checkoutButton) {


            checkoutButton.addEventListener(
                'click',
                async function () {


                    checkoutButton.disabled =
                        true;


                    try {


                        const response =
                            await fetch(
                                '/packages/create',
                                {
                                    method:
                                        'POST',

                                    headers: {
                                        'Content-Type':
                                            'application/json'
                                    },

                                    body:
                                        JSON.stringify({})

                                }
                            );


                        const data =
                            await response.json();


                        if (
                            data.success &&
                            data.packageId
                        ) {

                            window.location.href =
                                '/packages/' +
                                data.packageId;

                            return;

                        }


                        alert(
                            data.message ||
                            'Unable to create package order.'
                        );


                        checkoutButton.disabled =
                            false;


                    }
                    catch (error) {

                        console.error(error);


                        alert(
                            'Unable to connect to the server.'
                        );


                        checkoutButton.disabled =
                            false;

                    }

                }
            );

        }


    }

);

</script>