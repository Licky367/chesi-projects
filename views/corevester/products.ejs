</style><div class="market-wrap"><div class="market-container">


    <!-- =================================================
         MARKETPLACE HEADER
    ================================================= -->

    <header class="market-top">

        <div class="market-heading">

            <h1 class="market-title">

                <span class="market-title-icon">
                    <i class="fas fa-store"></i>
                </span>

                Marketplace

            </h1>

            <div class="market-sub">

                Browse available products and build your order.

            </div>

        </div>


        <!-- CART ICON -->

        <button
            type="button"
