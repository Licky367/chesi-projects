<% /*
============================================================
PRODUCT MARKETPLACE

PURPOSE:
------------------------------------------------------------
    Displays marketplace products as compact product cards.

LAYOUT:
------------------------------------------------------------
    • Uses FLEXBOX only.
    • CSS GRID IS NOT USED.
    • Products are arranged four cards across.
    • Additional products continue on the next row.
    • The product area can scroll horizontally.
    • Cards never shrink.
    • Cards remain compact on phones.

MOBILE CARD SIZE:
------------------------------------------------------------
    Width  : 108px
    Height : 155px

PRODUCT DATA:
------------------------------------------------------------
    products
    categories
    activeCategory
    cart
    cartCount
    cartTotal

============================================================
*/ %>


<div class="marketplace">


    <!-- =====================================================
         MARKETPLACE HEADER
    ====================================================== -->

    <section class="market-hero">

        <div class="market-hero-inner">


            <div class="market-title-row">


                <div class="market-heading">


                    <div class="market-eyebrow">

                        <i class="fas fa-store"></i>

                        Marketplace

                    </div>


                    <h1 class="market-title">

                        Shop our products

                    </h1>


                    <p class="market-description">

                        Browse available products and add what you need.

                    </p>


                </div>



                <button
                    type="button"
                    id="cartBtn"
                    class="market-cart-button"
                    aria-label="Open shopping cart"
                >

                    <i class="fas fa-shopping-cart"></i>

                </button>


            </div>



            <!-- =================================================
                 SUMMARY
            ================================================== -->

            <div class="market-summary">


                <div class="summary-card">


                    <div class="summary-icon">

                        <i class="fas fa-box-open"></i>

                    </div>


                    <div class="summary-info">

                        <span class="summary-label">

                            Available

                        </span>


                        <span class="summary-value">

                            <%= products.length %>

                            <%= products.length === 1
                                ? 'Product'
                                : 'Products'
                            %>

                        </span>

                    </div>


                </div>



                <div class="summary-card">


                    <div class="summary-icon">

                        <i class="fas fa-shopping-basket"></i>

                    </div>


                    <div class="summary-info">

                        <span class="summary-label">

                            In Cart

                        </span>


                        <span
                            class="summary-value"
                            id="cartCount"
                        >

                            <%= cartCount || 0 %>

                            <%= (cartCount || 0) === 1
                                ? 'Item'
                                : 'Items'
                            %>

                        </span>

                    </div>


                </div>



                <div class="summary-card">


                    <div class="summary-icon">

                        <i class="fas fa-coins"></i>

                    </div>


                    <div class="summary-info">

                        <span class="summary-label">

                            Cart Value

                        </span>


                        <span
                            class="summary-value"
                            id="cartTotalText"
                        >

                            KES

                            <%= Number(
                                cartTotal || 0
                            ).toLocaleString() %>

                        </span>

                    </div>


                </div>


            </div>


        </div>

    </section>



    <!-- =====================================================
         MAIN
    ====================================================== -->

    <main class="market-main">


        <!-- =================================================
             CATEGORY SECTION
        ================================================== -->

        <section class="category-section">


            <div class="section-heading">


                <div class="section-heading-left">

                    <i class="fas fa-layer-group"></i>

                    <h2 class="section-heading-title">

                        Categories

                    </h2>

                </div>


            </div>



            <nav
                class="category-bar"
                aria-label="Product categories"
            >


                <a
                    href="/products?category=all"
                    class="category-pill
                        <%= activeCategory === 'all'
                            ? 'active'
                            : '' %>"
                >

                    All

                </a>



                <% (categories || []).forEach(function(category) { %>


                    <a
                        href="/products?category=<%= encodeURIComponent(category) %>"
                        class="category-pill
                            <%= activeCategory === category
                                ? 'active'
                                : '' %>"
                    >

                        <%= category %>

                    </a>


                <% }) %>


            </nav>


        </section>



        <!-- =================================================
             PRODUCTS
        ================================================== -->

        <section class="products-section">


            <% if (!products || !products.length) { %>


                <!-- =========================================
                     EMPTY MARKETPLACE
                ========================================== -->

                <div class="empty-market">


                    <div class="empty-inner">


                        <div class="empty-icon">

                            <i class="fas fa-store-slash"></i>

                        </div>


                        <h3>

                            Nothing available here yet

                        </h3>


                        <p>


                            <% if (
                                activeCategory &&
                                activeCategory !== 'all'
                            ) { %>

                                We don't currently have any
                                products in the
                                <strong>
                                    <%= activeCategory %>
                                </strong>
                                category.


                            <% } else { %>

                                There are currently no products
                                available in the marketplace.
                                Please check again later.

                            <% } %>


                        </p>



                        <% if (
                            activeCategory &&
                            activeCategory !== 'all'
                        ) { %>


                            <a
                                href="/products?category=all"
                                class="empty-action"
                            >

                                <i class="fas fa-store"></i>

                                VIEW ALL PRODUCTS

                            </a>


                        <% } %>


                    </div>


                </div>


            <% } else { %>


                <!-- =========================================
                     PRODUCTS HEADING
                ========================================== -->

                <div class="products-heading">


                    <div class="section-heading-left">

                        <i class="fas fa-boxes-stacked"></i>

                        <h2 class="section-heading-title">

                            Products

                        </h2>

                    </div>


                    <div class="products-count">

                        Showing

                        <strong>
                            <%= products.length %>
                        </strong>

                        available

                    </div>


                </div>



                <!-- =========================================
                     PRODUCT VIEWPORT

                     FLEXBOX ONLY.

                     NO CSS GRID.
                ========================================== -->

                <div class="product-scroll">


                    <!--
                        This is intentionally a FLEX container.

                        Four cards occupy one row.

                        The fifth card automatically moves
                        to the next row.

                        There is NO product-count limit.
                    -->

                    <div class="product-list">


                        <% products.forEach(function(product) { %>


                            <%
                                const stock =
                                    Number(
                                        product.units || 0
                                    );


                                let stockClass = '';


                                if (stock <= 0) {

                                    stockClass =
                                        'stock-out';

                                }
                                else if (stock <= 5) {

                                    stockClass =
                                        'stock-low';

                                }
                            %>



                            <!-- =================================
                                 PRODUCT CARD
                            ================================== -->

                            <article
                                class="product-card"
                                data-product-id="<%= product._id %>"
                            >


                                <!-- =============================
                                     PRODUCT IMAGE
                                ============================== -->

                                <div class="product-image-wrap">


                                    <img
                                        src="<%= product.image || '/images/no-image.png' %>"
                                        alt="<%= product.name %>"
                                        class="product-image"
                                        loading="lazy"
                                        onerror="this.src='/images/no-image.png';"
                                    >


                                    <!-- STOCK BADGE -->

                                    <span
                                        class="stock-badge <%= stockClass %>"
                                    >


                                        <span class="stock-dot"></span>


                                        <% if (stock <= 0) { %>

                                            Out of stock

                                        <% }
                                        else if (stock <= 5) { %>

                                            Only <%= stock %> left

                                        <% }
                                        else { %>

                                            <%= stock %> available

                                        <% } %>


                                    </span>


                                </div>



                                <!-- =============================
                                     PRODUCT CONTENT
                                ============================== -->

                                <div class="product-content">


                                    <!-- CATEGORY -->

                                    <div class="product-category">

                                        <%= product.category || 'General' %>

                                    </div>



                                    <!-- NAME -->

                                    <div class="product-name">

                                        <%= product.name %>

                                    </div>



                                    <!-- PRICE -->

                                    <div class="product-price">


                                        <span class="currency">

                                            KES

                                        </span>


                                        <span>

                                            <%= Number(
                                                product.unitSellPrice || 0
                                            ).toLocaleString() %>

                                        </span>


                                    </div>



                                    <!-- ADD TO CART -->

                                    <button
                                        type="button"
                                        class="add-to-cart-btn"
                                        data-id="<%= product._id %>"
                                        data-name="<%= product.name %>"
                                        data-stock="<%= stock %>"
                                        <%= stock <= 0
                                            ? 'disabled'
                                            : '' %>
                                    >


                                        <i class="fas
                                            <%= stock <= 0
                                                ? 'fa-ban'
                                                : 'fa-cart-plus' %>"
                                        ></i>


                                        <span>

                                            <%= stock <= 0
                                                ? 'OUT'
                                                : 'ADD' %>

                                        </span>


                                    </button>


                                </div>


                            </article>


                        <% }) %>


                    </div>


                </div>


            <% } %>


        </section>


    </main>


</div>



<!-- =========================================================
     QUANTITY MODAL
========================================================= -->

<div
    class="modal fade"
    id="qtyModal"
    tabindex="-1"
    aria-hidden="true"
>


    <div class="modal-dialog modal-dialog-centered modal-sm">


        <div class="modal-content qty-modal">


            <div class="qty-header">


                <div class="qty-icon">

                    <i class="fas fa-cart-plus"></i>

                </div>


                <h3
                    class="qty-product-name"
                    id="qtyProductName"
                ></h3>


                <p class="qty-available">

                    Available:

                    <strong id="qtyAvailable">
                        0
                    </strong>

                </p>


            </div>



            <div class="qty-body">


                <div class="qty-selector">


                    <button
                        type="button"
                        class="qty-control"
                        id="qtyMinus"
                    >

                        −

                    </button>


                    <span
                        id="qtyValue"
                        class="qty-number"
                    >

                        1

                    </span>


                    <button
                        type="button"
                        class="qty-control"
                        id="qtyPlus"
                    >

                        +

                    </button>


                </div>



                <button
                    type="button"
                    class="add-to-cart-btn qty-confirm"
                    id="qtyConfirm"
                >

                    <i class="fas fa-cart-plus"></i>

                    ADD

                    <span id="qtyConfirmCount">
                        1
                    </span>

                    TO CART

                </button>



                <button
                    type="button"
                    class="btn btn-link qty-cancel"
                    data-bs-dismiss="modal"
                >

                    Cancel

                </button>


            </div>


        </div>


    </div>


</div>



<!-- =========================================================
     CART SIDEBAR
========================================================= -->

<div
    class="offcanvas offcanvas-end cart-sidebar"
    tabindex="-1"
    id="cartSidebar"
>


    <div class="cart-header">


        <div class="cart-heading">


            <div class="cart-icon">

                <i class="fas fa-shopping-basket"></i>

            </div>


            <div>


                <h5 class="cart-title">

                    Your Cart

                </h5>


                <p class="cart-subtitle">

                    Review your selected products

                </p>


            </div>


        </div>



        <button
            type="button"
            class="btn-close"
            data-bs-dismiss="offcanvas"
        ></button>


    </div>



    <div class="offcanvas-body cart-body">


        <% if (cart && cart.length) { %>


            <% cart.forEach(function(item) { %>


                <div
                    class="cart-item"
                    data-id="<%= item.productId %>"
                >


                    <div class="cart-product-info">


                        <span class="cart-product-name">

                            <%= item.name %>

                        </span>


                        <span class="cart-product-price">

                            KES

                            <strong>

                                <%= Number(
                                    item.price || 0
                                ).toLocaleString() %>

                            </strong>

                            ×

                            <span class="cart-qty">

                                <%= item.qty %>

                            </span>

                        </span>


                    </div>



                    <div class="cart-controls">


                        <button
                            type="button"
                            class="cart-control cart-minus"
                            data-id="<%= item.productId %>"
                        >

                            −

                        </button>


                        <button
                            type="button"
                            class="cart-control cart-plus"
                            data-id="<%= item.productId %>"
                        >

                            +

                        </button>


                        <button
                            type="button"
                            class="cart-control cart-remove"
                            data-id="<%= item.productId %>"
                        >

                            ×

                        </button>


                    </div>


                </div>


            <% }) %>


        <% } else { %>


            <div class="empty-cart">


                <div class="empty-cart-icon">

                    <i class="fas fa-shopping-basket"></i>

                </div>


                <strong>

                    Your cart is empty

                </strong>


                <span>

                    Products you add will appear here.

                </span>


            </div>


        <% } %>


    </div>



    <div class="cart-footer">


        <div class="cart-total">


            <span>

                Cart total

            </span>


            <strong>

                KES

                <%= Number(
                    cartTotal || 0
                ).toLocaleString() %>

            </strong>


        </div>



        <% if (cart && cart.length) { %>


            <button
                type="button"
                class="add-to-cart-btn checkout-btn"
                id="checkoutBtn"
            >

                <i class="fas fa-box"></i>

                PACKAGE ORDER

            </button>


        <% } %>


    </div>


</div>



<style>

/* ==========================================================
   MARKETPLACE
========================================================== */

