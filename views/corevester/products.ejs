<%- contentFor('body') %>

<style>

/* ==========================================================
   MARKETPLACE
========================================================== */

.marketplace{

    --green:#0b5a2a;
    --green-dark:#073f1d;
    --green-soft:#edf7f0;

    --orange:#e58a22;
    --orange-soft:#fff5e8;

    --ink:#18231c;
    --muted:#718078;

    --line:#e2e9e4;
    --line-soft:#edf2ee;

    width:100%;
    min-height:100vh;

    margin:0;

    padding:0 0 35px;

    background:#f6f8f7;

    color:var(--ink);

    box-sizing:border-box;
}


.marketplace *,
.marketplace *::before,
.marketplace *::after{

    box-sizing:border-box;

}


/* ==========================================================
   HERO
========================================================== */

.market-hero{

    width:100%;

    background:#ffffff;

    border-bottom:1px solid var(--line);

}


.market-hero-inner{

    width:100%;

    max-width:1280px;

    margin:0 auto;

    padding:18px 14px 15px;

}


/* ==========================================================
   TITLE ROW
========================================================== */

.market-title-row{

    display:flex;

    align-items:center;

    justify-content:space-between;

    gap:15px;

}


.market-heading{

    min-width:0;

}


.market-eyebrow{

    display:flex;

    align-items:center;

    gap:6px;

    margin-bottom:4px;

    color:#718078;

    font-size:10px;

    font-weight:800;

    text-transform:uppercase;

    letter-spacing:1px;

}


.market-eyebrow i{

    color:var(--green);

}


.market-title{

    margin:0;

    color:var(--green);

    font-size:25px;

    font-weight:900;

    line-height:1.1;

    letter-spacing:-.5px;

}


.market-description{

    margin:5px 0 0;

    color:#758179;

    font-size:11px;

    font-weight:500;

    line-height:1.45;

}


/* ==========================================================
   CART BUTTON
========================================================== */

.market-cart-button{

    position:relative;

    flex:0 0 44px;

    width:44px;

    height:44px;

    display:flex;

    align-items:center;

    justify-content:center;

    border:0;

    border-radius:12px;

    background:var(--green);

    color:#ffffff;

    cursor:pointer;

    box-shadow:
        0 5px 14px rgba(11,90,42,.18);

}


.market-cart-button:hover{

    background:var(--green-dark);

}


.market-cart-button:active{

    transform:scale(.96);

}


.market-cart-button i{

    font-size:15px;

}


/* ==========================================================
   SUMMARY
========================================================== */

.market-summary{

    width:100%;

    display:grid;

    grid-template-columns:
        repeat(3,minmax(0,1fr));

    gap:7px;

    margin-top:14px;

}


.summary-card{

    min-width:0;

    display:flex;

    align-items:center;

    gap:7px;

    padding:8px;

    background:#ffffff;

    border:1px solid var(--line);

    border-radius:10px;

}


.summary-icon{

    flex:0 0 28px;

    width:28px;

    height:28px;

    display:flex;

    align-items:center;

    justify-content:center;

    border-radius:8px;

    background:var(--green-soft);

    color:var(--green);

    font-size:11px;

}


.summary-card:nth-child(2)
.summary-icon{

    background:#f2f5f3;

    color:#587064;

}


.summary-card:nth-child(3)
.summary-icon{

    background:var(--orange-soft);

    color:#c56d10;

}


.summary-info{

    min-width:0;

}


.summary-label{

    display:block;

    color:#8a958e;

    font-size:7px;

    font-weight:900;

    text-transform:uppercase;

    letter-spacing:.4px;

}


.summary-value{

    display:block;

    margin-top:2px;

    color:var(--green);

    font-size:10px;

    font-weight:900;

    line-height:1.1;

    white-space:nowrap;

    overflow:hidden;

    text-overflow:ellipsis;

}


.summary-card:nth-child(3)
.summary-value{

    color:#b96710;

}


/* ==========================================================
   MAIN
========================================================== */

.market-main{

    width:100%;

    max-width:1280px;

    margin:0 auto;

    padding:16px 12px 0;

}


/* ==========================================================
   CATEGORY SECTION
========================================================== */

.category-section{

    margin-bottom:17px;

}


.section-heading{

    display:flex;

    align-items:center;

    justify-content:space-between;

    margin-bottom:8px;

}


.section-heading-left{

    display:flex;

    align-items:center;

    gap:6px;

}


.section-heading-left i{

    color:var(--green);

    font-size:11px;

}


.section-heading-title{

    margin:0;

    color:#26352c;

    font-size:12px;

    font-weight:900;

    text-transform:uppercase;

    letter-spacing:.6px;

}


/* ==========================================================
   CATEGORY BAR
========================================================== */

.category-bar{

    width:100%;

    display:flex;

    align-items:center;

    gap:7px;

    overflow-x:auto;

    overflow-y:hidden;

    padding:2px 1px 5px;

    scrollbar-width:none;

    -webkit-overflow-scrolling:touch;

}


.category-bar::-webkit-scrollbar{

    display:none;

}


.category-pill{

    flex:0 0 auto;

    min-height:30px;

    display:inline-flex;

    align-items:center;

    justify-content:center;

    padding:0 13px;

    border:1px solid #d5dfd8;

    border-radius:30px;

    background:#ffffff;

    color:#425348;

    text-decoration:none;

    font-size:9px;

    font-weight:800;

    white-space:nowrap;

}


.category-pill:hover{

    border-color:#a8c5b1;

    color:var(--green);

}


.category-pill.active{

    background:var(--green);

    border-color:var(--green);

    color:#ffffff;

}


/* ==========================================================
   PRODUCTS HEADER
========================================================== */

.products-heading{

    display:flex;

    align-items:center;

    justify-content:space-between;

    gap:10px;

    margin-bottom:9px;

}


.products-count{

    color:#849089;

    font-size:9px;

    font-weight:600;

}


.products-count strong{

    color:var(--green);

    font-weight:900;

}


/* ==========================================================
   PRODUCT CATALOGUE
==========================================================

   Responsive ecommerce layout.

   No fixed four-card limit.
   No horizontal product strip.
   No product shrinking to fit one row.
========================================================== */

.product-grid{

    width:100%;

    display:grid;

    grid-template-columns:
        repeat(2,minmax(0,1fr));

    gap:9px;

}


/* ==========================================================
   PRODUCT CARD
========================================================== */

.product-card{

    position:relative;

    width:100%;

    min-width:0;

    display:flex;

    flex-direction:column;

    overflow:hidden;

    background:#ffffff;

    border:1px solid #e1e7e3;

    border-radius:9px;

    box-shadow:
        0 2px 7px rgba(20,40,28,.055);

    cursor:pointer;

    transition:
        transform .16s ease,
        box-shadow .16s ease,
        border-color .16s ease;

}


.product-card:hover{

    transform:translateY(-2px);

    border-color:#cbd9cf;

    box-shadow:
        0 7px 17px rgba(20,40,28,.10);

}


.product-card:active{

    transform:scale(.985);

}


/* ==========================================================
   IMAGE AREA
========================================================== */

.product-image{

    position:relative;

    width:100%;

    aspect-ratio:1 / 1;

    overflow:hidden;

    background:#f0f4f1;

}


.product-image img{

    width:100%;

    height:100%;

    display:block;

    object-fit:cover;

    object-position:center;

    transition:transform .25s ease;

}


.product-card:hover
.product-image img{

    transform:scale(1.035);

}


/* ==========================================================
   STOCK BADGE
========================================================== */

.stock-badge{

    position:absolute;

    top:6px;

    left:6px;

    z-index:3;

    max-width:calc(100% - 12px);

    min-height:18px;

    display:inline-flex;

    align-items:center;

    gap:4px;

    padding:0 6px;

    border:1px solid rgba(11,90,42,.12);

    border-radius:20px;

    background:rgba(255,255,255,.94);

    color:var(--green);

    font-size:7px;

    font-weight:900;

    white-space:nowrap;

    overflow:hidden;

    text-overflow:ellipsis;

}


.stock-dot{

    flex:0 0 5px;

    width:5px;

    height:5px;

    border-radius:50%;

    background:#2da653;

}


.stock-low{

    color:#9a650e;

    border-color:#ecd7aa;

}


.stock-low .stock-dot{

    background:#e39a1d;

}


.stock-out{

    color:#a52f2f;

    border-color:#edcccc;

}


.stock-out .stock-dot{

    background:#d63b3b;

}


/* ==========================================================
   PRODUCT DETAILS
========================================================== */

.product-details{

    width:100%;

    min-width:0;

    display:flex;

    flex-direction:column;

    flex:1;

    padding:8px;

}


/* ==========================================================
   CATEGORY
========================================================== */

.product-category{

    width:100%;

    margin:0 0 3px;

    color:#4b7d5a;

    font-size:7px;

    font-weight:900;

    line-height:1.1;

    text-transform:uppercase;

    letter-spacing:.35px;

    white-space:nowrap;

    overflow:hidden;

    text-overflow:ellipsis;

}


/* ==========================================================
   PRODUCT NAME
========================================================== */

.product-name{

    margin:0;

    min-height:30px;

    color:#202a23;

    font-size:11px;

    font-weight:700;

    line-height:15px;

    display:-webkit-box;

    -webkit-box-orient:vertical;

    -webkit-line-clamp:2;

    overflow:hidden;

}


/* ==========================================================
   PRICE
========================================================== */

.product-price{

    display:flex;

    align-items:baseline;

    gap:3px;

    margin-top:5px;

    color:var(--green);

    font-size:13px;

    font-weight:900;

    line-height:1;

}


.currency{

    font-size:7px;

    font-weight:900;

}


/* ==========================================================
   ADD TO CART
========================================================== */

.add-to-cart-btn{

    width:100%;

    min-height:28px;

    height:28px;

    display:flex;

    align-items:center;

    justify-content:center;

    gap:4px;

    margin-top:8px;

    padding:0 5px;

    border:0;

    border-radius:6px;

    background:var(--green);

    color:#ffffff;

    font-size:7px;

    font-weight:900;

    white-space:nowrap;

    cursor:pointer;

    transition:
        background .15s ease,
        transform .15s ease;

}


.add-to-cart-btn:hover{

    background:var(--green-dark);

}


.add-to-cart-btn:active{

    transform:scale(.97);

}


.add-to-cart-btn:disabled{

    background:#dfe6e1;

    color:#7c8981;

    cursor:not-allowed;

}


.add-to-cart-btn i{

    font-size:8px;

}


/* ==========================================================
   EMPTY MARKET
========================================================== */

.empty-market{

    width:100%;

    min-height:250px;

    display:flex;

    align-items:center;

    justify-content:center;

    padding:30px 18px;

    background:#ffffff;

    border:1px solid var(--line);

    border-radius:12px;

    text-align:center;

}


.empty-inner{

    max-width:380px;

}


.empty-icon{

    width:58px;

    height:58px;

    margin:0 auto 12px;

    display:flex;

    align-items:center;

    justify-content:center;

    border-radius:17px;

    background:var(--green-soft);

    color:var(--green);

    font-size:21px;

}


.empty-market h3{

    margin:0;

    color:#27382d;

    font-size:15px;

    font-weight:900;

}


.empty-market p{

    margin:7px auto 0;

    color:#7a877f;

    font-size:10px;

    font-weight:600;

    line-height:1.5;

}


.empty-action{

    display:inline-flex;

    align-items:center;

    justify-content:center;

    gap:6px;

    min-height:34px;

    margin-top:13px;

    padding:0 13px;

    border-radius:7px;

    background:var(--green);

    color:#ffffff;

    text-decoration:none;

    font-size:8px;

    font-weight:900;

}


/* ==========================================================
   QUANTITY MODAL
========================================================== */

.qty-modal{

    overflow:hidden;

    border:0;

    border-radius:18px;

    box-shadow:
        0 20px 55px rgba(0,0,0,.2);

}


.qty-header{

    padding:17px;

    background:#f3f8f4;

    border-bottom:1px solid var(--line);

    text-align:center;

}


.qty-icon{

    width:42px;

    height:42px;

    margin:0 auto 8px;

    display:flex;

    align-items:center;

    justify-content:center;

    border-radius:12px;

    background:var(--green);

    color:#ffffff;

    font-size:15px;

}


.qty-product-name{

    margin:0;

    color:var(--green);

    font-size:15px;

    font-weight:900;

}


.qty-available{

    margin:4px 0 0;

    color:#7b8981;

    font-size:10px;

}


.qty-available strong{

    color:#34483b;

}


.qty-body{

    padding:19px 17px 16px;

}


.qty-selector{

    display:flex;

    align-items:center;

    justify-content:center;

    gap:22px;

    margin-bottom:19px;

}


.qty-control{

    width:43px;

    height:43px;

    display:flex;

    align-items:center;

    justify-content:center;

    padding:0;

    border:2px solid var(--green);

    border-radius:50%;

    background:#ffffff;

    color:var(--green);

    font-size:19px;

    font-weight:900;

    cursor:pointer;

}


.qty-control:hover{

    background:var(--green);

    color:#ffffff;

}


.qty-number{

    min-width:45px;

    color:var(--green);

    font-size:30px;

    font-weight:900;

    text-align:center;

}


.qty-confirm{

    height:44px;

    min-height:44px;

    font-size:10px;

}


.qty-cancel{

    display:block;

    width:100%;

    margin-top:5px;

    color:#7c8982 !important;

    font-size:10px;

    font-weight:800;

    text-decoration:none !important;

}


/* ==========================================================
   CART SIDEBAR
========================================================== */

.cart-sidebar{

    width:min(400px,94vw) !important;

    border-left:1px solid var(--line) !important;

    box-shadow:
        -15px 0 45px rgba(0,0,0,.12);

}


.cart-header{

    display:flex;

    align-items:center;

    justify-content:space-between;

    gap:10px;

    padding:14px;

    background:#f2f8f3;

    border-bottom:1px solid var(--line);

}


.cart-heading{

    display:flex;

    align-items:center;

    gap:9px;

}


.cart-icon{

    width:38px;

    height:38px;

    display:flex;

    align-items:center;

    justify-content:center;

    border-radius:11px;

    background:var(--green);

    color:#ffffff;

    font-size:14px;

}


.cart-title{

    margin:0;

    color:var(--green);

    font-size:15px;

    font-weight:900;

}


.cart-subtitle{

    margin:2px 0 0;

    color:#7c8981;

    font-size:9px;

}


.cart-body{

    padding:10px !important;

    background:#ffffff;

}


.cart-item{

    display:flex;

    align-items:center;

    gap:8px;

    padding:11px 2px;

    border-bottom:1px solid var(--line-soft);

}


.cart-item:last-child{

    border-bottom:0;

}


.cart-product-info{

    flex:1;

    min-width:0;

}


.cart-product-name{

    display:block;

    color:#243229;

    font-size:11px;

    font-weight:900;

    white-space:nowrap;

    overflow:hidden;

    text-overflow:ellipsis;

}


.cart-product-price{

    display:block;

    margin-top:3px;

    color:#7d8982;

    font-size:9px;

}


.cart-product-price strong{

    color:var(--green);

}


.cart-controls{

    display:flex;

    align-items:center;

    gap:3px;

}


.cart-control{

    width:28px;

    height:28px;

    display:flex;

    align-items:center;

    justify-content:center;

    padding:0;

    border:1px solid #cfddd3;

    border-radius:7px;

    background:#ffffff;

    color:var(--green);

    font-size:14px;

    font-weight:900;

    cursor:pointer;

}


.cart-control:hover{

    background:var(--green-soft);

    border-color:var(--green);

}


.cart-remove{

    color:#b42f2f;

    border-color:#eccccc;

    background:#fff8f8;

}


.cart-qty{

    min-width:18px;

    color:#26352c;

    font-weight:900;

    text-align:center;

}


/* ==========================================================
   EMPTY CART
========================================================== */

.empty-cart{

    min-height:260px;

    display:flex;

    flex-direction:column;

    align-items:center;

    justify-content:center;

    padding:25px;

    text-align:center;

}


.empty-cart-icon{

    width:65px;

    height:65px;

    margin-bottom:12px;

    display:flex;

    align-items:center;

    justify-content:center;

    border-radius:20px;

    background:#f0f5f1;

    color:#8a9b91;

    font-size:21px;

}


.empty-cart strong{

    color:#405148;

    font-size:12px;

    font-weight:900;

}


.empty-cart span{

    margin-top:4px;

    color:#87928c;

    font-size:9px;

}


/* ==========================================================
   CART FOOTER
========================================================== */

.cart-footer{

    padding:13px;

    background:#f5f9f6;

    border-top:1px solid var(--line);

}


.cart-total{

    display:flex;

    align-items:center;

    justify-content:space-between;

    margin-bottom:10px;

    color:#68766e;

    font-size:10px;

    font-weight:800;

}


.cart-total strong{

    color:var(--green);

    font-size:15px;

    font-weight:900;

}


.checkout-btn{

    height:43px;

    min-height:43px;

}


/* ==========================================================
   TABLET
========================================================== */

@media (min-width:600px){

    .market-hero-inner{

        padding-left:22px;

        padding-right:22px;

    }


    .market-main{

        padding-left:20px;

        padding-right:20px;

    }


    .product-grid{

        grid-template-columns:
            repeat(3,minmax(0,1fr));

        gap:11px;

    }


    .product-name{

        font-size:12px;

    }


    .product-price{

        font-size:14px;

    }

}


/* ==========================================================
   DESKTOP
========================================================== */

@media (min-width:850px){

    .market-hero-inner{

        padding:
            22px
            28px
            18px;

    }


    .market-main{

        padding:
            20px
            28px
            0;

    }


    .product-grid{

        grid-template-columns:
            repeat(4,minmax(0,1fr));

        gap:13px;

    }


    .product-details{

        padding:10px;

    }


    .product-category{

        font-size:8px;

    }


    .product-name{

        font-size:13px;

        line-height:17px;

    }


    .product-price{

        font-size:15px;

    }


    .add-to-cart-btn{

        min-height:31px;

        height:31px;

        font-size:8px;

    }

}


/* ==========================================================
   LARGE DESKTOP
========================================================== */

@media (min-width:1100px){

    .market-hero-inner{

        padding-left:30px;

        padding-right:30px;

    }


    .market-main{

        padding-left:30px;

        padding-right:30px;

    }


    .product-grid{

        grid-template-columns:
            repeat(5,minmax(0,1fr));

        gap:14px;

    }

}


/* ==========================================================
   VERY SMALL PHONES
========================================================== */

@media (max-width:360px){

    .market-hero-inner{

        padding-left:10px;

        padding-right:10px;

    }


    .market-main{

        padding-left:8px;

        padding-right:8px;

    }


    .product-grid{

        gap:7px;

    }


    .product-details{

        padding:7px;

    }


    .product-name{

        font-size:10px;

        line-height:14px;

    }


    .product-price{

        font-size:12px;

    }


    .add-to-cart-btn{

        min-height:27px;

        height:27px;

        font-size:6.5px;

    }

}


/* ==========================================================
   ACCESSIBILITY
========================================================== */

button:focus-visible,
a:focus-visible{

    outline:3px solid rgba(11,90,42,.23);

    outline-offset:2px;

}


@media(prefers-reduced-motion:reduce){

    *,
    *::before,
    *::after{

        scroll-behavior:auto !important;

        transition:none !important;

        animation:none !important;

    }

}

</style>


<div class="marketplace">


    <!-- ======================================================
         MARKET HEADER
    ====================================================== -->

    <section class="market-hero">

        <div class="market-hero-inner">

            <div class="market-title-row">

                <div class="market-heading">

                    <div class="market-eyebrow">

                        <i class="fas fa-store"></i>

                        Marketplace

                    </div>


                    <h1 class="market-title">

                        Shop our products

                    </h1>


                    <p class="market-description">

                        Browse available products and add what you need.

                    </p>

                </div>


                <button
                    type="button"
                    id="cartBtn"
                    class="market-cart-button"
                    aria-label="Open shopping cart"
                >

                    <i class="fas fa-shopping-cart"></i>

                </button>

            </div>


            <!-- ==================================================
                 SUMMARY
            ================================================== -->

            <div class="market-summary">


                <div class="summary-card">

                    <div class="summary-icon">

                        <i class="fas fa-box-open"></i>

                    </div>


                    <div class="summary-info">

                        <span class="summary-label">
                            Available
                        </span>

                        <span class="summary-value">

                            <%= products.length %>

                            <%= products.length === 1
                                ? 'Product'
                                : 'Products'
                            %>

                        </span>

                    </div>

                </div>


                <div class="summary-card">

                    <div class="summary-icon">

                        <i class="fas fa-shopping-basket"></i>

                    </div>


                    <div class="summary-info">

                        <span class="summary-label">
                            In Cart
                        </span>

                        <span
                            class="summary-value"
                            id="cartCount"
                        >

                            <%= cartCount || 0 %>

                            <%= (cartCount || 0) === 1
                                ? 'Item'
                                : 'Items'
                            %>

                        </span>

                    </div>

                </div>


                <div class="summary-card">

                    <div class="summary-icon">

                        <i class="fas fa-coins"></i>

                    </div>


                    <div class="summary-info">

                        <span class="summary-label">
                            Cart Value
                        </span>

                        <span
                            class="summary-value"
                            id="cartTotalText"
                        >

                            KES

                            <%= Number(
                                cartTotal || 0
                            ).toLocaleString() %>

                        </span>

                    </div>

                </div>


            </div>

        </div>

    </section>



    <!-- ======================================================
         MAIN
    ====================================================== -->

    <main class="market-main">


        <!-- ==================================================
             CATEGORIES
        ================================================== -->

        <section class="category-section">


            <div class="section-heading">

                <div class="section-heading-left">

                    <i class="fas fa-layer-group"></i>

                    <h2 class="section-heading-title">
                        Categories
                    </h2>

                </div>

            </div>


            <nav
                class="category-bar"
                aria-label="Product categories"
            >


                <a
                    href="/products?category=all"
                    class="category-pill
                        <%= activeCategory === 'all'
                            ? 'active'
                            : '' %>"
                >

                    All

                </a>


                <% (categories || []).forEach(category => { %>


                    <a
                        href="/products?category=<%= encodeURIComponent(category) %>"
                        class="category-pill
                            <%= activeCategory === category
                                ? 'active'
                                : '' %>"
                    >

                        <%= category %>

                    </a>


                <% }) %>


            </nav>

        </section>



        <!-- ==================================================
             PRODUCTS
        ================================================== -->

        <section>


            <% if(!products || !products.length){ %>


                <div class="empty-market">

                    <div class="empty-inner">


                        <div class="empty-icon">

                            <i class="fas fa-store-slash"></i>

                        </div>


                        <h3>

                            Nothing available here yet

                        </h3>


                        <p>


                            <% if(
                                activeCategory &&
                                activeCategory !== 'all'
                            ){ %>

                                We don't currently have any
                                products in the
                                <strong>
                                    <%= activeCategory %>
                                </strong>
                                category.


                            <% } else { %>

                                There are currently no products
                                available in the marketplace.
                                Please check again later.


                            <% } %>


                        </p>


                        <% if(
                            activeCategory &&
                            activeCategory !== 'all'
                        ){ %>


                            <a
                                href="/products?category=all"
                                class="empty-action"
                            >

                                <i class="fas fa-store"></i>

                                VIEW ALL PRODUCTS

                            </a>


                        <% } %>


                    </div>

                </div>


            <% } else { %>


                <!-- ==========================================
                     PRODUCTS HEADER
                =========================================== -->

                <div class="products-heading">


                    <div class="section-heading-left">

                        <i class="fas fa-boxes-stacked"></i>

                        <h2 class="section-heading-title">

                            Products

                        </h2>

                    </div>


                    <div class="products-count">

                        Showing

                        <strong>
                            <%= products.length %>
                        </strong>

                        available

                    </div>


                </div>



                <!-- ==========================================
                     PRODUCT CATALOGUE
                =========================================== -->

                <div class="product-grid">


                    <% products.forEach(product => { %>


                        <%
                            const stock =
                                Number(product.units || 0);

                            let stockClass = '';

                            if(stock <= 0){

                                stockClass =
                                    'stock-out';

                            }
                            else if(stock <= 5){

                                stockClass =
                                    'stock-low';

                            }
                        %>


                        <article
                            class="product-card"
                            data-product-id="<%= product._id %>"
                        >


                            <!-- =================================
                                 PRODUCT IMAGE
                            ================================== -->

                            <div class="product-image">


                                <span
                                    class="stock-badge <%= stockClass %>"
                                >

                                    <span class="stock-dot"></span>


                                    <% if(stock <= 0){ %>

                                        Out of stock

                                    <% } else if(stock <= 5){ %>

                                        Only <%= stock %> left

                                    <% } else { %>

                                        <%= stock %> available

                                    <% } %>


                                </span>


                                <img
                                    src="<%= product.image || '/images/no-image.png' %>"
                                    alt="<%= product.name %>"
                                    loading="lazy"
                                    onerror="this.src='/images/no-image.png';"
                                >

                            </div>



                            <!-- =================================
                                 DETAILS
                            ================================== -->

                            <div class="product-details">


                                <p class="product-category">

                                    <%= product.category || 'General' %>

                                </p>


                                <h3 class="product-name">

                                    <%= product.name %>

                                </h3>


                                <div class="product-price">

                                    <span class="currency">
                                        KES
                                    </span>

                                    <%= Number(
                                        product.unitSellPrice || 0
                                    ).toLocaleString() %>

                                </div>


                                <button
                                    type="button"
                                    class="add-to-cart-btn"
                                    data-id="<%= product._id %>"
                                    data-name="<%= product.name %>"
                                    data-stock="<%= stock %>"
                                    <%= stock <= 0
                                        ? 'disabled'
                                        : '' %>
                                >

                                    <i class="fas
                                        <%= stock <= 0
                                            ? 'fa-ban'
                                            : 'fa-cart-plus' %>"
                                    ></i>


                                    <%= stock <= 0
                                        ? 'OUT OF STOCK'
                                        : 'ADD TO CART' %>

                                </button>


                            </div>


                        </article>


                    <% }) %>


                </div>


            <% } %>


        </section>


    </main>


</div>



<!-- ==========================================================
     QUANTITY MODAL
========================================================== -->

<div
    class="modal fade"
    id="qtyModal"
    tabindex="-1"
    aria-hidden="true"
>

    <div class="modal-dialog modal-dialog-centered modal-sm">

        <div class="modal-content qty-modal">


            <div class="qty-header">

                <div class="qty-icon">

                    <i class="fas fa-cart-plus"></i>

                </div>


                <h3
                    class="qty-product-name"
                    id="qtyProductName"
                ></h3>


                <p class="qty-available">

                    Available:

                    <strong id="qtyAvailable">
                        0
                    </strong>

                </p>

            </div>


            <div class="qty-body">


                <div class="qty-selector">


                    <button
                        type="button"
                        class="qty-control"
                        id="qtyMinus"
                        aria-label="Decrease quantity"
                    >
                        −
                    </button>


                    <span
                        id="qtyValue"
                        class="qty-number"
                    >
                        1
                    </span>


                    <button
                        type="button"
                        class="qty-control"
                        id="qtyPlus"
                        aria-label="Increase quantity"
                    >
                        +
                    </button>


                </div>


                <button
                    type="button"
                    class="add-to-cart-btn qty-confirm"
                    id="qtyConfirm"
                >

                    <i class="fas fa-cart-plus"></i>

                    ADD

                    <span id="qtyConfirmCount">
                        1
                    </span>

                    TO CART

                </button>


                <button
                    type="button"
                    class="btn btn-link qty-cancel"
                    data-bs-dismiss="modal"
                >

                    Cancel

                </button>


            </div>

        </div>

    </div>

</div>



<!-- ==========================================================
     CART SIDEBAR
========================================================== -->

<div
    class="offcanvas offcanvas-end cart-sidebar"
    tabindex="-1"
    id="cartSidebar"
    aria-labelledby="cartSidebarLabel"
>


    <div class="cart-header">


        <div class="cart-heading">


            <div class="cart-icon">

                <i class="fas fa-shopping-basket"></i>

            </div>


            <div>

                <h5
                    class="cart-title"
                    id="cartSidebarLabel"
                >

                    Your Cart

                </h5>


                <p class="cart-subtitle">

                    Review your selected products

                </p>

            </div>


        </div>


        <button
            type="button"
            class="btn-close"
            data-bs-dismiss="offcanvas"
            aria-label="Close"
        ></button>


    </div>



    <div class="offcanvas-body cart-body">


        <% if(cart && cart.length){ %>


            <% cart.forEach(item => { %>


                <div
                    class="cart-item"
                    data-id="<%= item.productId %>"
                >


                    <div class="cart-product-info">


                        <span class="cart-product-name">

                            <%= item.name %>

                        </span>


                        <span class="cart-product-price">

                            KES

                            <strong>

                                <%= Number(
                                    item.price || 0
                                ).toLocaleString() %>

                            </strong>

                            ×

                            <span class="cart-qty">

                                <%= item.qty %>

                            </span>

                        </span>


                    </div>


                    <div class="cart-controls">


                        <button
                            type="button"
                            class="cart-control cart-minus"
                            data-id="<%= item.productId %>"
                            aria-label="Decrease quantity"
                        >
                            −
                        </button>


                        <button
                            type="button"
                            class="cart-control cart-plus"
                            data-id="<%= item.productId %>"
                            aria-label="Increase quantity"
                        >
                            +
                        </button>


                        <button
                            type="button"
                            class="cart-control cart-remove"
                            data-id="<%= item.productId %>"
                            aria-label="Remove product"
                        >
                            ×
                        </button>


                    </div>


                </div>


            <% }) %>


        <% } else { %>


            <div class="empty-cart">


                <div class="empty-cart-icon">

                    <i class="fas fa-shopping-basket"></i>

                </div>


                <strong>

                    Your cart is empty

                </strong>


                <span>

                    Products you add will appear here.

                </span>


            </div>


        <% } %>


    </div>



    <div class="cart-footer">


        <div class="cart-total">

            <span>
                Cart total
            </span>


            <strong>

                KES

                <%= Number(
                    cartTotal || 0
                ).toLocaleString() %>

            </strong>

        </div>


        <% if(cart && cart.length){ %>


            <button
                type="button"
                class="add-to-cart-btn checkout-btn"
                id="checkoutBtn"
            >

                <i class="fas fa-box"></i>

                PACKAGE ORDER

            </button>


        <% } %>


    </div>


</div>



<script>

document.addEventListener('DOMContentLoaded', () => {


    const qtyModalElement =
        document.getElementById('qtyModal');

    const cartSidebarElement =
        document.getElementById('cartSidebar');


    const qtyModal =
        new bootstrap.Modal(qtyModalElement);

    const cartSidebar =
        new bootstrap.Offcanvas(cartSidebarElement);



    let selected = {

        id:null,

        name:'',

        stock:0,

        qty:1

    };



    /* ======================================================
       PRODUCT CARD NAVIGATION
    ====================================================== */

    document
        .querySelectorAll('.product-card')
        .forEach(card => {

            card.addEventListener(
                'click',
                event => {

                    if(
                        event.target.closest(
                            '.add-to-cart-btn'
                        )
                    ){

                        return;

                    }


                    const productId =
                        card.dataset.productId;


                    if(productId){

                        window.location.href =
                            '/products/' +
                            productId;

                    }

                }
            );

        });



    /* ======================================================
       ADD TO CART
    ====================================================== */

    document
        .querySelectorAll('.add-to-cart-btn')
        .forEach(button => {


            if(
                button.id === 'qtyConfirm' ||
                button.id === 'checkoutBtn'
            ){

                return;

            }


            button.addEventListener(
                'click',
                event => {

                    event.preventDefault();

                    event.stopPropagation();


                    selected.id =
                        button.dataset.id;

                    selected.name =
                        button.dataset.name;

                    selected.stock =
                        parseInt(
                            button.dataset.stock,
                            10
                        ) || 0;

                    selected.qty = 1;


                    document
                        .getElementById(
                            'qtyProductName'
                        )
                        .innerText =
                            selected.name;


                    document
                        .getElementById(
                            'qtyAvailable'
                        )
                        .innerText =
                            selected.stock;


                    updateQuantityDisplay();


                    qtyModal.show();

                }
            );

        });



    /* ======================================================
       QUANTITY DISPLAY
    ====================================================== */

    function updateQuantityDisplay(){

        document
            .getElementById('qtyValue')
            .innerText =
                selected.qty;


        document
            .getElementById('qtyConfirmCount')
            .innerText =
                selected.qty;

    }



    /* ======================================================
       PLUS
    ====================================================== */

    document
        .getElementById('qtyPlus')
        .addEventListener(
            'click',
            () => {

                if(
                    selected.qty <
                    selected.stock
                ){

                    selected.qty++;

                    updateQuantityDisplay();

                }

            }
        );



    /* ======================================================
       MINUS
    ====================================================== */

    document
        .getElementById('qtyMinus')
        .addEventListener(
            'click',
            () => {

                if(
                    selected.qty > 1
                ){

                    selected.qty--;

                    updateQuantityDisplay();

                }

            }
        );



    /* ======================================================
       CONFIRM ADD
    ====================================================== */

    document
        .getElementById('qtyConfirm')
        .addEventListener(
            'click',
            async () => {

                const button =
                    document.getElementById(
                        'qtyConfirm'
                    );


                button.disabled = true;


                try{

                    const response =
                        await fetch(
                            '/products/add-to-cart',
                            {
                                method:'POST',

                                headers:{
                                    'Content-Type':
                                        'application/json'
                                },

                                body:JSON.stringify({

                                    productId:
                                        selected.id,

                                    qty:
                                        selected.qty

                                })
                            }
                        );


                    const data =
                        await response.json();


                    if(!data.success){

                        alert(
                            data.message ||
                            'Unable to add product to cart.'
                        );


                        button.disabled = false;

                        return;

                    }


                    qtyModal.hide();

                    location.reload();

                }
                catch(error){

                    console.error(error);


                    alert(
                        'Unable to connect to the server.'
                    );


                    button.disabled = false;

                }

            }
        );



    /* ======================================================
       OPEN CART
    ====================================================== */

    document
        .getElementById('cartBtn')
        .addEventListener(
            'click',
            () => {

                cartSidebar.show();

            }
        );



    /* ======================================================
       CART REQUEST
    ====================================================== */

    async function callCart(
        url,
        body
    ){

        try{

            const response =
                await fetch(
                    url,
                    {
                        method:'POST',

                        headers:{
                            'Content-Type':
                                'application/json'
                        },

                        body:
                            JSON.stringify(body)
                    }
                );


            const data =
                await response.json();


            if(!data.success){

                alert(
                    data.message ||
                    'Cart update failed.'
                );

                return false;

            }


            location.reload();

            return true;

        }
        catch(error){

            console.error(error);


            alert(
                'Unable to connect to the server.'
            );


            return false;

        }

    }



    /* ======================================================
       CART PLUS
    ====================================================== */

    document
        .querySelectorAll('.cart-plus')
        .forEach(button => {

            button.addEventListener(
                'click',
                () => {

                    const id =
                        button.dataset.id;


                    const quantityElement =
                        document.querySelector(
                            `.cart-item[data-id="${id}"] .cart-qty`
                        );


                    if(!quantityElement){

                        return;

                    }


                    const currentQuantity =
                        parseInt(
                            quantityElement.innerText,
                            10
                        ) || 0;


                    callCart(
                        '/products/update-cart-qty',
                        {
                            productId:id,

                            qty:
                                currentQuantity + 1
                        }
                    );

                }
            );

        });



    /* ======================================================
       CART MINUS
    ====================================================== */

    document
        .querySelectorAll('.cart-minus')
        .forEach(button => {

            button.addEventListener(
                'click',
                () => {

                    const id =
                        button.dataset.id;


                    const quantityElement =
                        document.querySelector(
                            `.cart-item[data-id="${id}"] .cart-qty`
                        );


                    if(!quantityElement){

                        return;

                    }


                    const currentQuantity =
                        parseInt(
                            quantityElement.innerText,
                            10
                        ) || 0;


                    if(currentQuantity <= 1){

                        callCart(
                            '/products/remove-from-cart',
                            {
                                productId:id
                            }
                        );

                        return;

                    }


                    callCart(
                        '/products/update-cart-qty',
                        {
                            productId:id,

                            qty:
                                currentQuantity - 1
                        }
                    );

                }
            );

        });



    /* ======================================================
       REMOVE
    ====================================================== */

    document
        .querySelectorAll('.cart-remove')
        .forEach(button => {

            button.addEventListener(
                'click',
                () => {

                    callCart(
                        '/products/remove-from-cart',
                        {
                            productId:
                                button.dataset.id
                        }
                    );

                }
            );

        });



    /* ======================================================
       PACKAGE ORDER
    ====================================================== */

    const checkoutButton =
        document.getElementById(
            'checkoutBtn'
        );


    if(checkoutButton){

        checkoutButton.addEventListener(
            'click',
            async () => {

                checkoutButton.disabled = true;


                try{

                    const response =
                        await fetch(
                            '/packages/create',
                            {
                                method:'POST',

                                headers:{
                                    'Content-Type':
                                        'application/json'
                                },

                                body:
                                    JSON.stringify({})
                            }
                        );


                    const data =
                        await response.json();


                    if(
                        data.success &&
                        data.packageId
                    ){

                        window.location.href =
                            '/packages/' +
                            data.packageId;

                        return;

                    }


                    alert(
                        data.message ||
                        'Unable to create package order.'
                    );


                    checkoutButton.disabled = false;

                }
                catch(error){

                    console.error(error);


                    alert(
                        'Unable to connect to the server.'
                    );


                    checkoutButton.disabled = false;

                }

            }
        );

    }


});

</script>