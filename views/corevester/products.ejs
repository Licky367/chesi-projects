<%- contentFor('body') %>

<style>

/* =========================================================
   MARKETPLACE — COMPLETE UI
   ========================================================= */

.market-wrap{
    --green:#0a4d1e;
    --green-dark:#063914;
    --green-mid:#147334;
    --green-soft:#edf7ef;
    --green-pale:#f6fbf7;

    --orange:#e68a1b;
    --orange-soft:#fff4e4;

    --ink:#18231c;
    --muted:#718078;
    --line:#e2eae4;

    min-height:100vh;

    padding-bottom:45px;

    background:
        radial-gradient(
            circle at 0 0,
            rgba(10,77,30,.06),
            transparent 30%
        ),
        #f5f8f6;

    color:var(--ink);
}


/* =========================================================
   MAIN CONTAINER
   ========================================================= */

.market-container{
    width:100%;
    max-width:1450px;

    margin:0 auto;
}


/* =========================================================
   HEADER
   ========================================================= */

.market-top{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:18px;

    padding:22px 18px 16px;
}

.market-heading{
    min-width:0;
}

.market-title{
    display:flex;
    align-items:center;
    gap:10px;

    margin:0;

    color:var(--green-dark);

    font-size:1.65rem;
    line-height:1.1;
    font-weight:950;
    letter-spacing:-.7px;
}

.market-title-icon{
    display:flex;
    align-items:center;
    justify-content:center;

    width:38px;
    height:38px;

    flex:0 0 38px;

    background:var(--green);
    color:#fff;

    border-radius:12px;

    box-shadow:
        0 6px 16px rgba(10,77,30,.15);
}

.market-sub{
    margin:7px 0 0 48px;

    color:var(--muted);

    font-size:.73rem;
    font-weight:650;
}


/* =========================================================
   CART ICON
   ========================================================= */

.market-cart-button{
    position:relative;

    display:flex;
    align-items:center;
    justify-content:center;

    width:48px;
    height:48px;

    flex:0 0 48px;

    background:#fff;
    color:var(--green);

    border:1px solid #d8e4da;
    border-radius:15px;

    cursor:pointer;

    box-shadow:
        0 5px 15px rgba(22,55,32,.07);

    transition:
        transform .18s ease,
        background .18s ease,
        color .18s ease,
        box-shadow .18s ease;
}

.market-cart-button:hover{
    background:var(--green);
    color:#fff;

    transform:translateY(-2px);

    box-shadow:
        0 9px 20px rgba(10,77,30,.16);
}

.market-cart-button:active{
    transform:scale(.95);
}

.market-cart-button i{
    font-size:1.05rem;
}

.cart-badge{
    position:absolute;

    top:-5px;
    right:-5px;

    display:flex;
    align-items:center;
    justify-content:center;

    min-width:21px;
    height:21px;

    padding:0 5px;

    background:var(--orange);
    color:#fff;

    border:3px solid #f5f8f6;
    border-radius:50px;

    font-size:.57rem;
    font-weight:950;

    box-shadow:
        0 3px 8px rgba(230,138,27,.25);
}


/* =========================================================
   TOP SUMMARY CARDS
   ========================================================= */

.market-summary{
    display:grid;

    grid-template-columns:
        repeat(3,minmax(0,1fr));

    gap:10px;

    padding:0 14px 18px;
}

.summary-card{
    position:relative;

    display:flex;
    align-items:center;

    min-width:0;
    min-height:82px;

    padding:12px;

    overflow:hidden;

    background:#fff;

    border:1px solid var(--line);
    border-radius:17px;

    box-shadow:
        0 5px 17px rgba(23,57,34,.055);
}

.summary-card::after{
    content:"";

    position:absolute;

    width:70px;
    height:70px;

    right:-25px;
    bottom:-28px;

    border-radius:50%;

    background:rgba(10,77,30,.035);
}

.summary-icon{
    display:flex;
    align-items:center;
    justify-content:center;

    width:38px;
    height:38px;

    flex:0 0 38px;

    margin-right:9px;

    border-radius:11px;

    font-size:.88rem;
}

.summary-products .summary-icon{
    background:var(--green-soft);
    color:var(--green);
}

.summary-cart .summary-icon{
    background:var(--orange-soft);
    color:var(--orange);
}

.summary-money .summary-icon{
    background:#eef3f0;
    color:#496154;
}

.summary-content{
    min-width:0;
}

.summary-value{
    display:block;

    color:var(--green-dark);

    font-size:1.12rem;
    line-height:1.05;
    font-weight:950;

    white-space:nowrap;
    overflow:hidden;
    text-overflow:ellipsis;
}

.summary-cart .summary-value{
    color:#b86b0b;
}

.summary-money .summary-value{
    color:#26392d;

    font-size:.96rem;
}

.summary-label{
    display:block;

    margin-top:4px;

    color:#7d8b82;

    font-size:.57rem;
    line-height:1.15;
    font-weight:800;

    text-transform:uppercase;
    letter-spacing:.35px;
}


/* =========================================================
   CATEGORY NAVIGATION
   ========================================================= */

.category-shell{
    background:#fff;

    border-top:1px solid #e5ebe7;
    border-bottom:1px solid #e1e9e3;
}

.category-bar{
    display:flex;
    gap:7px;

    overflow-x:auto;

    padding:11px 14px;

    scrollbar-width:none;
    -webkit-overflow-scrolling:touch;
}

.category-bar::-webkit-scrollbar{
    display:none;
}

.cat-pill{
    display:inline-flex;
    align-items:center;
    justify-content:center;

    flex:0 0 auto;

    min-height:35px;

    padding:0 15px;

    background:#fff;
    color:#596a60;

    border:1px solid #dce6df;
    border-radius:50px;

    text-decoration:none;

    font-size:.65rem;
    font-weight:850;

    transition:
        background .16s ease,
        border-color .16s ease,
        color .16s ease,
        transform .16s ease;
}

.cat-pill:hover{
    background:var(--green-pale);
    border-color:#bcd1c1;
    color:var(--green);
}

.cat-pill.active{
    background:var(--green);
    color:#fff;

    border-color:var(--green);

    box-shadow:
        0 5px 13px rgba(10,77,30,.15);
}


/* =========================================================
   PRODUCTS HEADER
   ========================================================= */

.products-heading{
    display:flex;
    align-items:flex-end;
    justify-content:space-between;

    padding:21px 15px 13px;
}

.products-heading-left h2{
    margin:0;

    color:#203127;

    font-size:.98rem;
    font-weight:950;
    letter-spacing:-.2px;
}

.products-heading-left p{
    margin:4px 0 0;

    color:#829087;

    font-size:.66rem;
}

.products-count{
    color:#7b8981;

    font-size:.63rem;
    font-weight:800;
}


/* =========================================================
   PRODUCT GRID
   ========================================================= */

.grid-wrap{
    display:grid;

    grid-template-columns:
        repeat(2,minmax(0,1fr));

    gap:11px;

    padding:0 12px;
}

@media(min-width:600px){

    .grid-wrap{
        grid-template-columns:
            repeat(3,minmax(0,1fr));

        gap:15px;

        padding:0 17px;
    }

}

@media(min-width:900px){

    .grid-wrap{
        grid-template-columns:
            repeat(4,minmax(0,1fr));

        gap:17px;

        padding:0 22px;
    }

}

@media(min-width:1200px){

    .grid-wrap{
        grid-template-columns:
            repeat(5,minmax(0,1fr));

        gap:19px;

        padding:0 28px;
    }

}


/* =========================================================
   HORIZONTAL COLLECTION
   ========================================================= */

.prod-scroll{
    display:flex;
    gap:12px;

    overflow-x:auto;

    padding:0 12px 18px;

    scroll-snap-type:x mandatory;

    scrollbar-width:none;

    -webkit-overflow-scrolling:touch;
}

.prod-scroll::-webkit-scrollbar{
    display:none;
}

@media(min-width:768px){

    .prod-scroll{
        gap:16px;

        padding-left:22px;
        padding-right:22px;
    }

}


/* =========================================================
   PRODUCT CARD
   ========================================================= */

.card-box{
    position:relative;

    min-width:calc(50% - 6px);
    max-width:calc(50% - 6px);
    flex:0 0 calc(50% - 6px);

    overflow:hidden;

    background:#fff;

    border:1px solid #e0e8e2;
    border-radius:18px;

    cursor:pointer;

    scroll-snap-align:start;

    box-shadow:
        0 4px 14px rgba(20,58,33,.05);

    transition:
        transform .2s ease,
        box-shadow .2s ease,
        border-color .2s ease;
}

.card-box:hover{
    transform:translateY(-4px);

    border-color:#c6d9ca;

    box-shadow:
        0 12px 27px rgba(20,58,33,.10);
}

.grid-wrap .card-box{
    min-width:0;
    max-width:none;
    width:100%;
}

@media(min-width:768px){

    .prod-scroll .card-box{
        min-width:calc(25% - 12px);
        max-width:calc(25% - 12px);
        flex:0 0 calc(25% - 12px);
    }

}


/* =========================================================
   PRODUCT IMAGE
   ========================================================= */

.product-image-wrap{
    position:relative;

    width:100%;

    aspect-ratio:1 / .9;

    overflow:hidden;

    background:#edf4ef;
}

.product-image{
    display:block;

    width:100%;
    height:100%;

    object-fit:cover;

    transition:
        transform .45s cubic-bezier(.2,.7,.2,1);
}

.card-box:hover .product-image{
    transform:scale(1.055);
}

.product-image-wrap::after{
    content:"";

    position:absolute;
    inset:0;

    pointer-events:none;

    background:
        linear-gradient(
            to bottom,
            rgba(0,0,0,.08),
            transparent 32%,
            transparent 72%,
            rgba(0,0,0,.06)
        );
}


/* =========================================================
   STOCK BADGE
   ========================================================= */

.left-badge{
    position:absolute;

    top:9px;
    left:9px;

    z-index:5;

    display:inline-flex;
    align-items:center;
    gap:5px;

    min-height:25px;

    padding:0 8px;

    background:rgba(255,255,255,.95);
    color:var(--green);

    border:1px solid rgba(255,255,255,.75);
    border-radius:50px;

    font-size:.55rem;
    font-weight:900;

    box-shadow:
        0 3px 9px rgba(0,0,0,.10);

    backdrop-filter:blur(7px);
}

.stock-dot{
    width:6px;
    height:6px;

    border-radius:50%;

    background:#23a653;
}

.stock-low .stock-dot{
    background:var(--orange);
}

.stock-out{
    color:#a83232;

    background:#fff7f7;

    border-color:#f1d3d3;
}

.stock-out .stock-dot{
    background:#d74444;
}


/* =========================================================
   PRODUCT BODY
   ========================================================= */

.product-body{
    padding:12px 11px 12px;
}

.cat-label{
    margin-bottom:5px;

    color:#7c9082;

    font-size:.54rem;
    font-weight:900;

    text-transform:uppercase;
    letter-spacing:.6px;
}

.prod-name{
    min-height:35px;

    display:-webkit-box;

    -webkit-line-clamp:2;
    -webkit-box-orient:vertical;

    overflow:hidden;

    color:#1a2820;

    font-size:.82rem;
    line-height:1.3;

    font-weight:850;
}

.prod-price{
    display:flex;
    align-items:baseline;
    gap:3px;

    margin-top:8px;

    color:var(--green);

    font-size:.98rem;
    line-height:1;

    font-weight:950;
}

.price-label{
    color:#819087;

    font-size:.54rem;
    font-weight:800;
}


/* =========================================================
   ADD BUTTON
   ========================================================= */

.add-btn{
    display:flex;
    align-items:center;
    justify-content:center;
    gap:6px;

    width:100%;
    min-height:38px;

    margin-top:11px;

    padding:8px 9px;

    background:var(--green);
    color:#fff;

    border:0;
    border-radius:10px;

    font-size:.61rem;
    font-weight:900;

    cursor:pointer;

    box-shadow:
        0 4px 10px rgba(10,77,30,.10);

    transition:
        background .16s ease,
        transform .16s ease,
        box-shadow .16s ease;
}

.add-btn:hover{
    background:var(--green-dark);

    box-shadow:
        0 6px 14px rgba(10,77,30,.18);
}

.add-btn:active{
    transform:scale(.975);
}

.add-btn:disabled{
    background:#e3e8e4;
    color:#858f89;

    cursor:not-allowed;

    box-shadow:none;
}


/* =========================================================
   BEAUTIFUL EMPTY STATE
   ========================================================= */

.market-empty{
    position:relative;

    max-width:650px;

    margin:28px auto;

    padding:50px 25px 45px;

    overflow:hidden;

    text-align:center;

    background:#fff;

    border:1px solid #e0e9e2;
    border-radius:26px;

    box-shadow:
        0 12px 35px rgba(20,57,33,.065);
}

.market-empty::before{
    content:"";

    position:absolute;

    width:190px;
    height:190px;

    top:-100px;
    left:-75px;

    border-radius:50%;

    background:rgba(10,77,30,.045);
}

.market-empty::after{
    content:"";

    position:absolute;

    width:160px;
    height:160px;

    right:-70px;
    bottom:-90px;

    border-radius:50%;

    background:rgba(230,138,27,.055);
}

.empty-visual{
    position:relative;
    z-index:2;

    display:flex;
    align-items:center;
    justify-content:center;

    width:92px;
    height:92px;

    margin:0 auto 20px;

    background:
        linear-gradient(
            145deg,
            #eef8f0,
            #e4f1e7
        );

    border:8px solid #f7fbf8;

    border-radius:30px;

    color:var(--green);

    font-size:2rem;

    box-shadow:
        0 10px 25px rgba(10,77,30,.08);
}

.empty-visual::before{
    content:"";

    position:absolute;

    width:12px;
    height:12px;

    top:9px;
    right:8px;

    background:var(--orange);

    border:3px solid #eef8f0;

    border-radius:50%;
}

.market-empty h3{
    position:relative;
    z-index:2;

    margin:0;

    color:#213229;

    font-size:1.08rem;
    font-weight:950;
}

.market-empty p{
    position:relative;
    z-index:2;

    max-width:430px;

    margin:8px auto 0;

    color:#7a887f;

    font-size:.74rem;
    line-height:1.6;
}

.empty-action{
    position:relative;
    z-index:2;

    display:inline-flex;
    align-items:center;
    justify-content:center;
    gap:7px;

    margin-top:20px;

    min-height:40px;

    padding:0 18px;

    background:var(--green);
    color:#fff;

    border-radius:11px;

    text-decoration:none;

    font-size:.68rem;
    font-weight:900;

    box-shadow:
        0 6px 15px rgba(10,77,30,.14);

    transition:
        transform .16s ease,
        background .16s ease;
}

.empty-action:hover{
    background:var(--green-dark);
    color:#fff;

    transform:translateY(-2px);
}


/* =========================================================
   QUANTITY MODAL
   ========================================================= */

.qty-modal-content{
    overflow:hidden;

    background:#fff;

    border:0;
    border-radius:23px;

    box-shadow:
        0 25px 70px rgba(12,39,21,.22);
}

.qty-modal-header{
    padding:20px;

    text-align:center;

    background:
        linear-gradient(
            135deg,
            #f0f8f2,
            #fbfdfb
        );

    border-bottom:1px solid #e1eae3;
}

.qty-product-name{
    margin:0;

    color:var(--green-dark);

    font-size:1rem;
    font-weight:950;
}

.qty-available{
    margin:6px 0 0;

    color:#78867e;

    font-size:.71rem;
}

.qty-available strong{
    color:var(--green);
}

.qty-selector{
    display:flex;
    align-items:center;
    justify-content:center;
    gap:24px;

    margin:22px 0 24px;
}

.qty-control{
    display:flex;
    align-items:center;
    justify-content:center;

    width:46px;
    height:46px;

    background:#fff;

    border:1.5px solid #c9d9cd;
    border-radius:50%;

    color:var(--green);

    font-size:1.2rem;
    font-weight:900;

    cursor:pointer;

    transition:
        background .16s ease,
        color .16s ease,
        border-color .16s ease,
        transform .16s ease;
}

.qty-control:hover{
    background:var(--green);
    border-color:var(--green);
    color:#fff;
}

.qty-control:active{
    transform:scale(.91);
}

.qty-number{
    min-width:50px;

    color:var(--green-dark);

    font-size:2.2rem;
    line-height:1;

    font-weight:950;
}

.qty-confirm{
    min-height:47px;
    margin-top:0;

    border-radius:12px;
}

.qty-cancel{
    width:100%;

    margin-top:7px;

    color:#7b8780 !important;

    font-size:.76rem;
    font-weight:750;

    text-decoration:none !important;
}


/* =========================================================
   CART SIDEBAR
   ========================================================= */

.cart-sidebar{
    width:min(430px,94vw) !important;

    background:#fff;

    border-left:1px solid #dce7df !important;

    box-shadow:
        -18px 0 50px rgba(16,46,26,.15);
}

.cart-header{
    display:flex;
    align-items:center;
    justify-content:space-between;

    padding:17px;

    background:
        linear-gradient(
            135deg,
            #f0f8f2,
            #fff
        );

    border-bottom:1px solid #dfe8e2;
}

.cart-title-wrap{
    display:flex;
    align-items:center;
    gap:11px;
}

.cart-title-icon{
    display:flex;
    align-items:center;
    justify-content:center;

    width:42px;
    height:42px;

    background:var(--green);
    color:#fff;

    border-radius:12px;

    box-shadow:
        0 5px 13px rgba(10,77,30,.14);
}

.cart-title{
    margin:0;

    color:var(--green-dark);

    font-size:1rem;
    font-weight:950;
}

.cart-subtitle{
    margin:3px 0 0;

    color:#7b8981;

    font-size:.64rem;
}

.cart-body{
    padding:8px 16px 20px !important;

    background:#fff;
}

.cart-item{
    display:flex;
    align-items:center;
    gap:12px;

    padding:14px 0;

    border-bottom:1px solid #edf1ee !important;
}

.cart-item:last-child{
    border-bottom:0 !important;
}

.cart-product-info{
    min-width:0;
    flex:1;
}

.cart-product-name{
    display:block;

    color:#1d2a22;

    font-size:.81rem;
    line-height:1.3;
    font-weight:850;

    overflow:hidden;
    text-overflow:ellipsis;
}

.cart-product-price{
    display:block;

    margin-top:5px;

    color:#7c8981;

    font-size:.68rem;
}

.cart-qty{
    color:var(--green);
    font-weight:900;
}

.cart-controls{
    display:flex;
    align-items:center;
    gap:5px;
}

.cart-control{
    display:flex;
    align-items:center;
    justify-content:center;

    width:31px;
    height:31px;

    padding:0;

    background:#fff;

    border:1px solid #d2ded5;
    border-radius:8px;

    color:var(--green);

    font-size:.85rem;
    font-weight:900;

    cursor:pointer;

    transition:
        background .15s ease,
        border-color .15s ease,
        transform .15s ease;
}

.cart-control:hover{
    background:var(--green-soft);
    border-color:#aec7b4;
}

.cart-control:active{
    transform:scale(.92);
}

.cart-remove{
    color:#b33434 !important;

    background:#fff7f7 !important;

    border-color:#efd3d3 !important;
}


/* =========================================================
   EMPTY CART
   ========================================================= */

.empty-cart{
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;

    min-height:330px;

    text-align:center;
}

.empty-cart-icon{
    display:flex;
    align-items:center;
    justify-content:center;

    width:76px;
    height:76px;

    margin-bottom:15px;

    background:
        linear-gradient(
            145deg,
            #f0f7f2,
            #e7f1e9
        );

    border-radius:23px;

    color:#8ba092;

    font-size:1.55rem;
}

.empty-cart strong{
    color:#3f5146;

    font-size:.9rem;
    font-weight:900;
}

.empty-cart span{
    margin-top:5px;

    color:#89958e;

    font-size:.7rem;
}


/* =========================================================
   CART FOOTER
   ========================================================= */

.cart-footer{
    padding:16px;

    background:
        linear-gradient(
            to bottom,
            #f8faf8,
            #f1f6f2
        );

    border-top:1px solid #dce7df;

    box-shadow:
        0 -5px 18px rgba(24,60,37,.04);
}

.cart-total{
    display:flex;
    align-items:center;
    justify-content:space-between;

    margin-bottom:12px;

    color:#59685f;

    font-size:.78rem;
    font-weight:800;
}

.cart-total strong{
    color:var(--green-dark);

    font-size:1.08rem;
    font-weight:950;
}

.checkout-btn{
    min-height:47px;

    margin-top:0;

    border-radius:12px;
}


/* =========================================================
   MOBILE
   ========================================================= */

@media(max-width:575px){

    .market-top{
        padding:17px 13px 13px;
    }

    .market-title{
        font-size:1.34rem;
    }

    .market-title-icon{
        width:34px;
        height:34px;
        flex-basis:34px;

        border-radius:10px;

        font-size:.82rem;
    }

    .market-sub{
