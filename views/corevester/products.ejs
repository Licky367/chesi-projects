    --green-dark:
        #146c43;

    --green-soft:
        #edf7f0;

    --orange:
        #e58a22;

    --orange-soft:
        #fff5e8;

    --ink:
        #202520;

    --muted:
        #7b847e;

    --line:
        #e4e9e6;

    width:
        100%;

    min-height:
        100vh;

    margin:
        0;

    padding:
        0
        0
        30px;

    background:
        #f7faf8;

    color:
        var(--ink);

    box-sizing:
        border-box;

}


.marketplace *,
.marketplace *::before,
.marketplace *::after {

    box-sizing:
        border-box;

}



/* ==========================================================
   HEADER
========================================================== */

.market-hero {

    width:
        100%;

    padding:
        18px
        14px
        15px;

    background:
        linear-gradient(
            135deg,
            #ffffff,
            #f4faf5
        );

    border-bottom:
        1px solid
        #dce8df;

}


.market-hero-inner {

    width:
        100%;

    max-width:
        1180px;

    margin:
        0
        auto;

}



/* ==========================================================
   TITLE ROW
========================================================== */

.market-title-row {

    display:
        flex;

    align-items:
        center;

    justify-content:
        space-between;

    gap:
        15px;

}


.market-heading {

    min-width:
        0;

}


.market-eyebrow {

    display:
        flex;

    align-items:
        center;

    gap:
        6px;

    margin-bottom:
        4px;

    color:
        #6d8174;

    font-size:
        .58rem;

    font-weight:
        900;

    text-transform:
        uppercase;

    letter-spacing:
        1.2px;

}


.market-eyebrow i {

    color:
        var(--green);

}


.market-title {

    margin:
        0;

    color:
        #14532d;

    font-size:
        1.35rem;

    font-weight:
        950;

    line-height:
        1.05;

}


.market-description {

    margin:
        5px
        0
        0;

    color:
        var(--muted);

    font-size:
        .66rem;

    font-weight:
        600;

    line-height:
        1.4;

}



/* ==========================================================
   CART BUTTON
========================================================== */

.market-cart-button {

    flex:
        0 0
        48px;

    width:
        48px;

    height:
        42px;

    display:
        flex;

    align-items:
        center;

    justify-content:
        center;

    border:
        0;

    border-radius:
        12px;

    background:
        var(--green);

    color:
        #fff;

    cursor:
        pointer;

    box-shadow:
        0 5px 13px
