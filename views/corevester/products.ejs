<style>
.core-page{width:100%;max-width:100vw;overflow-x:hidden;background:#f8fdf6;font-family:"Segoe UI",sans-serif;}
.core-container{width:100%;max-width:1300px;margin:0 auto;padding:16px 12px;box-sizing:border-box;overflow-x:hidden;}
.core-header{margin-bottom:20px;}
.core-header h1{margin:0;color:#0a4d1e;font-size:24px;font-weight:900;}
.core-header p{margin:4px 0 0 0;color:#666;font-size:13px;}

.core-category{width:100%;max-width:100%;margin:0 0 28px 0;overflow:hidden;}
.core-cat-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;gap:8px;}
.core-cat-title{display:flex;align-items:center;gap:8px;min-width:0;}
.core-cat-icon{width:32px;height:32px;display:flex;align-items:center;justify-content:center;background:#e8f5e9;border:1px solid #c5e1a5;border-radius:8px;color:#0a4d1e;font-size:14px;flex-shrink:0;}
.core-cat-title h2{margin:0;color:#0a4d1e;font-size:16px;font-weight:800;text-transform:capitalize;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.core-cat-count{color:#777;font-size:11px;margin-left:4px;}
.core-cat-hint{color:#0a4d1e;font-size:10px;font-weight:700;flex-shrink:0;}

.core-row{width:100%;max-width:100%;display:flex;flex-wrap:nowrap;gap:12px;overflow-x:auto;overflow-y:hidden;padding:2px 2px 12px 2px;scrollbar-width:thin;-webkit-overflow-scrolling:touch;}
.core-row::-webkit-scrollbar{height:4px;}
.core-row::-webkit-scrollbar-thumb{background:#a5d6a7;border-radius:10px;}

.core-card{flex:0 0 170px;width:170px;min-width:170px;max-width:170px;background:#fff;border:1px solid #e8f5e9;border-radius:12px;overflow:hidden;display:flex;flex-direction:column;box-shadow:0 1px 6px rgba(0,0,0,0.04);cursor:pointer;}
.core-img-box{width:100%;height:110px;min-height:110px;max-height:110px;background:#f6fbf6;display:flex;align-items:center;justify-content:center;overflow:hidden;position:relative;flex-shrink:0;}
.core-img-box img{width:100%;height:100%;object-fit:contain;object-position:center;display:block;max-width:100%;max-height:100%;}
.core-no-img{width:100%;height:100%;display:flex;align-items:center;justify-content:center;color:#a5d6a7;font-size:28px;}
.core-stock{position:absolute;top:6px;left:6px;background:#fff;border:1px solid #0a4d1e;color:#0a4d1e;font-size:9px;font-weight:800;padding:2px 6px;border-radius:20px;z-index:2;}
.core-stock.empty{border-color:#c62828;color:#c62828;}
.core-info{padding:10px;flex:1;display:flex;flex-direction:column;}
.core-cat-label{margin:0;color:#2e7d32;font-size:9px;font-weight:800;text-transform:uppercase;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.core-name{margin:3px 0 0 0;color:#111;font-size:13px;font-weight:700;line-height:1.25;height:32px;overflow:hidden;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;}
.core-desc{margin:4px 0 0 0;color:#777;font-size:10px;line-height:1.3;height:26px;overflow:hidden;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;}
.core-price-box{margin-top:8px;background:#f9fbe7;border-radius:6px;padding:6px;}
.core-price-label{margin:0;color:#888;font-size:8px;}
.core-price-val{margin:0;color:#0a4d1e;font-size:12px;font-weight:800;}
.core-footer{padding:0 10px 10px 10px;}
.core-btn{width:100%;padding:8px;border:none;border-radius:7px;background:#0a4d1e;color:#fff;font-size:10px;font-weight:800;cursor:pointer;}
.core-btn:disabled{background:#eee;color:#999;}

@media(min-width:600px){.core-card{flex-basis:200px;width:200px;min-width:200px;max-width:200px;}.core-img-box{height:125px;min-height:125px;max-height:125px;} }

#qtyOverlay{position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:1200;display:none;align-items:center;justify-content:center;padding:20px;}
#qtyBox{background:#fff;border:3px solid #0a4d1e;border-radius:16px;width:100%;max-width:300px;padding:20px;text-align:center;}
</style>

<div class="core-page">
  <div class="core-container">
    <div class="core-header"><h1>Our Products</h1><p>Quality medical equipment and hospital supplies you can trust.</p></div>

    <%
      const groups={};
      if(Array.isArray(products)){ products.filter(p=>p&&p.isActive!==false).forEach(p=>{
        const c=String(p.category||"other").trim().toLowerCase(); if(!groups[c]) groups[c]=[]; groups[c].push(p);
      });}
      const icons={"medical equipment":"fa-stethoscope","hospital supplies":"fa-kit-medical","surgical":"fa-user-doctor","diagnostics":"fa-microscope","laboratory":"fa-flask","consumables":"fa-boxes-stacked","medicines":"fa-pills","other":"fa-box-open"};
    %>

    <% if(Object.keys(groups).length===0){ %>
      <div style="background:#fff;border-top:4px solid #0a4d1e;border-radius:16px;padding:40px 20px;text-align:center;"><i class="fas fa-box-open" style="font-size:30px;color:#0a4d1e;"></i><h3 style="color:#0a4d1e;">No Products</h3></div>
    <% } else { %>
      <% Object.keys(groups).forEach(cat=>{
        const list=groups[cat]; const icon=icons[cat]||"fa-boxes-stacked";
      %>
        <div class="core-category">
          <div class="core-cat-head">
            <div class="core-cat-title"><div class="core-cat-icon"><i class="fas <%= icon %>"></i></div><h2><%= cat %><span class="core-cat-count">(<%= list.length %>)</span></h2></div>
            <% if(list.length>2){ %><div class="core-cat-hint">Swipe <i class="fas fa-arrow-right"></i></div><% } %>
          </div>
          <div class="core-row">
            <% list.forEach(p=>{ %>
              <div class="core-card" data-id="<%= p._id %>">
                <div class="core-img-box">
                  <% if(p.image){ %><img src="<%= p.image %>" alt="<%= p.name %>" loading="lazy" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"><div class="core-no-img" style="display:none;"><i class="fas fa-image"></i></div><% } else { %><div class="core-no-img"><i class="fas fa-box-open"></i></div><% } %>
                  <% if(Number(p.units||0)>0){ %><span class="core-stock"><%= p.units %> left</span><% } else { %><span class="core-stock empty">Out</span><% } %>
                </div>
                <div class="core-info">
                  <p class="core-cat-label"><%= cat %></p>
                  <p class="core-name"><%= p.name %></p>
                  <p class="core-desc"><%= p.description||"Quality healthcare product." %></p>
                  <div class="core-price-box"><p class="core-price-label">PRICE</p><p class="core-price-val">KES <%= Number(p.unitSellPrice||0).toLocaleString() %></p></div>
                </div>
                <div class="core-footer">
                  <% if(Number(p.units||0)>0){ %><button class="core-btn" data-id="<%= p._id %>" data-name="<%= p.name %>" data-stock="<%= p.units %>"><i class="fas fa-cart-plus"></i> ADD CART</button><% } else { %><button class="core-btn" disabled>OUT OF STOCK</button><% } %>
                </div>
              </div>
            <% }) %>
          </div>
        </div>
      <% }) %>
    <% } %>
  </div>
</div>

<div id="qtyOverlay">
  <div id="qtyBox">
    <h3 id="qtyName" style="margin:0;color:#0a4d1e;font-size:15px;"></h3>
    <p style="font-size:11px;color:#666;">Available: <b id="qtyAvail"></b></p>
    <div style="display:flex;justify-content:center;align-items:center;gap:12px;margin:18px 0;">
      <button id="qMinus" style="width:40px;height:40px;border-radius:50%;border:2px solid #0a4d1e;background:#fff;font-weight:900;cursor:pointer;">-</button>
      <span id="qVal" style="font-size:24px;font-weight:900;color:#0a4d1e;">1</span>
      <button id="qPlus" style="width:40px;height:40px;border-radius:50%;border:2px solid #0a4d1e;background:#fff;font-weight:900;cursor:pointer;">+</button>
    </div>
    <button id="qConfirm" style="width:100%;padding:10px;background:#0a4d1e;color:#fff;border:none;border-radius:8px;font-weight:800;cursor:pointer;">ADD <span id="qCount">1</span> TO CART</button>
    <button onclick="closeQty()" style="width:100%;margin-top:8px;background:none;border:none;color:#888;cursor:pointer;">Cancel</button>
  </div>
</div>

<script>
(function(){
  let sel={id:null,stock:0,qty:1};
  function openQty(id,name,stock){ sel={id,stock:parseInt(stock),qty:1}; document.getElementById('qtyName').innerText=name; document.getElementById('qtyAvail').innerText=stock; document.getElementById('qVal').innerText=1; document.getElementById('qCount').innerText=1; document.getElementById('qtyOverlay').style.display='flex'; }
  window.closeQty=()=>document.getElementById('qtyOverlay').style.display='none';
  document.getElementById('qPlus').onclick=()=>{ if(sel.qty<sel.stock){sel.qty++; document.getElementById('qVal').innerText=sel.qty; document.getElementById('qCount').innerText=sel.qty; } };
  document.getElementById('qMinus').onclick=()=>{ if(sel.qty>1){sel.qty--; document.getElementById('qVal').innerText=sel.qty; document.getElementById('qCount').innerText=sel.qty; } };
  document.getElementById('qConfirm').onclick=async()=>{ const r=await fetch('/products/add-to-cart',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({productId:sel.id,qty:sel.qty})}); const d=await r.json(); if(!d.success){alert(d.message);return;} closeQty(); location.reload(); };
  document.getElementById('qtyOverlay').addEventListener('click',e=>{ if(e.target.id==='qtyOverlay') closeQty(); });

  document.querySelectorAll('.core-card').forEach(card=>{
    card.addEventListener('click',e=>{
      if(e.target.closest('.core-btn')) return;
      const btn=card.querySelector('.core-btn[data-id]'); if(btn) window.location.href='/products/'+btn.dataset.id;
    });
  });
  document.querySelectorAll('.core-btn[data-id]').forEach(b=>{
    b.addEventListener('click',e=>{ e.stopPropagation(); openQty(b.dataset.id,b.dataset.name,b.dataset.stock); });
  });

  document.querySelectorAll('.core-row').forEach(row=>{
    let drag=false,sx=0,ss=0;
    row.addEventListener('mousedown',e=>{ drag=true; sx=e.pageX-row.offsetLeft; ss=row.scrollLeft; });
    row.addEventListener('mousemove',e=>{ if(!drag) return; e.preventDefault(); row.scrollLeft=ss-(e.pageX-row.offsetLeft-sx); });
    row.addEventListener('mouseup',()=>drag=false); row.addEventListener('mouseleave',()=>drag=false);
  });
})();
</script>