}


.market-cart-button i {

    font-size:
        .9rem;

}



/* ==========================================================
   SUMMARY
========================================================== */

.market-summary {

    width:
        100%;

    margin-top:
        13px;

    display:
        flex;

    gap:
        7px;

}


.summary-card {

    flex:
        1 1 0;

    min-width:
        0;

    display:
        flex;

    align-items:
        center;

    gap:
        7px;

    padding:
        8px
        9px;

    background:
        #fff;

    border:
        1px solid
        #dce8df;

    border-radius:
        11px;

}


.summary-icon {

    flex:
        0 0
        29px;

    width:
        29px;

    height:
        29px;

    display:
        flex;

    align-items:
        center;

    justify-content:
        center;

    border-radius:
        8px;

