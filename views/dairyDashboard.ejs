<style>
/* ==========================================================
   CHESI PROJECT MANAGEMENT SYSTEM
   ========================================================== */

:root {
  --primary: #0b5d1e;
  --primary-dark: #084814;
  --primary-light: #eaf7ee;

  --sidebar-width: 275px;
  --sidebar-collapsed-width: 64px;

  --background: #f5f7f6;
  --white: #ffffff;

  --text: #263238;
  --muted: #667085;
  --border: #e5e7eb;
}


/* ==========================================================
   PAGE
   ========================================================== */

.page {
  width: 100%;
  max-width: 1200px;

  margin: 0 auto;

  padding: 30px 25px 50px;

  box-sizing: border-box;
}


/* ==========================================================
   SIDEBAR
   ----------------------------------------------------------
   Collapsed:
   • Only the icon rail is visible.
   • Tapping anywhere on the rail opens it.

   Expanded:
   • Labels become visible.
   • Navigation links can be clicked normally.
   • Clicking outside closes it.
   ========================================================== */

.dashboard-sidebar {
  position: fixed;

  top: 0;
  left: 0;
  bottom: 0;

  width: var(--sidebar-collapsed-width);

  background: var(--primary);

  z-index: 1000;

  overflow-x: hidden;
  overflow-y: auto;

  box-shadow:
    3px 0 15px rgba(0, 0, 0, 0.08);

  cursor: pointer;

  transition:
    width 0.25s ease;
}


/* ==========================================================
   EXPANDED SIDEBAR
   ========================================================== */

.dashboard-sidebar.open {
  width: var(--sidebar-width);

  cursor: default;
}


/* ==========================================================
   SIDEBAR MENU
   ========================================================== */

.sidebar-menu {
  list-style: none;

  margin: 0;

  padding: 0;
}


/* ==========================================================
   SIDEBAR ITEM
   ========================================================== */

.sidebar-item {
  width: 100%;
}


/* ==========================================================
   SIDEBAR LINK
   ========================================================== */

.sidebar-link {
  width: 100%;
  height: 58px;

  box-sizing: border-box;

  display: flex;
  align-items: center;

  gap: 15px;

  padding: 0 15px;

  color: #ffffff;

  text-decoration: none;

  white-space: nowrap;

  border-bottom:
    1px solid rgba(255, 255, 255, 0.10);

  transition:
    background 0.2s ease,
    color 0.2s ease;
}


.sidebar-link:hover {
  background: rgba(255, 255, 255, 0.10);
}


/* ==========================================================
   ACTIVE LINK
   ========================================================== */

.sidebar-link.active {
  background: var(--primary-light);

  color: var(--primary);
}


/* ==========================================================
   SIDEBAR ICON
   ========================================================== */

.sidebar-icon {
  width: 34px;
  min-width: 34px;

  height: 34px;

  display: flex;
  align-items: center;
  justify-content: center;

  font-size: 21px;

  border-radius: 8px;

  color: #ffffff;

  pointer-events: none;
}


.sidebar-link.active .sidebar-icon {
  color: var(--primary);
}


/* ==========================================================
   SIDEBAR LABEL
   ========================================================== */

.sidebar-label {
  display: block;

  opacity: 0;
  visibility: hidden;

  font-size: 15px;

  font-weight: 600;

  transition:
    opacity 0.15s ease,
    visibility 0.15s ease;
}


.dashboard-sidebar.open .sidebar-label {
  opacity: 1;

  visibility: visible;
}


/* ==========================================================
   SIDEBAR FOOTER
   ========================================================== */

.sidebar-footer {
  padding: 25px 15px 30px;

  color: rgba(255, 255, 255, 0.75);

  font-size: 12px;

  line-height: 1.5;

  white-space: nowrap;

  opacity: 0;

  visibility: hidden;

  transition:
    opacity 0.15s ease,
    visibility 0.15s ease;
}


.dashboard-sidebar.open .sidebar-footer {
  opacity: 1;

  visibility: visible;
}


/* ==========================================================
   SIDEBAR OVERLAY
   ----------------------------------------------------------
   This is invisible while the sidebar is closed.

   When the sidebar opens, it covers the rest of the page.
   Tapping it closes the sidebar.
   ========================================================== */

.sidebar-overlay {
  position: fixed;

  inset: 0;

  background: rgba(0, 0, 0, 0.18);

  z-index: 900;

  opacity: 0;

  visibility: hidden;

  cursor: pointer;

  transition:
    opacity 0.2s ease,
    visibility 0.2s ease;
}


.sidebar-overlay.active {
  opacity: 1;

  visibility: visible;
}


/* ==========================================================
   MAIN PAGE CONTENT
   ----------------------------------------------------------
   The hero is the actual page content.

   The sidebar does not contain or push the hero.
   ========================================================== */

.main-content {
  min-height: 100vh;

  margin-left: var(--sidebar-collapsed-width);

  background: var(--background);

  transition:
    margin-left 0.25s ease;
}


/*
 * The sidebar remains an independent navigation layer.
 *
 * Opening it does NOT change the main-content margin.
 *
 * Therefore the expanded sidebar overlays the page instead
 * of pushing or repositioning the hero.
 */


/* ==========================================================
   HERO SECTION
   ========================================================== */

.hero {
  position: relative;

  width: 100%;

  min-height: 285px;

  box-sizing: border-box;

  padding: 48px 45px;

  background: var(--white);

  border:
    1px solid var(--border);

  border-radius: 18px;

  overflow: hidden;

  box-shadow:
    0 8px 25px rgba(0, 0, 0, 0.05);
}


/* ==========================================================
   HERO DECORATION
   ========================================================== */

.hero::before {
  content: "";

  position: absolute;

  width: 300px;
  height: 300px;

  right: -110px;
  top: -120px;

  border-radius: 50%;

  background: var(--primary-light);

  opacity: 0.8;

  pointer-events: none;
}


.hero::after {
  content: "";

  position: absolute;

  width: 120px;
  height: 120px;

  right: 80px;
  bottom: -70px;

  border-radius: 50%;

  background: #f2f8f3;

  pointer-events: none;
}


/* ==========================================================
   HERO CONTENT
   ========================================================== */

.hero-content {
  position: relative;

  z-index: 2;

  max-width: 820px;
}


/* ==========================================================
   HERO KICKER
   ========================================================== */

.hero-kicker {
  margin-bottom: 12px;

  color: var(--primary);

  font-size: 13px;

  font-weight: 700;

  letter-spacing: 1.2px;

  text-transform: uppercase;
}


/* ==========================================================
   HERO HEADING
   ========================================================== */

.hero h1 {
  margin: 0 0 18px;

  color: var(--primary-dark);

  font-size: clamp(28px, 4vw, 44px);

  line-height: 1.15;

  font-weight: 750;
}


.hero h1 span {
  color: var(--primary);
}


/* ==========================================================
   HERO DESCRIPTION
   ========================================================== */

.hero p {
  max-width: 800px;

  margin: 0;

  color: var(--muted);

  font-size: 16px;

  line-height: 1.75;
}


/* ==========================================================
   RESPONSIVE
   ========================================================== */

@media (max-width: 700px) {

  :root {
    --sidebar-collapsed-width: 60px;
    --sidebar-width: 270px;
  }


  .page {
    padding: 20px 14px 35px;
  }


  .hero {
    min-height: auto;

    padding: 34px 24px;

    border-radius: 14px;
  }


  .hero h1 {
    font-size: 29px;
  }


  .hero p {
    font-size: 15px;

    line-height: 1.7;
  }
}


/* ==========================================================
   SMALL PHONES
   ========================================================== */

@media (max-width: 400px) {

  :root {
    --sidebar-width: 250px;
  }


  .hero {
    padding: 30px 20px;
  }


  .hero h1 {
    font-size: 26px;
  }


  .hero p {
    font-size: 14px;
  }
}
</style>


<!-- ==========================================================
