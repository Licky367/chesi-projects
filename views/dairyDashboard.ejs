<style>
/* ==========================================================
   CHESI PROJECT MANAGEMENT SYSTEM
   ========================================================== */

:root {
  --primary: #0b5d1e;
  --primary-dark: #084814;
  --primary-light: #eaf7ee;

  --sidebar-width: 275px;
  --sidebar-collapsed-width: 64px;

  /*
   * The existing layout has:
   * Header     = 70px
   * Top menu   = 50px
   * Total      = 120px
   */
  --layout-top: 120px;

  --background: #f5f7f6;
  --white: #ffffff;

  --text: #263238;
  --muted: #667085;
  --border: #e5e7eb;
}


/* ==========================================================
   PAGE
========================================================== */

.page {
  width: 100%;
  max-width: 1200px;

  margin: 0 auto;

  padding: 30px 25px 50px;

  box-sizing: border-box;
}


/* ==========================================================
   SIDEBAR
   ----------------------------------------------------------
   CLOSED:
   • A 64px icon rail remains visible.
   • The entire visible rail is clickable.
   • Clicking anywhere on it opens the sidebar.

   OPEN:
   • Sidebar expands.
   • Labels become visible.
   • Navigation links become clickable.
   • Clicking outside closes it.
========================================================== */

.dashboard-sidebar {
  position: fixed;

  top: var(--layout-top);
  left: 0;
  bottom: 50px;

  width: var(--sidebar-collapsed-width);

  background: var(--primary);

  z-index: 1000;

  overflow-x: hidden;
  overflow-y: auto;

  box-shadow:
    3px 0 15px rgba(0, 0, 0, 0.12);

  cursor: pointer;

  transition:
    width 0.25s ease;
}


/* ==========================================================
   EXPANDED SIDEBAR
========================================================== */

.dashboard-sidebar.open {
  width: var(--sidebar-width);

  cursor: default;
}


/* ==========================================================
   SIDEBAR MENU
========================================================== */

.sidebar-menu {
  list-style: none;

  width: 100%;

  margin: 0;

  padding: 0;
}


/* ==========================================================
   SIDEBAR ITEM
========================================================== */

.sidebar-item {
  width: 100%;

  margin: 0;

  padding: 0;
}


/* ==========================================================
   SIDEBAR LINK
========================================================== */

.sidebar-link {
  width: 100%;
  min-height: 58px;

  box-sizing: border-box;

  display: flex;
  align-items: center;

  gap: 15px;

  padding: 0 15px;

  color: #ffffff;

  text-decoration: none;

  white-space: nowrap;

  border-bottom:
    1px solid rgba(255, 255, 255, 0.10);

  transition:
    background 0.2s ease,
    color 0.2s ease;
}


.sidebar-link:hover {
  background: rgba(255, 255, 255, 0.10);
}


/* ==========================================================
   ACTIVE LINK
========================================================== */

.sidebar-link.active {
  background: var(--primary-light);

  color: var(--primary);
}


/* ==========================================================
   SIDEBAR MENU BUTTON
   ----------------------------------------------------------
   This is the first item in the sidebar.

   It is deliberately NOT a normal navigation link.
   When the sidebar is collapsed, it is visible as the
   first icon. Tapping it opens the sidebar.
========================================================== */

.sidebar-menu-button {
  width: 100%;
  height: 58px;

  display: flex;
  align-items: center;

  gap: 15px;

  padding: 0 15px;

  box-sizing: border-box;

  border: 0;
  border-bottom:
    1px solid rgba(255, 255, 255, 0.10);

  background: transparent;

  color: #ffffff;

  cursor: pointer;

  font: inherit;

  text-align: left;

  white-space: nowrap;

  transition:
    background 0.2s ease;
}


.sidebar-menu-button:hover {
  background: rgba(255, 255, 255, 0.10);
}


/* ==========================================================
   SIDEBAR MENU ICON
========================================================== */

.sidebar-menu-icon {
  width: 34px;
  min-width: 34px;

  height: 34px;

  display: flex;
  align-items: center;
  justify-content: center;

  font-size: 25px;

  line-height: 1;

  border-radius: 8px;

  color: #ffffff;

  pointer-events: none;
}


/* ==========================================================
   SIDEBAR ICON
========================================================== */

.sidebar-icon {
  width: 34px;
  min-width: 34px;

  height: 34px;

  display: flex;
  align-items: center;
  justify-content: center;

  font-size: 21px;

  line-height: 1;

  border-radius: 8px;

  color: #ffffff;

  pointer-events: none;
}


.sidebar-link.active .sidebar-icon {
  color: var(--primary);
}


/* ==========================================================
   SIDEBAR LABEL
========================================================== */

.sidebar-label {
  display: block;

  opacity: 0;

  visibility: hidden;

  font-size: 15px;

  font-weight: 600;

  transition:
    opacity 0.15s ease,
    visibility 0.15s ease;
}


.dashboard-sidebar.open .sidebar-label {
  opacity: 1;

  visibility: visible;
}


/* ==========================================================
   SIDEBAR FOOTER
========================================================== */

.sidebar-footer {
  padding: 25px 15px 30px;

  color: rgba(255, 255, 255, 0.75);

  font-size: 12px;

  line-height: 1.5;

  white-space: nowrap;

  opacity: 0;

  visibility: hidden;

  transition:
    opacity 0.15s ease,
    visibility 0.15s ease;
}


.dashboard-sidebar.open .sidebar-footer {
  opacity: 1;

  visibility: visible;
}


/* ==========================================================
   SIDEBAR OVERLAY
   ----------------------------------------------------------
   Only appears when the sidebar is open.

   It starts below the existing top navigation so the
   existing header/top-menu remain visible.
========================================================== */

.sidebar-overlay {
  position: fixed;

  top: var(--layout-top);
  left: 0;
  right: 0;
  bottom: 50px;

  background: rgba(0, 0, 0, 0.18);

  z-index: 900;

  opacity: 0;

  visibility: hidden;

  cursor: pointer;

  transition:
    opacity 0.2s ease,
    visibility 0.2s ease;
}


.sidebar-overlay.active {
  opacity: 1;

  visibility: visible;
}


/* ==========================================================
   MAIN PAGE CONTENT
   ----------------------------------------------------------
   The collapsed sidebar occupies 64px on the left.
   The expanded sidebar overlays the content.
========================================================== */

.main-content {
  min-height: 100vh;

  margin-left: var(--sidebar-collapsed-width);

  background: var(--background);

  transition:
    margin-left 0.25s ease;
}


/* ==========================================================
   HERO SECTION
========================================================== */

.hero {
  position: relative;

  width: 100%;

  min-height: 285px;

  box-sizing: border-box;

  padding: 48px 45px;

  background: var(--white);

  border:
    1px solid var(--border);

  border-radius: 18px;

  overflow: hidden;

  box-shadow:
    0 8px 25px rgba(0, 0, 0, 0.05);
}


/* ==========================================================
   HERO DECORATION
========================================================== */

.hero::before {
  content: "";

  position: absolute;

  width: 300px;
  height: 300px;

  right: -110px;
  top: -120px;

  border-radius: 50%;

  background: var(--primary-light);

  opacity: 0.8;

  pointer-events: none;
}


.hero::after {
  content: "";

  position: absolute;

  width: 120px;
  height: 120px;

  right: 80px;
  bottom: -70px;

  border-radius: 50%;

  background: #f2f8f3;

  pointer-events: none;
}


/* ==========================================================
   HERO CONTENT
========================================================== */

.hero-content {
  position: relative;

  z-index: 2;

  max-width: 820px;
}


/* ==========================================================
   HERO KICKER
========================================================== */

.hero-kicker {
  margin-bottom: 12px;

  color: var(--primary);

  font-size: 13px;

  font-weight: 700;

  letter-spacing: 1.2px;

  text-transform: uppercase;
}


/* ==========================================================
   HERO HEADING
========================================================== */

.hero h1 {
  margin: 0 0 18px;

  color: var(--primary-dark);

  font-size: clamp(28px, 4vw, 44px);

  line-height: 1.15;

  font-weight: 750;
}


.hero h1 span {
  color: var(--primary);
}


/* ==========================================================
   HERO DESCRIPTION
========================================================== */

.hero p {
  max-width: 800px;

  margin: 0;

  color: var(--muted);

  font-size: 16px;

  line-height: 1.75;
}


/* ==========================================================
   RESPONSIVE
========================================================== */

@media (max-width: 700px) {

  :root {
    --sidebar-collapsed-width: 60px;
    --sidebar-width: 270px;
  }


  .page {
    padding: 20px 14px 35px;
  }


  .hero {
    min-height: auto;

    padding: 34px 24px;

    border-radius: 14px;
  }


  .hero h1 {
    font-size: 29px;
  }


  .hero p {
    font-size: 15px;

    line-height: 1.7;
  }


  .sidebar-link,
  .sidebar-menu-button {
    height: 56px;

    min-height: 56px;

    padding-left: 13px;
    padding-right: 13px;
  }


  .sidebar-icon,
  .sidebar-menu-icon {
    width: 34px;
    min-width: 34px;
  }

}


/* ==========================================================
   SMALL PHONES
========================================================== */

@media (max-width: 400px) {

  :root {
    --sidebar-width: 250px;
  }


  .hero {
    padding: 30px 20px;
  }


  .hero h1 {
    font-size: 26px;
  }


  .hero p {
    font-size: 14px;
  }

}
</style>


<!-- ==========================================================
     NAVIGATION SIDEBAR
========================================================== -->

<aside
  id="dashboardSidebar"
  class="dashboard-sidebar"
  aria-label="Project navigation"
  aria-expanded="false"
>


  <!-- ========================================================
       SIDEBAR NAVIGATION
  ========================================================= -->

  <ul class="sidebar-menu">


    <!-- ======================================================
         MENU BUTTON — FIRST ITEM
    ====================================================== -->

    <li class="sidebar-item">

      <button
        type="button"
        id="sidebarMenuButton"
        class="sidebar-menu-button"
        aria-label="Open navigation menu"
        aria-expanded="false"
      >

        <span
          class="sidebar-menu-icon"
          aria-hidden="true"
        >
          ☰
        </span>

        <span class="sidebar-label">
          Menu
        </span>

      </button>

    </li>


    <!-- ======================================================
         DASHBOARD
    ====================================================== -->

    <li class="sidebar-item">

      <a
        href="/"
        class="sidebar-link active"
        title="Dashboard"
      >

        <span
          class="sidebar-icon"
          aria-hidden="true"
        >
          ⌂
        </span>

        <span class="sidebar-label">
          Dashboard
        </span>

      </a>

    </li>


    <% if (user && user.role === "admin") { %>


      <!-- ====================================================
           ADD ASSET
      ==================================================== -->

      <li class="sidebar-item">

        <a
          href="/add"
          class="sidebar-link"
          title="Add an Asset"
        >

          <span
            class="sidebar-icon"
            aria-hidden="true"
          >
            ＋
          </span>

          <span class="sidebar-label">
            Add an Asset
          </span>

        </a>

      </li>


      <!-- ====================================================
           VIEW ASSETS
      ==================================================== -->

      <li class="sidebar-item">

        <a
          href="/networth"
          class="sidebar-link"
          title="View Assets"
        >

          <span
            class="sidebar-icon"
            aria-hidden="true"
          >
            👁
          </span>

          <span class="sidebar-label">
            View Assets
          </span>

        </a>

      </li>


      <!-- ====================================================
           MILK PRODUCTION
      ==================================================== -->

      <li class="sidebar-item">

        <a
          href="/milk"
          class="sidebar-link"
          title="Record Milk Production"
        >

          <span
            class="sidebar-icon"
            aria-hidden="true"
          >
            🥛
          </span>

          <span class="sidebar-label">
            Record Milk Production
          </span>

        </a>

      </li>


      <!-- ====================================================
           MILK SALES
      ==================================================== -->

      <li class="sidebar-item">

        <a
          href="/sales"
          class="sidebar-link"
          title="Record Milk Sales"
        >

          <span
            class="sidebar-icon"
            aria-hidden="true"
          >
            💰
          </span>

          <span class="sidebar-label">
            Record Milk Sales
          </span>

        </a>

      </li>


      <!-- ====================================================
           MILK STATISTICS
      ==================================================== -->

      <li class="sidebar-item">

        <a
          href="/stats"
          class="sidebar-link"
          title="Milk Production Statistics"
        >

          <span
            class="sidebar-icon"
            aria-hidden="true"
          >
            📊
          </span>

          <span class="sidebar-label">
            Milk Production Statistics
          </span>

        </a>

      </li>


      <!-- ====================================================
           FINANCIALS
      ==================================================== -->

      <li class="sidebar-item">

        <a
          href="/financials/summary"
          class="sidebar-link"
          title="Financials"
        >

          <span
            class="sidebar-icon"
            aria-hidden="true"
          >
            💱
          </span>

          <span class="sidebar-label">
            Financials
          </span>

        </a>

      </li>


    <% } %>


  </ul>


  <!-- ========================================================
       SIDEBAR FOOTER
  ========================================================= -->

  <div class="sidebar-footer">

    Chesi Project Management System

  </div>


</aside>


<!-- ==========================================================
     OUTSIDE-CLICK OVERLAY
========================================================== -->

<div
  id="sidebarOverlay"
  class="sidebar-overlay"
  aria-hidden="true"
></div>


<!-- ==========================================================
     MAIN PAGE CONTENT
========================================================== -->

<main class="main-content">

  <div class="page">


    <!-- ======================================================
         HERO SECTION
    ====================================================== -->

    <section class="hero">

      <div class="hero-content">


        <div class="hero-kicker">
          Chesi Project Management System
        </div>


        <h1>

          Welcome,
          <span>
            <%= user && user.name ? user.name : "User" %>
          </span>

        </h1>


        <p>

          Welcome to the Chesi Project Management System.
          Use this space to keep track of our projects, assets,
          production, sales, and financial activities. Navigate
          through the system to update records, monitor progress,
          and help us maintain accurate information for better
          project management and decision-making. Thank you for
          being part of the work.

        </p>


      </div>

    </section>


  </div>

</main>


<!-- ==========================================================
     SIDEBAR JAVASCRIPT
========================================================== -->

<script>
(function () {

  const sidebar =
    document.getElementById("dashboardSidebar");

  const overlay =
    document.getElementById("sidebarOverlay");

  const menuButton =
    document.getElementById("sidebarMenuButton");


  if (!sidebar || !overlay || !menuButton) {
    return;
  }


  /* ========================================================
     OPEN SIDEBAR
  ========================================================= */

  function openSidebar() {

    sidebar.classList.add("open");

    overlay.classList.add("active");

    sidebar.setAttribute(
      "aria-expanded",
      "true"
    );

    menuButton.setAttribute(
      "aria-expanded",
      "true"
    );

    overlay.setAttribute(
      "aria-hidden",
      "false"
    );

  }


  /* ========================================================
     CLOSE SIDEBAR
  ========================================================= */

  function closeSidebar() {

    sidebar.classList.remove("open");

    overlay.classList.remove("active");

    sidebar.setAttribute(
      "aria-expanded",
      "false"
    );

    menuButton.setAttribute(
      "aria-expanded",
      "false"
    );

    overlay.setAttribute(
      "aria-hidden",
      "true"
    );

  }


  /* ========================================================
     FIRST SIDEBAR ITEM
     --------------------------------------------------------
     Menu button opens the sidebar.
  ========================================================= */

  menuButton.addEventListener(
    "click",
    function (event) {

      event.preventDefault();

      event.stopPropagation();

      openSidebar();

    }
  );


  /* ========================================================
     COLLAPSED SIDEBAR RAIL
     --------------------------------------------------------
     When closed, tapping anywhere on the visible sidebar
     opens it.

     The menu button above also opens it directly.
  ========================================================= */

  sidebar.addEventListener(
    "click",
    function (event) {

      /*
       * If the sidebar is already open, links must behave
       * normally.
       */

      if (sidebar.classList.contains("open")) {
        return;
      }


      /*
       * The sidebar is collapsed.
       *
       * Any tap anywhere on its visible 60/64px rail opens it.
       */

      event.preventDefault();

      event.stopPropagation();

      openSidebar();

    }
  );


  /* ========================================================
     SIDEBAR LINKS
     --------------------------------------------------------
     Once open:
       • First tap follows the link.
       • Sidebar does not intercept navigation.
  ========================================================= */

  const sidebarLinks =
    sidebar.querySelectorAll(".sidebar-link");


  sidebarLinks.forEach(
    function (link) {

      link.addEventListener(
        "click",
        function (event) {

          /*
           * If the sidebar is closed, the parent sidebar
           * handles the tap by opening it.
           */

          if (
            !sidebar.classList.contains("open")
          ) {

            event.preventDefault();

            return;

          }


          /*
           * Sidebar is open.
           *
           * Allow the browser to follow the link normally.
           */

        }
      );

    }
  );


  /* ========================================================
     OUTSIDE CLICK
     --------------------------------------------------------
     Tapping anywhere outside the expanded sidebar closes it.
  ========================================================= */

  overlay.addEventListener(
    "click",
    function () {

      closeSidebar();

    }
  );


  /* ========================================================
     ESCAPE KEY
  ========================================================= */

  document.addEventListener(
    "keydown",
    function (event) {

      if (event.key === "Escape") {

        closeSidebar();

      }

    }
  );


  /* ========================================================
     WINDOW RESIZE
  ========================================================= */

  window.addEventListener(
    "resize",
    function () {

      /*
       * Keep the sidebar closed when the viewport changes.
       * The existing layout remains responsible for its
       * header/top-menu behavior.
       */

      closeSidebar();

    }
  );


})();
</script>