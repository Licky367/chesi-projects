          class="sidebar-link"
          title="Add an Asset"
        >

          <span class="sidebar-icon">
            ＋
          </span>

          <span class="sidebar-label">
            Add an Asset
          </span>

        </a>

      </li>


      <!-- ====================================================
           VIEW ASSETS
           ==================================================== -->

      <li class="sidebar-item">

        <a
          href="/networth"
          class="sidebar-link"
          title="View Assets"
        >

          <span class="sidebar-icon">
            👁
          </span>

          <span class="sidebar-label">
            View Assets
          </span>

        </a>

      </li>


      <!-- ====================================================
           MILK PRODUCTION
           ==================================================== -->

      <li class="sidebar-item">

        <a
          href="/milk"
          class="sidebar-link"
          title="Record Milk Production"
        >

          <span class="sidebar-icon">
            🥛
          </span>

          <span class="sidebar-label">
            Record Milk Production
          </span>

        </a>

      </li>


      <!-- ====================================================
           MILK SALES
           ==================================================== -->

      <li class="sidebar-item">

        <a
          href="/sales"
          class="sidebar-link"
          title="Record Milk Sales"
        >

          <span class="sidebar-icon">
            💰
          </span>

          <span class="sidebar-label">
            Record Milk Sales
          </span>

        </a>

      </li>


      <!-- ====================================================
           MILK STATISTICS
           ==================================================== -->

      <li class="sidebar-item">

        <a
          href="/stats"
          class="sidebar-link"
          title="Milk Production Statistics"
        >

          <span class="sidebar-icon">
            📊
          </span>

          <span class="sidebar-label">
            Milk Production Statistics
          </span>

        </a>

      </li>


      <!-- ====================================================
           FINANCIALS
           ==================================================== -->

      <li class="sidebar-item">

        <a
          href="/financials/summary"
          class="sidebar-link"
          title="Financials"
        >

          <span class="sidebar-icon">
            💱
          </span>

          <span class="sidebar-label">
            Financials
          </span>

        </a>

      </li>


    <% } %>


  </ul>


  <!-- ========================================================
       SIDEBAR FOOTER
       ======================================================== -->

  <div class="sidebar-footer">

    Chesi Project Management System

  </div>


</aside>


<!-- ==========================================================
     OUTSIDE-CLICK OVERLAY
     ========================================================== -->

<div
  id="sidebarOverlay"
  class="sidebar-overlay"
  aria-hidden="true"
></div>


<!-- ==========================================================
     MAIN PAGE CONTENT
     ----------------------------------------------------------
     HERO IS THE FIRST AND ONLY CONTENT SECTION.
     ========================================================== -->

<main class="main-content">

  <div class="page">


    <!-- ======================================================
         HERO SECTION
         ====================================================== -->

    <section class="hero">

      <div class="hero-content">


        <div class="hero-kicker">
          Chesi Project Management System
        </div>


        <h1>

          Welcome,
          <span>
            <%= user && user.name ? user.name : "User" %>
          </span>

        </h1>


        <p>

          Welcome to the Chesi Project Management System.
          Use this space to keep track of our projects, assets,
          production, sales, and financial activities. Navigate
          through the system to update records, monitor progress,
          and help us maintain accurate information for better
          project management and decision-making. Thank you for
          being part of the work.

        </p>


      </div>

    </section>


  </div>

</main>


<!-- ==========================================================
     SIDEBAR JAVASCRIPT
     ========================================================== -->

<script>
(function () {

  const sidebar =
    document.getElementById("dashboardSidebar");

  const toggle =
    document.getElementById("sidebarToggle");

  const overlay =
    document.getElementById("sidebarOverlay");


  if (!sidebar || !toggle || !overlay) {
    return;
  }


  /* ========================================================
     OPEN SIDEBAR
     ======================================================== */

  function openSidebar() {

    sidebar.classList.add("open");

    overlay.classList.add("active");

    toggle.setAttribute(
      "aria-expanded",
      "true"
    );

    toggle.setAttribute(
      "aria-label",
      "Close navigation"
    );

  }


  /* ========================================================
     CLOSE SIDEBAR
     ======================================================== */

  function closeSidebar() {

    sidebar.classList.remove("open");

    overlay.classList.remove("active");

    toggle.setAttribute(
      "aria-expanded",
      "false"
    );

    toggle.setAttribute(
      "aria-label",
      "Open navigation"
    );

  }


  /* ========================================================
     THREE-DOT BUTTON
     ======================================================== */

  toggle.addEventListener(
    "click",
    function (event) {

      event.preventDefault();

      event.stopPropagation();


      if (
        sidebar.classList.contains("open")
      ) {

        closeSidebar();

      } else {

        openSidebar();

      }

    }
  );


  /* ========================================================
     CLICK OUTSIDE SIDEBAR
     ======================================================== */

  overlay.addEventListener(
    "click",
    function () {

      closeSidebar();

    }
  );


  /* ========================================================
     ESCAPE KEY
     ======================================================== */

  document.addEventListener(
    "keydown",
    function (event) {

      if (event.key === "Escape") {

        closeSidebar();

      }

    }
  );


})();
</script>