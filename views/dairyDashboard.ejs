          being part of the work.

        </p>


      </div>

    </section>


  </div>

</main>


<!-- ==========================================================
     SIDEBAR JAVASCRIPT
     ========================================================== -->

<script>
(function () {

  const sidebar =
    document.getElementById("dashboardSidebar");

  const overlay =
    document.getElementById("sidebarOverlay");


  if (!sidebar || !overlay) {
    return;
  }


  /* ========================================================
     OPEN SIDEBAR
     ======================================================== */

  function openSidebar() {

    sidebar.classList.add("open");

    overlay.classList.add("active");

    sidebar.setAttribute(
      "aria-expanded",
      "true"
    );

  }


  /* ========================================================
     CLOSE SIDEBAR
     ======================================================== */

  function closeSidebar() {

    sidebar.classList.remove("open");

    overlay.classList.remove("active");

    sidebar.setAttribute(
      "aria-expanded",
      "false"
    );

  }


  /* ========================================================
     CLICK ON COLLAPSED ICON RAIL
     --------------------------------------------------------
     When the sidebar is closed, ANYWHERE on the visible
     narrow rail opens it.
     ======================================================== */

  sidebar.addEventListener(
    "click",
    function (event) {

      /*
       * If the sidebar is already open, do nothing here.
       * Individual links are then handled normally.
       */

      if (sidebar.classList.contains("open")) {
        return;
      }


      /*
       * Sidebar is collapsed.
       *
       * Prevent the click from following a link because the
       * first tap is only intended to open the navigation.
       */

      event.preventDefault();

      event.stopPropagation();

      openSidebar();

    }
  );


  /* ========================================================
     PREVENT LINK NAVIGATION WHILE CLOSED
     --------------------------------------------------------
     The first tap opens the sidebar.
     A second tap on a visible link selects it.
     ======================================================== */

  const sidebarLinks =
    sidebar.querySelectorAll(".sidebar-link");


  sidebarLinks.forEach(
    function (link) {

      link.addEventListener(
        "click",
        function (event) {

          if (
            !sidebar.classList.contains("open")
          ) {

            event.preventDefault();

          }

        }
      );

    }
  );


  /* ========================================================
     CLICK OUTSIDE
     ======================================================== */

  overlay.addEventListener(
    "click",
    function () {

      closeSidebar();

    }
  );


  /* ========================================================
     ESCAPE KEY
     ======================================================== */

  document.addEventListener(
    "keydown",
    function (event) {

      if (event.key === "Escape") {

        closeSidebar();

      }

    }
  );


})();
</script>