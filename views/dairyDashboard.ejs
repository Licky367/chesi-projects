<style>
/* ==========================================================
   CHESI PROJECT MANAGEMENT SYSTEM
   ========================================================== */

:root {
  --primary: #0b5d1e;
  --primary-dark: #084814;
  --primary-light: #eaf7ee;

  --sidebar-width: 275px;
  --sidebar-collapsed-width: 64px;

  /*
   * Existing layout:
   * Header     = 70px
   * Top menu   = 50px
   * Total      = 120px
   */
  --layout-top: 120px;

  --background: #f5f7f6;
  --white: #ffffff;

  --text: #263238;
  --muted: #667085;
  --border: #e5e7eb;
}


/* ==========================================================
   PAGE
========================================================== */

.page {
  width: 100%;
  max-width: 1200px;

  margin: 0 auto;

  padding: 30px 25px 50px;

  box-sizing: border-box;
}


/* ==========================================================
   SIDEBAR
========================================================== */

.dashboard-sidebar {
  position: fixed;

  top: var(--layout-top);
  left: 0;
  bottom: 50px;

  width: var(--sidebar-collapsed-width);

  background: var(--primary);

  z-index: 1000;

  overflow-x: hidden;
  overflow-y: auto;

  box-shadow:
    3px 0 15px rgba(0, 0, 0, 0.12);

  cursor: pointer;

  transition:
    width 0.25s ease;
}


/* ==========================================================
   EXPANDED SIDEBAR
========================================================== */

.dashboard-sidebar.open {
  width: var(--sidebar-width);

  cursor: default;
}


/* ==========================================================
   SIDEBAR MENU
========================================================== */

.sidebar-menu {
  list-style: none;

  width: 100%;

  margin: 0;

  padding: 0;
}


/* ==========================================================
   SIDEBAR ITEM
========================================================== */

.sidebar-item {
  width: 100%;

  margin: 0;

  padding: 0;
}


/* ==========================================================
   SIDEBAR LINK
========================================================== */

.sidebar-link {
  width: 100%;
  min-height: 58px;

  box-sizing: border-box;

  display: flex;
  align-items: center;

  gap: 15px;

  padding: 0 15px;

  color: #ffffff;

  text-decoration: none;

  white-space: nowrap;

  border-bottom:
    1px solid rgba(255, 255, 255, 0.10);

  transition:
    background 0.2s ease,
    color 0.2s ease;
}


.sidebar-link:hover {
  background: rgba(255, 255, 255, 0.10);
}


/* ==========================================================
   ACTIVE LINK
========================================================== */

.sidebar-link.active {
  background: var(--primary-light);

  color: var(--primary);
}


.sidebar-link.active .sidebar-icon {
  color: var(--primary);
}


/* ==========================================================
   SIDEBAR MENU BUTTON
   ----------------------------------------------------------
   First item in sidebar.
========================================================== */

.sidebar-menu-button {
  width: 100%;
  height: 58px;

  display: flex;
  align-items: center;

  gap: 15px;

  padding: 0 15px;

  box-sizing: border-box;

  border: 0;

  border-bottom:
    1px solid rgba(255, 255, 255, 0.10);

  background: transparent;

  color: #ffffff;

  cursor: pointer;

  font: inherit;

  text-align: left;

  white-space: nowrap;

  transition:
    background 0.2s ease;
}


.sidebar-menu-button:hover {
  background: rgba(255, 255, 255, 0.10);
}


/* ==========================================================
   SIDEBAR MENU ICON
========================================================== */

.sidebar-menu-icon {
  width: 34px;
  min-width: 34px;

  height: 34px;

  display: flex;
  align-items: center;
  justify-content: center;

  font-size: 25px;

  line-height: 1;

  border-radius: 8px;

  color: #ffffff;

  pointer-events: none;
}


/* ==========================================================
   SIDEBAR ICON
========================================================== */

.sidebar-icon {
  width: 34px;
  min-width: 34px;

  height: 34px;

  display: flex;
  align-items: center;
  justify-content: center;

  font-size: 21px;

  line-height: 1;

  border-radius: 8px;

  color: #ffffff;

  pointer-events: none;
}


/* ==========================================================
   SIDEBAR LABEL
========================================================== */

.sidebar-label {
  display: block;

  opacity: 0;

  visibility: hidden;

  font-size: 15px;

  font-weight: 600;

  transition:
    opacity 0.15s ease,
    visibility 0.15s ease;
}


.dashboard-sidebar.open .sidebar-label {
  opacity: 1;

  visibility: visible;
}


/* ==========================================================
   DAIRY ACTIVITIES BUTTON
========================================================== */

.sidebar-section-button {
  width: 100%;
  min-height: 58px;

  display: flex;
  align-items: center;

  gap: 15px;

  padding: 0 15px;

  box-sizing: border-box;

  border: 0;

  border-bottom:
    1px solid rgba(255, 255, 255, 0.10);

  background: transparent;

  color: #ffffff;

  cursor: pointer;

  font: inherit;

  text-align: left;

  white-space: nowrap;

  transition:
    background 0.2s ease;
}


.sidebar-section-button:hover {
  background: rgba(255, 255, 255, 0.10);
}


/* ==========================================================
   ACTIVE / EXPANDED DAIRY ACTIVITIES BUTTON
========================================================== */

.sidebar-section-button.expanded {
  background: rgba(255, 255, 255, 0.12);
}


/* ==========================================================
   DAIRY ACTIVITIES ARROW
========================================================== */

.sidebar-section-arrow {
  margin-left: auto;

  font-size: 14px;

  line-height: 1;

  opacity: 0;

  visibility: hidden;

  transition:
    transform 0.2s ease,
    opacity 0.15s ease,
    visibility 0.15s ease;
}


.dashboard-sidebar.open
.sidebar-section-arrow {
  opacity: 0.9;

  visibility: visible;
}


.sidebar-section-button.expanded
.sidebar-section-arrow {
  transform: rotate(90deg);
}


/* ==========================================================
   DAIRY ACTIVITIES SUBMENU
   ----------------------------------------------------------
   Hidden by default.
========================================================== */

.sidebar-submenu {
  display: none;

  width: 100%;

  margin: 0;

  padding: 0;

  list-style: none;

  background: rgba(0, 0, 0, 0.12);
}


.sidebar-submenu.open {
  display: block;
}


/* ==========================================================
   SUBMENU LINKS
========================================================== */

.sidebar-submenu .sidebar-link {
  min-height: 52px;

  padding-left: 28px;

  gap: 12px;

  border-bottom:
    1px solid rgba(255, 255, 255, 0.07);
}


/* ==========================================================
   SUBMENU ICON
========================================================== */

.sidebar-submenu .sidebar-icon {
  width: 30px;
  min-width: 30px;

  height: 30px;

  font-size: 18px;
}


/* ==========================================================
   SUBMENU LABEL
========================================================== */

.sidebar-submenu .sidebar-label {
  font-size: 14px;
}


/* ==========================================================
   SIDEBAR FOOTER
========================================================== */

.sidebar-footer {
  padding: 25px 15px 30px;

  color: rgba(255, 255, 255, 0.75);

  font-size: 12px;

  line-height: 1.5;

  white-space: nowrap;

  opacity: 0;

  visibility: hidden;

  transition:
    opacity 0.15s ease,
    visibility 0.15s ease;
}


.dashboard-sidebar.open .sidebar-footer {
  opacity: 1;

  visibility: visible;
}


/* ==========================================================
   SIDEBAR OVERLAY
========================================================== */

.sidebar-overlay {
  position: fixed;

  top: var(--layout-top);
  left: 0;
  right: 0;
  bottom: 50px;

  background: rgba(0, 0, 0, 0.18);

  z-index: 900;

  opacity: 0;

  visibility: hidden;

  cursor: pointer;

  transition:
    opacity 0.2s ease,
    visibility 0.2s ease;
}


.sidebar-overlay.active {
  opacity: 1;

  visibility: visible;
}


/* ==========================================================
   MAIN PAGE CONTENT
========================================================== */

.main-content {
  min-height: 100vh;

  margin-left: var(--sidebar-collapsed-width);

  background: var(--background);

  transition:
    margin-left 0.25s ease;
}


/* ==========================================================
   HERO SECTION
========================================================== */

.hero {
  position: relative;

  width: 100%;

  min-height: 285px;

  box-sizing: border-box;

  padding: 48px 45px;

  background: var(--white);

  border:
    1px solid var(--border);

  border-radius: 18px;

  overflow: hidden;

  box-shadow:
    0 8px 25px rgba(0, 0, 0, 0.05);
}


/* ==========================================================
   HERO DECORATION
========================================================== */

.hero::before {
  content: "";

  position: absolute;

  width: 300px;
  height: 300px;

  right: -110px;
  top: -120px;

  border-radius: 50%;

  background: var(--primary-light);

  opacity: 0.8;

  pointer-events: none;
}


.hero::after {
  content: "";

  position: absolute;

  width: 120px;
  height: 120px;

  right: 80px;
  bottom: -70px;

  border-radius: 50%;

  background: #f2f8f3;

  pointer-events: none;
}


/* ==========================================================
   HERO CONTENT
========================================================== */

.hero-content {
  position: relative;

  z-index: 2;

  max-width: 820px;
}


/* ==========================================================
   HERO KICKER
========================================================== */

.hero-kicker {
  margin-bottom: 12px;

  color: var(--primary);

  font-size: 13px;

  font-weight: 700;

  letter-spacing: 1.2px;

  text-transform: uppercase;
}


/* ==========================================================
   HERO HEADING
========================================================== */

.hero h1 {
  margin: 0 0 18px;

  color: var(--primary-dark);

  font-size: clamp(28px, 4vw, 44px);

  line-height: 1.15;

  font-weight: 750;
}


.hero h1 span {
  color: var(--primary);
}


/* ==========================================================
   HERO DESCRIPTION
========================================================== */

.hero p {
  max-width: 800px;

  margin: 0;

  color: var(--muted);

  font-size: 16px;

  line-height: 1.75;
}


/* ==========================================================
   RESPONSIVE
========================================================== */

@media (max-width: 700px) {

  :root {
    --sidebar-collapsed-width: 60px;
    --sidebar-width: 270px;
  }


  .page {
    padding: 20px 14px 35px;
  }


  .hero {
    min-height: auto;

    padding: 34px 24px;

    border-radius: 14px;
  }


  .hero h1 {
    font-size: 29px;
  }


  .hero p {
    font-size: 15px;

    line-height: 1.7;
  }


  .sidebar-link,
  .sidebar-menu-button,
  .sidebar-section-button {
    height: 56px;

    min-height: 56px;

    padding-left: 13px;
    padding-right: 13px;
  }


  .sidebar-icon,
  .sidebar-menu-icon {
    width: 34px;
    min-width: 34px;
  }


  .sidebar-submenu .sidebar-link {
    padding-left: 25px;
  }

}


/* ==========================================================
   SMALL PHONES
========================================================== */

@media (max-width: 400px) {

  :root {
    --sidebar-width: 250px;
  }


  .hero {
    padding: 30px 20px;
  }


  .hero h1 {
    font-size: 26px;
  }


  .hero p {
    font-size: 14px;
  }

}
</style>


<!-- ==========================================================
     NAVIGATION SIDEBAR
========================================================== -->

<aside
  id="dashboardSidebar"
  class="dashboard-sidebar"
  aria-label="Project navigation"
  aria-expanded="false"
>


  <!-- ========================================================
       SIDEBAR NAVIGATION
  ========================================================= -->

  <ul class="sidebar-menu">


    <!-- ======================================================
         MENU BUTTON — FIRST ITEM
    ====================================================== -->

    <li class="sidebar-item">

      <button
        type="button"
        id="sidebarMenuButton"
        class="sidebar-menu-button"
        aria-label="Open navigation menu"
        aria-expanded="false"
      >

        <span
          class="sidebar-menu-icon"
          aria-hidden="true"
        >
          ☰
        </span>

        <span class="sidebar-label">
          Menu
        </span>

      </button>

    </li>


    <!-- ======================================================
         DASHBOARD
    ====================================================== -->

    <li class="sidebar-item">

      <a
        href="/"
        class="sidebar-link active"
        title="Dashboard"
      >

        <span
          class="sidebar-icon"
          aria-hidden="true"
        >
          ⌂
        </span>

        <span class="sidebar-label">
          Dashboard
        </span>

      </a>

    </li>


    <% if (user && user.role === "admin") { %>


      <!-- ====================================================
           DAIRY ACTIVITIES
      ==================================================== -->

      <li class="sidebar-item">

        <button
          type="button"
          id="dairyActivitiesButton"
          class="sidebar-section-button"
          aria-expanded="false"
          aria-controls="dairyActivitiesSubmenu"
        >

          <span
            class="sidebar-icon"
            aria-hidden="true"
          >
            🐄
          </span>

          <span class="sidebar-label">
            Dairy Activities
          </span>

          <span
            class="sidebar-section-arrow"
            aria-hidden="true"
          >
            ▶
          </span>

        </button>


        <!-- ==================================================
             DAIRY ACTIVITIES SUBMENU
        =================================================== -->

        <ul
          id="dairyActivitiesSubmenu"
          class="sidebar-submenu"
        >


          <!-- ================================================
               ADD AN ASSET
          ================================================= -->

          <li class="sidebar-item">

            <a
              href="/add"
              class="sidebar-link"
              title="Add an Asset"
            >

              <span
                class="sidebar-icon"
                aria-hidden="true"
              >
                ＋
              </span>

              <span class="sidebar-label">
                Add an Asset
              </span>

            </a>

          </li>


          <!-- ================================================
               RECORD MILK PRODUCTION
          ================================================= -->

          <li class="sidebar-item">

            <a
              href="/milk"
              class="sidebar-link"
              title="Record Milk Production"
            >

              <span
                class="sidebar-icon"
                aria-hidden="true"
              >
                🥛
              </span>

              <span class="sidebar-label">
                Record Milk Production
              </span>

            </a>

          </li>


          <!-- ================================================
               RECORD MILK SALES
          ================================================= -->

          <li class="sidebar-item">

            <a
              href="/sales"
              class="sidebar-link"
              title="Record Milk Sales"
            >

              <span
                class="sidebar-icon"
                aria-hidden="true"
              >
                💰
              </span>

              <span class="sidebar-label">
                Record Milk Sales
              </span>

            </a>

          </li>


          <!-- ================================================
               MILK STATISTICS
          ================================================= -->

          <li class="sidebar-item">

            <a
              href="/stats"
              class="sidebar-link"
              title="Milk Statistics"
            >

              <span
                class="sidebar-icon"
                aria-hidden="true"
              >
                📊
              </span>

              <span class="sidebar-label">
                Milk Statistics
              </span>

            </a>

          </li>


        </ul>

      </li>


      <!-- ====================================================
           VIEW ASSETS
      ==================================================== -->

      <li class="sidebar-item">

        <a
          href="/networth"
          class="sidebar-link"
          title="View Assets"
        >

          <span
            class="sidebar-icon"
            aria-hidden="true"
          >
            👁
          </span>

          <span class="sidebar-label">
            View Assets
          </span>

        </a>

      </li>


      <!-- ====================================================
           FINANCIALS
      ==================================================== -->

      <li class="sidebar-item">

        <a
          href="/financials/summary"
          class="sidebar-link"
          title="Financials"
        >

          <span
            class="sidebar-icon"
            aria-hidden="true"
          >
            💱
          </span>

          <span class="sidebar-label">
            Financials
          </span>

        </a>

      </li>


    <% } %>


  </ul>


  <!-- ========================================================
       SIDEBAR FOOTER
  ========================================================= -->

  <div class="sidebar-footer">

    Chesi Project Management System

  </div>


</aside>


<!-- ==========================================================
     OUTSIDE-CLICK OVERLAY
========================================================== -->

<div
  id="sidebarOverlay"
  class="sidebar-overlay"
  aria-hidden="true"
></div>


<!-- ==========================================================
     MAIN PAGE CONTENT
========================================================== -->

<main class="main-content">

  <div class="page">


    <!-- ======================================================
         HERO SECTION
    ====================================================== -->

    <section class="hero">

      <div class="hero-content">


        <div class="hero-kicker">
          Chesi Project Management System
        </div>


        <h1>

          Welcome,

          <span>
            <%= user && user.name ? user.name : "User" %>
          </span>

        </h1>


        <p>

          Welcome to the Chesi Project Management System.
          Use this space to keep track of our projects, assets,
          production, sales, and financial activities. Navigate
          through the system to update records, monitor progress,
          and help us maintain accurate information for better
          project management and decision-making. Thank you for
          being part of the work.

        </p>


      </div>

    </section>


  </div>

</main>


<!-- ==========================================================
     SIDEBAR JAVASCRIPT
========================================================== -->

<script>
(function () {

  const sidebar =
    document.getElementById(
      "dashboardSidebar"
    );


  const overlay =
    document.getElementById(
      "sidebarOverlay"
    );


  const menuButton =
    document.getElementById(
      "sidebarMenuButton"
    );


  const dairyActivitiesButton =
    document.getElementById(
      "dairyActivitiesButton"
    );


  const dairyActivitiesSubmenu =
    document.getElementById(
      "dairyActivitiesSubmenu"
    );


  /* ========================================================
     SAFETY CHECK
  ========================================================= */

  if (
    !sidebar ||
    !overlay ||
    !menuButton
  ) {

    return;

  }


  /* ========================================================
     OPEN SIDEBAR
  ========================================================= */

  function openSidebar() {

    sidebar.classList.add("open");

    overlay.classList.add("active");


    sidebar.setAttribute(
      "aria-expanded",
      "true"
    );


    menuButton.setAttribute(
      "aria-expanded",
      "true"
    );


    overlay.setAttribute(
      "aria-hidden",
      "false"
    );

  }


  /* ========================================================
     CLOSE DAIRY ACTIVITIES
  ========================================================= */

  function closeDairyActivities() {

    if (
      !dairyActivitiesButton ||
      !dairyActivitiesSubmenu
    ) {

      return;

    }


    dairyActivitiesButton.setAttribute(
      "aria-expanded",
      "false"
    );


    dairyActivitiesButton.classList.remove(
      "expanded"
    );


    dairyActivitiesSubmenu.classList.remove(
      "open"
    );

  }


  /* ========================================================
     CLOSE SIDEBAR
  ========================================================= */

  function closeSidebar() {

    sidebar.classList.remove("open");

    overlay.classList.remove("active");


    sidebar.setAttribute(
      "aria-expanded",
      "false"
    );


    menuButton.setAttribute(
      "aria-expanded",
      "false"
    );


    overlay.setAttribute(
      "aria-hidden",
      "true"
    );


    /*
     * Also close Dairy Activities.
     */

    closeDairyActivities();

  }


  /* ========================================================
     MENU BUTTON
     --------------------------------------------------------
     Opens the sidebar.
  ========================================================= */

  menuButton.addEventListener(
    "click",
    function (event) {

      event.preventDefault();

      event.stopPropagation();

      openSidebar();

    }
  );


  /* ========================================================
     DAIRY ACTIVITIES TOGGLE
  ========================================================= */

  if (
    dairyActivitiesButton &&
    dairyActivitiesSubmenu
  ) {

    dairyActivitiesButton.addEventListener(
      "click",
      function (event) {

        event.preventDefault();

        event.stopPropagation();


        /*
         * If sidebar is closed, first open it.
         */

        if (
          !sidebar.classList.contains("open")
        ) {

          openSidebar();

          return;

        }


        const isExpanded =
          dairyActivitiesButton.getAttribute(
            "aria-expanded"
          ) === "true";


        dairyActivitiesButton.setAttribute(
          "aria-expanded",
          String(!isExpanded)
        );


        dairyActivitiesButton.classList.toggle(
          "expanded",
          !isExpanded
        );


        dairyActivitiesSubmenu.classList.toggle(
          "open",
          !isExpanded
        );

      }
    );

  }


  /* ========================================================
     COLLAPSED SIDEBAR RAIL
     --------------------------------------------------------
     When the sidebar is closed, tapping anywhere on the
     visible icon rail opens it.
  ========================================================= */

  sidebar.addEventListener(
    "click",
    function (event) {

      /*
       * If already open, allow normal interactions.
       */

      if (
        sidebar.classList.contains("open")
      ) {

        return;

      }


      /*
       * Sidebar is collapsed.
       *
       * Any tap on the visible rail opens it.
       */

      event.preventDefault();

      event.stopPropagation();

      openSidebar();

    }
  );


  /* ========================================================
     SIDEBAR LINKS
     --------------------------------------------------------
     When open, links navigate normally.
  ========================================================= */

  const sidebarLinks =
    sidebar.querySelectorAll(
      ".sidebar-link"
    );


  sidebarLinks.forEach(
    function (link) {

      link.addEventListener(
        "click",
        function (event) {

          /*
           * If sidebar is closed, tapping the link should
           * only open the sidebar.
           */

          if (
            !sidebar.classList.contains("open")
          ) {

            event.preventDefault();

            openSidebar();

            return;

          }


          /*
           * Sidebar is open.
           *
           * Allow normal navigation.
           */

        }
      );

    }
  );


  /* ========================================================
     OUTSIDE CLICK
     --------------------------------------------------------
     Clicking the overlay closes the sidebar.
  ========================================================= */

  overlay.addEventListener(
    "click",
    function () {

      closeSidebar();

    }
  );


  /* ========================================================
     ESCAPE KEY
  ========================================================= */

  document.addEventListener(
    "keydown",
    function (event) {

      if (
        event.key === "Escape"
      ) {

        closeSidebar();

      }

    }
  );


  /* ========================================================
     WINDOW RESIZE
  ========================================================= */

  window.addEventListener(
    "resize",
    function () {

      closeSidebar();

    }
  );


})();
</script>