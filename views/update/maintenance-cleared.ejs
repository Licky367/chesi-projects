<!-- ==========================================================
     MAINTENANCE RECORD - COMPLETED
========================================================== -->

<article
    class="feed-card maintenance-card maintenance-cleared-card"
    data-id="<%= item._id %>"
    data-type="maintenance"
>


    <!-- =================================================
         HEADER
         Format:

         User Name about Dairy Name
         Date and time
    ================================================== -->

    <div class="feed-header">


        <!-- USER -->

        <div class="feed-user">

            <img
                src="<%= item.userImage || ('https://ui-avatars.com/api/?name=' + encodeURIComponent(item.userName || 'User')) %>"
                class="avatar-sm"
                alt="<%= item.userName || 'User' %>"
            >


            <div class="feed-user-info">


                <!-- =========================================
                     USER + DAIRY
                ========================================== -->

                <div class="post-meta-line">

                    <strong class="post-user-name">

                        <%= item.userName || "User" %>

                    </strong>


                    <% if (item.dairyName) { %>

                        <span class="post-meta-action">

                            about

                        </span>


                        <% if (item.dairyId) { %>

                            <a
                                href="/dairy/<%= item.dairyId %>"
                                class="post-subject"
                                title="View <%= item.dairyName %>"
                            >

                                <%= item.dairyName %>

                            </a>

                        <% } else { %>

                            <span class="post-subject">

                                <%= item.dairyName %>

                            </span>

                        <% } %>

                    <% } %>

                </div>


                <!-- =========================================
                     DATE / TIME
                ========================================== -->

                <small class="post-time">

                    <%= item.dateText || "" %>

                </small>


            </div>

        </div>



        <!-- =================================================
             DELETE MAINTENANCE
        ================================================== -->

        <% if (
            user &&
            (
                user.role === "admin" ||
                (
                    user._id &&
                    item.userId &&
                    user._id.toString() ===
                    item.userId.toString()
                )
            )
        ) { %>


            <button
                class="delete-post"
                data-id="<%= item._id %>"
                data-type="maintenance"
                title="Delete Maintenance Record"
                aria-label="Delete Maintenance Record"
                type="button"
            >

                <i
                    class="bi bi-trash3-fill"
                    aria-hidden="true"
                ></i>

            </button>


        <% } %>


    </div>



    <!-- =================================================
         BODY
    ================================================== -->

    <div class="feed-body">


        <!-- =============================================
             HEADING
        ============================================== -->

        <h3>

            ✅ Maintenance Completed

        </h3>



        <!-- =============================================
             STATUS
        ============================================== -->

        <div class="maintenance-status cleared">

            Status:

            <strong>

                Completed

            </strong>

        </div>



        <!-- =============================================
             MAINTENANCE TYPE
        ============================================== -->

        <% if (item.maintenanceType) { %>

            <p>

                <strong>Type:</strong>

                <%= item.maintenanceType %>

            </p>

        <% } %>



        <!-- =============================================
             TITLE
        ============================================== -->

        <% if (item.title) { %>

            <p>

                <strong>Title:</strong>

                <%= item.title %>

            </p>

        <% } %>



        <!-- =============================================
             DESCRIPTION
        ============================================== -->

        <% if (item.description) { %>

            <p>

                <%= item.description %>

            </p>

        <% } %>



        <!-- =============================================
             CHARGES
        ============================================== -->

        <% if (item.charges) { %>

            <p>

                <strong>Charges:</strong>

                KES <%= item.charges %>

            </p>

        <% } %>


    </div>



    <!-- =================================================
         ACTIONS
    ================================================== -->

    <%- include("partials/feed-actions", {
        item,
        type: "maintenance"
    }) %>



    <!-- =================================================
         COMMENTS
    ================================================== -->

    <%- include("comment-section", {
        item,
        user,
        type: "maintenance"
    }) %>


</article>



<!-- =========================================================
     MAINTENANCE COMPLETED CARD CSS
     
     Header is intentionally structured as:

         User about Dairy
         Date / time

     Body begins immediately after header.
========================================================= -->

<style>

.maintenance-cleared-card .feed-header {

    display: flex;

    align-items: center;

    justify-content: space-between;

    width: 100%;

    box-sizing: border-box;

    padding: 11px 14px 9px;

    border-bottom: 1px solid #e6ece8;

}


.maintenance-cleared-card .feed-user {

    min-width: 0;

    display: flex;

    align-items: center;

    gap: 10px;

}


.maintenance-cleared-card .feed-user-info {

    min-width: 0;

    display: block;

}


.maintenance-cleared-card .post-meta-line {

    display: block;

    margin: 0;

    padding: 0;

    color: #202520;

    font-size: 14px;

    line-height: 1.35;

}


.maintenance-cleared-card .post-user-name {

    color: #202520;

    font-size: 14px;

    font-weight: 700;

}


.maintenance-cleared-card .post-meta-action {

    margin: 0 4px;

    color: #727b75;

    font-size: 13px;

    font-weight: 400;

}


.maintenance-cleared-card .post-subject {

    color: #198754;

    font-size: 14px;

    font-weight: 700;

    text-decoration: none;

}


.maintenance-cleared-card a.post-subject:hover {

    color: #146c43;

    text-decoration: underline;

}


.maintenance-cleared-card .post-time {

    display: block;

    margin: 2px 0 0;

    padding: 0;

    color: #89928c;

    font-size: 11px;

    line-height: 1.2;

}


.maintenance-cleared-card .feed-body {

    border-bottom: 1px solid #e6ece8;

}


.maintenance-cleared-card .feed-body p {

    margin-top: 0;

}


@media (max-width: 600px) {

    .maintenance-cleared-card .feed-header {

        padding:
            9px
            12px
            8px;

    }


    .maintenance-cleared-card .post-meta-line {

        font-size: 13px;

    }


    .maintenance-cleared-card .post-user-name {

        font-size: 13px;

    }


    .maintenance-cleared-card .post-subject {

        font-size: 13px;

    }


    .maintenance-cleared-card .post-meta-action {

        font-size: 12px;

    }


    .maintenance-cleared-card .post-time {

        font-size: 10px;

    }

}

</style>