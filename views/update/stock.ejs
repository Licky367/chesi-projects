<% /*
==============================================================
STOCK UPDATE FEED CARD

FILE:
    views/update/stock.ejs

PURPOSE:
    Render ONE stock history update.

IMPORTANT:
--------------------------------------------------------------
This partial represents exactly ONE Update document.

The parent page passes:

    include("stock", {
        item: item,
        user: user
    })

Therefore this file MUST use:

    item

for the Update document.

There is NO variable named:

    update

Every Update document gets its own card.

EXPECTED DATA:
--------------------------------------------------------------
    item.type
    item.stock
    item.user
    item.userName
    item.userImage
    item.authorRole
    item.title
    item.text
    item.images
    item.createdAt

STOCK DATA:
--------------------------------------------------------------
    item.stock.stockType
    item.stock.action
    item.stock.itemName
    item.stock.category
    item.stock.quantity
    item.stock.unit
    item.stock.price
    item.stock.instructions
    item.stock.expectedDuration
    item.stock.message
    item.stock.images
==============================================================
*/ %>


<%
/* ==========================================================
   SAFETY

   IMPORTANT:
   The parent page passes the feed document as "item".
========================================================== */

const stockUpdate =
    item || null;


const stockData =
    stockUpdate &&
    stockUpdate.stock
        ? stockUpdate.stock
        : null;


/* ==========================================================
   STOP IF THIS IS NOT A STOCK UPDATE
========================================================== */

const isStockUpdate =
    !!(
        stockUpdate &&
        stockUpdate.type === "stock" &&
        stockData
    );


/* ==========================================================
   BASIC STOCK VALUES
========================================================== */

const stockType =
    stockData
        ? (
            stockData.stockType ||
            stockData.category ||
            "feed"
        )
        : "feed";


const stockAction =
    stockData
        ? (
            stockData.action ||
            ""
        )
        : "";


const itemName =
    stockData
        ? (
            stockData.itemName ||
            stockData.name ||
            "Unnamed Stock"
        )
        : "Unnamed Stock";


const quantity =
    stockData &&
    stockData.quantity !== undefined &&
    stockData.quantity !== null
        ? Number(stockData.quantity)
        : 0;


const unit =
    stockData
        ? (
            stockData.unit ||
            "units"
        )
        : "units";


/* ==========================================================
   STOCK CATEGORY
========================================================== */

const isMedicine =
    stockType === "medicine";


/* ==========================================================
   ACTION LABEL
========================================================== */

let actionLabel =
    "Stock Update";


if (stockAction === "available") {

    actionLabel =
        "Stock Available";

}


if (stockAction === "remainder") {

    actionLabel =
        "Remaining Stock";

}


/* ==========================================================
   AUTHOR
========================================================== */

const authorName =
    stockUpdate.userName ||
    (
        stockUpdate.user &&
        stockUpdate.user.name
    ) ||
    (
        stockUpdate.authorRole === "system"
            ? "System"
            : "User"
    );


const authorImage =
    stockUpdate.userImage ||
    (
        stockUpdate.user &&
        stockUpdate.user.profileImage
    ) ||
    "/images/h1.png";


/* ==========================================================
   MESSAGE
========================================================== */

const message =
    (
        stockData &&
        stockData.message
    ) ||
    stockUpdate.text ||
    "";


/* ==========================================================
   INSTRUCTIONS
========================================================== */

const instructions =
    stockData &&
    stockData.instructions
        ? stockData.instructions
        : "";


/* ==========================================================
   EXPECTED DURATION
========================================================== */

const expectedDuration =
    stockData &&
    stockData.expectedDuration
        ? stockData.expectedDuration
        : "";


/* ==========================================================
   IMAGES

   Stock-specific images first.

   Fall back to the Update document's images.

   NEVER merge images from another Update.
========================================================== */

let stockImages = [];


if (
    stockData &&
    Array.isArray(stockData.images)
) {

    stockImages =
        stockData.images.filter(Boolean);

}


if (
    stockImages.length === 0 &&
    stockUpdate &&
    Array.isArray(stockUpdate.images)
) {

    stockImages =
        stockUpdate.images.filter(Boolean);

}


/* ==========================================================
   UNIQUE CARD ID

   Always identify the individual Update document.

   Do NOT use:

       itemName
       category
       stockType
========================================================== */

const cardId =
    stockUpdate &&
    stockUpdate._id
        ? String(stockUpdate._id)
        : (
            "stock-" +
            Math.random()
        );


/* ==========================================================
   DATE
========================================================== */

const createdAt =
    stockUpdate &&
    stockUpdate.createdAt
        ? new Date(stockUpdate.createdAt)
        : null;

%>


<% if (isStockUpdate) { %>


<!-- ==========================================================
     ONE STOCK UPDATE CARD

     ONE item / Update document = ONE card.
========================================================== -->

<article
    class="stock-update-card"
    id="stock-update-<%= cardId %>"
    data-stock-update-id="<%= cardId %>"
    data-stock-type="<%= stockType %>"
    data-stock-action="<%= stockAction %>"
>


    <!-- ======================================================
         HEADER
    ======================================================= -->

    <header class="stock-update-card__header">


        <!-- ==================================================
             AUTHOR
        =================================================== -->

        <div class="stock-update-card__author">


            <div class="stock-update-card__avatar">

                <img
                    src="<%= authorImage %>"
                    alt=""
                    loading="lazy"
                    onerror="this.onerror=null;this.src='/images/h1.png';"
                >

            </div>


            <div class="stock-update-card__author-info">

                <strong>
                    <%= authorName %>
                </strong>


                <span>

                    <% if (
                        stockUpdate.authorRole === "system"
                    ) { %>

                        System

                    <% } else if (
                        stockUpdate.authorRole === "admin"
                    ) { %>

                        Administrator

                    <% } else { %>

                        Dairy Worker

                    <% } %>

                </span>

            </div>


        </div>



        <!-- ==================================================
             DATE
        =================================================== -->

        <% if (createdAt) { %>

            <time
                class="stock-update-card__date"
                datetime="<%= createdAt.toISOString() %>"
            >

                <%= createdAt.toLocaleString() %>

            </time>

        <% } %>


    </header>



    <!-- ======================================================
         TITLE / ACTION
    ======================================================= -->

    <div class="stock-update-card__heading">


        <div
            class="stock-update-card__icon"
            aria-hidden="true"
        >

            <% if (isMedicine) { %>

                💊

            <% } else { %>

                🌾

            <% } %>

        </div>


        <div>

            <span class="stock-update-card__action">
                <%= actionLabel %>
            </span>


            <h3>
                <%= stockUpdate.title || itemName %>
            </h3>

        </div>


    </div>



    <!-- ======================================================
         STOCK INFORMATION
    ======================================================= -->

    <div class="stock-update-card__stock">


        <div class="stock-update-card__item">

            <span class="stock-update-card__label">
                Stock
            </span>


            <strong>
                <%= itemName %>
            </strong>

        </div>



        <div class="stock-update-card__quantity">

            <span class="stock-update-card__label">
                Quantity
            </span>


            <strong>

                <%= quantity.toLocaleString() %>

                <small>
                    <%= unit %>
                </small>

            </strong>

        </div>


    </div>



    <!-- ======================================================
         MESSAGE
    ======================================================= -->

    <% if (message) { %>

        <div class="stock-update-card__message">

            <p>
                <%= message %>
            </p>

        </div>

    <% } %>



    <!-- ======================================================
         INSTRUCTIONS
    ======================================================= -->

    <% if (instructions) { %>

        <div class="stock-update-card__detail">

            <span>
                Instructions
            </span>


            <p>
                <%= instructions %>
            </p>

        </div>

    <% } %>



    <!-- ======================================================
         EXPECTED DURATION
    ======================================================= -->

    <% if (expectedDuration) { %>

        <div class="stock-update-card__detail">

            <span>
                Expected duration
            </span>


            <p>
                <%= expectedDuration %>
            </p>

        </div>

    <% } %>



    <!-- ======================================================
         IMAGES
    ======================================================= -->

    <% if (stockImages.length > 0) { %>

        <div class="stock-update-card__images">

            <% stockImages.forEach(
                function(image, imageIndex)
            { %>

                <img
                    src="<%= image %>"
                    alt="<%= itemName %>"
                    loading="lazy"
                    data-stock-image-index="<%= imageIndex %>"
                >

            <% }); %>

        </div>

    <% } %>


</article>



<style>

/* ==========================================================
   STOCK UPDATE CARD
========================================================== */

.stock-update-card,
.stock-update-card * {

    box-sizing: border-box;

}


.stock-update-card {

    width: 100%;

    margin: 0 0 14px;

    padding: 16px;

    border: 1px solid #e0e8e3;

    border-radius: 16px;

    background: #ffffff;

    box-shadow:
        0 2px 8px
        rgba(25, 60, 40, .05);

}



/* ==========================================================
   HEADER
========================================================== */

.stock-update-card__header {

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 12px;

    margin-bottom: 14px;

}


.stock-update-card__author {

    display: flex;

    align-items: center;

    gap: 10px;

    min-width: 0;

}


.stock-update-card__avatar {

    width: 40px;
    height: 40px;

    flex: 0 0 40px;

    overflow: hidden;

    border-radius: 50%;

    background: #edf5ef;

}


.stock-update-card__avatar img {

    width: 100%;
    height: 100%;

    display: block;

    object-fit: cover;

}


.stock-update-card__author-info {

    display: flex;

    flex-direction: column;

    min-width: 0;

    gap: 2px;

}


.stock-update-card__author-info strong {

    overflow: hidden;

    color: #27342d;

    font-size: 13px;

    font-weight: 800;

    white-space: nowrap;

    text-overflow: ellipsis;

}


.stock-update-card__author-info span {

    color: #8a938e;

    font-size: 10px;

}


.stock-update-card__date {

    flex-shrink: 0;

    color: #929a95;

    font-size: 9px;

}



/* ==========================================================
   HEADING
========================================================== */

.stock-update-card__heading {

    display: flex;

    align-items: center;

    gap: 11px;

    margin-bottom: 14px;

}


.stock-update-card__icon {

    width: 42px;
    height: 42px;

    flex: 0 0 42px;

    display: flex;

    align-items: center;

    justify-content: center;

    border-radius: 12px;

    background: #eef7f1;

    font-size: 20px;

}


.stock-update-card__action {

    display: block;

    margin-bottom: 2px;

    color: #198754;

    font-size: 9px;

    font-weight: 900;

    letter-spacing: .6px;

    text-transform: uppercase;

}


.stock-update-card__heading h3 {

    margin: 0;

    color: #26352d;

    font-size: 16px;

    font-weight: 850;

    line-height: 1.25;

}



/* ==========================================================
   STOCK DATA
========================================================== */

.stock-update-card__stock {

    display: grid;

    grid-template-columns: 1fr auto;

    gap: 14px;

    padding: 13px;

    border-radius: 11px;

    background: #f6faf7;

}


.stock-update-card__item,
.stock-update-card__quantity {

    display: flex;

    flex-direction: column;

    gap: 4px;

}


.stock-update-card__label {

    color: #8a948e;

    font-size: 9px;

    font-weight: 800;

    text-transform: uppercase;

    letter-spacing: .5px;

}


.stock-update-card__item strong {

    color: #29372f;

    font-size: 13px;

    font-weight: 800;

}


.stock-update-card__quantity {

    text-align: right;

}


.stock-update-card__quantity strong {

    color: #198754;

    font-size: 18px;

    font-weight: 900;

}


.stock-update-card__quantity small {

    color: #748078;

    font-size: 10px;

    font-weight: 700;

}



/* ==========================================================
   MESSAGE
========================================================== */

.stock-update-card__message {

    margin-top: 13px;

    padding: 11px 12px;

    border-left: 3px solid #198754;

    border-radius: 0 9px 9px 0;

    background: #f7faf8;

}


.stock-update-card__message p {

    margin: 0;

    color: #4f5c54;

    font-size: 12px;

    line-height: 1.55;

}



/* ==========================================================
   DETAILS
========================================================== */

.stock-update-card__detail {

    margin-top: 12px;

}


.stock-update-card__detail > span {

    display: block;

    margin-bottom: 4px;

    color: #748078;

    font-size: 9px;

    font-weight: 900;

    letter-spacing: .5px;

    text-transform: uppercase;

}


.stock-update-card__detail p {

    margin: 0;

    color: #4e5b53;

    font-size: 11px;

    line-height: 1.5;

}



/* ==========================================================
   IMAGES
========================================================== */

.stock-update-card__images {

    display: grid;

    grid-template-columns:
        repeat(
            auto-fit,
            minmax(90px, 1fr)
        );

    gap: 7px;

    margin-top: 13px;

}


.stock-update-card__images img {

    width: 100%;

    aspect-ratio: 1 / 1;

    display: block;

    overflow: hidden;

    border-radius: 9px;

    object-fit: cover;

    background: #f1f4f2;

}



/* ==========================================================
   MOBILE
========================================================== */

@media (max-width: 600px) {

    .stock-update-card {

        padding: 13px;

        border-radius: 14px;

    }


    .stock-update-card__header {

        align-items: flex-start;

    }


    .stock-update-card__date {

        font-size: 8px;

    }


    .stock-update-card__stock {

        grid-template-columns: 1fr auto;

    }

}

</style>


<% } %>