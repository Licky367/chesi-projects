<% /*
==============================================================
STOCK FEED ITEM

FILE:
    views/updates/stock.ejs

PURPOSE:
    Render feed-store stock announcements and subsequent
    stock updates inside the normal Updates feed.

SYSTEM STOCK ANNOUNCEMENT:
    Uses /images/h1.png
    Sender = System

WORKER STOCK UPDATE:
    Uses the actual user's profile image/name.

EXPECTED:
    update
    dairy
==============================================================
*/ %>


<%
    const isSystem =
        update &&
        (
            update.authorType === "system" ||
            update.source === "system" ||
            update.isSystem === true ||
            update.userName === "System"
        );

    const isMedicine =
        update &&
        (
            update.category === "medicine" ||
            update.stockType === "medicine" ||
            update.type === "medicine"
        );

    const senderName =
        isSystem
            ? "System"
            : (
                update.userName ||
                (
                    update.user &&
                    update.user.name
                ) ||
                "User"
            );

    const senderImage =
        isSystem
            ? "/images/h1.png"
            : (
                update.userImage ||
                (
                    update.user &&
                    update.user.profileImage
                ) ||
                "/images/h1.png"
            );

    const title =
        update.title ||
        (
            isSystem
                ? (
                    isMedicine
                        ? "More Veterinary Meds Available"
                        : "More Animal Feed Available"
                )
                : "Foodstock Update"
        );

    const quantity =
        update.quantity ??
        update.addedQuantity ??
        update.quantityRemaining ??
        update.amount;

    const unit =
        update.unit ||
        "";

    const instructions =
        update.instructions ||
        update.usageInstructions ||
        "";

    const duration =
        update.expectedDuration ||
        update.duration ||
        "";

    const message =
        update.message ||
        update.text ||
        "";

    const images =
        Array.isArray(update.images)
            ? update.images
            : [];

    const created =
        update.createdAt
            ? new Date(update.createdAt)
            : new Date();
%>



<article
    class="stock-feed-item"
    data-update-id="<%= update._id || "" %>"
>


    <!-- ======================================================
         HEADER
    ======================================================= -->

    <header class="stock-feed-header">


        <!-- ==================================================
             PROFILE IMAGE
        =================================================== -->

        <div class="stock-feed-avatar">

            <img
                src="<%= senderImage %>"
                alt="<%= senderName %>"
                loading="lazy"
            >

        </div>



        <!-- ==================================================
             AUTHOR + DATE
        =================================================== -->

        <div class="stock-feed-author">

            <div class="stock-feed-author-line">

                <strong>
                    <%= senderName %>
                </strong>

            </div>


            <div class="stock-feed-context">

                <% if (isSystem) { %>

                    The System updated

                    <a
                        href="/dairy/<%= dairy._id %>"
                        class="stock-feed-dairy-link"
                    >
                        <%= dairy.name %>'s Foodstock
                    </a>

                <% } else { %>

                    updated

                    <a
                        href="/dairy/<%= dairy._id %>"
                        class="stock-feed-dairy-link"
                    >
                        <%= dairy.name %>'s Foodstock
                    </a>

                <% } %>

            </div>


            <time
                class="stock-feed-date"
                datetime="<%= created.toISOString() %>"
            >
                <%= created.toLocaleString() %>
            </time>

        </div>


    </header>



    <!-- ======================================================
         BODY
    ======================================================= -->

    <div class="stock-feed-body">


        <!-- ==================================================
             TITLE
        =================================================== -->

        <h3 class="stock-feed-title">

            <%= title %>

        </h3>



        <!-- ==================================================
             STOCK DETAILS
        =================================================== -->

        <div class="stock-feed-details">


            <% if (
                quantity !== undefined &&
                quantity !== null &&
                quantity !== ""
            ) { %>

                <div class="stock-feed-detail">

                    <span class="stock-feed-detail-label">
                        <%= isSystem
                            ? "Added quantity"
                            : "Quantity remaining" %>
                    </span>

                    <strong>

                        <%= Number(quantity).toLocaleString() %>

                        <% if (unit) { %>

                            <%= unit %>

                        <% } %>

                    </strong>

                </div>

            <% } %>



            <% if (duration) { %>

                <div class="stock-feed-detail">

                    <span class="stock-feed-detail-label">
                        Expected duration
                    </span>

                    <strong>
                        <%= duration %>
                    </strong>

                </div>

            <% } %>


        </div>



        <!-- ==================================================
             INSTRUCTIONS
        =================================================== -->

        <% if (instructions) { %>

            <div class="stock-feed-instructions">

                <div class="stock-feed-subheading">
                    Instructions of use
                </div>

                <p>
                    <%= instructions %>
                </p>

            </div>

        <% } %>



        <!-- ==================================================
             WORKER MESSAGE
        =================================================== -->

        <% if (message) { %>

            <div class="stock-feed-message">

                <%= message %>

            </div>

        <% } %>



        <!-- ==================================================
             IMAGES
        =================================================== -->

        <% if (images.length > 0) { %>

            <div class="stock-feed-images">

                <% images.forEach(function(image) { %>

                    <% if (image) { %>

                        <img
                            src="<%= image %>"
                            alt="Foodstock"
                            loading="lazy"
                        >

                    <% } %>

                <% }); %>

            </div>

        <% } %>


    </div>


</article>



<style>

/* ==========================================================
   STOCK FEED ITEM
========================================================== */

.stock-feed-item {

    width: 100%;

    padding: 16px 0 19px;

    border-bottom: 1px solid #e5ebe7;

}


.stock-feed-item:last-child {

    border-bottom: none;

}



/* ==========================================================
   HEADER
========================================================== */

.stock-feed-header {

    display: flex;

    align-items: flex-start;

    gap: 11px;

}


.stock-feed-avatar {

    width: 44px;
    height: 44px;

    flex: 0 0 44px;

    overflow: hidden;

    border-radius: 50%;

    background: #edf5ef;

}


.stock-feed-avatar img {

    width: 100%;
    height: 100%;

    display: block;

    object-fit: cover;

}


.stock-feed-author {

    min-width: 0;

    padding-top: 1px;

}


.stock-feed-author-line {

    display: flex;
    align-items: center;

}


.stock-feed-author-line strong {

    color: #26352d;

    font-size: 13px;
    font-weight: 850;

}


.stock-feed-context {

    margin-top: 2px;

    color: #68756e;

    font-size: 11px;

    line-height: 1.4;

}


.stock-feed-dairy-link {

    color: #198754;

    font-weight: 750;

    text-decoration: none;

}


.stock-feed-dairy-link:hover {

    text-decoration: underline;

}


.stock-feed-date {

    display: block;

    margin-top: 3px;

    color: #99a19c;

    font-size: 10px;

}



/* ==========================================================
   BODY
========================================================== */

.stock-feed-body {

    margin-left: 55px;

    margin-top: 13px;

}


.stock-feed-title {

    margin: 0 0 12px;

    color: #198754;

    font-size: 18px;
    line-height: 1.3;

    font-weight: 900;

}



/* ==========================================================
   DETAILS
========================================================== */

.stock-feed-details {

    display: flex;
    flex-wrap: wrap;

    gap: 8px;

    margin-bottom: 12px;

}


.stock-feed-detail {

    min-width: 150px;

    padding: 9px 11px;

    border-radius: 10px;

    background: #f3f8f4;

}


.stock-feed-detail-label {

    display: block;

    margin-bottom: 3px;

    color: #829087;

    font-size: 9px;
    font-weight: 800;

    text-transform: uppercase;

    letter-spacing: .4px;

}


.stock-feed-detail strong {

    color: #245a3b;

    font-size: 13px;
    font-weight: 850;

}



/* ==========================================================
   INSTRUCTIONS
========================================================== */

.stock-feed-instructions {

    margin-top: 8px;

    padding: 11px 13px;

    border-left: 3px solid #198754;

    border-radius: 0 9px 9px 0;

    background: #f7faf8;

}


.stock-feed-subheading {

    margin-bottom: 4px;

    color: #31553f;

    font-size: 10px;
    font-weight: 850;

    text-transform: uppercase;

    letter-spacing: .5px;

}


.stock-feed-instructions p {

    margin: 0;

    color: #4f5d55;

    font-size: 12px;

    line-height: 1.55;

    white-space: pre-wrap;

}



/* ==========================================================
   MESSAGE
========================================================== */

.stock-feed-message {

    margin-top: 12px;

    color: #4e5b54;

    font-size: 13px;

    line-height: 1.6;

    white-space: pre-wrap;

}



/* ==========================================================
   IMAGES
========================================================== */

.stock-feed-images {

    display: flex;

    gap: 7px;

    margin-top: 13px;

    overflow-x: auto;

    padding-bottom: 3px;

}


.stock-feed-images img {

    width: 125px;
    height: 105px;

    flex: 0 0 125px;

    display: block;

    object-fit: cover;

    border-radius: 10px;

}



/* ==========================================================
   MOBILE
========================================================== */

@media (max-width: 600px) {

    .stock-feed-body {

        margin-left: 0;

        margin-top: 12px;

    }


    .stock-feed-title {

        font-size: 17px;

    }


    .stock-feed-detail {

        flex: 1 1 100%;

        min-width: 0;

    }


    .stock-feed-images img {

        width: 110px;
        height: 92px;

        flex-basis: 110px;

    }

}

</style>