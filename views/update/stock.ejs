<!-- ==========================================================
     DAIRY FEED STOCK REPORT

     FILE:
         views/update/stock.ejs

     PURPOSE:
         Display a Feed Store report inside the chronological
         dairy feed.

     DESIGN:
         ------------------------------------------------------
         This is NOT a social-media post card.

         It is a compact operational report containing:

             • Report title
             • Dairy/feed-store name
             • Date
             • Facility condition
             • Feed quality
             • Estimated stock remaining
             • Report message
             • Optional images
             • Feed actions
             • Comments

         No avatar.
         No "about".
         No social-post header.
         No unnecessary empty space.
========================================================== -->


<%
/* ==========================================================
   DATA
========================================================== */

const stockDairyName =
    item.dairyName ||
    dairy?.name ||
    "Dairy Feed Store";


const stockDate =
    item.dateText ||
    (
        item.createdAt
            ? new Date(item.createdAt).toLocaleString(
                "en-GB",
                {
                    day: "2-digit",
                    month: "short",
                    year: "numeric",
                    hour: "2-digit",
                    minute: "2-digit"
                }
            )
            : ""
    );


/*
 * ----------------------------------------------------------
 * REPORT TEXT
 * ----------------------------------------------------------
 *
 * The current feedsService stores the report as:
 *
 * Facility condition: ...
 *
 * Feed quality: ...
 *
 * Estimated food remaining: ...%
 *
 * Message
 *
 * We preserve that information exactly as supplied.
 */

const reportText =
    item.text ||
    item.description ||
    "";


/*
 * ----------------------------------------------------------
 * OPTIONAL STRUCTURED VALUES
 * ----------------------------------------------------------
 *
 * These are supported if the service/feed mapping supplies
 * them directly in the future.
 */

const condition =
    item.condition ||
    null;


const feedQuality =
    item.feedQuality ||
    null;


const percentageRemaining =
    item.percentageRemaining !== undefined &&
    item.percentageRemaining !== null &&
    item.percentageRemaining !== ""
        ? item.percentageRemaining
        : null;


/*
 * ----------------------------------------------------------
 * IMAGES
 * ----------------------------------------------------------
 */

const stockImages =
    Array.isArray(item.images)
        ? item.images
        : [];

%>



<article
    class="feed-stock-report"
    data-id="<%= item._id %>"
    data-type="stock"
>


    <!-- ======================================================
         REPORT HEADING
    ======================================================= -->

    <header class="feed-stock-report__header">

        <div>

            <p class="feed-stock-report__eyebrow">

                FEED STORE

            </p>


            <h2 class="feed-stock-report__title">

                Dairy Feed Stock Report

            </h2>


            <h3 class="feed-stock-report__dairy">

                <%= stockDairyName %>

            </h3>

        </div>


        <% if (stockDate) { %>

            <time
                class="feed-stock-report__date"
                datetime="<%= item.createdAt || "" %>"
            >

                <%= stockDate %>

            </time>

        <% } %>

    </header>



    <!-- ======================================================
         REPORT CONTENT
    ======================================================= -->

    <section class="feed-stock-report__body">


        <!-- ==================================================
             STRUCTURED REPORT
        =================================================== -->

        <% if (
            condition ||
            feedQuality ||
            percentageRemaining !== null
        ) { %>

            <div class="feed-stock-report__summary">


                <% if (condition) { %>

                    <div class="feed-stock-report__field">

                        <span class="feed-stock-report__label">

                            Facility Condition

                        </span>

                        <strong class="feed-stock-report__value">

                            <%= condition %>

                        </strong>

                    </div>

                <% } %>



                <% if (feedQuality) { %>

                    <div class="feed-stock-report__field">

                        <span class="feed-stock-report__label">

                            Feed Quality

                        </span>

                        <strong class="feed-stock-report__value">

                            <%= feedQuality %>

                        </strong>

                    </div>

                <% } %>



                <% if (percentageRemaining !== null) { %>

                    <div class="feed-stock-report__field">

                        <span class="feed-stock-report__label">

                            Estimated Feed Remaining

                        </span>

                        <strong class="feed-stock-report__value feed-stock-report__value--percentage">

                            <%= percentageRemaining %>%

                        </strong>

                    </div>

                <% } %>


            </div>

        <% } %>



        <!-- ==================================================
             REPORT TEXT
        =================================================== -->

        <% if (reportText) { %>

            <div class="feed-stock-report__message">

                <span class="feed-stock-report__label">

                    Report

                </span>


                <div class="feed-stock-report__message-text">

                    <%
                    const reportLines =
                        reportText
                            .split(/\n+/)
                            .map(line => line.trim())
                            .filter(Boolean);
                    %>


                    <% reportLines.forEach(function(line) { %>

                        <p>

                            <%= line %>

                        </p>

                    <% }); %>

                </div>

            </div>

        <% } %>



        <!-- ==================================================
             IMAGES
        =================================================== -->

        <% if (stockImages.length) { %>

            <div class="feed-stock-report__images">

                <% stockImages.forEach(function(image) { %>

                    <figure class="feed-stock-report__image">

                        <img
                            src="<%= image %>"
                            alt="Feed store report image"
                            loading="lazy"
                        >

                    </figure>

                <% }); %>

            </div>

        <% } %>


    </section>



    <!-- ======================================================
         ACTIONS
    ======================================================= -->

    <div class="feed-stock-report__actions">

        <%- include("partials/feed-actions", {
            item,
            type: "stock"
        }) %>

    </div>



    <!-- ======================================================
         COMMENTS
    ======================================================= -->

    <%- include("comment-section", {
        item,
        user,
        type: "stock"
    }) %>


</article>



<!-- ==========================================================
     STOCK REPORT STYLES
     
     Completely isolated from post.ejs / post.css.
========================================================== -->

<style>

/* ==========================================================
   CONTAINER
========================================================== */

.feed-stock-report {

    width: 100%;

    margin: 16px 0;

    background: #ffffff;

    border: 1px solid #dfe8e1;

    border-left: 5px solid #187a3a;

    border-radius: 14px;

    overflow: hidden;

    box-shadow:
        0 4px 14px rgba(0, 0, 0, 0.06);

}


/* ==========================================================
   HEADER
========================================================== */

.feed-stock-report__header {

    display: flex;

    align-items: flex-start;

    justify-content: space-between;

    gap: 18px;

    padding: 20px 20px 17px;

    background:
        linear-gradient(
            to right,
            #f4faf5,
            #ffffff
        );

    border-bottom: 1px solid #e4ebe5;

}


.feed-stock-report__eyebrow {

    margin: 0 0 5px;

    font-size: 11px;

    font-weight: 800;

    letter-spacing: 1.3px;

    color: #187a3a;

}


.feed-stock-report__title {

    margin: 0;

    font-size: 22px;

    line-height: 1.25;

    font-weight: 800;

    color: #17351f;

}


.feed-stock-report__dairy {

    margin: 5px 0 0;

    font-size: 16px;

    line-height: 1.35;

    font-weight: 600;

    color: #4c6253;

}


.feed-stock-report__date {

    flex-shrink: 0;

    padding-top: 4px;

    font-size: 12px;

    line-height: 1.4;

    color: #6d7c72;

    text-align: right;

}


/* ==========================================================
   BODY
========================================================== */

.feed-stock-report__body {

    padding: 20px;

}


/* ==========================================================
   SUMMARY
========================================================== */

.feed-stock-report__summary {

    display: grid;

    grid-template-columns:
        repeat(
            3,
            minmax(0, 1fr)
        );

    gap: 10px;

    margin-bottom: 18px;

}


.feed-stock-report__field {

    min-width: 0;

    padding: 13px 14px;

    background: #f7faf8;

    border: 1px solid #e3ebe5;

    border-radius: 10px;

}


.feed-stock-report__label {

    display: block;

    margin-bottom: 5px;

    font-size: 11px;

    line-height: 1.3;

    font-weight: 800;

    letter-spacing: .4px;

    text-transform: uppercase;

    color: #718078;

}


.feed-stock-report__value {

    display: block;

    font-size: 15px;

    line-height: 1.35;

    font-weight: 700;

    color: #273b2e;

    overflow-wrap: anywhere;

}


.feed-stock-report__value--percentage {

    color: #187a3a;

}


/* ==========================================================
   REPORT MESSAGE
========================================================== */

.feed-stock-report__message {

    padding-top: 2px;

}


.feed-stock-report__message-text {

    margin-top: 8px;

    color: #39483f;

    font-size: 15px;

    line-height: 1.65;

}


.feed-stock-report__message-text p {

    margin: 0 0 10px;

}


.feed-stock-report__message-text p:last-child {

    margin-bottom: 0;

}


/* ==========================================================
   IMAGES
========================================================== */

.feed-stock-report__images {

    display: grid;

    grid-template-columns:
        repeat(
            auto-fit,
            minmax(
                140px,
                1fr
            )
        );

    gap: 10px;

    margin-top: 20px;

}


.feed-stock-report__image {

    margin: 0;

    overflow: hidden;

    border-radius: 10px;

    background: #f1f4f2;

}


.feed-stock-report__image img {

    display: block;

    width: 100%;

    height: 180px;

    object-fit: cover;

}


/* ==========================================================
   ACTION AREA
========================================================== */

.feed-stock-report__actions {

    border-top: 1px solid #e8eeea;

    padding: 4px 12px;

}


/* ==========================================================
   MOBILE
========================================================== */

@media (max-width: 600px) {

    .feed-stock-report {

        margin: 12px 0;

        border-radius: 12px;

    }


    .feed-stock-report__header {

        padding: 17px 16px 15px;

        gap: 10px;

    }


    .feed-stock-report__title {

        font-size: 20px;

    }


    .feed-stock-report__dairy {

        font-size: 15px;

    }


    .feed-stock-report__date {

        font-size: 11px;

    }


    .feed-stock-report__body {

        padding: 16px;

    }


    .feed-stock-report__summary {

        grid-template-columns: 1fr;

        gap: 8px;

    }


    .feed-stock-report__field {

        padding: 11px 12px;

    }


    .feed-stock-report__message-text {

        font-size: 14px;

        line-height: 1.6;

    }


    .feed-stock-report__images {

        grid-template-columns:
            repeat(
                2,
                minmax(0, 1fr)
            );

    }


    .feed-stock-report__image img {

        height: 135px;

    }

}

</style>