<%
/* ==========================================================
   STOCK PARTIAL — SAFE VARIABLE RESOLUTION
========================================================== */

const currentUpdate =
    (typeof item !== "undefined" && item)
        ? item
        : (
            typeof update !== "undefined" && update
                ? update
                : null
        );

const stock =
    currentUpdate &&
    currentUpdate.stock
        ? currentUpdate.stock
        : null;

const isValidStock =
    !!(
        currentUpdate &&
        stock
    );

%>


<% if (isValidStock) { %>

<%
/* ==========================================================
   SYSTEM
========================================================== */

const isSystem =
    currentUpdate.authorRole === "system" ||
    currentUpdate.userName === "System" ||
    (
        currentUpdate.user === null &&
        currentUpdate.type === "stock" &&
        stock.action === "available"
    );


/* ==========================================================
   STOCK TYPE
========================================================== */

const stockType =
    stock.stockType || "feed";

const isMedicine =
    stockType === "medicine";


/* ==========================================================
   ACTION
========================================================== */

const stockAction =
    stock.action || "";


/* ==========================================================
   ITEM
========================================================== */

const itemName =
    stock.itemName || "Stock";


/* ==========================================================
   CATEGORY
========================================================== */

const category =
    stock.category || "";


/* ==========================================================
   AUTHOR
========================================================== */

const senderName =
    isSystem
        ? "System"
        : (
            currentUpdate.userName ||
            (
                currentUpdate.user &&
                currentUpdate.user.name
            ) ||
            "User"
        );


/* ==========================================================
   IMAGE
========================================================== */

const senderImage =
    isSystem
        ? "/images/h1.png"
        : (
            currentUpdate.userImage ||
            (
                currentUpdate.user &&
                (
                    currentUpdate.user.profileImage ||
                    currentUpdate.user.displayImage
                )
            ) ||
            "/images/h1.png"
        );


/* ==========================================================
   TITLE
========================================================== */

let title =
    currentUpdate.title || "";

if (!title) {

    if (isSystem) {

        title =
            isMedicine
                ? "More Veterinary Meds Available"
                : "More Animal Feed Available";

    } else {

        title =
            isMedicine
                ? "Veterinary Medicine Stock Update"
                : "Animal Feed Stock Update";

    }

}


/* ==========================================================
   STOCK VALUES
========================================================== */

const quantity =
    stock.quantity;

const unit =
    stock.unit || "";

const price =
    Number(stock.price) || 0;

const instructions =
    stock.instructions || "";

const duration =
    stock.expectedDuration || "";

const message =
    stock.message || "";


/* ==========================================================
   IMAGES
========================================================== */

const images =
    Array.isArray(stock.images)
        ? stock.images.filter(Boolean)
        : [];


/* ==========================================================
   DATE
========================================================== */

const created =
    currentUpdate.createdAt
        ? new Date(currentUpdate.createdAt)
        : new Date();

const validCreatedDate =
    !Number.isNaN(created.getTime())
        ? created
        : new Date();


/* ==========================================================
   LABELS
========================================================== */

const actionLabel =
    stockAction === "remainder"
        ? "reported remaining stock"
        : "made stock available";

const stockTypeLabel =
    isMedicine
        ? "Veterinary Medicine"
        : "Animal Feed";

const quantityLabel =
    stockAction === "remainder"
        ? "Quantity remaining"
        : "Added quantity";

%>


<!-- ==========================================================
     STOCK FEED ITEM
========================================================== -->

<article
    class="stock-feed-item"
    data-update-id="<%= currentUpdate._id || "" %>"
    data-stock-type="<%= stockType %>"
    data-stock-action="<%= stockAction %>"
>


    <!-- ======================================================
         HEADER
    ======================================================= -->

    <header class="stock-feed-header">


        <div class="stock-feed-avatar">

            <img
                src="<%= senderImage %>"
                alt="<%= senderName %>"
                loading="lazy"
            >

        </div>


        <div class="stock-feed-author">


            <div class="stock-feed-author-line">

                <strong>
                    <%= senderName %>
                </strong>

            </div>


            <div class="stock-feed-context">

                <% if (isSystem) { %>

                    The System updated

                <% } else { %>

                    <%= senderName %>
                    <%= actionLabel %>

                <% } %>


                <% if (
                    typeof dairy !== "undefined" &&
                    dairy &&
                    dairy._id
                ) { %>

                    <a
                        href="/dairy/<%= dairy._id %>"
                        class="stock-feed-dairy-link"
                    >

                        <%= dairy.name %>'s Foodstock

                    </a>

                <% } else { %>

                    the Foodstock

                <% } %>

            </div>


            <time
                class="stock-feed-date"
                datetime="<%= validCreatedDate.toISOString() %>"
            >

                <%= validCreatedDate.toLocaleString() %>

            </time>


        </div>

    </header>



    <!-- ======================================================
         BODY
    ======================================================= -->

    <div class="stock-feed-body">


        <!-- ==================================================
             TYPE
        =================================================== -->

        <div class="stock-feed-type">

            <span
                class="stock-feed-type-icon"
                aria-hidden="true"
            >

                <%= isMedicine ? "💊" : "🌾" %>

            </span>

            <span>

                <%= stockTypeLabel %>

            </span>

        </div>



        <!-- ==================================================
             TITLE
        =================================================== -->

        <h3 class="stock-feed-title">

            <%= title %>

        </h3>



        <!-- ==================================================
             ITEM NAME
        =================================================== -->

        <div class="stock-feed-item-name">

            <span class="stock-feed-item-label">
                Item
            </span>

            <strong>
                <%= itemName %>
            </strong>

        </div>



        <!-- ==================================================
             CATEGORY
        =================================================== -->

        <% if (category) { %>

            <div class="stock-feed-category">

                <span class="stock-feed-category-label">
                    Category
                </span>

                <span>
                    <%= category %>
                </span>

            </div>

        <% } %>



        <!-- ==================================================
             DETAILS
        =================================================== -->

        <div class="stock-feed-details">


            <% if (
                quantity !== undefined &&
                quantity !== null &&
                quantity !== ""
            ) { %>

                <div class="stock-feed-detail">

                    <span class="stock-feed-detail-label">

                        <%= quantityLabel %>

                    </span>

                    <strong>

                        <%= Number(
                            quantity
                        ).toLocaleString() %>

                        <% if (unit) { %>

                            <%= unit %>

                        <% } %>

                    </strong>

                </div>

            <% } %>



            <% if (duration) { %>

                <div class="stock-feed-detail">

                    <span class="stock-feed-detail-label">

                        Expected duration

                    </span>

                    <strong>

                        <%= duration %>

                    </strong>

                </div>

            <% } %>



            <% if (
                isSystem &&
                price > 0
            ) { %>

                <div class="stock-feed-detail">

                    <span class="stock-feed-detail-label">

                        Stock value

                    </span>

                    <strong>

                        <%= price.toLocaleString(
                            undefined,
                            {
                                minimumFractionDigits: 2,
                                maximumFractionDigits: 2
                            }
                        ) %>

                    </strong>

                </div>

            <% } %>


        </div>



        <!-- ==================================================
             INSTRUCTIONS
        =================================================== -->

        <% if (instructions) { %>

            <div class="stock-feed-instructions">

                <div class="stock-feed-subheading">

                    Instructions of use

                </div>

                <p>

                    <%= instructions %>

                </p>

            </div>

        <% } %>



        <!-- ==================================================
             MESSAGE
        =================================================== -->

        <% if (message) { %>

            <div class="stock-feed-message">

                <div class="stock-feed-subheading">

                    Additional information

                </div>

                <p>

                    <%= message %>

                </p>

            </div>

        <% } %>



        <!-- ==================================================
             IMAGES
        =================================================== -->

        <% if (images.length > 0) { %>

            <div class="stock-feed-images">

                <% images.forEach(function(image) { %>

                    <img
                        src="<%= image %>"
                        alt="<%= itemName %>"
                        loading="lazy"
                    >

                <% }); %>

            </div>

        <% } %>


    </div>

</article>



