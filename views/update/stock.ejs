<!-- ==========================================================
     FEED STOCK RECORD

     FILE:
         views/update/stock.ejs

     PURPOSE:
         Display a feed-stock / restocking event inside the
         chronological dairy feed.

     DESIGN:
         Purpose-built stock record.
         NOT based on post.ejs.
========================================================== -->


<article
    class="feed-card stock-card"
    data-id="<%= item._id %>"
    data-type="stock"
>


    <!-- =================================================
         HEADER
    ================================================== -->

    <div class="feed-header">

        <div class="feed-user">

            <img
                src="<%= item.userImage || ('https://ui-avatars.com/api/?name=' + encodeURIComponent(item.userName || 'User')) %>"
                class="avatar-sm"
                alt="<%= item.userName || 'User' %>"
            >


            <div class="feed-user-info">

                <!-- =========================================
                     STOCK META
                ========================================== -->

                <div class="post-meta-line">

                    <strong class="post-user-name">

                        📦 <%= item.userName || "User" %>

                    </strong>


                    <% if (item.dairyName && item.dairyId) { %>

                        <span class="post-meta-action">

                            restocked

                        </span>


                        <a
                            href="/dairy/<%= item.dairyId %>"
                            class="post-subject"
                            title="View <%= item.dairyName %>"
                        >

                            <%= item.dairyName %>

                        </a>

                    <% } %>

                </div>


                <!-- =========================================
                     DATE / TIME
                ========================================== -->

                <small class="post-time">

                    <%= item.dateText || "" %>

                </small>

            </div>

        </div>


        <!-- =================================================
             DELETE STOCK RECORD
        ================================================== -->

        <% if (
            user &&
            (
                user.role === "admin" ||
                (
                    user._id &&
                    item.userId &&
                    user._id.toString() ===
                    item.userId.toString()
                )
            )
        ) { %>

            <button
                class="delete-post"
                data-id="<%= item._id %>"
                data-type="stock"
                title="Delete Stock Record"
                aria-label="Delete Stock Record"
                type="button"
            >

                <i
                    class="bi bi-trash3-fill"
                    aria-hidden="true"
                ></i>

            </button>

        <% } %>

    </div>



    <!-- =================================================
         STOCK BODY
    ================================================== -->

    <div class="feed-body">


        <h3>

            📦 Feed Stock

        </h3>


        <!-- =============================================
             FEED NAME
        ============================================== -->

        <% if (item.feedName || item.name) { %>

            <p>

                <strong>Feed:</strong>

                <%= item.feedName || item.name %>

            </p>

        <% } %>



        <!-- =============================================
             QUANTITY
        ============================================== -->

        <% if (
            item.amount !== undefined &&
            item.amount !== null &&
            item.amount !== ""
        ) { %>

            <p>

                <strong>Quantity:</strong>

                <%= item.amount %>

                <% if (item.unit) { %>

                    <%= item.unit %>

                <% } %>

            </p>

        <% } %>



        <!-- =============================================
             COST
        ============================================== -->

        <% if (
            item.cost !== undefined &&
            item.cost !== null &&
            item.cost !== ""
        ) { %>

            <p>

                <strong>Cost:</strong>

                <%= item.cost %>

            </p>

        <% } %>



        <!-- =============================================
             DESCRIPTION
        ============================================== -->

        <% if (item.description) { %>

            <p>

                <%= item.description %>

            </p>

        <% } %>


    </div>



    <!-- =================================================
         ACTIONS
    ================================================== -->

    <%- include("partials/feed-actions", {
        item,
        type: "stock"
    }) %>



    <!-- =================================================
         COMMENTS
    ================================================== -->

    <%- include("comment-section", {
        item,
        user,
        type: "stock"
    }) %>


</article>