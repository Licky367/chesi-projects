<% /*
==============================================================
STOCK FEED ITEM

FILE:
    views/update/stock.ejs

PURPOSE:
    Render stock updates inside the chronological dairy feed.

SUPPORTED STOCK UPDATES:
--------------------------------------------------------------
    1. SYSTEM STOCK ANNOUNCEMENT

       Created automatically when an admin adds:

           • Animal feed
           • Veterinary medicine

       Stored as:

           update.type        = "stock"
           update.authorRole  = "system"
           update.user        = null
           update.userName    = "System"
           update.userImage   = "/images/h1.png"

       Stock data:

           update.stock


    2. DAIRY WORKER STOCK REPORT

       Created when a dairy worker reports remaining stock.

       Stored as:

           update.type        = "stock"
           update.authorRole  = "dairyWorker"
           update.user        = worker
           update.userName    = worker name
           update.userImage   = worker image

       Stock data:

           update.stock


IMPORTANT:
--------------------------------------------------------------
    The current Update.js structure is:

        update
          |
          +-- type
          +-- user
          +-- userName
          +-- userImage
          +-- authorRole
          +-- title
          |
          +-- stock
                |
                +-- stockType
                +-- action
                +-- itemName
                +-- category
                +-- quantity
                +-- unit
                +-- price
                +-- instructions
                +-- expectedDuration
                +-- message
                +-- images

    Therefore this partial MUST read stock information from:

        update.stock

    and NOT:

        update.quantity
        update.unit
        update.images
        etc.


SYSTEM IDENTITY:
--------------------------------------------------------------
    System stock announcements always use:

        /images/h1.png

    and:

        System


WORKER IDENTITY:
--------------------------------------------------------------
    Worker updates use:

        update.userImage
        update.userName

    with populated user data used as fallback.
==============================================================
*/ %>



<%
/* ==========================================================
   SAFETY
========================================================== */

const currentUpdate =
    update || null;


const stock =
    currentUpdate &&
    currentUpdate.stock
        ? currentUpdate.stock
        : null;



/* ==========================================================
   DO NOT RENDER INVALID STOCK ITEMS
========================================================== */

if (
    currentUpdate &&
    stock
) {


/* ==========================================================
   SYSTEM DETECTION
========================================================== */

const isSystem =
    currentUpdate.authorRole === "system" ||
    currentUpdate.userName === "System" ||
    currentUpdate.user === null &&
    currentUpdate.type === "stock" &&
    stock.action === "available";



/* ==========================================================
   STOCK TYPE
========================================================== */

const stockType =
    stock.stockType || "feed";


const isMedicine =
    stockType === "medicine";


const isFeed =
    stockType === "feed";



/* ==========================================================
   STOCK ACTION
========================================================== */

const stockAction =
    stock.action || "";



/* ==========================================================
   ITEM NAME
========================================================== */

const itemName =
    stock.itemName ||
    "Stock";



/* ==========================================================
   CATEGORY
========================================================== */

const category =
    stock.category || "";



/* ==========================================================
   SENDER NAME
========================================================== */

const senderName =
    isSystem

        ? "System"

        : (
            currentUpdate.userName ||

            (
                currentUpdate.user &&
                currentUpdate.user.name
            ) ||

            "User"
        );



/* ==========================================================
   SENDER IMAGE
========================================================== */

const senderImage =
    isSystem

        ? "/images/h1.png"

        : (
            currentUpdate.userImage ||

            (
                currentUpdate.user &&
                (
                    currentUpdate.user.profileImage ||
                    currentUpdate.user.displayImage
                )
            ) ||

            "/images/h1.png"
        );



/* ==========================================================
   TITLE
========================================================== */

let title =
    currentUpdate.title || "";


if (!title) {

    if (isSystem) {

        title =
            isMedicine

                ? "More Veterinary Meds Available"

                : "More Animal Feed Available";

    } else {

        title =
            isMedicine

                ? "Veterinary Medicine Stock Update"

                : "Animal Feed Stock Update";

    }

}



/* ==========================================================
   QUANTITY
========================================================== */

const quantity =
    stock.quantity;



/* ==========================================================
   UNIT
========================================================== */

const unit =
    stock.unit || "";



/* ==========================================================
   PRICE
========================================================== */

const price =
    Number(stock.price) || 0;



/* ==========================================================
   INSTRUCTIONS
========================================================== */

const instructions =
    stock.instructions || "";



/* ==========================================================
   EXPECTED DURATION
========================================================== */

const duration =
    stock.expectedDuration || "";



/* ==========================================================
   MESSAGE
========================================================== */

const message =
    stock.message || "";



/* ==========================================================
   STOCK IMAGES
========================================================== */

const images =
    Array.isArray(stock.images)

        ? stock.images.filter(Boolean)

        : [];



/* ==========================================================
   CREATED DATE
========================================================== */

const created =
    currentUpdate.createdAt

        ? new Date(currentUpdate.createdAt)

        : new Date();



/* ==========================================================
   SAFE DATE
========================================================== */

const validCreatedDate =
    !Number.isNaN(
        created.getTime()
    )

        ? created

        : new Date();



/* ==========================================================
   ACTION LABEL
========================================================== */

const actionLabel =
    stockAction === "remainder"

        ? "reported remaining stock"

        : "made stock available";



/* ==========================================================
   STOCK TYPE LABEL
========================================================== */

const stockTypeLabel =
    isMedicine

        ? "Veterinary Medicine"

        : "Animal Feed";



/* ==========================================================
   QUANTITY LABEL
========================================================== */

const quantityLabel =
    stockAction === "remainder"

        ? "Quantity remaining"

        : "Added quantity";

%>



<!-- ==========================================================
     STOCK FEED ITEM
========================================================== -->

<article
    class="stock-feed-item"
    data-update-id="<%= currentUpdate._id || "" %>"
    data-stock-type="<%= stockType %>"
    data-stock-action="<%= stockAction %>"
>



    <!-- ======================================================
         HEADER
    ======================================================= -->

    <header class="stock-feed-header">


        <!-- ==================================================
             PROFILE IMAGE
        =================================================== -->

        <div class="stock-feed-avatar">

            <img
                src="<%= senderImage %>"
                alt="<%= senderName %>"
                loading="lazy"
            >

        </div>



        <!-- ==================================================
             AUTHOR INFORMATION
        =================================================== -->

        <div class="stock-feed-author">


            <div class="stock-feed-author-line">

                <strong>
                    <%= senderName %>
                </strong>

            </div>



            <!-- ==============================================
                 FEED CONTEXT
            =============================================== -->

            <div class="stock-feed-context">


                <% if (isSystem) { %>

                    The System updated

                <% } else { %>

                    <%= senderName %> <%= actionLabel %>

                <% } %>



                <% if (dairy && dairy._id) { %>

                    <a
                        href="/dairy/<%= dairy._id %>"
                        class="stock-feed-dairy-link"
                    >

                        <%= dairy.name %>'s Foodstock

                    </a>

                <% } else { %>

                    the Foodstock

                <% } %>


            </div>



            <!-- ==============================================
                 DATE
            =============================================== -->

            <time
                class="stock-feed-date"
                datetime="<%= validCreatedDate.toISOString() %>"
            >

                <%= validCreatedDate.toLocaleString() %>

            </time>


        </div>


    </header>



    <!-- ======================================================
         BODY
    ======================================================= -->

    <div class="stock-feed-body">


        <!-- ==================================================
             STOCK TYPE
        =================================================== -->

        <div class="stock-feed-type">

            <span class="stock-feed-type-icon">

                <%= isMedicine ? "💊" : "🌾" %>

            </span>

            <span>

                <%= stockTypeLabel %>

            </span>

        </div>



        <!-- ==================================================
             TITLE
        =================================================== -->

        <h3 class="stock-feed-title">

            <%= title %>

        </h3>



        <!-- ==================================================
             ITEM NAME
        =================================================== -->

        <div class="stock-feed-item-name">

            <span class="stock-feed-item-label">
                Item
            </span>

            <strong>
                <%= itemName %>
            </strong>

        </div>



        <!-- ==================================================
             CATEGORY
        =================================================== -->

        <% if (category) { %>

            <div class="stock-feed-category">

                <span class="stock-feed-category-label">
                    Category
                </span>

                <span>
                    <%= category %>
                </span>

            </div>

        <% } %>



        <!-- ==================================================
             STOCK DETAILS
        =================================================== -->

        <div class="stock-feed-details">


            <!-- ==============================================
                 QUANTITY
            =============================================== -->

            <% if (
                quantity !== undefined &&
                quantity !== null &&
                quantity !== ""
            ) { %>

                <div class="stock-feed-detail">

                    <span class="stock-feed-detail-label">

                        <%= quantityLabel %>

                    </span>

                    <strong>

                        <%= Number(quantity).toLocaleString() %>

                        <% if (unit) { %>

                            <%= unit %>

                        <% } %>

                    </strong>

                </div>

            <% } %>



            <!-- ==============================================
                 EXPECTED DURATION
            =============================================== -->

            <% if (duration) { %>

                <div class="stock-feed-detail">

                    <span class="stock-feed-detail-label">
                        Expected duration
                    </span>

                    <strong>
                        <%= duration %>
                    </strong>

                </div>

            <% } %>



            <!-- ==============================================
                 PRICE

                 Only show price for system/admin availability
                 records.

                 Worker remainder reports do not represent
                 new financial stock value.
            =============================================== -->

            <% if (
                isSystem &&
                price > 0
            ) { %>

                <div class="stock-feed-detail">

                    <span class="stock-feed-detail-label">
                        Stock value
                    </span>

                    <strong>

                        <%= price.toLocaleString(
                            undefined,
                            {
                                minimumFractionDigits: 2,
                                maximumFractionDigits: 2
                            }
                        ) %>

                    </strong>

                </div>

            <% } %>


        </div>



        <!-- ==================================================
             INSTRUCTIONS
        =================================================== -->

        <% if (instructions) { %>

            <div class="stock-feed-instructions">


                <div class="stock-feed-subheading">

                    Instructions of use

                </div>


                <p>

                    <%= instructions %>

                </p>


            </div>

        <% } %>



        <!-- ==================================================
             WORKER / ADDITIONAL MESSAGE
        =================================================== -->

        <% if (message) { %>

            <div class="stock-feed-message">

                <div class="stock-feed-subheading">

                    Additional information

                </div>


                <p>

                    <%= message %>

                </p>

            </div>

        <% } %>



        <!-- ==================================================
             STOCK IMAGES
        =================================================== -->

        <% if (images.length > 0) { %>

            <div class="stock-feed-images">


                <% images.forEach(function(image) { %>


                    <% if (image) { %>

                        <img
                            src="<%= image %>"
                            alt="<%= itemName %>"
                            loading="lazy"
                        >

                    <% } %>


                <% }); %>


            </div>

        <% } %>


    </div>


</article>



