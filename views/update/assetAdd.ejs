<!-- =====================================================
     ASSET ADDED FEED CARD
====================================================== -->

<article
    class="feed-card asset-card asset-added-card"
    data-id="<%= item._id %>"
    data-type="asset"
>


    <!-- =================================================
         HEADER
    ================================================== -->

    <div class="feed-header">


        <div class="feed-user">


            <img
                src="<%= item.userImage || ('https://ui-avatars.com/api/?name=' + encodeURIComponent(item.userName || 'User')) %>"
                class="avatar-sm"
                alt="<%= item.userName || 'User' %>"
            >


            <div class="feed-user-info">


                <strong>

                    <%= item.userName || "User" %>

                </strong>


                <small>

                    <%= item.dateText %>

                </small>


            </div>


        </div>


        <!-- =================================================
             DELETE
        ================================================== -->

        <% if (
            user &&
            (
                user.role === "admin" ||
                (
                    user._id &&
                    item.userId &&
                    user._id.toString() ===
                    item.userId.toString()
                )
            )
        ) { %>


            <button
                class="delete-post"
                data-id="<%= item._id %>"
                data-type="asset"
                title="Delete Asset Record"
                type="button"
            >

                <i class="bi bi-trash3-fill"></i>

            </button>


        <% } %>


    </div>



    <!-- =================================================
         BODY
    ================================================== -->

    <div class="feed-body">


        <!-- =================================================
             TITLE
        ================================================== -->

        <h3>

            🏗️ New Asset Added

        </h3>


        <!-- =================================================
             INTRODUCTION
        ================================================== -->

        <p>

            <strong>
                <%= item.userName || "A user" %>
            </strong>

            added a new asset to

            <strong>
                <%= item.dairyName || "this Dairy Farm" %>
            </strong>.

        </p>



        <!-- =================================================
             ASSET NAME
        ================================================== -->

        <% if (item.asset && item.asset.name) { %>

            <p>

                <strong>
                    Asset:
                </strong>

                <%= item.asset.name %>

            </p>

        <% } %>



        <!-- =================================================
             ASSET TYPE
        ================================================== -->

        <% if (item.asset && item.asset.type) { %>

            <p>

                <strong>
                    Type:
                </strong>

                <%= item.asset.type
                    .replace(
                        /([A-Z])/g,
                        " $1"
                    )
                    .replace(
                        /^./,
                        function(char) {
                            return char.toUpperCase();
                        }
                    )
                %>

            </p>

        <% } %>



        <!-- =================================================
             BUYING PRICE
        ================================================== -->

        <% if (
            item.asset &&
            item.asset.buyingPrice !== undefined &&
            item.asset.buyingPrice !== null
        ) { %>

            <p>

                <strong>
                    Buying Price:
                </strong>

                KES
                <%= Number(
                    item.asset.buyingPrice
                ).toLocaleString(
                    "en-KE",
                    {
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 2
                    }
                ) %>

            </p>

        <% } %>



        <!-- =================================================
             CURRENT WORTH
        ================================================== -->

        <% if (
            item.asset &&
            item.asset.currentWorth !== undefined &&
            item.asset.currentWorth !== null
        ) { %>

            <p>

                <strong>
                    Current Worth:
                </strong>

                KES
                <%= Number(
                    item.asset.currentWorth
                ).toLocaleString(
                    "en-KE",
                    {
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 2
                    }
                ) %>

            </p>

        <% } %>



        <!-- =================================================
             DESCRIPTION
        ================================================== -->

        <% if (
            item.asset &&
            item.asset.description
        ) { %>

            <p>

                <strong>
                    Description:
                </strong>

                <%= item.asset.description %>

            </p>

        <% } %>



        <!-- =================================================
             CONDITION
        ================================================== -->

        <% if (
            item.asset &&
            item.asset.condition
        ) { %>

            <p>

                <strong>
                    Condition:
                </strong>

                <%= item.asset.condition %>

            </p>

        <% } %>



        <!-- =================================================
             LOCATION
        ================================================== -->

        <% if (
            item.asset &&
            item.asset.location
        ) { %>

            <p>

                <strong>
                    Location:
                </strong>

                <%= item.asset.location %>

            </p>

        <% } %>



        <!-- =================================================
             STATUS
        ================================================== -->

        <% if (
            item.asset &&
            item.asset.status
        ) { %>

            <div
                class="asset-status"
            >

                Status:

                <strong>

                    <%= item.asset.status
                        .charAt(0)
                        .toUpperCase() +
                        item.asset.status.slice(1)
                    %>

                </strong>

            </div>

        <% } %>


    </div>



    <!-- =================================================
         ACTIONS
    ================================================== -->

    <%- include("partials/feed-actions", {
        item,
        type: "asset"
    }) %>



    <!-- =================================================
         COMMENTS
    ================================================== -->

    <%- include("comment-section", {
        item,
        user,
        type: "asset"
    }) %>


</article>