<!-- =====================================================
     ASSET ADDED FEED CARD
====================================================== -->

<article
    class="feed-card asset-add-card"
    data-id="<%= item._id %>"
    data-type="assetAdd"
>


    <!-- =================================================
         HEADER
    ================================================== -->

    <div class="feed-header">


        <div class="feed-user">


            <% if (item.userImage) { %>

                <img
                    src="<%= item.userImage %>"
                    class="avatar-sm"
                    alt="<%= item.userName || 'User' %>"
                >

            <% } else { %>

                <img
                    src="<%= 'https://ui-avatars.com/api/?name=' +
                        encodeURIComponent(
                            item.userName || 'User'
                        ) %>"
                    class="avatar-sm"
                    alt="<%= item.userName || 'User' %>"
                >

            <% } %>


            <div class="feed-user-info">


                <strong>

                    <%= item.userName || "User" %>

                </strong>


                <small>

                    <%= item.dateText %>

                </small>


            </div>


        </div>


    </div>



    <!-- =================================================
         BODY
    ================================================== -->

    <div class="feed-body">


        <h3>

            🏗️ New Asset Added

        </h3>


        <p>

            <strong>
                <%= item.userName || "Someone" %>
            </strong>

            added a new asset to this Dairy Farm.

        </p>


        <!-- =============================================
             ASSET INFORMATION
        ============================================== -->

        <div class="asset-add-details">


            <!-- =========================================
                 ASSET NAME
            ========================================== -->

            <div class="asset-add-title">

                <%= item.assetName || "Unnamed Asset" %>

            </div>


            <!-- =========================================
                 ASSET TYPE
            ========================================== -->

            <% if (item.assetType) { %>

                <div class="asset-add-row">

                    <span class="asset-add-label">

                        Type

                    </span>

                    <span class="asset-add-value">

                        <%= item.assetType
                            .replace(
                                /([A-Z])/g,
                                " $1"
                            )
                            .replace(
                                /^./,
                                function(char) {
                                    return char.toUpperCase();
                                }
                            ) %>

                    </span>

                </div>

            <% } %>


            <!-- =========================================
                 CURRENT WORTH
            ========================================== -->

            <div class="asset-add-row">

                <span class="asset-add-label">

                    Current Worth

                </span>

                <span class="asset-add-value">

                    KES
                    <%= Number(
                        item.assetCurrentWorth || 0
                    ).toLocaleString(
                        "en-KE",
                        {
                            minimumFractionDigits: 2,
                            maximumFractionDigits: 2
                        }
                    ) %>

                </span>

            </div>


            <!-- =========================================
                 CONDITION
            ========================================== -->

            <% if (item.assetCondition) { %>

                <div class="asset-add-row">

                    <span class="asset-add-label">

                        Condition

                    </span>

                    <span class="asset-add-value">

                        <%= item.assetCondition %>

                    </span>

                </div>

            <% } %>


            <!-- =========================================
                 LOCATION
            ========================================== -->

            <% if (item.assetLocation) { %>

                <div class="asset-add-row">

                    <span class="asset-add-label">

                        Location

                    </span>

                    <span class="asset-add-value">

                        <%= item.assetLocation %>

                    </span>

                </div>

            <% } %>


            <!-- =========================================
                 STATUS
            ========================================== -->

            <% if (item.assetStatus) { %>

                <div class="asset-add-status">

                    <span>

                        Status

                    </span>

                    <strong>

                        <%= item.assetStatus
                            .charAt(0)
                            .toUpperCase() +
                            item.assetStatus.slice(1) %>

                    </strong>

                </div>

            <% } %>


        </div>


        <!-- =============================================
             DESCRIPTION
        ============================================== -->

        <% if (item.assetDescription) { %>

            <p class="asset-add-description">

                <%= item.assetDescription %>

            </p>

        <% } %>


    </div>



    <!-- =================================================
         ACTIONS
    ================================================== -->

    <%- include("partials/feed-actions", {
        item,
        type: "assetAdd"
    }) %>


    <!-- =================================================
         COMMENTS
    ================================================== -->

    <%- include("comment-section", {
        item,
        user,
        type: "assetAdd"
    }) %>


</article>



<!-- =====================================================
     ASSET ADD CARD CSS
====================================================== -->

<style>

.asset-add-card {

    overflow: hidden;

}


.asset-add-card .feed-body h3 {

    margin-bottom: 10px;

}


.asset-add-details {

    margin-top: 16px;

    padding: 15px;

    background: #f5f9f6;

    border: 1px solid #dce8df;

    border-radius: 13px;

}


.asset-add-title {

    margin-bottom: 13px;

    color: #1f4f31;

    font-size: 18px;

    font-weight: 800;

}


.asset-add-row {

    display: flex;

    align-items: flex-start;

    justify-content: space-between;

    gap: 20px;

    padding: 9px 0;

    border-top: 1px solid #e6eee8;

}


.asset-add-row:first-of-type {

    border-top: none;

}


.asset-add-label {

    color: #718078;

    font-size: 13px;

    font-weight: 600;

}


.asset-add-value {

    color: #304139;

    font-size: 13px;

    font-weight: 700;

    text-align: right;

}


.asset-add-status {

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 15px;

    margin-top: 9px;

    padding-top: 11px;

    border-top: 1px solid #e0e9e3;

    color: #718078;

    font-size: 13px;

}


.asset-add-status strong {

    color: #2f8f55;

    font-size: 12px;

    font-weight: 800;

    text-transform: capitalize;

}


.asset-add-description {

    margin-top: 14px;

    padding-top: 14px;

    border-top: 1px solid #edf1ee;

    color: #536159;

    font-size: 13px;

    line-height: 1.55;

}


@media (max-width: 600px) {

    .asset-add-row {

        gap: 12px;

    }

    .asset-add-title {

        font-size: 17px;

    }

}

</style>