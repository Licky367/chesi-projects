<!-- =====================================================
     DAIRY FEED

     FILE:
         views/update/feed.ejs

     PURPOSE:
         Render the chronological dairy feed.

     FEED ITEM TYPES:
     ------------------------------------------------------
         post
         milk
         medical
         maintenance
         assetAdd
         stock

     IMPORTANT:
     ------------------------------------------------------
         Every item already contained in `feed` is rendered.

         Stock items are NOT filtered out.

         stock.ejs receives:

             update: item

         because stock.ejs expects the variable name
         `update`.

     RECURRING CARDS:
     ------------------------------------------------------
         Create-post and asset-cards are inserted between
         actual feed items.

         They do NOT modify the chronological order of
         the actual feed.
====================================================== -->


<%
/* =========================================================
   RECURRING CARD CONFIGURATION
========================================================= */


/*
 * ---------------------------------------------------------
 * CREATE POST
 * ---------------------------------------------------------
 */

const CREATE_POST_MIN_GAP = 8;

const CREATE_POST_MAX_GAP = 20;


/*
 * ---------------------------------------------------------
 * ASSET CARDS
 * ---------------------------------------------------------
 */

const ASSET_CARD_MIN_GAP = 5;

const ASSET_CARD_MAX_GAP = 18;



/* =========================================================
   RANDOM INTERVAL HELPER
========================================================= */

function randomFeedInterval(min, max) {

    return Math.floor(
        Math.random() * (max - min + 1)
    ) + min;

}



/* =========================================================
   INITIAL INSERTION POSITIONS
========================================================= */

let nextCreatePostAt =
    randomFeedInterval(
        CREATE_POST_MIN_GAP,
        CREATE_POST_MAX_GAP
    );


let nextAssetCardsAt =
    randomFeedInterval(
        ASSET_CARD_MIN_GAP,
        ASSET_CARD_MAX_GAP
    );



/* =========================================================
   LAST INSERTION
========================================================= */

let lastInsertion = null;



/* =========================================================
   ACTUAL FEED ITEM COUNTER
========================================================= */

let feedItemNumber = 0;



/* =========================================================
   ASSET AVAILABILITY
========================================================= */

const hasAssetCards =
    Array.isArray(assetDairies) &&
    assetDairies.length > 0;

%>



<section
    id="feed"
    class="feed-container"
>


    <% if (Array.isArray(feed)) { %>


        <% feed.forEach(function(item) { %>


            <%
            /* =================================================
               COUNT REAL FEED ITEM
            ================================================= */

            feedItemNumber++;
            %>



            <!-- =================================================
                 RECURRING INSERTION LOGIC
            ================================================== -->

            <%
            /*
             * =================================================
             * CHECK WHICH INSERTION IS READY
             * =================================================
             */

            const createPostReady =
                feedItemNumber >=
                nextCreatePostAt;


            const assetCardsReady =
                hasAssetCards &&
                feedItemNumber >=
                nextAssetCardsAt;



            /*
             * =================================================
             * SELECT INSERTION TYPE
             * =================================================
             */

            let insertionType = null;


            if (
                createPostReady &&
                assetCardsReady
            ) {

                /*
                 * Never place the same recurring card twice
                 * consecutively.
                 */

                if (
                    lastInsertion ===
                    "create-post"
                ) {

                    insertionType =
                        "asset-cards";

                } else if (
                    lastInsertion ===
                    "asset-cards"
                ) {

                    insertionType =
                        "create-post";

                } else {

                    insertionType =
                        Math.random() < 0.5
                            ? "create-post"
                            : "asset-cards";

                }

            } else if (
                createPostReady
            ) {

                insertionType =
                    "create-post";

            } else if (
                assetCardsReady
            ) {

                insertionType =
                    "asset-cards";

            }



            /*
             * =================================================
             * CREATE POST
             * =================================================
             */

            if (
                insertionType ===
                "create-post"
            ) {

                if (
                    lastInsertion !==
                    "asset-cards"
                ) {
            %>


                    <div
                        class="feed-recurring-card feed-recurring-create-post"
                        data-feed-insertion="create-post"
                    >

                        <%- include("create-post", {

                            dairy: dairy,

                            user: user,

                            assetDairies:
                                assetDairies || []

                        }) %>

                    </div>


            <%
                    lastInsertion =
                        "create-post";


                    nextCreatePostAt =
                        feedItemNumber +
                        randomFeedInterval(
                            CREATE_POST_MIN_GAP,
                            CREATE_POST_MAX_GAP
                        );

                } else {

                    /*
                     * Give the insertion another chance
                     * after a few real feed items.
                     */

                    nextCreatePostAt =
                        feedItemNumber + 3;

                }

            }



            /*
             * =================================================
             * ASSET CARDS
             * =================================================
             */

            if (
                insertionType ===
                "asset-cards"
            ) {

                if (
                    lastInsertion !==
                    "create-post"
                ) {
            %>


                    <div
                        class="feed-recurring-card feed-recurring-assets"
                        data-feed-insertion="asset-cards"
                    >

                        <%- include("asset-cards", {

                            dairy: dairy,

                            user: user,

                            assetDairies:
                                assetDairies || []

                        }) %>

                    </div>


            <%
                    lastInsertion =
                        "asset-cards";


                    nextAssetCardsAt =
                        feedItemNumber +
                        randomFeedInterval(
                            ASSET_CARD_MIN_GAP,
                            ASSET_CARD_MAX_GAP
                        );

                } else {

                    /*
                     * Give the insertion another chance
                     * after a few real feed items.
                     */

                    nextAssetCardsAt =
                        feedItemNumber + 3;

                }

            }

            %>



            <!-- =================================================
                 NORMAL POST
            ================================================== -->

            <% if (
                item.type === "post"
            ) { %>


                <%- include("post", {

                    item: item,

                    user: user,

                    type: "post"

                }) %>


            <% } %>



            <!-- =================================================
                 MILK
            ================================================== -->

            <% if (
                item.type === "milk"
            ) { %>


                <%- include("milk", {

                    item: item,

                    user: user,

                    type: "milk"

                }) %>


            <% } %>



            <!-- =================================================
                 MEDICAL — MARKED
            ================================================== -->

            <% if (
                item.type === "medical" &&
                item.status === "marked"
            ) { %>


                <%- include("medical-marked", {

                    item: item,

                    user: user,

                    type: "medical"

                }) %>


            <% } %>



            <!-- =================================================
                 MEDICAL — CLEARED
            ================================================== -->

            <% if (
                item.type === "medical" &&
                item.status === "cleared"
            ) { %>


                <%- include("medical-cleared", {

                    item: item,

                    user: user,

                    type: "medical"

                }) %>


            <% } %>



            <!-- =================================================
                 MAINTENANCE — MARKED
            ================================================== -->

            <% if (
                item.type === "maintenance" &&
                item.status === "marked"
            ) { %>


                <%- include("maintenance-marked", {

                    item: item,

                    user: user,

                    type: "maintenance"

                }) %>


            <% } %>



            <!-- =================================================
                 MAINTENANCE — CLEARED
            ================================================== -->

            <% if (
                item.type === "maintenance" &&
                item.status === "cleared"
            ) { %>


                <%- include("maintenance-cleared", {

                    item: item,

                    user: user,

                    type: "maintenance"

                }) %>


            <% } %>



            <!-- =================================================
                 ASSET ADDED
            ================================================== -->

            <% if (
                item.type === "assetAdd"
            ) { %>


                <%- include("addAsset", {

                    item: item,

                    user: user,

                    type: "assetAdd"

                }) %>


            <% } %>



            <!-- =================================================
                 STOCK
            ==================================================

                 IMPORTANT:

                 stock.ejs expects:

                     update

                 NOT:

                     item

                 Therefore the feed item is passed as:

                     update: item

                 ALL stock items are rendered.

                 This includes:

                     • System stock announcements
                     • Dairy-worker stock reports

                 There is deliberately NO author-role filter
                 here.

                 stock.ejs itself determines whether the
                 update is a System announcement or a worker
                 update.
            ================================================== -->

            <% if (
                item.type === "stock"
            ) { %>


                <%- include("stock", {

                    update: item,

                    user: user,

                    type: "stock",

                    dairy: dairy

                }) %>


            <% } %>


        <% }); %>


    <% } %>



    <!-- =====================================================
         END OF FEED

         Nothing is manufactured here.

         Every actual feed card comes from `feed`.

         This includes stock updates.

         Chronological order is therefore preserved.
    ===================================================== -->

</section>



<!-- =====================================================
     RECURRING FEED CARD STYLING
====================================================== -->

<style>

.feed-recurring-card {

    width: 100%;

    margin:
        14px 0;

}


.feed-recurring-create-post {

    width: 100%;

}


.feed-recurring-assets {

    width: 100%;

}

</style>