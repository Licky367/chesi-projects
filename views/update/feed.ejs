<%
/* =========================================================
   DAIRY UPDATE FEED

   FILE:
       views/update/feed.ejs

   PURPOSE:
       Reusable feed partial.

   EXPECTED DATA:
       feed
       user

   FEED TYPES:
       post
       milk
       medical
       maintenance
       animalFeed
       assetAdd

   IMPORTANT:
   ----------------------------------------------------------
   This file is an INCLUDE only.

   It does NOT contain:

       - page wrappers
       - stylesheet links
       - scripts
       - create-post
       - H1
       - asset cards
       - boolean cards
       - asset sidebar
========================================================== */
%>

<section
    id="feed"
    class="feed-container"
>

    <% if (Array.isArray(feed) && feed.length > 0) { %>

        <% feed.forEach(function(item) { %>


            <% if (item.type === "post") { %>

                <%- include(
                    "post",
                    {
                        item: item,
                        user: user
                    }
                ) %>

            <% } else if (item.type === "milk") { %>

                <%- include(
                    "milk",
                    {
                        item: item,
                        user: user
                    }
                ) %>

            <% } else if (
                item.type === "medical" &&
                item.status === "marked"
            ) { %>

                <%- include(
                    "medical-marked",
                    {
                        item: item,
                        user: user
                    }
                ) %>

            <% } else if (
                item.type === "medical" &&
                item.status === "cleared"
            ) { %>

                <%- include(
                    "medical-cleared",
                    {
                        item: item,
                        user: user
                    }
                ) %>

            <% } else if (
                item.type === "maintenance" &&
                item.status === "marked"
            ) { %>

                <%- include(
                    "maintenance-marked",
                    {
                        item: item,
                        user: user
                    }
                ) %>

            <% } else if (
                item.type === "maintenance" &&
                item.status === "cleared"
            ) { %>

                <%- include(
                    "maintenance-cleared",
                    {
                        item: item,
                        user: user
                    }
                ) %>

            <% } else if (item.type === "animalFeed") { %>

                <%- include(
                    "stock-update",
                    {
                        update: item,
                        user: user
                    }
                ) %>

            <% } else if (item.type === "assetAdd") { %>

                <%- include(
                    "addAsset",
                    {
                        item: item,
                        user: user
                    }
                ) %>

            <% } %>


        <% }); %>


    <% } else { %>

        <div
            class="feed-empty-state"
            style="
                width:100%;
                padding:30px 20px;
                text-align:center;
                color:#7b847e;
            "
        >

            <i
                class="bi bi-journal-text"
                aria-hidden="true"
            ></i>

            <p>
                No updates have been recorded yet.
            </p>

        </div>

    <% } %>

</section>