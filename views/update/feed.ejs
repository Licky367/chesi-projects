<%
/* ==========================================================
   DAIRY UPDATE FEED

   FILE:
       views/update/feed.ejs

   PURPOSE:
       Reusable feed partial.

   INCLUDE EXAMPLE:

       <%- include(
           "update/feed",
           {
               feed: feed || [],
               user: user
           }
       ) %>

   DATA RECEIVED:
       feed
       user

   FEED ITEM TYPES:
       post
       milk
       medical
       maintenance
       animalFeed
       assetAdd

   IMPORTANT:
   ----------------------------------------------------------
   This partial renders ONLY the feed.

   It does NOT render:

       - page wrappers
       - create-post
       - H1
       - asset cards
       - boolean management
       - item links
       - asset sidebar
       - scripts
       - stylesheets

   Every actual item contained in feed is evaluated.
========================================================== */
%>


<!-- =====================================================
     MAIN FEED
===================================================== -->

<section
    id="feed"
    class="feed-container"
>


    <!-- =================================================
         FEED EXISTS
    ================================================== -->

    <% if (
        Array.isArray(feed) &&
        feed.length > 0
    ) { %>


        <!-- =================================================
             FEED LOOP

             Fixed page components are NOT rendered here.
        ================================================== -->

        <% feed.forEach(
            function(item, index)
        { %>


            <!-- =============================================
                 NORMAL POST
            ============================================== -->

            <% if (
                item.type === "post"
            ) { %>

                <%- include(
                    "update/post",
                    {
                        item: item,
                        user: user
                    }
                ) %>

            <% } %>



            <!-- =============================================
                 WEEKLY MILK REPORT
            ============================================== -->

            <% if (
                item.type === "milk"
            ) { %>

                <%- include(
                    "update/milk",
                    {
                        item: item,
                        user: user
                    }
                ) %>

            <% } %>



            <!-- =============================================
                 MEDICAL — MARKED
            ============================================== -->

            <% if (
                item.type === "medical" &&
                item.status === "marked"
            ) { %>

                <%- include(
                    "update/medical-marked",
                    {
                        item: item,
                        user: user
                    }
                ) %>

            <% } %>



            <!-- =============================================
                 MEDICAL — CLEARED
            ============================================== -->

            <% if (
                item.type === "medical" &&
                item.status === "cleared"
            ) { %>

                <%- include(
                    "update/medical-cleared",
                    {
                        item: item,
                        user: user
                    }
                ) %>

            <% } %>



            <!-- =============================================
                 MAINTENANCE — MARKED
            ============================================== -->

            <% if (
                item.type === "maintenance" &&
                item.status === "marked"
            ) { %>

                <%- include(
                    "update/maintenance-marked",
                    {
                        item: item,
                        user: user
                    }
                ) %>

            <% } %>



            <!-- =============================================
                 MAINTENANCE — CLEARED
            ============================================== -->

            <% if (
                item.type === "maintenance" &&
                item.status === "cleared"
            ) { %>

                <%- include(
                    "update/maintenance-cleared",
                    {
                        item: item,
                        user: user
                    }
                ) %>

            <% } %>



            <!-- =============================================
                 ANIMAL FEED / STOCK UPDATE

                 stock-update.ejs expects:

                     update

                 Therefore:

                     update: item
            ============================================== -->

            <% if (
                item.type === "animalFeed"
            ) { %>

                <%- include(
                    "update/stock-update",
                    {
                        update: item,
                        user: user
                    }
                ) %>

            <% } %>



            <!-- =============================================
                 ASSET ADDED
            ============================================== -->

            <% if (
                item.type === "assetAdd"
            ) { %>

                <%- include(
                    "update/addAsset",
                    {
                        item: item,
                        user: user
                    }
                ) %>

            <% } %>


        <% }); %>



    <!-- =================================================
         EMPTY FEED
    ================================================== -->

    <% } else { %>


        <div
            class="feed-empty-state"
            style="
                width:100%;
                padding:30px 20px;
                text-align:center;
                color:#7b847e;
            "
        >

            <i
                class="bi bi-journal-text"
                aria-hidden="true"
            ></i>


            <p>
                No updates have been recorded yet.
            </p>

        </div>


    <% } %>


</section>