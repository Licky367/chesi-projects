<!-- =====================================================
     DAIRY FEED

     FILE:
         views/update/feed.ejs

     PURPOSE:
         Render the chronological dairy feed.

     FEED ITEM TYPES:
     ------------------------------------------------------
         post
         milk
         medical
         maintenance
         assetAdd
         stock

     STOCK:
     ------------------------------------------------------
         stock.ejs handles BOTH:

             1. SYSTEM STOCK ANNOUNCEMENTS
                Created automatically when an admin adds
                animal feed or veterinary medicine.

             2. DAIRY WORKER STOCK UPDATES
                Created when a dairyWorker reports remaining
                stock.

         feed.ejs does NOT filter stock items by author.

         The stock.ejs partial is responsible for deciding
         whether the item is a System item or a user item.

     IMPORTANT:
     ------------------------------------------------------
         h1.ejs is NOT rendered here.

         System stock items use:

             /images/h1.png

         internally through stock.ejs.

     FEED ORDER:
     ------------------------------------------------------
         The original chronological order of `feed` is
         preserved.

         Recurring cards are inserted between actual feed
         items without changing the order of the feed itself.
====================================================== -->


<%
/* =========================================================
   RECURRING CARD CONFIGURATION
========================================================= */


/*
 * ---------------------------------------------------------
 * CREATE POST
 * ---------------------------------------------------------
 */

const CREATE_POST_MIN_GAP = 8;

const CREATE_POST_MAX_GAP = 20;


/*
 * ---------------------------------------------------------
 * ASSET CARDS
 * ---------------------------------------------------------
 */

const ASSET_CARD_MIN_GAP = 5;

const ASSET_CARD_MAX_GAP = 18;



/* =========================================================
   RANDOM NUMBER HELPER
========================================================= */

function randomFeedInterval(min, max) {

    return Math.floor(
        Math.random() * (max - min + 1)
    ) + min;

}



/* =========================================================
   INITIAL INTERVALS
========================================================= */

let nextCreatePostAt =
    randomFeedInterval(
        CREATE_POST_MIN_GAP,
        CREATE_POST_MAX_GAP
    );


let nextAssetCardsAt =
    randomFeedInterval(
        ASSET_CARD_MIN_GAP,
        ASSET_CARD_MAX_GAP
    );



/* =========================================================
   LAST INSERTION TRACKING
========================================================= */

let lastInsertion =
    null;



/* =========================================================
   FEED ITEM COUNTER
========================================================= */

let feedItemNumber =
    0;



/* =========================================================
   ASSET AVAILABILITY
========================================================= */

const hasAssetCards =
    Array.isArray(assetDairies) &&
    assetDairies.length > 0;

%>



<section
    id="feed"
    class="feed-container"
>


    <% if (Array.isArray(feed)) { %>


        <% feed.forEach(function (item) { %>


            <%
            /* =================================================
               COUNT ACTUAL FEED ITEM
            ================================================= */

            feedItemNumber++;
            %>



            <!-- =================================================
                 RECURRING INSERTIONS
            ================================================== -->

            <%
            /*
             * =================================================
             * DETERMINE WHAT IS READY
             * =================================================
             */

            const createPostReady =
                feedItemNumber >=
                nextCreatePostAt;


            const assetCardsReady =
                hasAssetCards &&
                feedItemNumber >=
                nextAssetCardsAt;



            /*
             * =================================================
             * DETERMINE INSERTION TYPE
             * =================================================
             */

            let insertionType =
                null;


            if (
                createPostReady &&
                assetCardsReady
            ) {

                if (
                    lastInsertion ===
                    "create-post"
                ) {

                    insertionType =
                        "asset-cards";

                } else if (
                    lastInsertion ===
                    "asset-cards"
                ) {

                    insertionType =
                        "create-post";

                } else {

                    insertionType =
                        Math.random() < 0.5
                            ? "create-post"
                            : "asset-cards";

                }

            } else if (
                createPostReady
            ) {

                insertionType =
                    "create-post";

            } else if (
                assetCardsReady
            ) {

                insertionType =
                    "asset-cards";

            }



            /*
             * =================================================
             * CREATE POST INSERTION
             * =================================================
             */

            if (
                insertionType ===
                "create-post"
            ) {

                if (
                    lastInsertion !==
                    "asset-cards"
                ) {
            %>


                    <!-- =====================================
                         RECURRING CREATE POST
                    ====================================== -->

                    <div
                        class="feed-recurring-card feed-recurring-create-post"
                        data-feed-insertion="create-post"
                    >

                        <%- include("create-post", {
                            dairy: dairy,
                            user: user,
                            assetDairies:
                                assetDairies || []
                        }) %>

                    </div>


            <%
                    lastInsertion =
                        "create-post";


                    nextCreatePostAt =
                        feedItemNumber +
                        randomFeedInterval(
                            CREATE_POST_MIN_GAP,
                            CREATE_POST_MAX_GAP
                        );

                } else {

                    nextCreatePostAt =
                        feedItemNumber + 3;

                }

            }



            /*
             * =================================================
             * ASSET CARD INSERTION
             * =================================================
             */

            if (
                insertionType ===
                "asset-cards"
            ) {

                if (
                    lastInsertion !==
                    "create-post"
                ) {
            %>


                    <!-- =====================================
                         RECURRING ASSET CARDS
                    ====================================== -->

                    <div
                        class="feed-recurring-card feed-recurring-assets"
                        data-feed-insertion="asset-cards"
                    >

                        <%- include("asset-cards", {
                            dairy: dairy,
                            user: user,
                            assetDairies:
                                assetDairies || []
                        }) %>

                    </div>


            <%
                    lastInsertion =
                        "asset-cards";


                    nextAssetCardsAt =
                        feedItemNumber +
                        randomFeedInterval(
                            ASSET_CARD_MIN_GAP,
                            ASSET_CARD_MAX_GAP
                        );

                } else {

                    nextAssetCardsAt =
                        feedItemNumber + 3;

                }

            }

            %>



            <!-- =================================================
                 NORMAL POSTS
            ================================================== -->

            <% if (item.type === "post") { %>

                <%- include("post", {
                    item: item,
                    user: user,
                    type: "post"
                }) %>

            <% } %>



            <!-- =================================================
                 MILK
            ================================================== -->

            <% if (item.type === "milk") { %>

                <%- include("milk", {
                    item: item,
                    user: user,
                    type: "milk"
                }) %>

            <% } %>



            <!-- =================================================
                 MEDICAL
            ================================================== -->

            <% if (
                item.type === "medical" &&
                item.status === "marked"
            ) { %>

                <%- include("medical-marked", {
                    item: item,
                    user: user,
                    type: "medical"
                }) %>

            <% } %>


            <% if (
                item.type === "medical" &&
                item.status === "cleared"
            ) { %>

                <%- include("medical-cleared", {
                    item: item,
                    user: user,
                    type: "medical"
                }) %>

            <% } %>



            <!-- =================================================
                 MAINTENANCE
            ================================================== -->

            <% if (
                item.type === "maintenance" &&
                item.status === "marked"
            ) { %>

                <%- include("maintenance-marked", {
                    item: item,
                    user: user,
                    type: "maintenance"
                }) %>

            <% } %>


            <% if (
                item.type === "maintenance" &&
                item.status === "cleared"
            ) { %>

                <%- include("maintenance-cleared", {
                    item: item,
                    user: user,
                    type: "maintenance"
                }) %>

            <% } %>



            <!-- =================================================
                 ASSET ADDED
            ================================================== -->

            <% if (
                item.type === "assetAdd"
            ) { %>

                <%- include("addAsset", {
                    item: item,
                    user: user,
                    type: "assetAdd"
                }) %>

            <% } %>



            <!-- =================================================
                 FEED STORE STOCK
                 
                 IMPORTANT:
                 ------------------------------------------------
                 ALL stock items are rendered.

                 This includes:

                     • System stock announcements
                     • Dairy worker stock updates

                 There is deliberately NO role filter here.

                 stock.ejs determines whether the item is:

                     System
                         OR
                     actual user
            ================================================== -->

            <% if (
                item.type === "stock"
            ) { %>


                <%- include("stock", {
                    item: item,
                    user: user,
                    type: "stock",
                    dairy: dairy
                }) %>


            <% } %>


        <% }); %>


    <% } %>



    <!-- =====================================================
         END OF FEED

         No feed item is manufactured here.

         No System stock item is manufactured here.

         No worker stock item is manufactured here.

         Everything comes from `feed`.

         This preserves the chronological order.
    ===================================================== -->

</section>



<!-- =====================================================
     RECURRING FEED CARD STYLING

     Individual feed partials remain responsible for
     their own visual design.
====================================================== -->

<style>

.feed-recurring-card {

    width: 100%;

    margin:
        14px
        0;

}


.feed-recurring-create-post {

    width: 100%;

}


.feed-recurring-assets {

    width: 100%;

}

</style>