<!-- =====================================================
     DAIRY FEED

     FILE:
         views/update/feed.ejs

     PURPOSE:
         Render the chronological dairy feed.

     CURRENT UPDATE TYPES:
     ------------------------------------------------------
         post
         medical
         maintenance
         assetAdd
         stock

     STOCK:
     ------------------------------------------------------
         stock.action === "available"
             System stock announcement

         stock.action === "remainder"
             Dairy-worker stock report

         BOTH are rendered.

     IMPORTANT:
     ------------------------------------------------------
         feed.ejs does NOT manufacture feed updates.

         It renders exactly what exists in `feed`.

         stock.ejs decides how a stock item is displayed.
====================================================== -->


<%
/* =========================================================
   RECURRING CARD CONFIGURATION
========================================================= */


/*
 * ---------------------------------------------------------
 * CREATE POST
 * ---------------------------------------------------------
 */

const CREATE_POST_MIN_GAP = 8;

const CREATE_POST_MAX_GAP = 20;


/*
 * ---------------------------------------------------------
 * ASSET CARDS
 * ---------------------------------------------------------
 */

const ASSET_CARD_MIN_GAP = 5;

const ASSET_CARD_MAX_GAP = 18;



/* =========================================================
   RANDOM INTERVAL HELPER
========================================================= */

function randomFeedInterval(min, max) {

    return Math.floor(
        Math.random() * (max - min + 1)
    ) + min;

}



/* =========================================================
   INITIAL INSERTION POSITIONS
========================================================= */

let nextCreatePostAt =
    randomFeedInterval(
        CREATE_POST_MIN_GAP,
        CREATE_POST_MAX_GAP
    );


let nextAssetCardsAt =
    randomFeedInterval(
        ASSET_CARD_MIN_GAP,
        ASSET_CARD_MAX_GAP
    );



/* =========================================================
   INSERTION TRACKING
========================================================= */

let lastInsertion = null;



/* =========================================================
   ACTUAL FEED ITEM COUNTER
========================================================= */

let feedItemNumber = 0;



/* =========================================================
   ASSET AVAILABILITY
========================================================= */

const hasAssetCards =
    Array.isArray(assetDairies) &&
    assetDairies.length > 0;

%>



<section
    id="feed"
    class="feed-container"
>


    <!-- =====================================================
         FEED EXISTS
    ====================================================== -->

    <% if (Array.isArray(feed) && feed.length > 0) { %>


        <% feed.forEach(function(item) { %>


            <%
            /* =================================================
               COUNT REAL FEED ITEM

               This counter counts ONLY actual Update
               documents.

               Recurring cards do not affect chronology.
            ================================================= */

            feedItemNumber++;
            %>



            <!-- =================================================
                 RECURRING CARD DECISION
            ================================================== -->

            <%
            const createPostReady =
                feedItemNumber >= nextCreatePostAt;


            const assetCardsReady =
                hasAssetCards &&
                feedItemNumber >= nextAssetCardsAt;


            let insertionType = null;


            /*
             * -------------------------------------------------
             * BOTH READY
             * -------------------------------------------------
             */

            if (
                createPostReady &&
                assetCardsReady
            ) {

                if (
                    lastInsertion === "create-post"
                ) {

                    insertionType =
                        "asset-cards";

                } else if (
                    lastInsertion === "asset-cards"
                ) {

                    insertionType =
                        "create-post";

                } else {

                    insertionType =
                        Math.random() < 0.5
                            ? "create-post"
                            : "asset-cards";

                }

            }


            /*
             * -------------------------------------------------
             * CREATE POST READY
             * -------------------------------------------------
             */

            else if (
                createPostReady
            ) {

                insertionType =
                    "create-post";

            }


            /*
             * -------------------------------------------------
             * ASSET CARDS READY
             * -------------------------------------------------
             */

            else if (
                assetCardsReady
            ) {

                insertionType =
                    "asset-cards";

            }



            /* =================================================
               CREATE POST
            ================================================== */

            if (
                insertionType ===
                "create-post"
            ) {

                if (
                    lastInsertion !==
                    "asset-cards"
                ) {
            %>


                    <div
                        class="feed-recurring-card feed-recurring-create-post"
                        data-feed-insertion="create-post"
                    >

                        <%- include("create-post", {
                            dairy: dairy,
                            user: user,
                            assetDairies:
                                assetDairies || []
                        }) %>

                    </div>


            <%
                    lastInsertion =
                        "create-post";


                    nextCreatePostAt =
                        feedItemNumber +
                        randomFeedInterval(
                            CREATE_POST_MIN_GAP,
                            CREATE_POST_MAX_GAP
                        );

                } else {

                    /*
                     * Prevent immediate consecutive insertion.
                     */

                    nextCreatePostAt =
                        feedItemNumber + 3;

                }

            }



            /* =================================================
               ASSET CARDS
            ================================================== */

            if (
                insertionType ===
                "asset-cards"
            ) {

                if (
                    lastInsertion !==
                    "create-post"
                ) {
            %>


                    <div
                        class="feed-recurring-card feed-recurring-assets"
                        data-feed-insertion="asset-cards"
                    >

                        <%- include("asset-cards", {
                            dairy: dairy,
                            user: user,
                            assetDairies:
                                assetDairies || []
                        }) %>

                    </div>


            <%
                    lastInsertion =
                        "asset-cards";


                    nextAssetCardsAt =
                        feedItemNumber +
                        randomFeedInterval(
                            ASSET_CARD_MIN_GAP,
                            ASSET_CARD_MAX_GAP
                        );

                } else {

                    /*
                     * Prevent immediate consecutive insertion.
                     */

                    nextAssetCardsAt =
                        feedItemNumber + 3;

                }

            }

            %>



            <!-- =================================================
                 NORMAL POST
            ================================================== -->

            <% if (
                item.type === "post"
            ) { %>


                <%- include("post", {
                    item: item,
                    user: user,
                    type: "post",
                    dairy: dairy
                }) %>


            <% } %>



            <!-- =================================================
                 MEDICAL UPDATE
            ==================================================

                 Current Update.js structure:

                     item.type === "medical"

                 Medical information is stored in:

                     item.medical

                 The partial receives the complete Update item.
            ================================================== -->

            <% if (
                item.type === "medical"
            ) { %>


                <%
                /*
                 * ------------------------------------------------
                 * MARKED MEDICAL UPDATE
                 * ------------------------------------------------
                 */

                const medicalStatus =
                    item.medical &&
                    item.medical.status
                        ? item.medical.status
                        : "";
                %>


                <% if (
                    medicalStatus === "marked"
                ) { %>


                    <%- include("medical-marked", {
                        item: item,
                        user: user,
                        type: "medical",
                        dairy: dairy
                    }) %>


                <% } %>



                <%
                /*
                 * ------------------------------------------------
                 * CLEARED MEDICAL UPDATE
                 * ------------------------------------------------
                 */

                if (
                    medicalStatus === "cleared"
                ) {
                %>


                    <%- include("medical-cleared", {
                        item: item,
                        user: user,
                        type: "medical",
                        dairy: dairy
                    }) %>


                <%
                }
                %>


            <% } %>



            <!-- =================================================
                 MAINTENANCE UPDATE
            ==================================================

                 Current Update.js structure:

                     item.type === "maintenance"

                 Maintenance information is stored in:

                     item.maintenance
            ================================================== -->

            <% if (
                item.type === "maintenance"
            ) { %>


                <%
                /*
                 * ------------------------------------------------
                 * MAINTENANCE STATUS
                 * ------------------------------------------------
                 */

                const maintenanceStatus =
                    item.maintenance &&
                    item.maintenance.status
                        ? item.maintenance.status
                        : "";
                %>


                <% if (
                    maintenanceStatus === "marked"
                ) { %>


                    <%- include("maintenance-marked", {
                        item: item,
                        user: user,
                        type: "maintenance",
                        dairy: dairy
                    }) %>


                <% } %>



                <% if (
                    maintenanceStatus === "cleared"
                ) { %>


                    <%- include("maintenance-cleared", {
                        item: item,
                        user: user,
                        type: "maintenance",
                        dairy: dairy
                    }) %>


                <% } %>


            <% } %>



            <!-- =================================================
                 ASSET ADDED
            ==================================================

                 Current Update.js structure:

                     item.type === "assetAdd"

                 Asset information is stored in:

                     item.asset
            ================================================== -->

            <% if (
                item.type === "assetAdd"
            ) { %>


                <%- include("addAsset", {
                    item: item,
                    user: user,
                    type: "assetAdd",
                    dairy: dairy
                }) %>


            <% } %>



            <!-- =================================================
                 STOCK UPDATE
            ==================================================

                 CURRENT Update.js STRUCTURE:

                     item.type === "stock"

                 Stock information:

                     item.stock

                 Possible actions:

                     available
                     remainder

                 BOTH MUST BE RENDERED.

                 We deliberately DO NOT filter by:

                     user
                     authorRole
                     stock.action

                 Therefore:

                     System stock announcements
                     AND
                     dairy-worker stock reports

                 both reach stock.ejs.
            ================================================== -->

            <% if (
                item.type === "stock" &&
                item.stock
            ) { %>


                <%- include("stock", {
                    item: item,
                    user: user,
                    type: "stock",
                    dairy: dairy
                }) %>


            <% } %>



        <% }); %>


    <% } else { %>


        <!-- =================================================
             EMPTY FEED
        ================================================== -->

        <div
            class="feed-empty"
            data-feed-empty="true"
        >

            <div class="feed-empty-icon">
                📰
            </div>

            <div class="feed-empty-title">
                No updates yet
            </div>

            <div class="feed-empty-text">
                Updates about this dairy will appear here.
            </div>

        </div>


    <% } %>


</section>



<!-- =====================================================
     RECURRING FEED CARD STYLING
====================================================== -->

<style>

.feed-recurring-card {

    width: 100%;

    margin:
        14px 0;

}


.feed-recurring-create-post {

    width: 100%;

}


.feed-recurring-assets {

    width: 100%;

}


.feed-empty {

    width: 100%;

    padding:
        40px 20px;

    text-align: center;

}


.feed-empty-icon {

    font-size: 36px;

    margin-bottom: 10px;

}


.feed-empty-title {

    font-size: 18px;

    font-weight: 700;

    margin-bottom: 6px;

}


.feed-empty-text {

    font-size: 14px;

    opacity: 0.7;

}

</style>