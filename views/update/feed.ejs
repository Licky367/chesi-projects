<!-- =====================================================
     FEED

     FILE:
         views/update/feed.ejs

     PURPOSE:
         Render the chronological dairy feed.

     FEED ITEM TYPES:
     ------------------------------------------------------
         post
         milk
         medical
         maintenance
         assetAdd
         stock

     RECURRING INSERTIONS:
     ------------------------------------------------------
         create-post.ejs
             Recurs after a random number of feed items.

         asset-cards.ejs
             Recurs after a random number of feed items.

     STOCK RULE:
     ------------------------------------------------------
         stock.ejs is rendered only when the report was
         submitted by a dairyWorker.

         Admin stock/restocking activity is NOT rendered
         as a stock feed item.

     IMPORTANT:
     ------------------------------------------------------
         h1.ejs is NOT rendered here.

         It remains fixed directly after the first
         create-post.ejs in the parent page.

         The actual feed order is never changed.
====================================================== -->


<%
/* =========================================================
   RECURRING CARD CONFIGURATION
========================================================= */


/*
 * ---------------------------------------------------------
 * CREATE POST
 * ---------------------------------------------------------
 */

const CREATE_POST_MIN_GAP = 8;
const CREATE_POST_MAX_GAP = 20;


/*
 * ---------------------------------------------------------
 * ASSET CARDS
 * ---------------------------------------------------------
 */

const ASSET_CARD_MIN_GAP = 5;
const ASSET_CARD_MAX_GAP = 18;



/* =========================================================
   RANDOM NUMBER HELPER
========================================================= */

function randomFeedInterval(min, max) {

    return Math.floor(
        Math.random() * (max - min + 1)
    ) + min;

}



/* =========================================================
   INITIAL INTERVALS
========================================================= */

let nextCreatePostAt =
    randomFeedInterval(
        CREATE_POST_MIN_GAP,
        CREATE_POST_MAX_GAP
    );


let nextAssetCardsAt =
    randomFeedInterval(
        ASSET_CARD_MIN_GAP,
        ASSET_CARD_MAX_GAP
    );



/* =========================================================
   LAST INSERTION TRACKING
========================================================= */

let lastInsertion =
    null;



/* =========================================================
   FEED ITEM COUNTER
========================================================= */

let feedItemNumber =
    0;



/* =========================================================
   ASSET AVAILABILITY
========================================================= */

const hasAssetCards =
    Array.isArray(assetDairies) &&
    assetDairies.length > 0;

%>



<section
    id="feed"
    class="feed-container"
>


    <% feed.forEach(function (item) { %>


        <%
        /* =====================================================
           COUNT THIS FEED ITEM
        ===================================================== */

        feedItemNumber++;
        %>



        <!-- =================================================
             RECURRING INSERTIONS
        ================================================== -->

        <%
        /*
         * =====================================================
         * DETERMINE WHAT IS READY
         * =====================================================
         */

        const createPostReady =
            feedItemNumber >= nextCreatePostAt;


        const assetCardsReady =
            hasAssetCards &&
            feedItemNumber >= nextAssetCardsAt;



        /*
         * =====================================================
         * DETERMINE INSERTION TYPE
         * =====================================================
         */

        let insertionType =
            null;


        if (
            createPostReady &&
            assetCardsReady
        ) {

            if (
                lastInsertion === "create-post"
            ) {

                insertionType =
                    "asset-cards";

            } else if (
                lastInsertion === "asset-cards"
            ) {

                insertionType =
                    "create-post";

            } else {

                insertionType =
                    Math.random() < 0.5
                        ? "create-post"
                        : "asset-cards";

            }

        } else if (
            createPostReady
        ) {

            insertionType =
                "create-post";

        } else if (
            assetCardsReady
        ) {

            insertionType =
                "asset-cards";

        }



        /*
         * =====================================================
         * CREATE POST INSERTION
         * =====================================================
         */

        if (
            insertionType === "create-post"
        ) {

            if (
                lastInsertion !== "asset-cards"
            ) {
        %>


                <!-- =========================================
                     RECURRING CREATE POST
                ========================================== -->

                <div
                    class="feed-recurring-card feed-recurring-create-post"
                    data-feed-insertion="create-post"
                >

                    <%- include("create-post", {
                        dairy: dairy,
                        user: user,
                        assetDairies: assetDairies || []
                    }) %>

                </div>


        <%
                lastInsertion =
                    "create-post";


                nextCreatePostAt =
                    feedItemNumber +
                    randomFeedInterval(
                        CREATE_POST_MIN_GAP,
                        CREATE_POST_MAX_GAP
                    );

            } else {

                nextCreatePostAt =
                    feedItemNumber + 3;

            }

        }



        /*
         * =====================================================
         * ASSET CARD INSERTION
         * =====================================================
         */

        if (
            insertionType === "asset-cards"
        ) {

            if (
                lastInsertion !== "create-post"
            ) {
        %>


                <!-- =========================================
                     RECURRING ASSET CARDS
                ========================================== -->

                <div
                    class="feed-recurring-card feed-recurring-assets"
                    data-feed-insertion="asset-cards"
                >

                    <%- include("asset-cards", {
                        dairy: dairy,
                        user: user,
                        assetDairies: assetDairies || []
                    }) %>

                </div>


        <%
                lastInsertion =
                    "asset-cards";


                nextAssetCardsAt =
                    feedItemNumber +
                    randomFeedInterval(
                        ASSET_CARD_MIN_GAP,
                        ASSET_CARD_MAX_GAP
                    );

            } else {

                nextAssetCardsAt =
                    feedItemNumber + 3;

            }

        }

        %>



        <!-- =================================================
             NORMAL POSTS
        ================================================== -->

        <% if (item.type === "post") { %>

            <%- include("post", {
                item,
                user,
                type: "post"
            }) %>

        <% } %>



        <!-- =================================================
             WEEKLY MILK REPORTS
        ================================================== -->

        <% if (item.type === "milk") { %>

            <%- include("milk", {
                item,
                user,
                type: "milk"
            }) %>

        <% } %>



        <!-- =================================================
             MEDICAL RECORDS
        ================================================== -->

        <% if (
            item.type === "medical" &&
            item.status === "marked"
        ) { %>

            <%- include("medical-marked", {
                item,
                user,
                type: "medical"
            }) %>

        <% } %>


        <% if (
            item.type === "medical" &&
            item.status === "cleared"
        ) { %>

            <%- include("medical-cleared", {
                item,
                user,
                type: "medical"
            }) %>

        <% } %>



        <!-- =================================================
             MAINTENANCE RECORDS
        ================================================== -->

        <% if (
            item.type === "maintenance" &&
            item.status === "marked"
        ) { %>

            <%- include("maintenance-marked", {
                item,
                user,
                type: "maintenance"
            }) %>

        <% } %>


        <% if (
            item.type === "maintenance" &&
            item.status === "cleared"
        ) { %>

            <%- include("maintenance-cleared", {
                item,
                user,
                type: "maintenance"
            }) %>

        <% } %>



        <!-- =================================================
             ASSET ADDED
        ================================================== -->

        <% if (item.type === "assetAdd") { %>

            <%- include("addAsset", {
                item,
                user,
                type: "assetAdd"
            }) %>

        <% } %>



        <!-- =================================================
             FEED STORE / STOCK REPORT
             
             IMPORTANT:
             --------------------------------------------------
             Only a dairyWorker's report becomes a feed card.

             Admin activity is intentionally excluded.
        ================================================== -->

        <%
        if (item.type === "stock") {

            /*
             * Determine the author role.
             *
             * Depending on how the controller populates
             * the feed item, the role may be available as:
             *
             *     item.userRole
             *     item.role
             *     item.user.role
             */

            const stockAuthorRole =
                item.userRole ||
                item.role ||
                (
                    item.user &&
                    item.user.role
                ) ||
                null;


            const isDairyWorkerReport =
                stockAuthorRole === "dairyWorker";


            if (isDairyWorkerReport) {
        %>


                <!-- =========================================
                     DAIRY WORKER STOCK REPORT
                ========================================== -->

                <%- include("stock", {
                    item,
                    user,
                    type: "stock"
                }) %>


        <%
            }

        }
        %>


    <% }) %>



    <!-- =====================================================
         END OF FEED
         
         No forced insertion is made here.
         
         Recurring cards are intentionally inserted only
         between actual feed items.
    ====================================================== -->

</section>



<!-- =====================================================
     RECURRING FEED CARD STYLING

     Intentionally minimal.

     Individual feed partials remain responsible for
     their own visual design.
====================================================== -->

<style>

.feed-recurring-card {

    width: 100%;

    margin:
        14px
        0;

}


.feed-recurring-create-post {

    width: 100%;

}


.feed-recurring-assets {

    width: 100%;

}

</style>