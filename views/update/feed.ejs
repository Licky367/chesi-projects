<!-- =====================================================
     DAIRY FEED

     FILE:
         views/update/feed.ejs

     PURPOSE:
         Render the chronological dairy update feed.

     SUPPORTED UPDATE TYPES:
     ------------------------------------------------------
         post
         milk
         medical
         maintenance
         assetAdd
         stock

     STOCK:
     ------------------------------------------------------
         Every stock Update document is rendered.

         System stock announcements:
             authorRole = "system"
             user = null
             userName = "System"
             userImage = "/images/h1.png"

         Dairy-worker stock reports:
             authorRole = "dairyWorker"
             user = worker
             userName = worker name
             userImage = worker image

         feed.ejs DOES NOT FILTER STOCK BY ROLE.

         stock.ejs decides how the stock update is
         displayed.

     IMPORTANT:
     ------------------------------------------------------
         The Update model stores stock information as:

             item.stock

         Therefore the COMPLETE Update document is passed
         to stock.ejs as:

             update: item

     FEED ORDER:
     ------------------------------------------------------
         The order of `feed` is preserved exactly.

         Recurring cards are inserted between feed items
         without modifying the chronological feed order.
====================================================== -->


<%
/* =========================================================
   RECURRING CARD CONFIGURATION
========================================================= */


/* =========================================================
   CREATE POST
========================================================= */

const CREATE_POST_MIN_GAP = 8;

const CREATE_POST_MAX_GAP = 20;


/* =========================================================
   ASSET CARDS
========================================================= */

const ASSET_CARD_MIN_GAP = 5;

const ASSET_CARD_MAX_GAP = 18;


/* =========================================================
   RANDOM INTERVAL HELPER
========================================================= */

function randomFeedInterval(min, max) {

    return Math.floor(
        Math.random() * (max - min + 1)
    ) + min;

}


/* =========================================================
   INITIAL INSERTION POSITIONS
========================================================= */

let nextCreatePostAt =
    randomFeedInterval(
        CREATE_POST_MIN_GAP,
        CREATE_POST_MAX_GAP
    );


let nextAssetCardsAt =
    randomFeedInterval(
        ASSET_CARD_MIN_GAP,
        ASSET_CARD_MAX_GAP
    );


/* =========================================================
   LAST INSERTION
========================================================= */

let lastInsertion = null;


/* =========================================================
   ACTUAL FEED ITEM NUMBER
========================================================= */

let feedItemNumber = 0;


/* =========================================================
   ASSET CARD AVAILABILITY
========================================================= */

const hasAssetCards =
    Array.isArray(assetDairies) &&
    assetDairies.length > 0;

%>



<section
    id="feed"
    class="feed-container"
>


    <!-- =====================================================
         FEED
    ====================================================== -->

    <% if (Array.isArray(feed) && feed.length > 0) { %>


        <% feed.forEach(function(item) { %>


            <%
            /* =================================================
               COUNT REAL FEED ITEM

               Recurring cards do NOT count as feed items.
            ================================================= */

            feedItemNumber++;
            %>



            <!-- =================================================
                 DETERMINE RECURRING INSERTION
            ================================================= -->

            <%
            const createPostReady =
                feedItemNumber >=
                nextCreatePostAt;


            const assetCardsReady =
                hasAssetCards &&
                feedItemNumber >=
                nextAssetCardsAt;


            let insertionType = null;


            /* =================================================
               BOTH ARE READY
            ================================================= */

            if (
                createPostReady &&
                assetCardsReady
            ) {

                /*
                 * Prevent the same recurring card from appearing
                 * twice consecutively.
                 */

                if (
                    lastInsertion ===
                    "create-post"
                ) {

                    insertionType =
                        "asset-cards";

                } else if (
                    lastInsertion ===
                    "asset-cards"
                ) {

                    insertionType =
                        "create-post";

                } else {

                    insertionType =
                        Math.random() < 0.5
                            ? "create-post"
                            : "asset-cards";

                }

            }


            /* =================================================
               ONLY CREATE POST IS READY
            ================================================= */

            else if (
                createPostReady
            ) {

                insertionType =
                    "create-post";

            }


            /* =================================================
               ONLY ASSET CARDS ARE READY
            ================================================= */

            else if (
                assetCardsReady
            ) {

                insertionType =
                    "asset-cards";

            }



            /* =================================================
               INSERT CREATE POST
            ================================================= */

            if (
                insertionType ===
                "create-post"
            ) {

                if (
                    lastInsertion !==
                    "asset-cards"
                ) {
            %>


                    <!-- =====================================
                         CREATE POST CARD
                    ====================================== -->

                    <div
                        class="feed-recurring-card feed-recurring-create-post"
                        data-feed-insertion="create-post"
                    >

                        <%- include("create-post", {
                            dairy: dairy,
                            user: user,
                            assetDairies:
                                assetDairies || []
                        }) %>

                    </div>


            <%
                    lastInsertion =
                        "create-post";


                    nextCreatePostAt =
                        feedItemNumber +
                        randomFeedInterval(
                            CREATE_POST_MIN_GAP,
                            CREATE_POST_MAX_GAP
                        );

                } else {

                    /*
                     * If the previous recurring card was also
                     * create-post, postpone this insertion.
                     */

                    nextCreatePostAt =
                        feedItemNumber + 3;

                }

            }



            /* =================================================
               INSERT ASSET CARDS
            ================================================= */

            if (
                insertionType ===
                "asset-cards"
            ) {

                if (
                    lastInsertion !==
                    "create-post"
                ) {
            %>


                    <!-- =====================================
                         ASSET CARDS
                    ====================================== -->

                    <div
                        class="feed-recurring-card feed-recurring-assets"
                        data-feed-insertion="asset-cards"
                    >

                        <%- include("asset-cards", {
                            dairy: dairy,
                            user: user,
                            assetDairies:
                                assetDairies || []
                        }) %>

                    </div>


            <%
                    lastInsertion =
                        "asset-cards";


                    nextAssetCardsAt =
                        feedItemNumber +
                        randomFeedInterval(
                            ASSET_CARD_MIN_GAP,
                            ASSET_CARD_MAX_GAP
                        );

                } else {

                    /*
                     * If the previous recurring card was also
                     * asset-cards, postpone this insertion.
                     */

                    nextAssetCardsAt =
                        feedItemNumber + 3;

                }

            }

            %>



            <!-- =================================================
                 ACTUAL UPDATE
            ================================================== -->


            <!-- =================================================
                 GENERAL POST
            ================================================== -->

            <% if (
                item &&
                item.type === "post"
            ) { %>


                <%- include("post", {
                    item: item,
                    user: user,
                    type: "post"
                }) %>


            <% } %>



            <!-- =================================================
                 MILK
            ================================================== -->

            <% if (
                item &&
                item.type === "milk"
            ) { %>


                <%- include("milk", {
                    item: item,
                    user: user,
                    type: "milk"
                }) %>


            <% } %>



            <!-- =================================================
                 MEDICAL — MARKED
            ================================================== -->

            <% if (
                item &&
                item.type === "medical" &&
                item.medical &&
                item.medical.status === "marked"
            ) { %>


                <%- include("medical-marked", {
                    item: item,
                    user: user,
                    type: "medical"
                }) %>


            <% } %>



            <!-- =================================================
                 MEDICAL — CLEARED
            ================================================== -->

            <% if (
                item &&
                item.type === "medical" &&
                item.medical &&
                item.medical.status === "cleared"
            ) { %>


                <%- include("medical-cleared", {
                    item: item,
                    user: user,
                    type: "medical"
                }) %>


            <% } %>



            <!-- =================================================
                 MAINTENANCE — MARKED
            ================================================== -->

            <% if (
                item &&
                item.type === "maintenance" &&
                item.maintenance &&
                item.maintenance.status === "marked"
            ) { %>


                <%- include("maintenance-marked", {
                    item: item,
                    user: user,
                    type: "maintenance"
                }) %>


            <% } %>



            <!-- =================================================
                 MAINTENANCE — CLEARED
            ================================================== -->

            <% if (
                item &&
                item.type === "maintenance" &&
                item.maintenance &&
                item.maintenance.status === "cleared"
            ) { %>


                <%- include("maintenance-cleared", {
                    item: item,
                    user: user,
                    type: "maintenance"
                }) %>


            <% } %>



            <!-- =================================================
                 ASSET ADDED
            ================================================== -->

            <% if (
                item &&
                item.type === "assetAdd"
            ) { %>


                <%- include("addAsset", {
                    item: item,
                    user: user,
                    type: "assetAdd"
                }) %>


            <% } %>



            <!-- =================================================
                 STOCK
            ==================================================
                 
                 IMPORTANT:
                 ------------------------------------------------
                 DO NOT FILTER BY:

                     authorRole
                     user
                     userName
                     source
                     isSystem

                 Both kinds of stock updates belong in the feed.

                 The Update model structure is:

                     item
                       └── stock
                           ├── stockType
                           ├── action
                           ├── itemName
                           ├── category
                           ├── quantity
                           ├── unit
                           ├── price
                           ├── instructions
                           ├── expectedDuration
                           ├── message
                           └── images

                 stock.ejs receives the COMPLETE Update document
                 as `update`.

            ================================================== -->

            <% if (
                item &&
                item.type === "stock" &&
                item.stock
            ) { %>


                <%- include("stock", {
                    update: item,
                    dairy: dairy,
                    user: user,
                    type: "stock"
                }) %>


            <% } %>


        <% }); %>


    <% } %>



    <!-- =====================================================
         EMPTY FEED
    ====================================================== -->

    <% if (
        !Array.isArray(feed) ||
        feed.length === 0
    ) { %>


        <div class="feed-empty-state">

            <div class="feed-empty-icon">
                📰
            </div>

            <h3>
                No updates yet
            </h3>

            <p>
                Dairy updates, stock announcements,
                maintenance, medical records and other
                activities will appear here.
            </p>

        </div>


    <% } %>


</section>



<!-- =====================================================
     RECURRING FEED CARD STYLING
====================================================== -->

<style>

.feed-recurring-card {

    width: 100%;

    margin:
        14px
        0;

}


.feed-recurring-create-post {

    width: 100%;

}


.feed-recurring-assets {

    width: 100%;

}



/* ==========================================================
   EMPTY FEED
========================================================== */

.feed-empty-state {

    width: 100%;

    padding:
        45px
        20px;

    text-align: center;

}


.feed-empty-icon {

    margin-bottom: 10px;

    font-size: 34px;

}


.feed-empty-state h3 {

    margin:
        0
        0
        7px;

    color: #314038;

    font-size: 17px;

    font-weight: 850;

}


.feed-empty-state p {

    max-width: 420px;

    margin:
        0
        auto;

    color: #7a857f;

    font-size: 12px;

    line-height: 1.6;

}

</style>