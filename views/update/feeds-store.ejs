<% /*
============================================================
FEED STORE PAGE

FILE:
    views/updates/feeds-store.ejs

PURPOSE:
    Feed-store management page for a Dairy structure whose
    structure type is:

        feedStore

PAGE ROUTE:
    GET /dairy/feedstore/:id

CURRENT ASSET:
    dairy

USER:
    user

FUNCTIONS
------------------------------------------------------------

DAIRY WORKER:
    • Report general facility condition
    • Report feed quality
    • Estimate percentage of feed remaining
    • Attach multiple images
    • Submit text + images

ADMIN:
    • Everything a dairyWorker can do
    • View feed financial inventory
    • Restock existing feed categories
    • Create new feed categories
    • Enter financial amount for restocking

FINANCIAL RULE
------------------------------------------------------------

Individual feed amounts are stored separately.

Example:

    Fodder      25,000
    Silage      18,000
    Hay         12,000

Then:

    feedsAmount = 55,000

feedsAmount is the aggregate financial value of all
individual feed stocks.

IMPORTANT:
    The user does NOT manually enter feedsAmount.

    Backend should calculate:

        SUM(all feed.amount)

    and save that result as:

        feedsAmount

============================================================
*/ %>


<% if (dairy && user) { %>


<div class="feedstore-page">


    <!-- ====================================================
         PAGE HEADER
    ===================================================== -->

    <header class="feedstore-header">

        <div class="feedstore-header__icon">
            🥬
        </div>

        <div class="feedstore-header__content">

            <div class="feedstore-header__eyebrow">
                FEED STORE
            </div>

            <h1>
                Food Stock
            </h1>

            <p>
                Manage feed stock, monitor conditions and keep
                <strong><%= dairy.name %></strong> updated.
            </p>

        </div>

    </header>



    <!-- ====================================================
         STORE SUMMARY
    ===================================================== -->

    <section class="feedstore-summary">


        <!-- =================================================
             TOTAL FEED VALUE
        ================================================== -->

        <article class="feedstore-total-card">

            <div class="feedstore-total-card__label">
                Total Food Stock Value
            </div>

            <div class="feedstore-total-card__amount">

                KES

                <span>
                    <%= Number(
                        dairy.feedsAmount || 0
                    ).toLocaleString() %>
                </span>

            </div>

            <div class="feedstore-total-card__note">
                Combined value of all feed categories
            </div>

        </article>


        <!-- =================================================
             FEED STORE IDENTITY
        ================================================== -->

        <article class="feedstore-info-card">

            <div class="feedstore-info-card__label">
                Facility
            </div>

            <div class="feedstore-info-card__name">
                <%= dairy.name %>
            </div>

            <div class="feedstore-info-card__meta">
                Structure · Feed Store
            </div>

        </article>


    </section>



    <!-- ====================================================
         FEED INVENTORY
    ===================================================== -->

    <section class="feedstore-section">


        <div class="feedstore-section-heading">

            <div>

                <h2>
                    Current Food Stock
                </h2>

                <p>
                    Current financial allocation by feed category.
                </p>

            </div>

        </div>



        <% if (
            dairy.feeds &&
            Array.isArray(dairy.feeds) &&
            dairy.feeds.length
        ) { %>


            <div class="feedstore-inventory">


                <% dairy.feeds.forEach(function(feed) { %>

                    <article class="feedstock-row">


                        <div class="feedstock-row__identity">

                            <div class="feedstock-row__icon">
                                🌾
                            </div>

                            <div>

                                <div class="feedstock-row__name">
                                    <%= feed.name %>
                                </div>

                                <div class="feedstock-row__label">
                                    Current stock value
                                </div>

                            </div>

                        </div>


                        <div class="feedstock-row__amount">

                            KES
                            <strong>
                                <%= Number(
                                    feed.amount || 0
                                ).toLocaleString() %>
                            </strong>

                        </div>


                    </article>

                <% }); %>


            </div>


        <% } else { %>


            <div class="feedstore-empty">

                <div class="feedstore-empty__icon">
                    🌾
                </div>

                <h3>
                    No food stock recorded
                </h3>

                <p>
                    No feed categories have been added to this
                    feed store yet.
                </p>

                <% if (user.role === "admin") { %>

                    <p class="feedstore-empty__admin-note">
                        Use the restocking section below to add
                        the first stock category.
                    </p>

                <% } %>

            </div>


        <% } %>


    </section>



    <!-- ====================================================
         OPERATIONAL REPORTING
    ===================================================== -->

    <section class="feedstore-section">


        <div class="feedstore-section-heading">

            <div>

                <h2>
                    Store Condition
                </h2>

                <p>
                    Report the condition of the facility and
                    the quality of the feed.
                </p>

            </div>

        </div>



        <form
            class="feedstore-report-card"
            action="/dairy/<%= dairy._id %>/feedstore/update"
            method="POST"
            enctype="multipart/form-data"
        >


            <!-- =============================================
                 REPORT TYPE
            ============================================== -->

            <div class="feedstore-field">

                <label for="feedstoreReportType">
                    Report type
                </label>

                <select
                    id="feedstoreReportType"
                    name="feedstoreReportType"
                    required
                >

                    <option value="">
                        Select report type
                    </option>

                    <option value="facilityCondition">
                        Facility condition
                    </option>

                    <option value="feedQuality">
                        Feed quality
                    </option>

                    <option value="facilityAndFeed">
                        Facility and feed quality
                    </option>

                </select>

            </div>



            <!-- =============================================
                 MESSAGE
            ============================================== -->

            <div class="feedstore-field">

                <label for="feedstoreMessage">
                    Report
                </label>

                <textarea
                    id="feedstoreMessage"
                    name="message"
                    rows="6"
                    maxlength="3000"
                    placeholder="Describe the condition of the feed store and/or the quality of the animal feed..."
                    required
                ></textarea>

                <div class="feedstore-field__hint">
                    Include anything important about cleanliness,
                    storage conditions, moisture, feed quality,
                    damage or deterioration.
                </div>

            </div>



            <!-- =============================================
                 IMAGES
            ============================================== -->

            <div class="feedstore-field">

                <label for="feedstoreImages">
                    Photos
                </label>

                <input
                    id="feedstoreImages"
                    type="file"
                    name="images"
                    accept="image/*"
                    multiple
                >

                <div class="feedstore-field__hint">
                    You may attach several photos showing the
                    condition of the facility or feed.
                </div>

            </div>



            <!-- =============================================
                 SUBMIT
            ============================================== -->

            <button
                type="submit"
                class="feedstore-primary-button"
            >

                <span>
                    📤
                </span>

                Submit Condition Report

            </button>


        </form>


    </section>



    <!-- ====================================================
         REMAINING STOCK REPORT
    ===================================================== -->

    <section class="feedstore-section">


        <div class="feedstore-section-heading">

            <div>

                <h2>
                    Food Remaining
                </h2>

                <p>
                    Give an estimate of how much food remains
                    in the store.
                </p>

            </div>

        </div>



        <form
            class="feedstore-report-card"
            action="/dairy/<%= dairy._id %>/feedstore/remaining"
            method="POST"
            enctype="multipart/form-data"
        >


            <!-- =============================================
                 PERCENTAGE
            ============================================== -->

            <div class="feedstore-percentage-box">

                <label for="feedRemaining">
                    Estimated food remaining
                </label>

                <div class="feedstore-percentage-input">

                    <input
                        id="feedRemaining"
                        type="number"
                        name="remainingPercentage"
                        min="0"
                        max="100"
                        step="1"
                        placeholder="0"
                        required
                    >

                    <span>
                        %
                    </span>

                </div>

            </div>



            <!-- =============================================
                 MESSAGE
            ============================================== -->

            <div class="feedstore-field">

                <label for="remainingMessage">
                    Observation
                </label>

                <textarea
                    id="remainingMessage"
                    name="message"
                    rows="5"
                    maxlength="2000"
                    placeholder="Describe the current food levels, which feeds are running low, or anything that should be noted..."
                    required
                ></textarea>

            </div>



            <!-- =============================================
                 IMAGES
            ============================================== -->

            <div class="feedstore-field">

                <label for="remainingImages">
                    Photos
                </label>

                <input
                    id="remainingImages"
                    type="file"
                    name="images"
                    accept="image/*"
                    multiple
                >

                <div class="feedstore-field__hint">
                    Attach several images if they help show
                    the remaining stock.
                </div>

            </div>



            <button
                type="submit"
                class="feedstore-primary-button"
            >

                <span>
                    📊
                </span>

                Submit Stock Estimate

            </button>


        </form>


    </section>



    <!-- ====================================================
         ADMIN RESTOCKING
    ===================================================== -->

    <% if (user.role === "admin") { %>


    <section class="feedstore-section feedstore-admin-section">


        <div class="feedstore-section-heading">

            <div>

                <div class="feedstore-admin-badge">
                    ADMIN
                </div>

                <h2>
                    Restock Food
                </h2>

                <p>
                    Add financial value to an existing feed
                    category or create a new category.
                </p>

            </div>

        </div>



        <form
            class="feedstore-restock-card"
            action="/dairy/<%= dairy._id %>/feedstore/restock"
            method="POST"
        >


            <!-- =============================================
                 RESTOCK MODE
            ============================================== -->

            <div class="feedstore-field">

                <label for="restockMode">
                    Stock action
                </label>

                <select
                    id="restockMode"
                    name="restockMode"
                    onchange="toggleFeedStoreRestockMode()"
                    required
                >

                    <option value="existing">
                        Restock existing stock
                    </option>

                    <option value="new">
                        Add new stock category
                    </option>

                </select>

            </div>



            <!-- =============================================
                 EXISTING STOCK
            ============================================== -->

            <div
                id="existingFeedStockField"
                class="feedstore-field"
            >

                <label for="existingFeedStock">
                    Existing stock
                </label>

                <select
                    id="existingFeedStock"
                    name="existingStock"
                >

                    <option value="">
                        Select feed stock
                    </option>


                    <% if (
                        dairy.feeds &&
                        Array.isArray(dairy.feeds)
                    ) { %>

                        <% dairy.feeds.forEach(function(feed) { %>

                            <option value="<%= feed.name %>">
                                <%= feed.name %>
                            </option>

                        <% }); %>

                    <% } %>

                </select>

            </div>



            <!-- =============================================
                 NEW STOCK
            ============================================== -->

            <div
                id="newFeedStockField"
                class="feedstore-field"
                style="display: none;"
            >

                <label for="newFeedStock">
                    New stock name
                </label>

                <input
                    id="newFeedStock"
                    type="text"
                    name="newStock"
                    maxlength="100"
                    placeholder="e.g. Dairy Meal"
                >

                <div class="feedstore-field__hint">
                    Enter the name of a new feed category.
                </div>

            </div>



            <!-- =============================================
                 AMOUNT
            ============================================== -->

            <div class="feedstore-field">

                <label for="restockAmount">
                    Amount added
                </label>

                <div class="feedstore-money-input">

                    <span>
                        KES
                    </span>

                    <input
                        id="restockAmount"
                        type="number"
                        name="amount"
                        min="0"
                        step="0.01"
                        placeholder="0.00"
                        required
                    >

                </div>

            </div>



            <!-- =============================================
                 RESTOCK NOTE
            ============================================== -->

            <div class="feedstore-field">

                <label for="restockDescription">
                    Restocking note
                </label>

                <textarea
                    id="restockDescription"
                    name="description"
                    rows="4"
                    maxlength="1000"
                    placeholder="Optional note about this restocking..."
                ></textarea>

            </div>



            <!-- =============================================
                 SUBMIT
            ============================================== -->

            <button
                type="submit"
                class="feedstore-admin-button"
            >

                <span>
                    ➕
                </span>

                Restock Food

            </button>


        </form>


    </section>


    <% } %>



    <!-- ====================================================
         RECENT FEED STORE UPDATES
    ===================================================== -->

    <% if (
        updates &&
        Array.isArray(updates) &&
        updates.length
    ) { %>


    <section class="feedstore-section">


        <div class="feedstore-section-heading">

            <div>

                <h2>
                    Recent Reports
                </h2>

                <p>
                    Recent observations submitted for this
                    feed store.
                </p>

            </div>

        </div>



        <div class="feedstore-updates">


            <% updates.forEach(function(update) { %>


            <article class="feedstore-update-card">


                <!-- =========================================
                     UPDATE HEADER
                ========================================== -->

                <div class="feedstore-update-header">

                    <div class="feedstore-update-avatar">

                        <% if (
                            update.user &&
                            update.user.profileImage
                        ) { %>

                            <img
                                src="<%= update.user.profileImage %>"
                                alt=""
                            >

                        <% } else { %>

                            <span>
                                👤
                            </span>

                        <% } %>

                    </div>


                    <div class="feedstore-update-author">

                        <strong>

                            <%= update.user
                                ? update.user.name
                                : "User" %>

                        </strong>

                        <span>

                            <%= update.createdAt
                                ? new Date(
                                    update.createdAt
                                ).toLocaleString()
                                : "" %>

                        </span>

                    </div>

                </div>



                <!-- =========================================
                     UPDATE MESSAGE
                ========================================== -->

                <% if (update.message) { %>

                    <div class="feedstore-update-message">

                        <%= update.message %>

                    </div>

                <% } %>



                <!-- =========================================
                     UPDATE IMAGES
                ========================================== -->

                <% if (
                    update.images &&
                    Array.isArray(update.images) &&
                    update.images.length
                ) { %>


                    <div class="feedstore-update-images">


                        <% update.images.forEach(function(image) { %>

                            <img
                                src="<%= image %>"
                                alt="Feed store condition"
                                loading="lazy"
                            >

                        <% }); %>


                    </div>


                <% } %>



            </article>


            <% }); %>


        </div>


    </section>


    <% } %>



</div>



<!-- ========================================================
     JAVASCRIPT
========================================================= -->

<script>

(function () {

    "use strict";


    window.toggleFeedStoreRestockMode =
        function () {

            const mode =
                document.getElementById(
                    "restockMode"
                );

            const existingField =
                document.getElementById(
                    "existingFeedStockField"
                );

            const newField =
                document.getElementById(
                    "newFeedStockField"
                );

            const existingSelect =
                document.getElementById(
                    "existingFeedStock"
                );

            const newInput =
                document.getElementById(
                    "newFeedStock"
                );


            if (
                !mode ||
                !existingField ||
                !newField
            ) {

                return;

            }


            if (mode.value === "new") {

                existingField.style.display =
                    "none";

                newField.style.display =
                    "flex";

                if (existingSelect) {

                    existingSelect.required =
                        false;

                }

                if (newInput) {

                    newInput.required =
                        true;

                }

            } else {

                existingField.style.display =
                    "flex";

                newField.style.display =
                    "none";

                if (existingSelect) {

                    existingSelect.required =
                        true;

                }

                if (newInput) {

                    newInput.required =
                        false;

                }

            }

        };


})();

</script>



<style>

/* ==========================================================
   FEED STORE PAGE
========================================================== */

.feedstore-page {

    width: 100%;

    max-width: 1100px;

    margin: 0 auto;

    padding: 18px 0 50px;

    color: #26322b;

    box-sizing: border-box;

}


.feedstore-page *,
.feedstore-page *::before,
.feedstore-page *::after {

    box-sizing: border-box;

}



/* ==========================================================
   HEADER
========================================================== */

.feedstore-header {

    display: flex;

    align-items: center;

    gap: 18px;

    margin-bottom: 26px;

    padding: 4px;

}


.feedstore-header__icon {

    width: 64px;

    height: 64px;

    flex: 0 0 64px;

    display: flex;

    align-items: center;

    justify-content: center;

    border-radius: 18px;

    background:
        linear-gradient(
            145deg,
            #198754,
            #14532d
        );

    color: #ffffff;

    font-size: 30px;

    box-shadow:
        0 8px 20px
        rgba(25, 135, 84, .16);

}


.feedstore-header__eyebrow {

    margin-bottom: 3px;

    color: #198754;

    font-size: 11px;

    font-weight: 800;

    letter-spacing: 1.4px;

}


.feedstore-header h1 {

    margin: 0;

    color: #14532d;

    font-size: 34px;

    font-weight: 800;

    line-height: 1.1;

    letter-spacing: -.7px;

}


.feedstore-header p {

    max-width: 720px;

    margin: 7px 0 0;

    color: #66736b;

    font-size: 14px;

    line-height: 1.5;

}


.feedstore-header p strong {

    color: #198754;

}



/* ==========================================================
   SUMMARY
========================================================== */

.feedstore-summary {

    display: grid;

    grid-template-columns:
        minmax(0, 1.4fr)
        minmax(220px, .8fr);

    gap: 14px;

    margin-bottom: 30px;

}


.feedstore-total-card,
.feedstore-info-card {

    min-height: 145px;

    padding: 22px;

    border: 1px solid #dce7e0;

    border-radius: 18px;

    background:
        linear-gradient(
            145deg,
            #ffffff,
            #f5faf7
        );

}


.feedstore-total-card {

    border-color: #cfe3d6;

}


.feedstore-total-card__label,
.feedstore-info-card__label {

    color: #718078;

    font-size: 12px;

    font-weight: 700;

    text-transform: uppercase;

    letter-spacing: .7px;

}


.feedstore-total-card__amount {

    margin-top: 12px;

    color: #14532d;

    font-size: 17px;

    font-weight: 700;

}


.feedstore-total-card__amount span {

    margin-left: 5px;

    font-size: 31px;

    font-weight: 800;

    letter-spacing: -.5px;

}


.feedstore-total-card__note {

    margin-top: 9px;

    color: #8a928d;

    font-size: 12px;

}


.feedstore-info-card__name {

    margin-top: 15px;

    color: #26322b;

    font-size: 21px;

    font-weight: 800;

}


.feedstore-info-card__meta {

    margin-top: 6px;

    color: #198754;

    font-size: 12px;

    font-weight: 700;

}



/* ==========================================================
   SECTIONS
========================================================== */

.feedstore-section {

    margin-top: 30px;

}


.feedstore-section-heading {

    display: flex;

    align-items: flex-end;

    justify-content: space-between;

    gap: 15px;

    margin-bottom: 14px;

}


.feedstore-section-heading h2 {

    margin: 0;

    color: #14532d;

    font-size: 22px;

    font-weight: 800;

    line-height: 1.2;

}


.feedstore-section-heading p {

    margin: 5px 0 0;

    color: #718078;

    font-size: 13px;

    line-height: 1.45;

}



/* ==========================================================
   INVENTORY
========================================================== */

.feedstore-inventory {

    display: flex;

    flex-direction: column;

    gap: 9px;

}


.feedstock-row {

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 15px;

    min-height: 72px;

    padding: 12px 15px;

    border: 1px solid #e0e9e3;

    border-radius: 13px;

    background: #ffffff;

}


.feedstock-row__identity {

    display: flex;

    align-items: center;

    gap: 12px;

    min-width: 0;

}


.feedstock-row__icon {

    width: 42px;

    height: 42px;

    flex: 0 0 42px;

    display: flex;

    align-items: center;

    justify-content: center;

    border-radius: 12px;

    background: #edf7f0;

    font-size: 19px;

}


.feedstock-row__name {

    overflow: hidden;

    color: #26322b;

    font-size: 14px;

    font-weight: 800;

    text-overflow: ellipsis;

    white-space: nowrap;

}


.feedstock-row__label {

    margin-top: 3px;

    color: #8a928d;

    font-size: 11px;

}


.feedstock-row__amount {

    flex-shrink: 0;

    color: #718078;

    font-size: 11px;

    font-weight: 700;

}


.feedstock-row__amount strong {

    margin-left: 3px;

    color: #198754;

    font-size: 16px;

}



/* ==========================================================
   EMPTY
========================================================== */

.feedstore-empty {

    padding: 35px 20px;

    border: 1px dashed #cbdcd1;

    border-radius: 16px;

    background: #f8fbf9;

    text-align: center;

}


.feedstore-empty__icon {

    font-size: 30px;

}


.feedstore-empty h3 {

    margin: 10px 0 5px;

    color: #26322b;

    font-size: 17px;

}


.feedstore-empty p {

    max-width: 500px;

    margin: 0 auto;

    color: #7a857e;

    font-size: 13px;

    line-height: 1.5;

}


.feedstore-empty__admin-note {

    margin-top: 8px !important;

    color: #198754 !important;

    font-weight: 600;

}



/* ==========================================================
   REPORT / RESTOCK CARDS
========================================================== */

.feedstore-report-card,
.feedstore-restock-card {

    padding: 20px;

    border: 1px solid #dce7e0;

    border-radius: 17px;

    background: #ffffff;

}


.feedstore-restock-card {

    border-color: #cfe3d6;

    background:
        linear-gradient(
            145deg,
            #ffffff,
            #f6faf7
        );

}


.feedstore-field {

    display: flex;

    flex-direction: column;

    gap: 7px;

    margin-bottom: 16px;

}


.feedstore-field:last-of-type {

    margin-bottom: 0;

}


.feedstore-field label,
.feedstore-percentage-box label {

    color: #344139;

    font-size: 12px;

    font-weight: 800;

}


.feedstore-field input,
.feedstore-field select,
.feedstore-field textarea {

    width: 100%;

    padding: 11px 12px;

    border: 1px solid #d7e2da;

    border-radius: 9px;

    outline: none;

    background: #ffffff;

    color: #26322b;

    font-family: inherit;

    font-size: 13px;

    transition:
        border-color .15s ease,
        box-shadow .15s ease;

}


.feedstore-field textarea {

    min-height: 110px;

    resize: vertical;

    line-height: 1.5;

}


.feedstore-field input:focus,
.feedstore-field select:focus,
.feedstore-field textarea:focus {

    border-color: #198754;

    box-shadow:
        0 0 0 3px
        rgba(25, 135, 84, .08);

}


.feedstore-field__hint {

    color: #89938d;

    font-size: 11px;

    line-height: 1.4;

}



/* ==========================================================
   PERCENTAGE
========================================================== */

.feedstore-percentage-box {

    margin-bottom: 18px;

}


.feedstore-percentage-input {

    display: flex;

    align-items: center;

    max-width: 220px;

    margin-top: 7px;

    overflow: hidden;

    border: 1px solid #d7e2da;

    border-radius: 10px;

    background: #ffffff;

}


.feedstore-percentage-input:focus-within {

    border-color: #198754;

    box-shadow:
        0 0 0 3px
        rgba(25, 135, 84, .08);

}


.feedstore-percentage-input input {

    width: 100%;

    min-width: 0;

    padding: 13px;

    border: none;

    outline: none;

    background: transparent;

    color: #14532d;

    font: inherit;

    font-size: 22px;

