<% /*
==============================================================
FEED STORE PAGE

FILE:
    views/update/feeds-store.ejs

PURPOSE:
    Dedicated dairy foodstock page.

DATA EXPECTED FROM CONTROLLER:
--------------------------------------------------------------
    dairy
    user
    updates
    feedTypes
    medicineTypes
    stockUnits

CURRENT INVENTORY:
--------------------------------------------------------------
    dairy.feedStocks[]

HISTORY:
--------------------------------------------------------------
    updates[]

IMPORTANT FEED CONTRACT:
--------------------------------------------------------------
    Every history document is rendered independently.

    Each history document is passed to stock.ejs as:

        item: stockItem

    stock.ejs therefore uses:

        item.type
        item.stock
        item.user
        item.userName
        item.userImage
        item.authorRole
        item.title
        item.text
        item.images
        item.createdAt

STOCK DATA:
--------------------------------------------------------------
    item.stock.stockType
    item.stock.action
    item.stock.itemName
    item.stock.category
    item.stock.quantity
    item.stock.unit
    item.stock.price
    item.stock.instructions
    item.stock.expectedDuration
    item.stock.message
    item.stock.images

IMPORTANT:
--------------------------------------------------------------
    DO NOT pass:

        update
        stockUpdate

    to stock.ejs.

    The universal feed variable is:

        item

    Every Update document remains a separate card.

    If updates contains 10 documents,
    stock.ejs is included 10 times.

TAB STRUCTURE:
--------------------------------------------------------------
    1. Available Stock
    2. Add Available Stock
    3. Update Remaining Stock
    4. Foodstock Updates

IMPORTANT:
--------------------------------------------------------------
    Tabs only change the page presentation.

    Existing routes, form fields, permissions,
    stock logic and history logic remain unchanged.
==============================================================
*/ %>


<%
/* ==========================================================
   SAFE PAGE DATA
========================================================== */

const currentDairy =
    dairy || null;


const currentUser =
    user || null;


/* ==========================================================
   CURRENT INVENTORY
========================================================== */

const feedStoreItems =
    currentDairy &&
    Array.isArray(currentDairy.feedStocks)

        ? currentDairy.feedStocks

        : [];


/* ==========================================================
   STOCK HISTORY
========================================================== */

const feedStoreUpdates =
    Array.isArray(updates)

        ? updates

        : [];


/* ==========================================================
   FORM OPTIONS
========================================================== */

const availableFeedTypes =
    Array.isArray(feedTypes)

        ? feedTypes

        : [];


const availableMedicineTypes =
    Array.isArray(medicineTypes)

        ? medicineTypes

        : [];


const availableStockUnits =
    Array.isArray(stockUnits)

        ? stockUnits

        : [
            "kg",
            "bags",
            "tonnes",
            "bales",
            "litres",
            "bottles",
            "packs",
            "units"
        ];


/* ==========================================================
   STOCK TYPE HELPER
========================================================== */

function isMedicineStock(stock) {

    if (!stock) {

        return false;

    }


    return (

        String(
            stock.category ||
            stock.stockType ||
            stock.type ||
            ""
        ).toLowerCase() === "medicine"

    );

}


/* ==========================================================
   STOCK NAME
========================================================== */

function getStockName(stock) {

    if (!stock) {

        return "Unnamed Stock";

    }


    return (

        stock.name ||

        stock.feedName ||

        stock.medicineName ||

        stock.stockName ||

        stock.productName ||

        stock.itemName ||

        "Unnamed Stock"

    );

}


/* ==========================================================
   STOCK QUANTITY
========================================================== */

function getStockQuantity(stock) {

    if (!stock) {

        return 0;

    }


    if (
        stock.quantityRemaining !== undefined &&
        stock.quantityRemaining !== null &&
        stock.quantityRemaining !== ""
    ) {

        return stock.quantityRemaining;

    }


    if (
        stock.quantity !== undefined &&
        stock.quantity !== null &&
        stock.quantity !== ""
    ) {

        return stock.quantity;

    }


    if (
        stock.remaining !== undefined &&
        stock.remaining !== null &&
        stock.remaining !== ""
    ) {

        return stock.remaining;

    }


    if (
        stock.amount !== undefined &&
        stock.amount !== null &&
        stock.amount !== ""
    ) {

        return stock.amount;

    }


    return 0;

}


/* ==========================================================
   STOCK UNIT
========================================================== */

function getStockUnit(stock) {

    if (!stock) {

        return "units";

    }


    return (

        stock.unit ||

        stock.stockUnit ||

        "units"

    );

}

%>



<% if (currentDairy && currentUser) { %>


<div
    class="feedstore-page"
    data-dairy-id="<%= currentDairy._id %>"
>


    <!-- ======================================================
         PAGE INTRO
    ======================================================= -->

    <header class="feedstore-intro">


        <div
            class="feedstore-intro-icon"
            aria-hidden="true"
        >
            🌾
        </div>


        <div>

            <div class="feedstore-eyebrow">
                DAIRY FOODSTOCK
            </div>


            <h1>
                <%= currentDairy.name %>'s Foodstock
            </h1>


            <p>
                View available animal feeds and veterinary
                medicines and keep the remaining quantities
                up to date.
            </p>

        </div>


    </header>



    <!-- ======================================================
         TAB NAVIGATION
    ======================================================= -->

    <nav
        class="feedstore-tabs"
        aria-label="Foodstock sections"
    >


        <button
            type="button"
            class="feedstore-tab active"
            data-tab="available-stock"
            aria-selected="true"
        >

            <span
                class="feedstore-tab-icon"
                aria-hidden="true"
            >
                📦
            </span>

            <span class="feedstore-tab-text">
                Available Stock
            </span>

        </button>



        <% if (currentUser.role === "admin") { %>


            <button
                type="button"
                class="feedstore-tab"
                data-tab="add-stock"
                aria-selected="false"
            >

                <span
                    class="feedstore-tab-icon"
                    aria-hidden="true"
                >
                    ➕
                </span>

                <span class="feedstore-tab-text">
                    Add Stock
                </span>

            </button>


        <% } %>



        <% if (
            currentUser.role === "dairyWorker" ||
            currentUser.role === "admin"
        ) { %>


            <button
                type="button"
                class="feedstore-tab"
                data-tab="remaining-stock"
                aria-selected="false"
            >

                <span
                    class="feedstore-tab-icon"
                    aria-hidden="true"
                >
                    🔄
                </span>

                <span class="feedstore-tab-text">
                    Update Remaining
                </span>

            </button>


        <% } %>



        <button
            type="button"
            class="feedstore-tab"
            data-tab="foodstock-updates"
            aria-selected="false"
        >

            <span
                class="feedstore-tab-icon"
                aria-hidden="true"
            >
                📝
            </span>

            <span class="feedstore-tab-text">
                Foodstock Updates
            </span>

        </button>


    </nav>



    <!-- ======================================================
         TAB CONTENT AREA
    ======================================================= -->

    <main class="feedstore-tab-content">


        <!-- ==================================================
             TAB 1
             AVAILABLE STOCK
        =================================================== -->

        <section
            class="feedstore-tab-panel active"
            data-panel="available-stock"
        >


            <div class="feedstore-section">


                <div class="feedstore-section-header">

                    <div>

                        <h2>
                            Available Stock
                        </h2>


                        <p>
                            Current feeds and veterinary medicines
                            recorded for this dairy.
                        </p>

                    </div>

                </div>



                <% if (feedStoreItems.length > 0) { %>


                    <div class="feedstore-stock-list">


                        <% feedStoreItems.forEach(
                            function(stockItem)
                        { %>


                            <%
                                const medicine =
                                    isMedicineStock(
                                        stockItem
                                    );


                                const stockName =
                                    getStockName(
                                        stockItem
                                    );


                                const stockQuantity =
                                    getStockQuantity(
                                        stockItem
                                    );


                                const stockUnit =
                                    getStockUnit(
                                        stockItem
                                    );
                            %>


                            <article
                                class="feedstore-stock-card"
                                data-stock-id="<%= stockItem._id || "" %>"
                                data-stock-type="<%= medicine ? "medicine" : "feed" %>"
                            >


                                <div class="feedstore-stock-main">


                                    <div
                                        class="feedstore-stock-icon"
                                        aria-hidden="true"
                                    >

                                        <% if (medicine) { %>

                                            💊

                                        <% } else { %>

                                            🌾

                                        <% } %>

                                    </div>


                                    <div class="feedstore-stock-info">


                                        <strong>
                                            <%= stockName %>
                                        </strong>


                                        <span>

                                            <% if (medicine) { %>

                                                Veterinary medicine

                                            <% } else { %>

                                                Animal feed

                                            <% } %>

                                        </span>


                                    </div>


                                </div>



                                <div class="feedstore-stock-quantity">


                                    <strong>
                                        <%= Number(
                                            stockQuantity
                                        ).toLocaleString() %>
                                    </strong>


                                    <span>
                                        <%= stockUnit %>
                                    </span>


                                </div>


                            </article>


                        <% }); %>


                    </div>


                <% } else { %>


                    <div class="feedstore-empty">


                        <div
                            class="feedstore-empty-icon"
                            aria-hidden="true"
                        >
                            🌾
                        </div>


                        <h3>
                            No stock recorded yet
                        </h3>


                        <p>
                            Available animal feed and veterinary
                            medicines will appear here once they
                            are added.
                        </p>


                    </div>


                <% } %>


            </div>



            <% if (currentUser.role === "admin") { %>


                <section class="feedstore-admin-value">


                    <div>

                        <span>
                            TOTAL FOODSTOCK &amp; MEDICINE VALUE
                        </span>


                        <strong>

                            KES
                            <%= Number(
                                currentDairy.feedsAmount || 0
                            ).toLocaleString(
                                undefined,
                                {
                                    minimumFractionDigits: 2,
                                    maximumFractionDigits: 2
                                }
                            ) %>

                        </strong>

                    </div>


                    <small>
                        Visible to administrators only.
                    </small>


                </section>


            <% } %>


        </section>



        <!-- ==================================================
             TAB 2
             ADMIN: ADD AVAILABLE STOCK
        =================================================== -->

        <% if (currentUser.role === "admin") { %>


            <section
                class="feedstore-tab-panel"
                data-panel="add-stock"
            >


                <div class="feedstore-section">


                    <div class="feedstore-section-header">


                        <div>

                            <div class="feedstore-admin-label">
                                ADMIN
                            </div>


                            <h2>
                                Add Available Stock
                            </h2>


                            <p>
                                Record newly available animal feed or
                                veterinary medicine.
                            </p>

                        </div>


                    </div>



                    <form
                        class="feedstore-form"
                        action="/dairy/<%= currentDairy._id %>/feedstore/restock"
                        method="POST"
                        enctype="multipart/form-data"
                    >


                        <div class="feedstore-field">


                            <label for="stockCategory">
                                Stock type
                            </label>


                            <select
                                id="stockCategory"
                                name="category"
                                required
                            >


                                <option value="">
                                    Select stock type
                                </option>


                                <option value="feed">
                                    Animal Feed
                                </option>


                                <option value="medicine">
                                    Veterinary Medicine
                                </option>


                            </select>


                        </div>



                        <div
                            class="feedstore-field"
                            id="feedTypeField"
                        >


                            <label for="feedType">
                                Animal feed
                            </label>


                            <select
                                id="feedType"
                                name="feedName"
                            >


                                <option value="">
                                    Select animal feed
                                </option>


                                <% availableFeedTypes.forEach(
                                    function(type)
                                { %>


                                    <option value="<%= type %>">
                                        <%= type %>
                                    </option>


                                <% }); %>


                            </select>


                        </div>



                        <div
                            class="feedstore-field"
                            id="medicineTypeField"
                            hidden
                        >


                            <label for="medicineType">
                                Veterinary medicine
                            </label>


                            <select
                                id="medicineType"
                                name="medicineName"
                            >


                                <option value="">
                                    Select veterinary medicine
                                </option>


                                <% availableMedicineTypes.forEach(
                                    function(type)
                                { %>


                                    <option value="<%= type %>">
                                        <%= type %>
                                    </option>


                                <% }); %>


                            </select>


                        </div>



                        <div class="feedstore-two-columns">


                            <div class="feedstore-field">


                                <label for="stockQuantity">
                                    Quantity
                                </label>


                                <input
                                    id="stockQuantity"
                                    type="number"
                                    name="quantity"
                                    min="0"
                                    step="0.01"
                                    placeholder="e.g. 20"
                                    required
                                >


                            </div>


                            <div class="feedstore-field">


                                <label for="stockUnit">
                                    Unit
                                </label>


                                <select
                                    id="stockUnit"
                                    name="unit"
                                    required
                                >


                                    <option value="">
                                        Select unit
                                    </option>


                                    <% availableStockUnits.forEach(
                                        function(unit)
                                    { %>


                                        <option value="<%= unit %>">
                                            <%= unit %>
                                        </option>


                                    <% }); %>


                                </select>


                            </div>


                        </div>



                        <div class="feedstore-field">


                            <label for="stockPrice">
                                Price / value
                            </label>


                            <div class="feedstore-money">


                                <span>
                                    KES
                                </span>


                                <input
                                    id="stockPrice"
                                    type="number"
                                    name="price"
                                    min="0"
                                    step="0.01"
                                    placeholder="Enter value"
                                    required
                                >


                            </div>


                            <small>
                                Financial information is visible to
                                administrators only.
                            </small>


                        </div>



                        <div class="feedstore-field">


                            <label for="stockInstructions">
                                Instructions of use
                            </label>


                            <textarea
                                id="stockInstructions"
                                name="instructions"
                                rows="4"
                                maxlength="1500"
                                placeholder="How should this feed or medicine be used?"
                            ></textarea>


                        </div>



                        <div class="feedstore-field">


                            <label for="expectedDuration">
                                Expected duration of consumption
                            </label>


                            <input
                                id="expectedDuration"
                                type="text"
                                name="expectedDuration"
                                maxlength="100"
                                placeholder="e.g. Approximately 14 days"
                            >


                        </div>



                        <div class="feedstore-field">


                            <label for="stockImages">
                                Images
                            </label>


                            <input
                                id="stockImages"
                                type="file"
                                name="images"
                                accept="image/*"
                                multiple
                            >


                            <small>
                                Add photos of the feed, medicine or
                                stock being received.
                            </small>


                        </div>



                        <button
                            type="submit"
                            class="feedstore-submit admin-submit"
                        >

                            <span aria-hidden="true">
                                ➕
                            </span>

                            Add Stock

                        </button>


                    </form>


                </div>


            </section>


        <% } %>



        <!-- ==================================================
             TAB 3
             UPDATE REMAINING STOCK
        =================================================== -->

        <% if (
            currentUser.role === "dairyWorker" ||
            currentUser.role === "admin"
        ) { %>


            <section
                class="feedstore-tab-panel"
                data-panel="remaining-stock"
            >


                <div class="feedstore-section">


                    <div class="feedstore-section-header">


                        <div>

                            <h2>
                                Update Remaining Stock
                            </h2>


                            <p>
                                Record what is currently remaining
                                in the store.
                            </p>

                        </div>


                    </div>



                    <form
                        class="feedstore-form worker-form"
                        action="/dairy/<%= currentDairy._id %>/feedstore/update"
                        method="POST"
                        enctype="multipart/form-data"
                    >


                        <div class="feedstore-field">


                            <label for="remainingStock">
                                Stock item
                            </label>


                            <select
                                id="remainingStock"
                                name="stockId"
                                required
                            >


                                <option value="">
                                    Select stock
                                </option>


                                <% feedStoreItems.forEach(
                                    function(stockItem)
                                { %>


                                    <option
                                        value="<%= stockItem._id || "" %>"
                                    >

                                        <%= getStockName(
                                            stockItem
                                        ) %>

                                        —
                                        <%= getStockUnit(
                                            stockItem
                                        ) %>

                                    </option>


                                <% }); %>


                            </select>


                        </div>



                        <div class="feedstore-two-columns">


                            <div class="feedstore-field">


                                <label for="remainingQuantity">
                                    Quantity remaining
                                </label>


                                <input
                                    id="remainingQuantity"
                                    type="number"
                                    name="quantityRemaining"
                                    min="0"
                                    step="0.01"
                                    placeholder="e.g. 8"
                                    required
                                >


                            </div>


                            <div class="feedstore-field">


                                <label for="remainingUnit">
                                    Unit
                                </label>


                                <select
                                    id="remainingUnit"
                                    name="unit"
                                    required
                                >


                                    <option value="">
                                        Select unit
                                    </option>


                                    <% availableStockUnits.forEach(
                                        function(unit)
                                    { %>


                                        <option value="<%= unit %>">
                                            <%= unit %>
                                        </option>


                                    <% }); %>


                                </select>


                            </div>


                        </div>



                        <div class="feedstore-field">


                            <label for="remainingMessage">
                                Additional information
                            </label>


                            <textarea
                                id="remainingMessage"
                                name="message"
                                rows="5"
                                maxlength="1500"
                                placeholder="Add any useful information about the remaining stock..."
                            ></textarea>


                        </div>



                        <div class="feedstore-field">


                            <label for="remainingImages">
                                Images
                            </label>


                            <input
                                id="remainingImages"
                                type="file"
                                name="images"
                                accept="image/*"
                                multiple
                            >


                        </div>



                        <button
                            type="submit"
                            class="feedstore-submit worker-submit"
                        >

                            <span aria-hidden="true">
                                📦
                            </span>

                            Update Remaining Stock

                        </button>


                    </form>


                </div>


            </section>


        <% } %>



        <!-- ==================================================
             TAB 4
             FOODSTOCK HISTORY
        =================================================== -->

        <section
            class="feedstore-tab-panel"
            data-panel="foodstock-updates"
        >


            <div class="feedstore-section">


                <div class="feedstore-section-header">


                    <div>

                        <h2>
                            Foodstock Updates
                        </h2>


                        <p>
                            Recent additions and remaining-stock
                            updates.
                        </p>

                    </div>


                </div>



                <% if (feedStoreUpdates.length > 0) { %>


                    <div class="feedstore-feed">


                        <% feedStoreUpdates.forEach(
                            function(item)
                        { %>


                            <%- include(
                                "stock",
                                {
                                    item: item,
                                    dairy: currentDairy,
                                    user: currentUser
                                }
                            ) %>


                        <% }); %>


                    </div>


                <% } else { %>


                    <div class="feedstore-empty">


                        <div
                            class="feedstore-empty-icon"
                            aria-hidden="true"
                        >
                            📦
                        </div>


                        <h3>
                            No foodstock updates yet
                        </h3>


                        <p>
                            Stock additions and remaining-stock
                            reports will appear here.
                        </p>


                    </div>


                <% } %>


            </div>


        </section>


    </main>


</div>



<!-- ==========================================================
     TAB + STOCK CATEGORY JAVASCRIPT
========================================================== -->

<script>

document.addEventListener(
    "DOMContentLoaded",
    function () {


        /* ======================================================
           TABS
        ======================================================= */

        const tabs =
            document.querySelectorAll(
                ".feedstore-tab"
            );


        const panels =
            document.querySelectorAll(
                ".feedstore-tab-panel"
            );


        function activateTab(
            tabName
        ) {


            tabs.forEach(
                function(tab) {

                    const isActive =
                        tab.dataset.tab === tabName;


                    tab.classList.toggle(
                        "active",
                        isActive
                    );


                    tab.setAttribute(
                        "aria-selected",
                        isActive
                            ? "true"
                            : "false"
                    );

                }
            );


            panels.forEach(
                function(panel) {

                    const isActive =
                        panel.dataset.panel === tabName;


                    panel.classList.toggle(
                        "active",
                        isActive
                    );

                }
            );


            window.scrollTo({
                top: 0,
                behavior: "smooth"
            });

        }


        tabs.forEach(
            function(tab) {

                tab.addEventListener(
                    "click",
                    function() {

                        activateTab(
                            tab.dataset.tab
                        );

                    }
                );

            }
        );



        /* ======================================================
           STOCK CATEGORY SWITCHER
        ======================================================= */

        const category =
            document.getElementById(
                "stockCategory"
            );


        const feedField =
            document.getElementById(
                "feedTypeField"
            );


        const medicineField =
            document.getElementById(
                "medicineTypeField"
            );


        const feedSelect =
            document.getElementById(
                "feedType"
            );


        const medicineSelect =
            document.getElementById(
                "medicineType"
            );


        if (
            category &&
            feedField &&
            medicineField &&
            feedSelect &&
            medicineSelect
        ) {


            function updateStockType() {

                const value =
                    category.value;


                if (value === "medicine") {

                    feedField.hidden =
                        true;

                    medicineField.hidden =
                        false;

                    feedSelect.required =
                        false;

                    medicineSelect.required =
                        true;

                } else {

                    feedField.hidden =
                        false;

                    medicineField.hidden =
                        true;

                    feedSelect.required =
                        value === "feed";

                    medicineSelect.required =
                        false;

                }

            }


            category.addEventListener(
                "change",
                updateStockType
            );


            updateStockType();

        }


    }
);

</script>



<style>

/* ==========================================================
   FEED STORE PAGE
========================================================== */

.feedstore-page {

    width: 100%;
    max-width: 1000px;

    margin: 0 auto;

    padding: 12px 0 45px;

    color: #26352d;

}


.feedstore-page *,
.feedstore-page *::before,
.feedstore-page *::after {

    box-sizing: border-box;

}


/* ==========================================================
   INTRO
========================================================== */

.feedstore-intro {

    display: flex;
    align-items: center;

    gap: 13px;

    margin-bottom: 15px;

}


.feedstore-intro-icon {

    width: 50px;
    height: 50px;

    flex: 0 0 50px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 14px;

    background: #e5f2e9;

    font-size: 24px;

}


.feedstore-eyebrow {

    margin-bottom: 2px;

    color: #137342;

    font-size: 9px;
    font-weight: 900;

    letter-spacing: 1.2px;

}


.feedstore-intro h1 {

    margin: 0;

    color: #123f29;

    font-size: 25px;
    line-height: 1.15;

    font-weight: 850;

}


.feedstore-intro p {

    margin: 5px 0 0;

    color: #748078;

    font-size: 12px;
    line-height: 1.4;

}


/* ==========================================================
   DARK GREEN TAB BAR
========================================================== */

.feedstore-tabs {

    width: 100%;

    display: grid;

    grid-template-columns:
        repeat(4, minmax(0, 1fr));

    gap: 4px;

    margin-bottom: 0;

    padding: 5px;

    border: 1px solid #06391f;
    border-radius: 13px;

    background:
        linear-gradient(
            135deg,
            #073b22 0%,
            #0a4b2b 50%,
            #06361e 100%
        );

    box-shadow:
        0 5px 16px
        rgba(3, 48, 27, .18);

}


/* ==========================================================
   TAB BUTTON
========================================================== */

.feedstore-tab {

    min-width: 0;

    min-height: 48px;

    display: flex;
    align-items: center;
    justify-content: center;

    gap: 6px;

    padding: 7px 8px;

    border: 1px solid transparent;
    border-radius: 9px;

    background: transparent;

    color: #c8ded1;

    font-family: inherit;

    font-size: 10px;
