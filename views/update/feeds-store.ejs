<% /*
==============================================================
FEED STORE

FILE:
    views/updates/feeds-store.ejs

==============================================================
ROUTES
==============================================================

PAGE:

    GET /dairy/feedstore/:id

WHERE:

    :id = dairy._id


ADMIN RESTOCK:

    POST /dairy/:id/feedstore/restock

WHERE:

    :id = dairy._id


WORKER / ADMIN STOCK UPDATE:

    POST /dairy/:id/feedstore/update

WHERE:

    :id = dairy._id


==============================================================
EXPECTED BACKEND DATA
==============================================================

dairy
user
updates

OPTIONAL ARRAYS:

feedTypes
medicineTypes
stockUnits

==============================================================
IMPORTANT
==============================================================

The page route is intentionally different from the POST
routes.

PAGE:

    /dairy/feedstore/:id

POST ACTIONS:

    /dairy/:id/feedstore/restock
    /dairy/:id/feedstore/update

In ALL THREE cases, the ID represents the SAME Dairy
document:

    dairy._id

==============================================================
*/ %>


<% if (dairy && user) { %>

<div
    class="feedstore-page"
    data-dairy-id="<%= dairy._id %>"
    data-feedstore-url="/dairy/feedstore/<%= dairy._id %>"
>


    <!-- ======================================================
         PAGE INTRO
    ======================================================= -->

    <header class="feedstore-intro">

        <div class="feedstore-intro-icon">
            🌾
        </div>


        <div>

            <div class="feedstore-eyebrow">
                DAIRY FOODSTOCK
            </div>


            <h1>
                <%= dairy.name %>'s Foodstock
            </h1>


            <p>
                View available animal feeds and veterinary
                medicines and keep the remaining quantities
                up to date.
            </p>

        </div>

    </header>



    <!-- ======================================================
         CURRENT STOCK
    ======================================================= -->

    <section class="feedstore-section">


        <div class="feedstore-section-header">

            <div>

                <h2>
                    Available Stock
                </h2>

                <p>
                    Current feeds and veterinary medicines
                    recorded for this dairy.
                </p>

            </div>

        </div>



        <% if (
            Array.isArray(dairy.feeds) &&
            dairy.feeds.length > 0
        ) { %>


            <div class="feedstore-stock-list">


                <% dairy.feeds.forEach(function(feed) { %>

                    <article
                        class="feedstore-stock-card"
                        data-stock-id="<%= feed._id %>"
                    >


                        <!-- ==================================
                             STOCK INFORMATION
                        =================================== -->

                        <div class="feedstore-stock-main">


                            <div class="feedstore-stock-icon">

                                <% if (
                                    feed.category === "medicine" ||
                                    feed.type === "medicine"
                                ) { %>

                                    💊

                                <% } else { %>

                                    🌾

                                <% } %>

                            </div>


                            <div class="feedstore-stock-info">

                                <strong>

                                    <%= feed.name ||
                                        feed.feedName ||
                                        "Unnamed Stock" %>

                                </strong>


                                <span>

                                    <% if (
                                        feed.category === "medicine" ||
                                        feed.type === "medicine"
                                    ) { %>

                                        Veterinary medicine

                                    <% } else { %>

                                        Animal feed

                                    <% } %>

                                </span>

                            </div>

                        </div>



                        <!-- ==================================
                             QUANTITY
                        =================================== -->

                        <div class="feedstore-stock-quantity">

                            <strong>

                                <%= feed.quantity ??
                                    feed.amount ??
                                    0 %>

                            </strong>


                            <span>

                                <%= feed.unit ||
                                    "units" %>

                            </span>

                        </div>


                    </article>

                <% }); %>


            </div>


        <% } else { %>


            <div class="feedstore-empty">

                <div class="feedstore-empty-icon">
                    🌾
                </div>


                <h3>
                    No stock recorded yet
                </h3>


                <p>
                    Available animal feed and veterinary
                    medicines will appear here once they
                    are added.
                </p>

            </div>


        <% } %>


    </section>



    <!-- ======================================================
         ADMIN FINANCIAL SUMMARY
    ======================================================= -->

    <% if (user.role === "admin") { %>


        <section class="feedstore-admin-value">


            <div>

                <span>
                    TOTAL FOODSTOCK & MEDICINE VALUE
                </span>


                <strong>

                    KES
                    <%= Number(
                        dairy.feedsAmount || 0
                    ).toLocaleString() %>

                </strong>

            </div>


            <small>
                Visible to administrators only.
            </small>


        </section>


    <% } %>



    <!-- ======================================================
         ADMIN STOCK ADDITION
    ======================================================= -->

    <% if (user.role === "admin") { %>


        <section class="feedstore-section">


            <div class="feedstore-section-header">


                <div>

                    <div class="feedstore-admin-label">
                        ADMIN
                    </div>


                    <h2>
                        Add Available Stock
                    </h2>


                    <p>
                        Record newly available animal feed or
                        veterinary medicine.
                    </p>

                </div>


            </div>



            <!-- ==================================================
                 IMPORTANT ROUTE MAPPING
                 ==================================================

                 PAGE:

                     /dairy/feedstore/:id

                 FORM:

                     /dairy/:id/feedstore/restock

                 :id = dairy._id

            =================================================== -->

            <form
                class="feedstore-form"
                action="/dairy/<%= dairy._id %>/feedstore/restock"
                method="POST"
                enctype="multipart/form-data"
            >


                <!-- ==========================================
                     STOCK CATEGORY
                =========================================== -->

                <div class="feedstore-field">

                    <label for="stockCategory">
                        Stock type
                    </label>


                    <select
                        id="stockCategory"
                        name="category"
                        required
                    >

                        <option value="">
                            Select stock type
                        </option>


                        <option value="feed">
                            Animal Feed
                        </option>


                        <option value="medicine">
                            Veterinary Medicine
                        </option>

                    </select>

                </div>



                <!-- ==========================================
                     FEED TYPE
                =========================================== -->

                <div
                    class="feedstore-field"
                    id="feedTypeField"
                >

                    <label for="feedType">
                        Animal feed
                    </label>


                    <select
                        id="feedType"
                        name="feedName"
                    >

                        <option value="">
                            Select animal feed
                        </option>


                        <% if (Array.isArray(feedTypes)) { %>

                            <% feedTypes.forEach(function(type) { %>

                                <option value="<%= type %>">
                                    <%= type %>
                                </option>

                            <% }); %>

                        <% } %>


                    </select>

                </div>



                <!-- ==========================================
                     MEDICINE TYPE
                =========================================== -->

                <div
                    class="feedstore-field"
                    id="medicineTypeField"
                    hidden
                >

                    <label for="medicineType">
                        Veterinary medicine
                    </label>


                    <select
                        id="medicineType"
                        name="medicineName"
                    >

                        <option value="">
                            Select veterinary medicine
                        </option>


                        <% if (
                            Array.isArray(medicineTypes)
                        ) { %>


                            <% medicineTypes.forEach(
                                function(type)
                            { %>

                                <option value="<%= type %>">
                                    <%= type %>
                                </option>

                            <% }); %>


                        <% } %>


                    </select>

                </div>



                <!-- ==========================================
                     QUANTITY + UNIT
                =========================================== -->

                <div class="feedstore-two-columns">


                    <div class="feedstore-field">

                        <label for="stockQuantity">
                            Quantity
                        </label>


                        <input
                            id="stockQuantity"
                            type="number"
                            name="quantity"
                            min="0"
                            step="0.01"
                            placeholder="e.g. 20"
                            required
                        >

                    </div>



                    <div class="feedstore-field">

                        <label for="stockUnit">
                            Unit
                        </label>


                        <select
                            id="stockUnit"
                            name="unit"
                            required
                        >

                            <option value="">
                                Select unit
                            </option>


                            <% if (
                                Array.isArray(stockUnits)
                            ) { %>


                                <% stockUnits.forEach(
                                    function(unit)
                                { %>

                                    <option value="<%= unit %>">
                                        <%= unit %>
                                    </option>

                                <% }); %>


                            <% } else { %>


                                <option value="kg">
                                    kg
                                </option>

                                <option value="bags">
                                    bags
                                </option>

                                <option value="tonnes">
                                    tonnes
                                </option>

                                <option value="bales">
                                    bales
                                </option>

                                <option value="litres">
                                    litres
                                </option>

                                <option value="bottles">
                                    bottles
                                </option>

                                <option value="packs">
                                    packs
                                </option>

                                <option value="units">
                                    units
                                </option>


                            <% } %>


                        </select>

                    </div>


                </div>



                <!-- ==========================================
                     PRICE
                =========================================== -->

                <div class="feedstore-field">


                    <label for="stockPrice">
                        Price / value
                    </label>


                    <div class="feedstore-money">

                        <span>
                            KES
                        </span>


                        <input
                            id="stockPrice"
                            type="number"
                            name="price"
                            min="0"
                            step="0.01"
                            placeholder="Enter value"
                            required
                        >

                    </div>


                    <small>
                        This information is visible to
                        administrators only.
                    </small>


                </div>



                <!-- ==========================================
                     INSTRUCTIONS
                =========================================== -->

                <div class="feedstore-field">


                    <label for="stockInstructions">
                        Instructions of use
                    </label>


                    <textarea
                        id="stockInstructions"
                        name="instructions"
                        rows="4"
                        maxlength="1500"
                        placeholder="How should this feed or medicine be used?"
                    ></textarea>


                </div>



                <!-- ==========================================
                     EXPECTED DURATION
                =========================================== -->

                <div class="feedstore-field">


                    <label for="expectedDuration">
                        Expected duration of consumption
                    </label>


                    <input
                        id="expectedDuration"
                        type="text"
                        name="expectedDuration"
                        maxlength="100"
                        placeholder="e.g. Approximately 14 days"
                    >


                </div>



                <!-- ==========================================
                     IMAGES
                =========================================== -->

                <div class="feedstore-field">


                    <label for="stockImages">
                        Images
                    </label>


                    <input
                        id="stockImages"
                        type="file"
                        name="images"
                        accept="image/*"
                        multiple
                    >


                    <small>
                        Add photos of the feed, medicine or
                        stock being received.
                    </small>


                </div>



                <!-- ==========================================
                     SUBMIT
                =========================================== -->

                <button
                    type="submit"
                    class="feedstore-submit admin-submit"
                >

                    <span>
                        ➕
                    </span>

                    Add Stock

                </button>


            </form>


        </section>


    <% } %>



    <!-- ======================================================
         DAIRY WORKER STOCK UPDATE
    ======================================================= -->

    <section class="feedstore-section">


        <div class="feedstore-section-header">


            <div>

                <h2>
                    Update Remaining Stock
                </h2>


                <p>
                    Record what is currently remaining in the
                    store.
                </p>

            </div>


        </div>



        <!-- ==================================================
             IMPORTANT ROUTE MAPPING

             PAGE:

                 /dairy/feedstore/:id

             FORM:

                 /dairy/:id/feedstore/update

             :id = dairy._id

        =================================================== -->

        <form
            class="feedstore-form worker-form"
            action="/dairy/<%= dairy._id %>/feedstore/update"
            method="POST"
            enctype="multipart/form-data"
        >


            <!-- ==========================================
                 STOCK ITEM
            =========================================== -->

            <div class="feedstore-field">


                <label for="remainingStock">
                    Stock item
                </label>


                <select
                    id="remainingStock"
                    name="stockId"
                    required
                >

                    <option value="">
                        Select stock
                    </option>


                    <% if (
                        Array.isArray(dairy.feeds)
                    ) { %>


                        <% dairy.feeds.forEach(
                            function(feed)
                        { %>


                            <option
                                value="<%= feed._id %>"
                            >

                                <%= feed.name ||
                                    feed.feedName ||
                                    "Unnamed Stock" %>


                                <% if (feed.unit) { %>

                                    — <%= feed.unit %>

                                <% } %>


                            </option>


                        <% }); %>


                    <% } %>


                </select>


            </div>



            <!-- ==========================================
                 REMAINING QUANTITY
            =========================================== -->

            <div class="feedstore-two-columns">


                <div class="feedstore-field">


                    <label for="remainingQuantity">
                        Quantity remaining
                    </label>


                    <input
                        id="remainingQuantity"
                        type="number"
                        name="quantityRemaining"
                        min="0"
                        step="0.01"
                        placeholder="e.g. 8"
                        required
                    >


                </div>



                <div class="feedstore-field">


                    <label for="remainingUnit">
                        Unit
                    </label>


                    <select
                        id="remainingUnit"
                        name="unit"
                        required
                    >

                        <option value="">
                            Select unit
                        </option>


                        <% if (
                            Array.isArray(stockUnits)
                        ) { %>


                            <% stockUnits.forEach(
                                function(unit)
                            { %>

                                <option value="<%= unit %>">
                                    <%= unit %>
                                </option>

                            <% }); %>


                        <% } else { %>


                            <option value="kg">
                                kg
                            </option>

                            <option value="bags">
                                bags
                            </option>

                            <option value="tonnes">
                                tonnes
                            </option>

                            <option value="bales">
                                bales
                            </option>

                            <option value="litres">
                                litres
                            </option>

                            <option value="bottles">
                                bottles
                            </option>

                            <option value="packs">
                                packs
                            </option>

                            <option value="units">
                                units
                            </option>


                        <% } %>


                    </select>


                </div>


            </div>



            <!-- ==========================================
                 WORKER MESSAGE
            =========================================== -->

            <div class="feedstore-field">


                <label for="remainingMessage">
                    Additional information
                </label>


                <textarea
                    id="remainingMessage"
                    name="message"
                    rows="5"
                    maxlength="1500"
                    placeholder="Add any useful information about the remaining stock..."
                ></textarea>


            </div>



            <!-- ==========================================
                 WORKER IMAGES
            =========================================== -->

            <div class="feedstore-field">


                <label for="remainingImages">
                    Images
                </label>


                <input
                    id="remainingImages"
                    type="file"
                    name="images"
                    accept="image/*"
                    multiple
                >


            </div>



            <!-- ==========================================
                 SUBMIT
            =========================================== -->

            <button
                type="submit"
                class="feedstore-submit worker-submit"
            >

                <span>
                    📦
                </span>

                Update Remaining Stock

            </button>


        </form>


    </section>



    <!-- ======================================================
         STOCK UPDATE FEED
    ======================================================= -->

    <% if (
        Array.isArray(updates) &&
        updates.length > 0
    ) { %>


        <section class="feedstore-section">


            <div class="feedstore-section-header">


                <div>

                    <h2>
                        Foodstock Updates
                    </h2>


                    <p>
                        Recent additions and stock updates.
                    </p>

                </div>


            </div>



            <div class="feedstore-feed">


                <% updates.forEach(function(update) { %>


                    <%- include(
                        "stock",
                        {
                            update: update,
                            dairy: dairy
                        }
                    ) %>


                <% }); %>


            </div>


        </section>


    <% } %>


</div>



<!-- ==========================================================
     STOCK CATEGORY SWITCHER
========================================================== -->

<script>

document.addEventListener(
    "DOMContentLoaded",
    function() {


        const category =
            document.getElementById(
                "stockCategory"
            );


        const feedField =
            document.getElementById(
                "feedTypeField"
            );


        const medicineField =
            document.getElementById(
                "medicineTypeField"
            );


        const feedSelect =
            document.getElementById(
                "feedType"
            );


        const medicineSelect =
            document.getElementById(
                "medicineType"
            );


        if (!category) {

            return;

        }


        function updateStockType() {


            const value =
                category.value;


            if (value === "medicine") {


                feedField.hidden =
                    true;


                medicineField.hidden =
                    false;


                feedSelect.required =
                    false;


                medicineSelect.required =
                    true;


            } else {


                feedField.hidden =
                    false;


                medicineField.hidden =
                    true;


                feedSelect.required =
                    true;


                medicineSelect.required =
                    false;


            }

        }


        category.addEventListener(
            "change",
            updateStockType
        );


        updateStockType();


    }
);

</script>



<style>

/* ==========================================================
   FEED STORE
========================================================== */

.feedstore-page {

    width: 100%;
    max-width: 1000px;
    margin: 0 auto;

    padding: 18px 0 60px;

    color: #26352d;

}


.feedstore-page *,
.feedstore-page *::before,
.feedstore-page *::after {

    box-sizing: border-box;

}



/* ==========================================================
   INTRO
========================================================== */

.feedstore-intro {

    display: flex;
    align-items: center;

    gap: 15px;

    margin-bottom: 28px;

}


.feedstore-intro-icon {

    width: 56px;
    height: 56px;

    flex: 0 0 56px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 16px;

    background: #edf7f0;

    font-size: 27px;

}


.feedstore-eyebrow {

    margin-bottom: 3px;

    color: #198754;

    font-size: 10px;
    font-weight: 900;

    letter-spacing: 1.2px;

}


.feedstore-intro h1 {

    margin: 0;

    color: #164f31;

    font-size: 28px;
    line-height: 1.15;

    font-weight: 850;

}


.feedstore-intro p {

    margin: 6px 0 0;

    color: #748078;

    font-size: 13px;
    line-height: 1.5;

}



/* ==========================================================
   SECTION
========================================================== */

.feedstore-section {

    margin-top: 30px;

}


.feedstore-section-header {

    margin-bottom: 14px;

}


.feedstore-section-header h2 {

    margin: 0;

    color: #164f31;

    font-size: 20px;
    font-weight: 850;

}


.feedstore-section-header p {

    margin: 5px 0 0;

    color: #7a857e;

    font-size: 12px;

}



/* ==========================================================
   STOCK LIST
========================================================== */

.feedstore-stock-list {

    display: flex;
    flex-direction: column;

    gap: 8px;

}


.feedstore-stock-card {

    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 15px;

    padding: 13px 15px;

    border: 1px solid #e0e9e3;
    border-radius: 13px;

    background: #ffffff;

}


.feedstore-stock-main {

    display: flex;
    align-items: center;

    min-width: 0;

    gap: 12px;

}


.feedstore-stock-icon {

    width: 42px;
    height: 42px;

    flex: 0 0 42px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 12px;

    background: #f0f7f2;

    font-size: 19px;

}


.feedstore-stock-info {

    display: flex;
    flex-direction: column;

    gap: 3px;

    min-width: 0;

}


.feedstore-stock-info strong {

    color: #29362f;

    font-size: 14px;
    font-weight: 800;

}


.feedstore-stock-info span {

    color: #87918b;

    font-size: 11px;

}


.feedstore-stock-quantity {

    display: flex;
    align-items: baseline;

    gap: 5px;

    flex-shrink: 0;

}


.feedstore-stock-quantity strong {

    color: #198754;

    font-size: 18px;
    font-weight: 850;

}


.feedstore-stock-quantity span {

    color: #748078;

    font-size: 11px;
    font-weight: 700;

}



/* ==========================================================
   EMPTY
========================================================== */

.feedstore-empty {

    padding: 35px 20px;

    border: 1px dashed #cbdcd1;
    border-radius: 15px;

    background: #f8fbf9;

    text-align: center;

}


.feedstore-empty-icon {

    font-size: 30px;

}


.feedstore-empty h3 {

    margin: 9px 0 4px;

    color: #2b3931;

    font-size: 16px;

}


.feedstore-empty p {

    margin: 0;

    color: #7d8881;

    font-size: 12px;

}



/* ==========================================================
   ADMIN VALUE
========================================================== */

.feedstore-admin-value {

    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 15px;

    margin-top: 20px;

    padding: 17px 19px;

    border: 1px solid #cfe3d6;
    border-radius: 14px;

    background: #f5faf7;

}


.feedstore-admin-value div {

    display: flex;
    flex-direction: column;

    gap: 5px;

}


.feedstore-admin-value span {

    color: #718078;

    font-size: 9px;
    font-weight: 900;

    letter-spacing: .8px;

}


.feedstore-admin-value strong {

    color: #145c36;

    font-size: 22px;
    font-weight: 850;

}


.feedstore-admin-value small {

    color: #89938d;

    font-size: 10px;

}



/* ==========================================================
   ADMIN LABEL
========================================================== */

.feedstore-admin-label {

    display: inline-flex;

    margin-bottom: 5px;

    padding: 4px 8px;

    border-radius: 999px;

    background: #e9f5ed;

    color: #198754;

    font-size: 9px;
    font-weight: 900;

    letter-spacing: .7px;

}



/* ==========================================================
   FORM
========================================================== */

.feedstore-form {

    padding: 19px;

    border: 1px solid #dce7e0;
    border-radius: 15px;

    background: #ffffff;

}


.feedstore-field {

    display: flex;
    flex-direction: column;

    gap: 7px;

    margin-bottom: 16px;

}


.feedstore-field label {

    color: #344139;

    font-size: 12px;
    font-weight: 800;

}


.feedstore-field input,
.feedstore-field select,
.feedstore-field textarea {

    width: 100%;

    padding: 11px 12px;

    border: 1px solid #d7e2da;
    border-radius: 9px;

    outline: none;

    background: #ffffff;
    color: #26352d;

    font-family: inherit;
    font-size: 13px;

}


.feedstore-field textarea {

    resize: vertical;

    line-height: 1.5;

}


.feedstore-field input:focus,
.feedstore-field select:focus,
.feedstore-field textarea:focus {

    border-color: #198754;

    box-shadow:
        0 0 0 3px
        rgba(25, 135, 84, .08);

}


.feedstore-field small {

    color: #89938d;

    font-size: 10px;
    line-height: 1.4;

}



/* ==========================================================
   TWO COLUMNS
========================================================== */

.feedstore-two-columns {

    display: grid;

    grid-template-columns:
        1fr 1fr;

    gap: 12px;

}



/* ==========================================================
   MONEY
========================================================== */

.feedstore-money {

    display: flex;
    align-items: center;

    overflow: hidden;

    border: 1px solid #d7e2da;
    border-radius: 9px;

}


.feedstore-money span {

    padding-left: 12px;

    color: #198754;

    font-size: 11px;
    font-weight: 850;

}


.feedstore-money input {

    border: none;

}


.feedstore-money:focus-within {

    border-color: #198754;

    box-shadow:
        0 0 0 3px
        rgba(25, 135, 84, .08);

}



/* ==========================================================
   BUTTON
========================================================== */

.feedstore-submit {

    width: 100%;

    min-height: 46px;

    display: flex;
    align-items: center;
    justify-content: center;

    gap: 8px;

    margin-top: 7px;

    border: none;
    border-radius: 10px;

    color: #ffffff;

    font-family: inherit;

    font-size: 13px;
    font-weight: 850;

    cursor: pointer;

}


.admin-submit {

    background: #145c36;

}


.worker-submit {

    background: #198754;

}



/* ==========================================================
   MOBILE
========================================================== */

@media (max-width: 650px) {


