<% /*
==============================================================
FEED STORE PAGE

FILE:
    views/update/feeds-store.ejs

PURPOSE:
    Dedicated dairy foodstock page.

DATA EXPECTED FROM CONTROLLER:
--------------------------------------------------------------
    dairy
    user
    updates
    feedTypes
    medicineTypes
    stockUnits

CURRENT INVENTORY:
--------------------------------------------------------------
    dairy.feedStocks[]

HISTORY:
--------------------------------------------------------------
    updates[]

IMPORTANT:
--------------------------------------------------------------
    The Available Stock section displays the CURRENT
    remainder directly from dairy.feedStocks[].

    Clicking an available stock opens the Add / Restock
    section with that stock prefilled.

    The old "Update Remaining Stock" tab has been removed.

ROLES:
--------------------------------------------------------------
    ADMIN:
        • Can add stock.
        • Can select an existing stock item.
        • Can edit quantity.
        • Can edit unit.
        • Can add information.
        • Can add photos.

    DAIRY WORKER:
        • Can select an existing stock item.
        • Cannot change the unit.
        • Unit comes from the database.
        • Cannot submit a quantity greater than the
          current quantity remaining.
        • Can add information.
        • Can add photos.

IMPORTANT FEED CONTRACT:
--------------------------------------------------------------
    Every history document is rendered independently.

    Each history document is passed to stock.ejs as:

        item: stockItem

    stock.ejs therefore uses:

        item.type
        item.stock
        item.user
        item.userName
        item.userImage
        item.authorRole
        item.title
        item.text
        item.images
        item.createdAt
==============================================================
*/ %>


<%
/* ==========================================================
   SAFE PAGE DATA
========================================================== */

const currentDairy =
    dairy || null;


const currentUser =
    user || null;


/* ==========================================================
   CURRENT INVENTORY

   IMPORTANT:
   This is the database-backed inventory supplied by the
   controller.

   Do not create simulated stock here.
========================================================== */

const feedStoreItems =
    currentDairy &&
    Array.isArray(currentDairy.feedStocks)

        ? currentDairy.feedStocks

        : [];


/* ==========================================================
   STOCK HISTORY
========================================================== */

const feedStoreUpdates =
    Array.isArray(updates)

        ? updates

        : [];


/* ==========================================================
   FORM OPTIONS
========================================================== */

const availableFeedTypes =
    Array.isArray(feedTypes)

        ? feedTypes

        : [];


const availableMedicineTypes =
    Array.isArray(medicineTypes)

        ? medicineTypes

        : [];


const availableStockUnits =
    Array.isArray(stockUnits)

        ? stockUnits

        : [
            "kg",
            "bags",
            "tonnes",
            "bales",
            "litres",
            "bottles",
            "packs",
            "units"
        ];


/* ==========================================================
   USER ROLE
========================================================== */

const isAdmin =
    !!(
        currentUser &&
        currentUser.role === "admin"
    );


const isDairyWorker =
    !!(
        currentUser &&
        currentUser.role === "dairyWorker"
    );


const canUpdateStock =
    isAdmin ||
    isDairyWorker;


/* ==========================================================
   STOCK TYPE HELPER
========================================================== */

function isMedicineStock(stock) {

    if (!stock) {

        return false;

    }


    return (

        String(
            stock.category ||
            stock.stockType ||
            stock.type ||
            ""
        ).toLowerCase() === "medicine"

    );

}


/* ==========================================================
   STOCK NAME
========================================================== */

function getStockName(stock) {

    if (!stock) {

        return "Unnamed Stock";

    }


    return (

        stock.name ||

        stock.feedName ||

        stock.medicineName ||

        stock.stockName ||

        stock.productName ||

        stock.itemName ||

        "Unnamed Stock"

    );

}


/* ==========================================================
   STOCK QUANTITY

   IMPORTANT:
   quantityRemaining is preferred because this represents
   the CURRENT remainder.

   Other fields are only fallbacks for compatibility with
   existing database documents.
========================================================== */

function getStockQuantity(stock) {

    if (!stock) {

        return 0;

    }


    if (
        stock.quantityRemaining !== undefined &&
        stock.quantityRemaining !== null &&
        stock.quantityRemaining !== ""
    ) {

        return Number(
            stock.quantityRemaining
        );

    }


    if (
        stock.remaining !== undefined &&
        stock.remaining !== null &&
        stock.remaining !== ""
    ) {

        return Number(
            stock.remaining
        );

    }


    if (
        stock.quantity !== undefined &&
        stock.quantity !== null &&
        stock.quantity !== ""
    ) {

        return Number(
            stock.quantity
        );

    }


    if (
        stock.amount !== undefined &&
        stock.amount !== null &&
        stock.amount !== ""
    ) {

        return Number(
            stock.amount
        );

    }


    return 0;

}


/* ==========================================================
   STOCK UNIT

   IMPORTANT:
   This comes from the database.

   It is NOT invented when the stock already has a unit.
========================================================== */

function getStockUnit(stock) {

    if (!stock) {

        return "units";

    }


    return (

        stock.unit ||

        stock.stockUnit ||

        "units"

    );

}


/* ==========================================================
   STOCK PRICE
========================================================== */

function getStockPrice(stock) {

    if (!stock) {

        return 0;

    }


    if (
        stock.price !== undefined &&
        stock.price !== null &&
        stock.price !== ""
    ) {

        return Number(
            stock.price
        );

    }


    return 0;

}

%>



<% if (currentDairy && currentUser) { %>


<div
    class="feedstore-page"
    data-dairy-id="<%= currentDairy._id %>"
>


    <!-- ======================================================
         PAGE INTRO
    ======================================================= -->

    <header class="feedstore-intro">


        <div
            class="feedstore-intro-icon"
            aria-hidden="true"
        >
            🌾
        </div>


        <div>

            <div class="feedstore-eyebrow">
                DAIRY FOODSTOCK
            </div>


            <h1>
                <%= currentDairy.name %>'s Foodstock
            </h1>


            <p>
                View current stock, restock supplies and keep
                foodstock records up to date.
            </p>

        </div>


    </header>



    <!-- ======================================================
         TAB NAVIGATION

         ONLY THREE SECTIONS NOW:

         1. Available Stock
         2. Add / Restock Stock
         3. Foodstock Updates
    ======================================================= -->

    <nav
        class="feedstore-tabs"
        aria-label="Foodstock sections"
    >


        <button
            type="button"
            class="feedstore-tab active"
            data-tab="available-stock"
            aria-selected="true"
        >

            <span
                class="feedstore-tab-icon"
                aria-hidden="true"
            >
                📦
            </span>

            <span class="feedstore-tab-text">
                Available Stock
            </span>

        </button>



        <% if (canUpdateStock) { %>


            <button
                type="button"
                class="feedstore-tab"
                data-tab="restock-stock"
                aria-selected="false"
            >

                <span
                    class="feedstore-tab-icon"
                    aria-hidden="true"
                >
                    ➕
                </span>

                <span class="feedstore-tab-text">
                    Add / Restock
                </span>

            </button>


        <% } %>



        <button
            type="button"
            class="feedstore-tab"
            data-tab="foodstock-updates"
            aria-selected="false"
        >

            <span
                class="feedstore-tab-icon"
                aria-hidden="true"
            >
                📝
            </span>

            <span class="feedstore-tab-text">
                Foodstock Updates
            </span>

        </button>


    </nav>



    <!-- ======================================================
         TAB CONTENT
    ======================================================= -->

    <main class="feedstore-tab-content">


        <!-- ==================================================
             TAB 1
             AVAILABLE STOCK
        =================================================== -->

        <section
            class="feedstore-tab-panel active"
            data-panel="available-stock"
        >


            <div class="feedstore-section">


                <div class="feedstore-section-header">

                    <div>

                        <h2>
                            Available Stock
                        </h2>


                        <p>
                            Current quantities recorded in the
                            dairy database. Select a stock item
                            to update or restock it.
                        </p>

                    </div>

                </div>



                <% if (feedStoreItems.length > 0) { %>


                    <div class="feedstore-stock-list">


                        <% feedStoreItems.forEach(
                            function(stockItem)
                        { %>


                            <%
                                const medicine =
                                    isMedicineStock(
                                        stockItem
                                    );


                                const stockName =
                                    getStockName(
                                        stockItem
                                    );


                                const stockQuantity =
                                    getStockQuantity(
                                        stockItem
                                    );


                                const stockUnit =
                                    getStockUnit(
                                        stockItem
                                    );


                                const stockPrice =
                                    getStockPrice(
                                        stockItem
                                    );


                                const stockId =
                                    stockItem &&
                                    stockItem._id
                                        ? String(
                                            stockItem._id
                                        )
                                        : "";


                                const hasStockId =
                                    !!stockId;
                            %>


                            <article
                                class="
                                    feedstore-stock-card
                                    <%= canUpdateStock && hasStockId
                                        ? "feedstore-stock-card--clickable"
                                        : ""
                                    %>
                                "
                                data-stock-id="<%= stockId %>"
                                data-stock-name="<%= stockName %>"
                                data-stock-quantity="<%= stockQuantity %>"
                                data-stock-unit="<%= stockUnit %>"
                                data-stock-price="<%= stockPrice %>"
                                data-stock-type="<%= medicine ? "medicine" : "feed" %>"
                                <% if (
                                    canUpdateStock &&
                                    hasStockId
                                ) { %>
                                    tabindex="0"
                                    role="button"
                                    aria-label="Update <%= stockName %>"
                                <% } %>
                            >


                                <div class="feedstore-stock-main">


                                    <div
                                        class="feedstore-stock-icon"
                                        aria-hidden="true"
                                    >

                                        <% if (medicine) { %>

                                            💊

                                        <% } else { %>

                                            🌾

                                        <% } %>

                                    </div>


                                    <div class="feedstore-stock-info">


                                        <strong>
                                            <%= stockName %>
                                        </strong>


                                        <span>

                                            <% if (medicine) { %>

                                                Veterinary medicine

                                            <% } else { %>

                                                Animal feed

                                            <% } %>

                                        </span>


                                    </div>


                                </div>



                                <div class="feedstore-stock-right">


                                    <div class="feedstore-stock-quantity">


                                        <strong>
                                            <%= Number(
                                                stockQuantity
                                            ).toLocaleString() %>
                                        </strong>


                                        <span>
                                            <%= stockUnit %>
                                        </span>


                                    </div>



                                    <% if (
                                        canUpdateStock &&
                                        hasStockId
                                    ) { %>


                                        <span
                                            class="feedstore-stock-action"
                                            aria-hidden="true"
                                        >
                                            Update →
                                        </span>


                                    <% } %>


                                </div>


                            </article>


                        <% }); %>


                    </div>


                <% } else { %>


                    <div class="feedstore-empty">


                        <div
                            class="feedstore-empty-icon"
                            aria-hidden="true"
                        >
                            🌾
                        </div>


                        <h3>
                            No stock recorded yet
                        </h3>


                        <p>
                            Available animal feed and veterinary
                            medicines will appear here once they
                            are added.
                        </p>


                    </div>


                <% } %>


            </div>



            <% if (isAdmin) { %>


                <section class="feedstore-admin-value">


                    <div>

                        <span>
                            TOTAL FOODSTOCK &amp; MEDICINE VALUE
                        </span>


                        <strong>

                            KES
                            <%= Number(
                                currentDairy.feedsAmount || 0
                            ).toLocaleString(
                                undefined,
                                {
                                    minimumFractionDigits: 2,
                                    maximumFractionDigits: 2
                                }
                            ) %>

                        </strong>

                    </div>


                    <small>
                        Visible to administrators only.
                    </small>


                </section>


            <% } %>


        </section>



        <!-- ==================================================
             TAB 2
             ADD / RESTOCK STOCK
        =================================================== -->

        <% if (canUpdateStock) { %>


            <section
                class="feedstore-tab-panel"
                data-panel="restock-stock"
            >


                <div class="feedstore-section">


                    <div class="feedstore-section-header">


                        <div>

                            <% if (isAdmin) { %>

                                <div class="feedstore-admin-label">
                                    ADMIN
                                </div>

                            <% } %>


                            <h2 id="restockHeading">
                                Add / Restock Stock
                            </h2>


                            <p id="restockDescription">
                                Select a stock item from Available
                                Stock to continue.
                            </p>

                        </div>


                    </div>



                    <!-- ==================================================
                         SELECTED STOCK SUMMARY
                    =================================================== -->

                    <div
                        id="selectedStockSummary"
                        class="feedstore-selected-stock"
                        hidden
                    >


                        <div
                            id="selectedStockIcon"
                            class="feedstore-selected-stock__icon"
                            aria-hidden="true"
                        >
                            🌾
                        </div>


                        <div class="feedstore-selected-stock__info">


                            <span>
                                SELECTED STOCK
                            </span>


                            <strong id="selectedStockName">
                                —
                            </strong>


                            <small id="selectedStockCurrent">
                                Current remainder: —
                            </small>


                        </div>


                    </div>



                    <!-- ==================================================
                         FORM
                    =================================================== -->

                    <form
                        id="feedstoreStockForm"
                        class="feedstore-form"
                        action="/dairy/<%= currentDairy._id %>/feedstore/restock"
                        method="POST"
                        enctype="multipart/form-data"
                    >


                        <!-- ==================================================
                             EXISTING STOCK ID

                             Empty when adding a completely new stock.

                             Filled automatically when an available
                             stock card is clicked.
                        =================================================== -->

                        <input
                            id="selectedStockId"
                            type="hidden"
                            name="stockId"
                            value=""
                        >


                        <!-- ==================================================
                             STOCK CATEGORY
                        =================================================== -->

                        <div class="feedstore-field">


                            <label for="stockCategory">
                                Stock type
                            </label>


                            <select
                                id="stockCategory"
                                name="category"
                                required
                            >


                                <option value="">
                                    Select stock type
                                </option>


                                <option value="feed">
                                    Animal Feed
                                </option>


                                <option value="medicine">
                                    Veterinary Medicine
                                </option>


                            </select>


                        </div>



                        <!-- ==================================================
                             FEED
                        =================================================== -->

                        <div
                            class="feedstore-field"
                            id="feedTypeField"
                        >


                            <label for="feedType">
                                Animal feed
                            </label>


                            <select
                                id="feedType"
                                name="feedName"
                            >


                                <option value="">
                                    Select animal feed
                                </option>


                                <% availableFeedTypes.forEach(
                                    function(type)
                                { %>


                                    <option value="<%= type %>">
                                        <%= type %>
                                    </option>


                                <% }); %>


                            </select>


                        </div>



                        <!-- ==================================================
                             MEDICINE
                        =================================================== -->

                        <div
                            class="feedstore-field"
                            id="medicineTypeField"
                            hidden
                        >


                            <label for="medicineType">
                                Veterinary medicine
                            </label>


                            <select
                                id="medicineType"
                                name="medicineName"
                            >


                                <option value="">
                                    Select veterinary medicine
                                </option>


                                <% availableMedicineTypes.forEach(
                                    function(type)
                                { %>


                                    <option value="<%= type %>">
                                        <%= type %>
                                    </option>


                                <% }); %>


                            </select>


                        </div>



                        <!-- ==================================================
                             QUANTITY + UNIT
                        =================================================== -->

                        <div class="feedstore-two-columns">


                            <div class="feedstore-field">


                                <label for="stockQuantity">
                                    Quantity
                                </label>


                                <input
                                    id="stockQuantity"
                                    type="number"
                                    name="quantity"
                                    min="0"
                                    step="0.01"
                                    placeholder="Enter quantity"
                                    required
                                >


                                <small
                                    id="workerQuantityHelp"
                                    hidden
                                >
                                    You cannot enter a quantity greater
                                    than the current quantity remaining.
                                </small>


                            </div>



                            <div class="feedstore-field">


                                <label for="stockUnit">
                                    Unit
                                </label>


                                <select
                                    id="stockUnit"
                                    name="unit"
                                    required
                                >


                                    <option value="">
                                        Select unit
                                    </option>


                                    <% availableStockUnits.forEach(
                                        function(unit)
                                    { %>


                                        <option value="<%= unit %>">
                                            <%= unit %>
                                        </option>


                                    <% }); %>


                                </select>


                                <% if (isDairyWorker) { %>


                                    <small>
                                        Unit is taken from the current
                                        database record and cannot be
                                        changed by a dairy worker.
                                    </small>


                                <% } else { %>


                                    <small>
                                        Administrators may edit the
                                        stock unit when updating stock.
                                    </small>


                                <% } %>


                            </div>


                        </div>



                        <!-- ==================================================
                             PRICE

                             Kept available for the existing admin
                             restock workflow.

                             Hidden for dairy workers.
                        =================================================== -->

                        <% if (isAdmin) { %>


                            <div class="feedstore-field">


                                <label for="stockPrice">
                                    Price / value
                                </label>


                                <div class="feedstore-money">


                                    <span>
                                        KES
                                    </span>


                                    <input
                                        id="stockPrice"
                                        type="number"
                                        name="price"
                                        min="0"
                                        step="0.01"
                                        placeholder="Enter value"
                                    >


                                </div>


                                <small>
                                    Financial information is visible to
                                    administrators only.
                                </small>


                            </div>


                        <% } %>



                        <!-- ==================================================
                             INSTRUCTIONS
                        =================================================== -->

                        <div class="feedstore-field">


                            <label for="stockInstructions">
                                Instructions of use
                            </label>


                            <textarea
                                id="stockInstructions"
                                name="instructions"
                                rows="4"
                                maxlength="1500"
                                placeholder="How should this feed or medicine be used?"
                            ></textarea>


                        </div>



                        <!-- ==================================================
                             EXPECTED DURATION
                        =================================================== -->

                        <div class="feedstore-field">


                            <label for="expectedDuration">
                                Expected duration of consumption
                            </label>


                            <input
                                id="expectedDuration"
                                type="text"
                                name="expectedDuration"
                                maxlength="100"
                                placeholder="e.g. Approximately 14 days"
                            >


                        </div>



                        <!-- ==================================================
                             ADDITIONAL INFORMATION
                        =================================================== -->

                        <div class="feedstore-field">


                            <label for="stockMessage">
                                Additional information
                            </label>


                            <textarea
                                id="stockMessage"
                                name="message"
                                rows="4"
                                maxlength="1500"
                                placeholder="Add useful information about this stock update..."
                            ></textarea>


                        </div>



                        <!-- ==================================================
                             PHOTOS
                        =================================================== -->

                        <div class="feedstore-field">


                            <label for="stockImages">
                                Images
                            </label>


                            <input
                                id="stockImages"
                                type="file"
                                name="images"
                                accept="image/*"
                                multiple
                            >


                            <small>
                                Add photos related to this stock update.
                            </small>


                        </div>



                        <!-- ==================================================
                             SUBMIT
                        =================================================== -->

                        <button
                            id="feedstoreSubmit"
                            type="submit"
                            class="
                                feedstore-submit
                                <%= isAdmin
                                    ? "admin-submit"
                                    : "worker-submit"
                                %>
                            "
                        >


                            <span
                                id="feedstoreSubmitIcon"
                                aria-hidden="true"
                            >
                                ➕
                            </span>


                            <span id="feedstoreSubmitText">
                                Add Stock
                            </span>


                        </button>


                    </form>


                </div>


            </section>


        <% } %>



        <!-- ==================================================
             TAB 3
             FOODSTOCK HISTORY
        =================================================== -->

        <section
            class="feedstore-tab-panel"
            data-panel="foodstock-updates"
        >


            <div class="feedstore-section">


                <div class="feedstore-section-header">


                    <div>

                        <h2>
                            Foodstock Updates
                        </h2>


                        <p>
                            Additions and remaining-stock updates
                            recorded for this dairy.
                        </p>

                    </div>


                </div>



                <% if (feedStoreUpdates.length > 0) { %>


                    <div class="feedstore-feed">


                        <% feedStoreUpdates.forEach(
                            function(item)
                        { %>


                            <%- include(
                                "stock",
                                {
                                    item: item,
                                    dairy: currentDairy,
                                    user: currentUser
                                }
                            ) %>


                        <% }); %>


                    </div>


                <% } else { %>


                    <div class="feedstore-empty">


                        <div
                            class="feedstore-empty-icon"
                            aria-hidden="true"
                        >
                            📦
                        </div>


                        <h3>
                            No foodstock updates yet
                        </h3>


                        <p>
                            Stock additions and remaining-stock
                            reports will appear here.
                        </p>


                    </div>


                <% } %>


            </div>


        </section>


    </main>


</div>



<!-- ==========================================================
     FEED STORE JAVASCRIPT
========================================================== -->

<script>

document.addEventListener(
    "DOMContentLoaded",
    function () {


        /* ======================================================
           ELEMENTS
        ======================================================= */

        const tabs =
            document.querySelectorAll(
                ".feedstore-tab"
            );


        const panels =
            document.querySelectorAll(
                ".feedstore-tab-panel"
            );


        const stockCards =
            document.querySelectorAll(
                ".feedstore-stock-card--clickable"
            );


        const category =
            document.getElementById(
                "stockCategory"
            );


        const feedField =
            document.getElementById(
                "feedTypeField"
            );


        const medicineField =
            document.getElementById(
                "medicineTypeField"
            );


        const feedSelect =
            document.getElementById(
                "feedType"
            );


        const medicineSelect =
            document.getElementById(
                "medicineType"
            );


        const form =
            document.getElementById(
                "feedstoreStockForm"
            );


        const selectedStockId =
            document.getElementById(
                "selectedStockId"
            );


        const stockQuantity =
            document.getElementById(
                "stockQuantity"
            );


        const stockUnit =
            document.getElementById(
                "stockUnit"
            );


        const stockPrice =
            document.getElementById(
                "stockPrice"
            );


        const stockInstructions =
            document.getElementById(
                "stockInstructions"
            );


        const expectedDuration =
            document.getElementById(
                "expectedDuration"
            );


        const stockMessage =
            document.getElementById(
                "stockMessage"
            );


        const selectedStockSummary =
            document.getElementById(
                "selectedStockSummary"
            );


        const selectedStockName =
            document.getElementById(
                "selectedStockName"
            );


        const selectedStockCurrent =
            document.getElementById(
                "selectedStockCurrent"
            );


        const selectedStockIcon =
            document.getElementById(
                "selectedStockIcon"
            );


        const restockHeading =
            document.getElementById(
                "restockHeading"
            );


        const restockDescription =
            document.getElementById(
                "restockDescription"
            );


        const submitText =
            document.getElementById(
                "feedstoreSubmitText"
            );


        const submitIcon =
            document.getElementById(
                "feedstoreSubmitIcon"
            );


        const workerQuantityHelp =
            document.getElementById(
                "workerQuantityHelp"
            );


        /* ======================================================
           USER / ROLE
        ======================================================= */

        const isAdmin =
            <%= isAdmin ? "true" : "false" %>;


        const isDairyWorker =
            <%= isDairyWorker ? "true" : "false" %>;



        /* ======================================================
           TAB ACTIVATION
        ======================================================= */

        function activateTab(
            tabName,
            shouldScroll
        ) {


            tabs.forEach(
                function(tab) {


                    const isActive =
                        tab.dataset.tab === tabName;


                    tab.classList.toggle(
                        "active",
                        isActive
                    );


                    tab.setAttribute(
                        "aria-selected",
                        isActive
                            ? "true"
                            : "false"
                    );


                }
            );


            panels.forEach(
                function(panel) {


                    const isActive =
                        panel.dataset.panel === tabName;


                    panel.classList.toggle(
                        "active",
                        isActive
                    );


                }
            );


            if (shouldScroll) {

                window.scrollTo({
                    top: 0,
                    behavior: "smooth"
                });

            }

        }



        tabs.forEach(
            function(tab) {


                tab.addEventListener(
                    "click",
                    function() {


                        activateTab(
                            tab.dataset.tab,
                            true
                        );


                    }
                );


            }
        );



        /* ======================================================
           STOCK CATEGORY SWITCHER
        ======================================================= */

        function updateStockType() {


            if (
                !category ||
                !feedField ||
                !medicineField ||
                !feedSelect ||
                !medicineSelect
            ) {

                return;

            }


            const value =
                category.value;


            if (value === "medicine") {


                feedField.hidden =
                    true;


                medicineField.hidden =
                    false;


                feedSelect.required =
                    false;


                medicineSelect.required =
                    !selectedStockId.value;


            } else {


                feedField.hidden =
                    false;


                medicineField.hidden =
                    true;


                feedSelect.required =
                    value === "feed" &&
                    !selectedStockId.value;


                medicineSelect.required =
                    false;


            }

        }



        if (category) {


            category.addEventListener(
                "change",
                updateStockType
            );


        }



        /* ======================================================
           CLEAR NEW STOCK FORM

           Used when the admin simply opens Add / Restock
           without selecting an existing stock item.
        ======================================================= */

        function prepareNewStockForm() {


            if (!form) {

                return;

            }


            form.reset();


            selectedStockId.value =
                "";


            if (selectedStockSummary) {

                selectedStockSummary.hidden =
                    true;

            }


            if (restockHeading) {

                restockHeading.textContent =
                    "Add / Restock Stock";

            }


            if (restockDescription) {

                restockDescription.textContent =
                    "Record newly available animal feed or veterinary medicine.";

            }


            if (submitText) {

                submitText.textContent =
                    "Add Stock";

            }


            if (submitIcon) {

                submitIcon.textContent =
                    "➕";

            }


            if (stockQuantity) {

                stockQuantity.removeAttribute(
                    "max"
                );

            }


            if (workerQuantityHelp) {

                workerQuantityHelp.hidden =
                    true;

            }


            if (isDairyWorker && stockUnit) {

                stockUnit.disabled =
                    false;

            }


            updateStockType();

        }



        /* ======================================================
           OPEN EXISTING STOCK

           Clicking an Available Stock card opens the
           Add / Restock section and pre-fills its database
           values.
        ======================================================= */

        function openExistingStock(
            card
        ) {


            if (
                !card ||
                !form
            ) {

                return;

            }


            const stockId =
                card.dataset.stockId ||
                "";


            const stockName =
                card.dataset.stockName ||
                "Unnamed Stock";


            const quantity =
                Number(
                    card.dataset.stockQuantity || 0
                );


            const unit =
                card.dataset.stockUnit ||
                "";


            const stockType =
                card.dataset.stockType ||
                "feed";


            const price =
                Number(
                    card.dataset.stockPrice || 0
                );


            /* ==================================================
               IDENTIFY EXISTING STOCK
            ================================================== */

            selectedStockId.value =
                stockId;


            /* ==================================================
               SHOW SELECTED STOCK
            ================================================== */

            if (selectedStockSummary) {

                selectedStockSummary.hidden =
                    false;

            }


            if (selectedStockName) {

                selectedStockName.textContent =
                    stockName;

            }


            if (selectedStockCurrent) {

                selectedStockCurrent.textContent =
                    "Current remainder: " +
                    Number(quantity).toLocaleString() +
                    " " +
                    unit;

            }


            if (selectedStockIcon) {

                selectedStockIcon.textContent =
                    stockType === "medicine"
                        ? "💊"
                        : "🌾";

            }


            /* ==================================================
               STOCK TYPE
            ================================================== */

            if (category) {

                category.value =
                    stockType;

            }


            /* ==================================================
               QUANTITY

               Start with the actual database remainder.
            ================================================== */

            if (stockQuantity) {

                stockQuantity.value =
                    quantity;

            }


            /* ==================================================
               UNIT

               The unit always starts from the database.

               Admin:
                   editable.

               Dairy worker:
                   locked.
            ================================================== */

            if (stockUnit) {

                stockUnit.value =
                    unit;


                if (isDairyWorker) {

                    stockUnit.disabled =
                        true;

                } else {

                    stockUnit.disabled =
                        false;

                }

            }


            /* ==================================================
               ADMIN PRICE
            ================================================== */

            if (stockPrice) {

                stockPrice.value =
                    price || "";

            }


            /* ==================================================
               EMPTY UPDATE FIELDS

               Backend data for these fields can be supplied
               later by the controller if desired.

               They are intentionally cleared here so a new
               update does not accidentally reuse another
               stock's information.
            ================================================== */

            if (stockInstructions) {

                stockInstructions.value =
                    "";

            }


            if (expectedDuration) {

                expectedDuration.value =
                    "";

            }


            if (stockMessage) {

                stockMessage.value =
                    "";

            }


            /* ==================================================
               WORKER LIMIT

               A dairy worker cannot submit a quantity above
               the current quantity remaining.
            ================================================== */

            if (stockQuantity) {


                if (isDairyWorker) {


                    stockQuantity.max =
                        String(quantity);


                    if (workerQuantityHelp) {

                        workerQuantityHelp.hidden =
                            false;

                    }


                } else {


                    stockQuantity.removeAttribute(
                        "max"
                    );


                    if (workerQuantityHelp) {

                        workerQuantityHelp.hidden =
                            true;

                    }

                }

            }


            /* ==================================================
               CHANGE TEXT
            ================================================== */

            if (restockHeading) {

                restockHeading.textContent =
                    isAdmin
                        ? "Restock / Update Stock"
                        : "Update Remaining Stock";

            }


            if (restockDescription) {

                restockDescription.textContent =
                    isAdmin
                        ? "The selected stock has been loaded from the database. Edit the quantity, unit or other information as required."
                        : "The selected stock has been loaded from the database. Enter the quantity currently remaining.";

            }


            if (submitText) {

                submitText.textContent =
                    isAdmin
                        ? "Save Stock Update"
                        : "Update Remaining Stock";

            }


            if (submitIcon) {

                submitIcon.textContent =
                    isAdmin
                        ? "💾"
                        : "📦";

            }


            updateStockType();


            /* ==================================================
               OPEN RESTOCK TAB
            ================================================== */

            activateTab(
                "restock-stock",
                true
            );


        }



        /* ======================================================
           AVAILABLE STOCK CLICK EVENTS
        ======================================================= */

        stockCards.forEach(
            function(card) {


                card.addEventListener(
                    "click",
                    function() {

                        openExistingStock(
                            card
                        );

                    }
                );


                card.addEventListener(
                    "keydown",
                    function(event) {


                        if (
                            event.key === "Enter" ||
                            event.key === " "
                        ) {


                            event.preventDefault();


                            openExistingStock(
                                card
                            );


                        }

                    }
                );


            }
        );



        /* ======================================================
           ADMIN ADD / RESTOCK TAB

           When clicking the tab directly rather than through
           an available stock card, prepare a fresh form.
        ======================================================= */

        const restockTab =
            document.querySelector(
                '[data-tab="restock-stock"]'
            );


        if (restockTab) {


            restockTab.addEventListener(
                "click",
                function() {


                    if (
                        selectedStockId &&
                        selectedStockId.value
                    ) {

                        return;

                    }


                    prepareNewStockForm();


                }
            );


        }



        /* ======================================================
           WORKER QUANTITY VALIDATION
        ======================================================= */

        if (stockQuantity) {


            stockQuantity.addEventListener(
                "input",
                function() {


                    if (!isDairyWorker) {

                        return;

                    }


                    if (
                        !stockQuantity.hasAttribute(
                            "max"
                        )
                    ) {

                        return;

                    }


                    const maximum =
                        Number(
                            stockQuantity.max
                        );


                    const entered =
                        Number(
                            stockQuantity.value
                        );


                    if (
                        Number.isFinite(
                            maximum
                        ) &&
                        Number.isFinite(
                            entered
                        ) &&
                        entered > maximum
                    ) {


                        stockQuantity.value =
                            maximum;


                    }


                }
            );


        }



        /* ======================================================
           FINAL WORKER FORM VALIDATION

           Client-side protection only.

           The service/controller MUST perform the same
           validation against the database.
        ======================================================= */

        if (form) {


            form.addEventListener(
                "submit",
                function(event) {


                    if (!isDairyWorker) {

                        return;

                    }


                    if (
                        !selectedStockId ||
                        !selectedStockId.value
                    ) {

                        return;

                    }


                    const maximum =
                        Number(
                            stockQuantity.max
                        );


                    const entered =
                        Number(
                            stockQuantity.value
                        );


                    if (
                        Number.isFinite(maximum) &&
                        Number.isFinite(entered) &&
                        entered > maximum
                    ) {


                        event.preventDefault();


                        stockQuantity.value =
                            maximum;


                        stockQuantity.focus();


                        alert(
                            "A dairy worker cannot enter a quantity greater than the current stock remainder."
                        );


                    }


                }
            );


        }



        /* ======================================================
           INITIAL CATEGORY STATE
        ======================================================= */

        updateStockType();


    }
);

</script>



