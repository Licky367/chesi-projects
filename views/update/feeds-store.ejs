    font-size: 16px;

}


.feedstore-empty p {

    margin: 0;

    color: #7d8881;

    font-size: 12px;

}



/* ==========================================================
   ADMIN VALUE
========================================================== */

.feedstore-admin-value {

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 15px;

    margin-top: 20px;

    padding: 17px 19px;

    border: 1px solid #cfe3d6;

    border-radius: 14px;

    background: #f5faf7;

}


.feedstore-admin-value div {

    display: flex;

    flex-direction: column;

    gap: 5px;

}


.feedstore-admin-value span {

    color: #718078;

    font-size: 9px;

    font-weight: 900;

    letter-spacing: .8px;

}


.feedstore-admin-value strong {

    color: #145c36;

    font-size: 22px;

    font-weight: 850;

}


.feedstore-admin-value small {

    color: #89938d;

    font-size: 10px;

}



/* ==========================================================
   ADMIN LABEL
========================================================== */

.feedstore-admin-label {

    display: inline-flex;

    margin-bottom: 5px;

    padding: 4px 8px;

    border-radius: 999px;

    background: #e9f5ed;

    color: #198754;

    font-size: 9px;

    font-weight: 900;

    letter-spacing: .7px;

}



/* ==========================================================
   FORM
========================================================== */

.feedstore-form {

    padding: 19px;

    border: 1px solid #dce7e0;

    border-radius: 15px;

    background: #ffffff;

}


.feedstore-field {

    display: flex;

    flex-direction: column;

    gap: 7px;

    margin-bottom: 16px;

}


.feedstore-field label {

    color: #344139;

    font-size: 12px;

