    animation:
        feedstorePanelIn .18s ease;

}


@keyframes feedstorePanelIn {

    from {

        opacity: 0;

        transform:
            translateY(4px);

    }

    to {

        opacity: 1;

        transform:
            translateY(0);

    }

}


