<% /*
==============================================================
FEED STORE PAGE

FILE:
    views/update/feeds-store.ejs

PURPOSE:
    Dedicated dairy foodstock page.

DATA EXPECTED FROM CONTROLLER:
--------------------------------------------------------------
    dairy
    user
    updates
    feedTypes
    medicineTypes
    stockUnits

CURRENT INVENTORY:
--------------------------------------------------------------
    dairy.feedStocks[]

HISTORY:
--------------------------------------------------------------
    updates[]

IMPORTANT STOCK RULE:
--------------------------------------------------------------
    ADMIN:
        • Creates new stock.
        • Restocks existing stock.
        • Can change unit.
        • Can enter price/value.
        • Can add instructions.
        • Can add expected duration.
        • Can add additional information.
        • Can add photos.

    DAIRY WORKER:
        • NEVER creates stock.
        • NEVER restocks stock.
        • Selects an existing stock item only.
        • Reports the CURRENT quantity remaining.
        • Cannot change the unit.
        • Cannot report more than the current quantity.
        • Can add instructions.
        • Can add expected duration.
        • Can add additional information.
        • Can add photos.

IMPORTANT:
--------------------------------------------------------------
    Every history document is rendered independently.

    Each history document is passed to stock.ejs as:

        item: stockItem

    stock.ejs therefore uses:

        item.type
        item.stock
        item.user
        item.userName
        item.userImage
        item.authorRole
        item.title
        item.text
        item.images
        item.createdAt
==============================================================
*/ %>


<%
/* ==========================================================
   SAFE PAGE DATA
========================================================== */

const currentDairy =
    dairy || null;


const currentUser =
    user || null;


/* ==========================================================
   CURRENT INVENTORY
========================================================== */

const feedStoreItems =
    currentDairy &&
    Array.isArray(currentDairy.feedStocks)

        ? currentDairy.feedStocks

        : [];


/* ==========================================================
   STOCK HISTORY
========================================================== */

const feedStoreUpdates =
    Array.isArray(updates)

        ? updates

        : [];


/* ==========================================================
   FORM OPTIONS
========================================================== */

const availableFeedTypes =
    Array.isArray(feedTypes)

        ? feedTypes

        : [];


const availableMedicineTypes =
    Array.isArray(medicineTypes)

        ? medicineTypes

        : [];


const availableStockUnits =
    Array.isArray(stockUnits)

        ? stockUnits

        : [
            "kg",
            "bags",
            "tonnes",
            "bales",
            "litres",
            "bottles",
            "packs",
            "units"
        ];


/* ==========================================================
   USER ROLE
========================================================== */

const isAdmin =
    !!(
        currentUser &&
        currentUser.role === "admin"
    );


const isDairyWorker =
    !!(
        currentUser &&
        currentUser.role === "dairyWorker"
    );


/*
==============================================================
IMPORTANT ROLE RULE

Only administrators can restock.

Dairy workers can ONLY update remaining quantity.
==============================================================
*/

const canRestock =
    isAdmin;


const canUpdateRemaining =
    isAdmin ||
    isDairyWorker;


/* ==========================================================
   STOCK TYPE HELPER
========================================================== */

function isMedicineStock(stock) {

    if (!stock) {

        return false;

    }


    return (

        String(
            stock.category ||
            stock.stockType ||
            stock.type ||
            ""
        ).toLowerCase() === "medicine"

    );

}


/* ==========================================================
   STOCK NAME
========================================================== */

function getStockName(stock) {

    if (!stock) {

        return "Unnamed Stock";

    }


    return (

        stock.name ||

        stock.feedName ||

        stock.medicineName ||

        stock.stockName ||

        stock.productName ||

        stock.itemName ||

        "Unnamed Stock"

    );

}


/* ==========================================================
   STOCK QUANTITY
========================================================== */

function getStockQuantity(stock) {

    if (!stock) {

        return 0;

    }


    if (
        stock.quantityRemaining !== undefined &&
        stock.quantityRemaining !== null &&
        stock.quantityRemaining !== ""
    ) {

        return Number(
            stock.quantityRemaining
        );

    }


    if (
        stock.remaining !== undefined &&
        stock.remaining !== null &&
        stock.remaining !== ""
    ) {

        return Number(
            stock.remaining
        );

    }


    if (
        stock.quantity !== undefined &&
        stock.quantity !== null &&
        stock.quantity !== ""
    ) {

        return Number(
            stock.quantity
        );

    }


    if (
        stock.amount !== undefined &&
        stock.amount !== null &&
        stock.amount !== ""
    ) {

        return Number(
            stock.amount
        );

    }


    return 0;

}


/* ==========================================================
   STOCK UNIT
========================================================== */

function getStockUnit(stock) {

    if (!stock) {

        return "units";

    }


    return (

        stock.unit ||

        stock.stockUnit ||

        "units"

    );

}


/* ==========================================================
   STOCK PRICE
========================================================== */

function getStockPrice(stock) {

    if (!stock) {

        return 0;

    }


    if (
        stock.price !== undefined &&
        stock.price !== null &&
        stock.price !== ""
    ) {

        return Number(
            stock.price
        );

    }


    return 0;

}

%>



<% if (currentDairy && currentUser) { %>


<div
    class="feedstore-page"
    data-dairy-id="<%= currentDairy._id %>"
    data-user-role="<%= currentUser.role || "" %>"
>


    <!-- ======================================================
         PAGE INTRO
    ======================================================= -->

    <header class="feedstore-intro">


        <div
            class="feedstore-intro-icon"
            aria-hidden="true"
        >
            🌾
        </div>


        <div>

            <div class="feedstore-eyebrow">
                DAIRY FOODSTOCK
            </div>


            <h1>
                <%= currentDairy.name %>'s Foodstock
            </h1>


            <p>
                View current stock and keep foodstock records
                up to date.
            </p>

        </div>


    </header>



    <!-- ======================================================
         TAB NAVIGATION

         ADMIN:
             Available Stock
             Add / Restock
             Foodstock Updates

         DAIRY WORKER:
             Available Stock
             Foodstock Updates
    ======================================================= -->

    <nav
        class="
            feedstore-tabs
            <%= isAdmin
                ? "feedstore-tabs--admin"
                : "feedstore-tabs--worker"
            %>
        "
        aria-label="Foodstock sections"
    >


        <!-- ==================================================
             AVAILABLE STOCK
        =================================================== -->

        <button
            type="button"
            class="feedstore-tab active"
            data-tab="available-stock"
            aria-selected="true"
        >

            <span
                class="feedstore-tab-icon"
                aria-hidden="true"
            >
                📦
            </span>

            <span class="feedstore-tab-text">
                Available Stock
            </span>

        </button>



        <!-- ==================================================
             ADMIN ONLY:
             ADD / RESTOCK
        =================================================== -->

        <% if (isAdmin) { %>


            <button
                type="button"
                class="feedstore-tab"
                data-tab="restock-stock"
                aria-selected="false"
            >

                <span
                    class="feedstore-tab-icon"
                    aria-hidden="true"
                >
                    ➕
                </span>

                <span class="feedstore-tab-text">
                    Add / Restock
                </span>

            </button>


        <% } %>



        <!-- ==================================================
             HISTORY
        =================================================== -->

        <button
            type="button"
            class="feedstore-tab"
            data-tab="foodstock-updates"
            aria-selected="false"
        >

            <span
                class="feedstore-tab-icon"
                aria-hidden="true"
            >
                📝
            </span>

            <span class="feedstore-tab-text">
                Foodstock Updates
            </span>

        </button>


    </nav>



    <!-- ======================================================
         TAB CONTENT
    ======================================================= -->

    <main class="feedstore-tab-content">


        <!-- ==================================================
             TAB 1
             AVAILABLE STOCK
        =================================================== -->

        <section
            class="feedstore-tab-panel active"
            data-panel="available-stock"
        >


            <div class="feedstore-section">


                <div class="feedstore-section-header">

                    <div>

                        <h2>
                            Available Stock
                        </h2>


                        <% if (isAdmin) { %>

                            <p>
                                Select an item to add or restock
                                it, or use Add / Restock to create
                                new stock.
                            </p>

                        <% } else { %>

                            <p>
                                Select a stock item to report the
                                quantity currently remaining.
                            </p>

                        <% } %>

                    </div>

                </div>



                <% if (feedStoreItems.length > 0) { %>


                    <div class="feedstore-stock-list">


                        <% feedStoreItems.forEach(
                            function(stockItem)
                        { %>


                            <%
                                const medicine =
                                    isMedicineStock(
                                        stockItem
                                    );


                                const stockName =
                                    getStockName(
                                        stockItem
                                    );


                                const stockQuantity =
                                    getStockQuantity(
                                        stockItem
                                    );


                                const stockUnit =
                                    getStockUnit(
                                        stockItem
                                    );


                                const stockPrice =
                                    getStockPrice(
                                        stockItem
                                    );


                                const stockId =
                                    stockItem &&
                                    stockItem._id
                                        ? String(
                                            stockItem._id
                                        )
                                        : "";


                                const hasStockId =
                                    !!stockId;
                            %>


                            <article
                                class="
                                    feedstore-stock-card
                                    <%= canUpdateRemaining && hasStockId
                                        ? "feedstore-stock-card--clickable"
                                        : ""
                                    %>
                                "
                                data-stock-id="<%= stockId %>"
                                data-stock-name="<%= stockName %>"
                                data-stock-quantity="<%= stockQuantity %>"
                                data-stock-unit="<%= stockUnit %>"
                                data-stock-price="<%= stockPrice %>"
                                data-stock-type="<%= medicine ? "medicine" : "feed" %>"
                                <% if (
                                    canUpdateRemaining &&
                                    hasStockId
                                ) { %>
                                    tabindex="0"
                                    role="button"
                                    aria-label="<%= isAdmin ? "Restock " : "Update remaining " %><%= stockName %>"
                                <% } %>
                            >


                                <div class="feedstore-stock-main">


                                    <div
                                        class="feedstore-stock-icon"
                                        aria-hidden="true"
                                    >

                                        <% if (medicine) { %>

                                            💊

                                        <% } else { %>

                                            🌾

                                        <% } %>

                                    </div>


                                    <div class="feedstore-stock-info">


                                        <strong>
                                            <%= stockName %>
                                        </strong>


                                        <span>

                                            <% if (medicine) { %>

                                                Veterinary medicine

                                            <% } else { %>

                                                Animal feed

                                            <% } %>

                                        </span>


                                    </div>


                                </div>



                                <div class="feedstore-stock-right">


                                    <div class="feedstore-stock-quantity">


                                        <strong>
                                            <%= Number(
                                                stockQuantity
                                            ).toLocaleString() %>
                                        </strong>


                                        <span>
                                            <%= stockUnit %>
                                        </span>


                                    </div>



                                    <% if (
                                        canUpdateRemaining &&
                                        hasStockId
                                    ) { %>


                                        <span
                                            class="feedstore-stock-action"
                                            aria-hidden="true"
                                        >

                                            <% if (isAdmin) { %>

                                                Restock →

                                            <% } else { %>

                                                Update →

                                            <% } %>

                                        </span>


                                    <% } %>


                                </div>


                            </article>


                        <% }); %>


                    </div>


                <% } else { %>


                    <div class="feedstore-empty">


                        <div
                            class="feedstore-empty-icon"
                            aria-hidden="true"
                        >
                            🌾
                        </div>


                        <h3>
                            No stock recorded yet
                        </h3>


                        <p>

                            <% if (isAdmin) { %>

                                Use Add / Restock to add the
                                first animal feed or veterinary
                                medicine.

                            <% } else { %>

                                Available animal feed and
                                veterinary medicines will appear
                                here once they are added by an
                                administrator.

                            <% } %>

                        </p>


                    </div>


                <% } %>


            </div>



            <% if (isAdmin) { %>


                <section class="feedstore-admin-value">


                    <div>

                        <span>
                            TOTAL FOODSTOCK &amp; MEDICINE VALUE
                        </span>


                        <strong>

                            KES
                            <%= Number(
                                currentDairy.feedsAmount || 0
                            ).toLocaleString(
                                undefined,
                                {
                                    minimumFractionDigits: 2,
                                    maximumFractionDigits: 2
                                }
                            ) %>

                        </strong>

                    </div>


                    <small>
                        Visible to administrators only.
                    </small>


                </section>


            <% } %>


        </section>



        <!-- ==================================================
             TAB 2
             ADMIN ONLY: ADD / RESTOCK
        =================================================== -->

        <% if (isAdmin) { %>


            <section
                class="feedstore-tab-panel"
                data-panel="restock-stock"
            >


                <div class="feedstore-section">


                    <div class="feedstore-section-header">


                        <div>

                            <div class="feedstore-admin-label">
                                ADMIN ONLY
                            </div>


                            <h2 id="restockHeading">
                                Add / Restock Stock
                            </h2>


                            <p id="restockDescription">
                                Add newly available stock or select
                                an existing stock item to restock it.
                            </p>

                        </div>


                    </div>



                    <!-- ==================================================
                         SELECTED STOCK SUMMARY
                    =================================================== -->

                    <div
                        id="selectedStockSummary"
                        class="feedstore-selected-stock"
                        hidden
                    >


                        <div
                            id="selectedStockIcon"
                            class="feedstore-selected-stock__icon"
                            aria-hidden="true"
                        >
                            🌾
                        </div>


                        <div class="feedstore-selected-stock__info">


                            <span>
                                SELECTED STOCK
                            </span>


                            <strong id="selectedStockName">
                                —
                            </strong>


                            <small id="selectedStockCurrent">
                                Current remainder: —
                            </small>


                        </div>


                    </div>



                    <!-- ==================================================
                         ADMIN FORM
                    =================================================== -->

                    <form
                        id="feedstoreStockForm"
                        class="feedstore-form"
                        action="/dairy/<%= currentDairy._id %>/feedstore/restock"
                        method="POST"
                        enctype="multipart/form-data"
                    >


                        <!-- ==================================================
                             EXISTING STOCK ID
                        =================================================== -->

                        <input
                            id="selectedStockId"
                            type="hidden"
                            name="stockId"
                            value=""
                        >


                        <!-- ==================================================
                             STOCK CATEGORY
                        =================================================== -->

                        <div class="feedstore-field">


                            <label for="stockCategory">
                                Stock type
                            </label>


                            <select
                                id="stockCategory"
                                name="category"
                                required
                            >


                                <option value="">
                                    Select stock type
                                </option>


                                <option value="feed">
                                    Animal Feed
                                </option>


                                <option value="medicine">
                                    Veterinary Medicine
                                </option>


                            </select>


                        </div>



                        <!-- ==================================================
                             FEED
                        =================================================== -->

                        <div
                            class="feedstore-field"
                            id="feedTypeField"
                        >


                            <label for="feedType">
                                Animal feed
                            </label>


                            <select
                                id="feedType"
                                name="feedName"
                            >


                                <option value="">
                                    Select animal feed
                                </option>


                                <% availableFeedTypes.forEach(
                                    function(type)
                                { %>


                                    <option value="<%= type %>">
                                        <%= type %>
                                    </option>


                                <% }); %>


                            </select>


                        </div>



                        <!-- ==================================================
                             MEDICINE
                        =================================================== -->

                        <div
                            class="feedstore-field"
                            id="medicineTypeField"
                            hidden
                        >


                            <label for="medicineType">
                                Veterinary medicine
                            </label>


                            <select
                                id="medicineType"
                                name="medicineName"
                            >


                                <option value="">
                                    Select veterinary medicine
                                </option>


                                <% availableMedicineTypes.forEach(
                                    function(type)
                                { %>


                                    <option value="<%= type %>">
                                        <%= type %>
                                    </option>


                                <% }); %>


                            </select>


                        </div>



                        <!-- ==================================================
                             QUANTITY + UNIT
                        =================================================== -->

                        <div class="feedstore-two-columns">


                            <div class="feedstore-field">


                                <label for="stockQuantity">
                                    Quantity to add
                                </label>


                                <input
                                    id="stockQuantity"
                                    type="number"
                                    name="quantity"
                                    min="0"
                                    step="0.01"
                                    placeholder="Enter quantity to add"
                                    required
                                >


                                <small id="quantityHelp">
                                    For an existing stock item, this is
                                    the additional quantity being added.
                                </small>


                            </div>



                            <div class="feedstore-field">


                                <label for="stockUnit">
                                    Unit
                                </label>


                                <select
                                    id="stockUnit"
                                    name="unit"
                                    required
                                >


                                    <option value="">
                                        Select unit
                                    </option>


                                    <% availableStockUnits.forEach(
                                        function(unit)
                                    { %>


                                        <option value="<%= unit %>">
                                            <%= unit %>
                                        </option>


                                    <% }); %>


                                </select>


                                <small>
                                    Administrators may select or change
                                    the stock unit.
                                </small>


                            </div>


                        </div>



                        <!-- ==================================================
                             PRICE
                        =================================================== -->

                        <div class="feedstore-field">


                            <label for="stockPrice">
                                Price / value
                            </label>


                            <div class="feedstore-money">


                                <span>
                                    KES
                                </span>


                                <input
                                    id="stockPrice"
                                    type="number"
                                    name="price"
                                    min="0"
                                    step="0.01"
                                    placeholder="Enter value"
                                >


                            </div>


                            <small>
                                Financial information is visible to
                                administrators only.
                            </small>


                        </div>



                        <!-- ==================================================
                             INSTRUCTIONS
                        =================================================== -->

                        <div class="feedstore-field">


                            <label for="stockInstructions">
                                Instructions of use
                            </label>


                            <textarea
                                id="stockInstructions"
                                name="instructions"
                                rows="4"
                                maxlength="1500"
                                placeholder="How should this feed or medicine be used?"
                            ></textarea>


                        </div>



                        <!-- ==================================================
                             EXPECTED DURATION
                        =================================================== -->

                        <div class="feedstore-field">


                            <label for="expectedDuration">
                                Expected duration of consumption
                            </label>


                            <input
                                id="expectedDuration"
                                type="text"
                                name="expectedDuration"
                                maxlength="100"
                                placeholder="e.g. Approximately 14 days"
                            >


                        </div>



                        <!-- ==================================================
                             ADDITIONAL INFORMATION
                        =================================================== -->

                        <div class="feedstore-field">


                            <label for="stockMessage">
                                Additional information
                            </label>


                            <textarea
                                id="stockMessage"
                                name="message"
                                rows="4"
                                maxlength="1500"
                                placeholder="Add useful information about this stock update..."
                            ></textarea>


                        </div>



                        <!-- ==================================================
                             PHOTOS
                        =================================================== -->

                        <div class="feedstore-field">


                            <label for="stockImages">
                                Images
                            </label>


                            <input
                                id="stockImages"
                                type="file"
                                name="images"
                                accept="image/*"
                                multiple
                            >


                            <small>
                                Add photos related to this stock update.
                            </small>


                        </div>



                        <!-- ==================================================
                             SUBMIT
                        =================================================== -->

                        <button
                            id="feedstoreSubmit"
                            type="submit"
                            class="
                                feedstore-submit
                                admin-submit
                            "
                        >


                            <span
                                id="feedstoreSubmitIcon"
                                aria-hidden="true"
                            >
                                ➕
                            </span>


                            <span id="feedstoreSubmitText">
                                Add Stock
                            </span>


                        </button>


                    </form>


                </div>


            </section>


        <% } %>



        <!-- ==================================================
             DAIRY WORKER REMAINING-STOCK FORM

             IMPORTANT:
             This is NOT a separate tab.

             It appears in the same update panel when a worker
             selects an existing stock item.
        =================================================== -->

        <% if (isDairyWorker) { %>


            <section
                id="workerUpdatePanel"
                class="feedstore-worker-update-panel"
                hidden
            >


                <div class="feedstore-section">


                    <div class="feedstore-section-header">


                        <div>

                            <div class="feedstore-worker-label">
                                DAIRY WORKER
                            </div>


                            <h2>
                                Update Remaining Stock
                            </h2>


                            <p>
                                Report the quantity currently remaining
                                in the selected stock item.
                            </p>

                        </div>


                    </div>



                    <div
                        id="workerSelectedStockSummary"
                        class="feedstore-selected-stock"
                    >


                        <div
                            id="workerSelectedStockIcon"
                            class="feedstore-selected-stock__icon"
                            aria-hidden="true"
                        >
                            🌾
                        </div>


                        <div class="feedstore-selected-stock__info">


                            <span>
                                SELECTED STOCK
                            </span>


                            <strong id="workerSelectedStockName">
                                —
                            </strong>


                            <small id="workerSelectedStockCurrent">
                                Current remainder: —
                            </small>


                        </div>


                    </div>



                    <form
                        id="workerStockForm"
                        class="feedstore-form"
                        action="/dairy/<%= currentDairy._id %>/feedstore/remaining"
                        method="POST"
                        enctype="multipart/form-data"
                    >


                        <input
                            id="workerStockId"
                            type="hidden"
                            name="stockId"
                            value=""
                        >


                        <!-- ==================================================
                             TYPE

                             Hidden because the worker cannot change
                             the existing stock type.
                        =================================================== -->

                        <input
                            id="workerStockCategory"
                            type="hidden"
                            name="category"
                            value=""
                        >


                        <!-- ==================================================
                             UNIT

                             Hidden field is required because the visible
                             disabled select is NOT submitted by browsers.
                        =================================================== -->

                        <input
                            id="workerStockUnitHidden"
                            type="hidden"
                            name="unit"
                            value=""
                        >


                        <div class="feedstore-field">


                            <label for="workerQuantity">
                                Quantity currently remaining
                            </label>


                            <input
                                id="workerQuantity"
                                type="number"
                                name="quantity"
                                min="0"
                                step="0.01"
                                placeholder="Enter quantity remaining"
                                required
                            >


                            <small id="workerQuantityHelp">
                                You cannot report more than the current
                                database quantity.
                            </small>


                        </div>



                        <div class="feedstore-field">


                            <label>
                                Unit
                            </label>


                            <input
                                id="workerStockUnitDisplay"
                                type="text"
                                value=""
                                readonly
                                disabled
                            >


                            <small>
                                The unit belongs to the existing stock
                                record and cannot be changed by a
                                dairy worker.
                            </small>


                        </div>



                        <!-- ==================================================
                             INSTRUCTIONS
                        =================================================== -->

                        <div class="feedstore-field">


                            <label for="workerInstructions">
                                Instructions of use
                            </label>


                            <textarea
                                id="workerInstructions"
                                name="instructions"
                                rows="4"
                                maxlength="1500"
                                placeholder="Add or update instructions..."
                            ></textarea>


                        </div>



                        <!-- ==================================================
                             EXPECTED DURATION
                        =================================================== -->

                        <div class="feedstore-field">


                            <label for="workerExpectedDuration">
                                Expected duration of consumption
                            </label>


                            <input
                                id="workerExpectedDuration"
                                type="text"
                                name="expectedDuration"
                                maxlength="100"
                                placeholder="e.g. Approximately 7 days"
                            >


                        </div>



                        <!-- ==================================================
                             ADDITIONAL INFORMATION
                        =================================================== -->

                        <div class="feedstore-field">


                            <label for="workerMessage">
                                Additional information
                            </label>


                            <textarea
                                id="workerMessage"
                                name="message"
                                rows="4"
                                maxlength="1500"
                                placeholder="Report anything useful about the remaining stock..."
                            ></textarea>


                        </div>



                        <!-- ==================================================
                             PHOTOS
                        =================================================== -->

                        <div class="feedstore-field">


                            <label for="workerImages">
                                Photos
                            </label>


                            <input
                                id="workerImages"
                                type="file"
                                name="images"
                                accept="image/*"
                                multiple
                            >


                            <small>
                                Add photos related to this remaining-stock
                                report.
                            </small>


                        </div>



                        <!-- ==================================================
                             SUBMIT
                        =================================================== -->

                        <button
                            type="submit"
                            class="feedstore-submit worker-submit"
                        >


                            <span aria-hidden="true">
                                📦
                            </span>


                            <span>
                                Submit Remaining Stock
                            </span>


                        </button>


                    </form>


                </div>


            </section>


        <% } %>



        <!-- ==================================================
             FOODSTOCK HISTORY
        =================================================== -->

        <section
            class="feedstore-tab-panel"
            data-panel="foodstock-updates"
        >


            <div class="feedstore-section">


                <div class="feedstore-section-header">


                    <div>

                        <h2>
                            Foodstock Updates
                        </h2>


                        <p>

                            <% if (isAdmin) { %>

                                Stock additions, restocks and
                                remaining-stock reports recorded
                                for this dairy.

                            <% } else { %>

                                Remaining-stock reports and other
                                foodstock information recorded for
                                this dairy.

                            <% } %>

                        </p>

                    </div>


                </div>



                <% if (feedStoreUpdates.length > 0) { %>


                    <div class="feedstore-feed">


                        <% feedStoreUpdates.forEach(
                            function(item)
                        { %>


                            <%- include(
                                "stock",
                                {
                                    item: item,
                                    dairy: currentDairy,
                                    user: currentUser
                                }
                            ) %>


                        <% }); %>


                    </div>


                <% } else { %>


                    <div class="feedstore-empty">


                        <div
                            class="feedstore-empty-icon"
                            aria-hidden="true"
                        >
                            📦
                        </div>


                        <h3>
                            No foodstock updates yet
                        </h3>


                        <p>

                            <% if (isAdmin) { %>

                                Stock additions and remaining-stock
                                reports will appear here.

                            <% } else { %>

                                Remaining-stock reports will appear
                                here after they are submitted.

                            <% } %>

                        </p>


                    </div>


                <% } %>


            </div>


        </section>


    </main>


</div>



<!-- ==========================================================
     FEED STORE JAVASCRIPT
========================================================== -->

<script>

document.addEventListener(
    "DOMContentLoaded",
    function () {


        /* ======================================================
           ELEMENTS
        ======================================================= */

        const tabs =
            document.querySelectorAll(
                ".feedstore-tab"
            );


        const panels =
            document.querySelectorAll(
                ".feedstore-tab-panel"
            );


        const stockCards =
            document.querySelectorAll(
                ".feedstore-stock-card--clickable"
            );


        /* ======================================================
           ADMIN FORM ELEMENTS
        ======================================================= */

        const adminForm =
            document.getElementById(
                "feedstoreStockForm"
            );


        const category =
            document.getElementById(
                "stockCategory"
            );


        const feedField =
            document.getElementById(
                "feedTypeField"
            );


        const medicineField =
            document.getElementById(
                "medicineTypeField"
            );


        const feedSelect =
            document.getElementById(
                "feedType"
            );


        const medicineSelect =
            document.getElementById(
                "medicineType"
            );


        const selectedStockId =
            document.getElementById(
                "selectedStockId"
            );


        const stockQuantity =
            document.getElementById(
                "stockQuantity"
            );


        const stockUnit =
            document.getElementById(
                "stockUnit"
            );


        const stockPrice =
            document.getElementById(
                "stockPrice"
            );


        const stockInstructions =
            document.getElementById(
                "stockInstructions"
            );


        const expectedDuration =
            document.getElementById(
                "expectedDuration"
            );


        const stockMessage =
            document.getElementById(
                "stockMessage"
            );


        const selectedStockSummary =
            document.getElementById(
                "selectedStockSummary"
            );


        const selectedStockName =
            document.getElementById(
                "selectedStockName"
            );


        const selectedStockCurrent =
            document.getElementById(
                "selectedStockCurrent"
            );


        const selectedStockIcon =
            document.getElementById(
                "selectedStockIcon"
            );


        const restockHeading =
            document.getElementById(
                "restockHeading"
            );


        const restockDescription =
            document.getElementById(
                "restockDescription"
            );


        const submitText =
            document.getElementById(
                "feedstoreSubmitText"
            );


        const submitIcon =
            document.getElementById(
                "feedstoreSubmitIcon"
            );


        const quantityHelp =
            document.getElementById(
                "quantityHelp"
            );


        /* ======================================================
           WORKER FORM ELEMENTS
        ======================================================= */

        const workerPanel =
            document.getElementById(
                "workerUpdatePanel"
            );


        const workerForm =
            document.getElementById(
                "workerStockForm"
            );


        const workerStockId =
            document.getElementById(
                "workerStockId"
            );


        const workerStockCategory =
            document.getElementById(
                "workerStockCategory"
            );


        const workerStockUnitHidden =
            document.getElementById(
                "workerStockUnitHidden"
            );


        const workerQuantity =
            document.getElementById(
                "workerQuantity"
            );


        const workerStockUnitDisplay =
            document.getElementById(
                "workerStockUnitDisplay"
            );


        const workerSelectedStockName =
            document.getElementById(
                "workerSelectedStockName"
            );


        const workerSelectedStockCurrent =
            document.getElementById(
                "workerSelectedStockCurrent"
            );


        const workerSelectedStockIcon =
            document.getElementById(
                "workerSelectedStockIcon"
            );


        /* ======================================================
           ROLE
        ======================================================= */

        const isAdmin =
            <%= isAdmin ? "true" : "false" %>;


        const isDairyWorker =
            <%= isDairyWorker ? "true" : "false" %>;



        /* ======================================================
           TAB ACTIVATION
        ======================================================= */

        function activateTab(
            tabName,
            shouldScroll
        ) {


            tabs.forEach(
                function(tab) {


                    const isActive =
                        tab.dataset.tab === tabName;


                    tab.classList.toggle(
                        "active",
                        isActive
                    );


                    tab.setAttribute(
                        "aria-selected",
                        isActive
                            ? "true"
                            : "false"
                    );


                }
            );


            panels.forEach(
                function(panel) {


                    const isActive =
                        panel.dataset.panel === tabName;


                    panel.classList.toggle(
                        "active",
                        isActive
                    );


                }
            );


            if (shouldScroll) {


                window.scrollTo({

                    top: 0,

                    behavior: "smooth"

                });


            }


        }



        tabs.forEach(
            function(tab) {


                tab.addEventListener(
                    "click",
                    function() {


                        activateTab(
                            tab.dataset.tab,
                            true
                        );


                    }
                );


            }
        );



        /* ======================================================
           ADMIN STOCK CATEGORY
        ======================================================= */

        function updateStockType() {


            if (
                !category ||
                !feedField ||
                !medicineField ||
                !feedSelect ||
                !medicineSelect
            ) {

                return;

            }


            const value =
                category.value;


            if (value === "medicine") {


                feedField.hidden =
                    true;


                medicineField.hidden =
                    false;


                feedSelect.required =
                    !selectedStockId.value;


                medicineSelect.required =
                    !selectedStockId.value;


            } else if (value === "feed") {


                feedField.hidden =
                    false;


                medicineField.hidden =
                    true;


                feedSelect.required =
                    !selectedStockId.value;


                medicineSelect.required =
                    false;


            } else {


                feedField.hidden =
                    false;


                medicineField.hidden =
                    true;


                feedSelect.required =
                    true;


                medicineSelect.required =
                    false;


            }


        }



        if (category) {


            category.addEventListener(
                "change",
                updateStockType
            );


        }



        /* ======================================================
           ADMIN NEW STOCK FORM
        ======================================================= */

        function prepareNewStockForm() {


            if (!isAdmin || !adminForm) {

                return;

            }


            adminForm.reset();


            selectedStockId.value =
                "";


            if (selectedStockSummary) {

                selectedStockSummary.hidden =
                    true;

            }


            if (restockHeading) {

                restockHeading.textContent =
                    "Add / Restock Stock";

            }


            if (restockDescription) {

                restockDescription.textContent =
                    "Record newly available animal feed or veterinary medicine.";

            }


            if (submitText) {

                submitText.textContent =
                    "Add Stock";

            }


            if (submitIcon) {

                submitIcon.textContent =
                    "➕";

            }


            if (quantityHelp) {

                quantityHelp.textContent =
                    "For an existing stock item, this is the additional quantity being added.";

            }


            updateStockType();


        }



        /* ======================================================
           ADMIN SELECT EXISTING STOCK
        ======================================================= */

        function openExistingStockAsAdmin(
            card
        ) {


            if (
                !isAdmin ||
                !adminForm ||
                !card
            ) {

                return;

            }


            const stockId =
                card.dataset.stockId ||
                "";


            const stockName =
                card.dataset.stockName ||
                "Unnamed Stock";


            const quantity =
                Number(
                    card.dataset.stockQuantity || 0
                );


            const unit =
                card.dataset.stockUnit ||
                "";


            const stockType =
                card.dataset.stockType ||
                "feed";


            const price =
                Number(
                    card.dataset.stockPrice || 0
                );


            selectedStockId.value =
                stockId;


            if (selectedStockSummary) {

                selectedStockSummary.hidden =
                    false;

            }


            if (selectedStockName) {

                selectedStockName.textContent =
                    stockName;

            }


            if (selectedStockCurrent) {

                selectedStockCurrent.textContent =
                    "Current remainder: " +
                    Number(quantity).toLocaleString() +
                    " " +
                    unit;

            }


            if (selectedStockIcon) {

                selectedStockIcon.textContent =
                    stockType === "medicine"
                        ? "💊"
                        : "🌾";

            }


            if (category) {

                category.value =
                    stockType;

            }


            /*
            ======================================================
            IMPORTANT ADMIN QUANTITY RULE

            This is NOT the current total.

            It is the NEW quantity being added to the
            existing stock.
            ======================================================
            */

            if (stockQuantity) {

                stockQuantity.value =
                    "";

            }


            if (stockUnit) {

                stockUnit.value =
                    unit;

                stockUnit.disabled =
                    false;

            }


            if (stockPrice) {

                stockPrice.value =
                    price || "";

            }


            if (stockInstructions) {

                stockInstructions.value =
                    "";

            }


            if (expectedDuration) {

                expectedDuration.value =
                    "";

            }


            if (stockMessage) {

                stockMessage.value =
                    "";

            }


            if (quantityHelp) {

                quantityHelp.textContent =
                    "Enter only the additional quantity being added. The database will add it to the current remainder.";

            }


            if (restockHeading) {

                restockHeading.textContent =
                    "Restock Existing Stock";

            }


            if (restockDescription) {

                restockDescription.textContent =
                    "The selected stock has been loaded from the database. Enter the additional quantity being added.";

            }


            if (submitText) {

                submitText.textContent =
                    "Save Restock";

            }


            if (submitIcon) {

                submitIcon.textContent =
                    "💾";

            }


            updateStockType();


            activateTab(
                "restock-stock",
                true
            );


        }



        /* ======================================================
           DAIRY WORKER SELECT EXISTING STOCK
        ======================================================= */

        function openExistingStockAsWorker(
            card
        ) {


            if (
                !isDairyWorker ||
                !workerForm ||
                !card
            ) {

                return;

            }


            const stockId =
                card.dataset.stockId ||
                "";


            const stockName =
                card.dataset.stockName ||
                "Unnamed Stock";


            const quantity =
                Number(
                    card.dataset.stockQuantity || 0
                );


            const unit =
                card.dataset.stockUnit ||
                "";


            const stockType =
                card.dataset.stockType ||
                "feed";


            if (!stockId) {

                return;

            }


            /* ==================================================
               STOCK ID
            ================================================== */

            workerStockId.value =
                stockId;


            /* ==================================================
               STOCK CATEGORY

               Hidden because the worker cannot change it.
            ================================================== */

            if (workerStockCategory) {

                workerStockCategory.value =
                    stockType;

            }


            /* ==================================================
               DATABASE UNIT

               Store it in the hidden enabled input.

               The visible field is disabled only for display.
            ================================================== */

            if (workerStockUnitHidden) {

                workerStockUnitHidden.value =
                    unit;

            }


            if (workerStockUnitDisplay) {

                workerStockUnitDisplay.value =
                    unit;

            }


            /* ==================================================
               SELECTED STOCK DISPLAY
            ================================================== */

            if (workerSelectedStockName) {

                workerSelectedStockName.textContent =
                    stockName;

            }


            if (workerSelectedStockCurrent) {

                workerSelectedStockCurrent.textContent =
                    "Current database remainder: " +
                    Number(quantity).toLocaleString() +
                    " " +
                    unit;

            }


            if (workerSelectedStockIcon) {

                workerSelectedStockIcon.textContent =
                    stockType === "medicine"
                        ? "💊"
                        : "🌾";

            }


            /*
            ======================================================
            IMPORTANT WORKER RULE

            The worker enters the CURRENT REMAINING amount.

            We intentionally do NOT prefill the current amount.

            This prevents accidentally submitting the old
            quantity as a new report.
            ======================================================
            */

            if (workerQuantity) {

                workerQuantity.value =
                    "";

                workerQuantity.max =
                    String(quantity);

                workerQuantity.placeholder =
                    "Enter quantity remaining";

            }


            /* ==================================================
               CLEAR PREVIOUS REPORT INFORMATION
            ================================================== */

            const workerInstructions =
                document.getElementById(
                    "workerInstructions"
                );


            const workerExpectedDuration =
                document.getElementById(
                    "workerExpectedDuration"
                );


            const workerMessage =
                document.getElementById(
                    "workerMessage"
                );


            if (workerInstructions) {

                workerInstructions.value =
                    "";

            }


            if (workerExpectedDuration) {

                workerExpectedDuration.value =
                    "";

            }


            if (workerMessage) {

                workerMessage.value =
                    "";

            }


            /* ==================================================
               SHOW WORKER UPDATE PANEL
            ================================================== */

            if (workerPanel) {

                workerPanel.hidden =
                    false;

            }


            /*
            ======================================================
            WORKER FORM IS NOT A RESTOCK FORM.

            It always posts to the remaining-stock endpoint.
            ======================================================
            */

            workerForm.action =
                "/dairy/<%= currentDairy._id %>/feedstore/remaining";


            activateTab(
                "foodstock-updates",
                true
            );


            /*
            Bring the worker update form into view.
            */

            setTimeout(
                function() {

                    if (workerPanel) {

                        workerPanel.scrollIntoView({

                            behavior: "smooth",

                            block: "start"

                        });

                    }

                },
                100
            );


        }



        /* ======================================================
           STOCK CARD EVENTS
        ======================================================= */

        stockCards.forEach(
            function(card) {


                card.addEventListener(
                    "click",
                    function() {


                        if (isAdmin) {

                            openExistingStockAsAdmin(
                                card
                            );

                        } else if (isDairyWorker) {

                            openExistingStockAsWorker(
                                card
                            );

                        }


                    }
                );


                card.addEventListener(
                    "keydown",
                    function(event) {


                        if (
                            event.key === "Enter" ||
                            event.key === " "
                        ) {


                            event.preventDefault();


                            if (isAdmin) {

                                openExistingStockAsAdmin(
                                    card
                                );

                            } else if (isDairyWorker) {

                                openExistingStockAsWorker(
                                    card
                                );

                            }


                        }

                    }
                );


            }
        );



        /* ======================================================
           ADMIN RESTOCK TAB

           Clicking Add / Restock directly always starts a
           fresh admin form.
        ======================================================= */

        const restockTab =
            document.querySelector(
                '[data-tab="restock-stock"]'
            );


        if (restockTab && isAdmin) {


            restockTab.addEventListener(
                "click",
                function() {


                    prepareNewStockForm();


                }
            );


        }



        /* ======================================================
           WORKER QUANTITY VALIDATION
        ======================================================= */

        if (workerQuantity) {


            workerQuantity.addEventListener(
                "input",
                function() {


                    if (!isDairyWorker) {

                        return;

                    }


                    const maximum =
                        Number(
                            workerQuantity.max
                        );


                    const entered =
                        Number(
                            workerQuantity.value
                        );


                    if (
                        Number.isFinite(maximum) &&
                        Number.isFinite(entered) &&
                        entered > maximum
                    ) {


                        workerQuantity.value =
                            maximum;


                    }


                }
            );


        }



        /* ======================================================
           WORKER FORM SUBMISSION

           Client-side protection only.

           The controller/service MUST repeat this validation
           against the database.
        ======================================================= */

        if (workerForm) {


            workerForm.addEventListener(
                "submit",
                function(event) {


                    if (!isDairyWorker) {

                        return;

                    }


                    if (
                        !workerStockId ||
                        !workerStockId.value
                    ) {


                        event.preventDefault();


                        alert(
                            "Please select an existing stock item first."
                        );


                        return;

                    }


                    const maximum =
                        Number(
                            workerQuantity.max
                        );


                    const entered =
                        Number(
                            workerQuantity.value
                        );


                    if (
                        !Number.isFinite(entered) ||
                        entered < 0
                    ) {


                        event.preventDefault();


                        alert(
                            "Please enter a valid remaining quantity."
                        );


                        workerQuantity.focus();


                        return;

                    }


                    if (
                        Number.isFinite(maximum) &&
                        entered > maximum
                    ) {


                        event.preventDefault();


                        workerQuantity.value =
                            maximum;


                        workerQuantity.focus();


                        alert(
                            "A dairy worker cannot report more than the current stock remainder."
                        );


                    }


                }
            );


        }



        /* ======================================================
           ADMIN FORM PROTECTION

           This ensures the admin form cannot accidentally be
           used to submit a worker-style remaining quantity.
        ======================================================= */

        if (adminForm) {


            adminForm.addEventListener(
                "submit",
                function(event) {


                    if (!isAdmin) {


                        event.preventDefault();


                        return;

                    }


                    const quantity =
                        Number(
                            stockQuantity.value
                        );


                    if (
                        !Number.isFinite(quantity) ||
                        quantity <= 0
                    ) {


                        event.preventDefault();


                        alert(
                            "Please enter a quantity greater than zero."
                        );


                        stockQuantity.focus();


                        return;

                    }


                }
            );


        }



        /* ======================================================
           INITIAL ADMIN FORM STATE
        ======================================================= */

        if (isAdmin) {

            updateStockType();

        }


    }
);

</script>



<style>

/* ==========================================================
   FEED STORE PAGE
========================================================== */

.feedstore-page {

    width: 100%;
    max-width: 1000px;

    margin: 0 auto;

    padding: 12px 0 45px;

    color: #26352d;

}


.feedstore-page *,
.feedstore-page *::before,
.feedstore-page *::after {

    box-sizing: border-box;

}


/* ==========================================================
   INTRO
========================================================== */

.feedstore-intro {

    display: flex;
    align-items: center;

    gap: 13px;

    margin-bottom: 15px;

}


.feedstore-intro-icon {

    width: 50px;
    height: 50px;

    flex: 0 0 50px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 14px;

    background: #e5f2e9;

    font-size: 24px;

}


.feedstore-eyebrow {

    margin-bottom: 2px;

    color: #137342;

    font-size: 9px;
    font-weight: 900;

    letter-spacing: 1.2px;

}


.feedstore-intro h1 {

    margin: 0;

    color: #123f29;

    font-size: 25px;
    line-height: 1.15;

    font-weight: 850;

}


.feedstore-intro p {

    margin: 5px 0 0;

    color: #748078;

    font-size: 12px;
    line-height: 1.4;

}


/* ==========================================================
   TAB BAR
========================================================== */

.feedstore-tabs {

    width: 100%;

    display: grid;

    gap: 4px;

    margin-bottom: 0;

    padding: 5px;

    border: 1px solid #06391f;
    border-radius: 13px;

    background:
        linear-gradient(
            135deg,
            #073b22 0%,
            #0a4b2b 50%,
            #06361e 100%
        );

    box-shadow:
        0 5px 16px
        rgba(3, 48, 27, .18);

}


.feedstore-tabs--admin {

    grid-template-columns:
        repeat(3, minmax(0, 1fr));

}


.feedstore-tabs--worker {

    grid-template-columns:
        repeat(2, minmax(0, 1fr));

}


/* ==========================================================
   TAB BUTTON
========================================================== */

.feedstore-tab {

    min-width: 0;

    min-height: 48px;

    display: flex;
    align-items: center;
    justify-content: center;

    gap: 6px;

    padding: 7px 8px;

    border: 1px solid transparent;
    border-radius: 9px;

    background: transparent;

    color: #c8ded1;

    font-family: inherit;

    font-size: 10px;
    font-weight: 850;

    white-space: nowrap;

    cursor: pointer;

    transition:
        background .18s ease,
        color .18s ease,
        box-shadow .18s ease;

}


.feedstore-tab:hover {

    background: rgba(255,255,255,.08);

    color: #ffffff;

}


.feedstore-tab.active {

    background: #ffffff;

    color: #0b5d35;

    border-color: rgba(255,255,255,.8);

    box-shadow:
        0 3px 10px
        rgba(0,0,0,.18);

}


.feedstore-tab-icon {

    font-size: 15px;

    line-height: 1;

}


.feedstore-tab-text {

    overflow: hidden;

    text-overflow: ellipsis;

    line-height: 1.2;

}


/* ==========================================================
   TAB CONTENT
========================================================== */

.feedstore-tab-content {

    width: 100%;

    padding-top: 0;

}


.feedstore-tab-panel {

    display: none;

}


.feedstore-tab-panel.active {

    display: block;

    animation:
        feedstorePanelIn .16s ease;

}


@keyframes feedstorePanelIn {

    from {

        opacity: 0;

        transform:
            translateY(3px);

    }

    to {

        opacity: 1;

        transform:
            translateY(0);

    }

}


/* ==========================================================
   SECTION
========================================================== */

.feedstore-section {

    margin-top: 15px;

}


.feedstore-section-header {

    margin-bottom: 12px;

}


.feedstore-section-header h2 {

    margin: 0;

    color: #164f31;

    font-size: 19px;
    font-weight: 850;

}


.feedstore-section-header p {

    margin: 4px 0 0;

    color: #7a857e;

    font-size: 11px;

}


/* ==========================================================
   CURRENT STOCK
========================================================== */

.feedstore-stock-list {

    display: flex;

    flex-direction: column;

    gap: 6px;

}


.feedstore-stock-card {

    display: flex;

    align-items: center;
    justify-content: space-between;

    gap: 12px;

    padding: 10px 12px;

    border: 1px solid #dbe7df;
    border-radius: 11px;

    background: #ffffff;

    box-shadow:
        0 2px 7px
        rgba(23, 65, 43, .04);

}


.feedstore-stock-card--clickable {

    cursor: pointer;

    transition:
        transform .16s ease,
        border-color .16s ease,
        box-shadow .16s ease,
        background .16s ease;

}


.feedstore-stock-card--clickable:hover {

    border-color: #9bc9ad;

    background: #fbfefc;

    box-shadow:
        0 5px 14px
        rgba(23, 65, 43, .08);

    transform:
        translateY(-1px);

}


.feedstore-stock-card--clickable:focus {

    outline: none;

    border-color: #198754;

    box-shadow:
        0 0 0 3px
        rgba(25,135,84,.10);

}


.feedstore-stock-main {

    display: flex;

    align-items: center;

    min-width: 0;

    gap: 10px;

}


.feedstore-stock-icon {

    width: 38px;
    height: 38px;

    flex: 0 0 38px;

    display: flex;

    align-items: center;
    justify-content: center;

    border-radius: 10px;

    background: #eef7f1;

    font-size: 17px;

}


.feedstore-stock-info {

    display: flex;

    flex-direction: column;

    gap: 2px;

    min-width: 0;

}


.feedstore-stock-info strong {

    overflow: hidden;

    color: #29362f;

    font-size: 13px;
    font-weight: 800;

    text-overflow: ellipsis;
    white-space: nowrap;

}


.feedstore-stock-info span {

    color: #87918b;

    font-size: 10px;

}


.feedstore-stock-right {

    display: flex;

    align-items: center;

    gap: 10px;

    flex-shrink: 0;

}


.feedstore-stock-quantity {

    display: flex;

    align-items: baseline;

    gap: 4px;

}


.feedstore-stock-quantity strong {

    color: #198754;

    font-size: 17px;
    font-weight: 850;

}


.feedstore-stock-quantity span {

    color: #748078;

    font-size: 10px;
    font-weight: 700;

}


.feedstore-stock-action {

    color: #198754;

    font-size: 9px;
    font-weight: 900;

    white-space: nowrap;

}


/* ==========================================================
   SELECTED STOCK
========================================================== */

.feedstore-selected-stock {

    display: flex;

    align-items: center;

    gap: 11px;

    margin-bottom: 10px;

    padding: 12px;

    border: 1px solid #b9d8c5;

    border-radius: 12px;

    background: #edf8f1;

}


.feedstore-selected-stock__icon {

    width: 42px;
    height: 42px;

    flex: 0 0 42px;

    display: flex;

    align-items: center;
    justify-content: center;

    border-radius: 11px;

    background: #ffffff;

    font-size: 20px;

}


.feedstore-selected-stock__info {

    display: flex;

    flex-direction: column;

    gap: 2px;

    min-width: 0;

}


.feedstore-selected-stock__info span {

    color: #6e8276;

    font-size: 8px;
    font-weight: 900;

    letter-spacing: .7px;

}


.feedstore-selected-stock__info strong {

    overflow: hidden;

    color: #174f31;

    font-size: 14px;
    font-weight: 850;

    white-space: nowrap;
    text-overflow: ellipsis;

}


.feedstore-selected-stock__info small {

    color: #718078;

    font-size: 9px;

}


/* ==========================================================
   ADMIN LABEL
========================================================== */

.feedstore-admin-label {

    display: inline-flex;

    margin-bottom: 4px;

    padding: 3px 7px;

    border-radius: 999px;

    background: #e5f4ea;

    color: #198754;

    font-size: 8px;
    font-weight: 900;

    letter-spacing: .7px;

}


/* ==========================================================
   WORKER LABEL
========================================================== */

.feedstore-worker-label {

    display: inline-flex;

    margin-bottom: 4px;

    padding: 3px 7px;

    border-radius: 999px;

    background: #e8f2f7;

    color: #176b91;

    font-size: 8px;
    font-weight: 900;

    letter-spacing: .7px;

}


/* ==========================================================
   WORKER UPDATE PANEL
========================================================== */

.feedstore-worker-update-panel {

    margin-top: 15px;

}


.feedstore-worker-update-panel[hidden] {

    display: none;

}


/* ==========================================================
   EMPTY
========================================================== */

.feedstore-empty {

    padding: 28px 18px;

    border: 1px dashed #cbdcd1;
    border-radius: 13px;

    background: #f8fbf9;

    text-align: center;

}


.feedstore-empty-icon {

    font-size: 27px;

}


.feedstore-empty h3 {

    margin: 8px 0 4px;

    color: #2b3931;

    font-size: 15px;

}


.feedstore-empty p {

    margin: 0;

    color: #7d8881;

    font-size: 11px;

}


/* ==========================================================
   ADMIN VALUE
========================================================== */

.feedstore-admin-value {

    display: flex;

    align-items: center;
    justify-content: space-between;

    gap: 15px;

    margin-top: 14px;

    padding: 14px 16px;

    border: 1px solid #b9d8c5;
    border-radius: 12px;

    background: #edf8f1;

}


.feedstore-admin-value div {

    display: flex;

    flex-direction: column;

    gap: 3px;

}


.feedstore-admin-value span {

    color: #718078;

    font-size: 8px;
    font-weight: 900;

    letter-spacing: .8px;

}


.feedstore-admin-value strong {

    color: #145c36;

    font-size: 20px;
    font-weight: 850;

}


.feedstore-admin-value small {

    color: #89938d;

    font-size: 9px;

}


/* ==========================================================
   FORM
========================================================== */

.feedstore-form {

    padding: 16px;

    border: 1px solid #dce7e0;
    border-radius: 13px;

    background: #ffffff;

    box-shadow:
        0 3px 12px
        rgba(23, 65, 43, .04);

}


.feedstore-field {

    display: flex;

    flex-direction: column;

    gap: 5px;

    margin-bottom: 12px;

}


.feedstore-field label {

    color: #344139;

    font-size: 11px;
    font-weight: 800;

}


.feedstore-field input,
.feedstore-field select,
.feedstore-field textarea {

    width: 100%;

    padding: 9px 10px;

    border: 1px solid #d7e2da;
    border-radius: 8px;

    outline: none;

    background: #ffffff;
    color: #26352d;

    font-family: inherit;
    font-size: 12px;

}


.feedstore-field textarea {

    resize: vertical;

    line-height: 1.4;

}


.feedstore-field input:focus,
.feedstore-field select:focus,
.feedstore-field textarea:focus {

    border-color: #198754;

    box-shadow:
        0 0 0 3px
        rgba(25, 135, 84, .08);

}


.feedstore-field input:disabled,
.feedstore-field select:disabled {

    background: #f2f5f3;

    color: #69756e;

    cursor: not-allowed;

}


.feedstore-field small {

    color: #89938d;

    font-size: 9px;
    line-height: 1.3;

}


/* ==========================================================
   TWO COLUMNS
========================================================== */

.feedstore-two-columns {

    display: grid;

    grid-template-columns:
        1fr 1fr;

    gap: 10px;

}


/* ==========================================================
   MONEY
========================================================== */

.feedstore-money {

    display: flex;

    align-items: center;

    overflow: hidden;

    border: 1px solid #d7e2da;
    border-radius: 8px;

}


.feedstore-money span {

    padding-left: 10px;

    color: #198754;

    font-size: 10px;
    font-weight: 850;

}


.feedstore-money input {

    border: none;

}


.feedstore-money:focus-within {

    border-color: #198754;

    box-shadow:
        0 0 0 3px
        rgba(25, 135, 84, .08);

}


/* ==========================================================
   HISTORY FEED
========================================================== */

.feedstore-feed {

    width: 100%;

    display: flex;

    flex-direction: column;

    gap: 12px;

}


.feedstore-feed > * {

    width: 100%;

}


/* ==========================================================
   BUTTON
========================================================== */

.feedstore-submit {

    width: 100%;

    min-height: 43px;

    display: flex;

    align-items: center;
    justify-content: center;

    gap: 7px;

    margin-top: 5px;

    border: none;

    border-radius: 9px;

    color: #ffffff;

    font-family: inherit;

    font-size: 12px;
    font-weight: 850;

    cursor: pointer;

    transition:
        transform .15s ease,
        opacity .15s ease;

}


.feedstore-submit:hover {

    opacity: .94;

}


.feedstore-submit:active {

    transform:
        translateY(1px);

}


.admin-submit {

    background: #0d5933;

}


.worker-submit {

    background: #176b91;

}


/* ==========================================================
   DESKTOP
========================================================== */

@media (min-width: 900px) {


    .feedstore-page {

        padding-top: 10px;

    }


    .feedstore-intro {

        margin-bottom: 12px;

    }


    .feedstore-intro-icon {

        width: 48px;
        height: 48px;

        flex-basis: 48px;

        font-size: 23px;

    }


    .feedstore-intro h1 {

        font-size: 24px;

    }


    .feedstore-intro p {

        font-size: 11px;

    }


    .feedstore-tabs {

        min-height: 55px;

    }


    .feedstore-tab {

        min-height: 45px;

    }


}


/* ==========================================================
   MOBILE
========================================================== */

@media (max-width: 650px) {


    .feedstore-page {

        padding:
            8px 0 35px;

    }


    .feedstore-intro {

        align-items: flex-start;

        gap: 10px;

        margin-bottom: 10px;

    }


    .feedstore-intro-icon {

        width: 43px;
        height: 43px;

        flex-basis: 43px;

        border-radius: 12px;

        font-size: 20px;

    }


    .feedstore-eyebrow {

        font-size: 8px;

    }


    .feedstore-intro h1 {

        font-size: 21px;

    }


    .feedstore-intro p {

        font-size: 10px;

    }


    .feedstore-tab {

        min-height: 49px;

        flex-direction: column;

        gap: 3px;

        padding:
            5px 3px;

        border-radius: 8px;

        font-size: 8px;

    }


    .feedstore-tab-icon {

        font-size: 14px;

    }


    .feedstore-tab-text {

        width: 100%;

        text-align: center;

        white-space: normal;

    }


    .feedstore-section {

        margin-top: 12px;

    }


    .feedstore-section-header {

        margin-bottom: 10px;

    }


    .feedstore-section-header h2 {

        font-size: 17px;

    }


    .feedstore-section-header p {

        font-size: 10px;

    }


    .feedstore-two-columns {

        grid-template-columns: 1fr;

        gap: 0;

    }


    .feedstore-admin-value {

        align-items: flex-start;

        flex-direction: column;

    }


    .feedstore-stock-card {

        padding: 9px;

    }


    .feedstore-stock-main {

        gap: 8px;

    }


    .feedstore-stock-icon {

        width: 36px;
        height: 36px;

        flex-basis: 36px;

        font-size: 16px;

    }


    .feedstore-stock-info strong {

        font-size: 12px;

    }


    .feedstore-stock-right {

        flex-direction: column;

        align-items: flex-end;

        gap: 2px;

    }


    .feedstore-stock-quantity {

        gap: 3px;

    }


    .feedstore-stock-quantity strong {

        font-size: 15px;

    }


    .feedstore-stock-action {

        font-size: 8px;

    }


    .feedstore-form {

        padding: 13px;

    }


    .feedstore-selected-stock {

        padding: 10px;

    }


}

</style>



<% } else { %>


<!-- ==========================================================
     INVALID / UNAUTHENTICATED PAGE DATA
========================================================== -->

<div
    class="feedstore-empty"
    style="margin:20px;"
>

    <div
        class="feedstore-empty-icon"
        aria-hidden="true"
    >
        ⚠️
    </div>


    <h3>
        Foodstock unavailable
    </h3>


    <p>
        The dairy foodstock information could not be loaded.
    </p>

</div>


<% } %>