<% /*
==============================================================
FEED STORE

FILE:
    views/updates/feeds-store.ejs

ROUTES
--------------------------------------------------------------

GET:
    /dairy/feedstore/:id

ADMIN:
    POST /dairy/:id/feedstore/restock

WORKER / ADMIN:
    POST /dairy/:id/feedstore/update

DATA EXPECTED
--------------------------------------------------------------

dairy
user
updates

OPTIONAL:
    feedTypes
    stockUnits

IMPORTANT
--------------------------------------------------------------

The current Dairy model stores feed stock as:

    dairy.feedStocks[]

Each feed stock contains:

    _id
    name
    percentageRemaining
    feedsAmount

The parent Dairy contains:

    feedsAmount

which is the aggregate of all feedStocks[].feedsAmount.

==============================================================
*/ %>


<% if (dairy && user) { %>

<div class="feedstore-page">


    <!-- ======================================================
         PAGE INTRO
    ======================================================= -->

    <header class="feedstore-intro">

        <div class="feedstore-intro-icon">
            🌾
        </div>

        <div>

            <div class="feedstore-eyebrow">
                DAIRY FEED STORE
            </div>

            <h1>
                <%= dairy.name %>'s Feed Store
            </h1>

            <p>
                Monitor available animal feed and keep
                stock levels up to date.
            </p>

        </div>

    </header>



    <!-- ======================================================
         SUCCESS MESSAGE
    ======================================================= -->

    <% if (typeof success !== "undefined" && success) { %>

        <div class="feedstore-success">

            <% if (success === "stock-added") { %>

                <strong>
                    ✓ Stock added successfully
                </strong>

                <span>
                    The feed store has been updated.
                </span>

            <% } else if (success === "stock-updated") { %>

                <strong>
                    ✓ Stock updated successfully
                </strong>

                <span>
                    The remaining stock level has been updated.
                </span>

            <% } else { %>

                <strong>
                    ✓ Operation completed successfully
                </strong>

            <% } %>

        </div>

    <% } %>



    <!-- ======================================================
         CURRENT FEED STOCK
    ======================================================= -->

    <section class="feedstore-section">

        <div class="feedstore-section-header">

            <div>

                <h2>
                    Available Feed
                </h2>

                <p>
                    Current feed stocks recorded for this dairy.
                </p>

            </div>

        </div>



        <% if (
            Array.isArray(dairy.feedStocks) &&
            dairy.feedStocks.length > 0
        ) { %>


            <div class="feedstore-stock-list">


                <% dairy.feedStocks.forEach(function(feed) { %>


                    <article
                        class="feedstore-stock-card"
                    >


                        <!-- ==================================
                             STOCK INFORMATION
                        =================================== -->

                        <div class="feedstore-stock-main">


                            <div class="feedstore-stock-icon">
                                🌾
                            </div>


                            <div class="feedstore-stock-info">

                                <strong>
                                    <%= feed.name || "Unnamed Feed" %>
                                </strong>

                                <span>
                                    Animal feed
                                </span>

                            </div>

                        </div>



                        <!-- ==================================
                             REMAINING LEVEL
                        =================================== -->

                        <div class="feedstore-stock-level">


                            <div class="feedstore-stock-percentage">

                                <strong>
                                    <%= Number(
                                        feed.percentageRemaining || 0
                                    ) %>%
                                </strong>

                                <span>
                                    remaining
                                </span>

                            </div>


                            <div class="feedstore-progress">

                                <div
                                    class="feedstore-progress-bar"
                                    style="
                                        width: <%= Math.max(
                                            0,
                                            Math.min(
                                                100,
                                                Number(
                                                    feed.percentageRemaining || 0
                                                )
                                            )
                                        ) %>%;
                                    "
                                ></div>

                            </div>


                        </div>


                    </article>


                <% }); %>


            </div>


        <% } else { %>


            <!-- ==============================================
                 EMPTY STOCK
            =============================================== -->

            <div class="feedstore-empty">

                <div class="feedstore-empty-icon">
                    🌾
                </div>

                <h3>
                    No feed stock recorded
                </h3>

                <p>
                    Feed stock will appear here once it is
                    added to the store.
                </p>

            </div>


        <% } %>


    </section>



    <!-- ======================================================
         ADMIN FINANCIAL SUMMARY
    ======================================================= -->

    <% if (user.role === "admin") { %>


        <section class="feedstore-admin-value">


            <div>

                <span>
                    TOTAL FEED STOCK VALUE
                </span>

                <strong>

                    KES
                    <%= Number(
                        dairy.feedsAmount || 0
                    ).toLocaleString() %>

                </strong>

            </div>


            <small>
                Financial information is visible to
                administrators only.
            </small>


        </section>


    <% } %>



    <!-- ======================================================
         ADMIN RESTOCK
    ======================================================= -->

    <% if (user.role === "admin") { %>


        <section class="feedstore-section">


            <div class="feedstore-section-header">

                <div>

                    <div class="feedstore-admin-label">
                        ADMIN
                    </div>

                    <h2>
                        Add Feed Stock
                    </h2>

                    <p>
                        Record newly received feed for this
                        dairy's feed store.
                    </p>

                </div>

            </div>



            <form
                class="feedstore-form"
                action="/dairy/<%= dairy._id %>/feedstore/restock"
                method="POST"
            >


                <!-- ==========================================
                     FEED TYPE
                =========================================== -->

                <div class="feedstore-field">

                    <label for="feedName">
                        Feed type
                    </label>


                    <select
                        id="feedName"
                        name="feedName"
                        required
                    >

                        <option value="">
                            Select feed
                        </option>


                        <% if (
                            Array.isArray(feedTypes) &&
                            feedTypes.length
                        ) { %>


                            <% feedTypes.forEach(function(feedType) { %>

                                <option value="<%= feedType %>">
                                    <%= feedType %>
                                </option>

                            <% }); %>


                        <% } else { %>


                            <option value="fodder">
                                Fodder
                            </option>

                            <option value="silage">
                                Silage
                            </option>

                            <option value="hay">
                                Hay
                            </option>

                            <option value="maize">
                                Maize
                            </option>

                            <option value="concentrates">
                                Concentrates
                            </option>

                            <option value="minerals">
                                Minerals
                            </option>

                            <option value="other">
                                Other
                            </option>


                        <% } %>


                    </select>

                </div>



                <!-- ==========================================
                     NEW / EXISTING STOCK
                =========================================== -->

                <div class="feedstore-field">


                    <label>
                        Stock status
                    </label>


                    <div class="feedstore-radio-group">


                        <label class="feedstore-radio">

                            <input
                                type="radio"
                                name="isNewStock"
                                value="false"
                                checked
                            >

                            <span>
                                Existing feed
                            </span>

                        </label>


                        <label class="feedstore-radio">

                            <input
                                type="radio"
                                name="isNewStock"
                                value="true"
                            >

                            <span>
                                New feed type
                            </span>

                        </label>


                    </div>


                </div>



                <!-- ==========================================
                     QUANTITY
                =========================================== -->

                <div class="feedstore-two-columns">


                    <div class="feedstore-field">


                        <label for="quantity">
                            Quantity added
                        </label>


                        <input
                            id="quantity"
                            type="number"
                            name="quantity"
                            min="0"
                            step="0.01"
                            placeholder="e.g. 20"
                            required
                        >


                    </div>



                    <div class="feedstore-field">


                        <label for="unit">
                            Unit
                        </label>


                        <select
                            id="unit"
                            name="unit"
                            required
                        >

                            <option value="">
                                Select unit
                            </option>


                            <% if (
                                Array.isArray(stockUnits) &&
                                stockUnits.length
                            ) { %>


                                <% stockUnits.forEach(function(unit) { %>

                                    <option value="<%= unit %>">
                                        <%= unit %>
                                    </option>

                                <% }); %>


                            <% } else { %>


                                <option value="kg">
                                    kg
                                </option>

                                <option value="bags">
                                    bags
                                </option>

                                <option value="tonnes">
                                    tonnes
                                </option>

                                <option value="bales">
                                    bales
                                </option>


                            <% } %>


                        </select>


                    </div>


                </div>



                <!-- ==========================================
                     FINANCIAL VALUE
                =========================================== -->

                <div class="feedstore-field">


                    <label for="feedsAmount">
                        Feed value
                    </label>


                    <div class="feedstore-money">


                        <span>
                            KES
                        </span>


                        <input
                            id="feedsAmount"
                            type="number"
                            name="feedsAmount"
                            min="0"
                            step="0.01"
                            placeholder="Enter feed value"
                            required
                        >


                    </div>


                    <small>
                        This value contributes to the dairy's
                        total feed-stock value.
                    </small>


                </div>



                <!-- ==========================================
                     UNIT COST
                =========================================== -->

                <div class="feedstore-field">


                    <label for="unitCost">
                        Unit cost
                    </label>


                    <div class="feedstore-money">


                        <span>
                            KES
                        </span>


                        <input
                            id="unitCost"
                            type="number"
                            name="unitCost"
                            min="0"
                            step="0.01"
                            placeholder="Optional"
                        >


                    </div>


                </div>



                <!-- ==========================================
                     TOTAL COST
                =========================================== -->

                <div class="feedstore-field">


                    <label for="totalCost">
                        Total cost
                    </label>


                    <div class="feedstore-money">


                        <span>
                            KES
                        </span>


                        <input
                            id="totalCost"
                            type="number"
                            name="totalCost"
                            min="0"
                            step="0.01"
                            placeholder="Optional"
                        >


                    </div>


                </div>



                <!-- ==========================================
                     MESSAGE
                =========================================== -->

                <div class="feedstore-field">


                    <label for="restockMessage">
                        Notes
                    </label>


                    <textarea
                        id="restockMessage"
                        name="message"
                        rows="4"
                        maxlength="2000"
                        placeholder="Describe the feed received, quality, supplier information or any other useful observation..."
                    ></textarea>


                </div>



                <!-- ==========================================
                     FINANCIAL NOTE
                =========================================== -->

                <div class="feedstore-field">


                    <label for="financialNote">
                        Financial note
                    </label>


                    <textarea
                        id="financialNote"
                        name="financialNote"
                        rows="3"
                        maxlength="1000"
                        placeholder="Optional financial note..."
                    ></textarea>


                </div>



                <!-- ==========================================
                     SUBMIT
                =========================================== -->

                <button
                    type="submit"
                    class="feedstore-submit admin-submit"
                >

                    <span>
                        ➕
                    </span>

                    Add Feed Stock

                </button>


            </form>


        </section>


    <% } %>



    <!-- ======================================================
         WORKER / ADMIN STOCK UPDATE
    ======================================================= -->

    <section class="feedstore-section">


        <div class="feedstore-section-header">


            <div>

                <h2>
                    Update Remaining Feed
                </h2>

                <p>
                    Record the estimated percentage of feed
                    currently remaining in the store.
                </p>

            </div>


        </div>



        <form
            class="feedstore-form worker-form"
            action="/dairy/<%= dairy._id %>/feedstore/update"
            method="POST"
        >


            <!-- ==========================================
                 STOCK ITEM
            =========================================== -->

            <div class="feedstore-field">


                <label for="stockId">
                    Feed stock
                </label>


                <select
                    id="stockId"
                    name="stockId"
                    required
                >


                    <option value="">
                        Select feed stock
                    </option>


                    <% if (
                        Array.isArray(dairy.feedStocks)
                    ) { %>


                        <% dairy.feedStocks.forEach(function(feed) { %>


                            <option
                                value="<%= feed._id %>"
                            >

                                <%= feed.name || "Unnamed Feed" %>

                            </option>


                        <% }); %>


                    <% } %>


                </select>


            </div>



            <!-- ==========================================
                 PERCENTAGE REMAINING
            =========================================== -->

            <div class="feedstore-field">


                <label for="percentageRemaining">
                    Percentage remaining
                </label>


                <div class="feedstore-percentage-input">


                    <input
                        id="percentageRemaining"
                        type="number"
                        name="percentageRemaining"
                        min="0"
                        max="100"
                        step="1"
                        placeholder="e.g. 65"
                        required
                    >


                    <span>
                        %
                    </span>


                </div>


                <small>
                    Enter an estimated value between 0% and
                    100%.
                </small>


            </div>



            <!-- ==========================================
                 MESSAGE
            =========================================== -->

            <div class="feedstore-field">


                <label for="updateMessage">
                    Additional information
                </label>


                <textarea
                    id="updateMessage"
                    name="message"
                    rows="5"
                    maxlength="2000"
                    placeholder="Add any useful information about the current feed stock..."
                ></textarea>


            </div>



            <!-- ==========================================
                 IMAGES
            =========================================== -->

            <div class="feedstore-field">


                <label for="updateImages">
                    Images
                </label>


                <input
                    id="updateImages"
                    type="file"
                    name="images"
                    accept="image/*"
                    multiple
                >


                <small>
                    Optional photos showing the current
                    condition of the feed store or stock.
                </small>


            </div>



            <!-- ==========================================
                 SUBMIT
            =========================================== -->

            <button
                type="submit"
                class="feedstore-submit worker-submit"
            >

                <span>
                    📦
                </span>

                Update Remaining Feed

            </button>


        </form>


    </section>



    <!-- ======================================================
         FEED STORE UPDATE HISTORY
    ======================================================= -->

    <% if (
        Array.isArray(updates) &&
        updates.length > 0
    ) { %>


        <section class="feedstore-section">


            <div class="feedstore-section-header">


                <div>

                    <h2>
                        Feed Store Updates
                    </h2>

                    <p>
                        Recent feed-store activity.
                    </p>

                </div>


            </div>



            <div class="feedstore-feed">


                <% updates.forEach(function(update) { %>


                    <%- include("stock", {
                        update: update,
                        dairy: dairy
                    }) %>


                <% }); %>


            </div>


        </section>


    <% } %>


</div>



<!-- ==========================================================
     SUCCESS POPUP
=========================================================== -->

<% if (
    typeof success !== "undefined" &&
    success
) { %>


<div
    class="feedstore-success-overlay"
    id="feedstoreSuccess"
>


    <div class="feedstore-success-popup">


        <div class="feedstore-success-icon">
            ✓
        </div>


        <h3>
            Success
        </h3>


        <p>

            <% if (success === "stock-added") { %>

                Feed stock has been added successfully.

            <% } else if (success === "stock-updated") { %>

                Feed stock has been updated successfully.

            <% } else { %>

                The operation was completed successfully.

            <% } %>

        </p>


        <button
            type="button"
            id="feedstoreSuccessOk"
        >
            OK
        </button>


    </div>


</div>


<% } %>



<script>

document.addEventListener(
    "DOMContentLoaded",
    function () {


        // ==================================================
        // SUCCESS POPUP
        // ==================================================

        const successPopup =
            document.getElementById(
                "feedstoreSuccess"
            );


        const successOk =
            document.getElementById(
                "feedstoreSuccessOk"
            );


        if (
            successPopup &&
            successOk
        ) {


            successOk.addEventListener(
                "click",
                function () {

                    window.location.href =
                        window.location.pathname;

                }
            );


        }


        // ==================================================
        // PERCENTAGE VALIDATION
        // ==================================================

        const percentageInput =
            document.getElementById(
                "percentageRemaining"
            );


        if (percentageInput) {


            percentageInput.addEventListener(
                "input",
                function () {


                    let value =
                        Number(
                            this.value
                        );


                    if (Number.isNaN(value)) {

                        return;

                    }


                    if (value < 0) {

                        this.value = 0;

                    }


                    if (value > 100) {

                        this.value = 100;

                    }


                }
            );


        }


    }
);

</script>



<style>

/* ==========================================================
   FEED STORE PAGE
========================================================== */

.feedstore-page {

    width: 100%;
    max-width: 1000px;

    margin: 0 auto;

    padding: 18px 0 60px;

    color: #26352d;

}


.feedstore-page *,
.feedstore-page *::before,
.feedstore-page *::after {

    box-sizing: border-box;

}



/* ==========================================================
   INTRO
========================================================== */

.feedstore-intro {

    display: flex;
    align-items: center;

    gap: 15px;

    margin-bottom: 25px;

}


.feedstore-intro-icon {

    width: 56px;
    height: 56px;

    flex: 0 0 56px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 16px;

    background: #edf7f0;

    font-size: 27px;

}


.feedstore-eyebrow {

    margin-bottom: 3px;

    color: #198754;

    font-size: 10px;
    font-weight: 900;

    letter-spacing: 1.2px;

}


.feedstore-intro h1 {

    margin: 0;

    color: #164f31;

    font-size: 28px;
    line-height: 1.15;

    font-weight: 850;

}


.feedstore-intro p {

    margin: 6px 0 0;

    color: #748078;

    font-size: 13px;

    line-height: 1.5;

}



/* ==========================================================
   SUCCESS
========================================================== */

.feedstore-success {

    display: flex;
    flex-direction: column;

    gap: 3px;

    margin-bottom: 20px;

    padding: 13px 15px;

    border: 1px solid #cce5d5;

    border-radius: 12px;

    background: #f1faf4;

}


.feedstore-success strong {

    color: #145c36;

    font-size: 13px;

}


.feedstore-success span {

    color: #6d7d73;

    font-size: 11px;

}



/* ==========================================================
   SUCCESS POPUP
========================================================== */

.feedstore-success-overlay {

    position: fixed;

    inset: 0;

    z-index: 9999;

    display: flex;

    align-items: center;
    justify-content: center;

    padding: 20px;

    background: rgba(20, 35, 27, .42);

}


.feedstore-success-popup {

    width: min(
        100%,
        360px
    );

    padding: 28px 22px 22px;

    border-radius: 18px;

    background: #ffffff;

    text-align: center;

    box-shadow:
        0 18px 55px
        rgba(0, 0, 0, .18);

}


.feedstore-success-icon {

    width: 52px;
    height: 52px;

    margin: 0 auto 12px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 50%;

    background: #e8f6ed;

    color: #198754;

    font-size: 25px;
    font-weight: 900;

}


.feedstore-success-popup h3 {

    margin: 0;

    color: #164f31;

    font-size: 20px;

}


.feedstore-success-popup p {

    margin: 8px 0 20px;

    color: #748078;

    font-size: 12px;

    line-height: 1.5;

}


.feedstore-success-popup button {

    width: 100%;

    min-height: 44px;

    border: none;

    border-radius: 10px;

    background: #145c36;

    color: #ffffff;

    font-family: inherit;

    font-size: 13px;

    font-weight: 850;

    cursor: pointer;

}



/* ==========================================================
   SECTION
========================================================== */

.feedstore-section {

    margin-top: 30px;

}


.feedstore-section-header {

    margin-bottom: 14px;

}


.feedstore-section-header h2 {

    margin: 0;

    color: #164f31;

    font-size: 20px;

    font-weight: 850;

}


.feedstore-section-header p {

    margin: 5px 0 0;

    color: #7a857e;

    font-size: 12px;

}



/* ==========================================================
   STOCK LIST
========================================================== */

.feedstore-stock-list {

    display: flex;

    flex-direction: column;

    gap: 8px;

}


.feedstore-stock-card {

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 18px;

    padding: 14px 15px;

    border: 1px solid #e0e9e3;

    border-radius: 13px;

    background: #ffffff;

}


.feedstore-stock-main {

    display: flex;

    align-items: center;

    gap: 12px;

    min-width: 0;

}


.feedstore-stock-icon {

    width: 42px;
    height: 42px;

    flex: 0 0 42px;

    display: flex;

    align-items: center;
    justify-content: center;

    border-radius: 12px;

    background: #f0f7f2;

    font-size: 19px;

}


.feedstore-stock-info {

    display: flex;

    flex-direction: column;

    gap: 3px;

