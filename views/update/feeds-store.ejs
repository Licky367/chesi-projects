<% /*
==============================================================
FEED STORE PAGE

FILE:
    views/update/feeds-store.ejs

PURPOSE:
    Dedicated dairy foodstock page.

DATA EXPECTED FROM CONTROLLER:
--------------------------------------------------------------
    dairy
    user
    updates
    feedTypes
    medicineTypes
    stockUnits

CURRENT INVENTORY:
--------------------------------------------------------------
    dairy.feedStocks[]

HISTORY:
--------------------------------------------------------------
    updates[]

IMPORTANT STOCK RULE:
--------------------------------------------------------------
    CURRENT inventory comes ONLY from:

        dairy.feedStocks[]

    Historical events come ONLY from:

        updates[]

ROLES:
--------------------------------------------------------------
    ADMIN:
        • Can add new stock.
        • Can restock existing stock.
        • Can edit quantity.
        • Can edit unit.
        • Can add price/value.
        • Can add additional information.
        • Can add instructions.
        • Can add expected duration.
        • Can add photos.

    DAIRY WORKER:
        • Cannot add new stock.
        • Cannot restock stock.
        • Can select existing stock only.
        • Can report the current remaining quantity.
        • Cannot change the unit.
        • Cannot report more than the current database remainder.
        • Can add additional information.
        • Can add photos.
        • CANNOT provide instructions of use.
        • CANNOT provide expected duration.

IMPORTANT QUANTITY RULE:
--------------------------------------------------------------
    When an existing stock is selected:

        database remainder
                ↓
        form quantity

    The form MUST NOT replace the database remainder with 0.

    For dairy workers:

        maximum quantity = current database remainder

    For administrators:

        quantity is editable without that worker limit.

IMPORTANT FEED CONTRACT:
--------------------------------------------------------------
    Every history document is rendered independently.

    Each history document is passed to stock.ejs as:

        item: stockItem
==============================================================
*/ %>


<%
/* ==========================================================
   SAFE PAGE DATA
========================================================== */

const currentDairy =
    dairy || null;


const currentUser =
    user || null;


/* ==========================================================
   CURRENT INVENTORY

   Database-backed inventory only.
========================================================== */

const feedStoreItems =
    currentDairy &&
    Array.isArray(currentDairy.feedStocks)

        ? currentDairy.feedStocks

        : [];


/* ==========================================================
   STOCK HISTORY
========================================================== */

const feedStoreUpdates =
    Array.isArray(updates)

        ? updates

        : [];


/* ==========================================================
   FORM OPTIONS
========================================================== */

const availableFeedTypes =
    Array.isArray(feedTypes)

        ? feedTypes

        : [];


const availableMedicineTypes =
    Array.isArray(medicineTypes)

        ? medicineTypes

        : [];


const availableStockUnits =
    Array.isArray(stockUnits)

        ? stockUnits

        : [
            "kg",
            "bags",
            "tonnes",
            "bales",
            "litres",
            "bottles",
            "packs",
            "units"
        ];


/* ==========================================================
   USER ROLE
========================================================== */

const isAdmin =
    !!(
        currentUser &&
        currentUser.role === "admin"
    );


const isDairyWorker =
    !!(
        currentUser &&
        currentUser.role === "dairyWorker"
    );


/*
--------------------------------------------------------------
IMPORTANT

Only administrators can:

    • Add stock
    • Restock stock
    • Edit stock unit
    • Edit stock price

Dairy workers can ONLY:

    • Select existing stock
    • Report remaining quantity
    • Add additional information
    • Add photos
--------------------------------------------------------------
*/

const canUpdateStock =
    isAdmin ||
    isDairyWorker;


/* ==========================================================
   STOCK TYPE HELPER
========================================================== */

function isMedicineStock(stock) {

    if (!stock) {

        return false;

    }


    return (

        String(
            stock.category ||
            stock.stockType ||
            stock.type ||
            ""
        ).toLowerCase() === "medicine"

    );

}


/* ==========================================================
   STOCK NAME
========================================================== */

function getStockName(stock) {

    if (!stock) {

        return "Unnamed Stock";

    }


    return (

        stock.name ||

        stock.feedName ||

        stock.medicineName ||

        stock.stockName ||

        stock.productName ||

        stock.itemName ||

        "Unnamed Stock"

    );

}


/* ==========================================================
   STOCK QUANTITY

   IMPORTANT:

   The CURRENT database remainder must be returned.

   quantityRemaining is preferred.

   Other fields are compatibility fallbacks only.
========================================================== */

function getStockQuantity(stock) {

    if (!stock) {

        return 0;

    }


    if (
        stock.quantityRemaining !== undefined &&
        stock.quantityRemaining !== null &&
        stock.quantityRemaining !== ""
    ) {

        const value =
            Number(
                stock.quantityRemaining
            );


        if (
            Number.isFinite(value)
        ) {

            return value;

        }

    }


    if (
        stock.remaining !== undefined &&
        stock.remaining !== null &&
        stock.remaining !== ""
    ) {

        const value =
            Number(
                stock.remaining
            );


        if (
            Number.isFinite(value)
        ) {

            return value;

        }

    }


    if (
        stock.quantity !== undefined &&
        stock.quantity !== null &&
        stock.quantity !== ""
    ) {

        const value =
            Number(
                stock.quantity
            );


        if (
            Number.isFinite(value)
        ) {

            return value;

        }

    }


    if (
        stock.amount !== undefined &&
        stock.amount !== null &&
        stock.amount !== ""
    ) {

        const value =
            Number(
                stock.amount
            );


        if (
            Number.isFinite(value)
        ) {

            return value;

        }

    }


    return 0;

}


/* ==========================================================
   STOCK UNIT
========================================================== */

function getStockUnit(stock) {

    if (!stock) {

        return "units";

    }


    return (

        stock.unit ||

        stock.stockUnit ||

        "units"

    );

}


/* ==========================================================
   STOCK PRICE
========================================================== */

function getStockPrice(stock) {

    if (!stock) {

        return 0;

    }


    if (
        stock.price !== undefined &&
        stock.price !== null &&
        stock.price !== ""
    ) {

        const value =
            Number(
                stock.price
            );


        if (
            Number.isFinite(value)
        ) {

            return value;

        }

    }


    return 0;

}

%>


<% if (currentDairy && currentUser) { %>


<div
    class="feedstore-page"
    data-dairy-id="<%= currentDairy._id %>"
>


    <!-- ======================================================
         PAGE INTRO
    ======================================================= -->

    <header class="feedstore-intro">


        <div
            class="feedstore-intro-icon"
            aria-hidden="true"
        >
            🌾
        </div>


        <div>

            <div class="feedstore-eyebrow">
                DAIRY FOODSTOCK
            </div>


            <h1>
                <%= currentDairy.name %>'s Foodstock
            </h1>


            <p>
                View current stock and keep foodstock records
                up to date.
            </p>

        </div>


    </header>



    <!-- ======================================================
         TAB NAVIGATION

         ADMIN:
             Available Stock
             Add / Restock
             Foodstock Updates

         DAIRY WORKER:
             Available Stock
             Update Remaining
             Foodstock Updates

         The worker is NOT given an Add / Restock operation.
    ======================================================= -->

    <nav
        class="feedstore-tabs"
        aria-label="Foodstock sections"
    >


        <button
            type="button"
            class="feedstore-tab active"
            data-tab="available-stock"
            aria-selected="true"
        >

            <span
                class="feedstore-tab-icon"
                aria-hidden="true"
            >
                📦
            </span>

            <span class="feedstore-tab-text">
                Available Stock
            </span>

        </button>



        <% if (isAdmin) { %>


            <button
                type="button"
                class="feedstore-tab"
                data-tab="restock-stock"
                aria-selected="false"
            >

                <span
                    class="feedstore-tab-icon"
                    aria-hidden="true"
                >
                    ➕
                </span>

                <span class="feedstore-tab-text">
                    Add / Restock
                </span>

            </button>


        <% } else if (isDairyWorker) { %>


            <button
                type="button"
                class="feedstore-tab"
                data-tab="restock-stock"
                aria-selected="false"
            >

                <span
                    class="feedstore-tab-icon"
                    aria-hidden="true"
                >
                    📦
                </span>

                <span class="feedstore-tab-text">
                    Update Remaining
                </span>

            </button>


        <% } %>



        <button
            type="button"
            class="feedstore-tab"
            data-tab="foodstock-updates"
            aria-selected="false"
        >

            <span
                class="feedstore-tab-icon"
                aria-hidden="true"
            >
                📝
            </span>

            <span class="feedstore-tab-text">
                Foodstock Updates
            </span>

        </button>


    </nav>



    <!-- ======================================================
         TAB CONTENT
    ======================================================= -->

    <main class="feedstore-tab-content">


        <!-- ==================================================
             AVAILABLE STOCK
        =================================================== -->

        <section
            class="feedstore-tab-panel active"
            data-panel="available-stock"
        >


            <div class="feedstore-section">


                <div class="feedstore-section-header">

                    <div>

                        <h2>
                            Available Stock
                        </h2>


                        <p>
                            Current quantities recorded in the
                            dairy database.
                        </p>

                    </div>

                </div>



                <% if (feedStoreItems.length > 0) { %>


                    <div class="feedstore-stock-list">


                        <% feedStoreItems.forEach(
                            function(stockItem)
                        { %>


                            <%
                                const medicine =
                                    isMedicineStock(
                                        stockItem
                                    );


                                const stockName =
                                    getStockName(
                                        stockItem
                                    );


                                /*
                                --------------------------------------------------
                                IMPORTANT

                                This value is captured directly from the
                                database-backed feedStocks[] item.

                                It is NOT replaced with zero unless the
                                actual record has no usable quantity.
                                --------------------------------------------------
                                */

                                const stockQuantity =
                                    getStockQuantity(
                                        stockItem
                                    );


                                const stockUnit =
                                    getStockUnit(
                                        stockItem
                                    );


                                const stockPrice =
                                    getStockPrice(
                                        stockItem
                                    );


                                const stockId =
                                    stockItem &&
                                    stockItem._id
                                        ? String(
                                            stockItem._id
                                        )
                                        : "";


                                const hasStockId =
                                    !!stockId;
                            %>


                            <article
                                class="
                                    feedstore-stock-card
                                    <%= canUpdateStock && hasStockId
                                        ? "feedstore-stock-card--clickable"
                                        : ""
                                    %>
                                "
                                data-stock-id="<%= stockId %>"
                                data-stock-name="<%= stockName %>"
                                data-stock-quantity="<%= stockQuantity %>"
                                data-stock-unit="<%= stockUnit %>"
                                data-stock-price="<%= stockPrice %>"
                                data-stock-type="<%= medicine ? "medicine" : "feed" %>"
                                <% if (
                                    canUpdateStock &&
                                    hasStockId
                                ) { %>
                                    tabindex="0"
                                    role="button"
                                    aria-label="<%= isAdmin ? "Restock" : "Update remaining" %> <%= stockName %>"
                                <% } %>
                            >


                                <div class="feedstore-stock-main">


                                    <div
                                        class="feedstore-stock-icon"
                                        aria-hidden="true"
                                    >

                                        <% if (medicine) { %>

                                            💊

                                        <% } else { %>

                                            🌾

                                        <% } %>

                                    </div>


                                    <div class="feedstore-stock-info">


                                        <strong>
                                            <%= stockName %>
                                        </strong>


                                        <span>

                                            <% if (medicine) { %>

                                                Veterinary medicine

                                            <% } else { %>

                                                Animal feed

                                            <% } %>

                                        </span>


                                    </div>


                                </div>



                                <div class="feedstore-stock-right">


                                    <div class="feedstore-stock-quantity">


                                        <strong>
                                            <%= Number(
                                                stockQuantity
                                            ).toLocaleString() %>
                                        </strong>


                                        <span>
                                            <%= stockUnit %>
                                        </span>


                                    </div>



                                    <% if (
                                        canUpdateStock &&
                                        hasStockId
                                    ) { %>


                                        <span
                                            class="feedstore-stock-action"
                                            aria-hidden="true"
                                        >

                                            <%= isAdmin
                                                ? "Restock →"
                                                : "Update →"
                                            %>

                                        </span>


                                    <% } %>


                                </div>


                            </article>


                        <% }); %>


                    </div>


                <% } else { %>


                    <div class="feedstore-empty">


                        <div
                            class="feedstore-empty-icon"
                            aria-hidden="true"
                        >
                            🌾
                        </div>


                        <h3>
                            No stock recorded yet
                        </h3>


                        <p>
                            Available animal feed and veterinary
                            medicines will appear here once they
                            are added.
                        </p>


                    </div>


                <% } %>


            </div>



            <% if (isAdmin) { %>


                <section class="feedstore-admin-value">


                    <div>

                        <span>
                            TOTAL FOODSTOCK &amp; MEDICINE VALUE
                        </span>


                        <strong>

                            KES
                            <%= Number(
                                currentDairy.feedsAmount || 0
                            ).toLocaleString(
                                undefined,
                                {
                                    minimumFractionDigits: 2,
                                    maximumFractionDigits: 2
                                }
                            ) %>

                        </strong>

                    </div>


                    <small>
                        Visible to administrators only.
                    </small>


                </section>


            <% } %>


        </section>



        <!-- ==================================================
             ADMIN ADD / RESTOCK
             WORKER UPDATE REMAINING
        =================================================== -->

        <% if (canUpdateStock) { %>


            <section
                class="feedstore-tab-panel"
                data-panel="restock-stock"
            >


                <div class="feedstore-section">


                    <div class="feedstore-section-header">


                        <div>

                            <% if (isAdmin) { %>

                                <div class="feedstore-admin-label">
                                    ADMIN
                                </div>

                            <% } else if (isDairyWorker) { %>

                                <div class="feedstore-worker-label">
                                    DAIRY WORKER
                                </div>

                            <% } %>


                            <h2 id="restockHeading">

                                <%= isAdmin
                                    ? "Add / Restock Stock"
                                    : "Update Remaining Stock"
                                %>

                            </h2>


                            <p id="restockDescription">

                                <%= isAdmin
                                    ? "Add new stock or update an existing stock item."
                                    : "Select an existing stock item and report the quantity currently remaining."
                                %>

                            </p>

                        </div>


                    </div>



                    <!-- ==================================================
                         SELECTED STOCK
                    =================================================== -->

                    <div
                        id="selectedStockSummary"
                        class="feedstore-selected-stock"
                        hidden
                    >


                        <div
                            id="selectedStockIcon"
                            class="feedstore-selected-stock__icon"
                            aria-hidden="true"
                        >
                            🌾
                        </div>


                        <div class="feedstore-selected-stock__info">


                            <span>
                                SELECTED STOCK
                            </span>


                            <strong id="selectedStockName">
                                —
                            </strong>


                            <small id="selectedStockCurrent">
                                Current remainder: —
                            </small>


                        </div>


                    </div>



                    <!-- ==================================================
                         FORM
                    =================================================== -->

                    <form
                        id="feedstoreStockForm"
                        class="feedstore-form"
                        action="/dairy/<%= currentDairy._id %>/feedstore/restock"
                        method="POST"
                        enctype="multipart/form-data"
                    >


                        <!-- EXISTING STOCK ID -->

                        <input
                            id="selectedStockId"
                            type="hidden"
                            name="stockId"
                            value=""
                        >



                        <!-- ==================================================
                             STOCK CATEGORY

                             ADMIN:
                                 selectable.

                             WORKER:
                                 selected stock determines category.
                                 Category is disabled.
                        =================================================== -->

                        <div class="feedstore-field">


                            <label for="stockCategory">
                                Stock type
                            </label>


                            <select
                                id="stockCategory"
                                name="category"
                                required
                            >


                                <option value="">
                                    Select stock type
                                </option>


                                <option value="feed">
                                    Animal Feed
                                </option>


                                <option value="medicine">
                                    Veterinary Medicine
                                </option>


                            </select>


                            <% if (isDairyWorker) { %>

                                <small>
                                    Stock type comes from the selected
                                    database record.
                                </small>

                            <% } %>


                        </div>



                        <!-- ==================================================
                             FEED
                        =================================================== -->

                        <div
                            class="feedstore-field"
                            id="feedTypeField"
                        >


                            <label for="feedType">
                                Animal feed
                            </label>


                            <select
                                id="feedType"
                                name="feedName"
                            >


                                <option value="">
                                    Select animal feed
                                </option>


                                <% availableFeedTypes.forEach(
                                    function(type)
                                { %>


                                    <option value="<%= type %>">
                                        <%= type %>
                                    </option>


                                <% }); %>


                            </select>


                        </div>



                        <!-- ==================================================
                             MEDICINE
                        =================================================== -->

                        <div
                            class="feedstore-field"
                            id="medicineTypeField"
                            hidden
                        >


                            <label for="medicineType">
                                Veterinary medicine
                            </label>


                            <select
                                id="medicineType"
                                name="medicineName"
                            >


                                <option value="">
                                    Select veterinary medicine
                                </option>


                                <% availableMedicineTypes.forEach(
                                    function(type)
                                { %>


                                    <option value="<%= type %>">
                                        <%= type %>
                                    </option>


                                <% }); %>


                            </select>


                        </div>



                        <!-- ==================================================
                             QUANTITY + UNIT
                        =================================================== -->

                        <div class="feedstore-two-columns">


                            <div class="feedstore-field">


                                <label for="stockQuantity">

                                    <%= isAdmin
                                        ? "Quantity"
                                        : "Quantity Remaining"
                                    %>

                                </label>


                                <input
                                    id="stockQuantity"
                                    type="number"
                                    name="quantity"
                                    min="0"
                                    step="0.01"
                                    placeholder="<%= isAdmin ? "Enter quantity" : "Enter quantity remaining" %>"
                                    required
                                >


                                <% if (isDairyWorker) { %>


                                    <small
                                        id="workerQuantityHelp"
                                    >

                                        Current database remainder:
                                        <strong id="workerCurrentQuantity">
                                            0
                                        </strong>

                                        <br>

                                        You cannot report a quantity
                                        greater than the current
                                        database remainder.

                                    </small>


                                <% } %>


                            </div>



                            <div class="feedstore-field">


                                <label for="stockUnit">
                                    Unit
                                </label>


                                <select
                                    id="stockUnit"
                                    name="unit"
                                    required
                                >


                                    <option value="">
                                        Select unit
                                    </option>


                                    <% availableStockUnits.forEach(
                                        function(unit)
                                    { %>


                                        <option value="<%= unit %>">
                                            <%= unit %>
                                        </option>


                                    <% }); %>


                                </select>


                                <% if (isDairyWorker) { %>


                                    <small>
                                        Unit is taken from the current
                                        database record and cannot be
                                        changed.
                                    </small>


                                <% } else { %>


                                    <small>
                                        Administrators may edit the
                                        stock unit.
                                    </small>


                                <% } %>


                            </div>


                        </div>



                        <!-- ==================================================
                             ADMIN PRICE ONLY
                        =================================================== -->

                        <% if (isAdmin) { %>


                            <div class="feedstore-field">


                                <label for="stockPrice">
                                    Price / value
                                </label>


                                <div class="feedstore-money">


                                    <span>
                                        KES
                                    </span>


                                    <input
                                        id="stockPrice"
                                        type="number"
                                        name="price"
                                        min="0"
                                        step="0.01"
                                        placeholder="Enter value"
                                    >


                                </div>


                                <small>
                                    Financial information is visible
                                    to administrators only.
                                </small>


                            </div>


                        <% } %>



                        <!-- ==================================================
                             ADMIN ONLY:
                             INSTRUCTIONS
                        =================================================== -->

                        <% if (isAdmin) { %>


                            <div class="feedstore-field">


                                <label for="stockInstructions">
                                    Instructions of use
                                </label>


                                <textarea
                                    id="stockInstructions"
                                    name="instructions"
                                    rows="4"
                                    maxlength="1500"
                                    placeholder="How should this feed or medicine be used?"
                                ></textarea>


                            </div>



                            <!-- ==================================================
                                 ADMIN ONLY:
                                 EXPECTED DURATION
                            =================================================== -->

                            <div class="feedstore-field">


                                <label for="expectedDuration">
                                    Expected duration of consumption
                                </label>


                                <input
                                    id="expectedDuration"
                                    type="text"
                                    name="expectedDuration"
                                    maxlength="100"
                                    placeholder="e.g. Approximately 14 days"
                                >


                            </div>


                        <% } %>



                        <!-- ==================================================
                             ADDITIONAL INFORMATION

                             BOTH ADMIN AND WORKER CAN PROVIDE THIS.
                        =================================================== -->

                        <div class="feedstore-field">


                            <label for="stockMessage">
                                Additional information
                            </label>


                            <textarea
                                id="stockMessage"
                                name="message"
                                rows="4"
                                maxlength="1500"
                                placeholder="Add useful information about this stock update..."
                            ></textarea>


                        </div>



                        <!-- ==================================================
                             PHOTOS

                             BOTH ADMIN AND WORKER CAN PROVIDE PHOTOS.
                        =================================================== -->

                        <div class="feedstore-field">


                            <label for="stockImages">
                                Photos
                            </label>


                            <input
                                id="stockImages"
                                type="file"
                                name="images"
                                accept="image/*"
                                multiple
                            >


                            <small>
                                Add photos related to this stock update.
                            </small>


                        </div>



                        <!-- ==================================================
                             SUBMIT
                        =================================================== -->

                        <button
                            id="feedstoreSubmit"
                            type="submit"
                            class="
                                feedstore-submit
                                <%= isAdmin
                                    ? "admin-submit"
                                    : "worker-submit"
                                %>
                            "
                        >


                            <span
                                id="feedstoreSubmitIcon"
                                aria-hidden="true"
                            >

                                <%= isAdmin
                                    ? "➕"
                                    : "📦"
                                %>

                            </span>


                            <span id="feedstoreSubmitText">

                                <%= isAdmin
                                    ? "Add Stock"
                                    : "Update Remaining Stock"
                                %>

                            </span>


                        </button>


                    </form>


                </div>


            </section>


        <% } %>



        <!-- ==================================================
             FOODSTOCK HISTORY
        =================================================== -->

        <section
            class="feedstore-tab-panel"
            data-panel="foodstock-updates"
        >


            <div class="feedstore-section">


                <div class="feedstore-section-header">


                    <div>

                        <h2>
                            Foodstock Updates
                        </h2>


                        <p>
                            Stock additions and remaining-stock
                            reports recorded for this dairy.
                        </p>

                    </div>


                </div>



                <% if (feedStoreUpdates.length > 0) { %>


                    <div class="feedstore-feed">


                        <% feedStoreUpdates.forEach(
                            function(item)
                        { %>


                            <%- include(
                                "stock",
                                {
                                    item: item,
                                    dairy: currentDairy,
                                    user: currentUser
                                }
                            ) %>


                        <% }); %>


                    </div>


                <% } else { %>


                    <div class="feedstore-empty">


                        <div
                            class="feedstore-empty-icon"
                            aria-hidden="true"
                        >
                            📦
                        </div>


                        <h3>
                            No foodstock updates yet
                        </h3>


                        <p>
                            Stock additions and remaining-stock
                            reports will appear here.
                        </p>


                    </div>


                <% } %>


            </div>


        </section>


    </main>


</div>



<!-- ==========================================================
     FEED STORE JAVASCRIPT
========================================================== -->

<script>

document.addEventListener(
    "DOMContentLoaded",
    function () {


        /* ======================================================
           ELEMENTS
        ======================================================= */

        const tabs =
            document.querySelectorAll(
                ".feedstore-tab"
            );


        const panels =
            document.querySelectorAll(
                ".feedstore-tab-panel"
            );


        const stockCards =
            document.querySelectorAll(
                ".feedstore-stock-card--clickable"
            );


        const category =
            document.getElementById(
                "stockCategory"
            );


        const feedField =
            document.getElementById(
                "feedTypeField"
            );


        const medicineField =
            document.getElementById(
                "medicineTypeField"
            );


        const feedSelect =
            document.getElementById(
                "feedType"
            );


        const medicineSelect =
            document.getElementById(
                "medicineType"
            );


        const form =
            document.getElementById(
                "feedstoreStockForm"
            );


        const selectedStockId =
            document.getElementById(
                "selectedStockId"
            );


        const stockQuantity =
            document.getElementById(
                "stockQuantity"
            );


        const stockUnit =
            document.getElementById(
                "stockUnit"
            );


        const stockPrice =
            document.getElementById(
                "stockPrice"
            );


        const stockInstructions =
            document.getElementById(
                "stockInstructions"
            );


        const expectedDuration =
            document.getElementById(
                "expectedDuration"
            );


        const stockMessage =
            document.getElementById(
                "stockMessage"
            );


        const stockImages =
            document.getElementById(
                "stockImages"
            );


        const selectedStockSummary =
            document.getElementById(
                "selectedStockSummary"
            );


        const selectedStockName =
            document.getElementById(
                "selectedStockName"
            );


        const selectedStockCurrent =
            document.getElementById(
                "selectedStockCurrent"
            );


        const selectedStockIcon =
            document.getElementById(
                "selectedStockIcon"
            );


        const restockHeading =
            document.getElementById(
                "restockHeading"
            );


        const restockDescription =
            document.getElementById(
                "restockDescription"
            );


        const submitText =
            document.getElementById(
                "feedstoreSubmitText"
            );


        const submitIcon =
            document.getElementById(
                "feedstoreSubmitIcon"
            );


        const workerCurrentQuantity =
            document.getElementById(
                "workerCurrentQuantity"
            );



        /* ======================================================
           ROLE
        ======================================================= */

        const isAdmin =
            <%= isAdmin ? "true" : "false" %>;


        const isDairyWorker =
            <%= isDairyWorker ? "true" : "false" %>;



        /* ======================================================
           CURRENT SELECTED DATABASE QUANTITY

           IMPORTANT:

           This variable stores the actual remainder loaded
           from the selected feedStocks[] record.

           It is deliberately NOT initialized from a random
           zero value.

           It is only zero when the actual selected database
           record contains zero.
        ======================================================= */

        let selectedDatabaseQuantity =
            null;



        /* ======================================================
           TAB ACTIVATION
        ======================================================= */

        function activateTab(
            tabName,
            shouldScroll
        ) {


            tabs.forEach(
                function(tab) {


                    const isActive =
                        tab.dataset.tab === tabName;


                    tab.classList.toggle(
                        "active",
                        isActive
                    );


                    tab.setAttribute(
                        "aria-selected",
                        isActive
                            ? "true"
                            : "false"
                    );


                }
            );


            panels.forEach(
                function(panel) {


                    const isActive =
                        panel.dataset.panel === tabName;


                    panel.classList.toggle(
                        "active",
                        isActive
                    );


                }
            );


            if (shouldScroll) {


                window.scrollTo({

                    top: 0,

                    behavior: "smooth"

                });


            }

        }



        tabs.forEach(
            function(tab) {


                tab.addEventListener(
                    "click",
                    function() {


                        activateTab(
                            tab.dataset.tab,
                            true
                        );


                    }
                );


            }
        );



        /* ======================================================
           STOCK CATEGORY SWITCHER
        ======================================================= */

        function updateStockType() {


            if (
                !category ||
                !feedField ||
                !medicineField ||
                !feedSelect ||
                !medicineSelect
            ) {

                return;

            }


            const value =
                category.value;


            if (value === "medicine") {


                feedField.hidden =
                    true;


                medicineField.hidden =
                    false;


                feedSelect.required =
                    false;


                medicineSelect.required =
                    !selectedStockId.value;


            } else {


                feedField.hidden =
                    false;


                medicineField.hidden =
                    true;


                feedSelect.required =
                    value === "feed" &&
                    !selectedStockId.value;


                medicineSelect.required =
                    false;


            }

        }



        if (category) {


            category.addEventListener(
                "change",
                updateStockType
            );


        }



        /* ======================================================
           PREPARE NEW STOCK

           IMPORTANT:
           ONLY ADMINISTRATORS CAN USE THIS.

           A dairy worker cannot reach this state.
        ======================================================= */

        function prepareNewStockForm() {


            if (
                !isAdmin ||
                !form
            ) {

                return;

            }


            form.reset();


            selectedStockId.value =
                "";


            selectedDatabaseQuantity =
                null;


            if (selectedStockSummary) {

                selectedStockSummary.hidden =
                    true;

            }


            if (restockHeading) {

                restockHeading.textContent =
                    "Add / Restock Stock";

            }


            if (restockDescription) {

                restockDescription.textContent =
                    "Record newly available animal feed or veterinary medicine.";

            }


            if (submitText) {

                submitText.textContent =
                    "Add Stock";

            }


            if (submitIcon) {

                submitIcon.textContent =
                    "➕";

            }


            if (stockQuantity) {

                stockQuantity.removeAttribute(
                    "max"
                );


                stockQuantity.value =
                    "";

            }


            if (stockUnit) {

                stockUnit.disabled =
                    false;

            }


            if (stockImages) {

                stockImages.value =
                    "";

            }


            updateStockType();

        }



        /* ======================================================
           OPEN EXISTING STOCK
        ======================================================= */

        function openExistingStock(
            card
        ) {


            if (
                !card ||
                !form
            ) {

                return;

            }


            const stockId =
                card.dataset.stockId ||
                "";


            if (!stockId) {

                return;

            }


            const stockName =
                card.dataset.stockName ||
                "Unnamed Stock";


            /*
            --------------------------------------------------
            CRITICAL QUANTITY FIX

            Read the value exactly as stored on the stock card.

            The card itself was generated from:

                dairy.feedStocks[]

            We do NOT use:

                || 0

            because that can hide the fact that the wrong
            database property was supplied.

            Number("") is handled explicitly below.
            --------------------------------------------------
            */

            const rawQuantity =
                card.dataset.stockQuantity;


            let quantity =
                Number(rawQuantity);


            if (
                rawQuantity === undefined ||
                rawQuantity === null ||
                rawQuantity === "" ||
                !Number.isFinite(quantity)
            ) {

                quantity = 0;

            }


            const unit =
                card.dataset.stockUnit ||
                "";


            const stockType =
                card.dataset.stockType ||
                "feed";


            const rawPrice =
                card.dataset.stockPrice;


            let price =
                Number(rawPrice);


            if (
                !Number.isFinite(price)
            ) {

                price = 0;

            }


            /* ==================================================
               SAVE ACTUAL DATABASE REMAINDER IN MEMORY
            ================================================== */

            selectedDatabaseQuantity =
                quantity;


            /* ==================================================
               STOCK ID
            ================================================== */

            selectedStockId.value =
                stockId;


            /* ==================================================
               SHOW SELECTED STOCK
            ================================================== */

            if (selectedStockSummary) {

                selectedStockSummary.hidden =
                    false;

            }


            if (selectedStockName) {

                selectedStockName.textContent =
                    stockName;

            }


            if (selectedStockCurrent) {

                selectedStockCurrent.textContent =
                    "Current remainder: " +
                    quantity.toLocaleString() +
                    " " +
                    unit;

            }


            if (selectedStockIcon) {

                selectedStockIcon.textContent =
                    stockType === "medicine"
                        ? "💊"
                        : "🌾";

            }


            /* ==================================================
               STOCK TYPE
            ================================================== */

            if (category) {

                category.value =
                    stockType;


                if (isDairyWorker) {

                    category.disabled =
                        true;

                } else {

                    category.disabled =
                        false;

                }

            }


            /* ==================================================
               STOCK NAME

               Existing stock is selected by stockId.

               The backend should identify the actual item
               from that ID.

               The select is therefore not required for an
               existing stock.
            ================================================== */

            if (feedSelect) {

                feedSelect.required =
                    false;

            }


            if (medicineSelect) {

                medicineSelect.required =
                    false;

            }


            /* ==================================================
               QUANTITY

               THIS IS THE IMPORTANT FIX.

               Existing database remainder is loaded directly
               into the input.

               We do not initialise it with zero.
            ================================================== */

            if (stockQuantity) {

                stockQuantity.value =
                    String(
                        quantity
                    );


                if (isDairyWorker) {


                    stockQuantity.max =
                        String(
                            quantity
                        );


                } else {


                    stockQuantity.removeAttribute(
                        "max"
                    );


                }

            }


            /* ==================================================
               UNIT

               Existing database unit is loaded.

               Worker:
                   disabled.

               Admin:
                   editable.
            ================================================== */

            if (stockUnit) {

                stockUnit.value =
                    unit;


                stockUnit.disabled =
                    isDairyWorker;

            }


            /* ==================================================
               ADMIN PRICE
            ================================================== */

            if (
                isAdmin &&
                stockPrice
            ) {

                stockPrice.value =
                    price > 0
                        ? String(price)
                        : "";

            }


            /* ==================================================
               CLEAR NEW UPDATE DATA

               Do not accidentally carry information from a
               previous stock update.
            ================================================== */

            if (stockInstructions) {

                stockInstructions.value =
                    "";

            }


            if (expectedDuration) {

                expectedDuration.value =
                    "";

            }


            if (stockMessage) {

                stockMessage.value =
                    "";

            }


            if (stockImages) {

                stockImages.value =
                    "";

            }


            /* ==================================================
               WORKER CURRENT QUANTITY DISPLAY
            ================================================== */

            if (workerCurrentQuantity) {

                workerCurrentQuantity.textContent =
                    quantity.toLocaleString();

            }


            /* ==================================================
               HEADING
            ================================================== */

            if (restockHeading) {

                restockHeading.textContent =
                    isAdmin
                        ? "Restock / Update Stock"
                        : "Update Remaining Stock";

            }


            if (restockDescription) {

                restockDescription.textContent =
                    isAdmin

                        ? "The selected stock has been loaded from the database. Edit the quantity or unit as required."

                        : "The selected stock has been loaded from the database. Enter the quantity currently remaining.";

            }


            /* ==================================================
               BUTTON
            ================================================== */

            if (submitText) {

                submitText.textContent =
                    isAdmin
                        ? "Save Stock Update"
                        : "Update Remaining Stock";

            }


            if (submitIcon) {

                submitIcon.textContent =
                    isAdmin
                        ? "💾"
                        : "📦";

            }


            updateStockType();


            /* ==================================================
               OPEN UPDATE TAB
            ================================================== */

            activateTab(
                "restock-stock",
                true
            );

        }



        /* ======================================================
           STOCK CARD CLICK
        ======================================================= */

        stockCards.forEach(
            function(card) {


                card.addEventListener(
                    "click",
                    function() {


                        openExistingStock(
                            card
                        );


                    }
                );


                card.addEventListener(
                    "keydown",
                    function(event) {


                        if (
                            event.key === "Enter" ||
                            event.key === " "
                        ) {


                            event.preventDefault();


                            openExistingStock(
                                card
                            );


                        }

                    }
                );


            }
        );



        /* ======================================================
           DIRECT ADD / UPDATE TAB

           ADMIN:
               opens clean Add / Restock form.

           WORKER:
               does NOT get an empty form.

               They MUST select an existing stock first.
        ======================================================= */

        const restockTab =
            document.querySelector(
                '[data-tab="restock-stock"]'
            );


        if (restockTab) {


            restockTab.addEventListener(
                "click",
                function(event) {


                    if (isAdmin) {


                        if (
                            selectedStockId &&
                            selectedStockId.value
                        ) {

                            return;

                        }


                        prepareNewStockForm();


                    }


                    if (isDairyWorker) {


                        if (
                            !selectedStockId ||
                            !selectedStockId.value
                        ) {


                            /*
                            ------------------------------------------------
                            A worker cannot create a new stock event.

                            They must select an existing database stock.
                            ------------------------------------------------
                            */

                            event.preventDefault();


                            activateTab(
                                "available-stock",
                                true
                            );


                            alert(
                                "Select an existing stock item first."
                            );


                        }

                    }


                }
            );


        }



        /* ======================================================
           WORKER QUANTITY VALIDATION
        ======================================================= */

        if (stockQuantity) {


            stockQuantity.addEventListener(
                "input",
                function() {


                    if (!isDairyWorker) {

                        return;

                    }


                    if (
                        selectedDatabaseQuantity === null
                    ) {

                        return;

                    }


                    const entered =
                        Number(
                            stockQuantity.value
                        );


                    if (
                        !Number.isFinite(
                            entered
                        )
                    ) {

                        return;

                    }


                    if (
                        entered >
                        selectedDatabaseQuantity
                    ) {


                        stockQuantity.value =
                            String(
                                selectedDatabaseQuantity
                            );


                        if (workerCurrentQuantity) {

                            workerCurrentQuantity.textContent =
                                selectedDatabaseQuantity.toLocaleString();

                        }


                    }

                }
            );


        }



        /* ======================================================
           FINAL FORM VALIDATION
        ======================================================= */

        if (form) {


            form.addEventListener(
                "submit",
                function(event) {


                    /* ==========================================
                       WORKER
                    =========================================== */

                    if (isDairyWorker) {


                        /* --------------------------------------
                           Worker MUST select an existing stock.
                        -------------------------------------- */

                        if (
                            !selectedStockId ||
                            !selectedStockId.value
                        ) {


                            event.preventDefault();


                            alert(
                                "Select an existing stock item before submitting."
                            );


                            return;

                        }


                        /* --------------------------------------
                           Worker cannot provide instructions.
                        -------------------------------------- */

                        if (stockInstructions) {

                            stockInstructions.value =
                                "";

                        }


                        /* --------------------------------------
                           Worker cannot provide duration.
                        -------------------------------------- */

                        if (expectedDuration) {

                            expectedDuration.value =
                                "";

                        }


                        /* --------------------------------------
                           Worker cannot change unit.
                        -------------------------------------- */

                        if (stockUnit) {

                            stockUnit.disabled =
                                false;

                        }


                        /*
                        ------------------------------------------------
                        IMPORTANT HTML FORM BEHAVIOUR

                        A disabled input/select is NOT submitted.

                        Therefore the worker's database unit must be
                        copied into a hidden field before submission.

                        Remove any old hidden unit field first.
                        ------------------------------------------------
                        */

                        const oldHiddenUnit =
                            form.querySelector(
                                "#workerDatabaseUnit"
                            );


                        if (oldHiddenUnit) {

                            oldHiddenUnit.remove();

                        }


                        const hiddenUnit =
                            document.createElement(
                                "input"
                            );


                        hiddenUnit.type =
                            "hidden";


                        hiddenUnit.id =
                            "workerDatabaseUnit";


                        hiddenUnit.name =
                            "unit";


                        hiddenUnit.value =
                            stockUnit
                                ? stockUnit.value
                                : "";


                        form.appendChild(
                            hiddenUnit
                        );


                        /* --------------------------------------
                           Worker quantity must not exceed the
                           database remainder.
                        -------------------------------------- */

                        const entered =
                            Number(
                                stockQuantity.value
                            );


                        if (
                            selectedDatabaseQuantity === null ||
                            !Number.isFinite(
                                entered
                            )
                        ) {


                            event.preventDefault();


                            alert(
                                "Enter the remaining quantity."
                            );


                            return;

                        }


                        if (
                            entered >
                            selectedDatabaseQuantity
                        ) {


                            event.preventDefault();


                            stockQuantity.value =
                                String(
                                    selectedDatabaseQuantity
                                );


                            stockQuantity.focus();


                            alert(
                                "A dairy worker cannot report a quantity greater than the current stock remainder."
                            );


                            return;

                        }


                        /*
                        ------------------------------------------------
                        Worker is allowed:

                            message
                            images

                        Worker is NOT allowed:

                            instructions
                            expectedDuration
                            price
                            unit changes
                        ------------------------------------------------
                        */

                        if (stockPrice) {

                            stockPrice.value =
                                "";

                        }


                        return;

                    }



                    /* ==========================================
                       ADMIN
                    =========================================== */

                    if (isAdmin) {


                        /*
                        ------------------------------------------------
                        Admin can:

                            create new stock
                            restock existing stock
                            edit quantity
                            edit unit
                            edit price
                            add instructions
                            add duration
                            add message
                            add images
                        ------------------------------------------------
                        */

                        return;

                    }


                    /* ==========================================
                       UNKNOWN ROLE
                    =========================================== */

                    event.preventDefault();


                    alert(
                        "You are not authorized to update foodstock."
                    );


                }
            );


        }



        /* ======================================================
           INITIAL CATEGORY STATE
        ======================================================= */

        updateStockType();


    }
);

</script>



