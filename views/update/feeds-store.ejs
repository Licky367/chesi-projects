<% /*
==============================================================
FEED STORE PAGE

FILE:
    views/update/feeds-store.ejs

PURPOSE:
    Dedicated dairy foodstock page.

EXPECTED DATA:
--------------------------------------------------------------
    dairy
    user
    updates
    feedTypes
    medicineTypes
    stockUnits

CURRENT INVENTORY:
--------------------------------------------------------------
    dairy.feedStocks[]

HISTORY:
--------------------------------------------------------------
    updates[]

IMPORTANT STOCK RULE:
--------------------------------------------------------------
    CURRENT inventory comes ONLY from:

        dairy.feedStocks[]

    Historical events come ONLY from:

        updates[]

ROLES:
--------------------------------------------------------------
    ADMIN:
        • Can add new stock.
        • Can restock existing stock.
        • Can edit quantity.
        • Can edit unit.
        • Can add price/value.
        • Can add additional information.
        • Can add instructions.
        • Can add expected duration.
        • Can add photos.

    DAIRY WORKER:
        • Cannot add new stock.
        • Cannot restock stock.
        • Can select existing stock only.
        • Can report current remaining quantity.
        • Cannot change unit.
        • Cannot report more than current database remainder.
        • Can add additional information.
        • Can add photos.
        • Cannot provide instructions.
        • Cannot provide expected duration.
==============================================================
*/ %>


<%
/* ==========================================================
   DIRECT PAGE DATA

   No fallback values are introduced here.
========================================================== */

const currentDairy = dairy;

const currentUser = user;


/* ==========================================================
   CURRENT INVENTORY

   DIRECTLY FROM dairy.feedStocks
========================================================== */

const feedStoreItems =
    currentDairy.feedStocks;


/* ==========================================================
   HISTORY

   DIRECTLY FROM controller data
========================================================== */

const feedStoreUpdates =
    updates;


/* ==========================================================
   FORM OPTIONS

   DIRECTLY FROM CONTROLLER
========================================================== */

const availableFeedTypes =
    feedTypes;


const availableMedicineTypes =
    medicineTypes;


const availableStockUnits =
    stockUnits;


/* ==========================================================
   USER ROLE
========================================================== */

const isAdmin =
    currentUser.role === "admin";


const isDairyWorker =
    currentUser.role === "dairyWorker";


/* ==========================================================
   STOCK TYPE
========================================================== */

function isMedicineStock(stock) {

    return stock.category === "medicine";

}


/* ==========================================================
   STOCK NAME

   ONE EXPECTED DATABASE FIELD:
       stock.name
========================================================== */

function getStockName(stock) {

    return stock.name;

}


/* ==========================================================
   STOCK QUANTITY

   ONE EXPECTED DATABASE FIELD:
       stock.quantityRemaining
========================================================== */

function getStockQuantity(stock) {

    return Number(
        stock.quantityRemaining
    );

}


/* ==========================================================
   STOCK UNIT

   ONE EXPECTED DATABASE FIELD:
       stock.unit
========================================================== */

function getStockUnit(stock) {

    return stock.unit;

}


/* ==========================================================
   STOCK PRICE

   ONE EXPECTED DATABASE FIELD:
       stock.price
========================================================== */

function getStockPrice(stock) {

    return Number(
        stock.price
    );

}

%>


<div
    class="feedstore-page"
    data-dairy-id="<%= currentDairy._id %>"
>


    <!-- ======================================================
         PAGE INTRO
    ======================================================= -->

    <header class="feedstore-intro">


        <div
            class="feedstore-intro-icon"
            aria-hidden="true"
        >
            🌾
        </div>


        <div>

            <div class="feedstore-eyebrow">
                DAIRY FOODSTOCK
            </div>


            <h1>
                <%= currentDairy.name %>'s Foodstock
            </h1>


            <p>
                View current stock and keep foodstock records
                up to date.
            </p>

        </div>


    </header>



    <!-- ======================================================
         TAB NAVIGATION
    ======================================================= -->

    <nav
        class="feedstore-tabs"
        aria-label="Foodstock sections"
    >


        <button
            type="button"
            class="feedstore-tab active"
            data-tab="available-stock"
            aria-selected="true"
        >

            <span
                class="feedstore-tab-icon"
                aria-hidden="true"
            >
                📦
            </span>

            <span class="feedstore-tab-text">
                Available Stock
            </span>

        </button>



        <% if (isAdmin) { %>


            <button
                type="button"
                class="feedstore-tab"
                data-tab="restock-stock"
                aria-selected="false"
            >

                <span
                    class="feedstore-tab-icon"
                    aria-hidden="true"
                >
                    ➕
                </span>

                <span class="feedstore-tab-text">
                    Add / Restock
                </span>

            </button>


        <% } else if (isDairyWorker) { %>


            <button
                type="button"
                class="feedstore-tab"
                data-tab="restock-stock"
                aria-selected="false"
            >

                <span
                    class="feedstore-tab-icon"
                    aria-hidden="true"
                >
                    📦
                </span>

                <span class="feedstore-tab-text">
                    Update Remaining
                </span>

            </button>


        <% } %>



        <button
            type="button"
            class="feedstore-tab"
            data-tab="foodstock-updates"
            aria-selected="false"
        >

            <span
                class="feedstore-tab-icon"
                aria-hidden="true"
            >
                📝
            </span>

            <span class="feedstore-tab-text">
                Foodstock Updates
            </span>

        </button>


    </nav>



    <!-- ======================================================
         TAB CONTENT
    ======================================================= -->

    <main class="feedstore-tab-content">


        <!-- ==================================================
             AVAILABLE STOCK
        =================================================== -->

        <section
            class="feedstore-tab-panel active"
            data-panel="available-stock"
        >


            <div class="feedstore-section">


                <div class="feedstore-section-header">

                    <div>

                        <h2>
                            Available Stock
                        </h2>


                        <p>
                            Current quantities recorded in the
                            dairy database.
                        </p>

                    </div>

                </div>



                <% if (feedStoreItems.length > 0) { %>


                    <div class="feedstore-stock-list">


                        <% feedStoreItems.forEach(
                            function(stockItem)
                        { %>


                            <%
                                const medicine =
                                    isMedicineStock(
                                        stockItem
                                    );


                                const stockName =
                                    getStockName(
                                        stockItem
                                    );


                                const stockQuantity =
                                    getStockQuantity(
                                        stockItem
                                    );


                                const stockUnit =
                                    getStockUnit(
                                        stockItem
                                    );


                                const stockPrice =
                                    getStockPrice(
                                        stockItem
                                    );


                                const stockId =
                                    String(
                                        stockItem._id
                                    );
                            %>


                            <article
                                class="
                                    feedstore-stock-card
                                    feedstore-stock-card--clickable
                                "
                                data-stock-id="<%= stockId %>"
                                data-stock-name="<%= stockName %>"
                                data-stock-quantity="<%= stockQuantity %>"
                                data-stock-unit="<%= stockUnit %>"
                                data-stock-price="<%= stockPrice %>"
                                data-stock-type="<%= medicine ? "medicine" : "feed" %>"
                                tabindex="0"
                                role="button"
                                aria-label="<%= isAdmin ? "Restock" : "Update remaining" %> <%= stockName %>"
                            >


                                <div class="feedstore-stock-main">


                                    <div
                                        class="feedstore-stock-icon"
                                        aria-hidden="true"
                                    >

                                        <% if (medicine) { %>

                                            💊

                                        <% } else { %>

                                            🌾

                                        <% } %>

                                    </div>


                                    <div class="feedstore-stock-info">


                                        <strong>
                                            <%= stockName %>
                                        </strong>


                                        <span>

                                            <% if (medicine) { %>

                                                Veterinary medicine

                                            <% } else { %>

                                                Animal feed

                                            <% } %>

                                        </span>


                                    </div>


                                </div>



                                <div class="feedstore-stock-right">


                                    <div class="feedstore-stock-quantity">


                                        <strong>
                                            <%= Number(
                                                stockQuantity
                                            ).toLocaleString() %>
                                        </strong>


                                        <span>
                                            <%= stockUnit %>
                                        </span>


                                    </div>


                                    <span
                                        class="feedstore-stock-action"
                                        aria-hidden="true"
                                    >

                                        <%= isAdmin
                                            ? "Restock →"
                                            : "Update →"
                                        %>

                                    </span>


                                </div>


                            </article>


                        <% }); %>


                    </div>


                <% } else { %>


                    <div class="feedstore-empty">


                        <div
                            class="feedstore-empty-icon"
                            aria-hidden="true"
                        >
                            🌾
                        </div>


                        <h3>
                            No stock recorded yet
                        </h3>


                        <p>
                            Available animal feed and veterinary
                            medicines will appear here once they
                            are added.
                        </p>


                    </div>


                <% } %>


            </div>



            <% if (isAdmin) { %>


                <section class="feedstore-admin-value">


                    <div>

                        <span>
                            TOTAL FOODSTOCK &amp; MEDICINE VALUE
                        </span>


                        <strong>

                            KES
                            <%= Number(
                                currentDairy.feedsAmount
                            ).toLocaleString(
                                undefined,
                                {
                                    minimumFractionDigits: 2,
                                    maximumFractionDigits: 2
                                }
                            ) %>

                        </strong>

                    </div>


                    <small>
                        Visible to administrators only.
                    </small>


                </section>


            <% } %>


        </section>



        <!-- ==================================================
             ADD / RESTOCK / UPDATE REMAINING
        =================================================== -->

        <% if (isAdmin || isDairyWorker) { %>


            <section
                class="feedstore-tab-panel"
                data-panel="restock-stock"
            >


                <div class="feedstore-section">


                    <div class="feedstore-section-header">


                        <div>

                            <% if (isAdmin) { %>

                                <div class="feedstore-admin-label">
                                    ADMIN
                                </div>

                            <% } else { %>

                                <div class="feedstore-worker-label">
                                    DAIRY WORKER
                                </div>

                            <% } %>


                            <h2 id="restockHeading">

                                <%= isAdmin
                                    ? "Add / Restock Stock"
                                    : "Update Remaining Stock"
                                %>

                            </h2>


                            <p id="restockDescription">

                                <%= isAdmin
                                    ? "Add new stock or update an existing stock item."
                                    : "Select an existing stock item and report the quantity currently remaining."
                                %>

                            </p>

                        </div>


                    </div>



                    <!-- ==================================================
                         SELECTED STOCK
                    =================================================== -->

                    <div
                        id="selectedStockSummary"
                        class="feedstore-selected-stock"
                        hidden
                    >


                        <div
                            id="selectedStockIcon"
                            class="feedstore-selected-stock__icon"
                            aria-hidden="true"
                        >
                            🌾
                        </div>


                        <div class="feedstore-selected-stock__info">


                            <span>
                                SELECTED STOCK
                            </span>


                            <strong id="selectedStockName">
                                —
                            </strong>


                            <small id="selectedStockCurrent">
                                Current remainder: —
                            </small>


                        </div>


                    </div>



                    <!-- ==================================================
                         FORM
                    =================================================== -->

                    <form
                        id="feedstoreStockForm"
                        class="feedstore-form"
                        action="/dairy/<%= currentDairy._id %>/feedstore/restock"
                        method="POST"
                        enctype="multipart/form-data"
                    >


                        <input
                            id="selectedStockId"
                            type="hidden"
                            name="stockId"
                            value=""
                        >



                        <!-- ==================================================
                             STOCK CATEGORY
                        =================================================== -->

                        <div class="feedstore-field">


                            <label for="stockCategory">
                                Stock type
                            </label>


                            <select
                                id="stockCategory"
                                name="category"
                                required
                            >


                                <option value="">
                                    Select stock type
                                </option>


                                <option value="feed">
                                    Animal Feed
                                </option>


                                <option value="medicine">
                                    Veterinary Medicine
                                </option>


                            </select>


                            <% if (isDairyWorker) { %>

                                <small>
                                    Stock type comes from the selected
                                    database record.
                                </small>

                            <% } %>


                        </div>



                        <!-- ==================================================
                             FEED
                        =================================================== -->

                        <div
                            class="feedstore-field"
                            id="feedTypeField"
                        >


                            <label for="feedType">
                                Animal feed
                            </label>


                            <select
                                id="feedType"
                                name="feedName"
                            >


                                <option value="">
                                    Select animal feed
                                </option>


                                <% availableFeedTypes.forEach(
                                    function(type)
                                { %>


                                    <option value="<%= type %>">
                                        <%= type %>
                                    </option>


                                <% }); %>


                            </select>


                        </div>



                        <!-- ==================================================
                             MEDICINE
                        =================================================== -->

                        <div
                            class="feedstore-field"
                            id="medicineTypeField"
                            hidden
                        >


                            <label for="medicineType">
                                Veterinary medicine
                            </label>


                            <select
                                id="medicineType"
                                name="medicineName"
                            >


                                <option value="">
                                    Select veterinary medicine
                                </option>


                                <% availableMedicineTypes.forEach(
                                    function(type)
                                { %>


                                    <option value="<%= type %>">
                                        <%= type %>
                                    </option>


                                <% }); %>


                            </select>


                        </div>



                        <!-- ==================================================
                             QUANTITY + UNIT
                        =================================================== -->

                        <div class="feedstore-two-columns">


                            <div class="feedstore-field">


                                <label for="stockQuantity">

                                    <%= isAdmin
                                        ? "Quantity"
                                        : "Quantity Remaining"
                                    %>

                                </label>


                                <input
                                    id="stockQuantity"
                                    type="number"
                                    name="quantity"
                                    min="0"
                                    step="0.01"
                                    placeholder="<%= isAdmin ? "Enter quantity" : "Enter quantity remaining" %>"
                                    required
                                >


                                <% if (isDairyWorker) { %>


                                    <small
                                        id="workerQuantityHelp"
                                    >

                                        Current database remainder:
                                        <strong id="workerCurrentQuantity">
                                            0
                                        </strong>

                                        <br>

                                        You cannot report a quantity
                                        greater than the current
                                        database remainder.

                                    </small>


                                <% } %>


                            </div>



                            <div class="feedstore-field">


                                <label for="stockUnit">
                                    Unit
                                </label>


                                <select
                                    id="stockUnit"
                                    name="unit"
                                    required
                                >


                                    <option value="">
                                        Select unit
                                    </option>


                                    <% availableStockUnits.forEach(
                                        function(unit)
                                    { %>


                                        <option value="<%= unit %>">
                                            <%= unit %>
                                        </option>


                                    <% }); %>


                                </select>


                                <% if (isDairyWorker) { %>


                                    <small>
                                        Unit comes from the selected
                                        stock record.
                                    </small>


                                <% } %>


                            </div>


                        </div>



                        <!-- ==================================================
                             ADMIN PRICE
                        =================================================== -->

                        <% if (isAdmin) { %>


                            <div class="feedstore-field">


                                <label for="stockPrice">
                                    Price / value
                                </label>


                                <div class="feedstore-money">


                                    <span>
                                        KES
                                    </span>


                                    <input
                                        id="stockPrice"
                                        type="number"
                                        name="price"
                                        min="0"
                                        step="0.01"
                                        placeholder="Enter value"
                                    >


                                </div>


                                <small>
                                    Financial information is visible
                                    to administrators only.
                                </small>


                            </div>


                        <% } %>



                        <!-- ==================================================
                             ADMIN INSTRUCTIONS
                        =================================================== -->

                        <% if (isAdmin) { %>


                            <div class="feedstore-field">


                                <label for="stockInstructions">
                                    Instructions of use
                                </label>


                                <textarea
                                    id="stockInstructions"
                                    name="instructions"
                                    rows="4"
                                    maxlength="1500"
                                    placeholder="How should this feed or medicine be used?"
                                ></textarea>


                            </div>



                            <div class="feedstore-field">


                                <label for="expectedDuration">
                                    Expected duration of consumption
                                </label>


                                <input
                                    id="expectedDuration"
                                    type="text"
                                    name="expectedDuration"
                                    maxlength="100"
                                    placeholder="e.g. Approximately 14 days"
                                >


                            </div>


                        <% } %>



                        <!-- ==================================================
                             ADDITIONAL INFORMATION
                        =================================================== -->

                        <div class="feedstore-field">


                            <label for="stockMessage">
                                Additional information
                            </label>


                            <textarea
                                id="stockMessage"
                                name="message"
                                rows="4"
                                maxlength="1500"
                                placeholder="Add useful information about this stock update..."
                            ></textarea>


                        </div>



                        <!-- ==================================================
                             PHOTOS
                        =================================================== -->

                        <div class="feedstore-field">


                            <label for="stockImages">
                                Photos
                            </label>


                            <input
                                id="stockImages"
                                type="file"
                                name="images"
                                accept="image/*"
                                multiple
                            >


                            <small>
                                Add photos related to this stock update.
                            </small>


                        </div>



                        <!-- ==================================================
                             SUBMIT
                        =================================================== -->

                        <button
                            id="feedstoreSubmit"
                            type="submit"
                            class="
                                feedstore-submit
                                <%= isAdmin
                                    ? "admin-submit"
                                    : "worker-submit"
                                %>
                            "
                        >


                            <span
                                id="feedstoreSubmitIcon"
                                aria-hidden="true"
                            >

                                <%= isAdmin
                                    ? "➕"
                                    : "📦"
                                %>

                            </span>


                            <span id="feedstoreSubmitText">

                                <%= isAdmin
                                    ? "Add Stock"
                                    : "Update Remaining Stock"
                                %>

                            </span>


                        </button>


                    </form>


                </div>


            </section>


        <% } %>



        <!-- ==================================================
             HISTORY
        =================================================== -->

        <section
            class="feedstore-tab-panel"
            data-panel="foodstock-updates"
        >


            <div class="feedstore-section">


                <div class="feedstore-section-header">


                    <div>

                        <h2>
                            Foodstock Updates
                        </h2>


                        <p>
                            Stock additions and remaining-stock
                            reports recorded for this dairy.
                        </p>

                    </div>


                </div>



                <% if (feedStoreUpdates.length > 0) { %>


                    <div class="feedstore-feed">


                        <% feedStoreUpdates.forEach(
                            function(item)
                        { %>


                            <%- include(
                                "stock",
                                {
                                    item: item,
                                    dairy: currentDairy,
                                    user: currentUser
                                }
                            ) %>


                        <% }); %>


                    </div>


                <% } else { %>


                    <div class="feedstore-empty">


                        <div
                            class="feedstore-empty-icon"
                            aria-hidden="true"
                        >
                            📦
                        </div>


                        <h3>
                            No foodstock updates yet
                        </h3>


                        <p>
                            Stock additions and remaining-stock
                            reports will appear here.
                        </p>


                    </div>


                <% } %>


            </div>


        </section>


    </main>


</div>



<script>

document.addEventListener(
    "DOMContentLoaded",
    function () {


        /* ======================================================
           ELEMENTS
        ======================================================= */

        const tabs =
            document.querySelectorAll(
                ".feedstore-tab"
            );


        const panels =
            document.querySelectorAll(
                ".feedstore-tab-panel"
            );


        const stockCards =
            document.querySelectorAll(
                ".feedstore-stock-card--clickable"
            );


        const category =
            document.getElementById(
                "stockCategory"
            );


        const feedField =
            document.getElementById(
                "feedTypeField"
            );


        const medicineField =
            document.getElementById(
                "medicineTypeField"
            );


        const feedSelect =
            document.getElementById(
                "feedType"
            );


        const medicineSelect =
            document.getElementById(
                "medicineType"
            );


        const form =
            document.getElementById(
                "feedstoreStockForm"
            );


        const selectedStockId =
            document.getElementById(
                "selectedStockId"
            );


        const stockQuantity =
            document.getElementById(
                "stockQuantity"
            );


        const stockUnit =
            document.getElementById(
                "stockUnit"
            );


        const stockPrice =
            document.getElementById(
                "stockPrice"
            );


        const stockInstructions =
            document.getElementById(
                "stockInstructions"
            );


        const expectedDuration =
            document.getElementById(
                "expectedDuration"
            );


        const stockMessage =
            document.getElementById(
                "stockMessage"
            );


        const stockImages =
            document.getElementById(
                "stockImages"
            );


        const selectedStockSummary =
            document.getElementById(
                "selectedStockSummary"
            );


        const selectedStockName =
            document.getElementById(
                "selectedStockName"
            );


        const selectedStockCurrent =
            document.getElementById(
                "selectedStockCurrent"
            );


        const selectedStockIcon =
            document.getElementById(
                "selectedStockIcon"
            );


        const restockHeading =
            document.getElementById(
                "restockHeading"
            );


        const restockDescription =
            document.getElementById(
                "restockDescription"
            );


        const submitText =
            document.getElementById(
                "feedstoreSubmitText"
            );


        const submitIcon =
            document.getElementById(
                "feedstoreSubmitIcon"
            );


        const workerCurrentQuantity =
            document.getElementById(
                "workerCurrentQuantity"
            );



        /* ======================================================
           ROLE
        ======================================================= */

        const isAdmin =
            <%= isAdmin %>;


        const isDairyWorker =
            <%= isDairyWorker %>;



        /* ======================================================
           SELECTED DATABASE QUANTITY
        ======================================================= */

        let selectedDatabaseQuantity;



        /* ======================================================
           TAB ACTIVATION
        ======================================================= */

        function activateTab(
            tabName,
            shouldScroll
        ) {


            tabs.forEach(
                function(tab) {


                    const isActive =
                        tab.dataset.tab === tabName;


                    tab.classList.toggle(
                        "active",
                        isActive
                    );


                    tab.setAttribute(
                        "aria-selected",
                        isActive
                            ? "true"
                            : "false"
                    );


                }
            );


            panels.forEach(
                function(panel) {


                    const isActive =
                        panel.dataset.panel === tabName;


                    panel.classList.toggle(
                        "active",
                        isActive
                    );


                }
            );


            if (shouldScroll) {

                window.scrollTo({

                    top: 0,

                    behavior: "smooth"

                });

            }

        }



        tabs.forEach(
            function(tab) {


                tab.addEventListener(
                    "click",
                    function() {


                        activateTab(
                            tab.dataset.tab,
                            true
                        );


                    }
                );


            }
        );



        /* ======================================================
           CATEGORY SWITCHER
        ======================================================= */

        function updateStockType() {


            const value =
                category.value;


            if (value === "medicine") {


                feedField.hidden =
                    true;


                medicineField.hidden =
                    false;


                feedSelect.required =
                    false;


                medicineSelect.required =
                    !selectedStockId.value;


            } else {


                feedField.hidden =
                    false;


                medicineField.hidden =
                    true;


                feedSelect.required =
                    value === "feed" &&
                    !selectedStockId.value;


                medicineSelect.required =
                    false;

            }

        }



        category.addEventListener(
            "change",
            updateStockType
        );



        /* ======================================================
           PREPARE NEW STOCK
        ======================================================= */

        function prepareNewStockForm() {


            if (!isAdmin) {

                return;

            }


            form.reset();


            selectedStockId.value =
                "";


            selectedDatabaseQuantity =
                undefined;


            selectedStockSummary.hidden =
                true;


            restockHeading.textContent =
                "Add / Restock Stock";


            restockDescription.textContent =
                "Record newly available animal feed or veterinary medicine.";


            submitText.textContent =
                "Add Stock";


            submitIcon.textContent =
                "➕";


            stockQuantity.removeAttribute(
                "max"
            );


            stockQuantity.value =
                "";


            stockUnit.disabled =
                false;


            stockImages.value =
                "";


            updateStockType();

        }



        /* ======================================================
           OPEN EXISTING STOCK
        ======================================================= */

        function openExistingStock(
            card
        ) {


            const stockId =
                card.dataset.stockId;


            const stockName =
                card.dataset.stockName;


            const quantity =
                Number(
                    card.dataset.stockQuantity
                );


            const unit =
                card.dataset.stockUnit;


            const stockType =
                card.dataset.stockType;


            const price =
                Number(
                    card.dataset.stockPrice
                );


            selectedDatabaseQuantity =
                quantity;


            selectedStockId.value =
                stockId;


            selectedStockSummary.hidden =
                false;


            selectedStockName.textContent =
                stockName;


            selectedStockCurrent.textContent =
                "Current remainder: " +
                quantity.toLocaleString() +
                " " +
                unit;


            selectedStockIcon.textContent =
                stockType === "medicine"
                    ? "💊"
                    : "🌾";


            category.value =
                stockType;


            category.disabled =
                isDairyWorker;


            feedSelect.required =
                false;


            medicineSelect.required =
                false;


            /*
            --------------------------------------------------
            EXISTING DATABASE QUANTITY

            Directly loaded into the form.

            No zero fallback.
            --------------------------------------------------
            */

            stockQuantity.value =
                String(
                    quantity
                );


            if (isDairyWorker) {

                stockQuantity.max =
                    String(
                        quantity
                    );

            } else {

                stockQuantity.removeAttribute(
                    "max"
                );

            }


            stockUnit.value =
                unit;


            stockUnit.disabled =
                isDairyWorker;


            if (isAdmin) {

                stockPrice.value =
                    String(
                        price
                    );

            }


            if (stockInstructions) {

                stockInstructions.value =
                    "";

            }


            if (expectedDuration) {

                expectedDuration.value =
                    "";

            }


            stockMessage.value =
                "";


            stockImages.value =
                "";


            if (workerCurrentQuantity) {

                workerCurrentQuantity.textContent =
                    quantity.toLocaleString();

            }


            restockHeading.textContent =
                isAdmin
                    ? "Restock / Update Stock"
                    : "Update Remaining Stock";


            restockDescription.textContent =
                isAdmin
                    ? "The selected stock has been loaded from the database. Edit the quantity or unit as required."
                    : "The selected stock has been loaded from the database. Enter the quantity currently remaining.";


            submitText.textContent =
                isAdmin
                    ? "Save Stock Update"
                    : "Update Remaining Stock";


            submitIcon.textContent =
                isAdmin
                    ? "💾"
                    : "📦";


            updateStockType();


            activateTab(
                "restock-stock",
                true
            );

        }



        /* ======================================================
           STOCK CARD CLICK
        ======================================================= */

        stockCards.forEach(
            function(card) {


                card.addEventListener(
                    "click",
                    function() {

                        openExistingStock(
                            card
                        );

                    }
                );


                card.addEventListener(
                    "keydown",
                    function(event) {


                        if (
                            event.key === "Enter" ||
                            event.key === " "
                        ) {


                            event.preventDefault();


                            openExistingStock(
                                card
                            );


                        }

                    }
                );


            }
        );



        /* ======================================================
           RESTOCK TAB
        ======================================================= */

        const restockTab =
            document.querySelector(
                '[data-tab="restock-stock"]'
            );


        if (restockTab) {


            restockTab.addEventListener(
                "click",
                function(event) {


                    if (isAdmin) {


                        if (
                            selectedStockId.value
                        ) {

                            return;

                        }


                        prepareNewStockForm();


                    }


                    if (isDairyWorker) {


                        if (
                            !selectedStockId.value
                        ) {


                            event.preventDefault();


                            activateTab(
                                "available-stock",
                                true
                            );


                            alert(
                                "Select an existing stock item first."
                            );


                        }

                    }


                }
            );


        }



        /* ======================================================
           WORKER QUANTITY LIMIT
        ======================================================= */

        if (isDairyWorker) {


            stockQuantity.addEventListener(
                "input",
                function() {


                    const entered =
                        Number(
                            stockQuantity.value
                        );


                    if (
                        entered >
                        selectedDatabaseQuantity
                    ) {


                        stockQuantity.value =
                            String(
                                selectedDatabaseQuantity
                            );


                        workerCurrentQuantity.textContent =
                            selectedDatabaseQuantity.toLocaleString();

                    }

                }
            );


        }



        /* ======================================================
           FORM SUBMISSION
        ======================================================= */

        form.addEventListener(
            "submit",
            function(event) {


                if (isDairyWorker) {


                    if (
                        !selectedStockId.value
                    ) {


                        event.preventDefault();


                        alert(
                            "Select an existing stock item before submitting."
                        );


                        return;

                    }


                    if (stockInstructions) {

                        stockInstructions.value =
                            "";

                    }


                    if (expectedDuration) {

                        expectedDuration.value =
                            "";

                    }


                    stockUnit.disabled =
                        false;


                    const oldHiddenUnit =
                        form.querySelector(
                            "#workerDatabaseUnit"
                        );


                    if (oldHiddenUnit) {

                        oldHiddenUnit.remove();

                    }


                    const hiddenUnit =
                        document.createElement(
                            "input"
                        );


                    hiddenUnit.type =
                        "hidden";


                    hiddenUnit.id =
                        "workerDatabaseUnit";


                    hiddenUnit.name =
                        "unit";


                    hiddenUnit.value =
                        stockUnit.value;


                    form.appendChild(
                        hiddenUnit
                    );


                    const entered =
                        Number(
                            stockQuantity.value
                        );


                    if (
                        entered >
                        selectedDatabaseQuantity
                    ) {


                        event.preventDefault();


                        stockQuantity.value =
                            String(
                                selectedDatabaseQuantity
                            );


                        stockQuantity.focus();


                        alert(
                            "A dairy worker cannot report a quantity greater than the current stock remainder."
                        );


                        return;

                    }


                    if (stockPrice) {

                        stockPrice.value =
                            "";

                    }


                    return;

                }


                if (isAdmin) {

                    return;

                }


                event.preventDefault();


                alert(
                    "You are not authorized to update foodstock."
                );


            }
        );



        /* ======================================================
           INITIAL CATEGORY
        ======================================================= */

        updateStockType();


    }
);

</script>