        border-radius: 14px;

        font-size: 23px;

    }


    .feedstore-intro h1 {

        font-size: 24px;

    }


    .feedstore-tabs {

        gap: 3px;

        padding: 4px;

    }


    .feedstore-tab {

        min-height: 43px;

        padding:
