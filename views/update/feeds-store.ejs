<% /*
=============================.===============================
FEED STORE PAGE

FILE:
    views/updates/feeds-store.ejs

ROUTE:
    GET /dairy/feedstore/:id

UPDATE ROUTE:
    POST /dairy/:id/feedstore/update

RESTOCK ROUTE:
    POST /dairy/:id/feedstore/restock

CONTROLLER CONTRACT
------------------------------------------------------------

updateFeedStore receives:

    message
    condition
    feedQuality
    percentageRemaining
    images[]

restockFeedStore receives:

    feedName
    amount
    cost
    unit
    description

IMPORTANT:

    feedsAmount is NOT entered by the user.

    Backend/service calculates the aggregate value
    from the individual feed records.

============================================================
*/ %>


<% if (dairy && user) { %>


<div class="feedstore-page">


    <!-- ====================================================
         PAGE HEADER
    ===================================================== -->

    <header class="feedstore-header">

        <div class="feedstore-header__icon">
            🌾
        </div>

        <div class="feedstore-header__content">

            <div class="feedstore-header__eyebrow">
                FEED STORE
            </div>

            <h1>
                Food Stock
            </h1>

            <p>
                Manage food stock and report the condition of
                <strong><%= dairy.name %></strong>.
            </p>

        </div>

    </header>



    <!-- ====================================================
         STORE SUMMARY
    ===================================================== -->

    <section class="feedstore-summary">


        <!-- =================================================
             TOTAL FEED VALUE
        ================================================== -->

        <article class="feedstore-total-card">

            <div class="feedstore-total-card__label">
                Total Food Stock Value
            </div>

            <div class="feedstore-total-card__amount">

                <span class="feedstore-currency">
                    KES
                </span>

                <strong>
                    <%= Number(
                        dairy.feedsAmount || 0
                    ).toLocaleString() %>
                </strong>

            </div>

            <div class="feedstore-total-card__note">
                Combined value of all food stock
            </div>

        </article>



        <!-- =================================================
             FACILITY
        ================================================== -->

        <article class="feedstore-info-card">

            <div class="feedstore-info-card__label">
                Facility
            </div>

            <div class="feedstore-info-card__name">
                <%= dairy.name %>
            </div>

            <div class="feedstore-info-card__meta">
                Structure · Feed Store
            </div>

        </article>


    </section>



    <!-- ====================================================
         CURRENT FOOD STOCK
    ===================================================== -->

    <section class="feedstore-section">


        <div class="feedstore-section-heading">

            <div>

                <h2>
                    Current Food Stock
                </h2>

                <p>
                    Financial value currently assigned to each
                    feed category.
                </p>

            </div>

        </div>



        <% if (
            Array.isArray(dairy.feeds) &&
            dairy.feeds.length > 0
        ) { %>


            <div class="feedstore-inventory">


                <% dairy.feeds.forEach(function(feed) { %>

                    <article class="feedstock-row">


                        <div class="feedstock-row__identity">

                            <div class="feedstock-row__icon">
                                🌾
                            </div>

                            <div>

                                <div class="feedstock-row__name">
                                    <%= feed.name || "Unnamed Feed" %>
                                </div>

                                <div class="feedstock-row__label">

                                    <% if (feed.unit) { %>

                                        Unit:
                                        <%= feed.unit %>

                                    <% } else { %>

                                        Current stock value

                                    <% } %>

                                </div>

                            </div>

                        </div>



                        <div class="feedstock-row__amount">

                            <span>
                                KES
                            </span>

                            <strong>
                                <%= Number(
                                    feed.amount || 0
                                ).toLocaleString() %>
                            </strong>

                        </div>


                    </article>

                <% }); %>


            </div>


        <% } else { %>


            <div class="feedstore-empty">

                <div class="feedstore-empty__icon">
                    🌾
                </div>

                <h3>
                    No food stock recorded
                </h3>

                <p>
                    No feed categories have been added to this
                    feed store yet.
                </p>

                <% if (user.role === "admin") { %>

                    <p class="feedstore-empty__admin-note">
                        Use the restocking section below to add
                        the first food stock category.
                    </p>

                <% } %>

            </div>


        <% } %>


    </section>



    <!-- ====================================================
         STORE CONDITION REPORT
    ===================================================== -->

    <section class="feedstore-section">


        <div class="feedstore-section-heading">

            <div>

                <h2>
                    Store Condition
                </h2>

                <p>
                    Report the condition of the facility,
                    feed quality and remaining stock.
                </p>

            </div>

        </div>



        <form
            class="feedstore-report-card"
            action="/dairy/<%= dairy._id %>/feedstore/update"
            method="POST"
            enctype="multipart/form-data"
        >


            <!-- =============================================
                 FACILITY CONDITION
            ============================================== -->

            <div class="feedstore-field">

                <label for="feedstoreCondition">
                    Facility condition
                </label>

                <select
                    id="feedstoreCondition"
                    name="condition"
                >

                    <option value="">
                        Select condition
                    </option>

                    <option value="excellent">
                        Excellent
                    </option>

                    <option value="good">
                        Good
                    </option>

                    <option value="fair">
                        Fair
                    </option>

                    <option value="poor">
                        Poor
                    </option>

                    <option value="critical">
                        Critical
                    </option>

                </select>

            </div>



            <!-- =============================================
                 FEED QUALITY
            ============================================== -->

            <div class="feedstore-field">

                <label for="feedQuality">
                    Feed quality
                </label>

                <select
                    id="feedQuality"
                    name="feedQuality"
                >

                    <option value="">
                        Select feed quality
                    </option>

                    <option value="excellent">
                        Excellent
                    </option>

                    <option value="good">
                        Good
                    </option>

                    <option value="fair">
                        Fair
                    </option>

                    <option value="poor">
                        Poor
                    </option>

                    <option value="spoiled">
                        Spoiled / Unusable
                    </option>

                </select>

            </div>



            <!-- =============================================
                 PERCENTAGE REMAINING
            ============================================== -->

            <div class="feedstore-field">

                <label for="percentageRemaining">
                    Estimated food remaining
                </label>

                <div class="feedstore-percentage-input">

                    <input
                        id="percentageRemaining"
                        type="number"
                        name="percentageRemaining"
                        min="0"
                        max="100"
                        step="1"
                        placeholder="0"
                    >

                    <span>
                        %
                    </span>

                </div>

                <div class="feedstore-field__hint">
                    Estimate the percentage of the total food
                    stock that remains in the store.
                </div>

            </div>



            <!-- =============================================
                 REPORT MESSAGE
            ============================================== -->

            <div class="feedstore-field">

                <label for="feedstoreMessage">
                    Report
                </label>

                <textarea
                    id="feedstoreMessage"
                    name="message"
                    rows="6"
                    maxlength="1000"
                    placeholder="Describe the condition of the feed store, feed quality, storage conditions, damage, moisture, deterioration or anything important..."
                    required
                ></textarea>

            </div>



            <!-- =============================================
                 IMAGES
            ============================================== -->

            <div class="feedstore-field">

                <label for="feedstoreImages">
                    Photos
                </label>

                <input
                    id="feedstoreImages"
                    type="file"
                    name="images"
                    accept="image/*"
                    multiple
                >

                <div class="feedstore-field__hint">
                    You may attach up to 10 photos.
                </div>

            </div>



            <!-- =============================================
                 SUBMIT
            ============================================== -->

            <button
                type="submit"
                class="feedstore-primary-button"
            >

                <span>
                    📤
                </span>

                Submit Store Report

            </button>


        </form>


    </section>



    <!-- ====================================================
         ADMIN RESTOCKING
    ===================================================== -->

    <% if (user.role === "admin") { %>


    <section class="feedstore-section feedstore-admin-section">


        <div class="feedstore-section-heading">

            <div>

                <div class="feedstore-admin-badge">
                    ADMIN
                </div>

                <h2>
                    Restock Food
                </h2>

                <p>
                    Add value to an existing feed category or
                    create a new one.
                </p>

            </div>

        </div>



        <form
            class="feedstore-restock-card"
            action="/dairy/<%= dairy._id %>/feedstore/restock"
            method="POST"
        >


            <!-- =============================================
                 FEED NAME
            ============================================== -->

            <div class="feedstore-field">

                <label for="feedName">
                    Feed category
                </label>

                <input
                    id="feedName"
                    type="text"
                    name="feedName"
                    list="existingFeedCategories"
                    maxlength="100"
                    placeholder="e.g. Fodder, Silage, Hay, Dairy Meal"
                    required
                >


                <datalist id="existingFeedCategories">

                    <% if (
                        Array.isArray(dairy.feeds)
                    ) { %>

                        <% dairy.feeds.forEach(function(feed) { %>

                            <% if (feed.name) { %>

                                <option
                                    value="<%= feed.name %>"
                                >

                            <% } %>

                        <% }); %>

                    <% } %>

                </datalist>


                <div class="feedstore-field__hint">
                    Enter an existing feed category to restock
                    it, or enter a new category name.
                </div>

            </div>



            <!-- =============================================
                 AMOUNT
            ============================================== -->

            <div class="feedstore-field">

                <label for="restockAmount">
                    Stock amount
                </label>

                <div class="feedstore-money-input">

                    <span>
                        KES
                    </span>

                    <input
                        id="restockAmount"
                        type="number"
                        name="amount"
                        min="0"
                        step="0.01"
                        placeholder="0.00"
                        required
                    >

                </div>

                <div class="feedstore-field__hint">
                    Financial value being added to this feed
                    category.
                </div>

            </div>



            <!-- =============================================
                 COST
            ============================================== -->

            <div class="feedstore-field">

                <label for="restockCost">
                    Purchase cost
                </label>

                <div class="feedstore-money-input">

                    <span>
                        KES
                    </span>

                    <input
                        id="restockCost"
                        type="number"
                        name="cost"
                        min="0"
                        step="0.01"
                        placeholder="0.00"
                    >

                </div>

                <div class="feedstore-field__hint">
                    Cost associated with this restocking.
                </div>

            </div>



            <!-- =============================================
                 UNIT
            ============================================== -->

            <div class="feedstore-field">

                <label for="restockUnit">
                    Unit
                </label>

                <input
                    id="restockUnit"
                    type="text"
                    name="unit"
                    maxlength="30"
                    placeholder="e.g. kg, bags, tonnes"
                >

            </div>



            <!-- =============================================
                 DESCRIPTION
            ============================================== -->

            <div class="feedstore-field">

                <label for="restockDescription">
                    Restocking note
                </label>

                <textarea
                    id="restockDescription"
                    name="description"
                    rows="4"
                    maxlength="1000"
                    placeholder="Optional note about this restocking..."
                ></textarea>

            </div>



            <!-- =============================================
                 SUBMIT
            ============================================== -->

            <button
                type="submit"
                class="feedstore-admin-button"
            >

                <span>
                    ➕
                </span>

                Restock Food

            </button>


        </form>


    </section>


    <% } %>



    <!-- ====================================================
         RECENT FEED STORE REPORTS
    ===================================================== -->

    <% if (
        Array.isArray(updates) &&
        updates.length > 0
    ) { %>


    <section class="feedstore-section">


        <div class="feedstore-section-heading">

            <div>

                <h2>
                    Recent Reports
                </h2>

                <p>
                    Recent observations submitted for this
                    feed store.
                </p>

            </div>

        </div>



        <div class="feedstore-updates">


            <% updates.forEach(function(update) { %>


            <article class="feedstore-update-card">


                <!-- =========================================
                     UPDATE HEADER
                ========================================== -->

                <div class="feedstore-update-header">


                    <div class="feedstore-update-avatar">

                        <% if (update.userImage) { %>

                            <img
                                src="<%= update.userImage %>"
                                alt=""
                                loading="lazy"
                            >

                        <% } else if (
                            update.user &&
                            update.user.profileImage
                        ) { %>

                            <img
                                src="<%= update.user.profileImage %>"
                                alt=""
                                loading="lazy"
                            >

                        <% } else { %>

                            <span>
                                👤
                            </span>

                        <% } %>

                    </div>



                    <div class="feedstore-update-author">

                        <strong>

                            <%= update.userName ||
                                (
                                    update.user &&
                                    update.user.name
                                ) ||
                                "User" %>

                        </strong>

                        <span>

                            <%= update.createdAt
                                ? new Date(
                                    update.createdAt
                                ).toLocaleString()
                                : "" %>

                        </span>

                    </div>


                </div>



                <!-- =========================================
                     REPORT DETAILS
                ========================================== -->

                <div class="feedstore-update-details">


                    <% if (update.condition) { %>

                        <span class="feedstore-report-tag">

                            Condition:
                            <%= update.condition %>

                        </span>

                    <% } %>


                    <% if (update.feedQuality) { %>

                        <span class="feedstore-report-tag">

                            Feed:
                            <%= update.feedQuality %>

                        </span>

                    <% } %>


                    <% if (
                        update.percentageRemaining !==
                        undefined &&
                        update.percentageRemaining !==
                        null &&
                        update.percentageRemaining !== ""
                    ) { %>

                        <span class="feedstore-report-tag">

                            Remaining:
                            <%= update.percentageRemaining %>%

                        </span>

                    <% } %>


                </div>



                <!-- =========================================
                     UPDATE TEXT
                ========================================== -->

                <% if (update.text) { %>

                    <div class="feedstore-update-message">

                        <%= update.text %>

                    </div>

                <% } else if (update.message) { %>

                    <div class="feedstore-update-message">

                        <%= update.message %>

                    </div>

                <% } %>



                <!-- =========================================
                     UPDATE IMAGES
                ========================================== -->

                <% if (
                    Array.isArray(update.images) &&
                    update.images.length > 0
                ) { %>


                    <div class="feedstore-update-images">


                        <% update.images.forEach(function(image) { %>

                            <% if (image) { %>

                                <img
                                    src="<%= image %>"
                                    alt="Feed store report"
                                    loading="lazy"
                                >

                            <% } %>

                        <% }); %>


                    </div>


                <% } %>


            </article>


            <% }); %>


        </div>


    </section>


    <% } %>


</div>


<% } %>



<style>

/* ==========================================================
   FEED STORE PAGE
========================================================== */

.feedstore-page {

    width: 100%;

    max-width: 1100px;

    margin: 0 auto;

    padding: 18px 0 50px;

    color: #26322b;

    box-sizing: border-box;

}


.feedstore-page *,
.feedstore-page *::before,
.feedstore-page *::after {

    box-sizing: border-box;

}



/* ==========================================================
   HEADER
========================================================== */

.feedstore-header {

    display: flex;

    align-items: center;

    gap: 18px;

    margin-bottom: 26px;

    padding: 4px;

}


.feedstore-header__icon {

    width: 64px;

    height: 64px;

    flex: 0 0 64px;

    display: flex;

    align-items: center;

    justify-content: center;

    border-radius: 18px;

    background:
        linear-gradient(
            145deg,
            #198754,
            #14532d
        );

    color: #ffffff;

    font-size: 30px;

    box-shadow:
        0 8px 20px
        rgba(25, 135, 84, .16);

}


.feedstore-header__eyebrow {

    margin-bottom: 3px;

    color: #198754;

    font-size: 11px;

    font-weight: 800;

    letter-spacing: 1.4px;

}


.feedstore-header h1 {

    margin: 0;

    color: #14532d;

    font-size: 34px;

    font-weight: 800;

    line-height: 1.1;

}


.feedstore-header p {

    max-width: 720px;

    margin: 7px 0 0;

    color: #66736b;

    font-size: 14px;

    line-height: 1.5;

}


.feedstore-header p strong {

    color: #198754;

}



/* ==========================================================
   SUMMARY
========================================================== */

.feedstore-summary {

    display: grid;

    grid-template-columns:
        minmax(0, 1.4fr)
        minmax(220px, .8fr);

    gap: 14px;

    margin-bottom: 30px;

}


.feedstore-total-card,
.feedstore-info-card {

    min-height: 145px;

    padding: 22px;

    border: 1px solid #dce7e0;

    border-radius: 18px;

    background:
        linear-gradient(
            145deg,
            #ffffff,
            #f5faf7
        );

}


.feedstore-total-card {

    border-color: #cfe3d6;

}


.feedstore-total-card__label,
.feedstore-info-card__label {

    color: #718078;

    font-size: 12px;

    font-weight: 700;

    text-transform: uppercase;

    letter-spacing: .7px;

}


.feedstore-total-card__amount {

    display: flex;

    align-items: baseline;

    gap: 7px;

    margin-top: 12px;

    color: #14532d;

}


.feedstore-currency {

    font-size: 15px;

    font-weight: 700;

}


.feedstore-total-card__amount strong {

    font-size: 31px;

    font-weight: 800;

}


.feedstore-total-card__note {

    margin-top: 9px;

    color: #8a928d;

    font-size: 12px;

}


.feedstore-info-card__name {

    margin-top: 15px;

    color: #26322b;

    font-size: 21px;

    font-weight: 800;

}


.feedstore-info-card__meta {

    margin-top: 6px;

    color: #198754;

    font-size: 12px;

    font-weight: 700;

}



/* ==========================================================
   SECTIONS
========================================================== */

.feedstore-section {

    margin-top: 30px;

}


.feedstore-section-heading {

    display: flex;

    align-items: flex-end;

    justify-content: space-between;

    gap: 15px;

    margin-bottom: 14px;

}


.feedstore-section-heading h2 {

    margin: 0;

    color: #14532d;

    font-size: 22px;

    font-weight: 800;

}


.feedstore-section-heading p {

    margin: 5px 0 0;

    color: #718078;

    font-size: 13px;

    line-height: 1.45;

}



/* ==========================================================
   INVENTORY
========================================================== */

.feedstore-inventory {

    display: flex;

    flex-direction: column;

    gap: 9px;

}


.feedstock-row {

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 15px;

    min-height: 72px;

    padding: 12px 15px;

    border: 1px solid #e0e9e3;

    border-radius: 13px;

    background: #ffffff;

}


.feedstock-row__identity {

    display: flex;

    align-items: center;

    gap: 12px;

    min-width: 0;

}


.feedstock-row__icon {

    width: 42px;

    height: 42px;

    flex: 0 0 42px;

    display: flex;

    align-items: center;

    justify-content: center;

    border-radius: 12px;

    background: #edf7f0;

    font-size: 19px;

}


.feedstock-row__name {

    overflow: hidden;

    color: #26322b;

    font-size: 14px;

    font-weight: 800;

    text-overflow: ellipsis;

    white-space: nowrap;

}


.feedstock-row__label {

    margin-top: 3px;

    color: #8a928d;

    font-size: 11px;

}


.feedstock-row__amount {

    flex-shrink: 0;

    color: #718078;

    font-size: 11px;

    font-weight: 700;

}


.feedstock-row__amount strong {

    margin-left: 3px;

    color: #198754;

    font-size: 16px;

}



/* ==========================================================
   EMPTY
========================================================== */

.feedstore-empty {

    padding: 35px 20px;

    border: 1px dashed #cbdcd1;

    border-radius: 16px;

    background: #f8fbf9;

    text-align: center;

}


.feedstore-empty__icon {

    font-size: 30px;

}


.feedstore-empty h3 {

    margin: 10px 0 5px;

    color: #26322b;

    font-size: 17px;

}


.feedstore-empty p {

    max-width: 500px;

    margin: 0 auto;

    color: #7a857e;

    font-size: 13px;

    line-height: 1.5;

}


.feedstore-empty__admin-note {

    margin-top: 8px !important;

    color: #198754 !important;

    font-weight: 600;

}



/* ==========================================================
   FORMS
========================================================== */

.feedstore-report-card,
.feedstore-restock-card {

    padding: 20px;

    border: 1px solid #dce7e0;

    border-radius: 17px;

    background: #ffffff;

}


.feedstore-restock-card {

    border-color: #cfe3d6;

    background:
        linear-gradient(
            145deg,
            #ffffff,
            #f6faf7
        );

}


.feedstore-field {

    display: flex;

    flex-direction: column;

    gap: 7px;

    margin-bottom: 16px;

}


.feedstore-field label {

    color: #344139;

    font-size: 12px;

    font-weight: 800;

}


.feedstore-field input,
.feedstore-field select,
.feedstore-field textarea {

    width: 100%;

    padding: 11px 12px;

    border: 1px solid #d7e2da;

    border-radius: 9px;

    outline: none;

    background: #ffffff;

    color: #26322b;

    font-family: inherit;

    font-size: 13px;

    transition:
        border-color .15s ease,
        box-shadow .15s ease;

}


.feedstore-field textarea {

    min-height: 110px;

    resize: vertical;

    line-height: 1.5;

}


.feedstore-field input:focus,
.feedstore-field select:focus,
.feedstore-field textarea:focus {

    border-color: #198754;

    box-shadow:
        0 0 0 3px
        rgba(25, 135, 84, .08);

}


.feedstore-field__hint {

    color: #89938d;

    font-size: 11px;

    line-height: 1.4;

}



/* ==========================================================
   PERCENTAGE
========================================================== */

.feedstore-percentage-input {

    display: flex;

    align-items: center;

    max-width: 220px;

    overflow: hidden;

    border: 1px solid #d7e2da;

    border-radius: 10px;

    background: #ffffff;

}


.feedstore-percentage-input:focus-within {

    border-color: #198754;

    box-shadow:
        0 0 0 3px
        rgba(25, 135, 84, .08);

}


.feedstore-percentage-input input {

    width: 100%;

    min-width: 0;

    padding: 13px;

    border: none;

    outline: none;

    background: transparent;

    color: #14532d;

    font-size: 22px;

    font-weight: 800;

}


.feedstore-percentage-input span {

    padding-right: 14px;

    color: #198754;

    font-size: 20px;

    font-weight: 800;

}



/* ==========================================================
   MONEY INPUT
========================================================== */

.feedstore-money-input {

    display: flex;

    align-items: center;

    overflow: hidden;

    border: 1px solid #d7e2da;

    border-radius: 9px;

    background: #ffffff;

}


.feedstore-money-input span {

    padding-left: 12px;

    color: #198754;

    font-size: 12px;

    font-weight: 800;

}


.feedstore-money-input input {

    border: none;

    box-shadow: none;

}


.feedstore-money-input:focus-within {

    border-color: #198754;

    box-shadow:
        0 0 0 3px
        rgba(25, 135, 84, .08);

}



/* ==========================================================
   BUTTONS
========================================================== */

.feedstore-primary-button,
.feedstore-admin-button {

    width: 100%;

    min-height: 45px;

    margin-top: 18px;

    padding: 11px 15px;

    display: flex;

    align-items: center;

    justify-content: center;

    gap: 8px;

    border: none;

