    font-weight: 800;

}


.feedstore-stock-info span {

    color: #87918b;

    font-size: 11px;

}



/* ==========================================================
   STOCK LEVEL
========================================================== */

.feedstore-stock-level {

    width: 190px;

    flex-shrink: 0;

}


.feedstore-stock-percentage {

    display: flex;

    align-items: baseline;

    justify-content: flex-end;

    gap: 5px;

    margin-bottom: 5px;

}


.feedstore-stock-percentage strong {

    color: #198754;

    font-size: 17px;

    font-weight: 850;

}


.feedstore-stock-percentage span {

    color: #748078;

    font-size: 10px;

}


.feedstore-progress {

    width: 100%;

    height: 7px;

    overflow: hidden;

    border-radius: 999px;

    background: #e7eee9;

}


.feedstore-progress-bar {

    height: 100%;

    border-radius: inherit;

    background: #198754;

}



/* ==========================================================
   EMPTY
========================================================== */

.feedstore-empty {

    padding: 35px 20px;

    border: 1px dashed #cbdcd1;

    border-radius: 15px;

    background: #f8fbf9;

