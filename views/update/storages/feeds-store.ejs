<%
/* ==========================================================
   FEED STORE
========================================================== */

const currentDairy = dairy || {};
const currentUser = user || {};

const isAdmin =
    currentUser.role === "admin";

const feedStoreItems =
    Array.isArray(currentDairy.feedStocks)
        ? currentDairy.feedStocks
        : [];

const availableFeedTypes =
    Array.isArray(feedTypes)
        ? feedTypes
        : [];

const availableMedicineTypes =
    Array.isArray(medicineTypes)
        ? medicineTypes
        : [];

const availableStockUnits =
    Array.isArray(stockUnits)
        ? stockUnits
        : [];


/* ==========================================================
   SAFE NUMBER
   Prevents NaN from ever reaching the page.
========================================================== */

function safeNumber(value) {

    const number = Number(value);

    return Number.isFinite(number)
        ? number
        : 0;

}


/* ==========================================================
   STOCK HELPERS
========================================================== */

function stockCategory(stock) {

    return String(
        stock.category || "feed"
    ).toLowerCase();

}


function stockName(stock) {

    return (
        stock.name ||
        stock.feedName ||
        stock.medicineName ||
        "Unnamed stock"
    );

}


function stockQuantity(stock) {

    return safeNumber(
        stock.quantityRemaining
    );

}


function stockUnit(stock) {

    return (
        stock.unit ||
        ""
    );

}


function stockPrice(stock) {

    return safeNumber(
        stock.price
    );

}

%>


<div
    class="feedstore"
    data-dairy-id="<%= currentDairy._id %>"
>


    <!-- ======================================================
         HEADER
    ======================================================= -->

    <div class="feedstore-header">

        <div>

            <span class="feedstore-eyebrow">
                DAIRY FOODSTOCK
            </span>

            <h1>
                Foodstock
            </h1>

            <p>
                Manage available animal feed and veterinary medicine.
            </p>

        </div>

    </div>



    <!-- ======================================================
         ADMIN COMPOSER
         
         ONLY ADMIN SEES THIS.
    ======================================================= -->

    <% if (isAdmin) { %>

        <button
            type="button"
            id="openAddStock"
            class="feedstore-composer"
        >

            <div class="composer-icon">
                ➕
            </div>

            <div class="composer-content">

                <strong>
                    Add stock
                </strong>

                <span>
                    Add animal feed or veterinary medicine
                </span>

            </div>

            <div class="composer-arrow">
                →
            </div>

        </button>

    <% } %>



    <!-- ======================================================
         AVAILABLE STOCK
    ======================================================= -->

    <section class="feedstore-stock-section">

        <div class="section-heading">

            <div>

                <span>
                    CURRENT INVENTORY
                </span>

                <h2>
                    Available Stock
                </h2>

            </div>

            <strong>
                <%= feedStoreItems.length %>
            </strong>

        </div>



        <% if (feedStoreItems.length) { %>


            <div class="stock-list">


                <% feedStoreItems.forEach(
                    function(stock)
                {

                    const id =
                        String(
                            stock._id || ""
                        );

                    const category =
                        stockCategory(stock);

                    const name =
                        stockName(stock);

                    const quantity =
                        stockQuantity(stock);

                    const unit =
                        stockUnit(stock);

                    const price =
                        stockPrice(stock);

                %>


                    <!-- ==================================================
                         CLICKABLE STOCK ITEM
                    =================================================== -->

                    <article
                        class="stock-item"
                        tabindex="0"
                        role="button"

                        data-stock-id="<%= id %>"
                        data-stock-name="<%= name %>"
                        data-stock-category="<%= category %>"
                        data-stock-quantity="<%= quantity %>"
                        data-stock-unit="<%= unit %>"
                        data-stock-price="<%= price %>"
                    >


                        <div class="stock-item-left">


                            <div class="stock-icon">

                                <% if (
                                    category === "medicine"
                                ) { %>

                                    💊

                                <% } else { %>

                                    🌾

                                <% } %>

                            </div>


                            <div class="stock-info">

                                <strong>
                                    <%= name %>
                                </strong>

                                <span>

                                    <%= category === "medicine"
                                        ? "Veterinary medicine"
                                        : "Animal feed"
                                    %>

                                </span>

                            </div>


                        </div>



                        <div class="stock-item-right">


                            <div class="stock-quantity">

                                <strong>
                                    <%= quantity.toLocaleString() %>
                                </strong>

                                <span>
                                    <%= unit %>
                                </span>

                            </div>


                            <span class="stock-arrow">
                                →
                            </span>


                        </div>


                    </article>


                <% }); %>


            </div>


        <% } else { %>


            <div class="empty-stock">

                <div>
                    📦
                </div>

                <strong>
                    No stock available
                </strong>

                <span>
                    <% if (isAdmin) { %>
                        Click "Add stock" above to create the first stock item.
                    <% } else { %>
                        No stock has been added yet.
                    <% } %>
                </span>

            </div>


        <% } %>


    </section>



</div>



<!-- ==========================================================
     MODAL
     
     Used for:
     
         ADMIN:
             Add stock
     
         ANY USER:
             Click existing stock
             → opens same modal
========================================================== -->

<div
    id="stockModal"
    class="stock-modal"
    hidden
>


    <div
        class="stock-modal-backdrop"
        data-close-modal
    ></div>



    <div
        class="stock-modal-dialog"
        role="dialog"
        aria-modal="true"
        aria-labelledby="stockModalTitle"
    >


        <!-- ==================================================
             MODAL HEADER
        =================================================== -->

        <div class="stock-modal-header">


            <div>

                <span
                    id="stockModalEyebrow"
                    class="modal-eyebrow"
                >
                    ADMIN
                </span>

                <h2 id="stockModalTitle">
                    Add Stock
                </h2>

                <p id="stockModalDescription">
                    Add animal feed or veterinary medicine.
                </p>

            </div>


            <button
                type="button"
                class="modal-close"
                data-close-modal
                aria-label="Close"
            >
                ×
            </button>


        </div>



        <!-- ==================================================
             FORM
        =================================================== -->

        <form
            id="stockForm"

            action="/dairy/<%= currentDairy._id %>/feedstore/restock"

            method="POST"

            enctype="multipart/form-data"
        >


            <!-- EXISTING STOCK ID -->

            <input
                type="hidden"
                id="stockId"
                name="stockId"
                value=""
            >



            <!-- ==================================================
                 STOCK CATEGORY
            =================================================== -->

            <div class="form-field">

                <label for="category">
                    Stock type
                </label>

                <select
                    id="category"
                    name="category"
                    required
                >

                    <option value="">
                        Select stock type
                    </option>

                    <option value="feed">
                        Animal Feed
                    </option>

                    <option value="medicine">
                        Veterinary Medicine
                    </option>

                </select>

            </div>



            <!-- ==================================================
                 FEED NAME
            =================================================== -->

            <div
                id="feedField"
                class="form-field"
            >

                <label for="feedName">
                    Animal feed
                </label>

                <select
                    id="feedName"
                    name="feedName"
                >

                    <option value="">
                        Select animal feed
                    </option>

                    <% availableFeedTypes.forEach(
                        function(type)
                    { %>

                        <option value="<%= type %>">
                            <%= type %>
                        </option>

                    <% }); %>

                </select>

            </div>



            <!-- ==================================================
                 MEDICINE NAME
            =================================================== -->

            <div
                id="medicineField"
                class="form-field"
                hidden
            >

                <label for="medicineName">
                    Veterinary medicine
                </label>

                <select
                    id="medicineName"
                    name="medicineName"
                >

                    <option value="">
                        Select veterinary medicine
                    </option>

                    <% availableMedicineTypes.forEach(
                        function(type)
                    { %>

                        <option value="<%= type %>">
                            <%= type %>
                        </option>

                    <% }); %>

                </select>

            </div>



            <!-- ==================================================
                 QUANTITY + UNIT
            =================================================== -->

            <div class="form-grid">


                <div class="form-field">

                    <label for="quantity">
                        Quantity
                    </label>

                    <input
                        id="quantity"
                        type="number"
                        name="quantity"
                        min="0"
                        step="0.01"
                        required
                    >

                    <small id="quantityHelp">
                        Enter the quantity being added.
                    </small>

                </div>



                <div class="form-field">

                    <label for="unit">
                        Unit
                    </label>

                    <select
                        id="unit"
                        name="unit"
                        required
                    >

                        <option value="">
                            Select unit
                        </option>

                        <% availableStockUnits.forEach(
                            function(unit)
                        { %>

                            <option value="<%= unit %>">
                                <%= unit %>
                            </option>

                        <% }); %>

                    </select>

                </div>


            </div>



            <!-- ==================================================
                 PRICE
                 
                 ADMIN ONLY
            =================================================== -->

            <% if (isAdmin) { %>

                <div
                    id="priceField"
                    class="form-field"
                >

                    <label for="price">
                        Price / Value
                    </label>

                    <div class="money-input">

                        <span>
                            KES
                        </span>

                        <input
                            id="price"
                            type="number"
                            name="price"
                            min="0"
                            step="0.01"
                        >

                    </div>

                </div>


                <!-- ==============================================
                     INSTRUCTIONS
                =============================================== -->

                <div
                    id="instructionsField"
                    class="form-field"
                >

                    <label for="instructions">
                        Instructions of use
                    </label>

                    <textarea
                        id="instructions"
                        name="instructions"
                        rows="3"
                        maxlength="1500"
                        placeholder="How should this stock be used?"
                    ></textarea>

                </div>



                <!-- ==============================================
                     EXPECTED DURATION
                =============================================== -->

                <div
                    id="durationField"
                    class="form-field"
                >

                    <label for="expectedDuration">
                        Expected duration
                    </label>

                    <input
                        id="expectedDuration"
                        type="text"
                        name="expectedDuration"
                        maxlength="100"
                        placeholder="e.g. Approximately 14 days"
                    >

                </div>

            <% } %>



            <!-- ==================================================
                 ADDITIONAL INFORMATION
            =================================================== -->

            <div class="form-field">

                <label for="message">
                    Additional information
                </label>

                <textarea
                    id="message"
                    name="message"
                    rows="3"
                    maxlength="1500"
                    placeholder="Add any useful information..."
                ></textarea>

            </div>



            <!-- ==================================================
                 PHOTOS
            =================================================== -->

            <div class="form-field">

                <label for="images">
                    Photos
                </label>

                <input
                    id="images"
                    type="file"
                    name="images"
                    accept="image/*"
                    multiple
                >

            </div>



            <!-- ==================================================
                 SUBMIT
            =================================================== -->

            <button
                type="submit"
                id="stockSubmit"
                class="stock-submit"
            >

                <span id="stockSubmitIcon">
                    ➕
                </span>

                <span id="stockSubmitText">
                    Add Stock
                </span>

            </button>


        </form>


    </div>

</div>



<style>

/* ==========================================================
   PAGE
========================================================== */

.feedstore {

    width: 100%;
    max-width: 900px;

    margin: 0 auto;

    padding: 15px 12px 50px;

    color: #26352d;

}


.feedstore * {

    box-sizing: border-box;

}


/* ==========================================================
   HEADER
========================================================== */

.feedstore-header {

    margin-bottom: 15px;

}


.feedstore-eyebrow {

    color: #198754;

    font-size: 9px;

    font-weight: 900;

    letter-spacing: 1px;

}


.feedstore-header h1 {

    margin: 3px 0;

    color: #123f29;

    font-size: 25px;

}


.feedstore-header p {

    margin: 0;

    color: #7a857e;

    font-size: 11px;

}


/* ==========================================================
   ADMIN COMPOSER
========================================================== */

.feedstore-composer {

    width: 100%;

    display: flex;

    align-items: center;

    gap: 12px;

    padding: 13px;

    margin-bottom: 18px;

    border: 1px solid #cfe3d6;

    border-radius: 13px;

    background: #ffffff;

    color: inherit;

    text-align: left;

    cursor: pointer;

    box-shadow:
        0 3px 12px
        rgba(23,65,43,.05);

    transition:
        transform .15s ease,
        border-color .15s ease,
        box-shadow .15s ease;

}


.feedstore-composer:hover {

    transform: translateY(-1px);

    border-color: #8fc5a4;

    box-shadow:
        0 6px 18px
        rgba(23,65,43,.09);

}


.composer-icon {

    width: 42px;
    height: 42px;

    display: flex;
    align-items: center;
    justify-content: center;

    flex-shrink: 0;

    border-radius: 11px;

    background: #e7f5ec;

    color: #198754;

    font-size: 20px;

}


.composer-content {

    min-width: 0;

    display: flex;

    flex-direction: column;

    gap: 2px;

}


.composer-content strong {

    color: #164f31;

    font-size: 13px;

}


.composer-content span {

    color: #7d8982;

    font-size: 10px;

}


.composer-arrow {

    margin-left: auto;

    color: #198754;

    font-size: 18px;

}


/* ==========================================================
   SECTION HEADING
========================================================== */

.section-heading {

    display: flex;

    align-items: center;
    justify-content: space-between;

    margin-bottom: 9px;

}


.section-heading span {

    color: #7d8982;

    font-size: 8px;

    font-weight: 900;

    letter-spacing: .8px;

}


.section-heading h2 {

    margin: 2px 0 0;

    color: #164f31;

    font-size: 18px;

}


.section-heading > strong {

    min-width: 28px;

    padding: 5px 8px;

    border-radius: 999px;

    background: #e8f5ed;

    color: #198754;

    font-size: 10px;

    text-align: center;

}


/* ==========================================================
   STOCK LIST
========================================================== */

.stock-list {

    display: flex;

    flex-direction: column;

    gap: 6px;

}


.stock-item {

    display: flex;

    align-items: center;
    justify-content: space-between;

    gap: 10px;

    padding: 11px;

    border: 1px solid #dce7e0;

    border-radius: 11px;

    background: #ffffff;

    cursor: pointer;

    outline: none;

    transition:
        transform .15s ease,
        border-color .15s ease,
        box-shadow .15s ease;

}


.stock-item:hover,
.stock-item:focus {

    transform: translateY(-1px);

    border-color: #94caaa;

    box-shadow:
        0 5px 14px
        rgba(23,65,43,.07);

}


.stock-item-left {

    display: flex;

    align-items: center;

    gap: 10px;

    min-width: 0;

}


.stock-icon {

    width: 38px;
    height: 38px;

    display: flex;

    align-items: center;
    justify-content: center;

    flex-shrink: 0;

    border-radius: 10px;

    background: #eef7f1;

    font-size: 17px;

}


.stock-info {

    display: flex;

    flex-direction: column;

    gap: 2px;

    min-width: 0;

}


.stock-info strong {

    overflow: hidden;

    color: #29362f;

    font-size: 13px;

    white-space: nowrap;

    text-overflow: ellipsis;

}


.stock-info span {

    color: #87918b;

    font-size: 9px;

}


.stock-item-right {

    display: flex;

    align-items: center;

    gap: 10px;

    flex-shrink: 0;

}


.stock-quantity {

    display: flex;

    align-items: baseline;

    gap: 4px;

}


.stock-quantity strong {

    color: #198754;

    font-size: 16px;

}


.stock-quantity span {

    color: #7a857e;

    font-size: 9px;

}


.stock-arrow {

    color: #198754;

    font-size: 16px;

}


/* ==========================================================
   EMPTY
========================================================== */

.empty-stock {

    display: flex;

    align-items: center;

    flex-direction: column;

    gap: 5px;

    padding: 30px 15px;

    border: 1px dashed #cbdcd1;

    border-radius: 12px;

    background: #f8fbf9;

    text-align: center;

}


.empty-stock div {

    font-size: 25px;

}


.empty-stock strong {

    color: #334039;

    font-size: 14px;

}


.empty-stock span {

    color: #818c85;

    font-size: 10px;

}


/* ==========================================================
   MODAL
========================================================== */

.stock-modal {

    position: fixed;

    inset: 0;

    z-index: 9999;

    display: flex;

    align-items: center;

    justify-content: center;

    padding: 15px;

}


.stock-modal[hidden] {

    display: none;

}


.stock-modal-backdrop {

    position: absolute;

    inset: 0;

    background:
        rgba(8, 30, 18, .55);

    backdrop-filter:
        blur(3px);

}


.stock-modal-dialog {

    position: relative;

    width: 100%;

    max-width: 560px;

    max-height: 92vh;

    overflow-y: auto;

    border-radius: 15px;

    background: #ffffff;

    box-shadow:
        0 20px 60px
        rgba(0,0,0,.25);

}


/* ==========================================================
   MODAL HEADER
========================================================== */

.stock-modal-header {

    display: flex;

    justify-content: space-between;

    gap: 15px;

    padding: 17px;

    border-bottom: 1px solid #e5ece7;

}


.modal-eyebrow {

    color: #198754;

    font-size: 8px;

    font-weight: 900;

    letter-spacing: .8px;

}


.stock-modal-header h2 {

    margin: 3px 0;

    color: #164f31;

    font-size: 19px;

}


.stock-modal-header p {

    margin: 0;

    color: #7b867f;

    font-size: 10px;

}


.modal-close {

    width: 32px;
    height: 32px;

    flex-shrink: 0;

    border: none;

    border-radius: 50%;

    background: #f1f5f2;

    color: #536159;

    font-size: 22px;

    cursor: pointer;

}


/* ==========================================================
   FORM
========================================================== */

#stockForm {

    padding: 17px;

}


.form-field {

    display: flex;

    flex-direction: column;

    gap: 5px;

    margin-bottom: 12px;

}


.form-field label {

    color: #344139;

    font-size: 10px;

    font-weight: 850;

}


.form-field input,
.form-field select,
.form-field textarea {

    width: 100%;

    padding: 9px 10px;

    border: 1px solid #d5e1d9;

    border-radius: 8px;

    outline: none;

    background: #ffffff;

    color: #29362f;

    font-family: inherit;

    font-size: 11px;

}


.form-field textarea {

    resize: vertical;

}


.form-field input:focus,
.form-field select:focus,
.form-field textarea:focus {

    border-color: #198754;

    box-shadow:
        0 0 0 3px
        rgba(25,135,84,.08);

}


.form-field small {

    color: #87918b;

    font-size: 8px;

}


.form-grid {

    display: grid;

    grid-template-columns: 1fr 1fr;

    gap: 10px;

}


.money-input {

    display: flex;

    align-items: center;

    border: 1px solid #d5e1d9;

    border-radius: 8px;

    overflow: hidden;

}


.money-input span {

    padding-left: 9px;

    color: #198754;

    font-size: 9px;

    font-weight: 900;

}


.money-input input {

    border: none;

}


.stock-submit {

    width: 100%;

    min-height: 43px;

    display: flex;

    align-items: center;

    justify-content: center;

    gap: 7px;

    margin-top: 4px;

    border: none;

    border-radius: 9px;

    background: #0d5933;

    color: #ffffff;

    font-family: inherit;

    font-size: 11px;

    font-weight: 850;

    cursor: pointer;

}


/* ==========================================================
   MOBILE
========================================================== */

@media (max-width: 600px) {

    .feedstore {

        padding:
            10px 8px 40px;

    }


    .stock-item {

        padding: 9px;

    }


    .stock-item-right {

        gap: 6px;

    }


    .stock-arrow {

        display: none;

    }


    .form-grid {

        grid-template-columns: 1fr;

        gap: 0;

    }


    .stock-modal {

        align-items: flex-end;

        padding: 0;

    }


    .stock-modal-dialog {

        max-height: 94vh;

        border-radius:
            16px 16px 0 0;

    }

}

</style>



<script>

document.addEventListener(
    "DOMContentLoaded",
    function () {


        /* ======================================================
           ELEMENTS
        ======================================================= */

        const modal =
            document.getElementById(
                "stockModal"
            );


        const openAddStock =
            document.getElementById(
                "openAddStock"
            );


        const form =
            document.getElementById(
                "stockForm"
            );


        const category =
            document.getElementById(
                "category"
            );


        const feedField =
            document.getElementById(
                "feedField"
            );


        const medicineField =
            document.getElementById(
                "medicineField"
            );


        const feedName =
            document.getElementById(
                "feedName"
            );


        const medicineName =
            document.getElementById(
                "medicineName"
            );


        const stockId =
            document.getElementById(
                "stockId"
            );


        const quantity =
            document.getElementById(
                "quantity"
            );


        const unit =
            document.getElementById(
                "unit"
            );


        const price =
            document.getElementById(
                "price"
            );


        const instructions =
            document.getElementById(
                "instructions"
            );


        const expectedDuration =
            document.getElementById(
                "expectedDuration"
            );


        const message =
            document.getElementById(
                "message"
            );


        const images =
            document.getElementById(
                "images"
            );


        const modalTitle =
            document.getElementById(
                "stockModalTitle"
            );


        const modalEyebrow =
            document.getElementById(
                "stockModalEyebrow"
            );


        const modalDescription =
            document.getElementById(
                "stockModalDescription"
            );


        const submitText =
            document.getElementById(
                "stockSubmitText"
            );


        const submitIcon =
            document.getElementById(
                "stockSubmitIcon"
            );


        const quantityHelp =
            document.getElementById(
                "quantityHelp"
            );



        /* ======================================================
           ROLE
        ======================================================= */

        const isAdmin =
            <%= isAdmin ? "true" : "false" %>;



        /* ======================================================
           MODAL OPEN
        ======================================================= */

        function openModal() {

            modal.hidden = false;

            document.body.style.overflow =
                "hidden";

        }



        /* ======================================================
           MODAL CLOSE
        ======================================================= */

        function closeModal() {

            modal.hidden = true;

            document.body.style.overflow =
                "";

        }



        /* ======================================================
           CLOSE BUTTONS
        ======================================================= */

        document
            .querySelectorAll(
                "[data-close-modal]"
            )
            .forEach(
                function(element) {

                    element.addEventListener(
                        "click",
                        closeModal
                    );

                }
            );



        /* ======================================================
           ESCAPE
        ======================================================= */

        document.addEventListener(
            "keydown",
            function(event) {

                if (
                    event.key === "Escape" &&
                    !modal.hidden
                ) {

                    closeModal();

                }

            }
        );



        /* ======================================================
           CATEGORY
        ======================================================= */

        function updateCategory() {

            const value =
                category.value;


            feedField.hidden =
                value !== "feed";


            medicineField.hidden =
                value !== "medicine";


            feedName.required =
                value === "feed";


            medicineName.required =
                value === "medicine";

        }



        category.addEventListener(
            "change",
            updateCategory
        );



        /* ======================================================
           RESET FOR NEW STOCK
           
           ADMIN ONLY.
        ======================================================= */

        function openNewStock() {

            if (!isAdmin) {

                return;

            }


            form.reset();


            stockId.value =
                "";


            category.disabled =
                false;


            unit.disabled =
                false;


            quantity.removeAttribute(
                "max"
            );


            modalEyebrow.textContent =
                "ADMIN";


            modalTitle.textContent =
                "Add Stock";


            modalDescription.textContent =
                "Add animal feed or veterinary medicine.";


            quantityHelp.textContent =
                "Enter the quantity being added.";


            submitIcon.textContent =
                "➕";


            submitText.textContent =
                "Add Stock";


            updateCategory();


            openModal();

        }



        /* ======================================================
           ADMIN COMPOSER
        ======================================================= */

        if (openAddStock) {

            openAddStock.addEventListener(
                "click",
                openNewStock
            );

        }



        /* ======================================================
           EXISTING STOCK
        ======================================================= */

        function openExistingStock(
            card
        ) {


            const id =
                card.dataset.stockId;


            const name =
                card.dataset.stockName;


            const stockCategory =
                card.dataset.stockCategory;


            const currentQuantity =
                Number(
                    card.dataset.stockQuantity
                );


            const stockUnit =
                card.dataset.stockUnit;


            const stockPrice =
                Number(
                    card.dataset.stockPrice
                );


            stockId.value =
                id;


            category.value =
                stockCategory;


            category.disabled =
                true;


            quantity.value =
                Number.isFinite(
                    currentQuantity
                )
                    ? currentQuantity
                    : 0;


            unit.value =
                stockUnit;


            /*
             * Existing stock is being opened.
             *
             * For this first UI stage:
             *
             * the form is simply populated with the
             * actual database values.
             */

            if (price) {

                price.value =
                    Number.isFinite(
                        stockPrice
                    )
                        ? stockPrice
                        : "";

            }


            /*
             * Stock name is already identified by stockId.
             *
             * Do not ask the user to choose another name.
             */

            feedName.required =
                false;


            medicineName.required =
                false;


            /*
             * Existing stock fields.
             */

            if (stockCategory === "feed") {

                feedName.value =
                    name;

            } else {

                medicineName.value =
                    name;

            }


            modalEyebrow.textContent =
                "EXISTING STOCK";


            modalTitle.textContent =
                name;


            modalDescription.textContent =
                "Update this stock item.";


            quantityHelp.textContent =
                "Current quantity: " +
                currentQuantity +
                " " +
                stockUnit;


            submitIcon.textContent =
                "💾";


            submitText.textContent =
                "Save Stock Update";


            updateCategory();


            openModal();

        }



        /* ======================================================
           CLICKABLE STOCK LIST
        ======================================================= */

        document
            .querySelectorAll(
                ".stock-item"
            )
            .forEach(
                function(card) {


                    card.addEventListener(
                        "click",
                        function() {

                            openExistingStock(
                                card
                            );

                        }
                    );


                    card.addEventListener(
                        "keydown",
                        function(event) {


                            if (
                                event.key === "Enter" ||
                                event.key === " "
                            ) {

                                event.preventDefault();

                                openExistingStock(
                                    card
                                );

                            }

                        }
                    );

                }
            );



        /* ======================================================
           INITIAL STATE
        ======================================================= */

        updateCategory();


    }
);

</script>