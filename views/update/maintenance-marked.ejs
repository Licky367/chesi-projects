<!-- ==========================================================
     MAINTENANCE RECORD - REQUIRED
========================================================== -->

<article
    class="feed-card maintenance-card"
    data-id="<%= item._id %>"
    data-type="maintenance"
>

    <!-- =================================================
         HEADER
    ================================================== -->

    <div class="feed-header">

        <div class="feed-user">

            <img
                src="<%= item.userImage || ('https://ui-avatars.com/api/?name=' + encodeURIComponent(item.userName || 'User')) %>"
                class="avatar-sm"
                alt="<%= item.userName || 'User' %>"
            >

            <div class="feed-user-info">

                <!-- =========================================
                     MAINTENANCE META
                ========================================== -->

                <div class="post-meta-line">

                    <strong class="post-user-name">

                        🔧 <%= item.userName || "User" %>

                    </strong>

                    <% if (item.dairyName && item.dairyId) { %>

                        <span class="post-meta-action">

                            evaluated

                        </span>

                        <a
                            href="/dairy/<%= item.dairyId %>"
                            class="post-subject"
                            title="View <%= item.dairyName %>"
                        >

                            <%= item.dairyName %>

                        </a>

                        <span class="post-meta-action">

                            overal conditions

                        </span>

                    <% } else { %>

                        <span class="post-meta-action">

                            evaluated health condition

                        </span>

                    <% } %>

                </div>


                <!-- =========================================
                     DATE / TIME
                ========================================== -->

                <small class="post-time">

                    <%= item.dateText %>

                </small>

            </div>

        </div>


        <!-- =================================================
             DELETE MAINTENANCE
        ================================================== -->

        <% if (
            user &&
            (
                user.role === "admin" ||
                (
                    user._id &&
                    item.userId &&
                    user._id.toString() ===
                    item.userId.toString()
                )
            )
        ) { %>

            <button
                class="delete-post"
                data-id="<%= item._id %>"
                data-type="maintenance"
                title="Delete Maintenance Record"
                aria-label="Delete Maintenance Record"
                type="button"
            >

                <i
                    class="bi bi-trash3-fill"
                    aria-hidden="true"
                ></i>

            </button>

        <% } %>

    </div>


    <!-- =================================================
         BODY
    ================================================== -->

    <div class="feed-body">

        <h3>

            🔧 Maintenance Required

        </h3>


        <!-- =============================================
             STATUS
        ============================================== -->

        <div class="maintenance-status marked">

            Status:

            <strong>

                Requires Maintenance

            </strong>

        </div>


        <!-- =============================================
             MAINTENANCE TYPE
        ============================================== -->

        <% if (item.maintenanceType) { %>

            <p>

                <strong>Type:</strong>

                <%= item.maintenanceType %>

            </p>

        <% } %>


        <!-- =============================================
             TITLE
        ============================================== -->

        <% if (item.title) { %>

            <p>

                <strong>Title:</strong>

                <%= item.title %>

            </p>

        <% } %>


        <!-- =============================================
             DESCRIPTION
        ============================================== -->

        <% if (item.description) { %>

            <p>

                <%= item.description %>

            </p>

        <% } %>

    </div>


    <!-- =================================================
         ACTIONS
    ================================================== -->

    <%- include("partials/feed-actions", {
        item,
        type: "maintenance"
    }) %>


    <!-- =================================================
         COMMENTS
    ================================================== -->

    <%- include("comment-section", {
        item,
        user,
        type: "maintenance"
    }) %>

</article>