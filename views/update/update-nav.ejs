<!-- =====================================================
     UPDATE NAVIGATION

     FILE:
         views/update/update-nav.ejs

     PURPOSE:
         Fixed navigation bar for the update page.

     layout.ejs header:
         120px

     Navigation:
         top:    120px
         height: 40px

     LINKS:
         1. Updates
         2. Switch Farm  ← only when more than one assigned farm
         3. Storage
         4. Dairy Assets

     FARM SWITCHING:
         • Uses assignedFarms
         • Only appears when assignedFarms.length > 1
         • Current farm is identified by dairy._id
         • Clicking a farm opens /dairy/<farm._id>
===================================================== -->


<%
/* =====================================================
   ASSIGNED FARMS

   Safely normalize assignedFarms so this view cannot
   crash when the variable is missing or is not an array.
===================================================== */

const workerAssignedFarms =
    Array.isArray(assignedFarms)
        ? assignedFarms.filter(farm => !!farm)
        : [];


/* =====================================================
   FARM SWITCHING AVAILABILITY
===================================================== */

const canSwitchFarms =
    workerAssignedFarms.length > 1;
%>



<!-- =====================================================
     UPDATE NAVIGATION
===================================================== -->

<nav
    class="update-fixed-nav <%= canSwitchFarms ? 'has-farm-switcher' : 'without-farm-switcher' %>"
    aria-label="Dairy update navigation"
>


    <!-- =================================================
         1. UPDATES
    ================================================== -->

    <a
        href="/dairy/<%= dairy._id %>/general"
        class="update-nav-link update-nav-updates"
        title="View Updates"
        aria-label="View Updates"
    >

        <span
            class="update-nav-icon"
            aria-hidden="true"
        >

            <!-- Edit / Updates -->

            <svg
                viewBox="0 0 24 24"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
            >

                <path
                    d="M4 20H8L19 9C20.1 7.9 20.1 6.1 19 5C17.9 3.9 16.1 3.9 15 5L4 16V20Z"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                />

                <path
                    d="M13.5 6.5L17.5 10.5"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                />

            </svg>

        </span>

        <span class="update-nav-label">
            Updates
        </span>

    </a>



    <% if (canSwitchFarms) { %>

        <!-- =============================================
             2. SWITCH FARM
        ============================================== -->

        <div
            class="update-nav-farm-switcher"
        >

            <button
                type="button"
                id="updateFarmSwitchButton"
                class="update-nav-link update-nav-switch-farm"
                aria-expanded="false"
                aria-controls="updateAssignedFarmList"
                title="Switch Farm"
                aria-label="Switch Farm"
            >

                <span
                    class="update-nav-icon"
                    aria-hidden="true"
                >

                    <!-- Farm Swap / Switch Icon -->

                    <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"
                    >

                        <path
                            d="M7 7H19"
                            stroke="currentColor"
                            stroke-width="1.8"
                            stroke-linecap="round"
                        />

                        <path
                            d="M16 4L19 7L16 10"
                            stroke="currentColor"
                            stroke-width="1.8"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        />

                        <path
                            d="M17 17H5"
                            stroke="currentColor"
                            stroke-width="1.8"
                            stroke-linecap="round"
                        />

                        <path
                            d="M8 14L5 17L8 20"
                            stroke="currentColor"
                            stroke-width="1.8"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        />

                    </svg>

                </span>

                <span class="update-nav-label">
                    Switch Farm
                </span>

            </button>



            <!-- =========================================
                 ASSIGNED FARM LIST
            ========================================== -->

            <div
                id="updateAssignedFarmList"
                class="update-nav-farm-list"
                hidden
            >

                <div
                    class="update-nav-farm-list-title"
                >
                    YOUR ASSIGNED FARMS
                </div>


                <div
                    class="update-nav-farm-options"
                >

                    <% workerAssignedFarms.forEach(farm => { %>

                        <a
                            href="/dairy/<%= farm._id %>"
                            class="update-nav-farm-option <%= (
                                dairy &&
                                dairy._id &&
                                farm._id &&
                                dairy._id.toString() ===
                                farm._id.toString()
                            ) ? 'is-current' : '' %>"
                        >

                            <!-- FARM ICON -->

                            <span
                                class="update-nav-farm-option-icon"
                                aria-hidden="true"
                            >

                                <%= (
                                    dairy &&
                                    dairy._id &&
                                    farm._id &&
                                    dairy._id.toString() ===
                                    farm._id.toString()
                                ) ? '✓' : '⌂' %>

                            </span>


                            <!-- FARM DETAILS -->

                            <span
                                class="update-nav-farm-option-details"
                            >

                                <span
                                    class="update-nav-farm-option-name"
                                >
                                    <%= farm.name %>
                                </span>


                                <% if (
                                    farm.code !== null &&
                                    farm.code !== undefined
                                ) { %>

                                    <span
                                        class="update-nav-farm-option-code"
                                    >
                                        Farm #<%= farm.code %>
                                    </span>

                                <% } %>

                            </span>


                            <!-- CURRENT LABEL -->

                            <% if (
                                dairy &&
                                dairy._id &&
                                farm._id &&
                                dairy._id.toString() ===
                                farm._id.toString()
                            ) { %>

                                <span
                                    class="update-nav-current-label"
                                >
                                    CURRENT
                                </span>

                            <% } %>

                        </a>

                    <% }); %>

                </div>

            </div>

        </div>

    <% } %>



    <!-- =================================================
         3. STORAGE
    ================================================== -->

    <a
        href="/storage/<%= dairy._id %>"
        class="update-nav-link update-nav-storage"
        title="Storage"
        aria-label="Storage"
    >

        <span
            class="update-nav-icon"
            aria-hidden="true"
        >

            <!-- Storage Box -->

            <svg
                viewBox="0 0 24 24"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
            >

                <path
                    d="M4 7.5L12 4L20 7.5V16.5L12 20L4 16.5V7.5Z"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linejoin="round"
                />

                <path
                    d="M4 7.5L12 11L20 7.5"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linejoin="round"
                />

                <path
                    d="M12 11V20"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                />

            </svg>

        </span>

        <span class="update-nav-label">
            Storage
        </span>

    </a>



    <!-- =================================================
         4. DAIRY ASSETS
    ================================================== -->

    <a
        href="/dairy/<%= dairy._id %>/assets"
        class="update-nav-link update-nav-dairy-assets"
        title="Dairy Assets"
        aria-label="Dairy Assets"
    >

        <span
            class="update-nav-icon"
            aria-hidden="true"
        >

            <!-- Farm / Dairy Asset -->

            <svg
                viewBox="0 0 24 24"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
            >

                <path
                    d="M3 21V10L12 4L21 10V21"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                />

                <path
                    d="M7 21V14H17V21"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linejoin="round"
                />

                <path
                    d="M9 14V11H15V14"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linejoin="round"
                />

            </svg>

        </span>

        <span class="update-nav-label">
            Dairy Assets
        </span>

    </a>


</nav>



<!-- =====================================================
     FARM SWITCHING JAVASCRIPT
===================================================== -->

<script>

(function () {

    "use strict";


    /* =====================================================
       INITIALIZE
    ===================================================== */

    function initializeFarmSwitcher() {


        const switchButton =
            document.getElementById(
                "updateFarmSwitchButton"
            );


        const farmList =
            document.getElementById(
                "updateAssignedFarmList"
            );


        /* =================================================
           NOTHING TO INITIALIZE

           This happens automatically when the worker has
           zero or one assigned farm because the EJS does
           not render the switcher.
        ================================================== */

        if (
            !switchButton ||
            !farmList
        ) {

            return;

        }


        /* =================================================
           TOGGLE FARM LIST
        ================================================== */

        switchButton.addEventListener(
            "click",
            function (event) {

                event.preventDefault();

                event.stopPropagation();


                const currentlyHidden =
                    farmList.hidden;


                farmList.hidden =
                    !currentlyHidden;


                switchButton.setAttribute(
                    "aria-expanded",
                    String(currentlyHidden)
                );

            }
        );


        /* =================================================
           CLOSE WHEN CLICKING OUTSIDE
        ================================================== */

        document.addEventListener(
            "click",
            function (event) {

                if (
                    !switchButton.contains(event.target) &&
                    !farmList.contains(event.target)
                ) {

                    farmList.hidden =
                        true;

                    switchButton.setAttribute(
                        "aria-expanded",
                        "false"
                    );

                }

            }
        );


        /* =================================================
           ESCAPE KEY
        ================================================== */

        document.addEventListener(
            "keydown",
            function (event) {

                if (
                    event.key === "Escape" &&
                    !farmList.hidden
                ) {

                    farmList.hidden =
                        true;

                    switchButton.setAttribute(
                        "aria-expanded",
                        "false"
                    );

                    switchButton.focus();

                }

            }
        );

    }


    /* =====================================================
       DOM READY
    ===================================================== */

    if (
        document.readyState ===
        "loading"
    ) {

        document.addEventListener(
            "DOMContentLoaded",
            initializeFarmSwitcher
        );

    } else {

        initializeFarmSwitcher();

    }

})();

</script>



<!-- =====================================================
     UPDATE NAVIGATION STYLES
===================================================== -->

<style>

/* =====================================================
   COLOUR PALETTE
===================================================== */

.update-fixed-nav {

    --nav-green:
        #638b6a;

    --nav-green-dark:
        #4f7657;

    --nav-green-light:
        rgba(225, 240, 226, 0.72);

    --nav-green-hover:
        rgba(201, 225, 204, 0.72);

    --nav-border:
        rgba(99, 139, 106, 0.16);

}



/* =====================================================
   FIXED NAVIGATION
===================================================== */

.update-fixed-nav {

    position: fixed;

    top: 120px;

    left: 0;
    right: 0;

    width: 100%;

    height: 40px;

    display: grid;

    /*
       Four columns when the farm switcher exists.
       Three columns when it does not.
    */

    grid-template-columns:
        repeat(4, minmax(0, 1fr));

    align-items: stretch;

    margin: 0;

    padding: 0;

    box-sizing: border-box;

    z-index: 9999;

    background:
        var(--nav-green-light);

    border-bottom:
        1px solid
        var(--nav-border);

    box-shadow:
        0 1px 5px
        rgba(67, 103, 72, 0.06);

    backdrop-filter:
        blur(4px);

    -webkit-backdrop-filter:
        blur(4px);

}


/* =====================================================
   THREE COLUMN MODE

   When there is only one assigned farm, the farm
   switcher is not rendered. The remaining three
   navigation items fill the navigation evenly.
===================================================== */

.update-fixed-nav.without-farm-switcher {

    grid-template-columns:
        repeat(3, minmax(0, 1fr));

}



/* =====================================================
   EACH NAVIGATION ITEM
===================================================== */

.update-nav-link {

    min-width: 0;

    width: 100%;

    height: 40px;

    display: flex;

    flex-direction: row;

    align-items: center;

    justify-content: center;

    gap: 5px;

    margin: 0;

    padding: 0 5px;

    border: 0;

    border-right:
        1px solid
        rgba(99, 139, 106, 0.08);

    border-radius: 0;

    background: transparent;

    color:
        var(--nav-green-dark);

    text-decoration: none;

    font-family: inherit;

    font-size: 10px;

    font-weight: 600;

    line-height: 1;

    white-space: nowrap;

    overflow: hidden;

    cursor: pointer;

    box-sizing: border-box;

    transition:
        background-color 0.18s ease,
        color 0.18s ease;

    -webkit-tap-highlight-color:
        transparent;

}



/* =====================================================
   FARM SWITCHER CONTAINER

   It occupies exactly one grid column.
===================================================== */

.update-nav-farm-switcher {

    position: relative;

    min-width: 0;

    width: 100%;

    height: 40px;

}



/* =====================================================
   FARM SWITCH BUTTON
===================================================== */

.update-nav-switch-farm {

    appearance: none;

    -webkit-appearance: none;

    font: inherit;

}



/* =====================================================
   REMOVE DIVIDER FROM FINAL ITEM
===================================================== */

.update-nav-link:last-child {

    border-right: 0;

}



/* =====================================================
   ICON
===================================================== */

.update-nav-icon {

    width: 19px;

    height: 19px;

    flex:
        0 0 19px;

    display: flex;

    align-items: center;

    justify-content: center;

}


.update-nav-icon svg {

    width: 18px;

    height: 18px;

    display: block;

}



/* =====================================================
   LABEL
===================================================== */

.update-nav-label {

    min-width: 0;

    overflow: hidden;

    text-overflow: ellipsis;

    white-space: nowrap;

}



/* =====================================================
   INDIVIDUAL ICON SHADES
===================================================== */

.update-nav-updates {

    color:
        #628668;

}


.update-nav-switch-farm {

    color:
        #587f5f;

}


.update-nav-storage {

    color:
        #668b6b;

}


.update-nav-dairy-assets {

    color:
        #4f7857;

}



/* =====================================================
   HOVER
===================================================== */

.update-nav-link:hover {

    background:
        var(--nav-green-hover);

    color:
        var(--nav-green-dark);

}



/* =====================================================
   FOCUS
===================================================== */

.update-nav-link:focus-visible {

    outline:
        2px solid
        rgba(79, 118, 87, 0.28);

    outline-offset:
        -2px;

    background:
        rgba(255, 255, 255, 0.35);

}



/* =====================================================
   ACTIVE
===================================================== */

.update-nav-link:active {

    background:
        rgba(185, 213, 189, 0.55);

}



/* =====================================================
   FARM LIST
===================================================== */

.update-nav-farm-list {

    position: absolute;

    top: 43px;

    left: 50%;

    width: 270px;

    max-width:
        calc(100vw - 24px);

    box-sizing: border-box;

    transform:
        translateX(-50%);

    padding: 8px;

    border:
        1px solid
        rgba(99, 139, 106, 0.18);

    border-radius: 10px;

    background:
        #ffffff;

    box-shadow:
        0 8px 24px
        rgba(45, 74, 50, 0.15);

    z-index: 10001;

}


.update-nav-farm-list[hidden] {

    display: none;

}



/* =====================================================
   FARM LIST TITLE
===================================================== */

.update-nav-farm-list-title {

    padding:
        3px 6px 8px;

    color:
        #727c75;

    font-size: 8px;

    font-weight: 800;

    letter-spacing: 1px;

}



/* =====================================================
   FARM OPTIONS
===================================================== */

.update-nav-farm-options {

    display: flex;

    flex-direction: column;

    gap: 4px;

}



/* =====================================================
   INDIVIDUAL FARM
===================================================== */

.update-nav-farm-option {

    min-width: 0;

    display: flex;

    align-items: center;

    gap: 8px;

    padding: 8px;

    border:
        1px solid
        transparent;

    border-radius: 7px;

    background:
        #f7faf8;

    color:
        #17351f;

    text-decoration: none;

    transition:
        background-color 0.18s ease,
        border-color 0.18s ease;

}


.update-nav-farm-option:hover {

    background:
        #edf6ef;

    border-color:
        #c8d9cc;

}


.update-nav-farm-option.is-current {

    background:
        #e8f5eb;

    border-color:
        #bad3c0;

}



/* =====================================================
   FARM OPTION ICON
===================================================== */

.update-nav-farm-option-icon {

    flex:
        0 0 27px;

    width: 27px;

    height: 27px;

    border-radius: 50%;

    display: flex;

    align-items: center;

    justify-content: center;

    background:
        #e3ebe5;

    color:
        var(--nav-green);

    font-size: 12px;

    font-weight: 800;

}


.update-nav-farm-option.is-current
.update-nav-farm-option-icon {

    background:
        var(--nav-green);

    color:
        #ffffff;

}



/* =====================================================
   FARM DETAILS
===================================================== */

.update-nav-farm-option-details {

    min-width: 0;

    flex:
        1;

    display: flex;

    flex-direction: column;

    gap: 2px;

}


.update-nav-farm-option-name {

    overflow: hidden;

    text-overflow: ellipsis;

    white-space: nowrap;

    color:
        #20352a;

    font-size: 11px;

    font-weight: 700;

}


.update-nav-farm-option-code {

    color:
        #747d77;

    font-size: 9px;

}



/* =====================================================
   CURRENT LABEL
===================================================== */

.update-nav-current-label {

    flex:
        0 0 auto;

    padding:
        4px 6px;

    border-radius: 5px;

    background:
        var(--nav-green);

    color:
        #ffffff;

    font-size: 7px;

    font-weight: 800;

    letter-spacing: 0.5px;

}



/* =====================================================
   BUTTON RESET
===================================================== */

.update-nav-button {

    appearance: none;

    -webkit-appearance: none;

}



/* =====================================================
   CONTENT POSITIONING

   Navigation is exactly 40px high.

   The content starts exactly below it.
===================================================== */

.dairy-page {

    margin-top: 40px;

}



/* =====================================================
   MOBILE
===================================================== */

@media (max-width: 600px) {

    .update-nav-link {

        gap: 3px;

        padding: 0 3px;

        font-size: 9px;

    }


    .update-nav-icon {

        width: 18px;

        height: 18px;

        flex-basis: 18px;

    }


    .update-nav-icon svg {

        width: 17px;

        height: 17px;

    }


    .update-nav-farm-list {

        width: 255px;

    }

}



/* =====================================================
   VERY SMALL SCREENS
===================================================== */

@media (max-width: 380px) {

    .update-nav-link {

        gap: 2px;

        padding: 0 2px;

        font-size: 8px;

    }


    .update-nav-icon {

        width: 17px;

        height: 17px;

        flex-basis: 17px;

    }


    .update-nav-icon svg {

        width: 16px;

        height: 16px;

    }


    .update-nav-farm-list {

        width: 240px;

    }

}



/* =====================================================
   REDUCED MOTION
===================================================== */

@media (prefers-reduced-motion: reduce) {

    .update-nav-link,
    .update-nav-farm-option {

        transition: none;

    }

}

</style>