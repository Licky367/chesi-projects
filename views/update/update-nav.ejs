<!-- =====================================================
     UPDATE NAVIGATION

     FILE:
         views/update/update-nav.ejs

     PURPOSE:
         Fixed navigation bar for the update page.

     layout.ejs already contains a 120px header.

     Navigation:
         top:    120px
         height: 40px

     CONTENT:
         The page content starts exactly 40px below
         the navigation.
===================================================== -->



<!-- =====================================================
     UPDATE NAVIGATION
===================================================== -->

<nav
    class="update-fixed-nav"
    aria-label="Dairy update navigation"
>


    <!-- =================================================
         VIEW UPDATES / GENERAL
    ================================================== -->

    <a
        href="/dairy/<%= dairy._id %>/general"
        class="update-nav-link"
        title="View Updates"
        aria-label="View Updates"
    >

        <span
            class="update-nav-icon update-icon-updates"
            aria-hidden="true"
        >

            <!-- Edit / update icon -->

            <svg
                viewBox="0 0 24 24"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
            >

                <path
                    d="M4 20H8L19 9C20.1 7.9 20.1 6.1 19 5C17.9 3.9 16.1 3.9 15 5L4 16V20Z"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                />

                <path
                    d="M13.5 6.5L17.5 10.5"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                />

            </svg>

        </span>

    </a>



    <!-- =================================================
         VIEW ASSETS
    ================================================== -->

    <button
        type="button"
        id="viewPropertyButton"
        class="update-nav-link update-nav-button"
        aria-controls="assetBar"
        aria-expanded="false"
        title="View Assets"
        aria-label="View Assets"
    >

        <span
            class="update-nav-icon update-icon-assets"
            aria-hidden="true"
        >

            <!-- Grid / assets icon -->

            <svg
                viewBox="0 0 24 24"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
            >

                <rect
                    x="4"
                    y="4"
                    width="6"
                    height="6"
                    rx="1"
                    stroke="currentColor"
                    stroke-width="1.8"
                />

                <rect
                    x="14"
                    y="4"
                    width="6"
                    height="6"
                    rx="1"
                    stroke="currentColor"
                    stroke-width="1.8"
                />

                <rect
                    x="4"
                    y="14"
                    width="6"
                    height="6"
                    rx="1"
                    stroke="currentColor"
                    stroke-width="1.8"
                />

                <rect
                    x="14"
                    y="14"
                    width="6"
                    height="6"
                    rx="1"
                    stroke="currentColor"
                    stroke-width="1.8"
                />

            </svg>

        </span>

    </button>



    <!-- =================================================
         STORAGE
    ================================================== -->

    <a
        href="/storage/<%= dairy._id %>"
        class="update-nav-link"
        title="Storage"
        aria-label="Storage"
    >

        <span
            class="update-nav-icon update-icon-storage"
            aria-hidden="true"
        >

            <!-- Storage / box icon -->

            <svg
                viewBox="0 0 24 24"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
            >

                <path
                    d="M4 7.5L12 4L20 7.5V16.5L12 20L4 16.5V7.5Z"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linejoin="round"
                />

                <path
                    d="M4 7.5L12 11L20 7.5"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linejoin="round"
                />

                <path
                    d="M12 11V20"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                />

            </svg>

        </span>

    </a>


</nav>



<!-- =====================================================
     UPDATE NAVIGATION STYLES
===================================================== -->

<style>


    /* =====================================================
       UPDATE NAVIGATION VARIABLES
    ===================================================== */

    .update-fixed-nav {

        --update-cream:
            rgba(246, 239, 213, 0.72);

        --update-green:
            #55745b;

        --update-orange:
            #b87945;

        --update-border:
            rgba(91, 117, 91, 0.14);

    }



    /* =====================================================
       FIXED NAVIGATION

       layout.ejs header:
           120px

       navigation:
           40px

       navigation occupies:
           120px → 160px
    ===================================================== */

    .update-fixed-nav {

        position: fixed;

        top: 120px;

        left: 0;
        right: 0;

        width: 100%;

        height: 40px;

        display: flex;

        align-items: center;

        justify-content: center;

        gap: 18px;

        margin: 0;

        padding: 0;

        box-sizing: border-box;

        z-index: 9999;

        background:
            var(--update-cream);

        border-bottom:
            1px solid
            var(--update-border);

        box-shadow:
            0 1px 5px
            rgba(72, 91, 62, 0.06);

        backdrop-filter:
            blur(5px);

        -webkit-backdrop-filter:
            blur(5px);

    }



    /* =====================================================
       NAVIGATION BUTTON / LINK

       Each item has an equal visual area.
    ===================================================== */

    .update-nav-link {

        width: 42px;

        height: 36px;

        flex: 0 0 42px;

        display: flex;

        align-items: center;

        justify-content: center;

        margin: 0;

        padding: 0;

        border: 0;

        border-radius: 8px;

        background: transparent;

        color:
            var(--update-green);

        text-decoration: none;

        cursor: pointer;

        box-sizing: border-box;

        transition:
            background-color 0.18s ease,
            color 0.18s ease,
            transform 0.12s ease;

        -webkit-tap-highlight-color:
            transparent;

    }



    /* =====================================================
       ICON CONTAINER
    ===================================================== */

    .update-nav-icon {

        width: 22px;

        height: 22px;

        display: flex;

        align-items: center;

        justify-content: center;

        box-sizing: border-box;

    }



    /* =====================================================
       SVG ICON
    ===================================================== */

    .update-nav-icon svg {

        width: 20px;

        height: 20px;

        display: block;

    }



    /* =====================================================
       INDIVIDUAL ICON ACCENTS
       
       Updates:
           warm orange

       Assets:
           natural green

       Storage:
           muted green-orange
    ===================================================== */

    .update-icon-updates {

        color:
            var(--update-orange);

    }


    .update-icon-assets {

        color:
            var(--update-green);

    }


    .update-icon-storage {

        color:
            #8a7651;

    }



    /* =====================================================
       HOVER
    ===================================================== */

    .update-nav-link:hover {

        background:
            rgba(255, 255, 255, 0.55);

    }


    .update-icon-updates:hover {

        color:
            #a76537;

    }


    .update-icon-assets:hover {

        color:
            #46664d;

    }


    .update-icon-storage:hover {

        color:
            #74613e;

    }



    /* =====================================================
       KEYBOARD FOCUS
    ===================================================== */

    .update-nav-link:focus-visible {

        outline:
            2px solid
            rgba(85, 116, 91, 0.35);

        outline-offset:
            -2px;

        background:
            rgba(255, 255, 255, 0.55);

    }



    /* =====================================================
       ACTIVE / PRESS
    ===================================================== */

    .update-nav-link:active {

        transform:
            scale(0.92);

    }



    /* =====================================================
       BUTTON RESET
    ===================================================== */

    .update-nav-button {

        font-family: inherit;

        appearance: none;

        -webkit-appearance: none;

    }



    /* =====================================================
       CONTENT POSITIONING
       
       IMPORTANT:

       The navigation is fixed and therefore does not
       occupy normal document flow.

       The content receives EXACTLY the navigation height:

           40px

       No additional padding is added.
    ===================================================== */

    .dairy-page {

        margin-top: 40px;

    }



    /* =====================================================
       MOBILE
       
       Navigation remains exactly 40px.
    ===================================================== */

    @media (max-width: 600px) {

        .update-fixed-nav {

            height: 40px;

            gap: 14px;

        }


        .update-nav-link {

            width: 40px;

            height: 36px;

            flex-basis: 40px;

        }


        .update-nav-icon {

            width: 21px;

            height: 21px;

        }


        .update-nav-icon svg {

            width: 19px;

            height: 19px;

        }

    }



    /* =====================================================
       VERY SMALL SCREENS
    ===================================================== */

    @media (max-width: 380px) {

        .update-fixed-nav {

            gap: 10px;

        }


        .update-nav-link {

            width: 38px;

            flex-basis: 38px;

        }

    }

</style>