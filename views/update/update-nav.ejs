<!-- =====================================================
     UPDATE NAVIGATION STYLES
===================================================== -->

<style>

    /* =====================================================
       COLOUR PALETTE

       Very faint light green / "kwa umbaali"

       The background is intentionally subtle.
    ===================================================== */

    .update-fixed-nav {

        --nav-green:
            #638b6a;

        --nav-green-dark:
            #4f7657;

        --nav-green-light:
            rgba(225, 240, 226, 0.72);

        --nav-green-hover:
            rgba(201, 225, 204, 0.72);

        --nav-border:
            rgba(99, 139, 106, 0.16);

    }



    /* =====================================================
       FIXED NAVIGATION

       layout.ejs header:
           120px

       update navigation:
           40px
    ===================================================== */

    .update-fixed-nav {

        position: fixed;

        top: 120px;

        left: 0;
        right: 0;

        width: 100%;

        height: 40px;

        display: grid;

        grid-template-columns:
            repeat(4, minmax(0, 1fr));

        align-items: stretch;

        margin: 0;

        padding: 0;

        box-sizing: border-box;

        z-index: 9999;

        background:
            var(--nav-green-light);

        border-bottom:
            1px solid
            var(--nav-border);

        box-shadow:
            0 1px 5px
            rgba(67, 103, 72, 0.06);

        backdrop-filter:
            blur(4px);

        -webkit-backdrop-filter:
            blur(4px);

    }



    /* =====================================================
       EACH NAVIGATION ITEM

       Four equal columns.
    ===================================================== */

    .update-nav-link {

        min-width: 0;

        width: 100%;

        height: 40px;

        display: flex;

        flex-direction: row;

        align-items: center;

        justify-content: center;

        gap: 5px;

        margin: 0;

        padding: 0 5px;

        border: 0;

        border-right:
            1px solid
            rgba(99, 139, 106, 0.08);

        border-radius: 0;

        background: transparent;

        color:
            var(--nav-green-dark);

        text-decoration: none;

        font-family: inherit;

        font-size: 10px;

        font-weight: 600;

        line-height: 1;

        white-space: nowrap;

        overflow: hidden;

        cursor: pointer;

        box-sizing: border-box;

        transition:
            background-color 0.18s ease,
            color 0.18s ease;

        -webkit-tap-highlight-color:
            transparent;

    }



    /* Remove divider from final item */

    .update-nav-link:last-child {

        border-right: 0;

    }



    /* =====================================================
       ICON
    ===================================================== */

    .update-nav-icon {

        width: 19px;

        height: 19px;

        flex: 0 0 19px;

        display: flex;

        align-items: center;

        justify-content: center;

    }


    .update-nav-icon svg {

        width: 18px;

        height: 18px;

        display: block;

    }



    /* =====================================================
       LABEL
    ===================================================== */

    .update-nav-label {

        min-width: 0;

        overflow: hidden;

        text-overflow: ellipsis;

        white-space: nowrap;

    }



    /* =====================================================
       INDIVIDUAL ICON SHADES
       
       All remain within the same soft green family.
    ===================================================== */

    .update-nav-updates {

        color:
            #628668;

    }


    .update-nav-assets {

        color:
            #587f5f;

    }


    .update-nav-storage {

        color:
            #668b6b;

    }


    .update-nav-dairy-assets {

        color:
            #4f7857;

    }



    /* =====================================================
       HOVER
    ===================================================== */

    .update-nav-link:hover {

        background:
            var(--nav-green-hover);

        color:
            var(--nav-green-dark);

    }



    /* =====================================================
       FOCUS
    ===================================================== */

    .update-nav-link:focus-visible {

        outline:
            2px solid
            rgba(79, 118, 87, 0.28);

        outline-offset:
            -2px;

        background:
            rgba(255, 255, 255, 0.35);

    }



    /* =====================================================
       ACTIVE
    ===================================================== */

    .update-nav-link:active {

        background:
            rgba(185, 213, 189, 0.55);

    }



    /* =====================================================
       BUTTON RESET
    ===================================================== */

    .update-nav-button {

        appearance: none;

        -webkit-appearance: none;

    }



    /* =====================================================
       CONTENT POSITIONING

       Navigation is exactly 40px high.

       The content starts exactly below it.
    ===================================================== */

    .dairy-page {

        margin-top: 40px;

    }



    /* =====================================================
       MOBILE
    ===================================================== */

    @media (max-width: 600px) {

        .update-nav-link {

            gap: 3px;

            padding: 0 3px;

            font-size: 9px;

        }


        .update-nav-icon {

            width: 18px;

            height: 18px;

            flex-basis: 18px;

        }


        .update-nav-icon svg {

            width: 17px;

            height: 17px;

        }

    }



    /* =====================================================
       VERY SMALL SCREENS

       Labels remain visible but become smaller.
    ===================================================== */

    @media (max-width: 380px) {

        .update-nav-link {

            gap: 2px;

            padding: 0 2px;

            font-size: 8px;

        }


        .update-nav-icon {

            width: 17px;

            height: 17px;

            flex-basis: 17px;

        }


        .update-nav-icon svg {

            width: 16px;

            height: 16px;

        }

    }

</style>