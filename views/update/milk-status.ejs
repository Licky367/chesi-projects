<% /*
==========================================================
MILKING STATUS CARD

FILE:
views/update/milk-status.ejs

PURPOSE:
----------------------------------------------------------
Compact vertical milking-status card for update-cards.

DESIGN:
----------------------------------------------------------
• Narrow vertical layout
• WhatsApp-status-style presentation
• Animal image at the top
• Animal name
• Short milking status
• Compact toggle button
• Uses:

    POST /dairy/:id/toggle-milking

AUTHORIZED USERS:
----------------------------------------------------------
• admin
• dairyWorker

EXPECTED DATA:
----------------------------------------------------------
dairy
user
==========================================================
*/ %>


<% if (dairy) { %>


<div
    class="milk-status-card"
    data-dairy-id="<%= dairy._id %>"
>


    <!-- =================================================
         ANIMAL IMAGE
    ================================================== -->

    <div class="milk-status-image">

        <% if (dairy.profileImage) { %>

            <img
                src="<%= dairy.profileImage %>"
                alt="<%= dairy.name %>"
            >

        <% } else { %>

            <span class="milk-status-placeholder">
                🐄
            </span>

        <% } %>

    </div>


    <!-- =================================================
         CARD CONTENT
    ================================================== -->

    <div class="milk-status-content">


        <!-- =================================================
             SMALL LABEL
        ================================================== -->

        <span class="milk-status-label">
            Milking Status
        </span>


        <!-- =================================================
             ANIMAL NAME
        ================================================== -->

        <h3 class="milk-status-name">
            <%= dairy.name %>
        </h3>


        <!-- =================================================
             CURRENT STATUS
        ================================================== -->

        <% if (dairy.isMilking === true) { %>

            <div
                class="milk-status-state active"
                data-milking-status
            >
                <span class="milk-status-dot"></span>

                <span>
                    Currently milking
                </span>
            </div>

        <% } else { %>

            <div
                class="milk-status-state inactive"
                data-milking-status
            >
                <span class="milk-status-dot"></span>

                <span>
                    Not milking
                </span>
            </div>

        <% } %>


        <!-- =================================================
             TOGGLE
        ================================================== -->

        <% if (
            user &&
            (
                user.role === "admin" ||
                user.role === "dairyWorker"
            )
        ) { %>

            <form
                class="milk-status-form"
                action="/dairy/<%= dairy._id %>/toggle-milking"
                method="POST"
                autocomplete="off"
            >

                <% if (dairy.isMilking === true) { %>

                    <button
                        type="submit"
                        class="milk-status-button stop"
                        data-milking-button
                    >
                        Stop milking
                    </button>

                <% } else { %>

                    <button
                        type="submit"
                        class="milk-status-button start"
                        data-milking-button
                    >
                        Start milking
                    </button>

                <% } %>

            </form>

        <% } %>


    </div>

</div>


<% } %>



<style>

/* =====================================================
   MILKING STATUS CARD
===================================================== */

.milk-status-card {

    width: 170px;

    box-sizing: border-box;

    padding: 10px;

    border-radius: 14px;

    background: #ffffff;

    border: 1px solid #eeeeee;

    box-shadow:
        0 4px 14px rgba(0, 0, 0, 0.06);

    overflow: hidden;

}


/* =====================================================
   IMAGE
===================================================== */

.milk-status-image {

    width: 100%;

    height: 145px;

    overflow: hidden;

    border-radius: 10px;

    background: #f0fdf4;

    display: flex;

    align-items: center;

    justify-content: center;

}


.milk-status-image img {

    width: 100%;

    height: 100%;

    object-fit: cover;

    display: block;

}


.milk-status-placeholder {

    font-size: 42px;

}


/* =====================================================
   CONTENT
===================================================== */

.milk-status-content {

    padding-top: 10px;

}


/* =====================================================
   LABEL
===================================================== */

.milk-status-label {

    display: block;

    margin-bottom: 3px;

    color: #9ca3af;

    font-size: 9px;

    font-weight: 700;

    letter-spacing: 0.4px;

    text-transform: uppercase;

}


/* =====================================================
   ANIMAL NAME
===================================================== */

.milk-status-name {

    margin: 0 0 7px;

    color: #1f2937;

    font-size: 14px;

    font-weight: 700;

    line-height: 1.2;

    white-space: nowrap;

    overflow: hidden;

    text-overflow: ellipsis;

}


/* =====================================================
   CURRENT STATUS
===================================================== */

.milk-status-state {

    display: flex;

    align-items: center;

    gap: 6px;

    margin-bottom: 9px;

    font-size: 10px;

    font-weight: 600;

    line-height: 1.2;

}


.milk-status-dot {

    width: 7px;

    height: 7px;

    flex: 0 0 7px;

    border-radius: 50%;

}


.milk-status-state.active {

    color: #166534;

}


.milk-status-state.active
.milk-status-dot {

    background: #22c55e;

}


.milk-status-state.inactive {

    color: #6b7280;

}


.milk-status-state.inactive
.milk-status-dot {

    background: #9ca3af;

}


/* =====================================================
   TOGGLE BUTTON
===================================================== */

.milk-status-form {

    width: 100%;

    margin: 0;

}


.milk-status-button {

    width: 100%;

    box-sizing: border-box;

    padding: 7px 8px;

    border: none;

    border-radius: 7px;

    color: #ffffff;

    font-family: inherit;

    font-size: 10px;

    font-weight: 700;

    cursor: pointer;

    transition:
        transform 0.15s ease,
        opacity 0.15s ease;

}


.milk-status-button:hover {

    transform:
        translateY(-1px);

}


.milk-status-button.start {

    background: #166534;

}


.milk-status-button.stop {

    background: #b91c1c;

}


.milk-status-button:disabled {

    opacity: 0.55;

    cursor: wait;

    transform: none;

}


/* =====================================================
   MOBILE
===================================================== */

@media (max-width: 650px) {

    .milk-status-card {

        width: 155px;

        padding: 9px;

    }


    .milk-status-image {

        height: 130px;

    }

}

</style>



<script>

/* ==========================================================
   MILKING STATUS TOGGLE

   Uses fetch() so the page remains where it is.

========================================================== */

(function () {

    const cards =
        document.querySelectorAll(
            ".milk-status-card"
        );


    cards.forEach(
        function (card) {

            const form =
                card.querySelector(
                    ".milk-status-form"
                );


            const button =
                card.querySelector(
                    "[data-milking-button]"
                );


            const status =
                card.querySelector(
                    "[data-milking-status]"
                );


            if (
                !form ||
                !button ||
                !status
            ) {

                return;

            }


            form.addEventListener(
                "submit",
                async function (event) {

                    event.preventDefault();


                    if (
                        button.disabled
                    ) {

                        return;

                    }


                    const currentlyMilking =
                        status.classList.contains(
                            "active"
                        );


                    if (
                        currentlyMilking
                    ) {

                        const confirmed =
                            window.confirm(
                                "Stop milking for <%= dairy.name %>?"
                            );


                        if (!confirmed) {

                            return;

                        }

                    }


                    button.disabled =
                        true;


                    const originalText =
                        button.textContent;


                    button.textContent =
                        "Updating...";


                    try {

                        const response =
                            await fetch(
                                form.action,
                                {

                                    method:
                                        "POST",

                                    headers: {

                                        "Accept":
                                            "application/json"

                                    }

                                }
                            );


                        const data =
                            await response.json();


                        if (
                            !response.ok ||
                            !data.success
                        ) {

                            throw new Error(
                                data.message ||
                                "Unable to update milking status."
                            );

                        }


                        /* ==================================
                           CURRENTLY MILKING
                        ================================== */

                        if (
                            data.isMilking === true
                        ) {

                            status
                                .classList
                                .remove(
                                    "inactive"
                                );

                            status
                                .classList
                                .add(
                                    "active"
                                );


                            status.innerHTML =
                                '<span class="milk-status-dot"></span>' +
                                '<span>Currently milking</span>';


                            button
                                .classList
                                .remove(
                                    "start"
                                );

                            button
                                .classList
                                .add(
                                    "stop"
                                );


                            button.textContent =
                                "Stop milking";

                        }


                        /* ==================================
                           NOT MILKING
                        ================================== */

                        else {

                            status
                                .classList
                                .remove(
                                    "active"
                                );

                            status
                                .classList
                                .add(
                                    "inactive"
                                );


                            status.innerHTML =
                                '<span class="milk-status-dot"></span>' +
                                '<span>Not milking</span>';


                            button
                                .classList
                                .remove(
                                    "stop"
                                );

                            button
                                .classList
                                .add(
                                    "start"
                                );


                            button.textContent =
                                "Start milking";

                        }

                    } catch (error) {

                        console.error(
                            "MILKING STATUS ERROR:",
                            error
                        );


                        alert(
                            error.message ||
                            "Unable to update milking status."
                        );


                        button.textContent =
                            originalText;

                    } finally {

                        button.disabled =
                            false;

                    }

                }
            );

        }
    );

})();

</script>