<% /*
============================================================
MILKING HISTORY CARD

FILE:
    views/update/milking-history.ejs

PURPOSE:
    Compact clickable card for opening the milking history
    of the CURRENT dairy animal.

NAVIGATION:
    /milk/history/:id

DESIGN:
    - Same size as create.ejs
    - 112px × 155px
    - 108px × 150px on mobile
    - Greenish theme
    - Entire card is clickable
    - No JavaScript required
============================================================
*/ %>


<% if (dairy) { %>


<a
    href="/milk/history/<%= dairy._id %>"
    class="milking-history-card"
    aria-label="View milking history for <%= dairy.name %>"
>


    <!-- =====================================================
         ICON
    ====================================================== -->

    <span
        class="milking-history-card__icon"
        aria-hidden="true"
    >

        <i class="bi bi-clock-history"></i>

    </span>



    <!-- =====================================================
         LABEL
    ====================================================== -->

    <span class="milking-history-card__label">

        MILKING

    </span>



    <!-- =====================================================
         TITLE
    ====================================================== -->

    <span class="milking-history-card__title">

        Milking History

    </span>



    <!-- =====================================================
         TARGET
    ====================================================== -->

    <span class="milking-history-card__target">

        <%= dairy.name %>

    </span>



    <!-- =====================================================
         ARROW
    ====================================================== -->

    <span
        class="milking-history-card__arrow"
        aria-hidden="true"
    >

        <i class="bi bi-chevron-right"></i>

    </span>


</a>



<style>

/* ==========================================================
   MILKING HISTORY CARD
   SAME DIMENSIONS AS create.ejs
========================================================== */

.milking-history-card {

    position: relative;

    width: 112px;

    height: 155px;

    flex: 0 0 112px;

    box-sizing: border-box;

    padding: 12px;

    display: flex;

    flex-direction: column;

    align-items: center;

    justify-content: center;

    gap: 7px;

    overflow: hidden;

    border: 1px solid #dce7e0;

    border-radius: 15px;

    background:
        linear-gradient(
            145deg,
            #ffffff,
            #f3f8f5
        );

    color: #198754;

    text-decoration: none;

    font-family: inherit;

    cursor: pointer;

    text-align: center;

    transition:
        transform .15s ease,
        border-color .15s ease,
        box-shadow .15s ease;

}



/* ==========================================================
   HOVER
========================================================== */

.milking-history-card:hover {

    border-color: #198754;

    box-shadow:
        0 5px 15px
        rgba(25, 135, 84, .10);

}



/* ==========================================================
   ACTIVE
========================================================== */

.milking-history-card:active {

    transform: scale(.95);

}



/* ==========================================================
   KEYBOARD FOCUS
========================================================== */

.milking-history-card:focus-visible {

    outline: 2px solid #198754;

    outline-offset: 2px;

}



/* ==========================================================
   ICON
========================================================== */

.milking-history-card__icon {

    width: 48px;

    height: 48px;

    flex: 0 0 48px;

    display: flex;

    align-items: center;

    justify-content: center;

    border-radius: 50%;

    background: #198754;

    color: #ffffff;

    font-size: 22px;

    box-shadow:
        0 4px 12px
        rgba(25, 135, 84, .20);

}



/* ==========================================================
   LABEL
========================================================== */

.milking-history-card__label {

    display: block;

    color: #789080;

    font-size: 8px;

    font-weight: 800;

    letter-spacing: .7px;

    line-height: 1.1;

}



/* ==========================================================
   TITLE
========================================================== */

.milking-history-card__title {

    display: block;

    max-width: 90px;

    color: #26322b;

    font-size: 13px;

    font-weight: 800;

    line-height: 1.2;

}



/* ==========================================================
   TARGET
========================================================== */

.milking-history-card__target {

    display: block;

    max-width: 88px;

    overflow: hidden;

    color: #8a928d;

    font-size: 9px;

    line-height: 1.2;

    white-space: nowrap;

    text-overflow: ellipsis;

}



/* ==========================================================
   ARROW
========================================================== */

.milking-history-card__arrow {

    position: absolute;

    right: 7px;

    bottom: 7px;

    width: 22px;

    height: 22px;

    display: flex;

    align-items: center;

    justify-content: center;

    border-radius: 50%;

    background: #eaf6ee;

    color: #198754;

    font-size: 10px;

}



/* ==========================================================
   MOBILE
========================================================== */

@media (max-width: 600px) {

    .milking-history-card {

        width: 108px;

        height: 150px;

        flex-basis: 108px;

    }


    .milking-history-card__icon {

        width: 46px;

        height: 46px;

        flex-basis: 46px;

        font-size: 21px;

    }

}



/* ==========================================================
   SMALL PHONES
========================================================== */

@media (max-width: 380px) {

    .milking-history-card {

        width: 108px;

        height: 150px;

        flex-basis: 108px;

    }

}

</style>


<% } %>