<% /*
==========================================================
MILKING HISTORY CARD

FILE:
    views/update/milking-history.ejs

PURPOSE:
----------------------------------------------------------
Compact clickable card that opens the milking history
page for the currently viewed dairy animal.

NAVIGATION:
----------------------------------------------------------
/milk/history/:id

Example:
    /milk/history/64f123...

EXPECTED DATA:
----------------------------------------------------------
dairy

DESIGN:
----------------------------------------------------------
• Same compact size as other update cards
• Greenish theme
• Entire card is clickable
• No form
• No JavaScript required
==========================================================
*/ %>


<% if (dairy) { %>

<a
    href="/milk/history/<%= dairy._id %>"
    class="milking-history-card"
    aria-label="View milking history for <%= dairy.name %>"
>


    <!-- ==================================================
         ICON
    =================================================== -->

    <div class="milking-history-icon">

        <i class="bi bi-clock-history"></i>

    </div>


    <!-- ==================================================
         CONTENT
    =================================================== -->

    <div class="milking-history-content">

        <span class="milking-history-label">
            MILKING
        </span>

        <h3 class="milking-history-title">
            Milking History
        </h3>

        <p class="milking-history-description">
            View recorded milk production.
        </p>

    </div>


    <!-- ==================================================
         ARROW
    =================================================== -->

    <div class="milking-history-arrow">

        <i class="bi bi-chevron-right"></i>

    </div>


</a>


<style>

/* ==========================================================
   MILKING HISTORY CARD
========================================================== */

.milking-history-card {

    position: relative;

    width: 170px;

    min-height: 205px;

    box-sizing: border-box;

    padding: 12px;

    display: flex;

    flex-direction: column;

    text-decoration: none;

    color: inherit;

    background: #ffffff;

    border: 1px solid #dcebe2;

    border-radius: 14px;

    box-shadow:
        0 4px 14px rgba(20, 83, 45, 0.07);

    overflow: hidden;

    cursor: pointer;

    transition:
        transform 0.16s ease,
        box-shadow 0.16s ease,
        border-color 0.16s ease;

}


.milking-history-card:hover {

    transform: translateY(-2px);

    border-color: #a9d5b9;

    box-shadow:
        0 7px 18px rgba(20, 83, 45, 0.11);

}


.milking-history-card:active {

    transform: scale(0.98);

}



/* ==========================================================
   ICON
========================================================== */

.milking-history-icon {

    width: 42px;

    height: 42px;

    flex: 0 0 42px;

    display: flex;

    align-items: center;

    justify-content: center;

    margin-bottom: 14px;

    border-radius: 11px;

    background: #eaf6ee;

    color: #198754;

    font-size: 21px;

}



/* ==========================================================
   CONTENT
========================================================== */

.milking-history-content {

    min-width: 0;

    flex: 1;

}


.milking-history-label {

    display: block;

    margin-bottom: 4px;

    color: #7a9181;

    font-size: 9px;

    font-weight: 800;

    letter-spacing: 0.7px;

}


.milking-history-title {

    margin: 0;

    color: #183d28;

    font-size: 15px;

    font-weight: 800;

    line-height: 1.25;

}


.milking-history-description {

    margin: 7px 0 0;

    color: #718078;

    font-size: 10px;

    line-height: 1.4;

}



/* ==========================================================
   ARROW
========================================================== */

.milking-history-arrow {

    position: absolute;

    right: 10px;

    bottom: 10px;

    width: 25px;

    height: 25px;

    display: flex;

    align-items: center;

    justify-content: center;

    border-radius: 50%;

    background: #edf7f0;

    color: #198754;

    font-size: 12px;

}



/* ==========================================================
   MOBILE
========================================================== */

@media (max-width: 650px) {

    .milking-history-card {

        width: 155px;

        min-height: 190px;

        padding: 10px;

    }


    .milking-history-icon {

        width: 40px;

        height: 40px;

        flex-basis: 40px;

    }

}

</style>

<% } %>