<% /* ==========================================================
DAIRY FARM INTRODUCTION / H1

FILE:
views/update/h1.ejs

PURPOSE:
Editorial-style introductory section for a Dairy Farm.

BACKGROUND:
One centered diagonal typographic treatment:

    CFP <%= dairy.name %>

The entire phrase remains visible on:
    • Phones
    • Tablets
    • Desktop
    • Large screens

DATA REQUIRED:
dairy

========================================================== */ %>


<section
    class="dairy-h1"
    aria-label="Dairy Farm Introduction"
>


    <!-- =====================================================
         DIAGONAL TYPOGRAPHIC BACKGROUND
    ====================================================== -->

    <div
        class="dairy-h1-background"
        aria-hidden="true"
    >

        <div class="dairy-h1-diagonal">

            <span class="dairy-h1-diagonal-cfp">
                CFP
            </span>

            <span class="dairy-h1-diagonal-name">
                <%= dairy.name || "DAIRY FARM" %>
            </span>

        </div>

    </div>


    <!-- =====================================================
         MAIN CONTENT
    ====================================================== -->

    <div class="dairy-h1-content">


        <!-- =================================================
             LABEL
        ================================================== -->

        <div class="dairy-h1-label">

            <span class="dairy-h1-label-line"></span>

            <span>
                DAIRY FARM
            </span>

            <span class="dairy-h1-label-line"></span>

        </div>


        <!-- =================================================
             TITLE
        ================================================== -->

        <h1 class="dairy-h1-title">

            Welcome to

            <span>
                <%= dairy.name || "Our Dairy Farm" %>
            </span>

        </h1>


        <!-- =================================================
             FARM CODE
        ================================================== -->

        <% if (
            dairy &&
            dairy.code !== null &&
            dairy.code !== undefined
        ) { %>

            <div class="dairy-h1-code">

                FARM #<%= dairy.code %>

            </div>

        <% } %>


        <!-- =================================================
             INTRODUCTORY MESSAGE
        ================================================== -->

        <div class="dairy-h1-message">

            <p>

                Welcome to

                <strong>
                    <%= dairy.name || "this dairy farm" %>
                </strong>.

                We're glad to have you here.

            </p>


            <p>

                Support the activities here by updating
                us about the welfare of all assets within
                the dairy farm.

            </p>


            <p>

                In case of any inconveniences, keep us
                updated on this site.

            </p>

        </div>


        <!-- =================================================
             FARM VALUES
        ================================================== -->

        <div class="dairy-h1-values">


            <!-- =============================================
                 ANIMAL WELFARE
            ============================================== -->

            <div class="dairy-h1-value">

                <span
                    class="dairy-h1-value-icon"
                    aria-hidden="true"
                >
                    ♧
                </span>

                <div>

                    <strong>
                        Animal Welfare
                    </strong>

                    <span>
                        Care for every animal
                    </span>

                </div>

            </div>


            <!-- =============================================
                 FARM ASSETS
            ============================================== -->

            <div class="dairy-h1-value">

                <span
                    class="dairy-h1-value-icon"
                    aria-hidden="true"
                >
                    ◈
                </span>

                <div>

                    <strong>
                        Farm Assets
                    </strong>

                    <span>
                        Maintain every resource
                    </span>

                </div>

            </div>


            <!-- =============================================
                 STAY UPDATED
            ============================================== -->

            <div class="dairy-h1-value">

                <span
                    class="dairy-h1-value-icon"
                    aria-hidden="true"
                >
                    ↗
                </span>

                <div>

                    <strong>
                        Stay Updated
                    </strong>

                    <span>
                        Keep the farm informed
                    </span>

                </div>

            </div>


        </div>


    </div>

</section>


<!-- =========================================================
     DAIRY H1 STYLES
========================================================= -->

<style>


/* =========================================================
   MAIN SECTION

   This is NOT a card.
========================================================= */

.dairy-h1 {

    position: relative;

    width: 100%;

    min-height: 520px;

    margin: 0 0 35px;

    overflow: hidden;

    background: #ffffff;

}


/* =========================================================
   TYPOGRAPHIC BACKGROUND AREA
========================================================= */

.dairy-h1-background {

    position: absolute;

    inset: 0;

    z-index: 0;

    display: flex;

    align-items: center;

    justify-content: center;

    overflow: hidden;

    pointer-events: none;

}


/* =========================================================
   SINGLE DIAGONAL TYPOGRAPHY

   IMPORTANT:

   The element itself is centered first.

   It is then rotated around its own CENTER.

   This prevents the text from disappearing outside
   the section on mobile screens.
========================================================= */

.dairy-h1-diagonal {

    position: absolute;

    left: 50%;

    top: 50%;

    width: max-content;

    max-width: 90%;

    display: flex;

    align-items: baseline;

    justify-content: center;

    gap: clamp(10px, 1.8vw, 26px);

    white-space: nowrap;

    transform:
        translate(-50%, -50%)
        rotate(-18deg);

    transform-origin: center center;

    font-family:
        Georgia,
        "Times New Roman",
        serif;

    font-weight: 700;

    line-height: .9;

    text-transform: uppercase;

    opacity: 1;

}


/* =========================================================
   CFP

   Green typography.
========================================================= */

.dairy-h1-diagonal-cfp {

    font-size:
        clamp(
            55px,
            8vw,
            130px
        );

    letter-spacing:
        clamp(
            -3px,
            -.35vw,
            -6px
        );

    color:
        rgba(45, 91, 57, .12);

}


/* =========================================================
   FARM NAME

   Slightly larger than CFP.
========================================================= */

.dairy-h1-diagonal-name {

    max-width: 70vw;

    overflow: hidden;

    text-overflow: ellipsis;

    font-size:
        clamp(
            62px,
            10vw,
            165px
        );

    letter-spacing:
        clamp(
            -3px,
            -.45vw,
            -7px
        );

    color:
        rgba(45, 91, 57, .15);

}


/* =========================================================
   CONTENT

   Content sits above the typography.
========================================================= */

.dairy-h1-content {

    position: relative;

    z-index: 2;

    width: 100%;

    max-width: 1180px;

    min-height: 520px;

    margin: 0 auto;

    padding:
        clamp(50px, 7vw, 80px)
        clamp(24px, 6vw, 70px)
        50px;

    box-sizing: border-box;

    display: flex;

    flex-direction: column;

    justify-content: center;

    align-items: flex-start;

}


/* =========================================================
   LABEL
========================================================= */

.dairy-h1-label {

    display: flex;

    align-items: center;

    gap: 10px;

    margin-bottom: 16px;

    color: #426b4d;

    font-family:
        Arial,
        Helvetica,
        sans-serif;

    font-size: 10px;

    font-weight: 800;

    letter-spacing: 2.8px;

}


.dairy-h1-label-line {

    display: block;

    width: 30px;

    height: 1px;

    background:
        rgba(66, 107, 77, .70);

}


/* =========================================================
   MAIN TITLE

   Georgia gives the heading an editorial character.
========================================================= */

.dairy-h1-title {

    max-width: 820px;

    margin: 0;

    font-family:
        Georgia,
        "Times New Roman",
        serif;

    font-size:
        clamp(
            36px,
            5vw,
            64px
        );

    line-height: 1.04;

    letter-spacing: -1.5px;

    font-weight: 700;

    color: #263d2d;

}


/* =========================================================
   FARM NAME
========================================================= */

.dairy-h1-title span {

    display: block;

    margin-top: 6px;

    color: #3d6849;

}


/* =========================================================
   FARM CODE
========================================================= */

.dairy-h1-code {

    margin-top: 13px;

    color: #55765c;

    font-family:
        Arial,
        Helvetica,
        sans-serif;

    font-size: 9px;

    font-weight: 800;

    letter-spacing: 1.7px;

    text-transform: uppercase;

}


/* =========================================================
   MESSAGE
========================================================= */

.dairy-h1-message {

    max-width: 680px;

    margin-top: 26px;

}


.dairy-h1-message p {

    margin: 0 0 10px;

    color:
        rgba(39, 58, 45, .86);

    font-family:
        Arial,
        Helvetica,
        sans-serif;

    font-size:
        clamp(
            13px,
            1.5vw,
            15px
        );

    line-height: 1.7;

    font-weight: 400;

}


.dairy-h1-message p:last-child {

    margin-bottom: 0;

}


.dairy-h1-message strong {

    color: #3f6848;

    font-weight: 700;

}


/* =========================================================
   VALUES
========================================================= */

.dairy-h1-values {

    width: 100%;

    max-width: 800px;

    display: grid;

    grid-template-columns:
        repeat(3, minmax(0, 1fr));

    margin-top: 34px;

}


/* =========================================================
   VALUE
========================================================= */

.dairy-h1-value {

    min-width: 0;

    display: flex;

    align-items: center;

    gap: 11px;

    padding:
        4px 18px 4px 0;

}


/* =========================================================
   VALUE SEPARATOR
========================================================= */

.dairy-h1-value + .dairy-h1-value {

    padding-left: 18px;

    border-left:
        1px solid
        rgba(62, 101, 70, .22);

}


/* =========================================================
   VALUE ICON
========================================================= */

.dairy-h1-value-icon {

    flex: 0 0 34px;

    width: 34px;

    height: 34px;

    display: flex;

    align-items: center;

    justify-content: center;

    border-radius: 50%;

    border:
        1px solid
        rgba(62, 101, 70, .35);

    color: #477451;

    font-family:
        Georgia,
        serif;

    font-size: 17px;

}


/* =========================================================
   VALUE TEXT
========================================================= */

.dairy-h1-value div {

    min-width: 0;

}


.dairy-h1-value strong {

    display: block;

    margin-bottom: 3px;

    color: #365d40;

    font-family:
        Arial,
        Helvetica,
        sans-serif;

    font-size: 11px;

    font-weight: 800;

}


.dairy-h1-value span:not(.dairy-h1-value-icon) {

    display: block;

    color:
        rgba(53, 78, 59, .66);

    font-family:
        Arial,
        Helvetica,
        sans-serif;

    font-size: 9px;

    line-height: 1.35;

}


/* =========================================================
   LARGE DESKTOP
========================================================= */

@media (min-width: 1400px) {

    .dairy-h1 {

        min-height: 560px;

    }


    .dairy-h1-content {

        min-height: 560px;

        padding-left: 80px;

        padding-right: 80px;

    }


    .dairy-h1-message {

        max-width: 720px;

    }


    .dairy-h1-diagonal {

        gap: 28px;

    }

}


/* =========================================================
   TABLETS
========================================================= */

@media (max-width: 900px) {

    .dairy-h1 {

        min-height: 500px;

    }


    .dairy-h1-content {

        min-height: 500px;

    }


    .dairy-h1-diagonal {

        max-width: none;

        gap: 12px;

    }


    .dairy-h1-diagonal-cfp {

        font-size: 70px;

    }


    .dairy-h1-diagonal-name {

        font-size: 86px;

    }

}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 650px) {

    .dairy-h1 {

        min-height: 620px;

        margin-bottom: 25px;

    }


    /* =====================================================
       MOBILE TYPOGRAPHY

       The entire phrase remains centered.

       We reduce the scale instead of moving the
       phrase outside the viewport.
    ===================================================== */

    .dairy-h1-diagonal {

        width: max-content;

        max-width: none;

        gap: 8px;

        transform:
            translate(-50%, -50%)
            rotate(-18deg)
            scale(.72);

    }


    .dairy-h1-diagonal-cfp {

        font-size: 88px;

        letter-spacing: -4px;

    }


    .dairy-h1-diagonal-name {

        max-width: none;

        font-size: 104px;

        letter-spacing: -5px;

    }


    /* =====================================================
       CONTENT
    ===================================================== */

    .dairy-h1-content {

        min-height: 620px;

        padding:
            42px
            20px
            35px;

        justify-content: center;

    }


    /* =====================================================
       LABEL
    ===================================================== */

    .dairy-h1-label {

        font-size: 9px;

        letter-spacing: 2px;

    }


    /* =====================================================
       TITLE
    ===================================================== */

    .dairy-h1-title {

        font-size:
            clamp(
                32px,
                10vw,
                43px
            );

        letter-spacing: -.8px;

    }


    /* =====================================================
       MESSAGE
    ===================================================== */

    .dairy-h1-message {

        margin-top: 21px;

    }


    .dairy-h1-message p {

        font-size: 13px;

        line-height: 1.65;

        margin-bottom: 9px;

    }


    /* =====================================================
       VALUES
    ===================================================== */

    .dairy-h1-values {

        grid-template-columns: 1fr;

        gap: 0;

        margin-top: 25px;

    }


    .dairy-h1-value {

        padding:
            9px 0;

    }


    .dairy-h1-value + .dairy-h1-value {

        padding-left: 0;

        border-left: none;

        border-top:
            1px solid
            rgba(62, 101, 70, .18);

    }


    .dairy-h1-value-icon {

        flex-basis: 31px;

        width: 31px;

        height: 31px;

        font-size: 15px;

    }

}


/* =========================================================
   VERY SMALL PHONES
========================================================= */

@media (max-width: 380px) {

    .dairy-h1 {

        min-height: 650px;

    }


    .dairy-h1-content {

        min-height: 650px;

        padding-left: 16px;

        padding-right: 16px;

    }


    .dairy-h1-title {

        font-size: 30px;

    }


    .dairy-h1-message p {

        font-size: 12px;

    }


    /* Keep the whole phrase visible */

    .dairy-h1-diagonal {

        transform:
            translate(-50%, -50%)
            rotate(-18deg)
            scale(.58);

    }

}

</style>