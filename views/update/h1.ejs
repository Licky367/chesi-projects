<% /*
==========================================================
DAIRY FARM INTRODUCTION / H1

FILE:
views/update/h1.ejs

PURPOSE:
Personalized editorial hero section for a Dairy Farm.

DATA REQUIRED:
dairy
user

ROLE BEHAVIOUR:

dairyWorker:
    Personalized welcome using the user's name.

admin:
    Introduces the page as the home page for dairy
    workers assigned to this farm.

==========================================================
*/ %>

<section
    class="dairy-h1"
    aria-label="Dairy Farm Introduction"
>

    <!-- =================================================
         BACKGROUND LOGO
    ================================================== -->

    <div
        class="dairy-h1-background"
        aria-hidden="true"
    >

        <img
            src="/images/h1.png"
            alt=""
            class="dairy-h1-logo"
        >

    </div>


    <!-- =================================================
         DECORATIVE SIDE ACCENT
    ================================================== -->

    <div
        class="dairy-h1-accent"
        aria-hidden="true"
    ></div>


    <!-- =================================================
         CONTENT
    ================================================== -->

    <div class="dairy-h1-content">

        <!-- =================================================
             SMALL SECTION LABEL
        ================================================== -->

        <div class="dairy-h1-label">

            <span class="dairy-h1-label-line"></span>

            <span>DAIRY FARM</span>

            <span class="dairy-h1-label-line"></span>

        </div>


        <!-- =================================================
             PERSONALIZED HEADING
        ================================================== -->

        <% if (user && user.role === "admin") { %>

            <div class="dairy-h1-greeting">
                DAIRY MANAGEMENT SPACE
            </div>

            <h1 class="dairy-h1-title">

                Welcome to

                <span>
                    <%= dairy.name || "this Dairy Farm" %>
                </span>

            </h1>

        <% } else { %>

            <div class="dairy-h1-greeting">

                <%= user && user.name
                    ? user.name.split(" ")[0]
                    : "Welcome" %>

                <span class="greeting-dot">•</span>

                WELCOME

            </div>

            <h1 class="dairy-h1-title">

                Welcome to

                <span>
                    <%= dairy.name || "Our Dairy Farm" %>
                </span>

            </h1>

        <% } %>


        <!-- =================================================
             FARM CODE
        ================================================== -->

        <% if (dairy && dairy.code != null) { %>

            <div class="dairy-h1-code">

                FARM #

                <%= dairy.code %>

            </div>

        <% } %>


        <!-- =================================================
             DAIRY WORKER MESSAGE
        ================================================== -->

        <% if (!user || user.role === "dairyWorker") { %>

            <div class="dairy-h1-message">

                <p class="dairy-h1-lead">

                    <strong>
                        <%= user && user.name
                            ? user.name.split(" ")[0]
                            : "Welcome" %>,
                    </strong>

                    you're now on the home page for

                    <strong>
                        <%= dairy.name || "this dairy farm" %>
                    </strong>.

                </p>


                <p>

                    This is your space to keep an eye on the
                    animals, assets and activities that keep the
                    farm moving.

                </p>


                <p>

                    Take a look around, share updates and keep
                    the farm's story current. Every observation
                    helps build a clearer picture of what is
                    happening here.

                </p>

            </div>


        <!-- =================================================
             ADMIN MESSAGE
        ================================================== -->

        <% } else if (user.role === "admin") { %>

            <div class="dairy-h1-message admin-message">

                <p class="dairy-h1-lead">

                    This is the home page for all dairy workers
                    assigned to

                    <strong>
                        <%= dairy.name || "this dairy farm" %>
                    </strong>.

                </p>


                <p>

                    Go through their updates, observations and
                    conversations to see what is happening
                    across the farm.

                </p>


                <p>

                    Their updates provide a window into the
                    day-to-day life of this dairy farm and the
                    work being carried out here.

                </p>

            </div>

        <% } %>


        <!-- =================================================
             SMALL BOTTOM MARKER
        ================================================== -->

        <div class="dairy-h1-footer">

            <span></span>

            <small>
                THE CHESI FAMILY PROJECTS
            </small>

            <span></span>

        </div>

    </div>

</section>


<style>

/* =========================================================
   MAIN HERO
========================================================= */

.dairy-h1 {

    position: relative;

    width: calc(100% - 24px);
    max-width: 1180px;

    min-height: 350px;

    margin: 12px auto 28px;

    overflow: hidden;

    border-radius: 22px;

    /*
       Keep the background predominantly white.

       The green logo now has enough contrast to actually
       be visible.
    */
    background:
        linear-gradient(
            135deg,
            #ffffff 0%,
            #ffffff 58%,
            #f7fbf8 100%
        );

    border:
        1px solid rgba(57, 103, 70, .10);

    border-left:
        7px solid #4d8a5d;

    box-shadow:
        0 10px 28px rgba(42, 78, 51, .10),
        0 2px 5px rgba(42, 78, 51, .04);

}


/* =========================================================
   INNER EDGE
========================================================= */

.dairy-h1::after {

    content: "";

    position: absolute;

    inset: 0;

    z-index: 1;

    pointer-events: none;

    border-radius: inherit;

    box-shadow:
        inset 0 0 25px rgba(55, 105, 67, .035);

}


/* =========================================================
   BACKGROUND LOGO
========================================================= */

.dairy-h1-background {

    position: absolute;

    inset: 0;

    z-index: 0;

    display: flex;

    align-items: center;

    justify-content: flex-end;

    overflow: hidden;

    pointer-events: none;

}


/*
   The old opacity of .035 made the logo almost disappear.

   This is intentionally much stronger.
*/

.dairy-h1-logo {

    display: block;

    width: min(670px, 62vw);

    height: auto;

    opacity: .115;

    filter:
        saturate(1.15)
        contrast(1.05);

    transform:
        translateX(8%)
        rotate(-2deg);

}


/* =========================================================
   DECORATIVE ACCENT
========================================================= */

.dairy-h1-accent {

    position: absolute;

    z-index: 1;

    right: 0;

    top: 0;

    width: 34%;

    height: 100%;

    pointer-events: none;

    background:
        linear-gradient(
            90deg,
            transparent,
            rgba(77, 138, 93, .025)
        );

}


/* =========================================================
   CONTENT
========================================================= */

.dairy-h1-content {

    position: relative;

    z-index: 2;

    width: 100%;

    min-height: 350px;

    padding:
        34px
        clamp(22px, 5vw, 60px)
        28px;

    box-sizing: border-box;

    display: flex;

    flex-direction: column;

    justify-content: center;

    align-items: flex-start;

}


/* =========================================================
   LABEL
========================================================= */

.dairy-h1-label {

    display: flex;

    align-items: center;

    gap: 9px;

    margin-bottom: 9px;

    color: #386247;

    font-family:
        Arial,
        Helvetica,
        sans-serif;

    font-size: 9px;

    font-weight: 800;

    letter-spacing: 2.5px;

}


.dairy-h1-label-line {

    width: 27px;

    height: 1px;

    background:
        rgba(56, 98, 71, .62);

}


/* =========================================================
   PERSONAL GREETING
========================================================= */

.dairy-h1-greeting {

    margin-bottom: 7px;

    color: #4d8a5d;

    font-family:
        Arial,
        Helvetica,
        sans-serif;

    font-size: 10px;

    font-weight: 800;

    letter-spacing: 1.8px;

    text-transform: uppercase;

}


.greeting-dot {

    display: inline-block;

    margin:
        0 5px;

    color: #7ca887;

}


/* =========================================================
   TITLE
========================================================= */

.dairy-h1-title {

    max-width: 820px;

    margin: 0;

    color: #263f2e;

    font-family:
        Georgia,
        "Times New Roman",
        serif;

    font-size:
        clamp(34px, 4.5vw, 56px);

    line-height: 1.02;

    letter-spacing: -1.3px;

    font-weight: 700;

}


.dairy-h1-title span {

    display: block;

    margin-top: 4px;

    color: #37694a;

}


/* =========================================================
   FARM CODE
========================================================= */

.dairy-h1-code {

    margin-top: 9px;

    color: #52775b;

    font-family:
        Arial,
        Helvetica,
        sans-serif;

    font-size: 8px;

    font-weight: 800;

    letter-spacing: 1.6px;

    text-transform: uppercase;

}


/* =========================================================
   MESSAGE
========================================================= */

.dairy-h1-message {

    max-width: 680px;

    margin-top: 18px;

}


.dairy-h1-message p {

    margin: 0 0 7px;

    color:
        rgba(39, 65, 47, .86);

    font-family:
        Arial,
        Helvetica,
        sans-serif;

    font-size:
        clamp(12px, 1.35vw, 14px);

    line-height: 1.55;

    font-weight: 400;

}


.dairy-h1-message p:last-child {

    margin-bottom: 0;

}


.dairy-h1-message strong {

    color: #356647;

    font-weight: 700;

}


/* =========================================================
   LEAD MESSAGE
========================================================= */

.dairy-h1-message .dairy-h1-lead {

    color: #2d4d36;

    font-size:
        clamp(13px, 1.45vw, 15px);

    line-height: 1.5;

}


/* =========================================================
   FOOTER MARKER
========================================================= */

.dairy-h1-footer {

    display: flex;

    align-items: center;

    gap: 8px;

    margin-top: 18px;

    color: rgba(55, 105, 74, .52);

}


.dairy-h1-footer span {

    width: 20px;

    height: 1px;

    background:
        rgba(55, 105, 74, .25);

}


.dairy-h1-footer small {

    font-family:
        Arial,
        Helvetica,
        sans-serif;

    font-size: 7px;

    font-weight: 800;

    letter-spacing: 1.5px;

}


/* =========================================================
   TABLETS
========================================================= */

@media (max-width: 900px) {

    .dairy-h1 {

        width: calc(100% - 20px);

        min-height: 340px;

        border-radius: 20px;

    }


    .dairy-h1-content {

        min-height: 340px;

        padding:
            32px
            28px
            27px;

    }


    .dairy-h1-logo {

        width: min(610px, 72vw);

        opacity: .10;

    }

}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 650px) {

    .dairy-h1 {

        width: calc(100% - 18px);

        min-height: 390px;

        margin:
            9px
            auto
            22px;

        border-radius: 18px;

        border-left-width: 6px;

    }


    .dairy-h1-content {

        min-height: 390px;

        padding:
            29px
            20px
            25px;

    }


    .dairy-h1-background {

        align-items: center;

        justify-content: center;

    }


    .dairy-h1-logo {

        width: 530px;

        max-width: 135vw;

        opacity: .085;

        transform:
            translateX(12%)
            rotate(-2deg);

    }


    .dairy-h1-accent {

        width: 60%;

    }


    .dairy-h1-label {

        margin-bottom: 9px;

        font-size: 8px;

        letter-spacing: 2px;

    }


    .dairy-h1-greeting {

        font-size: 8px;

        letter-spacing: 1.5px;

    }


    .dairy-h1-title {

        font-size:
            clamp(30px, 9vw, 41px);

        letter-spacing: -.8px;

    }


    .dairy-h1-title span {

        margin-top: 3px;

    }


    .dairy-h1-code {

        margin-top: 8px;

        font-size: 7.5px;

    }


    .dairy-h1-message {

        margin-top: 17px;

    }


    .dairy-h1-message p {

        font-size: 12.5px;

        line-height: 1.55;

        margin-bottom: 7px;

    }


    .dairy-h1-message .dairy-h1-lead {

        font-size: 13px;

    }


    .dairy-h1-footer {

        margin-top: 16px;

    }

}


/* =========================================================
   VERY SMALL PHONES
========================================================= */

@media (max-width: 380px) {

    .dairy-h1 {

        width: calc(100% - 14px);

        min-height: 375px;

        border-radius: 16px;

    }


    .dairy-h1-content {

        min-height: 375px;

        padding:
            26px
            16px
            23px;

    }


    .dairy-h1-title {

        font-size: 29px;

    }


    .dairy-h1-message {

        margin-top: 15px;

    }


    .dairy-h1-message p {

        font-size: 12px;

        line-height: 1.5;

    }


    .dairy-h1-message .dairy-h1-lead {

        font-size: 12.5px;

    }


    .dairy-h1-logo {

        width: 470px;

        opacity: .075;

    }


    .dairy-h1-footer {

        margin-top: 13px;

    }

}

</style>