<% /*
==========================================================
DAIRY FARM INTRODUCTION + ASSET BROWSER

FILE:
views/update/h1.ejs

PURPOSE:
Editorial introduction for the Dairy Farm combined with
a compact browser for assets belonging to the farm.

DATA REQUIRED:
    dairy
    user
    assetDairies

ASSET RULES:
    Animals:
        code > 0

    Structures / Machines / Tools:
        code === null / undefined

NAVIGATION:
    /dairy/:asset._id
==========================================================
*/ %>


<%
/* =========================================================
   PREPARE ASSET DATA
========================================================= */

const availableAssets =
    Array.isArray(assetDairies)
        ? assetDairies.filter(asset => !!asset)
        : [];


/* =========================================================
   ANIMALS
========================================================= */

const animalDairies =
    availableAssets.filter(asset => {

        return (
            asset.code !== null &&
            asset.code !== undefined &&
            Number(asset.code) > 0
        );

    });


/* =========================================================
   STRUCTURES / MACHINES / TOOLS
========================================================= */

const structureDairies =
    availableAssets.filter(asset => {

        return (
            asset.code === null ||
            asset.code === undefined
        );

    });


/* =========================================================
   DISPLAY VALUES
========================================================= */

const farmName =
    dairy && dairy.name
        ? dairy.name
        : "Our Dairy Farm";


const userName =
    user && user.name
        ? user.name
        : "User";

%>


<!-- =========================================================
     DAIRY FARM HERO
========================================================= -->

<section
    class="dairy-h1"
    aria-label="Dairy Farm Introduction"
>


    <!-- =====================================================
         LOGO BACKGROUND
    ====================================================== -->

    <div
        class="dairy-h1-background"
        aria-hidden="true"
    >

        <img
            src="/images/h1.png"
            alt=""
            class="dairy-h1-logo"
        >

    </div>


    <!-- =====================================================
         MAIN CONTENT
    ====================================================== -->

    <div class="dairy-h1-content">


        <!-- =================================================
             LABEL
        ================================================== -->

        <div class="dairy-h1-label">

            <span class="dairy-h1-label-line"></span>

            <span>
                DAIRY FARM
            </span>

            <span class="dairy-h1-label-line"></span>

        </div>


        <!-- =================================================
             TITLE
        ================================================== -->

        <h1 class="dairy-h1-title">

            Welcome to

            <span>
                <%= farmName %>
            </span>

        </h1>


        <!-- =================================================
             FARM CODE
        ================================================== -->

        <% if (dairy && dairy.code != null) { %>

            <div class="dairy-h1-code">

                FARM #<%= dairy.code %>

            </div>

        <% } %>


        <!-- =================================================
             INTRODUCTORY MESSAGE
        ================================================== -->

        <div class="dairy-h1-message">

            <p>

                Welcome to
                <strong>
                    <%= farmName %>
                </strong>.

                We're glad to have you here.

            </p>


            <p>

                <%= userName %>, go through the available
                assets within this dairy farm and keep us
                updated about their welfare and condition.

            </p>


            <p>

                In case of any inconveniences, keep us
                updated on this site.

            </p>

        </div>


        <!-- =================================================
             FARM VALUES
        ================================================== -->

        <div class="dairy-h1-values">


            <!-- =============================================
                 ANIMAL WELFARE
            ============================================== -->

            <div class="dairy-h1-value">

                <span
                    class="dairy-h1-value-icon"
                    aria-hidden="true"
                >
                    ♧
                </span>

                <div>

                    <strong>
                        Animal Welfare
                    </strong>

                    <span>
                        Care for every animal
                    </span>

                </div>

            </div>


            <!-- =============================================
                 FARM ASSETS
            ============================================== -->

            <div class="dairy-h1-value">

                <span
                    class="dairy-h1-value-icon"
                    aria-hidden="true"
                >
                    ◈
                </span>

                <div>

                    <strong>
                        Farm Assets
                    </strong>

                    <span>
                        Maintain every resource
                    </span>

                </div>

            </div>


            <!-- =============================================
                 STAY UPDATED
            ============================================== -->

            <div class="dairy-h1-value">

                <span
                    class="dairy-h1-value-icon"
                    aria-hidden="true"
                >
                    ↗
                </span>

                <div>

                    <strong>
                        Stay Updated
                    </strong>

                    <span>
                        Keep the farm informed
                    </span>

                </div>

            </div>


        </div>


        <!-- =================================================
             ASSET BROWSER
        ================================================== -->

        <div
            class="dairy-assets"
            aria-label="Available Farm Assets"
        >


            <!-- =============================================
                 ASSET INTRO
            ============================================== -->

            <div class="dairy-assets-heading">


                <div>

                    <span class="dairy-assets-label">
                        AVAILABLE ASSETS
                    </span>


                    <h2>
                        Go through your farm assets
                    </h2>


                    <p>
                        Select a category below to view the
                        assets belonging to this dairy farm.
                    </p>

                </div>


                <!-- =========================================
                     TOTAL ASSETS
                ========================================== -->

                <div class="dairy-assets-total">

                    <span>
                        TOTAL
                    </span>

                    <strong>
                        <%= availableAssets.length %>
                    </strong>

                </div>


            </div>


            <!-- =============================================
                 ASSET SELECTORS
            ============================================== -->

            <div class="dairy-assets-selectors">


                <!-- =========================================
                     ANIMALS
                ========================================== -->

                <div class="dairy-asset-selector">


                    <button
                        type="button"
                        class="dairy-asset-button"
                        data-asset-dropdown="dairyAnimalsDropdown"
                        aria-expanded="false"
                        aria-controls="dairyAnimalsDropdown"
                    >


                        <span
                            class="dairy-asset-button-icon"
                            aria-hidden="true"
                        >
                            ♧
                        </span>


                        <span class="dairy-asset-button-text">


                            <span class="dairy-asset-button-title">
                                Animals
                            </span>


                            <span class="dairy-asset-button-subtitle">

                                <%= animalDairies.length %>

                                animal<%= animalDairies.length === 1
                                    ? ''
                                    : 's' %>

                            </span>


                        </span>


                        <span
                            class="dairy-asset-button-arrow"
                            aria-hidden="true"
                        >
                            ↓
                        </span>


                    </button>


                    <!-- =====================================
                         ANIMAL LIST
                    ====================================== -->

                    <div
                        id="dairyAnimalsDropdown"
                        class="dairy-asset-dropdown"
                        hidden
                    >


                        <div class="dairy-asset-dropdown-header">


                            <span>
                                LIVESTOCK
                            </span>


                            <span>
                                <%= animalDairies.length %>
                            </span>


                        </div>


                        <div class="dairy-asset-dropdown-scroll">


                            <% if (animalDairies.length) { %>


                                <% animalDairies.forEach(animal => { %>


                                    <a
                                        href="/dairy/<%= animal._id %>"
                                        class="dairy-asset-option"
                                    >


                                        <span
                                            class="dairy-asset-option-image"
                                        >

                                            <img
                                                src="<%= animal.displayImage %>"
                                                alt="<%= animal.name %>"
                                                loading="lazy"
                                            >

                                        </span>


                                        <span
                                            class="dairy-asset-option-details"
                                        >


                                            <span
                                                class="dairy-asset-option-name"
                                            >
                                                <%= animal.name %>
                                            </span>


                                            <span
                                                class="dairy-asset-option-code"
                                            >
                                                Animal #<%= animal.code %>
                                            </span>


                                            <% if (
                                                animal.type ||
                                                animal.gender
                                            ) { %>

                                                <span
                                                    class="dairy-asset-option-meta"
                                                >

                                                    <% if (animal.type) { %>

                                                        <span>
                                                            <%= animal.type %>
                                                        </span>

                                                    <% } %>


                                                    <% if (
                                                        animal.type &&
                                                        animal.gender
                                                    ) { %>

                                                        <span
                                                            class="dairy-asset-dot"
                                                        >
                                                            •
                                                        </span>

                                                    <% } %>


                                                    <% if (animal.gender) { %>

                                                        <span>
                                                            <%= animal.gender %>
                                                        </span>

                                                    <% } %>

                                                </span>

                                            <% } %>


                                        </span>


                                        <span
                                            class="dairy-asset-option-arrow"
                                            aria-hidden="true"
                                        >
                                            →
                                        </span>


                                    </a>


                                <% }); %>


                            <% } else { %>


                                <div class="dairy-assets-empty">

                                    <span>
                                        —
                                    </span>

                                    <p>
                                        No animals found for this
                                        dairy farm.
                                    </p>

                                </div>


                            <% } %>


                        </div>


                    </div>


                </div>


                <!-- =========================================
                     STRUCTURES & EQUIPMENT
                ========================================== -->

                <div class="dairy-asset-selector">


                    <button
                        type="button"
                        class="dairy-asset-button"
                        data-asset-dropdown="dairyStructuresDropdown"
                        aria-expanded="false"
                        aria-controls="dairyStructuresDropdown"
                    >


                        <span
                            class="dairy-asset-button-icon"
                            aria-hidden="true"
                        >
                            ◈
                        </span>


                        <span class="dairy-asset-button-text">


                            <span class="dairy-asset-button-title">
                                Structures &amp; Equipment
                            </span>


                            <span class="dairy-asset-button-subtitle">

                                <%= structureDairies.length %>

                                item<%= structureDairies.length === 1
                                    ? ''
                                    : 's' %>

                            </span>


                        </span>


                        <span
                            class="dairy-asset-button-arrow"
                            aria-hidden="true"
                        >
                            ↓
                        </span>


                    </button>


                    <!-- =====================================
                         STRUCTURE LIST
                    ====================================== -->

                    <div
                        id="dairyStructuresDropdown"
                        class="dairy-asset-dropdown"
                        hidden
                    >


                        <div class="dairy-asset-dropdown-header">


                            <span>
                                STRUCTURES &amp; EQUIPMENT
                            </span>


                            <span>
                                <%= structureDairies.length %>
                            </span>


                        </div>


                        <div class="dairy-asset-dropdown-scroll">


                            <% if (structureDairies.length) { %>


                                <% structureDairies.forEach(asset => { %>


                                    <a
                                        href="/dairy/<%= asset._id %>"
                                        class="dairy-asset-option"
                                    >


                                        <span
                                            class="dairy-asset-option-image"
                                        >

                                            <img
                                                src="<%= asset.displayImage %>"
                                                alt="<%= asset.name %>"
                                                loading="lazy"
                                            >

                                        </span>


                                        <span
                                            class="dairy-asset-option-details"
                                        >


                                            <span
                                                class="dairy-asset-option-name"
                                            >
                                                <%= asset.name %>
                                            </span>


                                            <% if (asset.type) { %>

                                                <span
                                                    class="dairy-asset-option-code"
                                                >
                                                    <%= asset.type %>
                                                </span>

                                            <% } %>


                                            <% if (asset.location) { %>

                                                <span
                                                    class="dairy-asset-option-meta"
                                                >
                                                    <%= asset.location %>
                                                </span>

                                            <% } %>


                                        </span>


                                        <span
                                            class="dairy-asset-option-arrow"
                                            aria-hidden="true"
                                        >
                                            →
                                        </span>


                                    </a>


                                <% }); %>


                            <% } else { %>


                                <div class="dairy-assets-empty">

                                    <span>
                                        —
                                    </span>

                                    <p>
                                        No structures, machines or
                                        tools found for this dairy farm.
                                    </p>

                                </div>


                            <% } %>


                        </div>


                    </div>


                </div>


            </div>


        </div>


    </div>

</section>


<!-- =========================================================
     ASSET DROPDOWN JAVASCRIPT
========================================================= -->

<script>

document.addEventListener(
    "DOMContentLoaded",
    function() {


        const buttons =
            document.querySelectorAll(
                ".dairy-asset-button"
            );


        const dropdowns =
            document.querySelectorAll(
                ".dairy-asset-dropdown"
            );


        /* =================================================
           CLOSE ALL
        ================================================= */

        function closeAll(
            exceptDropdown = null
        ) {

            dropdowns.forEach(
                function(dropdown) {

                    if (
                        dropdown ===
                        exceptDropdown
                    ) {

                        return;

                    }


                    dropdown.hidden =
                        true;


                    const button =
                        document.querySelector(
                            '[data-asset-dropdown="' +
                            dropdown.id +
                            '"]'
                        );


                    if (button) {

                        button.setAttribute(
                            "aria-expanded",
                            "false"
                        );


                        button.classList.remove(
                            "open"
                        );

                    }

                }
            );

        }


        /* =================================================
           BUTTONS
        ================================================= */

        buttons.forEach(
            function(button) {

                button.addEventListener(
                    "click",
                    function(event) {

                        event.preventDefault();

                        event.stopPropagation();


                        const dropdownId =
                            button.dataset
                                .assetDropdown;


                        const dropdown =
                            document.getElementById(
                                dropdownId
                            );


                        if (!dropdown) {

                            return;

                        }


                        const opening =
                            dropdown.hidden;


                        closeAll(
                            opening
                                ? dropdown
                                : null
                        );


                        dropdown.hidden =
                            !opening;


                        button.setAttribute(
                            "aria-expanded",
                            String(opening)
                        );


                        button.classList.toggle(
                            "open",
                            opening
                        );

                    }
                );

            }
        );


        /* =================================================
           CLICK OUTSIDE
        ================================================= */

        document.addEventListener(
            "click",
            function(event) {

                if (
                    !event.target.closest(
                        ".dairy-asset-selector"
                    )
                ) {

                    closeAll();

                }

            }
        );


        /* =================================================
           ESCAPE
        ================================================= */

        document.addEventListener(
            "keydown",
            function(event) {

                if (
                    event.key === "Escape"
                ) {

                    closeAll();

                }

            }
        );


    }
);

</script>


