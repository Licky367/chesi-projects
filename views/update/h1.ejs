<% /* ==========================================================
DAIRY FARM INTRODUCTION / H1

FILE:
views/update/h1.ejs

PURPOSE:
Editorial-style introductory hero section for a Dairy Farm.

The background consists of one large diagonal green
typographic treatment.

DATA REQUIRED:
dairy

========================================================== */ %>


<section
    class="dairy-h1"
    aria-label="Dairy Farm Introduction"
>


    <!-- =====================================================
         SINGLE DIAGONAL TYPOGRAPHIC BACKGROUND
    ====================================================== -->

    <div
        class="dairy-h1-background"
        aria-hidden="true"
    >

        <div class="dairy-h1-diagonal-text">

            <span class="dairy-h1-cfp">
                CFP
            </span>

            <span class="dairy-h1-dairy-name">
                <%= dairy.name || "DAIRY FARM" %>
            </span>

        </div>

    </div>


    <!-- =====================================================
         MAIN CONTENT
    ====================================================== -->

    <div class="dairy-h1-content">


        <!-- =================================================
             SMALL LABEL
        ================================================== -->

        <div class="dairy-h1-label">

            <span class="dairy-h1-label-line"></span>

            <span>
                DAIRY FARM
            </span>

            <span class="dairy-h1-label-line"></span>

        </div>


        <!-- =================================================
             FARM NAME
        ================================================== -->

        <h1 class="dairy-h1-title">

            Welcome to

            <span>
                <%= dairy.name || "Our Dairy Farm" %>
            </span>

        </h1>


        <!-- =================================================
             FARM CODE
        ================================================== -->

        <% if (
            dairy &&
            dairy.code !== null &&
            dairy.code !== undefined
        ) { %>

            <div class="dairy-h1-code">
                FARM #<%= dairy.code %>
            </div>

        <% } %>


        <!-- =================================================
             INTRODUCTORY MESSAGE
        ================================================== -->

        <div class="dairy-h1-message">

            <p>
                Welcome to
                <strong>
                    <%= dairy.name || "this dairy farm" %>
                </strong>.
                We're glad to have you here.
            </p>

            <p>
                Support the activities here by updating
                us about the welfare of all assets within
                the dairy farm.
            </p>

            <p>
                In case of any inconveniences, keep us
                updated on this site.
            </p>

        </div>


        <!-- =================================================
             FARM VALUES
        ================================================== -->

        <div class="dairy-h1-values">


            <!-- =============================================
                 ANIMAL WELFARE
            ============================================== -->

            <div class="dairy-h1-value">

                <span
                    class="dairy-h1-value-icon"
                    aria-hidden="true"
                >
                    ♧
                </span>

                <div>

                    <strong>
                        Animal Welfare
                    </strong>

                    <span>
                        Care for every animal
                    </span>

                </div>

            </div>


            <!-- =============================================
                 FARM ASSETS
            ============================================== -->

            <div class="dairy-h1-value">

                <span
                    class="dairy-h1-value-icon"
                    aria-hidden="true"
                >
                    ◈
                </span>

                <div>

                    <strong>
                        Farm Assets
                    </strong>

                    <span>
                        Maintain every resource
                    </span>

                </div>

            </div>


            <!-- =============================================
                 STAY UPDATED
            ============================================== -->

            <div class="dairy-h1-value">

                <span
                    class="dairy-h1-value-icon"
                    aria-hidden="true"
                >
                    ↗
                </span>

                <div>

                    <strong>
                        Stay Updated
                    </strong>

                    <span>
                        Keep the farm informed
                    </span>

                </div>

            </div>


        </div>


    </div>

</section>


<!-- =========================================================
     DAIRY H1 STYLES
========================================================= -->

<style>


/* =========================================================
   MAIN HERO

   No card.
   No image.
   No rounded container.
   No outer shadow.
========================================================= */

.dairy-h1 {

    position: relative;

    width: 100%;

    min-height: 520px;

    margin: 0 0 35px;

    overflow: hidden;

    background: #ffffff;

}


/* =========================================================
   TYPOGRAPHIC BACKGROUND
========================================================= */

.dairy-h1-background {

    position: absolute;

    inset: 0;

    z-index: 0;

    overflow: hidden;

    pointer-events: none;

}


/* =========================================================
   SINGLE DIAGONAL TEXT

   The entire phrase runs from bottom-left toward
   top-right.

   It is intentionally oversized so that the
   typography becomes part of the visual design.
========================================================= */

.dairy-h1-diagonal-text {

    position: absolute;

    left: -9%;

    bottom: 2%;

    display: flex;

    align-items: baseline;

    gap: 22px;

    white-space: nowrap;

    transform:
        rotate(-18deg);

    transform-origin:
        left bottom;

    font-family:
        Georgia,
        "Times New Roman",
        serif;

    font-weight: 900;

    line-height: .85;

    color:
        rgba(46, 92, 57, .13);

}


/* =========================================================
   CFP

   Slightly smaller than the farm name to create
   a refined typographic hierarchy.
========================================================= */

.dairy-h1-cfp {

    font-size:
        clamp(
            72px,
            11vw,
            155px
        );

    letter-spacing:
        -5px;

}


/* =========================================================
   FARM NAME

   This is the dominant part of the diagonal.
========================================================= */

.dairy-h1-dairy-name {

    font-size:
        clamp(
            82px,
            13vw,
            185px
        );

    letter-spacing:
        -6px;

    text-transform:
        uppercase;

}


/* =========================================================
   SUBTLE TYPOGRAPHIC DEPTH

   Keeps the text visible without competing heavily
   with the actual introduction.
========================================================= */

.dairy-h1-diagonal-text::after {

    content: "";

    position: absolute;

    left: 4%;

    bottom: -10px;

    width: 55%;

    height: 2px;

    background:
        rgba(46, 92, 57, .10);

}


/* =========================================================
   MAIN CONTENT

   Content remains above the diagonal typography.
========================================================= */

.dairy-h1-content {

    position: relative;

    z-index: 2;

    width: 100%;

    max-width: 1180px;

    min-height: 520px;

    margin: 0 auto;

    padding:
        clamp(50px, 7vw, 80px)
        clamp(24px, 6vw, 70px)
        50px;

    box-sizing: border-box;

    display: flex;

    flex-direction: column;

    justify-content: center;

    align-items: flex-start;

}


/* =========================================================
   LABEL
========================================================= */

.dairy-h1-label {

    display: flex;

    align-items: center;

    gap: 10px;

    margin-bottom: 16px;

    color: #456b4d;

    font-size: 10px;

    font-weight: 900;

    letter-spacing: 2.8px;

}


.dairy-h1-label-line {

    display: block;

    width: 30px;

    height: 1px;

    background:
        rgba(69, 107, 77, .70);

}


/* =========================================================
   TITLE
========================================================= */

.dairy-h1-title {

    max-width: 820px;

    margin: 0;

    font-family:
        Georgia,
        "Times New Roman",
        serif;

    font-size:
        clamp(
            36px,
            5vw,
            64px
        );

    line-height: 1.04;

    letter-spacing: -1.5px;

    font-weight: 800;

    color: #243b2b;

}


/* =========================================================
   FARM NAME
========================================================= */

.dairy-h1-title span {

    display: block;

    margin-top: 6px;

    color: #3e6949;

}


/* =========================================================
   FARM CODE
========================================================= */

.dairy-h1-code {

    margin-top: 13px;

    color: #4f7658;

    font-size: 9px;

    font-weight: 900;

    letter-spacing: 1.7px;

    text-transform: uppercase;

}


/* =========================================================
   MESSAGE
========================================================= */

.dairy-h1-message {

    max-width: 680px;

    margin-top: 26px;

}


.dairy-h1-message p {

    margin: 0 0 10px;

    color:
        rgba(39, 59, 45, .84);

    font-size:
        clamp(
            13px,
            1.5vw,
            15px
        );

    line-height: 1.7;

    font-weight: 400;

}


.dairy-h1-message p:last-child {

    margin-bottom: 0;

}


.dairy-h1-message strong {

    color: #3d6948;

    font-weight: 800;

}


/* =========================================================
   VALUES
========================================================= */

.dairy-h1-values {

    width: 100%;

    max-width: 800px;

    display: grid;

    grid-template-columns:
        repeat(3, minmax(0, 1fr));

    margin-top: 34px;

}


/* =========================================================
   VALUE ITEM
========================================================= */

.dairy-h1-value {

    min-width: 0;

    display: flex;

    align-items: center;

    gap: 11px;

    padding:
        4px 18px 4px 0;

}


/* =========================================================
   SEPARATOR
========================================================= */

.dairy-h1-value + .dairy-h1-value {

    padding-left: 18px;

    border-left:
        1px solid
        rgba(60, 100, 70, .22);

}


/* =========================================================
   VALUE ICON
========================================================= */

.dairy-h1-value-icon {

    flex: 0 0 34px;

    width: 34px;

    height: 34px;

    display: flex;

    align-items: center;

    justify-content: center;

    border-radius: 50%;

    border:
        1px solid
        rgba(60, 100, 70, .35);

    color: #477451;

    font-size: 17px;

}


/* =========================================================
   VALUE TEXT
========================================================= */

.dairy-h1-value div {

    min-width: 0;

}


.dairy-h1-value strong {

    display: block;

    margin-bottom: 3px;

    color: #365d40;

    font-size: 11px;

    font-weight: 900;

}


.dairy-h1-value span:not(.dairy-h1-value-icon) {

    display: block;

    color:
        rgba(53, 78, 59, .66);

    font-size: 9px;

    line-height: 1.35;

}


/* =========================================================
   LARGE SCREENS
========================================================= */

@media (min-width: 1400px) {

    .dairy-h1 {

        min-height: 560px;

    }


    .dairy-h1-content {

        min-height: 560px;

        padding-left: 80px;

        padding-right: 80px;

    }


    .dairy-h1-message {

        max-width: 720px;

    }


    .dairy-h1-diagonal-text {

        left: -5%;

        bottom: 4%;

    }

}


/* =========================================================
   TABLETS
========================================================= */

@media (max-width: 900px) {

    .dairy-h1 {

        min-height: 500px;

    }


    .dairy-h1-content {

        min-height: 500px;

    }


    .dairy-h1-diagonal-text {

        left: -16%;

        bottom: 5%;

        gap: 15px;

    }


    .dairy-h1-cfp {

        font-size: 80px;

    }


    .dairy-h1-dairy-name {

        font-size: 100px;

    }

}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 650px) {

    .dairy-h1 {

        min-height: 620px;

        margin-bottom: 25px;

    }


    /* ================================================
       DIAGONAL TYPOGRAPHY

       Kept deliberately large so that the phrase
       crosses the visible center of the phone.
    ================================================= */

    .dairy-h1-diagonal-text {

        left: -42%;

        bottom: 8%;

        gap: 10px;

        transform:
            rotate(-18deg);

    }


    .dairy-h1-cfp {

        font-size: 72px;

        letter-spacing: -4px;

    }


    .dairy-h1-dairy-name {

        font-size: 82px;

        letter-spacing: -4px;

    }


    /* ================================================
       CONTENT
    ================================================= */

    .dairy-h1-content {

        min-height: 620px;

        padding:
            42px
            20px
            35px;

        justify-content: center;

    }


    /* ================================================
       LABEL
    ================================================= */

    .dairy-h1-label {

        font-size: 9px;

        letter-spacing: 2px;

    }


    /* ================================================
       TITLE
    ================================================= */

    .dairy-h1-title {

        font-size:
            clamp(
                32px,
                10vw,
                43px
            );

        letter-spacing: -.8px;

    }


    /* ================================================
       MESSAGE
    ================================================= */

    .dairy-h1-message {

        margin-top: 21px;

    }


    .dairy-h1-message p {

        font-size: 13px;

        line-height: 1.65;

        margin-bottom: 9px;

    }


    /* ================================================
       VALUES
    ================================================= */

    .dairy-h1-values {

        grid-template-columns: 1fr;

        gap: 0;

        margin-top: 25px;

    }


    .dairy-h1-value {

        padding:
            9px 0;

    }


    .dairy-h1-value + .dairy-h1-value {

        padding-left: 0;

        border-left: none;

        border-top:
            1px solid
            rgba(60, 100, 70, .18);

    }


    .dairy-h1-value-icon {

        flex-basis: 31px;

        width: 31px;

        height: 31px;

        font-size: 15px;

    }

}


/* =========================================================
   VERY SMALL PHONES
========================================================= */

@media (max-width: 380px) {

    .dairy-h1 {

        min-height: 650px;

    }


    .dairy-h1-content {

        min-height: 650px;

        padding-left: 16px;

        padding-right: 16px;

    }


    .dairy-h1-title {

        font-size: 30px;

    }


    .dairy-h1-message p {

        font-size: 12px;

    }


    .dairy-h1-diagonal-text {

        left: -48%;

        bottom: 9%;

        gap: 7px;

    }


    .dairy-h1-cfp {

        font-size: 62px;

    }


    .dairy-h1-dairy-name {

        font-size: 70px;

    }

}

</style>