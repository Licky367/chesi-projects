<% /* ==========================================================
DAIRY FARM INTRODUCTION / H1

FILE:
views/update/h1.ejs

PURPOSE:
Editorial-style introductory hero section for a Dairy Farm.

BACKGROUND:
No image.

The background is generated entirely with typography:
"CFP <%= dairy.name %>"

DATA REQUIRED:
dairy

========================================================== */ %>

<section
    class="dairy-h1"
    aria-label="Dairy Farm Introduction"
>


    <!-- =====================================================
         TYPOGRAPHIC BACKGROUND
    ====================================================== -->

    <div
        class="dairy-h1-typography"
        aria-hidden="true"
    >

        <div class="dairy-h1-type-row row-1">
            CFP <%= dairy.name || "DAIRY FARM" %>
        </div>

        <div class="dairy-h1-type-row row-2">
            CFP <%= dairy.name || "DAIRY FARM" %>
        </div>

        <div class="dairy-h1-type-row row-3">
            CFP <%= dairy.name || "DAIRY FARM" %>
        </div>

        <div class="dairy-h1-type-row row-4">
            CFP <%= dairy.name || "DAIRY FARM" %>
        </div>

        <div class="dairy-h1-type-row row-5">
            CFP <%= dairy.name || "DAIRY FARM" %>
        </div>

        <div class="dairy-h1-type-row row-6">
            CFP <%= dairy.name || "DAIRY FARM" %>
        </div>

        <div class="dairy-h1-type-row row-7">
            CFP <%= dairy.name || "DAIRY FARM" %>
        </div>

    </div>


    <!-- =====================================================
         COLOUR / READABILITY OVERLAY
    ====================================================== -->

    <div
        class="dairy-h1-overlay"
        aria-hidden="true"
    ></div>


    <!-- =====================================================
         DECORATIVE BRAND MARK
    ====================================================== -->

    <div
        class="dairy-h1-brand"
        aria-hidden="true"
    >
        CFP
    </div>


    <!-- =====================================================
         MAIN CONTENT
    ====================================================== -->

    <div class="dairy-h1-content">


        <!-- =================================================
             SMALL LABEL
        ================================================== -->

        <div class="dairy-h1-label">

            <span class="dairy-h1-label-line"></span>

            <span>
                DAIRY FARM
            </span>

            <span class="dairy-h1-label-line"></span>

        </div>


        <!-- =================================================
             FARM NAME
        ================================================== -->

        <h1 class="dairy-h1-title">

            Welcome to

            <span>
                <%= dairy.name || "Our Dairy Farm" %>
            </span>

        </h1>


        <!-- =================================================
             FARM CODE
        ================================================== -->

        <% if (
            dairy &&
            dairy.code !== null &&
            dairy.code !== undefined
        ) { %>

            <div class="dairy-h1-code">

                FARM #<%= dairy.code %>

            </div>

        <% } %>


        <!-- =================================================
             INTRODUCTORY MESSAGE
        ================================================== -->

        <div class="dairy-h1-message">

            <p>
                Welcome to
                <strong>
                    <%= dairy.name || "this dairy farm" %>
                </strong>.
                We're glad to have you here.
            </p>

            <p>
                Support the activities here by updating
                us about the welfare of all assets within
                the dairy farm.
            </p>

            <p>
                In case of any inconveniences, keep us
                updated on this site.
            </p>

        </div>


        <!-- =================================================
             FARM VALUES
        ================================================== -->

        <div class="dairy-h1-values">


            <!-- =============================================
                 ANIMAL WELFARE
            ============================================== -->

            <div class="dairy-h1-value">

                <span
                    class="dairy-h1-value-icon"
                    aria-hidden="true"
                >
                    ♧
                </span>

                <div>

                    <strong>
                        Animal Welfare
                    </strong>

                    <span>
                        Care for every animal
                    </span>

                </div>

            </div>


            <!-- =============================================
                 FARM ASSETS
            ============================================== -->

            <div class="dairy-h1-value">

                <span
                    class="dairy-h1-value-icon"
                    aria-hidden="true"
                >
                    ◈
                </span>

                <div>

                    <strong>
                        Farm Assets
                    </strong>

                    <span>
                        Maintain every resource
                    </span>

                </div>

            </div>


            <!-- =============================================
                 STAY UPDATED
            ============================================== -->

            <div class="dairy-h1-value">

                <span
                    class="dairy-h1-value-icon"
                    aria-hidden="true"
                >
                    ↗
                </span>

                <div>

                    <strong>
                        Stay Updated
                    </strong>

                    <span>
                        Keep the farm informed
                    </span>

                </div>

            </div>


        </div>


    </div>

</section>


<!-- =========================================================
     DAIRY H1 STYLES
========================================================= -->

<style>

/* =========================================================
   MAIN HERO

   This is NOT a card.

   No:
   - image
   - border radius
   - shadow
   - visible container border
========================================================= */

.dairy-h1{

    position:relative;

    width:100%;

    min-height:520px;

    margin:0 0 35px;

    overflow:hidden;

    background:
        linear-gradient(
            135deg,
            #eef0e6 0%,
            #e5e8dc 45%,
            #d9ddcf 100%
        );

}


/* =========================================================
   TYPOGRAPHIC BACKGROUND

   Large diagonal CFP farm-name typography.
========================================================= */

.dairy-h1-typography{

    position:absolute;

    inset:-30% -20%;

    z-index:0;

    overflow:hidden;

    transform:
        rotate(-17deg)
        scale(1.08);

    pointer-events:none;

}


/* =========================================================
   BACKGROUND TEXT ROWS
========================================================= */

.dairy-h1-type-row{

    position:absolute;

    white-space:nowrap;

    font-family:
        Georgia,
        "Times New Roman",
        serif;

    font-size:
        clamp(
            55px,
            8vw,
            125px
        );

    line-height:.95;

    font-weight:900;

    letter-spacing:
        -4px;

    text-transform:
        uppercase;

    user-select:none;

}


/* =========================================================
   ROW POSITIONS
========================================================= */

.dairy-h1-type-row.row-1{

    top:3%;

    left:-12%;

    color:
        rgba(43,75,45,.16);

}


.dairy-h1-type-row.row-2{

    top:17%;

    left:3%;

    color:
        rgba(112,91,48,.13);

}


.dairy-h1-type-row.row-3{

    top:31%;

    left:-10%;

    color:
        rgba(43,75,45,.20);

}


.dairy-h1-type-row.row-4{

    top:45%;

    left:4%;

    color:
        rgba(112,91,48,.14);

}


.dairy-h1-type-row.row-5{

    top:59%;

    left:-13%;

    color:
        rgba(43,75,45,.17);

}


.dairy-h1-type-row.row-6{

    top:73%;

    left:2%;

    color:
        rgba(112,91,48,.12);

}


.dairy-h1-type-row.row-7{

    top:87%;

    left:-11%;

    color:
        rgba(43,75,45,.18);

}


/* =========================================================
   TEXTUAL DEPTH

   Gives the typography a more designed appearance.
========================================================= */

.dairy-h1-type-row::first-letter{

    color:
        rgba(38,72,41,.24);

}


/* =========================================================
   READABILITY OVERLAY

   Keeps the background visible while protecting
   the foreground content.
========================================================= */

.dairy-h1-overlay{

    position:absolute;

    inset:0;

    z-index:1;

    background:

        linear-gradient(
            90deg,

            rgba(237,240,229,.96) 0%,

            rgba(237,240,229,.88) 35%,

            rgba(237,240,229,.64) 62%,

            rgba(237,240,229,.48) 100%
        );


}


/* =========================================================
   DECORATIVE CFP BRAND

   Large subtle CFP watermark.
========================================================= */

.dairy-h1-brand{

    position:absolute;

    z-index:1;

    right:
        clamp(
            20px,
            7vw,
            100px
        );

    top:
        clamp(
            20px,
            5vw,
            65px
        );

    font-family:
        Georgia,
        "Times New Roman",
        serif;

    font-size:
        clamp(
            60px,
            11vw,
            150px
        );

    line-height:1;

    font-weight:900;

    letter-spacing:
        -7px;

    color:
        rgba(39,75,43,.10);

    pointer-events:none;

    user-select:none;

}


/* =========================================================
   CONTENT
========================================================= */

.dairy-h1-content{

    position:relative;

    z-index:3;

    width:100%;

    max-width:1180px;

    min-height:520px;

    margin:0 auto;

    padding:
        clamp(50px, 7vw, 80px)
        clamp(24px, 6vw, 70px)
        50px;

    box-sizing:border-box;

    display:flex;

    flex-direction:column;

    justify-content:center;

    align-items:flex-start;

}


/* =========================================================
   LABEL
========================================================= */

.dairy-h1-label{

    display:flex;

    align-items:center;

    gap:10px;

    margin-bottom:16px;

    color:#53633f;

    font-size:10px;

    font-weight:900;

    letter-spacing:2.8px;

}


.dairy-h1-label-line{

    display:block;

    width:30px;

    height:1px;

    background:
        #71805c;

}


/* =========================================================
   TITLE
========================================================= */

.dairy-h1-title{

    max-width:820px;

    margin:0;

    font-family:
        Georgia,
        "Times New Roman",
        serif;

    font-size:
        clamp(
            36px,
            5vw,
            64px
        );

    line-height:1.04;

    letter-spacing:-1.5px;

    font-weight:800;

    color:#263b29;

}


/* =========================================================
   FARM NAME
========================================================= */

.dairy-h1-title span{

    display:block;

    margin-top:6px;

    color:#796238;

}


/* =========================================================
   FARM CODE
========================================================= */

.dairy-h1-code{

    margin-top:13px;

    color:#66714d;

    font-size:9px;

    font-weight:900;

    letter-spacing:1.7px;

    text-transform:uppercase;

}


/* =========================================================
   MESSAGE
========================================================= */

.dairy-h1-message{

    max-width:680px;

    margin-top:26px;

}


.dairy-h1-message p{

    margin:0 0 10px;

    color:
        rgba(39,52,39,.84);

    font-size:
        clamp(
            13px,
            1.5vw,
            15px
        );

    line-height:1.7;

    font-weight:400;

}


.dairy-h1-message p:last-child{

    margin-bottom:0;

}


.dairy-h1-message strong{

    color:#4c623f;

    font-weight:800;

}


/* =========================================================
   VALUES
========================================================= */

.dairy-h1-values{

    width:100%;

    max-width:800px;

    display:grid;

    grid-template-columns:
        repeat(3, minmax(0,1fr));

    margin-top:34px;

}


/* =========================================================
   VALUE
========================================================= */

.dairy-h1-value{

    min-width:0;

    display:flex;

    align-items:center;

    gap:11px;

    padding:
        4px 18px 4px 0;

}


/* =========================================================
   VALUE SEPARATORS
========================================================= */

.dairy-h1-value + .dairy-h1-value{

    padding-left:18px;

    border-left:
        1px solid
        rgba(75,91,60,.25);

}


/* =========================================================
   VALUE ICON
========================================================= */

.dairy-h1-value-icon{

    flex:0 0 34px;

    width:34px;

    height:34px;

    display:flex;

    align-items:center;

    justify-content:center;

    border-radius:50%;

    border:
        1px solid
        rgba(78,99,63,.38);

    color:#5c714d;

    font-size:17px;

}


/* =========================================================
   VALUE TEXT
========================================================= */

.dairy-h1-value div{

    min-width:0;

}


.dairy-h1-value strong{

    display:block;

    margin-bottom:3px;

    color:#3e5138;

    font-size:11px;

    font-weight:900;

}


.dairy-h1-value span:not(.dairy-h1-value-icon){

    display:block;

    color:
        rgba(53,67,51,.66);

    font-size:9px;

    line-height:1.35;

}


/* =========================================================
   LARGE SCREENS
========================================================= */

@media(min-width:1400px){

    .dairy-h1{

        min-height:560px;

    }


    .dairy-h1-content{

        min-height:560px;

        padding-left:80px;

        padding-right:80px;

    }


    .dairy-h1-message{

        max-width:720px;

    }

}


/* =========================================================
   TABLETS
========================================================= */

@media(max-width:900px){

    .dairy-h1{

        min-height:500px;

    }


    .dairy-h1-content{

        min-height:500px;

    }


    .dairy-h1-type-row{

        font-size:
            clamp(
                48px,
                9vw,
                90px
            );

    }


    .dairy-h1-overlay{

        background:
            linear-gradient(
                90deg,

                rgba(237,240,229,.95) 0%,

                rgba(237,240,229,.82) 55%,

                rgba(237,240,229,.58) 100%
            );

    }

}


/* =========================================================
   MOBILE
========================================================= */

@media(max-width:650px){

    .dairy-h1{

        min-height:620px;

        margin-bottom:25px;

    }


    .dairy-h1-content{

        min-height:620px;

        padding:
            42px
            20px
            35px;

        justify-content:center;

    }


    /* ================================================
       DIAGONAL TYPOGRAPHY
    ================================================ */

    .dairy-h1-typography{

        inset:-20% -80%;

        transform:
            rotate(-17deg)
            scale(1.15);

    }


    .dairy-h1-type-row{

        font-size:
            54px;

        letter-spacing:
            -2px;

    }


    .dairy-h1-overlay{

        background:
            linear-gradient(
                180deg,

                rgba(237,240,229,.88) 0%,

                rgba(237,240,229,.91) 50%,

                rgba(231,234,223,.96) 100%
            );

    }


    /* ================================================
       BRAND WATERMARK
    ================================================ */

    .dairy-h1-brand{

        right:15px;

        top:18px;

        font-size:75px;

        letter-spacing:-4px;

    }


    /* ================================================
       LABEL
    ================================================ */

    .dairy-h1-label{

        font-size:9px;

        letter-spacing:2px;

    }


    /* ================================================
       TITLE
    ================================================ */

    .dairy-h1-title{

        font-size:
            clamp(
                32px,
                10vw,
                43px
            );

        letter-spacing:-.8px;

    }


    /* ================================================
       MESSAGE
    ================================================ */

    .dairy-h1-message{

        margin-top:21px;

    }


    .dairy-h1-message p{

        font-size:13px;

        line-height:1.65;

        margin-bottom:9px;

    }


    /* ================================================
       VALUES
    ================================================ */

    .dairy-h1-values{

        grid-template-columns:1fr;

        gap:0;

        margin-top:25px;

    }


    .dairy-h1-value{

        padding:
            9px 0;

    }


    .dairy-h1-value + .dairy-h1-value{

        padding-left:0;

        border-left:none;

        border-top:
            1px solid
            rgba(75,91,60,.20);

    }


    .dairy-h1-value-icon{

        flex-basis:31px;

        width:31px;

        height:31px;

        font-size:15px;

    }

}


/* =========================================================
   VERY SMALL PHONES
========================================================= */

@media(max-width:380px){

    .dairy-h1{

        min-height:650px;

    }


    .dairy-h1-content{

        min-height:650px;

        padding-left:16px;

        padding-right:16px;

    }


    .dairy-h1-title{

        font-size:30px;

    }


    .dairy-h1-message p{

        font-size:12px;

    }


    .dairy-h1-type-row{

        font-size:46px;

    }

}

</style>