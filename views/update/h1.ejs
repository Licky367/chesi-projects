<% /*
==========================================================
DAIRY FARM INTRODUCTION / H1

FILE:
views/update/h1.ejs

PURPOSE:
Compact editorial introductory section for a Dairy Farm.

DATA REQUIRED:
dairy

==========================================================
*/ %>

<section
    class="dairy-h1"
    aria-label="Dairy Farm Introduction"
>

    <!-- =================================================
         BACKGROUND LOGO
    ================================================== -->

    <div
        class="dairy-h1-background"
        aria-hidden="true"
    >
        <img
            src="/images/h1.png"
            alt=""
            class="dairy-h1-logo"
        >
    </div>


    <!-- =================================================
         CONTENT
    ================================================== -->

    <div class="dairy-h1-content">

        <div class="dairy-h1-label">
            <span class="dairy-h1-label-line"></span>
            <span>DAIRY FARM</span>
            <span class="dairy-h1-label-line"></span>
        </div>


        <h1 class="dairy-h1-title">
            Welcome to
            <span>
                <%= dairy.name || "Our Dairy Farm" %>
            </span>
        </h1>


        <% if (dairy && dairy.code != null) { %>

            <div class="dairy-h1-code">
                FARM #<%= dairy.code %>
            </div>

        <% } %>


        <div class="dairy-h1-message">

            <p>
                Welcome to
                <strong>
                    <%= dairy.name || "this dairy farm" %>
                </strong>.
                We're glad to have you here.
            </p>

            <p>
                Support the activities here by updating us
                about the welfare of all assets within the
                dairy farm.
            </p>

            <p>
                In case of any inconveniences, keep us
                updated on this site.
            </p>

        </div>

    </div>

</section>


<style>

/* =========================================================
   MAIN CARD
========================================================= */

.dairy-h1 {

    position: relative;

    width: calc(100% - 24px);
    max-width: 1180px;

    min-height: 350px;

    margin: 12px auto 28px;

    overflow: hidden;

    border-radius: 22px;

    /*
       Main visual accent:
       thick green left border.
    */
    border-left: 7px solid #4d8a5d;

    /*
       Almost white background.
       Only a very subtle green tint.
    */
    background:
        radial-gradient(
            circle at 50% 45%,
            #ffffff 0%,
            #fcfefc 55%,
            #f3faf4 100%
        );

    box-shadow:
        0 8px 24px rgba(42, 78, 51, .09),
        inset 0 0 18px rgba(76, 135, 88, .035);

}


/* =========================================================
   SUBTLE INNER EDGE
========================================================= */

.dairy-h1::after {

    content: "";

    position: absolute;

    inset: 0;

    z-index: 1;

    pointer-events: none;

    border-radius: inherit;

    box-shadow:
        inset 0 0 22px rgba(55, 105, 67, .045);

}


/* =========================================================
   BACKGROUND LOGO
========================================================= */

.dairy-h1-background {

    position: absolute;

    inset: 0;

    z-index: 0;

    display: flex;

    align-items: center;

    justify-content: center;

    overflow: hidden;

    pointer-events: none;

}


.dairy-h1-logo {

    display: block;

    width: min(680px, 105vw);

    height: auto;

    /*
       Extremely subtle logo.
    */
    opacity: .035;

    filter:
        saturate(.6)
        contrast(.85);

}


/* =========================================================
   CONTENT
========================================================= */

.dairy-h1-content {

    position: relative;

    z-index: 2;

    width: 100%;

    min-height: 350px;

    padding:
        34px
        clamp(22px, 5vw, 60px)
        30px;

    box-sizing: border-box;

    display: flex;

    flex-direction: column;

    justify-content: center;

    align-items: flex-start;

}


/* =========================================================
   LABEL
========================================================= */

.dairy-h1-label {

    display: flex;

    align-items: center;

    gap: 9px;

    margin-bottom: 11px;

    color: #386247;

    font-family:
        Arial,
        Helvetica,
        sans-serif;

    font-size: 9px;

    font-weight: 800;

    letter-spacing: 2.5px;

}


.dairy-h1-label-line {

    width: 27px;

    height: 1px;

    background:
        rgba(56, 98, 71, .62);

}


/* =========================================================
   TITLE
========================================================= */

.dairy-h1-title {

    max-width: 820px;

    margin: 0;

    color: #263f2e;

    font-family:
        Georgia,
        "Times New Roman",
        serif;

    font-size:
        clamp(34px, 4.5vw, 56px);

    line-height: 1.02;

    letter-spacing: -1.3px;

    font-weight: 700;

}


.dairy-h1-title span {

    display: block;

    margin-top: 4px;

    color: #37694a;

}


/* =========================================================
   FARM CODE
========================================================= */

.dairy-h1-code {

    margin-top: 9px;

    color: #52775b;

    font-family:
        Arial,
        Helvetica,
        sans-serif;

    font-size: 8px;

    font-weight: 800;

    letter-spacing: 1.6px;

    text-transform: uppercase;

}


/* =========================================================
   MESSAGE
========================================================= */

.dairy-h1-message {

    max-width: 650px;

    margin-top: 18px;

}


.dairy-h1-message p {

    margin: 0 0 7px;

    color:
        rgba(39, 65, 47, .86);

    font-family:
        Arial,
        Helvetica,
        sans-serif;

    font-size:
        clamp(12px, 1.35vw, 14px);

    line-height: 1.55;

    font-weight: 400;

}


.dairy-h1-message p:last-child {

    margin-bottom: 0;

}


.dairy-h1-message strong {

    color: #356647;

    font-weight: 700;

}


/* =========================================================
   TABLETS
========================================================= */

@media (max-width: 900px) {

    .dairy-h1 {

        width: calc(100% - 20px);

        min-height: 340px;

        border-radius: 20px;

        border-left-width: 7px;

    }


    .dairy-h1-content {

        min-height: 340px;

        padding:
            32px
            28px
            29px;

    }


    .dairy-h1-logo {

        width: min(620px, 110vw);

    }

}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 650px) {

    .dairy-h1 {

        width: calc(100% - 18px);

        min-height: 370px;

        margin:
            9px
            auto
            22px;

        border-radius: 18px;

        border-left-width: 6px;

        background:
            radial-gradient(
                circle at 50% 45%,
                #ffffff 0%,
                #fdfefd 60%,
                #f5faf6 100%
            );

        box-shadow:
            0 7px 20px rgba(42, 78, 51, .08),
            inset 0 0 15px rgba(76, 135, 88, .03);

    }


    .dairy-h1-content {

        min-height: 370px;

        padding:
            29px
            20px
            27px;

    }


    .dairy-h1-logo {

        width: 520px;

        max-width: 130vw;

        opacity: .03;

    }


    .dairy-h1-label {

        margin-bottom: 10px;

        font-size: 8px;

        letter-spacing: 2px;

    }


    .dairy-h1-title {

        font-size:
            clamp(30px, 9vw, 41px);

        letter-spacing: -.8px;

    }


    .dairy-h1-title span {

        margin-top: 3px;

    }


    .dairy-h1-code {

        margin-top: 8px;

        font-size: 7.5px;

    }


    .dairy-h1-message {

        margin-top: 17px;

    }


    .dairy-h1-message p {

        font-size: 12.5px;

        line-height: 1.55;

        margin-bottom: 6px;

    }

}


/* =========================================================
   VERY SMALL PHONES
========================================================= */

@media (max-width: 380px) {

    .dairy-h1 {

        width: calc(100% - 14px);

        min-height: 355px;

        border-radius: 16px;

        border-left-width: 6px;

    }


    .dairy-h1-content {

        min-height: 355px;

        padding:
            26px
            16px
            24px;

    }


    .dairy-h1-title {

        font-size: 29px;

    }


    .dairy-h1-message {

        margin-top: 15px;

    }


    .dairy-h1-message p {

        font-size: 12px;

        line-height: 1.5;

    }


    .dairy-h1-logo {

        width: 470px;

    }

}

</style>