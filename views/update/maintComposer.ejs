<!-- =========================================================
     MAINTENANCE COMPOSER + FULL SCREEN MAINTENANCE MODAL

     FILE:
         views/update/maintComposer.ejs

     PURPOSE:
         Allows admin/dairyWorker to report maintenance
         required for a facility, equipment, or tool.

     EXPECTED VARIABLES:
         user
         dairy
========================================================= -->


<!-- =========================================================
     MAINTENANCE COMPOSER CARD
========================================================= -->

<section class="maint-composer-card">


    <!-- =====================================================
         HEADER
    ====================================================== -->

    <div class="maint-composer-header">


        <!-- USER AVATAR -->

        <div class="maint-composer-avatar">

            <img
                src="<%= user.profileImage || ('https://ui-avatars.com/api/?name=' + encodeURIComponent(user.name)) %>"
                alt="<%= user.name %>"
                class="maint-avatar-sm"
            >

        </div>


        <!-- HEADING -->

        <div class="maint-composer-heading">

            <div class="maint-heading-line">

                <strong>
                    <%= user.name.split(" ")[0] %>
                </strong>

                , does this facility/equipment/tool require
                any maintenance?

            </div>

        </div>

    </div>



    <!-- =====================================================
         CLICKABLE MAINTENANCE TRIGGER
    ====================================================== -->

    <div
        id="openMaintComposer"
        class="maint-composer-trigger"
        role="button"
        tabindex="0"
        aria-label="Report maintenance"
    >

        <span>

            🔧 Report maintenance...

        </span>

    </div>


</section>



<!-- =========================================================
     FULL SCREEN MAINTENANCE MODAL
========================================================= -->

<div
    id="maintModal"
    class="maint-modal"
    aria-hidden="true"
>


    <div class="maint-modal-content">


        <!-- =================================================
             MODAL HEADER
        ================================================== -->

        <header class="maint-modal-header">


            <button
                type="button"
                id="closeMaintModal"
                class="maint-back-button"
                aria-label="Go back"
            >

                <i class="bi bi-arrow-left"></i>

            </button>


            <div class="maint-modal-title">

                <strong>
                    Maintenance Report
                </strong>

                <span>
                    <%= dairy.name %>
                </span>

            </div>


            <div class="maint-header-spacer"></div>


        </header>



        <!-- =================================================
             MODAL BODY
        ================================================== -->

        <main class="maint-modal-body">


            <!-- =================================================
                 QUESTION
            ================================================== -->

            <div class="maint-question">

                <strong>
                    <%= user.name.split(" ")[0] %>
                </strong>,

                does this facility/equipment/tool require
                any maintenance?

            </div>



            <!-- =================================================
                 FACILITY / EQUIPMENT / TOOL
            ================================================== -->

            <div class="maint-target">


                <% if (
                    dairy.profileImage &&
                    dairy.profileImage.trim() !== ""
                ) { %>


                    <img
                        src="/uploads/<%= dairy.profileImage %>"
                        class="maint-target-image"
                        alt="<%= dairy.name %>"
                    >


                <% } else { %>


                    <img
                        src="https://ui-avatars.com/api/?name=<%= encodeURIComponent(dairy.name) %>&background=0b5d1e&color=fff"
                        class="maint-target-image"
                        alt="<%= dairy.name %>"
                    >


                <% } %>


                <div class="maint-target-info">

                    <strong>
                        <%= dairy.name %>
                    </strong>

                    <span>
                        Maintenance required
                    </span>

                </div>


            </div>



            <!-- =================================================
                 MAINTENANCE FORM
            ================================================== -->

            <form
                id="maintForm"
                action="/dairy/<%= dairy._id %>/maintenance/mark"
                method="POST"
            >


                <!-- =============================================
                     MAINTENANCE TYPE
                ============================================== -->

                <div class="maint-field">

                    <label
                        for="maintType"
                    >

                        Maintenance type

                    </label>


                    <select
                        id="maintType"
                        name="type"
                        required
                    >

                        <option value="">
                            Select maintenance type
                        </option>

                        <option value="repair">
                            🔧 Repair
                        </option>

                        <option value="maintenance">
                            🛠️ Maintenance
                        </option>

                        <option value="construction">
                            🏗️ Construction
                        </option>

                    </select>

                </div>



                <!-- =============================================
                     DESCRIPTION
                ============================================== -->

                <div class="maint-field">

                    <label
                        for="maintDescription"
                    >

                        What needs attention?

                    </label>


                    <textarea
                        id="maintDescription"
                        name="description"
                        maxlength="1000"
                        placeholder="Describe the problem or maintenance required..."
                        required
                    ></textarea>


                    <div
                        id="maintCharacterCounter"
                        class="maint-character-counter"
                    >

                        0/1000

                    </div>

                </div>



                <!-- =============================================
                     SUBMIT
                ============================================== -->

                <div class="maint-submit-wrapper">

                    <button
                        type="submit"
                        id="submitMaintButton"
                        class="maint-submit-button"
                        disabled
                    >

                        <i class="bi bi-tools"></i>

                        Submit Maintenance Report

                    </button>

                </div>


            </form>


        </main>


    </div>

</div>



<!-- =========================================================
     CSS
========================================================= -->

<style>

/* =========================================================
   MAINTENANCE COMPOSER CARD
========================================================= */

.maint-composer-card {

    width: 100%;

    background: #ffffff;

    border-radius: 16px;

    padding: 16px;

    margin-bottom: 16px;

    box-sizing: border-box;

    border: 1px solid #e7eee9;

}


.maint-composer-header {

    display: flex;

    align-items: center;

    gap: 12px;

}


.maint-composer-avatar {

    flex-shrink: 0;

}


.maint-avatar-sm {

    width: 44px;
    height: 44px;

    border-radius: 50%;

    object-fit: cover;

    display: block;

}


.maint-composer-heading {

    min-width: 0;

    font-size: 14px;

    line-height: 1.5;

    color: #555;

}


.maint-heading-line {

    display: block;

}


.maint-composer-heading strong {

    color: #222;

}



/* =========================================================
   CLICKABLE TRIGGER
========================================================= */

.maint-composer-trigger {

    margin-top: 14px;

    min-height: 48px;

    padding: 0 16px;

    border: 1px solid #dfe8e2;

    border-radius: 24px;

    display: flex;

    align-items: center;

    color: #777;

    background: #f8faf8;

    cursor: pointer;

    transition:
        background 0.2s ease,
        border-color 0.2s ease,
        transform 0.15s ease;

}


.maint-composer-trigger:hover {

    background: #f1f7f3;

    border-color: #2e8b57;

}


.maint-composer-trigger:active {

    transform: scale(0.99);

}



/* =========================================================
   FULL SCREEN MODAL
========================================================= */

.maint-modal {

    position: fixed;

    inset: 0;

    width: 100vw;

    height: 100dvh;

    background: #ffffff;

    z-index: 99999;

    display: none;

    overflow: hidden;

}


.maint-modal.active {

    display: block;

}


.maint-modal-content {

    position: relative;

    width: 100%;

    height: 100%;

    display: flex;

    flex-direction: column;

    background: #ffffff;

}



/* =========================================================
   MODAL HEADER
========================================================= */

.maint-modal-header {

    flex: 0 0 auto;

    height: 64px;

    width: 100%;

    display: flex;

    align-items: center;

    padding: 0 16px;

    box-sizing: border-box;

    border-bottom: 1px solid #e8eee9;

    background: #ffffff;

}


.maint-back-button {

    width: 44px;

    height: 44px;

    border: none;

    background: transparent;

    color: #198754;

    display: flex;

    align-items: center;

    justify-content: center;

    cursor: pointer;

    font-size: 27px;

    padding: 0;

    flex-shrink: 0;

}


.maint-back-button:hover {

    color: #146c43;

}


.maint-modal-title {

    margin-left: 8px;

    display: flex;

    flex-direction: column;

    line-height: 1.25;

}


.maint-modal-title strong {

    font-size: 17px;

    color: #202520;

}


.maint-modal-title span {

    margin-top: 2px;

    font-size: 12px;

    color: #7a817d;

}


.maint-header-spacer {

    flex: 1;

}



/* =========================================================
   MODAL BODY
========================================================= */

.maint-modal-body {

    flex: 1 1 auto;

    min-height: 0;

    overflow-y: auto;

    padding: 20px;

    box-sizing: border-box;

}



/* =========================================================
   QUESTION
========================================================= */

.maint-question {

    margin-bottom: 20px;

    color: #202520;

    font-size: 20px;

    line-height: 1.45;

}


.maint-question strong {

    color: #198754;

}



/* =========================================================
   TARGET
========================================================= */

.maint-target {

    display: flex;

    align-items: center;

    gap: 12px;

    margin-bottom: 24px;

    padding: 12px;

    border: 1px solid #e1ebe4;

    border-radius: 14px;

    background: #f7faf8;

}


.maint-target-image {

    width: 52px;

    height: 52px;

    flex-shrink: 0;

    object-fit: cover;

    border-radius: 50%;

}


.maint-target-info {

    display: flex;

    flex-direction: column;

    min-width: 0;

}


.maint-target-info strong {

    color: #202520;

    font-size: 15px;

}


.maint-target-info span {

    margin-top: 3px;

    color: #7a817d;

    font-size: 12px;

}



/* =========================================================
   FORM
========================================================= */

#maintForm {

    width: 100%;

    margin: 0;

}


.maint-field {

    position: relative;

    margin-bottom: 20px;

}


.maint-field label {

    display: block;

    margin-bottom: 7px;

    color: #37413a;

    font-size: 13px;

    font-weight: 700;

}


.maint-field select,

.maint-field textarea {

    width: 100%;

    box-sizing: border-box;

    border: 1px solid #d6e0d9;

    border-radius: 12px;

    outline: none;

    background: #f8faf8;

    color: #202520;

    font-family: inherit;

    font-size: 15px;

}


.maint-field select {

    height: 48px;

    padding: 0 12px;

}


.maint-field textarea {

    min-height: 130px;

    resize: vertical;

    padding: 13px;

    padding-bottom: 28px;

    line-height: 1.5;

}


.maint-field select:focus,

.maint-field textarea:focus {

    border-color: #198754;

    background: #ffffff;

    box-shadow:
        0 0 0 3px
        rgba(25, 135, 84, 0.10);

}



/* =========================================================
   CHARACTER COUNTER
========================================================= */

.maint-character-counter {

    position: absolute;

    right: 10px;

    bottom: 8px;

    color: #89938d;

    font-size: 10px;

    pointer-events: none;

}



/* =========================================================
   SUBMIT
========================================================= */

.maint-submit-wrapper {

    width: 100%;

    margin-top: 6px;

}


.maint-submit-button {

    width: 100%;

    min-height: 50px;

    border: none;

    border-radius: 13px;

    background: #198754;

    color: #ffffff;

    font-family: inherit;

    font-size: 14px;

    font-weight: 700;

    cursor: pointer;

    display: flex;

    align-items: center;

    justify-content: center;

    gap: 8px;

    transition:
        background 0.2s ease,
        transform 0.15s ease;

}


.maint-submit-button:not(:disabled):hover {

    background: #146c43;

}


.maint-submit-button:not(:disabled):active {

    transform: scale(0.99);

}


.maint-submit-button:disabled {

    background: #b8c2bc;

    cursor: default;

}



/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 600px) {

    .maint-modal-header {

        height: 60px;

        padding: 0 10px;

    }


    .maint-modal-title strong {

        font-size: 16px;

    }


    .maint-modal-body {

        padding: 16px;

    }


    .maint-question {

        font-size: 18px;

    }

}


/* =========================================================
   SMALL PHONES
========================================================= */

@media (max-width: 380px) {

    .maint-modal-body {

        padding: 12px;

    }


    .maint-modal-title span {

        display: none;

    }

}

</style>



<!-- =========================================================
     JAVASCRIPT
========================================================= -->

<script>

(function () {

    "use strict";


    function initializeMaintenanceComposer() {


        const modal =
            document.getElementById("maintModal");

        const openButton =
            document.getElementById("openMaintComposer");

        const closeButton =
            document.getElementById("closeMaintModal");

        const typeInput =
            document.getElementById("maintType");

        const descriptionInput =
            document.getElementById("maintDescription");

        const characterCounter =
            document.getElementById("maintCharacterCounter");

        const submitButton =
            document.getElementById("submitMaintButton");

        const form =
            document.getElementById("maintForm");


        if (
            !modal ||
            !openButton ||
            !closeButton ||
            !typeInput ||
            !descriptionInput ||
            !characterCounter ||
            !submitButton ||
            !form
        ) {

            return;

        }



        /* =================================================
           OPEN
        ================================================== */

        function openModal() {

            modal.classList.add("active");

            modal.setAttribute(
                "aria-hidden",
                "false"
            );

            document.body.style.overflow =
                "hidden";


            setTimeout(function () {

                typeInput.focus();

            }, 100);

        }



        /* =================================================
           CLOSE
        ================================================== */

        function closeModal() {

            modal.classList.remove("active");

            modal.setAttribute(
                "aria-hidden",
                "true"
            );

            document.body.style.overflow =
                "";

        }



        /* =================================================
           VALIDATION
        ================================================== */

        function updateSubmitButton() {

            const validType =
                typeInput.value.trim() !== "";

            const validDescription =
                descriptionInput.value.trim().length > 0;

            submitButton.disabled =
                !(validType && validDescription);

        }



        /* =================================================
           CHARACTER COUNT
        ================================================== */

        function updateCharacterCounter() {

            const length =
                descriptionInput.value.length;

            characterCounter.textContent =
                length + "/1000";

        }



        /* =================================================
           OPEN EVENTS
        ================================================== */

        openButton.addEventListener(
            "click",
            openModal
        );


        openButton.addEventListener(
            "keydown",
            function (event) {

                if (
                    event.key === "Enter" ||
                    event.key === " "
                ) {

                    event.preventDefault();

                    openModal();

                }

            }
        );



        /* =================================================
           CLOSE EVENTS
        ================================================== */

        closeButton.addEventListener(
            "click",
            closeModal
        );


        document.addEventListener(
            "keydown",
            function (event) {

                if (
                    event.key === "Escape" &&
                    modal.classList.contains("active")
                ) {

                    closeModal();

                }

            }
        );



        /* =================================================
           INPUT EVENTS
        ================================================== */

        typeInput.addEventListener(
            "change",
            updateSubmitButton
        );


        descriptionInput.addEventListener(
            "input",
            function () {

                updateCharacterCounter();

                updateSubmitButton();

            }
        );



        /* =================================================
           FORM SUBMIT
        ================================================== */

        form.addEventListener(
            "submit",
            function () {

                submitButton.disabled = true;

                submitButton.innerHTML =
                    '<i class="bi bi-hourglass-split"></i> ' +
                    'Submitting...';

            }
        );



        /* =================================================
           INITIAL STATE
        ================================================== */

        updateCharacterCounter();

        updateSubmitButton();

    }



    /* =====================================================
       DOM READY
    ====================================================== */

    if (
        document.readyState === "loading"
    ) {

        document.addEventListener(
            "DOMContentLoaded",
            initializeMaintenanceComposer
        );

    } else {

        initializeMaintenanceComposer();

    }

})();

</script>