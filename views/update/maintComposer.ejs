<% /*
============================================================
MAINTENANCE COMPOSER

FILE:
    views/update/maintComposer.ejs

PURPOSE:
    Compact status-style card for reporting maintenance
    required for the CURRENT dairy asset.

CARD STANDARD:
    Matches create.ejs:

        Desktop:
            112px × 155px

        Mobile:
            108px × 150px

TARGET:
    The current dairy/asset is ALWAYS the target.

AUTHORIZED USERS:
    admin
    dairyWorker

CONDITION:
    Dairy must have NO code.

FORM:
    POST /dairy/:id/maintenance/mark
============================================================
*/ %>


<% if (
    dairy &&
    (
        dairy.code === null ||
        dairy.code === undefined
    ) &&
    user &&
    (
        user.role === "admin" ||
        user.role === "dairyWorker"
    )
) { %>


<!-- =========================================================
     MAINTENANCE CARD
========================================================= -->

<section
    class="maint-composer"
    aria-label="Report maintenance"
>


    <button
        type="button"
        id="openMaintComposer"
        class="maint-composer__card"
        aria-label="Report maintenance for <%= dairy.name %>"
    >


        <!-- =================================================
             ICON
        ================================================== -->

        <span
            class="maint-composer__icon"
            aria-hidden="true"
        >
            <i class="bi bi-tools"></i>
        </span>


        <!-- =================================================
             LABEL
        ================================================== -->

        <span class="maint-composer__label">
            Maintenance
        </span>


        <!-- =================================================
             TARGET
        ================================================== -->

        <span class="maint-composer__target">

            <%= dairy.name %>

        </span>


    </button>

</section>



<!-- =========================================================
     FULL-SCREEN MAINTENANCE MODAL
========================================================= -->

<div
    id="maintModal"
    class="maint-modal"
    aria-hidden="true"
>


    <div class="maint-modal__content">


        <!-- =================================================
             HEADER
        ================================================== -->

        <header class="maint-modal__header">


            <button
                type="button"
                id="closeMaintModal"
                class="maint-modal__back"
                aria-label="Close maintenance report"
            >

                <span aria-hidden="true">
                    &#8592;
                </span>

            </button>


            <div class="maint-modal__title">

                <strong>
                    Maintenance Report
                </strong>

                <span>
                    <%= dairy.name %>
                </span>

            </div>


            <div
                class="maint-modal__spacer"
                aria-hidden="true"
            ></div>


        </header>



        <!-- =================================================
             BODY
        ================================================== -->

        <main class="maint-modal__body">


            <div class="maint-modal__fields">


                <!-- =================================================
                     QUESTION
                ================================================== -->

                <div class="maint-question">

                    <strong>
                        <%= user.name.split(" ")[0] %>
                    </strong>,

                    does this facility/equipment/tool require
                    any maintenance?

                </div>



                <!-- =================================================
                     TARGET
                ================================================== -->

                <section
                    class="maint-target"
                    aria-label="Maintenance target"
                >


                    <% if (
                        dairy.profileImage &&
                        dairy.profileImage.trim() !== ""
                    ) { %>

                        <img
                            src="<%= dairy.profileImage %>"
                            class="maint-target__image"
                            alt="<%= dairy.name %>"
                        >

                    <% } else { %>

                        <div
                            class="maint-target__placeholder"
                            aria-hidden="true"
                        >
                            <i class="bi bi-tools"></i>
                        </div>

                    <% } %>


                    <div class="maint-target__info">

                        <span>
                            Maintenance required
                        </span>

                        <strong>
                            <%= dairy.name %>
                        </strong>

                    </div>


                </section>



                <!-- =================================================
                     MAINTENANCE FORM
                ================================================== -->

                <form
                    id="maintForm"
                    class="maint-form"
                    action="/dairy/<%= dairy._id %>/maintenance/mark"
                    method="POST"
                    autocomplete="off"
                >


                    <!-- =============================================
                         MAINTENANCE TYPE
                    ============================================== -->

                    <div class="maint-field">

                        <label
                            for="maintType"
                        >
                            Maintenance type
                        </label>


                        <select
                            id="maintType"
                            name="type"
                            required
                        >

                            <option value="">
                                Select maintenance type
                            </option>

                            <option value="repair">
                                🔧 Repair
                            </option>

                            <option value="maintenance">
                                🛠️ Maintenance
                            </option>

                            <option value="construction">
                                🏗️ Construction
                            </option>

                        </select>

                    </div>



                    <!-- =============================================
                         DESCRIPTION
                    ============================================== -->

                    <div class="maint-field">

                        <label
                            for="maintDescription"
                        >
                            What needs attention?
                        </label>


                        <textarea
                            id="maintDescription"
                            name="description"
                            maxlength="1000"
                            rows="5"
                            placeholder="Describe the problem or maintenance required..."
                            required
                        ></textarea>


                        <span
                            id="maintCharacterCounter"
                            class="maint-character-counter"
                        >
                            0/1000
                        </span>

                    </div>



                    <!-- =============================================
                         SUBMIT
                    ============================================== -->

                    <button
                        type="submit"
                        id="submitMaintButton"
                        class="maint-submit-button"
                        disabled
                    >

                        <i
                            class="bi bi-tools"
                            aria-hidden="true"
                        ></i>

                        <span>
                            Submit Maintenance Report
                        </span>

                    </button>


                </form>


            </div>

        </main>


    </div>

</div>



<!-- =========================================================
     CSS
========================================================= -->

<style>

/* =========================================================
   ROOT
========================================================= */

.maint-composer,
.maint-composer *,
.maint-modal,
.maint-modal * {

    box-sizing: border-box;

}



/* =========================================================
   REAL UPDATE CARD
========================================================= */

.maint-composer {

    width: 112px;

    flex: 0 0 112px;

    margin: 0 0 16px;

}


.maint-composer__card {

    position: relative;

    width: 112px;
    height: 155px;

    padding: 0;

    display: flex;

    flex-direction: column;

    align-items: center;
    justify-content: center;

    gap: 7px;

    overflow: hidden;

    border: 1px solid #dce7e0;

    border-radius: 15px;

    background:
        linear-gradient(
            145deg,
            #ffffff,
            #f3f8f5
        );

    color: #198754;

    font-family: inherit;

    cursor: pointer;

    text-align: center;

    transition:
        transform .15s ease,
        border-color .15s ease,
        box-shadow .15s ease;

}


.maint-composer__card:hover {

    border-color: #198754;

    box-shadow:
        0 5px 15px
        rgba(25, 135, 84, .10);

}


.maint-composer__card:active {

    transform: scale(.95);

}


.maint-composer__card:focus-visible {

    outline: 2px solid #198754;

    outline-offset: 2px;

}



/* =========================================================
   MAINTENANCE ICON
========================================================= */

.maint-composer__icon {

    width: 48px;
    height: 48px;

    display: flex;

    align-items: center;
    justify-content: center;

    border-radius: 50%;

    background: #198754;

    color: #ffffff;

    font-size: 22px;

    line-height: 1;

    box-shadow:
        0 4px 12px
        rgba(25, 135, 84, .20);

}


.maint-composer__icon i {

    line-height: 1;

}



/* =========================================================
   CARD LABEL
========================================================= */

.maint-composer__label {

    display: block;

    color: #26322b;

    font-size: 13px;

    font-weight: 700;

    line-height: 1.2;

}


.maint-composer__target {

    display: block;

    max-width: 88px;

    overflow: hidden;

    color: #8a928d;

    font-size: 10px;

    line-height: 1.25;

    white-space: nowrap;

    text-overflow: ellipsis;

}



/* =========================================================
   FULL-SCREEN MODAL
========================================================= */

.maint-modal {

    position: fixed;

    inset: 0;

    width: 100vw;
    height: 100dvh;

    z-index: 99999;

    display: none;

    overflow: hidden;

    background: #ffffff;

}


.maint-modal.active {

    display: block;

}



/* =========================================================
   MODAL CONTENT
========================================================= */

.maint-modal__content {

    width: 100%;
    height: 100%;

    display: flex;

    flex-direction: column;

    background: #ffffff;

}



/* =========================================================
   MODAL HEADER
========================================================= */

.maint-modal__header {

    flex: 0 0 64px;

    width: 100%;
    height: 64px;

    display: flex;

    align-items: center;

    padding: 0 15px;

    border-bottom: 1px solid #e7ede9;

    background: #ffffff;

}


.maint-modal__back {

    width: 44px;
    height: 44px;

    flex: 0 0 44px;

    display: flex;

    align-items: center;
    justify-content: center;

    padding: 0;

    border: none;

    border-radius: 50%;

    background: transparent;

    color: #198754;

    font-size: 27px;

    line-height: 1;

    cursor: pointer;

}


.maint-modal__back:active {

    background: #edf7f1;

}


.maint-modal__back:focus-visible {

    outline: 2px solid #198754;

    outline-offset: 2px;

}



/* =========================================================
   MODAL TITLE
========================================================= */

.maint-modal__title {

    min-width: 0;

    margin-left: 8px;

    display: flex;

    flex-direction: column;

    line-height: 1.25;

}


.maint-modal__title strong {

    color: #202520;

    font-size: 17px;

}


.maint-modal__title span {

    max-width: 72vw;

    margin-top: 2px;

    overflow: hidden;

    color: #7b847e;

    font-size: 12px;

    white-space: nowrap;

    text-overflow: ellipsis;

}


.maint-modal__spacer {

    flex: 1;

}



/* =========================================================
   MODAL BODY
========================================================= */

.maint-modal__body {

    flex: 1 1 auto;

    min-height: 0;

    overflow-y: auto;

    padding: 20px;

}


.maint-modal__fields {

    width: 100%;

    max-width: 700px;

    margin: 0 auto;

}



/* =========================================================
   QUESTION
========================================================= */

.maint-question {

    margin-bottom: 20px;

    color: #202520;

    font-size: 20px;

    line-height: 1.45;

}


.maint-question strong {

    color: #198754;

}



/* =========================================================
   TARGET
========================================================= */

.maint-target {

    width: 100%;

    display: flex;

    align-items: center;

    gap: 12px;

    margin-bottom: 24px;

    padding: 12px 13px;

    border: 1px solid #dcebe2;

    border-radius: 13px;

    background: #f6faf7;

}


.maint-target__image,
.maint-target__placeholder {

    width: 52px;
    height: 52px;

    flex: 0 0 52px;

    overflow: hidden;

    border-radius: 50%;

}


.maint-target__image {

    display: block;

    object-fit: cover;

}


.maint-target__placeholder {

    display: flex;

    align-items: center;
    justify-content: center;

    background: #198754;

    color: #ffffff;

    font-size: 20px;

}


.maint-target__info {

    min-width: 0;

    display: flex;

    flex-direction: column;

}


.maint-target__info span {

    color: #78827c;

    font-size: 10px;

}


.maint-target__info strong {

    margin-top: 3px;

    overflow: hidden;

    color: #235d3e;

    font-size: 14px;

    white-space: nowrap;

    text-overflow: ellipsis;

}



/* =========================================================
   FORM
========================================================= */

.maint-form {

    width: 100%;

    margin: 0;

}


.maint-field {

    position: relative;

    width: 100%;

    margin-bottom: 20px;

}


.maint-field label {

    display: block;

    margin-bottom: 7px;

    color: #6d7771;

    font-size: 11px;

    font-weight: 700;

    letter-spacing: .04em;

    text-transform: uppercase;

}


.maint-field select,
.maint-field textarea {

    width: 100%;

    border: 1px solid #e0e7e2;

    border-radius: 12px;

    outline: none;

    background: #f8faf8;

    color: #202520;

    font: inherit;

    font-size: 15px;

}


.maint-field select {

    height: 48px;

    padding: 0 13px;

}


.maint-field textarea {

    min-height: 130px;

    max-height: 300px;

    resize: vertical;

    padding: 13px 14px 30px;

    line-height: 1.5;

}


.maint-field select:focus,
.maint-field textarea:focus {

    border-color: #198754;

    background: #ffffff;

    box-shadow:
        0 0 0 3px
        rgba(25, 135, 84, .10);

}



/* =========================================================
   CHARACTER COUNTER
========================================================= */

.maint-character-counter {

    position: absolute;

    right: 11px;

    bottom: 9px;

    padding-left: 3px;

    background: #f8faf8;

    color: #8a928d;

    font-size: 10px;

    pointer-events: none;

}


.maint-field textarea:focus
~ .maint-character-counter {

    background: #ffffff;

}



/* =========================================================
   SUBMIT
========================================================= */

.maint-submit-button {

    width: 100%;

    min-height: 50px;

    display: flex;

    align-items: center;
    justify-content: center;

    gap: 8px;

    padding: 10px 14px;

    border: none;

    border-radius: 13px;

    background: #198754;

    color: #ffffff;

    font-family: inherit;

    font-size: 14px;

    font-weight: 700;

    cursor: pointer;

    transition:
        background .2s ease,
        transform .15s ease,
        opacity .15s ease;

}


.maint-submit-button:not(:disabled):hover {

    background: #146c43;

}


.maint-submit-button:not(:disabled):active {

    transform: scale(.99);

}


.maint-submit-button:disabled {

    background: #b8c2bc;

    cursor: default;

}


.maint-submit-button i {

    font-size: 16px;

}



/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 600px) {

    .maint-composer {

        width: 108px;

        flex-basis: 108px;

    }


    .maint-composer__card {

        width: 108px;

        height: 150px;

    }


    .maint-composer__icon {

        width: 46px;
        height: 46px;

        font-size: 21px;

    }


    .maint-modal__header {

        flex-basis: 60px;

        height: 60px;

        padding: 0 10px;

    }


    .maint-modal__body {

        padding: 14px;

    }


    .maint-question {

        font-size: 19px;

    }


    .maint-target {

        margin-bottom: 20px;

    }

}


@media (max-width: 380px) {

    .maint-modal__title span {

        display: none;

    }


    .maint-modal__body {

        padding: 10px;

    }

}

</style>



<!-- =========================================================
     JAVASCRIPT
========================================================= -->

<script>

(function () {

    "use strict";


    function initializeMaintenanceComposer() {


        /* =====================================================
           ELEMENTS
        ====================================================== */

        const modal =
            document.getElementById(
                "maintModal"
            );


        const openButton =
            document.getElementById(
                "openMaintComposer"
            );


        const closeButton =
            document.getElementById(
                "closeMaintModal"
            );


        const typeInput =
            document.getElementById(
                "maintType"
            );


        const descriptionInput =
            document.getElementById(
                "maintDescription"
            );


        const characterCounter =
            document.getElementById(
                "maintCharacterCounter"
            );


        const submitButton =
            document.getElementById(
                "submitMaintButton"
            );


        const form =
            document.getElementById(
                "maintForm"
            );



        /* =====================================================
           SAFETY CHECK
        ====================================================== */

        if (
            !modal ||
            !openButton ||
            !closeButton ||
            !typeInput ||
            !descriptionInput ||
            !characterCounter ||
            !submitButton ||
            !form
        ) {

            console.error(
                "MAINTCOMPOSER.EJS: Required elements are missing."
            );

            return;

        }



        /* =====================================================
           OPEN MODAL
        ====================================================== */

        function openModal() {

            modal.classList.add(
                "active"
            );


            modal.setAttribute(
                "aria-hidden",
                "false"
            );


            document.body.style.overflow =
                "hidden";


            window.setTimeout(
                function () {

                    typeInput.focus();

                },
                100
            );

        }



        /* =====================================================
           CLOSE MODAL
        ====================================================== */

        function closeModal() {

            modal.classList.remove(
                "active"
            );


            modal.setAttribute(
                "aria-hidden",
                "true"
            );


            document.body.style.overflow =
                "";

        }



        /* =====================================================
           VALIDATION
        ====================================================== */

        function updateSubmitButton() {

            const hasType =
                typeInput.value.trim().length > 0;


            const hasDescription =
                descriptionInput.value.trim().length > 0;


            submitButton.disabled =
                !(
                    hasType &&
                    hasDescription
                );

        }



        /* =====================================================
           CHARACTER COUNTER
        ====================================================== */

        function updateCharacterCounter() {

            characterCounter.textContent =
                descriptionInput.value.length +
                "/1000";

        }



        /* =====================================================
           TEXTAREA RESIZE
        ====================================================== */

        function resizeTextarea() {

            descriptionInput.style.height =
                "auto";


            const height =
                Math.min(
                    descriptionInput.scrollHeight,
                    300
                );


            descriptionInput.style.height =
                height + "px";

        }



        /* =====================================================
           OPEN
        ====================================================== */

        openButton.addEventListener(
            "click",
            openModal
        );



        /* =====================================================
           CLOSE
        ====================================================== */

        closeButton.addEventListener(
            "click",
            closeModal
        );



        /* =====================================================
           ESCAPE
        ====================================================== */

        document.addEventListener(
            "keydown",
            function (event) {

                if (
                    event.key === "Escape" &&
                    modal.classList.contains(
                        "active"
                    )
                ) {

                    closeModal();

                }

            }
        );



        /* =====================================================
           TYPE
        ====================================================== */

        typeInput.addEventListener(
            "change",
            updateSubmitButton
        );



        /* =====================================================
           DESCRIPTION
        ====================================================== */

        descriptionInput.addEventListener(
            "input",
            function () {

                updateCharacterCounter();

                resizeTextarea();

                updateSubmitButton();

            }
        );



        /* =====================================================
           FORM SUBMIT
        ====================================================== */

        form.addEventListener(
            "submit",
            function () {

                submitButton.disabled =
                    true;


                submitButton.innerHTML =
                    '<i class="bi bi-hourglass-split"></i>' +
                    '<span>Submitting...</span>';

            }
        );



        /* =====================================================
           INITIAL STATE
        ====================================================== */

        updateCharacterCounter();

        resizeTextarea();

        updateSubmitButton();

    }



    /* =========================================================
       DOM READY
    ========================================================= */

    if (
        document.readyState === "loading"
    ) {

        document.addEventListener(
            "DOMContentLoaded",
            initializeMaintenanceComposer
        );

    } else {

        initializeMaintenanceComposer();

    }

})();

</script>


<% } %>