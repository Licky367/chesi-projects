<% /*
==========================================================
UPDATE CARDS

FILE:
    views/update/update-cards.ejs

PURPOSE:
----------------------------------------------------------
Central container for the update-related cards/composers
shown on a dairy asset page.

INCLUDES:
----------------------------------------------------------
• Maintenance composer
• Maintenance clear composer
• Milking status card

EXPECTED DATA:
----------------------------------------------------------
dairy
user
==========================================================
*/ %>


<% if (dairy) { %>


<section class="update-cards">


    <!-- =================================================
         PAGE TITLE
    ================================================== -->

    <div class="update-cards-title-section">

        <h1 class="update-cards-title">
            Updates
        </h1>

        <p class="update-cards-subtitle">
            Manage activities, maintenance and status
            for <strong><%= dairy.name %></strong>.
        </p>

    </div>



    <!-- =================================================
         UPDATE CARDS CONTENT
    ================================================== -->

    <div class="update-cards-list">


        <!-- =================================================
             MILKING STATUS
        ================================================== -->

        <%- include("milk-status", {
            dairy: dairy,
            user: user
        }) %>



        <!-- =================================================
             MAINTENANCE COMPOSER
        ================================================== -->

        <%- include("maintComposer", {
            dairy: dairy,
            user: user
        }) %>



        <!-- =================================================
             CLEAR MAINTENANCE COMPOSER
        ================================================== -->

        <%- include("maintClearComposer", {
            dairy: dairy,
            user: user
        }) %>


    </div>


</section>



<style>

/* ==========================================================
   UPDATE CARDS
========================================================== */

.update-cards {

    width: 100%;

    box-sizing: border-box;

    padding: 4px 0 24px;

}


/* ==========================================================
   TITLE SECTION
========================================================== */

.update-cards-title-section {

    width: 100%;

    margin-bottom: 22px;

    padding: 4px 4px 0;

    box-sizing: border-box;

}


.update-cards-title {

    margin: 0;

    color: #14532d;

    font-size: 32px;

    font-weight: 800;

    line-height: 1.1;

    letter-spacing: -0.7px;

}


.update-cards-subtitle {

    margin: 8px 0 0;

    max-width: 650px;

    color: #66736b;

    font-size: 14px;

    font-weight: 500;

    line-height: 1.5;

}


.update-cards-subtitle strong {

    color: #198754;

    font-weight: 700;

}



/* ==========================================================
   GREEN TITLE ACCENT
========================================================== */

.update-cards-title-section::after {

    content: "";

    display: block;

    width: 48px;

    height: 4px;

    margin-top: 13px;

    border-radius: 999px;

    background: #198754;

}



/* ==========================================================
   CARDS LIST
========================================================== */

.update-cards-list {

    width: 100%;

    display: flex;

    flex-wrap: wrap;

    align-items: flex-start;

    gap: 16px;

}



/* ==========================================================
   MOBILE
========================================================== */

@media (max-width: 650px) {

    .update-cards {

        padding-bottom: 20px;

    }


    .update-cards-title {

        font-size: 28px;

        letter-spacing: -0.5px;

    }


    .update-cards-subtitle {

        font-size: 13px;

    }


    .update-cards-list {

        gap: 12px;

    }

}



/* ==========================================================
   SMALL PHONES
========================================================== */

@media (max-width: 380px) {

    .update-cards-title {

        font-size: 25px;

    }

}

</style>


<% } %>