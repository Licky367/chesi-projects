<% /*
==========================================================
UPDATE CARDS

FILE:
    views/update/update-cards.ejs

PURPOSE:
----------------------------------------------------------
Main container for update-related cards and composers
belonging to the currently viewed dairy asset.

INCLUDES:
----------------------------------------------------------
• milk-status.ejs
• maintComposer.ejs
• maintenanceClearComposer.ejs

EXPECTED DATA:
----------------------------------------------------------
dairy
user
==========================================================
*/ %>


<% if (dairy) { %>


<section class="update-cards">


    <!-- =================================================
         TITLE
    ================================================== -->

    <div class="update-cards-heading">

        <h1 class="update-cards-title">
            Updates
        </h1>

        <p class="update-cards-description">

            Manage activities, maintenance and status
            for

            <strong>
                <%= dairy.name %>
            </strong>

        </p>

    </div>



    <!-- =================================================
         GREEN TITLE ACCENT
    ================================================== -->

    <div class="update-cards-accent"></div>



    <!-- =================================================
         UPDATE CONTENT
    ================================================== -->

    <div class="update-cards-list">


        <!-- =================================================
             MILKING STATUS
        ================================================== -->

        <%- include("update/milk-status.ejs", {
            dairy: dairy,
            user: user
        }) %>



        <!-- =================================================
             MAINTENANCE REPORT
        ================================================== -->

        <%- include("update/maintComposer.ejs", {
            dairy: dairy,
            user: user
        }) %>



        <!-- =================================================
             CLEAR COMPLETED MAINTENANCE

             EXACT FILE:
                 maintenanceClearComposer.ejs
        ================================================== -->

        <%- include("update/maintenanceClearComposer.ejs", {
            dairy: dairy,
            user: user
        }) %>


    </div>


</section>



<style>

/* ==========================================================
   UPDATE CARDS CONTAINER
========================================================== */

.update-cards {

    width: 100%;

    box-sizing: border-box;

    margin: 0;

    padding: 8px 0 28px;

}


/* ==========================================================
   TITLE AREA
========================================================== */

.update-cards-heading {

    width: 100%;

    box-sizing: border-box;

    margin: 0 0 5px;

    padding: 0 4px;

}


/* ==========================================================
   MAIN TITLE
========================================================== */

.update-cards-title {

    margin: 0;

    color: #14532d;

    font-size: 34px;

    font-weight: 800;

    line-height: 1.1;

    letter-spacing: -0.8px;

}


/* ==========================================================
   DESCRIPTION
========================================================== */

.update-cards-description {

    max-width: 700px;

    margin: 8px 0 0;

    color: #66736b;

    font-size: 14px;

    font-weight: 500;

    line-height: 1.5;

}


.update-cards-description strong {

    color: #198754;

    font-weight: 800;

}


/* ==========================================================
   TITLE ACCENT
========================================================== */

.update-cards-accent {

    width: 52px;

    height: 4px;

    margin: 13px 0 22px 4px;

    border-radius: 999px;

    background: #198754;

}


/* ==========================================================
   UPDATE CARDS LIST
========================================================== */

.update-cards-list {

    width: 100%;

    box-sizing: border-box;

    display: flex;

    flex-wrap: wrap;

    align-items: flex-start;

    gap: 16px;

}


/* ==========================================================
   GREENISH THEME SUPPORT

   Keeps the surrounding update area visually consistent
   with the green dairy theme.
========================================================== */

.update-cards-list {

    color: #24352b;

}


.update-cards-list * {

    box-sizing: border-box;

}



/* ==========================================================
   MOBILE
========================================================== */

@media (max-width: 650px) {

    .update-cards {

        padding-top: 5px;

        padding-bottom: 22px;

    }


    .update-cards-title {

        font-size: 29px;

        letter-spacing: -0.6px;

    }


    .update-cards-description {

        font-size: 13px;

        line-height: 1.45;

    }


    .update-cards-accent {

        margin-bottom: 18px;

    }


    .update-cards-list {

        gap: 12px;

    }

}



/* ==========================================================
   SMALL PHONES
========================================================== */

@media (max-width: 380px) {

    .update-cards-title {

        font-size: 26px;

    }


    .update-cards-description {

        font-size: 12px;

    }

}

</style>


<% } %>