<% /*
==========================================================
UPDATE CARDS

FILE:
    views/update/update-cards.ejs

PURPOSE:
----------------------------------------------------------
Container for the interactive update/action cards shown
on the dairy update page.

This file:

• Displays the section title.
• Includes the individual update composers/cards.
• Keeps the cards together in one clean green-themed area.

INDIVIDUAL COMPONENTS:
----------------------------------------------------------
• milk-status.ejs
• maintComposer.ejs
• maintClearComposer.ejs

EXPECTED DATA:
----------------------------------------------------------
dairy
user
==========================================================
*/ %>


<!-- =========================================================
     UPDATE CARDS SECTION
========================================================= -->

<section class="update-cards-section">


    <!-- =====================================================
         SECTION HEADER
    ====================================================== -->

    <header class="update-cards-header">

        <div class="update-cards-title-wrap">

            <span class="update-cards-title-accent"></span>

            <div>

                <h2 class="update-cards-title">
                    Farm Updates
                </h2>

                <p class="update-cards-subtitle">
                    Manage and update this dairy asset
                </p>

            </div>

        </div>

    </header>



    <!-- =====================================================
         CARDS CONTAINER
    ====================================================== -->

    <div class="update-cards-container">


        <!-- =================================================
             MILKING STATUS
        ================================================== -->

        <%- include("./milk-status", {
            dairy: dairy,
            user: user
        }) %>



        <!-- =================================================
             REPORT MAINTENANCE
        ================================================== -->

        <%- include("./maintComposer", {
            dairy: dairy,
            user: user
        }) %>



        <!-- =================================================
             CLEAR MAINTENANCE
        ================================================== -->

        <%- include("./maintClearComposer", {
            dairy: dairy,
            user: user
        }) %>


    </div>


</section>



<!-- =========================================================
     CSS
========================================================= -->

<style>

/* =========================================================
   MAIN SECTION
========================================================= */

.update-cards-section {

    width: 100%;

    box-sizing: border-box;

    margin: 24px 0;

    padding: 0;

}



/* =========================================================
   SECTION HEADER
========================================================= */

.update-cards-header {

    width: 100%;

    box-sizing: border-box;

    margin-bottom: 18px;

    padding: 0 2px;

}


.update-cards-title-wrap {

    display: flex;

    align-items: center;

    gap: 12px;

}


.update-cards-title-accent {

    width: 5px;

    height: 46px;

    flex: 0 0 5px;

    border-radius: 999px;

    background:
        linear-gradient(
            to bottom,
            #166534,
            #22c55e
        );

}


.update-cards-title {

    margin: 0;

    color: #123d28;

    font-size: 28px;

    font-weight: 800;

    line-height: 1.1;

    letter-spacing: -0.6px;

}


.update-cards-subtitle {

    margin: 5px 0 0;

    color: #6b7f72;

    font-size: 13px;

    font-weight: 500;

    line-height: 1.4;

}



/* =========================================================
   CARDS CONTAINER
========================================================= */

.update-cards-container {

    width: 100%;

    box-sizing: border-box;

    display: flex;

    flex-wrap: wrap;

    align-items: flex-start;

    gap: 16px;

    padding: 18px;

    border: 1px solid #dceee3;

    border-radius: 18px;

    background:
        linear-gradient(
            145deg,
            #f8fcf9,
            #f1f8f4
        );

    box-shadow:
        0 5px 18px
        rgba(22, 101, 52, 0.06);

}



/* =========================================================
   CHILD COMPONENT WIDTH
========================================================= */

.update-cards-container
> .milk-status-card {

    flex: 0 0 auto;

}


.update-cards-container
> .maint-composer-card,

.update-cards-container
> .maint-clear-composer-card {

    flex: 1 1 300px;

    min-width: 280px;

}



/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 700px) {

    .update-cards-section {

        margin: 20px 0;

    }


    .update-cards-title {

        font-size: 24px;

    }


    .update-cards-title-accent {

        height: 40px;

    }


    .update-cards-container {

        padding: 12px;

        gap: 12px;

        border-radius: 15px;

    }


    .update-cards-container
    > .maint-composer-card,

    .update-cards-container
    > .maint-clear-composer-card {

        flex: 1 1 100%;

        min-width: 0;

    }

}



/* =========================================================
   SMALL PHONES
========================================================= */

@media (max-width: 380px) {

    .update-cards-title {

        font-size: 22px;

    }


    .update-cards-subtitle {

        font-size: 12px;

    }


    .update-cards-container {

        padding: 10px;

    }

}

</style>