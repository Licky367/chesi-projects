<% /*
==========================================================
DAIRY UPDATE CARDS

FILE:
    views/update/update-cards.ejs

PURPOSE:
    Compact horizontal WhatsApp-style action cards for
    the currently viewed dairy asset.

VISIBLE CARDS:
----------------------------------------------------------

1. CREATE UPDATE
   • Always visible.
   • Opens the existing create.ejs post composer.

2. MILKING STATUS
   • Visible ONLY when:
         dairy.code > 0
         AND dairy.code is even

   • Visible ONLY to:
         admin
         dairyWorker

   • Opens the existing milk-status control.

IMPORTANT:
----------------------------------------------------------
    There are ONLY these two cards.

    No maintenance card.
    No clear-maintenance card.
    No blank cards.
    No placeholder cards.

EXPECTED DATA:
----------------------------------------------------------
    user
    dairy

==========================================================
*/ %>


<%
    /* ======================================================
       SAFE VALUES
    ====================================================== */

    const currentUser = user || {};
    const currentDairy = dairy || {};



    /* ======================================================
       USER ROLE
    ====================================================== */

    const userRole =
        currentUser.role || "";



    /* ======================================================
       DAIRY CODE
    ====================================================== */

    const rawCode =
        currentDairy.code;


    const dairyCode =
        (
            rawCode !== null &&
            rawCode !== undefined &&
            rawCode !== ""
        )
            ? Number(rawCode)
            : null;



    /* ======================================================
       MILKING CARD VISIBILITY

       Requirements:

       • positive code
       • even code
       • admin OR dairyWorker
    ====================================================== */

    const showMilkStatus =
        Number.isFinite(dairyCode) &&
        dairyCode > 0 &&
        dairyCode % 2 === 0 &&
        (
            userRole === "admin" ||
            userRole === "dairyWorker"
        );
%>



<section
    class="dairy-update-cards"
    aria-label="Dairy updates and operations"
>


    <!-- =====================================================
         SECTION INTRO
    ====================================================== -->

    <div class="dairy-update-header">

        <div class="dairy-update-heading">

            <strong>
                <%= currentUser.name
                    ? currentUser.name.split(" ")[0]
                    : "User" %>
            </strong>

            <span>
                — update and manage
            </span>

            <strong>
                <%= currentDairy.name || "this dairy" %>
            </strong>

        </div>

    </div>



    <!-- =====================================================
         HORIZONTAL ACTION CARDS
    ====================================================== -->

    <div
        class="dairy-update-scroll"
        role="list"
        aria-label="Available dairy actions"
    >


        <!-- =================================================
             1. CREATE UPDATE
             
             ALWAYS VISIBLE
             
             Opens the existing create.ejs composer.
        ================================================== -->

        <button
            type="button"
            class="dairy-update-card dairy-update-card--create"
            data-update-card="create"
            aria-label="Create an update about <%= currentDairy.name || 'this dairy' %>"
            role="listitem"
        >

            <div class="dairy-update-card__icon">

                <span aria-hidden="true">
                    +
                </span>

            </div>


            <div class="dairy-update-card__content">

                <strong>
                    Add an Update
                </strong>

                <span>
                    Share something about
                    <%= currentDairy.name || "this dairy" %>.
                </span>

            </div>


            <div
                class="dairy-update-card__arrow"
                aria-hidden="true"
            >
                →
            </div>

        </button>



        <!-- =================================================
             2. MILKING STATUS

             ONLY:
                 • positive even dairy.code
                 • admin
                 • dairyWorker
        ================================================== -->

        <% if (showMilkStatus) { %>

            <button
                type="button"
                class="dairy-update-card dairy-update-card--milk"
                data-update-card="milk-status"
                aria-label="Manage milking status for <%= currentDairy.name || 'this dairy' %>"
                role="listitem"
            >

                <div class="dairy-update-card__icon">

                    <span aria-hidden="true">
                        🥛
                    </span>

                </div>


                <div class="dairy-update-card__content">

                    <strong>
                        Milking Status
                    </strong>

                    <span>
                        Check or change whether
                        <%= currentDairy.name || "this animal" %>
                        is currently being milked.
                    </span>

                </div>


                <div
                    class="dairy-update-card__arrow"
                    aria-hidden="true"
                >
                    →
                </div>

            </button>

        <% } %>


    </div>

</section>



<style>

/* ==========================================================
   ROOT
========================================================== */

.dairy-update-cards {

    width: 100%;

    margin:
        0
        0
        18px;

    padding: 0;

    overflow: hidden;

    font-family:
        Arial,
        Helvetica,
        sans-serif;

}



/* ==========================================================
   HEADER
========================================================== */

.dairy-update-header {

    width: 100%;

    padding:
        0
        2px
        10px;

}


.dairy-update-heading {

    display: flex;

    align-items: baseline;

    flex-wrap: wrap;

    column-gap: 4px;

    row-gap: 1px;

    color: #707972;

    font-size: 12px;

    line-height: 1.45;

}


.dairy-update-heading strong {

    color: #202520;

    font-size: 14px;

    font-weight: 700;

}


.dairy-update-heading strong:first-child {

    font-size: 18px;

}


.dairy-update-heading span {

    color: #7b847e;

}



/* ==========================================================
   HORIZONTAL SCROLL
========================================================== */

.dairy-update-scroll {

    width: 100%;

    display: flex;

    align-items: stretch;

    gap: 10px;

    overflow-x: auto;

    overflow-y: hidden;

    padding:
        2px
        3px
        8px;

    scroll-behavior: smooth;

    -webkit-overflow-scrolling: touch;

    scrollbar-width: none;

}


.dairy-update-scroll::-webkit-scrollbar {

    display: none;

}



/* ==========================================================
   CARD
========================================================== */

.dairy-update-card {

    position: relative;

    flex:
        0 0
        184px;

    width: 184px;

    min-height: 112px;

    display: flex;

    align-items: center;

    gap: 10px;

    padding: 12px;

    border:
        1px solid
        #e3e9e5;

    border-radius: 16px;

    background: #ffffff;

    box-shadow:
        0 3px 10px
        rgba(20, 40, 28, .06);

    cursor: pointer;

    text-align: left;

    font-family: inherit;

    appearance: none;

    -webkit-appearance: none;

    transition:
        transform .15s ease,
        box-shadow .15s ease,
        border-color .15s ease;

}


.dairy-update-card:hover {

    transform:
        translateY(-2px);

    border-color:
        #d4ded8;

    box-shadow:
        0 6px 16px
        rgba(20, 40, 28, .09);

}


.dairy-update-card:active {

    transform:
        scale(.97);

}


.dairy-update-card:focus-visible {

    outline:
        2px solid
        #198754;

    outline-offset:
        2px;

}



/* ==========================================================
   CARD ICON
========================================================== */

.dairy-update-card__icon {

    width: 44px;
    height: 44px;

    flex:
        0 0
        44px;

    display: flex;

    align-items: center;

    justify-content: center;

    border-radius: 13px;

    font-size: 21px;

    font-weight: 500;

}


.dairy-update-card--create
.dairy-update-card__icon {

    background:
        #edf5ff;

    color:
        #2563eb;

}


.dairy-update-card--milk
.dairy-update-card__icon {

    background:
        #edf7f7;

    color:
        #087f8c;

}



/* ==========================================================
   CREATE PLUS SIGN
========================================================== */

.dairy-update-card--create
.dairy-update-card__icon span {

    display: block;

    font-size: 31px;

    font-weight: 300;

    line-height: 1;

}



/* ==========================================================
   CARD CONTENT
========================================================== */

.dairy-update-card__content {

    min-width: 0;

    flex: 1;

}


.dairy-update-card__content strong {

    display: block;

    margin-bottom: 4px;

    color:
        #202520;

    font-size:
        13px;

    font-weight:
        700;

    line-height:
        1.25;

}


.dairy-update-card__content span {

    display:
        -webkit-box;

    overflow:
        hidden;

    color:
        #7b847e;

    font-size:
        10px;

    line-height:
        1.4;

    -webkit-box-orient:
        vertical;

    -webkit-line-clamp:
        3;

}



/* ==========================================================
   ARROW
========================================================== */

.dairy-update-card__arrow {

    flex:
        0 0
        auto;

    color:
        #a2aba5;

    font-size:
        18px;

    font-weight:
        500;

}



/* ==========================================================
   MOBILE
========================================================== */

@media (max-width: 600px) {

    .dairy-update-heading {

        font-size:
            11px;

    }


    .dairy-update-heading strong {

        font-size:
            13px;

    }


    .dairy-update-heading strong:first-child {

        font-size:
            17px;

    }


    .dairy-update-card {

        flex-basis:
            170px;

        width:
            170px;

        min-height:
            106px;

        padding:
            11px;

        border-radius:
            15px;

    }


    .dairy-update-card__icon {

        width:
            40px;

        height:
            40px;

        flex-basis:
            40px;

        border-radius:
            12px;

        font-size:
            19px;

    }


    .dairy-update-card--create
    .dairy-update-card__icon span {

        font-size:
            28px;

    }


    .dairy-update-card__content strong {

        font-size:
            12px;

    }


    .dairy-update-card__content span {

        font-size:
            9px;

    }

}



/* ==========================================================
   VERY SMALL SCREENS
========================================================== */

@media (max-width: 380px) {

    .dairy-update-card {

        flex-basis:
            162px;

        width:
            162px;

    }

}

</style>



<script>

/* ==========================================================
   UPDATE CARD ACTION BRIDGE

   These cards do NOT create their own composers.

   They simply open the existing components:

       create.ejs
       milk-status.ejs

   Therefore there are no duplicate modals and no blank
   operation cards.
========================================================== */

(function () {

    "use strict";


    /* ======================================================
       CREATE UPDATE CARD
    ====================================================== */

    const createCard =
        document.querySelector(
            '[data-update-card="create"]'
        );


    if (createCard) {

        createCard.addEventListener(
            "click",
            function () {

                /*
                 * create.ejs uses:
                 *
                 *     #coreCreatePostOpen
                 *
                 * as its actual composer trigger.
                 */

                const createTrigger =
                    document.getElementById(
                        "coreCreatePostOpen"
                    );


                if (createTrigger) {

                    createTrigger.click();

                    return;

                }


                /*
                 * Fallback selectors in case the
                 * composer trigger has another
                 * existing selector on the page.
                 */

                const fallbackTrigger =
                    document.querySelector(
                        "[data-post-modal-trigger], " +
                        "[data-open-post-modal-trigger], " +
                        ".create-post-card"
                    );


                if (fallbackTrigger) {

                    fallbackTrigger.click();

                }

            }
        );

    }



    /* ======================================================
       MILKING STATUS CARD
    ====================================================== */

    const milkStatusCard =
        document.querySelector(
            '[data-update-card="milk-status"]'
        );


    if (milkStatusCard) {

        milkStatusCard.addEventListener(
            "click",
            function () {

                /*
                 * milk-status.ejs should expose its
                 * existing trigger using one of these
                 * selectors.
                 *
                 * The update card does not duplicate
                 * the milking form or its logic.
                 */

                const milkTrigger =
                    document.querySelector(
                        "[data-milk-status-trigger], " +
                        "[data-open-milk-status-trigger], " +
                        ".milk-status-button"
                    );


                if (milkTrigger) {

                    milkTrigger.click();

                }

            }
        );

    }

})();

</script>