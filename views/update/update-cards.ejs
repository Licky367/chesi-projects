<% /*
============================================================
UPDATE CARDS

FILE:
    views/update/update-cards.ejs

PURPOSE:
    Main update-card strip for the CURRENT dairy asset.

RULES:
------------------------------------------------------------

1. create.ejs
   ALWAYS appears.

2. milk-status.ejs
   Appears ONLY when:
       dairy.code is a positive EVEN number.

3. maintComposer.ejs
   Appears ONLY when:
       dairy.needsMaintenance === false
       AND
       dairy.code is undefined OR null.

4. maintenanceClearComposer.ejs
   Appears ONLY when:
       dairy.needsMaintenance === true.

5. milking-history.ejs
   Appears ONLY when:
       dairy.code is a positive EVEN number.

CARD LAYOUT:
------------------------------------------------------------
Cards remain in ONE horizontal row.

They do NOT wrap.

If the cards are wider than the available screen,
the user can SWIPE LEFT/RIGHT horizontally.

ORDER:
------------------------------------------------------------
1. Add an update
2. Milking status       [eligible assets only]
3. Milking history      [eligible assets only]
4. Maintenance          [eligible assets only]
5. Clear maintenance    [when required]

EXPECTED DATA:
------------------------------------------------------------
dairy
user
============================================================
*/ %>


<% if (dairy) { %>


<section class="update-cards">


    <!-- =====================================================
         TITLE
    ====================================================== -->

    <div class="update-cards-heading">

        <h1 class="update-cards-title">
            Updates
        </h1>


        <p class="update-cards-description">

            Keep
            <strong>
                <%= dairy.name %>
            </strong>
            updated with activities, maintenance and
            important status changes.

        </p>

    </div>



    <!-- =====================================================
         TITLE ACCENT
    ====================================================== -->

    <div class="update-cards-accent"></div>



    <!-- =====================================================
         DETERMINE MILKING ELIGIBILITY
    ====================================================== -->

    <%
        const dairyCodeNumber =
            Number(dairy.code);

        const showMilkingCards =
            Number.isFinite(dairyCodeNumber) &&
            dairyCodeNumber > 0 &&
            dairyCodeNumber % 2 === 0;
    %>



    <!-- =====================================================
         DETERMINE WHETHER DAIRY HAS NO CODE
    ====================================================== -->

    <%
        const hasNoDairyCode =
            dairy.code === undefined ||
            dairy.code === null;

        const showMaintenanceComposer =
            dairy.needsMaintenance === false &&
            hasNoDairyCode;
    %>



    <!-- =====================================================
         HORIZONTAL CARD STRIP

         IMPORTANT:
         - NO flex-wrap
         - NO wrapping
         - Cards stay left-to-right
         - Horizontal swipe on smaller screens
    ====================================================== -->

    <div
        class="update-cards-list"
        aria-label="Available updates"
    >


        <!-- =================================================
             1. CREATE

             ALWAYS VISIBLE
        ================================================== -->

        <%- include("create", {
            dairy: dairy,
            user: user
        }) %>



        <!-- =================================================
             2. MILKING STATUS

             Positive EVEN dairy code only.
        ================================================== -->

        <% if (showMilkingCards) { %>

            <%- include("milk-status", {
                dairy: dairy,
                user: user
            }) %>

        <% } %>



        <!-- =================================================
             3. MILKING HISTORY

             Positive EVEN dairy code only.

             The card itself links to:

                 /milk/history/<dairy._id>
        ================================================== -->

        <% if (showMilkingCards) { %>

            <%- include("milking-history", {
                dairy: dairy,
                user: user
            }) %>

        <% } %>



        <!-- =================================================
             4. MAINTENANCE COMPOSER

             Only when:
                 needsMaintenance === false

             AND:
                 code === undefined
                 OR
                 code === null
        ================================================== -->

        <% if (showMaintenanceComposer) { %>

            <%- include("maintComposer", {
                dairy: dairy,
                user: user
            }) %>

        <% } %>



        <!-- =================================================
             5. CLEAR MAINTENANCE

             Only when:
                 needsMaintenance === true
        ================================================== -->

        <% if (dairy.needsMaintenance === true) { %>

            <%- include("maintenanceClearComposer", {
                dairy: dairy,
                user: user
            }) %>

        <% } %>


    </div>


</section>



<style>

/* ==========================================================
   UPDATE CARDS
========================================================== */

.update-cards {

    width: 100%;

    box-sizing: border-box;

    margin: 0;

    padding: 8px 0 28px;

}



/* ==========================================================
   TITLE
========================================================== */

.update-cards-heading {

    width: 100%;

    box-sizing: border-box;

    margin: 0;

    padding: 0 4px;

}


.update-cards-title {

    margin: 0;

    color: #14532d;

    font-size: 34px;

    font-weight: 800;

    line-height: 1.08;

    letter-spacing: -0.8px;

}



/* ==========================================================
   DESCRIPTION
========================================================== */

.update-cards-description {

    max-width: 700px;

    margin: 8px 0 0;

    color: #66736b;

    font-size: 14px;

    font-weight: 500;

    line-height: 1.5;

}


.update-cards-description strong {

    color: #198754;

    font-weight: 800;

}



/* ==========================================================
   TITLE ACCENT
========================================================== */

.update-cards-accent {

    width: 54px;

    height: 4px;

    margin: 13px 0 22px 4px;

    border-radius: 999px;

    background: #198754;

}



/* ==========================================================
   CARD STRIP
========================================================== */

.update-cards-list {

    width: 100%;

    box-sizing: border-box;

    display: flex;

    flex-direction: row;

    flex-wrap: nowrap;

    align-items: flex-start;

    justify-content: flex-start;

    gap: 16px;

    overflow-x: auto;

    overflow-y: hidden;

    padding:
        2px
        4px
        12px;

    scroll-snap-type: x proximity;

    -webkit-overflow-scrolling: touch;

    scrollbar-width: thin;

}



/* ==========================================================
   PREVENT INCLUDED CARDS FROM SHRINKING
========================================================== */

.update-cards-list > * {

    flex-shrink: 0;

}



/* ==========================================================
   HORIZONTAL SCROLLBAR
========================================================== */

.update-cards-list::-webkit-scrollbar {

    height: 5px;

}


.update-cards-list::-webkit-scrollbar-track {

    background: #edf4ef;

    border-radius: 999px;

}


.update-cards-list::-webkit-scrollbar-thumb {

    background: #a9cbb5;

    border-radius: 999px;

}


.update-cards-list::-webkit-scrollbar-thumb:hover {

    background: #198754;

}



/* ==========================================================
   MOBILE
========================================================== */

@media (max-width: 650px) {

    .update-cards {

        padding-top: 5px;

        padding-bottom: 22px;

    }


    .update-cards-title {

        font-size: 29px;

        letter-spacing: -0.6px;

    }


    .update-cards-description {

        font-size: 13px;

        line-height: 1.45;

    }


    .update-cards-accent {

        margin-bottom: 18px;

    }


    .update-cards-list {

        gap: 12px;

        padding-left: 4px;

        padding-right: 4px;

        padding-bottom: 10px;

    }

}



/* ==========================================================
   SMALL PHONES
========================================================== */

@media (max-width: 380px) {

    .update-cards-title {

        font-size: 26px;

    }


    .update-cards-description {

        font-size: 12px;

    }


    .update-cards-list {

        gap: 10px;

    }

}

</style>


<% } %>