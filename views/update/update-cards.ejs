</style>



<script>

/* ==========================================================
   CREATE UPDATE CARD
==========================================================

   Opens the EXISTING post modal.

   This deliberately does not create a new modal.

   It looks for common modal triggers first and then
   falls back to clicking the existing composer trigger.
========================================================== */

(function () {

    const createCard =
        document.querySelector(
            "[data-open-post-modal]"
        );


    if (!createCard) {
        return;
    }


    function openPostModal() {

        /*
         * Existing modal trigger.
         *
         * Adjust these selectors only if your existing
         * postModal.js uses a different trigger.
         */

        const trigger =
            document.querySelector(
                "[data-open-post-modal-trigger], " +
                ".create-post-card, " +
                ".post-composer-trigger, " +
                "[data-post-modal-trigger]"
            );


        if (trigger && trigger !== createCard) {

            trigger.click();

            return;
        }


        /*
         * If postModal.js exposes the modal through
         * the .post-modal structure, attempt to activate
         * it directly.
         */

        const modal =
            document.querySelector(
                ".post-modal, " +
                "#postModal, " +
                "[data-post-modal]"
            );


        if (modal) {

            modal.classList.add("active");

            document.body.classList.add(
                "modal-open"
            );

        }

    }


    createCard.addEventListener(
        "click",
        openPostModal
    );


    createCard.addEventListener(
        "keydown",
        function (event) {

            if (
                event.key === "Enter" ||
                event.key === " "
            ) {

                event.preventDefault();

                openPostModal();

            }

        }
    );

})();

</script>


<% /*
==========================================================
IMPORTANT PARTIAL STRUCTURE

The following files should exist:

    views/update/maintComposer.ejs

    views/update/maintenanceClearComposer.ejs

    views/update/milk-status.ejs

Those files contain their own actual forms / toggles.

This file controls WHEN they are rendered.
==========================================================
*/ %>