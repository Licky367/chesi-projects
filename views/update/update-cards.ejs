<% /*
==========================================================
DAIRY UPDATE / OPERATION CARDS

FILE:
    views/update/update-cards.ejs

PURPOSE:
    Horizontal WhatsApp-style operation cards for the
    currently viewed dairy.

    Every visible card is itself clickable.

OPERATIONS:
----------------------------------------------------------

1. CREATE UPDATE
   Opens the existing post modal.

2. MAINTENANCE
   Visible ONLY when:
       dairy.code is null
       dairy.code is undefined
       dairy.code is ""

   AND user is:
       dairyWorker
       OR admin

   Clicking the card opens the maintenance composer.

3. CLEAR MAINTENANCE
   Visible ONLY to admin.

   Clicking the card opens the maintenance-clear composer.

4. MILKING STATUS
   Visible ONLY when:
       dairy.code > 0
       AND dairy.code is even.

   Clicking the card opens/toggles the milk-status control.

IMPORTANT:
----------------------------------------------------------
    There are NO separate blank composer cards.

    The cards below ARE the clickable controls.

    The actual composer/modal partials are expected to
    already exist elsewhere in the page or be controlled
    by their existing JavaScript.

EXPECTED DATA:
    user
    dairy
==========================================================
*/ %>


<%
    /* ======================================================
       SAFE VALUES
    ====================================================== */

    const currentUser =
        user || {};

    const currentDairy =
        dairy || {};



    /* ======================================================
       USER ROLE
    ====================================================== */

    const userRole =
        currentUser.role || "";



    /* ======================================================
       DAIRY CODE
    ====================================================== */

    const rawCode =
        currentDairy.code;


    const dairyCode =
        (
            rawCode !== null &&
            rawCode !== undefined &&
            rawCode !== ""
        )
            ? Number(rawCode)
            : null;



    /* ======================================================
       CODE CONDITIONS
    ====================================================== */

    const noDairyCode =
        rawCode === null ||
        rawCode === undefined ||
        rawCode === "";


    const canMaintain =
        noDairyCode &&
        (
            userRole === "dairyWorker" ||
            userRole === "admin"
        );


    const canClearMaintenance =
        userRole === "admin";


    const showMilkStatus =
        dairyCode !== null &&
        Number.isFinite(dairyCode) &&
        dairyCode > 0 &&
        dairyCode % 2 === 0;
%>



<section
    class="dairy-update-cards"
    aria-label="Dairy operations"
>


    <!-- =====================================================
         HEADER
    ====================================================== -->

    <div class="dairy-update-header">

        <div class="dairy-update-title">

            <strong>
                <%= currentUser.name
                    ? currentUser.name.split(" ")[0]
                    : "User" %>,
                update
            </strong>

            <span>
                and perform several operations concerning
                <strong>
                    <%= currentDairy.name || "this dairy" %>
                </strong>
            </span>

        </div>

    </div>



    <!-- =====================================================
         HORIZONTAL CARDS
    ====================================================== -->

    <div
        class="dairy-update-scroll"
        role="list"
    >


        <!-- =================================================
             CREATE UPDATE
        ================================================== -->

        <button
            type="button"
            class="dairy-update-card dairy-update-card-create"
            data-open-post-modal
            role="listitem"
        >

            <div class="dairy-update-card-icon">

                <span aria-hidden="true">
                    ✍️
                </span>

            </div>


            <div class="dairy-update-card-content">

                <strong>
                    Create Update
                </strong>

                <span>
                    Share an update about
                    <%= currentDairy.name || "the dairy" %>.
                </span>

            </div>


            <div
                class="dairy-update-card-arrow"
                aria-hidden="true"
            >
                →
            </div>

        </button>



        <!-- =================================================
             MAINTENANCE

             ONLY:
                 no dairy.code

             AND:
                 dairyWorker OR admin
        ================================================== -->

        <% if (canMaintain) { %>

            <button
                type="button"
                class="dairy-update-card dairy-update-card-maintenance"
                data-open-maintenance-composer
                data-dairy-id="<%= currentDairy._id %>"
                role="listitem"
            >

                <div class="dairy-update-card-icon">

                    <span aria-hidden="true">
                        🔧
                    </span>

                </div>


                <div class="dairy-update-card-content">

                    <strong>
                        Maintenance
                    </strong>

                    <span>
                        Record a maintenance issue
                        for this dairy.
                    </span>

                </div>


                <div
                    class="dairy-update-card-arrow"
                    aria-hidden="true"
                >
                    →
                </div>

            </button>

        <% } %>



        <!-- =================================================
             CLEAR MAINTENANCE

             ADMIN ONLY
        ================================================== -->

        <% if (canClearMaintenance) { %>

            <button
                type="button"
                class="dairy-update-card dairy-update-card-clear"
                data-open-maintenance-clear
                data-dairy-id="<%= currentDairy._id %>"
                role="listitem"
            >

                <div class="dairy-update-card-icon">

                    <span aria-hidden="true">
                        🧹
                    </span>

                </div>


                <div class="dairy-update-card-content">

                    <strong>
                        Clear Maintenance
                    </strong>

                    <span>
                        Clear the current maintenance
                        issue.
                    </span>

                </div>


                <div
                    class="dairy-update-card-arrow"
                    aria-hidden="true"
                >
                    →
                </div>

            </button>

        <% } %>



        <!-- =================================================
             MILKING STATUS

             ONLY:
                 positive even dairy.code
        ================================================== -->

        <% if (showMilkStatus) { %>

            <button
                type="button"
                class="dairy-update-card dairy-update-card-milk"
                data-open-milk-status
                data-dairy-id="<%= currentDairy._id %>"
                role="listitem"
            >

                <div class="dairy-update-card-icon">

                    <span aria-hidden="true">
                        🥛
                    </span>

                </div>


                <div class="dairy-update-card-content">

                    <strong>
                        Milking Status
                    </strong>

                    <span>
                        Toggle the milking status
                        of this dairy.
                    </span>

                </div>


                <div class="dairy-update-card-arrow">

                    <span
                        class="dairy-update-mini-toggle"
                        aria-hidden="true"
                    >
                        <span></span>
                    </span>

                </div>

            </button>

        <% } %>


    </div>

</section>



<style>

/* ==========================================================
   UPDATE CARDS
========================================================== */

.dairy-update-cards {

    width: 100%;

    margin:
        0
        0
        18px;

    padding: 0;

    overflow: hidden;

    font-family:
        Arial,
        Helvetica,
        sans-serif;

}



/* ==========================================================
   HEADER
========================================================== */

.dairy-update-header {

    width: 100%;

    padding:
        0
        2px
        10px;

}


.dairy-update-title {

    color:
        #202520;

    font-size:
        13px;

    line-height:
        1.45;

}


.dairy-update-title strong:first-child {

    font-size:
        18px;

    font-weight:
        700;

}


.dairy-update-title span {

    color:
        #7b847e;

}


.dairy-update-title span strong {

    color:
        #4e5952;

    font-weight:
        600;

}



/* ==========================================================
   HORIZONTAL SCROLL
========================================================== */

.dairy-update-scroll {

    width: 100%;

    display: flex;

    gap:
        10px;

    overflow-x:
        auto;

    overflow-y:
        hidden;

    padding:
        2px
        2px
        8px;

    scroll-behavior:
        smooth;

    -webkit-overflow-scrolling:
        touch;

    scrollbar-width:
        none;

}


.dairy-update-scroll::-webkit-scrollbar {

    display: none;

}



/* ==========================================================
   CARD
========================================================== */

.dairy-update-card {

    position: relative;

    flex:
        0 0
        178px;

    width:
        178px;

    min-height:
        112px;

    display:
        flex;

    align-items:
        center;

    gap:
        10px;

    padding:
        12px;

    border:
        1px solid
        #e4e9e6;

    border-radius:
        16px;

    background:
        #ffffff;

    box-shadow:
        0 2px 8px
        rgba(20, 40, 28, .06);

    cursor:
        pointer;

    text-align:
        left;

    font-family:
        inherit;

    appearance:
        none;

    -webkit-appearance:
        none;

    transition:
        transform .16s ease,
        box-shadow .16s ease,
        border-color .16s ease;

}



/* ==========================================================
   HOVER
========================================================== */

.dairy-update-card:hover {

    transform:
        translateY(-2px);

    box-shadow:
        0 5px 14px
        rgba(20, 40, 28, .10);

    border-color:
        #d8e2dc;

}



/* ==========================================================
   ACTIVE
========================================================== */

.dairy-update-card:active {

    transform:
        scale(.97);

}



/* ==========================================================
   ICON
========================================================== */

.dairy-update-card-icon {

    flex:
        0 0
        42px;

    width:
        42px;

    height:
        42px;

    display:
        flex;

    align-items:
        center;

    justify-content:
        center;

    border-radius:
        13px;

    background:
        #eef5f0;

    font-size:
        20px;

}



/* ==========================================================
   CONTENT
========================================================== */

.dairy-update-card-content {

    min-width:
        0;

    flex:
        1;

}


.dairy-update-card-content strong {

    display:
        block;

    margin-bottom:
        4px;

    color:
        #202520;

    font-size:
        13px;

    font-weight:
        700;

    line-height:
        1.25;

}


.dairy-update-card-content span {

    display:
        -webkit-box;

    overflow:
        hidden;

    color:
        #7b847e;

    font-size:
        10px;

    line-height:
        1.35;

    -webkit-box-orient:
        vertical;

    -webkit-line-clamp:
        3;

}



/* ==========================================================
   ARROW
========================================================== */

.dairy-update-card-arrow {

    flex:
        0 0
        auto;

    color:
        #a0aaa4;

    font-size:
        17px;

    font-weight:
        600;

}



/* ==========================================================
   CARD ICON BACKGROUNDS
========================================================== */

.dairy-update-card-create
.dairy-update-card-icon {

    background:
        #edf5ff;

}


.dairy-update-card-maintenance
.dairy-update-card-icon {

    background:
        #fff5e8;

}


.dairy-update-card-clear
.dairy-update-card-icon {

    background:
        #f2f0f8;

}


.dairy-update-card-milk
.dairy-update-card-icon {

    background:
        #edf7f7;

}



/* ==========================================================
   MINI MILKING TOGGLE
========================================================== */

.dairy-update-mini-toggle {

    position:
        relative;

    display:
        block;

    width:
        30px;

    height:
        17px;

    border-radius:
        20px;

    background:
        #dce3df;

}


.dairy-update-mini-toggle span {

    position:
        absolute;

    top:
        3px;

    left:
        3px;

    width:
        11px;

    height:
        11px;

    border-radius:
        50%;

    background:
        #ffffff;

    box-shadow:
        0 1px 3px
        rgba(0, 0, 0, .15);

}



/* ==========================================================
   FOCUS
========================================================== */

.dairy-update-card:focus-visible {

    outline:
        2px solid
        #198754;

    outline-offset:
        2px;

}



/* ==========================================================
   MOBILE
========================================================== */

@media (max-width: 600px) {

    .dairy-update-title strong:first-child {

        font-size:
            17px;

    }


    .dairy-update-title {

        font-size:
            12px;

    }


    .dairy-update-card {

        flex-basis:
            168px;

        width:
            168px;

        min-height:
            106px;

        padding:
            11px;

        border-radius:
            15px;

    }


    .dairy-update-card-icon {

        flex-basis:
            39px;

        width:
            39px;

        height:
            39px;

        border-radius:
            12px;

        font-size:
            18px;

    }


    .dairy-update-card-content strong {

        font-size:
            12px;

    }


    .dairy-update-card-content span {

        font-size:
            9px;

    }

}

</style>



<script>

/* ==========================================================
   UPDATE CARD ACTION BRIDGE
==========================================================

   The cards themselves are clickable.

   The selectors below allow the existing composer/modal
   implementations to handle the actual operation.

   No extra cards are generated.
========================================================== */

(function () {

    /* ======================================================
       CREATE UPDATE
    ====================================================== */

    const createCard =
        document.querySelector(
            "[data-open-post-modal]"
        );


    if (createCard) {

        createCard.addEventListener(
            "click",
            function () {

                /*
                 * Find the existing post composer trigger.
                 */

                const trigger =
                    document.querySelector(
                        ".create-post-card, " +
                        "[data-post-modal-trigger], " +
                        "[data-open-post-modal-trigger]"
                    );


                if (trigger) {

                    trigger.click();

                }

            }
        );

    }



    /* ======================================================
       MAINTENANCE
    ====================================================== */

    const maintenanceCard =
        document.querySelector(
            "[data-open-maintenance-composer]"
        );


    if (maintenanceCard) {

        maintenanceCard.addEventListener(
            "click",
            function () {

                const trigger =
                    document.querySelector(
                        "[data-maintenance-composer-trigger], " +
                        "[data-open-maintenance-composer-trigger]"
                    );


                if (trigger) {

                    trigger.click();

                }

            }
        );

    }



    /* ======================================================
       CLEAR MAINTENANCE
    ====================================================== */

    const clearMaintenanceCard =
        document.querySelector(
            "[data-open-maintenance-clear]"
        );


    if (clearMaintenanceCard) {

        clearMaintenanceCard.addEventListener(
            "click",
            function () {

                const trigger =
                    document.querySelector(
                        "[data-maintenance-clear-trigger], " +
                        "[data-open-maintenance-clear-trigger]"
                    );


                if (trigger) {

                    trigger.click();

                }

            }
        );

    }



    /* ======================================================
       MILKING STATUS
    ====================================================== */

    const milkStatusCard =
        document.querySelector(
            "[data-open-milk-status]"
        );


    if (milkStatusCard) {

        milkStatusCard.addEventListener(
            "click",
            function () {

                const trigger =
                    document.querySelector(
                        "[data-milk-status-trigger], " +
                        "[data-open-milk-status-trigger]"
                    );


                if (trigger) {

                    trigger.click();

                }

            }
        );

    }

})();

</script>