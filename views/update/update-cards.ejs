<% /*
==========================================================
DAIRY OPERATION / COMPOSER CARDS

FILE:
    views/update/update-cards.ejs

PURPOSE:
    Compact horizontal operation navigator for a dairy.

    Cards may:
        - Open the existing post modal
        - Open a maintenance composer
        - Clear maintenance (admin)
        - Toggle milking status

OPERATIONS:
----------------------------------------------------------
    1. Create Update
       Opens the existing post modal.

    2. Maintenance
       Shown when:
           dairy.code is null
           dairy.code is undefined
           dairy.code is empty

       AND user.role is:
           dairyWorker
           admin

    3. Clear Maintenance
       Shown only to:
           admin

    4. Milking Status
       Shown when:
           dairy.code > 0
           dairy.code is even

       Example:
           2   -> shown
           4   -> shown
           6   -> shown

           1   -> hidden
           3   -> hidden
           5   -> hidden
           0   -> hidden
           negative -> hidden

IMPORTANT:
    This component does NOT contain the actual
    composer/modal markup.

    It only includes the appropriate partials/triggers.

EXPECTED DATA:
    user
    dairy
==========================================================
*/ %>


<%
    /* ======================================================
       SAFE VALUES
    ====================================================== */

    const currentUser =
        user || {};

    const currentDairy =
        dairy || {};



    /* ======================================================
       USER ROLE
    ====================================================== */

    const userRole =
        currentUser.role || "";



    /* ======================================================
       DAIRY CODE
    ====================================================== */

    const rawDairyCode =
        currentDairy.code;



    const dairyCode =
        (
            rawDairyCode !== null &&
            rawDairyCode !== undefined &&
            rawDairyCode !== ""
        )
            ? Number(rawDairyCode)
            : null;



    /* ======================================================
       DAIRY CODE STATES
    ====================================================== */

    const hasNoDairyCode =
        rawDairyCode === null ||
        rawDairyCode === undefined ||
        rawDairyCode === "";



    const hasPositiveEvenCode =
        dairyCode !== null &&
        Number.isFinite(dairyCode) &&
        dairyCode > 0 &&
        dairyCode % 2 === 0;



    /* ======================================================
       MAINTENANCE PERMISSION
    ====================================================== */

    const canMaintain =
        hasNoDairyCode &&
        (
            userRole === "dairyWorker" ||
            userRole === "admin"
        );



    /* ======================================================
       ADMIN MAINTENANCE CLEAR
    ====================================================== */

    const canClearMaintenance =
        userRole === "admin";
%>



<section
    class="dairy-operation-strip"
    aria-label="Dairy operations"
>


    <!-- =====================================================
         SECTION HEADER
    ====================================================== -->

    <div class="dairy-operation-strip-header">

        <div class="dairy-operation-strip-title">

            <strong>
                <%= currentUser.name
                    ? currentUser.name.split(" ")[0]
                    : "User" %>,
                update
            </strong>

            <span>
                and perform several operations concerning
                <strong>
                    <%= currentDairy.name || "this dairy" %>
                </strong>
            </span>

        </div>

    </div>



    <!-- =====================================================
         HORIZONTAL OPERATION CARDS
    ====================================================== -->

    <div
        class="dairy-operation-scroll"
        role="list"
        aria-label="Dairy operations"
    >


        <!-- =================================================
             1. CREATE UPDATE
        ================================================== -->

        <div
            class="dairy-operation-card dairy-operation-create"
            role="listitem"
            tabindex="0"
            aria-label="Create an update"
            data-open-post-modal
        >

            <div class="dairy-operation-icon">

                <span aria-hidden="true">
                    ✍️
                </span>

            </div>


            <div class="dairy-operation-content">

                <strong>
                    Create Update
                </strong>

                <span>
                    Share something about
                    <%= currentDairy.name || "the dairy" %>.
                </span>

            </div>


            <div
                class="dairy-operation-arrow"
                aria-hidden="true"
            >
                →
            </div>

        </div>



        <!-- =================================================
             2. MAINTENANCE COMPOSER
             
             Render only when:
                 dairy.code missing/null/undefined

             AND:
                 dairyWorker
                 OR admin
        ================================================== -->

        <% if (canMaintain) { %>

            <div
                class="dairy-operation-card dairy-operation-maintenance"
                role="listitem"
            >

                <div class="dairy-operation-icon">

                    <span aria-hidden="true">
                        🔧
                    </span>

                </div>


                <div class="dairy-operation-content">

                    <strong>
                        Maintenance
                    </strong>

                    <span>
                        Record a maintenance issue
                        for this dairy.
                    </span>

                </div>


                <div
                    class="dairy-operation-arrow"
                    aria-hidden="true"
                >
                    →
                </div>

            </div>


            <!-- =============================================
                 MAINTENANCE COMPOSER PARTIAL

                 Put your actual maintenance composer
                 inside this partial.
            ============================================== -->

            <%- include("../update/maintComposer", {
                user: currentUser,
                dairy: currentDairy
            }) %>

        <% } %>



        <!-- =================================================
             3. CLEAR MAINTENANCE
             
             ADMIN ONLY
        ================================================== -->

        <% if (canClearMaintenance) { %>

            <div
                class="dairy-operation-card dairy-operation-clear"
                role="listitem"
            >

                <div class="dairy-operation-icon">

                    <span aria-hidden="true">
                        🧹
                    </span>

                </div>


                <div class="dairy-operation-content">

                    <strong>
                        Clear Maintenance
                    </strong>

                    <span>
                        Mark the dairy maintenance
                        as cleared.
                    </span>

                </div>


                <div
                    class="dairy-operation-arrow"
                    aria-hidden="true"
                >
                    →
                </div>

            </div>


            <!-- =============================================
                 MAINTENANCE CLEAR COMPOSER
            ============================================== -->

            <%- include("../update/maintenanceClearComposer", {
                user: currentUser,
                dairy: currentDairy
            }) %>

        <% } %>



        <!-- =================================================
             4. MILKING STATUS
             
             ONLY:
                 positive
                 even
                 dairy.code

             Examples:
                 2 -> shown
                 4 -> shown
                 6 -> shown
        ================================================== -->

        <% if (hasPositiveEvenCode) { %>

            <div
                class="dairy-operation-card dairy-operation-milking"
                role="listitem"
            >

                <div class="dairy-operation-icon">

                    <span aria-hidden="true">
                        🥛
                    </span>

                </div>


                <div class="dairy-operation-content">

                    <strong>
                        Milking Status
                    </strong>

                    <span>
                        Toggle the milking status
                        of this dairy.
                    </span>

                </div>


                <div
                    class="dairy-operation-toggle"
                    aria-hidden="true"
                >

                    <span class="dairy-toggle-track">

                        <span class="dairy-toggle-thumb">
                        </span>

                    </span>

                </div>

            </div>


            <!-- =============================================
                 MILK STATUS PARTIAL
            ============================================== -->

            <%- include("../update/milk-status", {
                user: currentUser,
                dairy: currentDairy
            }) %>

        <% } %>


    </div>

</section>



<style>

