<% /*
==========================================================
UPDATE CARDS

FILE:
    views/update/update-cards.ejs

PURPOSE:
----------------------------------------------------------
Main update area for the currently viewed dairy asset.

RULES:
----------------------------------------------------------

1. create.ejs
   • Appears for ALL dairy assets.

2. milk-status.ejs
   • Appears ONLY when dairy.code is a positive EVEN number.

3. maintComposer.ejs
   • Appears ONLY when:
       - dairy.needsMaintenance === false
       - AND dairy has no code
         OR dairy.code is undefined
         OR dairy.code is null

4. maintenanceClearComposer.ejs
   • Appears ONLY when:
       - dairy.needsMaintenance === true

5. milking-history.ejs
   • Appears for dairy assets with a positive EVEN code.
   • The card itself handles navigation to:
       /milk/history/<dairy._id>

EXPECTED DATA:
----------------------------------------------------------
dairy
user
==========================================================
*/ %>


<% if (dairy) { %>


<section class="update-cards">


    <!-- =================================================
         TITLE
    ================================================== -->

    <div class="update-cards-heading">

        <h1 class="update-cards-title">
            Updates
        </h1>

        <p class="update-cards-description">

            Keep us updated about <strong><%= dairy.name %>'s</strong>
            conditions, activities, maintenance and
            important status changes.

        </p>

    </div>



    <!-- =================================================
         TITLE ACCENT
    ================================================== -->

    <div class="update-cards-accent"></div>



    <!-- =================================================
         UPDATE CONTENT
    ================================================== -->

    <div class="update-cards-list">


        <!-- =================================================
             1. CREATE COMPOSER

             ALWAYS VISIBLE
        ================================================== -->

        <%- include("create", {
            dairy: dairy,
            user: user
        }) %>



        <!-- =================================================
             DAIRY CODE

             Used by the milking-related cards.
        ================================================== -->

        <%
            const dairyCodeNumber =
                Number(dairy.code);

            const showMilkingCards =
                Number.isFinite(dairyCodeNumber) &&
                dairyCodeNumber > 0 &&
                dairyCodeNumber % 2 === 0;
        %>



        <!-- =================================================
             2. MILKING STATUS

             ONLY VISIBLE WHEN:

             dairy.code is positive
             AND
             dairy.code is even
        ================================================== -->

        <% if (showMilkingCards) { %>

            <%- include("milk-status", {
                dairy: dairy,
                user: user
            }) %>

        <% } %>



        <!-- =================================================
             3. MILKING HISTORY

             ONLY VISIBLE FOR THE SAME DAIRY ANIMALS
             THAT HAVE THE MILKING STATUS CARD.

             milking-history.ejs handles the link:

                 /milk/history/<%= dairy._id %>
        ================================================== -->

        <% if (showMilkingCards) { %>

            <%- include("milking-history", {
                dairy: dairy,
                user: user
            }) %>

        <% } %>



        <!-- =================================================
             4. MAINTENANCE COMPOSER

             ONLY VISIBLE WHEN:

             dairy.needsMaintenance === false

             AND

             dairy has NO code

             Code conditions:

                 null
                 undefined
        ================================================== -->

        <%
            const hasNoDairyCode =
                dairy.code === null ||
                dairy.code === undefined;

            const showMaintenanceComposer =
                dairy.needsMaintenance === false &&
                hasNoDairyCode;
        %>


        <% if (showMaintenanceComposer) { %>

            <%- include("maintComposer", {
                dairy: dairy,
                user: user
            }) %>

        <% } %>



        <!-- =================================================
             5. CLEAR MAINTENANCE COMPOSER

             ONLY VISIBLE WHEN:

                 dairy.needsMaintenance === true
        ================================================== -->

        <% if (dairy.needsMaintenance === true) { %>

            <%- include("maintenanceClearComposer", {
                dairy: dairy,
                user: user
            }) %>

        <% } %>


    </div>


</section>



<style>

/* ==========================================================
   UPDATE CARDS
========================================================== */

.update-cards {

    width: 100%;

    box-sizing: border-box;

    margin: 0;

    padding: 8px 0 28px;

}



/* ==========================================================
   TITLE SECTION
========================================================== */

.update-cards-heading {

    width: 100%;

    box-sizing: border-box;

    margin: 0;

    padding: 0 4px;

}



/* ==========================================================
   TITLE
========================================================== */

.update-cards-title {

    margin: 0;

    color: #14532d;

    font-size: 34px;

    font-weight: 800;

    line-height: 1.08;

    letter-spacing: -0.8px;

}



/* ==========================================================
   DESCRIPTION
========================================================== */

.update-cards-description {

    max-width: 700px;

    margin: 8px 0 0;

    color: #66736b;

    font-size: 14px;

    font-weight: 500;

    line-height: 1.5;

}


.update-cards-description strong {

    color: #198754;

    font-weight: 800;

}



/* ==========================================================
   TITLE ACCENT
========================================================== */

.update-cards-accent {

    width: 54px;

    height: 4px;

    margin: 13px 0 22px 4px;

    border-radius: 999px;

    background: #198754;

}



/* ==========================================================
   UPDATE CONTENT
========================================================== */

.update-cards-list {

    width: 100%;

    box-sizing: border-box;

    display: flex;

    flex-wrap: wrap;

    align-items: flex-start;

    gap: 16px;

}



/* ==========================================================
   MOBILE
========================================================== */

@media (max-width: 650px) {

    .update-cards {

        padding-top: 5px;

        padding-bottom: 22px;

    }


    .update-cards-title {

        font-size: 29px;

        letter-spacing: -0.6px;

    }


    .update-cards-description {

        font-size: 13px;

        line-height: 1.45;

    }


    .update-cards-accent {

        margin-bottom: 18px;

    }


    .update-cards-list {

        gap: 12px;

    }

}



/* ==========================================================
   SMALL PHONES
========================================================== */

@media (max-width: 380px) {

    .update-cards-title {

        font-size: 26px;

    }


    .update-cards-description {

        font-size: 12px;

    }

}

</style>


<% } %>