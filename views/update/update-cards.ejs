<% /*
==========================================================
DAIRY UPDATE CARDS

FILE:
    views/update/update-cards.ejs

PURPOSE:
    Compact horizontal WhatsApp-style operation cards
    for the currently viewed dairy / dairy asset.

AVAILABLE CARDS:
----------------------------------------------------------

1. ADD AN UPDATE
   • Always visible.
   • Opens create.ejs.

2. MILKING STATUS
   • Only visible when:
         dairy.code > 0
         AND dairy.code is even
   • Only visible to:
         admin
         dairyWorker
   • Opens milk-status.ejs.

3. MAINTENANCE
   • Only visible when:
         dairy.code is null
         OR undefined
         OR ""
   • Only visible to:
         admin
         dairyWorker
   • Opens maintComposer.ejs.

4. CLEAR MAINTENANCE
   • Only visible when:
         dairy.code is null
         OR undefined
         OR ""
   • Only visible to:
         admin
   • Opens maintenanceClearComposer.ejs.

IMPORTANT:
----------------------------------------------------------
    No blank cards.
    No placeholder cards.
    No unrelated operations.

    The cards themselves are clickable.

    The actual composers remain in their respective
    EJS partials and are opened through their existing
    triggers.

EXPECTED DATA:
----------------------------------------------------------
    user
    dairy

==========================================================
*/ %>


<%
    /* ======================================================
       SAFE VALUES
    ====================================================== */

    const currentUser =
        user || {};

    const currentDairy =
        dairy || {};



    /* ======================================================
       USER ROLE
    ====================================================== */

    const userRole =
        currentUser.role || "";



    /* ======================================================
       RAW DAIRY CODE
    ====================================================== */

    const rawCode =
        currentDairy.code;



    /* ======================================================
       NORMALIZED DAIRY CODE
    ====================================================== */

    const dairyCode =
        (
            rawCode !== null &&
            rawCode !== undefined &&
            rawCode !== ""
        )
            ? Number(rawCode)
            : null;



    /* ======================================================
       NO-CODE RECORD
       
       Used for:
           Structures
           Facilities
           Tools
           Other non-animal assets
    ====================================================== */

    const hasNoCode =
        rawCode === null ||
        rawCode === undefined ||
        rawCode === "";



    /* ======================================================
       STAFF ACCESS
    ====================================================== */

    const canManage =
        userRole === "admin" ||
        userRole === "dairyWorker";



    /* ======================================================
       MAINTENANCE CARD
       
       Admin + dairyWorker
       AND no dairy code.
    ====================================================== */

    const showMaintenance =
        hasNoCode &&
        canManage;



    /* ======================================================
       CLEAR MAINTENANCE CARD
       
       Admin only
       AND no dairy code.
    ====================================================== */

    const showMaintenanceClear =
        hasNoCode &&
        userRole === "admin";



    /* ======================================================
       MILKING STATUS CARD
       
       Admin + dairyWorker
       AND positive EVEN code.
    ====================================================== */

    const showMilkStatus =
        Number.isFinite(dairyCode) &&
        dairyCode > 0 &&
        dairyCode % 2 === 0 &&
        canManage;
%>



<section
    class="dairy-update-cards"
    aria-label="Dairy updates and operations"
>


    <!-- =====================================================
         SECTION INTRO
    ====================================================== -->

    <div class="dairy-update-header">

        <div class="dairy-update-heading">

            <strong>
                <%= currentUser.name
                    ? currentUser.name.split(" ")[0]
                    : "User" %>
            </strong>

            <span>
                — update and manage
            </span>

            <strong>
                <%= currentDairy.name || "this dairy" %>
            </strong>

        </div>

    </div>



    <!-- =====================================================
         ACTION CARDS
    ====================================================== -->

    <div
        class="dairy-update-scroll"
        role="list"
        aria-label="Available dairy actions"
    >


        <!-- =================================================
             ADD AN UPDATE
             
             ALWAYS VISIBLE
        ================================================== -->

        <button
            type="button"
            class="
                dairy-update-card
                dairy-update-card--create
            "
            data-update-card="create"
            aria-label="Add an update about <%= currentDairy.name || 'this dairy' %>"
            role="listitem"
        >

            <div class="dairy-update-card__icon">

                <span aria-hidden="true">
                    +
                </span>

            </div>


            <div class="dairy-update-card__content">

                <strong>
                    Add an Update
                </strong>

                <span>
                    Share something about
                    <%= currentDairy.name || "this dairy" %>.
                </span>

            </div>


            <div
                class="dairy-update-card__arrow"
                aria-hidden="true"
            >
                →
            </div>

        </button>



        <!-- =================================================
             MILKING STATUS
             
             ONLY:
                 admin / dairyWorker
                 positive even code
        ================================================== -->

        <% if (showMilkStatus) { %>

            <button
                type="button"
                class="
                    dairy-update-card
                    dairy-update-card--milk
                "
                data-update-card="milk-status"
                data-dairy-id="<%= currentDairy._id %>"
                aria-label="Manage milking status for <%= currentDairy.name || 'this dairy animal' %>"
                role="listitem"
            >

                <div class="dairy-update-card__icon">

                    <span aria-hidden="true">
                        🥛
                    </span>

                </div>


                <div class="dairy-update-card__content">

                    <strong>
                        Milking Status
                    </strong>

                    <span>
                        Check or change the current
                        milking status.
                    </span>

                </div>


                <div
                    class="dairy-update-card__arrow"
                    aria-hidden="true"
                >
                    →
                </div>

            </button>

        <% } %>



        <!-- =================================================
             MAINTENANCE
             
             ONLY:
                 admin / dairyWorker
                 no code
        ================================================== -->

        <% if (showMaintenance) { %>

            <button
                type="button"
                class="
                    dairy-update-card
                    dairy-update-card--maintenance
                "
                data-update-card="maintenance"
                data-dairy-id="<%= currentDairy._id %>"
                aria-label="Record maintenance for <%= currentDairy.name || 'this dairy asset' %>"
                role="listitem"
            >

                <div class="dairy-update-card__icon">

                    <span aria-hidden="true">
                        🔧
                    </span>

                </div>


                <div class="dairy-update-card__content">

                    <strong>
                        Maintenance
                    </strong>

                    <span>
                        Record a maintenance issue
                        or service for this asset.
                    </span>

                </div>


                <div
                    class="dairy-update-card__arrow"
                    aria-hidden="true"
                >
                    →
                </div>

            </button>

        <% } %>



        <!-- =================================================
             CLEAR MAINTENANCE
             
             ONLY:
                 admin
                 no code
        ================================================== -->

        <% if (showMaintenanceClear) { %>

            <button
                type="button"
                class="
                    dairy-update-card
                    dairy-update-card--clear
                "
                data-update-card="maintenance-clear"
                data-dairy-id="<%= currentDairy._id %>"
                aria-label="Clear maintenance for <%= currentDairy.name || 'this dairy asset' %>"
                role="listitem"
            >

                <div class="dairy-update-card__icon">

                    <span aria-hidden="true">
                        ✓
                    </span>

                </div>


                <div class="dairy-update-card__content">

                    <strong>
                        Clear Maintenance
                    </strong>

                    <span>
                        Mark the current maintenance
                        issue as cleared.
                    </span>

                </div>


                <div
                    class="dairy-update-card__arrow"
                    aria-hidden="true"
                >
                    →
                </div>

            </button>

        <% } %>


    </div>

</section>



<style>

/* ==========================================================
   ROOT
========================================================== */

.dairy-update-cards {

    width: 100%;

    margin:
        0
        0
        18px;

    padding: 0;

    overflow: hidden;

    font-family:
        Arial,
        Helvetica,
        sans-serif;

}



/* ==========================================================
   HEADER
========================================================== */

.dairy-update-header {

    width: 100%;

    padding:
        0
        2px
        10px;

}


.dairy-update-heading {

    display: flex;

    align-items: baseline;

    flex-wrap: wrap;

    column-gap: 4px;

    row-gap: 1px;

    color: #707972;

    font-size: 12px;

    line-height: 1.45;

}


.dairy-update-heading strong {

    color: #202520;

    font-size: 14px;

    font-weight: 700;

}


.dairy-update-heading strong:first-child {

    font-size: 18px;

}


.dairy-update-heading span {

    color: #7b847e;

}



/* ==========================================================
   HORIZONTAL SCROLL
========================================================== */

.dairy-update-scroll {

    width: 100%;

    display: flex;

    align-items: stretch;

    gap: 10px;

    overflow-x: auto;

    overflow-y: hidden;

    padding:
        2px
        3px
        8px;

    scroll-behavior: smooth;

    -webkit-overflow-scrolling: touch;

    scrollbar-width: none;

}


.dairy-update-scroll::-webkit-scrollbar {

    display: none;

}



/* ==========================================================
   CARD
========================================================== */

.dairy-update-card {

    position: relative;

    flex:
        0 0
        184px;

    width: 184px;

    min-height: 112px;

    display: flex;

    align-items: center;

    gap: 10px;

    padding: 12px;

    border:
        1px solid
        #e3e9e5;

    border-radius: 16px;

    background: #ffffff;

    box-shadow:
        0 3px 10px
        rgba(20, 40, 28, .06);

    cursor: pointer;

    text-align: left;

    font-family: inherit;

    appearance: none;

    -webkit-appearance: none;

    transition:
        transform .15s ease,
        box-shadow .15s ease,
        border-color .15s ease;

}


.dairy-update-card:hover {

    transform:
        translateY(-2px);

    border-color:
        #d4ded8;

    box-shadow:
        0 6px 16px
        rgba(20, 40, 28, .09);

}


.dairy-update-card:active {

    transform:
        scale(.97);

}


.dairy-update-card:focus-visible {

    outline:
        2px solid
        #198754;

    outline-offset:
        2px;

}



/* ==========================================================
   ICON
========================================================== */

.dairy-update-card__icon {

    width: 44px;
    height: 44px;

    flex:
        0 0
        44px;

    display: flex;

    align-items: center;

    justify-content: center;

    border-radius: 13px;

    font-size: 21px;

    font-weight: 500;

}


.dairy-update-card--create
.dairy-update-card__icon {

    background:
        #edf5ff;

    color:
        #2563eb;

}


.dairy-update-card--milk
.dairy-update-card__icon {

    background:
        #edf7f7;

    color:
        #087f8c;

}


.dairy-update-card--maintenance
.dairy-update-card__icon {

    background:
        #fff5e8;

    color:
        #c26b00;

}


.dairy-update-card--clear
.dairy-update-card__icon {

    background:
        #edf7f0;

    color:
        #198754;

}



/* ==========================================================
   PLUS SIGN
========================================================== */

.dairy-update-card--create
.dairy-update-card__icon span {

    display: block;

    font-size: 31px;

    font-weight: 300;

    line-height: 1;

}



/* ==========================================================
   CARD CONTENT
========================================================== */

.dairy-update-card__content {

    min-width: 0;

    flex: 1;

}


.dairy-update-card__content strong {

    display: block;

    margin-bottom: 4px;

    color:
        #202520;

    font-size:
        13px;

    font-weight:
        700;

    line-height:
        1.25;

}


.dairy-update-card__content span {

    display:
        -webkit-box;

    overflow:
        hidden;

    color:
        #7b847e;

    font-size:
        10px;

    line-height:
        1.4;

    -webkit-box-orient:
        vertical;

    -webkit-line-clamp:
        3;

}



/* ==========================================================
   ARROW
========================================================== */

.dairy-update-card__arrow {

    flex:
        0 0
        auto;

    color:
        #a2aba5;

    font-size:
        18px;

    font-weight:
        500;

}



/* ==========================================================
   MOBILE
========================================================== */

@media (max-width: 600px) {

    .dairy-update-heading {

        font-size:
            11px;

    }


    .dairy-update-heading strong {

        font-size:
            13px;

    }


    .dairy-update-heading strong:first-child {

        font-size:
            17px;

    }


    .dairy-update-card {

        flex-basis:
            170px;

        width:
            170px;

        min-height:
            106px;

        padding:
            11px;

        border-radius:
            15px;

    }


    .dairy-update-card__icon {

        width:
            40px;

        height:
            40px;

        flex-basis:
            40px;

        border-radius:
            12px;

        font-size:
            19px;

    }


    .dairy-update-card--create
    .dairy-update-card__icon span {

        font-size:
            28px;

    }


    .dairy-update-card__content strong {

        font-size:
            12px;

    }


    .dairy-update-card__content span {

        font-size:
            9px;

    }

}



/* ==========================================================
   VERY SMALL SCREENS
========================================================== */

@media (max-width: 380px) {

    .dairy-update-card {

        flex-basis:
            162px;

        width:
            162px;

    }

}

</style>



<script>

/* ==========================================================
   UPDATE CARD ACTION BRIDGE

   The cards are only triggers.

   They do NOT duplicate:
       • post composer
       • maintenance composer
       • maintenance-clear composer
       • milking form

   The existing EJS components remain responsible for
   their own modal/form behaviour.
========================================================== */

(function () {

    "use strict";



    /* ======================================================
       CREATE UPDATE
       
       Opens:
           create.ejs
       
       Primary trigger:
           #coreCreatePostOpen
    ====================================================== */

    const createCard =
        document.querySelector(
            '[data-update-card="create"]'
        );


    if (createCard) {

        createCard.addEventListener(
            "click",
            function () {

                const trigger =
                    document.getElementById(
                        "coreCreatePostOpen"
                    );


                if (trigger) {

                    trigger.click();

                    return;

                }


                /*
                 * Compatibility fallbacks.
                 */

                const fallback =
                    document.querySelector(
                        "[data-post-modal-trigger], " +
                        "[data-open-post-modal-trigger], " +
                        ".create-post-card"
                    );


                if (fallback) {

                    fallback.click();

                }

            }
        );

    }



    /* ======================================================
       MILKING STATUS
       
       Opens:
           milk-status.ejs
       
       This card is only rendered for the correct
       user role and dairy code, so no extra permission
       logic is needed here.
    ====================================================== */

    const milkCard =
        document.querySelector(
            '[data-update-card="milk-status"]'
        );


    if (milkCard) {

        milkCard.addEventListener(
            "click",
            function () {

                const trigger =
                    document.querySelector(
                        "[data-milk-status-trigger], " +
                        "[data-open-milk-status-trigger]"
                    );


                if (trigger) {

                    trigger.click();

                    return;

                }


                /*
                 * Compatibility fallback.
                 *
                 * If milk-status.ejs exposes the actual
                 * toggle button directly, allow the card
                 * to activate it.
                 */

                const fallback =
                    document.querySelector(
                        ".milk-status-button"
                    );


                if (fallback) {

                    fallback.click();

                }

            }
        );

    }



    /* ======================================================
       MAINTENANCE
       
       Opens:
           maintComposer.ejs
    ====================================================== */

    const maintenanceCard =
        document.querySelector(
            '[data-update-card="maintenance"]'
        );


    if (maintenanceCard) {

        maintenanceCard.addEventListener(
            "click",
            function () {

                const trigger =
                    document.querySelector(
                        "[data-maintenance-composer-trigger], " +
                        "[data-open-maintenance-composer-trigger], " +
                        "[data-open-maintenance-composer]"
                    );


                if (trigger) {

                    trigger.click();

                }

            }
        );

    }



    /* ======================================================
       CLEAR MAINTENANCE
       
       Opens:
           maintenanceClearComposer.ejs
    ====================================================== */

    const maintenanceClearCard =
        document.querySelector(
            '[data-update-card="maintenance-clear"]'
        );


    if (maintenanceClearCard) {

        maintenanceClearCard.addEventListener(
            "click",
            function () {

                const trigger =
                    document.querySelector(
                        "[data-maintenance-clear-trigger], " +
                        "[data-open-maintenance-clear-trigger], " +
                        "[data-open-maintenance-clear]"
                    );


                if (trigger) {

                    trigger.click();

                }

            }
        );

    }

})();

</script>