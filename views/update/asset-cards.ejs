<% /*
=========================================================
DAIRY HORIZONTAL CARDS

FILE:
    views/update/asset-cards.ejs

PURPOSE:
    Compact horizontal Dairy navigator.

    The section:
        - Displays ONLY Dairy records whose dwellNumber is negative
        - Shows the Dairy profile image
        - Shows the Dairy name
        - Shows quantity and unit when available
        - Links directly to /dairy/:id
        - Provides a Dairy-specific update heading

DAIRY RULES:
----------------------------------------------------------
    dwellNumber < 0

IMPORTANT:
    dwellNumber is the selection criterion.

    DO NOT use:
        recordType
        type
        code

    A card is displayed ONLY when:

        Number(dwellNumber) < 0

Cards DO NOT open the post modal.

Clicking a Dairy takes the user directly to:

    /dairy/:id
==========================================================
*/ %>


<%
    /* ======================================================
       SAFE ASSET ARRAY
    ====================================================== */

    const assets =
        Array.isArray(assetDairies)
            ? assetDairies
            : [];


    /* ======================================================
       ONLY DAIRIES WITH NEGATIVE DWELL NUMBER

       Selection is based ONLY on dwellNumber.

       Do NOT use:
           recordType
           type
           code
    ====================================================== */

    const dairies =
        assets.filter(function (asset) {

            if (!asset) {
                return false;
            }


            const dwellNumber =
                Number(
                    asset.dwellNumber
                );


            return (
                Number.isFinite(dwellNumber) &&
                dwellNumber < 0
            );

        });
%>


<% if (dairies.length) { %>

<section
    class="dairy-feed-strip"
    aria-label="Dairies with negative dwell numbers"
>


    <!-- =====================================================
         SECTION HEADER
    ====================================================== -->

    <div class="dairy-feed-strip-header">


        <div class="dairy-feed-strip-title">

            <strong>
                Give updates about the dairy feeds currently available in
                <%= dairy.name %>
            </strong>

        </div>


        <div class="dairy-feed-strip-description">

            Select a Dairy below to view its details and give
            updates about the dairies currently present in
            <strong><%= dairy.name %></strong>.

        </div>


    </div>



    <!-- =====================================================
         HORIZONTAL DAIRY SCROLL
    ====================================================== -->

    <div
        class="dairy-feed-scroll"
        role="list"
        aria-label="Dairies with negative dwell numbers in <%= dairy.name %>"
    >


        <% dairies.forEach(function (asset) { %>

            <%
                /* =================================================
                   SAFETY CHECK
                ================================================= */

                if (
                    !asset ||
                    !asset._id
                ) {
                    return;
                }


                /* =================================================
                   DAIRY NAME
                ================================================= */

                const dairyName =
                    asset.name ||
                    "Unnamed Dairy";


                /* =================================================
                   DAIRY IMAGE
                ================================================= */

                const dairyImage =
                    asset.displayImage ||
                    asset.profileImage ||
                    (
                        "https://ui-avatars.com/api/?name=" +
                        encodeURIComponent(
                            dairyName
                        ) +
                        "&background=e8f5ee&color=198754"
                    );


                /* =================================================
                   QUANTITY
                ================================================= */

                let dairyQuantityText = "";


                if (
                    asset.quantity !== null &&
                    asset.quantity !== undefined &&
                    asset.quantity !== ""
                ) {

                    const quantity =
                        Number(asset.quantity);


                    if (
                        Number.isFinite(
                            quantity
                        )
                    ) {

                        dairyQuantityText =
                            `${quantity}` +
                            (
                                asset.unit
                                    ? ` ${asset.unit}`
                                    : ""
                            );

                    }

                }
            %>



            <!-- =================================================
                 DAIRY CARD
            ================================================== -->

            <a
                href="/dairy/<%= asset._id %>"
                class="dairy-feed-card"
                role="listitem"
                aria-label="Give updates about <%= dairyName %>"
            >


                <!-- =============================================
                     IMAGE
                ============================================== -->

                <div class="dairy-feed-image-wrap">

                    <img
                        src="<%= dairyImage %>"
                        alt="<%= dairyName %>"
                        class="dairy-feed-image"
                        loading="lazy"
                    >

                </div>



                <!-- =============================================
                     DAIRY INFORMATION
                ============================================== -->

                <div class="dairy-feed-content">


                    <!-- =========================================
                         DAIRY NAME
                    ========================================== -->

                    <div class="dairy-feed-name">

                        <%= dairyName %>

                    </div>



                    <!-- =========================================
                         DAIRY TYPE
                    ========================================== -->

                    <div class="dairy-feed-type">

                        <span
                            class="dairy-feed-type-icon"
                            aria-hidden="true"
                        >
                            🐄
                        </span>

                        <span>
                            Dairy
                        </span>

                    </div>



                    <!-- =========================================
                         QUANTITY
                    ========================================== -->

                    <% if (dairyQuantityText) { %>

                        <div class="dairy-feed-quantity">

                            <span
                                class="dairy-feed-quantity-label"
                            >
                                Stock:
                            </span>

                            <span>
                                <%= dairyQuantityText %>
                            </span>

                        </div>

                    <% } %>


                </div>


            </a>


        <% }); %>


    </div>


</section>



<style>

