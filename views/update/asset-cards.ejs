    width:
        100%;

    padding:
        0
        2px
        10px;

}



/* ==========================================================
   TITLE
========================================================== */

.dairy-feed-strip-title {

    width:
        100%;

}


.dairy-feed-strip-title strong {

    display:
        block;

    color:
        #2E7D32;

    font-size:
        18px;

    font-weight:
        700;

    line-height:
        1.35;

}



/* ==========================================================
   DESCRIPTION
========================================================== */

.dairy-feed-strip-description {

    max-width:
        620px;

    margin-top:
        4px;

    color:
        #7b847e;

    font-size:
        12px;

    line-height:
        1.45;

}


.dairy-feed-strip-description strong {

    color:
        #4e5952;

    font-weight:
        600;

}



/* ==========================================================
   HORIZONTAL SCROLL
========================================================== */

.dairy-feed-scroll {

    width:
        100%;

    display:
        flex;

    gap:
        10px;

    overflow-x:
        auto;

    overflow-y:
        hidden;

    padding:
        2px
        2px
        8px;

    scroll-behavior:
        smooth;

    -webkit-overflow-scrolling:
        touch;

    scrollbar-width:
        none;

}


.dairy-feed-scroll::-webkit-scrollbar {

    display:
        none;

}



/* ==========================================================
   DAIRY CARD
========================================================== */

.dairy-feed-card {

    position:
        relative;

    flex:
        0 0
        116px;

    width:
        116px;

    height:
        190px;

    display:
        flex;

    flex-direction:
        column;

    overflow:
        hidden;

    text-decoration:
        none;

    border:
        1px solid
        #e4e9e6;

    border-radius:
        15px;

    background:
        #ffffff;

    box-shadow:
        0 2px 8px
        rgba(20, 40, 28, .06);

