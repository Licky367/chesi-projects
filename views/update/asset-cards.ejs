   IMAGE
========================================================== */

.dairy-feed-image {

    width:
        100%;

    height:
        100%;

    display:
        block;

    object-fit:
        cover;

}



/* ==========================================================
   DAIRY CONTENT
========================================================== */

.dairy-feed-content {

    width:
        100%;

    min-width:
        0;

    display:
        flex;

    flex-direction:
        column;

    flex:
