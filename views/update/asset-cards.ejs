<% /*
=========================================================
DAIRY FEED HORIZONTAL CARDS

FILE:
    views/update/asset-cards.ejs

PURPOSE:
    Compact horizontal feed navigator.

    The section:
        - Displays ONLY Dairy records whose type is "feeds"
        - Shows the feed profile image
        - Shows the feed name
        - Shows the feed quantity and unit when available
        - Links directly to /dairy/:id
        - Provides a feed-specific update heading

FEED RULES:
----------------------------------------------------------
    recordType === "structure"
        AND
    type === "feeds"

IMPORTANT:
    "feeds" is a TYPE.

    It is NOT a recordType.

    Therefore:

        recordType = "structure"
        type       = "feeds"

Cards DO NOT open the post modal.

Clicking a feed takes the user directly to:

    /dairy/:id
==========================================================
*/ %>


<%
    /* ======================================================
       SAFE ASSET ARRAY
    ====================================================== */

    const assets =
        Array.isArray(assetDairies)
            ? assetDairies
            : [];


    /* ======================================================
       ONLY FEED RECORDS
       
       According to models/dairy.js:

           recordType = "structure"
           type       = "feeds"

       Do NOT use code to determine this.
    ====================================================== */

    const feeds =
        assets.filter(function (asset) {

            if (!asset) {
                return false;
            }


            const recordType =
                String(
                    asset.recordType || ""
                )
                    .trim()
                    .toLowerCase();


            const type =
                String(
                    asset.type || ""
                )
                    .trim()
                    .toLowerCase();


            return (
                recordType === "structure" &&
                type === "feeds"
            );

        });
%>


<% if (feeds.length) { %>

<section
    class="dairy-feed-strip"
    aria-label="Dairy animal feeds"
>


    <!-- =====================================================
         SECTION HEADER
    ====================================================== -->

    <div class="dairy-feed-strip-header">


        <div class="dairy-feed-strip-title">

            <strong>
                Give updates about the animal feeds present in
                <%= dairy.name %>
            </strong>

        </div>


        <div class="dairy-feed-strip-description">

            Select a feed below to view its details and give
            updates about the animal feeds currently present
            in <strong><%= dairy.name %></strong>.

        </div>


    </div>



    <!-- =====================================================
         HORIZONTAL FEED SCROLL
    ====================================================== -->

    <div
        class="dairy-feed-scroll"
        role="list"
        aria-label="Animal feeds in <%= dairy.name %>"
    >


        <% feeds.forEach(function (feed) { %>

            <%
                /* =================================================
                   SAFETY CHECK
                ================================================= */

                if (
                    !feed ||
                    !feed._id
                ) {
                    return;
                }


                /* =================================================
                   FEED NAME
                ================================================= */

                const feedName =
                    feed.name ||
                    "Unnamed Feed";


                /* =================================================
                   FEED IMAGE
                ================================================= */

                const feedImage =
                    feed.displayImage ||
                    feed.profileImage ||
                    (
                        "https://ui-avatars.com/api/?name=" +
                        encodeURIComponent(
                            feedName
                        ) +
                        "&background=e8f5ee&color=198754"
                    );


                /* =================================================
                   FEED QUANTITY
                ================================================= */

                let feedQuantityText = "";


                if (
                    feed.quantity !== null &&
                    feed.quantity !== undefined &&
                    feed.quantity !== ""
                ) {

                    const quantity =
                        Number(feed.quantity);


                    if (
                        Number.isFinite(
                            quantity
                        )
                    ) {

                        feedQuantityText =
                            `${quantity}` +
                            (
                                feed.unit
                                    ? ` ${feed.unit}`
                                    : ""
                            );

                    }

                }
            %>



            <!-- =================================================
                 FEED CARD
            ================================================== -->

            <a
                href="/dairy/<%= feed._id %>"
                class="dairy-feed-card"
                role="listitem"
                aria-label="Give updates about <%= feedName %>"
            >


                <!-- =============================================
                     IMAGE
                ============================================== -->

                <div class="dairy-feed-image-wrap">

                    <img
                        src="<%= feedImage %>"
                        alt="<%= feedName %>"
                        class="dairy-feed-image"
                        loading="lazy"
                    >

                </div>



                <!-- =============================================
                     FEED INFORMATION
                ============================================== -->

                <div class="dairy-feed-content">


                    <!-- =========================================
                         FEED NAME
                    ========================================== -->

                    <div class="dairy-feed-name">

                        <%= feedName %>

                    </div>



                    <!-- =========================================
                         FEED TYPE
                    ========================================== -->

                    <div class="dairy-feed-type">

                        <span
                            class="dairy-feed-type-icon"
                            aria-hidden="true"
                        >
                            🌾
                        </span>

                        <span>
                            Animal Feed
                        </span>

                    </div>



                    <!-- =========================================
                         QUANTITY
                    ========================================== -->

                    <% if (feedQuantityText) { %>

                        <div class="dairy-feed-quantity">

                            <span
                                class="dairy-feed-quantity-label"
                            >
                                Stock:
                            </span>

                            <span>
                                <%= feedQuantityText %>
                            </span>

                        </div>

                    <% } %>


                </div>


            </a>


        <% }); %>


    </div>


</section>



