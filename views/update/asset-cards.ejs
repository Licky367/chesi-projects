    transform:
        translateY(-2px);

    box-shadow:
        0 5px 14px
        rgba(20, 40, 28, .10);

}



/* ==========================================================
   CARD ACTIVE
========================================================== */

.dairy-feed-card:active {

    transform:
        scale(.97);

}



/* ==========================================================
   IMAGE WRAPPER
========================================================== */

.dairy-feed-image-wrap {

    position:
        relative;

    width:
        100%;

    height:
        116px;

    flex:
        0 0
        116px;

    overflow:
        hidden;

    background:
        #eef3ef;

}



