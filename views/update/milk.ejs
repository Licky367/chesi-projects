<!-- =======================================================
     WEEKLY MILK REPORT
======================================================= -->

<article
    class="feed-card milk-card"
    data-id="<%= item._id %>"
    data-type="milk"
>

    <!-- =================================================
         HEADER
    ================================================== -->

    <div class="feed-header">

        <div class="feed-user">

            <img
                src="<%= item.userImage || ('https://ui-avatars.com/api/?name=' + encodeURIComponent(item.userName || 'System')) %>"
                class="avatar-sm"
                alt="<%= item.userName || 'System' %>"
            >

            <div class="feed-user-info">

                <strong>
                    <%= item.userName || "System" %>
                </strong>

                <small>
                    <%= item.dateText %>
                </small>

            </div>

        </div>


        <!-- =================================================
             DELETE REPORT
        ================================================== -->

        <% if (
            user &&
            (
                user.role === "admin" ||
                (
                    user._id &&
                    item.userId &&
                    user._id.toString() === item.userId.toString()
                )
            )
        ) { %>

            <button
                class="delete-post"
                data-id="<%= item._id %>"
                data-type="milk"
                title="Delete Report"
                aria-label="Delete Report"
                type="button"
            >

                <i
                    class="bi bi-trash3-fill"
                    aria-hidden="true"
                ></i>

            </button>

        <% } %>

    </div>


    <!-- =================================================
         BODY
    ================================================== -->

    <div class="feed-body">

        <!-- =================================================
             REPORT TITLE
        ================================================== -->

        <h3>

            🥛 Weekly Milk Report

            <% if (item.dairyName && item.dairyId) { %>

                <span>
                    for
                </span>

                <a
                    href="/dairy/<%= item.dairyId %>"
                    class="milk-dairy-link"
                    title="View <%= item.dairyName %>"
                >
                    <%= item.dairyName %>
                </a>

            <% } %>

        </h3>


        <!-- =================================================
             WEEK
        ================================================== -->

        <% if (item.weekStart && item.weekEnd) { %>

            <p>

                <strong>
                    Week:
                </strong>

                <%= item.weekStart %>
                -
                <%= item.weekEnd %>

            </p>

        <% } %>


        <!-- =================================================
             TITLE / DESCRIPTION
        ================================================== -->

        <% if (
            item.title &&
            item.title !== "Weekly Milk Report"
        ) { %>

            <p>

                <%= item.title %>

            </p>

        <% } %>


        <!-- =================================================
             WEEKLY TABLE
        ================================================== -->

        <div class="table-wrapper">

            <table class="weekly-table">

                <thead>

                    <tr>

                        <th>
                            Day
                        </th>

                        <th>
                            Total
                        </th>

                    </tr>

                </thead>

                <tbody>

                    <% item.days.forEach(day => { %>

                        <tr>

                            <td>
                                <%= day.day %>
                            </td>

                            <td>
                                <%= day.total %> L
                            </td>

                        </tr>

                    <% }) %>

                </tbody>

            </table>

        </div>


        <!-- =================================================
             AVERAGE
        ================================================== -->

        <div class="weekly-average">

            Average

            <strong>
                <%= item.average %> L/day
            </strong>

        </div>

    </div>


    <!-- =================================================
         ACTIONS
    ================================================== -->

    <%- include("partials/feed-actions", {
        item,
        type: "milk"
    }) %>


    <!-- =================================================
         COMMENTS
    ================================================== -->

    <%- include("comment-section", {
        item,
        user,
        type: "milk"
    }) %>

</article>