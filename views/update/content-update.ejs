</style>



<script>

(function () {

    "use strict";


    /* ======================================================
       UPDATE COMPOSER
    ======================================================= */

    const composer =
        document.querySelector(
            "[data-history-composer]"
        );


    const openComposerButtons =
        document.querySelectorAll(
            "[data-open-composer]"
        );


    const closeComposerButtons =
        document.querySelectorAll(
            "[data-close-composer]"
        );


    function openComposer() {

        if (!composer) {

            return;

        }

        composer.classList.add(
            "is-open"
        );

        composer.setAttribute(
            "aria-hidden",
            "false"
        );

        document.body.style.overflow =
            "hidden";

    }


    function closeComposer() {

        if (!composer) {

            return;

        }

        composer.classList.remove(
            "is-open"
        );

        composer.setAttribute(
            "aria-hidden",
            "true"
        );

        document.body.style.overflow =
            "";

    }


    openComposerButtons.forEach(
        function (button) {

            button.addEventListener(
                "click",
                openComposer
            );

        }
    );


    closeComposerButtons.forEach(
        function (button) {

            button.addEventListener(
                "click",
                closeComposer
            );

        }
    );



    /* ======================================================
       HISTORY MODAL
    ======================================================= */

    const historyModal =
        document.querySelector(
            "[data-history-modal]"
        );


    const historyCards =
        document.querySelectorAll(
            "[data-history]"
        );


    const closeHistoryButtons =
        document.querySelectorAll(
            "[data-close-history]"
        );


    const modalQuantity =
        document.querySelector(
            "[data-modal-quantity]"
        );


    const modalUser =
        document.querySelector(
            "[data-modal-user]"
        );


    const modalDate =
        document.querySelector(
            "[data-modal-date]"
        );


    const modalNote =
        document.querySelector(
            "[data-modal-note]"
        );


    const modalNoteContainer =
        document.querySelector(
            "[data-modal-note-container]"
        );


    const modalImages =
        document.querySelector(
            "[data-modal-images]"
        );


    function openHistory(data) {

        if (!historyModal) {

            return;

        }


        const quantity =
            data.quantity !== null &&
            data.quantity !== undefined
                ? Number(
                    data.quantity
                ).toLocaleString() +
                  (
                      data.unit
                          ? " " + data.unit
                          : ""
                  )
                : "—";


        if (modalQuantity) {

            modalQuantity.textContent =
                quantity;

        }


        if (modalUser) {

            modalUser.textContent =
                data.user || "Unknown user";

        }


        if (modalDate) {

            modalDate.textContent =
                data.date || "Unknown date";

        }


        if (
            modalNote &&
            modalNoteContainer
        ) {

            if (
                data.note &&
                String(
                    data.note
                ).trim()
            ) {

                modalNote.textContent =
                    data.note;

                modalNoteContainer.style.display =
                    "";

            } else {

                modalNote.textContent =
                    "";

                modalNoteContainer.style.display =
                    "none";

            }

        }


        if (modalImages) {

            modalImages.innerHTML =
                "";


            (
                Array.isArray(
                    data.images
                )
                    ? data.images
                    : []
            ).forEach(
                function (imageUrl) {

                    if (!imageUrl) {

                        return;

                    }


                    const image =
                        document.createElement(
                            "img"
                        );

                    image.src =
                        imageUrl;

                    image.alt =
                        "Stock update image";

                    image.loading =
                        "lazy";

                    modalImages.appendChild(
                        image
                    );

                }
            );

        }


        historyModal.classList.add(
            "is-open"
        );

        historyModal.setAttribute(
            "aria-hidden",
            "false"
        );

        document.body.style.overflow =
            "hidden";

    }


    function closeHistory() {

        if (!historyModal) {

            return;

        }


        historyModal.classList.remove(
            "is-open"
        );

        historyModal.setAttribute(
            "aria-hidden",
            "true"
        );

        document.body.style.overflow =
            "";

    }


    historyCards.forEach(
        function (card) {

            card.addEventListener(
                "click",
                function () {

                    try {

                        const encoded =
                            card.getAttribute(
                                "data-history"
                            );


                        if (!encoded) {

                            return;

                        }


                        const data =
                            JSON.parse(
                                decodeURIComponent(
                                    encoded
                                )
                            );


                        openHistory(
                            data
                        );

                    } catch (error) {

                        console.error(
                            "Unable to open stock update:",
                            error
                        );

                    }

                }
            );

        }
    );


    closeHistoryButtons.forEach(
        function (button) {

            button.addEventListener(
                "click",
                closeHistory
            );

        }
    );


    /* ======================================================
       ESCAPE KEY
    ======================================================= */

    document.addEventListener(
        "keydown",
        function (event) {

            if (
                event.key !==
                "Escape"
            ) {

                return;

            }


            closeComposer();

            closeHistory();

        }
    );

})();

</script>