<!-- ============================================================
     CONTENT UPDATE HISTORY
============================================================= -->

<section
    class="content-update-history"
    aria-label="Stock update history"
>


    <!-- ========================================================
         HEADER
    ========================================================= -->

    <header
        class="content-update-history-header"
    >


        <div
            class="content-update-history-heading"
        >

            <h2
                class="content-update-history-title"
            >

                <%= contentUpdateItemName %> Updates

            </h2>


            <p
                class="content-update-history-description"
            >

                View stock history or record a new update.

            </p>

        </div>


        <span
            class="content-update-history-action-label"
        >

            Stock History

        </span>


    </header>



    <!-- ========================================================
         HORIZONTAL STORY CARDS
    ========================================================= -->

    <div
        class="content-update-history-list"
        role="list"
        aria-label="Stock updates for <%= contentUpdateItemName %>"
    >


        <!-- ====================================================
             FIRST CARD — UPDATE STOCK
        ===================================================== -->

        <% if (contentUpdateAction) { %>

            <div
                class="content-update-card"
                role="listitem"
            >

                <button
                    type="button"
                    class="content-update-open"
                    id="openContentUpdateModal"
                    aria-haspopup="dialog"
                    aria-controls="contentUpdateModal"
                >

                    <span
                        class="content-update-open-inner"
                    >

                        <span
                            class="content-update-open-icon"
                            aria-hidden="true"
                        >

                            +

                        </span>


                        <span
                            class="content-update-open-content"
                        >

                            <strong
                                class="content-update-open-title"
                            >

                                Update Stock

                            </strong>


                            <span
                                class="content-update-open-description"
                            >

                                Record a new quantity,
                                unit, note or images.

                            </span>

                        </span>


                        <span
                            class="content-update-open-arrow"
                            aria-hidden="true"
                        >

                            →

                        </span>

                    </span>

                </button>

            </div>

        <% } %>



        <!-- ====================================================
             HISTORY CARDS
        ===================================================== -->

        <% if (displayHistory.length) { %>


            <% displayHistory.forEach(
                function (
                    update,
                    displayIndex
                ) {

                    const originalIndex =
                        stockHistory.indexOf(
                            update
                        );


                    const previousUpdate =
                        originalIndex > 0
                            ? stockHistory[
                                originalIndex - 1
                            ]
                            : null;


                    let fromQuantity =
                        null;


                    if (
                        previousUpdate &&
                        previousUpdate.quantity !== null &&
                        previousUpdate.quantity !== undefined
                    ) {

                        fromQuantity =
                            Number(
                                previousUpdate.quantity
                            );

                    }


                    const toQuantity =
                        Number(
                            update.quantity
                        );


                    const historyUser =
                        getContentUpdateUserName(
                            update.recordedBy
                        );


                    const historyDate =
                        formatContentUpdateDate(
                            update.recordedAt
                        );


                    const historyNote =
                        update.stockUpdateNote
                            ? String(
                                update.stockUpdateNote
                            ).trim()
                            : "";

            %>


                <article
                    class="content-update-card content-update-history-card"
                    role="listitem"
                >


                    <!-- ========================================
                         HISTORY HEADER
                    ========================================= -->

                    <div
                        class="content-update-history-top"
                    >

                        <span
                            class="content-update-history-date"
                        >

                            <%= historyDate %>

                        </span>


                        <span
                            class="content-update-history-number"
                        >

                            Update
                            <%= displayHistory.length - displayIndex %>

                        </span>

                    </div>



                    <!-- ========================================
                         FROM
                    ========================================= -->

                    <div
                        class="content-update-history-change"
                    >

                        <div
                            class="content-update-change-box"
                        >

                            <span
                                class="content-update-change-label"
                            >

                                From

                            </span>


                            <span
                                class="content-update-change-value"
                            >

                                <% if (fromQuantity !== null) { %>

                                    <%= formatContentQuantity(
                                        fromQuantity
                                    ) %>


                                    <% if (contentUpdateUnit) { %>

                                        <span
                                            class="content-update-change-unit"
                                        >

                                            <%= contentUpdateUnit %>

                                        </span>

                                    <% } %>

                                <% } else { %>

                                    Initial

                                <% } %>

                            </span>

                        </div>



                        <!-- ====================================
                             ARROW
                        ===================================== -->

                        <span
                            class="content-update-change-arrow"
                            aria-hidden="true"
                        >

                            ↓

                        </span>



                        <!-- ====================================
                             TO
                        ===================================== -->

                        <div
                            class="content-update-change-box"
                        >

                            <span
                                class="content-update-change-label"
                            >

                                To

                            </span>


                            <span
                                class="content-update-change-value"
                            >

                                <%= formatContentQuantity(
                                    toQuantity
                                ) %>


                                <% if (contentUpdateUnit) { %>

                                    <span
                                        class="content-update-change-unit"
                                    >

                                        <%= contentUpdateUnit %>

                                    </span>

                                <% } %>

                            </span>

                        </div>

                    </div>



                    <!-- ========================================
                         USER
                    ========================================= -->

                    <div
                        class="content-update-history-user"
                    >

                        <span
                            class="content-update-history-user-icon"
                            aria-hidden="true"
                        >

                            👤

                        </span>


                        <span>

                            <strong>
                                By:
                            </strong>

                            <%= historyUser %>

                        </span>

                    </div>



                    <!-- ========================================
                         NOTE
                    ========================================= -->

                    <% if (historyNote) { %>

                        <div
                            class="content-update-history-note"
                        >

                            <%= historyNote %>

                        </div>

                    <% } %>


                </article>


            <% }); %>


        <% } else { %>


            <!-- =================================================
                 EMPTY HISTORY
            ================================================== -->

            <div
                class="content-update-empty"
                role="listitem"
            >

                No stock updates have been recorded yet.

            </div>


        <% } %>


    </div>

</section>



<!-- ============================================================
     UPDATE MODAL
============================================================= -->

<% if (contentUpdateAction) { %>


<div
    class="content-update-modal"
    id="contentUpdateModal"
    role="dialog"
    aria-modal="true"
    aria-labelledby="contentUpdateModalTitle"
    aria-hidden="true"
>


    <div
        class="content-update-modal-dialog"
        role="document"
    >


        <!-- ====================================================
             MODAL HEADER
        ===================================================== -->

        <header
            class="content-update-modal-header"
        >

            <h2
                class="content-update-modal-title"
                id="contentUpdateModalTitle"
            >

                Update
                <%= contentUpdateItemName %>

            </h2>


            <button
                type="button"
                class="content-update-modal-close"
                id="closeContentUpdateModal"
                aria-label="Close update form"
            >

                ×

            </button>

        </header>



        <!-- ====================================================
             MODAL BODY
        ===================================================== -->

        <div
            class="content-update-modal-body"
        >

            <%- include(
                "content-item-update",
                {
                    dairy:
                        contentUpdateDairy,

                    storage:
                        contentUpdateStorage,

                    item:
                        contentUpdateItem,

                    user:
                        contentUpdateUser
                }
            ) %>

        </div>


    </div>

</div>


<script>

(function () {

    /* ========================================================
       ELEMENTS
    ======================================================== */

    const openButton =
        document.getElementById(
            "openContentUpdateModal"
        );


    const closeButton =
        document.getElementById(
            "closeContentUpdateModal"
        );


    const modal =
        document.getElementById(
            "contentUpdateModal"
        );


    if (
        !openButton ||
        !closeButton ||
        !modal
    ) {

        return;

    }


    /* ========================================================
       OPEN MODAL
    ======================================================== */

    function openModal() {

        modal.classList.add(
            "is-open"
        );

        modal.setAttribute(
            "aria-hidden",
            "false"
        );

        document.body.style.overflow =
            "hidden";

    }


    /* ========================================================
       CLOSE MODAL
    ======================================================== */

    function closeModal() {

        modal.classList.remove(
            "is-open"
        );

        modal.setAttribute(
            "aria-hidden",
            "true"
        );

        document.body.style.overflow =
            "";

    }


    /* ========================================================
       OPEN
    ======================================================== */

    openButton.addEventListener(
        "click",
        openModal
    );


    /* ========================================================
       CLOSE
    ======================================================== */

    closeButton.addEventListener(
        "click",
        closeModal
    );


    /* ========================================================
       CLICK OUTSIDE
    ======================================================== */

    modal.addEventListener(
        "click",
        function (event) {

            if (
                event.target === modal
            ) {

                closeModal();

            }

        }
    );


    /* ========================================================
       ESCAPE
    ======================================================== */

    document.addEventListener(
        "keydown",
        function (event) {

            if (
                event.key === "Escape" &&
                modal.classList.contains(
                    "is-open"
                )
            ) {

                closeModal();

            }

        }
    );


})();

</script>


<% } %>