    font-size: 19px;

    line-height: 1.2;

}


.stock-stat-value small {

    color:
        #708078;

    font-size: 10px;

    font-weight: 600;

}


/* ==========================================================
   DESCRIPTION
========================================================== */

.description-box {

    padding:
        15px 17px;

    border-left:
        3px solid
        #4c8a59;

    border-radius:
        0 12px 12px 0;

    background:
        #f6faf6;

    color:
        #526057;

    font-size:
        12px;

    line-height:
        1.65;

}


/* ==========================================================
   HISTORY SCROLL
========================================================== */

.update-history-scroll {

    display: flex;

    gap: 10px;

    overflow-x: auto;

    overflow-y: hidden;

    padding:
        3px
