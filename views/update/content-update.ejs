<script>

/* ==========================================================
   STOCK UPDATE COMPOSER
========================================================== */

(function () {

    const openButton =
        document.getElementById(
            "openStockComposer"
        );

    const closeButton =
        document.getElementById(
            "closeStockComposer"
        );

    const composer =
        document.getElementById(
            "stockUpdateComposer"
        );


    if (
        !openButton ||
        !composer
    ) {

        return;

    }


    /* ======================================================
       OPEN
    ======================================================= */

    openButton.addEventListener(
        "click",
        function () {

            composer.hidden = false;

            openButton.setAttribute(
                "aria-expanded",
                "true"
            );

            /*
                Give the composer a small delay so the
                browser can position it naturally.
            */

            requestAnimationFrame(
                function () {

                    composer.scrollIntoView({
                        behavior:
                            "smooth",

                        block:
                            "start"
                    });

                }
            );

        }
    );


    /* ======================================================
       CLOSE
    ======================================================= */

    if (closeButton) {

        closeButton.addEventListener(
            "click",
            function () {

                composer.hidden = true;

                openButton.setAttribute(
                    "aria-expanded",
                    "false"
                );

                openButton.focus();

            }
        );

    }

})();

</script>