<%
/*
==============================================================
CONTENT UPDATE HISTORY
==============================================================

FILE:
    views/update/content-update.ejs

PURPOSE:
    Displays stock-update history for ONE storage content item.

IMPORTANT:

    THIS IS NOT A PAGE.

    THIS IS AN INCLUDE.

    It belongs to a storage CONTENT ITEM.

CONTENT ITEM IDENTITY:

    item._id
        =
    contentItemId

STORAGE LOCATION:

    item.dwellNumber
        =
    dwellNumber


UPDATE ROUTE:

    POST /dairy/:contentItemId/:dwellNumber


EXAMPLE:

    contentItemId = 6a89f0355464b1518f0c65f3
    dwellNumber   = -1

    POST:

        /dairy/6a89f0355464b1518f0c65f3/-1


HISTORY DISPLAY:

    Last updated
    By who?
    From what?
    To what?


FIRST CARD:

    The first card is an UPDATE STOCK card.

    Clicking it opens the stock-update modal.

    The modal includes:

        content-item-update.ejs


EXPECTED VARIABLES:

    item
    dairy
    storage

==============================================================
*/


/* ============================================================
   SAFE DATA
============================================================ */

const contentUpdateItem =
    item || {};

const contentUpdateDairy =
    dairy || {};

const contentUpdateStorage =
    storage || {};


/* ============================================================
   CONTENT ITEM ID
============================================================ */

const contentItemId =
    contentUpdateItem._id
        ? String(
            contentUpdateItem._id
        )
        : "";


/* ============================================================
   DWELL NUMBER
============================================================ */

const dwellNumber =
    contentUpdateItem.dwellNumber !== null &&
    contentUpdateItem.dwellNumber !== undefined
        ? String(
            contentUpdateItem.dwellNumber
        )
        : "";


/* ============================================================
   ITEM NAME
============================================================ */

const contentUpdateItemName =
    contentUpdateItem.name ||
    "Unnamed Item";


/* ============================================================
   ITEM UNIT
============================================================ */

const contentUpdateUnit =
    contentUpdateItem.unit
        ? String(
            contentUpdateItem.unit
        ).trim()
        : "";


/* ============================================================
   STOCK UPDATE HISTORY
============================================================ */

const rawStockUpdates =
    Array.isArray(
        contentUpdateItem.stockUpdates
    )
        ? contentUpdateItem.stockUpdates
        : [];


/*
--------------------------------------------------------------
Create a safe chronological copy.

Oldest update first.

This allows every update to determine:

    FROM = previous quantity

    TO = current update quantity
--------------------------------------------------------------
*/

const stockHistory =
    rawStockUpdates
        .filter(function (update) {

            return (
                update &&
                update.quantity !== null &&
                update.quantity !== undefined
            );

        })
        .slice()
        .sort(function (a, b) {

            const dateA =
                a.recordedAt
                    ? new Date(
                        a.recordedAt
                    ).getTime()
                    : 0;


            const dateB =
                b.recordedAt
                    ? new Date(
                        b.recordedAt
                    ).getTime()
                    : 0;


            return dateA - dateB;

        });


/* ============================================================
   FORMAT QUANTITY
============================================================ */

function formatContentQuantity(
    value
) {

    if (
        value === null ||
        value === undefined ||
        value === ""
    ) {

        return "—";

    }


    const number =
        Number(value);


    if (
        !Number.isFinite(
            number
        )
    ) {

        return String(
            value
        );

    }


    return number.toLocaleString();

}


/* ============================================================
   FORMAT DATE
============================================================ */

function formatContentUpdateDate(
    value
) {

    if (!value) {

        return "Unknown date";

    }


    const date =
        new Date(
            value
        );


    if (
        Number.isNaN(
            date.getTime()
        )
    ) {

        return "Unknown date";

    }


    return date.toLocaleString(
        undefined,
        {
            year:
                "numeric",

            month:
                "short",

            day:
                "numeric",

            hour:
                "numeric",

            minute:
                "2-digit"
        }
    );

}


/* ============================================================
   GET USER NAME
============================================================ */

function getContentUpdateUserName(
    recordedBy
) {

    if (!recordedBy) {

        return "Unknown user";

    }


    if (
        typeof recordedBy === "object"
    ) {

        if (
            recordedBy.name
        ) {

            return String(
                recordedBy.name
            );

        }


        if (
            recordedBy.email
        ) {

            return String(
                recordedBy.email
            );

        }


        if (
            recordedBy._id
        ) {

            return String(
                recordedBy._id
            );

        }

    }


    return String(
        recordedBy
    );

}


/* ============================================================
   UPDATE ACTION
============================================================ */

const contentUpdateAction =
    contentItemId &&
    dwellNumber
        ? `/dairy/${contentItemId}/${dwellNumber}`
        : "";


/* ============================================================
   CURRENT QUANTITY
============================================================ */

const currentContentQuantity =
    contentUpdateItem.quantity !== null &&
    contentUpdateItem.quantity !== undefined
        ? Number(
            contentUpdateItem.quantity
        )
        : null;

%>


<style>

/* ============================================================
   CONTENT UPDATE HISTORY
============================================================ */

.content-update-history{

    width:100%;

    box-sizing:border-box;

    margin:0 0 18px;

}


/* ============================================================
   HEADER
============================================================ */

.content-update-history-header{

    display:flex;

    align-items:flex-start;

    justify-content:space-between;

    gap:14px;

    margin-bottom:13px;

}


.content-update-history-heading{

    min-width:0;

    flex:1;

}


.content-update-history-title{

    margin:0;

    color:#202a23;

    font-size:18px;

    line-height:1.3;

    font-weight:800;

    letter-spacing:-.02em;

}


.content-update-history-description{

    margin:4px 0 0;

    color:#7a847d;

    font-size:11px;

    line-height:1.5;

}


/* ============================================================
   UPDATE ACTION LABEL
============================================================ */

.content-update-history-action-label{

    flex:none;

    padding:7px 10px;

    border-radius:999px;

    background:#edf7ef;

    color:#317448;

    font-size:9px;

    line-height:1;

    font-weight:800;

    letter-spacing:.05em;

    text-transform:uppercase;

}


/* ============================================================
   HISTORY LIST
============================================================ */

.content-update-history-list{

    width:100%;

    display:flex;

    flex-direction:column;

    gap:9px;

}


/* ============================================================
   BASE CARD
============================================================ */

.content-update-card{

    position:relative;

    width:100%;

    box-sizing:border-box;

    border:1px solid #e1e8e3;

    border-radius:14px;

    background:#ffffff;

    box-shadow:
        0 2px 8px
        rgba(25,45,32,.045);

}


/* ============================================================
   UPDATE BUTTON CARD
============================================================ */

.content-update-open{

    width:100%;

    display:block;

    padding:15px;

    border:0;

    border-radius:14px;

    background:
        linear-gradient(
            135deg,
            #f0f8f2 0%,
            #ffffff 100%
        );

    color:inherit;

    text-align:left;

    cursor:pointer;

    font:inherit;

}


.content-update-open:hover{

    background:
        linear-gradient(
            135deg,
            #eaf6ed 0%,
            #ffffff 100%
        );

}


.content-update-open:active{

    transform:scale(.99);

}


.content-update-open:focus-visible{

    outline:
        2px solid
        #2f7c48;

    outline-offset:
        2px;

}


/* ============================================================
   UPDATE CARD INNER
============================================================ */

.content-update-open-inner{

    display:flex;

    align-items:center;

    gap:13px;

}


/* ============================================================
   UPDATE ICON
============================================================ */

.content-update-open-icon{

    width:44px;

    height:44px;

    flex:none;

    display:flex;

    align-items:center;

    justify-content:center;

    border-radius:12px;

    background:#dff0e3;

    color:#2f7c48;

    font-size:22px;

    font-weight:800;

}


/* ============================================================
   UPDATE TEXT
============================================================ */

.content-update-open-content{

    min-width:0;

    flex:1;

}


.content-update-open-title{

    margin:0;

    color:#294333;

    font-size:13px;

    line-height:1.35;

    font-weight:800;

}


.content-update-open-description{

    margin:4px 0 0;

    color:#78857d;

    font-size:10px;

    line-height:1.45;

}


/* ============================================================
   ARROW
============================================================ */

.content-update-open-arrow{

    flex:none;

    color:#438455;

    font-size:20px;

    font-weight:700;

}


/* ============================================================
   HISTORY CARD
============================================================ */

.content-update-history-card{

    padding:14px;

}


/* ============================================================
   HISTORY TOP
============================================================ */

.content-update-history-top{

    display:flex;

    align-items:center;

    justify-content:space-between;

    gap:10px;

    margin-bottom:12px;

}


.content-update-history-date{

    color:#7a867e;

    font-size:9px;

    line-height:1.3;

    font-weight:700;

}


.content-update-history-number{

    flex:none;

    padding:5px 8px;

    border-radius:999px;

    background:#f1f5f2;

    color:#65736a;

    font-size:8px;

    line-height:1;

    font-weight:800;

    text-transform:uppercase;

}


/* ============================================================
   FROM / TO
============================================================ */

.content-update-history-change{

    display:grid;

    grid-template-columns:
        minmax(0,1fr)
        28px
        minmax(0,1fr);

    align-items:center;

    gap:7px;

}


/* ============================================================
   CHANGE BOX
============================================================ */

.content-update-change-box{

    min-width:0;

    padding:11px;

    border-radius:11px;

    background:#f8faf9;

    border:1px solid #e6ece8;

}


.content-update-change-label{

    display:block;

    margin-bottom:5px;

    color:#8a958e;

    font-size:8px;

    line-height:1;

    font-weight:800;

    letter-spacing:.07em;

    text-transform:uppercase;

}


.content-update-change-value{

    display:block;

    color:#304438;

    font-size:15px;

    line-height:1.25;

    font-weight:850;

    word-break:break-word;

}


.content-update-change-unit{

    margin-left:2px;

    color:#7c8981;

    font-size:9px;

    font-weight:700;

}


/* ============================================================
   ARROW
============================================================ */

.content-update-change-arrow{

    display:flex;

    align-items:center;

    justify-content:center;

    color:#72917b;

    font-size:18px;

    font-weight:800;

}


/* ============================================================
   USER
============================================================ */

.content-update-history-user{

    display:flex;

    align-items:center;

    gap:6px;

    margin-top:10px;

    color:#66736b;

    font-size:10px;

    line-height:1.4;

}


.content-update-history-user-icon{

    font-size:11px;

}


/* ============================================================
   NOTE
============================================================ */

.content-update-history-note{

    margin-top:10px;

    padding-top:9px;

    border-top:1px solid #edf1ee;

    color:#69766e;

    font-size:10px;

    line-height:1.55;

    white-space:pre-wrap;

    word-break:break-word;

}


/* ============================================================
   EMPTY HISTORY
============================================================ */

.content-update-empty{

    padding:18px;

    border:1px dashed #dce5df;

    border-radius:14px;

    background:#fafcfb;

    color:#7d8981;

    font-size:11px;

    line-height:1.5;

    text-align:center;

}


/* ============================================================
   MODAL BACKDROP
============================================================ */

.content-update-modal{

    position:fixed;

    inset:0;

    z-index:9999;

    display:none;

    align-items:center;

    justify-content:center;

    padding:18px;

    box-sizing:border-box;

    background:
        rgba(20,32,25,.58);

    backdrop-filter:
        blur(4px);

}


.content-update-modal.is-open{

    display:flex;

}


/* ============================================================
   MODAL
============================================================ */

.content-update-modal-dialog{

    position:relative;

    width:100%;

    max-width:620px;

    max-height:
        calc(
            100vh - 36px
        );

    overflow-y:auto;

    box-sizing:border-box;

    border-radius:18px;

    background:#ffffff;

    box-shadow:
        0 20px 60px
        rgba(0,0,0,.20);

}


/* ============================================================
   MODAL HEADER
============================================================ */

.content-update-modal-header{

    position:sticky;

    top:0;

    z-index:2;

    display:flex;

    align-items:center;

    justify-content:space-between;

    gap:12px;

    padding:16px 18px;

    background:#ffffff;

    border-bottom:1px solid #e5ebe7;

}


.content-update-modal-title{

    min-width:0;

    margin:0;

    color:#26382d;

    font-size:16px;

    line-height:1.3;

    font-weight:850;

}


.content-update-modal-close{

    width:34px;

    height:34px;

    flex:none;

    display:flex;

    align-items:center;

    justify-content:center;

    border:0;

    border-radius:50%;

    background:#f1f4f2;

    color:#59675e;

    cursor:pointer;

    font-size:20px;

    line-height:1;

}


.content-update-modal-close:hover{

    background:#e8ede9;

}


.content-update-modal-close:focus-visible{

    outline:
        2px solid
        #2f7c48;

    outline-offset:
        2px;

}


/* ============================================================
   MODAL BODY
============================================================ */

.content-update-modal-body{

    padding:18px;

}


/* ============================================================
   MODAL FORM OVERRIDE
============================================================ */

.content-update-modal-body
.stock-update-section{

    margin-top:0;

}


/* ============================================================
   MODAL MOBILE
============================================================ */

@media (max-width:600px){

    .content-update-history-header{

        align-items:flex-start;

    }


    .content-update-history-action-label{

        display:none;

    }


    .content-update-modal{

        align-items:flex-end;

        padding:0;

    }


    .content-update-modal-dialog{

        max-width:none;

        max-height:
            92vh;

        border-radius:
            18px 18px 0 0;

    }

}


@media (max-width:470px){

    .content-update-history-title{

        font-size:17px;

    }


    .content-update-history-card{

        padding:12px;

    }


    .content-update-history-change{

        grid-template-columns:
            minmax(0,1fr)
            22px
            minmax(0,1fr);

        gap:4px;

    }


    .content-update-change-box{

        padding:9px;

    }


    .content-update-change-value{

        font-size:14px;

    }


    .content-update-modal-body{

        padding:15px;

    }

}

</style>


<!-- ============================================================
     CONTENT UPDATE HISTORY
============================================================= -->

<section
    class="content-update-history"
    aria-label="Stock update history"
>


    <!-- ========================================================
         HEADER
    ========================================================= -->

    <header class="content-update-history-header">


        <div class="content-update-history-heading">


            <h2 class="content-update-history-title">

                <%= contentUpdateItemName %> Updates

            </h2>


            <p class="content-update-history-description">

                View previous stock changes or give a new
                update for this item.

            </p>


        </div>


        <span
            class="content-update-history-action-label"
        >

            Stock History

        </span>


    </header>


    <!-- ========================================================
         HISTORY LIST
    ========================================================= -->

    <div class="content-update-history-list">


        <!-- ====================================================
             FIRST CARD — UPDATE STOCK
        ===================================================== -->

        <% if (contentUpdateAction) { %>


            <div class="content-update-card">


                <button
                    type="button"
                    class="content-update-open"
                    id="openContentUpdateModal"
                    aria-haspopup="dialog"
                    aria-controls="contentUpdateModal"
                >


                    <span
                        class="content-update-open-inner"
                    >


                        <span
                            class="content-update-open-icon"
                            aria-hidden="true"
                        >

                            +

                        </span>


                        <span
                            class="content-update-open-content"
                        >


                            <strong
                                class="content-update-open-title"
                            >

                                Update Stock

                            </strong>


                            <span
                                class="content-update-open-description"
                            >

                                Record a new quantity,
                                unit, note or images.

                            </span>


                        </span>


                        <span
                            class="content-update-open-arrow"
                            aria-hidden="true"
                        >

                            ›

                        </span>


                    </span>


                </button>


            </div>


        <% } %>



        <!-- ====================================================
             HISTORY CARDS
        ===================================================== -->

        <% if (stockHistory.length) { %>


            <%
                /*
                --------------------------------------------------
                Reverse for display.

                Latest update appears first.

                --------------------------------------------------
                */
                const displayHistory =
                    stockHistory
                        .slice()
                        .reverse();
            %>


            <% displayHistory.forEach(
                function (
                    update,
                    displayIndex
                ) {

                    /*
                    ------------------------------------------------
                    Find this update's original chronological index.

                    ------------------------------------------------
                    */

                    const originalIndex =
                        stockHistory.indexOf(
                            update
                        );


                    /*
                    ------------------------------------------------
                    Previous update.

                    If this is the first recorded update,
                    there is no previous stock-update quantity.
                    ------------------------------------------------
                    */

                    const previousUpdate =
                        originalIndex > 0
                            ? stockHistory[
                                originalIndex - 1
                            ]
                            : null;


                    /*
                    ------------------------------------------------
                    FROM quantity
                    ------------------------------------------------
                    */

                    let fromQuantity = null;


                    if (
                        previousUpdate &&
                        previousUpdate.quantity !== null &&
                        previousUpdate.quantity !== undefined
                    ) {

                        fromQuantity =
                            Number(
                                previousUpdate.quantity
                            );

                    } else if (
                        originalIndex === 0
                    ) {

                        /*
                        --------------------------------------------
                        First recorded update.

                        If the item has an acquisition/current
                        quantity and no previous stock history,
                        do not falsely claim that the stock was
                        previously zero.

                        Display "Initial" instead.
                        --------------------------------------------
                        */

                        fromQuantity =
                            null;

                    }


                    /*
                    ------------------------------------------------
                    TO quantity
                    ------------------------------------------------
                    */

                    const toQuantity =
                        Number(
                            update.quantity
                        );


                    /*
                    ------------------------------------------------
                    USER
                    ------------------------------------------------
                    */

                    const historyUser =
                        getContentUpdateUserName(
                            update.recordedBy
                        );


                    /*
                    ------------------------------------------------
                    DATE
                    ------------------------------------------------
                    */

                    const historyDate =
                        formatContentUpdateDate(
                            update.recordedAt
                        );


                    /*
                    ------------------------------------------------
                    NOTE
                    ------------------------------------------------
                    */

                    const historyNote =
                        update.stockUpdateNote
                            ? String(
                                update.stockUpdateNote
                            ).trim()
                            : "";

            %>


                <article
                    class="content-update-card content-update-history-card"
                >


                    <!-- ==========================================
                         HISTORY TOP
                    =========================================== -->

                    <div
                        class="content-update-history-top"
                    >


                        <span
                            class="content-update-history-date"
                        >

                            <%= historyDate %>

                        </span>


                        <span
                            class="content-update-history-number"
                        >

                            Update
                            <%= displayHistory.length - displayIndex %>

                        </span>


                    </div>



                    <!-- ==========================================
                         FROM → TO
                    =========================================== -->

                    <div
                        class="content-update-history-change"
                    >


                        <!-- ======================================
                             FROM
                        ======================================= -->

                        <div
                            class="content-update-change-box"
                        >


                            <span
                                class="content-update-change-label"
                            >

                                From

                            </span>


                            <span
                                class="content-update-change-value"
                            >


                                <% if (fromQuantity !== null) { %>

                                    <%= formatContentQuantity(
                                        fromQuantity
                                    ) %>


                                    <% if (contentUpdateUnit) { %>

                                        <span
                                            class="content-update-change-unit"
                                        >

                                            <%= contentUpdateUnit %>

                                        </span>

                                    <% } %>


                                <% } else { %>

                                    Initial

                                <% } %>


                            </span>


                        </div>



                        <!-- ======================================
                             ARROW
                        ======================================= -->

                        <span
                            class="content-update-change-arrow"
                            aria-hidden="true"
                        >

                            →

                        </span>



                        <!-- ======================================
                             TO
                        ======================================= -->

                        <div
                            class="content-update-change-box"
                        >


                            <span
                                class="content-update-change-label"
                            >

                                To

                            </span>


                            <span
                                class="content-update-change-value"
                            >


                                <%= formatContentQuantity(
                                    toQuantity
                                ) %>


                                <% if (contentUpdateUnit) { %>

                                    <span
                                        class="content-update-change-unit"
                                    >

                                        <%= contentUpdateUnit %>

                                    </span>

                                <% } %>


                            </span>


                        </div>


                    </div>



                    <!-- ==========================================
                         USER
                    =========================================== -->

                    <div
                        class="content-update-history-user"
                    >


                        <span
                            class="content-update-history-user-icon"
                            aria-hidden="true"
                        >

                            👤

                        </span>


                        <span>

                            <strong>
                                By:
                            </strong>

                            <%= historyUser %>

                        </span>


                    </div>



                    <!-- ==========================================
                         NOTE
                    =========================================== -->

                    <% if (historyNote) { %>


                        <div
                            class="content-update-history-note"
                        >

                            <%= historyNote %>

                        </div>


                    <% } %>


                </article>


            <% }); %>


        <% } else { %>


            <!-- =================================================
                 EMPTY HISTORY
            ================================================== -->

            <div
                class="content-update-empty"
            >

                No stock updates have been recorded yet.
                Use the update card above to record the first
                stock update.

            </div>


        <% } %>


    </div>


</section>



<!-- ============================================================
     UPDATE MODAL
============================================================= -->

<% if (contentUpdateAction) { %>


<div
    class="content-update-modal"
    id="contentUpdateModal"
    role="dialog"
    aria-modal="true"
    aria-labelledby="contentUpdateModalTitle"
    aria-hidden="true"
>


    <div
        class="content-update-modal-dialog"
        role="document"
    >


        <!-- ====================================================
             MODAL HEADER
        ===================================================== -->

        <header
            class="content-update-modal-header"
        >


            <h2
                class="content-update-modal-title"
                id="contentUpdateModalTitle"
            >

                Update
                <%= contentUpdateItemName %>

            </h2>


            <button
                type="button"
                class="content-update-modal-close"
                id="closeContentUpdateModal"
                aria-label="Close update form"
            >

                ×

            </button>


        </header>



        <!-- ====================================================
             MODAL BODY

             The existing update form is reused.

             Its action is:

                 /dairy/:contentItemId/:dwellNumber
        ===================================================== -->

        <div
            class="content-update-modal-body"
        >


            <%- include(
                "content-item-update",
                {
                    dairy:
                        contentUpdateDairy,

                    storage:
                        contentUpdateStorage,

                    item:
                        contentUpdateItem
                }
            ) %>


        </div>


    </div>


</div>


<script>

(function () {

    /* ========================================================
       ELEMENTS
    ======================================================== */

    const openButton =
        document.getElementById(
            "openContentUpdateModal"
        );


    const closeButton =
        document.getElementById(
            "closeContentUpdateModal"
        );


    const modal =
        document.getElementById(
            "contentUpdateModal"
        );


    if (
        !openButton ||
        !closeButton ||
        !modal
    ) {

        return;

    }


    /* ========================================================
       OPEN MODAL
    ======================================================== */

    function openModal() {

        modal.classList.add(
            "is-open"
        );

        modal.setAttribute(
            "aria-hidden",
            "false"
        );


        document.body.style.overflow =
            "hidden";

    }


    /* ========================================================
       CLOSE MODAL
    ======================================================== */

    function closeModal() {

        modal.classList.remove(
            "is-open"
        );

        modal.setAttribute(
            "aria-hidden",
            "true"
        );


        document.body.style.overflow =
            "";

    }


    /* ========================================================
       OPEN
    ======================================================== */

    openButton.addEventListener(
        "click",
        openModal
    );


    /* ========================================================
       CLOSE
    ======================================================== */

    closeButton.addEventListener(
        "click",
        closeModal
    );


    /* ========================================================
       CLICK OUTSIDE
    ======================================================== */

    modal.addEventListener(
        "click",
        function (event) {

            if (
                event.target === modal
            ) {

                closeModal();

            }

        }
    );


    /* ========================================================
       ESCAPE
    ======================================================== */

    document.addEventListener(
        "keydown",
        function (event) {

            if (
                event.key === "Escape" &&
                modal.classList.contains(
                    "is-open"
                )
            ) {

                closeModal();

            }

        }
    );


})();

</script>


<% } %>