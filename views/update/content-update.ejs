<%
/*
==============================================================
CONTENT UPDATE HISTORY
==============================================================

FILE:
    views/update/content-update.ejs

PURPOSE:
    Displays stock-update history for ONE storage content item.

DESIGN:
    • Horizontal scroll from left to right.
    • Story-style cards inspired by social-media status cards.
    • First card = "Update Stock".
    • Clicking the first card opens the update modal.
    • Remaining cards = stock-update history.
    • Latest update appears first.
    • Greenish visual theme.

HISTORY CARD SHOWS:
    • Last updated
    • By who?
    • From what?
    • To what?

USER IDENTITY:
    Uses:

        user._name

    It does NOT use user._id as the displayed identity.

EXPECTED VARIABLES:
    item
    dairy
    storage
    user

==============================================================
*/


/* ============================================================
   SAFE DATA
============================================================ */

const contentUpdateItem =
    (typeof item !== "undefined" && item)
        ? item
        : {};

const contentUpdateDairy =
    (typeof dairy !== "undefined" && dairy)
        ? dairy
        : {};

const contentUpdateStorage =
    (typeof storage !== "undefined" && storage)
        ? storage
        : {};

const contentUpdateUser =
    (typeof user !== "undefined" && user)
        ? user
        : null;


/* ============================================================
   CONTENT ITEM ID
============================================================ */

const contentItemId =
    contentUpdateItem._id
        ? String(
            contentUpdateItem._id
        )
        : "";


/* ============================================================
   DWELL NUMBER
============================================================ */

const dwellNumber =
    contentUpdateItem.dwellNumber !== null &&
    contentUpdateItem.dwellNumber !== undefined &&
    String(
        contentUpdateItem.dwellNumber
    ).trim() !== ""
        ? String(
            contentUpdateItem.dwellNumber
        )
        : "";


/* ============================================================
   ITEM NAME
============================================================ */

const contentUpdateItemName =
    contentUpdateItem.name ||
    "Unnamed Item";


/* ============================================================
   UNIT
============================================================ */

const contentUpdateUnit =
    contentUpdateItem.unit
        ? String(
            contentUpdateItem.unit
        ).trim()
        : "";


/* ============================================================
   STOCK HISTORY
============================================================ */

const rawStockUpdates =
    Array.isArray(
        contentUpdateItem.stockUpdates
    )
        ? contentUpdateItem.stockUpdates
        : [];


/*
--------------------------------------------------------------
Chronological copy.

Oldest first.

This allows us to determine:

    FROM
        previous update quantity

    TO
        current update quantity
--------------------------------------------------------------
*/

const stockHistory =
    rawStockUpdates
        .filter(function (update) {

            return (
                update &&
                update.quantity !== null &&
                update.quantity !== undefined
            );

        })
        .slice()
        .sort(function (a, b) {

            const dateA =
                a.recordedAt
                    ? new Date(
                        a.recordedAt
                    ).getTime()
                    : 0;

            const dateB =
                b.recordedAt
                    ? new Date(
                        b.recordedAt
                    ).getTime()
                    : 0;

            return dateA - dateB;

        });


/* ============================================================
   DISPLAY HISTORY
============================================================ */

const displayHistory =
    stockHistory
        .slice()
        .reverse();


/* ============================================================
   FORMAT QUANTITY
============================================================ */

function formatContentQuantity(
    value
) {

    if (
        value === null ||
        value === undefined ||
        value === ""
    ) {

        return "—";

    }


    const number =
        Number(value);


    if (
        !Number.isFinite(
            number
        )
    ) {

        return String(
            value
        );

    }


    return number.toLocaleString();

}


/* ============================================================
   FORMAT DATE
============================================================ */

function formatContentUpdateDate(
    value
) {

    if (!value) {

        return "Unknown date";

    }


    const date =
        new Date(
            value
        );


    if (
        Number.isNaN(
            date.getTime()
        )
    ) {

        return "Unknown date";

    }


    return date.toLocaleString(
        undefined,
        {
            year:
                "numeric",

            month:
                "short",

            day:
                "numeric",

            hour:
                "numeric",

            minute:
                "2-digit"
        }
    );

}


/* ============================================================
   USER NAME
============================================================ */

function getContentUpdateUserName(
    recordedBy
) {

    /*
    ----------------------------------------------------------
    IMPORTANT:

    Display identity using:

        user._name

    when the supplied user object is available.

    Do NOT use _id as the displayed identity.
    ----------------------------------------------------------
    */

    if (
        contentUpdateUser &&
        contentUpdateUser._name
    ) {

        return String(
            contentUpdateUser._name
        );

    }


    /*
    ----------------------------------------------------------
    For historical records, use the populated user's name.

    Still never display _id as identity.
    ----------------------------------------------------------
    */

    if (
        recordedBy &&
        typeof recordedBy === "object"
    ) {

        if (
            recordedBy._name
        ) {

            return String(
                recordedBy._name
            );

        }


        if (
            recordedBy.name
        ) {

            return String(
                recordedBy.name
            );

        }


        if (
            recordedBy.email
        ) {

            return String(
                recordedBy.email
            );

        }

    }


    if (
        recordedBy &&
        typeof recordedBy === "string"
    ) {

        return String(
            recordedBy
        );

    }


    return "Unknown user";

}


/* ============================================================
   UPDATE ACTION
============================================================ */

const contentUpdateAction =
    contentItemId &&
    dwellNumber
        ? `/dairy/${contentItemId}/${dwellNumber}`
        : "";


/* ============================================================
   CURRENT QUANTITY
============================================================ */

const currentContentQuantity =
    contentUpdateItem.quantity !== null &&
    contentUpdateItem.quantity !== undefined
        ? Number(
            contentUpdateItem.quantity
        )
        : null;

