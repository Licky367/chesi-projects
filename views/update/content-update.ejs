        9px;

    scroll-snap-type:
        x mandatory;

    -webkit-overflow-scrolling:
        touch;

    scrollbar-width:
        none;

}


.update-history-scroll::-webkit-scrollbar {

    display: none;

}


/* ==========================================================
   HISTORY CARD
========================================================== */

.history-card {

    position: relative;

    flex:
        0 0
        172px;

    width: 172px;

    min-height: 158px;

    display: flex;

    flex-direction: column;

    align-items: flex-start;

    padding:
        15px;

    box-sizing: border-box;

    scroll-snap-align:
        start;

    overflow: hidden;

    border:
        1px solid
        #e2e9e3;

    border-radius:
        17px;

    background:
        #ffffff;

    color:
        #26352b;

    text-align:
        left;

    cursor:
        pointer;

    box-shadow:
        0 3px 12px
        rgba(27, 55, 35, .055);

    transition:
        transform .16s ease,
        box-shadow .16s ease,
        border-color .16s ease;

}


.history-card:hover {

    transform:
        translateY(-2px);

    border-color:
        #bdd5c2;

    box-shadow:
        0 7px 18px
        rgba(27, 55, 35, .09);

}


.history-card:active {

    transform:
        scale(.97);

}


.history-card:focus-visible {

    outline:
        2px solid
        #39834b;

    outline-offset:
        2px;

}


/* ==========================================================
   UPDATE CARD
========================================================== */

.history-update-card {

    justify-content:
        center;

    border:
        1px dashed
        #9dbda4;

    background:
        linear-gradient(
            145deg,
            #f4faf5,
            #ffffff
        );

}


.history-update-icon {

    width: 36px;
    height: 36px;

    display: flex;

    align-items: center;
    justify-content: center;

    margin-bottom: 10px;

    border-radius:
        11px;

    background:
        #dfefdf;

    color:
        #28733a;

    font-size:
        23px;

    font-weight:
        300;

}


.history-update-title {

    color:
        #25472d;

    font-size:
        13px;

    font-weight:
        800;

}


.history-update-text {

    margin-top:
        5px;

    color:
        #758279;

    font-size:
        9px;

    line-height:
        1.45;

}


.history-update-action {

    margin-top:
        auto;

    padding-top:
        9px;

    color:
        #388148;

    font-size:
        8px;

    font-weight:
        800;

}


/* ==========================================================
   HISTORY DETAILS
========================================================== */

.history-number {

    position: absolute;

    top: 10px;
    right: 10px;

    min-width: 19px;
    height: 19px;

    display: flex;

    align-items: center;
    justify-content: center;

    border-radius:
        50%;

