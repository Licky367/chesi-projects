<%
/* ==========================================================
   STORAGE CONTENT ITEM
   FILE:
       views/update/content-item.ejs

   PURPOSE:
       Display one storage content item and its update history.

   IMPORTANT:
   ----------------------------------------------------------
       This is an INCLUDE.

       It is NOT a standalone page.

   UPDATE ROUTE:
       POST /dairy/:contentItemId/:dwellNumber

   UPDATE HISTORY:
       item.stockUpdates[]

   EACH UPDATE:
       quantity
       stockUpdateNote
       images
       recordedBy
       recordedAt

   CURRENT STOCK:
       item.quantity
========================================================== */


/* ==========================================================
   SAFE DATA
========================================================== */

const contentItem =
    item || {};

const currentStorage =
    storage || {};

const currentDairy =
    dairy || {};


/* ==========================================================
   CONTENT ITEM ID
========================================================== */

const contentItemId =
    contentItem._id
        ? String(contentItem._id)
        : "";


/* ==========================================================
   DWELL NUMBER
========================================================== */

const dwellNumber =
    contentItem.dwellNumber !== null &&
    contentItem.dwellNumber !== undefined
        ? String(contentItem.dwellNumber)
        : "";


/* ==========================================================
   UPDATE ROUTE
========================================================== */

const stockUpdateAction =
    contentItemId && dwellNumber
        ? `/dairy/${encodeURIComponent(contentItemId)}/${encodeURIComponent(dwellNumber)}`
        : "";


/* ==========================================================
   ITEM CLASSIFICATION
========================================================== */

const itemType =
    String(
        contentItem.type || ""
    ).trim();

const itemCode =
    Number(
        contentItem.code
    );

const itemIsAnimal =
    contentItem.code !== null &&
    contentItem.code !== undefined &&
    !Number.isNaN(itemCode) &&
    itemCode > 0;

const itemIsFeed =
    itemType === "feeds";

const itemIsAgroStore =
    itemType === "agroStore";


let itemCategory =
    "Asset";

let itemIcon =
    "📦";

let itemCategoryClass =
    "asset-badge";


if (itemIsFeed) {

    itemCategory =
        "Feed";

    itemIcon =
        "🌾";

    itemCategoryClass =
        "feed-badge";

} else if (itemIsAnimal) {

    itemCategory =
        "Animal";

    itemIcon =
        "🐄";

    itemCategoryClass =
        "animal-badge";

} else if (itemIsAgroStore) {

    itemCategory =
        "AgroStore";

    itemIcon =
        "🏪";

    itemCategoryClass =
        "feed-badge";

}


/* ==========================================================
   ITEM DETAILS
========================================================== */

const itemName =
    contentItem.name ||
    "Unnamed Item";

const itemUnit =
    contentItem.unit
        ? String(
            contentItem.unit
        ).trim()
        : "";

const hasQuantity =
    contentItem.quantity !== null &&
    contentItem.quantity !== undefined;

const quantityValue =
    hasQuantity
        ? Number(
            contentItem.quantity || 0
        )
        : null;

const hasCurrentWorth =
    contentItem.currentWorth !== null &&
    contentItem.currentWorth !== undefined;

const currentWorthValue =
    hasCurrentWorth
        ? Number(
            contentItem.currentWorth || 0
        )
        : null;


/* ==========================================================
   UPDATE HISTORY
========================================================== */

const updateHistory =
    Array.isArray(
        contentItem.stockUpdates
    )
        ? contentItem.stockUpdates
        : [];


/* ==========================================================
   SAFE OPTIONAL MESSAGES
========================================================== */

const safeSuccessMessage =
    typeof successMessage !== "undefined"
        ? successMessage
        : null;

const safePageError =
    typeof pageError !== "undefined"
        ? pageError
        : null;

%>


<!-- ========================================================
     SUCCESS MESSAGE
========================================================= -->

<% if (safeSuccessMessage) { %>

    <div
        class="content-item-message content-item-success"
        role="status"
    >

        <span class="message-icon">
            ✓
        </span>

        <span>
            <%= safeSuccessMessage %>
        </span>

    </div>

<% } %>


<!-- ========================================================
     ERROR MESSAGE
========================================================= -->

<% if (safePageError) { %>

    <div
        class="content-item-message content-item-error"
        role="alert"
    >

        <span class="message-icon">
            !
        </span>

        <span>
            <%= safePageError %>
        </span>

    </div>

<% } %>


<!-- ========================================================
     MAIN ITEM CARD
========================================================= -->

<article class="content-item-card">


    <!-- ====================================================
         ITEM HEADER
    ===================================================== -->

    <header class="content-item-header">

        <div class="content-item-icon">
            <%= itemIcon %>
        </div>


        <div class="content-item-heading">

            <span class="content-item-eyebrow">
                STORAGE CONTENT
            </span>

            <h1 class="content-item-title">
                <%= itemName %>
            </h1>


            <div class="content-item-badges">

                <span
                    class="content-item-badge <%= itemCategoryClass %>"
                >
                    <%= itemCategory %>
                </span>


                <% if (contentItem.status) { %>

                    <span class="content-item-badge status-badge">
                        <%= contentItem.status %>
                    </span>

                <% } %>

            </div>

        </div>

    </header>



    <!-- ====================================================
         CURRENT STOCK
    ===================================================== -->

    <section class="content-item-section">

        <div class="section-heading">

            <div>

                <span class="section-kicker">
                    CURRENT POSITION
                </span>

                <h2>
                    Stock Overview
                </h2>

            </div>

            <span class="section-line"></span>

        </div>


        <div class="stock-overview">

            <div class="stock-stat">

                <span class="stock-stat-label">
                    Quantity
                </span>

                <strong class="stock-stat-value">

                    <% if (hasQuantity) { %>

                        <%= quantityValue.toLocaleString() %>

                        <% if (itemUnit) { %>

                            <small>
                                <%= itemUnit %>
                            </small>

                        <% } %>

                    <% } else { %>

                        —

                    <% } %>

                </strong>

            </div>


            <div class="stock-stat">

                <span class="stock-stat-label">
                    Unit
                </span>

                <strong class="stock-stat-value">
                    <%= itemUnit || "—" %>
                </strong>

            </div>


            <div class="stock-stat">

                <span class="stock-stat-label">
                    Current Worth
                </span>

                <strong class="stock-stat-value">

                    <% if (hasCurrentWorth) { %>

                        <%= currentWorthValue.toLocaleString() %>

                    <% } else { %>

                        —

                    <% } %>

                </strong>

            </div>

        </div>

    </section>



    <!-- ====================================================
         DESCRIPTION
    ===================================================== -->

    <% if (
        contentItem.description &&
        String(
            contentItem.description
        ).trim()
    ) { %>

        <section class="content-item-section">

            <div class="section-heading">

                <div>

                    <span class="section-kicker">
                        INFORMATION
                    </span>

                    <h2>
                        Description
                    </h2>

                </div>

                <span class="section-line"></span>

            </div>


            <div class="description-box">

                <%= contentItem.description %>

            </div>

        </section>

    <% } %>



    <!-- ====================================================
         UPDATE HISTORY
    ===================================================== -->

    <section class="content-item-section history-section">

        <div class="section-heading">

            <div>

                <span class="section-kicker">
                    ACTIVITY
                </span>

                <h2>
                    Update History
                </h2>

            </div>

            <span class="history-count">
                <%= updateHistory.length %>
                <%= updateHistory.length === 1
                    ? "update"
                    : "updates"
                %>
            </span>

        </div>


        <!-- ==================================================
             SWIPEABLE HISTORY
        =================================================== -->

        <div
            class="update-history-scroll"
            aria-label="Stock update history"
        >


            <!-- ==============================================
                 FIRST CARD — UPDATE
            =============================================== -->

            <button
                type="button"
                class="history-card history-update-card"
                data-open-composer
                aria-label="Create a stock update"
            >

                <span class="history-update-icon">
                    +
                </span>

                <span class="history-update-title">
                    Update Stock
                </span>

                <span class="history-update-text">
                    Record a new quantity,
                    note or image.
                </span>

                <span class="history-update-action">
                    Open composer →
                </span>

            </button>



            <!-- ==============================================
                 EXISTING HISTORY
            =============================================== -->

            <% updateHistory.forEach(function (update, index) { %>

                <%

                    const historyUpdate =
                        update || {};


                    /* ------------------------------------------
                       QUANTITY
                    ------------------------------------------ */

                    const historyQuantity =
                        historyUpdate.quantity !== null &&
                        historyUpdate.quantity !== undefined
                            ? Number(
                                historyUpdate.quantity
                            )
                            : null;


                    /* ------------------------------------------
                       NOTE
                    ------------------------------------------ */

                    const historyNote =
                        historyUpdate.stockUpdateNote
                            ? String(
                                historyUpdate.stockUpdateNote
                            ).trim()
                            : "";


                    /* ------------------------------------------
                       IMAGES
                    ------------------------------------------ */

                    const historyImages =
                        Array.isArray(
                            historyUpdate.images
                        )
                            ? historyUpdate.images
                            : [];


                    /* ------------------------------------------
                       RECORDED BY
                    ------------------------------------------ */

                    const recordedBy =
                        historyUpdate.recordedBy;


                    let recordedByName =
                        "Unknown user";


                    if (recordedBy) {

                        if (
                            typeof recordedBy === "object" &&
                            recordedBy.name
                        ) {

                            recordedByName =
                                String(
                                    recordedBy.name
                                );

                        } else if (
                            typeof recordedBy === "object" &&
                            recordedBy.email
                        ) {

                            recordedByName =
                                String(
                                    recordedBy.email
                                );

                        } else {

                            recordedByName =
                                String(
                                    recordedBy
                                );

                        }

                    }


                    /* ------------------------------------------
                       DATE
                    ------------------------------------------ */

                    let historyDate =
                        "Unknown date";


                    if (historyUpdate.recordedAt) {

                        const date =
                            new Date(
                                historyUpdate.recordedAt
                            );


                        if (
                            !Number.isNaN(
                                date.getTime()
                            )
                        ) {

                            historyDate =
                                date.toLocaleString(
                                    undefined,
                                    {
                                        month: "short",
                                        day: "numeric",
                                        year: "numeric",
                                        hour: "numeric",
                                        minute: "2-digit"
                                    }
                                );

                        }

                    }


                    /* ------------------------------------------
                       PREVIEW
                    ------------------------------------------ */

                    const historyPreview =
                        historyNote ||
                        (
                            historyQuantity !== null
                                ? `Quantity updated to ${historyQuantity.toLocaleString()}${itemUnit ? " " + itemUnit : ""}.`
                                : "Stock information updated."
                        );


                    /* ------------------------------------------
                       SERIALIZED DATA FOR MODAL
                    ------------------------------------------ */

                    const historyData = {

                        quantity:
                            historyQuantity,

                        unit:
                            itemUnit,

                        note:
                            historyNote,

                        user:
                            recordedByName,

                        date:
                            historyDate,

                        images:
                            historyImages.map(
                                function(image) {

                                    if (
                                        typeof image === "string"
                                    ) {

                                        return image;

                                    }

                                    return image &&
                                        (
                                            image.url ||
                                            image.path ||
                                            image.location
                                        );

                                }
                            ).filter(Boolean)

                    };

                %>


                <button
                    type="button"
                    class="history-card"
                    role="button"
                    data-history="<%= encodeURIComponent(JSON.stringify(historyData)) %>"
                    aria-label="View stock update <%= index + 1 %>"
                >


                    <!-- ----------------------------------------
                         HISTORY NUMBER
                    ----------------------------------------- -->

                    <span class="history-number">
                        <%= updateHistory.length - index %>
                    </span>


                    <!-- ----------------------------------------
                         HISTORY ICON
                    ----------------------------------------- -->

                    <span class="history-card-icon">
                        ↻
                    </span>


                    <!-- ----------------------------------------
                         DATE
                    ----------------------------------------- -->

                    <span class="history-date">
                        <%= historyDate %>
                    </span>


                    <!-- ----------------------------------------
                         QUANTITY
                    ----------------------------------------- -->

                    <% if (historyQuantity !== null) { %>

                        <strong class="history-quantity">

                            <%= historyQuantity.toLocaleString() %>

                            <% if (itemUnit) { %>

                                <small>
                                    <%= itemUnit %>
                                </small>

                            <% } %>

                        </strong>

                    <% } else { %>

                        <strong class="history-quantity">
                            Updated
                        </strong>

                    <% } %>


                    <!-- ----------------------------------------
                         NOTE
                    ----------------------------------------- -->

                    <span class="history-preview">
                        <%= historyPreview %>
                    </span>


                    <!-- ----------------------------------------
                         USER
                    ----------------------------------------- -->

                    <span class="history-user">

                        <span class="history-user-dot"></span>

                        <%= recordedByName %>

                    </span>


                    <!-- ----------------------------------------
                         IMAGE INDICATOR
                    ----------------------------------------- -->

                    <% if (historyImages.length) { %>

                        <span class="history-images">

                            📷
                            <%= historyImages.length %>

                        </span>

                    <% } %>

                </button>

            <% }); %>


        </div>

    </section>



    <!-- ====================================================
         FOOTER
    ===================================================== -->

    <footer class="content-item-footer">

        <span class="footer-status">

            <span class="footer-status-dot"></span>

            Stock history active

        </span>


        <span class="footer-history-hint">

            Swipe to view updates

        </span>

    </footer>

</article>



<!-- ========================================================
     UPDATE DETAILS MODAL
========================================================= -->

<div
    class="history-modal"
    data-history-modal
    aria-hidden="true"
>

    <div
        class="history-modal-backdrop"
        data-close-history
    ></div>


    <div
        class="history-modal-panel"
        role="dialog"
        aria-modal="true"
        aria-labelledby="history-modal-title"
    >

        <button
            type="button"
            class="history-modal-close"
            data-close-history
            aria-label="Close update"
        >
            ×
        </button>


        <div class="history-modal-header">

            <span class="modal-kicker">
                STOCK UPDATE
            </span>

            <h2 id="history-modal-title">
                Update details
            </h2>

        </div>


        <div class="history-modal-body">


            <div class="modal-update-grid">

                <div class="modal-stat">

                    <span>
                        Quantity
                    </span>

                    <strong data-modal-quantity>
                        —
                    </strong>

                </div>


                <div class="modal-stat">

                    <span>
                        Recorded by
                    </span>

                    <strong data-modal-user>
                        —
                    </strong>

                </div>


                <div class="modal-stat">

                    <span>
                        Recorded at
                    </span>

                    <strong data-modal-date>
                        —
                    </strong>

                </div>

            </div>


            <div
                class="modal-note"
                data-modal-note-container
            >

                <span>
                    Note
                </span>

                <p data-modal-note></p>

            </div>


            <div
                class="modal-images"
                data-modal-images
            ></div>

        </div>

    </div>

</div>



<!-- ========================================================
     UPDATE COMPOSER
========================================================= -->

<div
    class="history-composer"
    data-history-composer
    aria-hidden="true"
>

    <div
        class="history-composer-backdrop"
        data-close-composer
    ></div>


    <div
        class="history-composer-panel"
        role="dialog"
        aria-modal="true"
        aria-labelledby="composer-title"
    >

        <button
            type="button"
            class="history-composer-close"
            data-close-composer
            aria-label="Close update composer"
        >
            ×
        </button>


        <div class="composer-header">

            <span class="composer-kicker">
                STOCK MANAGEMENT
            </span>

            <h2 id="composer-title">
                Update Stock
            </h2>

            <p>
                Record the current stock position
                and add any useful information.
            </p>

        </div>


        <div class="composer-content">

            <%
                /*
                    Existing update form.

                    The form itself remains in:
                        content-item-update.ejs

                    This avoids duplicating the update
                    form implementation here.
                */
            %>

            <%- include(
                "content-item-update",
                {
                    dairy:
                        currentDairy,

                    storage:
                        currentStorage,

                    item:
                        contentItem,

                    contentItemId:
                        contentItemId,

                    dwellNumber:
                        dwellNumber,

                    stockUpdateAction:
                        stockUpdateAction
                }
            ) %>

        </div>

    </div>

</div>



<style>

/* ==========================================================
   BASE
========================================================== */

.content-item-card {

    width: 100%;

    box-sizing: border-box;

    overflow: hidden;

    border:
        1px solid
        #e5e9e6;

    border-radius: 24px;

    background:
        #ffffff;

    box-shadow:
        0 12px 35px
        rgba(28, 48, 34, .07);

    font-family:
        Arial,
        Helvetica,
        sans-serif;

}


/* ==========================================================
   HEADER
========================================================== */

.content-item-header {

    display: flex;

    align-items: center;

    gap: 17px;

    padding:
        25px;

    background:
        linear-gradient(
            135deg,
            #f7fbf7,
            #ffffff
        );

    border-bottom:
        1px solid
        #edf0ed;

}


.content-item-icon {

    width: 58px;
    height: 58px;

    flex:
        0 0
        58px;

    display: flex;

    align-items: center;
    justify-content: center;

    border-radius: 17px;

    background:
        #eef7f0;

    font-size: 28px;

}


.content-item-heading {

    min-width: 0;

}


.content-item-eyebrow {

    display: block;

    margin-bottom: 4px;

    color:
        #7b887f;

    font-size: 8px;

    font-weight: 800;

    letter-spacing:
        2px;

}


.content-item-title {

    margin: 0;

    color:
        #213126;

    font-family:
        Georgia,
        "Times New Roman",
        serif;

    font-size:
        clamp(25px, 5vw, 38px);

    line-height: 1.05;

}


.content-item-badges {

    display: flex;

    flex-wrap: wrap;

    gap: 6px;

    margin-top: 9px;

}


.content-item-badge {

    display: inline-flex;

    align-items: center;

    padding:
        5px
        9px;

    border-radius:
        999px;

    font-size: 8px;

    font-weight: 800;

    letter-spacing:
        .7px;

}


.asset-badge {

    color:
        #41604a;

    background:
        #edf4ee;

}


.feed-badge {

    color:
        #287245;

    background:
        #e8f5eb;

}


.animal-badge {

    color:
        #795c26;

    background:
        #faf3df;

}


.status-badge {

    color:
        #637067;

    background:
        #f2f4f2;

}


/* ==========================================================
   SECTIONS
========================================================== */

.content-item-section {

    padding:
        24px 25px;

    border-bottom:
        1px solid
        #edf0ed;

}


.section-heading {

    display: flex;

    align-items: center;

    gap: 14px;

    margin-bottom: 15px;

}


.section-heading > div {

    flex:
        0 0
        auto;

}


.section-kicker {

    display: block;

    margin-bottom: 3px;

    color:
        #849088;

    font-size: 7px;

    font-weight: 800;

    letter-spacing:
        1.8px;

}


.section-heading h2 {

    margin: 0;

    color:
        #29382e;

    font-size: 15px;

    font-weight: 700;

}


.section-line {

    flex: 1;

    height: 1px;

    background:
        #e5ebe6;

}


.history-count {

    flex:
        0 0
        auto;

    padding:
        5px 9px;

    border-radius:
        999px;

    color:
        #477154;

    background:
        #eef7f0;

    font-size: 8px;

    font-weight: 700;

}


/* ==========================================================
   STOCK OVERVIEW
========================================================== */

.stock-overview {

    display: grid;

    grid-template-columns:
        repeat(3, 1fr);

    gap: 10px;

}


.stock-stat {

    min-width: 0;

    padding:
        15px;

    border:
