        grid-template-columns:
            repeat(2, 1fr);

    }

}

</style>



<!-- =========================================================
     POST IMAGE VIEWER
========================================================= -->

<div
    id="postImageViewer"
    class="post-image-viewer"
    aria-hidden="true"
>


    <button
        type="button"
        id="closePostImageViewer"
        class="post-image-viewer-close"
        aria-label="Close image"
    >

        <i class="bi bi-x-lg"></i>

    </button>


    <button
        type="button"
        id="previousPostImage"
        class="post-image-viewer-navigation previous"
