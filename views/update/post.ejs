<!-- =========================================================
     POST INTERACTION JAVASCRIPT
========================================================= -->

<script>

(function(){

    if(
        window.__modernPostInteractionsInitialized
    ){

        return;

    }


    window.__modernPostInteractionsInitialized =
        true;


    let activePhotoViewer = null;

    let activePhotoIndex = 0;

    let activePhotoImages = [];

    let touchStartX = 0;

    let touchStartY = 0;



    /* =====================================================
       OPEN EXPANDED POST
    ====================================================== */

    function openExpandedPost(button){

        if(!button){

            return;

        }


        const postId =
            button.dataset.postExpand;


        if(!postId){

            return;

        }


        const modal =
            document.querySelector(
                `[data-post-expand-modal="${postId}"]`
            );


        if(!modal){

            return;

        }


        modal.classList.add("active");

        modal.setAttribute(
            "aria-hidden",
            "false"
        );


        document.body.style.overflow =
            "hidden";


        const body =
            modal.querySelector(
                ".post-expand-body"
            );


        if(body){

            body.scrollTop = 0;

        }

    }



    /* =====================================================
       CLOSE EXPANDED POST
    ====================================================== */

    function closeExpandedPost(modal){

        if(!modal){

            return;

        }


        modal.classList.remove("active");

        modal.setAttribute(
            "aria-hidden",
            "true"
        );


        if(
            !document.querySelector(
                ".post-photo-viewer.active"
            ) &&
            !document.querySelector(
                ".comment-modal.active"
            )
        ){

            document.body.style.overflow = "";

        }

    }



    /* =====================================================
       COLLECT IMAGES
    ====================================================== */

    function getPostImagesFromCard(card){

        if(!card){

            return [];

        }


        const images = [];


        card
            .querySelectorAll(
                ".post-expand-image img"
            )
            .forEach(function(img){

                if(img.src){

                    images.push(img.src);

                }

            });


        if(!images.length){

            card
                .querySelectorAll(
                    ".post-image-item img"
                )
                .forEach(function(img){

                    if(img.src){

                        images.push(img.src);

                    }

                });

        }


        return images;

    }



    /* =====================================================
       OPEN PHOTO VIEWER
    ====================================================== */

    function openPhotoViewer(card,index){

        if(!card){

            return;

        }


        const viewer =
            card.querySelector(
                ".post-photo-viewer"
            );


        if(!viewer){

            return;

        }


        const images =
            getPostImagesFromCard(card);


        if(!images.length){

            return;

        }


        activePhotoViewer =
            viewer;


        activePhotoImages =
            images;


        activePhotoIndex =
            Math.max(
                0,
                Math.min(
                    Number(index) || 0,
                    images.length - 1
                )
            );


        updatePhotoViewer();


        viewer.classList.add("active");

        viewer.setAttribute(
            "aria-hidden",
            "false"
        );


        document.body.style.overflow =
            "hidden";

    }



    /* =====================================================
       UPDATE VIEWER
    ====================================================== */

    function updatePhotoViewer(){

        if(
            !activePhotoViewer ||
            !activePhotoImages.length
        ){

            return;

        }


        const image =
            activePhotoViewer.querySelector(
                ".photo-viewer-image"
            );


        const current =
            activePhotoViewer.querySelector(
                ".photo-current"
            );


        if(image){

            image.src =
                activePhotoImages[
                    activePhotoIndex
                ];

        }


        if(current){

            current.textContent =
                activePhotoIndex + 1;

        }

    }



    /* =====================================================
       CLOSE VIEWER
    ====================================================== */

    function closePhotoViewer(){

        if(!activePhotoViewer){

            return;

        }


        activePhotoViewer.classList.remove(
            "active"
        );


        activePhotoViewer.setAttribute(
            "aria-hidden",
            "true"
        );


        activePhotoViewer = null;

        activePhotoImages = [];

        activePhotoIndex = 0;


        if(
            !document.querySelector(
                ".post-expand-modal.active"
            ) &&
            !document.querySelector(
                ".comment-modal.active"
            )
        ){

            document.body.style.overflow = "";

        }

    }



    /* =====================================================
       NEXT
    ====================================================== */

    function nextPhoto(){

        if(!activePhotoImages.length){

            return;

        }


        activePhotoIndex =
            (
                activePhotoIndex + 1
            ) %
            activePhotoImages.length;


        updatePhotoViewer();

    }



    /* =====================================================
       PREVIOUS
    ====================================================== */

    function previousPhoto(){

        if(!activePhotoImages.length){

            return;

        }


        activePhotoIndex =
            (
                activePhotoIndex -
                1 +
                activePhotoImages.length
            ) %
            activePhotoImages.length;


        updatePhotoViewer();

    }



    /* =====================================================
       CLICK HANDLER
    ====================================================== */

    document.addEventListener(
        "click",
        function(event){

            const seeMore =
                event.target.closest(
                    ".post-see-more"
                );


            if(seeMore){

                event.preventDefault();

                event.stopPropagation();

                openExpandedPost(
                    seeMore
                );

                return;

            }


            const closeExpanded =
                event.target.closest(
                    "[data-close-post-expand]"
                );


            if(closeExpanded){

                event.preventDefault();

                const modal =
                    closeExpanded.closest(
                        ".post-expand-modal"
                    );


                closeExpandedPost(modal);

                return;

            }


            const photoButton =
                event.target.closest(
                    ".post-image-item, .post-expand-image"
                );


            if(photoButton){

                event.preventDefault();

                const card =
                    photoButton.closest(
                        ".post-card"
                    );


                const index =
                    Number(
                        photoButton.dataset.photoIndex ||
                        0
                    );


                openPhotoViewer(
                    card,
                    index
                );

                return;

            }


            const closeViewer =
                event.target.closest(
                    "[data-close-photo-viewer]"
                );


            if(closeViewer){

                event.preventDefault();

                closePhotoViewer();

                return;

            }


            const next =
                event.target.closest(
                    "[data-photo-next]"
                );


            if(next){

                event.preventDefault();

                nextPhoto();

                return;

            }


            const previous =
                event.target.closest(
                    "[data-photo-prev]"
                );


            if(previous){

                event.preventDefault();

                previousPhoto();

                return;

            }

        }
    );



    /* =====================================================
       SWIPE
    ====================================================== */

    document.addEventListener(
        "touchstart",
        function(event){

            if(
                !activePhotoViewer ||
                !activePhotoViewer.classList.contains(
                    "active"
                )
            ){

                return;

            }


            const touch =
                event.touches[0];


            if(!touch){

                return;

            }


            touchStartX =
                touch.clientX;


            touchStartY =
                touch.clientY;

        },
        {
            passive: true
        }
    );



    document.addEventListener(
        "touchend",
        function(event){

            if(
                !activePhotoViewer ||
                !activePhotoViewer.classList.contains(
                    "active"
                )
            ){

                return;

            }


            const touch =
                event.changedTouches[0];


            if(!touch){

                return;

            }


            const deltaX =
                touch.clientX -
                touchStartX;


            const deltaY =
                touch.clientY -
                touchStartY;


            if(
                Math.abs(deltaX) < 50 ||
                Math.abs(deltaX) <= Math.abs(deltaY)
            ){

                return;

            }


            if(deltaX < 0){

                nextPhoto();

            }
            else{

                previousPhoto();

            }

        },
        {
            passive: true
        }
    );



    /* =====================================================
       KEYBOARD
    ====================================================== */

    document.addEventListener(
        "keydown",
        function(event){

            if(
                event.key === "Escape"
            ){

                if(activePhotoViewer){

                    closePhotoViewer();

                    return;

                }


                const expanded =
                    document.querySelector(
                        ".post-expand-modal.active"
                    );


                if(expanded){

                    closeExpandedPost(
                        expanded
                    );

                }

                return;

            }


            if(activePhotoViewer){

                if(
                    event.key === "ArrowRight"
                ){

                    nextPhoto();

                }


                if(
                    event.key === "ArrowLeft"
                ){

                    previousPhoto();

                }

            }

        }
    );

})();

</script>