<!-- =========================================================
     POST JAVASCRIPT
========================================================= -->

<script>

(function () {

    /*
     * -------------------------------------------------------
     * INITIALIZATION GUARD
     * -------------------------------------------------------
     */

    if (window.__corevesterCpostInitialized) {

        return;

    }

    window.__corevesterCpostInitialized = true;



    /*
     * -------------------------------------------------------
     * ACTIVE PHOTO VIEWER
     * -------------------------------------------------------
     */

    let cpostActiveViewer = null;

    let cpostActiveImages = [];

    let cpostActiveIndex = 0;

    let cpostTouchStartX = 0;

    let cpostTouchStartY = 0;



    /*
     * -------------------------------------------------------
     * BODY LOCK
     * -------------------------------------------------------
     */

    function cpostLockBody() {

        document.body.style.overflow = "hidden";

    }


    function cpostUnlockBody() {

        if (
            !document.querySelector(
                ".cpost-expand.cpost-is-active"
            ) &&
            !document.querySelector(
                ".cpost-viewer.cpost-is-active"
            ) &&
            !document.querySelector(
                ".cpost-comment-modal.cpost-is-active"
            )
        ) {

            document.body.style.overflow = "";

        }

    }



    /*
     * -------------------------------------------------------
     * EXPAND POST
     * -------------------------------------------------------
     */

    function cpostOpenExpanded(button) {

        if (!button) {

            return;

        }


        const postId =
            button.dataset.cpostExpand;


        if (!postId) {

            return;

        }


        const modal =
            document.querySelector(
                `[data-cpost-expand-modal="${postId}"]`
            );


        if (!modal) {

            return;

        }


        modal.classList.add(
            "cpost-is-active"
        );

        modal.setAttribute(
            "aria-hidden",
            "false"
        );

        cpostLockBody();


        const body =
            modal.querySelector(
                ".cpost-expand-body"
            );


        if (body) {

            body.scrollTop = 0;

        }

    }



    /*
     * -------------------------------------------------------
     * CLOSE EXPANDED POST
     * -------------------------------------------------------
     */

    function cpostCloseExpanded(modal) {

        if (!modal) {

            return;

        }


        modal.classList.remove(
            "cpost-is-active"
        );

        modal.setAttribute(
            "aria-hidden",
            "true"
        );


        cpostUnlockBody();

    }



    /*
     * -------------------------------------------------------
     * GET IMAGES
     * -------------------------------------------------------
     */

    function cpostGetImages(card) {

        if (!card) {

            return [];

        }


        const images = [];


        card
            .querySelectorAll(
                ".cpost-expanded-image img"
            )
            .forEach(function (img) {

                if (img.src) {

                    images.push(img.src);

                }

            });


        if (!images.length) {

            card
                .querySelectorAll(
                    ".cpost-image-button img"
                )
                .forEach(function (img) {

                    if (img.src) {

                        images.push(img.src);

                    }

                });

        }


        return images;

    }



    /*
     * -------------------------------------------------------
     * OPEN PHOTO VIEWER
     * -------------------------------------------------------
     */

    function cpostOpenViewer(card, index) {

        if (!card) {

            return;

        }


        const viewer =
            card.querySelector(
                ".cpost-viewer"
            );


        if (!viewer) {

            return;

        }


        const images =
            cpostGetImages(card);


        if (!images.length) {

            return;

        }


        cpostActiveViewer = viewer;

        cpostActiveImages = images;

        cpostActiveIndex =
            Math.max(
                0,
                Math.min(
                    Number(index) || 0,
                    images.length - 1
                )
            );


        cpostUpdateViewer();


        viewer.classList.add(
            "cpost-is-active"
        );

        viewer.setAttribute(
            "aria-hidden",
            "false"
        );


        cpostLockBody();

    }



    /*
     * -------------------------------------------------------
     * UPDATE PHOTO VIEWER
     * -------------------------------------------------------
     */

    function cpostUpdateViewer() {

        if (
            !cpostActiveViewer ||
            !cpostActiveImages.length
        ) {

            return;

        }


        const image =
            cpostActiveViewer.querySelector(
                ".cpost-viewer-image"
            );


        const counter =
            cpostActiveViewer.querySelector(
                ".cpost-current-photo"
            );


        if (image) {

            image.src =
                cpostActiveImages[
                    cpostActiveIndex
                ];

        }


        if (counter) {

            counter.textContent =
                cpostActiveIndex + 1;

        }

    }



    /*
     * -------------------------------------------------------
     * CLOSE PHOTO VIEWER
     * -------------------------------------------------------
     */

    function cpostCloseViewer() {

        if (!cpostActiveViewer) {

            return;

        }


        cpostActiveViewer.classList.remove(
            "cpost-is-active"
        );

        cpostActiveViewer.setAttribute(
            "aria-hidden",
            "true"
        );


        cpostActiveViewer = null;

        cpostActiveImages = [];

        cpostActiveIndex = 0;


        cpostUnlockBody();

    }



    /*
     * -------------------------------------------------------
     * NEXT PHOTO
     * -------------------------------------------------------
     */

    function cpostNextPhoto() {

        if (!cpostActiveImages.length) {

            return;

        }


        cpostActiveIndex =
            (
                cpostActiveIndex + 1
            ) %
            cpostActiveImages.length;


        cpostUpdateViewer();

    }



    /*
     * -------------------------------------------------------
     * PREVIOUS PHOTO
     * -------------------------------------------------------
     */

    function cpostPreviousPhoto() {

        if (!cpostActiveImages.length) {

            return;

        }


        cpostActiveIndex =
            (
                cpostActiveIndex -
                1 +
                cpostActiveImages.length
            ) %
            cpostActiveImages.length;


        cpostUpdateViewer();

    }



    /*
     * -------------------------------------------------------
     * OPEN COMMENTS
     * -------------------------------------------------------
     */

    function cpostOpenComments(button) {

        if (!button) {

            return;

        }


        const postId =
            button.dataset.cpostComments;


        if (!postId) {

            return;

        }


        const modal =
            document.querySelector(
                `[data-cpost-comment-modal="${postId}"]`
            );


        if (!modal) {

            return;

        }


        modal.classList.add(
            "cpost-is-active"
        );

        modal.setAttribute(
            "aria-hidden",
            "false"
        );


        cpostLockBody();

    }



    /*
     * -------------------------------------------------------
     * CLOSE COMMENTS
     * -------------------------------------------------------
     */

    function cpostCloseComments(modal) {

        if (!modal) {

            return;

        }


        modal.classList.remove(
            "cpost-is-active"
        );

        modal.setAttribute(
            "aria-hidden",
            "true"
        );


        cpostUnlockBody();

    }



    /*
     * -------------------------------------------------------
     * CLICK HANDLER
     * -------------------------------------------------------
     */

    document.addEventListener(
        "click",
        function (event) {


            /*
             * SEE MORE
             */

            const seeMore =
                event.target.closest(
                    ".cpost-see-more"
                );


            if (seeMore) {

                event.preventDefault();

                event.stopPropagation();

                cpostOpenExpanded(
                    seeMore
                );

                return;

            }



            /*
             * CLOSE EXPANDED
             */

            const closeExpand =
                event.target.closest(
                    "[data-cpost-close-expand]"
                );


            if (closeExpand) {

                event.preventDefault();


                const modal =
                    closeExpand.closest(
                        ".cpost-expand"
                    );


                cpostCloseExpanded(
                    modal
                );

                return;

            }



            /*
             * COMMENTS
             */

            const commentsButton =
                event.target.closest(
                    ".cpost-comments-button"
                );


            if (commentsButton) {

                event.preventDefault();

                cpostOpenComments(
                    commentsButton
                );

                return;

            }



            /*
             * CLOSE COMMENTS
             */

            const closeComments =
                event.target.closest(
                    "[data-cpost-close-comments]"
                );


            if (closeComments) {

                event.preventDefault();


                const modal =
                    closeComments.closest(
                        ".cpost-comment-modal"
                    );


                cpostCloseComments(
                    modal
                );

                return;

            }



            /*
             * POST IMAGE
             */

            const photoButton =
                event.target.closest(
                    ".cpost-image-button, .cpost-expanded-image"
                );


            if (photoButton) {

                event.preventDefault();


                const card =
                    photoButton.closest(
                        ".cpost-card"
                    );


                const index =
                    Number(
                        photoButton.dataset
                            .cpostPhotoIndex ||
                        0
                    );


                cpostOpenViewer(
                    card,
                    index
                );

                return;

            }



            /*
             * CLOSE PHOTO VIEWER
             */

            const closeViewer =
                event.target.closest(
                    "[data-cpost-close-viewer]"
                );


            if (closeViewer) {

                event.preventDefault();

                cpostCloseViewer();

                return;

            }



            /*
             * NEXT PHOTO
             */

            const next =
                event.target.closest(
                    "[data-cpost-photo-next]"
                );


            if (next) {

                event.preventDefault();

                cpostNextPhoto();

                return;

            }



            /*
             * PREVIOUS PHOTO
             */

            const previous =
                event.target.closest(
                    "[data-cpost-photo-prev]"
                );


            if (previous) {

                event.preventDefault();

                cpostPreviousPhoto();

                return;

            }

        }
    );



    /*
     * -------------------------------------------------------
     * TOUCH START
     * -------------------------------------------------------
     */

    document.addEventListener(
        "touchstart",
        function (event) {

            if (
                !cpostActiveViewer ||
                !cpostActiveViewer.classList.contains(
                    "cpost-is-active"
                )
            ) {

                return;

            }


            const touch =
                event.touches[0];


            if (!touch) {

                return;

            }


            cpostTouchStartX =
                touch.clientX;


            cpostTouchStartY =
                touch.clientY;

        },
        {
            passive: true
        }
    );



    /*
     * -------------------------------------------------------
     * TOUCH END
     * -------------------------------------------------------
     */

    document.addEventListener(
        "touchend",
        function (event) {

            if (
                !cpostActiveViewer ||
                !cpostActiveViewer.classList.contains(
                    "cpost-is-active"
                )
            ) {

                return;

            }


            const touch =
                event.changedTouches[0];


            if (!touch) {

                return;

            }


            const deltaX =
                touch.clientX -
                cpostTouchStartX;


            const deltaY =
                touch.clientY -
                cpostTouchStartY;


            if (
                Math.abs(deltaX) < 50 ||
                Math.abs(deltaX) <= Math.abs(deltaY)
            ) {

                return;

            }


            if (deltaX < 0) {

                cpostNextPhoto();

            } else {

                cpostPreviousPhoto();

            }

        },
        {
            passive: true
        }
    );



    /*
     * -------------------------------------------------------
     * KEYBOARD
     * -------------------------------------------------------
     */

    document.addEventListener(
        "keydown",
        function (event) {


            if (event.key === "Escape") {


                if (cpostActiveViewer) {

                    cpostCloseViewer();

                    return;

                }


                const expanded =
                    document.querySelector(
                        ".cpost-expand.cpost-is-active"
                    );


                if (expanded) {

                    cpostCloseExpanded(
                        expanded
                    );

                    return;

                }


                const comments =
                    document.querySelector(
                        ".cpost-comment-modal.cpost-is-active"
                    );


                if (comments) {

                    cpostCloseComments(
                        comments
                    );

                }


                return;

            }



            if (cpostActiveViewer) {


                if (
                    event.key === "ArrowRight"
                ) {

                    cpostNextPhoto();

                }


                if (
                    event.key === "ArrowLeft"
                ) {

                    cpostPreviousPhoto();

                }

            }

        }
    );


})();

</script>