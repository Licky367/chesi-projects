<!-- =========================================================
     POST INTERACTION SCRIPT

     ONLY HANDLES:

     • Detecting long photo-post text
     • See more
     • Opening expanded post
     • Closing expanded post

     LIKE / COMMENT / DELETE ARE STILL HANDLED BY
     feed-actions.ejs.
========================================================= -->

<script>

(function () {

    /* =====================================================
       PREVENT DUPLICATE INITIALIZATION
    ====================================================== */

    if (
        window.__postCardExpansionInitialized
    ) {

        return;

    }


    window.__postCardExpansionInitialized =
        true;



    /* =====================================================
       DETECT LONG TEXT
    ====================================================== */

    function checkPostText(card) {

        if (!card) {

            return;

        }


        const wrapper =
            card.querySelector(
                ".post-text-wrapper.has-post-image"
            );


        if (!wrapper) {

            return;

        }


        const text =
            wrapper.querySelector(
                ".post-text"
            );


        const seeMore =
            wrapper.querySelector(
                ".post-see-more"
            );


        const expandButton =
            card.querySelector(
                ".post-expand-button"
            );


        if (
            !text ||
            !seeMore
        ) {

            return;

        }


        /*
         * Temporarily remove truncation so we can
         * measure the real text height.
         */

        wrapper.classList.remove(
            "is-truncated"
        );


        /*
         * Three lines based on the actual line height.
         */

        const styles =
            window.getComputedStyle(
                text
            );


        const lineHeight =
            parseFloat(
                styles.lineHeight
            );


        const threeLineHeight =
            lineHeight * 3;


        const isLong =
            text.scrollHeight >
            threeLineHeight + 2;


        if (isLong) {

            wrapper.classList.add(
                "is-truncated"
            );


            seeMore.hidden =
                false;


            if (expandButton) {

                expandButton.hidden =
                    false;

            }

        }
        else {

            seeMore.hidden =
                true;


            if (expandButton) {

                expandButton.hidden =
                    true;

            }

        }

    }



    /* =====================================================
       OPEN POST
    ====================================================== */

    function openPost(card) {

        if (!card) {

            return;

        }


        card.classList.add(
            "is-expanded"
        );


        document.body.classList.add(
            "post-expanded-open"
        );


        document.body.style.overflow =
            "hidden";


        const backdrop =
            card.querySelector(
                ".post-expand-backdrop"
            );


        if (backdrop) {

            backdrop.setAttribute(
                "aria-hidden",
                "false"
            );

        }

    }



    /* =====================================================
       CLOSE POST
    ====================================================== */

    function closePost(card) {

        if (!card) {

            return;

        }


        card.classList.remove(
            "is-expanded"
        );


        document.body.classList.remove(
            "post-expanded-open"
        );


        /*
         * Only restore scrolling when there isn't
         * another modal open.
         */

        const activeCommentModal =
            document.querySelector(
                ".comment-modal.active"
            );


        if (!activeCommentModal) {

            document.body.style.overflow =
                "";

        }


        const backdrop =
            card.querySelector(
                ".post-expand-backdrop"
            );


        if (backdrop) {

            backdrop.setAttribute(
                "aria-hidden",
                "true"
            );

        }

    }



    /* =====================================================
       CLOSE ALL EXPANDED POSTS
    ====================================================== */

    function closeAllPosts() {

        document
            .querySelectorAll(
                ".feed-card.post-card.is-expanded"
            )
            .forEach(
                closePost
            );

    }



    /* =====================================================
       INITIAL CHECK
    ====================================================== */

    function initializePostCards() {

        document
            .querySelectorAll(
                ".feed-card.post-card"
            )
            .forEach(
                checkPostText
            );

    }


    /*
     * Run after the page has painted.
     *
     * This gives the browser the correct width before
     * measuring how many lines the text occupies.
     */

    if (
        document.readyState ===
        "loading"
    ) {

        document.addEventListener(
            "DOMContentLoaded",
            initializePostCards,
            {
                once: true
            }
        );

    }
    else {

        initializePostCards();

    }



    /* =====================================================
       WINDOW RESIZE

       Recalculate because a change in width can turn
       a three-line post into a four-line post or vice versa.
    ====================================================== */

    let resizeTimer = null;


    window.addEventListener(
        "resize",
        function () {

            clearTimeout(
                resizeTimer
            );


            resizeTimer =
                setTimeout(
                    function () {

                        document
                            .querySelectorAll(
                                ".feed-card.post-card:not(.is-expanded)"
                            )
                            .forEach(
                                checkPostText
                            );

                    },
                    150
                );

        }
    );



    /* =====================================================
       CLICK HANDLER
    ====================================================== */

    document.addEventListener(
        "click",
        function (event) {


            /* =============================================
               SEE MORE
            ============================================== */

            const seeMore =
                event.target.closest(
                    ".post-see-more"
                );


            if (seeMore) {

                event.preventDefault();

                event.stopPropagation();


                const card =
                    seeMore.closest(
                        ".feed-card.post-card"
                    );


                openPost(card);

                return;

            }



            /* =============================================
               EXPAND ICON
            ============================================== */

            const expandButton =
                event.target.closest(
                    ".post-expand-button"
                );


            if (expandButton) {

                event.preventDefault();

                event.stopPropagation();


                const card =
                    expandButton.closest(
                        ".feed-card.post-card"
                    );


                openPost(card);

                return;

            }



            /* =============================================
               CLOSE EXPANDED POST
            ============================================== */

            const closeButton =
                event.target.closest(
                    ".post-expanded-close"
                );


            if (closeButton) {

                event.preventDefault();

                event.stopPropagation();


                const card =
                    closeButton.closest(
                        ".feed-card.post-card"
                    );


                closePost(card);

                return;

            }



            /* =============================================
               CLICK BACKDROP
            ============================================== */

            if (
                event.target.classList.contains(
                    "post-expand-backdrop"
                )
            ) {

                const card =
                    event.target.closest(
                        ".feed-card.post-card"
                    );


                closePost(card);

                return;

            }



            /* =============================================
               CLICK IMAGE OVERLAY

               If the user taps +N, open the full post.
            ============================================== */

            const moreImages =
                event.target.closest(
                    ".post-more-images"
                );


            if (moreImages) {

                const card =
                    moreImages.closest(
                        ".feed-card.post-card"
                    );


                if (card) {

                    event.preventDefault();

                    event.stopPropagation();

                    openPost(card);

                }

                return;

            }

        }
    );



    /* =====================================================
       ESCAPE KEY
    ====================================================== */

    document.addEventListener(
        "keydown",
        function (event) {

            if (
                event.key !==
                "Escape"
            ) {

                return;

            }


            closeAllPosts();

        }
    );



    /* =====================================================
       IMAGE LOAD RECALCULATION
    ====================================================== */

    document.addEventListener(
        "load",
        function (event) {

            if (
                event.target &&
                event.target.matches &&
                event.target.matches(
                    ".post-image"
                )
            ) {

                const card =
                    event.target.closest(
                        ".feed-card.post-card"
                    );


                if (
                    card &&
                    !card.classList.contains(
                        "is-expanded"
                    )
                ) {

                    checkPostText(card);

                }

            }

        },
        true
    );

})();

</script>