        16px
        10px;

    box-sizing: border-box;

}


.feed-comment {

    display: flex;

    align-items: flex-start;

    gap: 8px;

    margin-top: 10px;

}


.feed-comment-avatar {

    width: 32px;

    height: 32px;

    flex: 0 0 32px;

    border-radius: 50%;

    object-fit: cover;

}


.feed-comment-body {

    min-width: 0;

    flex: 1;

}


.feed-comment-bubble {

    display: inline-block;

    max-width: 100%;

    padding:
        8px
        11px;

    border-radius: 12px;

