<!-- =========================================================
     POST FEED ITEM

     FILE:
     views/update/post.ejs

     IMPORTANT:
     This partial receives:

         item
         user

     from:

         update/feed.ejs

     Example:

         <%- include("post", {
             item,
             user
         }) %>

========================================================= -->


<%
    // =====================================================
    // CURRENT POST
    // =====================================================

    const post =
        item || {};


    // =====================================================
    // POST ID
    // =====================================================

    const postId =
        post._id
            ? post._id.toString()
            : "";


    // =====================================================
    // USER NAME
    // =====================================================

    const postUserName =
        post.userName ||
        "User";


    // =====================================================
    // USER IMAGE
    // =====================================================

    const postUserImage =
        post.userImage ||
        (
            "https://ui-avatars.com/api/?name=" +
            encodeURIComponent(postUserName)
        );


    // =====================================================
    // POST TITLE
    // =====================================================

    const postTitle =
        post.title ||
        "";


    // =====================================================
    // POST TEXT
    // =====================================================

    const postText =
        post.text ||
        "";


    // =====================================================
    // IMAGES
    //
    // New system:
    //
    //     post.images = []
    //
    // Backward compatibility:
    //
    //     post.image
    //
    // is also supported.
    // =====================================================

    let postImages = [];


    if (
        Array.isArray(post.images)
    ) {

        postImages =
            post.images.filter(
                image => image
            );

    }


    // -----------------------------------------------------
    // BACKWARD COMPATIBILITY WITH OLD SINGLE IMAGE
    // -----------------------------------------------------

    if (
        postImages.length === 0 &&
        post.image
    ) {

        postImages = [
            post.image
        ];

    }


    // =====================================================
    // LIKE COUNT
    // =====================================================

    const likeCount =
        Array.isArray(post.likes)
            ? post.likes.length
            : (
                typeof post.likes === "number"
                    ? post.likes
                    : 0
            );


    // =====================================================
    // DETERMINE WHETHER CURRENT USER LIKED POST
    // =====================================================

    let userLiked =
        false;


    if (
        user &&
        user._id &&
        Array.isArray(post.likes)
    ) {

        const currentUserId =
            user._id.toString();


        userLiked =
            post.likes.some(
                likeId => {

                    if (!likeId) {
                        return false;
                    }

                    return likeId.toString() ===
                        currentUserId;

                }
            );

    }


    // =====================================================
    // COMMENTS
    // =====================================================

    const comments =
        Array.isArray(post.comments)
            ? post.comments
            : [];


    // =====================================================
    // COMMENT COUNT
    // =====================================================

    const commentCount =
        comments.length;


    // =====================================================
    // CURRENT USER ID
    // =====================================================

    const currentUserId =
        user && user._id
            ? user._id.toString()
            : "";


    // =====================================================
    // DATE
    // =====================================================

    let postDateText =
        "";


    if (post.createdAt) {

        postDateText =
            new Date(
                post.createdAt
            ).toLocaleString();

    }

%>


<!-- =========================================================
     POST
========================================================= -->

<article
    class="feed-post"
    data-post-id="<%= postId %>"
>


    <!-- =====================================================
         POST HEADER
    ====================================================== -->

    <header class="feed-post-header">


        <!-- =================================================
             USER
        ================================================== -->

        <div class="feed-post-user">


            <!-- USER AVATAR -->

            <img
                src="<%= postUserImage %>"
                alt="<%= postUserName %>"
                class="feed-post-avatar"
            >


            <!-- USER INFORMATION -->

            <div class="feed-post-user-info">

                <strong class="feed-post-user-name">
                    <%= postUserName %>
                </strong>


                <% if (postDateText) { %>

                    <span class="feed-post-date">
                        <%= postDateText %>
                    </span>

                <% } %>

            </div>

        </div>



        <!-- =================================================
             POST MENU
        ================================================== -->

        <% if (user && (user.role === "admin" || (
            post.user &&
            user._id &&
            post.user.toString() === user._id.toString()
        ))) { %>

            <button
                type="button"
                class="feed-post-menu-button"
                data-post-menu="<%= postId %>"
                aria-label="Post options"
                title="Post options"
            >

                <i class="bi bi-three-dots"></i>

            </button>

        <% } %>


    </header>



    <!-- =====================================================
         POST CONTENT
    ====================================================== -->

    <div class="feed-post-content">


        <!-- =================================================
             TITLE
        ================================================== -->

        <% if (postTitle) { %>

            <h3 class="feed-post-title">
                <%= postTitle %>
            </h3>

        <% } %>



        <!-- =================================================
             TEXT
        ================================================== -->

        <% if (postText) { %>

            <div class="feed-post-text">

                <%= postText %>

            </div>

        <% } %>



        <!-- =================================================
             MULTIPLE IMAGE GALLERY
        ================================================== -->

        <% if (postImages.length > 0) { %>


            <div
                class="
                    feed-post-image-gallery
                    gallery-count-<%= postImages.length > 4
                        ? 'many'
                        : postImages.length %>
                "
            >


                <% postImages.forEach(function (image, index) { %>

                    <button
                        type="button"
                        class="feed-post-image-button"
                        data-image-index="<%= index %>"
                        data-post-id="<%= postId %>"
                        aria-label="View image <%= index + 1 %>"
                    >

                        <img
                            src="<%= image.startsWith('/') ? image : '/uploads/' + image %>"
                            alt="Post image <%= index + 1 %>"
                            class="feed-post-image"
                            loading="lazy"
                        >

                    </button>

                <% }); %>


            </div>

        <% } %>


    </div>



    <!-- =====================================================
         POST ACTIONS
    ====================================================== -->

    <div class="feed-post-actions">


        <!-- =================================================
             LIKE
        ================================================== -->

        <button
            type="button"
            class="
                feed-post-action
                like-post-button
                <%= userLiked ? 'liked' : '' %>
            "
            data-post-id="<%= postId %>"
            aria-label="Like post"
        >

            <i
                class="
                    bi
                    <%= userLiked
                        ? 'bi-heart-fill'
                        : 'bi-heart' %>
                "
            ></i>

            <span class="like-count">
                <%= likeCount %>
            </span>

        </button>



        <!-- =================================================
             COMMENT
        ================================================== -->

        <button
            type="button"
            class="feed-post-action comment-post-button"
            data-post-id="<%= postId %>"
            aria-label="Comment on post"
        >

            <i class="bi bi-chat"></i>

            <span class="comment-count">
                <%= commentCount %>
            </span>

        </button>


    </div>



    <!-- =====================================================
         COMMENTS
    ====================================================== -->

    <% if (comments.length > 0) { %>

        <section
            class="feed-post-comments"
            data-comments-for="<%= postId %>"
        >


            <% comments.forEach(function (comment) { %>


                <%
                    const commentUserName =
                        comment.userName ||
                        "User";


                    const commentUserImage =
                        comment.userImage ||
                        (
                            "https://ui-avatars.com/api/?name=" +
                            encodeURIComponent(
                                commentUserName
                            )
                        );


                    const commentOwner =
                        currentUserId &&
                        comment.userId &&
                        comment.userId.toString() ===
                        currentUserId;


                    const canDeleteComment =
                        commentOwner ||
                        (
                            user &&
                            user.role === "admin"
                        );


                    let commentDateText =
                        "";


                    if (comment.createdAt) {

                        commentDateText =
                            new Date(
                                comment.createdAt
                            ).toLocaleString();

                    }

                %>


                <!-- =========================================
                     COMMENT
                ========================================== -->

                <div
                    class="feed-comment"
                    data-comment-id="<%= comment._id %>"
                >


                    <!-- COMMENT AVATAR -->

                    <img
                        src="<%= commentUserImage %>"
                        alt="<%= commentUserName %>"
                        class="feed-comment-avatar"
                    >


                    <!-- COMMENT CONTENT -->

                    <div class="feed-comment-body">


                        <div class="feed-comment-bubble">


                            <strong class="feed-comment-user">

                                <%= commentUserName %>

                            </strong>


                            <div class="feed-comment-text">

                                <%= comment.text %>

                            </div>


                        </div>


                        <!-- COMMENT META -->

                        <div class="feed-comment-meta">


                            <% if (commentDateText) { %>

                                <span>
                                    <%= commentDateText %>
                                </span>

                            <% } %>


                            <% if (canDeleteComment) { %>

                                <button
                                    type="button"
                                    class="delete-comment-button"
                                    data-comment-id="<%= comment._id %>"
                                    data-post-id="<%= postId %>"
                                >

                                    Delete

                                </button>

                            <% } %>


                        </div>


                    </div>


                </div>


            <% }); %>


        </section>

    <% } %>



    <!-- =====================================================
         COMMENT INPUT
    ====================================================== -->

    <% if (user) { %>

        <div
            class="feed-post-comment-composer"
            data-comment-composer="<%= postId %>"
        >


            <img
                src="<%= user.profileImage || (
                    'https://ui-avatars.com/api/?name=' +
                    encodeURIComponent(user.name)
                ) %>"
                alt="<%= user.name %>"
                class="feed-comment-current-avatar"
            >


            <div class="feed-comment-input-wrapper">

                <input
                    type="text"
                    class="feed-comment-input"
                    data-post-id="<%= postId %>"
                    maxlength="500"
                    placeholder="Write a comment..."
                >


                <button
                    type="button"
                    class="feed-comment-send-button"
                    data-post-id="<%= postId %>"
                    aria-label="Send comment"
                >

                    <i class="bi bi-send-fill"></i>

                </button>

            </div>


        </div>

    <% } %>


</article>



<!-- =========================================================
     POST CSS
========================================================= -->

<style>

/* =========================================================
