}



/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 600px) {

    .feed-post {

        border-radius: 12px;

    }


    .feed-post-header {

        padding:
            12px;

    }


    .feed-post-avatar {

        width: 40px;

        height: 40px;

        flex-basis: 40px;

    }


    .feed-post-title {

        padding:
            0
            12px
