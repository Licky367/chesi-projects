<!-- =========================================================
     POST FEED CARD

     FILE:
     views/update/post.ejs

     EXPECTED VARIABLES:

     item
     user

     OPTIONAL:
     type

     IMPORTANT:
     This file is designed to work with:

         feed-actions.ejs

     Therefore the required classes such as:

         .feed-card
         .like-btn
         .toggle-comments
         .delete-post
         .comment-modal
         .comment-form
         .comment-section
         .delete-comment

     MUST NOT be renamed.
========================================================= -->


<%
    /* =====================================================
       SAFE VALUES
    ====================================================== */

    const postType =
        typeof type !== "undefined" && type
            ? type
            : "post";


    const likes =
        Array.isArray(item.likes)
            ? item.likes.length
            : Number(item.likes || 0);


    const comments =
        Array.isArray(item.comments)
            ? item.comments
            : [];


    const postUserId =
        item.user
            ? String(
                item.user._id ||
                item.user
            )
            : "";


    const currentUserId =
        user && user._id
            ? String(user._id)
            : "";


    const canDeletePost =
        user &&
        (
            postUserId === currentUserId ||
            user.role === "admin"
        );
%>


<!-- =========================================================
     POST CARD
========================================================= -->

<article
    class="feed-card post-card"
    data-feed-id="<%= item._id %>"
    data-post-id="<%= item._id %>"
    data-feed-type="<%= postType %>"
>


    <!-- =====================================================
         POST HEADER
    ====================================================== -->

    <header class="post-card-header">


        <!-- =================================================
             USER AVATAR
        ================================================== -->

        <div class="post-avatar">

            <img
                src="<%= item.userImage || ('https://ui-avatars.com/api/?name=' + encodeURIComponent(item.userName || 'User')) %>"
                alt="<%= item.userName || 'User' %>"
                loading="lazy"
            >

        </div>



        <!-- =================================================
             USER INFORMATION
        ================================================== -->

        <div class="post-user-info">

            <strong class="post-user-name">

                <%= item.userName || "User" %>

            </strong>


            <span class="post-date">

                <%= item.createdAt
                    ? new Date(item.createdAt).toLocaleString()
                    : ""
                %>

            </span>

        </div>



        <!-- =================================================
             DELETE POST
        ================================================== -->

        <% if (canDeletePost) { %>

            <button
                type="button"
                class="post-menu-button delete-post"
                data-id="<%= item._id %>"
                aria-label="Delete post"
                title="Delete post"
            >

                <i class="bi bi-trash3"></i>

            </button>

        <% } %>

    </header>



    <!-- =====================================================
         POST CONTENT
    ====================================================== -->

    <div class="post-content">


        <!-- =================================================
             POST TITLE
        ================================================== -->

        <% if (
            item.title &&
            String(item.title).trim()
        ) { %>

            <h2 class="post-title">

                <%= item.title %>

            </h2>

        <% } %>



        <!-- =================================================
             POST TEXT
        ================================================== -->

        <% if (
            item.text &&
            String(item.text).trim()
        ) { %>

            <div class="post-text">

                <%= item.text %>

            </div>

        <% } %>



        <!-- =================================================
             MULTIPLE IMAGES
        ================================================== -->

        <%
            const postImages =
                Array.isArray(item.images)
                    ? item.images.filter(Boolean)
                    : [];
        %>


        <% if (postImages.length > 0) { %>


            <div
                class="
                    post-image-grid
                    post-image-count-<%= Math.min(postImages.length, 4) %>
                "
            >


                <% postImages.forEach(function(image, index) { %>

                    <div
                        class="post-image-item"
                        data-image-index="<%= index %>"
                    >

                        <img
                            src="/uploads/<%= image %>"
                            alt="Post image <%= index + 1 %>"
                            class="post-image"
                            loading="lazy"
                        >


                        <% if (
                            postImages.length > 4 &&
                            index === 3
                        ) { %>

                            <div class="post-more-images">

                                +<%= postImages.length - 4 %>

                            </div>

                        <% } %>

                    </div>

                <% }); %>


            </div>


        <% } else if (item.image) { %>


            <!-- =================================================
                 OLD SINGLE IMAGE SUPPORT
            ================================================== -->

            <div class="post-single-image">

                <img
                    src="/uploads/<%= item.image %>"
                    alt="Post image"
                    class="post-image"
                    loading="lazy"
                >

            </div>


        <% } %>


    </div>



    <!-- =====================================================
         POST ACTIONS

         IMPORTANT:

         These class names intentionally match
         feed-actions.ejs.
    ====================================================== -->

    <div
        class="feed-actions post-actions"
        data-feed-id="<%= item._id %>"
        data-feed-type="<%= postType %>"
    >


        <!-- =================================================
             LIKE
        ================================================== -->

        <button
            type="button"
            class="like-btn"
            data-id="<%= item._id %>"
            data-type="<%= postType %>"
            aria-label="Like"
        >

            <i class="bi bi-hand-thumbs-up-fill"></i>

            <span class="like-count">

                <%= likes %>

            </span>

        </button>



        <!-- =================================================
             COMMENTS
        ================================================== -->

        <button
            type="button"
            class="toggle-comments"
            aria-label="Comments"
        >

            <i class="bi bi-chat-dots-fill"></i>

            <span class="comment-count">

                <%= comments.length %>

            </span>

        </button>


    </div>



    <!-- =====================================================
         COMMENT MODAL
    ====================================================== -->

    <div
        class="comment-modal"
        aria-hidden="true"
    >


        <div class="comment-modal-content">


            <!-- =============================================
                 COMMENT MODAL HEADER
            ============================================== -->

            <header class="comment-modal-header">


                <div class="comment-modal-title">

                    <strong>
                        Comments
                    </strong>

                    <span>

                        <%= comments.length %>

                    </span>

                </div>


                <button
                    type="button"
                    class="close-comment-modal"
                    aria-label="Close comments"
                >

                    <i class="bi bi-x-lg"></i>

                </button>

            </header>



            <!-- =============================================
                 COMMENT LIST
            ============================================== -->

            <div class="comment-section">


                <% if (comments.length === 0) { %>

                    <div class="comment-empty-state">

                        <i class="bi bi-chat-dots"></i>

                        <span>
                            No comments yet.
                        </span>

                        <small>
                            Be the first to comment.
                        </small>

                    </div>

                <% } %>



                <% comments.forEach(function(comment) { %>


                    <div
                        class="comment-item"
                        data-comment-id="<%= comment._id %>"
                    >


                        <!-- =================================
                             COMMENT AVATAR
                        ================================== -->

                        <div class="comment-user-avatar">

                            <img
                                src="<%= comment.userImage || ('https://ui-avatars.com/api/?name=' + encodeURIComponent(comment.userName || 'User')) %>"
                                alt="<%= comment.userName || 'User' %>"
                                loading="lazy"
                            >

                        </div>



                        <!-- =================================
                             COMMENT CONTENT
                        ================================== -->

                        <div class="comment-content">


                            <div class="comment-top-row">


                                <strong class="comment-user-name">

                                    <%= comment.userName || "User" %>

                                </strong>


                                <%
                                    const commentUserId =
                                        comment.userId
                                            ? String(
                                                comment.userId._id ||
                                                comment.userId
                                            )
                                            : "";


                                    const canDeleteComment =
                                        user &&
                                        (
                                            commentUserId === currentUserId ||
                                            user.role === "admin"
                                        );
                                %>


                                <% if (canDeleteComment) { %>

                                    <button
                                        type="button"
                                        class="delete-comment"
                                        data-id="<%= comment._id %>"
                                        aria-label="Delete comment"
                                        title="Delete comment"
                                    >

                                        <i class="bi bi-trash3"></i>

                                    </button>

                                <% } %>


                            </div>



                            <p class="comment-text">

                                <%= comment.text %>

                            </p>



                            <small class="comment-date">

                                <%= comment.createdAt
                                    ? new Date(comment.createdAt).toLocaleString()
                                    : ""
                                %>

                            </small>


                        </div>


                    </div>


                <% }); %>


            </div>



            <!-- =============================================
                 COMMENT COMPOSER
            ============================================== -->

            <div class="comment-composer-wrapper">


                <form
                    class="comment-form"
                    data-id="<%= item._id %>"
                    data-type="<%= postType %>"
                >


                    <div class="comment-composer">


                        <div class="comment-input-wrapper">

                            <textarea
                                name="text"
                                rows="1"
                                maxlength="500"
                                placeholder="Write a comment..."
                                aria-label="Write a comment"
                            ></textarea>

                        </div>


                        <button
                            type="submit"
                            class="comment-submit-button"
                            aria-label="Send comment"
                        >

                            <i class="bi bi-send-fill"></i>

                        </button>


                    </div>


                </form>


            </div>


        </div>


    </div>


</article>



<!-- =========================================================
     POST CSS
========================================================= -->

<style>

/* =========================================================
   POST CARD
========================================================= */

.feed-card.post-card {

    width: 100%;

    box-sizing: border-box;

    background: #ffffff;

    border: 1px solid #e3eae5;

    border-radius: 16px;

    margin-bottom: 16px;

    overflow: hidden;

}



/* =========================================================
   HEADER
========================================================= */

.post-card-header {

    width: 100%;

    display: flex;

    align-items: center;

    gap: 10px;

    padding: 14px 16px;

    box-sizing: border-box;

}


.post-avatar {

    width: 42px;
    height: 42px;

    flex: 0 0 42px;

}


.post-avatar img {

    width: 42px;
    height: 42px;

    display: block;

    border-radius: 50%;

    object-fit: cover;

}


.post-user-info {

    min-width: 0;

    flex: 1;

    display: flex;

    flex-direction: column;

}


.post-user-name {

    color: #202520;

    font-size: 14px;

    line-height: 1.3;

    overflow: hidden;

    text-overflow: ellipsis;

    white-space: nowrap;

}


.post-date {

    margin-top: 3px;

    color: #89918c;

    font-size: 11px;

    line-height: 1.3;

}


.post-menu-button {

    width: 38px;
    height: 38px;

    flex: 0 0 38px;

    border: none;

    border-radius: 50%;

    background: transparent;

    color: #7c857f;

    display: flex;

    align-items: center;

    justify-content: center;

    cursor: pointer;

    font-size: 17px;

    padding: 0;

}


.post-menu-button:hover {

    background: #fff1f1;

    color: #c62828;

}



/* =========================================================
   CONTENT
========================================================= */

.post-content {

    width: 100%;

    box-sizing: border-box;

    padding: 0 16px 14px;

}


.post-title {

    margin: 0 0 9px;

    color: #18201b;

    font-size: 20px;

    font-weight: 750;

    line-height: 1.3;

    letter-spacing: -0.2px;

    word-break: break-word;

}


.post-text {

    color: #303833;

    font-size: 15px;

    line-height: 1.6;

    white-space: pre-wrap;

    word-break: break-word;

}



/* =========================================================
   SINGLE IMAGE
========================================================= */

.post-single-image {

    width: 100%;

    margin-top: 14px;

    overflow: hidden;

    border-radius: 13px;

    background: #f2f5f3;

}


.post-single-image .post-image {

    width: 100%;

    height: auto;

    max-height: 650px;

    display: block;

    object-fit: contain;

}



/* =========================================================
   IMAGE GRID
========================================================= */

.post-image-grid {

    width: 100%;

    margin-top: 14px;

    display: grid;

    grid-template-columns:
        repeat(
            2,
            minmax(0, 1fr)
        );

    gap: 4px;

    overflow: hidden;

    border-radius: 13px;

}


.post-image-item {

    position: relative;

    min-width: 0;

    aspect-ratio: 1 / 1;

    overflow: hidden;

    background: #f1f4f2;

}


.post-image {

    width: 100%;

    height: 100%;

    display: block;

    object-fit: cover;

}


.post-more-images {

    position: absolute;

    inset: 0;

    display: flex;

    align-items: center;

    justify-content: center;

    background: rgba(0, 0, 0, 0.45);

    color: #ffffff;

    font-size: 28px;

    font-weight: 700;

}



/* =========================================================
   IMAGE COUNT VARIATIONS
========================================================= */

.post-image-count-1 {

    grid-template-columns: 1fr;

}


.post-image-count-1
.post-image-item {

    aspect-ratio: auto;

}


.post-image-count-1
.post-image {

    height: auto;

    max-height: 650px;

    object-fit: contain;

}


.post-image-count-3
.post-image-item:first-child {

    grid-row: span 2;

}


.post-image-count-3 {

    grid-template-columns:
        1.35fr
        1fr;

}


.post-image-count-4 {

    grid-template-columns:
        repeat(2, 1fr);

}



/* =========================================================
   FEED ACTIONS
========================================================= */

.post-actions {

    display: flex;

    align-items: center;

    gap: 6px;

    padding: 8px 12px;

    border-top: 1px solid #edf1ee;

}


.post-actions .like-btn,
.post-actions .toggle-comments {

    min-width: 72px;

    height: 38px;

    padding: 0 11px;

    border: none;

    border-radius: 20px;

    background: transparent;

    color: #66706a;

    display: inline-flex;

    align-items: center;

    justify-content: center;

    gap: 6px;

    cursor: pointer;

    font-size: 14px;

    transition:
        background 0.15s ease,
        color 0.15s ease,
        transform 0.1s ease;

}


.post-actions .like-btn:hover,
.post-actions .toggle-comments:hover {

    background: #f0f6f2;

    color: #198754;

}


.post-actions .like-btn:active,
.post-actions .toggle-comments:active {

    transform: scale(0.96);

}


.post-actions .like-btn.liked {

    color: #198754;

    background: #edf7f1;

}


.post-actions .like-btn:disabled {

    opacity: 0.6;

    cursor: wait;

}


.post-actions i {

    font-size: 17px;

}


.like-count,
.comment-count {

    min-width: 12px;

    font-size: 13px;

    line-height: 1;

}



/* =========================================================
   COMMENT MODAL
========================================================= */

.comment-modal {

    position: fixed;

    inset: 0;

    z-index: 100000;

    display: none;

    align-items: flex-end;

    justify-content: center;

    background: rgba(0, 0, 0, 0.45);

}


.comment-modal.active {

    display: flex;

}


.comment-modal-content {

    width: 100%;

    max-width: 650px;

    max-height: 88dvh;

    display: flex;

    flex-direction: column;

    background: #ffffff;

    border-radius:
        18px
        18px
        0
        0;

    overflow: hidden;

    box-shadow:
        0 -8px 30px
        rgba(0, 0, 0, 0.18);

}



/* =========================================================
   COMMENT HEADER
========================================================= */

.comment-modal-header {

    flex: 0 0 auto;

    height: 58px;

    display: flex;

    align-items: center;

    justify-content: space-between;

    padding: 0 14px 0 18px;

    box-sizing: border-box;

    border-bottom: 1px solid #e8eee9;

}


.comment-modal-title {

    display: flex;

    align-items: center;

    gap: 7px;

}


.comment-modal-title strong {

    color: #202520;

    font-size: 16px;

}


.comment-modal-title span {

    min-width: 22px;

    height: 22px;

    padding: 0 6px;

    border-radius: 11px;

    background: #edf5ef;

    color: #198754;

    display: inline-flex;

    align-items: center;

    justify-content: center;

    font-size: 11px;

    font-weight: 700;

}


.close-comment-modal {

    width: 38px;
    height: 38px;

    border: none;

    border-radius: 50%;

    background: transparent;

    color: #68716b;

    display: flex;

    align-items: center;

    justify-content: center;

    cursor: pointer;

    font-size: 17px;

}


.close-comment-modal:hover {

    background: #f1f4f2;

    color: #202520;

}



/* =========================================================
   COMMENT SECTION
========================================================= */

.comment-section {

    flex: 1 1 auto;

    min-height: 0;

    overflow-y: auto;

    padding: 10px 15px 14px;

}


.comment-empty-state {

    min-height: 180px;

    display: flex;

    flex-direction: column;

    align-items: center;

    justify-content: center;

    text-align: center;

    color: #89918c;

}


.comment-empty-state i {

    font-size: 34px;

    margin-bottom: 10px;

    color: #aeb8b2;

}


.comment-empty-state span {

    color: #606963;

    font-size: 14px;

    font-weight: 600;

}


.comment-empty-state small {

    margin-top: 4px;

    font-size: 12px;

}



/* =========================================================
   COMMENT ITEM
========================================================= */

.comment-item {

    display: flex;

    gap: 9px;

    padding: 8px 0;

}


.comment-user-avatar {

    width: 34px;
    height: 34px;

    flex: 0 0 34px;

}


.comment-user-avatar img {

    width: 34px;
    height: 34px;

    border-radius: 50%;

    object-fit: cover;

    display: block;

}


.comment-content {

    min-width: 0;

    flex: 1;

    padding:
        8px
        10px;

    border-radius: 13px;

    background: #f5f8f6;

}


.comment-top-row {

    display: flex;

    align-items: center;

    gap: 8px;

}


.comment-user-name {

    min-width: 0;

    flex: 1;

    color: #202520;

    font-size: 12px;

    line-height: 1.3;

}


.comment-text {

    margin: 3px 0 0;

    color: #343a36;

    font-size: 13px;

    line-height: 1.45;

    white-space: pre-wrap;

    word-break: break-word;

}


.comment-date {

    display: block;

    margin-top: 5px;

    color: #8b938e;

    font-size: 10px;

}


.delete-comment {

    width: 28px;
    height: 28px;

    flex: 0 0 28px;

    border: none;

    border-radius: 50%;

    background: transparent;

    color: #969d98;

    display: flex;

    align-items: center;

    justify-content: center;

    cursor: pointer;

    padding: 0;

}


.delete-comment:hover {

    color: #c62828;

    background: #fff0f0;

}


.delete-comment:disabled {

    opacity: 0.5;

    cursor: wait;

}



/* =========================================================
   COMMENT COMPOSER
========================================================= */

.comment-composer-wrapper {

    flex: 0 0 auto;

    padding:
        9px
        12px
        calc(
            9px +
            env(safe-area-inset-bottom)
        );

    border-top: 1px solid #e8eee9;

    background: #ffffff;

}


.comment-form {

    width: 100%;

    margin: 0;

}


.comment-composer {

    min-height: 46px;

    display: flex;

    align-items: flex-end;

    gap: 6px;

    padding:
        4px
        5px
        4px
        12px;

    box-sizing: border-box;

    border: 1px solid #dce5df;

    border-radius: 24px;

    background: #f7faf8;

}


.comment-input-wrapper {

    flex: 1;

    min-width: 0;

}


.comment-input-wrapper textarea {

    width: 100%;

    min-height: 36px;

    max-height: 100px;

    resize: none;

    overflow-y: auto;

    border: none;

    outline: none;

    background: transparent;

    padding:
        9px
        0
        6px;

    margin: 0;

    box-sizing: border-box;

    font-family: inherit;

    font-size: 14px;

    line-height: 20px;

    color: #202520;

}


.comment-input-wrapper textarea::placeholder {

    color: #8b928d;

}


.comment-submit-button {

    width: 38px;
    height: 38px;

    flex: 0 0 38px;

    border: none;

    border-radius: 50%;

    background: transparent;

    color: #198754;

    display: flex;

    align-items: center;

    justify-content: center;

    cursor: pointer;

    font-size: 17px;

}


.comment-submit-button:hover {

    background: #e9f5ed;

    color: #146c43;

}


.comment-submit-button:active {

    transform: scale(0.94);

}


.comment-submit-button:disabled {

    opacity: 0.5;

    cursor: wait;

}



/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 600px) {

    .feed-card.post-card {

        border-radius: 13px;

        margin-bottom: 12px;

    }


    .post-card-header {

        padding: 12px;

    }


    .post-content {

        padding:
            0
            12px
            12px;

    }


    .post-title {

        font-size: 18px;

    }


    .post-text {

        font-size: 14px;

        line-height: 1.55;

    }


    .post-actions {

        padding:
            7px
            9px;

    }


    .post-actions .like-btn,
    .post-actions .toggle-comments {

        min-width: 66px;

        height: 36px;

    }


    .comment-modal-content {

        max-height: 92dvh;

        border-radius:
            16px
            16px
            0
            0;

    }


    .comment-section {

        padding:
            8px
            12px
            12px;

    }

}



/* =========================================================
   SMALL PHONES
========================================================= */

@media (max-width: 380px) {

    .post-title {

        font-size: 17px;

    }


    .post-image-grid {

        gap: 3px;

    }


    .post-actions .like-btn,
    .post-actions .toggle-comments {

        min-width: 60px;

        padding:
            0
            8px;

    }

}

</style>