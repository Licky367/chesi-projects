<!-- =========================================================
     POST FEED CARD

     FILE:
     views/update/post.ejs

     PURPOSE:
     ---------------------------------------------------------
     Facebook-style compact post card.

     STRUCTURE:
     ---------------------------------------------------------

         HEADER
         ├── User avatar
         ├── User name about Dairy
         └── Date and time

         MESSAGE
         ├── Title (if available)
         ├── Paragraph text
         ├── See more
         └── Images

         FOOTER
         ├── Like
         └── Comment

     IMPORTANT:
     ---------------------------------------------------------
     - Dairy belongs in the HEADER.
     - Message starts immediately below HEADER.
     - Message is left aligned.
     - No artificial vertical spacing.
     - See more follows the truncated text immediately.
========================================================= -->


<%
/* =========================================================
   SAFE VALUES
========================================================= */

const postType =
    typeof type !== "undefined" && type
        ? type
        : "post";


/* =========================================================
   LIKES
========================================================= */

const likes =
    Array.isArray(item.likes)
        ? item.likes.length
        : Number(item.likes || 0);


/* =========================================================
   COMMENTS
========================================================= */

const comments =
    Array.isArray(item.comments)
        ? item.comments
        : [];


/* =========================================================
   USER IDS
========================================================= */

const postUserId =
    item.user
        ? String(
            item.user._id ||
            item.user
        )
        : "";


const currentUserId =
    user && user._id
        ? String(user._id)
        : "";


/* =========================================================
   DELETE PERMISSION
========================================================= */

const canDeletePost =
    user &&
    (
        postUserId === currentUserId ||
        user.role === "admin"
    );


/* =========================================================
   POST TEXT
========================================================= */

const fullPostText =
    item.text
        ? String(item.text).trim()
        : "";


/* =========================================================
   LONG TEXT
========================================================= */

const isLongPost =
    fullPostText.length > 100;


/* =========================================================
   TEXT PREVIEW
========================================================= */

const postPreview =
    isLongPost
        ? fullPostText.substring(0, 100).trimEnd() + "…"
        : fullPostText;


/* =========================================================
   POST IMAGES
========================================================= */

const postImages =
    Array.isArray(item.images)
        ? item.images.filter(Boolean)
        : (
            item.image
                ? [item.image]
                : []
        );


const visibleImages =
    postImages.slice(0, 4);


const additionalImages =
    Math.max(
        0,
        postImages.length - 4
    );


/* =========================================================
   DAIRY / FARM
========================================================= */

const dairyId =
    item.dairyId ||
    (
        item.dairy &&
        (
            item.dairy._id ||
            item.dairy
        )
    ) ||
    "";


const dairyName =
    item.dairyName ||
    (
        item.dairy &&
        item.dairy.name
    ) ||
    "";


/* =========================================================
   USER NAME
========================================================= */

const userName =
    item.userName ||
    "User";


/* =========================================================
   DATE
========================================================= */

const postDate =
    item.createdAt
        ? new Date(item.createdAt).toLocaleString()
        : (
            item.dateText ||
            ""
        );

%>



<!-- =========================================================
     POST CARD
========================================================= -->

<article
    class="feed-card post-card"
    data-feed-id="<%= item._id %>"
    data-post-id="<%= item._id %>"
    data-feed-type="<%= postType %>"
>


    <!-- =====================================================
         HEADER
    ====================================================== -->

    <header class="post-card-header">

        <!-- AVATAR -->

        <div class="post-avatar">

            <img
                src="<%= item.userImage || ('https://ui-avatars.com/api/?name=' + encodeURIComponent(userName)) %>"
                alt="<%= userName %>"
                loading="lazy"
            >

        </div>


        <!-- USER / DAIRY / DATE -->

        <div class="post-header-info">

            <div class="post-header-main">

                <strong class="post-user-name">
                    <%= userName %>
                </strong>

                <% if (dairyName) { %>

                    <span class="post-about">
                        about
                    </span>

                    <% if (dairyId) { %>

                        <a
                            href="/dairy/<%= dairyId %>"
                            class="post-header-dairy"
                            title="View <%= dairyName %>"
                        >
                            <%= dairyName %>
                        </a>

                    <% } else { %>

                        <span class="post-header-dairy">
                            <%= dairyName %>
                        </span>

                    <% } %>

                <% } %>

            </div>


            <span class="post-date">
                <%= postDate %>
            </span>

        </div>


        <!-- DELETE -->

        <% if (canDeletePost) { %>

            <button
                type="button"
                class="post-menu-button delete-post"
                data-id="<%= item._id %>"
                data-type="post"
                aria-label="Delete post"
                title="Delete post"
            >

                <i
                    class="bi bi-trash3"
                    aria-hidden="true"
                ></i>

            </button>

        <% } %>

    </header>



    <!-- =====================================================
         MESSAGE AREA
    ====================================================== -->

    <div class="post-content">


        <!-- =================================================
             TITLE
        ================================================== -->

        <% if (
            item.title &&
            String(item.title).trim()
        ) { %>

            <h2 class="post-title">
                <%= item.title %>
            </h2>

        <% } %>



        <!-- =================================================
             MESSAGE

             IMPORTANT:
             -------------------------------------------------
             The preview and See More remain in the SAME
             natural text flow.

             There is no separate block containing See More
             that can create a vertical gap.
        ================================================== -->

        <% if (fullPostText) { %>

            <div class="post-text-area">

                <% if (isLongPost) { %>

                    <p class="post-text post-text-preview">

                        <%= postPreview %>

                        <button
                            type="button"
                            class="post-see-more"
                            data-post-expand="<%= item._id %>"
                        >
                            See more
                            <i
                                class="bi bi-arrow-right"
                                aria-hidden="true"
                            ></i>
                        </button>

                    </p>

                <% } else { %>

                    <p class="post-text">
                        <%= fullPostText %>
                    </p>

                <% } %>

            </div>

        <% } %>



        <!-- =================================================
             IMAGE GRID
        ================================================== -->

        <% if (visibleImages.length > 0) { %>

            <div
                class="post-image-grid post-image-count-<%= visibleImages.length %>"
                data-photo-count="<%= postImages.length %>"
            >

                <% visibleImages.forEach(function(image, index) { %>

                    <button
                        type="button"
                        class="post-image-item"
                        data-photo-index="<%= index %>"
                        aria-label="Open photo <%= index + 1 %>"
                    >

                        <img
                            src="/uploads/<%= image %>"
                            alt="Post photo <%= index + 1 %>"
                            class="post-image"
                            loading="lazy"
                        >


                        <% if (
                            index === 3 &&
                            additionalImages > 0
                        ) { %>

                            <span class="post-more-images">

                                <i
                                    class="bi bi-images"
                                    aria-hidden="true"
                                ></i>

                                <strong>
                                    +<%= additionalImages %>
                                </strong>

                            </span>

                        <% } %>

                    </button>

                <% }); %>

            </div>

        <% } %>

    </div>



    <!-- =====================================================
         FOOTER / ACTIONS
    ====================================================== -->

    <footer
        class="feed-actions post-actions"
        data-feed-id="<%= item._id %>"
        data-feed-type="<%= postType %>"
    >

        <button
            type="button"
            class="like-btn"
            data-id="<%= item._id %>"
            data-type="<%= postType %>"
            aria-label="Like"
        >

            <i
                class="bi bi-hand-thumbs-up-fill"
                aria-hidden="true"
            ></i>

            <span class="like-count">
                <%= likes %>
            </span>

        </button>


        <button
            type="button"
            class="toggle-comments"
            aria-label="Comments"
        >

            <i
                class="bi bi-chat-dots-fill"
                aria-hidden="true"
            ></i>

            <span class="comment-count">
                <%= comments.length %>
            </span>

        </button>

    </footer>



    <!-- =====================================================
         EXPANDED POST
    ====================================================== -->

    <% if (isLongPost) { %>

        <div
            class="post-expand-modal"
            data-post-expand-modal="<%= item._id %>"
            aria-hidden="true"
        >

            <div
                class="post-expand-backdrop"
                data-close-post-expand
            ></div>


            <div
                class="post-expand-card"
                role="dialog"
                aria-modal="true"
                aria-label="Expanded post"
            >

                <header class="post-expand-header">

                    <div class="post-expand-user">

                        <img
                            src="<%= item.userImage || ('https://ui-avatars.com/api/?name=' + encodeURIComponent(userName)) %>"
                            alt="<%= userName %>"
                            loading="lazy"
                        >

                        <div>

                            <strong>
                                <%= userName %>
                            </strong>

                            <small>
                                <%= postDate %>
                            </small>

                        </div>

                    </div>


                    <button
                        type="button"
                        class="post-expand-close"
                        data-close-post-expand
                        aria-label="Close post"
                    >

                        <i
                            class="bi bi-x-lg"
                            aria-hidden="true"
                        ></i>

                    </button>

                </header>


                <div class="post-expand-body">

                    <% if (dairyName) { %>

                        <% if (dairyId) { %>

                            <a
                                href="/dairy/<%= dairyId %>"
                                class="post-dairy-link expanded-dairy-link"
                            >

                                <i
                                    class="bi bi-building"
                                    aria-hidden="true"
                                ></i>

                                <span>
                                    <%= dairyName %>
                                </span>

                            </a>

                        <% } else { %>

                            <div class="post-dairy-link expanded-dairy-link">

                                <i
                                    class="bi bi-building"
                                    aria-hidden="true"
                                ></i>

                                <span>
                                    <%= dairyName %>
                                </span>

                            </div>

                        <% } %>

                    <% } %>


                    <% if (
                        item.title &&
                        String(item.title).trim()
                    ) { %>

                        <h2 class="post-expand-title">
                            <%= item.title %>
                        </h2>

                    <% } %>


                    <div class="post-expand-text">
                        <%= fullPostText %>
                    </div>


                    <% if (postImages.length > 0) { %>

                        <div class="post-expand-images">

                            <% postImages.forEach(function(image, index) { %>

                                <button
                                    type="button"
                                    class="post-expand-image"
                                    data-photo-index="<%= index %>"
                                >

                                    <img
                                        src="/uploads/<%= image %>"
                                        alt="Post photo <%= index + 1 %>"
                                        loading="lazy"
                                    >

                                </button>

                            <% }); %>

                        </div>

                    <% } %>

                </div>

            </div>

        </div>

    <% } %>



    <!-- =====================================================
         FULL SCREEN PHOTO VIEWER
    ====================================================== -->

    <% if (postImages.length > 0) { %>

        <div
            class="post-photo-viewer"
            data-photo-viewer="<%= item._id %>"
            aria-hidden="true"
        >

            <div
                class="photo-viewer-backdrop"
                data-close-photo-viewer
            ></div>


            <div class="photo-viewer-topbar">

                <span class="photo-viewer-counter">

                    <span class="photo-current">
                        1
                    </span>

                    /

                    <span>
                        <%= postImages.length %>
                    </span>

                </span>


                <button
                    type="button"
                    class="photo-viewer-close"
                    data-close-photo-viewer
                    aria-label="Close photo viewer"
                >

                    <i
                        class="bi bi-x-lg"
                        aria-hidden="true"
                    ></i>

                </button>

            </div>


            <% if (postImages.length > 1) { %>

                <button
                    type="button"
                    class="photo-viewer-nav photo-viewer-prev"
                    data-photo-prev
                    aria-label="Previous photo"
                >

                    <i
                        class="bi bi-chevron-left"
                        aria-hidden="true"
                    ></i>

                </button>

            <% } %>


            <div class="photo-viewer-stage">

                <img
                    class="photo-viewer-image"
                    src="/uploads/<%= postImages[0] %>"
                    alt="Post photo"
                >

            </div>


            <% if (postImages.length > 1) { %>

                <button
                    type="button"
                    class="photo-viewer-nav photo-viewer-next"
                    data-photo-next
                    aria-label="Next photo"
                >

                    <i
                        class="bi bi-chevron-right"
                        aria-hidden="true"
                    ></i>

                </button>

            <% } %>

        </div>

    <% } %>



    <!-- =====================================================
         COMMENT MODAL
    ====================================================== -->

    <div
        class="comment-modal"
        aria-hidden="true"
    >

        <div class="comment-modal-content">

            <header class="comment-modal-header">

                <div class="comment-modal-title">

                    <strong>
                        Comments
                    </strong>

                    <span>
                        <%= comments.length %>
                    </span>

                </div>


                <button
                    type="button"
                    class="close-comment-modal"
                    aria-label="Close comments"
                >

                    <i
                        class="bi bi-x-lg"
                        aria-hidden="true"
                    ></i>

                </button>

            </header>


            <div class="comment-section">

                <% if (comments.length === 0) { %>

                    <div class="comment-empty-state">

                        <i class="bi bi-chat-dots"></i>

                        <span>
                            No comments yet.
                        </span>

                        <small>
                            Be the first to comment.
                        </small>

                    </div>

                <% } %>


                <% comments.forEach(function(comment) { %>

                    <div
                        class="comment-item"
                        data-comment-id="<%= comment._id %>"
                    >

                        <div class="comment-user-avatar">

                            <img
                                src="<%= comment.userImage || ('https://ui-avatars.com/api/?name=' + encodeURIComponent(comment.userName || 'User')) %>"
                                alt="<%= comment.userName || 'User' %>"
                                loading="lazy"
                            >

                        </div>


                        <div class="comment-content">

                            <div class="comment-top-row">

                                <strong class="comment-user-name">
                                    <%= comment.userName || "User" %>
                                </strong>


                                <%
                                    const commentUserId =
                                        comment.userId
                                            ? String(
                                                comment.userId._id ||
                                                comment.userId
                                            )
                                            : "";


                                    const canDeleteComment =
                                        user &&
                                        (
                                            commentUserId === currentUserId ||
                                            user.role === "admin"
                                        );
                                %>


                                <% if (canDeleteComment) { %>

                                    <button
                                        type="button"
                                        class="delete-comment"
                                        data-id="<%= comment._id %>"
                                        aria-label="Delete comment"
                                        title="Delete comment"
                                    >

                                        <i
                                            class="bi bi-trash3"
                                            aria-hidden="true"
                                        ></i>

                                    </button>

                                <% } %>

                            </div>


                            <p class="comment-text">
                                <%= comment.text %>
                            </p>


                            <small class="comment-date">

                                <%= comment.createdAt
                                    ? new Date(comment.createdAt).toLocaleString()
                                    : ""
                                %>

                            </small>

                        </div>

                    </div>

                <% }); %>

            </div>


            <div class="comment-composer-wrapper">

                <form
                    class="comment-form"
                    data-id="<%= item._id %>"
                    data-type="<%= postType %>"
                >

                    <div class="comment-composer">

                        <div class="comment-input-wrapper">

                            <textarea
                                name="text"
                                rows="1"
                                maxlength="500"
                                placeholder="Write a comment..."
                                aria-label="Write a comment"
                            ></textarea>

                        </div>


                        <button
                            type="submit"
                            class="comment-submit-button"
                            aria-label="Send comment"
                        >

                            <i class="bi bi-send-fill"></i>

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</article>



<!-- =========================================================
     POST CSS
========================================================= -->

<style>

/* =========================================================
   CARD
========================================================= */

.feed-card.post-card {

    width: 100%;
    box-sizing: border-box;

    margin: 0 0 14px;
    padding: 0;

    background: #ffffff;

    border: 1px solid #dfe8e2;
    border-radius: 18px;

    overflow: hidden;

    box-shadow:
        0 2px 8px rgba(24,42,30,0.045);

}



/* =========================================================
   HEADER
========================================================= */

.post-card-header {

    width: 100%;

    min-height: 62px;

    box-sizing: border-box;

    padding: 10px 14px;

    display: flex;

    align-items: center;

    gap: 10px;

    border-bottom: 1px solid #e2e9e4;

    background: #ffffff;

}


.post-avatar {

    width: 44px;
    height: 44px;

    flex: 0 0 44px;

}


.post-avatar img {

    display: block;

    width: 44px;
    height: 44px;

    object-fit: cover;

    border-radius: 50%;

    border: 2px solid #edf5ef;

}


.post-header-info {

    flex: 1;

    min-width: 0;

}


.post-header-main {

    width: 100%;

    min-width: 0;

    display: flex;

    align-items: baseline;

    flex-wrap: wrap;

    column-gap: 5px;

    row-gap: 1px;

    line-height: 1.25;

}


.post-user-name {

    color: #172019;

    font-size: 14px;

    font-weight: 700;

    line-height: 1.25;

}


.post-about {

    color: #7c867f;

    font-size: 12px;

    font-weight: 400;

}


.post-header-dairy {

    min-width: 0;

    max-width: 100%;

    color: #198754;

    font-size: 13px;

    font-weight: 700;

    text-decoration: none;

    overflow-wrap: anywhere;

}


a.post-header-dairy:hover {

    color: #146c43;

    text-decoration: underline;

}


.post-date {

    display: block;

    margin-top: 2px;

    color: #89928c;

    font-size: 11px;

    line-height: 1.2;

}


.post-menu-button {

    width: 36px;
    height: 36px;

    flex: 0 0 36px;

    margin: 0;
    padding: 0;

    border: none;
    border-radius: 50%;

    background: transparent;

    color: #7c867f;

    display: flex;

    align-items: center;
    justify-content: center;

    cursor: pointer;

    font-size: 17px;

}


.post-menu-button:hover {

    color: #c62828;

    background: #fff1f1;

}



/* =========================================================
   MESSAGE / CONTENT

   IMPORTANT:
   ---------------------------------------------------------
   This area is a normal block flow.

   There is NO:
   - flex centering
   - fixed height
   - min-height
   - vertical justification
   - artificial top gap
========================================================= */

.post-content {

    width: 100%;

    height: auto !important;

    min-height: 0 !important;

    box-sizing: border-box;

    display: block !important;

    padding: 12px 14px 12px !important;

    margin: 0 !important;

    overflow: visible !important;

}


.post-content > * {

    box-sizing: border-box;

}



/* =========================================================
   TITLE
========================================================= */

.post-title {

    display: block;

    margin: 0 0 6px !important;

    padding: 0 !important;

    color: #18201b;

    font-size: 20px;

    font-weight: 800;

    line-height: 1.25;

    letter-spacing: -0.25px;

    text-align: left;

    word-break: break-word;

}



/* =========================================================
   TEXT AREA
========================================================= */

.post-text-area {

    display: block !important;

    width: 100%;

    height: auto !important;

    min-height: 0 !important;

    margin: 0 !important;

    padding: 0 !important;

    overflow: visible !important;

}



/* =========================================================
   PARAGRAPH

   THIS IS THE IMPORTANT FIX.

   The post is treated as a real block paragraph.

   There is:
   - NO top margin
   - NO bottom margin
   - NO padding
   - NO flex
   - NO vertical centering
========================================================= */

.post-text {

    display: block !important;

    width: 100%;

    height: auto !important;

    min-height: 0 !important;

    margin: 0 !important;

    padding: 0 !important;

    color: #303833;

    font-size: 15px;

    font-weight: 400;

    line-height: 1.5;

    text-align: left;

    white-space: pre-wrap;

    word-break: break-word;

    overflow-wrap: anywhere;

    vertical-align: top;

}



/* =========================================================
   SEE MORE

   IMPORTANT:
   ---------------------------------------------------------
   This button is INLINE with the paragraph.

   Therefore:

       "...truncated word… See more →"

   remains in the SAME natural text flow.

   There is no separate block creating a huge gap.
========================================================= */

.post-see-more {

    display: inline;

    width: auto;

    height: auto;

    margin: 0 0 0 4px !important;

    padding: 0 !important;

    border: none;

    outline: none;

    background: transparent;

    color: #198754;

    font-family: inherit;

    font-size: 14px;

    font-weight: 700;

    line-height: inherit;

    white-space: nowrap;

    vertical-align: baseline;

    cursor: pointer;

}


.post-see-more i {

    display: inline-block;

    margin-left: 2px;

    font-size: 11px;

    vertical-align: baseline;

}


.post-see-more:hover {

    color: #146c43;

}



/* =========================================================
   IMAGE GRID
========================================================= */

.post-image-grid {

    width: 100%;

    height: auto;

    margin: 10px 0 0 !important;

    padding: 0;

    display: grid;

    grid-template-columns:
        repeat(2, minmax(0, 1fr));

    gap: 3px;

    overflow: hidden;

    border-radius: 13px;

    background: #f0f3f1;

}


.post-image-item {

    position: relative;

    display: block;

    width: 100%;

    min-width: 0;

    aspect-ratio: 1 / 1;

    margin: 0;
    padding: 0;

    border: none;

    background: #eef2ef;

    overflow: hidden;

    cursor: pointer;

}


.post-image-item::after {

    content: "";

    position: absolute;

    inset: 0;

    background: rgba(0,0,0,0);

    transition: background 0.15s ease;

}


.post-image-item:hover::after {

    background: rgba(0,0,0,0.08);

}


.post-image {

    width: 100%;
    height: 100%;

    display: block;

    object-fit: cover;

}



/* =========================================================
   ONE IMAGE
========================================================= */

.post-image-count-1 {

    grid-template-columns: 1fr;

}


.post-image-count-1 .post-image-item {

    aspect-ratio: auto;

    max-height: 650px;

}


.post-image-count-1 .post-image {

    height: auto;

    max-height: 650px;

    object-fit: contain;

}



/* =========================================================
   THREE IMAGES
========================================================= */

.post-image-count-3 {

    grid-template-columns:
        1.35fr
        1fr;

}


.post-image-count-3 .post-image-item:first-child {

    grid-row: span 2;

}



/* =========================================================
   MORE IMAGES
========================================================= */

.post-more-images {

    position: absolute;

    inset: 0;

    z-index: 3;

    display: flex;

    align-items: center;

    justify-content: center;

    gap: 7px;

    background: rgba(0,0,0,0.43);

    color: #ffffff;

    font-size: 18px;

    font-weight: 700;

    pointer-events: none;

}


.post-more-images i {

    font-size: 20px;

}


.post-more-images strong {

    font-size: 20px;

}



/* =========================================================
   FOOTER / ACTIONS

   Clear border separating message from actions.
========================================================= */

.post-actions {

    width: 100%;

    min-height: 47px;

    box-sizing: border-box;

    display: flex;

    align-items: center;

    gap: 4px;

    margin: 0;

    padding: 5px 10px;

    border-top: 1px solid #dfe7e2;

    background: #ffffff;

}


.post-actions .like-btn,
.post-actions .toggle-comments {

    min-width: 70px;

    height: 36px;

    margin: 0;

    padding: 0 11px;

