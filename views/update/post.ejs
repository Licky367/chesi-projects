<!-- =======================================================
     POST
     FILE:
     views/dairy/update/post.ejs
======================================================= -->


<%
    /* =====================================================
       POST PHOTOS
       -----------------------------------------------------
       Multiple images:
           item.images

       Single-image fallback:
           item.image
    ====================================================== */

    let postPhotos = [];


    if (Array.isArray(item.images)) {

        postPhotos = item.images;

    } else if (item.image) {

        postPhotos = [item.image];

    }


    const photoCount =
        postPhotos.length;


    /* =====================================================
       POST OWNER
    ====================================================== */

    const authorName =
        item.userName || "User";


    const authorImage =
        item.userImage ||
        (
            "https://ui-avatars.com/api/?name=" +
            encodeURIComponent(
                item.userName || "User"
            )
        );
%>


<article
    class="feed-card post-card"
    data-id="<%= item._id %>"
    data-type="post"
>


    <!-- =================================================
         HEADER
    ================================================== -->

    <div class="feed-header">


        <!-- =================================================
             POST OWNER + SUBJECT
        ================================================== -->

        <div class="feed-user">


            <img
                src="<%= item.userImage || ('https://ui-avatars.com/api/?name=' + encodeURIComponent(item.userName || 'User')) %>"
                alt="<%= item.userName || 'User' %>"
                class="avatar-sm"
                loading="lazy"
                onerror="this.src='https://ui-avatars.com/api/?name=User'"
            >


            <div class="feed-user-info">


                <!-- =============================================
                     POST META
                ============================================== -->

                <div class="post-meta-line">


                    <strong class="post-user-name">

                        <%= item.userName || "User" %>

                    </strong>


                    <% if (
                        item.dairyName &&
                        item.dairyId
                    ) { %>

                        <span class="post-meta-action">
                            updated about
                        </span>


                        <a
                            href="/dairy/<%= item.dairyId %>"
                            class="post-subject"
                            title="View <%= item.dairyName %>"
                        >

                            <%= item.dairyName %>

                        </a>

                    <% } %>


                </div>


                <!-- =============================================
                     POST DATE / TIME
                ============================================== -->

                <small class="post-time">

                    <%= item.dateText %>

                </small>


            </div>

        </div>



        <!-- =================================================
             DELETE POST
        ================================================== -->

        <% if (
            user &&
            (
                user.role === "admin" ||
                (
                    user._id &&
                    item.userId &&
                    user._id.toString() ===
                    item.userId.toString()
                )
            )
        ) { %>

            <button
                class="delete-post"
                data-id="<%= item._id %>"
                title="Delete Post"
                aria-label="Delete Post"
                type="button"
            >

                <i
                    class="bi bi-trash3-fill"
                    aria-hidden="true"
                ></i>

            </button>

        <% } %>


    </div>



    <!-- =================================================
         BODY
         -------------------------------------------------
         IMPORTANT:
         No fixed height.
         No vertical centering.
         The body grows according to the content.
    ================================================== -->

    <div class="feed-body post-body">


        <!-- =============================================
             TITLE
        ============================================== -->

        <% if (item.title) { %>

            <h3 class="post-title">

                <%= item.title %>

            </h3>

        <% } %>



        <!-- =============================================
             TEXT
             ------------------------------------------------
             The CSS should limit this to 5 lines.

             The full text is NOT altered here.
             post.js can use the full text when opening
             the "See more" modal.
        ============================================== -->

        <% if (
            item.text &&
            String(item.text).trim()
        ) { %>


            <div
                class="post-text-wrapper"
                data-post-text-wrapper="<%= item._id %>"
            >


                <p
                    class="post-text post-text-preview"
                    data-post-text="<%= item._id %>"
                >

                    <%= item.text %>

                </p>


                <!-- =========================================
                     SEE MORE
                     ------------------------------------------------
                     Hidden by default.

                     JavaScript should display this only when
                     the text actually exceeds the five-line
                     preview.
                ========================================== -->

                <button
                    type="button"
                    class="post-see-more"
                    data-action="see-more"
                    data-post-id="<%= item._id %>"
                    hidden
                >

                    See more

                </button>


            </div>


        <% } %>



        <!-- =================================================
             PHOTO GALLERY
        ================================================== -->

        <% if (photoCount > 0) { %>


            <div
                class="
                    post-gallery
                    post-gallery-count-<%= Math.min(photoCount, 5) %>
                "
                data-gallery="<%= item._id %>"
            >


                <!-- =========================================
                     ONE PHOTO
                ========================================== -->

                <% if (photoCount === 1) { %>

                    <button
                        type="button"
                        class="
                            post-photo
                            post-photo-single
                        "
                        data-photo-index="0"
                        data-gallery-id="<%= item._id %>"
                        aria-label="View photo"
                    >

                        <img
                            src="/uploads/<%= postPhotos[0] %>"
                            alt="Post image"
                            class="feed-img post-image"
                            loading="lazy"
                        >

                    </button>

                <% } %>



                <!-- =========================================
                     TWO PHOTOS
                ========================================== -->

                <% if (photoCount === 2) { %>

                    <% postPhotos.forEach(
                        (photo, index) => {
                    %>

                        <button
                            type="button"
                            class="post-photo"
                            data-photo-index="<%= index %>"
                            data-gallery-id="<%= item._id %>"
                            aria-label="View photo <%= index + 1 %>"
                        >

                            <img
                                src="/uploads/<%= photo %>"
                                alt="Post image <%= index + 1 %>"
                                class="feed-img post-image"
                                loading="lazy"
                            >

                        </button>

                    <% }) %>

                <% } %>



                <!-- =========================================
                     THREE PHOTOS
                ========================================== -->

                <% if (photoCount === 3) { %>


                    <button
                        type="button"
                        class="post-photo post-photo-large"
                        data-photo-index="0"
                        data-gallery-id="<%= item._id %>"
                        aria-label="View photo 1"
                    >

                        <img
                            src="/uploads/<%= postPhotos[0] %>"
                            alt="Post image 1"
                            class="feed-img post-image"
                            loading="lazy"
                        >

                    </button>


                    <div class="post-gallery-side">


                        <button
                            type="button"
                            class="post-photo"
                            data-photo-index="1"
                            data-gallery-id="<%= item._id %>"
                            aria-label="View photo 2"
                        >

                            <img
                                src="/uploads/<%= postPhotos[1] %>"
                                alt="Post image 2"
                                class="feed-img post-image"
                                loading="lazy"
                            >

                        </button>


                        <button
                            type="button"
                            class="post-photo"
                            data-photo-index="2"
                            data-gallery-id="<%= item._id %>"
                            aria-label="View photo 3"
                        >

                            <img
                                src="/uploads/<%= postPhotos[2] %>"
                                alt="Post image 3"
                                class="feed-img post-image"
                                loading="lazy"
                            >

                        </button>


                    </div>


                <% } %>



                <!-- =========================================
                     FOUR PHOTOS
                ========================================== -->

                <% if (photoCount === 4) { %>

                    <% postPhotos.forEach(
                        (photo, index) => {
                    %>

                        <button
                            type="button"
                            class="post-photo"
                            data-photo-index="<%= index %>"
                            data-gallery-id="<%= item._id %>"
                            aria-label="View photo <%= index + 1 %>"
                        >

                            <img
                                src="/uploads/<%= photo %>"
                                alt="Post image <%= index + 1 %>"
                                class="feed-img post-image"
                                loading="lazy"
                            >

                        </button>

                    <% }) %>

                <% } %>



                <!-- =========================================
                     FIVE OR MORE PHOTOS
                ========================================== -->

                <% if (photoCount >= 5) { %>

                    <% postPhotos
                        .slice(0, 5)
                        .forEach(
                            (photo, index) => {
                    %>

                        <button
                            type="button"
                            class="
                                post-photo
                                <%= index === 4
                                    ? 'post-photo-more'
                                    : ''
                                %>
                            "
                            data-photo-index="<%= index %>"
                            data-gallery-id="<%= item._id %>"
                            aria-label="View photo <%= index + 1 %>"
                        >

                            <img
                                src="/uploads/<%= photo %>"
                                alt="Post image <%= index + 1 %>"
                                class="feed-img post-image"
                                loading="lazy"
                            >


                            <% if (index === 4) { %>

                                <span
                                    class="
                                        post-photo-more-overlay
                                    "
                                >

                                    +<%= photoCount - 4 %>

                                </span>

                            <% } %>


                        </button>

                    <% }) %>

                <% } %>


            </div>


        <% } %>


    </div>



    <!-- =================================================
         EXISTING ACTIONS
         -------------------------------------------------
         IMPORTANT:
         No like/comment counts are added here.
         Your existing partial remains the owner of the
         action area.
    ================================================== -->

    <%- include("partials/feed-actions", {
        item,
        type: "post"
    }) %>



    <!-- =================================================
         EXISTING COMMENTS
    ================================================== -->

    <%- include("comment-section", {
        item,
        user,
        type: "post"
    }) %>


</article>



<!-- =========================================================
     FULL POST / SEE MORE MODAL
     ---------------------------------------------------------
     This is opened when "See more" is tapped.

     The complete message is displayed here.
========================================================= -->

<div
    class="post-full-viewer"
    id="postFullViewer-<%= item._id %>"
    data-post-viewer="<%= item._id %>"
    hidden
    aria-hidden="true"
>


    <!-- =================================================
         BACKDROP
    ================================================== -->

    <div
        class="post-full-viewer-backdrop"
        data-post-viewer-close
    ></div>



    <!-- =================================================
         MODAL
    ================================================== -->

    <div
        class="post-full-viewer-card"
        role="dialog"
        aria-modal="true"
        aria-label="Full post"
    >


        <!-- =================================================
             MODAL HEADER
        ================================================== -->

        <div class="post-full-viewer-header">


            <div class="feed-user">


                <img
                    src="<%= authorImage %>"
                    alt="<%= authorName %>"
                    class="avatar-sm"
                    loading="lazy"
                >


                <div class="feed-user-info">


                    <strong class="post-user-name">

                        <%= authorName %>

                    </strong>


                    <small class="post-time">

                        <%= item.dateText %>

                    </small>


                </div>


            </div>


            <button
                type="button"
                class="post-full-viewer-close"
                data-post-viewer-close
                aria-label="Close post"
            >

                <i class="bi bi-x-lg"></i>

            </button>


        </div>



        <!-- =================================================
             FULL TITLE
        ================================================== -->

        <% if (item.title) { %>

            <div class="post-full-viewer-title">

                <%= item.title %>

            </div>

        <% } %>



        <!-- =================================================
             FULL TEXT
        ================================================== -->

        <div class="post-full-viewer-text">

            <%= item.text %>

        </div>


    </div>

</div>



<!-- =========================================================
     PHOTO DATA
     ---------------------------------------------------------
     Used by the existing/new gallery JavaScript.
========================================================= -->

<script
    type="application/json"
    class="post-gallery-data"
    data-gallery-data="<%= item._id %>"
>
    <%- JSON.stringify(postPhotos) %>
</script>