<!-- =========================================================
     SELF-CONTAINED JAVASCRIPT

     IMPORTANT:
     ---------------------------------------------------------
     This script uses the same backend routes as
     feed-actions.ejs.

     It is initialized ONLY ONCE.
========================================================= -->

<script>

(function () {

    "use strict";


    /* =====================================================
       INITIALIZATION GUARD
    ===================================================== */

    if (
        window.__corevesterCpostActionsInitialized
    ) {

        return;

    }


    window.__corevesterCpostActionsInitialized =
        true;



    /* =====================================================
       BODY LOCK
    ===================================================== */

    function cpostLockBody() {

        document.body.style.overflow = "hidden";

    }


    function cpostUnlockBody() {

        if (
            !document.querySelector(
                ".cpost-expand.cpost-is-active"
            ) &&
            !document.querySelector(
                ".cpost-viewer.cpost-is-active"
            ) &&
            !document.querySelector(
                ".cpost-comment-modal.cpost-is-active"
            )
        ) {

            document.body.style.overflow = "";

        }

    }



    /* =====================================================
       MESSAGE
    ===================================================== */

    function cpostMessage(message) {

        if (
            typeof window.showMessage ===
            "function"
        ) {

            window.showMessage(message);

            return;

        }


        window.alert(message);

    }



    /* =====================================================
       RESPONSE PARSER
       -----------------------------------------------------
       Protects against HTML responses when the server
       redirects instead of returning JSON.
    ===================================================== */

    async function cpostReadResponse(response) {

        const contentType =
            response.headers.get(
                "content-type"
            ) || "";


        if (
            contentType.includes(
                "application/json"
            )
        ) {

            return await response.json();

        }


        const text =
            await response.text();


        return {

            success:
                response.ok,

            message:
                text ||
                `Request failed (${response.status})`

        };

    }



    /* =====================================================
       GET CARD
    ===================================================== */

    function cpostGetCard(element) {

        if (!element) {

            return null;

        }


        return element.closest(
            ".cpost-card"
        );

    }



    /* =====================================================
       LIKE
    ===================================================== */

    async function cpostLike(button) {

        const card =
            cpostGetCard(button);


        if (!card) {

            return;

        }


        const id =
            card.dataset.cpostId;


        const type =
            card.dataset.cpostType ||
            "post";


        if (!id) {

            cpostMessage(
                "Unable to identify this post."
            );

            return;

        }


        if (button.disabled) {

            return;

        }


        button.disabled = true;


        /*
         * IMPORTANT:
         *
         * Your feed-actions.ejs confirms that
         * post likes use:
         *
         * POST /post/:id/like
         */

        const url =
            type === "post"
                ? `/post/${encodeURIComponent(id)}/like`
                : `/${encodeURIComponent(type)}/${encodeURIComponent(id)}/like`;


        try {

            const response =
                await fetch(
                    url,
                    {
                        method: "POST",

                        headers: {
                            "Accept":
                                "application/json"
                        },

                        credentials: "same-origin"
                    }
                );


            const result =
                await cpostReadResponse(
                    response
                );


            if (
                !response.ok ||
                result.success !== true
            ) {

                throw new Error(
                    result.message ||
                    `Unable to like (${response.status})`
                );

            }


            const count =
                button.querySelector(
                    ".cpost-like-count"
                );


            if (count) {

                count.textContent =
                    result.likes ?? 0;

            }


            const liked =
                result.liked === true;


            button.classList.toggle(
                "liked",
                liked
            );


            button.setAttribute(
                "aria-pressed",
                liked
                    ? "true"
                    : "false"
            );

        }
        catch (error) {

            console.error(
                "CPOST LIKE ERROR:",
                error
            );


            cpostMessage(
                error.message ||
                "Unable to like this post."
            );

        }
        finally {

            button.disabled = false;

        }

    }



    /* =====================================================
       OPEN COMMENTS
    ===================================================== */

    function cpostOpenComments(button) {

        const card =
            cpostGetCard(button);


        if (!card) {

            return;

        }


        const modal =
            card.querySelector(
                ".cpost-comment-modal"
            );


        if (!modal) {

            console.error(
                "CPOST: Comment modal not found."
            );

            return;

        }


        modal.classList.add(
            "cpost-is-active"
        );


        modal.setAttribute(
            "aria-hidden",
            "false"
        );


        cpostLockBody();


        const textarea =
            modal.querySelector(
                ".cpost-comment-form textarea"
            );


        setTimeout(
            function () {

                if (textarea) {

                    textarea.focus();

                }

            },
            100
        );

    }



    /* =====================================================
       CLOSE COMMENTS
    ===================================================== */

    function cpostCloseComments(modal) {

        if (!modal) {

            return;

        }


        modal.classList.remove(
            "cpost-is-active"
        );


        modal.setAttribute(
            "aria-hidden",
            "true"
        );


        cpostUnlockBody();

    }



    /* =====================================================
       UPDATE COMMENT COUNTS
    ===================================================== */

    function cpostUpdateCommentCounts(
        card,
        amount
    ) {

        if (!card) {

            return;

        }


        const visibleCount =
            card.querySelector(
                ".cpost-comment-count"
            );


        const modalCount =
            card.querySelector(
                ".cpost-modal-comment-count"
            );


        const current =
            Number(
                visibleCount
                    ? visibleCount.textContent
                    : (
                        modalCount
                            ? modalCount.textContent
                            : 0
                    )
            ) || 0;


        const next =
            Math.max(
                0,
                current + amount
            );


        if (visibleCount) {

            visibleCount.textContent =
                next;

        }


        if (modalCount) {

            modalCount.textContent =
                next;

        }

    }



    /* =====================================================
       ADD COMMENT TO UI
    ===================================================== */

    function cpostAddComment(
        form,
        comment
    ) {

        const card =
            cpostGetCard(form);


        if (!card) {

            return;

        }


        const list =
            card.querySelector(
                ".cpost-comment-list"
            );


        if (!list) {

            return;

        }


        const empty =
            list.querySelector(
                ".cpost-comment-empty"
            );


        if (empty) {

            empty.remove();

        }


        const item =
            document.createElement(
                "div"
            );


        item.className =
            "cpost-comment-item";


        if (comment._id) {

            item.dataset.cpostCommentId =
                comment._id;

        }


        const avatar =
            document.createElement(
                "div"
            );


        avatar.className =
            "cpost-comment-avatar";


        const image =
            document.createElement(
                "img"
            );


        const nameValue =
            comment.userName ||
            "User";


        image.src =
            comment.userImage ||
            (
                "https://ui-avatars.com/api/?name=" +
                encodeURIComponent(
                    nameValue
                )
            );


        image.alt =
            nameValue;


        avatar.appendChild(
            image
        );


        const body =
            document.createElement(
                "div"
            );


        body.className =
            "cpost-comment-body";


        const top =
            document.createElement(
                "div"
            );


        top.className =
            "cpost-comment-top";


        const name =
            document.createElement(
                "strong"
            );


        name.textContent =
            nameValue;


        top.appendChild(
            name
        );


        /*
         * If the server identifies the newly-created
         * comment as belonging to the current user,
         * allow the delete button immediately.
         *
         * Admin-created comments are also removable.
         */

        const commentId =
            comment._id ||
            comment.id;


        if (commentId) {

            const deleteButton =
                document.createElement(
                    "button"
                );


            deleteButton.type =
                "button";


            deleteButton.className =
                "cpost-delete-comment";


            deleteButton.dataset.cpostDeleteComment =
                "";


            deleteButton.setAttribute(
                "aria-label",
                "Delete comment"
            );


            deleteButton.title =
                "Delete comment";


            deleteButton.innerHTML =
                '<i class="bi bi-trash3" aria-hidden="true"></i>';


            top.appendChild(
                deleteButton
            );

        }


        const text =
            document.createElement(
                "p"
            );


        text.className =
            "cpost-comment-text";


        text.textContent =
            comment.text ||
            "";


        body.appendChild(
            top
        );


        body.appendChild(
            text
        );


        if (
            comment.createdAt ||
            comment.dateText
        ) {

            const date =
                document.createElement(
                    "small"
                );


            date.className =
                "cpost-comment-date";


            date.textContent =
                comment.dateText ||
                new Date(
                    comment.createdAt
                ).toLocaleString();


            body.appendChild(
                date
            );

        }


        item.appendChild(
            avatar
        );


        item.appendChild(
            body
        );


        list.prepend(
            item
        );

    }



    /* =====================================================
       SUBMIT COMMENT
    ===================================================== */

    async function cpostSubmitComment(form) {

        if (!form) {

            return;

        }


        const card =
            cpostGetCard(form);


        if (!card) {

            return;

        }


        const textarea =
            form.querySelector(
                "textarea"
            );


        if (!textarea) {

            return;

        }


        const text =
            textarea.value.trim();


        if (!text) {

            textarea.focus();

            return;

        }


        const id =
            card.dataset.cpostId;


        const type =
            card.dataset.cpostType ||
            "post";


        if (!id) {

            cpostMessage(
                "Unable to identify this post."
            );

            return;

        }


        const submitButton =
            form.querySelector(
                ".cpost-comment-submit"
            );


        if (
            submitButton &&
            submitButton.disabled
        ) {

            return;

        }


        if (submitButton) {

            submitButton.disabled =
                true;

        }


        /*
         * IMPORTANT:
         *
         * Your feed-actions.ejs confirms:
         *
         * POST /post/:id/comment
         */

        const url =
            type === "post"
                ? `/post/${encodeURIComponent(id)}/comment`
                : `/${encodeURIComponent(type)}/${encodeURIComponent(id)}/comment`;


        try {

            const response =
                await fetch(
                    url,
                    {
                        method: "POST",

                        headers: {

                            "Content-Type":
                                "application/json",

                            "Accept":
                                "application/json"

                        },

                        credentials:
                            "same-origin",

                        body:
                            JSON.stringify({
                                text
                            })
                    }
                );


            const result =
                await cpostReadResponse(
                    response
                );


            if (
                !response.ok ||
                result.success !== true
            ) {

                throw new Error(
                    result.message ||
                    `Unable to save comment (${response.status})`
                );

            }


            /*
             * Preferred:
             *
             * Server returns:
             *
             * {
             *     success: true,
             *     comment: {...}
             * }
             */

            if (result.comment) {

                cpostAddComment(
                    form,
                    result.comment
                );


                cpostUpdateCommentCounts(
                    card,
                    1
                );


                textarea.value =
                    "";


                textarea.style.height =
                    "auto";


                return;

            }


            /*
             * If no comment was returned,
             * reload because the server has already
             * saved the comment.
             */

            window.location.reload();

        }
        catch (error) {

            console.error(
                "CPOST COMMENT ERROR:",
                error
            );


            cpostMessage(
                error.message ||
                "Unable to save comment."
            );

        }
        finally {

            if (submitButton) {

                submitButton.disabled =
                    false;

            }

        }

    }



    /* =====================================================
       DELETE POST
    ===================================================== */

    async function cpostDeletePost(button) {

        const card =
            cpostGetCard(button);


        if (!card) {

            return;

        }


        const id =
            card.dataset.cpostId;


        if (!id) {

            cpostMessage(
                "Unable to identify this post."
            );

            return;

        }


        const confirmed =
            window.confirm(
                "Delete this post?"
            );


        if (!confirmed) {

            return;

        }


        button.disabled =
            true;


        try {

            /*
             * Confirmed by feed-actions.ejs:
             *
             * DELETE /post/:id
             */

            const response =
                await fetch(
                    `/post/${encodeURIComponent(id)}`,
                    {
                        method: "DELETE",

                        headers: {
                            "Accept":
                                "application/json"
                        },

                        credentials:
                            "same-origin"
                    }
                );


            const result =
                await cpostReadResponse(
                    response
                );


            if (
                !response.ok ||
                result.success !== true
            ) {

                throw new Error(
                    result.message ||
                    `Delete failed (${response.status})`
                );

            }


            /*
             * Close any open modal belonging to
             * this card before removing it.
             */

            card
                .querySelectorAll(
                    ".cpost-expand.cpost-is-active, " +
                    ".cpost-viewer.cpost-is-active, " +
                    ".cpost-comment-modal.cpost-is-active"
                )
                .forEach(
                    function(modal) {

                        modal.classList.remove(
                            "cpost-is-active"
                        );

                    }
                );


            card.remove();


            cpostUnlockBody();

        }
        catch (error) {

            console.error(
                "CPOST DELETE ERROR:",
                error
            );


            cpostMessage(
                error.message ||
                "Unable to delete this post."
            );

        }
        finally {

            button.disabled =
                false;

        }

    }



    /* =====================================================
       DELETE COMMENT
    ===================================================== */

    async function cpostDeleteComment(button) {

        const comment =
            button.closest(
                ".cpost-comment-item"
            );


        const card =
            cpostGetCard(button);


        if (!comment || !card) {

            return;

        }


        const id =
            comment.dataset.cpostCommentId;


        if (!id) {

            cpostMessage(
                "Unable to identify this comment."
            );

            return;

        }


        const confirmed =
            window.confirm(
                "Delete this comment?"
            );


        if (!confirmed) {

            return;

        }


        button.disabled =
            true;


        try {

            /*
             * Confirmed by feed-actions.ejs:
             *
             * DELETE /comment/:id
             */

            const response =
                await fetch(
                    `/comment/${encodeURIComponent(id)}`,
                    {
                        method: "DELETE",

                        headers: {
                            "Accept":
                                "application/json"
                        },

                        credentials:
                            "same-origin"
                    }
                );


            const result =
                await cpostReadResponse(
                    response
                );


            if (
                !response.ok ||
                result.success !== true
            ) {

                throw new Error(
                    result.message ||
                    `Delete failed (${response.status})`
                );

            }


            comment.remove();


            cpostUpdateCommentCounts(
                card,
                -1
            );


            const list =
                card.querySelector(
                    ".cpost-comment-list"
                );


            if (
                list &&
                !list.querySelector(
                    ".cpost-comment-item"
                )
            ) {

                const empty =
                    document.createElement(
                        "div"
                    );


                empty.className =
                    "cpost-comment-empty";


                empty.innerHTML =

                    '<i class="bi bi-chat-dots" aria-hidden="true"></i>' +

                    '<span>No comments yet.</span>' +

                    '<small>Be the first to comment.</small>';


                list.appendChild(
                    empty
                );

            }

        }
        catch (error) {

            console.error(
                "CPOST DELETE COMMENT ERROR:",
                error
            );


            cpostMessage(
                error.message ||
                "Unable to delete comment."
            );

        }
        finally {

            button.disabled =
                false;

        }

    }



    /* =====================================================
       EXPAND POST
    ===================================================== */

    function cpostOpenExpand(button) {

        const card =
            cpostGetCard(button);


        if (!card) {

            return;

        }


        const modal =
            card.querySelector(
                ".cpost-expand"
            );


        if (!modal) {

            return;

        }


        modal.classList.add(
            "cpost-is-active"
        );


        modal.setAttribute(
            "aria-hidden",
            "false"
        );


        cpostLockBody();

    }



    function cpostCloseExpand(modal) {

        if (!modal) {

            return;

        }


        modal.classList.remove(
            "cpost-is-active"
        );


        modal.setAttribute(
            "aria-hidden",
            "true"
        );


        cpostUnlockBody();

    }



    /* =====================================================
       PHOTO VIEWER
    ===================================================== */

    let cpostViewer = null;

    let cpostViewerImages = [];

    let cpostViewerIndex = 0;


    function cpostGetImages(card) {

        const images = [];


        card
            .querySelectorAll(
                ".cpost-expanded-image img"
            )
            .forEach(
                function(img) {

                    if (img.src) {

                        images.push(
                            img.src
                        );

                    }

                }
            );


        if (!images.length) {

            card
                .querySelectorAll(
                    ".cpost-image-button img"
                )
                .forEach(
                    function(img) {

                        if (img.src) {

                            images.push(
                                img.src
                            );

                        }

                    }
                );

        }


        return images;

    }



    function cpostOpenViewer(
        button
    ) {

        const card =
            cpostGetCard(button);


        if (!card) {

            return;

        }


        const viewer =
            card.querySelector(
                ".cpost-viewer"
            );


        if (!viewer) {

            return;

        }


        const images =
            cpostGetImages(card);


        if (!images.length) {

            return;

        }


        cpostViewer =
            viewer;


        cpostViewerImages =
            images;


        cpostViewerIndex =
            Number(
                button.dataset.cpostPhotoIndex
            ) || 0;


        cpostViewerIndex =
            Math.max(
                0,
                Math.min(
                    cpostViewerIndex,
                    images.length - 1
                )
            );


        cpostUpdateViewer();


        viewer.classList.add(
            "cpost-is-active"
        );


        viewer.setAttribute(
            "aria-hidden",
            "false"
        );


        cpostLockBody();

    }



    function cpostUpdateViewer() {

        if (
            !cpostViewer ||
            !cpostViewerImages.length
        ) {

            return;

        }


        const image =
            cpostViewer.querySelector(
                ".cpost-viewer-image"
            );


        const counter =
            cpostViewer.querySelector(
                ".cpost-current-photo"
            );


        if (image) {

            image.src =
                cpostViewerImages[
                    cpostViewerIndex
                ];

        }


        if (counter) {

            counter.textContent =
                cpostViewerIndex + 1;

        }

    }



    function cpostCloseViewer() {

        if (!cpostViewer) {

            return;

        }


        cpostViewer.classList.remove(
            "cpost-is-active"
        );


        cpostViewer.setAttribute(
            "aria-hidden",
            "true"
        );


        cpostViewer = null;

        cpostViewerImages = [];

        cpostViewerIndex = 0;


        cpostUnlockBody();

    }



    function cpostNextPhoto() {

        if (
            !cpostViewerImages.length
        ) {

            return;

        }


        cpostViewerIndex =
            (
                cpostViewerIndex + 1
            ) %
            cpostViewerImages.length;


        cpostUpdateViewer();

    }



    function cpostPreviousPhoto() {

        if (
            !cpostViewerImages.length
        ) {

            return;

        }


        cpostViewerIndex =
            (
                cpostViewerIndex -
                1 +
                cpostViewerImages.length
            ) %
            cpostViewerImages.length;


        cpostUpdateViewer();

    }



    /* =====================================================
       CLICK HANDLER
    ===================================================== */

    document.addEventListener(
        "click",
        function(event) {


            /* =============================================
               LIKE
            ============================================= */

            const like =
                event.target.closest(
                    "[data-cpost-like]"
                );


            if (like) {

                event.preventDefault();

                cpostLike(like);

                return;

            }


            /* =============================================
               OPEN COMMENTS
            ============================================= */

            const comments =
                event.target.closest(
                    "[data-cpost-open-comments]"
                );


            if (comments) {

                event.preventDefault();

                cpostOpenComments(
                    comments
                );

                return;

            }


            /* =============================================
               CLOSE COMMENTS
            ============================================= */

            const closeComments =
                event.target.closest(
                    "[data-cpost-close-comments]"
                );


            if (closeComments) {

                event.preventDefault();

                cpostCloseComments(
                    closeComments.closest(
                        ".cpost-comment-modal"
                    )
                );

                return;

            }


            /* =============================================
               DELETE POST
            ============================================= */

            const deletePost =
                event.target.closest(
                    "[data-cpost-delete]"
                );


            if (deletePost) {

                event.preventDefault();

                cpostDeletePost(
                    deletePost
                );

                return;

            }


            /* =============================================
               DELETE COMMENT
            ============================================= */

            const deleteComment =
                event.target.closest(
                    "[data-cpost-delete-comment]"
                );


            if (deleteComment) {

                event.preventDefault();

                cpostDeleteComment(
                    deleteComment
                );

                return;

            }


            /* =============================================
               SEE MORE
            ============================================= */

            const seeMore =
                event.target.closest(
                    "[data-cpost-expand]"
                );


            if (seeMore) {

                event.preventDefault();

                cpostOpenExpand(
                    seeMore
                );

                return;

            }


            /* =============================================
               CLOSE EXPANDED POST
            ============================================= */

            const closeExpand =
                event.target.closest(
                    "[data-cpost-close-expand]"
                );


            if (closeExpand) {

                event.preventDefault();

                cpostCloseExpand(
                    closeExpand.closest(
                        ".cpost-expand"
                    )
                );

                return;

            }


            /* =============================================
               PHOTO
            ============================================= */

            const photo =
                event.target.closest(
                    ".cpost-image-button, .cpost-expanded-image"
                );


            if (photo) {

                event.preventDefault();

                cpostOpenViewer(
                    photo
                );

                return;

            }


            /* =============================================
               CLOSE VIEWER
            ============================================= */

            const closeViewer =
                event.target.closest(
                    "[data-cpost-close-viewer]"
                );


            if (closeViewer) {

                event.preventDefault();

                cpostCloseViewer();

                return;

            }


            /* =============================================
               NEXT PHOTO
            ============================================= */

            const next =
                event.target.closest(
                    "[data-cpost-photo-next]"
                );


            if (next) {

                event.preventDefault();

                cpostNextPhoto();

                return;

            }


            /* =============================================
               PREVIOUS PHOTO
            ============================================= */

            const previous =
                event.target.closest(
                    "[data-cpost-photo-prev]"
                );


            if (previous) {

                event.preventDefault();

                cpostPreviousPhoto();

                return;

            }


            /* =============================================
               CLICK OUTSIDE COMMENTS
            ============================================= */

            const modal =
                event.target.closest(
                    ".cpost-comment-modal"
                );


            if (
                modal &&
                event.target === modal
            ) {

                cpostCloseComments(
                    modal
                );

                return;

            }

        }
    );



    /* =====================================================
       FORM SUBMISSION
    ===================================================== */

    document.addEventListener(
        "submit",
        function(event) {

            const form =
                event.target.closest(
                    "[data-cpost-comment-form]"
                );


            if (!form) {

                return;

            }


            event.preventDefault();


            cpostSubmitComment(
                form
            );

        }
    );



    /* =====================================================
       TEXTAREA AUTO GROW
    ===================================================== */

    document.addEventListener(
        "input",
        function(event) {

            if (
                !event.target.matches(
                    ".cpost-comment-form textarea"
                )
            ) {

                return;

            }


            const textarea =
                event.target;


            textarea.style.height =
                "auto";


            textarea.style.height =
                Math.min(
                    textarea.scrollHeight,
                    100
                ) + "px";

        }
    );



    /* =====================================================
       ESCAPE KEY
    ===================================================== */

    document.addEventListener(
        "keydown",
        function(event) {

            if (
                event.key !== "Escape"
            ) {

                return;

            }


            if (cpostViewer) {

                cpostCloseViewer();

                return;

            }


            const expanded =
                document.querySelector(
                    ".cpost-expand.cpost-is-active"
                );


            if (expanded) {

                cpostCloseExpand(
                    expanded
                );

                return;

            }


            const comments =
                document.querySelector(
                    ".cpost-comment-modal.cpost-is-active"
                );


            if (comments) {

                cpostCloseComments(
                    comments
                );

            }

        }
    );



    /* =====================================================
       ARROW KEYS FOR PHOTO VIEWER
    ===================================================== */

    document.addEventListener(
        "keydown",
        function(event) {

            if (!cpostViewer) {

                return;

            }


            if (
                event.key === "ArrowRight"
            ) {

                event.preventDefault();

                cpostNextPhoto();

            }


            if (
                event.key === "ArrowLeft"
            ) {

                event.preventDefault();

                cpostPreviousPhoto();

            }

        }
    );



    /* =====================================================
       TOUCH SWIPE
    ===================================================== */

    let cpostTouchStartX = 0;

    let cpostTouchStartY = 0;


    document.addEventListener(
        "touchstart",
        function(event) {

            if (!cpostViewer) {

                return;

            }


            const touch =
                event.touches[0];


            if (!touch) {

                return;

            }


            cpostTouchStartX =
                touch.clientX;


            cpostTouchStartY =
                touch.clientY;

        },
        {
            passive: true
        }
    );


    document.addEventListener(
        "touchend",
        function(event) {

            if (!cpostViewer) {

                return;

            }


            const touch =
                event.changedTouches[0];


            if (!touch) {

                return;

            }


            const deltaX =
                touch.clientX -
                cpostTouchStartX;


            const deltaY =
                touch.clientY -
                cpostTouchStartY;


            if (
                Math.abs(deltaX) < 50 ||
                Math.abs(deltaX) <=
                    Math.abs(deltaY)
            ) {

                return;

            }


            if (deltaX < 0) {

                cpostNextPhoto();

            } else {

                cpostPreviousPhoto();

            }

        },
        {
            passive: true
        }
    );


})();

</script>