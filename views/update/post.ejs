<!-- ==========================================================
     POST CARD
     ==========================================================
     Supports:
     - User profile
     - Dairy subject
     - Delete post
     - Title
     - Message
     - Multi-image grid
     - Fullscreen image viewer
     - Image navigation
     - Long-message expansion
     - Likes
     - Comments
========================================================== -->


<%
    /* ========================================================
       NORMALIZE POST IMAGES
    ======================================================== */

    let postImages = [];

    if (
        Array.isArray(item.images) &&
        item.images.length
    ) {

        postImages =
            item.images.filter(Boolean);

    }
    else if (item.image) {

        postImages = [
            item.image
        ];

    }


    const visibleImages =
        postImages.slice(0, 4);


    const remainingImages =
        Math.max(
            0,
            postImages.length - 4
        );


    /* ========================================================
       POST TEXT
    ======================================================== */

    const postText =
        item.text ||
        item.comment ||
        "";


    const isLongPost =
        postText.length > 100;


    const shortPostText =
        isLongPost
            ? postText
                .substring(0, 100)
                .trim()
            : postText;


    /* ========================================================
       POST TITLE
    ======================================================== */

    const postTitle =
        item.title ||
        "Update";

%>


<!-- ==========================================================
     POST CARD
========================================================== -->

<article
    class="feed-card post-card"
    data-id="<%= item._id %>"
    data-type="post"
    data-images="<%= JSON.stringify(postImages).replace(/"/g, '&quot;') %>"
>


    <!-- ======================================================
         HEADER
    ======================================================= -->

    <div class="feed-header">


        <div class="feed-user">


            <!-- ==================================================
                 USER AVATAR
            =================================================== -->

            <img
                src="<%= item.userImage || ('https://ui-avatars.com/api/?name=' + encodeURIComponent(item.userName || 'User')) %>"
                class="avatar-sm"
                alt="<%= item.userName || 'User' %>"
            >


            <!-- ==================================================
                 USER INFORMATION
            =================================================== -->

            <div class="feed-user-info">


                <!-- ==================================================
                     META LINE
                =================================================== -->

                <div class="post-meta-line">


                    <strong class="post-user-name">

                        <%= item.userName || "User" %>

                    </strong>


                    <% if (
                        item.dairyName &&
                        item.dairyId
                    ) { %>


                        <span class="post-meta-action">

                            about

                        </span>


                        <a
                            href="/dairy/<%= item.dairyId %>"
                            class="post-subject"
                        >

                            <%= item.dairyName %>

                        </a>


                    <% } %>


                </div>


                <!-- ==================================================
                     POST TIME
                =================================================== -->

                <small class="post-time">

                    <%= item.dateText || "" %>

                </small>


            </div>


        </div>


        <!-- ==================================================
             DELETE POST
        =================================================== -->

        <% if (
            user &&
            (
                user.role === "admin" ||
                (
                    user._id &&
                    item.userId &&
                    user._id.toString() ===
                    item.userId.toString()
                )
            )
        ) { %>


            <button
                class="delete-post"
                data-id="<%= item._id %>"
                data-type="post"
                title="Delete Post"
                aria-label="Delete Post"
                type="button"
            >

                <i
                    class="bi bi-trash3-fill"
                    aria-hidden="true"
                ></i>

            </button>


        <% } %>


    </div>


    <!-- ======================================================
         POST BODY
    ======================================================= -->

    <div class="feed-body post-body">


        <!-- ==================================================
             POST TITLE
        =================================================== -->

        <h3 class="post-title">

            <%= postTitle %>

        </h3>


        <!-- ==================================================
             POST MESSAGE
        =================================================== -->

        <% if (postText) { %>


            <div
                class="post-message"
                data-long="<%= isLongPost ? 'true' : 'false' %>"
            >


                <% if (isLongPost) { %>


                    <span class="post-message-short">

                        <%= shortPostText %>...

                    </span>


                    <span
                        class="post-message-full"
                        hidden
                    >

                        <%= postText %>

                    </span>


                    <button
                        type="button"
                        class="see-more-post"
                        aria-expanded="false"
                    >

                        See more

                    </button>


                <% } else { %>


                    <span class="post-message-full">

                        <%= postText %>

                    </span>


                <% } %>


            </div>


        <% } %>


        <!-- ==================================================
             IMAGE GRID
        =================================================== -->

        <% if (visibleImages.length) { %>


            <div
                class="
                    post-image-grid
                    post-image-count-<%= visibleImages.length %>
                    <%= remainingImages > 0
                        ? 'has-more-images'
                        : '' %>
                "
            >


                <% visibleImages.forEach((image, index) => { %>


                    <button
                        type="button"
                        class="
                            post-image-item
                            <%= index === 3 &&
                                remainingImages > 0
                                ? 'has-image-overlay'
                                : '' %>
                        "
                        data-image-index="<%= index %>"
                        aria-label="View image <%= index + 1 %>"
                    >


                        <img
                            src="<%= image %>"
                            alt="Post image <%= index + 1 %>"
                            loading="lazy"
                        >


                        <% if (
                            index === 3 &&
                            remainingImages > 0
                        ) { %>


                            <span class="post-more-images">

                                +<%= remainingImages %>

                            </span>


                        <% } %>


                    </button>


                <% }) %>


            </div>


        <% } %>


    </div>


    <!-- ======================================================
         POST ACTIONS
    ======================================================= -->

    <%- include("partials/feed-actions", {
        item,
        type: "post"
    }) %>


    <!-- ======================================================
         COMMENTS
    ======================================================= -->

    <%- include("comment-section", {
        item,
        user,
        type: "post"
    }) %>


</article>



<!-- ==========================================================
     FULLSCREEN IMAGE VIEWER
========================================================== -->

<div
    class="post-image-viewer"
    aria-hidden="true"
>


    <!-- ======================================================
         CLOSE
    ======================================================= -->

    <button
        type="button"
        class="post-viewer-close"
        aria-label="Close image viewer"
    >

        <i class="bi bi-x-lg"></i>

    </button>


    <!-- ======================================================
         PREVIOUS
    ======================================================= -->

    <button
        type="button"
        class="post-viewer-prev"
        aria-label="Previous image"
    >

        <i class="bi bi-chevron-left"></i>

    </button>


    <!-- ======================================================
         VIEWER CONTENT
    ======================================================= -->

    <div class="post-viewer-content">


        <img
            class="post-viewer-image"
            src=""
            alt="Post image"
        >


        <div class="post-viewer-counter">

            <span class="post-viewer-current">
                1
            </span>

            /

            <span class="post-viewer-total">
                <%= postImages.length %>
            </span>

        </div>


    </div>


    <!-- ======================================================
         NEXT
    ======================================================= -->

    <button
        type="button"
        class="post-viewer-next"
        aria-label="Next image"
    >

        <i class="bi bi-chevron-right"></i>

    </button>


</div>



<!-- ==========================================================
     POST CARD STYLES
========================================================== -->

<style>


/* ==========================================================
   POST CARD
========================================================== */

.post-card {

    position: relative;

    width: 100%;

    text-align: left !important;

}


/* ==========================================================
   POST BODY
========================================================== */

.post-card .post-body {

    display: block;

    position: relative;

    width: 100%;

    height: auto;

    min-height: 0;

    margin: 0;

    padding: 17px 20px 18px;

    background: #ffffff;

    text-align: left !important;

    box-sizing: border-box;

}


/* ==========================================================
   TITLE
========================================================== */

.post-card .post-title {

    display: block;

    width: 100%;

    margin: 0 0 8px;

    padding: 0;

    color: #285d39;

    font-size: 18px;

    font-weight: 700;

    line-height: 1.4;

    text-align: left !important;

    box-sizing: border-box;

}


/* ==========================================================
   MESSAGE
========================================================== */

.post-card .post-message {

    display: block;

    width: 100%;

    margin: 0;

    padding: 0;

    color: #3f4d44;

    font-size: 15px;

    font-weight: 400;

    line-height: 1.7;

    text-align: left !important;

    white-space: pre-wrap;

    word-break: break-word;

    overflow-wrap: anywhere;

    box-sizing: border-box;

}


/* ==========================================================
   MESSAGE SPANS
========================================================== */

.post-card
.post-message-short,

.post-card
.post-message-full {

    display: inline;

    margin: 0;

    padding: 0;

    color: inherit;

    font-size: inherit;

    font-weight: inherit;

    line-height: inherit;

    text-align: left !important;

    white-space: pre-wrap;

    word-break: break-word;

    overflow-wrap: anywhere;

}


/* ==========================================================
   SEE MORE
========================================================== */

.post-card .see-more-post {

    display: inline;

    margin: 0 0 0 5px;

    padding: 0;

    border: 0;

    background: transparent;

    color: #166534;

    font-family: inherit;

    font-size: inherit;

    font-weight: 700;

    line-height: inherit;

    text-align: left;

    cursor: pointer;

}


.post-card .see-more-post:hover {

    color: #14532d;

}


/* ==========================================================
   IMAGE GRID
========================================================== */

.post-image-grid {

    display: grid;

    gap: 3px;

    width: 100%;

    margin: 14px 0 0;

    padding: 0;

    overflow: hidden;

    border-radius: 9px;

    box-sizing: border-box;

}


/* ==========================================================
   ONE IMAGE
========================================================== */

.post-image-count-1 {

    grid-template-columns: 1fr;

}


/* ==========================================================
   TWO IMAGES
========================================================== */

.post-image-count-2 {

    grid-template-columns: repeat(
        2,
        minmax(0, 1fr)
    );

}


/* ==========================================================
   THREE IMAGES
========================================================== */

.post-image-count-3 {

    grid-template-columns: repeat(
        2,
        minmax(0, 1fr)
    );

}


.post-image-count-3
.post-image-item:first-child {

    grid-row: span 2;

}


/* ==========================================================
   FOUR IMAGES
========================================================== */

.post-image-count-4 {

    grid-template-columns: repeat(
        2,
        minmax(0, 1fr)
    );

}


/* ==========================================================
   IMAGE BUTTON
========================================================== */

.post-image-item {

    position: relative;

    display: block;

    width: 100%;

    min-width: 0;

    min-height: 0;

    margin: 0;

    padding: 0;

    border: 0;

    border-radius: 0;

    outline: none;

    background: #f3f4f6;

    overflow: hidden;

    cursor: pointer;

    box-sizing: border-box;

}


/* ==========================================================
   IMAGE
========================================================== */

.post-image-item img {

    display: block;

    width: 100%;

    height: 180px;

    min-height: 0;

    margin: 0;

    padding: 0;

    border: 0;

    object-fit: cover;

    transition:
        transform .2s ease;

}


/* ==========================================================
   IMAGE HOVER
========================================================== */

.post-image-item:hover img {

    transform: scale(1.02);

}


/* ==========================================================
   SINGLE IMAGE
========================================================== */

.post-image-count-1
.post-image-item img {

    width: 100%;

    height: auto;

    max-height: 420px;

    min-height: 0;

    object-fit: contain;

    background: #f3f4f6;

}


/* ==========================================================
   THREE IMAGE LARGE IMAGE
========================================================== */

.post-image-count-3
.post-image-item:first-child img {

    height: 363px;

}


/* ==========================================================
   MORE IMAGES OVERLAY
========================================================== */

.has-image-overlay::after {

    content: "";

    position: absolute;

    inset: 0;

    z-index: 1;

    background:
        rgba(0, 0, 0, .35);

}


.post-more-images {

    position: absolute;

    inset: 0;

    z-index: 2;

    display: flex;

    align-items: center;

    justify-content: center;

    color: #ffffff;

    font-size: 24px;

    font-weight: 800;

    line-height: 1;

    pointer-events: none;

}


/* ==========================================================
   IMAGE BUTTON FOCUS
========================================================== */

.post-image-item:focus-visible {

    outline: 3px solid #2e7d32;

    outline-offset: -3px;

}


/* ==========================================================
   FULLSCREEN VIEWER
========================================================== */

.post-image-viewer {

    position: fixed;

    inset: 0;

    z-index: 99999;

    display: none;

    align-items: center;

    justify-content: center;

    width: 100%;

    height: 100%;

    background:
        rgba(0, 0, 0, .94);

    touch-action: none;

}


.post-image-viewer.active {

    display: flex;

}


/* ==========================================================
   VIEWER CONTENT
========================================================== */

.post-viewer-content {

    position: relative;

    display: flex;

    align-items: center;

    justify-content: center;

    width: 100%;

    height: 100%;

    padding: 55px 65px;

    box-sizing: border-box;

}


/* ==========================================================
   VIEWER IMAGE
========================================================== */

.post-viewer-image {

    display: block;

    max-width: 100%;

    max-height: 100%;

    width: auto;

    height: auto;

    margin: 0;

    padding: 0;

    object-fit: contain;

    user-select: none;

    -webkit-user-drag: none;

}


/* ==========================================================
   VIEWER BUTTONS
========================================================== */

.post-viewer-close,

.post-viewer-prev,

.post-viewer-next {

    position: absolute;

    z-index: 5;

    display: flex;

    align-items: center;

    justify-content: center;

    width: 42px;

    height: 42px;

    margin: 0;

    padding: 0;

    border: 0;

    border-radius: 50%;

    background:
        rgba(255, 255, 255, .14);

    color: #ffffff;

    cursor: pointer;

    backdrop-filter: blur(5px);

    box-sizing: border-box;

}


.post-viewer-close {

    top: 16px;

    right: 16px;

}


.post-viewer-prev {

    left: 16px;

    top: 50%;

    transform:
        translateY(-50%);

}


.post-viewer-next {

    right: 16px;

    top: 50%;

    transform:
        translateY(-50%);

}


.post-viewer-close:hover,

.post-viewer-prev:hover,

.post-viewer-next:hover {

    background:
        rgba(255, 255, 255, .25);

}


/* ==========================================================
   VIEWER COUNTER
========================================================== */

.post-viewer-counter {

    position: absolute;

    left: 50%;

    bottom: 16px;

    transform:
        translateX(-50%);

    color: #ffffff;

    font-size: 13px;

    font-weight: 600;

    line-height: 1;

    padding: 6px 11px;

    border-radius: 20px;

    background:
        rgba(0, 0, 0, .45);

}


/* ==========================================================
   MOBILE
========================================================== */

@media (max-width: 600px) {


    /* ------------------------------------------------------
       BODY
    ------------------------------------------------------ */

    .post-card .post-body {

        padding:
            15px
            16px
            16px;

    }


    /* ------------------------------------------------------
       TITLE
    ------------------------------------------------------ */

    .post-card .post-title {

        margin-bottom: 7px;

        font-size: 17px;

        line-height: 1.4;

    }


    /* ------------------------------------------------------
       MESSAGE
    ------------------------------------------------------ */

    .post-card .post-message {

        font-size: 15px;

        line-height: 1.65;

    }


    /* ------------------------------------------------------
       IMAGE GRID
    ------------------------------------------------------ */

    .post-image-grid {

        margin-top: 11px;

    }


    /* ------------------------------------------------------
       GRID IMAGE
    ------------------------------------------------------ */

    .post-image-item img {

        height: 135px;

    }


    /* ------------------------------------------------------
       THREE IMAGE LAYOUT
    ------------------------------------------------------ */

    .post-image-count-3
    .post-image-item:first-child img {

        height: 273px;

    }


    /* ------------------------------------------------------
       SINGLE IMAGE
    ------------------------------------------------------ */

    .post-image-count-1
    .post-image-item img {

        height: auto;

        max-height: 320px;

        min-height: 0;

    }


    /* ------------------------------------------------------
       VIEWER
    ------------------------------------------------------ */

    .post-viewer-content {

        padding:
            50px
            40px;

    }


    .post-viewer-prev {

        left: 7px;

    }


    .post-viewer-next {

        right: 7px;

    }


    .post-viewer-close {

        top: 10px;

        right: 10px;

    }


}


/* ==========================================================
   SMALL MOBILE
========================================================== */

@media (max-width: 380px) {


    .post-card .post-body {

        padding:
            14px;

    }


    .post-card .post-title {

        font-size: 16px;

    }


    .post-card .post-message {

        font-size: 14px;

    }


    .post-image-item img {

        height: 115px;

    }


    .post-image-count-3
    .post-image-item:first-child img {

        height: 233px;

    }

}

</style>



<!-- ==========================================================
     POST CARD JAVASCRIPT
========================================================== -->

<script>

(function () {


    /* ========================================================
       PREVENT MULTIPLE INITIALIZATION
    ======================================================== */

    if (
        window.__postCardInitialized
    ) {

        return;

    }


    window.__postCardInitialized =
        true;


    /* ========================================================
       SEE MORE / SEE LESS
    ======================================================== */

    document.addEventListener(
        "click",
        event => {


            const button =
                event.target.closest(
                    ".see-more-post"
                );


            if (!button) {

                return;

            }


            event.preventDefault();


            const message =
                button.closest(
                    ".post-message"
                );


            if (!message) {

                return;

            }


            const shortText =
                message.querySelector(
                    ".post-message-short"
                );


            const fullText =
                message.querySelector(
                    ".post-message-full"
                );


            if (
                !shortText ||
                !fullText
            ) {

                return;

            }


            const expanded =
                button.getAttribute(
                    "aria-expanded"
                ) === "true";


            if (expanded) {


                fullText.hidden =
                    true;


                shortText.hidden =
                    false;


                button.textContent =
                    "See more";


                button.setAttribute(
                    "aria-expanded",
                    "false"
                );


            }
            else {


                shortText.hidden =
                    true;


                fullText.hidden =
                    false;


                button.textContent =
                    "See less";


                button.setAttribute(
                    "aria-expanded",
                    "true"
                );

            }

        }
    );


    /* ========================================================
       VIEWER STATE
    ======================================================== */

    let viewerImages = [];

    let viewerIndex = 0;

    let activeViewer = null;


    /* ========================================================
       OPEN VIEWER
    ======================================================== */

    function openPostImageViewer(
        card,
        index
    ) {


        if (!card) {

            return;

        }


        /* ----------------------------------------------------
           RESET PREVIOUS IMAGE STATE
        ---------------------------------------------------- */

        viewerImages = [];


        /* ----------------------------------------------------
           READ FULL IMAGE ARRAY
        ---------------------------------------------------- */

        try {


            const encodedImages =
                card.dataset.images;


            if (encodedImages) {


                const parsed =
                    JSON.parse(
                        encodedImages
                    );


                if (
                    Array.isArray(parsed) &&
                    parsed.length
                ) {


                    viewerImages =
                        parsed;

                }

            }

        }
        catch (error) {


            console.warn(
                "POST IMAGE VIEWER: Unable to read image list.",
                error
            );

        }


        /* ----------------------------------------------------
           FALLBACK TO VISIBLE IMAGES
        ---------------------------------------------------- */

        if (
            !viewerImages.length
        ) {


            const imageElements =
                card.querySelectorAll(
                    ".post-image-item img"
                );


            viewerImages =
                Array.from(
                    imageElements
                ).map(
                    image =>
                        image.currentSrc ||
                        image.src
                );

        }


        if (
            !viewerImages.length
        ) {

            return;

        }


        /* ----------------------------------------------------
           SET INDEX
        ---------------------------------------------------- */

        viewerIndex =
            Math.max(
                0,
                Math.min(
                    index,
                    viewerImages.length - 1
                )
            );


        /* ----------------------------------------------------
           FIND VIEWER
        ---------------------------------------------------- */

        activeViewer =
            document.querySelector(
                ".post-image-viewer"
            );


        if (!activeViewer) {

            return;

        }


        /* ----------------------------------------------------
           OPEN
        ---------------------------------------------------- */

        activeViewer.classList.add(
            "active"
        );


        activeViewer.setAttribute(
            "aria-hidden",
            "false"
        );


        document.body.style.overflow =
            "hidden";


        updatePostViewer();

    }


    /* ========================================================
       UPDATE VIEWER
    ======================================================== */

    function updatePostViewer() {


        if (
            !activeViewer ||
            !viewerImages.length
        ) {

            return;

        }


        const image =
            activeViewer.querySelector(
                ".post-viewer-image"
            );


        const current =
            activeViewer.querySelector(
                ".post-viewer-current"
            );


        const total =
            activeViewer.querySelector(
                ".post-viewer-total"
            );


        /* ----------------------------------------------------
           IMAGE
        ---------------------------------------------------- */

        if (image) {

            image.src =
                viewerImages[
                    viewerIndex
                ];

        }


        /* ----------------------------------------------------
           COUNTER
        ---------------------------------------------------- */

        if (current) {

            current.textContent =
                viewerIndex + 1;

        }


        if (total) {

            total.textContent =
                viewerImages.length;

        }


        /* ----------------------------------------------------
           NAVIGATION
        ---------------------------------------------------- */

        const previous =
            activeViewer.querySelector(
                ".post-viewer-prev"
            );


        const next =
            activeViewer.querySelector(
                ".post-viewer-next"
            );


        const multiple =
            viewerImages.length > 1;


        if (previous) {

            previous.style.display =
                multiple
                    ? "flex"
                    : "none";

        }


        if (next) {

            next.style.display =
                multiple
                    ? "flex"
                    : "none";

        }

    }


    /* ========================================================
       CLOSE VIEWER
    ======================================================== */

    function closePostImageViewer() {


        if (!activeViewer) {

            return;

        }


        activeViewer.classList.remove(
            "active"
        );


        activeViewer.setAttribute(
            "aria-hidden",
            "true"
        );


        document.body.style.overflow =
            "";


        activeViewer = null;

        viewerImages = [];

        viewerIndex = 0;

    }


    /* ========================================================
       PREVIOUS IMAGE
    ======================================================== */

    function previousPostImage() {


        if (
            !viewerImages.length
        ) {

            return;

        }


        viewerIndex =
            viewerIndex <= 0
                ? viewerImages.length - 1
                : viewerIndex - 1;


        updatePostViewer();

    }


    /* ========================================================
       NEXT IMAGE
    ======================================================== */

    function nextPostImage() {


        if (
            !viewerImages.length
        ) {

            return;

        }


        viewerIndex =
            viewerIndex >=
                viewerImages.length - 1
                ? 0
                : viewerIndex + 1;


        updatePostViewer();

    }


    /* ========================================================
       IMAGE CLICK
    ======================================================== */

    document.addEventListener(
        "click",
        event => {


            const imageButton =
                event.target.closest(
                    ".post-image-item"
                );


            if (!imageButton) {

                return;

            }


            event.preventDefault();


            const card =
                imageButton.closest(
                    ".post-card"
                );


            if (!card) {

                return;

            }


            const index =
                Number(
                    imageButton.dataset.imageIndex
                );


            openPostImageViewer(
                card,
                index
            );

        }
    );


    /* ========================================================
       VIEWER CONTROLS
    ======================================================== */

    document.addEventListener(
        "click",
        event => {


            /* ------------------------------------------------
               CLOSE
            ------------------------------------------------ */

            if (
                event.target.closest(
                    ".post-viewer-close"
                )
            ) {


                closePostImageViewer();

                return;

            }


            /* ------------------------------------------------
               PREVIOUS
            ------------------------------------------------ */

            if (
                event.target.closest(
                    ".post-viewer-prev"
                )
            ) {


                previousPostImage();

                return;

            }


            /* ------------------------------------------------
               NEXT
            ------------------------------------------------ */

            if (
                event.target.closest(
                    ".post-viewer-next"
                )
            ) {


                nextPostImage();

                return;

            }


            /* ------------------------------------------------
               CLICK BACKDROP
            ------------------------------------------------ */

            const viewer =
                event.target.closest(
                    ".post-image-viewer"
                );


            if (
                viewer &&
                event.target === viewer
            ) {


                closePostImageViewer();

            }

        }
    );


    /* ========================================================
       KEYBOARD NAVIGATION
    ======================================================== */

    document.addEventListener(
        "keydown",
        event => {


            if (!activeViewer) {

                return;

            }


            /* ------------------------------------------------
               ESCAPE
            ------------------------------------------------ */

            if (
                event.key === "Escape"
            ) {


                closePostImageViewer();

                return;

            }


            /* ------------------------------------------------
               LEFT
            ------------------------------------------------ */

            if (
                event.key === "ArrowLeft"
            ) {


                previousPostImage();

                return;

            }


            /* ------------------------------------------------
               RIGHT
            ------------------------------------------------ */

            if (
                event.key === "ArrowRight"
            ) {


                nextPostImage();

                return;

            }

        }
    );


    /* ========================================================
       TOUCH SWIPE
    ======================================================== */

    let touchStartX = 0;

    let touchStartY = 0;


    document.addEventListener(
        "touchstart",
        event => {


            if (!activeViewer) {

                return;

            }


            if (
                !event.touches ||
                !event.touches.length
            ) {

                return;

            }


            touchStartX =
                event.touches[0].clientX;


            touchStartY =
                event.touches[0].clientY;

        },
        {
            passive: true
        }
    );


    document.addEventListener(
        "touchend",
        event => {


            if (!activeViewer) {

                return;

            }


            if (
                !event.changedTouches ||
                !event.changedTouches.length
            ) {

                return;

            }


            const endX =
                event.changedTouches[0].clientX;


            const endY =
                event.changedTouches[0].clientY;


            const deltaX =
                endX - touchStartX;


            const deltaY =
                endY - touchStartY;


            /* ------------------------------------------------
               IGNORE SMALL / VERTICAL SWIPES
            ------------------------------------------------ */

            if (
                Math.abs(deltaX) < 50 ||
                Math.abs(deltaX) <
                Math.abs(deltaY)
            ) {

                return;

            }


            /* ------------------------------------------------
               SWIPE RIGHT
            ------------------------------------------------ */

            if (
                deltaX > 0
            ) {


                previousPostImage();

            }


            /* ------------------------------------------------
               SWIPE LEFT
            ------------------------------------------------ */

            else {


                nextPostImage();

            }

        },
        {
            passive: true
        }
    );


})();

</script>