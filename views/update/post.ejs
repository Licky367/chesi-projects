<!-- =========================================================
     POST FEED ITEM

     EXPECTED VARIABLES:

     item
     user

     item contains:

     _id
     dairy
     user
     userName
     userImage
     type
     title
     text
     image
     images
     likes
     comments
     createdAt
========================================================= -->


<article
    class="feed-post"
    data-post-id="<%= item._id %>"
>


    <!-- =====================================================
         POST HEADER
    ====================================================== -->

    <header class="feed-post-header">


        <!-- =================================================
             USER AVATAR
        ================================================== -->

        <div class="feed-post-avatar">

            <img
                src="<%= item.userImage || ('https://ui-avatars.com/api/?name=' + encodeURIComponent(item.userName || 'User')) %>"
                alt="<%= item.userName || 'User' %>"
            >

        </div>


        <!-- =================================================
             USER INFORMATION
        ================================================== -->

        <div class="feed-post-user-info">

            <strong>
                <%= item.userName || "User" %>
            </strong>


            <span class="feed-post-date">

                <%= item.createdAt
                    ? new Date(item.createdAt).toLocaleString()
                    : ""
                %>

            </span>

        </div>


        <!-- =================================================
             DELETE BUTTON
        ================================================== -->

        <% if (
            user &&
            (
                String(item.user) === String(user._id) ||
                user.role === "admin"
            )
        ) { %>

            <button
                type="button"
                class="feed-post-delete"
                data-post-id="<%= item._id %>"
                aria-label="Delete post"
                title="Delete post"
            >

                <i class="bi bi-trash"></i>

            </button>

        <% } %>

    </header>



    <!-- =====================================================
         POST CONTENT
    ====================================================== -->

    <div class="feed-post-content">


        <!-- =================================================
             POST TITLE
        ================================================== -->

        <% if (item.title) { %>

            <h3 class="feed-post-title">
                <%= item.title %>
            </h3>

        <% } %>



        <!-- =================================================
             POST TEXT
        ================================================== -->

        <% if (item.text) { %>

            <div class="feed-post-text">

                <%= item.text %>

            </div>

        <% } %>



        <!-- =================================================
             MULTIPLE IMAGES
        ================================================== -->

        <% if (
            Array.isArray(item.images) &&
            item.images.length
        ) { %>


            <div
                class="
                    feed-post-images
                    feed-post-images-count-<%= Math.min(item.images.length, 4) %>
                "
            >

                <% item.images.forEach(function (image, index) { %>

                    <div
                        class="feed-post-image-wrapper"
                        data-image-index="<%= index %>"
                    >

                        <img
                            src="/uploads/<%= image %>"
                            alt="Post image <%= index + 1 %>"
                            class="feed-post-image"
                            loading="lazy"
                        >

                    </div>

                <% }); %>

            </div>


        <% } else if (item.image) { %>


            <!-- =================================================
                 BACKWARD COMPATIBILITY
                 FOR OLD POSTS HAVING ONE IMAGE
            ================================================== -->

            <div class="feed-post-images single-image">

                <div class="feed-post-image-wrapper">

                    <img
                        src="/uploads/<%= item.image %>"
                        alt="Post image"
                        class="feed-post-image"
                        loading="lazy"
                    >

                </div>

            </div>


        <% } %>

    </div>



    <!-- =====================================================
         POST ACTIONS
    ====================================================== -->

    <footer class="feed-post-actions">


        <!-- =================================================
             LIKE
        ================================================== -->

        <button
            type="button"
            class="feed-post-action like-post-button"
            data-post-id="<%= item._id %>"
            aria-label="Like post"
        >

            <i class="bi bi-heart"></i>

            <span class="post-like-count">

                <%= Array.isArray(item.likes)
                    ? item.likes.length
                    : 0
                %>

            </span>

        </button>



        <!-- =================================================
             COMMENT
        ================================================== -->

        <button
            type="button"
            class="feed-post-action comment-post-button"
            data-post-id="<%= item._id %>"
            aria-label="Comment on post"
        >

            <i class="bi bi-chat"></i>

            <span class="post-comment-count">

                <%= Array.isArray(item.comments)
                    ? item.comments.length
                    : 0
                %>

            </span>

        </button>


    </footer>



    <!-- =====================================================
         COMMENTS
    ====================================================== -->

    <% if (
        Array.isArray(item.comments) &&
        item.comments.length
    ) { %>


        <div class="feed-post-comments">


            <% item.comments.forEach(function(comment) { %>

                <div
                    class="feed-post-comment"
                    data-comment-id="<%= comment._id %>"
                >


                    <div class="comment-avatar">

                        <img
                            src="<%= comment.userImage || ('https://ui-avatars.com/api/?name=' + encodeURIComponent(comment.userName || 'User')) %>"
                            alt="<%= comment.userName || 'User' %>"
                        >

                    </div>


                    <div class="comment-body">

                        <div class="comment-user">

                            <strong>
                                <%= comment.userName || "User" %>
                            </strong>

                        </div>


                        <div class="comment-text">

                            <%= comment.text %>

                        </div>


                        <div class="comment-date">

                            <%= comment.createdAt
                                ? new Date(comment.createdAt).toLocaleString()
                                : ""
                            %>

                        </div>

                    </div>

                </div>

            <% }); %>


        </div>


    <% } %>

</article>



<!-- =========================================================
     POST CSS
========================================================= -->

<style>

.feed-post {

    width: 100%;

    box-sizing: border-box;

    background: #ffffff;

    border: 1px solid #e5ebe7;

    border-radius: 16px;

    margin-bottom: 16px;

    overflow: hidden;

}


.feed-post-header {

    display: flex;

    align-items: center;

    gap: 10px;

    padding: 14px 16px;

}


.feed-post-avatar {

    width: 42px;

    height: 42px;

    flex: 0 0 42px;

}


.feed-post-avatar img {

    width: 42px;

    height: 42px;

    display: block;

    object-fit: cover;

    border-radius: 50%;

}


.feed-post-user-info {

    min-width: 0;

    flex: 1;

    display: flex;

    flex-direction: column;

}


.feed-post-user-info strong {

    color: #202520;

    font-size: 14px;

    line-height: 1.3;

}


.feed-post-date {

    margin-top: 2px;

    color: #858d88;

    font-size: 11px;

}


.feed-post-delete {

    width: 38px;

    height: 38px;

    flex: 0 0 38px;

    border: none;

    background: transparent;

    color: #8a918d;

    border-radius: 50%;

    display: flex;

    align-items: center;

    justify-content: center;

    cursor: pointer;

}


.feed-post-delete:hover {

    color: #c62828;

    background: #fff3f3;

}


.feed-post-content {

    padding: 0 16px 14px;

}


.feed-post-title {

    margin: 0 0 8px;

    color: #202520;

    font-size: 18px;

    line-height: 1.35;

    font-weight: 700;

}


.feed-post-text {

    color: #303632;

    font-size: 15px;

    line-height: 1.55;

    white-space: pre-wrap;

    word-break: break-word;

}


/* =========================================================
   IMAGE GRID
========================================================= */

.feed-post-images {

    width: 100%;

    margin-top: 14px;

    display: grid;

    grid-template-columns: repeat(2, minmax(0, 1fr));

    gap: 4px;

    overflow: hidden;

    border-radius: 12px;

}


.feed-post-images.single-image {

    display: block;

}


.feed-post-image-wrapper {

    position: relative;

    min-width: 0;

    overflow: hidden;

    background: #f1f4f2;

    aspect-ratio: 1 / 1;

}


.feed-post-images.single-image
.feed-post-image-wrapper {

    aspect-ratio: auto;

}


.feed-post-image {

    width: 100%;

    height: 100%;

    display: block;

    object-fit: cover;

}


.feed-post-images.single-image
.feed-post-image {

    height: auto;

    max-height: 600px;

    object-fit: contain;

}


/* =========================================================
   ACTIONS
========================================================= */

.feed-post-actions {

    display: flex;

    align-items: center;

    gap: 8px;

    padding: 8px 12px;

    border-top: 1px solid #edf1ee;

}


.feed-post-action {

    min-width: 70px;

    height: 38px;

    padding: 0 10px;

    border: none;

    border-radius: 20px;

    background: transparent;

    color: #66706a;

    display: inline-flex;

    align-items: center;

    justify-content: center;

    gap: 6px;

    cursor: pointer;

    font-size: 14px;

}


.feed-post-action:hover {

    background: #f1f6f3;

    color: #198754;

}


.feed-post-action i {

    font-size: 18px;

}


.post-like-count,
.post-comment-count {

    font-size: 13px;

}


/* =========================================================
   COMMENTS
========================================================= */

.feed-post-comments {

    border-top: 1px solid #edf1ee;

    padding: 10px 14px 14px;

}


.feed-post-comment {

    display: flex;

    gap: 9px;

    padding: 8px 0;

}


.comment-avatar {

    width: 32px;

    height: 32px;

    flex: 0 0 32px;

}


.comment-avatar img {

    width: 32px;

    height: 32px;

    border-radius: 50%;

    object-fit: cover;

}


.comment-body {

    min-width: 0;

    flex: 1;

    background: #f5f8f6;

    border-radius: 12px;

    padding: 7px 10px;

}


.comment-user strong {

    font-size: 12px;

    color: #202520;

}


.comment-text {

    margin-top: 2px;

    font-size: 13px;

    line-height: 1.45;

    color: #343a36;

    white-space: pre-wrap;

    word-break: break-word;

}


.comment-date {

    margin-top: 4px;

    color: #8a918d;

    font-size: 10px;

}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 600px) {

    .feed-post-header {

        padding: 12px;

    }


    .feed-post-content {

        padding: 0 12px 12px;

    }


    .feed-post-title {

        font-size: 17px;

    }


    .feed-post-text {

        font-size: 14px;

    }


    .feed-post-images {

        border-radius: 10px;

    }

}

</style>