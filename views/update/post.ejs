    >

        <i class="bi bi-chevron-left"></i>

    </button>


    <img
        id="postViewerImage"
        src=""
        alt="Post image"
    >


    <button
        type="button"
        id="nextPostImage"
        class="post-image-viewer-navigation next"
        aria-label="Next image"
    >

        <i class="bi bi-chevron-right"></i>

    </button>


    <div
        id="postImageViewerCounter"
        class="post-image-viewer-counter"
    ></div>


</div>



<style>

/* =========================================================
   IMAGE VIEWER
========================================================= */

.post-image-viewer {

    position: fixed;

    inset: 0;

    z-index: 100000;

    display: none;

    align-items: center;

    justify-content: center;

    background:
        rgba(0, 0, 0, 0.92);

}


.post-image-viewer.active {

    display: flex;

}


#postViewerImage {

    max-width: 92vw;

    max-height: 88vh;

    width: auto;

    height: auto;

    object-fit: contain;

}


.post-image-viewer-close {

    position: absolute;

    top: 18px;

    right: 18px;

    width: 44px;

    height: 44px;

    border: none;

    border-radius: 50%;

    background:
        rgba(255, 255, 255, 0.12);

    color: #ffffff;

    display: flex;

    align-items: center;

    justify-content: center;

    cursor: pointer;

    font-size: 20px;

}


.post-image-viewer-navigation {

    position: absolute;

    top: 50%;

    transform:
        translateY(-50%);

    width: 46px;

    height: 46px;

    border: none;

    border-radius: 50%;

    background:
        rgba(255, 255, 255, 0.12);

    color: #ffffff;

    display: flex;

    align-items: center;

    justify-content: center;

    cursor: pointer;

    font-size: 24px;

}


.post-image-viewer-navigation.previous {

    left: 15px;

}


.post-image-viewer-navigation.next {

    right: 15px;

}


.post-image-viewer-counter {

    position: absolute;

    bottom: 20px;

    left: 50%;

    transform:
        translateX(-50%);

    color: #ffffff;

    font-size: 13px;

    background:
        rgba(0, 0, 0, 0.45);

    padding:
        5px
        10px;

    border-radius: 12px;

}

</style>



<!-- =========================================================
     JAVASCRIPT
========================================================= -->

<script>

(function () {

    "use strict";


    /* =====================================================
       POST ID
    ====================================================== */

    const postId =
        "<%= postId %>";


    /* =====================================================
       IMAGE DATA
    ====================================================== */

    const postImages =
        <%- JSON.stringify(postImages) %>;


    /* =====================================================
       IMAGE URL
    ====================================================== */

    function getImageUrl(image) {

        if (!image) {

            return "";

        }


        if (
            image.startsWith("/")
        ) {

            return image;

        }


        return "/uploads/" + image;

    }


    /* =====================================================
       IMAGE VIEWER ELEMENTS
    ====================================================== */

    const viewer =
        document.getElementById(
            "postImageViewer"
        );


    const viewerImage =
        document.getElementById(
            "postViewerImage"
        );


    const closeViewer =
        document.getElementById(
            "closePostImageViewer"
        );


    const previousButton =
        document.getElementById(
            "previousPostImage"
        );


    const nextButton =
        document.getElementById(
            "nextPostImage"
        );


    const counter =
        document.getElementById(
            "postImageViewerCounter"
        );


    let currentImageIndex =
        0;


    /* =====================================================
       SHOW IMAGE
    ====================================================== */

    function showImage(index) {

        if (
            !postImages.length ||
            !viewer ||
            !viewerImage
        ) {

            return;

        }


        currentImageIndex =
            (
                index +
                postImages.length
            ) %
            postImages.length;


        viewerImage.src =
            getImageUrl(
                postImages[currentImageIndex]
            );


        if (counter) {

            counter.textContent =
                (
                    currentImageIndex + 1
                ) +
                " / " +
                postImages.length;

        }


        if (previousButton) {

            previousButton.style.display =
                postImages.length > 1
                    ? "flex"
                    : "none";

        }


        if (nextButton) {

            nextButton.style.display =
                postImages.length > 1
                    ? "flex"
                    : "none";

        }

    }


    /* =====================================================
       OPEN VIEWER
    ====================================================== */

    function openViewer(index) {

        if (!viewer) {

            return;

        }


        showImage(index);


        viewer.classList.add(
            "active"
        );


        viewer.setAttribute(
            "aria-hidden",
            "false"
        );


        document.body.style.overflow =
            "hidden";

    }


    /* =====================================================
       CLOSE VIEWER
    ====================================================== */

    function closeImageViewer() {

        if (!viewer) {

            return;

        }


        viewer.classList.remove(
            "active"
        );


        viewer.setAttribute(
            "aria-hidden",
            "true"
        );


        viewerImage.src =
            "";


        document.body.style.overflow =
            "";

    }


    /* =====================================================
       IMAGE BUTTONS
    ====================================================== */

    const imageButtons =
        document.querySelectorAll(
            '.feed-post-image-button[data-post-id="' +
            postId +
            '"]'
        );


    imageButtons.forEach(
        function (button) {

            button.addEventListener(
                "click",
                function () {

                    const index =
                        Number(
                            button.dataset.imageIndex
                        );


                    openViewer(index);

                }
            );

        }
    );


    /* =====================================================
       CLOSE
    ====================================================== */

    if (closeViewer) {

        closeViewer.addEventListener(
            "click",
            closeImageViewer
        );

    }


    /* =====================================================
       PREVIOUS
    ====================================================== */

    if (previousButton) {

        previousButton.addEventListener(
            "click",
            function () {

                showImage(
                    currentImageIndex - 1
                );

            }
        );

    }


    /* =====================================================
       NEXT
    ====================================================== */

    if (nextButton) {

        nextButton.addEventListener(
            "click",
            function () {

                showImage(
                    currentImageIndex + 1
                );

            }
        );

    }


    /* =====================================================
       CLICK BACKDROP
    ====================================================== */

    if (viewer) {

        viewer.addEventListener(
            "click",
            function (event) {

                if (
                    event.target === viewer
                ) {

                    closeImageViewer();

                }

            }
        );

    }


    /* =====================================================
       KEYBOARD
    ====================================================== */

    document.addEventListener(
        "keydown",
        function (event) {

            if (
                !viewer ||
                !viewer.classList.contains(
                    "active"
                )
            ) {

                return;

            }


            if (
                event.key === "Escape"
            ) {

                closeImageViewer();

            }


            if (
                event.key === "ArrowLeft" &&
                postImages.length > 1
            ) {

                showImage(
                    currentImageIndex - 1
                );

            }


            if (
                event.key === "ArrowRight" &&
                postImages.length > 1
            ) {

                showImage(
                    currentImageIndex + 1
                );

            }

        }
    );


})();

</script>