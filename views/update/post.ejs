<!-- =========================================================
     POST
========================================================= -->

<article
    class="feed-post"
    data-post-id="<%= post._id %>"
>


    <!-- =====================================================
         POST HEADER
    ====================================================== -->

    <header class="feed-post-header">

        <div class="feed-post-user">

            <img
                src="<%= post.userImage || ('https://ui-avatars.com/api/?name=' + encodeURIComponent(post.userName || 'User')) %>"
                alt="<%= post.userName || 'User' %>"
                class="feed-post-avatar"
            >


            <div class="feed-post-user-info">

                <strong>
                    <%= post.userName || "User" %>
                </strong>

                <span>
                    <%= post.dateText || new Date(post.createdAt).toLocaleString() %>
                </span>

            </div>

        </div>


        <!-- =================================================
             DELETE
        ================================================== -->

        <% if (
            user &&
            (
                String(post.userId) === String(user._id) ||
                user.role === "admin"
            )
        ) { %>

            <button
                type="button"
                class="feed-post-menu-button"
                data-post-id="<%= post._id %>"
                aria-label="Post options"
            >

                <i class="bi bi-three-dots-vertical"></i>

            </button>

        <% } %>

    </header>



    <!-- =====================================================
         POST CONTENT
    ====================================================== -->

    <div class="feed-post-content">


        <!-- =================================================
             TITLE
        ================================================== -->

        <% if (post.title) { %>

            <h2 class="feed-post-title">

                <%= post.title %>

            </h2>

        <% } %>



        <!-- =================================================
             TEXT
        ================================================== -->

        <% if (post.text) { %>

            <div class="feed-post-text">

                <%= post.text %>

            </div>

        <% } %>



        <!-- =================================================
             IMAGES
        ================================================== -->

        <%
            const postImages =
                Array.isArray(post.images) &&
                post.images.length
                    ? post.images
                    : (
                        post.image
                            ? [post.image]
                            : []
                    );
        %>


        <% if (postImages.length > 0) { %>

            <div
                class="feed-post-images images-count-<%= Math.min(postImages.length, 4) %>"
            >

                <% postImages.forEach(
                    function (image, index) {
                %>

                    <div
                        class="feed-post-image-wrapper"
                        data-image-index="<%= index %>"
                    >

                        <img
                            src="/uploads/<%= image %>"
                            alt="Post image <%= index + 1 %>"
                            class="feed-post-image"
                            loading="lazy"
                        >

                    </div>

                <% }) %>

            </div>

        <% } %>

    </div>



    <!-- =====================================================
         POST ACTIONS
    ====================================================== -->

    <footer class="feed-post-actions">

        <button
            type="button"
            class="post-action-button like-post-button"
            data-post-id="<%= post._id %>"
            data-dairy-id="<%= post.dairy || dairy?._id || '' %>"
        >

            <i class="bi bi-heart"></i>

            <span class="post-like-count">
                <%= Array.isArray(post.likes)
                    ? post.likes.length
                    : (post.likes || 0)
                %>
            </span>

        </button>


        <button
            type="button"
            class="post-action-button comment-post-button"
            data-post-id="<%= post._id %>"
        >

            <i class="bi bi-chat"></i>

            <span>
                <%= Array.isArray(post.comments)
                    ? post.comments.length
                    : 0
                %>
            </span>

        </button>

    </footer>



    <!-- =====================================================
         COMMENTS
    ====================================================== -->

    <% if (
        Array.isArray(post.comments) &&
        post.comments.length
    ) { %>

        <div class="post-comments">

            <% post.comments.forEach(
                function (comment) {
            %>

                <div
                    class="post-comment"
                    data-comment-id="<%= comment._id %>"
                >

                    <img
                        src="<%= comment.userImage || ('https://ui-avatars.com/api/?name=' + encodeURIComponent(comment.userName || 'User')) %>"
                        alt="<%= comment.userName || 'User' %>"
                        class="comment-avatar"
                    >


                    <div class="comment-content">

                        <strong>
                            <%= comment.userName || "User" %>
                        </strong>


                        <p>
                            <%= comment.text %>
                        </p>


                        <span class="comment-date">

                            <%= comment.createdAt
                                ? new Date(
                                    comment.createdAt
                                ).toLocaleString()
                                : ""
                            %>

                        </span>

                    </div>

                </div>

            <% }) %>

        </div>

    <% } %>

</article>



<style>

/* =========================================================
   POST
========================================================= */

.feed-post {

    width: 100%;

    background: #ffffff;

    border: 1px solid #e5ebe7;

    border-radius: 16px;

    margin-bottom: 16px;

    overflow: hidden;

}



/* =========================================================
   HEADER
========================================================= */

.feed-post-header {

    display: flex;

    align-items: center;

    justify-content: space-between;

    padding: 14px 16px 10px;

}


.feed-post-user {

    display: flex;

    align-items: center;

    gap: 10px;

    min-width: 0;

}


.feed-post-avatar {

    width: 42px;

    height: 42px;

    border-radius: 50%;

    object-fit: cover;

    flex-shrink: 0;

}


.feed-post-user-info {

    min-width: 0;

    display: flex;

    flex-direction: column;

}


.feed-post-user-info strong {

    color: #202520;

    font-size: 14px;

}


.feed-post-user-info span {

    margin-top: 2px;

    color: #858d88;

    font-size: 11px;

}


.feed-post-menu-button {

    width: 38px;

    height: 38px;

    border: none;

    background: transparent;

    color: #777f7a;

    display: flex;

    align-items: center;

    justify-content: center;

    cursor: pointer;

    font-size: 20px;

}



/* =========================================================
   CONTENT
========================================================= */

.feed-post-content {

    padding:
        4px
        16px
        16px;

}


.feed-post-title {

    margin:
        4px
        0
        8px;

    font-size: 21px;

    line-height: 1.3;

    font-weight: 700;

    color: #202520;

    overflow-wrap: anywhere;

}


.feed-post-text {

    font-size: 15px;

    line-height: 1.6;

    color: #3f4742;

    white-space: pre-wrap;

    overflow-wrap: anywhere;

    margin-bottom: 14px;

}



/* =========================================================
   IMAGES
========================================================= */

.feed-post-images {

    width: 100%;

    display: grid;

    gap: 4px;

    overflow: hidden;

    border-radius: 12px;

}


.feed-post-image-wrapper {

    position: relative;

    min-width: 0;

    overflow: hidden;

    background: #f2f5f3;

}


.feed-post-image {

    width: 100%;

    height: 100%;

    display: block;

    object-fit: cover;

}



/* =========================================================
   ONE IMAGE
========================================================= */

.feed-post-images.images-count-1 {

    grid-template-columns: 1fr;

}


.feed-post-images.images-count-1
.feed-post-image-wrapper {

    max-height: 600px;

}


.feed-post-images.images-count-1
.feed-post-image {

    max-height: 600px;

    object-fit: contain;

}



/* =========================================================
   TWO IMAGES
========================================================= */

.feed-post-images.images-count-2 {

    grid-template-columns:
        repeat(2, 1fr);

}


.feed-post-images.images-count-2
.feed-post-image-wrapper {

    aspect-ratio: 1 / 1;

}



/* =========================================================
   THREE IMAGES
========================================================= */

.feed-post-images.images-count-3 {

    grid-template-columns:
        repeat(2, 1fr);

}


.feed-post-images.images-count-3
.feed-post-image-wrapper:first-child {

    grid-row:
        span 2;

    aspect-ratio:
        1 / 1;

}


.feed-post-images.images-count-3
.feed-post-image-wrapper:not(:first-child) {

    aspect-ratio:
        1 / 1;

}



/* =========================================================
   FOUR OR MORE
========================================================= */

.feed-post-images.images-count-4 {

    grid-template-columns:
        repeat(2, 1fr);

}


.feed-post-images.images-count-4
.feed-post-image-wrapper {

    aspect-ratio:
        1 / 1;

}



/* =========================================================
   ACTIONS
========================================================= */

.feed-post-actions {

    display: flex;

    align-items: center;

    gap: 6px;

    padding:
        8px
        12px;

    border-top:
        1px solid #edf1ee;

}


.post-action-button {

    min-height: 38px;

    padding:
        0
        10px;

    border: none;

    background: transparent;

    color: #68716b;

    display: flex;

    align-items: center;

    gap: 6px;

    cursor: pointer;

    font-size: 14px;

}


.post-action-button i {

    font-size: 18px;

}



/* =========================================================
   COMMENTS
========================================================= */

.post-comments {

    border-top:
        1px solid #edf1ee;

    padding:
        10px
        16px
        14px;

}


.post-comment {

    display: flex;

    gap: 9px;

    margin-bottom: 12px;

}


.post-comment:last-child {

    margin-bottom: 0;

}


.comment-avatar {

    width: 32px;

    height: 32px;

    border-radius: 50%;

    object-fit: cover;

    flex-shrink: 0;

}


.comment-content {

    min-width: 0;

}


.comment-content strong {

    display: block;

    font-size: 12px;

    color: #252b27;

}


.comment-content p {

    margin:
        2px
        0;

    font-size: 13px;

    line-height: 1.45;

    color: #4e5651;

    white-space: pre-wrap;

    overflow-wrap: anywhere;

}


.comment-date {

    font-size: 10px;

    color: #909792;

}



/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 600px) {

    .feed-post-title {

        font-size: 19px;

    }


    .feed-post-text {

        font-size: 14px;

    }


    .feed-post-header {

        padding:
            12px
            12px
            8px;

    }


    .feed-post-content {

        padding:
            4px
            12px
            12px;

    }

}

</style>