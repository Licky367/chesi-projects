<!-- =========================================================
     NORMAL FEED POST
========================================================= -->

<article
    class="feed-post"
    data-post-id="<%= post._id %>"
    data-dairy-id="<%= post.dairy %>"
>


    <!-- =====================================================
         POST HEADER
    ====================================================== -->

    <header class="feed-post-header">


        <!-- USER AVATAR -->
        <div class="feed-post-avatar">

            <img
                src="<%= post.userImage || ('https://ui-avatars.com/api/?name=' + encodeURIComponent(post.userName || 'User')) %>"
                alt="<%= post.userName || 'User' %>"
            >

        </div>


        <!-- USER INFORMATION -->
        <div class="feed-post-user">

            <strong>
                <%= post.userName || "User" %>
            </strong>

            <span>
                <%= new Date(post.createdAt).toLocaleString() %>
            </span>

        </div>


        <!-- DELETE -->
        <% if (
            user &&
            (
                (
                    post.user &&
                    user._id &&
                    post.user.toString() === user._id.toString()
                ) ||
                user.role === "admin"
            )
        ) { %>

            <button
                type="button"
                class="feed-post-delete"
                data-post-id="<%= post._id %>"
                aria-label="Delete post"
                title="Delete post"
            >

                <i class="bi bi-trash3"></i>

            </button>

        <% } %>

    </header>



    <!-- =====================================================
         POST CONTENT
    ====================================================== -->

    <div class="feed-post-content">


        <!-- =================================================
             TITLE
        ================================================== -->

        <% if (post.title) { %>

            <h3 class="feed-post-title">

                <%= post.title %>

            </h3>

        <% } %>



        <!-- =================================================
             TEXT
        ================================================== -->

        <% if (post.text) { %>

            <div class="feed-post-text">

                <%= post.text %>

            </div>

        <% } %>



        <!-- =================================================
             IMAGES
        ================================================== -->

        <%
            const postImages =
                Array.isArray(post.images) &&
                post.images.length
                    ? post.images
                    : (
                        post.image
                            ? [post.image]
                            : []
                    );
        %>


        <% if (postImages.length) { %>

            <div
                class="feed-post-images
                <% if (postImages.length === 1) { %>
                    single-image
                <% } else if (postImages.length === 2) { %>
                    two-images
                <% } else { %>
                    multiple-images
                <% } %>"
            >

                <% postImages.forEach(function(image, index) { %>

                    <div
                        class="feed-post-image"
                        data-image-index="<%= index %>"
                    >

                        <img
                            src="/uploads/<%= image %>"
                            alt="Post image <%= index + 1 %>"
                            loading="lazy"
                        >

                    </div>

                <% }) %>

            </div>

        <% } %>

    </div>



    <!-- =====================================================
         POST ACTIONS
    ====================================================== -->

    <footer class="feed-post-actions">


        <!-- LIKE -->
        <button
            type="button"
            class="feed-post-action like-post-button"
            data-post-id="<%= post._id %>"
            data-dairy-id="<%= post.dairy %>"
        >

            <i class="bi bi-heart"></i>

            <span class="like-count">
                <%= Array.isArray(post.likes) ? post.likes.length : 0 %>
            </span>

        </button>


        <!-- COMMENT -->
        <button
            type="button"
            class="feed-post-action comment-post-button"
            data-post-id="<%= post._id %>"
        >

            <i class="bi bi-chat"></i>

            <span class="comment-count">
                <%= Array.isArray(post.comments) ? post.comments.length : 0 %>
            </span>

        </button>

    </footer>



    <!-- =====================================================
         COMMENTS
    ====================================================== -->

    <% if (
        Array.isArray(post.comments) &&
        post.comments.length
    ) { %>

        <div class="feed-post-comments">

            <% post.comments.forEach(function(comment) { %>

                <div
                    class="feed-post-comment"
                    data-comment-id="<%= comment._id %>"
                >

                    <img
                        class="comment-avatar"
                        src="<%= comment.userImage || ('https://ui-avatars.com/api/?name=' + encodeURIComponent(comment.userName || 'User')) %>"
                        alt="<%= comment.userName || 'User' %>"
                    >


                    <div class="comment-content">

                        <strong>
                            <%= comment.userName || "User" %>
                        </strong>

                        <p>
                            <%= comment.text %>
                        </p>

                        <span class="comment-date">

                            <%= new Date(
                                comment.createdAt
                            ).toLocaleString() %>

                        </span>

                    </div>

                </div>

            <% }) %>

        </div>

    <% } %>

</article>



<style>

/* =========================================================
   FEED POST
========================================================= */

.feed-post {

    width: 100%;

    background: #ffffff;

    border: 1px solid #e5ebe7;

    border-radius: 16px;

    margin-bottom: 16px;

    overflow: hidden;

    box-sizing: border-box;

}



/* =========================================================
   HEADER
========================================================= */

.feed-post-header {

    display: flex;

    align-items: center;

    gap: 10px;

    padding: 14px 16px;

}


.feed-post-avatar {

    flex: 0 0 42px;

}


.feed-post-avatar img {

    width: 42px;

    height: 42px;

    border-radius: 50%;

    object-fit: cover;

    display: block;

}


.feed-post-user {

    min-width: 0;

    flex: 1;

    display: flex;

    flex-direction: column;

}


.feed-post-user strong {

    font-size: 14px;

    color: #202520;

    line-height: 1.3;

}


.feed-post-user span {

    margin-top: 2px;

    font-size: 11px;

    color: #858d88;

}


.feed-post-delete {

    width: 38px;

    height: 38px;

    border: none;

    background: transparent;

    color: #8b928d;

    border-radius: 50%;

    display: flex;

    align-items: center;

    justify-content: center;

    cursor: pointer;

    font-size: 17px;

}


.feed-post-delete:hover {

    color: #c62828;

    background: #fff5f5;

}



/* =========================================================
   CONTENT
========================================================= */

.feed-post-content {

    padding:
        0
        16px
        16px;

}


.feed-post-title {

    margin:
        0
        0
        8px;

    font-size: 20px;

    line-height: 1.3;

    color: #202520;

    font-weight: 700;

}


.feed-post-text {

    white-space: pre-wrap;

    word-break: break-word;

    font-size: 15px;

    line-height: 1.55;

    color: #444b46;

}



/* =========================================================
   IMAGE GRID
========================================================= */

.feed-post-images {

    width: 100%;

    margin-top: 14px;

    display: grid;

    gap: 4px;

    overflow: hidden;

    border-radius: 12px;

}


.feed-post-images.single-image {

    grid-template-columns: 1fr;

}


.feed-post-images.two-images {

    grid-template-columns:
        repeat(2, minmax(0, 1fr));

}


.feed-post-images.multiple-images {

    grid-template-columns:
        repeat(2, minmax(0, 1fr));

}


.feed-post-image {

    position: relative;

    width: 100%;

    aspect-ratio: 1 / 1;

    overflow: hidden;

    background: #f2f4f2;

    cursor: pointer;

}


.feed-post-images.single-image
.feed-post-image {

    aspect-ratio: auto;

    max-height: 600px;

}


.feed-post-image img {

    display: block;

    width: 100%;

    height: 100%;

    object-fit: cover;

}



/* =========================================================
   ACTIONS
========================================================= */

.feed-post-actions {

    min-height: 48px;

    display: flex;

    align-items: center;

    gap: 6px;

    padding:
        0
        12px;

    border-top: 1px solid #edf1ee;

}


.feed-post-action {

    min-width: 70px;

    height: 40px;

    border: none;

    background: transparent;

    color: #68716b;

    display: flex;

    align-items: center;

    justify-content: center;

    gap: 6px;

    border-radius: 20px;

    cursor: pointer;

    font-size: 14px;

}


.feed-post-action:hover {

    background: #f4f7f5;

}


.feed-post-action i {

    font-size: 18px;

}


.like-post-button.liked {

    color: #198754;

}



/* =========================================================
   COMMENTS
========================================================= */

.feed-post-comments {

    border-top: 1px solid #edf1ee;

    padding:
        10px
        16px
        14px;

}


.feed-post-comment {

    display: flex;

    gap: 9px;

    padding: 7px 0;

}


.comment-avatar {

    flex: 0 0 32px;

    width: 32px;

    height: 32px;

    border-radius: 50%;

    object-fit: cover;

}


.comment-content {

    min-width: 0;

    flex: 1;

}


.comment-content strong {

    display: block;

    font-size: 13px;

    color: #202520;

}


.comment-content p {

    margin:
        2px
        0
        2px;

    font-size: 13px;

    line-height: 1.45;

    color: #505852;

    white-space: pre-wrap;

    word-break: break-word;

}


.comment-date {

    font-size: 10px;

    color: #969d98;

}



/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 600px) {

    .feed-post {

        border-radius: 12px;

    }


    .feed-post-header {

        padding:
            12px;

    }


    .feed-post-content {

        padding:
            0
            12px
            12px;

    }


    .feed-post-title {

        font-size: 18px;

    }


    .feed-post-text {

        font-size: 14px;

    }


    .feed-post-images {

        margin-top: 12px;

    }


    .feed-post-actions {

        padding:
            0
            8px;

    }

}

</style>