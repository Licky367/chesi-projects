<!-- =========================================================
     POST FEED CARD

     FILE:
     views/update/post.ejs

     FEATURES:
     ---------------------------------------------------------
     • Modern post-card design
     • User header
     • Clickable dairy/farm name
     • Post title
     • 100-character text preview
     • "See more" expansion
     • Full readable expanded post
     • Up to 4 images in feed
     • +N indicator for additional images
     • Full-screen image viewer
     • Swipeable image viewer on mobile
     • Previous / next image controls
     • Existing feed-actions compatibility
     • Comment modal
     • Delete post
     • Delete comment

     EXPECTED VARIABLES:
     ---------------------------------------------------------
     item
     user

     OPTIONAL:
     type
========================================================= -->


<%
/* =========================================================
   SAFE VALUES
========================================================= */

const postType =
    typeof type !== "undefined" && type
        ? type
        : "post";


/* =========================================================
   LIKES
========================================================= */

const likes =
    Array.isArray(item.likes)
        ? item.likes.length
        : Number(item.likes || 0);


/* =========================================================
   COMMENTS
========================================================= */

const comments =
    Array.isArray(item.comments)
        ? item.comments
        : [];


/* =========================================================
   USER ID
========================================================= */

const postUserId =
    item.user
        ? String(
            item.user._id ||
            item.user
        )
        : "";


const currentUserId =
    user && user._id
        ? String(user._id)
        : "";


/* =========================================================
   DELETE PERMISSION
========================================================= */

const canDeletePost =
    user &&
    (
        postUserId === currentUserId ||
        user.role === "admin"
    );


/* =========================================================
   POST TEXT
========================================================= */

const fullPostText =
    item.text
        ? String(item.text).trim()
        : "";


/* =========================================================
   LONG TEXT
========================================================= */

const isLongPost =
    fullPostText.length > 100;


/* =========================================================
   TEXT PREVIEW

   Only used when text exceeds 100 characters.
========================================================= */

const postPreview =
    isLongPost
        ? fullPostText.substring(0, 100).trimEnd() + "…"
        : fullPostText;


/* =========================================================
   POST IMAGES

   Keep ALL images available to the full-screen viewer,
   but display only the first four in the feed.
========================================================= */

const postImages =
    Array.isArray(item.images)
        ? item.images.filter(Boolean)
        : (
            item.image
                ? [item.image]
                : []
        );


const visibleImages =
    postImages.slice(0, 4);


const additionalImages =
    Math.max(
        0,
        postImages.length - 4
    );


/* =========================================================
   DAIRY INFORMATION

   Supports both:
       dairyId / dairyName

   and, where available:
       dairy._id / dairy.name
========================================================= */

const dairyId =
    item.dairyId ||
    (
        item.dairy &&
        (
            item.dairy._id ||
            item.dairy
        )
    ) ||
    "";


const dairyName =
    item.dairyName ||
    (
        item.dairy &&
        item.dairy.name
    ) ||
    "";


/* =========================================================
   DATE
========================================================= */

const postDate =
    item.createdAt
        ? new Date(item.createdAt).toLocaleString()
        : (
            item.dateText ||
            ""
        );

%>



<!-- =========================================================
     POST CARD
========================================================= -->

<article
    class="feed-card post-card"
    data-feed-id="<%= item._id %>"
    data-post-id="<%= item._id %>"
    data-feed-type="<%= postType %>"
>


    <!-- =====================================================
         HEADER
    ====================================================== -->

    <header class="post-card-header">


        <!-- =================================================
             USER AVATAR
        ================================================== -->

        <div class="post-avatar">

            <img
                src="<%= item.userImage || ('https://ui-avatars.com/api/?name=' + encodeURIComponent(item.userName || 'User')) %>"
                alt="<%= item.userName || 'User' %>"
                loading="lazy"
            >

        </div>



        <!-- =================================================
             USER INFORMATION
        ================================================== -->

        <div class="post-user-info">

            <strong class="post-user-name">

                <%= item.userName || "User" %>

            </strong>


            <span class="post-date">

                <%= postDate %>

            </span>

        </div>



        <!-- =================================================
             DELETE
        ================================================== -->

        <% if (canDeletePost) { %>

            <button
                type="button"
                class="post-menu-button delete-post"
                data-id="<%= item._id %>"
                data-type="post"
                aria-label="Delete post"
                title="Delete post"
            >

                <i
                    class="bi bi-trash3"
                    aria-hidden="true"
                ></i>

            </button>

        <% } %>


    </header>



    <!-- =====================================================
         POST BODY
    ====================================================== -->

    <div class="post-content">


        <!-- =================================================
             DAIRY / FARM NAME
        ================================================== -->

        <% if (dairyName && dairyId) { %>

            <a
                href="/dairy/<%= dairyId %>"
                class="post-dairy-link"
                title="View <%= dairyName %>"
            >

                <i
                    class="bi bi-building"
                    aria-hidden="true"
                ></i>

                <span>
                    <%= dairyName %>
                </span>

            </a>

        <% } else if (dairyName) { %>

            <div class="post-dairy-link non-clickable">

                <i
                    class="bi bi-building"
                    aria-hidden="true"
                ></i>

                <span>
                    <%= dairyName %>
                </span>

            </div>

        <% } %>



        <!-- =================================================
             TITLE
        ================================================== -->

        <% if (
            item.title &&
            String(item.title).trim()
        ) { %>

            <h2 class="post-title">

                <%= item.title %>

            </h2>

        <% } %>



        <!-- =================================================
             TEXT
        ================================================== -->

        <% if (fullPostText) { %>

            <div
                class="
                    post-text-area
                    <%= isLongPost ? 'post-text-is-long' : '' %>
                "
            >


                <% if (isLongPost) { %>

                    <div
                        class="post-text post-text-preview"
                    >

                        <%= postPreview %>

                    </div>


                    <button
                        type="button"
                        class="post-see-more"
                        data-post-expand="<%= item._id %>"
                    >

                        See more

                        <i
                            class="bi bi-arrow-right"
                            aria-hidden="true"
                        ></i>

                    </button>


                <% } else { %>


                    <div class="post-text">

                        <%= fullPostText %>

                    </div>


                <% } %>


            </div>

        <% } %>



        <!-- =================================================
             IMAGE GRID
        ================================================== -->

        <% if (visibleImages.length > 0) { %>


            <div
                class="
                    post-image-grid
                    post-image-count-<%= visibleImages.length %>
                "
                data-photo-count="<%= postImages.length %>"
            >


                <% visibleImages.forEach(function(image, index) { %>


                    <button
                        type="button"
                        class="post-image-item"
                        data-photo-index="<%= index %>"
                        aria-label="Open photo <%= index + 1 %>"
                    >


                        <img
                            src="/uploads/<%= image %>"
                            alt="Post photo <%= index + 1 %>"
                            class="post-image"
                            loading="lazy"
                        >


                        <!-- =================================
                             +N OVERLAY
                        ================================== -->

                        <% if (
                            index === 3 &&
                            additionalImages > 0
                        ) { %>

                            <span class="post-more-images">

                                <i
                                    class="bi bi-images"
                                    aria-hidden="true"
                                ></i>

                                <strong>
                                    +<%= additionalImages %>
                                </strong>

                            </span>

                        <% } %>


                    </button>


                <% }); %>


            </div>


        <% } %>


    </div>



    <!-- =====================================================
         FEED ACTIONS

         IMPORTANT:
         Existing class names are preserved.
    ====================================================== -->

    <div
        class="feed-actions post-actions"
        data-feed-id="<%= item._id %>"
        data-feed-type="<%= postType %>"
    >


        <!-- =================================================
             LIKE
        ================================================== -->

        <button
            type="button"
            class="like-btn"
            data-id="<%= item._id %>"
            data-type="<%= postType %>"
            aria-label="Like"
        >

            <i
                class="bi bi-hand-thumbs-up-fill"
                aria-hidden="true"
            ></i>

            <span class="like-count">

                <%= likes %>

            </span>

        </button>



        <!-- =================================================
             COMMENTS
        ================================================== -->

        <button
            type="button"
            class="toggle-comments"
            aria-label="Comments"
        >

            <i
                class="bi bi-chat-dots-fill"
                aria-hidden="true"
            ></i>

            <span class="comment-count">

                <%= comments.length %>

            </span>

        </button>


    </div>



    <!-- =====================================================
         EXPANDED POST MODAL

         IMPORTANT:
         This is NOT the grey overlay shown previously.

         The actual post remains clearly visible inside
         a white, readable card.
    ====================================================== -->

    <% if (isLongPost) { %>

        <div
            class="post-expand-modal"
            data-post-expand-modal="<%= item._id %>"
            aria-hidden="true"
        >


            <div
                class="post-expand-backdrop"
                data-close-post-expand
            ></div>


            <div
                class="post-expand-card"
                role="dialog"
                aria-modal="true"
                aria-label="Expanded post"
            >


                <!-- =========================================
                     EXPANDED HEADER
                ========================================== -->

                <header class="post-expand-header">


                    <div class="post-expand-user">


                        <img
                            src="<%= item.userImage || ('https://ui-avatars.com/api/?name=' + encodeURIComponent(item.userName || 'User')) %>"
                            alt="<%= item.userName || 'User' %>"
                            loading="lazy"
                        >


                        <div>

                            <strong>
                                <%= item.userName || "User" %>
                            </strong>

                            <small>
                                <%= postDate %>
                            </small>

                        </div>


                    </div>


                    <button
                        type="button"
                        class="post-expand-close"
                        data-close-post-expand
                        aria-label="Close post"
                    >

                        <i
                            class="bi bi-x-lg"
                            aria-hidden="true"
                        ></i>

                    </button>


                </header>



                <!-- =========================================
                     EXPANDED BODY
                ========================================== -->

                <div class="post-expand-body">


                    <% if (dairyName && dairyId) { %>

                        <a
                            href="/dairy/<%= dairyId %>"
                            class="post-dairy-link expanded-dairy-link"
                        >

                            <i
                                class="bi bi-building"
                                aria-hidden="true"
                            ></i>

                            <span>
                                <%= dairyName %>
                            </span>

                        </a>

                    <% } %>



                    <% if (
                        item.title &&
                        String(item.title).trim()
                    ) { %>

                        <h2 class="post-expand-title">

                            <%= item.title %>

                        </h2>

                    <% } %>



                    <div class="post-expand-text">

                        <%= fullPostText %>

                    </div>



                    <!-- =====================================
                         EXPANDED IMAGES
                    ====================================== -->

                    <% if (postImages.length > 0) { %>

                        <div class="post-expand-images">


                            <% postImages.forEach(function(image, index) { %>

                                <button
                                    type="button"
                                    class="post-expand-image"
                                    data-photo-index="<%= index %>"
                                >

                                    <img
                                        src="/uploads/<%= image %>"
                                        alt="Post photo <%= index + 1 %>"
                                        loading="lazy"
                                    >

                                </button>

                            <% }); %>


                        </div>

                    <% } %>


                </div>


            </div>


        </div>

    <% } %>



    <!-- =====================================================
         FULL-SCREEN PHOTO VIEWER
    ====================================================== -->

    <% if (postImages.length > 0) { %>


        <div
            class="post-photo-viewer"
            data-photo-viewer="<%= item._id %>"
            aria-hidden="true"
        >


            <!-- =============================================
                 BACKDROP
            ============================================== -->

            <div
                class="photo-viewer-backdrop"
                data-close-photo-viewer
            ></div>



            <!-- =============================================
                 TOP BAR
            ============================================== -->

            <div class="photo-viewer-topbar">


                <span class="photo-viewer-counter">

                    <span class="photo-current">
                        1
                    </span>

                    /

                    <span>
                        <%= postImages.length %>
                    </span>

                </span>


                <button
                    type="button"
                    class="photo-viewer-close"
                    data-close-photo-viewer
                    aria-label="Close photo viewer"
                >

                    <i
                        class="bi bi-x-lg"
                        aria-hidden="true"
                    ></i>

                </button>


            </div>



            <!-- =============================================
                 PREVIOUS
            ============================================== -->

            <% if (postImages.length > 1) { %>

                <button
                    type="button"
                    class="photo-viewer-nav photo-viewer-prev"
                    data-photo-prev
                    aria-label="Previous photo"
                >

                    <i
                        class="bi bi-chevron-left"
                        aria-hidden="true"
                    ></i>

                </button>

            <% } %>



            <!-- =============================================
                 PHOTO
            ============================================== -->

            <div class="photo-viewer-stage">


                <img
                    class="photo-viewer-image"
                    src="/uploads/<%= postImages[0] %>"
                    alt="Post photo"
                >


            </div>



            <!-- =============================================
                 NEXT
            ============================================== -->

            <% if (postImages.length > 1) { %>

                <button
                    type="button"
                    class="photo-viewer-nav photo-viewer-next"
                    data-photo-next
                    aria-label="Next photo"
                >

                    <i
                        class="bi bi-chevron-right"
                        aria-hidden="true"
                    ></i>

                </button>

            <% } %>


        </div>


    <% } %>



    <!-- =====================================================
         COMMENT MODAL
    ====================================================== -->

    <div
        class="comment-modal"
        aria-hidden="true"
    >


        <div class="comment-modal-content">


            <!-- =============================================
                 COMMENT HEADER
            ============================================== -->

            <header class="comment-modal-header">


                <div class="comment-modal-title">

                    <strong>
                        Comments
                    </strong>

                    <span>
                        <%= comments.length %>
                    </span>

                </div>


                <button
                    type="button"
                    class="close-comment-modal"
                    aria-label="Close comments"
                >

                    <i
                        class="bi bi-x-lg"
                        aria-hidden="true"
                    ></i>

                </button>


            </header>



            <!-- =============================================
                 COMMENT LIST
            ============================================== -->

            <div class="comment-section">


                <% if (comments.length === 0) { %>

                    <div class="comment-empty-state">

                        <i class="bi bi-chat-dots"></i>

                        <span>
                            No comments yet.
                        </span>

                        <small>
                            Be the first to comment.
                        </small>

                    </div>

                <% } %>



                <% comments.forEach(function(comment) { %>


                    <div
                        class="comment-item"
                        data-comment-id="<%= comment._id %>"
                    >


                        <div class="comment-user-avatar">

                            <img
                                src="<%= comment.userImage || ('https://ui-avatars.com/api/?name=' + encodeURIComponent(comment.userName || 'User')) %>"
                                alt="<%= comment.userName || 'User' %>"
                                loading="lazy"
                            >

                        </div>



                        <div class="comment-content">


                            <div class="comment-top-row">


                                <strong class="comment-user-name">

                                    <%= comment.userName || "User" %>

                                </strong>


                                <%
                                    const commentUserId =
                                        comment.userId
                                            ? String(
                                                comment.userId._id ||
                                                comment.userId
                                            )
                                            : "";


                                    const canDeleteComment =
                                        user &&
                                        (
                                            commentUserId === currentUserId ||
                                            user.role === "admin"
                                        );
                                %>


                                <% if (canDeleteComment) { %>

                                    <button
                                        type="button"
                                        class="delete-comment"
                                        data-id="<%= comment._id %>"
                                        aria-label="Delete comment"
                                        title="Delete comment"
                                    >

                                        <i
                                            class="bi bi-trash3"
                                            aria-hidden="true"
                                        ></i>

                                    </button>

                                <% } %>


                            </div>


                            <p class="comment-text">

                                <%= comment.text %>

                            </p>


                            <small class="comment-date">

                                <%= comment.createdAt
                                    ? new Date(comment.createdAt).toLocaleString()
                                    : ""
                                %>

                            </small>


                        </div>


                    </div>


                <% }); %>


            </div>



            <!-- =============================================
                 COMMENT COMPOSER
            ============================================== -->

            <div class="comment-composer-wrapper">


                <form
                    class="comment-form"
                    data-id="<%= item._id %>"
                    data-type="<%= postType %>"
                >


                    <div class="comment-composer">


                        <div class="comment-input-wrapper">

                            <textarea
                                name="text"
                                rows="1"
                                maxlength="500"
                                placeholder="Write a comment..."
                                aria-label="Write a comment"
                            ></textarea>

                        </div>


                        <button
                            type="submit"
                            class="comment-submit-button"
                            aria-label="Send comment"
                        >

                            <i class="bi bi-send-fill"></i>

                        </button>


                    </div>


                </form>


            </div>


        </div>


    </div>


</article>



<!-- =========================================================
     POST CSS
========================================================= -->

<style>

/* =========================================================
   CARD
========================================================= */

.feed-card.post-card {

    width: 100%;

    box-sizing: border-box;

    margin: 0 0 16px;

    background: #ffffff;

    border:
        1px solid
        #e4ebe6;

    border-radius: 18px;

    overflow: hidden;

    box-shadow:
        0 2px 8px
        rgba(24, 42, 30, 0.045);

    transition:
        box-shadow 0.2s ease,
        transform 0.2s ease;

}


.feed-card.post-card:hover {

    box-shadow:
        0 8px 24px
        rgba(24, 42, 30, 0.08);

}



/* =========================================================
   HEADER
========================================================= */

.post-card-header {

    width: 100%;

    min-height: 66px;

    box-sizing: border-box;

    padding:
        12px
        14px;

    display: flex;

    align-items: center;

    gap: 10px;

}


.post-avatar {

    width: 44px;
    height: 44px;

    flex:
        0 0 44px;

}


.post-avatar img {

    width: 44px;
    height: 44px;

    display: block;

    object-fit: cover;

    border-radius: 50%;

    border:
        2px solid
        #edf5ef;

}


.post-user-info {

    flex: 1;

    min-width: 0;

    display: flex;

    flex-direction: column;

    justify-content: center;

}


.post-user-name {

    display: block;

    overflow: hidden;

    text-overflow: ellipsis;

    white-space: nowrap;

    color: #172019;

    font-size: 14px;

    font-weight: 700;

    line-height: 1.25;

}


.post-date {

    display: block;

    margin-top: 3px;

    color: #89928c;

    font-size: 11px;

    line-height: 1.2;

}


.post-menu-button {

    width: 38px;
    height: 38px;

    flex:
        0 0 38px;

    padding: 0;

    border: none;

    border-radius: 50%;

    background: transparent;

    color: #7c867f;

    display: flex;

    align-items: center;

    justify-content: center;

    cursor: pointer;

    font-size: 17px;

    transition:
        background 0.15s ease,
        color 0.15s ease;

}


.post-menu-button:hover {

    color: #c62828;

    background: #fff1f1;

}



/* =========================================================
   CONTENT
========================================================= */

.post-content {

    width: 100%;

    box-sizing: border-box;

    padding:
        0
        14px
        14px;

}


/* =========================================================
   DAIRY LINK
========================================================= */

.post-dairy-link {

    width: fit-content;

    max-width: 100%;

    margin:
        0 0 7px;

    padding:
        0;

    display: inline-flex;

    align-items: center;

    gap: 5px;

    color: #198754;

    text-decoration: none;

    font-size: 13px;

    font-weight: 700;

    line-height: 1.3;

}


.post-dairy-link i {

    font-size: 13px;

}


.post-dairy-link span {

    overflow: hidden;

    text-overflow: ellipsis;

    white-space: nowrap;

}


a.post-dairy-link:hover {

    color: #146c43;

    text-decoration: underline;

}


.post-dairy-link.non-clickable {

    cursor: default;

}



/* =========================================================
   TITLE
========================================================= */

.post-title {

    margin:
        0
        0
        7px;

    padding: 0;

    color: #18201b;

    font-size: 21px;

    font-weight: 800;

    line-height: 1.28;

    letter-spacing:
        -0.3px;

    word-break: break-word;

}



/* =========================================================
   TEXT
========================================================= */

.post-text-area {

    margin: 0;

    padding: 0;

}


.post-text {

    margin: 0;

    padding: 0;

    color: #303833;

    font-size: 15px;

    font-weight: 400;

    line-height: 1.55;

    white-space: pre-wrap;

    word-break: break-word;

}


.post-text-preview {

    margin: 0;

    padding: 0;

}


/* =========================================================
   SEE MORE

   No giant gap above or below.
========================================================= */

.post-see-more {

    display: inline-flex;

    align-items: center;

    gap: 5px;

    margin:
        5px
        0
        0;

    padding: 0;

    border: none;

    background: transparent;

    color: #198754;

    font-family: inherit;

    font-size: 14px;

    font-weight: 750;

    line-height: 1.3;

    cursor: pointer;

}


.post-see-more i {

    font-size: 12px;

    transition:
        transform 0.15s ease;

}


.post-see-more:hover {

    color: #146c43;

}


.post-see-more:hover i {

    transform:
        translateX(2px);

}



/* =========================================================
   IMAGE GRID
========================================================= */

.post-image-grid {

    width: 100%;

    margin:
        13px
        0
        0;

    display: grid;

    grid-template-columns:
        repeat(
            2,
            minmax(0, 1fr)
        );

    gap: 3px;

    overflow: hidden;

    border-radius: 14px;

    background: #f0f3f1;

}


.post-image-item {

    position: relative;

    display: block;

    width: 100%;

    min-width: 0;

    aspect-ratio: 1 / 1;

    padding: 0;

    border: none;

    background: #eef2ef;

    overflow: hidden;

    cursor: pointer;

}


.post-image-item::after {

    content: "";

    position: absolute;

    inset: 0;

    background:
        rgba(0, 0, 0, 0);

    transition:
        background 0.15s ease;

}


.post-image-item:hover::after {

    background:
        rgba(0, 0, 0, 0.08);

}


.post-image {

    width: 100%;

    height: 100%;

    display: block;

    object-fit: cover;

    transition:
        transform 0.25s ease;

}


.post-image-item:hover .post-image {

    transform:
        scale(1.025);

}



/* =========================================================
   ONE IMAGE
========================================================= */

.post-image-count-1 {

    grid-template-columns: 1fr;

}


.post-image-count-1
.post-image-item {

    aspect-ratio: auto;

    max-height: 650px;

}


.post-image-count-1
.post-image {

    height: auto;

    max-height: 650px;

    object-fit: contain;

}



/* =========================================================
   THREE IMAGE LAYOUT
========================================================= */

.post-image-count-3 {

    grid-template-columns:
        1.35fr
        1fr;

}


.post-image-count-3
.post-image-item:first-child {

    grid-row:
        span 2;

}



/* =========================================================
   FOUR IMAGE LAYOUT
========================================================= */

.post-image-count-4 {

    grid-template-columns:
        repeat(2, 1fr);

}



/* =========================================================
   +N IMAGE OVERLAY
========================================================= */

.post-more-images {

    position: absolute;

    inset: 0;

    z-index: 3;

    display: flex;

    align-items: center;

    justify-content: center;

    gap: 7px;

