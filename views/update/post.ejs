<!-- =========================================================
     COREVESTER POST COMPONENT

     FILE:
     views/update/post.ejs

     PURPOSE:
     ---------------------------------------------------------
     Completely self-contained Facebook-style post card.

     IMPORTANT:
     ---------------------------------------------------------
     This component intentionally does NOT depend on:
       - feed.css
       - layout.css
       - generic .feed-* classes
       - generic .post-* classes
       - generic .like-btn
       - generic .toggle-comments
       - generic comment CSS

     All visual selectors use the unique:
         cpost-
     namespace.

     This prevents CSS collisions with the rest of the page.
========================================================= -->


<%
/* =========================================================
   SAFE POST TYPE
========================================================= */

const cpostType =
    typeof type !== "undefined" && type
        ? type
        : "post";


/* =========================================================
   LIKES
========================================================= */

const cpostLikes =
    Array.isArray(item.likes)
        ? item.likes.length
        : Number(item.likes || 0);


/* =========================================================
   COMMENTS
========================================================= */

const cpostComments =
    Array.isArray(item.comments)
        ? item.comments
        : [];


/* =========================================================
   USER IDS
========================================================= */

const cpostPostUserId =
    item.user
        ? String(
            item.user._id ||
            item.user
        )
        : "";


const cpostCurrentUserId =
    user && user._id
        ? String(user._id)
        : "";


/* =========================================================
   DELETE PERMISSION
========================================================= */

const cpostCanDelete =
    user &&
    (
        cpostPostUserId === cpostCurrentUserId ||
        user.role === "admin"
    );


/* =========================================================
   TITLE
========================================================= */

const cpostTitle =
    item.title
        ? String(item.title).trim()
        : "";


/* =========================================================
   TEXT
========================================================= */

const cpostFullText =
    item.text
        ? String(item.text).trim()
        : "";


/* =========================================================
   LONG POST
========================================================= */

const cpostIsLong =
    cpostFullText.length > 100;


/* =========================================================
   PREVIEW
========================================================= */

const cpostPreview =
    cpostIsLong
        ? cpostFullText.substring(0, 100).trimEnd() + "…"
        : cpostFullText;


/* =========================================================
   IMAGES
========================================================= */

const cpostImages =
    Array.isArray(item.images)
        ? item.images.filter(Boolean)
        : (
            item.image
                ? [item.image]
                : []
        );


const cpostVisibleImages =
    cpostImages.slice(0, 4);


const cpostAdditionalImages =
    Math.max(
        0,
        cpostImages.length - 4
    );


/* =========================================================
   DAIRY
========================================================= */

const cpostDairyId =
    item.dairyId ||
    (
        item.dairy &&
        (
            item.dairy._id ||
            item.dairy
        )
    ) ||
    "";


const cpostDairyName =
    item.dairyName ||
    (
        item.dairy &&
        item.dairy.name
    ) ||
    "";


/* =========================================================
   USER
========================================================= */

const cpostUserName =
    item.userName ||
    "User";


/* =========================================================
   USER IMAGE
========================================================= */

const cpostUserImage =
    item.userImage ||
    (
        "https://ui-avatars.com/api/?name=" +
        encodeURIComponent(cpostUserName)
    );


/* =========================================================
   DATE
========================================================= */

const cpostDate =
    item.createdAt
        ? new Date(item.createdAt).toLocaleString()
        : (
            item.dateText ||
            ""
        );

%>



<!-- =========================================================
     POST
========================================================= -->

<article
    class="cpost-card"
    data-cpost-id="<%= item._id %>"
    data-cpost-type="<%= cpostType %>"
>


    <!-- =====================================================
         HEADER
    ====================================================== -->

    <header class="cpost-header">


        <!-- AVATAR -->

        <div class="cpost-avatar">

            <img
                src="<%= cpostUserImage %>"
                alt="<%= cpostUserName %>"
                loading="lazy"
            >

        </div>



        <!-- HEADER INFORMATION -->

        <div class="cpost-header-info">


            <!-- USER + DAIRY -->

            <div class="cpost-header-main">

                <strong class="cpost-user">

                    <%= cpostUserName %>

                </strong>


                <% if (cpostDairyName) { %>

                    <span class="cpost-about">

                        about

                    </span>


                    <% if (cpostDairyId) { %>

                        <a
                            href="/dairy/<%= cpostDairyId %>"
                            class="cpost-dairy"
                            title="View <%= cpostDairyName %>"
                        >

                            <%= cpostDairyName %>

                        </a>

                    <% } else { %>

                        <span class="cpost-dairy">

                            <%= cpostDairyName %>

                        </span>

                    <% } %>

                <% } %>

            </div>



            <!-- DATE -->

            <% if (cpostDate) { %>

                <time class="cpost-date">

                    <%= cpostDate %>

                </time>

            <% } %>



            <!-- TITLE -->

            <% if (cpostTitle) { %>

                <div class="cpost-title">

                    <%= cpostTitle %>

                </div>

            <% } %>


        </div>



        <!-- DELETE -->

        <% if (cpostCanDelete) { %>

            <button
                type="button"
                class="cpost-delete"
                data-cpost-delete="<%= item._id %>"
                data-id="<%= item._id %>"
                data-type="<%= cpostType %>"
                aria-label="Delete post"
                title="Delete post"
            >

                <i
                    class="bi bi-trash3"
                    aria-hidden="true"
                ></i>

            </button>

        <% } %>


    </header>



    <!-- =====================================================
         CONTENT
    ====================================================== -->

    <div class="cpost-content">


        <!-- =================================================
             TEXT
        ================================================== -->

        <% if (cpostFullText) { %>

            <div class="cpost-text-area">

                <% if (cpostIsLong) { %>

                    <p class="cpost-text cpost-text-preview">

                        <%= cpostPreview %><button
                            type="button"
                            class="cpost-see-more"
                            data-cpost-expand="<%= item._id %>"
                        >See more <i
                                class="bi bi-arrow-right"
                                aria-hidden="true"
                            ></i></button>

                    </p>

                <% } else { %>

                    <p class="cpost-text">

                        <%= cpostFullText %>

                    </p>

                <% } %>

            </div>

        <% } %>



        <!-- =================================================
             IMAGE GRID
        ================================================== -->

        <% if (cpostVisibleImages.length > 0) { %>

            <div
                class="
                    cpost-images
                    cpost-images-<%= cpostVisibleImages.length %>
                "
                data-cpost-photo-count="<%= cpostImages.length %>"
            >

                <% cpostVisibleImages.forEach(function(image, index) { %>

                    <button
                        type="button"
                        class="cpost-image-button"
                        data-cpost-photo-index="<%= index %>"
                        aria-label="Open photo <%= index + 1 %>"
                    >

                        <img
                            src="/uploads/<%= image %>"
                            alt="Post photo <%= index + 1 %>"
                            class="cpost-image"
                            loading="lazy"
                        >


                        <% if (
                            index === 3 &&
                            cpostAdditionalImages > 0
                        ) { %>

                            <span class="cpost-more-images">

                                <i
                                    class="bi bi-images"
                                    aria-hidden="true"
                                ></i>

                                <strong>
                                    +<%= cpostAdditionalImages %>
                                </strong>

                            </span>

                        <% } %>

                    </button>

                <% }); %>

            </div>

        <% } %>


    </div>



    <!-- =====================================================
         ACTIONS
    ====================================================== -->

    <footer class="cpost-actions">


        <!-- LIKE -->

        <button
            type="button"
            class="cpost-like"
            data-id="<%= item._id %>"
            data-type="<%= cpostType %>"
            aria-label="Like"
        >

            <i
                class="bi bi-hand-thumbs-up-fill"
                aria-hidden="true"
            ></i>

            <span class="cpost-like-count">

                <%= cpostLikes %>

            </span>

        </button>



        <!-- COMMENTS -->

        <button
            type="button"
            class="cpost-comments-button"
            data-cpost-comments="<%= item._id %>"
            aria-label="Comments"
        >

            <i
                class="bi bi-chat-dots-fill"
                aria-hidden="true"
            ></i>

            <span class="cpost-comment-count">

                <%= cpostComments.length %>

            </span>

        </button>


    </footer>



    <!-- =====================================================
         EXPANDED POST
    ====================================================== -->

    <% if (cpostIsLong) { %>

        <div
            class="cpost-expand"
            data-cpost-expand-modal="<%= item._id %>"
            aria-hidden="true"
        >

            <div
                class="cpost-expand-backdrop"
                data-cpost-close-expand
            ></div>


            <div
                class="cpost-expand-card"
                role="dialog"
                aria-modal="true"
                aria-label="Expanded post"
            >


                <!-- EXPANDED HEADER -->

                <header class="cpost-expand-header">


                    <div class="cpost-expand-user">


                        <img
                            src="<%= cpostUserImage %>"
                            alt="<%= cpostUserName %>"
                            loading="lazy"
                        >


                        <div class="cpost-expand-user-info">


                            <strong>

                                <%= cpostUserName %>

                            </strong>


                            <% if (cpostDate) { %>

                                <small>

                                    <%= cpostDate %>

                                </small>

                            <% } %>


                            <% if (cpostTitle) { %>

                                <span>

                                    <%= cpostTitle %>

                                </span>

                            <% } %>


                        </div>


                    </div>


                    <button
                        type="button"
                        class="cpost-expand-close"
                        data-cpost-close-expand
                        aria-label="Close post"
                    >

                        <i
                            class="bi bi-x-lg"
                            aria-hidden="true"
                        ></i>

                    </button>


                </header>



                <!-- EXPANDED BODY -->

                <div class="cpost-expand-body">


                    <% if (cpostDairyName) { %>

                        <% if (cpostDairyId) { %>

                            <a
                                href="/dairy/<%= cpostDairyId %>"
                                class="cpost-expanded-dairy"
                            >

                                <i
                                    class="bi bi-building"
                                    aria-hidden="true"
                                ></i>

                                <span>

                                    <%= cpostDairyName %>

                                </span>

                            </a>

                        <% } else { %>

                            <div class="cpost-expanded-dairy">

                                <i
                                    class="bi bi-building"
                                    aria-hidden="true"
                                ></i>

                                <span>

                                    <%= cpostDairyName %>

                                </span>

                            </div>

                        <% } %>

                    <% } %>


                    <div class="cpost-expanded-text">

                        <%= cpostFullText %>

                    </div>


                    <% if (cpostImages.length > 0) { %>

                        <div class="cpost-expanded-images">

                            <% cpostImages.forEach(function(image, index) { %>

                                <button
                                    type="button"
                                    class="cpost-expanded-image"
                                    data-cpost-photo-index="<%= index %>"
                                >

                                    <img
                                        src="/uploads/<%= image %>"
                                        alt="Post photo <%= index + 1 %>"
                                        loading="lazy"
                                    >

                                </button>

                            <% }); %>

                        </div>

                    <% } %>


                </div>


            </div>

        </div>

    <% } %>



    <!-- =====================================================
         PHOTO VIEWER
    ====================================================== -->

    <% if (cpostImages.length > 0) { %>

        <div
            class="cpost-viewer"
            data-cpost-viewer="<%= item._id %>"
            aria-hidden="true"
        >


            <div
                class="cpost-viewer-backdrop"
                data-cpost-close-viewer
            ></div>


            <div class="cpost-viewer-topbar">


                <span class="cpost-viewer-counter">

                    <span class="cpost-current-photo">
                        1
                    </span>

                    /

                    <span>
                        <%= cpostImages.length %>
                    </span>

                </span>


                <button
                    type="button"
                    class="cpost-viewer-close"
                    data-cpost-close-viewer
                    aria-label="Close photo viewer"
                >

                    <i
                        class="bi bi-x-lg"
                        aria-hidden="true"
                    ></i>

                </button>


            </div>



            <% if (cpostImages.length > 1) { %>

                <button
                    type="button"
                    class="cpost-viewer-navigation cpost-viewer-prev"
                    data-cpost-photo-prev
                    aria-label="Previous photo"
                >

                    <i
                        class="bi bi-chevron-left"
                        aria-hidden="true"
                    ></i>

                </button>

            <% } %>



            <div class="cpost-viewer-stage">

                <img
                    class="cpost-viewer-image"
                    src="/uploads/<%= cpostImages[0] %>"
                    alt="Post photo"
                >

            </div>



            <% if (cpostImages.length > 1) { %>

                <button
                    type="button"
                    class="cpost-viewer-navigation cpost-viewer-next"
                    data-cpost-photo-next
                    aria-label="Next photo"
                >

                    <i
                        class="bi bi-chevron-right"
                        aria-hidden="true"
                    ></i>

                </button>

            <% } %>


        </div>

    <% } %>



    <!-- =====================================================
         COMMENT MODAL
    ====================================================== -->

    <div
        class="cpost-comment-modal"
        data-cpost-comment-modal="<%= item._id %>"
        aria-hidden="true"
    >


        <div class="cpost-comment-modal-content">


            <!-- COMMENT HEADER -->

            <header class="cpost-comment-header">


                <div class="cpost-comment-heading">

                    <strong>
                        Comments
                    </strong>

                    <span>
                        <%= cpostComments.length %>
                    </span>

                </div>


                <button
                    type="button"
                    class="cpost-comment-close"
                    data-cpost-close-comments
                    aria-label="Close comments"
                >

                    <i
                        class="bi bi-x-lg"
                        aria-hidden="true"
                    ></i>

                </button>


            </header>



            <!-- COMMENT LIST -->

            <div class="cpost-comment-list">


                <% if (cpostComments.length === 0) { %>

                    <div class="cpost-comment-empty">

                        <i
                            class="bi bi-chat-dots"
                            aria-hidden="true"
                        ></i>

                        <span>
                            No comments yet.
                        </span>

                        <small>
                            Be the first to comment.
                        </small>

                    </div>

                <% } %>



                <% cpostComments.forEach(function(comment) { %>


                    <div
                        class="cpost-comment-item"
                        data-comment-id="<%= comment._id %>"
                    >


                        <div class="cpost-comment-avatar">


                            <img
                                src="<%= comment.userImage || ('https://ui-avatars.com/api/?name=' + encodeURIComponent(comment.userName || 'User')) %>"
                                alt="<%= comment.userName || 'User' %>"
                                loading="lazy"
                            >


                        </div>



                        <div class="cpost-comment-body">


                            <div class="cpost-comment-top">


                                <strong>

                                    <%= comment.userName || "User" %>

                                </strong>


                                <%

                                    const cpostCommentUserId =
                                        comment.userId
                                            ? String(
                                                comment.userId._id ||
                                                comment.userId
                                            )
                                            : "";


                                    const cpostCanDeleteComment =
                                        user &&
                                        (
                                            cpostCommentUserId ===
                                                cpostCurrentUserId ||
                                            user.role === "admin"
                                        );

                                %>


                                <% if (cpostCanDeleteComment) { %>

                                    <button
                                        type="button"
                                        class="cpost-delete-comment"
                                        data-id="<%= comment._id %>"
                                        aria-label="Delete comment"
                                        title="Delete comment"
                                    >

                                        <i
                                            class="bi bi-trash3"
                                            aria-hidden="true"
                                        ></i>

                                    </button>

                                <% } %>


                            </div>



                            <p class="cpost-comment-text">

                                <%= comment.text %>

                            </p>



                            <% if (comment.createdAt) { %>

                                <small class="cpost-comment-date">

                                    <%= new Date(
                                        comment.createdAt
                                    ).toLocaleString() %>

                                </small>

                            <% } %>


                        </div>


                    </div>


                <% }); %>


            </div>



            <!-- COMMENT COMPOSER -->

            <div class="cpost-comment-composer-wrapper">


                <form
                    class="cpost-comment-form"
                    data-id="<%= item._id %>"
                    data-type="<%= cpostType %>"
                >


                    <div class="cpost-comment-composer">


                        <div class="cpost-comment-input-wrapper">

                            <textarea
                                name="text"
                                rows="1"
                                maxlength="500"
                                placeholder="Write a comment..."
                                aria-label="Write a comment"
                            ></textarea>

                        </div>


                        <button
                            type="submit"
                            class="cpost-comment-submit"
                            aria-label="Send comment"
                        >

                            <i
                                class="bi bi-send-fill"
                                aria-hidden="true"
                            ></i>

                        </button>


                    </div>


                </form>


            </div>


        </div>


    </div>


</article>



<!-- =========================================================
     SELF-CONTAINED POST CSS

     UNIQUE NAMESPACE:
     ---------------------------------------------------------
     Every selector belongs to the cpost component.

     No dependency on:
       .feed-card
       .feed-body
       .feed-actions
       .post-card
       .like-btn
       .toggle-comments
       .comment-modal
       .comment-section
       etc.
========================================================= -->

<style>

.cpost-card,
.cpost-card *,
.cpost-card *::before,
.cpost-card *::after {

    box-sizing: border-box;

}


.cpost-card {

    --cpost-green: #198754;
    --cpost-green-dark: #146c43;
    --cpost-text: #303833;
    --cpost-muted: #89928c;
    --cpost-border: #dfe8e2;

    position: relative;

    width: 100%;

    margin: 0 0 14px;

    padding: 0;

    background: #ffffff;

    border: 1px solid var(--cpost-border);

    border-radius: 14px;

    overflow: hidden;

    box-shadow:
        0 2px 8px rgba(24, 42, 30, .045);

    isolation: isolate;

    color: var(--cpost-text);

    font-family: inherit;

}


/* =========================================================
   HEADER
========================================================= */

.cpost-header {

    width: 100%;

    min-width: 0;

    display: flex;

    align-items: center;

    gap: 10px;

    padding: 10px 13px;

    background: #ffffff;

    border-bottom: 1px solid #e4ebe6;

}


.cpost-avatar {

    width: 42px;
    height: 42px;

    flex: 0 0 42px;

}


.cpost-avatar img {

    display: block;

    width: 42px;
    height: 42px;

    border-radius: 50%;

    object-fit: cover;

    border: 2px solid #edf5ef;

}


.cpost-header-info {

    flex: 1 1 auto;

    min-width: 0;

}


.cpost-header-main {

    display: flex;

    align-items: baseline;

    flex-wrap: wrap;

    column-gap: 5px;

    row-gap: 1px;

    min-width: 0;

    line-height: 1.25;

}


.cpost-user {

    display: inline;

    color: #172019;

    font-size: 14px;

    font-weight: 700;

    line-height: 1.25;

}


.cpost-about {

    color: #7c867f;

    font-size: 12px;

    font-weight: 400;

}


.cpost-dairy {

    display: inline;

    min-width: 0;

    max-width: 100%;

    color: var(--cpost-green);

    font-size: 13px;

    font-weight: 700;

    line-height: 1.3;

    text-decoration: none;

    overflow-wrap: anywhere;

}


.cpost-dairy:hover {

    color: var(--cpost-green-dark);

    text-decoration: underline;

}


.cpost-date {

    display: block;

    margin-top: 2px;

    color: var(--cpost-muted);

    font-size: 10.5px;

    font-weight: 400;

    line-height: 1.2;

}


.cpost-title {

    display: block;

    width: 100%;

    margin-top: 3px;

    padding: 0;

    color: #18201b;

    font-size: 14px;

    font-weight: 800;

    line-height: 1.3;

    text-align: left;

    overflow-wrap: anywhere;

    word-break: break-word;

}


.cpost-delete {

    width: 34px;
    height: 34px;

    flex: 0 0 34px;

    display: inline-flex;

    align-items: center;

    justify-content: center;

    margin: 0;
    padding: 0;

    border: 0;

    border-radius: 50%;

    background: transparent;

    color: #7c867f;

    cursor: pointer;

    font-family: inherit;

    font-size: 15px;

    transition:
        background .15s ease,
        color .15s ease,
        transform .12s ease;

}


.cpost-delete:hover {

    background: #fff1f1;

    color: #c62828;

}


.cpost-delete:active {

    transform: scale(.94);

}



/* =========================================================
   CONTENT
========================================================= */

.cpost-content {

    width: 100%;

    min-width: 0;

    margin: 0;

    padding: 12px 14px;

    background: #ffffff;

}


.cpost-text-area {

    width: 100%;

    margin: 0;

    padding: 0;

}


.cpost-text {

    width: 100%;

    margin: 0;

    padding: 0;

    color: var(--cpost-text);

    font-size: 15px;

    font-weight: 400;

    line-height: 1.5;

    text-align: left;

    white-space: pre-wrap;

    word-break: break-word;

    overflow-wrap: anywhere;

}


.cpost-see-more {

    display: inline;

    margin: 0 0 0 4px;

    padding: 0;

    border: 0;

    background: transparent;

    color: var(--cpost-green);

    font-family: inherit;

    font-size: 14px;

    font-weight: 700;

    line-height: inherit;

    white-space: nowrap;

    vertical-align: baseline;

    cursor: pointer;

}


.cpost-see-more:hover {

    color: var(--cpost-green-dark);

}


.cpost-see-more i {

    display: inline-block;

    margin-left: 2px;

    font-size: 10px;

}



/* =========================================================
   IMAGE GRID
========================================================= */

.cpost-images {

    width: 100%;

    margin: 10px 0 0;

    padding: 0;

    display: grid;

    grid-template-columns:
        repeat(2, minmax(0, 1fr));

    gap: 3px;

    overflow: hidden;

    border-radius: 11px;

    background: #eef2ef;

}


.cpost-image-button {

    position: relative;

    display: block;

    width: 100%;

    min-width: 0;

    aspect-ratio: 1 / 1;

    margin: 0;

    padding: 0;

    border: 0;

    background: #eef2ef;

    overflow: hidden;

    cursor: pointer;

}


.cpost-image-button::after {

    content: "";

    position: absolute;

    inset: 0;

    background: transparent;

    transition: background .15s ease;

}


.cpost-image-button:hover::after {

    background: rgba(0,0,0,.07);

}


.cpost-image {

    display: block;

    width: 100%;

    height: 100%;

    object-fit: cover;

}


/* ONE IMAGE */

.cpost-images-1 {

    grid-template-columns: 1fr;

}


.cpost-images-1 .cpost-image-button {

    aspect-ratio: auto;

    max-height: 650px;

}


.cpost-images-1 .cpost-image {

    width: 100%;

    height: auto;

    max-height: 650px;

    object-fit: contain;

}


/* THREE IMAGES */

.cpost-images-3 {

    grid-template-columns:
        1.35fr
        1fr;

}


.cpost-images-3 .cpost-image-button:first-child {

    grid-row: span 2;

}


/* MORE IMAGES */

.cpost-more-images {

    position: absolute;

    inset: 0;

    z-index: 2;

    display: flex;

    align-items: center;

    justify-content: center;

    gap: 7px;

    background: rgba(0,0,0,.43);

    color: #ffffff;

    font-size: 18px;

    font-weight: 700;

    pointer-events: none;

}


.cpost-more-images i {

    font-size: 20px;

}


.cpost-more-images strong {

    font-size: 20px;

}



/* =========================================================
   ACTIONS
========================================================= */

.cpost-actions {

    width: 100%;

