}


.livestock-medical-card__button:active {

    transform: scale(.95);

}


.livestock-medical-card__button:focus-visible {

    outline: 2px solid #c85d4d;

    outline-offset: 2px;

}



/* =========================================================
   CARD IMAGE
========================================================= */

.livestock-medical-card__image,
.livestock-medical-card__avatar {

    width: 70px;
    height: 70px;

    flex: 0 0 70px;

    overflow: hidden;

    border-radius: 50%;

}


.livestock-medical-card__image {

    display: block;

    object-fit: cover;

    border: 2px solid #e8b2a9;

}


.livestock-medical-card__avatar {

    display: flex;

    align-items: center;
    justify-content: center;

    border: 2px solid #e8b2a9;

    background:
        linear-gradient(
            145deg,
            #3f8060,
            #bd5b4b
        );

    color: #ffffff;

    font-size: 27px;

}



/* =========================================================
   CARD NAME
========================================================= */

.livestock-medical-card__name {

    display: block;

    width: 100%;

    max-width: 94px;

    overflow: hidden;

    color: #29332d;

    font-size: 11px;

    font-weight: 750;

    line-height: 1.25;

    white-space: nowrap;

    text-overflow: ellipsis;

}



/* =========================================================
   MODAL
========================================================= */

.livestock-medical-modal {

    position: fixed;

    inset: 0;

    width: 100vw;
    height: 100dvh;

    z-index: 99999;

    display: none;

    overflow: hidden;

    background: #ffffff;

}


