    display: block;

}



/* =========================================================
   MODAL CONTENT
========================================================= */

.livestock-medical-modal__content {

    width: 100%;
    height: 100%;

    display: flex;

    flex-direction: column;

    background: #ffffff;

}



/* =========================================================
   MODAL HEADER
========================================================= */

.livestock-medical-modal__header {

    width: 100%;
    height: 64px;

    flex: 0 0 64px;

    display: flex;

    align-items: center;

    padding: 0 15px;

    border-bottom: 1px solid #eee1dd;

    background: #ffffff;

}


.livestock-medical-modal__back {

    width: 44px;
    height: 44px;

    flex: 0 0 44px;

    display: flex;

    align-items: center;
    justify-content: center;

    padding: 0;

    border: none;

    border-radius: 50%;

    background: transparent;

    color: #397653;

    font-size: 24px;

    cursor: pointer;

}


.livestock-medical-modal__back:active {

    background: #f5e9e5;

}


.livestock-medical-modal__back:focus-visible {

    outline: 2px solid #c85d4d;

    outline-offset: 2px;

}



/* =========================================================
   MODAL TITLE
========================================================= */

.livestock-medical-modal__title {

    min-width: 0;

    margin-left: 8px;

    display: flex;

    flex-direction: column;

    line-height: 1.25;

}


.livestock-medical-modal__title strong {

    color: #27322c;

    font-size: 17px;

}


.livestock-medical-modal__title span {

    max-width: 72vw;

    margin-top: 2px;

    overflow: hidden;

    color: #7c8580;

    font-size: 12px;

    white-space: nowrap;

    text-overflow: ellipsis;

}


.livestock-medical-modal__spacer {

    flex: 1;

}



/* =========================================================
   MODAL BODY
========================================================= */

.livestock-medical-modal__body {

    flex: 1 1 auto;

    min-height: 0;

    overflow-y: auto;

    padding: 20px;

}


.livestock-medical-modal__fields {

    width: 100%;

    max-width: 700px;

    margin: 0 auto;

}



/* =========================================================
   QUESTION
========================================================= */

.livestock-medical-question {

    margin-bottom: 20px;

    color: #292f2b;

    font-size: 20px;

    line-height: 1.45;

}


.livestock-medical-question strong {

    color: #3d7959;

}



/* =========================================================
   TARGET
========================================================= */

.livestock-medical-target {

    width: 100%;

    display: flex;

    align-items: center;

    gap: 12px;

    margin-bottom: 20px;

    padding: 12px 13px;

    border: 1px solid #e4d7d2;

    border-radius: 13px;

    background:
        linear-gradient(
            145deg,
            #f7fbf8,
            #fff7f4
        );

}


.livestock-medical-target__image,
.livestock-medical-target__placeholder {

    width: 52px;
    height: 52px;

    flex: 0 0 52px;

    overflow: hidden;

    border-radius: 50%;

}


.livestock-medical-target__image {

    display: block;

    object-fit: cover;

}


.livestock-medical-target__placeholder {

    display: flex;

    align-items: center;
    justify-content: center;

    background:
        linear-gradient(
            145deg,
            #397958,
            #bd5b4b
        );

    color: #ffffff;

    font-size: 20px;

}


.livestock-medical-target__info {

    min-width: 0;

    display: flex;

    flex-direction: column;

}


.livestock-medical-target__info span {

    color: #78827c;

    font-size: 10px;

}


.livestock-medical-target__info strong {

    margin-top: 3px;

    overflow: hidden;

    color: #315e46;

    font-size: 14px;

    white-space: nowrap;

    text-overflow: ellipsis;

}



/* =========================================================
   STATUS
========================================================= */

.livestock-medical-status {

    display: flex;

    align-items: flex-start;

    gap: 11px;

    margin-bottom: 24px;

    padding: 13px;

    border: 1px solid #f0d6d0;

    border-radius: 13px;

    background: #fff7f5;

}


.livestock-medical-status__icon {

    width: 30px;
    height: 30px;

    flex: 0 0 30px;

    display: flex;

    align-items: center;
    justify-content: center;

    border-radius: 50%;

    background: #f7ded8;

    color: #a84739;

    font-size: 15px;

}


.livestock-medical-status > div {

    min-width: 0;

    display: flex;

    flex-direction: column;

}


.livestock-medical-status strong {

