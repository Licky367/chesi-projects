        display: none;

    }


    .livestock-medical-modal__body {

        padding: 10px;

    }

}

</style>



<!-- =========================================================
     JAVASCRIPT
========================================================= -->

<script>

(function () {

    "use strict";


    function initializeLivestockMedicalComposer() {

        const openButtons =
            document.querySelectorAll(
                "[data-open-livestock-medical]"
            );


        const closeButtons =
            document.querySelectorAll(
                "[data-close-livestock-medical]"
            );


        const modals =
            document.querySelectorAll(
                "[data-livestock-medical-modal]"
            );


        if (
            !openButtons.length &&
            !modals.length
        ) {

            return;

        }



        /* =====================================================
           CLOSE ALL MODALS
        ====================================================== */

        function closeAllModals() {

            modals.forEach(
                function (modal) {

                    modal.classList.remove(
                        "active"
                    );

                    modal.setAttribute(
                        "aria-hidden",
                        "true"
                    );

                }
            );


            document.body.style.overflow =
                "";

        }



        /* =====================================================
           OPEN MODAL
        ====================================================== */

        function openModal(modal) {

            if (!modal) {
                return;
            }


            closeAllModals();


            modal.classList.add(
                "active"
            );


            modal.setAttribute(
                "aria-hidden",
                "false"
            );


            document.body.style.overflow =
                "hidden";


            const firstInput =
                modal.querySelector(
                    "input, textarea"
                );


            if (firstInput) {

                window.setTimeout(
                    function () {

                        firstInput.focus();

                    },
                    100
                );

            }

        }



        /* =====================================================
           OPEN BUTTONS
        ====================================================== */

        openButtons.forEach(
            function (button) {

                button.addEventListener(
                    "click",
                    function () {

                        const modalId =
                            button.getAttribute(
                                "data-open-livestock-medical"
                            );


                        const modal =
                            document.getElementById(
                                modalId
                            );


                        openModal(modal);

                    }
                );

            }
        );



        /* =====================================================
           CLOSE BUTTONS
        ====================================================== */

        closeButtons.forEach(
            function (button) {

                button.addEventListener(
                    "click",
                    function () {

                        closeAllModals();

                    }
                );

            }
        );



        /* =====================================================
           ESCAPE
        ====================================================== */

        document.addEventListener(
            "keydown",
            function (event) {

                if (
                    event.key === "Escape"
                ) {

                    const activeModal =
                        document.querySelector(
                            "[data-livestock-medical-modal].active"
                        );


                    if (activeModal) {

                        closeAllModals();

                    }

                }

            }
        );



        /* =====================================================
           EACH FORM
        ====================================================== */

        modals.forEach(
            function (modal) {

                const form =
                    modal.querySelector(
                        ".livestock-medical-form"
                    );


                const typeInput =
                    modal.querySelector(
                        'input[name="type"]'
                    );


                const detailsInput =
                    modal.querySelector(
                        'textarea[name="details"]'
                    );


                const counter =
                    modal.querySelector(
                        "[data-livestock-medical-submit]"
                    )
                        ? modal.querySelector(
                            ".livestock-medical-character-counter"
                        )
                        : null;


                const submitButton =
                    modal.querySelector(
                        "[data-livestock-medical-submit]"
                    );


                if (
                    !form ||
                    !typeInput ||
                    !detailsInput ||
                    !counter ||
                    !submitButton
                ) {

                    return;

                }



                /* =============================================
                   VALIDATION
                ============================================== */

                function updateSubmitButton() {

                    const hasType =
                        typeInput.value.trim().length > 0;


                    const hasDetails =
                        detailsInput.value.trim().length > 0;


                    submitButton.disabled =
                        !(
                            hasType &&
                            hasDetails
                        );

                }



                /* =============================================
                   CHARACTER COUNTER
                ============================================== */

                function updateCounter() {

                    counter.textContent =
                        detailsInput.value.length +
                        "/1000";

                }



                /* =============================================
                   TEXTAREA RESIZE
                ============================================== */

                function resizeTextarea() {

                    detailsInput.style.height =
                        "auto";


                    const height =
                        Math.min(
                            detailsInput.scrollHeight,
                            300
                        );


                    detailsInput.style.height =
                        height + "px";

                }



                /* =============================================
                   INPUT EVENTS
                ============================================== */

                typeInput.addEventListener(
                    "input",
                    updateSubmitButton
                );


                detailsInput.addEventListener(
                    "input",
                    function () {

                        updateCounter();

                        resizeTextarea();

                        updateSubmitButton();

                    }
                );



                /* =============================================
                   SUBMIT
                ============================================== */

                form.addEventListener(
                    "submit",
                    function () {

                        if (
                            submitButton.disabled
                        ) {

                            return;

                        }


                        submitButton.disabled =
                            true;


                        submitButton.innerHTML =
                            '<i class="bi bi-hourglass-split"></i>' +
                            '<span>Recording...</span>';

                    }
                );



                /* =============================================
                   INITIAL STATE
                ============================================== */

                updateCounter();

                resizeTextarea();

                updateSubmitButton();

            }
        );

    }



    /* =========================================================
       DOM READY
    ========================================================= */

    if (
        document.readyState === "loading"
    ) {

        document.addEventListener(
            "DOMContentLoaded",
            initializeLivestockMedicalComposer
        );

    } else {

        initializeLivestockMedicalComposer();

    }

})();

</script>


<% } %>