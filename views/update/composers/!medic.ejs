/* =========================================================
   FORM
========================================================= */

.livestock-medical-form {

    width: 100%;

    margin: 0;

}


.livestock-medical-field {

    position: relative;

    width: 100%;

    margin-bottom: 20px;

}


.livestock-medical-field label {

    display: block;

    margin-bottom: 7px;

    color: #6d7771;

    font-size: 11px;

    font-weight: 700;

