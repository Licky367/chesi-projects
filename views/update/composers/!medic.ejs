<%
/*
============================================================
MEDICAL CLEAR COMPOSER

FILE:
    views/update/composers/!medic.ejs

PURPOSE:
    Display animals whose medical attention is CURRENTLY
    MARKED.

    Clicking an animal opens a full-screen modal allowing
    an authorized user to record the completed treatment
    and clear the animal's medical attention status.

TITLE:
    Clear Medical Attention

DATA:
    medicalAnimals
    user
    dairy

CONDITION:
    animal.medicalAttention.isMarked === true

AUTHORIZED USER:
    admin

FORM:
    POST /dairy/:animalId/medical-unmark

IMPORTANT:
    This file handles the OPPOSITE of medic.ejs.

    medic.ejs:
        isMarked === false
        → Mark Medical Attention

    !medic.ejs:
        isMarked === true
        → Clear Medical Attention
============================================================
*/


/* =========================================================
   SAFE COLLECTION
========================================================= */

const safeMedicalAnimals =
    Array.isArray(medicalAnimals)
        ? medicalAnimals
        : [];


/* =========================================================
   ONLY CURRENTLY MARKED ANIMALS
========================================================= */

const markedMedicalAnimals =
    safeMedicalAnimals.filter(function (animal) {

        return (
            animal &&
            animal.medicalAttention &&
            animal.medicalAttention.isMarked === true
        );

    });


/* =========================================================
   AUTHORIZATION
========================================================= */

const canClearMedical =
    user &&
    user.role === "admin";

%>


<% if (
    canClearMedical &&
    markedMedicalAnimals.length > 0
) { %>


<!-- =========================================================
     MEDICAL CLEAR COMPOSER
========================================================= -->

<section
    class="medical-clear-composer"
    data-medical-clear-composer
>


    <!-- =====================================================
         HEADING
    ====================================================== -->

    <div class="medical-clear-composer__heading">

        <div class="medical-clear-composer__heading-icon">

            <i
                class="bi bi-heart-pulse-fill"
                aria-hidden="true"
            ></i>

        </div>


        <div class="medical-clear-composer__heading-text">

            <strong>
                Clear Medical Attention
            </strong>

            <span>
                Select an animal whose treatment has been completed.
            </span>

        </div>

    </div>



    <!-- =====================================================
         ANIMAL CARDS
    ====================================================== -->

    <div
        class="medical-clear-composer__cards"
        data-medical-clear-list
    >


        <% markedMedicalAnimals.forEach(function (animal, index) { %>


            <%
            const animalId =
                animal._id;

            const animalName =
                animal.name ||
                animal.tag ||
                animal.code ||
                "Animal";

            const animalImage =
                animal.profileImage &&
                String(animal.profileImage).trim() !== ""
                    ? animal.profileImage
                    : null;
            %>


            <!-- =================================================
                 ANIMAL CARD
            ================================================== -->

            <section
                class="medical-clear-card"
                data-medical-clear-card
                data-animal-id="<%= animalId %>"
            >


                <button
                    type="button"
                    class="medical-clear-card__button"
                    data-open-medical-clear
                    data-animal-id="<%= animalId %>"
                    aria-label="Clear medical attention for <%= animalName %>"
                >


                    <!-- =========================================
                         ANIMAL IMAGE
                    ========================================== -->

                    <% if (animalImage) { %>

                        <img
                            src="<%= animalImage %>"
                            class="medical-clear-card__image"
                            alt="<%= animalName %>"
                        >

                    <% } else { %>

                        <span
                            class="medical-clear-card__icon"
                            aria-hidden="true"
                        >

                            <i class="bi bi-check-circle-fill"></i>

                        </span>

                    <% } %>



                    <!-- =========================================
                         LABEL
                    ========================================== -->

                    <span class="medical-clear-card__label">

                        Clear Medical

                    </span>



                    <!-- =========================================
                         ANIMAL NAME
                    ========================================== -->

                    <span class="medical-clear-card__name">

                        <%= animalName %>

                    </span>


                </button>

            </section>



            <!-- =================================================
                 FULL-SCREEN MODAL
            ================================================== -->

            <div
                class="medical-clear-modal"
                data-medical-clear-modal
                data-animal-id="<%= animalId %>"
                aria-hidden="true"
            >


                <div class="medical-clear-modal__content">


                    <!-- =========================================
                         HEADER
                    ========================================== -->

                    <header class="medical-clear-modal__header">


                        <button
                            type="button"
                            class="medical-clear-modal__back"
                            data-close-medical-clear
                            aria-label="Go back"
                        >

                            <i
                                class="bi bi-arrow-left"
                                aria-hidden="true"
                            ></i>

                        </button>


                        <div class="medical-clear-modal__title">

                            <strong>
                                Clear Medical Attention
                            </strong>

                            <span>
                                <%= animalName %>
                            </span>

                        </div>


                        <div
                            class="medical-clear-modal__spacer"
                            aria-hidden="true"
                        ></div>


                    </header>



                    <!-- =========================================
                         BODY
                    ========================================== -->

                    <main class="medical-clear-modal__body">


                        <div class="medical-clear-modal__fields">


                            <!-- =================================
                                 QUESTION
                            ================================== -->

                            <div class="medical-clear-question">

                                <strong>
                                    <%= user.name
                                        ? user.name.split(" ")[0]
                                        : "User" %>
                                </strong>,

                                has the medical treatment for this
                                animal been completed?

                            </div>



                            <!-- =================================
                                 TARGET ANIMAL
                            ================================== -->

                            <section
                                class="medical-clear-target"
                                aria-label="Medical attention target"
                            >


                                <% if (animalImage) { %>

                                    <img
                                        src="<%= animalImage %>"
                                        class="medical-clear-target__image"
                                        alt="<%= animalName %>"
                                    >

                                <% } else { %>

                                    <div
                                        class="medical-clear-target__placeholder"
                                        aria-hidden="true"
                                    >

                                        <i class="bi bi-heart-pulse-fill"></i>

                                    </div>

                                <% } %>


                                <div class="medical-clear-target__info">

                                    <span>
                                        Medical attention currently active
                                    </span>

                                    <strong>
                                        <%= animalName %>
                                    </strong>

                                </div>


                            </section>



                            <!-- =================================
                                 ACTIVE STATUS
                            ================================== -->

                            <div class="medical-clear-status">


                                <span
                                    class="medical-clear-status__icon"
                                    aria-hidden="true"
                                >

                                    <i class="bi bi-heart-pulse-fill"></i>

                                </span>


                                <div>

                                    <strong>
                                        Medical attention active
                                    </strong>

                                    <span>
                                        Record the treatment completed
                                        below to clear this animal's
                                        medical status.
                                    </span>

                                </div>


                            </div>



                            <!-- =================================
                                 FORM
                            ================================== -->

                            <form
                                class="medical-clear-form"
                                action="/dairy/<%= animalId %>/medical-unmark"
                                method="POST"
                                autocomplete="off"
                                data-medical-clear-form
                            >


                                <!-- =================================
                                     CHARGES
                                ================================== -->

                                <div class="medical-clear-field">


                                    <label
                                        for="medicalClearCharges_<%= index %>"
                                    >

                                        Charges incurred

                                    </label>


                                    <div
                                        class="medical-clear-money-input"
                                    >

                                        <span>
                                            KES
                                        </span>


                                        <input
                                            type="number"
                                            id="medicalClearCharges_<%= index %>"
                                            name="charges"
                                            min="0"
                                            step="0.01"
                                            inputmode="decimal"
                                            placeholder="0.00"
                                            required
                                            data-medical-clear-charges
                                        >

                                    </div>


                                </div>



                                <!-- =================================
                                     TREATMENT DESCRIPTION
                                ================================== -->

                                <div class="medical-clear-field">


                                    <label
                                        for="medicalClearDescription_<%= index %>"
                                    >

                                        Treatment completed

                                    </label>


                                    <textarea
                                        id="medicalClearDescription_<%= index %>"
                                        name="description"
                                        maxlength="1000"
                                        rows="5"
                                        placeholder="Describe the treatment or medical work completed..."
                                        required
                                        data-medical-clear-description
                                    ></textarea>


                                    <span
                                        class="medical-clear-character-counter"
                                        data-medical-clear-counter
                                    >
                                        0/1000
                                    </span>


                                </div>



                                <!-- =================================
                                     SUBMIT
                                ================================== -->

                                <button
                                    type="submit"
                                    class="medical-clear-submit"
                                    data-medical-clear-submit
                                    disabled
                                >

                                    <i
                                        class="bi bi-check-circle-fill"
                                        aria-hidden="true"
                                    ></i>


                                    <span>
                                        Clear Medical Attention
                                    </span>

                                </button>


                            </form>


                        </div>

                    </main>


                </div>

            </div>


        <% }); %>


    </div>

</section>



<!-- =========================================================
     CSS
========================================================= -->

<style>

/* =========================================================
   ROOT
========================================================= */

.medical-clear-composer,
.medical-clear-composer *,
