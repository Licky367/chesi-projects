<%
/*
============================================================
LIVESTOCK MEDICAL UPDATE COMPOSER

FILE:
    views/update/composers/!medic.ejs

PURPOSE:
    Display animals belonging to the CURRENT Dairy Farm
    that have NOT been marked for medical attention.

TITLE:
    Update us about the Health of our Livestock.

DATA:
    medicalAnimals
    dairy
    user

ANIMAL RULE:
    An animal MUST:

        code > 0

    AND:

        medicalAttention.isMarked === false

FARM OWNERSHIP:
    medicalAnimals MUST already be restricted by the
    controller/service to animals belonging to the CURRENT
    Dairy Farm.

    This view does not display animals from another farm.

FORM:
    POST /dairy/:id/medical-mark

CARD:
    108px × 150px

============================================================
*/
%>


<%
/* =========================================================
   SAFE COLLECTION
========================================================= */

const safeMedicalAnimals =
    Array.isArray(medicalAnimals)
        ? medicalAnimals.filter(function (animal) {

            if (!animal) {
                return false;
            }

            const animalCode =
                Number(animal.code);

            const isAnimal =
                Number.isFinite(animalCode) &&
                animalCode > 0;

            const medicalMarked =
                animal.medicalAttention &&
                animal.medicalAttention.isMarked === true;

            return (
                isAnimal &&
                !medicalMarked
            );

        })
        : [];
%>


<% if (safeMedicalAnimals.length > 0) { %>


<!-- =========================================================
     MEDICAL LIVESTOCK COMPOSER
========================================================= -->

<section
    class="livestock-medical-composer"
    aria-labelledby="livestockMedicalComposerTitle"
>


    <!-- =====================================================
         HEADING
    ====================================================== -->

    <header class="livestock-medical-composer__header">

        <h2
            id="livestockMedicalComposerTitle"
            class="livestock-medical-composer__title"
        >
            Update us about the Health of our Livestock.
        </h2>

    </header>



    <!-- =====================================================
         HORIZONTAL CARD SCROLLER
    ====================================================== -->

    <div
        class="livestock-medical-composer__scroller"
        role="region"
        aria-label="Livestock health updates"
    >


        <div class="livestock-medical-composer__track">


            <% safeMedicalAnimals.forEach(function (animal, index) { %>


                <%
                /*
                ------------------------------------------------
                UNIQUE IDENTIFIER
                ------------------------------------------------
                */

                const animalId =
                    String(
                        animal._id ||
                        animal.id ||
                        index
                    );

                const safeAnimalName =
                    animal.name &&
                    String(animal.name).trim() !== ""
                        ? animal.name
                        : "Livestock";

                const modalId =
                    "livestockMedicalModal-" +
                    animalId;

                const formId =
                    "livestockMedicalForm-" +
                    animalId;

                const typeId =
                    "livestockMedicalType-" +
                    animalId;

                const detailsId =
                    "livestockMedicalDetails-" +
                    animalId;

                const counterId =
                    "livestockMedicalCounter-" +
                    animalId;
                %>


                <!-- =============================================
                     ANIMAL CARD
                ============================================== -->

                <article
                    class="livestock-medical-card"
                    data-livestock-medical-card
                    data-animal-id="<%= animalId %>"
                >


                    <button
                        type="button"
                        class="livestock-medical-card__button"
                        data-open-livestock-medical="<%= modalId %>"
                        aria-label="Update health of <%= safeAnimalName %>"
                    >


                        <!-- =====================================
                             ANIMAL IMAGE
                        ====================================== -->

                        <%
                        const image =
                            animal.profileImage &&
                            String(animal.profileImage).trim() !== ""
                                ? animal.profileImage
                                : null;
                        %>


                        <% if (image) { %>

                            <img
                                src="<%= image %>"
                                class="livestock-medical-card__image"
                                alt="<%= safeAnimalName %>"
                                loading="lazy"
                            >

                        <% } else { %>

                            <span
                                class="livestock-medical-card__avatar"
                                aria-hidden="true"
                            >

                                <i class="bi bi-heart-pulse"></i>

                            </span>

                        <% } %>



                        <!-- =====================================
                             ANIMAL NAME
                        ====================================== -->

                        <span
                            class="livestock-medical-card__name"
                        >
                            <%= safeAnimalName %>
                        </span>


                    </button>

                </article>



                <!-- =================================================
                     FULL-SCREEN MEDICAL MODAL
                ================================================== -->

                <div
                    id="<%= modalId %>"
                    class="livestock-medical-modal"
                    data-livestock-medical-modal
                    aria-hidden="true"
                >


                    <div class="livestock-medical-modal__content">


                        <!-- =========================================
                             HEADER
                        ========================================== -->

                        <header
                            class="livestock-medical-modal__header"
                        >


                            <button
                                type="button"
                                class="livestock-medical-modal__back"
                                data-close-livestock-medical="<%= modalId %>"
                                aria-label="Close health update"
                            >

                                <i
                                    class="bi bi-arrow-left"
                                    aria-hidden="true"
                                ></i>

                            </button>


                            <div
                                class="livestock-medical-modal__title"
                            >

                                <strong>
                                    Livestock Health
                                </strong>

                                <span>
                                    <%= safeAnimalName %>
                                </span>

                            </div>


                            <div
                                class="livestock-medical-modal__spacer"
                                aria-hidden="true"
                            ></div>


                        </header>



                        <!-- =========================================
                             BODY
                        ========================================== -->

                        <main
                            class="livestock-medical-modal__body"
                        >


                            <div
                                class="livestock-medical-modal__fields"
                            >


                                <!-- =================================
                                     QUESTION
                                ================================== -->

                                <div
                                    class="livestock-medical-question"
                                >

                                    <strong>
                                        <%
                                        const firstName =
                                            user &&
                                            user.name
                                                ? String(user.name)
                                                    .trim()
                                                    .split(/\s+/)[0]
                                                : "there";
                                        %>

                                        <%= firstName %>
                                    </strong>,

                                    how is
                                    <strong>
                                        <%= safeAnimalName %>
                                    </strong>
                                    doing?

                                </div>



                                <!-- =================================
                                     ANIMAL TARGET
                                ================================== -->

                                <section
                                    class="livestock-medical-target"
                                    aria-label="Livestock health target"
                                >


                                    <% if (image) { %>

                                        <img
                                            src="<%= image %>"
                                            class="livestock-medical-target__image"
                                            alt="<%= safeAnimalName %>"
                                        >

                                    <% } else { %>

                                        <div
                                            class="livestock-medical-target__placeholder"
                                            aria-hidden="true"
                                        >

                                            <i
                                                class="bi bi-heart-pulse"
                                            ></i>

                                        </div>

                                    <% } %>


                                    <div
                                        class="livestock-medical-target__info"
                                    >

                                        <span>
                                            Livestock health update
                                        </span>

                                        <strong>
                                            <%= safeAnimalName %>
                                        </strong>

                                    </div>


                                </section>



                                <!-- =================================
                                     STATUS NOTICE
                                ================================== -->

                                <div
                                    class="livestock-medical-status"
                                >


                                    <span
                                        class="livestock-medical-status__icon"
                                        aria-hidden="true"
                                    >

                                        <i
                                            class="bi bi-heart-pulse"
                                        ></i>

                                    </span>


                                    <div>

                                        <strong>
                                            Health attention
                                        </strong>

                                        <span>
                                            Record any health concern
                                            or medical condition noticed
                                            in this animal.
                                        </span>

                                    </div>


                                </div>



                                <!-- =================================
                                     MEDICAL FORM
                                ================================== -->

                                <form
                                    id="<%= formId %>"
                                    class="livestock-medical-form"
                                    action="/dairy/<%= animal._id %>/medical-mark"
                                    method="POST"
                                    autocomplete="off"
                                >


                                    <!-- =============================
                                         MEDICAL TYPE
                                    ============================== -->

                                    <div
                                        class="livestock-medical-field"
                                    >

                                        <label
                                            for="<%= typeId %>"
                                        >
                                            Medical type
                                        </label>


                                        <input
                                            type="text"
                                            id="<%= typeId %>"
                                            name="type"
                                            maxlength="200"
                                            placeholder="e.g. Mastitis"
                                            required
                                        >

                                    </div>



                                    <!-- =============================
                                         DETAILS
                                    ============================== -->

                                    <div
                                        class="livestock-medical-field"
                                    >

                                        <label
                                            for="<%= detailsId %>"
                                        >
                                            Health details
                                        </label>


                                        <textarea
                                            id="<%= detailsId %>"
                                            name="details"
                                            maxlength="1000"
                                            rows="5"
                                            placeholder="Describe the condition or health concern..."
                                            required
                                        ></textarea>


                                        <span
                                            id="<%= counterId %>"
                                            class="livestock-medical-character-counter"
                                        >
                                            0/1000
                                        </span>

                                    </div>



                                    <!-- =============================
                                         SUBMIT
                                    ============================== -->

                                    <button
                                        type="submit"
                                        class="livestock-medical-submit"
                                        data-livestock-medical-submit
                                        disabled
                                    >

                                        <i
                                            class="bi bi-heart-pulse"
                                            aria-hidden="true"
                                        ></i>

                                        <span>
                                            Record Medical Attention
                                        </span>

                                    </button>


                                </form>


                            </div>

                        </main>


                    </div>

                </div>


            <% }); %>


        </div>

    </div>

</section>


<!-- =========================================================
     CSS
========================================================= -->

<style>

/* =========================================================
   ROOT
========================================================= */

.livestock-medical-composer,
.livestock-medical-composer *,
.livestock-medical-modal,
.livestock-medical-modal * {

    box-sizing: border-box;

}



/* =========================================================
   COMPOSER
========================================================= */

.livestock-medical-composer {

    width: 100%;

    margin: 0 0 20px;

}



/* =========================================================
   HEADING
========================================================= */

.livestock-medical-composer__header {

    width: 100%;

    margin-bottom: 10px;

}


.livestock-medical-composer__title {

    margin: 0;

    color: #314139;

    font-size: 17px;

    font-weight: 750;

    line-height: 1.3;

}



/* =========================================================
   HORIZONTAL SCROLLER
========================================================= */

.livestock-medical-composer__scroller {

    width: 100%;

    overflow-x: auto;
    overflow-y: hidden;

    padding:
        3px
        0
        10px;

    scrollbar-width: thin;

    -webkit-overflow-scrolling: touch;

    overscroll-behavior-x: contain;

}


.livestock-medical-composer__track {

    width: max-content;

    min-width: 100%;

    display: flex;

    align-items: flex-start;

    gap: 9px;

}



/* =========================================================
   ANIMAL CARD
========================================================= */

.livestock-medical-card {

    width: 108px;

    height: 150px;

    flex: 0 0 108px;

}


.livestock-medical-card__button {

    width: 108px;
    height: 150px;

    display: flex;

    flex-direction: column;

    align-items: center;
    justify-content: center;

    gap: 9px;

    padding: 10px 7px;

    overflow: hidden;

    border: 1px solid #eaded8;

    border-radius: 15px;

    background:
        linear-gradient(
            145deg,
            #ffffff,
            #fff7f3
        );

    color: #3f453f;

    font-family: inherit;

    text-align: center;

    cursor: pointer;

    transition:
        transform .15s ease,
        border-color .15s ease,
        box-shadow .15s ease;

}


.livestock-medical-card__button:hover {

    border-color: #c85d4d;

    box-shadow:
        0 6px 16px
