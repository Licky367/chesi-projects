<!-- =========================================================
     JAVASCRIPT
========================================================= -->

<script>

(function () {

    "use strict";


    function initializeMedicalClear() {


        /* =====================================================
           MODALS
        ====================================================== */

        const modals =
            document.querySelectorAll(
                "[data-medical-clear-modal]"
            );


        const openButtons =
            document.querySelectorAll(
                "[data-open-medical-clear]"
            );


        if (
            !modals.length ||
            !openButtons.length
        ) {

            return;

        }



        /* =====================================================
           CLOSE ALL
        ====================================================== */

        function closeAllModals() {

            modals.forEach(
                function (modal) {

                    modal.classList.remove(
                        "active"
                    );

                    modal.setAttribute(
                        "aria-hidden",
                        "true"
                    );

                }
            );


            document.body.style.overflow =
                "";

        }



        /* =====================================================
           OPEN MODAL
        ====================================================== */

        function openModal(animalId) {

            closeAllModals();


            const modal =
                document.querySelector(
                    '[data-medical-clear-modal][data-animal-id="' +
                    animalId +
                    '"]'
                );


            if (!modal) {

                console.error(
                    "MEDICAL CLEAR: Modal not found for animal:",
                    animalId
                );

                return;

            }


            modal.classList.add(
                "active"
            );


            modal.setAttribute(
                "aria-hidden",
                "false"
            );


            document.body.style.overflow =
                "hidden";


            const chargesInput =
                modal.querySelector(
                    "[data-medical-clear-charges]"
                );


            window.setTimeout(
                function () {

                    if (chargesInput) {

                        chargesInput.focus();

                    }

                },
                100
            );

        }



        /* =====================================================
           OPEN BUTTONS
        ====================================================== */

        openButtons.forEach(
            function (button) {

                button.addEventListener(
                    "click",
                    function () {

                        const animalId =
                            button.getAttribute(
                                "data-animal-id"
                            );


                        if (!animalId) {

                            return;

                        }


                        openModal(
                            animalId
                        );

                    }
                );

            }
        );



        /* =====================================================
           CLOSE BUTTONS
        ====================================================== */

        document
            .querySelectorAll(
                "[data-close-medical-clear]"
            )
            .forEach(
                function (button) {

                    button.addEventListener(
                        "click",
                        closeAllModals
                    );

                }
            );



        /* =====================================================
           ESCAPE
        ====================================================== */

        document.addEventListener(
            "keydown",
            function (event) {

                if (
                    event.key === "Escape"
                ) {

                    const activeModal =
                        document.querySelector(
                            "[data-medical-clear-modal].active"
                        );


                    if (activeModal) {

                        closeAllModals();

                    }

                }

            }
        );



        /* =====================================================
           FORM INITIALIZATION
        ====================================================== */

        modals.forEach(
            function (modal) {

                const form =
                    modal.querySelector(
                        "[data-medical-clear-form]"
                    );


                const chargesInput =
                    modal.querySelector(
                        "[data-medical-clear-charges]"
                    );


                const descriptionInput =
                    modal.querySelector(
                        "[data-medical-clear-description]"
                    );


                const counter =
                    modal.querySelector(
                        "[data-medical-clear-counter]"
                    );


                const submitButton =
                    modal.querySelector(
                        "[data-medical-clear-submit]"
                    );


                if (
                    !form ||
                    !chargesInput ||
                    !descriptionInput ||
                    !counter ||
                    !submitButton
                ) {

                    return;

                }



                /* =============================================
                   CHARACTER COUNTER
                ============================================== */

                function updateCounter() {

                    counter.textContent =
                        descriptionInput.value.length +
                        "/1000";

                }



                /* =============================================
                   VALIDATE
                ============================================== */

                function updateSubmitButton() {

                    const charges =
                        chargesInput.value.trim();


                    const description =
                        descriptionInput.value.trim();


                    const numericCharges =
                        Number(charges);


                    const validCharges =
                        charges !== "" &&
                        Number.isFinite(
                            numericCharges
                        ) &&
                        numericCharges >= 0;


                    const validDescription =
                        description.length > 0;


                    submitButton.disabled =
                        !(
                            validCharges &&
                            validDescription
                        );

                }



                /* =============================================
                   EVENTS
                ============================================== */

                chargesInput.addEventListener(
                    "input",
                    updateSubmitButton
                );


                descriptionInput.addEventListener(
                    "input",
                    function () {

                        updateCounter();

                        updateSubmitButton();

                    }
                );



                /* =============================================
                   SUBMIT
                ============================================== */

                form.addEventListener(
                    "submit",
                    function () {

                        submitButton.disabled =
                            true;


                        submitButton.innerHTML =
                            '<i class="bi bi-hourglass-split"></i>' +
                            '<span>Clearing...</span>';

                    }
                );



                /* =============================================
                   INITIAL
                ============================================== */

                updateCounter();

                updateSubmitButton();

            }
        );

    }



    /* =========================================================
       DOM READY
    ========================================================= */

    if (
        document.readyState === "loading"
    ) {

        document.addEventListener(
            "DOMContentLoaded",
            initializeMedicalClear
        );

    } else {

        initializeMedicalClear();

    }

})();

</script>


