    outline: none;

    background: #faf9f8;

    color: #202520;

    font: inherit;

    font-size: 15px;

}


.livestock-medical-field input {

    height: 48px;

    padding: 0 13px;

}


.livestock-medical-field textarea {

    min-height: 130px;

    max-height: 300px;

    resize: vertical;

