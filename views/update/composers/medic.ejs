<%
/*
============================================================
MEDICAL UPDATE COMPOSER

FILE:
    views/update/composers/medical.ejs

PURPOSE:
    Display a horizontally scrollable collection of dairy
    animals that have NOT yet been marked for medical
    attention.

FILTER:
    --------------------------------------------------------
    1. Positive animal code
           Number(dairy.code) > 0

    2. Medical attention is NOT currently marked
           dairy.medicalAttention.isMarked !== true

    3. Animal belongs to the CURRENT Dairy Farm
           dairy.assetCode === current farm code

CARD:
    108px × 150px

CLICK:
    Opens a medical recording modal for that animal.

FORM:
    POST /dairy/:id/medical-mark

AUTHORIZED USERS:
    admin
    dairyWorker

EXPECTED DATA:
    dairies
    dairy
    user

IMPORTANT:
    `dairy` represents the CURRENT Dairy Farm.

    `dairies` represents the records available to this
    composer.

    The composer performs a second safety filter so that
    animals belonging to another Dairy Farm cannot appear.
============================================================
*/


<%
/* =========================================================
   CURRENT FARM CODE
========================================================= */

const currentFarmCode =
    dairy &&
    dairy.recordType === "farm"
        ? Number(dairy.code)
        : (
            dairy &&
            Number(dairy.code) < 0
                ? Number(dairy.code)
                : (
                    dairy &&
                    dairy.assetCode !== null &&
                    dairy.assetCode !== undefined
                        ? Number(dairy.assetCode)
                        : null
                )
        );


/* =========================================================
   AUTHORIZATION
========================================================= */

const canRecordMedical =
    user &&
    (
        user.role === "admin" ||
        user.role === "dairyWorker"
    );


/* =========================================================
   MEDICAL CANDIDATES
========================================================= */

const medicalCandidates =
    Array.isArray(dairies)
        ? dairies.filter(function (animal) {

            if (!animal) {
                return false;
            }


            /* ---------------------------------------------
               MUST BE AN ANIMAL
            --------------------------------------------- */

            if (
                Number(animal.code) <= 0
            ) {
                return false;
            }


            /* ---------------------------------------------
               MUST BELONG TO CURRENT FARM
            --------------------------------------------- */

            if (
                currentFarmCode === null ||
                Number(animal.assetCode) !== currentFarmCode
            ) {
                return false;
            }


            /* ---------------------------------------------
               MUST NOT ALREADY BE MARKED
            --------------------------------------------- */

            if (
                animal.medicalAttention &&
                animal.medicalAttention.isMarked === true
            ) {
                return false;
            }


            return true;

        })
        : [];
%>


<% if (canRecordMedical && medicalCandidates.length > 0) { %>


<!-- =======================================================
     MEDICAL UPDATE COMPOSER
======================================================== -->

<section
    class="medical-composer"
    aria-labelledby="medicalComposerHeading"
>


    <!-- ===================================================
         HEADING
    ==================================================== -->

    <header class="medical-composer__header">

        <h2
            id="medicalComposerHeading"
            class="medical-composer__heading"
        >
            Update us about the Health of our Livestock.
        </h2>

    </header>



    <!-- ===================================================
         HORIZONTAL CARD SCROLLER
    ==================================================== -->

    <div
        class="medical-composer__scroller"
        role="list"
        aria-label="Livestock requiring health updates"
    >


        <% medicalCandidates.forEach(function (animal, index) { %>


        <!-- ===============================================
             ANIMAL CARD
        ================================================ -->

        <article
            class="medical-composer__item"
            role="listitem"
        >


            <button
                type="button"
                class="medical-composer__card"
                data-medical-open="<%= index %>"
                aria-label="Record health information for <%= animal.name %>"
            >


                <!-- =========================================
                     IMAGE / AVATAR
                ========================================== -->

                <span
                    class="medical-composer__avatar"
                >

                    <% if (
                        animal.profileImage &&
                        String(animal.profileImage).trim() !== ""
                    ) { %>

                        <img
                            src="<%= animal.profileImage %>"
                            alt="<%= animal.name %>"
                            loading="lazy"
                        >

                    <% } else if (
                        animal.profileImages &&
                        Array.isArray(animal.profileImages) &&
                        animal.profileImages.length > 0 &&
                        animal.profileImages[0]
                    ) { %>

                        <img
                            src="<%= animal.profileImages[0] %>"
                            alt="<%= animal.name %>"
                            loading="lazy"
                        >

                    <% } else { %>

                        <span
                            class="medical-composer__avatar-fallback"
                            aria-hidden="true"
                        >
                            <i class="bi bi-heart-pulse"></i>
                        </span>

                    <% } %>

                </span>



                <!-- =========================================
                     ANIMAL NAME
                ========================================== -->

                <span
                    class="medical-composer__name"
                    title="<%= animal.name %>"
                >
                    <%= animal.name %>
                </span>



                <!-- =========================================
                     ACTION INDICATOR
                ========================================== -->

                <span
                    class="medical-composer__indicator"
                    aria-hidden="true"
                >
                    +
                </span>


            </button>

        </article>


        <% }); %>


    </div>

</section>



<!-- =======================================================
     MEDICAL RECORDING MODALS
======================================================== -->

<% medicalCandidates.forEach(function (animal, index) { %>


<div
    id="medicalComposerModal-<%= index %>"
    class="medical-composer-modal"
    aria-hidden="true"
>


    <div
        class="medical-composer-modal__content"
        role="dialog"
        aria-modal="true"
        aria-labelledby="medicalComposerModalTitle-<%= index %>"
    >


        <!-- ===============================================
             MODAL HEADER
        ================================================ -->

        <header class="medical-composer-modal__header">


            <button
                type="button"
                class="medical-composer-modal__back"
                data-medical-close="<%= index %>"
                aria-label="Close medical recording"
            >
                &#8592;
            </button>


            <div
                class="medical-composer-modal__title"
            >

                <strong
                    id="medicalComposerModalTitle-<%= index %>"
                >
                    Health Update
                </strong>

                <span>
                    <%= animal.name %>
                </span>

            </div>


            <span
                class="medical-composer-modal__spacer"
                aria-hidden="true"
            ></span>


        </header>



        <!-- ===============================================
             MODAL BODY
        ================================================ -->

        <main class="medical-composer-modal__body">


            <div class="medical-composer-modal__inner">


                <!-- =========================================
                     QUESTION
                ========================================== -->

                <div class="medical-composer__question">

                    <strong>
                        <%= user.name.split(" ")[0] %>
                    </strong>,

                    tell us about the health of
                    <strong>
                        <%= animal.name %>
                    </strong>.

                </div>



                <!-- =========================================
                     ANIMAL TARGET
                ========================================== -->

                <section
                    class="medical-composer__target"
                    aria-label="Animal being updated"
                >


                    <span
                        class="medical-composer__target-image"
                    >

                        <% if (
                            animal.profileImage &&
                            String(animal.profileImage).trim() !== ""
                        ) { %>

                            <img
                                src="<%= animal.profileImage %>"
                                alt="<%= animal.name %>"
                            >

                        <% } else if (
                            animal.profileImages &&
                            Array.isArray(animal.profileImages) &&
                            animal.profileImages.length > 0 &&
                            animal.profileImages[0]
                        ) { %>

                            <img
                                src="<%= animal.profileImages[0] %>"
                                alt="<%= animal.name %>"
                            >

                        <% } else { %>

                            <span
                                class="medical-composer__target-fallback"
                                aria-hidden="true"
                            >
                                <i class="bi bi-heart-pulse"></i>
                            </span>

                        <% } %>

                    </span>


                    <span
                        class="medical-composer__target-info"
                    >

                        <small>
                            Livestock health update
                        </small>

                        <strong>
                            <%= animal.name %>
                        </strong>

                    </span>


                </section>



                <!-- =========================================
                     MEDICAL FORM
                ========================================== -->

                <form
                    class="medical-composer__form"
                    action="/dairy/<%= animal._id %>/medical-mark"
                    method="POST"
                    autocomplete="off"
                    data-medical-form="<%= index %>"
                >


                    <!-- =====================================
                         MEDICAL TYPE
                    ====================================== -->

                    <div
                        class="medical-composer__field"
                    >

                        <label
                            for="medicalType-<%= index %>"
                        >
                            Medical type
                        </label>


                        <input
                            type="text"
                            id="medicalType-<%= index %>"
                            name="type"
                            maxlength="200"
                            placeholder="e.g. Mastitis"
                            required
                        >

                    </div>



                    <!-- =====================================
                         DETAILS
                    ====================================== -->

                    <div
                        class="medical-composer__field"
                    >

                        <label
                            for="medicalDetails-<%= index %>"
                        >
                            Details
                        </label>


                        <textarea
                            id="medicalDetails-<%= index %>"
                            name="details"
                            maxlength="1000"
                            rows="5"
                            placeholder="Describe the condition or concern..."
                            required
                        ></textarea>


                        <span
                            class="medical-composer__counter"
                            data-medical-counter="<%= index %>"
                        >
                            0/1000
                        </span>

                    </div>



                    <!-- =====================================
                         SUBMIT
                    ====================================== -->

                    <button
                        type="submit"
                        class="medical-composer__submit"
                        data-medical-submit="<%= index %>"
                        disabled
                    >

                        <i
                            class="bi bi-heart-pulse"
                            aria-hidden="true"
                        ></i>

                        <span>
                            Record Health Update
                        </span>

                    </button>


                </form>


            </div>

        </main>


    </div>

</div>


<% }); %>



<!-- =======================================================
     CSS
======================================================== -->

<style>

.medical-composer,
.medical-composer *,
.medical-composer-modal,
.medical-composer-modal * {

    box-sizing: border-box;

}



/* =========================================================
   COMPOSER
========================================================= */

