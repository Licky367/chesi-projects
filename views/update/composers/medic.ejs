<%
/*
============================================================
MEDICAL UPDATE COMPOSER

FILE:
    views/update/composers/medical.ejs

PURPOSE:
    Display compact horizontal cards for livestock belonging
    to the CURRENT DAIRY FARM that:

        1. have a positive code
        2. have medicalAttention.isMarked === false

    Clicking a livestock card opens a medical recording modal.

CARD:
    108px × 150px

LAYOUT:
    Horizontal scrolling

TARGET:
    Only livestock belonging to the current Dairy Farm.

EXPECTED DATA:
    medicalDairies
    user
    dairy

IMPORTANT:
    The backend/controller should already ensure that
    medicalDairies belongs to the current Dairy Farm.

    This view additionally performs defensive filtering
    using the positive-code and medicalAttention rules.
============================================================
*/
%>

<%
    const sourceDairies =
        Array.isArray(medicalDairies)
            ? medicalDairies
            : [];

    const eligibleDairies =
        sourceDairies.filter(function (animal) {

            if (!animal) {
                return false;
            }

            const code =
                Number(animal.code);

            const isPositiveCode =
                Number.isFinite(code) &&
                code > 0;

            const isNotMarked =
                !(
                    animal.medicalAttention &&
                    animal.medicalAttention.isMarked === true
                );

            return (
                isPositiveCode &&
                isNotMarked
            );

        });
%>


<% if (eligibleDairies.length > 0) { %>

<section
    class="medical-update-composer"
    aria-labelledby="medicalUpdateComposerHeading"
>

    <!-- =====================================================
         HEADING
    ====================================================== -->

    <header class="medical-update-composer__header">

        <h2
            id="medicalUpdateComposerHeading"
            class="medical-update-composer__heading"
        >
            Update us about the Health of our Livestock.
        </h2>

    </header>


    <!-- =====================================================
         HORIZONTAL CARDS
    ====================================================== -->

    <div
        class="medical-update-composer__scroller"
        role="list"
        aria-label="Livestock requiring health updates"
    >

        <% eligibleDairies.forEach(function (animal, index) { %>

            <article
                class="medical-update-composer__item"
                role="listitem"
            >

                <button
                    type="button"
                    class="medical-update-composer__card"
                    data-medical-card="<%= index %>"
                    aria-label="Update health information for <%= animal.name || 'livestock' %>"
                >

                    <!-- =====================================
                         IMAGE / AVATAR
                    ====================================== -->

                    <div class="medical-update-composer__avatar">

                        <% if (
                            animal.profileImage &&
                            String(animal.profileImage).trim() !== ""
                        ) { %>

                            <img
                                src="<%= animal.profileImage %>"
                                alt="<%= animal.name || 'Livestock' %>"
                                class="medical-update-composer__image"
                                loading="lazy"
                            >

                        <% } else { %>

                            <span
                                class="medical-update-composer__avatar-fallback"
                                aria-hidden="true"
                            >
                                <i class="bi bi-heart-pulse"></i>
                            </span>

                        <% } %>

                    </div>


                    <!-- =====================================
                         NAME
                    ====================================== -->

                    <span
                        class="medical-update-composer__name"
                    >
                        <%= animal.name || "Livestock" %>
                    </span>


                    <!-- =====================================
                         ACTION
                    ====================================== -->

                    <span
                        class="medical-update-composer__action"
                    >
                        Update Health
                    </span>

                </button>

            </article>

        <% }); %>

    </div>

</section>



<!-- =========================================================
     MODALS
========================================================= -->

<% eligibleDairies.forEach(function (animal, index) { %>

<div
    class="medical-update-modal"
    id="medicalUpdateModal_<%= index %>"
    aria-hidden="true"
    data-medical-modal="<%= index %>"
>

    <div
        class="medical-update-modal__content"
        role="dialog"
        aria-modal="true"
        aria-labelledby="medicalUpdateTitle_<%= index %>"
    >

        <!-- =============================================
             HEADER
        ============================================== -->

        <header class="medical-update-modal__header">

            <button
                type="button"
                class="medical-update-modal__close"
                data-medical-close="<%= index %>"
                aria-label="Close health update"
            >
                &#8592;
            </button>


            <div class="medical-update-modal__title">

                <strong id="medicalUpdateTitle_<%= index %>">
                    Livestock Health
                </strong>

                <span>
                    <%= animal.name || "Livestock" %>
                </span>

            </div>


            <span
                class="medical-update-modal__spacer"
                aria-hidden="true"
            ></span>

        </header>


        <!-- =============================================
             BODY
        ============================================== -->

        <main class="medical-update-modal__body">

            <div class="medical-update-modal__inner">


                <!-- =====================================
                     QUESTION
                ====================================== -->

                <div class="medical-update-modal__question">

                    <% if (user && user.name) { %>

                        <strong>
                            <%= user.name.split(" ")[0] %>
                        </strong>,

                    <% } %>

                    tell us about the health of

                    <strong>
                        <%= animal.name || "this livestock" %>
                    </strong>.

                </div>


                <!-- =====================================
                     TARGET
                ====================================== -->

                <section
                    class="medical-update-target"
                    aria-label="Livestock being updated"
                >

                    <div class="medical-update-target__avatar">

                        <% if (
                            animal.profileImage &&
                            String(animal.profileImage).trim() !== ""
                        ) { %>

                            <img
                                src="<%= animal.profileImage %>"
                                alt="<%= animal.name || 'Livestock' %>"
                                class="medical-update-target__image"
                            >

                        <% } else { %>

                            <span
                                class="medical-update-target__fallback"
                                aria-hidden="true"
                            >
                                <i class="bi bi-heart-pulse"></i>
                            </span>

                        <% } %>

                    </div>


                    <div class="medical-update-target__info">

                        <span>
                            Health update for
                        </span>

                        <strong>
                            <%= animal.name || "Livestock" %>
                        </strong>

                    </div>

                </section>


                <!-- =====================================
                     MEDICAL FORM
                ====================================== -->

                <form
                    class="medical-update-form"
                    action="/dairy/<%= animal._id %>/medical-mark"
                    method="POST"
                    autocomplete="off"
                >

                    <div class="medical-update-field">

                        <label
                            for="medicalType_<%= index %>"
                        >
                            Medical type
                        </label>

                        <input
                            type="text"
                            id="medicalType_<%= index %>"
                            name="type"
                            maxlength="200"
                            placeholder="e.g. Mastitis"
                            required
                        >

                    </div>


                    <div class="medical-update-field">

                        <label
                            for="medicalDetails_<%= index %>"
                        >
                            Details
                        </label>

                        <textarea
                            id="medicalDetails_<%= index %>"
                            name="details"
                            maxlength="1000"
                            rows="6"
                            placeholder="Describe the health condition, symptoms or concern..."
                            required
                        ></textarea>

                        <span class="medical-update-counter">
                            0/1000
                        </span>

                    </div>


                    <button
                        type="submit"
                        class="medical-update-submit"
                        disabled
                    >

                        <i
                            class="bi bi-heart-pulse"
                            aria-hidden="true"
                        ></i>

                        <span>
                            Record Health Update
                        </span>

                    </button>

                </form>

            </div>

        </main>

    </div>

</div>

<% }); %>



<!-- =========================================================
     CSS
========================================================= -->

<style>

.medical-update-composer,
.medical-update-composer *,
.medical-update-modal,
.medical-update-modal * {
    box-sizing: border-box;
}


/* =========================================================
   SECTION
========================================================= */

.medical-update-composer {
    width: 100%;
    margin: 0 0 20px;
}


/* =========================================================
   HEADING
========================================================= */

.medical-update-composer__header {
    width: 100%;
    margin: 0 0 12px;
}


.medical-update-composer__heading {
    margin: 0;
    color: #37422e;
    font-size: 18px;
    font-weight: 700;
    line-height: 1.3;
}


/* =========================================================
   HORIZONTAL SCROLLER
========================================================= */

.medical-update-composer__scroller {
    width: 100%;

    display: flex;

    flex-direction: row;

    gap: 10px;

    overflow-x: auto;
    overflow-y: hidden;

    padding: 2px 2px 12px;

    scroll-behavior: smooth;

    -webkit-overflow-scrolling: touch;

    scrollbar-width: none;
}


.medical-update-composer__scroller::-webkit-scrollbar {
    display: none;
}


/* =========================================================
   CARD ITEM
========================================================= */

.medical-update-composer__item {
    width: 108px;
    min-width: 108px;
    max-width: 108px;

    height: 150px;

    flex: 0 0 108px;
}


/* =========================================================
   CARD
========================================================= */

.medical-update-composer__card {
    width: 108px;
    height: 150px;

    padding: 12px 7px;

    display: flex;

    flex-direction: column;

    align-items: center;
    justify-content: center;

    gap: 7px;

    overflow: hidden;

    border: 1px solid #eadfce;

    border-radius: 15px;

    background:
        linear-gradient(
            145deg,
            #fffdf8,
            #f7f4e9
        );

    color: #46522f;

    font-family: inherit;

    text-align: center;

    cursor: pointer;

    transition:
        transform .15s ease,
        box-shadow .15s ease,
        border-color .15s ease;
}


.medical-update-composer__card:hover {
    border-color: #c47b32;

    box-shadow:
        0 6px 16px
        rgba(180, 105, 35, .14);
}


.medical-update-composer__card:active {
    transform: scale(.95);
}


.medical-update-composer__card:focus-visible {
    outline: 2px solid #c47b32;
    outline-offset: 2px;
}


/* =========================================================
   AVATAR
========================================================= */

.medical-update-composer__avatar {
    width: 64px;
    height: 64px;

    flex: 0 0 64px;

    overflow: hidden;

    border: 2px solid #e8cda9;

    border-radius: 50%;

    background: #f0eadb;

    box-shadow:
        0 3px 10px
        rgba(120, 90, 40, .10);
}


.medical-update-composer__image {
    width: 100%;
    height: 100%;

    display: block;

    object-fit: cover;
}


.medical-update-composer__avatar-fallback {
    width: 100%;
    height: 100%;

    display: flex;

    align-items: center;
    justify-content: center;

    background: #6f7d3d;

    color: #ffffff;

    font-size: 25px;
}


/* =========================================================
   NAME
========================================================= */

.medical-update-composer__name {
    display: block;

    width: 100%;
    max-width: 94px;

    overflow: hidden;

    color: #3c4435;

    font-size: 12px;
    font-weight: 700;

    line-height: 1.2;

    white-space: nowrap;

    text-overflow: ellipsis;
}


/* =========================================================
   ACTION
========================================================= */

.medical-update-composer__action {
    display: block;

    max-width: 94px;

    color: #b46c2c;

    font-size: 9px;
    font-weight: 700;

    line-height: 1.2;

    text-transform: uppercase;
}


/* =========================================================
   MODAL
========================================================= */

.medical-update-modal {
    position: fixed;

    inset: 0;

    width: 100vw;
    height: 100dvh;

    z-index: 99999;

    display: none;

    overflow: hidden;

    background: #ffffff;
}


.medical-update-modal.active {
    display: block;
}


/* =========================================================
   MODAL CONTENT
========================================================= */

.medical-update-modal__content {
    width: 100%;
    height: 100%;

    display: flex;

    flex-direction: column;

    background: #ffffff;
}


/* =========================================================
   MODAL HEADER
========================================================= */

.medical-update-modal__header {
    width: 100%;
    height: 64px;

    flex: 0 0 64px;

    display: flex;

    align-items: center;

    padding: 0 14px;

    border-bottom: 1px solid #ece8de;

    background: #ffffff;
}


.medical-update-modal__close {
    width: 44px;
    height: 44px;

    flex: 0 0 44px;

    display: flex;

    align-items: center;
    justify-content: center;

    padding: 0;

    border: none;

    border-radius: 50%;

    background: transparent;

    color: #6f7d3d;

    font-size: 27px;

    cursor: pointer;
}


.medical-update-modal__close:active {
    background: #f3efe5;
}


.medical-update-modal__title {
    min-width: 0;

    margin-left: 8px;

    display: flex;

    flex-direction: column;

    line-height: 1.25;
}


.medical-update-modal__title strong {
    color: #33382d;
    font-size: 17px;
}


.medical-update-modal__title span {
    max-width: 70vw;

    margin-top: 2px;

    overflow: hidden;

    color: #858477;

    font-size: 12px;

    white-space: nowrap;

    text-overflow: ellipsis;
}


.medical-update-modal__spacer {
    flex: 1;
}


/* =========================================================
   MODAL BODY
========================================================= */

.medical-update-modal__body {
    flex: 1 1 auto;

    min-height: 0;

    overflow-y: auto;

    padding: 20px;
}


.medical-update-modal__inner {
    width: 100%;
    max-width: 700px;

    margin: 0 auto;
}


/* =========================================================
   QUESTION
========================================================= */

.medical-update-modal__question {
    margin-bottom: 20px;

    color: #33382d;

    font-size: 20px;

    line-height: 1.45;
}


.medical-update-modal__question strong {
    color: #6f7d3d;
}


/* =========================================================
   TARGET
========================================================= */

.medical-update-target {
    width: 100%;

    display: flex;

    align-items: center;

    gap: 12px;

    margin-bottom: 24px;

    padding: 12px;

    border: 1px solid #e6ddc9;

    border-radius: 14px;

    background: #faf7ef;
}


.medical-update-target__avatar {
    width: 54px;
    height: 54px;

    flex: 0 0 54px;

    overflow: hidden;

    border-radius: 50%;
}


.medical-update-target__image {
    width: 100%;
    height: 100%;

    display: block;

    object-fit: cover;
}


.medical-update-target__fallback {
    width: 100%;
    height: 100%;

    display: flex;

    align-items: center;
    justify-content: center;

    background: #6f7d3d;

    color: #ffffff;

    font-size: 21px;
}


.medical-update-target__info {
    min-width: 0;

    display: flex;

    flex-direction: column;
}


.medical-update-target__info span {
    color: #898879;

    font-size: 10px;
}


.medical-update-target__info strong {
    margin-top: 3px;

    overflow: hidden;

    color: #59652f;

    font-size: 15px;

    white-space: nowrap;

    text-overflow: ellipsis;
}


/* =========================================================
   FORM
========================================================= */

.medical-update-form {
    width: 100%;
    margin: 0;
}


.medical-update-field {
    position: relative;

    width: 100%;

    margin-bottom: 20px;
}


.medical-update-field label {
    display: block;

    margin-bottom: 7px;

    color: #777667;

    font-size: 11px;

    font-weight: 700;

    letter-spacing: .04em;

    text-transform: uppercase;
}


.medical-update-field input,
.medical-update-field textarea {
    width: 100%;

    border: 1px solid #dfddd4;

    border-radius: 12px;

    outline: none;

    background: #fafaf7;

    color: #30352e;

    font: inherit;

    font-size: 15px;
}


.medical-update-field input {
    height: 48px;

    padding: 0 13px;
}


.medical-update-field textarea {
    min-height: 130px;

    padding: 13px 14px 30px;

    resize: vertical;

    line-height: 1.5;
}


.medical-update-field input:focus,
.medical-update-field textarea:focus {
    border-color: #c47b32;

    background: #ffffff;

    box-shadow:
        0 0 0 3px
        rgba(196, 123, 50, .10);
}


/* =========================================================
   COUNTER
========================================================= */

.medical-update-counter {
    position: absolute;

    right: 11px;
    bottom: 9px;

    color: #99978b;

    font-size: 10px;

    pointer-events: none;
}


/* =========================================================
   SUBMIT
========================================================= */

.medical-update-submit {
    width: 100%;

    min-height: 50px;

    display: flex;

    align-items: center;
    justify-content: center;

    gap: 8px;

    padding: 10px 14px;

    border: none;

    border-radius: 13px;

    background: #6f7d3d;

    color: #ffffff;

    font-family: inherit;

    font-size: 14px;

    font-weight: 700;

    cursor: pointer;
}


.medical-update-submit:not(:disabled):active {
    transform: scale(.99);
}


.medical-update-submit:disabled {
    background: #c3c5ba;

    cursor: default;
}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 600px) {

    .medical-update-composer__heading {
        font-size: 17px;
    }

    .medical-update-modal__header {
        height: 60px;

        flex-basis: 60px;

        padding: 0 10px;
    }

    .medical-update-modal__body {
        padding: 14px;
    }

    .medical-update-modal__question {
        font-size: 19px;
    }

}


/* =========================================================
   SMALL PHONES
========================================================= */

@media (max-width: 380px) {

    .medical-update-modal__body {
        padding: 10px;
    }

    .medical-update-modal__title span {
        display: none;
    }

}

</style>



<!-- =========================================================
     JAVASCRIPT
========================================================= -->

<script>

(function () {

    "use strict";


    function initializeMedicalComposer() {

        const cards =
            document.querySelectorAll(
                "[data-medical-card]"
            );


        const modals =
            document.querySelectorAll(
                "[data-medical-modal]"
            );


        const closeButtons =
            document.querySelectorAll(
                "[data-medical-close]"
            );


        if (!cards.length) {
            return;
        }


        function closeAllModals() {

            modals.forEach(function (modal) {

                modal.classList.remove("active");

                modal.setAttribute(
                    "aria-hidden",
                    "true"
                );

            });

            document.body.style.overflow = "";

        }


        function openModal(index) {

            const modal =
                document.querySelector(
                    '[data-medical-modal="' +
                    index +
                    '"]'
                );


            if (!modal) {
                return;
            }


            modal.classList.add("active");

            modal.setAttribute(
                "aria-hidden",
                "false"
            );


            document.body.style.overflow =
                "hidden";


            const input =
                modal.querySelector(
                    'input[name="type"]'
                );


            if (input) {

                window.setTimeout(
                    function () {
                        input.focus();
                    },
                    100
                );

            }

        }


        cards.forEach(function (card) {

            card.addEventListener(
                "click",
                function () {

                    const index =
                        card.getAttribute(
                            "data-medical-card"
                        );


                    openModal(index);

                }
            );

        });


        closeButtons.forEach(function (button) {

            button.addEventListener(
                "click",
                function () {

                    closeAllModals();

                }
            );

        });


        modals.forEach(function (modal) {

            modal.addEventListener(
                "click",
                function (event) {

                    if (
                        event.target === modal
                    ) {

                        closeAllModals();

                    }

                }
            );

        });


        document.addEventListener(
            "keydown",
            function (event) {

                if (
                    event.key === "Escape"
                ) {

                    closeAllModals();

                }

            }
        );


        /* =====================================================
           FORM VALIDATION / COUNTERS
        ====================================================== */

        modals.forEach(function (modal) {

            const form =
                modal.querySelector(
                    ".medical-update-form"
                );


            const typeInput =
                modal.querySelector(
                    'input[name="type"]'
                );


            const detailsInput =
                modal.querySelector(
                    'textarea[name="details"]'
                );


            const counter =
                modal.querySelector(
                    ".medical-update-counter"
                );


            const submitButton =
                modal.querySelector(
                    ".medical-update-submit"
                );


            if (
                !form ||
                !typeInput ||
                !detailsInput ||
                !counter ||
                !submitButton
            ) {

                return;

            }


            function validate() {

                const hasType =
                    typeInput.value.trim().length > 0;


                const hasDetails =
                    detailsInput.value.trim().length > 0;


                submitButton.disabled =
                    !(
                        hasType &&
                        hasDetails
                    );

            }


            function updateCounter() {

                counter.textContent =
                    detailsInput.value.length +
                    "/1000";

            }


            typeInput.addEventListener(
                "input",
                validate
            );


            detailsInput.addEventListener(
                "input",
                function () {

                    updateCounter();

                    validate();

                }
            );


            form.addEventListener(
                "submit",
                function () {

                    submitButton.disabled =
                        true;

                    submitButton.innerHTML =
                        '<i class="bi bi-hourglass-split"></i>' +
                        '<span>Submitting...</span>';

                }
            );


            updateCounter();

            validate();

        });

    }


    if (
        document.readyState === "loading"
    ) {

        document.addEventListener(
            "DOMContentLoaded",
            initializeMedicalComposer
        );

    } else {

        initializeMedicalComposer();

    }

})();

</script>