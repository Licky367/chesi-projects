}



/* =========================================================
   TARGET
========================================================= */

.medical-composer__target {

    width: 100%;

    display: flex;

    align-items: center;

    gap: 12px;

    margin-bottom: 24px;

    padding: 12px 13px;

    border: 1px solid #ead9c8;

    border-radius: 13px;

    background: #fffaf3;

}


.medical-composer__target-image {

    width: 52px;

    height: 52px;

    flex: 0 0 52px;

    display: flex;

    align-items: center;

    justify-content: center;

    overflow: hidden;

    border-radius: 50%;

    background: #f1dfc8;

}


.medical-composer__target-image img {

    width: 100%;

    height: 100%;

    object-fit: cover;

}


.medical-composer__target-fallback {

    width: 100%;

    height: 100%;

    display: flex;

    align-items: center;

    justify-content: center;

    background: #d58a43;

    color: #ffffff;

    font-size: 20px;

}


.medical-composer__target-info {

