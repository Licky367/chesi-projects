<%
/*
============================================================
MEDICAL HEALTH COMPOSER

FILE:
    views/update/composers/medic.ejs

PURPOSE:
    Display livestock that can be updated medically.

DATA:
    medicalDairies
    dairy
    user

RULES:
    --------------------------------------------------------
    1. Only positive-code Dairy records are displayed.
    2. Only animals belonging to the CURRENT Dairy Farm
       are supplied by the controller.
    3. Only animals whose medicalAttention.isMarked is false
       are displayed.
    4. Clicking an animal opens its medical recording modal.
============================================================
*/
%>


<%
const medicalList =
    Array.isArray(medicalDairies)
        ? medicalDairies.filter(function (animal) {

            if (!animal) {
                return false;
            }

            const code =
                Number(animal.code);

            if (
                !Number.isFinite(code) ||
                code <= 0
            ) {
                return false;
            }

            return !(
                animal.medicalAttention &&
                animal.medicalAttention.isMarked === true
            );

        })
        : [];
%>


<% if (medicalList.length > 0) { %>

<section
    class="medical-health-composer"
    aria-labelledby="medicalHealthComposerHeading"
>

    <div class="medical-health-composer__heading">

        <h2 id="medicalHealthComposerHeading">
            Update us about the Health of our Livestock.
        </h2>

    </div>


    <div
        class="medical-health-composer__scroller"
        role="region"
        aria-label="Livestock health updates"
    >

        <div class="medical-health-composer__track">


            <% medicalList.forEach(function (animal) { %>

                <%
                const animalId =
                    animal._id;

                const animalName =
                    animal.name ||
                    animal.code ||
                    "Livestock";

                const image =
                    typeof animal.profileImage === "string"
                        ? animal.profileImage.trim()
                        : "";

                const firstLetter =
                    String(animalName)
                        .trim()
                        .charAt(0)
                        .toUpperCase() || "?";

                const modalId =
                    "medicalComposerModal_" +
                    String(animalId);
                %>


                <!-- =================================================
                     LIVESTOCK CARD
                ================================================== -->

                <article
                    class="medical-health-card"
                >

                    <button
                        type="button"
                        class="medical-health-card__button"
                        data-medical-open="<%= modalId %>"
                        aria-label="Update health of <%= animalName %>"
                    >

                        <% if (image) { %>

                            <img
                                src="<%= image %>"
                                class="medical-health-card__image"
                                alt="<%= animalName %>"
                                loading="lazy"
                            >

                        <% } else { %>

                            <span
                                class="medical-health-card__avatar"
                                aria-hidden="true"
                            >
                                <%= firstLetter %>
                            </span>

                        <% } %>


                        <span
                            class="medical-health-card__name"
                        >
                            <%= animalName %>
                        </span>

                    </button>

                </article>


                <!-- =================================================
                     MEDICAL RECORDING MODAL
                ================================================== -->

                <div
                    id="<%= modalId %>"
                    class="medical-health-modal"
                    aria-hidden="true"
                >

                    <div
                        class="medical-health-modal__content"
                        role="dialog"
                        aria-modal="true"
                        aria-labelledby="<%= modalId %>_title"
                    >

                        <header
                            class="medical-health-modal__header"
                        >

                            <button
                                type="button"
                                class="medical-health-modal__close"
                                data-medical-close="<%= modalId %>"
                                aria-label="Close medical recording"
                            >
                                &#8592;
                            </button>


                            <div
                                class="medical-health-modal__title"
                                id="<%= modalId %>_title"
                            >

                                <strong>
                                    Livestock Health
                                </strong>

                                <span>
                                    <%= animalName %>
                                </span>

                            </div>

                        </header>


                        <main
                            class="medical-health-modal__body"
                        >

                            <div
                                class="medical-health-modal__animal"
                            >

                                <% if (image) { %>

                                    <img
                                        src="<%= image %>"
                                        alt="<%= animalName %>"
                                    >

                                <% } else { %>

                                    <span
                                        class="medical-health-modal__animal-avatar"
                                    >
                                        <%= firstLetter %>
                                    </span>

                                <% } %>


                                <div>

                                    <span>
                                        Livestock
                                    </span>

                                    <strong>
                                        <%= animalName %>
                                    </strong>

                                </div>

                            </div>


                            <form
                                class="medical-health-form"
                                action="/dairy/<%= animalId %>/medical-mark"
                                method="POST"
                                autocomplete="off"
                            >

                                <div
                                    class="medical-health-field"
                                >

                                    <label
                                        for="<%= modalId %>_type"
                                    >
                                        Medical type
                                    </label>

                                    <input
                                        type="text"
                                        id="<%= modalId %>_type"
                                        name="type"
                                        maxlength="200"
                                        placeholder="e.g. Mastitis"
                                        required
                                    >

                                </div>


                                <div
                                    class="medical-health-field"
                                >

                                    <label
                                        for="<%= modalId %>_details"
                                    >
                                        Details
                                    </label>

                                    <textarea
                                        id="<%= modalId %>_details"
                                        name="details"
                                        maxlength="1000"
                                        rows="5"
                                        placeholder="Describe the health condition or concern..."
                                        required
                                    ></textarea>

                                    <span>
                                        0/1000
                                    </span>

                                </div>


                                <button
                                    type="submit"
                                    class="medical-health-submit"
                                >

                                    <i
                                        class="bi bi-heart-pulse"
                                        aria-hidden="true"
                                    ></i>

                                    <span>
                                        Mark for Medical Attention
                                    </span>

                                </button>

                            </form>

                        </main>

                    </div>

                </div>

            <% }); %>


        </div>

    </div>

</section>

<% } %>



<style>

/* =========================================================
   MEDICAL HEALTH COMPOSER
========================================================= */

.medical-health-composer,
.medical-health-composer *,
.medical-health-modal,
.medical-health-modal * {
    box-sizing: border-box;
}


.medical-health-composer {
    width: 100%;
    margin: 0 0 20px;
}


.medical-health-composer__heading {
    width: 100%;
    margin-bottom: 12px;
}


.medical-health-composer__heading h2 {
    margin: 0;
    color: #3d392d;
    font-size: 18px;
    font-weight: 700;
    line-height: 1.3;
}



/* =========================================================
   HORIZONTAL SCROLLER
========================================================= */

.medical-health-composer__scroller {
    width: 100%;
    overflow-x: auto;
    overflow-y: hidden;

    -webkit-overflow-scrolling: touch;

    scrollbar-width: none;
}


.medical-health-composer__scroller::-webkit-scrollbar {
    display: none;
}


.medical-health-composer__track {
    display: flex;
    align-items: flex-start;
    gap: 10px;

    width: max-content;

    padding: 2px 2px 8px;
}



/* =========================================================
   CARD
========================================================= */

.medical-health-card {
    width: 108px;
    height: 150px;

    flex: 0 0 108px;
}


.medical-health-card__button {
    width: 108px;
    height: 150px;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    gap: 10px;

    padding: 10px 6px;

    border: 1px solid #e2dfd2;
    border-radius: 15px;

    background:
        linear-gradient(
            145deg,
            #ffffff,
            #faf7ed
        );

    color: #3d392d;

    cursor: pointer;

    font-family: inherit;

    text-align: center;

    transition:
        transform .15s ease,
        border-color .15s ease,
        box-shadow .15s ease;
}


.medical-health-card__button:hover {
    border-color: #c87932;

    box-shadow:
        0 5px 16px
        rgba(200, 121, 50, .14);
}


.medical-health-card__button:active {
    transform: scale(.95);
}


.medical-health-card__button:focus-visible {
    outline: 2px solid #c87932;
    outline-offset: 2px;
}



/* =========================================================
   IMAGE
========================================================= */

.medical-health-card__image,
.medical-health-card__avatar {
    width: 64px;
    height: 64px;

    flex: 0 0 64px;

    border-radius: 50%;

    overflow: hidden;
}


.medical-health-card__image {
    display: block;

    object-fit: cover;

    border: 2px solid #e5c49e;
}


.medical-health-card__avatar {
    display: flex;

    align-items: center;
    justify-content: center;

    background:
        linear-gradient(
            145deg,
            #198754,
            #c87932
        );

    color: #ffffff;

    font-size: 25px;
    font-weight: 700;

    border: 2px solid #ead4b9;
}



/* =========================================================
   NAME
========================================================= */

.medical-health-card__name {
    width: 94px;

    overflow: hidden;

    color: #39372f;

    font-size: 12px;
    font-weight: 700;

    line-height: 1.25;

    text-align: center;

    white-space: nowrap;

    text-overflow: ellipsis;
}



/* =========================================================
   MODAL
========================================================= */

.medical-health-modal {
    position: fixed;

    inset: 0;

    z-index: 99999;

    display: none;

    width: 100vw;
    height: 100dvh;

    overflow: hidden;

    background: #ffffff;
}


.medical-health-modal.active {
    display: block;
}


.medical-health-modal__content {
    width: 100%;
    height: 100%;

    display: flex;
    flex-direction: column;

    background: #ffffff;
}


.medical-health-modal__header {
    width: 100%;
    height: 64px;

    flex: 0 0 64px;

    display: flex;
    align-items: center;

    padding: 0 12px;

    border-bottom: 1px solid #ebe7dc;

    background: #ffffff;
}


.medical-health-modal__close {
    width: 44px;
    height: 44px;

    flex: 0 0 44px;

    border: none;
    border-radius: 50%;

    background: transparent;

    color: #198754;

    font-size: 27px;

    cursor: pointer;
}


.medical-health-modal__close:active {
    background: #f4eee5;
}


.medical-health-modal__title {
    min-width: 0;

    margin-left: 8px;

    display: flex;
    flex-direction: column;
}


.medical-health-modal__title strong {
    color: #292820;

    font-size: 17px;
}


.medical-health-modal__title span {
    max-width: 75vw;

    overflow: hidden;

    color: #7c786d;

    font-size: 12px;

    white-space: nowrap;

    text-overflow: ellipsis;
}



/* =========================================================
   MODAL BODY
========================================================= */

.medical-health-modal__body {
    flex: 1 1 auto;

    min-height: 0;

    overflow-y: auto;

    padding: 20px;
}


.medical-health-modal__animal {
    width: 100%;

    display: flex;
    align-items: center;

    gap: 12px;

    margin-bottom: 24px;

    padding: 12px;

    border: 1px solid #e8dfd1;
    border-radius: 14px;

    background: #faf8f2;
}


.medical-health-modal__animal img,
.medical-health-modal__animal-avatar {
    width: 54px;
    height: 54px;

    flex: 0 0 54px;

    border-radius: 50%;

    overflow: hidden;
}


.medical-health-modal__animal img {
    display: block;
    object-fit: cover;
}


.medical-health-modal__animal-avatar {
    display: flex;

    align-items: center;
    justify-content: center;

    background:
        linear-gradient(
            145deg,
            #198754,
            #c87932
        );

    color: #ffffff;

    font-size: 21px;
    font-weight: 700;
}


.medical-health-modal__animal div {
    min-width: 0;

    display: flex;
    flex-direction: column;
}


.medical-health-modal__animal div span {
    color: #817b6f;

    font-size: 10px;
}


.medical-health-modal__animal div strong {
    margin-top: 3px;

    overflow: hidden;

    color: #3d392d;

    font-size: 15px;

    white-space: nowrap;

    text-overflow: ellipsis;
}



/* =========================================================
   FORM
========================================================= */

.medical-health-form {
    width: 100%;

    max-width: 700px;

    margin: 0 auto;
}


.medical-health-field {
    position: relative;

    width: 100%;

    margin-bottom: 20px;
}


.medical-health-field label {
    display: block;

    margin-bottom: 7px;

    color: #6f6b60;

    font-size: 11px;
    font-weight: 700;

    letter-spacing: .04em;

    text-transform: uppercase;
}


.medical-health-field input,
.medical-health-field textarea {
    width: 100%;

    border: 1px solid #dfddd4;
    border-radius: 12px;

    outline: none;

    background: #fafaf8;

    color: #292820;

    font-family: inherit;
    font-size: 15px;
}


.medical-health-field input {
    height: 48px;

    padding: 0 13px;
}


.medical-health-field textarea {
    min-height: 130px;

    padding: 13px 14px 30px;

    resize: vertical;

    line-height: 1.5;
}


.medical-health-field input:focus,
.medical-health-field textarea:focus {
    border-color: #c87932;

    background: #ffffff;

    box-shadow:
        0 0 0 3px
        rgba(200, 121, 50, .10);
}


.medical-health-field span {
    position: absolute;

    right: 11px;
    bottom: 9px;

    color: #8b877c;

    font-size: 10px;

    pointer-events: none;
}



/* =========================================================
   SUBMIT
========================================================= */

.medical-health-submit {
    width: 100%;

    min-height: 50px;

    display: flex;
    align-items: center;
    justify-content: center;

    gap: 8px;

    padding: 10px 14px;

    border: none;
    border-radius: 13px;

    background: #198754;

    color: #ffffff;

    font-family: inherit;

    font-size: 14px;
    font-weight: 700;

    cursor: pointer;
}


.medical-health-submit:hover {
    background: #146c43;
}


.medical-health-submit:active {
    transform: scale(.99);
}



/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 600px) {

    .medical-health-composer__heading h2 {
        font-size: 17px;
    }


    .medical-health-modal__header {
        height: 60px;
        flex-basis: 60px;
    }


    .medical-health-modal__body {
        padding: 14px;
    }

}

</style>



<script>

(function () {

    "use strict";


    function initializeMedicalComposer() {

        const openButtons =
            document.querySelectorAll(
                "[data-medical-open]"
            );


        const closeButtons =
            document.querySelectorAll(
                "[data-medical-close]"
            );


        if (!openButtons.length) {
            return;
        }


        function closeAllModals() {

            document
                .querySelectorAll(
                    ".medical-health-modal.active"
                )
                .forEach(function (modal) {

                    modal.classList.remove(
                        "active"
                    );

                    modal.setAttribute(
                        "aria-hidden",
                        "true"
                    );

                });


            document.body.style.overflow =
                "";

        }


        openButtons.forEach(
            function (button) {

                button.addEventListener(
                    "click",
                    function () {

                        const modalId =
                            button.getAttribute(
                                "data-medical-open"
                            );


                        const modal =
                            document.getElementById(
                                modalId
                            );


                        if (!modal) {
                            return;
                        }


                        modal.classList.add(
                            "active"
                        );


                        modal.setAttribute(
                            "aria-hidden",
                            "false"
                        );


                        document.body.style.overflow =
                            "hidden";

                    }
                );

            }
        );


        closeButtons.forEach(
            function (button) {

                button.addEventListener(
                    "click",
                    function () {

                        const modalId =
                            button.getAttribute(
                                "data-medical-close"
                            );


                        const modal =
                            document.getElementById(
                                modalId
                            );


                        if (!modal) {
                            return;
                        }


                        modal.classList.remove(
                            "active"
                        );


                        modal.setAttribute(
                            "aria-hidden",
                            "true"
                        );


                        document.body.style.overflow =
                            "";

                    }
                );

            }
        );


        document.addEventListener(
            "keydown",
            function (event) {

                if (
                    event.key === "Escape"
                ) {

                    closeAllModals();

                }

            }
        );


        document
            .querySelectorAll(
                ".medical-health-form"
            )
            .forEach(function (form) {

                const textarea =
                    form.querySelector(
                        "textarea"
                    );


                const counter =
                    form.querySelector(
                        ".medical-health-field span"
                    );


                if (
                    textarea &&
                    counter
                ) {

                    textarea.addEventListener(
                        "input",
                        function () {

                            counter.textContent =
                                textarea.value.length +
                                "/1000";

                        }
                    );

                }


                form.addEventListener(
                    "submit",
                    function () {

                        const submit =
                            form.querySelector(
                                "button[type='submit']"
                            );


                        if (!submit) {
                            return;
                        }


                        submit.disabled =
                            true;


                        submit.innerHTML =
                            '<i class="bi bi-hourglass-split"></i>' +
                            '<span>Submitting...</span>';

                    }
                );

            });

    }


    if (
        document.readyState === "loading"
    ) {

        document.addEventListener(
            "DOMContentLoaded",
            initializeMedicalComposer
        );

    } else {

        initializeMedicalComposer();

    }

})();

</script>