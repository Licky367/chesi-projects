    border-radius: 50%;

    background: transparent;

    color: #c87932;

    font-size: 27px;

    line-height: 1;

    cursor: pointer;

}


.medical-composer-modal__back:active {

    background: #fff3e5;

}


.medical-composer-modal__title {

    min-width: 0;

    margin-left: 8px;

    display: flex;

    flex-direction: column;

    line-height: 1.25;

}


.medical-composer-modal__title strong {

    color: #35422f;

    font-size: 17px;

}


.medical-composer-modal__title span {

    max-width: 72vw;

    margin-top: 2px;

    overflow: hidden;

    color: #858078;

    font-size: 12px;

    white-space: nowrap;

    text-overflow: ellipsis;

}


.medical-composer-modal__spacer {

    flex: 1;

}



/* =========================================================
   MODAL BODY
========================================================= */

.medical-composer-modal__body {

    flex: 1 1 auto;

    min-height: 0;

    overflow-y: auto;

    padding: 20px;

}


.medical-composer-modal__inner {

    width: 100%;

    max-width: 700px;

    margin: 0 auto;

}



/* =========================================================
   QUESTION
========================================================= */

.medical-composer__question {

    margin-bottom: 20px;

    color: #30382d;

    font-size: 20px;

    line-height: 1.45;

}


