    border-radius: 13px;

    background: #d58a43;

    color: #ffffff;

    font-family: inherit;

    font-size: 14px;

    font-weight: 700;

    cursor: pointer;

}


.medical-composer__submit:not(:disabled):hover {

    background: #bc7130;

}


.medical-composer__submit:disabled {

    background: #c8c4bd;

