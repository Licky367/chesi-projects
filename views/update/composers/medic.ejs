}



/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 600px) {

    .medical-composer__heading {

        font-size: 17px;

    }


    .medical-composer-modal__header {

        height: 60px;

        flex-basis: 60px;

        padding: 0 10px;

    }


    .medical-composer-modal__body {

        padding: 14px;

    }


    .medical-composer__question {

        font-size: 19px;

    }

}

</style>



<!-- =======================================================
     JAVASCRIPT
======================================================== -->

<script>

(function () {

    "use strict";


    function initializeMedicalComposer() {


        /* =====================================================
           OPEN BUTTONS
        ====================================================== */

        const openButtons =
            document.querySelectorAll(
                "[data-medical-open]"
            );


        const closeButtons =
            document.querySelectorAll(
                "[data-medical-close]"
            );


        if (!openButtons.length) {

            return;

        }



        /* =====================================================
           OPEN MODAL
        ====================================================== */

        function openModal(index) {

            const modal =
                document.getElementById(
                    "medicalComposerModal-" + index
                );


            if (!modal) {

                return;

            }


            modal.classList.add(
                "active"
            );


            modal.setAttribute(
                "aria-hidden",
                "false"
            );


            document.body.style.overflow =
                "hidden";


            const typeInput =
                document.getElementById(
                    "medicalType-" + index
                );


            if (typeInput) {

                window.setTimeout(
                    function () {

                        typeInput.focus();

                    },
                    100
                );

            }

        }



        /* =====================================================
           CLOSE MODAL
        ====================================================== */

        function closeModal(index) {

            const modal =
                document.getElementById(
                    "medicalComposerModal-" + index
                );


            if (!modal) {

                return;

            }


            modal.classList.remove(
                "active"
            );


            modal.setAttribute(
                "aria-hidden",
                "true"
            );


            const activeModal =
                document.querySelector(
                    ".medical-composer-modal.active"
                );


            if (!activeModal) {

                document.body.style.overflow =
                    "";

            }

        }



        /* =====================================================
           OPEN EVENTS
        ====================================================== */

        openButtons.forEach(
            function (button) {

                button.addEventListener(
                    "click",
                    function () {

                        openModal(
                            button.dataset.medicalOpen
                        );

                    }
                );

            }
        );



        /* =====================================================
           CLOSE EVENTS
        ====================================================== */

        closeButtons.forEach(
            function (button) {

                button.addEventListener(
                    "click",
                    function () {

                        closeModal(
                            button.dataset.medicalClose
                        );

                    }
                );

            }
        );



        /* =====================================================
           ESCAPE
        ====================================================== */

        document.addEventListener(
            "keydown",
            function (event) {

                if (
                    event.key !== "Escape"
                ) {

                    return;

                }


                const modal =
                    document.querySelector(
                        ".medical-composer-modal.active"
                    );


                if (!modal) {

                    return;

                }


                const id =
                    modal.id.replace(
                        "medicalComposerModal-",
                        ""
                    );


                closeModal(id);

            }
        );



        /* =====================================================
           FORM INITIALIZATION
        ====================================================== */

        document
            .querySelectorAll(
                "[data-medical-form]"
            )
            .forEach(
                function (form) {

                    const index =
                        form.dataset.medicalForm;


                    const typeInput =
                        document.getElementById(
                            "medicalType-" + index
                        );


                    const detailsInput =
                        document.getElementById(
                            "medicalDetails-" + index
                        );


                    const counter =
                        document.querySelector(
                            '[data-medical-counter="' +
                            index +
                            '"]'
                        );


                    const submitButton =
                        document.querySelector(
                            '[data-medical-submit="' +
                            index +
                            '"]'
                        );


                    if (
                        !typeInput ||
                        !detailsInput ||
                        !counter ||
                        !submitButton
                    ) {

                        return;

                    }



                    /* =========================================
                       VALIDATION
                    ========================================== */

                    function updateSubmit() {

                        submitButton.disabled =
                            !(
                                typeInput.value.trim() &&
                                detailsInput.value.trim()
                            );

                    }



                    /* =========================================
                       COUNTER
                    ========================================== */

                    function updateCounter() {

                        counter.textContent =
                            detailsInput.value.length +
                            "/1000";

                    }



                    typeInput.addEventListener(
                        "input",
                        updateSubmit
                    );


                    detailsInput.addEventListener(
                        "input",
                        function () {

                            updateCounter();

                            updateSubmit();

                        }
                    );



                    /* =========================================
                       SUBMIT
                    ========================================== */

                    form.addEventListener(
                        "submit",
                        function () {

                            submitButton.disabled =
                                true;


                            submitButton.innerHTML =
                                '<i class="bi bi-hourglass-split"></i>' +
                                '<span>Submitting...</span>';

                        }
                    );


                    updateCounter();

                    updateSubmit();

                }
            );

    }



    /* =========================================================
       DOM READY
    ========================================================== */

    if (
        document.readyState === "loading"
    ) {

        document.addEventListener(
            "DOMContentLoaded",
            initializeMedicalComposer
        );

    } else {

        initializeMedicalComposer();

    }

})();

</script>


<% } %>