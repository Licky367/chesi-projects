    font-size: 10px;

}


.medical-composer__target-info strong {

    margin-top: 3px;

    overflow: hidden;

    color: #8b5425;

    font-size: 14px;

    white-space: nowrap;

    text-overflow: ellipsis;

}



/* =========================================================
   FORM
========================================================= */

.medical-composer__form {

    width: 100%;

    margin: 0;

}


.medical-composer__field {

    position: relative;

    width: 100%;

    margin-bottom: 20px;

}


.medical-composer__field label {

    display: block;

    margin-bottom: 7px;

