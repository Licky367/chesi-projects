<% /*
============================================================
MILK HISTORY CARDS

FILE:
    views/update/milk-history-cards.ejs

PURPOSE:
    Displays horizontally scrollable milking-history cards
    for eligible animals belonging to the CURRENT parent farm.

DATA:
    assetDairies

IMPORTANT:
    assetDairies is ALWAYS provided by the controller.

    The controller is responsible for ensuring that
    assetDairies contains only dairies belonging to the
    current parent farm.

ELIGIBLE ANIMALS:
    1. Positive AND even code
       OR
    2. gender === "female"

NAVIGATION:
    /milk/history/:id

DESIGN:
    - Horizontal left/right scrolling
    - Compact cards
    - Entire card is clickable
    - No JavaScript required
============================================================
*/ %>


<%
/*
============================================================
FILTER ELIGIBLE ANIMALS
============================================================

assetDairies is already scoped to the current parent farm.

We only display:
    - positive even animal codes
    OR
    - female animals
============================================================
*/

const milkHistoryAnimals = Array.isArray(assetDairies)
    ? assetDairies.filter((animal) => {

        if (!animal) {
            return false;
        }

        const code = Number(animal.code);

        const positiveEvenCode =
            Number.isInteger(code) &&
            code > 0 &&
            code % 2 === 0;

        const female =
            typeof animal.gender === "string" &&
            animal.gender.toLowerCase() === "female";

        return positiveEvenCode || female;

    })
    : [];

%>


<% if (milkHistoryAnimals.length > 0) { %>

<section class="milk-history-cards-section">


    <!-- =====================================================
         SECTION TITLE
    ====================================================== -->

    <div class="milk-history-cards-section__header">

        <h2 class="milk-history-cards-section__title">

            View Our Cattles' Milking History

        </h2>

    </div>



    <!-- =====================================================
         HORIZONTAL CARD SCROLLER
    ====================================================== -->

    <div
        class="milk-history-cards"
        aria-label="Cattles' milking history"
    >


        <% milkHistoryAnimals.forEach((animal) => { %>


            <!-- =================================================
                 MILKING HISTORY CARD
            ================================================== -->

            <a
                href="/milk/history/<%= animal._id %>"
                class="milk-history-card"
                aria-label="View milking history for <%= animal.name || 'Animal' %>"
            >


                <!-- =============================================
                     ICON
                ============================================== -->

                <span
                    class="milk-history-card__icon"
                    aria-hidden="true"
                >

                    <i class="bi bi-clock-history"></i>

                </span>



                <!-- =============================================
                     LABEL
                ============================================== -->

                <span class="milk-history-card__label">

                    MILKING

                </span>



                <!-- =============================================
                     ANIMAL NAME
                ============================================== -->

                <span class="milk-history-card__name">

                    <%= animal.name || "Unnamed Animal" %>

                </span>



                <!-- =============================================
                     ANIMAL CODE
                ============================================== -->

                <% if (animal.code !== undefined && animal.code !== null) { %>

                    <span class="milk-history-card__code">

                        #<%= animal.code %>

                    </span>

                <% } %>



                <!-- =============================================
                     ARROW
                ============================================== -->

                <span
                    class="milk-history-card__arrow"
                    aria-hidden="true"
                >

                    <i class="bi bi-chevron-right"></i>

                </span>


            </a>


        <% }) %>


    </div>


</section>


<style>

/* ==========================================================
   MILK HISTORY CARDS SECTION
========================================================== */

.milk-history-cards-section {

    width: 100%;

    box-sizing: border-box;

    margin: 18px 0;

}



/* ==========================================================
   HEADER
========================================================== */

.milk-history-cards-section__header {

    width: 100%;

    box-sizing: border-box;

    margin-bottom: 10px;

}



/* ==========================================================
   TITLE
========================================================== */

.milk-history-cards-section__title {

    margin: 0;

    color: #26322b;

    font-size: 17px;

    font-weight: 800;

    line-height: 1.25;

}



/* ==========================================================
   HORIZONTAL SCROLLER
========================================================== */

.milk-history-cards {

    width: 100%;

    display: flex;

    flex-direction: row;

    align-items: stretch;

    gap: 10px;

    overflow-x: auto;

    overflow-y: hidden;

    padding: 4px 3px 10px;

    box-sizing: border-box;

    scroll-behavior: smooth;

    -webkit-overflow-scrolling: touch;

    scrollbar-width: thin;

}



/* ==========================================================
   SCROLLBAR
========================================================== */

.milk-history-cards::-webkit-scrollbar {

    height: 5px;

}



.milk-history-cards::-webkit-scrollbar-track {

    background: #edf3ef;

    border-radius: 10px;

}



.milk-history-cards::-webkit-scrollbar-thumb {

    background: #b7cdbf;

    border-radius: 10px;

}



.milk-history-cards::-webkit-scrollbar-thumb:hover {

    background: #198754;

}



/* ==========================================================
   CARD
========================================================== */

.milk-history-card {

    position: relative;

    width: 112px;

    height: 155px;

    flex: 0 0 112px;

    box-sizing: border-box;

    padding: 12px 9px;

    display: flex;

    flex-direction: column;

    align-items: center;

    justify-content: center;

    gap: 6px;

    overflow: hidden;

    border: 1px solid #dce7e0;

    border-radius: 15px;

    background:
        linear-gradient(
            145deg,
            #ffffff,
            #f3f8f5
        );

    color: #198754;

    text-decoration: none;

    font-family: inherit;

    cursor: pointer;

    text-align: center;

    transition:
        transform .15s ease,
        border-color .15s ease,
        box-shadow .15s ease;

}



/* ==========================================================
   HOVER
========================================================== */

.milk-history-card:hover {

    border-color: #198754;

    box-shadow:
        0 5px 15px
        rgba(25, 135, 84, .10);

}



/* ==========================================================
   ACTIVE
========================================================== */

.milk-history-card:active {

    transform: scale(.95);

}



/* ==========================================================
   KEYBOARD FOCUS
========================================================== */

.milk-history-card:focus-visible {

    outline: 2px solid #198754;

    outline-offset: 2px;

}



/* ==========================================================
   ICON
========================================================== */

.milk-history-card__icon {

    width: 46px;

    height: 46px;

    flex: 0 0 46px;

    display: flex;

    align-items: center;

    justify-content: center;

    border-radius: 50%;

    background: #198754;

    color: #ffffff;

    font-size: 21px;

    box-shadow:
        0 4px 12px
        rgba(25, 135, 84, .20);

}



/* ==========================================================
   LABEL
========================================================== */

.milk-history-card__label {

    display: block;

    color: #789080;

    font-size: 8px;

    font-weight: 800;

    letter-spacing: .7px;

    line-height: 1.1;

}



/* ==========================================================
   ANIMAL NAME
========================================================== */

.milk-history-card__name {

    display: block;

    width: 100%;

    max-width: 94px;

    overflow: hidden;

    color: #26322b;

    font-size: 12px;

    font-weight: 800;

    line-height: 1.2;

    white-space: nowrap;

    text-overflow: ellipsis;

}



/* ==========================================================
   ANIMAL CODE
========================================================== */

.milk-history-card__code {

    display: block;

    color: #8a928d;

    font-size: 9px;

    line-height: 1.2;

    white-space: nowrap;

}



/* ==========================================================
   ARROW
========================================================== */

.milk-history-card__arrow {

    position: absolute;

    right: 7px;

    bottom: 7px;

    width: 22px;

    height: 22px;

    display: flex;

    align-items: center;

    justify-content: center;

    border-radius: 50%;

    background: #eaf6ee;

    color: #198754;

    font-size: 10px;

}



/* ==========================================================
   MOBILE
========================================================== */

@media (max-width: 600px) {

    .milk-history-cards-section__title {

        font-size: 16px;

    }


    .milk-history-card {

        width: 108px;

        height: 150px;

        flex-basis: 108px;

    }


    .milk-history-card__icon {

        width: 44px;

        height: 44px;

        flex-basis: 44px;

        font-size: 20px;

    }

}



/* ==========================================================
   SMALL PHONES
========================================================== */

@media (max-width: 380px) {

    .milk-history-card {

        width: 108px;

        height: 150px;

        flex-basis: 108px;

    }

}

</style>

<% } %>