<!-- =========================================================
     JAVASCRIPT
========================================================= -->

<script>

(function () {

    "use strict";


    /* =====================================================
       INITIALIZE
    ====================================================== */

    function initializePostModal() {

        const modal =
            document.getElementById("postModal");

        const openComposer =
            document.getElementById("openPostComposer");

        const closeButton =
            document.getElementById("closePostModal");

        const titleInput =
            document.getElementById("postTitle");

        const formTitleInput =
            document.getElementById("formPostTitle");

        const textarea =
            document.getElementById("postText");

        const imageInput =
            document.getElementById("postImage");

        const imagePreviewContainer =
            document.getElementById("imagePreviewContainer");

        const imagePreviewGrid =
            document.getElementById("imagePreviewGrid");

        const titleCharacterCounter =
            document.getElementById("titleCharacterCounter");

        const characterCounter =
            document.getElementById("characterCounter");

        const sendButton =
            document.getElementById("submitPostButton");

        const form =
            document.getElementById("postForm");


        /* =================================================
           REQUIRED ELEMENT CHECK
        ================================================== */

        if (
            !modal ||
            !openComposer ||
            !closeButton ||
            !titleInput ||
            !formTitleInput ||
            !textarea ||
            !imageInput ||
            !imagePreviewContainer ||
            !imagePreviewGrid ||
            !titleCharacterCounter ||
            !characterCounter ||
            !sendButton ||
            !form
        ) {

            console.error(
                "Post modal could not initialize. Required element missing."
            );

            return;

        }


        /* =================================================
           CONSTANTS
        ================================================== */

        const MAX_IMAGES = 10;



        /* =================================================
           SELECTED IMAGES
           
           We maintain our own array because replacing
           imageInput.files directly is not reliable for
           removing individual files.
        ================================================== */

        let selectedImages = [];



        /* =================================================
           OPEN MODAL
        ================================================== */

        function openModal() {

            modal.classList.add("active");

            modal.setAttribute(
                "aria-hidden",
                "false"
            );

            document.body.style.overflow = "hidden";


            setTimeout(function () {

                titleInput.focus();

            }, 100);

        }



        /* =================================================
           CLOSE MODAL
        ================================================== */

        function closeModal() {

            modal.classList.remove("active");

            modal.setAttribute(
                "aria-hidden",
                "true"
            );

            document.body.style.overflow = "";

        }



        /* =================================================
           TITLE COUNTER
        ================================================== */

        function updateTitleCounter() {

            const length =
                titleInput.value.length;

            titleCharacterCounter.textContent =
                length + "/150";

        }



        /* =================================================
           TEXT COUNTER
        ================================================== */

        function updateCharacterCounter() {

            const length =
                textarea.value.length;

            characterCounter.textContent =
                length + "/1000";

        }



        /* =================================================
           SEND BUTTON
        ================================================== */

        function updateSendButton() {

            const hasTitle =
                titleInput.value.trim().length > 0;

            const hasText =
                textarea.value.trim().length > 0;

            const hasImages =
                selectedImages.length > 0;

            sendButton.disabled =
                !(hasTitle || hasText || hasImages);

        }



        /* =================================================
           TEXTAREA AUTO HEIGHT
        ================================================== */

        function resizeTextarea() {

            textarea.style.height = "auto";

            const newHeight =
                Math.min(
                    textarea.scrollHeight,
                    120
                );

            textarea.style.height =
                newHeight + "px";

        }



        /* =================================================
           SYNC FILE INPUT
           
           This allows individual files to be removed while
           keeping the final multipart upload as name="images".
        ================================================== */

        function syncFileInput() {

            const dataTransfer =
                new DataTransfer();


            selectedImages.forEach(function (file) {

                dataTransfer.items.add(file);

            });


            imageInput.files =
                dataTransfer.files;

        }



        /* =================================================
           RENDER IMAGE PREVIEWS
        ================================================== */

        function renderImagePreviews() {

            imagePreviewGrid.innerHTML = "";


            if (selectedImages.length === 0) {

                imagePreviewContainer.hidden = true;

                return;

            }


            imagePreviewContainer.hidden = false;


            selectedImages.forEach(
                function (file, index) {

                    const reader =
                        new FileReader();


                    reader.onload =
                        function (event) {

                            const item =
                                document.createElement("div");

                            item.className =
                                "image-preview-item";


                            const image =
                                document.createElement("img");

                            image.src =
                                event.target.result;

                            image.alt =
                                "Selected image " +
                                (index + 1);


                            const removeButton =
                                document.createElement("button");

                            removeButton.type =
                                "button";

                            removeButton.className =
                                "remove-image-button";

                            removeButton.setAttribute(
                                "aria-label",
                                "Remove image " +
                                (index + 1)
                            );


                            removeButton.innerHTML =
                                '<i class="bi bi-x-lg"></i>';


                            removeButton.addEventListener(
                                "click",
                                function () {

                                    removeImage(index);

                                }
                            );


                            const number =
                                document.createElement("span");

                            number.className =
                                "image-preview-number";

                            number.textContent =
                                index + 1;


                            item.appendChild(image);

                            item.appendChild(number);

                            item.appendChild(removeButton);

                            imagePreviewGrid.appendChild(item);

                        };


                    reader.readAsDataURL(file);

                }
            );


            /* =================================================
               ADD MORE BUTTON
            ================================================== */

            if (
                selectedImages.length < MAX_IMAGES
            ) {

                const addMore =
                    document.createElement("label");

                addMore.className =
                    "add-more-images";

                addMore.setAttribute(
                    "for",
                    "postImage"
                );


                addMore.innerHTML =
                    '<i class="bi bi-plus-lg"></i>' +
                    '<span>Add photos</span>';


                imagePreviewGrid.appendChild(
                    addMore
                );

            }


            /* =================================================
               IMAGE COUNT
            ================================================== */

            const countMessage =
                document.createElement("div");

            countMessage.className =
                "image-count-message";

            countMessage.textContent =
                selectedImages.length +
                " of " +
                MAX_IMAGES +
                " photos selected";


            imagePreviewContainer.appendChild(
                countMessage
            );

        }



        /* =================================================
           REMOVE IMAGE
        ================================================== */

        function removeImage(index) {

            if (
                index < 0 ||
                index >= selectedImages.length
            ) {

                return;

            }


            selectedImages.splice(
                index,
                1
            );


            syncFileInput();

            renderImagePreviews();

            updateSendButton();

        }



        /* =================================================
           ADD SELECTED IMAGES
        ================================================== */

        function addImages(files) {

            const incomingFiles =
                Array.from(files);


            if (!incomingFiles.length) {

                return;

            }


            for (
                let i = 0;
                i < incomingFiles.length;
                i++
            ) {

                const file =
                    incomingFiles[i];


                /* =========================================
                   IMAGE CHECK
                ========================================== */

                if (
                    !file.type.startsWith("image/")
                ) {

                    continue;

                }


                /* =========================================
                   MAXIMUM IMAGE CHECK
                ========================================== */

                if (
                    selectedImages.length >= MAX_IMAGES
                ) {

                    break;

                }


                /* =========================================
                   DUPLICATE CHECK
                ========================================== */

                const duplicate =
                    selectedImages.some(
                        function (existingFile) {

                            return (
                                existingFile.name === file.name &&
                                existingFile.size === file.size &&
                                existingFile.lastModified ===
                                    file.lastModified
                            );

                        }
                    );


                if (duplicate) {

                    continue;

                }


                selectedImages.push(file);

            }


            syncFileInput();

            renderImagePreviews();

            updateSendButton();

        }



        /* =================================================
           TITLE INPUT
        ================================================== */

        titleInput.addEventListener(
            "input",
            function () {

                updateTitleCounter();

                updateSendButton();

            }
        );



        /* =================================================
           TEXT INPUT
        ================================================== */

        textarea.addEventListener(
            "input",
            function () {

                updateCharacterCounter();

                updateSendButton();

                resizeTextarea();

            }
        );



        /* =================================================
           OPEN COMPOSER
        ================================================== */

        openComposer.addEventListener(
            "click",
            function () {

                openModal();

            }
        );


        openComposer.addEventListener(
            "keydown",
            function (event) {

                if (
                    event.key === "Enter" ||
                    event.key === " "
                ) {

                    event.preventDefault();

                    openModal();

                }

            }
        );



        /* =================================================
           CLOSE BUTTON
        ================================================== */

        closeButton.addEventListener(
            "click",
            function () {

                closeModal();

            }
        );



        /* =================================================
           ESCAPE
        ================================================== */

        document.addEventListener(
            "keydown",
            function (event) {

                if (
                    event.key === "Escape" &&
                    modal.classList.contains("active")
                ) {

                    closeModal();

                }

            }
        );



        /* =================================================
           IMAGE SELECTION
        ================================================== */

        imageInput.addEventListener(
            "change",
            function () {

                addImages(
                    imageInput.files
                );

            }
        );



        /* =================================================
           FORM SUBMIT
        ================================================== */

        form.addEventListener(
            "submit",
            function (event) {

                const title =
                    titleInput.value.trim();

                const text =
                    textarea.value.trim();

                const hasImages =
                    selectedImages.length > 0;


                /* =========================================
                   VALIDATION
                ========================================== */

                if (
                    !title &&
                    !text &&
                    !hasImages
                ) {

                    event.preventDefault();

                    titleInput.focus();

                    return;

                }


                /* =========================================
                   COPY TITLE INTO FORM
                ========================================== */

                formTitleInput.value =
                    title;


                /* =========================================
                   FINAL FILE SYNC
                ========================================== */

                syncFileInput();


                /* =========================================
                   DISABLE SEND BUTTON
                ========================================== */

                sendButton.disabled =
                    true;


                sendButton.innerHTML =
                    '<i class="bi bi-hourglass-split"></i>';

            }
        );



        /* =================================================
           INITIAL STATE
        ================================================== */

        updateTitleCounter();

        updateCharacterCounter();

        updateSendButton();

        resizeTextarea();

    }



    /* =====================================================
       DOM READY
    ====================================================== */

    if (
        document.readyState === "loading"
    ) {

        document.addEventListener(
            "DOMContentLoaded",
            initializePostModal
        );

    } else {

        initializePostModal();

    }

})();

</script>