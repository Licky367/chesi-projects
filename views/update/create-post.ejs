<!-- =========================================================
     CREATE POST + FULL SCREEN POST MODAL
========================================================= -->

<!-- Bootstrap Icons -->
<link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
>


<!-- =========================================================
     CREATE POST CARD
========================================================= -->

<section class="create-post-card">

    <div class="create-post-header">

        <!-- USER AVATAR -->
        <div class="create-post-avatar">

            <img
                src="<%= user.profileImage || ('https://ui-avatars.com/api/?name=' + encodeURIComponent(user.name)) %>"
                alt="<%= user.name %>"
                class="avatar-sm"
            >

        </div>


        <!-- HEADING -->
        <div class="create-post-heading">

            <div class="heading-line">

                <strong>
                    <%= user.name.split(" ")[0] %>
                </strong>

                , update us about

            </div>

            <div class="heading-line">

                <strong>
                    <%= dairy.name %>
                </strong>

            </div>

        </div>

    </div>


    <!-- =====================================================
         CLICKABLE COMPOSER TRIGGER
    ====================================================== -->

    <div
        id="openPostComposer"
        class="composer-trigger"
        role="button"
        tabindex="0"
        aria-label="Create post"
    >

        <span>
            Share an update...
        </span>

    </div>

</section>



<!-- =========================================================
     FULL SCREEN POST MODAL
========================================================= -->

<div
    id="postModal"
    class="post-modal"
    aria-hidden="true"
>

    <div class="post-modal-content">


        <!-- =================================================
             MODAL HEADER
        ================================================== -->

        <header class="post-modal-header">

            <button
                type="button"
                id="closePostModal"
                class="post-back-button"
                aria-label="Go back"
            >

                <i class="bi bi-arrow-left"></i>

            </button>


            <div class="post-modal-title">

                <strong>New Update</strong>

                <span>
                    <%= dairy.name %>
                </span>

            </div>


            <!-- Spacer -->
            <div class="post-header-spacer"></div>

        </header>



        <!-- =================================================
             POST BODY
        ================================================== -->

        <main class="post-modal-body">


            <!-- =============================================
                 IMAGE PREVIEW
            ============================================== -->

            <div
                id="imagePreviewContainer"
                class="image-preview-container"
                hidden
            >

                <div class="image-preview-wrapper">

                    <img
                        id="imagePreview"
                        src=""
                        alt="Selected image"
                        class="image-preview"
                    >

                    <button
                        type="button"
                        id="removeImage"
                        class="remove-image-button"
                        aria-label="Remove image"
                    >

                        <i class="bi bi-x-lg"></i>

                    </button>

                </div>

            </div>


        </main>



        <!-- =================================================
             BOTTOM MESSAGE COMPOSER
        ================================================== -->

        <div class="post-composer-wrapper">

            <form
                id="postForm"
                action="/dairy/<%= dairy._id %>/post"
                method="POST"
                enctype="multipart/form-data"
                class="post-form"
            >


                <!-- =========================================
                     MESSAGE COMPOSER
                ========================================== -->

                <div class="post-composer">


                    <!-- =====================================
                         ATTACHMENT
                    ====================================== -->

                    <label
                        for="postImage"
                        class="composer-icon-button attachment-button"
                        aria-label="Attach image"
                        title="Attach image"
                    >

                        <i class="bi bi-paperclip"></i>

                    </label>


                    <input
                        type="file"
                        id="postImage"
                        name="image"
                        accept="image/*"
                        hidden
                    >



                    <!-- =====================================
                         TEXT INPUT
                    ====================================== -->

                    <div class="composer-input-area">

                        <textarea
                            id="postText"
                            name="text"
                            maxlength="1000"
                            rows="1"
                            placeholder="Type your update..."
                            aria-label="Type your update"
                        ></textarea>


                        <span
                            id="characterCounter"
                            class="character-counter"
                        >
                            0/1000
                        </span>

                    </div>



                    <!-- =====================================
                         SEND
                    ====================================== -->

                    <button
                        type="submit"
                        id="submitPostButton"
                        class="composer-send-button"
                        aria-label="Send update"
                        disabled
                    >

                        <i class="bi bi-send-fill"></i>

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>



<!-- =========================================================
     CSS
========================================================= -->

<style>

/* =========================================================
   CREATE POST CARD
========================================================= */

.create-post-card {

    width: 100%;
    background: #ffffff;
    border-radius: 16px;
    padding: 16px;
    margin-bottom: 16px;
    box-sizing: border-box;

    border: 1px solid #e7eee9;

}


.create-post-header {

    display: flex;
    align-items: center;
    gap: 12px;
}


.create-post-avatar {

    flex-shrink: 0;
}


.avatar-sm {

    width: 44px;
    height: 44px;

    border-radius: 50%;

    object-fit: cover;

    display: block;

}


.create-post-heading {

    min-width: 0;

    font-size: 14px;
    line-height: 1.5;

    color: #555;

}


.heading-line {

    display: block;

}


.create-post-heading strong {

    color: #222;

}


.composer-trigger {

    margin-top: 14px;

    min-height: 48px;

    padding: 0 16px;

    border: 1px solid #dfe8e2;

    border-radius: 24px;

    display: flex;
    align-items: center;

    color: #888;

    background: #f8faf8;

    cursor: pointer;

    transition:
        background 0.2s ease,
        border-color 0.2s ease,
        transform 0.15s ease;

}


.composer-trigger:hover {

    background: #f1f7f3;

    border-color: #2e8b57;

}


.composer-trigger:active {

    transform: scale(0.99);

}



/* =========================================================
   FULL SCREEN MODAL
========================================================= */

.post-modal {

    position: fixed;

    inset: 0;

    width: 100vw;
    height: 100dvh;

    background: #ffffff;

    z-index: 99999;

    display: none;

    overflow: hidden;

}


.post-modal.active {

    display: block;

}


.post-modal-content {

    position: relative;

    width: 100%;
    height: 100%;

    display: flex;

    flex-direction: column;

    background: #ffffff;

}



/* =========================================================
   HEADER
========================================================= */

.post-modal-header {

    flex: 0 0 auto;

    height: 64px;

    width: 100%;

    display: flex;

    align-items: center;

    padding:
        0 16px;

    box-sizing: border-box;

    border-bottom: 1px solid #e8eee9;

    background: #ffffff;

}


.post-back-button {

    width: 44px;
    height: 44px;

    border: none;

    background: transparent;

    color: #198754;

    display: flex;

    align-items: center;
    justify-content: center;

    cursor: pointer;

    font-size: 27px;

    padding: 0;

    flex-shrink: 0;

}


.post-back-button i {

    display: block;

}


.post-back-button:hover {

    color: #146c43;

}


.post-modal-title {

    margin-left: 8px;

    display: flex;

    flex-direction: column;

    line-height: 1.25;

}


.post-modal-title strong {

    font-size: 17px;

    color: #202520;

}


.post-modal-title span {

    margin-top: 2px;

    font-size: 12px;

    color: #7a817d;

}


.post-header-spacer {

    flex: 1;

}



/* =========================================================
   BODY
========================================================= */

.post-modal-body {

    flex: 1 1 auto;

    min-height: 0;

    overflow-y: auto;

    padding: 20px;

    box-sizing: border-box;

}



/* =========================================================
   IMAGE PREVIEW
========================================================= */

.image-preview-container {

    width: 100%;

}


.image-preview-wrapper {

    position: relative;

    width: 100%;

    max-width: 600px;

    margin: 0 auto;

    border-radius: 14px;

    overflow: hidden;

    background: #f4f6f4;

}


.image-preview {

    display: block;

    width: 100%;

    max-height: 55vh;

    object-fit: contain;

}


.remove-image-button {

    position: absolute;

    top: 10px;
    right: 10px;

    width: 38px;
    height: 38px;

    border: none;

    border-radius: 50%;

    background: rgba(0, 0, 0, 0.65);

    color: #ffffff;

    display: flex;

    align-items: center;
    justify-content: center;

    cursor: pointer;

    font-size: 16px;

}



/* =========================================================
   BOTTOM COMPOSER WRAPPER
========================================================= */

.post-composer-wrapper {

    flex: 0 0 auto;

    width: 100%;

    padding:
        10px
        12px
        calc(10px + env(safe-area-inset-bottom));

    box-sizing: border-box;

    background: #ffffff;

    border-top: 1px solid #e8eee9;

}



/* =========================================================
   FORM
========================================================= */

.post-form {

    width: 100%;

    margin: 0;

}



/* =========================================================
   WHATSAPP-STYLE COMPOSER
========================================================= */

.post-composer {

    width: 100%;

    min-height: 50px;

    display: flex;

    align-items: flex-end;

    gap: 8px;

    padding: 5px 7px;

    box-sizing: border-box;

    border: 1px solid #dce6df;

    border-radius: 28px;

    background: #f7faf8;

}



/* =========================================================
   ATTACHMENT ICON
========================================================= */

.composer-icon-button {

    flex: 0 0 42px;

    width: 42px;
    height: 42px;

    border: none;

    background: transparent;

    color: #198754;

    display: flex;

    align-items: center;
    justify-content: center;

    cursor: pointer;

    font-size: 23px;

    padding: 0;

}


.composer-icon-button:hover {

    color: #146c43;

}


.attachment-button i {

    display: block;

    transform: rotate(-20deg);

}



/* =========================================================
   TEXT INPUT AREA
========================================================= */

.composer-input-area {

    position: relative;

    flex: 1;

    min-width: 0;

    display: flex;

    align-items: flex-end;

}


#postText {

    width: 100%;

    min-height: 40px;

    max-height: 120px;

    resize: none;

    overflow-y: auto;

    border: none;

    outline: none;

    background: transparent;

    padding:
        10px
        4px
        5px;

    margin: 0;

    box-sizing: border-box;

    font-family: inherit;

    font-size: 15px;

    line-height: 20px;

    color: #202520;

}


#postText::placeholder {

    color: #8b928d;

}


#postText:focus {

    outline: none;

    box-shadow: none;

}



/* =========================================================
   CHARACTER COUNTER
========================================================= */

.character-counter {

    position: absolute;

    right: 5px;

    bottom: 1px;

    font-size: 10px;

    color: #8a928d;

    pointer-events: none;

    background: #f7faf8;

    padding-left: 3px;

}



/* =========================================================
   SEND BUTTON
========================================================= */

.composer-send-button {

    flex: 0 0 42px;

    width: 42px;
    height: 42px;

    border: none;

    border-radius: 50%;

    background: transparent;

    color: #198754;

    display: flex;

    align-items: center;
    justify-content: center;

    cursor: pointer;

    font-size: 20px;

    padding: 0;

    transition:
        color 0.2s ease,
        transform 0.15s ease;

}


.composer-send-button:not(:disabled):hover {

    color: #146c43;

    transform: scale(1.08);

}


.composer-send-button:not(:disabled):active {

    transform: scale(0.94);

}


.composer-send-button:disabled {

    color: #b8c2bc;

    cursor: default;

}



/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 600px) {

    .post-modal-header {

        height: 60px;

        padding: 0 10px;

    }


    .post-modal-title strong {

        font-size: 16px;

    }


    .post-modal-body {

        padding: 14px;

    }


    .post-composer-wrapper {

        padding:
            8px
            8px
            calc(8px + env(safe-area-inset-bottom));

    }


    .post-composer {

        min-height: 48px;

        gap: 4px;

        padding: 4px 5px;

    }


    .composer-icon-button {

        width: 40px;
        height: 40px;

        flex-basis: 40px;

        font-size: 22px;

    }


    .composer-send-button {

        width: 40px;
        height: 40px;

        flex-basis: 40px;

        font-size: 19px;

    }


    #postText {

        font-size: 15px;

        min-height: 38px;

    }

}



/* =========================================================
   SMALL PHONES
========================================================= */

@media (max-width: 380px) {

    .post-modal-title span {

        display: none;

    }


    .post-modal-body {

        padding: 10px;

    }


    .character-counter {

        font-size: 9px;

    }

}

</style>



<!-- =========================================================
     JAVASCRIPT
========================================================= -->

<script>

(function () {

    "use strict";


    /* =====================================================
       INITIALIZE
    ====================================================== */

    function initializePostModal() {

        const modal =
            document.getElementById("postModal");

        const openComposer =
            document.getElementById("openPostComposer");

        const closeButton =
            document.getElementById("closePostModal");

        const textarea =
            document.getElementById("postText");

        const imageInput =
            document.getElementById("postImage");

        const imagePreviewContainer =
            document.getElementById("imagePreviewContainer");

        const imagePreview =
            document.getElementById("imagePreview");

        const removeImage =
            document.getElementById("removeImage");

        const characterCounter =
            document.getElementById("characterCounter");

        const sendButton =
            document.getElementById("submitPostButton");

        const form =
            document.getElementById("postForm");


        /* =================================================
           REQUIRED ELEMENT CHECK
        ================================================== */

        if (
            !modal ||
            !openComposer ||
            !closeButton ||
            !textarea ||
            !imageInput ||
            !imagePreviewContainer ||
            !imagePreview ||
            !removeImage ||
            !characterCounter ||
            !sendButton ||
            !form
        ) {

            console.error(
                "Post modal could not initialize. Required element missing."
            );

            return;

        }


        /* =================================================
           OPEN MODAL
        ================================================== */

        function openModal() {

            modal.classList.add("active");

            modal.setAttribute(
                "aria-hidden",
                "false"
            );

            document.body.style.overflow = "hidden";


            setTimeout(function () {

                textarea.focus();

            }, 100);

        }


        /* =================================================
           CLOSE MODAL
        ================================================== */

        function closeModal() {

            modal.classList.remove("active");

            modal.setAttribute(
                "aria-hidden",
                "true"
            );

            document.body.style.overflow = "";

        }


        /* =================================================
           CHARACTER COUNTER
        ================================================== */

        function updateCharacterCounter() {

            const length =
                textarea.value.length;

            characterCounter.textContent =
                length + "/1000";

        }


        /* =================================================
           SEND BUTTON
        ================================================== */

        function updateSendButton() {

            const hasText =
                textarea.value.trim().length > 0;

            const hasImage =
                imageInput.files &&
                imageInput.files.length > 0;

            sendButton.disabled =
                !(hasText || hasImage);

        }


        /* =================================================
           TEXTAREA AUTO HEIGHT
        ================================================== */

        function resizeTextarea() {

            textarea.style.height = "auto";

            const newHeight =
                Math.min(
                    textarea.scrollHeight,
                    120
                );

            textarea.style.height =
                newHeight + "px";

        }


        /* =================================================
           TEXT INPUT
        ================================================== */

        textarea.addEventListener(
            "input",
            function () {

                updateCharacterCounter();

                updateSendButton();

                resizeTextarea();

            }
        );


        /* =================================================
           OPEN COMPOSER
        ================================================== */

        openComposer.addEventListener(
            "click",
            function () {

                openModal();

            }
        );


        /* =================================================
           KEYBOARD OPEN
        ================================================== */

        openComposer.addEventListener(
            "keydown",
            function (event) {

                if (
                    event.key === "Enter" ||
                    event.key === " "
                ) {

                    event.preventDefault();

                    openModal();

                }

            }
        );


        /* =================================================
           CLOSE
        ================================================== */

        closeButton.addEventListener(
            "click",
            function () {

                closeModal();

            }
        );


        /* =================================================
           ESCAPE
        ================================================== */

        document.addEventListener(
            "keydown",
            function (event) {

                if (
                    event.key === "Escape" &&
                    modal.classList.contains("active")
                ) {

                    closeModal();

                }

            }
        );


        /* =================================================
           IMAGE SELECTED
        ================================================== */

        imageInput.addEventListener(
            "change",
            function () {

                const file =
                    imageInput.files[0];

                if (!file) {

                    imagePreviewContainer.hidden = true;

                    imagePreview.src = "";

                    updateSendButton();

                    return;

                }


                if (
                    !file.type.startsWith("image/")
                ) {

                    imageInput.value = "";

                    imagePreviewContainer.hidden = true;

                    imagePreview.src = "";

                    updateSendButton();

                    return;

                }


                const reader =
                    new FileReader();


                reader.onload =
                    function (event) {

                        imagePreview.src =
                            event.target.result;

                        imagePreviewContainer.hidden =
                            false;

                    };


                reader.readAsDataURL(file);

                updateSendButton();

            }
        );


        /* =================================================
           REMOVE IMAGE
        ================================================== */

        removeImage.addEventListener(
            "click",
            function () {

                imageInput.value = "";

                imagePreview.src = "";

                imagePreviewContainer.hidden = true;

                updateSendButton();

            }
        );


        /* =================================================
           FORM SUBMIT
        ================================================== */

        form.addEventListener(
            "submit",
            function (event) {

                const text =
                    textarea.value.trim();

                const hasImage =
                    imageInput.files &&
                    imageInput.files.length > 0;


                if (!text && !hasImage) {

                    event.preventDefault();

                    textarea.focus();

                    return;

                }


                sendButton.disabled = true;

                sendButton.innerHTML =
                    '<i class="bi bi-hourglass-split"></i>';

            }
        );


        /* =================================================
           INITIAL STATE
        ================================================== */

        updateCharacterCounter();

        updateSendButton();

        resizeTextarea();

    }


    /* =====================================================
       DOM READY
    ====================================================== */

    if (
        document.readyState === "loading"
    ) {

        document.addEventListener(
            "DOMContentLoaded",
            initializePostModal
        );

    } else {

        initializePostModal();

    }

})();

</script>