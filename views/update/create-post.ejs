<!-- =========================================================
     CREATE POST + FULL SCREEN POST MODAL
========================================================= -->

<link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
>


<!-- =========================================================
     CREATE POST CARD
========================================================= -->

<section class="create-post-card">

    <div class="create-post-header">

        <div class="create-post-avatar">

            <img
                src="<%= user.profileImage || ('https://ui-avatars.com/api/?name=' + encodeURIComponent(user.name)) %>"
                alt="<%= user.name %>"
                class="avatar-sm"
            >

        </div>


        <div class="create-post-heading">

            <% if (dairy.code < 0) { %>

                <div class="heading-line">

                    <strong>
                        <%= user.name.split(" ")[0] %>
                    </strong>

                    , update us about the overall conditions of this dairy Farm.

                </div>

            <% } else { %>

                <div class="heading-line">

                    <strong>
                        <%= user.name.split(" ")[0] %>
                    </strong>

                    , update us about

                </div>

                <div class="heading-line">

                    <strong>
                        <%= dairy.name %>
                    </strong>

                </div>

            <% } %>

        </div>

    </div>


    <div
        id="openPostComposer"
        class="composer-trigger"
        role="button"
        tabindex="0"
        aria-label="Create post"
    >

        <span>
            Share an update...
        </span>

    </div>

</section>



<!-- =========================================================
     FULL SCREEN POST MODAL
========================================================= -->

<div
    id="postModal"
    class="post-modal"
    aria-hidden="true"
>

    <div class="post-modal-content">


        <!-- =================================================
             HEADER
        ================================================== -->

        <header class="post-modal-header">

            <button
                type="button"
                id="closePostModal"
                class="post-back-button"
                aria-label="Go back"
            >

                <i class="bi bi-arrow-left"></i>

            </button>


            <div class="post-modal-title">

                <strong>
                    New Update
                </strong>

                <span>
                    <%= dairy.name %>
                </span>

            </div>


            <div class="post-header-spacer"></div>

        </header>



        <!-- =================================================
             BODY
        ================================================== -->

        <main class="post-modal-body">


            <!-- =================================================
                 TITLE
            ================================================== -->

            <div class="post-title-wrapper">

                <input
                    type="text"
                    id="postTitle"
                    maxlength="150"
                    placeholder="Post title..."
                    autocomplete="off"
                    aria-label="Post title"
                >

                <div class="post-title-counter">

                    <span id="titleCharacterCounter">
                        0/150
                    </span>

                </div>

            </div>



            <!-- =================================================
                 IMAGE PREVIEW
            ================================================== -->

            <div
                id="imagePreviewContainer"
                class="image-preview-container"
                hidden
            >

                <div
                    id="imagePreviewGrid"
                    class="image-preview-grid"
                ></div>

                <div
                    id="imageCountMessage"
                    class="image-count-message"
                ></div>

            </div>

        </main>



        <!-- =================================================
             BOTTOM COMPOSER
        ================================================== -->

        <div class="post-composer-wrapper">

            <form
                id="postForm"
                action="/dairy/<%= dairy._id %>/post"
                method="POST"
                enctype="multipart/form-data"
                class="post-form"
            >

                <!-- TITLE -->
                <input
                    type="hidden"
                    id="formPostTitle"
                    name="title"
                    value=""
                >


                <!-- MULTIPLE IMAGES -->
                <input
                    type="file"
                    id="postImage"
                    name="images"
                    accept="image/*"
                    multiple
                    hidden
                >


                <div class="post-composer">


                    <!-- ATTACHMENT -->

                    <label
                        for="postImage"
                        class="composer-icon-button attachment-button"
                        aria-label="Attach images"
                        title="Attach images"
                    >

                        <i class="bi bi-paperclip"></i>

                    </label>



                    <!-- TEXT -->

                    <div class="composer-input-area">

                        <textarea
                            id="postText"
                            name="text"
                            maxlength="1000"
                            rows="1"
                            placeholder="Type your update..."
                            aria-label="Type your update"
                        ></textarea>


                        <span
                            id="characterCounter"
                            class="character-counter"
                        >
                            0/1000
                        </span>

                    </div>



                    <!-- SEND -->

                    <button
                        type="submit"
                        id="submitPostButton"
                        class="composer-send-button"
                        aria-label="Send update"
                        disabled
                    >

                        <i class="bi bi-send-fill"></i>

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>



<style>

/* =========================================================
   CREATE POST
========================================================= */

.create-post-card {

    width: 100%;

    background: #ffffff;

    border-radius: 16px;

    padding: 16px;

    margin-bottom: 16px;

    box-sizing: border-box;

    border: 1px solid #e7eee9;

}


.create-post-header {

    display: flex;

    align-items: center;

    gap: 12px;

}


.create-post-avatar {

    flex-shrink: 0;

}


.avatar-sm {

    width: 44px;

    height: 44px;

    border-radius: 50%;

    object-fit: cover;

    display: block;

}


.create-post-heading {

    min-width: 0;

    font-size: 14px;

    line-height: 1.5;

    color: #555;

}


.heading-line {

    display: block;

}


.create-post-heading strong {

    color: #222;

}


.composer-trigger {

    margin-top: 14px;

    min-height: 48px;

    padding: 0 16px;

    border: 1px solid #dfe8e2;

    border-radius: 24px;

    display: flex;

    align-items: center;

    color: #888;

    background: #f8faf8;

    cursor: pointer;

}


.composer-trigger:hover {

    background: #f1f7f3;

    border-color: #2e8b57;

}



/* =========================================================
   MODAL
========================================================= */

.post-modal {

    position: fixed;

    inset: 0;

    width: 100vw;

    height: 100dvh;

    background: #ffffff;

    z-index: 99999;

    display: none;

    overflow: hidden;

}


.post-modal.active {

    display: block;

}


.post-modal-content {

    position: relative;

    width: 100%;

    height: 100%;

    display: flex;

    flex-direction: column;

    background: #ffffff;

}



/* =========================================================
   HEADER
========================================================= */

.post-modal-header {

    flex: 0 0 auto;

    height: 64px;

    display: flex;

    align-items: center;

    padding: 0 16px;

    box-sizing: border-box;

    border-bottom: 1px solid #e8eee9;

}


.post-back-button {

    width: 44px;

    height: 44px;

    border: none;

    background: transparent;

    color: #198754;

    display: flex;

    align-items: center;

    justify-content: center;

    cursor: pointer;

    font-size: 27px;

}


.post-modal-title {

    margin-left: 8px;

    display: flex;

    flex-direction: column;

}


.post-modal-title strong {

    font-size: 17px;

    color: #202520;

}


.post-modal-title span {

    margin-top: 2px;

    font-size: 12px;

    color: #7a817d;

}


.post-header-spacer {

    flex: 1;

}



/* =========================================================
   BODY
========================================================= */

.post-modal-body {

    flex: 1 1 auto;

    min-height: 0;

    overflow-y: auto;

    padding: 20px;

    box-sizing: border-box;

}



/* =========================================================
   TITLE
========================================================= */

.post-title-wrapper {

    width: 100%;

    margin-bottom: 20px;

}


#postTitle {

    width: 100%;

    box-sizing: border-box;

    border: none;

    outline: none;

    border-bottom: 1px solid #e2e9e4;

    background: transparent;

    padding: 6px 0 10px;

    font-family: inherit;

    font-size: 23px;

    font-weight: 700;

    color: #202520;

}


#postTitle::placeholder {

    color: #a0a7a2;

}


#postTitle:focus {

    border-bottom-color: #198754;

}


.post-title-counter {

    text-align: right;

    padding-top: 5px;

    font-size: 10px;

    color: #8a928d;

}



/* =========================================================
   IMAGE GRID
========================================================= */

.image-preview-container {

    width: 100%;

}


.image-preview-grid {

    display: grid;

    grid-template-columns:
        repeat(2, minmax(0, 1fr));

    gap: 10px;

}


.image-preview-item {

    position: relative;

    aspect-ratio: 1 / 1;

    overflow: hidden;

    border-radius: 14px;

    background: #f4f6f4;

}


.image-preview-item img {

    width: 100%;

    height: 100%;

    object-fit: cover;

    display: block;

}


.image-preview-number {

    position: absolute;

    left: 8px;

    bottom: 8px;

    min-width: 24px;

    height: 24px;

    padding: 0 7px;

    border-radius: 12px;

    background: rgba(0, 0, 0, 0.6);

    color: #ffffff;

    display: flex;

    align-items: center;

    justify-content: center;

    font-size: 11px;

}


.remove-image-button {

    position: absolute;

    top: 8px;

    right: 8px;

    width: 34px;

    height: 34px;

    border: none;

    border-radius: 50%;

    background: rgba(0, 0, 0, 0.65);

    color: #ffffff;

    display: flex;

    align-items: center;

    justify-content: center;

    cursor: pointer;

}


.add-more-images {

    aspect-ratio: 1 / 1;

    border: 2px dashed #cbd8cf;

    border-radius: 14px;

    background: #f8faf8;

    color: #198754;

    display: flex;

    flex-direction: column;

    align-items: center;

    justify-content: center;

    gap: 6px;

    cursor: pointer;

}


.add-more-images i {

    font-size: 24px;

}


.image-count-message {

    margin-top: 10px;

    text-align: center;

    font-size: 11px;

    color: #7d857f;

}



/* =========================================================
   COMPOSER
========================================================= */

.post-composer-wrapper {

    flex: 0 0 auto;

    width: 100%;

    padding:
        10px
        12px
        calc(10px + env(safe-area-inset-bottom));

    box-sizing: border-box;

    background: #ffffff;

    border-top: 1px solid #e8eee9;

}


.post-form {

    width: 100%;

    margin: 0;

}


.post-composer {

    width: 100%;

    min-height: 50px;

    display: flex;

    align-items: flex-end;

    gap: 8px;

    padding: 5px 7px;

    box-sizing: border-box;

    border: 1px solid #dce6df;

    border-radius: 28px;

    background: #f7faf8;

}


.composer-icon-button {

    flex: 0 0 42px;

    width: 42px;

    height: 42px;

    border: none;

    background: transparent;

    color: #198754;

    display: flex;

    align-items: center;

    justify-content: center;

    cursor: pointer;

    font-size: 23px;

}


.attachment-button i {

    transform: rotate(-20deg);

}


.composer-input-area {

    position: relative;

    flex: 1;

    min-width: 0;

}


#postText {

    width: 100%;

    min-height: 40px;

    max-height: 120px;

    resize: none;

    overflow-y: auto;

    border: none;

    outline: none;

    background: transparent;

    padding:
        10px
        4px
        5px;

    box-sizing: border-box;

    font-family: inherit;

    font-size: 15px;

    line-height: 20px;

}


.character-counter {

    position: absolute;

    right: 5px;

    bottom: 1px;

    font-size: 10px;

    color: #8a928d;

    pointer-events: none;

    background: #f7faf8;

}


.composer-send-button {

    flex: 0 0 42px;

    width: 42px;

    height: 42px;

    border: none;

    border-radius: 50%;

    background: transparent;

    color: #198754;

    display: flex;

    align-items: center;

    justify-content: center;

    cursor: pointer;

    font-size: 20px;

}


.composer-send-button:disabled {

    color: #b8c2bc;

    cursor: default;

}



/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 600px) {

    .post-modal-header {

        height: 60px;

        padding: 0 10px;

    }


    .post-modal-body {

        padding: 14px;

    }


    #postTitle {

        font-size: 21px;

    }


    .post-composer-wrapper {

        padding:
            8px
            8px
            calc(8px + env(safe-area-inset-bottom));

    }


    .image-preview-grid {

        gap: 8px;

    }

}


@media (max-width: 380px) {

    .post-modal-title span {

        display: none;

    }


    .post-modal-body {

        padding: 10px;

    }


    #postTitle {

        font-size: 19px;

    }

}

</style>



<script>

(function () {

    "use strict";


    function initializePostModal() {

        const modal =
            document.getElementById("postModal");

        const openComposer =
            document.getElementById("openPostComposer");

        const closeButton =
            document.getElementById("closePostModal");

        const titleInput =
            document.getElementById("postTitle");

        const formTitleInput =
            document.getElementById("formPostTitle");

        const textarea =
            document.getElementById("postText");

        const imageInput =
            document.getElementById("postImage");

        const previewContainer =
            document.getElementById(
                "imagePreviewContainer"
            );

        const previewGrid =
            document.getElementById(
                "imagePreviewGrid"
            );

        const imageCountMessage =
            document.getElementById(
                "imageCountMessage"
            );

        const titleCounter =
            document.getElementById(
                "titleCharacterCounter"
            );

        const characterCounter =
            document.getElementById(
                "characterCounter"
            );

        const sendButton =
            document.getElementById(
                "submitPostButton"
            );

        const form =
            document.getElementById(
                "postForm"
            );


        if (
            !modal ||
            !openComposer ||
            !closeButton ||
            !titleInput ||
            !formTitleInput ||
            !textarea ||
            !imageInput ||
            !previewContainer ||
            !previewGrid ||
            !imageCountMessage ||
            !titleCounter ||
            !characterCounter ||
            !sendButton ||
            !form
        ) {

            console.error(
                "Post modal could not initialize."
            );

            return;

        }


        const MAX_IMAGES = 10;


        let selectedImages = [];



        // ==================================================
        // OPEN
        // ==================================================

        function openModal() {

            modal.classList.add(
                "active"
            );

            modal.setAttribute(
                "aria-hidden",
                "false"
            );

            document.body.style.overflow =
                "hidden";


            setTimeout(function () {

                titleInput.focus();

            }, 100);

        }



        // ==================================================
        // CLOSE
        // ==================================================

        function closeModal() {

            modal.classList.remove(
                "active"
            );

            modal.setAttribute(
                "aria-hidden",
                "true"
            );

            document.body.style.overflow =
                "";

        }



        // ==================================================
        // COUNTERS
        // ==================================================

        function updateCounters() {

            titleCounter.textContent =
                titleInput.value.length +
                "/150";


            characterCounter.textContent =
                textarea.value.length +
                "/1000";

        }



        // ==================================================
        // SEND BUTTON
        // ==================================================

        function updateSendButton() {

            const hasTitle =
                titleInput.value.trim()
                    .length > 0;


            const hasText =
                textarea.value.trim()
                    .length > 0;


            const hasImages =
                selectedImages.length > 0;


            sendButton.disabled =
                !(
                    hasTitle ||
                    hasText ||
                    hasImages
                );

        }



        // ==================================================
        // RESIZE TEXTAREA
        // ==================================================

        function resizeTextarea() {

            textarea.style.height =
                "auto";


            textarea.style.height =
                Math.min(
                    textarea.scrollHeight,
                    120
                ) + "px";

        }



        // ==================================================
        // SYNC FILE INPUT
        // ==================================================

        function syncFileInput() {

            const dataTransfer =
                new DataTransfer();


            selectedImages.forEach(
                function (file) {

                    dataTransfer.items.add(
                        file
                    );

                }
            );


            imageInput.files =
                dataTransfer.files;

        }



        // ==================================================
        // RENDER PREVIEWS
        // ==================================================

        function renderImagePreviews() {

            previewGrid.innerHTML =
                "";


            if (
                selectedImages.length === 0
            ) {

                previewContainer.hidden =
                    true;

                imageCountMessage.textContent =
                    "";

                return;

            }


            previewContainer.hidden =
                false;


            selectedImages.forEach(
                function (file, index) {

                    const reader =
                        new FileReader();


                    reader.onload =
                        function (event) {

                            const item =
                                document.createElement(
                                    "div"
                                );


                            item.className =
                                "image-preview-item";


                            const img =
                                document.createElement(
                                    "img"
                                );


                            img.src =
                                event.target.result;


                            img.alt =
                                "Selected image " +
                                (index + 1);


                            const number =
                                document.createElement(
                                    "span"
                                );


                            number.className =
                                "image-preview-number";


                            number.textContent =
                                index + 1;


                            const removeButton =
                                document.createElement(
                                    "button"
                                );


                            removeButton.type =
                                "button";


                            removeButton.className =
                                "remove-image-button";


                            removeButton.innerHTML =
                                '<i class="bi bi-x-lg"></i>';


                            removeButton.addEventListener(
                                "click",
                                function () {

                                    removeImage(
                                        index
                                    );

                                }
                            );


                            item.appendChild(
                                img
                            );


                            item.appendChild(
                                number
                            );


                            item.appendChild(
                                removeButton
                            );


                            previewGrid.appendChild(
                                item
                            );

                        };


                    reader.readAsDataURL(
                        file
                    );

                }
            );


            if (
                selectedImages.length <
                MAX_IMAGES
            ) {

                const addMore =
                    document.createElement(
                        "label"
                    );


                addMore.className =
                    "add-more-images";


                addMore.setAttribute(
                    "for",
                    "postImage"
                );


                addMore.innerHTML =
                    '<i class="bi bi-plus-lg"></i>' +
                    '<span>Add photos</span>';


                previewGrid.appendChild(
                    addMore
                );

            }


            imageCountMessage.textContent =
                selectedImages.length +
                " of " +
                MAX_IMAGES +
                " photos selected";

        }



        // ==================================================
        // REMOVE IMAGE
        // ==================================================

        function removeImage(index) {

            selectedImages.splice(
                index,
                1
            );


            syncFileInput();

            renderImagePreviews();

            updateSendButton();

        }



        // ==================================================
        // ADD IMAGES
        // ==================================================

        function addImages(files) {

            const incoming =
                Array.from(files);


            incoming.forEach(
                function (file) {

                    if (
                        selectedImages.length >=
                        MAX_IMAGES
                    ) {

                        return;

                    }


                    if (
                        !file.type.startsWith(
                            "image/"
                        )
                    ) {

                        return;

                    }


                    const duplicate =
                        selectedImages.some(
                            function (
                                existing
                            ) {

                                return (
                                    existing.name ===
                                    file.name &&

                                    existing.size ===
                                    file.size &&

                                    existing.lastModified ===
                                    file.lastModified
                                );

                            }
                        );


                    if (duplicate) {

                        return;

                    }


                    selectedImages.push(
                        file
                    );

                }
            );


            syncFileInput();

            renderImagePreviews();

            updateSendButton();

        }



        // ==================================================
        // EVENTS
        // ==================================================

        titleInput.addEventListener(
            "input",
            function () {

                updateCounters();

                updateSendButton();

            }
        );


        textarea.addEventListener(
            "input",
            function () {

                updateCounters();

                updateSendButton();

                resizeTextarea();

            }
        );


        imageInput.addEventListener(
            "change",
            function () {

                addImages(
                    imageInput.files
                );

            }
        );


        openComposer.addEventListener(
            "click",
            openModal
        );


        openComposer.addEventListener(
            "keydown",
            function (event) {

                if (
                    event.key === "Enter" ||
                    event.key === " "
                ) {

                    event.preventDefault();

                    openModal();

                }

            }
        );


        closeButton.addEventListener(
            "click",
            closeModal
        );


        document.addEventListener(
            "keydown",
            function (event) {

                if (
                    event.key === "Escape" &&
                    modal.classList.contains(
                        "active"
                    )
                ) {

                    closeModal();

                }

            }
        );



        // ==================================================
        // SUBMIT
        // ==================================================

        form.addEventListener(
            "submit",
            function (event) {

                const title =
                    titleInput.value.trim();


                const text =
                    textarea.value.trim();


                if (
                    !title &&
                    !text &&
                    selectedImages.length === 0
                ) {

                    event.preventDefault();

                    titleInput.focus();

                    return;

                }


                formTitleInput.value =
                    title;


                syncFileInput();


                sendButton.disabled =
                    true;


                sendButton.innerHTML =
                    '<i class="bi bi-hourglass-split"></i>';

            }
        );



        updateCounters();

        updateSendButton();

        resizeTextarea();

    }


    if (
        document.readyState === "loading"
    ) {

        document.addEventListener(
            "DOMContentLoaded",
            initializePostModal
        );

    } else {

        initializePostModal();

    }

})();

</script>