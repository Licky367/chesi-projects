}


.farm-image-preview-item img {

    width: 100%;
    height: 100%;

    display: block;

    object-fit: cover;

}



/* =========================================================
   BOTTOM COMPOSER
========================================================= */

.farm-post-composer-wrapper {

    flex: 0 0 auto;

    width: 100%;

    padding:
        9px
