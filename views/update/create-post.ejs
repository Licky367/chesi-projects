<!-- =========================================================
     CREATE POST + FULL SCREEN POST MODAL
========================================================= --><style>

/* =========================================================
   CREATE POST CARD
========================================================= */

.create-post-card {
    width: 100%;
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 18px;
    padding: 16px;
    box-sizing: border-box;
}

.create-post-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 14px;
}

.create-post-avatar {
    flex: 0 0 auto;
}

.create-post-avatar img {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    object-fit: cover;
    display: block;
}

.create-post-heading {
    color: #374151;
    font-size: 14px;
    line-height: 1.4;
}

.create-post-heading strong {
    color: #166534;
    font-weight: 700;
}

.heading-line {
    display: block;
}


/* =========================================================
   OPEN COMPOSER
========================================================= */

.composer-trigger {
    width: 100%;
    min-height: 52px;

    display: flex;
    align-items: center;

    padding: 0 16px;

    box-sizing: border-box;

    background: #f7f9f8;
    border: 1px solid #dfe7e2;
    border-radius: 14px;

    cursor: pointer;

    transition: 0.2s ease;
}

.composer-trigger:hover {
    background: #f1f6f3;
    border-color: #86b99a;
}

.composer-trigger:focus {
    outline: none;
    border-color: #16a34a;
    box-shadow: 0 0 0 3px rgba(22, 163, 74, 0.12);
}

.composer-placeholder {
    color: #8a938e;
    font-size: 15px;
}


/* =========================================================
   FULL SCREEN MODAL
========================================================= */

.post-modal {
    position: fixed;
    inset: 0;

    width: 100%;
    height: 100dvh;

    background: #fff;

    z-index: 99999;

    display: flex;
    flex-direction: column;

    visibility: hidden;
    opacity: 0;
    pointer-events: none;

    transform: translateY(100%);

    transition:
        transform 0.25s ease,
        opacity 0.2s ease,
        visibility 0.25s ease;
}

.post-modal.active {
    visibility: visible;
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
}


/* =========================================================
   MODAL CONTENT
========================================================= */

.post-modal-content {
    width: 100%;
    height: 100%;

    display: flex;
    flex-direction: column;

    background: #fff;
}


/* =========================================================
   MODAL HEADER
========================================================= */

.post-modal-header {
    flex: 0 0 auto;

    width: 100%;
    min-height: 64px;

    display: grid;
    grid-template-columns: 52px 1fr 52px;
    align-items: center;

    padding: 0 12px;

    box-sizing: border-box;

    background: #fff;

    border-bottom: 1px solid #e5e7eb;
}

.post-modal-header h3 {
    margin: 0;

    text-align: center;

    color: #166534;

    font-size: 18px;
    font-weight: 700;
}


/* =========================================================
   BACK BUTTON
========================================================= */

.close-modal-button {
    width: 44px;
    height: 44px;

    padding: 0;
    margin: 0;

    border: none;
    background: transparent;

    display: flex;
    align-items: center;
    justify-content: center;

    color: #16a34a;

    cursor: pointer;

    transition: 0.15s ease;
}

.close-modal-button:hover {
    color: #15803d;
    transform: translateX(-2px);
}

.close-modal-button:active {
    transform: scale(0.9);
}

.close-modal-button svg {
    width: 28px;
    height: 28px;

    display: block;

    stroke: currentColor;
}


/* =========================================================
   MODAL BODY
   NO TEXTAREA HERE
   NO PAPERCLIP HERE
========================================================= */

.post-modal-body {
    flex: 1 1 auto;

    min-height: 0;

    overflow-y: auto;

    padding: 20px;

    box-sizing: border-box;

    background: #fff;
}


/* =========================================================
   IMAGE PREVIEW
========================================================= */

.image-preview-container {
    position: relative;

    width: 100%;

    border-radius: 16px;

    overflow: hidden;

    background: #f3f4f6;

    border: 1px solid #e5e7eb;
}

.image-preview {
    display: block;

    width: 100%;
    max-height: 65vh;

    object-fit: contain;

    background: #f3f4f6;
}


/* =========================================================
   REMOVE IMAGE
========================================================= */

.remove-image-button {
    position: absolute;

    top: 12px;
    right: 12px;

    width: 40px;
    height: 40px;

    padding: 0;

    border: none;
    border-radius: 50%;

    background: rgba(0, 0, 0, 0.65);

    color: #fff;

    display: flex;
    align-items: center;
    justify-content: center;

    cursor: pointer;
}

.remove-image-button svg {
    width: 19px;
    height: 19px;

    stroke: currentColor;
}


/* =========================================================
   BOTTOM COMPOSER
========================================================= */

.composer-bar {
    flex: 0 0 auto;

    width: 100%;

    display: flex;
    align-items: flex-end;

    gap: 8px;

    padding:
        10px
        12px
        calc(10px + env(safe-area-inset-bottom))
        12px;

    box-sizing: border-box;

    background: #fff;

    border-top: 1px solid #e5e7eb;
}


/* =========================================================
   PAPERCLIP
========================================================= */

.attachment-button {
    flex: 0 0 auto;

    width: 42px;
    height: 44px;

    display: flex;
    align-items: center;
    justify-content: center;

    color: #16a34a;

    cursor: pointer;

    transition: 0.15s ease;
}

.attachment-button:hover {
    color: #15803d;
}

.attachment-button:active {
    transform: scale(0.88);
}

.attachment-button svg {
    width: 25px;
    height: 25px;

    display: block;

    stroke: currentColor;
}


/* =========================================================
   INPUT CONTAINER

   THIS IS THE ONLY PLACE WHERE THE USER TYPES
========================================================= */

.composer-input-area {
    flex: 1 1 auto;

    min-width: 0;

    min-height: 44px;

    display: flex;
    align-items: flex-end;

    background: #f4f7f5;

    border: 1px solid #dfe7e2;

    border-radius: 23px;

    padding: 0 12px;

    box-sizing: border-box;

    transition: 0.2s ease;
}

.composer-input-area:focus-within {
    border-color: #86c79b;

    box-shadow:
        0 0 0 2px rgba(22, 163, 74, 0.08);
}


/* =========================================================
   ONLY TEXT INPUT
========================================================= */

.composer-input {
    flex: 1 1 auto;

    min-width: 0;

    width: 100%;

    min-height: 42px;
    max-height: 120px;

    resize: none;

    border: none;
    outline: none;

    background: transparent;

    padding: 11px 0;

    box-sizing: border-box;

    color: #17201a;

    font-family: inherit;

    font-size: 15px;

    line-height: 20px;
}

.composer-input::placeholder {
    color: #8b948f;
}

.composer-input:focus {
    outline: none;
}


/* =========================================================
   CHARACTER COUNTER
========================================================= */

.character-counter {
    flex: 0 0 auto;

    margin-left: 7px;
    margin-bottom: 11px;

    color: #8a938e;

    font-size: 11px;

    white-space: nowrap;
}


/* =========================================================
   SEND BUTTON
========================================================= */

.send-button {
    flex: 0 0 auto;

    width: 44px;
    height: 44px;

    padding: 0;

    border: none;
    background: transparent;

    color: #16a34a;

    display: flex;
    align-items: center;
    justify-content: center;

    cursor: pointer;

    transition: 0.15s ease;
}

.send-button svg {
    width: 28px;
    height: 28px;

    display: block;

    fill: currentColor;
}

.send-button:hover {
    color: #15803d;

    transform: translateX(1px);
}

.send-button:active {
    transform: scale(0.88);
}

.send-button:disabled {
    color: #a8b5ad;

    cursor: not-allowed;

    transform: none;
}


/* =========================================================
   HIDDEN FILE INPUT
========================================================= */

#postImage {
    display: none;
}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 600px) {

    .create-post-card {
        border-radius: 14px;
        padding: 14px;
    }

    .post-modal-header {
        min-height: 60px;
    }

    .post-modal-body {
        padding: 14px;
    }

    .composer-bar {
        gap: 5px;
    }

    .attachment-button {
        width: 38px;
    }

    .send-button {
        width: 42px;
    }

    .character-counter {
        font-size: 10px;
        margin-left: 4px;
    }

}


/* =========================================================
   VERY SMALL PHONES
========================================================= */

@media (max-width: 380px) {

    .character-counter {
        font-size: 9px;
    }

}


/* =========================================================
   PREVENT BACKGROUND SCROLL
========================================================= */

body.post-modal-open {
    overflow: hidden;
}

</style><!-- =========================================================
     CREATE POST CARD
========================================================= --><section class="create-post-card"><div class="create-post-header">

    <div class="create-post-avatar">

        <img
            src="<%= user.profileImage || ('https://ui-avatars.com/api/?name=' + encodeURIComponent(user.name)) %>"
            alt="<%= user.name %>"
        >

    </div>


    <div class="create-post-heading">

        <div class="heading-line">

            <strong>
                <%= user.name.split(" ")[0] %>
            </strong>

            , update us about

        </div>


        <div class="heading-line">

            <strong>
                <%= dairy.name %>
            </strong>

        </div>

    </div>

</div>


<!-- =====================================================
     ONLY OPEN COMPOSER
====================================================== -->

<div
    id="openPostComposer"
    class="composer-trigger"
    role="button"
    tabindex="0"
    aria-label="Create Post"
>

    <span class="composer-placeholder">
        Share an update...
    </span>

</div>

</section><!-- =========================================================
     FULL SCREEN POST MODAL
========================================================= --><div
    id="postModal"
    class="post-modal"
    aria-hidden="true"
><div class="post-modal-content">


    <!-- =================================================
         HEADER
    ================================================== -->

    <div class="post-modal-header">

        <button
            type="button"
            id="closePostModal"
            class="close-modal-button"
            aria-label="Back"
        >

            <!-- REAL BACK ARROW -->

            <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
            >

                <path d="M19 12H5"></path>

                <path d="M12 19l-7-7 7-7"></path>

            </svg>

        </button>


        <h3>
            New Update
        </h3>


        <span></span>

    </div>


    <!-- =================================================
         FORM
    ================================================== -->

    <form
        id="postForm"
        action="/dairy/<%= dairy._id %>/post"
        method="POST"
        enctype="multipart/form-data"
    >


        <!-- =================================================
             BODY

             IMPORTANT:
             NO TEXTAREA HERE.
             NO PAPERCLIP HERE.
        ================================================== -->

        <div class="post-modal-body">


            <!-- =============================================
                 IMAGE PREVIEW ONLY
            ============================================== -->

            <div
                id="imagePreviewContainer"
                class="image-preview-container"
                style="display:none;"
            >

                <img
                    id="imagePreview"
                    class="image-preview"
                    alt="Selected image preview"
                >


                <button
                    id="removeImage"
                    type="button"
                    class="remove-image-button"
                    aria-label="Remove image"
                >

                    <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                    >

                        <path d="M6 6l12 12"></path>
                        <path d="M18 6L6 18"></path>

                    </svg>

                </button>

            </div>


        </div>


        <!-- =================================================
             BOTTOM COMPOSER

             📎 [ Type your update... 0/1000 ] [ ➤ ]

             THIS IS THE ONLY INPUT.
        ================================================== -->

        <div class="composer-bar">


            <!-- =============================================
                 ONLY PAPERCLIP ICON
            ============================================== -->

            <label
                for="postImage"
                class="attachment-button"
                aria-label="Attach image"
            >

                <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                >

                    <path
                        d="M21.44 11.05l-9.19 9.19a6 6 0 01-8.49-8.49l9.19-9.19a4 4 0 015.66 5.66l-9.2 9.19a2 2 0 01-2.83-2.83l8.49-8.48"
                    ></path>

                </svg>

            </label>


            <!-- =============================================
                 ACTUAL FILE INPUT

                 Controller receives:
                 req.file
            ============================================== -->

            <input
                id="postImage"
                name="image"
                type="file"
                accept="image/*"
            >


            <!-- =============================================
                 ONLY TEXT INPUT

                 Controller receives:
                 req.body.text
            ============================================== -->

            <div class="composer-input-area">

                <textarea
                    id="composerInput"
                    class="composer-input"
                    name="text"
                    maxlength="1000"
                    placeholder="Type your update..."
                    rows="1"
                    aria-label="Type your update"
                ></textarea>


                <span
                    id="characterCounter"
                    class="character-counter"
                >
                    0/1000
                </span>

            </div>


            <!-- =============================================
                 ONLY SEND ICON
            ============================================== -->

            <button
                id="submitPostButton"
                type="submit"
                class="send-button"
                aria-label="Send post"
                disabled
            >

                <!-- REAL SEND ARROW -->

                <svg
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                >

                    <path
                        d="M3.4 20.4L21 12 3.4 3.6 3 10l12 2-12 2 .4 6.4z"
                    ></path>

                </svg>

            </button>


        </div>

    </form>

</div>

</div><script>

/* =========================================================
   POST MODAL
========================================================= */

(function () {

    function initializePostModal() {

        const modal =
            document.getElementById("postModal");

        const openComposer =
            document.getElementById("openPostComposer");

        const closeButton =
            document.getElementById("closePostModal");

        const form =
            document.getElementById("postForm");

        const composerInput =
            document.getElementById("composerInput");

        const imageInput =
            document.getElementById("postImage");

        const imagePreviewContainer =
            document.getElementById("imagePreviewContainer");

        const imagePreview =
            document.getElementById("imagePreview");

        const removeImage =
            document.getElementById("removeImage");

        const characterCounter =
            document.getElementById("characterCounter");

        const sendButton =
            document.getElementById("submitPostButton");


        /* =====================================================
           CHECK REQUIRED ELEMENTS
        ====================================================== */

        if (
            !modal ||
            !openComposer ||
            !closeButton ||
            !form ||
            !composerInput ||
            !imageInput ||
            !sendButton
        ) {

            console.warn(
                "Post modal not initialized. Required element missing."
            );

            return;

        }


        /* =====================================================
           OPEN MODAL
        ====================================================== */

        function openModal() {

            modal.classList.add("active");

            modal.setAttribute(
                "aria-hidden",
                "false"
            );

            document.body.classList.add(
                "post-modal-open"
            );

            setTimeout(function () {

                composerInput.focus();

            }, 250);

        }


        /* =====================================================
           CLOSE MODAL
        ====================================================== */

        function closeModal() {

            modal.classList.remove("active");

            modal.setAttribute(
                "aria-hidden",
                "true"
            );

            document.body.classList.remove(
                "post-modal-open"
            );

        }


        /* =====================================================
           OPEN COMPOSER
        ====================================================== */

        openComposer.addEventListener(
            "click",
            openModal
        );


        /* =====================================================
           KEYBOARD ACCESS
        ====================================================== */

        openComposer.addEventListener(
            "keydown",
            function (event) {

                if (
                    event.key === "Enter" ||
                    event.key === " "
                ) {

                    event.preventDefault();

                    openModal();

                }

            }
        );


        /* =====================================================
           BACK BUTTON
        ====================================================== */

        closeButton.addEventListener(
            "click",
            closeModal
        );


        /* =====================================================
           ESCAPE
        ====================================================== */

        document.addEventListener(
            "keydown",
            function (event) {

                if (
                    event.key === "Escape" &&
                    modal.classList.contains("active")
                ) {

                    closeModal();

                }

            }
        );


        /* =====================================================
           CHARACTER COUNTER
        ====================================================== */

        function updateCounter() {

            characterCounter.textContent =
                composerInput.value.length + "/1000";

        }


        /* =====================================================
           SEND BUTTON
        ====================================================== */

        function updateSendButton() {

            const hasText =
                composerInput.value.trim().length > 0;

            const hasImage =
                imageInput.files &&
                imageInput.files.length > 0;

            sendButton.disabled =
                !(hasText || hasImage);

        }


        /* =====================================================
           AUTO GROW TEXTAREA
        ====================================================== */

        function resizeInput() {

            composerInput.style.height = "42px";

            const height =
                Math.min(
                    composerInput.scrollHeight,
                    120
                );

            composerInput.style.height =
                height + "px";

        }


        /* =====================================================
           USER TYPING
        ====================================================== */

        composerInput.addEventListener(
            "input",
            function () {

                updateCounter();

                updateSendButton();

                resizeInput();

            }
        );


        /* =====================================================
           IMAGE SELECTED
        ====================================================== */

        imageInput.addEventListener(
            "change",
            function () {

                if (
                    !imageInput.files ||
                    imageInput.files.length === 0
                ) {

                    updateSendButton();

                    return;

                }


                const file =
                    imageInput.files[0];


                /* =============================================
                   PREVIEW
                ============================================== */

                if (
                    file.type &&
                    file.type.startsWith("image/")
                ) {

                    const reader =
                        new FileReader();

                    reader.onload =
                        function (event) {

                            imagePreview.src =
                                event.target.result;

                            imagePreviewContainer.style.display =
                                "block";

                        };

                    reader.readAsDataURL(file);

                }


                updateSendButton();

            }
        );


        /* =====================================================
           REMOVE IMAGE
        ====================================================== */

        removeImage.addEventListener(
            "click",
            function () {

                imageInput.value = "";

                imagePreview.src = "";

                imagePreviewContainer.style.display =
                    "none";

                updateSendButton();

            }
        );


        /* =====================================================
           FORM SUBMIT
        ====================================================== */

        form.addEventListener(
            "submit",
            function (event) {

                const hasText =
                    composerInput.value.trim().length > 0;

                const hasImage =
                    imageInput.files &&
                    imageInput.files.length > 0;


                /* ---------------------------------------------
                   Controller requires either text or image.
                ---------------------------------------------- */

                if (
                    !hasText &&
                    !hasImage
                ) {

                    event.preventDefault();

                    return;

                }


                /* ---------------------------------------------
                   name="text" is already on the textarea.
                   Therefore req.body.text receives it directly.
                ---------------------------------------------- */

                sendButton.disabled = true;


                /* ---------------------------------------------
                   Sending icon
                ---------------------------------------------- */

                sendButton.innerHTML = `
                    <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        aria-hidden="true"
                    >
                        <path d="M5 12h14"></path>
                        <path d="M13 6l6 6-6 6"></path>
                    </svg>
                `;

            }
        );


        /* =====================================================
           INITIAL STATE
        ====================================================== */

        updateCounter();

        updateSendButton();

        resizeInput();

    }


    /* =========================================================
       DOM READY
    ========================================================= */

    if (
        document.readyState === "loading"
    ) {

        document.addEventListener(
            "DOMContentLoaded",
            initializePostModal
        );

    } else {

        initializePostModal();

    }

})();

</script>