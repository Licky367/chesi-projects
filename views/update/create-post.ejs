<% /*
==========================================================
CREATE POST COMPOSER + FULL SCREEN POST MODAL

FILE:
    views/update/create-post.ejs

PURPOSE:
    Allows an authenticated user to create a post/update
    concerning a Dairy record.

TARGET RULES:
----------------------------------------------------------
1. If the current Dairy has a POSITIVE code:
       - The current Dairy is automatically the target.
       - No target selector is displayed.

2. If the current Dairy has a NEGATIVE code:
       - The user must select the post target.
       - Phase 1:
           • Animal
           • Structure / Facility / Tool

       - Phase 2:
           If Animal:
               Only Dairy records with code > 0

           If Structure / Facility / Tool:
               Only Dairy records with NO code:
                   code === null
                   code === undefined
                   code === ""

       - Negative-code records are NEVER displayed
         in the target selector.

3. The selected Dairy _id is submitted as:
       targetDairyId

NOTE:
    Backend must later be updated to use targetDairyId
    as the actual post target.
==========================================================
*/ %>


<!-- =========================================================
     BOOTSTRAP ICONS
========================================================= -->

<link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
>


<!-- =========================================================
     CREATE POST CARD
========================================================= -->

<section class="create-post-card">


    <!-- =====================================================
         HEADER
    ====================================================== -->

    <div class="create-post-header">


        <!-- USER AVATAR -->

        <div class="create-post-avatar">

            <img
                src="<%= user.profileImage || ('https://ui-avatars.com/api/?name=' + encodeURIComponent(user.name)) %>"
                alt="<%= user.name %>"
                class="avatar-sm"
            >

        </div>


        <!-- HEADING -->

        <div class="create-post-heading">

            <% if (Number(dairy.code) < 0) { %>

                <div class="heading-line">

                    <strong>
                        <%= user.name.split(" ")[0] %>
                    </strong>

                    , update us about the overall conditions
                    of this dairy Farm.

                </div>

            <% } else { %>

                <div class="heading-line">

                    <strong>
                        <%= user.name.split(" ")[0] %>
                    </strong>

                    , update us about

                </div>

                <div class="heading-line">

                    <strong>
                        <%= dairy.name %>
                    </strong>

                </div>

            <% } %>

        </div>

    </div>



    <!-- =====================================================
         COMPOSER TRIGGER
    ====================================================== -->

    <div
        id="openPostComposer"
        class="composer-trigger"
        role="button"
        tabindex="0"
        aria-label="Create post"
    >

        <span>
            Share an update...
        </span>

    </div>


</section>



<!-- =========================================================
     FULL SCREEN POST MODAL
========================================================= -->

<div
    id="postModal"
    class="post-modal"
    aria-hidden="true"
>

    <div class="post-modal-content">


        <!-- =================================================
             MODAL HEADER
        ================================================== -->

        <header class="post-modal-header">


            <button
                type="button"
                id="closePostModal"
                class="post-back-button"
                aria-label="Go back"
            >

                <i class="bi bi-arrow-left"></i>

            </button>


            <div class="post-modal-title">

                <strong>
                    New Update
                </strong>

                <span id="postTargetHeader">

                    <%= dairy.name %>

                </span>

            </div>


            <div class="post-header-spacer"></div>


        </header>



        <!-- =================================================
             MODAL BODY
        ================================================== -->

        <main class="post-modal-body">


            <div class="post-fields">


                <!-- =================================================
                     POST TARGET SELECTOR
                     ONLY FOR NEGATIVE-CODE CURRENT DAIRY
                ================================================== -->

                <% if (Number(dairy.code) < 0) { %>


                    <section
                        id="postTargetSection"
                        class="post-target-section"
                    >


                        <!-- =========================================
                             SECTION HEADER
                        ========================================== -->

                        <div class="post-section-label">

                            <span class="post-section-label-icon">

                                <i class="bi bi-bullseye"></i>

                            </span>

                            <div>

                                <strong>
                                    What is this update about?
                                </strong>

                                <span>
                                    Select the subject of this post
                                </span>

                            </div>

                        </div>



                        <!-- =========================================
                             PHASE 1
                        ========================================== -->

                        <div
                            id="targetPhaseOne"
                            class="target-phase"
                        >


                            <label
                                for="targetCategory"
                                class="target-field-label"
                            >

                                Select category

                            </label>


                            <select
                                id="targetCategory"
                                class="target-select"
                            >

                                <option value="">
                                    Select category
                                </option>

                                <option value="animal">
                                    🐄 Animal
                                </option>

                                <option value="structure">
                                    🏗️ Structure / Facility / Tool
                                </option>

                            </select>

                        </div>



                        <!-- =========================================
                             PHASE 2
                        ========================================== -->

                        <div
                            id="targetPhaseTwo"
                            class="target-phase target-phase-two"
                            hidden
                        >


                            <label
                                for="targetDairySelect"
                                class="target-field-label"
                            >

                                Select subject

                            </label>


                            <select
                                id="targetDairySelect"
                                class="target-select"
                                disabled
                            >

                                <option value="">
                                    Select a subject
                                </option>

                            </select>


                            <div
                                id="targetSelectionHint"
                                class="target-selection-hint"
                            >

                                Select a category first.

                            </div>

                        </div>



                        <!-- =========================================
                             SELECTED TARGET
                        ========================================== -->

                        <div
                            id="selectedTargetDisplay"
                            class="selected-target-display"
                            hidden
                        >


                            <div class="selected-target-icon">

                                <i class="bi bi-check-lg"></i>

                            </div>


                            <div class="selected-target-info">

                                <span>
                                    Post concerns
                                </span>

                                <strong
                                    id="selectedTargetName"
                                >
                                </strong>

                            </div>


                        </div>


                    </section>


                <% } %>



                <!-- =================================================
                     POST FORM FIELDS
                ================================================== -->

                <div class="post-fields-content">


                    <!-- =============================================
                         POST TITLE
                    ============================================== -->

                    <div class="post-title-wrapper">


                        <label
                            for="postTitle"
                            class="post-title-label"
                        >

                            Title

                        </label>


                        <input
                            type="text"
                            id="postTitle"
                            maxlength="200"
                            placeholder="Give your update a title..."
                            aria-label="Post title"
                            autocomplete="off"
                        >


                    </div>



                    <!-- =============================================
                         IMAGE PREVIEWS
                    ============================================== -->

                    <div
                        id="imagePreviewContainer"
                        class="image-preview-container"
                        hidden
                    >

                        <div
                            id="imagePreviewGrid"
                            class="image-preview-grid"
                        ></div>

                    </div>


                </div>


            </div>

        </main>



        <!-- =================================================
             BOTTOM COMPOSER
        ================================================== -->

        <div class="post-composer-wrapper">


            <form
                id="postForm"
                action="/dairy/<%= dairy._id %>/post"
                method="POST"
                enctype="multipart/form-data"
                class="post-form"
            >


                <!-- =============================================
                     TARGET DAIRY ID
                ============================================== -->

                <% if (Number(dairy.code) < 0) { %>

                    <input
                        type="hidden"
                        name="targetDairyId"
                        id="targetDairyId"
                        value=""
                    >

                <% } else { %>

                    <input
                        type="hidden"
                        name="targetDairyId"
                        id="targetDairyId"
                        value="<%= dairy._id %>"
                    >

                <% } %>



                <!-- =============================================
                     TITLE
                ============================================== -->

                <input
                    type="hidden"
                    id="postTitleHidden"
                    name="title"
                    value=""
                >



                <!-- =============================================
                     COMPOSER
                ============================================== -->

                <div class="post-composer">


                    <!-- =====================================
                         IMAGE ATTACHMENT
                    ====================================== -->

                    <label
                        for="postImages"
                        class="composer-icon-button attachment-button"
                        aria-label="Attach images"
                        title="Attach images"
                    >

                        <i class="bi bi-paperclip"></i>

                    </label>


                    <input
                        type="file"
                        id="postImages"
                        name="images"
                        accept="image/jpeg,image/jpg,image/png,image/webp"
                        multiple
                        hidden
                    >



                    <!-- =====================================
                         TEXT
                    ====================================== -->

                    <div class="composer-input-area">


                        <textarea
                            id="postText"
                            name="text"
                            maxlength="1000"
                            rows="1"
                            placeholder="Type your update..."
                            aria-label="Type your update"
                        ></textarea>


                        <span
                            id="characterCounter"
                            class="character-counter"
                        >

                            0/1000

                        </span>


                    </div>



                    <!-- =====================================
                         SEND
                    ====================================== -->

                    <button
                        type="submit"
                        id="submitPostButton"
                        class="composer-send-button"
                        aria-label="Send update"
                        disabled
                    >

                        <i class="bi bi-send-fill"></i>

                    </button>


                </div>


            </form>


        </div>


    </div>

</div>



<!-- =========================================================
     CSS
========================================================= -->

<style>

/* =========================================================
   CREATE POST CARD
========================================================= */

.create-post-card {

    width: 100%;

    background: #ffffff;

    border-radius: 16px;

    padding: 16px;

    margin-bottom: 16px;

    box-sizing: border-box;

    border: 1px solid #e7eee9;

}


.create-post-header {

    display: flex;

    align-items: center;

    gap: 12px;

}


.create-post-avatar {

    flex-shrink: 0;

}


.avatar-sm {

    width: 44px;

    height: 44px;

    border-radius: 50%;

    object-fit: cover;

    display: block;

}


.create-post-heading {

    min-width: 0;

    font-size: 14px;

    line-height: 1.5;

    color: #555;

}


.heading-line {

    display: block;

}


.create-post-heading strong {

    color: #222;

}



/* =========================================================
   COMPOSER TRIGGER
========================================================= */

.composer-trigger {

    margin-top: 14px;

    min-height: 48px;

    padding: 0 16px;

    border: 1px solid #dfe8e2;

    border-radius: 24px;

    display: flex;

    align-items: center;

    color: #888;

    background: #f8faf8;

    cursor: pointer;

    transition:
        background 0.2s ease,
        border-color 0.2s ease,
        transform 0.15s ease;

}


.composer-trigger:hover {

    background: #f1f7f3;

    border-color: #2e8b57;

}


.composer-trigger:active {

    transform: scale(0.99);

}



/* =========================================================
   FULL SCREEN MODAL
========================================================= */

.post-modal {

    position: fixed;

    inset: 0;

    width: 100vw;

    height: 100dvh;

    background: #ffffff;

    z-index: 99999;

    display: none;

    overflow: hidden;

}


.post-modal.active {

    display: block;

}


.post-modal-content {

    position: relative;

    width: 100%;

    height: 100%;

    display: flex;

    flex-direction: column;

    background: #ffffff;

}



/* =========================================================
   MODAL HEADER
========================================================= */

.post-modal-header {

    flex: 0 0 auto;

    height: 64px;

    width: 100%;

    display: flex;

    align-items: center;

    padding: 0 16px;

    box-sizing: border-box;

    border-bottom: 1px solid #e8eee9;

    background: #ffffff;

}


.post-back-button {

    width: 44px;

    height: 44px;

    border: none;

    background: transparent;

    color: #198754;

    display: flex;

    align-items: center;

    justify-content: center;

    cursor: pointer;

    font-size: 27px;

    padding: 0;

    flex-shrink: 0;

}


.post-back-button:hover {

    color: #146c43;

}


.post-modal-title {

    margin-left: 8px;

    display: flex;

    flex-direction: column;

    line-height: 1.25;

}


.post-modal-title strong {

    font-size: 17px;

    color: #202520;

}


.post-modal-title span {

    margin-top: 2px;

    font-size: 12px;

    color: #7a817d;

}


.post-header-spacer {

    flex: 1;

}



/* =========================================================
   MODAL BODY
========================================================= */

.post-modal-body {

    flex: 1 1 auto;

    min-height: 0;

    overflow-y: auto;

    padding: 20px;

    box-sizing: border-box;

}


.post-fields {

    width: 100%;

    max-width: 700px;

    margin: 0 auto;

}



/* =========================================================
   TARGET SECTION
========================================================= */

.post-target-section {

    width: 100%;

    margin-bottom: 24px;

    padding: 15px;

    box-sizing: border-box;

    border: 1px solid #e1ebe4;

    border-radius: 15px;

    background: #f7faf8;

}



/* =========================================================
   TARGET SECTION HEADER
========================================================= */

.post-section-label {

    display: flex;

    align-items: center;

    gap: 11px;

    margin-bottom: 15px;

}


.post-section-label-icon {

    width: 38px;

    height: 38px;

    flex: 0 0 38px;

    border-radius: 50%;

    background: #e2f2e9;

    color: #198754;

    display: flex;

    align-items: center;

    justify-content: center;

    font-size: 17px;

}


.post-section-label > div {

    display: flex;

    flex-direction: column;

    min-width: 0;

}


.post-section-label strong {

    color: #26312a;

    font-size: 14px;

}


.post-section-label span {

    margin-top: 2px;

    color: #7a817d;

    font-size: 11px;

}



/* =========================================================
   TARGET PHASE
========================================================= */

.target-phase {

    width: 100%;

}


.target-phase-two {

    margin-top: 13px;

}


.target-field-label {

    display: block;

    margin-bottom: 7px;

    color: #37413a;

    font-size: 12px;

    font-weight: 700;

}



/* =========================================================
   TARGET SELECT
========================================================= */

.target-select {

    width: 100%;

    height: 48px;

    box-sizing: border-box;

    border: 1px solid #d6e0d9;

    border-radius: 11px;

    outline: none;

    background: #ffffff;

    color: #202520;

    font-family: inherit;

    font-size: 14px;

    padding: 0 12px;

    cursor: pointer;

}


.target-select:focus {

    border-color: #198754;

    box-shadow:
        0 0 0 3px
        rgba(25, 135, 84, 0.10);

}


.target-select:disabled {

    color: #929a95;

    background: #f0f4f1;

    cursor: default;

}



/* =========================================================
   TARGET HINT
========================================================= */

.target-selection-hint {

    margin-top: 6px;

    color: #7f8983;

    font-size: 11px;

    line-height: 1.4;

}



/* =========================================================
   SELECTED TARGET
========================================================= */

.selected-target-display {

    display: flex;

    align-items: center;

    gap: 9px;

    margin-top: 12px;

    padding: 9px 11px;

    border-radius: 10px;

    background: #eaf6ef;

}


.selected-target-icon {

    width: 25px;

    height: 25px;

    flex: 0 0 25px;

    border-radius: 50%;

    background: #198754;

    color: #ffffff;

    display: flex;

    align-items: center;

    justify-content: center;

    font-size: 13px;

}


.selected-target-info {

    display: flex;

    flex-direction: column;

    min-width: 0;

}


.selected-target-info span {

    color: #718078;

    font-size: 10px;

}


.selected-target-info strong {

    margin-top: 1px;

    color: #205b3b;

    font-size: 13px;

}



/* =========================================================
   POST CONTENT
========================================================= */

.post-fields-content {

    width: 100%;

}



/* =========================================================
   POST TITLE
========================================================= */

.post-title-wrapper {

    width: 100%;

    margin-bottom: 18px;

}


.post-title-label {

    display: block;

    margin-bottom: 7px;

    color: #6d7771;

    font-size: 11px;

    font-weight: 700;

    text-transform: uppercase;

    letter-spacing: 0.04em;

}


#postTitle {

    width: 100%;

    box-sizing: border-box;

    border: 1px solid #e0e7e2;

    border-radius: 12px;

    outline: none;

    background: #f8faf8;

    font-family: inherit;

    font-size: 20px;

    font-weight: 700;

    color: #202520;

    padding: 13px 14px;

    transition:
        border-color 0.2s ease,
        background 0.2s ease,
        box-shadow 0.2s ease;

}


#postTitle:focus {

    border-color: #198754;

    background: #ffffff;

    box-shadow:
        0 0 0 3px
        rgba(25, 135, 84, 0.10);

}


#postTitle::placeholder {

    color: #a0a6a2;

    font-weight: 600;

}



/* =========================================================
   IMAGE PREVIEW
========================================================= */

.image-preview-container {

    width: 100%;

}


.image-preview-grid {

    width: 100%;

    display: grid;

    grid-template-columns:
        repeat(2, minmax(0, 1fr));

    gap: 10px;

}


.image-preview-item {

    position: relative;

    width: 100%;

    aspect-ratio: 1 / 1;

    overflow: hidden;

    border-radius: 12px;

    background: #f3f5f3;

}


.image-preview-item img {

    width: 100%;

    height: 100%;

    display: block;

    object-fit: cover;

}


.remove-preview-image {

    position: absolute;

    top: 7px;

    right: 7px;

    width: 32px;

    height: 32px;

    border: none;

    border-radius: 50%;

    background: rgba(0, 0, 0, 0.65);

    color: #ffffff;

    display: flex;

    align-items: center;

    justify-content: center;

    cursor: pointer;

}



/* =========================================================
   BOTTOM COMPOSER
========================================================= */

.post-composer-wrapper {

    flex: 0 0 auto;

    width: 100%;

    padding:
        10px
        12px
        calc(10px + env(safe-area-inset-bottom));

    box-sizing: border-box;

    background: #ffffff;

    border-top: 1px solid #e8eee9;

}


.post-form {

    width: 100%;

    margin: 0;

}


.post-composer {

    width: 100%;

    min-height: 50px;

    display: flex;

    align-items: flex-end;

    gap: 8px;

    padding: 5px 7px;

    box-sizing: border-box;

    border: 1px solid #dce6df;

    border-radius: 28px;

    background: #f7faf8;

}



/* =========================================================
   ATTACHMENT BUTTON
========================================================= */

.composer-icon-button {

    flex: 0 0 42px;

    width: 42px;

    height: 42px;

    border: none;

    background: transparent;

    color: #198754;

    display: flex;

    align-items: center;

    justify-content: center;

    cursor: pointer;

    font-size: 23px;

    padding: 0;

}


.attachment-button i {

    display: block;

    transform: rotate(-20deg);

}



/* =========================================================
   TEXT INPUT
========================================================= */

.composer-input-area {

    position: relative;

    flex: 1;

    min-width: 0;

    display: flex;

    align-items: flex-end;

}


#postText {

    width: 100%;

    min-height: 40px;

    max-height: 120px;

    resize: none;

    overflow-y: auto;

    border: none;

    outline: none;

    background: transparent;

    padding:
        10px
        4px
        5px;

    margin: 0;

    box-sizing: border-box;

    font-family: inherit;

    font-size: 15px;

    line-height: 20px;

    color: #202520;

}


#postText::placeholder {

    color: #8b928d;

}



/* =========================================================
   CHARACTER COUNTER
========================================================= */

.character-counter {

    position: absolute;

    right: 5px;

    bottom: 1px;

    font-size: 10px;

    color: #8a928d;

    pointer-events: none;

    background: #f7faf8;

    padding-left: 3px;

}



/* =========================================================
   SEND BUTTON
========================================================= */

.composer-send-button {

    flex: 0 0 42px;

    width: 42px;

    height: 42px;

    border: none;

    border-radius: 50%;

    background: transparent;

    color: #198754;

    display: flex;

    align-items: center;

    justify-content: center;

    cursor: pointer;

    font-size: 20px;

    padding: 0;

}


.composer-send-button:disabled {

    color: #b8c2bc;

    cursor: default;

}



/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 600px) {

    .post-modal-header {

        height: 60px;

        padding: 0 10px;

    }


    .post-modal-title strong {

        font-size: 16px;

    }


    .post-modal-body {

        padding: 14px;

    }


    .post-target-section {

        padding: 13px;

    }


    #postTitle {

        font-size: 19px;

    }


    .image-preview-grid {

        grid-template-columns:
            repeat(2, minmax(0, 1fr));

        gap: 7px;

    }


    .post-composer-wrapper {

        padding:
            8px
            8px
            calc(8px + env(safe-area-inset-bottom));

    }


    .post-composer {

        min-height: 48px;

        gap: 4px;

        padding: 4px 5px;

    }


    .composer-icon-button {

        width: 40px;

        height: 40px;

        flex-basis: 40px;

        font-size: 22px;

    }


    .composer-send-button {

        width: 40px;

        height: 40px;

        flex-basis: 40px;

        font-size: 19px;

    }

}



/* =========================================================
   SMALL PHONES
========================================================= */

@media (max-width: 380px) {

    .post-modal-title span {

        display: none;

    }


    .post-modal-body {

        padding: 10px;

    }


    .character-counter {

        font-size: 9px;

    }


    .post-section-label-icon {

        width: 34px;

        height: 34px;

        flex-basis: 34px;

    }

}

</style>



<!-- =========================================================
     JAVASCRIPT
========================================================= -->

<script>

(function () {

    "use strict";


    function initializePostModal() {


        /* =====================================================
           BASIC ELEMENTS
        ====================================================== */

        const modal =
            document.getElementById("postModal");

        const openComposer =
            document.getElementById("openPostComposer");

        const closeButton =
            document.getElementById("closePostModal");

        const titleInput =
            document.getElementById("postTitle");

        const hiddenTitle =
            document.getElementById("postTitleHidden");

        const textarea =
            document.getElementById("postText");

        const imageInput =
            document.getElementById("postImages");

        const previewContainer =
            document.getElementById(
                "imagePreviewContainer"
            );

        const previewGrid =
            document.getElementById(
                "imagePreviewGrid"
            );

        const characterCounter =
            document.getElementById(
                "characterCounter"
            );

        const sendButton =
            document.getElementById(
                "submitPostButton"
            );

        const form =
            document.getElementById(
                "postForm"
            );


        /* =====================================================
           TARGET ELEMENTS
           These exist only on negative-code pages.
        ====================================================== */

        const targetCategory =
            document.getElementById(
                "targetCategory"
            );

        const targetPhaseTwo =
            document.getElementById(
                "targetPhaseTwo"
            );

        const targetDairySelect =
            document.getElementById(
                "targetDairySelect"
            );

        const targetSelectionHint =
            document.getElementById(
                "targetSelectionHint"
            );

        const targetDairyId =
            document.getElementById(
                "targetDairyId"
            );

        const selectedTargetDisplay =
            document.getElementById(
                "selectedTargetDisplay"
            );

        const selectedTargetName =
            document.getElementById(
                "selectedTargetName"
            );

        const postTargetHeader =
            document.getElementById(
                "postTargetHeader"
            );


        if (
            !modal ||
            !openComposer ||
            !closeButton ||
            !titleInput ||
            !hiddenTitle ||
            !textarea ||
            !imageInput ||
            !previewContainer ||
            !previewGrid ||
            !characterCounter ||
            !sendButton ||
            !form
        ) {

            console.error(
                "Post modal initialization failed."
            );

            return;

        }



        /* =====================================================
           DAIRY DATA
           
           The controller should provide:
               dairies

           Each object should contain:
               _id
               name
               code
        ====================================================== */

        const availableDairies =
            <%- JSON.stringify(
                typeof dairies !== "undefined"
                    ? dairies
                    : []
            ) %>;



        /* =====================================================
           OPEN MODAL
        ====================================================== */

        function openModal() {

            modal.classList.add(
                "active"
            );

            modal.setAttribute(
                "aria-hidden",
                "false"
            );

            document.body.style.overflow =
                "hidden";


            setTimeout(
                function () {

                    if (targetCategory) {

                        targetCategory.focus();

                    } else {

                        titleInput.focus();

                    }

                },
                100
            );

        }



        /* =====================================================
           CLOSE MODAL
        ====================================================== */

        function closeModal() {

            modal.classList.remove(
                "active"
            );

            modal.setAttribute(
                "aria-hidden",
                "true"
            );

            document.body.style.overflow =
                "";

        }



        /* =====================================================
           CHARACTER COUNTER
        ====================================================== */

        function updateCharacterCounter() {

            characterCounter.textContent =
                textarea.value.length +
                "/1000";

        }



        /* =====================================================
           SEND BUTTON
        ====================================================== */

        function updateSendButton() {

            const hasTitle =
                titleInput.value.trim().length > 0;


            const hasText =
                textarea.value.trim().length > 0;


            const hasImages =
                imageInput.files &&
                imageInput.files.length > 0;


            let hasTarget =
                true;


            /*
             * On negative-code pages, a target MUST
             * be selected before posting.
             */

            if (targetDairyId) {

                hasTarget =
                    targetDairyId.value.trim()
                        .length > 0;

            }


            sendButton.disabled =
                !(
                    hasTarget &&
                    (
                        hasTitle ||
                        hasText ||
                        hasImages
                    )
                );

        }



        /* =====================================================
           RESIZE TEXTAREA
        ====================================================== */

        function resizeTextarea() {

            textarea.style.height =
                "auto";


            const height =
                Math.min(
                    textarea.scrollHeight,
                    120
                );


            textarea.style.height =
                height + "px";

        }



        /* =====================================================
           RENDER IMAGE PREVIEWS
        ====================================================== */

        function renderPreviews() {

            previewGrid.innerHTML =
                "";


            const files =
                Array.from(
                    imageInput.files || []
                );


            if (!files.length) {

                previewContainer.hidden =
                    true;

                return;

            }


            previewContainer.hidden =
                false;


            files.forEach(
                function (file) {

                    if (
                        !file.type.startsWith(
                            "image/"
                        )
                    ) {

                        return;

                    }


                    const reader =
                        new FileReader();


                    reader.onload =
                        function (event) {

                            const item =
                                document.createElement(
                                    "div"
                                );


                            item.className =
                                "image-preview-item";


                            const image =
                                document.createElement(
                                    "img"
                                );


                            image.src =
                                event.target.result;


                            image.alt =
                                "Selected image";


                            item.appendChild(
                                image
                            );


                            previewGrid.appendChild(
                                item
                            );

                        };


                    reader.readAsDataURL(
                        file
                    );

                }
            );

        }



        /* =====================================================
           POPULATE PHASE 2
        ====================================================== */

        function populateTargetList(
            category
        ) {


            if (
                !targetPhaseTwo ||
                !targetDairySelect
            ) {

                return;

            }


            targetDairySelect.innerHTML =
                "";


            targetDairySelect.disabled =
                true;


            if (!category) {

                targetPhaseTwo.hidden =
                    true;

                if (targetSelectionHint) {

                    targetSelectionHint.textContent =
                        "Select a category first.";

                }

                clearSelectedTarget();

                updateSendButton();

                return;

            }


            /*
             * IMPORTANT:
             *
             * Animal:
             *     code > 0
             *
             * Structure / Facility / Tool:
             *     NO CODE ONLY
             *
             * Negative codes are deliberately
             * excluded from both lists.
             */

            const matchingDairies =
                availableDairies.filter(
                    function (item) {

                        if (!item) {

                            return false;

                        }


                        if (
                            category === "animal"
                        ) {

                            return (
                                item.code !== null &&
                                item.code !== undefined &&
                                item.code !== "" &&
                                Number(item.code) > 0
                            );

                        }


                        if (
                            category === "structure"
                        ) {

                            return (
                                item.code === null ||
                                item.code === undefined ||
                                item.code === ""
                            );

                        }


                        return false;

                    }
                );


            const defaultOption =
                document.createElement(
                    "option"
                );


            defaultOption.value =
                "";


            defaultOption.textContent =
                category === "animal"
                    ? "Select an animal"
                    : "Select a structure / facility / tool";


            targetDairySelect.appendChild(
                defaultOption
            );


            matchingDairies.forEach(
                function (item) {

                    const option =
                        document.createElement(
                            "option"
                        );


                    option.value =
                        item._id;


                    option.textContent =
                        item.name;


                    targetDairySelect.appendChild(
                        option
                    );

                }
            );


            targetPhaseTwo.hidden =
                false;


            targetDairySelect.disabled =
                matchingDairies.length === 0;


            if (targetSelectionHint) {

                if (
                    matchingDairies.length
                ) {

                    targetSelectionHint.textContent =
                        category === "animal"
                            ? "Select the animal this update concerns."
                            : "Select the structure, facility, or tool this update concerns.";

                } else {

                    targetSelectionHint.textContent =
                        category === "animal"
                            ? "No animals are currently available."
                            : "No structures, facilities, or tools are currently available.";

                }

            }


            clearSelectedTarget();

            updateSendButton();

        }



        /* =====================================================
           SELECT TARGET
        ====================================================== */

        function handleTargetSelection() {

            if (
                !targetDairySelect ||
                !targetDairyId
            ) {

                return;

            }


            const selectedId =
                targetDairySelect.value;


            if (!selectedId) {

                clearSelectedTarget();

                updateSendButton();

                return;

            }


            const selectedDairy =
                availableDairies.find(
                    function (item) {

                        return (
                            String(item._id) ===
                            String(selectedId)
                        );

                    }
                );


            if (!selectedDairy) {

                clearSelectedTarget();

                updateSendButton();

                return;

            }


            /*
             * This is the important value that the
             * backend will use later.
             */

            targetDairyId.value =
                selectedDairy._id;


            if (selectedTargetName) {

                selectedTargetName.textContent =
                    selectedDairy.name;

            }


            if (selectedTargetDisplay) {

                selectedTargetDisplay.hidden =
                    false;

            }


            if (postTargetHeader) {

                postTargetHeader.textContent =
                    selectedDairy.name;

            }


            updateSendButton();

        }



        /* =====================================================
           CLEAR TARGET
        ====================================================== */

        function clearSelectedTarget() {

            if (targetDairyId) {

                targetDairyId.value =
                    "";

            }


            if (selectedTargetName) {

                selectedTargetName.textContent =
                    "";

            }


            if (selectedTargetDisplay) {

                selectedTargetDisplay.hidden =
                    true;

            }


            /*
             * On a negative-code page, the header should
             * return to the current farm name until a
             * specific target has been selected.
             */

            if (
                postTargetHeader
            ) {

                postTargetHeader.textContent =
                    "<%= dairy.name %>";

            }

        }



        /* =====================================================
           TITLE
        ====================================================== */

        titleInput.addEventListener(
            "input",
            function () {

                hiddenTitle.value =
                    titleInput.value;

                updateSendButton();

            }
        );



        /* =====================================================
           TEXT
        ====================================================== */

        textarea.addEventListener(
            "input",
            function () {

                updateCharacterCounter();

                resizeTextarea();

                updateSendButton();

            }
        );



        /* =====================================================
           PHASE 1
        ====================================================== */

        if (targetCategory) {

            targetCategory.addEventListener(
                "change",
                function () {

                    populateTargetList(
                        targetCategory.value
                    );

                }
            );

        }



        /* =====================================================
           PHASE 2
        ====================================================== */

        if (targetDairySelect) {

            targetDairySelect.addEventListener(
                "change",
                handleTargetSelection
            );

        }



        /* =====================================================
           OPEN EVENTS
        ====================================================== */

        openComposer.addEventListener(
            "click",
            openModal
        );


        openComposer.addEventListener(
            "keydown",
            function (event) {

                if (
                    event.key === "Enter" ||
                    event.key === " "
                ) {

                    event.preventDefault();

                    openModal();

                }

            }
        );



        /* =====================================================
           CLOSE EVENTS
        ====================================================== */

        closeButton.addEventListener(
            "click",
            closeModal
        );



        /* =====================================================
           ESCAPE
        ====================================================== */

        document.addEventListener(
            "keydown",
            function (event) {

                if (
                    event.key === "Escape" &&
                    modal.classList.contains(
                        "active"
                    )
                ) {

                    closeModal();

                }

            }
        );



        /* =====================================================
           IMAGE SELECTION
        ====================================================== */

        imageInput.addEventListener(
            "change",
            function () {

                renderPreviews();

                updateSendButton();

            }
        );



        /* =====================================================
           FORM SUBMIT
        ====================================================== */

        form.addEventListener(
            "submit",
            function (event) {


                hiddenTitle.value =
                    titleInput.value.trim();


                const title =
                    titleInput.value.trim();


                const text =
                    textarea.value.trim();


                const hasImages =
                    imageInput.files &&
                    imageInput.files.length > 0;


                /*
                 * On a negative-code page, a target
                 * is mandatory.
                 */

                if (
                    targetDairyId &&
                    !targetDairyId.value.trim()
                ) {

                    event.preventDefault();

                    alert(
                        "Please select what this update is about."
                    );

                    return;

                }


                if (
                    !title &&
                    !text &&
                    !hasImages
                ) {

                    event.preventDefault();

                    return;

                }


                sendButton.disabled =
                    true;


                sendButton.innerHTML =
                    '<i class="bi bi-hourglass-split"></i>';

            }
        );



        /* =====================================================
           INITIAL STATE
        ====================================================== */

        updateCharacterCounter();

        resizeTextarea();


        /*
         * For positive-code pages the target ID is already
         * populated in the hidden field.
         *
         * For negative-code pages it remains empty until
         * the user completes Phase 1 + Phase 2.
         */

        updateSendButton();

    }



    /* =========================================================
       DOM READY
    ========================================================= */

    if (
        document.readyState === "loading"
    ) {

        document.addEventListener(
            "DOMContentLoaded",
            initializePostModal
        );

    } else {

        initializePostModal();

    }

})();

</script>