<!-- =========================================================
     UPDATE PAGE
     CREATE POST + FULL SCREEN POST MODAL
========================================================= --><style>

/* =========================================================
   CREATE POST CARD
========================================================= */

.create-post-card {
    width: 100%;
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 18px;
    padding: 16px;
    box-sizing: border-box;
}


/* =========================================================
   CREATE POST HEADER
========================================================= */

.create-post-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 14px;
}

.create-post-avatar {
    flex: 0 0 auto;
}

.create-post-avatar img {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    object-fit: cover;
    display: block;
}

.create-post-heading {
    min-width: 0;
    color: #374151;
    font-size: 14px;
    line-height: 1.4;
}

.create-post-heading strong {
    color: #166534;
    font-weight: 700;
}

.heading-line {
    display: block;
}


/* =========================================================
   CLICKABLE COMPOSER
========================================================= */

.composer-trigger {
    width: 100%;
    min-height: 52px;
    box-sizing: border-box;

    display: flex;
    align-items: center;

    padding: 0 16px;

    background: #f7f9f8;
    border: 1px solid #dfe7e2;
    border-radius: 14px;

    cursor: pointer;

    transition:
        background 0.2s ease,
        border-color 0.2s ease,
        box-shadow 0.2s ease;
}

.composer-trigger:hover {
    background: #f1f6f3;
    border-color: #86b99a;
    box-shadow: 0 3px 10px rgba(22, 101, 52, 0.08);
}

.composer-trigger:focus {
    outline: none;
    border-color: #16a34a;
    box-shadow: 0 0 0 3px rgba(22, 163, 74, 0.12);
}

.composer-placeholder {
    color: #8a938e;
    font-size: 15px;
}


/* =========================================================
   FULL SCREEN MODAL
========================================================= */

.post-modal {
    position: fixed;
    inset: 0;

    width: 100%;
    height: 100dvh;

    background: #ffffff;

    z-index: 99999;

    display: flex;
    flex-direction: column;

    visibility: hidden;
    opacity: 0;

    pointer-events: none;

    transform: translateY(100%);

    transition:
        transform 0.25s ease,
        opacity 0.2s ease,
        visibility 0.25s ease;
}

.post-modal.active {
    visibility: visible;
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
}


/* =========================================================
   MODAL CONTENT
========================================================= */

.post-modal-content {
    width: 100%;
    height: 100%;

    display: flex;
    flex-direction: column;

    background: #ffffff;
}


/* =========================================================
   MODAL HEADER
========================================================= */

.post-modal-header {
    flex: 0 0 auto;

    width: 100%;
    min-height: 64px;

    display: grid;
    grid-template-columns: 48px 1fr 48px;
    align-items: center;

    padding:
        env(safe-area-inset-top)
        14px
        0
        14px;

    box-sizing: border-box;

    border-bottom: 1px solid #e5e7eb;

    background: #ffffff;

    position: relative;
    z-index: 5;
}

.post-modal-header h3 {
    margin: 0;

    text-align: center;

    color: #166534;

    font-size: 18px;
    font-weight: 700;
}


/* =========================================================
   BACK BUTTON
========================================================= */

.close-modal-button {
    width: 44px;
    height: 44px;

    padding: 0;
    margin: 0;

    border: none;
    background: transparent;

    display: flex;
    align-items: center;
    justify-content: center;

    cursor: pointer;

    color: #16a34a;

    transition:
        transform 0.15s ease,
        color 0.15s ease;
}

.close-modal-button:hover {
    color: #15803d;
    transform: translateX(-2px);
}

.close-modal-button:active {
    transform: scale(0.92);
}

.close-modal-button svg {
    width: 27px;
    height: 27px;

    display: block;

    stroke: currentColor;
}


/* =========================================================
   MODAL BODY
========================================================= */

.post-modal-body {
    flex: 1 1 auto;

    min-height: 0;

    overflow-y: auto;

    padding: 20px;

    box-sizing: border-box;

    background: #ffffff;
}


/* =========================================================
   IMAGE PREVIEW
========================================================= */

.image-preview-container {
    position: relative;

    width: 100%;

    margin-bottom: 18px;

    border-radius: 14px;

    overflow: hidden;

    background: #f3f4f6;

    border: 1px solid #e5e7eb;
}

.image-preview {
    display: block;

    width: 100%;
    max-height: 420px;

    object-fit: contain;

    background: #f3f4f6;
}

.remove-image-button {
    position: absolute;

    top: 10px;
    right: 10px;

    width: 38px;
    height: 38px;

    border: none;

    border-radius: 50%;

    background: rgba(0, 0, 0, 0.65);

    color: #ffffff;

    display: flex;
    align-items: center;
    justify-content: center;

    cursor: pointer;
}

.remove-image-button svg {
    width: 19px;
    height: 19px;

    stroke: currentColor;
}


/* =========================================================
   POST TEXT AREA
========================================================= */

.post-editor {
    width: 100%;
}

.post-editor textarea {
    width: 100%;

    min-height: 220px;

    resize: none;

    border: none;
    outline: none;

    background: transparent;

    color: #17201a;

    font-family: inherit;

    font-size: 17px;

    line-height: 1.6;

    padding: 0;

    box-sizing: border-box;
}

.post-editor textarea::placeholder {
    color: #9ca3af;
}

.post-editor textarea:focus {
    outline: none;
}


/* =========================================================
   ATTACHMENT SECTION
========================================================= */

.modal-attachment-area {
    margin-top: 20px;

    padding: 14px 0;

    border-top: 1px solid #eef1ef;
}

.modal-attachment-button {
    display: inline-flex;

    align-items: center;
    gap: 9px;

    color: #16a34a;

    font-size: 14px;
    font-weight: 600;

    cursor: pointer;

    user-select: none;
}

.modal-attachment-button:hover {
    color: #15803d;
}

.modal-attachment-button svg {
    width: 23px;
    height: 23px;

    stroke: currentColor;
}


/* =========================================================
   SELECTED IMAGE NAME
========================================================= */

.selected-image-name {
    display: block;

    margin-top: 8px;

    color: #6b7280;

    font-size: 13px;

    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}


/* =========================================================
   WHATSAPP / SMS STYLE COMPOSER BAR
========================================================= */

.composer-bar {
    flex: 0 0 auto;

    width: 100%;

    display: flex;
    align-items: center;
    gap: 9px;

    padding:
        10px
        12px
        calc(10px + env(safe-area-inset-bottom))
        12px;

    box-sizing: border-box;

    background: #ffffff;

    border-top: 1px solid #e5e7eb;
}


/* =========================================================
   PAPERCLIP
========================================================= */

.attachment-button {
    flex: 0 0 auto;

    width: 38px;
    height: 42px;

    display: flex;
    align-items: center;
    justify-content: center;

    color: #16a34a;

    cursor: pointer;

    transition:
        color 0.15s ease,
        transform 0.15s ease;
}

.attachment-button:hover {
    color: #15803d;
}

.attachment-button:active {
    transform: scale(0.9);
}

.attachment-button svg {
    width: 24px;
    height: 24px;

    display: block;

    stroke: currentColor;
}


/* =========================================================
   INPUT AREA
========================================================= */

.composer-input-area {
    flex: 1 1 auto;

    min-width: 0;

    display: flex;
    align-items: center;

    background: #f4f7f5;

    border: 1px solid #dfe7e2;

    border-radius: 22px;

    padding: 0 13px;
}

.composer-input-area:focus-within {
    border-color: #86c79b;

    box-shadow:
        0 0 0 2px rgba(22, 163, 74, 0.08);
}


/* =========================================================
   TEXTAREA INSIDE COMPOSER
========================================================= */

.composer-input {
    flex: 1 1 auto;

    min-width: 0;

    height: 42px;

    resize: none;

    border: none;
    outline: none;

    background: transparent;

    padding: 11px 0;

    box-sizing: border-box;

    color: #17201a;

    font-family: inherit;

    font-size: 15px;

    line-height: 20px;
}

.composer-input::placeholder {
    color: #8b948f;
}

.composer-input:focus {
    outline: none;
}


/* =========================================================
   CHARACTER COUNTER
========================================================= */

.character-counter {
    flex: 0 0 auto;

    margin-left: 7px;

    color: #8a938e;

    font-size: 11px;

    white-space: nowrap;
}


/* =========================================================
   SEND BUTTON
========================================================= */

.send-button {
    flex: 0 0 auto;

    width: 44px;
    height: 44px;

    padding: 0;

    border: none;

    background: transparent;

    color: #16a34a;

    display: flex;
    align-items: center;
    justify-content: center;

    cursor: pointer;

    transition:
        color 0.15s ease,
        transform 0.15s ease;
}

.send-button svg {
    width: 27px;
    height: 27px;

    display: block;

    fill: currentColor;
}

.send-button:hover {
    color: #15803d;

    transform: translateX(1px);
}

.send-button:active {
    transform: scale(0.88);
}

.send-button:disabled {
    color: #a8b5ad;

    cursor: not-allowed;

    transform: none;
}


/* =========================================================
   HIDDEN FILE INPUT
========================================================= */

#postImage {
    display: none;
}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 600px) {

    .create-post-card {
        border-radius: 14px;
        padding: 14px;
    }

    .post-modal-header {
        min-height: 60px;
    }

    .post-modal-body {
        padding: 16px;
    }

    .post-editor textarea {
        min-height: 180px;
        font-size: 16px;
    }

    .composer-bar {
        gap: 6px;
    }

    .attachment-button {
        width: 36px;
    }

    .send-button {
        width: 42px;
    }

    .character-counter {
        font-size: 10px;
        margin-left: 4px;
    }

}


/* =========================================================
   VERY SMALL SCREENS
========================================================= */

@media (max-width: 380px) {

    .character-counter {
        display: none;
    }

}


/* =========================================================
   PREVENT BACKGROUND SCROLL
========================================================= */

body.post-modal-open {
    overflow: hidden;
}

</style><!-- =========================================================
     CREATE POST CARD
========================================================= --><section class="create-post-card"><div class="create-post-header">

    <div class="create-post-avatar">

        <img
            src="<%= user.profileImage || ('https://ui-avatars.com/api/?name=' + encodeURIComponent(user.name)) %>"
            alt="<%= user.name %>"
        >

    </div>

    <div class="create-post-heading">

        <div class="heading-line">

            <strong>
                <%= user.name.split(" ")[0] %>
            </strong>
            , update us about

        </div>

        <div class="heading-line">

            <strong>
                <%= dairy.name %>
            </strong>

        </div>

    </div>

</div>


<!-- =====================================================
     CLICKABLE COMPOSER
     NO IMAGE ICON HERE
====================================================== -->

<div
    id="openPostComposer"
    class="composer-trigger"
    role="button"
    tabindex="0"
    aria-label="Create Post"
>

    <span class="composer-placeholder">
        Share an update...
    </span>

</div>

</section><!-- =========================================================
     FULL SCREEN POST MODAL
========================================================= --><div
    id="postModal"
    class="post-modal"
    aria-hidden="true"
><div class="post-modal-content">


    <!-- =================================================
         HEADER
    ================================================== -->

    <div class="post-modal-header">

        <button
            type="button"
            id="closePostModal"
            class="close-modal-button"
            aria-label="Back"
        >

            <!-- REAL BACK ARROW SVG -->

            <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
            >

                <path d="M19 12H5"></path>

                <path d="M12 19l-7-7 7-7"></path>

            </svg>

        </button>


        <h3>
            New Update
        </h3>


        <span></span>

    </div>


    <!-- =================================================
         FORM
    ================================================== -->

    <form
        id="postForm"
        action="/dairy/<%= dairy._id %>/post"
        method="POST"
        enctype="multipart/form-data"
        style="display:flex; flex-direction:column; height:100%; min-height:0;"
    >


        <!-- =============================================
             SCROLLABLE BODY
        ============================================== -->

        <div class="post-modal-body">


            <!-- =========================================
                 IMAGE PREVIEW
            ========================================== -->

            <div
                id="imagePreviewContainer"
                class="image-preview-container"
                style="display:none;"
            >

                <img
                    id="imagePreview"
                    class="image-preview"
                    alt="Selected image preview"
                >


                <button
                    id="removeImage"
                    type="button"
                    class="remove-image-button"
                    aria-label="Remove image"
                >

                    <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                    >

                        <path d="M6 6l12 12"></path>
                        <path d="M18 6L6 18"></path>

                    </svg>

                </button>

            </div>


            <!-- =========================================
                 POST TEXT
            ========================================== -->

            <div class="post-editor">

                <textarea
                    id="postText"
                    name="text"
                    maxlength="1000"
                    placeholder="<%= user.name.split(' ')[0] %>, type your update here..."
                ></textarea>

            </div>


            <!-- =========================================
                 ATTACHMENT INFORMATION

                 File icon is available HERE,
                 NOT ON THE ORIGINAL COMPOSER.
            ========================================== -->

            <div class="modal-attachment-area">

                <label
                    for="postImage"
                    class="modal-attachment-button"
                >

                    <!-- REAL PAPERCLIP SVG -->

                    <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                    >

                        <path
                            d="M21.44 11.05l-9.19 9.19a6 6 0 01-8.49-8.49l9.19-9.19a4 4 0 015.66 5.66l-9.2 9.19a2 2 0 01-2.83-2.83l8.49-8.48"
                        ></path>

                    </svg>

                    Add photo

                </label>


                <input
                    id="postImage"
                    name="image"
                    type="file"
                    accept="image/*"
                >


                <span
                    id="selectedImageName"
                    class="selected-image-name"
                ></span>

            </div>

        </div>


        <!-- =================================================
             WHATSAPP / SMS STYLE COMPOSER
        ================================================== -->

        <div class="composer-bar">


            <!-- =============================================
                 PAPERCLIP
            ============================================== -->

            <label
                for="postImage"
                class="attachment-button"
                aria-label="Attach image"
            >

                <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                >

                    <path
                        d="M21.44 11.05l-9.19 9.19a6 6 0 01-8.49-8.49l9.19-9.19a4 4 0 015.66 5.66l-9.2 9.19a2 2 0 01-2.83-2.83l8.49-8.48"
                    ></path>

                </svg>

            </label>


            <!-- =============================================
                 TYPING AREA

                 📎 [ Type your update... 0/1000 ] [ SEND ]
            ============================================== -->

            <div class="composer-input-area">

                <textarea
                    id="composerInput"
                    class="composer-input"
                    maxlength="1000"
                    placeholder="Type your update..."
                    rows="1"
                    aria-label="Type your update"
                ></textarea>


                <span
                    id="characterCounter"
                    class="character-counter"
                >
                    0/1000
                </span>

            </div>


            <!-- =============================================
                 SEND BUTTON
            ============================================== -->

            <button
                id="submitPostButton"
                type="submit"
                class="send-button"
                aria-label="Send post"
                disabled
            >

                <!-- REAL SEND ICON -->

                <svg
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                >

                    <path
                        d="M3.4 20.4L21 12 3.4 3.6 3 10l12 2-12 2 .4 6.4z"
                    ></path>

                </svg>

            </button>

        </div>


    </form>

</div>

</div><script>

/* =========================================================
   POST MODAL
========================================================= */

(function () {

    function initializePostModal() {

        const modal =
            document.getElementById("postModal");

        const openComposer =
            document.getElementById("openPostComposer");

        const closeButton =
            document.getElementById("closePostModal");

        const form =
            document.getElementById("postForm");

        const textarea =
            document.getElementById("postText");

        const composerInput =
            document.getElementById("composerInput");

        const imageInput =
            document.getElementById("postImage");

        const imagePreviewContainer =
            document.getElementById("imagePreviewContainer");

        const imagePreview =
            document.getElementById("imagePreview");

        const removeImage =
            document.getElementById("removeImage");

        const selectedImageName =
            document.getElementById("selectedImageName");

        const characterCounter =
            document.getElementById("characterCounter");

        const sendButton =
            document.getElementById("submitPostButton");


        /* =====================================================
           REQUIRED ELEMENT CHECK
        ====================================================== */

        if (
            !modal ||
            !openComposer ||
            !closeButton ||
            !form ||
            !textarea ||
            !composerInput ||
            !imageInput ||
            !sendButton
        ) {

            console.warn(
                "Post modal could not initialize. Required element missing."
            );

            return;

        }


        /* =====================================================
           OPEN MODAL
        ====================================================== */

        function openModal() {

            modal.classList.add("active");

            modal.setAttribute(
                "aria-hidden",
                "false"
            );

            document.body.classList.add(
                "post-modal-open"
            );


            setTimeout(function () {

                composerInput.focus();

            }, 250);

        }


        /* =====================================================
           CLOSE MODAL
        ====================================================== */

        function closeModal() {

            modal.classList.remove("active");

            modal.setAttribute(
                "aria-hidden",
                "true"
            );

            document.body.classList.remove(
                "post-modal-open"
            );

        }


        /* =====================================================
           OPEN COMPOSER
        ====================================================== */

        openComposer.addEventListener(
            "click",
            function () {

                openModal();

            }
        );


        /* =====================================================
           KEYBOARD OPEN
        ====================================================== */

        openComposer.addEventListener(
            "keydown",
            function (event) {

                if (
                    event.key === "Enter" ||
                    event.key === " "
                ) {

                    event.preventDefault();

                    openModal();

                }

            }
        );


        /* =====================================================
           CLOSE
        ====================================================== */

        closeButton.addEventListener(
            "click",
            function () {

                closeModal();

            }
        );


        /* =====================================================
           ESCAPE
        ====================================================== */

        document.addEventListener(
            "keydown",
            function (event) {

                if (
                    event.key === "Escape" &&
                    modal.classList.contains("active")
                ) {

                    closeModal();

                }

            }
        );


        /* =====================================================
           TEXTAREA HEIGHT
        ====================================================== */

        function resizeComposer() {

            composerInput.style.height = "42px";

            const newHeight =
                Math.min(
                    composerInput.scrollHeight,
                    120
                );

            composerInput.style.height =
                newHeight + "px";

        }


        /* =====================================================
           SYNC TEXT
        ====================================================== */

        function syncText() {

            textarea.value =
                composerInput.value;

            updateCounter();

            updateSendButton();

            resizeComposer();

        }


        /* =====================================================
           CHARACTER COUNTER
        ====================================================== */

        function updateCounter() {

            const length =
                composerInput.value.length;

            characterCounter.textContent =
                length + "/1000";

        }


        /* =====================================================
           SEND BUTTON STATE
        ====================================================== */

        function updateSendButton() {

            const hasText =
                composerInput.value.trim().length > 0;

            const hasImage =
                imageInput.files &&
                imageInput.files.length > 0;

            sendButton.disabled =
                !(hasText || hasImage);

        }


        /* =====================================================
           TYPING
        ====================================================== */

        composerInput.addEventListener(
            "input",
            function () {

                syncText();

            }
        );


        /* =====================================================
           IMAGE SELECTION
        ====================================================== */

        imageInput.addEventListener(
            "change",
            function () {

                if (
                    !imageInput.files ||
                    !imageInput.files.length
                ) {

                    updateSendButton();

                    return;

                }


                const file =
                    imageInput.files[0];


                /* =============================================
                   IMAGE PREVIEW
                ============================================== */

                if (
                    file.type &&
                    file.type.startsWith("image/")
                ) {

                    const reader =
                        new FileReader();

                    reader.onload =
                        function (event) {

                            imagePreview.src =
                                event.target.result;

                            imagePreviewContainer.style.display =
                                "block";

                        };

                    reader.readAsDataURL(file);

                }


                /* =============================================
                   FILE NAME
                ============================================== */

                if (selectedImageName) {

                    selectedImageName.textContent =
                        file.name;

                }


                updateSendButton();

            }
        );


        /* =====================================================
           REMOVE IMAGE
        ====================================================== */

        if (removeImage) {

            removeImage.addEventListener(
                "click",
                function () {

                    imageInput.value = "";

                    imagePreview.src = "";

                    imagePreviewContainer.style.display =
                        "none";

                    if (selectedImageName) {

                        selectedImageName.textContent =
                            "";

                    }

                    updateSendButton();

                }
            );

        }


        /* =====================================================
           SUBMIT FORM
        ====================================================== */

        form.addEventListener(
            "submit",
            function () {

                /* ---------------------------------------------
                   Copy composer text into the actual form
                   field used by the controller:
                   req.body.text
                ---------------------------------------------- */

                textarea.value =
                    composerInput.value.trim();


                const hasText =
                    textarea.value.length > 0;

                const hasImage =
                    imageInput.files &&
                    imageInput.files.length > 0;


                if (
                    !hasText &&
                    !hasImage
                ) {

                    event.preventDefault();

                    return;

                }


                sendButton.disabled = true;


                /* ---------------------------------------------
                   Replace send icon with simple sending state
                ---------------------------------------------- */

                sendButton.innerHTML = `
                    <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        aria-hidden="true"
                    >
                        <path d="M12 2v12"></path>
                        <path d="M7 9l5 5 5-5"></path>
                        <path d="M5 21h14"></path>
                    </svg>
                `;

            }
        );


        /* =====================================================
           INITIAL STATE
        ====================================================== */

        updateCounter();

        updateSendButton();

        resizeComposer();

    }


    /* =========================================================
       INITIALIZE AFTER DOM LOAD
    ========================================================= */

    if (
        document.readyState === "loading"
    ) {

        document.addEventListener(
            "DOMContentLoaded",
            initializePostModal
        );

    } else {

        initializePostModal();

    }

})();

</script>