    }


    .farm-post-icon-button {

        width: 40px;
        height: 40px;

        flex-basis: 40px;

        font-size: 22px;

    }


    .farm-post-send-button {

        width: 40px;
        height: 40px;

        flex-basis: 40px;

        font-size: 19px;

    }

}


@media (max-width: 380px) {

    .farm-post-modal__title span {

        max-width: 55vw;

    }

}

</style>



<!-- =========================================================
     JAVASCRIPT
========================================================= -->

<script>

(function () {

    "use strict";


    function initializeFarmPostComposer() {


        /* =====================================================
           ELEMENTS
        ====================================================== */

        const modal =
            document.getElementById(
                "farmPostModal"
            );


        const closeButton =
            document.getElementById(
                "farmPostModalClose"
            );


        const assetCards =
            document.querySelectorAll(
                ".farm-post-composer__asset-card"
            );


        const form =
            document.getElementById(
                "farmPostForm"
            );


        const targetDairyId =
            document.getElementById(
                "farmTargetDairyId"
            );


        const targetHeader =
            document.getElementById(
                "farmPostTargetHeader"
            );


        const selectedAssetImage =
            document.getElementById(
                "farmSelectedAssetImage"
            );


        const selectedAssetName =
            document.getElementById(
                "farmSelectedAssetName"
            );


        const selectedAssetType =
            document.getElementById(
                "farmSelectedAssetType"
            );


        const titleInput =
            document.getElementById(
                "farmPostTitle"
            );


        const hiddenTitle =
            document.getElementById(
                "farmPostTitleHidden"
            );


        const textInput =
            document.getElementById(
                "farmPostText"
            );


        const imageInput =
            document.getElementById(
                "farmPostImages"
            );


        const previewContainer =
            document.getElementById(
                "farmImagePreviewContainer"
            );


        const previewGrid =
            document.getElementById(
                "farmImagePreviewGrid"
            );


        const counter =
            document.getElementById(
                "farmPostCharacterCounter"
            );


        const submitButton =
            document.getElementById(
                "farmPostSubmitButton"
            );



        /* =====================================================
           REQUIRED ELEMENTS
        ====================================================== */

        if (
            !modal ||
            !closeButton ||
            !form ||
            !targetDairyId ||
            !titleInput ||
            !hiddenTitle ||
            !textInput ||
            !imageInput ||
            !counter ||
            !submitButton
        ) {

            console.error(
                "FARM CREATE POST: required elements missing."
            );

            return;

        }



        /* =====================================================
           OPEN MODAL
        ====================================================== */

        function openModal(card) {


            const assetId =
                card.dataset.assetId || "";


            const assetName =
                card.dataset.assetName ||
                "Unnamed Asset";


            const assetType =
                card.dataset.assetType ||
                "Tool";


            const assetImage =
                card.dataset.assetImage ||
                "";


            /* ================================================
               SET TARGET
            ================================================= */

            targetDairyId.value =
                assetId;


            /* ================================================
               SET HEADER
            ================================================= */

            targetHeader.textContent =
                assetName;


            /* ================================================
               SET SELECTED ASSET
            ================================================= */

            if (selectedAssetImage) {

                selectedAssetImage.src =
                    assetImage;

                selectedAssetImage.alt =
                    assetName;

            }


            if (selectedAssetName) {

                selectedAssetName.textContent =
                    assetName;

            }


            if (selectedAssetType) {

                selectedAssetType.textContent =
                    assetType;

            }


            /* ================================================
               RESET CONTENT
            ================================================= */

            titleInput.value =
                "";

            hiddenTitle.value =
                "";

            textInput.value =
                "";

            imageInput.value =
                "";

            previewGrid.innerHTML =
                "";

            previewContainer.hidden =
                true;


            updateCounter();

            resizeTextarea();

            updateSubmitButton();


            /* ================================================
               OPEN
            ================================================= */

            modal.classList.add(
                "farm-post-modal--active"
            );


            modal.setAttribute(
                "aria-hidden",
                "false"
            );


            document.body.style.overflow =
                "hidden";


            setTimeout(function () {

                titleInput.focus();

            }, 100);

        }



        /* =====================================================
           CLOSE MODAL
        ====================================================== */

        function closeModal() {

            modal.classList.remove(
                "farm-post-modal--active"
            );


            modal.setAttribute(
                "aria-hidden",
                "true"
            );


            document.body.style.overflow =
                "";

        }



        /* =====================================================
           COUNTER
        ====================================================== */

        function updateCounter() {

            counter.textContent =
                textInput.value.length +
                "/1000";

        }



        /* =====================================================
           TEXTAREA RESIZE
        ====================================================== */

        function resizeTextarea() {

            textInput.style.height =
                "auto";


            const height =
                Math.min(
                    textInput.scrollHeight,
                    120
                );


            textInput.style.height =
                height + "px";

        }



        /* =====================================================
           SUBMIT BUTTON
        ====================================================== */

        function updateSubmitButton() {

            const hasTarget =
                targetDairyId.value.trim().length > 0;


            const hasTitle =
                titleInput.value.trim().length > 0;


            const hasText =
                textInput.value.trim().length > 0;


            const hasImages =
                imageInput.files &&
                imageInput.files.length > 0;


            submitButton.disabled =
                !(
                    hasTarget &&
                    (
                        hasTitle ||
                        hasText ||
                        hasImages
                    )
                );

        }



        /* =====================================================
           IMAGE PREVIEW
        ====================================================== */

        function renderImagePreviews() {

            previewGrid.innerHTML =
                "";


            const files =
                Array.from(
                    imageInput.files || []
                );


            if (!files.length) {

                previewContainer.hidden =
                    true;

                return;

            }


            previewContainer.hidden =
                false;


            files.forEach(function (file) {

                if (
                    !file ||
                    !file.type.startsWith("image/")
                ) {

                    return;

                }


                const reader =
                    new FileReader();


                reader.onload =
                    function (event) {

                        const item =
                            document.createElement(
                                "div"
                            );


                        item.className =
                            "farm-image-preview-item";


                        const image =
                            document.createElement(
                                "img"
                            );


                        image.src =
                            event.target.result;


                        image.alt =
                            "Selected image";


                        item.appendChild(
                            image
                        );


                        previewGrid.appendChild(
                            item
                        );

                    };


                reader.readAsDataURL(file);

            });

        }



        /* =====================================================
           ASSET CARD CLICK
        ====================================================== */

        assetCards.forEach(function (card) {

            card.addEventListener(
                "click",
                function () {

                    openModal(card);

                }
            );

        });



        /* =====================================================
           CLOSE
        ====================================================== */

        closeButton.addEventListener(
            "click",
            closeModal
        );



        /* =====================================================
           ESCAPE
        ====================================================== */

        document.addEventListener(
            "keydown",
            function (event) {

                if (
                    event.key === "Escape" &&
                    modal.classList.contains(
                        "farm-post-modal--active"
                    )
                ) {

                    closeModal();

                }

            }
        );



        /* =====================================================
           TITLE
        ====================================================== */

        titleInput.addEventListener(
            "input",
            function () {

                hiddenTitle.value =
                    titleInput.value;

                updateSubmitButton();

            }
        );



        /* =====================================================
           TEXT
        ====================================================== */

        textInput.addEventListener(
            "input",
            function () {

                updateCounter();

                resizeTextarea();

                updateSubmitButton();

            }
        );



        /* =====================================================
           IMAGES
        ====================================================== */

        imageInput.addEventListener(
            "change",
            function () {

                renderImagePreviews();

                updateSubmitButton();

            }
        );



        /* =====================================================
           FORM SUBMIT
        ====================================================== */

        form.addEventListener(
            "submit",
            function (event) {


                const target =
                    targetDairyId.value.trim();


                const title =
                    titleInput.value.trim();


                const text =
                    textInput.value.trim();


                const hasImages =
                    imageInput.files &&
                    imageInput.files.length > 0;


                /* =============================================
                   TARGET REQUIRED
                ============================================== */

                if (!target) {

                    event.preventDefault();

                    alert(
                        "Please select an asset to update."
                    );

                    return;

                }


                /* =============================================
                   CONTENT REQUIRED
                ============================================== */

                if (
                    !title &&
                    !text &&
                    !hasImages
                ) {

                    event.preventDefault();

                    return;

                }


                /* =============================================
                   COPY TITLE
                ============================================== */

                hiddenTitle.value =
                    title;


                /* =============================================
                   PREVENT DOUBLE SUBMISSION
                ============================================== */

                submitButton.disabled =
                    true;


                submitButton.innerHTML =
                    '<i class="bi bi-hourglass-split"></i>';

            }
        );



        /* =====================================================
           INITIAL STATE
        ====================================================== */

        updateCounter();

        resizeTextarea();

        updateSubmitButton();

    }



    /* =========================================================
       DOM READY
    ========================================================= */

    if (
        document.readyState === "loading"
    ) {

        document.addEventListener(
            "DOMContentLoaded",
            initializeFarmPostComposer
        );

    } else {

        initializeFarmPostComposer();

    }

})();

</script>