    flex: 0 0 44px;
    border: none;
    background: transparent;
    color: #198754;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 27px;
    padding: 0;

}


.post-modal-title {

    margin-left: 8px;
    min-width: 0;
    display: flex;
    flex-direction: column;
