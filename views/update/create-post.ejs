    flex: 0 0 38px;
    border-radius: 50%;
    background: #e2f2e9;
    color: #198754;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 17px;

}


.post-section-label > div {

    display: flex;
    flex-direction: column;

}


.post-section-label strong {

    color: #26312a;
    font-size: 14px;

}


.post-section-label span {

    margin-top: 2px;
    color: #7a817d;
    font-size: 11px;

}



/* =========================================================
   PHASES
========================================================= */

.target-phase {

    width: 100%;

}


.target-phase-two {

    margin-top: 15px;

}


.target-field-label {

    display: block;
    margin-bottom: 7px;
    color: #37413a;
    font-size: 12px;
    font-weight: 700;

}



/* =========================================================
   SELECT
========================================================= */

.target-select {

    display: block;
    width: 100%;
    min-height: 48px;
    height: 48px;
    padding: 0 12px;
    border: 1px solid #d6e0d9;
    border-radius: 11px;
    outline: none;
    background-color: #ffffff;
    color: #202520;
    font-family: inherit;
    font-size: 14px;
    cursor: pointer;
