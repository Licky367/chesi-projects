/* =========================================================
   INDIVIDUAL IMAGE PREVIEW
========================================================= */

.image-preview-item {

    position: relative;

    width: 100%;

    aspect-ratio: 1 / 1;

    border-radius: 14px;

    overflow: hidden;

    background: #f4f6f4;

}


.image-preview-item img {

    width: 100%;

    height: 100%;

    display: block;

    object-fit: cover;

}



/* =========================================================
   IMAGE NUMBER
========================================================= */

.image-preview-number {

    position: absolute;

    left: 8px;

    bottom: 8px;

    min-width: 24px;

    height: 24px;

    padding: 0 7px;

    box-sizing: border-box;

    border-radius: 12px;

    background: rgba(0, 0, 0, 0.6);

    color: #ffffff;

    display: flex;

    align-items: center;

    justify-content: center;

    font-size: 11px;

    font-weight: 600;

}



/* =========================================================
   REMOVE IMAGE BUTTON
========================================================= */

.remove-image-button {

    position: absolute;

    top: 8px;

    right: 8px;

    width: 34px;

    height: 34px;

    border: none;

    border-radius: 50%;

    background: rgba(0, 0, 0, 0.65);

    color: #ffffff;

    display: flex;

    align-items: center;

    justify-content: center;

    cursor: pointer;

    font-size: 14px;

    padding: 0;

}


.remove-image-button:hover {

    background: rgba(0, 0, 0, 0.8);

}



/* =========================================================
   ADD MORE IMAGES
========================================================= */

.add-more-images {

    width: 100%;

    aspect-ratio: 1 / 1;

    border: 2px dashed #cbd8cf;

    border-radius: 14px;

    background: #f8faf8;

