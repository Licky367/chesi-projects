<% /*
==========================================================
DAIRY FARM CREATE POST COMPOSER

FILE:
    views/update/create-post.ejs

PURPOSE:
    Farm-level post composer.

    This version is ONLY for Dairy Farm pages.

CURRENT PAGE:
    dairy.code < 0

BEHAVIOUR:
----------------------------------------------------------
    The user sees the farm's assets in a horizontal row.

    Each asset card contains:

        profileImage
        asset name
        asset type

    Asset type:

        code > 0
            Animal

        code === null / undefined / ""
            Tool

    Clicking an asset immediately opens the post modal.

    The clicked asset automatically becomes:

        targetDairyId

IMPORTANT:
----------------------------------------------------------
    No category selector.
    No subject selector.
    No dropdown.
    No target list.

EXPECTED SERVER VARIABLES:
----------------------------------------------------------
    dairy
    user
    assetDairies

assetDairies should contain the assets belonging to the
currently viewed Dairy Farm.

==========================================================
*/ %>


<!-- =========================================================
     BOOTSTRAP ICONS
========================================================= -->

<link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
>


<!-- =========================================================
     DAIRY FARM CREATE POST
========================================================= -->

<section
    class="farm-post-composer"
    aria-label="Create Dairy Farm update"
>


    <!-- =====================================================
         HEADER
    ====================================================== -->

    <div class="farm-post-composer__header">


        <!-- USER AVATAR -->

        <div class="farm-post-composer__user">

            <img
                src="<%= user.profileImage || ('https://ui-avatars.com/api/?name=' + encodeURIComponent(user.name || 'User')) %>"
                alt="<%= user.name || 'User' %>"
                class="farm-post-composer__user-avatar"
            >

        </div>


        <!-- HEADER TEXT -->

        <div class="farm-post-composer__heading">

            <strong>
                <%= user.name || "User" %>
            </strong>

            , update us about any of

            <strong>
                <%= dairy.name %>
            </strong>

            's assets.

        </div>

    </div>



    <!-- =====================================================
         ASSET SCROLLER
    ====================================================== -->

    <div
        class="farm-post-composer__asset-scroll"
        role="list"
        aria-label="Dairy Farm assets"
    >

        <% if (Array.isArray(assetDairies) && assetDairies.length) { %>


            <% assetDairies.forEach(function (asset) { %>


                <%
                    /*
                    ==================================================
                    DETERMINE ASSET TYPE
                    ==================================================
                    */

                    const assetCode =
                        asset &&
                        asset.code !== undefined
                            ? asset.code
                            : null;


                    const numericAssetCode =
                        (
                            assetCode !== null &&
                            assetCode !== ""
                        )
                            ? Number(assetCode)
                            : NaN;


                    const isAnimal =
                        Number.isFinite(
                            numericAssetCode
                        ) &&
                        numericAssetCode > 0;


                    const assetType =
                        isAnimal
                            ? "Animal"
                            : "Tool";


                    /*
                    ==================================================
                    ASSET IMAGE
                    ==================================================
                    */

                    const assetImage =
                        asset.profileImage ||
                        asset.displayImage ||
                        (
                            "https://ui-avatars.com/api/?name=" +
                            encodeURIComponent(
                                asset.name || "Asset"
                            ) +
                            "&background=e8f5ed&color=198754"
                        );
                %>


                <!-- =================================================
                     ASSET CARD
                ================================================== -->

                <button
                    type="button"
                    class="farm-post-composer__asset-card"
                    data-asset-id="<%= asset._id %>"
                    data-asset-name="<%= asset.name || 'Unnamed Asset' %>"
                    data-asset-type="<%= assetType %>"
                    data-asset-image="<%= assetImage %>"
                    role="listitem"
                    aria-label="Update about <%= asset.name || 'Unnamed Asset' %>"
                >


                    <!-- ASSET IMAGE -->

                    <div class="farm-post-composer__asset-image-wrap">

                        <img
                            src="<%= assetImage %>"
                            alt="<%= asset.name || 'Asset' %>"
                            class="farm-post-composer__asset-image"
                            loading="lazy"
                        >

                    </div>


                    <!-- ASSET INFORMATION -->

                    <div class="farm-post-composer__asset-info">

                        <strong
                            class="farm-post-composer__asset-name"
                        >
                            <%= asset.name || "Unnamed Asset" %>
                        </strong>


                        <span
                            class="farm-post-composer__asset-type"
                        >
                            <%= assetType %>
                        </span>

                    </div>

                </button>


            <% }); %>


        <% } else { %>


            <!-- =================================================
                 EMPTY STATE
            ================================================== -->

            <div class="farm-post-composer__empty">

                <div class="farm-post-composer__empty-icon">

                    <i class="bi bi-box-seam"></i>

                </div>

                <span>
                    No farm assets available.
                </span>

            </div>


        <% } %>

    </div>

</section>



<!-- =========================================================
     FULL SCREEN POST MODAL
========================================================= -->

<div
    id="farmPostModal"
    class="farm-post-modal"
    aria-hidden="true"
>


    <div class="farm-post-modal__content">


        <!-- =================================================
             MODAL HEADER
        ================================================== -->

        <header class="farm-post-modal__header">


            <button
                type="button"
                id="farmPostModalClose"
                class="farm-post-modal__back"
                aria-label="Close post composer"
            >

                <i class="bi bi-arrow-left"></i>

            </button>


            <div class="farm-post-modal__title">

                <strong>
                    New Update
                </strong>


                <span id="farmPostTargetHeader">
                    Select an asset
                </span>

            </div>


            <div class="farm-post-modal__spacer"></div>

        </header>



        <!-- =================================================
             MODAL BODY
        ================================================== -->

        <main class="farm-post-modal__body">


            <div class="farm-post-modal__fields">


                <!-- =================================================
                     SELECTED ASSET
                ================================================== -->

                <div
                    id="farmSelectedAsset"
                    class="farm-selected-asset"
                >

                    <img
                        id="farmSelectedAssetImage"
                        src=""
                        alt=""
                        class="farm-selected-asset__image"
                    >


                    <div class="farm-selected-asset__info">

                        <span>
                            Update concerns
                        </span>

                        <strong id="farmSelectedAssetName">
                            Asset
                        </strong>

                        <small id="farmSelectedAssetType">
                            Animal
                        </small>

                    </div>


                    <div class="farm-selected-asset__check">

                        <i class="bi bi-check-lg"></i>

                    </div>

                </div>



                <!-- =================================================
                     TITLE
                ================================================== -->

                <div class="farm-post-title-wrapper">

                    <label
                        for="farmPostTitle"
                        class="farm-post-title-label"
                    >
                        Title
                    </label>


                    <input
                        type="text"
                        id="farmPostTitle"
                        maxlength="200"
                        placeholder="Give your update a title..."
                        autocomplete="off"
                        aria-label="Post title"
                    >

                </div>



                <!-- =================================================
                     IMAGE PREVIEW
                ================================================== -->

                <div
                    id="farmImagePreviewContainer"
                    class="farm-image-preview-container"
                    hidden
                >

                    <div
                        id="farmImagePreviewGrid"
                        class="farm-image-preview-grid"
                    ></div>

                </div>

            </div>

        </main>



        <!-- =================================================
             BOTTOM COMPOSER
        ================================================== -->

        <div class="farm-post-composer-wrapper">


            <form
                id="farmPostForm"
                action="/dairy/<%= dairy._id %>/post"
                method="POST"
                enctype="multipart/form-data"
                class="farm-post-form"
            >


                <!-- =================================================
                     TARGET ASSET
                ================================================== -->

                <input
                    type="hidden"
                    name="targetDairyId"
                    id="farmTargetDairyId"
                    value=""
                >


                <!-- =================================================
                     TITLE
                ================================================== -->

                <input
                    type="hidden"
                    name="title"
                    id="farmPostTitleHidden"
                    value=""
                >



                <!-- =================================================
                     COMPOSER
                ================================================== -->

                <div class="farm-post-composer-bar">


                    <!-- ATTACHMENT -->

                    <label
                        for="farmPostImages"
                        class="farm-post-icon-button"
                        aria-label="Attach images"
                        title="Attach images"
                    >

                        <i class="bi bi-paperclip"></i>

                    </label>


                    <input
                        type="file"
                        id="farmPostImages"
                        name="images"
                        accept="image/jpeg,image/jpg,image/png,image/webp"
                        multiple
                        hidden
                    >



                    <!-- TEXT -->

                    <div class="farm-post-input-area">

                        <textarea
                            id="farmPostText"
                            name="text"
                            maxlength="1000"
                            rows="1"
                            placeholder="Type your update..."
                            aria-label="Type your update"
                        ></textarea>


                        <span
                            id="farmPostCharacterCounter"
                            class="farm-post-character-counter"
                        >
                            0/1000
                        </span>

                    </div>



                    <!-- SEND -->

                    <button
                        type="submit"
                        id="farmPostSubmitButton"
                        class="farm-post-send-button"
                        aria-label="Send update"
                        disabled
                    >

                        <i class="bi bi-send-fill"></i>

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>



<!-- =========================================================
     CSS
========================================================= -->

<style>

/* =========================================================
   NAMESPACE
========================================================= */

.farm-post-composer,
