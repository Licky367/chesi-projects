}


.post-fields {

    width: 100%;
    max-width: 700px;
    margin: 0 auto;

}



/* =========================================================
   TARGET SECTION
========================================================= */

.post-target-section {

    width: 100%;
    margin-bottom: 24px;
    padding: 15px;
    border: 1px solid #e1ebe4;
    border-radius: 15px;
    background: #f7faf8;

}


.post-section-label {

    display: flex;
    align-items: center;
