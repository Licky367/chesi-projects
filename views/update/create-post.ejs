    }


    .composer-icon-button {

        width: 40px;
        height: 40px;
        flex-basis: 40px;
        font-size: 22px;

    }


    .composer-send-button {

        width: 40px;
        height: 40px;
        flex-basis: 40px;
        font-size: 19px;

    }

