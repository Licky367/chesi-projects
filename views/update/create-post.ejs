<!-- =========================================================
     CREATE POST + FULL SCREEN POST MODAL
========================================================= -->

<link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
>


<!-- =========================================================
     CREATE POST CARD
========================================================= -->

<section class="create-post-card">

    <div class="create-post-header">

        <div class="create-post-avatar">

            <img
                src="<%= user.profileImage || ('https://ui-avatars.com/api/?name=' + encodeURIComponent(user.name)) %>"
                alt="<%= user.name %>"
                class="avatar-sm"
            >

        </div>


        <div class="create-post-heading">

            <% if (Number(dairy.code) < 0) { %>

                <div class="heading-line">

                    <strong>
                        <%= user.name.split(" ")[0] %>
                    </strong>

                    , update us about the overall conditions of this dairy Farm.

                </div>

            <% } else { %>

                <div class="heading-line">

                    <strong>
                        <%= user.name.split(" ")[0] %>
                    </strong>

                    , update us about

                </div>

                <div class="heading-line">

                    <strong>
                        <%= dairy.name %>
                    </strong>

                </div>

            <% } %>

        </div>

    </div>


    <!-- =====================================================
         COMPOSER TRIGGER
    ====================================================== -->

    <div
        id="openPostComposer"
        class="composer-trigger"
        role="button"
        tabindex="0"
        aria-label="Create post"
    >

        <span>
            Share an update...
        </span>

    </div>

</section>



<!-- =========================================================
     FULL SCREEN POST MODAL
========================================================= -->

<div
    id="postModal"
    class="post-modal"
    aria-hidden="true"
>

    <div class="post-modal-content">


        <!-- =================================================
             HEADER
        ================================================== -->

        <header class="post-modal-header">

            <button
                type="button"
                id="closePostModal"
                class="post-back-button"
                aria-label="Go back"
            >

                <i class="bi bi-arrow-left"></i>

            </button>


            <div class="post-modal-title">

                <strong>
                    New Update
                </strong>

                <span>
                    <%= dairy.name %>
                </span>

            </div>


            <div class="post-header-spacer"></div>

        </header>



        <!-- =================================================
             BODY
        ================================================== -->

        <main class="post-modal-body">

            <div class="post-fields">


                <!-- =========================================
                     POST TITLE
                ========================================== -->

                <div class="post-title-wrapper">

                    <input
                        type="text"
                        id="postTitle"
                        name="title"
                        maxlength="200"
                        placeholder="Post title"
                        aria-label="Post title"
                    >

                </div>


                <!-- =========================================
                     IMAGE PREVIEWS
                ========================================== -->

                <div
                    id="imagePreviewContainer"
                    class="image-preview-container"
                    hidden
                >

                    <div
                        id="imagePreviewGrid"
                        class="image-preview-grid"
                    ></div>

                </div>

            </div>

        </main>



        <!-- =================================================
             BOTTOM COMPOSER
        ================================================== -->

        <div class="post-composer-wrapper">

            <form
                id="postForm"
                action="/dairy/<%= dairy._id %>/post"
                method="POST"
                enctype="multipart/form-data"
                class="post-form"
            >

                <!-- Hidden title field.
                     JavaScript keeps this synchronized
                     with the title input above. -->

                <input
                    type="hidden"
                    id="postTitleHidden"
                    name="title"
                    value=""
                >


                <!-- =========================================
                     COMPOSER
                ========================================== -->

                <div class="post-composer">


                    <!-- =====================================
                         MULTIPLE IMAGE ATTACHMENT
                    ====================================== -->

                    <label
                        for="postImages"
                        class="composer-icon-button attachment-button"
                        aria-label="Attach images"
                        title="Attach images"
                    >

                        <i class="bi bi-paperclip"></i>

                    </label>


                    <input
                        type="file"
                        id="postImages"
                        name="images"
                        accept="image/jpeg,image/jpg,image/png,image/webp"
                        multiple
                        hidden
                    >


                    <!-- =====================================
                         TEXT
                    ====================================== -->

                    <div class="composer-input-area">

                        <textarea
                            id="postText"
                            name="text"
                            maxlength="1000"
                            rows="1"
                            placeholder="Type your update..."
                            aria-label="Type your update"
                        ></textarea>


                        <span
                            id="characterCounter"
                            class="character-counter"
                        >
                            0/1000
                        </span>

                    </div>


                    <!-- =====================================
                         SEND
                    ====================================== -->

                    <button
                        type="submit"
                        id="submitPostButton"
                        class="composer-send-button"
                        aria-label="Send update"
                        disabled
                    >

                        <i class="bi bi-send-fill"></i>

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>



<style>

/* =========================================================
   CREATE POST CARD
========================================================= */

.create-post-card {

    width: 100%;

    background: #ffffff;

    border-radius: 16px;

    padding: 16px;

    margin-bottom: 16px;

    box-sizing: border-box;

    border: 1px solid #e7eee9;

}


.create-post-header {

    display: flex;

    align-items: center;

    gap: 12px;

}


.create-post-avatar {

    flex-shrink: 0;

}


.avatar-sm {

    width: 44px;

    height: 44px;

    border-radius: 50%;

    object-fit: cover;

    display: block;

}


.create-post-heading {

    min-width: 0;

    font-size: 14px;

    line-height: 1.5;

    color: #555;

}


.heading-line {

    display: block;

}


.create-post-heading strong {

    color: #222;

}


.composer-trigger {

    margin-top: 14px;

    min-height: 48px;

    padding: 0 16px;

    border: 1px solid #dfe8e2;

    border-radius: 24px;

    display: flex;

    align-items: center;

    color: #888;

    background: #f8faf8;

    cursor: pointer;

    transition:
        background 0.2s ease,
        border-color 0.2s ease,
        transform 0.15s ease;

}


.composer-trigger:hover {

    background: #f1f7f3;

    border-color: #2e8b57;

}


.composer-trigger:active {

    transform: scale(0.99);

}



/* =========================================================
   FULL SCREEN MODAL
========================================================= */

.post-modal {

    position: fixed;

    inset: 0;

    width: 100vw;

    height: 100dvh;

    background: #ffffff;

    z-index: 99999;

    display: none;

    overflow: hidden;

}


.post-modal.active {

    display: block;

}


.post-modal-content {

    position: relative;

    width: 100%;

    height: 100%;

    display: flex;

    flex-direction: column;

    background: #ffffff;

}



/* =========================================================
   HEADER
========================================================= */

.post-modal-header {

    flex: 0 0 auto;

    height: 64px;

    width: 100%;

    display: flex;

    align-items: center;

    padding: 0 16px;

    box-sizing: border-box;

    border-bottom: 1px solid #e8eee9;

    background: #ffffff;

}


.post-back-button {

    width: 44px;

    height: 44px;

    border: none;

    background: transparent;

    color: #198754;

    display: flex;

    align-items: center;

    justify-content: center;

    cursor: pointer;

    font-size: 27px;

    padding: 0;

    flex-shrink: 0;

}


.post-modal-title {

    margin-left: 8px;

    display: flex;

    flex-direction: column;

    line-height: 1.25;

}


.post-modal-title strong {

    font-size: 17px;

    color: #202520;

}


.post-modal-title span {

    margin-top: 2px;

    font-size: 12px;

    color: #7a817d;

}


.post-header-spacer {

    flex: 1;

}



/* =========================================================
   BODY
========================================================= */

.post-modal-body {

    flex: 1 1 auto;

    min-height: 0;

    overflow-y: auto;

    padding: 20px;

    box-sizing: border-box;

}


.post-fields {

    width: 100%;

    max-width: 700px;

    margin: 0 auto;

}



/* =========================================================
   TITLE
========================================================= */

.post-title-wrapper {

    width: 100%;

    margin-bottom: 18px;

}


#postTitle {

    width: 100%;

    box-sizing: border-box;

    border: none;

    outline: none;

    background: transparent;

    font-family: inherit;

    font-size: 24px;

    font-weight: 700;

    color: #202520;

    padding: 4px 0;

}


#postTitle::placeholder {

    color: #a0a6a2;

}



/* =========================================================
   IMAGE PREVIEW GRID
========================================================= */

.image-preview-container {

    width: 100%;

}


.image-preview-grid {

    width: 100%;

    display: grid;

    grid-template-columns:
        repeat(2, minmax(0, 1fr));

    gap: 10px;

}


.image-preview-item {

    position: relative;

    width: 100%;

    aspect-ratio: 1 / 1;

    overflow: hidden;

    border-radius: 12px;

    background: #f3f5f3;

}


.image-preview-item img {

    width: 100%;

    height: 100%;

    display: block;

    object-fit: cover;

}


.remove-preview-image {

    position: absolute;

    top: 7px;

    right: 7px;

    width: 32px;

    height: 32px;

    border: none;

    border-radius: 50%;

    background: rgba(0, 0, 0, 0.65);

    color: #ffffff;

    display: flex;

    align-items: center;

    justify-content: center;

    cursor: pointer;

}



/* =========================================================
   BOTTOM COMPOSER
========================================================= */

.post-composer-wrapper {

    flex: 0 0 auto;

    width: 100%;

    padding:
        10px
        12px
        calc(10px + env(safe-area-inset-bottom));

    box-sizing: border-box;

    background: #ffffff;

    border-top: 1px solid #e8eee9;

}


.post-form {

    width: 100%;

    margin: 0;

}


.post-composer {

    width: 100%;

    min-height: 50px;

    display: flex;

    align-items: flex-end;

    gap: 8px;

    padding: 5px 7px;

    box-sizing: border-box;

    border: 1px solid #dce6df;

    border-radius: 28px;

    background: #f7faf8;

}



/* =========================================================
   ATTACHMENT
========================================================= */

.composer-icon-button {

    flex: 0 0 42px;

    width: 42px;

    height: 42px;

    border: none;

    background: transparent;

    color: #198754;

    display: flex;

    align-items: center;

    justify-content: center;

    cursor: pointer;

    font-size: 23px;

    padding: 0;

}


.attachment-button i {

    display: block;

    transform: rotate(-20deg);

}



/* =========================================================
   TEXT
========================================================= */

.composer-input-area {

    position: relative;

    flex: 1;

    min-width: 0;

    display: flex;

    align-items: flex-end;

}


#postText {

    width: 100%;

    min-height: 40px;

    max-height: 120px;

    resize: none;

    overflow-y: auto;

    border: none;

    outline: none;

    background: transparent;

    padding:
        10px
        4px
        5px;

    margin: 0;

    box-sizing: border-box;

    font-family: inherit;

    font-size: 15px;

    line-height: 20px;

    color: #202520;

}


#postText::placeholder {

    color: #8b928d;

}



/* =========================================================
   CHARACTER COUNTER
========================================================= */

.character-counter {

    position: absolute;

    right: 5px;

    bottom: 1px;

    font-size: 10px;

    color: #8a928d;

    pointer-events: none;

    background: #f7faf8;

    padding-left: 3px;

}



/* =========================================================
   SEND
========================================================= */

.composer-send-button {

    flex: 0 0 42px;

    width: 42px;

    height: 42px;

    border: none;

    border-radius: 50%;

    background: transparent;

    color: #198754;

    display: flex;

    align-items: center;

    justify-content: center;

    cursor: pointer;

    font-size: 20px;

    padding: 0;

}


.composer-send-button:disabled {

    color: #b8c2bc;

    cursor: default;

}



/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 600px) {

    .post-modal-header {

        height: 60px;

        padding: 0 10px;

    }


    .post-modal-title strong {

        font-size: 16px;

    }


    .post-modal-body {

        padding: 14px;

    }


    #postTitle {

        font-size: 21px;

    }


    .image-preview-grid {

        grid-template-columns:
            repeat(2, minmax(0, 1fr));

        gap: 7px;

    }


    .post-composer-wrapper {

        padding:
            8px
            8px
            calc(8px + env(safe-area-inset-bottom));

    }


    .post-composer {

        min-height: 48px;

        gap: 4px;

        padding: 4px 5px;

    }


    .composer-icon-button {

        width: 40px;

        height: 40px;

        flex-basis: 40px;

        font-size: 22px;

    }


    .composer-send-button {

        width: 40px;

        height: 40px;

        flex-basis: 40px;

        font-size: 19px;

    }

}


@media (max-width: 380px) {

    .post-modal-title span {

        display: none;

    }


    .post-modal-body {

        padding: 10px;

    }


    .character-counter {

        font-size: 9px;

    }

}

</style>



<script>

(function () {

    "use strict";


    function initializePostModal() {

        const modal =
            document.getElementById("postModal");

        const openComposer =
            document.getElementById("openPostComposer");

        const closeButton =
            document.getElementById("closePostModal");

        const titleInput =
            document.getElementById("postTitle");

        const hiddenTitle =
            document.getElementById("postTitleHidden");

        const textarea =
            document.getElementById("postText");

        const imageInput =
            document.getElementById("postImages");

        const previewContainer =
            document.getElementById(
                "imagePreviewContainer"
            );

        const previewGrid =
            document.getElementById(
                "imagePreviewGrid"
            );

        const characterCounter =
            document.getElementById(
                "characterCounter"
            );

        const sendButton =
            document.getElementById(
                "submitPostButton"
            );

        const form =
            document.getElementById(
                "postForm"
            );


        if (
            !modal ||
            !openComposer ||
            !closeButton ||
            !titleInput ||
            !hiddenTitle ||
            !textarea ||
            !imageInput ||
            !previewContainer ||
            !previewGrid ||
            !characterCounter ||
            !sendButton ||
            !form
        ) {

            console.error(
                "Post modal initialization failed."
            );

            return;

        }


        // ==================================================
        // OPEN
        // ==================================================

        function openModal() {

            modal.classList.add(
                "active"
            );

            modal.setAttribute(
                "aria-hidden",
                "false"
            );

            document.body.style.overflow =
                "hidden";


            setTimeout(
                function () {

                    titleInput.focus();

                },
                100
            );

        }


        // ==================================================
        // CLOSE
        // ==================================================

        function closeModal() {

            modal.classList.remove(
                "active"
            );

            modal.setAttribute(
                "aria-hidden",
                "true"
            );

            document.body.style.overflow =
                "";

        }


        // ==================================================
        // CHARACTER COUNTER
        // ==================================================

        function updateCharacterCounter() {

            characterCounter.textContent =
                textarea.value.length +
                "/1000";

        }


        // ==================================================
        // SEND BUTTON
        // ==================================================

        function updateSendButton() {

            const hasTitle =
                titleInput.value.trim().length > 0;


            const hasText =
                textarea.value.trim().length > 0;


            const hasImages =
                imageInput.files &&
                imageInput.files.length > 0;


            sendButton.disabled =
                !(
                    hasTitle ||
                    hasText ||
                    hasImages
                );

        }


        // ==================================================
        // RESIZE TEXTAREA
        // ==================================================

        function resizeTextarea() {

            textarea.style.height =
                "auto";


            const height =
                Math.min(
                    textarea.scrollHeight,
                    120
                );


            textarea.style.height =
                height + "px";

        }


        // ==================================================
        // RENDER IMAGE PREVIEWS
        // ==================================================

        function renderPreviews() {

            previewGrid.innerHTML =
                "";


            const files =
                Array.from(
                    imageInput.files || []
                );


            if (!files.length) {

                previewContainer.hidden =
                    true;

                return;

            }


            previewContainer.hidden =
                false;


            files.forEach(
                function (file) {

                    if (
                        !file.type.startsWith(
                            "image/"
                        )
                    ) {

                        return;

                    }


                    const reader =
                        new FileReader();


                    reader.onload =
                        function (event) {

                            const item =
                                document.createElement(
                                    "div"
                                );


                            item.className =
                                "image-preview-item";


                            const image =
                                document.createElement(
                                    "img"
                                );


                            image.src =
                                event.target.result;


                            image.alt =
                                "Selected image";


                            item.appendChild(
                                image
                            );


                            previewGrid.appendChild(
                                item
                            );

                        };


                    reader.readAsDataURL(
                        file
                    );

                }
            );

        }


        // ==================================================
        // TITLE
        // ==================================================

        titleInput.addEventListener(
            "input",
            function () {

                hiddenTitle.value =
                    titleInput.value;

                updateSendButton();

            }
        );


        // ==================================================
        // TEXT
        // ==================================================

        textarea.addEventListener(
            "input",
            function () {

                updateCharacterCounter();

                resizeTextarea();

                updateSendButton();

            }
        );


        // ==================================================
        // OPEN
        // ==================================================

        openComposer.addEventListener(
            "click",
            openModal
        );


        openComposer.addEventListener(
            "keydown",
            function (event) {

                if (
                    event.key === "Enter" ||
                    event.key === " "
                ) {

                    event.preventDefault();

                    openModal();

                }

            }
        );


        // ==================================================
        // CLOSE
        // ==================================================

        closeButton.addEventListener(
            "click",
            closeModal
        );


        // ==================================================
        // ESCAPE
        // ==================================================

        document.addEventListener(
            "keydown",
            function (event) {

                if (
                    event.key === "Escape" &&
                    modal.classList.contains(
                        "active"
                    )
                ) {

                    closeModal();

                }

            }
        );


        // ==================================================
        // IMAGE SELECTION
        // ==================================================

        imageInput.addEventListener(
            "change",
            function () {

                renderPreviews();

                updateSendButton();

            }
        );


        // ==================================================
        // FORM SUBMIT
        // ==================================================

        form.addEventListener(
            "submit",
            function (event) {

                hiddenTitle.value =
                    titleInput.value.trim();


                const title =
                    titleInput.value.trim();


                const text =
                    textarea.value.trim();


                const hasImages =
                    imageInput.files &&
                    imageInput.files.length > 0;


                if (
                    !title &&
                    !text &&
                    !hasImages
                ) {

                    event.preventDefault();

                    return;

                }


                sendButton.disabled =
                    true;


                sendButton.innerHTML =
                    '<i class="bi bi-hourglass-split"></i>';

            }
        );


        // ==================================================
        // INITIAL STATE
        // ==================================================

        updateCharacterCounter();

        resizeTextarea();

        updateSendButton();

    }


    // ======================================================
    // DOM READY
    // ======================================================

    if (
        document.readyState === "loading"
    ) {

        document.addEventListener(
            "DOMContentLoaded",
            initializePostModal
        );

    } else {

        initializePostModal();

    }

})();

</script>