<!-- =========================================================
     CREATE POST + FULL SCREEN POST MODAL
     Aligned with updateController.createPost
========================================================= --><section class="create-post-card"><!-- =====================================================
     CREATE POST HEADER
====================================================== -->

<div class="create-post-header">

    <!-- USER AVATAR -->

    <div class="create-post-avatar">

        <img
            src="<%= user.profileImage || ('https://ui-avatars.com/api/?name=' + encodeURIComponent(user.name)) %>"
            alt="<%= user.name %>"
            class="avatar-sm"
        >

    </div>


    <!-- HEADING -->

    <div class="create-post-heading">

        <div class="heading-line">

            <strong>
                <%= user.name.split(" ")[0] %>
            </strong>

            , update us about

        </div>

        <div class="heading-line">

            <strong>
                <%= dairy.name %>
            </strong>

        </div>

    </div>

</div>


<!-- =====================================================
     CLICKABLE COMPOSER TRIGGER

     Clicking anywhere here opens the full-screen modal.
====================================================== -->

<div
    id="openPostComposer"
    class="composer-trigger"
    role="button"
    tabindex="0"
    aria-label="Create a new update"
>

    <span class="composer-placeholder">
        Share an update...
    </span>

</div>

</section><!-- =========================================================
     FULL SCREEN POST MODAL
========================================================= --><div
    id="postModal"
    class="post-modal"
    aria-hidden="true"
><div class="post-modal-screen">

    <!-- =================================================
         MODAL HEADER
    ================================================== -->

    <header class="post-modal-header">

        <!-- BACK BUTTON -->

        <button
            type="button"
            id="closePostModal"
            class="post-back-button"
            aria-label="Go back"
        >

            <i class="bi bi-arrow-left"></i>

        </button>


        <!-- TITLE -->

        <div class="post-modal-title">

            <strong>New Update</strong>

            <span>
                <%= dairy.name %>
            </span>

        </div>


        <!-- RIGHT SIDE SPACER -->

        <div class="post-header-spacer"></div>

    </header>



    <!-- =================================================
         FORM

         Controller expects:

         req.params.id
         req.body.text
         req.file
    ================================================== -->

    <form
        id="postForm"
        action="/dairy/<%= dairy._id %>/post"
        method="POST"
        enctype="multipart/form-data"
        class="post-form"
    >


        <!-- =================================================
             POST BODY
        ================================================== -->

        <main class="post-modal-body">


            <!-- USER INFORMATION -->

            <div class="post-author">

                <img
                    src="<%= user.profileImage || ('https://ui-avatars.com/api/?name=' + encodeURIComponent(user.name)) %>"
                    alt="<%= user.name %>"
                    class="post-author-image"
                >

                <div class="post-author-info">

                    <strong>
                        <%= user.name %>
                    </strong>

                    <span>
                        Update about <%= dairy.name %>
                    </span>

                </div>

            </div>



            <!-- =================================================
                 IMAGE PREVIEW
            ================================================== -->

            <div
                id="imagePreviewContainer"
                class="image-preview-container"
                hidden
            >

                <div class="image-preview-wrapper">

                    <img
                        id="imagePreview"
                        src=""
                        alt="Selected image"
                        class="image-preview"
                    >


                    <button
                        type="button"
                        id="removeImage"
                        class="remove-image-button"
                        aria-label="Remove image"
                    >

                        <i class="bi bi-x-lg"></i>

                    </button>

                </div>

                <div
                    id="selectedImageName"
                    class="selected-image-name"
                ></div>

            </div>



            <!-- =================================================
                 HIDDEN IMAGE INPUT

                 The 📎 button below activates this.
            ================================================== -->

            <input
                type="file"
                id="postImage"
                name="image"
                accept="image/*"
                hidden
            >


        </main>



        <!-- =================================================
             WHATSAPP / SMS STYLE COMPOSER
        ================================================== -->

        <div class="post-composer-area">

            <div class="post-composer">

                <!-- =================================================
                     ATTACHMENT BUTTON
                ================================================== -->

                <button
                    type="button"
                    id="openImagePicker"
                    class="composer-icon-button attachment-button"
                    aria-label="Attach image"
                >

                    <i class="bi bi-paperclip"></i>

                </button>



                <!-- =================================================
                     TEXT INPUT AREA

                     Visually:

                     📎 [ Type your update... 0/1000 ] [ ➤ ]
                ================================================== -->

                <div class="composer-input-wrapper">

                    <textarea
                        id="postText"
                        name="text"
                        maxlength="1000"
                        rows="1"
                        placeholder="Type your update..."
                        aria-label="Type your update"
                    ></textarea>


                    <!-- CHARACTER COUNTER -->

                    <span
                        id="characterCounter"
                        class="character-counter"
                    >
                        0/1000
                    </span>

                </div>



                <!-- =================================================
                     SEND BUTTON
                ================================================== -->

                <button
                    type="submit"
                    id="submitPostButton"
                    class="composer-send-button"
                    aria-label="Send update"
                    disabled
                >

                    <i class="bi bi-send-fill"></i>

                </button>

            </div>

        </div>

    </form>

</div>

</div><!-- =========================================================
     CSS
========================================================= --><style>

/* =========================================================
   CREATE POST CARD
========================================================= */

.create-post-card {

    width: 100%;
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 18px;
    padding: 16px;
    box-sizing: border-box;

}


.create-post-header {

    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 14px;

}


.create-post-avatar {

    flex: 0 0 auto;

}


.avatar-sm {

    width: 46px;
    height: 46px;
    border-radius: 50%;
    object-fit: cover;
    display: block;

}


.create-post-heading {

    min-width: 0;
    color: #374151;
    line-height: 1.35;

}


.heading-line {

    font-size: 14px;

}


.heading-line strong {

    color: #111827;

}



/* =========================================================
   CLICKABLE COMPOSER
========================================================= */

.composer-trigger {

    width: 100%;
    min-height: 48px;

    display: flex;
    align-items: center;

    padding: 0 16px;

    box-sizing: border-box;

    background: #f3f4f6;

    border: 1px solid #e5e7eb;

    border-radius: 24px;

    cursor: pointer;

    transition:
        background 0.2s ease,
        border-color 0.2s ease,
        box-shadow 0.2s ease;

}


.composer-trigger:hover {

    background: #eefbf3;
    border-color: #9bd5ad;

}


.composer-trigger:focus {

    outline: none;

    border-color: #16a34a;

    box-shadow:
        0 0 0 3px rgba(22, 163, 74, 0.12);

}


.composer-placeholder {

    color: #6b7280;
    font-size: 15px;

}



/* =========================================================
   FULL SCREEN MODAL
========================================================= */

.post-modal {

    position: fixed;

    inset: 0;

    width: 100vw;
    height: 100dvh;

    background: #ffffff;

    z-index: 99999;

    visibility: hidden;
    opacity: 0;

    pointer-events: none;

    transition:
        opacity 0.2s ease,
        visibility 0.2s ease;

}


.post-modal.active {

    visibility: visible;
    opacity: 1;

    pointer-events: auto;

}


/* =========================================================
   MODAL SCREEN
========================================================= */

.post-modal-screen {

    width: 100%;
    height: 100%;

    display: flex;
    flex-direction: column;

    background: #ffffff;

    overflow: hidden;

}



/* =========================================================
   MODAL HEADER
========================================================= */

.post-modal-header {

    flex: 0 0 auto;

    width: 100%;
    height: 64px;

    display: flex;
    align-items: center;

    padding:
        0 16px;

    box-sizing: border-box;

    background: #ffffff;

    border-bottom: 1px solid #e5e7eb;

    box-shadow:
        0 1px 4px rgba(0, 0, 0, 0.04);

}


.post-back-button {

    width: 44px;
    height: 44px;

    display: flex;
    align-items: center;
    justify-content: center;

    flex: 0 0 44px;

    border: none;
    outline: none;

    background: transparent;

    color: #16a34a;

    font-size: 25px;

    border-radius: 50%;

    cursor: pointer;

    -webkit-tap-highlight-color: transparent;

}


.post-back-button:hover {

    background: #f0fdf4;

}


.post-back-button:active {

    background: #dcfce7;

    transform: scale(0.94);

}


.post-modal-title {

    flex: 1;

    min-width: 0;

    display: flex;
    flex-direction: column;

    justify-content: center;

    padding-left: 8px;

}


.post-modal-title strong {

    color: #111827;

    font-size: 17px;

    font-weight: 700;

}


.post-modal-title span {

    margin-top: 2px;

    color: #6b7280;

    font-size: 12px;

    white-space: nowrap;

    overflow: hidden;

    text-overflow: ellipsis;

}


.post-header-spacer {

    width: 44px;
    flex: 0 0 44px;

}



/* =========================================================
   FORM
========================================================= */

.post-form {

    width: 100%;
    height: calc(100% - 64px);

    display: flex;
    flex-direction: column;

    min-height: 0;

}



/* =========================================================
   MODAL BODY
========================================================= */

.post-modal-body {

    flex: 1;

    min-height: 0;

    overflow-y: auto;

    padding: 20px 18px 24px;

    box-sizing: border-box;

    background: #ffffff;

}



/* =========================================================
   AUTHOR
========================================================= */

.post-author {

    display: flex;
    align-items: center;

    gap: 12px;

    margin-bottom: 18px;

}


.post-author-image {

    width: 44px;
    height: 44px;

    border-radius: 50%;

    object-fit: cover;

    flex: 0 0 auto;

}


.post-author-info {

    display: flex;
    flex-direction: column;

    min-width: 0;

}


.post-author-info strong {

    color: #111827;

    font-size: 15px;

}


.post-author-info span {

    margin-top: 2px;

    color: #6b7280;

    font-size: 12px;

}



/* =========================================================
   IMAGE PREVIEW
========================================================= */

.image-preview-container {

    width: 100%;

    margin-bottom: 16px;

}


.image-preview-wrapper {

    position: relative;

    width: 100%;

    max-width: 600px;

    border-radius: 16px;

    overflow: hidden;

    background: #f3f4f6;

}


.image-preview {

    display: block;

    width: 100%;

    max-height: 420px;

    object-fit: contain;

    background: #f3f4f6;

}


.remove-image-button {

    position: absolute;

    top: 10px;
    right: 10px;

    width: 38px;
    height: 38px;

    display: flex;
    align-items: center;
    justify-content: center;

    border: none;

    border-radius: 50%;

    background: rgba(0, 0, 0, 0.68);

    color: #ffffff;

    font-size: 16px;

    cursor: pointer;

}


.remove-image-button:hover {

    background: rgba(0, 0, 0, 0.82);

}


.selected-image-name {

    margin-top: 7px;

    color: #6b7280;

    font-size: 12px;

    overflow: hidden;

    white-space: nowrap;

    text-overflow: ellipsis;

}



/* =========================================================
   BOTTOM COMPOSER AREA
========================================================= */

.post-composer-area {

    flex: 0 0 auto;

    width: 100%;

    padding:
        10px 12px
        calc(10px + env(safe-area-inset-bottom))
        12px;

    box-sizing: border-box;

    background: #ffffff;

    border-top: 1px solid #e5e7eb;

}



/* =========================================================
   WHATSAPP STYLE COMPOSER
========================================================= */

.post-composer {

    width: 100%;

    display: flex;
    align-items: flex-end;

    gap: 8px;

}



/* =========================================================
   ATTACHMENT BUTTON
========================================================= */

.composer-icon-button {

    width: 46px;
    height: 46px;

    flex: 0 0 46px;

    display: flex;
    align-items: center;
    justify-content: center;

    border: none;

    background: #f0fdf4;

    color: #16a34a;

    border-radius: 50%;

    font-size: 22px;

    cursor: pointer;

    -webkit-tap-highlight-color: transparent;

    transition:
        background 0.2s ease,
        transform 0.15s ease;

}


.composer-icon-button:hover {

    background: #dcfce7;

}


.composer-icon-button:active {

    transform: scale(0.92);

}



/* =========================================================
   TEXT INPUT WRAPPER

   This creates:

   [ Type your update...     0/1000 ]
========================================================= */

.composer-input-wrapper {

    position: relative;

    flex: 1;

    min-width: 0;

    min-height: 46px;

    display: flex;
    align-items: center;

    background: #f3f4f6;

    border: 1px solid #e5e7eb;

    border-radius: 24px;

    box-sizing: border-box;

    transition:
        border-color 0.2s ease,
        background 0.2s ease,
        box-shadow 0.2s ease;

}


.composer-input-wrapper:focus-within {

    background: #ffffff;

    border-color: #16a34a;

    box-shadow:
        0 0 0 3px rgba(22, 163, 74, 0.10);

}



/* =========================================================
   TEXTAREA
========================================================= */

#postText {

    width: 100%;

    min-height: 44px;
    max-height: 120px;

    resize: none;

    border: none;
    outline: none;

    background: transparent;

    box-sizing: border-box;

    padding:
        12px 54px 12px 16px;

    color: #111827;

    font-family: inherit;

    font-size: 15px;

    line-height: 20px;

    overflow-y: auto;

}


#postText::placeholder {

    color: #9ca3af;

}


#postText::-webkit-scrollbar {

    width: 3px;

}


#postText::-webkit-scrollbar-thumb {

    background: #cbd5e1;

    border-radius: 10px;

}



/* =========================================================
   CHARACTER COUNTER
========================================================= */

.character-counter {

    position: absolute;

    right: 14px;
    bottom: 8px;

    color: #9ca3af;

    font-size: 10px;

    line-height: 12px;

    pointer-events: none;

    user-select: none;

}


.character-counter.warning {

    color: #d97706;

}


.character-counter.limit {

    color: #dc2626;

}



/* =========================================================
   SEND BUTTON

   WhatsApp-style circular green button.
========================================================= */

.composer-send-button {

    width: 46px;
    height: 46px;

    flex: 0 0 46px;

    display: flex;
    align-items: center;
    justify-content: center;

    border: none;

    border-radius: 50%;

    background: #16a34a;

    color: #ffffff;

    font-size: 18px;

    cursor: pointer;

    box-shadow:
        0 3px 8px rgba(22, 163, 74, 0.25);

    transition:
        background 0.2s ease,
        transform 0.15s ease,
        opacity 0.2s ease;

    -webkit-tap-highlight-color: transparent;

}


.composer-send-button:hover:not(:disabled) {

    background: #15803d;

}


.composer-send-button:active:not(:disabled) {

    transform: scale(0.91);

}


.composer-send-button:disabled {

    background: #d1d5db;

    color: #ffffff;

    cursor: not-allowed;

    box-shadow: none;

    opacity: 0.75;

}



/* =========================================================
   SUBMITTING STATE
========================================================= */

.composer-send-button.submitting {

    pointer-events: none;

}


.composer-send-button.submitting i {

    animation:
        sendSpin 0.8s linear infinite;

}


@keyframes sendSpin {

    from {
        transform: rotate(0deg);
    }

    to {
        transform: rotate(360deg);
    }

}



/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 600px) {

    .create-post-card {

        border-radius: 14px;

        padding: 14px;

    }


    .post-modal-header {

        height: 60px;

        padding: 0 10px;

    }


    .post-form {

        height: calc(100% - 60px);

    }


    .post-modal-body {

        padding:
            16px 14px 20px;

    }


    .post-composer-area {

        padding:
            8px 8px
            calc(8px + env(safe-area-inset-bottom))
            8px;

    }


    .post-composer {

        gap: 6px;

    }


    .composer-icon-button,
    .composer-send-button {

        width: 44px;
        height: 44px;

        flex-basis: 44px;

    }


    #postText {

        font-size: 15px;

        padding-left: 14px;
        padding-right: 50px;

    }

}



/* =========================================================
   VERY SMALL PHONES
========================================================= */

@media (max-width: 360px) {

    .composer-icon-button,
    .composer-send-button {

        width: 42px;
        height: 42px;

        flex-basis: 42px;

    }


    .composer-input-wrapper {

        min-height: 42px;

    }


    #postText {

        min-height: 40px;

        padding:
            10px 48px 10px 13px;

    }

}

</style><!-- =========================================================
     JAVASCRIPT
========================================================= --><script>

(function () {

    "use strict";


    /* =====================================================
       INITIALIZE
    ====================================================== */

    function initializePostModal() {

        const modal =
            document.getElementById("postModal");

        const openComposer =
            document.getElementById("openPostComposer");

        const closeButton =
            document.getElementById("closePostModal");

        const imageButton =
            document.getElementById("openImagePicker");

        const imageInput =
            document.getElementById("postImage");

        const imagePreviewContainer =
            document.getElementById("imagePreviewContainer");

        const imagePreview =
            document.getElementById("imagePreview");

        const removeImage =
            document.getElementById("removeImage");

        const selectedImageName =
            document.getElementById("selectedImageName");

        const textarea =
            document.getElementById("postText");

        const counter =
            document.getElementById("characterCounter");

        const sendButton =
            document.getElementById("submitPostButton");

        const form =
            document.getElementById("postForm");


        /* =================================================
           ELEMENT CHECK
        ================================================= */

        if (
            !modal ||
            !openComposer ||
            !closeButton ||
            !imageButton ||
            !imageInput ||
            !textarea ||
            !counter ||
            !sendButton ||
            !form
        ) {

            console.warn(
                "Post modal: required element missing."
            );

            return;

        }


        /* =================================================
           OPEN MODAL
        ================================================= */

        function openModal() {

            modal.classList.add("active");

            modal.setAttribute(
                "aria-hidden",
                "false"
            );

            document.body.style.overflow = "hidden";

            updateComposer();

            setTimeout(function () {

                textarea.focus();

            }, 150);

        }


        /* =================================================
           CLOSE MODAL
        ================================================= */

        function closeModal() {

            modal.classList.remove("active");

            modal.setAttribute(
                "aria-hidden",
                "true"
            );

            document.body.style.overflow = "";

        }


        /* =================================================
           CHARACTER COUNTER
        ================================================= */

        function updateCounter() {

            const length =
                textarea.value.length;

            counter.textContent =
                length + "/1000";


            counter.classList.remove(
                "warning",
                "limit"
            );


            if (length >= 950) {

                counter.classList.add(
                    "warning"
                );

            }


            if (length >= 1000) {

                counter.classList.remove(
                    "warning"
                );

                counter.classList.add(
                    "limit"
                );

            }

        }


        /* =================================================
           AUTO RESIZE TEXTAREA
        ================================================= */

        function resizeTextarea() {

            textarea.style.height = "auto";

            const newHeight =
                Math.min(
                    textarea.scrollHeight,
                    120
                );

            textarea.style.height =
                newHeight + "px";

        }


        /* =================================================
           SEND BUTTON STATE
        ================================================= */

        function updateComposer() {

            const hasText =
                textarea.value.trim().length > 0;

            const hasImage =
                imageInput.files &&
                imageInput.files.length > 0;


            sendButton.disabled =
                !(hasText || hasImage);

            updateCounter();

            resizeTextarea();

        }


        /* =================================================
           OPEN COMPOSER
        ================================================= */

        openComposer.addEventListener(
            "click",
            function () {

                openModal();

            }
        );


        /* =================================================
           KEYBOARD OPEN
        ================================================= */

        openComposer.addEventListener(
            "keydown",
            function (event) {

                if (
                    event.key === "Enter" ||
                    event.key === " "
                ) {

                    event.preventDefault();

                    openModal();

                }

            }
        );


        /* =================================================
           BACK BUTTON
        ================================================= */

        closeButton.addEventListener(
            "click",
            function () {

                closeModal();

            }
        );


        /* =================================================
           ESCAPE
        ================================================= */

        document.addEventListener(
            "keydown",
            function (event) {

                if (
                    event.key === "Escape" &&
                    modal.classList.contains("active")
                ) {

                    closeModal();

                }

            }
        );


        /* =================================================
           ATTACH IMAGE
        ================================================= */

        imageButton.addEventListener(
            "click",
            function () {

                imageInput.click();

            }
        );


        /* =================================================
           IMAGE SELECTED
        ================================================= */

        imageInput.addEventListener(
            "change",
            function () {

                const file =
                    imageInput.files[0];

                if (!file) {

                    return;

                }


                /* Only allow images */

                if (
                    !file.type.startsWith("image/")
                ) {

                    imageInput.value = "";

                    alert(
                        "Please select an image file."
                    );

                    updateComposer();

                    return;

                }


                /* IMAGE PREVIEW */

                const reader =
                    new FileReader();


                reader.onload =
                    function (event) {

                        imagePreview.src =
                            event.target.result;

                        imagePreviewContainer.hidden =
                            false;

                        selectedImageName.textContent =
                            file.name;

                        updateComposer();

                    };


                reader.readAsDataURL(file);

            }
        );


        /* =================================================
           REMOVE IMAGE
        ================================================= */

        if (removeImage) {

            removeImage.addEventListener(
                "click",
                function () {

                    imageInput.value = "";

                    imagePreview.src = "";

                    imagePreviewContainer.hidden =
                        true;

                    selectedImageName.textContent =
                        "";

                    updateComposer();

                }
            );

        }


        /* =================================================
           TEXT INPUT
        ================================================= */

        textarea.addEventListener(
            "input",
            function () {

                updateComposer();

            }
        );


        /* =================================================
           PREVENT ENTER FROM SUBMITTING
        ================================================= */

        textarea.addEventListener(
            "keydown",
            function (event) {

                /*
                 * Enter normally creates a new line.
                 * Ctrl + Enter / Cmd + Enter sends.
                 */

                if (
                    event.key === "Enter" &&
                    (event.ctrlKey || event.metaKey)
                ) {

                    event.preventDefault();

                    if (!sendButton.disabled) {

                        form.requestSubmit();

                    }

                }

            }
        );


        /* =================================================
           FORM SUBMIT
        ================================================= */

        form.addEventListener(
            "submit",
            function (event) {

                const hasText =
                    textarea.value.trim().length > 0;

                const hasImage =
                    imageInput.files &&
                    imageInput.files.length > 0;


                if (!hasText && !hasImage) {

                    event.preventDefault();

                    return;

                }


                /*
                 * Prevent double submission.
                 */

                sendButton.disabled =
                    true;

                sendButton.classList.add(
                    "submitting"
                );


                sendButton.innerHTML =
                    '<i class="bi bi-arrow-repeat"></i>';

            }
        );


        /* =================================================
           CLICK BACKDROP

           Since this is full-screen, clicking the white
           background does not accidentally close the modal.
        ================================================== */

        modal.addEventListener(
            "click",
            function (event) {

                if (
                    event.target === modal
                ) {

                    closeModal();

                }

            }
        );


        /* =================================================
           INITIAL STATE
        ================================================= */

        updateComposer();

    }


    /* =====================================================
       START

       This works whether this EJS is loaded before or
       after DOMContentLoaded.
    ====================================================== */

    if (
        document.readyState === "loading"
    ) {

        document.addEventListener(
            "DOMContentLoaded",
            initializePostModal
        );

    } else {

        initializePostModal();

    }

})();

</script>