    height: 42px;

    flex: 0 0 42px;

    display: flex;
    align-items: center;
    justify-content: center;

    border: none;
    border-radius: 50%;

    background: transparent;

    color: #198754;

    cursor: pointer;

    font-size: 20px;

}


.farm-post-send-button:disabled {

    color: #b8c2bc;

    cursor: default;

}



/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 600px) {

    .farm-post-composer {

        padding: 13px;

    }


    .farm-post-composer__asset-card {

        flex-basis: 108px;

        width: 108px;
        height: 150px;

    }


    .farm-post-modal__header {

        height: 60px;

    }


    .farm-post-modal__body {

