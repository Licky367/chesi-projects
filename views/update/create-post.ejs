}


#farmPostTitle::placeholder {

    color: #a0a6a2;

}



/* =========================================================
   IMAGE PREVIEW
========================================================= */

.farm-image-preview-container {

    width: 100%;

}


.farm-image-preview-grid {

    width: 100%;

    display: grid;

    grid-template-columns:
