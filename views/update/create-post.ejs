<!-- =========================================================
     CREATE POST + FULL SCREEN POST MODAL
========================================================= --><style>

/* =========================================================
   PAGE COMPOSER
========================================================= */

.create-post-card {
    width: 100%;
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 18px;
    padding: 16px;
    margin-bottom: 20px;
    box-sizing: border-box;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.05);
}


.create-post-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 14px;
}


.create-post-avatar {
    width: 46px;
    height: 46px;
    min-width: 46px;
    border-radius: 50%;
    overflow: hidden;
    background: #e8f5e9;
}


.create-post-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}


.create-post-heading {
    color: #374151;
    font-size: 14px;
    line-height: 1.45;
}


.heading-line {
    display: block;
}


.create-post-heading strong {
    color: #111827;
    font-weight: 700;
}


/* =========================================================
   PAGE COMPOSER TRIGGER
   NO IMAGE ICON HERE
========================================================= */

.composer-trigger {
    width: 100%;
    min-height: 52px;

    border: 1px solid #d1d5db;
    border-radius: 15px;

    background: #f8faf9;

    display: flex;
    align-items: center;

    padding: 0 16px;

    box-sizing: border-box;

    cursor: pointer;

    transition:
        border-color 0.2s ease,
        background 0.2s ease,
        box-shadow 0.2s ease;
}


.composer-trigger:hover {
    background: #f3faf4;
    border-color: #78b67f;
}


.composer-trigger:focus {
    outline: none;
    border-color: #2e7d32;
    box-shadow: 0 0 0 3px rgba(46, 125, 50, 0.12);
}


.composer-placeholder {
    color: #6b7280;
    font-size: 14px;
}


/* =========================================================
   FULL SCREEN MODAL
========================================================= */

.post-modal {
    position: fixed;

    inset: 0;

    width: 100vw;
    height: 100dvh;

    background: #ffffff;

    z-index: 999999;

    display: flex;
    flex-direction: column;

    opacity: 0;
    visibility: hidden;
    pointer-events: none;

    transform: translateY(100%);

    transition:
        transform 0.28s ease,
        opacity 0.2s ease,
        visibility 0.28s ease;
}


.post-modal.active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;

    transform: translateY(0);
}


/* =========================================================
   MODAL CONTENT
========================================================= */

.post-modal-content {
    width: 100%;
    height: 100%;

    display: flex;
    flex-direction: column;

    background: #ffffff;
}


/* =========================================================
   MODAL HEADER
========================================================= */

.post-modal-header {
    height: 62px;
    min-height: 62px;

    display: flex;
    align-items: center;

    padding: 0 16px;

    border-bottom: 1px solid #e5e7eb;

    background: #ffffff;

    position: relative;

    z-index: 5;

    box-sizing: border-box;
}


/* =========================================================
   BACK BUTTON
========================================================= */

.close-modal-button {
    width: 44px;
    height: 44px;

    border: none;
    border-radius: 50%;

    background: transparent;

    color: #1f2937;

    display: flex;
    align-items: center;
    justify-content: center;

    cursor: pointer;

    font-size: 25px;

    flex-shrink: 0;

    transition:
        background 0.2s ease,
        color 0.2s ease,
        transform 0.15s ease;
}


.close-modal-button:hover {
    background: #f0fdf4;
    color: #2e7d32;
}


.close-modal-button:active {
    transform: scale(0.92);
}


.post-modal-header h3 {
    position: absolute;

    left: 50%;

    transform: translateX(-50%);

    margin: 0;

    font-size: 17px;

    font-weight: 700;

    color: #111827;

    white-space: nowrap;
}


/* =========================================================
   FORM
========================================================= */

#postForm {
    width: 100%;
    height: calc(100% - 62px);

    display: flex;
    flex-direction: column;

    min-height: 0;
}


/* =========================================================
   MESSAGE / TYPING AREA
========================================================= */

.post-editor {
    flex: 1;

    min-height: 0;

    padding: 20px 18px;

    overflow-y: auto;

    background: #ffffff;

    box-sizing: border-box;
}


#postText {
    width: 100%;
    height: 100%;

    min-height: 200px;

    border: none;
    outline: none;

    resize: none;

    background: transparent;

    color: #111827;

    font-family: inherit;

    font-size: 17px;

    line-height: 1.6;

    box-sizing: border-box;
}


#postText::placeholder {
    color: #9ca3af;
}


/* =========================================================
   IMAGE PREVIEW
========================================================= */

.image-preview-container {
    position: relative;

    margin: 0 14px 8px;

    max-width: 500px;

    max-height: 260px;

    border-radius: 16px;

    overflow: hidden;

    background: #f3f4f6;

    flex-shrink: 0;
}


.image-preview {
    display: block;

    width: 100%;

    max-height: 260px;

    object-fit: contain;

    background: #f3f4f6;
}


.remove-image-button {
    position: absolute;

    top: 9px;
    right: 9px;

    width: 36px;
    height: 36px;

    border: none;

    border-radius: 50%;

    background: rgba(0, 0, 0, 0.72);

    color: #ffffff;

    display: flex;
    align-items: center;
    justify-content: center;

    cursor: pointer;

    font-size: 15px;
}


/* =========================================================
   WHATSAPP / SMS STYLE COMPOSER BAR
========================================================= */

.composer-bar {
    width: 100%;

    display: flex;
    align-items: flex-end;

    gap: 8px;

    padding: 10px 12px;

    padding-bottom:
        calc(10px + env(safe-area-inset-bottom));

    background: #ffffff;

    border-top: 1px solid #e5e7eb;

    box-sizing: border-box;
}


/* =========================================================
   ATTACHMENT BUTTON
========================================================= */

.attachment-button {
    width: 44px;
    height: 44px;

    min-width: 44px;

    border-radius: 50%;

    display: flex;
    align-items: center;
    justify-content: center;

    color: #4b5563;

    background: transparent;

    cursor: pointer;

    font-size: 23px;

    transition:
        background 0.2s ease,
        color 0.2s ease,
        transform 0.15s ease;
}


.attachment-button:hover {
    background: #f3f4f6;
    color: #2e7d32;
}


.attachment-button:active {
    transform: scale(0.9);
}


/* =========================================================
   TEXT INPUT CONTAINER
========================================================= */

.message-input-wrapper {
    flex: 1;

    min-width: 0;

    min-height: 44px;

    max-height: 130px;

    display: flex;
    align-items: center;

    background: #f1f3f4;

    border-radius: 22px;

    padding: 0 16px;

    box-sizing: border-box;

    transition:
        background 0.2s ease,
        box-shadow 0.2s ease;
}


.message-input-wrapper:focus-within {
    background: #eef7ef;

    box-shadow:
        inset 0 0 0 1px rgba(46, 125, 50, 0.2);
}


#postText {
    height: auto;

    min-height: 44px;

    max-height: 120px;

    padding: 11px 0;

    overflow-y: auto;

    font-size: 16px;

    line-height: 1.4;
}


/* =========================================================
   CHARACTER COUNTER
========================================================= */

.character-counter {
    font-size: 11px;

    color: #9ca3af;

    white-space: nowrap;

    align-self: center;

    margin-right: 4px;
}


/* =========================================================
   SEND BUTTON
========================================================= */

.send-button {
    width: 46px;
    height: 46px;

    min-width: 46px;

    border: none;

    border-radius: 50%;

    background: #2e7d32;

    color: #ffffff;

    display: flex;
    align-items: center;
    justify-content: center;

    cursor: pointer;

    font-size: 19px;

    box-shadow:
        0 3px 8px rgba(46, 125, 50, 0.25);

    transition:
        background 0.2s ease,
        transform 0.15s ease,
        box-shadow 0.2s ease;
}


.send-button:hover:not(:disabled) {
    background: #256b2a;

    transform: scale(1.05);

    box-shadow:
        0 5px 12px rgba(46, 125, 50, 0.3);
}


.send-button:active:not(:disabled) {
    transform: scale(0.92);
}


.send-button:disabled {
    background: #d1d5db;

    color: #ffffff;

    box-shadow: none;

    cursor: not-allowed;
}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 600px) {

    .create-post-card {
        border-radius: 14px;
        padding: 13px;
    }


    .create-post-avatar {
        width: 42px;
        height: 42px;
        min-width: 42px;
    }


    .post-modal-header {
        height: 58px;
        min-height: 58px;
        padding: 0 10px;
    }


    #postForm {
        height: calc(100% - 58px);
    }


    .post-editor {
        padding: 16px 14px;
    }


    .composer-bar {
        gap: 5px;

        padding-left: 7px;
        padding-right: 7px;
    }


    .attachment-button {
        width: 42px;
        height: 42px;
        min-width: 42px;
    }


    .send-button {
        width: 44px;
        height: 44px;
        min-width: 44px;
    }


    .character-counter {
        display: none;
    }


    .message-input-wrapper {
        border-radius: 21px;
        padding: 0 14px;
    }


    #postText {
        font-size: 16px;
    }

}

</style><!-- =========================================================
     CREATE POST CARD
========================================================= --><section class="create-post-card"><div class="create-post-header">

    <div class="create-post-avatar">

        <img
            src="<%= user.profileImage || ('https://ui-avatars.com/api/?name=' + encodeURIComponent(user.name)) %>"
            alt="<%= user.name %>"
        >

    </div>


    <div class="create-post-heading">

        <div class="heading-line">

            <strong>
                <%= user.name.split(" ")[0] %>
            </strong>
            , update us about

        </div>


        <div class="heading-line">

            <strong>
                <%= dairy.name %>
            </strong>

        </div>

    </div>

</div>


<!-- =====================================================
     COMPOSER
     NO IMAGE ICON HERE
====================================================== -->

<div
    id="openPostComposer"
    class="composer-trigger"
    role="button"
    tabindex="0"
    aria-label="Create a new update"
>

    <span class="composer-placeholder">
        Share an update...
    </span>

</div>

</section><!-- =========================================================
     FULL SCREEN POST MODAL
========================================================= --><div
    id="postModal"
    class="post-modal"
    aria-hidden="true"
><div class="post-modal-content">

    <form
        id="postForm"
        action="/dairy/<%= dairy._id %>/post"
        method="POST"
        enctype="multipart/form-data"
    >

        <!-- =================================================
             HEADER
        ================================================== -->

        <div class="post-modal-header">

            <button
                type="button"
                id="closePostModal"
                class="close-modal-button"
                aria-label="Back"
            >

                <i class="bi bi-arrow-left"></i>

            </button>


            <h3>
                New Update
            </h3>

        </div>


        <!-- =================================================
             MAIN TYPING AREA
        ================================================== -->

        <div class="post-editor">

            <textarea
                id="postText"
                name="text"
                maxlength="1000"
                placeholder="<%= user.name.split(' ')[0] %>, type your update here..."
                aria-label="Write your update"
            ></textarea>

        </div>


        <!-- =================================================
             IMAGE PREVIEW
        ================================================== -->

        <div
            id="imagePreviewContainer"
            class="image-preview-container"
            style="display:none;"
        >

            <img
                id="imagePreview"
                class="image-preview"
                alt="Selected image preview"
            >


            <button
                type="button"
                id="removeImage"
                class="remove-image-button"
                aria-label="Remove image"
            >

                <i class="bi bi-x-lg"></i>

            </button>

        </div>


        <!-- =================================================
             WHATSAPP / SMS STYLE INPUT BAR
        ================================================== -->

        <div class="composer-bar">

            <!-- FILE / ATTACHMENT -->

            <label
                for="postImage"
                class="attachment-button"
                aria-label="Attach image"
            >

                <i class="bi bi-paperclip"></i>

            </label>


            <input
                type="file"
                id="postImage"
                name="image"
                accept="image/*"
                hidden
            >


            <!-- TEXT INPUT -->

            <div class="message-input-wrapper">

                <span
                    id="characterCounter"
                    class="character-counter"
                >
                    0/1000
                </span>

            </div>


            <!-- SEND -->

            <button
                type="submit"
                id="submitPostButton"
                class="send-button"
                aria-label="Send update"
                disabled
            >

                <i class="bi bi-send-fill"></i>

            </button>

        </div>

    </form>

</div>

</div><!-- =========================================================
     JAVASCRIPT
========================================================= --><script>

(function () {

    "use strict";


    function initializePostModal() {

        const modal =
            document.getElementById("postModal");

        const composer =
            document.getElementById("openPostComposer");

        const closeButton =
            document.getElementById("closePostModal");

        const form =
            document.getElementById("postForm");

        const textarea =
            document.getElementById("postText");

        const imageInput =
            document.getElementById("postImage");

        const previewContainer =
            document.getElementById("imagePreviewContainer");

        const preview =
            document.getElementById("imagePreview");

        const removeImage =
            document.getElementById("removeImage");

        const counter =
            document.getElementById("characterCounter");

        const sendButton =
            document.getElementById("submitPostButton");


        /* =====================================================
           SAFETY CHECK
        ====================================================== */

        if (
            !modal ||
            !composer ||
            !closeButton ||
            !form ||
            !textarea ||
            !imageInput ||
            !previewContainer ||
            !preview ||
            !removeImage ||
            !counter ||
            !sendButton
        ) {

            console.error(
                "Post modal: required element missing."
            );

            return;

        }


        /* =====================================================
           OPEN
        ====================================================== */

        function openModal() {

            modal.classList.add("active");

            modal.setAttribute(
                "aria-hidden",
                "false"
            );

            document.body.style.overflow =
                "hidden";


            setTimeout(function () {

                textarea.focus();

            }, 250);

        }


        /* =====================================================
           CLOSE
        ====================================================== */

        function closeModal() {

            modal.classList.remove("active");

            modal.setAttribute(
                "aria-hidden",
                "true"
            );

            document.body.style.overflow =
                "";

        }


        /* =====================================================
           UPDATE SEND BUTTON
        ====================================================== */

        function updateState() {

            const hasText =
                textarea.value.trim().length > 0;

            const hasImage =
                imageInput.files.length > 0;


            sendButton.disabled =
                !(hasText || hasImage);


            counter.textContent =
                textarea.value.length + "/1000";

        }


        /* =====================================================
           OPEN COMPOSER
        ====================================================== */

        composer.addEventListener(
            "click",
            openModal
        );


        composer.addEventListener(
            "keydown",
            function (event) {

                if (
                    event.key === "Enter" ||
                    event.key === " "
                ) {

                    event.preventDefault();

                    openModal();

                }

            }
        );


        /* =====================================================
           CLOSE
        ====================================================== */

        closeButton.addEventListener(
            "click",
            closeModal
        );


        /* =====================================================
           ESC
        ====================================================== */

        document.addEventListener(
            "keydown",
            function (event) {

                if (
                    event.key === "Escape" &&
                    modal.classList.contains("active")
                ) {

                    closeModal();

                }

            }
        );


        /* =====================================================
           TEXT
        ====================================================== */

        textarea.addEventListener(
            "input",
            function () {

                updateState();

            }
        );


        /* =====================================================
           IMAGE
        ====================================================== */

        imageInput.addEventListener(
            "change",
            function () {

                const file =
                    imageInput.files[0];


                if (!file) {

                    return;

                }


                const reader =
                    new FileReader();


                reader.onload =
                    function (event) {

                        preview.src =
                            event.target.result;

                        previewContainer.style.display =
                            "block";

                    };


                reader.readAsDataURL(file);


                updateState();

            }
        );


        /* =====================================================
           REMOVE IMAGE
        ====================================================== */

        removeImage.addEventListener(
            "click",
            function () {

                imageInput.value = "";

                preview.src = "";

                previewContainer.style.display =
                    "none";

                updateState();

                textarea.focus();

            }
        );


        /* =====================================================
           SUBMIT
        ====================================================== */

        form.addEventListener(
            "submit",
            function (event) {

                const hasText =
                    textarea.value.trim().length > 0;

                const hasImage =
                    imageInput.files.length > 0;


                if (
                    !hasText &&
                    !hasImage
                ) {

                    event.preventDefault();

                    return;

                }


                sendButton.disabled =
                    true;


                sendButton.innerHTML =
                    '<i class="bi bi-hourglass-split"></i>';

            }
        );


        /* =====================================================
           INITIAL STATE
        ====================================================== */

        updateState();


        console.log(
            "Post modal initialized."
        );

    }


    /* =========================================================
       DOM READY
    ========================================================= */

    if (
        document.readyState === "loading"
    ) {

        document.addEventListener(
            "DOMContentLoaded",
            initializePostModal
        );

    } else {

        initializePostModal();

    }

})();

</script>