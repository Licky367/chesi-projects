<!-- =========================================================
     CREATE POST + FULL SCREEN POST MODAL
========================================================= -->

<!-- Bootstrap Icons -->
<link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
>


<!-- =========================================================
     CREATE POST CARD
========================================================= -->

<section class="create-post-card">

    <div class="create-post-header">

        <!-- USER AVATAR -->
        <div class="create-post-avatar">

            <img
                src="<%= user.profileImage || ('https://ui-avatars.com/api/?name=' + encodeURIComponent(user.name)) %>"
                alt="<%= user.name %>"
                class="avatar-sm"
            >

        </div>


        <!-- HEADING -->
        <div class="create-post-heading">

            <% if (dairy.code < 0) { %>

                <div class="heading-line">

                    <strong>
                        <%= user.name.split(" ")[0] %>
                    </strong>

                    , update us about the overall conditions of this dairy Farm.

                </div>

            <% } else { %>

                <div class="heading-line">

                    <strong>
                        <%= user.name.split(" ")[0] %>
                    </strong>

                    , update us about

                </div>

                <div class="heading-line">

                    <strong>
                        <%= dairy.name %>
                    </strong>

                </div>

            <% } %>

        </div>

    </div>


    <!-- =====================================================
         CLICKABLE COMPOSER TRIGGER
    ====================================================== -->

    <div
        id="openPostComposer"
        class="composer-trigger"
        role="button"
        tabindex="0"
        aria-label="Create post"
    >

        <span>
            Share an update...
        </span>

    </div>

</section>



<!-- =========================================================
     FULL SCREEN POST MODAL
========================================================= -->

<div
    id="postModal"
    class="post-modal"
    aria-hidden="true"
>

    <div class="post-modal-content">


        <!-- =================================================
             MODAL HEADER
        ================================================== -->

        <header class="post-modal-header">

            <button
                type="button"
                id="closePostModal"
                class="post-back-button"
                aria-label="Go back"
            >

                <i class="bi bi-arrow-left"></i>

            </button>


            <div class="post-modal-title">

                <strong>
                    New Update
                </strong>

                <span>
                    <%= dairy.name %>
                </span>

            </div>


            <div class="post-header-spacer"></div>

        </header>



        <!-- =================================================
             POST BODY
        ================================================== -->

        <main class="post-modal-body">


            <!-- =================================================
                 POST TITLE
            ================================================== -->

            <div class="post-title-wrapper">

                <input
                    type="text"
                    id="postTitle"
                    name="title"
                    maxlength="150"
                    placeholder="Post title..."
                    aria-label="Post title"
                    autocomplete="off"
                >

                <div class="post-title-counter">

                    <span id="titleCharacterCounter">
                        0/150
                    </span>

                </div>

            </div>



            <!-- =================================================
                 IMAGE PREVIEW
            ================================================== -->

            <div
                id="imagePreviewContainer"
                class="image-preview-container"
                hidden
            >

                <div
                    id="imagePreviewGrid"
                    class="image-preview-grid"
                ></div>

            </div>


        </main>



        <!-- =================================================
             BOTTOM MESSAGE COMPOSER
        ================================================== -->

        <div class="post-composer-wrapper">

            <form
                id="postForm"
                action="/dairy/<%= dairy._id %>/post"
                method="POST"
                enctype="multipart/form-data"
                class="post-form"
            >


                <!-- =================================================
                     HIDDEN TITLE
                     -------------------------------------------------
                     The visible title input is outside the form
                     because the modal body and composer are separate.

                     JavaScript copies its value here before submit.
                ================================================== -->

                <input
                    type="hidden"
                    id="formPostTitle"
                    name="title"
                    value=""
                >


                <!-- =========================================
                     IMAGE INPUT
                ========================================== -->

                <input
                    type="file"
                    id="postImage"
                    name="images"
                    accept="image/*"
                    multiple
                    hidden
                >


                <!-- =========================================
                     MESSAGE COMPOSER
                ========================================== -->

                <div class="post-composer">


                    <!-- =====================================
                         ATTACHMENT
                    ====================================== -->

                    <label
                        for="postImage"
                        class="composer-icon-button attachment-button"
                        aria-label="Attach images"
                        title="Attach images"
                    >

                        <i class="bi bi-paperclip"></i>

                    </label>



                    <!-- =====================================
                         TEXT INPUT AREA
                    ====================================== -->

                    <div class="composer-input-area">

                        <textarea
                            id="postText"
                            name="text"
                            maxlength="1000"
                            rows="1"
                            placeholder="Type your update..."
                            aria-label="Type your update"
                        ></textarea>


                        <span
                            id="characterCounter"
                            class="character-counter"
                        >
                            0/1000
                        </span>

                    </div>



                    <!-- =====================================
                         SEND
                    ====================================== -->

                    <button
                        type="submit"
                        id="submitPostButton"
                        class="composer-send-button"
                        aria-label="Send update"
                        disabled
                    >

                        <i class="bi bi-send-fill"></i>

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>



<!-- =========================================================
     CSS
========================================================= -->

<style>

/* =========================================================
   CREATE POST CARD
========================================================= */

.create-post-card {

    width: 100%;

    background: #ffffff;

    border-radius: 16px;

    padding: 16px;

    margin-bottom: 16px;

    box-sizing: border-box;

    border: 1px solid #e7eee9;

}


.create-post-header {

    display: flex;

    align-items: center;

    gap: 12px;

}


.create-post-avatar {

    flex-shrink: 0;

}


.avatar-sm {

    width: 44px;

    height: 44px;

    border-radius: 50%;

    object-fit: cover;

    display: block;

}


.create-post-heading {

    min-width: 0;

    font-size: 14px;

    line-height: 1.5;

    color: #555;

}


.heading-line {

    display: block;

}


.create-post-heading strong {

    color: #222;

}


.composer-trigger {

    margin-top: 14px;

    min-height: 48px;

    padding: 0 16px;

    border: 1px solid #dfe8e2;

    border-radius: 24px;

    display: flex;

    align-items: center;

    color: #888;

    background: #f8faf8;

    cursor: pointer;

    transition:
        background 0.2s ease,
        border-color 0.2s ease,
        transform 0.15s ease;

}


.composer-trigger:hover {

    background: #f1f7f3;

    border-color: #2e8b57;

}


.composer-trigger:active {

    transform: scale(0.99);

}



/* =========================================================
   FULL SCREEN MODAL
========================================================= */

.post-modal {

    position: fixed;

    inset: 0;

    width: 100vw;

    height: 100dvh;

    background: #ffffff;

    z-index: 99999;

    display: none;

    overflow: hidden;

}


.post-modal.active {

    display: block;

}


.post-modal-content {

    position: relative;

    width: 100%;

    height: 100%;

    display: flex;

    flex-direction: column;

    background: #ffffff;

}



/* =========================================================
   HEADER
========================================================= */

.post-modal-header {

    flex: 0 0 auto;

    height: 64px;

    width: 100%;

    display: flex;

    align-items: center;

    padding: 0 16px;

    box-sizing: border-box;

    border-bottom: 1px solid #e8eee9;

    background: #ffffff;

}


.post-back-button {

    width: 44px;

    height: 44px;

    border: none;

    background: transparent;

    color: #198754;

    display: flex;

    align-items: center;

    justify-content: center;

    cursor: pointer;

    font-size: 27px;

    padding: 0;

    flex-shrink: 0;

}


.post-back-button i {

    display: block;

}


.post-back-button:hover {

    color: #146c43;

}


.post-modal-title {

    margin-left: 8px;

    display: flex;

    flex-direction: column;

    line-height: 1.25;

}


.post-modal-title strong {

    font-size: 17px;

    color: #202520;

