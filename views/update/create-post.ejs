}



/* =========================================================
   BODY
========================================================= */

.post-modal-body {

    flex: 1 1 auto;

    min-height: 0;

    overflow-y: auto;

    padding: 20px;

    box-sizing: border-box;

}



/* =========================================================
   POST TITLE
========================================================= */

.post-title-wrapper {

    position: relative;

    width: 100%;

    margin-bottom: 20px;

}


#postTitle {

    width: 100%;

    box-sizing: border-box;

    border: none;

    outline: none;

    background: transparent;

    padding: 6px 0 10px;

    margin: 0;

    font-family: inherit;

    font-size: 23px;

    font-weight: 700;

    color: #202520;

    border-bottom: 1px solid #e2e9e4;

}


#postTitle::placeholder {

    color: #a0a7a2;

    font-weight: 600;

}


#postTitle:focus {

    border-bottom-color: #198754;

}


.post-title-counter {

    display: flex;

    justify-content: flex-end;

    padding-top: 5px;

    font-size: 10px;

    color: #8a928d;

}



/* =========================================================
   IMAGE PREVIEW CONTAINER
========================================================= */

.image-preview-container {

    width: 100%;

}


.image-preview-grid {

    width: 100%;

    display: grid;

    grid-template-columns:
