    font-size: 12px;

}


.farm-post-composer__empty-icon {

    width: 34px;
    height: 34px;

    flex: 0 0 34px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 50%;

    background: #eef5f0;

    color: #198754;

}



/* =========================================================
   FULL SCREEN MODAL
========================================================= */

.farm-post-modal {

    position: fixed;

    inset: 0;

    width: 100vw;
    height: 100dvh;

    display: none;

    z-index: 99999;

    overflow: hidden;

    background: #ffffff;

}


.farm-post-modal.farm-post-modal--active {

    display: block;

}


.farm-post-modal__content {

    width: 100%;
    height: 100%;

    display: flex;
    flex-direction: column;

    background: #ffffff;

}



/* =========================================================
   MODAL HEADER
========================================================= */

.farm-post-modal__header {

    flex: 0 0 auto;

    height: 62px;

    display: flex;
    align-items: center;

    padding: 0 12px;

    border-bottom: 1px solid #e6ece8;

    background: #ffffff;

}


.farm-post-modal__back {

    width: 44px;
    height: 44px;

    flex: 0 0 44px;

    display: flex;
    align-items: center;
    justify-content: center;

    border: none;
    border-radius: 50%;

    background: transparent;

    color: #198754;

    font-size: 25px;

    cursor: pointer;

}


.farm-post-modal__back:active {

    background: #eef6f1;

}


.farm-post-modal__title {

    min-width: 0;

    margin-left: 7px;

    display: flex;
    flex-direction: column;

    line-height: 1.25;

}


.farm-post-modal__title strong {

    color: #202520;

    font-size: 17px;

}


.farm-post-modal__title span {

    max-width: 70vw;

    margin-top: 2px;

    overflow: hidden;

    white-space: nowrap;
    text-overflow: ellipsis;

    color: #7b847e;

    font-size: 12px;

}


.farm-post-modal__spacer {

    flex: 1;

}



/* =========================================================
   MODAL BODY
========================================================= */

.farm-post-modal__body {

    flex: 1 1 auto;

    min-height: 0;

    overflow-y: auto;

    padding: 18px;

}


.farm-post-modal__fields {

    width: 100%;

    max-width: 700px;

    margin: 0 auto;

}



/* =========================================================
   SELECTED ASSET
========================================================= */

.farm-selected-asset {

    width: 100%;

    display: flex;
    align-items: center;

    gap: 11px;

    padding: 10px;

    margin-bottom: 20px;

    border: 1px solid #dce8e0;
    border-radius: 13px;

