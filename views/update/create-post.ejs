}



/* =========================================================
   SEND
========================================================= */

.composer-send-button {

    width: 42px;
    height: 42px;
    flex: 0 0 42px;
    border: none;
    border-radius: 50%;
    background: transparent;
    color: #198754;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 20px;
    padding: 0;

}


.composer-send-button:disabled {

    color: #b8c2bc;
    cursor: default;

}



/* =========================================================
   MOBILE
========================================================= */

