}


.farm-post-form {

    width: 100%;

    margin: 0;

}


.farm-post-composer-bar {

    width: 100%;

    min-height: 50px;

    display: flex;
    align-items: flex-end;

    gap: 6px;

    padding: 4px 6px;

    border: 1px solid #dce6df;

    border-radius: 28px;

