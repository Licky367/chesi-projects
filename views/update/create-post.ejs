    font-size: 10px;

}


.farm-selected-asset__info strong {

    margin-top: 1px;

    overflow: hidden;

    color: #243029;

    font-size: 14px;

    white-space: nowrap;
    text-overflow: ellipsis;

}


.farm-selected-asset__info small {

    margin-top: 2px;

    color: #198754;

    font-size: 10px;

    font-weight: 700;

}


.farm-selected-asset__check {

    width: 28px;
    height: 28px;

    flex: 0 0 28px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 50%;

    background: #198754;

    color: #ffffff;

    font-size: 14px;

}



/* =========================================================
   TITLE
========================================================= */

.farm-post-title-wrapper {

    width: 100%;

    margin-bottom: 18px;

}


.farm-post-title-label {

    display: block;

    margin-bottom: 7px;

    color: #6d7771;

    font-size: 11px;

    font-weight: 700;

    text-transform: uppercase;

    letter-spacing: .04em;

}


#farmPostTitle {

    width: 100%;

    padding: 13px 14px;

    border: 1px solid #e0e7e2;
    border-radius: 12px;

    outline: none;

    background: #f8faf8;

    color: #202520;

    font-family: inherit;

    font-size: 20px;
    font-weight: 700;

}


#farmPostTitle:focus {

    border-color: #198754;

    background: #ffffff;

    box-shadow:
        0 0 0 3px
