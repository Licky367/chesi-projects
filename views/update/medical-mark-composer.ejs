<% /*
============================================================
MEDICAL MARK COMPOSER

FILE:
    views/update/medical-mark-composer.ejs

PURPOSE:
    Compact card for marking the CURRENT dairy asset for
    medical attention.

TARGET:
    The current dairy/asset is ALWAYS the target.

AUTHORIZED USERS:
    admin
    dairyWorker

FORM:
    POST /dairy/:id/medical-mark

CARD SIZE:
    Desktop: 112px × 155px
    Mobile:  108px × 150px
============================================================
*/ %>


<% if (
    dairy &&
    user &&
    (
        user.role === "admin" ||
        user.role === "dairyWorker"
    )
) { %>


<!-- =========================================================
     MEDICAL MARK CARD
========================================================= -->

<section
    class="medical-mark-composer"
    aria-label="Mark medical attention"
>


    <button
        type="button"
        id="openMedicalMarkComposer"
        class="medical-mark-composer__card"
        aria-label="Mark <%= dairy.name %> for medical attention"
    >


        <!-- =================================================
             ICON
        ================================================== -->

        <span
            class="medical-mark-composer__icon"
            aria-hidden="true"
        >
            +
        </span>


        <!-- =================================================
             LABEL
        ================================================== -->

        <span class="medical-mark-composer__label">
            Mark Medical
        </span>


        <!-- =================================================
             TARGET
        ================================================== -->

        <span class="medical-mark-composer__target">

            <%= dairy.name %>

        </span>


    </button>

</section>



<!-- =========================================================
     FULL-SCREEN MEDICAL MARK MODAL
========================================================= -->

<div
    id="medicalMarkModal"
    class="medical-mark-modal"
    aria-hidden="true"
>


    <div class="medical-mark-modal__content">


        <!-- =================================================
             MODAL HEADER
        ================================================== -->

        <header class="medical-mark-modal__header">


            <button
                type="button"
                id="closeMedicalMarkModal"
                class="medical-mark-modal__back"
                aria-label="Close medical attention form"
            >

                <span aria-hidden="true">
                    &#8592;
                </span>

            </button>


            <div class="medical-mark-modal__title">

                <strong>
                    Medical Attention
                </strong>

                <span>
                    <%= dairy.name %>
                </span>

            </div>


            <div
                class="medical-mark-modal__spacer"
                aria-hidden="true"
            ></div>


        </header>



        <!-- =================================================
             MODAL BODY
        ================================================== -->

        <main class="medical-mark-modal__body">


            <div class="medical-mark-modal__fields">


                <!-- =================================================
                     QUESTION
                ================================================== -->

                <div class="medical-mark-question">

                    <strong>
                        <%= user.name.split(" ")[0] %>
                    </strong>,

                    does <%= dairy.name %> require
                    medical attention?

                </div>



                <!-- =================================================
                     TARGET
                ================================================== -->

                <section
                    class="medical-mark-target"
                    aria-label="Medical attention target"
                >


                    <% if (
                        dairy.profileImage &&
                        dairy.profileImage.trim() !== ""
                    ) { %>

                        <img
                            src="<%= dairy.profileImage %>"
                            class="medical-mark-target__image"
                            alt="<%= dairy.name %>"
                        >

                    <% } else { %>

                        <div
                            class="medical-mark-target__placeholder"
                            aria-hidden="true"
                        >

                            <i class="bi bi-heart-pulse"></i>

                        </div>

                    <% } %>


                    <div class="medical-mark-target__info">

                        <span>
                            Medical attention required
                        </span>

                        <strong>
                            <%= dairy.name %>
                        </strong>

                    </div>


                </section>



                <!-- =================================================
                     MEDICAL FORM
                ================================================== -->

                <form
                    id="medicalMarkForm"
                    class="medical-mark-form"
                    action="/dairy/<%= dairy._id %>/medical-mark"
                    method="POST"
                    autocomplete="off"
                >


                    <!-- =============================================
                         MEDICAL TYPE
                    ============================================== -->

                    <div class="medical-mark-field">

                        <label
                            for="medicalMarkType"
                        >
                            Medical type
                        </label>


                        <input
                            type="text"
                            id="medicalMarkType"
                            name="type"
                            maxlength="200"
                            placeholder="e.g. Mastitis"
                            required
                        >

                    </div>



                    <!-- =============================================
                         DETAILS
                    ============================================== -->

                    <div class="medical-mark-field">

                        <label
                            for="medicalMarkDetails"
                        >
                            Details
                        </label>


                        <textarea
                            id="medicalMarkDetails"
                            name="details"
                            maxlength="1000"
                            rows="5"
                            placeholder="Describe the medical condition or concern..."
                            required
                        ></textarea>


                        <span
                            id="medicalMarkCharacterCounter"
                            class="medical-mark-character-counter"
                        >
                            0/1000
                        </span>

                    </div>



                    <!-- =============================================
                         SUBMIT
                    ============================================== -->

                    <button
                        type="submit"
                        id="submitMedicalMarkButton"
                        class="medical-mark-submit-button"
                        disabled
                    >

                        <i
                            class="bi bi-heart-pulse"
                            aria-hidden="true"
                        ></i>

                        <span>
                            Mark for Medical Attention
                        </span>

                    </button>


                </form>


            </div>

        </main>


    </div>

</div>



<!-- =========================================================
     CSS
========================================================= -->

<style>

/* =========================================================
   ROOT
========================================================= */

.medical-mark-composer,
.medical-mark-composer *,
.medical-mark-modal,
.medical-mark-modal * {

    box-sizing: border-box;

}



/* =========================================================
   REAL UPDATE CARD
========================================================= */

.medical-mark-composer {

    width: 112px;

    flex: 0 0 112px;

    margin: 0 0 16px;

}


.medical-mark-composer__card {

    position: relative;

    width: 112px;
    height: 155px;

    padding: 0;

    display: flex;

    flex-direction: column;

    align-items: center;
    justify-content: center;

    gap: 7px;

    overflow: hidden;

    border: 1px solid #dce7e0;

    border-radius: 15px;

    background:
        linear-gradient(
            145deg,
            #ffffff,
            #f3f8f5
        );

    color: #198754;

    font-family: inherit;

    cursor: pointer;

    text-align: center;

    transition:
        transform .15s ease,
        border-color .15s ease,
        box-shadow .15s ease;

}


.medical-mark-composer__card:hover {

    border-color: #198754;

    box-shadow:
        0 5px 15px
        rgba(25, 135, 84, .10);

}


.medical-mark-composer__card:active {

    transform: scale(.95);

}


.medical-mark-composer__card:focus-visible {

    outline: 2px solid #198754;

    outline-offset: 2px;

}



/* =========================================================
   ICON
========================================================= */

.medical-mark-composer__icon {

    width: 48px;
    height: 48px;

    display: flex;

    align-items: center;
    justify-content: center;

    border-radius: 50%;

    background: #198754;

    color: #ffffff;

    font-size: 31px;

    font-weight: 300;

    line-height: 1;

    box-shadow:
        0 4px 12px
        rgba(25, 135, 84, .20);

}



/* =========================================================
   CARD LABEL
========================================================= */

.medical-mark-composer__label {

    display: block;

    color: #26322b;

    font-size: 13px;

    font-weight: 700;

    line-height: 1.2;

}


.medical-mark-composer__target {

    display: block;

    max-width: 88px;

    overflow: hidden;

    color: #8a928d;

    font-size: 10px;

    line-height: 1.25;

    white-space: nowrap;

    text-overflow: ellipsis;

}



/* =========================================================
   FULL-SCREEN MODAL
========================================================= */

.medical-mark-modal {

    position: fixed;

    inset: 0;

    width: 100vw;
    height: 100dvh;

    z-index: 99999;

    display: none;

    overflow: hidden;

    background: #ffffff;

}


.medical-mark-modal.active {

    display: block;

}



/* =========================================================
   MODAL CONTENT
========================================================= */

.medical-mark-modal__content {

    width: 100%;
    height: 100%;

    display: flex;

    flex-direction: column;

    background: #ffffff;

}



/* =========================================================
   MODAL HEADER
========================================================= */

.medical-mark-modal__header {

    flex: 0 0 64px;

    width: 100%;
    height: 64px;

    display: flex;

    align-items: center;

    padding: 0 15px;

    border-bottom: 1px solid #e7ede9;

    background: #ffffff;

}


.medical-mark-modal__back {

    width: 44px;
    height: 44px;

    flex: 0 0 44px;

    display: flex;

    align-items: center;
    justify-content: center;

    padding: 0;

    border: none;

    border-radius: 50%;

    background: transparent;

    color: #198754;

    font-size: 27px;

    line-height: 1;

    cursor: pointer;

}


.medical-mark-modal__back:active {

    background: #edf7f1;

}


.medical-mark-modal__back:focus-visible {

    outline: 2px solid #198754;

    outline-offset: 2px;

}



/* =========================================================
   MODAL TITLE
========================================================= */

.medical-mark-modal__title {

    min-width: 0;

    margin-left: 8px;

    display: flex;

    flex-direction: column;

    line-height: 1.25;

}


.medical-mark-modal__title strong {

    color: #202520;

    font-size: 17px;

}


.medical-mark-modal__title span {

    max-width: 72vw;

    margin-top: 2px;

    overflow: hidden;

    color: #7b847e;

    font-size: 12px;

    white-space: nowrap;

    text-overflow: ellipsis;

}


.medical-mark-modal__spacer {

    flex: 1;

}



/* =========================================================
   MODAL BODY
========================================================= */

.medical-mark-modal__body {

    flex: 1 1 auto;

    min-height: 0;

    overflow-y: auto;

    padding: 20px;

}


.medical-mark-modal__fields {

    width: 100%;

    max-width: 700px;

    margin: 0 auto;

}



/* =========================================================
   QUESTION
========================================================= */

.medical-mark-question {

    margin-bottom: 20px;

    color: #202520;

    font-size: 20px;

    line-height: 1.45;

}


.medical-mark-question strong {

    color: #198754;

}



/* =========================================================
   TARGET
========================================================= */

.medical-mark-target {

    width: 100%;

    display: flex;

    align-items: center;

    gap: 12px;

    margin-bottom: 24px;

    padding: 12px 13px;

    border: 1px solid #dcebe2;

    border-radius: 13px;

    background: #f6faf7;

}


.medical-mark-target__image,
.medical-mark-target__placeholder {

    width: 52px;
    height: 52px;

    flex: 0 0 52px;

    overflow: hidden;

    border-radius: 50%;

}


.medical-mark-target__image {

    display: block;

    object-fit: cover;

}


.medical-mark-target__placeholder {

    display: flex;

    align-items: center;
    justify-content: center;

    background: #198754;

    color: #ffffff;

    font-size: 20px;

}


.medical-mark-target__info {

    min-width: 0;

    display: flex;

    flex-direction: column;

}


.medical-mark-target__info span {

    color: #78827c;

    font-size: 10px;

}


.medical-mark-target__info strong {

    margin-top: 3px;

    overflow: hidden;

    color: #235d3e;

    font-size: 14px;

    white-space: nowrap;

    text-overflow: ellipsis;

}



/* =========================================================
   FORM
========================================================= */

.medical-mark-form {

    width: 100%;

    margin: 0;

}


.medical-mark-field {

    position: relative;

    width: 100%;

    margin-bottom: 20px;

}


.medical-mark-field label {

    display: block;

    margin-bottom: 7px;

    color: #6d7771;

    font-size: 11px;

    font-weight: 700;

    letter-spacing: .04em;

    text-transform: uppercase;

}


.medical-mark-field input,
.medical-mark-field textarea {

    width: 100%;

    border: 1px solid #e0e7e2;

    border-radius: 12px;

    outline: none;

    background: #f8faf8;

    color: #202520;

    font: inherit;

    font-size: 15px;

}


.medical-mark-field input {

    height: 48px;

    padding: 0 13px;

}


.medical-mark-field textarea {

    min-height: 130px;

    max-height: 300px;

    resize: vertical;

    padding: 13px 14px 30px;

    line-height: 1.5;

}


.medical-mark-field input:focus,
.medical-mark-field textarea:focus {

    border-color: #198754;

    background: #ffffff;

    box-shadow:
        0 0 0 3px
        rgba(25, 135, 84, .10);

}



/* =========================================================
   CHARACTER COUNTER
========================================================= */

.medical-mark-character-counter {

    position: absolute;

    right: 11px;

    bottom: 9px;

    padding-left: 3px;

    background: #f8faf8;

    color: #8a928d;

    font-size: 10px;

    pointer-events: none;

}


.medical-mark-field textarea:focus
~ .medical-mark-character-counter {

    background: #ffffff;

}



/* =========================================================
   SUBMIT
========================================================= */

.medical-mark-submit-button {

    width: 100%;

    min-height: 50px;

    display: flex;

    align-items: center;
    justify-content: center;

    gap: 8px;

    padding: 10px 14px;

    border: none;

    border-radius: 13px;

    background: #198754;

    color: #ffffff;

    font-family: inherit;

    font-size: 14px;

    font-weight: 700;

    cursor: pointer;

    transition:
        background .2s ease,
        transform .15s ease,
        opacity .15s ease;

}


.medical-mark-submit-button:not(:disabled):hover {

    background: #146c43;

}


.medical-mark-submit-button:not(:disabled):active {

    transform: scale(.99);

}


.medical-mark-submit-button:disabled {

    background: #b8c2bc;

    cursor: default;

}


.medical-mark-submit-button i {

    font-size: 16px;

}



/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 600px) {

    .medical-mark-composer {

        width: 108px;

        flex-basis: 108px;

    }


    .medical-mark-composer__card {

        width: 108px;

        height: 150px;

    }


    .medical-mark-composer__icon {

        width: 46px;
        height: 46px;

        font-size: 29px;

    }


    .medical-mark-modal__header {

        flex-basis: 60px;

        height: 60px;

        padding: 0 10px;

    }


    .medical-mark-modal__body {

        padding: 14px;

    }


    .medical-mark-question {

        font-size: 19px;

    }


    .medical-mark-target {

        margin-bottom: 20px;

    }

}



/* =========================================================
   SMALL PHONES
========================================================= */

@media (max-width: 380px) {

    .medical-mark-modal__title span {

        display: none;

    }


    .medical-mark-modal__body {

        padding: 10px;

    }

}

</style>



<!-- =========================================================
     JAVASCRIPT
========================================================= -->

<script>

(function () {

    "use strict";


    function initializeMedicalMarkComposer() {


        /* =====================================================
           ELEMENTS
        ====================================================== */

        const modal =
            document.getElementById(
                "medicalMarkModal"
            );


        const openButton =
            document.getElementById(
                "openMedicalMarkComposer"
            );


        const closeButton =
            document.getElementById(
                "closeMedicalMarkModal"
            );


        const typeInput =
            document.getElementById(
                "medicalMarkType"
            );


        const detailsInput =
            document.getElementById(
                "medicalMarkDetails"
            );


        const characterCounter =
            document.getElementById(
                "medicalMarkCharacterCounter"
            );


        const submitButton =
            document.getElementById(
                "submitMedicalMarkButton"
            );


        const form =
            document.getElementById(
                "medicalMarkForm"
            );



        /* =====================================================
           SAFETY CHECK
        ====================================================== */

        if (
            !modal ||
            !openButton ||
            !closeButton ||
            !typeInput ||
            !detailsInput ||
            !characterCounter ||
            !submitButton ||
            !form
        ) {

            console.error(
                "MEDICAL-MARK-COMPOSER.EJS: Required elements are missing."
            );

            return;

        }



        /* =====================================================
           OPEN MODAL
        ====================================================== */

        function openModal() {

            modal.classList.add(
                "active"
            );


            modal.setAttribute(
                "aria-hidden",
                "false"
            );


            document.body.style.overflow =
                "hidden";


            window.setTimeout(
                function () {

                    typeInput.focus();

                },
                100
            );

        }



        /* =====================================================
           CLOSE MODAL
        ====================================================== */

        function closeModal() {

            modal.classList.remove(
                "active"
            );


            modal.setAttribute(
                "aria-hidden",
                "true"
            );


            document.body.style.overflow =
                "";

        }



        /* =====================================================
           VALIDATION
        ====================================================== */

        function updateSubmitButton() {

            const hasType =
                typeInput.value.trim().length > 0;


            const hasDetails =
                detailsInput.value.trim().length > 0;


            submitButton.disabled =
                !(
                    hasType &&
                    hasDetails
                );

        }



        /* =====================================================
           CHARACTER COUNTER
        ====================================================== */

        function updateCharacterCounter() {

            characterCounter.textContent =
                detailsInput.value.length +
                "/1000";

        }



        /* =====================================================
           TEXTAREA RESIZE
        ====================================================== */

        function resizeTextarea() {

            detailsInput.style.height =
                "auto";


            const height =
                Math.min(
                    detailsInput.scrollHeight,
                    300
                );


            detailsInput.style.height =
                height + "px";

        }



        /* =====================================================
           OPEN
        ====================================================== */

        openButton.addEventListener(
            "click",
            openModal
        );



        /* =====================================================
           CLOSE
        ====================================================== */

        closeButton.addEventListener(
            "click",
            closeModal
        );



        /* =====================================================
           ESCAPE
        ====================================================== */

        document.addEventListener(
            "keydown",
            function (event) {

                if (
                    event.key === "Escape" &&
                    modal.classList.contains(
                        "active"
                    )
                ) {

                    closeModal();

                }

            }
        );



        /* =====================================================
           TYPE
        ====================================================== */

        typeInput.addEventListener(
            "input",
            updateSubmitButton
        );



        /* =====================================================
           DETAILS
        ====================================================== */

        detailsInput.addEventListener(
            "input",
            function () {

                updateCharacterCounter();

                resizeTextarea();

                updateSubmitButton();

            }
        );



        /* =====================================================
           FORM SUBMIT
        ====================================================== */

        form.addEventListener(
            "submit",
            function () {

                submitButton.disabled =
                    true;


                submitButton.innerHTML =
                    '<i class="bi bi-hourglass-split"></i>' +
                    '<span>Submitting...</span>';

            }
        );



        /* =====================================================
           INITIAL STATE
        ====================================================== */

        updateCharacterCounter();

        resizeTextarea();

        updateSubmitButton();

    }



    /* =========================================================
       DOM READY
    ========================================================= */

    if (
        document.readyState === "loading"
    ) {

        document.addEventListener(
            "DOMContentLoaded",
            initializeMedicalMarkComposer
        );

    } else {

        initializeMedicalMarkComposer();

    }

})();

</script>


<% } %>