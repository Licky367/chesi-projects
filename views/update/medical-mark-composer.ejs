<% /*
============================================================
MEDICAL MARK COMPOSER

FILE:
    views/update/medical-mark-composer.ejs

PURPOSE:
    Compact card for marking the CURRENT dairy asset for
    medical attention.

TARGET:
    The current dairy/asset is ALWAYS the target.

FORM:
    POST /dairy/:id/medical-mark

SIZE:
    Same as create.ejs:
        Desktop: 112px × 155px
        Mobile:  108px × 150px
============================================================
*/ %>

<% if (dairy && user && (
    user.role === "admin" ||
    user.role === "dairyWorker"
)) { %>

<section class="medical-mark-composer">

    <button
        type="button"
        class="medical-mark-composer__card"
        onclick="toggleMedicalMarkComposer('<%= dairy._id %>')"
        aria-label="Mark <%= dairy.name %> for medical attention"
    >

        <span class="medical-mark-composer__icon">
            +
        </span>

        <span class="medical-mark-composer__label">
            Mark Medical
        </span>

        <span class="medical-mark-composer__target">
            <%= dairy.name %>
        </span>

    </button>


    <form
        id="medicalMarkComposerForm-<%= dairy._id %>"
        class="medical-mark-composer__form"
        action="/dairy/<%= dairy._id %>/medical-mark"
        method="POST"
    >

        <div class="medical-mark-composer__form-title">
            Medical Attention
        </div>

        <input
            type="text"
            name="type"
            maxlength="200"
            placeholder="Medical type"
            required
        >

        <textarea
            name="details"
            rows="3"
            maxlength="1000"
            placeholder="Describe the condition..."
            required
        ></textarea>

        <button type="submit">
            Mark Medical
        </button>

    </form>

</section>


<style>

.medical-mark-composer,
.medical-mark-composer * {
    box-sizing: border-box;
}


.medical-mark-composer {

    width: 112px;

    flex: 0 0 112px;

    margin: 0 0 16px;

}


.medical-mark-composer__card {

    position: relative;

    width: 112px;
    height: 155px;

    padding: 0;

    display: flex;

    flex-direction: column;

    align-items: center;
    justify-content: center;

    gap: 7px;

    overflow: hidden;

    border: 1px solid #dce7e0;

    border-radius: 15px;

    background:
        linear-gradient(
            145deg,
            #ffffff,
            #f3f8f5
        );

    color: #198754;

    font-family: inherit;

    cursor: pointer;

    text-align: center;

    transition:
        transform .15s ease,
        border-color .15s ease,
        box-shadow .15s ease;
}


.medical-mark-composer__card:hover {

    border-color: #198754;

    box-shadow:
        0 5px 15px rgba(25, 135, 84, .10);
}


.medical-mark-composer__card:active {

    transform: scale(.95);
}


.medical-mark-composer__card:focus-visible {

    outline: 2px solid #198754;

    outline-offset: 2px;
}


.medical-mark-composer__icon {

    width: 48px;
    height: 48px;

    display: flex;

    align-items: center;
    justify-content: center;

    border-radius: 50%;

    background: #198754;

    color: #ffffff;

    font-size: 31px;

    font-weight: 300;

    line-height: 1;

    box-shadow:
        0 4px 12px rgba(25, 135, 84, .20);
}


.medical-mark-composer__label {

    display: block;

    color: #26322b;

    font-size: 13px;

    font-weight: 700;

    line-height: 1.2;
}


.medical-mark-composer__target {

    display: block;

    max-width: 88px;

    overflow: hidden;

    color: #8a928d;

    font-size: 10px;

    line-height: 1.25;

    white-space: nowrap;

    text-overflow: ellipsis;
}


/* =========================================================
   FORM
========================================================= */

.medical-mark-composer__form {

    display: none;

    width: 100%;

    margin-top: 8px;

    padding: 10px;

    flex-direction: column;

    gap: 8px;

    border: 1px solid #dce7e0;

    border-radius: 12px;

    background: #f7faf8;
}


.medical-mark-composer__form--visible {

    display: flex;
}


.medical-mark-composer__form-title {

    color: #14532d;

    font-size: 12px;

    font-weight: 800;
}


.medical-mark-composer__form input,
.medical-mark-composer__form textarea {

    width: 100%;

    padding: 9px;

    border: 1px solid #d7e2da;

    border-radius: 8px;

    outline: none;

    background: #ffffff;

    color: #26322b;

    font: inherit;

    font-size: 12px;
}


.medical-mark-composer__form textarea {

    min-height: 70px;

    resize: vertical;
}


.medical-mark-composer__form input:focus,
.medical-mark-composer__form textarea:focus {

    border-color: #198754;

    box-shadow:
        0 0 0 2px rgba(25, 135, 84, .08);
}


.medical-mark-composer__form button {

    width: 100%;

    padding: 9px;

    border: none;

    border-radius: 8px;

    background: #198754;

    color: #ffffff;

    font: inherit;

    font-size: 12px;

    font-weight: 700;

    cursor: pointer;
}


@media (max-width: 600px) {

    .medical-mark-composer {

        width: 108px;

        flex-basis: 108px;
    }


    .medical-mark-composer__card {

        width: 108px;

        height: 150px;
    }


    .medical-mark-composer__icon {

        width: 46px;
        height: 46px;

        font-size: 29px;
    }

}

</style>


<script>

(function () {

    "use strict";

    window.toggleMedicalMarkComposer = function (id) {

        const form =
            document.getElementById(
                "medicalMarkComposerForm-" + id
            );

        if (!form) return;

        form.classList.toggle(
            "medical-mark-composer__form--visible"
        );

    };

})();

</script>

<% } %>