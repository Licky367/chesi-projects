<% /*
==========================================================
MAINTENANCE CLEAR COMPOSER

FILE:
    views/update/maintClearComposer.ejs

PURPOSE:
----------------------------------------------------------
Allows an admin to record completed maintenance work
and clear the maintenance status of the current asset.

CONDITIONS:
----------------------------------------------------------
• User must be an admin.
• Dairy must have no asset code.
• Dairy must currently require maintenance.

EXPECTED DATA:
----------------------------------------------------------
dairy
user

ROUTE:
----------------------------------------------------------
POST /dairy/:id/maintenance/clear
==========================================================
*/ %>


<% if (
    user &&
    user.role === "admin" &&
    dairy &&
    (
        dairy.code === null ||
        dairy.code === undefined
    ) &&
    dairy.needsMaintenance === true
) { %>


<!-- =========================================================
     MAINTENANCE CLEAR COMPOSER
========================================================= -->

<section
    class="maint-clear-composer-card"
    data-maint-clear-card
    data-dairy-id="<%= dairy._id %>"
>


    <!-- =====================================================
         COMPOSER HEADER
    ====================================================== -->

    <div class="maint-clear-composer-header">


        <!-- ADMIN AVATAR -->

        <div class="maint-clear-composer-avatar">

            <img
                src="<%= user.profileImage || ('https://ui-avatars.com/api/?name=' + encodeURIComponent(user.name)) %>"
                alt="<%= user.name %>"
                class="maint-clear-avatar-sm"
            >

        </div>


        <!-- HEADING -->

        <div class="maint-clear-composer-heading">

            <div class="maint-clear-heading-line">

                <strong>
                    <%= user.name.split(" ")[0] %>
                </strong>

                , has the maintenance work on this
                facility been completed?

            </div>

        </div>

    </div>



    <!-- =====================================================
         CLICKABLE TRIGGER
    ====================================================== -->

    <div
        class="maint-clear-composer-trigger"
        data-open-maint-clear
        role="button"
        tabindex="0"
        aria-label="Record completed maintenance"
    >

        <span>
            ✓ Record completed maintenance...
        </span>

    </div>


</section>



<!-- =========================================================
     FULL SCREEN MAINTENANCE CLEAR MODAL
========================================================= -->

<div
    class="maint-clear-modal"
    data-maint-clear-modal
    aria-hidden="true"
>


    <div class="maint-clear-modal-content">


        <!-- =================================================
             MODAL HEADER
        ================================================== -->

        <header class="maint-clear-modal-header">


            <button
                type="button"
                class="maint-clear-back-button"
                data-close-maint-clear
                aria-label="Go back"
            >

                <i class="bi bi-arrow-left"></i>

            </button>


            <div class="maint-clear-modal-title">

                <strong>
                    Clear Maintenance
                </strong>

                <span>
                    <%= dairy.name %>
                </span>

            </div>


            <div class="maint-clear-header-spacer"></div>


        </header>



        <!-- =================================================
             MODAL BODY
        ================================================== -->

        <main class="maint-clear-modal-body">


            <!-- =================================================
                 QUESTION
            ================================================== -->

            <div class="maint-clear-question">

                <strong>
                    <%= user.name.split(" ")[0] %>
                </strong>,

                has the maintenance work on this facility
                been completed?

            </div>



            <!-- =================================================
                 TARGET ASSET
            ================================================== -->

            <div class="maint-clear-target">


                <% if (
                    dairy.profileImage &&
                    dairy.profileImage.trim() !== ""
                ) { %>

                    <img
                        src="<%= dairy.profileImage %>"
                        class="maint-clear-target-image"
                        alt="<%= dairy.name %>"
                    >

                <% } else { %>

                    <img
                        src="https://ui-avatars.com/api/?name=<%= encodeURIComponent(dairy.name) %>&background=0b5d1e&color=fff"
                        class="maint-clear-target-image"
                        alt="<%= dairy.name %>"
                    >

                <% } %>


                <div class="maint-clear-target-info">

                    <strong>
                        <%= dairy.name %>
                    </strong>

                    <span>
                        Maintenance currently required
                    </span>

                </div>


            </div>



            <!-- =================================================
                 MAINTENANCE STATUS
            ================================================== -->

            <div class="maint-clear-status">

                <span class="maint-clear-status-icon">
                    ⚠️
                </span>


                <div>

                    <strong>
                        Maintenance in progress
                    </strong>

                    <span>
                        Record the completed work below to
                        clear the maintenance status.
                    </span>

                </div>

            </div>



            <!-- =================================================
                 CLEAR MAINTENANCE FORM
            ================================================== -->

            <form
                class="maint-clear-form"
                action="/dairy/<%= dairy._id %>/maintenance/clear"
                method="POST"
                autocomplete="off"
            >


                <!-- =============================================
                     CHARGES
                ============================================== -->

                <div class="maint-clear-field">

                    <label for="maintClearCharges">

                        Charges incurred

                    </label>


                    <div class="maint-clear-money-input">

                        <span>
                            KES
                        </span>


                        <input
                            type="number"
                            id="maintClearCharges"
                            name="charges"
                            min="0"
                            step="0.01"
                            inputmode="decimal"
                            placeholder="0.00"
                            required
                        >

                    </div>

                </div>



                <!-- =============================================
                     DESCRIPTION
                ============================================== -->

                <div class="maint-clear-field">

                    <label for="maintClearDescription">

                        Work completed

                    </label>


                    <textarea
                        id="maintClearDescription"
                        name="description"
                        maxlength="1000"
                        placeholder="Describe the maintenance work completed..."
                        required
                    ></textarea>


                    <div
                        class="maint-clear-character-counter"
                        data-maint-clear-counter
                    >
                        0/1000
                    </div>

                </div>



                <!-- =============================================
                     SUBMIT
                ============================================== -->

                <div class="maint-clear-submit-wrapper">

                    <button
                        type="submit"
                        class="maint-clear-submit-button"
                        data-maint-clear-submit
                        disabled
                    >

                        <i class="bi bi-check-circle"></i>

                        Clear Maintenance

                    </button>

                </div>


            </form>


        </main>


    </div>

</div>



<!-- =========================================================
     CSS
========================================================= -->

<style>

/* =========================================================
   COMPOSER CARD
========================================================= */

.maint-clear-composer-card {

    width: 100%;

    box-sizing: border-box;

    padding: 16px;

    margin-bottom: 16px;

    background: #ffffff;

    border: 1px solid #e7eee9;

    border-radius: 16px;

}


/* =========================================================
   COMPOSER HEADER
========================================================= */

.maint-clear-composer-header {

    display: flex;

    align-items: center;

    gap: 12px;

}


.maint-clear-composer-avatar {

    flex: 0 0 auto;

}


.maint-clear-avatar-sm {

    width: 44px;

    height: 44px;

    display: block;

    object-fit: cover;

    border-radius: 50%;

}


.maint-clear-composer-heading {

    min-width: 0;

    color: #555555;

    font-size: 14px;

    line-height: 1.5;

}


.maint-clear-heading-line {

    display: block;

}


.maint-clear-composer-heading strong {

    color: #222222;

}



/* =========================================================
   CLICKABLE COMPOSER TRIGGER
========================================================= */

.maint-clear-composer-trigger {

    min-height: 48px;

    box-sizing: border-box;

    display: flex;

    align-items: center;

    margin-top: 14px;

    padding: 0 16px;

    border: 1px solid #dfe8e2;

    border-radius: 24px;

    background: #f8faf8;

    color: #777777;

    cursor: pointer;

    transition:
        background 0.2s ease,
        border-color 0.2s ease,
        transform 0.15s ease;

}


.maint-clear-composer-trigger:hover {

    background: #f1f7f3;

    border-color: #198754;

}


.maint-clear-composer-trigger:active {

    transform: scale(0.99);

}



/* =========================================================
   FULL SCREEN MODAL
========================================================= */

.maint-clear-modal {

    position: fixed;

    inset: 0;

    width: 100vw;

    height: 100dvh;

    display: none;

    overflow: hidden;

    box-sizing: border-box;

    background: #ffffff;

    z-index: 99999;

}


.maint-clear-modal.active {

    display: block;

}


.maint-clear-modal-content {

    width: 100%;

    height: 100%;

    display: flex;

    flex-direction: column;

    background: #ffffff;

}



/* =========================================================
   MODAL HEADER
========================================================= */

.maint-clear-modal-header {

    flex: 0 0 auto;

    width: 100%;

    height: 64px;

    box-sizing: border-box;

    display: flex;

    align-items: center;

    padding: 0 16px;

    border-bottom: 1px solid #e8eee9;

    background: #ffffff;

}


.maint-clear-back-button {

    width: 44px;

    height: 44px;

    flex: 0 0 44px;

    display: flex;

    align-items: center;

    justify-content: center;

    padding: 0;

    border: none;

    background: transparent;

    color: #198754;

    font-size: 27px;

    cursor: pointer;

}


.maint-clear-back-button:hover {

    color: #146c43;

}


.maint-clear-modal-title {

    min-width: 0;

    display: flex;

    flex-direction: column;

    margin-left: 8px;

    line-height: 1.25;

}


.maint-clear-modal-title strong {

    color: #202520;

    font-size: 17px;

}


.maint-clear-modal-title span {

    margin-top: 2px;

    color: #7a817d;

    font-size: 12px;

}


.maint-clear-header-spacer {

    flex: 1;

}



/* =========================================================
   MODAL BODY
========================================================= */

.maint-clear-modal-body {

    flex: 1 1 auto;

    min-height: 0;

    box-sizing: border-box;

    overflow-y: auto;

    padding: 20px;

}



/* =========================================================
   QUESTION
========================================================= */

.maint-clear-question {

    margin-bottom: 20px;

    color: #202520;

    font-size: 20px;

    line-height: 1.45;

}


.maint-clear-question strong {

    color: #198754;

}



/* =========================================================
   TARGET
========================================================= */

.maint-clear-target {

    display: flex;

    align-items: center;

    gap: 12px;

    box-sizing: border-box;

    margin-bottom: 16px;

    padding: 12px;

    border: 1px solid #e1ebe4;

    border-radius: 14px;

    background: #f7faf8;

}


.maint-clear-target-image {

    width: 52px;

    height: 52px;

    flex: 0 0 52px;

    object-fit: cover;

    border-radius: 50%;

}


.maint-clear-target-info {

    min-width: 0;

    display: flex;

    flex-direction: column;

}


.maint-clear-target-info strong {

    overflow: hidden;

    color: #202520;

    font-size: 15px;

    text-overflow: ellipsis;

    white-space: nowrap;

}


.maint-clear-target-info span {

    margin-top: 3px;

    color: #7a817d;

    font-size: 12px;

}



/* =========================================================
   STATUS NOTICE
========================================================= */

.maint-clear-status {

    display: flex;

    align-items: flex-start;

    gap: 11px;

    box-sizing: border-box;

    margin-bottom: 24px;

    padding: 13px;

    border: 1px solid #fde2e2;

    border-radius: 13px;

    background: #fff7f7;

}


.maint-clear-status-icon {

    width: 30px;

    height: 30px;

    flex: 0 0 30px;

    display: flex;

    align-items: center;

    justify-content: center;

    border-radius: 50%;

    background: #fee2e2;

    font-size: 15px;

}


.maint-clear-status > div {

    min-width: 0;

    display: flex;

    flex-direction: column;

}


.maint-clear-status strong {

    color: #991b1b;

    font-size: 13px;

}


.maint-clear-status span {

    margin-top: 3px;

    color: #7f1d1d;

    font-size: 12px;

    line-height: 1.4;

}



/* =========================================================
   FORM
========================================================= */

.maint-clear-form {

    width: 100%;

    margin: 0;

}


.maint-clear-field {

    position: relative;

    margin-bottom: 20px;

}


.maint-clear-field label {

    display: block;

    margin-bottom: 7px;

    color: #37413a;

    font-size: 13px;

    font-weight: 700;

}



/* =========================================================
   CHARGES INPUT
========================================================= */

.maint-clear-money-input {

    width: 100%;

    height: 48px;

    box-sizing: border-box;

    display: flex;

    align-items: center;

    overflow: hidden;

    border: 1px solid #d6e0d9;

    border-radius: 12px;

    background: #f8faf8;

    transition:
        border-color 0.2s ease,
        background 0.2s ease,
        box-shadow 0.2s ease;

}


.maint-clear-money-input:focus-within {

    border-color: #198754;

    background: #ffffff;

    box-shadow:
        0 0 0 3px
        rgba(25, 135, 84, 0.10);

}


.maint-clear-money-input span {

    height: 100%;

    box-sizing: border-box;

    display: flex;

    align-items: center;

    padding: 0 13px;

    border-right: 1px solid #d6e0d9;

    background: #eef5f0;

    color: #198754;

    font-size: 12px;

    font-weight: 800;

}


.maint-clear-money-input input {

    flex: 1;

    width: 100%;

    min-width: 0;

    height: 100%;

    box-sizing: border-box;

    padding: 0 12px;

    border: none;

    outline: none;

    background: transparent;

    color: #202520;

    font-family: inherit;

    font-size: 15px;

}



/* =========================================================
   DESCRIPTION
========================================================= */

.maint-clear-field textarea {

    width: 100%;

    min-height: 130px;

    box-sizing: border-box;

    padding: 13px;

    padding-bottom: 28px;

    resize: vertical;

    border: 1px solid #d6e0d9;

    border-radius: 12px;

    outline: none;

    background: #f8faf8;

    color: #202520;

    font-family: inherit;

    font-size: 15px;

    line-height: 1.5;

    transition:
        border-color 0.2s ease,
        background 0.2s ease,
        box-shadow 0.2s ease;

}


.maint-clear-field textarea:focus {

    border-color: #198754;

    background: #ffffff;

    box-shadow:
        0 0 0 3px
        rgba(25, 135, 84, 0.10);

}



/* =========================================================
   CHARACTER COUNTER
========================================================= */

.maint-clear-character-counter {

    position: absolute;

    right: 10px;

    bottom: 8px;

    color: #89938d;

    font-size: 10px;

    pointer-events: none;

}



/* =========================================================
   SUBMIT
========================================================= */

.maint-clear-submit-wrapper {

    width: 100%;

    margin-top: 6px;

}


.maint-clear-submit-button {

    width: 100%;

    min-height: 50px;

    box-sizing: border-box;

    display: flex;

    align-items: center;

    justify-content: center;

    gap: 8px;

    border: none;

    border-radius: 13px;

    background: #198754;

    color: #ffffff;

    font-family: inherit;

    font-size: 14px;

    font-weight: 700;

    cursor: pointer;

    transition:
        background 0.2s ease,
        transform 0.15s ease;

}


.maint-clear-submit-button:not(:disabled):hover {

    background: #146c43;

}


.maint-clear-submit-button:not(:disabled):active {

    transform: scale(0.99);

}


.maint-clear-submit-button:disabled {

    background: #b8c2bc;

    cursor: default;

}



/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 600px) {

    .maint-clear-modal-header {

        height: 60px;

        padding: 0 10px;

    }


    .maint-clear-modal-title strong {

        font-size: 16px;

    }


    .maint-clear-modal-body {

        padding: 16px;

    }


    .maint-clear-question {

        font-size: 18px;

    }

}



/* =========================================================
   SMALL PHONES
========================================================= */

@media (max-width: 380px) {

    .maint-clear-modal-body {

        padding: 12px;

    }


    .maint-clear-modal-title span {

        display: none;

    }

}

</style>



<!-- =========================================================
     JAVASCRIPT
========================================================= -->

<script>

(function () {

    "use strict";


    function initializeMaintenanceClearComposer() {


        const card =
            document.querySelector(
                "[data-maint-clear-card]"
            );


        const modal =
            document.querySelector(
                "[data-maint-clear-modal]"
            );


        const openButton =
            document.querySelector(
                "[data-open-maint-clear]"
            );


        const closeButton =
            document.querySelector(
                "[data-close-maint-clear]"
            );


        if (
            !card ||
            !modal ||
            !openButton ||
            !closeButton
        ) {

            return;

        }


        const chargesInput =
            card.parentElement.querySelector(
                "#maintClearCharges"
            );


        const descriptionInput =
            card.parentElement.querySelector(
                "#maintClearDescription"
            );


        const characterCounter =
            card.parentElement.querySelector(
                "[data-maint-clear-counter]"
            );


        const submitButton =
            card.parentElement.querySelector(
                "[data-maint-clear-submit]"
            );


        const form =
            card.parentElement.querySelector(
                ".maint-clear-form"
            );


        if (
            !chargesInput ||
            !descriptionInput ||
            !characterCounter ||
            !submitButton ||
            !form
        ) {

            return;

        }



        /* =================================================
           OPEN MODAL
        ================================================== */

        function openModal() {

            modal.classList.add("active");

            modal.setAttribute(
                "aria-hidden",
                "false"
            );

            document.body.style.overflow =
                "hidden";


            setTimeout(function () {

                chargesInput.focus();

            }, 100);

        }



        /* =================================================
           CLOSE MODAL
        ================================================== */

        function closeModal() {

            modal.classList.remove("active");

            modal.setAttribute(
                "aria-hidden",
                "true"
            );

            document.body.style.overflow =
                "";

        }



        /* =================================================
           VALIDATE FORM
        ================================================== */

        function updateSubmitButton() {

            const charges =
                chargesInput.value.trim();


            const description =
                descriptionInput.value.trim();


            const numericCharges =
                Number(charges);


            const validCharges =
                charges !== "" &&
                Number.isFinite(
                    numericCharges
                ) &&
                numericCharges >= 0;


            const validDescription =
                description.length > 0;


            submitButton.disabled =
                !(
                    validCharges &&
                    validDescription
                );

        }



        /* =================================================
           CHARACTER COUNTER
        ================================================== */

        function updateCharacterCounter() {

            const length =
                descriptionInput.value.length;


            characterCounter.textContent =
                length + "/1000";

        }



        /* =================================================
           OPEN CLICK
        ================================================== */

        openButton.addEventListener(
            "click",
            function () {

                openModal();

            }
        );



        /* =================================================
           OPEN KEYBOARD
        ================================================== */

        openButton.addEventListener(
            "keydown",
            function (event) {

                if (
                    event.key === "Enter" ||
                    event.key === " "
                ) {

                    event.preventDefault();

                    openModal();

                }

            }
        );



        /* =================================================
           CLOSE BUTTON
        ================================================== */

        closeButton.addEventListener(
            "click",
            function () {

                closeModal();

            }
        );



        /* =================================================
           ESCAPE KEY
        ================================================== */

        document.addEventListener(
            "keydown",
            function (event) {

                if (
                    event.key === "Escape" &&
                    modal.classList.contains("active")
                ) {

                    closeModal();

                }

            }
        );



        /* =================================================
           CHARGES INPUT
        ================================================== */

        chargesInput.addEventListener(
            "input",
            function () {

                updateSubmitButton();

            }
        );



        /* =================================================
           DESCRIPTION INPUT
        ================================================== */

        descriptionInput.addEventListener(
            "input",
            function () {

                updateCharacterCounter();

                updateSubmitButton();

            }
        );



        /* =================================================
           FORM SUBMIT
        ================================================== */

        form.addEventListener(
            "submit",
            function () {

                submitButton.disabled =
                    true;


                submitButton.innerHTML =
                    '<i class="bi bi-hourglass-split"></i> ' +
                    'Clearing...';

            }
        );



        /* =================================================
           INITIAL STATE
        ================================================== */

        updateCharacterCounter();

        updateSubmitButton();

    }



    /* =====================================================
       DOM READY
    ====================================================== */

    if (
        document.readyState === "loading"
    ) {

        document.addEventListener(
            "DOMContentLoaded",
            initializeMaintenanceClearComposer
        );

    } else {

        initializeMaintenanceClearComposer();

    }

})();

</script>


<% } %>