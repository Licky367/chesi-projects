<!-- =========================================================
     MAINTENANCE CLEAR COMPOSER + FULL SCREEN MODAL

     FILE:
         views/update/maintClearComposer.ejs

     PURPOSE:
         Allows an admin to record completion of maintenance
         work and clear the maintenance status of a facility.

     EXPECTED VARIABLES:
         user
         dairy

     CONDITIONS:
         - user.role === "admin"
         - dairy has NO code
         - dairy.needsMaintenance === true
========================================================= -->


<% if (
    user &&
    user.role === "admin" &&
    dairy &&
    (
        dairy.code === undefined ||
        dairy.code === null
    ) &&
    dairy.needsMaintenance === true
) { %>


<!-- =========================================================
     CLEAR MAINTENANCE COMPOSER CARD
========================================================= -->

<section class="maint-clear-composer-card">


    <!-- =====================================================
         HEADER
    ====================================================== -->

    <div class="maint-clear-composer-header">


        <!-- ADMIN AVATAR -->

        <div class="maint-clear-composer-avatar">

            <img
                src="<%= user.profileImage || ('https://ui-avatars.com/api/?name=' + encodeURIComponent(user.name)) %>"
                alt="<%= user.name %>"
                class="maint-clear-avatar-sm"
            >

        </div>


        <!-- HEADING -->

        <div class="maint-clear-composer-heading">

            <div class="maint-clear-heading-line">

                <strong>
                    <%= user.name.split(" ")[0] %>
                </strong>

                , has the maintenance work on this facility
                been completed?

            </div>

        </div>

    </div>



    <!-- =====================================================
         CLICKABLE TRIGGER
    ====================================================== -->

    <div
        id="openMaintClearComposer"
        class="maint-clear-composer-trigger"
        role="button"
        tabindex="0"
        aria-label="Clear completed maintenance"
    >

        <span>

            ✓ Record completed maintenance...

        </span>

    </div>


</section>



<!-- =========================================================
     FULL SCREEN CLEAR MAINTENANCE MODAL
========================================================= -->

<div
    id="maintClearModal"
    class="maint-clear-modal"
    aria-hidden="true"
>


    <div class="maint-clear-modal-content">


        <!-- =================================================
             MODAL HEADER
        ================================================== -->

        <header class="maint-clear-modal-header">


            <button
                type="button"
                id="closeMaintClearModal"
                class="maint-clear-back-button"
                aria-label="Go back"
            >

                <i class="bi bi-arrow-left"></i>

            </button>


            <div class="maint-clear-modal-title">

                <strong>
                    Clear Maintenance
                </strong>

                <span>
                    <%= dairy.name %>
                </span>

            </div>


            <div class="maint-clear-header-spacer"></div>


        </header>



        <!-- =================================================
             MODAL BODY
        ================================================== -->

        <main class="maint-clear-modal-body">


            <!-- =================================================
                 QUESTION
            ================================================== -->

            <div class="maint-clear-question">

                <strong>
                    <%= user.name.split(" ")[0] %>
                </strong>,

                has the maintenance work on this facility
                been completed?

            </div>



            <!-- =================================================
                 TARGET FACILITY
            ================================================== -->

            <div class="maint-clear-target">


                <% if (
                    dairy.profileImage &&
                    dairy.profileImage.trim() !== ""
                ) { %>


                    <img
                        src="/uploads/<%= dairy.profileImage %>"
                        class="maint-clear-target-image"
                        alt="<%= dairy.name %>"
                    >


                <% } else { %>


                    <img
                        src="https://ui-avatars.com/api/?name=<%= encodeURIComponent(dairy.name) %>&background=0b5d1e&color=fff"
                        class="maint-clear-target-image"
                        alt="<%= dairy.name %>"
                    >


                <% } %>


                <div class="maint-clear-target-info">

                    <strong>
                        <%= dairy.name %>
                    </strong>

                    <span>
                        Maintenance currently required
                    </span>

                </div>


            </div>



            <!-- =================================================
                 MAINTENANCE STATUS
            ================================================== -->

            <div class="maint-clear-status">

                <span class="maint-clear-status-icon">
                    ⚠️
                </span>

                <div>

                    <strong>
                        Maintenance in progress
                    </strong>

                    <span>
                        Record the completed work below to clear
                        the maintenance status.
                    </span>

                </div>

            </div>



            <!-- =================================================
                 CLEAR MAINTENANCE FORM
            ================================================== -->

            <form
                id="maintClearForm"
                action="/dairy/<%= dairy._id %>/maintenance/clear"
                method="POST"
            >


                <!-- =============================================
                     CHARGES
                ============================================== -->

                <div class="maint-clear-field">

                    <label
                        for="maintClearCharges"
                    >

                        Charges incurred

                    </label>


                    <div class="maint-clear-money-input">

                        <span>
                            KES
                        </span>

                        <input
                            type="number"
                            id="maintClearCharges"
                            name="charges"
                            min="0"
                            step="0.01"
                            inputmode="decimal"
                            placeholder="0.00"
                            required
                        >

                    </div>

                </div>



                <!-- =============================================
                     DESCRIPTION
                ============================================== -->

                <div class="maint-clear-field">

                    <label
                        for="maintClearDescription"
                    >

                        Work completed

                    </label>


                    <textarea
                        id="maintClearDescription"
                        name="description"
                        maxlength="1000"
                        placeholder="Describe the maintenance work completed..."
                        required
                    ></textarea>


                    <div
                        id="maintClearCharacterCounter"
                        class="maint-clear-character-counter"
                    >

                        0/1000

                    </div>

                </div>



                <!-- =============================================
                     SUBMIT
                ============================================== -->

                <div class="maint-clear-submit-wrapper">

                    <button
                        type="submit"
                        id="submitMaintClearButton"
                        class="maint-clear-submit-button"
                        disabled
                    >

                        <i class="bi bi-check-circle"></i>

                        Clear Maintenance

                    </button>

                </div>


            </form>


        </main>


    </div>

</div>



<!-- =========================================================
     CSS
========================================================= -->

<style>

/* =========================================================
   CLEAR MAINTENANCE COMPOSER CARD
========================================================= */

.maint-clear-composer-card {

    width: 100%;

    background: #ffffff;

    border-radius: 16px;

    padding: 16px;

    margin-bottom: 16px;

    box-sizing: border-box;

    border: 1px solid #e7eee9;

}


.maint-clear-composer-header {

    display: flex;

    align-items: center;

    gap: 12px;

}


.maint-clear-composer-avatar {

    flex-shrink: 0;

}


.maint-clear-avatar-sm {

    width: 44px;

    height: 44px;

    border-radius: 50%;

    object-fit: cover;

    display: block;

}


.maint-clear-composer-heading {

    min-width: 0;

    font-size: 14px;

    line-height: 1.5;

    color: #555;

}


.maint-clear-heading-line {

    display: block;

}


.maint-clear-composer-heading strong {

    color: #222;

}



/* =========================================================
   CLICKABLE TRIGGER
========================================================= */

.maint-clear-composer-trigger {

    margin-top: 14px;

    min-height: 48px;

    padding: 0 16px;

    border: 1px solid #dfe8e2;

    border-radius: 24px;

    display: flex;

    align-items: center;

    color: #777;

    background: #f8faf8;

    cursor: pointer;

    transition:
        background 0.2s ease,
        border-color 0.2s ease,
        transform 0.15s ease;

}


.maint-clear-composer-trigger:hover {

    background: #f1f7f3;

    border-color: #198754;

}


.maint-clear-composer-trigger:active {

    transform: scale(0.99);

}



/* =========================================================
   FULL SCREEN MODAL
========================================================= */

.maint-clear-modal {

    position: fixed;

    inset: 0;

    width: 100vw;

    height: 100dvh;

    background: #ffffff;

    z-index: 99999;

    display: none;

    overflow: hidden;

}


.maint-clear-modal.active {

    display: block;

}


.maint-clear-modal-content {

    position: relative;

    width: 100%;

    height: 100%;

    display: flex;

    flex-direction: column;

    background: #ffffff;

}



/* =========================================================
   MODAL HEADER
========================================================= */

.maint-clear-modal-header {

    flex: 0 0 auto;

    height: 64px;

    width: 100%;

    display: flex;

    align-items: center;

    padding: 0 16px;

    box-sizing: border-box;

    border-bottom: 1px solid #e8eee9;

    background: #ffffff;

}


.maint-clear-back-button {

    width: 44px;

    height: 44px;

    border: none;

    background: transparent;

    color: #198754;

    display: flex;

    align-items: center;

    justify-content: center;

    cursor: pointer;

    font-size: 27px;

    padding: 0;

    flex-shrink: 0;

}


.maint-clear-back-button:hover {

    color: #146c43;

}


.maint-clear-modal-title {

    margin-left: 8px;

    display: flex;

    flex-direction: column;

    line-height: 1.25;

}


.maint-clear-modal-title strong {

    font-size: 17px;

    color: #202520;

}


.maint-clear-modal-title span {

    margin-top: 2px;

    font-size: 12px;

    color: #7a817d;

}


.maint-clear-header-spacer {

    flex: 1;

}



/* =========================================================
   MODAL BODY
========================================================= */

.maint-clear-modal-body {

    flex: 1 1 auto;

    min-height: 0;

    overflow-y: auto;

    padding: 20px;

    box-sizing: border-box;

}



/* =========================================================
   QUESTION
========================================================= */

.maint-clear-question {

    margin-bottom: 20px;

    color: #202520;

    font-size: 20px;

    line-height: 1.45;

}


.maint-clear-question strong {

    color: #198754;

}



/* =========================================================
   TARGET
========================================================= */

.maint-clear-target {

    display: flex;

    align-items: center;

    gap: 12px;

    margin-bottom: 16px;

    padding: 12px;

    border: 1px solid #e1ebe4;

    border-radius: 14px;

    background: #f7faf8;

}


.maint-clear-target-image {

    width: 52px;

    height: 52px;

    flex-shrink: 0;

    object-fit: cover;

    border-radius: 50%;

}


.maint-clear-target-info {

    display: flex;

    flex-direction: column;

    min-width: 0;

}


.maint-clear-target-info strong {

    color: #202520;

    font-size: 15px;

}


.maint-clear-target-info span {

    margin-top: 3px;

    color: #7a817d;

    font-size: 12px;

}



/* =========================================================
   STATUS NOTICE
========================================================= */

.maint-clear-status {

    display: flex;

    align-items: flex-start;

    gap: 11px;

    padding: 13px;

    margin-bottom: 24px;

    border: 1px solid #fde2e2;

    border-radius: 13px;

    background: #fff7f7;

}


.maint-clear-status-icon {

    display: flex;

    align-items: center;

    justify-content: center;

    flex-shrink: 0;

    width: 30px;

    height: 30px;

    border-radius: 50%;

    background: #fee2e2;

    font-size: 15px;

}


.maint-clear-status div {

    display: flex;

    flex-direction: column;

    min-width: 0;

}


.maint-clear-status strong {

    color: #991b1b;

    font-size: 13px;

}


.maint-clear-status span:not(.maint-clear-status-icon) {

    margin-top: 3px;

    color: #7f1d1d;

    font-size: 12px;

    line-height: 1.4;

}



/* =========================================================
   FORM
========================================================= */

#maintClearForm {

    width: 100%;

    margin: 0;

}


.maint-clear-field {

    position: relative;

    margin-bottom: 20px;

}


.maint-clear-field label {

    display: block;

    margin-bottom: 7px;

    color: #37413a;

    font-size: 13px;

    font-weight: 700;

}



/* =========================================================
   MONEY INPUT
========================================================= */

.maint-clear-money-input {

    display: flex;

    align-items: center;

    width: 100%;

    height: 48px;

    box-sizing: border-box;

    border: 1px solid #d6e0d9;

    border-radius: 12px;

    overflow: hidden;

    background: #f8faf8;

    transition:
        border-color 0.2s ease,
        background 0.2s ease,
        box-shadow 0.2s ease;

}


.maint-clear-money-input:focus-within {

    border-color: #198754;

    background: #ffffff;

    box-shadow:
        0 0 0 3px
        rgba(25, 135, 84, 0.10);

}


.maint-clear-money-input span {

    height: 100%;

    display: flex;

    align-items: center;

    padding: 0 13px;

    border-right: 1px solid #d6e0d9;

    background: #eef5f0;

    color: #198754;

    font-size: 12px;

    font-weight: 800;

}


.maint-clear-money-input input {

    flex: 1;

    width: 100%;

    height: 100%;

    min-width: 0;

    padding: 0 12px;

    border: none;

    outline: none;

    background: transparent;

    color: #202520;

    font-family: inherit;

    font-size: 15px;

}



/* =========================================================
   DESCRIPTION
========================================================= */

.maint-clear-field textarea {

    width: 100%;

    min-height: 130px;

    box-sizing: border-box;

    padding: 13px;

    padding-bottom: 28px;

    resize: vertical;

    border: 1px solid #d6e0d9;

    border-radius: 12px;

    outline: none;

    background: #f8faf8;

    color: #202520;

    font-family: inherit;

    font-size: 15px;

    line-height: 1.5;

    transition:
        border-color 0.2s ease,
        background 0.2s ease,
        box-shadow 0.2s ease;

}


.maint-clear-field textarea:focus {

    border-color: #198754;

    background: #ffffff;

    box-shadow:
        0 0 0 3px
        rgba(25, 135, 84, 0.10);

}



/* =========================================================
   CHARACTER COUNTER
========================================================= */

.maint-clear-character-counter {

    position: absolute;

    right: 10px;

    bottom: 8px;

    color: #89938d;

    font-size: 10px;

    pointer-events: none;

}



/* =========================================================
   SUBMIT
========================================================= */

.maint-clear-submit-wrapper {

    width: 100%;

    margin-top: 6px;

}


.maint-clear-submit-button {

    width: 100%;

    min-height: 50px;

    border: none;

    border-radius: 13px;

    background: #198754;

    color: #ffffff;

    font-family: inherit;

    font-size: 14px;

    font-weight: 700;

    cursor: pointer;

    display: flex;

    align-items: center;

    justify-content: center;

    gap: 8px;

    transition:
        background 0.2s ease,
        transform 0.15s ease;

}


.maint-clear-submit-button:not(:disabled):hover {

    background: #146c43;

}


.maint-clear-submit-button:not(:disabled):active {

    transform: scale(0.99);

}


.maint-clear-submit-button:disabled {

    background: #b8c2bc;

    cursor: default;

}



/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 600px) {

    .maint-clear-modal-header {

        height: 60px;

        padding: 0 10px;

    }


    .maint-clear-modal-title strong {

        font-size: 16px;

    }


    .maint-clear-modal-body {

        padding: 16px;

    }


    .maint-clear-question {

        font-size: 18px;

    }

}



/* =========================================================
   SMALL PHONES
========================================================= */

@media (max-width: 380px) {

    .maint-clear-modal-body {

        padding: 12px;

    }


    .maint-clear-modal-title span {

        display: none;

    }

}

</style>



<!-- =========================================================
     JAVASCRIPT
========================================================= -->

<script>

(function () {

    "use strict";


    function initializeMaintenanceClearComposer() {


        const modal =
            document.getElementById(
                "maintClearModal"
            );

        const openButton =
            document.getElementById(
                "openMaintClearComposer"
            );

        const closeButton =
            document.getElementById(
                "closeMaintClearModal"
            );

        const chargesInput =
            document.getElementById(
                "maintClearCharges"
            );

        const descriptionInput =
            document.getElementById(
                "maintClearDescription"
            );

        const characterCounter =
            document.getElementById(
                "maintClearCharacterCounter"
            );

        const submitButton =
            document.getElementById(
                "submitMaintClearButton"
            );

        const form =
            document.getElementById(
                "maintClearForm"
            );


        if (
            !modal ||
            !openButton ||
            !closeButton ||
            !chargesInput ||
            !descriptionInput ||
            !characterCounter ||
            !submitButton ||
            !form
        ) {

            return;

        }



        /* =================================================
           OPEN
        ================================================== */

        function openModal() {

            modal.classList.add("active");

            modal.setAttribute(
                "aria-hidden",
                "false"
            );

            document.body.style.overflow =
                "hidden";


            setTimeout(function () {

                chargesInput.focus();

            }, 100);

        }



        /* =================================================
           CLOSE
        ================================================== */

        function closeModal() {

            modal.classList.remove("active");

            modal.setAttribute(
                "aria-hidden",
                "true"
            );

            document.body.style.overflow =
                "";

        }



        /* =================================================
           VALIDATION
        ================================================== */

        function updateSubmitButton() {

            const charges =
                chargesInput.value.trim();

            const description =
                descriptionInput.value.trim();

            const validCharges =
                charges !== "" &&
                Number.isFinite(
                    Number(charges)
                ) &&
                Number(charges) >= 0;

            const validDescription =
                description.length > 0;

            submitButton.disabled =
                !(
                    validCharges &&
                    validDescription
                );

        }



        /* =================================================
           CHARACTER COUNTER
        ================================================== */

        function updateCharacterCounter() {

            const length =
                descriptionInput.value.length;

            characterCounter.textContent =
                length + "/1000";

        }



        /* =================================================
           OPEN EVENTS
        ================================================= */

        openButton.addEventListener(
            "click",
            openModal
        );


        openButton.addEventListener(
            "keydown",
            function (event) {

                if (
                    event.key === "Enter" ||
                    event.key === " "
                ) {

                    event.preventDefault();

                    openModal();

                }

            }
        );



        /* =================================================
           CLOSE EVENTS
        ================================================= */

        closeButton.addEventListener(
            "click",
            closeModal
        );


        document.addEventListener(
            "keydown",
            function (event) {

                if (
                    event.key === "Escape" &&
                    modal.classList.contains("active")
                ) {

                    closeModal();

                }

            }
        );



        /* =================================================
           INPUT EVENTS
        ================================================= */

        chargesInput.addEventListener(
            "input",
            updateSubmitButton
        );


        descriptionInput.addEventListener(
            "input",
            function () {

                updateCharacterCounter();

                updateSubmitButton();

            }
        );



        /* =================================================
           FORM SUBMIT
        ================================================== */

        form.addEventListener(
            "submit",
            function () {

                submitButton.disabled = true;

                submitButton.innerHTML =
                    '<i class="bi bi-hourglass-split"></i> ' +
                    'Clearing...';

            }
        );



        /* =================================================
           INITIAL STATE
        ================================================== */

        updateCharacterCounter();

        updateSubmitButton();

    }



    /* =====================================================
       DOM READY
    ====================================================== */

    if (
        document.readyState === "loading"
    ) {

        document.addEventListener(
            "DOMContentLoaded",
            initializeMaintenanceClearComposer
        );

    } else {

        initializeMaintenanceClearComposer();

    }

})();

</script>


<% } %>