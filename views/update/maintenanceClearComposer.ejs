<% /*
============================================================
MAINTENANCE CLEAR COMPOSER

FILE:
    views/update/maintenanceClearComposer.ejs

PURPOSE:
    Compact status-style card for recording completed
    maintenance work on the CURRENT dairy asset.

CARD STANDARD:
    Matches maintComposer.ejs / create.ejs:

        Desktop:
            112px × 155px

        Mobile:
            108px × 150px

AUTHORIZED USER:
    admin

CONDITION:
    Dairy must have:
        code === undefined OR null
        AND
        needsMaintenance === true

FORM:
    POST /dairy/:id/maintenance/clear
============================================================
*/ %>


<% if (
    dairy &&
    (
        dairy.code === null ||
        dairy.code === undefined
    ) &&
    dairy.needsMaintenance === true &&
    user &&
    user.role === "admin"
) { %>


<!-- =========================================================
     MAINTENANCE CLEAR CARD
========================================================= -->

<section
    class="maint-clear-composer"
    aria-label="Clear maintenance"
>


    <button
        type="button"
        id="openMaintClearComposer"
        class="maint-clear-composer__card"
        aria-label="Record completed maintenance for <%= dairy.name %>"
    >


        <!-- =================================================
             ICON
        ================================================== -->

        <span
            class="maint-clear-composer__icon"
            aria-hidden="true"
        >

            <i class="bi bi-check-circle"></i>

        </span>


        <!-- =================================================
             LABEL
        ================================================== -->

        <span class="maint-clear-composer__label">
            Clear Maintenance
        </span>


        <!-- =================================================
             TARGET
        ================================================== -->

        <span class="maint-clear-composer__target">

            <%= dairy.name %>

        </span>


    </button>

</section>



<!-- =========================================================
     FULL-SCREEN MAINTENANCE CLEAR MODAL
========================================================= -->

<div
    id="maintClearModal"
    class="maint-clear-modal"
    aria-hidden="true"
>


    <div class="maint-clear-modal__content">


        <!-- =================================================
             MODAL HEADER
        ================================================== -->

        <header class="maint-clear-modal__header">


            <button
                type="button"
                id="closeMaintClearModal"
                class="maint-clear-modal__back"
                aria-label="Close maintenance clearance"
            >

                <span aria-hidden="true">
                    &#8592;
                </span>

            </button>


            <div class="maint-clear-modal__title">

                <strong>
                    Clear Maintenance
                </strong>

                <span>
                    <%= dairy.name %>
                </span>

            </div>


            <div
                class="maint-clear-modal__spacer"
                aria-hidden="true"
            ></div>


        </header>



        <!-- =================================================
             MODAL BODY
        ================================================== -->

        <main class="maint-clear-modal__body">


            <div class="maint-clear-modal__fields">


                <!-- =================================================
                     QUESTION
                ================================================== -->

                <div class="maint-clear-question">

                    <strong>
                        <%= user.name.split(" ")[0] %>
                    </strong>,

                    has the maintenance work on this facility
                    been completed?

                </div>



                <!-- =================================================
                     TARGET
                ================================================== -->

                <section
                    class="maint-clear-target"
                    aria-label="Maintenance target"
                >


                    <% if (
                        dairy.profileImage &&
                        dairy.profileImage.trim() !== ""
                    ) { %>

                        <img
                            src="<%= dairy.profileImage %>"
                            class="maint-clear-target__image"
                            alt="<%= dairy.name %>"
                        >

                    <% } else { %>

                        <div
                            class="maint-clear-target__placeholder"
                            aria-hidden="true"
                        >

                            <i class="bi bi-tools"></i>

                        </div>

                    <% } %>


                    <div class="maint-clear-target__info">

                        <span>
                            Maintenance currently required
                        </span>

                        <strong>
                            <%= dairy.name %>
                        </strong>

                    </div>


                </section>



                <!-- =================================================
                     STATUS NOTICE
                ================================================== -->

                <section
                    class="maint-clear-status"
                    aria-label="Maintenance status"
                >


                    <span
                        class="maint-clear-status__icon"
                        aria-hidden="true"
                    >
                        ⚠️
                    </span>


                    <div>

                        <strong>
                            Maintenance in progress
                        </strong>

                        <span>
                            Record the completed work below to
                            clear the maintenance status.
                        </span>

                    </div>


                </section>



                <!-- =================================================
                     CLEAR MAINTENANCE FORM
                ================================================== -->

                <form
                    id="maintClearForm"
                    class="maint-clear-form"
                    action="/dairy/<%= dairy._id %>/maintenance/clear"
                    method="POST"
                    autocomplete="off"
                >


                    <!-- =============================================
                         CHARGES
                    ============================================== -->

                    <div class="maint-clear-field">

                        <label
                            for="maintClearCharges"
                        >
                            Charges incurred
                        </label>


                        <div class="maint-clear-money-input">

                            <span>
                                KES
                            </span>


                            <input
                                type="number"
                                id="maintClearCharges"
                                name="charges"
                                min="0"
                                step="0.01"
                                inputmode="decimal"
                                placeholder="0.00"
                                required
                            >

                        </div>

                    </div>



                    <!-- =============================================
                         DESCRIPTION
                    ============================================== -->

                    <div class="maint-clear-field">

                        <label
                            for="maintClearDescription"
                        >
                            Work completed
                        </label>


                        <textarea
                            id="maintClearDescription"
                            name="description"
                            maxlength="1000"
                            rows="5"
                            placeholder="Describe the maintenance work completed..."
                            required
                        ></textarea>


                        <span
                            id="maintClearCharacterCounter"
                            class="maint-clear-character-counter"
                        >
                            0/1000
                        </span>

                    </div>



                    <!-- =============================================
                         SUBMIT
                    ============================================== -->

                    <button
                        type="submit"
                        id="submitMaintClearButton"
                        class="maint-clear-submit-button"
                        disabled
                    >

                        <i
                            class="bi bi-check-circle"
                            aria-hidden="true"
                        ></i>

                        <span>
                            Clear Maintenance
                        </span>

                    </button>


                </form>


            </div>

        </main>


    </div>

</div>



<!-- =========================================================
     CSS
========================================================= -->

<style>

/* =========================================================
   ROOT
========================================================= */

.maint-clear-composer,
.maint-clear-composer *,
.maint-clear-modal,
.maint-clear-modal * {

    box-sizing: border-box;

}



/* =========================================================
   REAL UPDATE CARD
========================================================= */

.maint-clear-composer {

    width: 112px;

    flex: 0 0 112px;

    margin: 0 0 16px;

}


.maint-clear-composer__card {

    position: relative;

    width: 112px;
    height: 155px;

    padding: 0;

    display: flex;

    flex-direction: column;

    align-items: center;
    justify-content: center;

    gap: 7px;

    overflow: hidden;

    border: 1px solid #dce7e0;

    border-radius: 15px;

    background:
        linear-gradient(
            145deg,
            #ffffff,
            #f3f8f5
        );

    color: #198754;

    font-family: inherit;

    cursor: pointer;

    text-align: center;

    transition:
        transform .15s ease,
        border-color .15s ease,
        box-shadow .15s ease;

}


.maint-clear-composer__card:hover {

    border-color: #198754;

    box-shadow:
        0 5px 15px
        rgba(25, 135, 84, .10);

}


.maint-clear-composer__card:active {

    transform: scale(.95);

}


.maint-clear-composer__card:focus-visible {

    outline: 2px solid #198754;

    outline-offset: 2px;

}



/* =========================================================
   ICON
========================================================= */

.maint-clear-composer__icon {

    width: 48px;
    height: 48px;

    display: flex;

    align-items: center;
    justify-content: center;

    border-radius: 50%;

    background: #198754;

    color: #ffffff;

    font-size: 22px;

    line-height: 1;

    box-shadow:
        0 4px 12px
        rgba(25, 135, 84, .20);

}


.maint-clear-composer__icon i {

    line-height: 1;

}



/* =========================================================
   CARD LABEL
========================================================= */

.maint-clear-composer__label {

    display: block;

    max-width: 94px;

    color: #26322b;

    font-size: 12px;

    font-weight: 700;

    line-height: 1.2;

}


.maint-clear-composer__target {

    display: block;

    max-width: 88px;

    overflow: hidden;

    color: #8a928d;

    font-size: 10px;

    line-height: 1.25;

    white-space: nowrap;

    text-overflow: ellipsis;

}



/* =========================================================
   FULL-SCREEN MODAL
========================================================= */

.maint-clear-modal {

    position: fixed;

    inset: 0;

    width: 100vw;
    height: 100dvh;

    z-index: 99999;

    display: none;

    overflow: hidden;

    background: #ffffff;

}


.maint-clear-modal.active {

    display: block;

}



/* =========================================================
   MODAL CONTENT
========================================================= */

.maint-clear-modal__content {

    width: 100%;
    height: 100%;

    display: flex;

    flex-direction: column;

    background: #ffffff;

}



/* =========================================================
   MODAL HEADER
========================================================= */

.maint-clear-modal__header {

    flex: 0 0 64px;

    width: 100%;
    height: 64px;

    display: flex;

    align-items: center;

    padding: 0 15px;

    border-bottom: 1px solid #e7ede9;

    background: #ffffff;

}


.maint-clear-modal__back {

    width: 44px;
    height: 44px;

    flex: 0 0 44px;

    display: flex;

    align-items: center;
    justify-content: center;

    padding: 0;

    border: none;

    border-radius: 50%;

    background: transparent;

    color: #198754;

    font-size: 27px;

    line-height: 1;

    cursor: pointer;

}


.maint-clear-modal__back:active {

    background: #edf7f1;

}


.maint-clear-modal__back:focus-visible {

    outline: 2px solid #198754;

    outline-offset: 2px;

}



/* =========================================================
   MODAL TITLE
========================================================= */

.maint-clear-modal__title {

    min-width: 0;

    margin-left: 8px;

    display: flex;

    flex-direction: column;

    line-height: 1.25;

}


.maint-clear-modal__title strong {

    color: #202520;

    font-size: 17px;

}


.maint-clear-modal__title span {

    max-width: 72vw;

    margin-top: 2px;

    overflow: hidden;

    color: #7b847e;

    font-size: 12px;

    white-space: nowrap;

    text-overflow: ellipsis;

}


.maint-clear-modal__spacer {

    flex: 1;

}



/* =========================================================
   MODAL BODY
========================================================= */

.maint-clear-modal__body {

    flex: 1 1 auto;

    min-height: 0;

    overflow-y: auto;

    padding: 20px;

}


.maint-clear-modal__fields {

    width: 100%;

    max-width: 700px;

    margin: 0 auto;

}



/* =========================================================
   QUESTION
========================================================= */

.maint-clear-question {

    margin-bottom: 20px;

    color: #202520;

    font-size: 20px;

    line-height: 1.45;

}


.maint-clear-question strong {

    color: #198754;

}



/* =========================================================
   TARGET
========================================================= */

.maint-clear-target {

    width: 100%;

    display: flex;

    align-items: center;

    gap: 12px;

    margin-bottom: 16px;

    padding: 12px 13px;

    border: 1px solid #dcebe2;

    border-radius: 13px;

    background: #f6faf7;

}


.maint-clear-target__image,
.maint-clear-target__placeholder {

    width: 52px;
    height: 52px;

    flex: 0 0 52px;

    overflow: hidden;

    border-radius: 50%;

}


.maint-clear-target__image {

    display: block;

    object-fit: cover;

}


.maint-clear-target__placeholder {

    display: flex;

    align-items: center;
    justify-content: center;

    background: #198754;

    color: #ffffff;

    font-size: 20px;

}


.maint-clear-target__info {

    min-width: 0;

    display: flex;

    flex-direction: column;

}


.maint-clear-target__info span {

    color: #78827c;

    font-size: 10px;

}


.maint-clear-target__info strong {

    margin-top: 3px;

    overflow: hidden;

    color: #235d3e;

    font-size: 14px;

    white-space: nowrap;

    text-overflow: ellipsis;

}



/* =========================================================
   STATUS NOTICE
========================================================= */

.maint-clear-status {

    display: flex;

    align-items: flex-start;

    gap: 11px;

    width: 100%;

    margin-bottom: 24px;

    padding: 13px;

    border: 1px solid #fde2e2;

    border-radius: 13px;

    background: #fff7f7;

}


.maint-clear-status__icon {

    width: 30px;
    height: 30px;

    flex: 0 0 30px;

    display: flex;

    align-items: center;
    justify-content: center;

    border-radius: 50%;

    background: #fee2e2;

    font-size: 15px;

}


.maint-clear-status > div {

    min-width: 0;

    display: flex;

    flex-direction: column;

}


.maint-clear-status strong {

    color: #991b1b;

    font-size: 13px;

}


.maint-clear-status span {

    margin-top: 3px;

    color: #7f1d1d;

    font-size: 12px;

    line-height: 1.4;

}



/* =========================================================
   FORM
========================================================= */

.maint-clear-form {

    width: 100%;

    margin: 0;

}


.maint-clear-field {

    position: relative;

    width: 100%;

    margin-bottom: 20px;

}


.maint-clear-field label {

    display: block;

    margin-bottom: 7px;

    color: #6d7771;

    font-size: 11px;

    font-weight: 700;

    letter-spacing: .04em;

    text-transform: uppercase;

}



/* =========================================================
   CHARGES
========================================================= */

.maint-clear-money-input {

    width: 100%;
    height: 48px;

    display: flex;

    align-items: center;

    overflow: hidden;

    border: 1px solid #e0e7e2;

    border-radius: 12px;

    background: #f8faf8;

}


.maint-clear-money-input:focus-within {

    border-color: #198754;

    background: #ffffff;

    box-shadow:
        0 0 0 3px
        rgba(25, 135, 84, .10);

}


.maint-clear-money-input span {

    height: 100%;

    display: flex;

    align-items: center;

    padding: 0 13px;

    border-right: 1px solid #d6e0d9;

    background: #eef5f0;

    color: #198754;

    font-size: 12px;

    font-weight: 800;

}


.maint-clear-money-input input {

    flex: 1;

    width: 100%;
    min-width: 0;

    height: 100%;

    padding: 0 12px;

    border: none;

    outline: none;

    background: transparent;

    color: #202520;

    font-family: inherit;

    font-size: 15px;

}



/* =========================================================
   DESCRIPTION
========================================================= */

.maint-clear-field textarea {

    width: 100%;

    min-height: 130px;
    max-height: 300px;

    padding: 13px 14px 30px;

    resize: vertical;

    border: 1px solid #e0e7e2;

    border-radius: 12px;

    outline: none;

    background: #f8faf8;

    color: #202520;

    font-family: inherit;

    font-size: 15px;

    line-height: 1.5;

}


.maint-clear-field textarea:focus {

    border-color: #198754;

    background: #ffffff;

    box-shadow:
        0 0 0 3px
        rgba(25, 135, 84, .10);

}



/* =========================================================
   CHARACTER COUNTER
========================================================= */

.maint-clear-character-counter {

    position: absolute;

    right: 11px;

    bottom: 9px;

    padding-left: 3px;

    background: #f8faf8;

    color: #8a928d;

    font-size: 10px;

    pointer-events: none;

}


.maint-clear-field textarea:focus
~ .maint-clear-character-counter {

    background: #ffffff;

}



/* =========================================================
   SUBMIT
========================================================= */

.maint-clear-submit-button {

    width: 100%;

    min-height: 50px;

    display: flex;

    align-items: center;
    justify-content: center;

    gap: 8px;

    padding: 10px 14px;

    border: none;

    border-radius: 13px;

    background: #198754;

    color: #ffffff;

    font-family: inherit;

    font-size: 14px;

    font-weight: 700;

    cursor: pointer;

    transition:
        background .2s ease,
        transform .15s ease,
        opacity .15s ease;

}


.maint-clear-submit-button:not(:disabled):hover {

    background: #146c43;

}


.maint-clear-submit-button:not(:disabled):active {

    transform: scale(.99);

}


.maint-clear-submit-button:disabled {

    background: #b8c2bc;

    cursor: default;

}


.maint-clear-submit-button i {

    font-size: 16px;

}



/* =========================================================
   MOBILE CARD
========================================================= */

@media (max-width: 600px) {

    .maint-clear-composer {

        width: 108px;

        flex-basis: 108px;

    }


    .maint-clear-composer__card {

        width: 108px;

        height: 150px;

    }


    .maint-clear-composer__icon {

        width: 46px;
        height: 46px;

        font-size: 21px;

    }


    .maint-clear-composer__label {

        font-size: 12px;

    }


    .maint-clear-modal__header {

        flex-basis: 60px;

        height: 60px;

        padding: 0 10px;

    }


    .maint-clear-modal__body {

        padding: 14px;

    }


    .maint-clear-question {

        font-size: 19px;

    }

}



/* =========================================================
   SMALL PHONES
========================================================= */

@media (max-width: 380px) {

    .maint-clear-modal__title span {

        display: none;

    }


    .maint-clear-modal__body {

        padding: 10px;

    }

}

</style>



<!-- =========================================================
     JAVASCRIPT
========================================================= -->

<script>

(function () {

    "use strict";


    function initializeMaintenanceClearComposer() {


        /* =====================================================
           ELEMENTS
        ====================================================== */

        const modal =
            document.getElementById(
                "maintClearModal"
            );


        const openButton =
            document.getElementById(
                "openMaintClearComposer"
            );


        const closeButton =
            document.getElementById(
                "closeMaintClearModal"
            );


        const chargesInput =
            document.getElementById(
                "maintClearCharges"
            );


        const descriptionInput =
            document.getElementById(
                "maintClearDescription"
            );


        const characterCounter =
            document.getElementById(
                "maintClearCharacterCounter"
            );


        const submitButton =
            document.getElementById(
                "submitMaintClearButton"
            );


        const form =
            document.getElementById(
                "maintClearForm"
            );



        /* =====================================================
           SAFETY CHECK
        ====================================================== */

        if (
            !modal ||
            !openButton ||
            !closeButton ||
            !chargesInput ||
            !descriptionInput ||
            !characterCounter ||
            !submitButton ||
            !form
        ) {

            console.error(
                "MAINTENANCECLEARCOMPOSER.EJS: Required elements are missing."
            );

            return;

        }



        /* =====================================================
           OPEN MODAL
        ====================================================== */

        function openModal() {

            modal.classList.add(
                "active"
            );


            modal.setAttribute(
                "aria-hidden",
                "false"
            );


            document.body.style.overflow =
                "hidden";


            window.setTimeout(
                function () {

                    chargesInput.focus();

                },
                100
            );

        }



        /* =====================================================
           CLOSE MODAL
        ====================================================== */

        function closeModal() {

            modal.classList.remove(
                "active"
            );


            modal.setAttribute(
                "aria-hidden",
                "true"
            );


            document.body.style.overflow =
                "";

        }



        /* =====================================================
           FORM VALIDATION
        ====================================================== */

        function updateSubmitButton() {

            const charges =
                chargesInput.value.trim();


            const description =
                descriptionInput.value.trim();


            const numericCharges =
                Number(charges);


            const validCharges =
                charges !== "" &&
                Number.isFinite(
                    numericCharges
                ) &&
                numericCharges >= 0;


            const validDescription =
                description.length > 0;


            submitButton.disabled =
                !(
                    validCharges &&
                    validDescription
                );

        }



        /* =====================================================
           CHARACTER COUNTER
        ====================================================== */

        function updateCharacterCounter() {

            characterCounter.textContent =
                descriptionInput.value.length +
                "/1000";

        }



        /* =====================================================
           OPEN
        ====================================================== */

        openButton.addEventListener(
            "click",
            openModal
        );



        /* =====================================================
           CLOSE
        ====================================================== */

        closeButton.addEventListener(
            "click",
            closeModal
        );



        /* =====================================================
           ESCAPE
        ====================================================== */

        document.addEventListener(
            "keydown",
            function (event) {

                if (
                    event.key === "Escape" &&
                    modal.classList.contains(
                        "active"
                    )
                ) {

                    closeModal();

                }

            }
        );



        /* =====================================================
           CHARGES
        ====================================================== */

        chargesInput.addEventListener(
            "input",
            updateSubmitButton
        );



        /* =====================================================
           DESCRIPTION
        ====================================================== */

        descriptionInput.addEventListener(
            "input",
            function () {

                updateCharacterCounter();

                updateSubmitButton();

            }
        );



        /* =====================================================
           FORM SUBMIT
        ====================================================== */

        form.addEventListener(
            "submit",
            function () {

                submitButton.disabled =
                    true;


                submitButton.innerHTML =
                    '<i class="bi bi-hourglass-split"></i>' +
                    '<span>Clearing...</span>';

            }
        );



        /* =====================================================
           INITIAL STATE
        ====================================================== */

        updateCharacterCounter();

        updateSubmitButton();

    }



    /* =========================================================
       DOM READY
    ========================================================= */

    if (
        document.readyState === "loading"
    ) {

        document.addEventListener(
            "DOMContentLoaded",
            initializeMaintenanceClearComposer
        );

    } else {

        initializeMaintenanceClearComposer();

    }

})();

</script>


<% } %>