<%
/* ==========================================================
   FEMALE ANIMAL BOOLEAN CARDS

   FILE:
       views/update/boolean.ejs

   PURPOSE:
       INCLUDE COMPONENT.

       This file is NOT rendered independently.

       Parent:
           views/update.ejs

   DISPLAY:
   ----------------------------------------------------------
       FIRST CARD:
           Boolean selector.

           Tapping it opens a dropdown containing all
           Boolean fields supplied by the controller.

       REMAINING CARDS:
           Eligible female animals.

   ELIGIBILITY:
   ----------------------------------------------------------
       Positive EVEN code

       OR

       gender === "female"

   TOGGLE ROUTE:
   ----------------------------------------------------------
       PUT /dairy/:animalId/boolean

   BODY:
       {
           field: "...",
           value: true
       }

========================================================== */


/* ==========================================================
   SAFE DATA
========================================================== */

const booleanAnimals =
    Array.isArray(animals)
        ? animals
        : (
            Array.isArray(booleanAnimalsData)
                ? booleanAnimalsData
                : []
        );


const booleanFields =
    Array.isArray(fields)
        ? fields
        : (
            Array.isArray(booleanFieldsData)
                ? booleanFieldsData
                : []
        );


/* ==========================================================
   FILTER ELIGIBLE ANIMALS
========================================================== */

const eligibleAnimals =
    booleanAnimals.filter(
        function (animal) {

            if (!animal) {

                return false;

            }


            const numericCode =
                Number(
                    animal.code
                );


            const positiveEvenCode =
                Number.isInteger(
                    numericCode
                ) &&
                numericCode > 0 &&
                numericCode % 2 === 0;


            const isFemale =
                String(
                    animal.gender || ""
                )
                .trim()
                .toLowerCase() === "female";


            return (
                positiveEvenCode ||
                isFemale
            );

        }
    );

%>


<section
    class="boolean-animal-strip"
    aria-label="Female animal boolean management"
>


    <!-- ======================================================
         HEADER
    ======================================================= -->

    <div class="boolean-animal-header">

        <div class="boolean-animal-heading">

            <span class="boolean-animal-kicker">
                ANIMAL MANAGEMENT
            </span>

            <strong>
                Female Animals
            </strong>

        </div>


        <div class="boolean-animal-description">

            Select a property, then tap an animal to update it.

        </div>

    </div>



    <!-- ======================================================
         HORIZONTAL CARD STRIP
    ======================================================= -->

    <div
        class="boolean-animal-scroll"
        role="list"
        aria-label="Female animals"
    >


        <!-- ==================================================
             BOOLEAN SELECTOR CARD
        =================================================== -->

        <div
            class="boolean-animal-card boolean-selector-card"
            role="listitem"
        >

            <div class="boolean-card-accent"></div>


            <button
                type="button"
                class="boolean-selector-button"
                id="booleanSelectorButton"
                aria-expanded="false"
                aria-controls="booleanFieldDropdown"
            >

                <span class="boolean-selector-icon">

                    <i class="fas fa-sliders"></i>

                </span>


                <span class="boolean-selector-title">
                    Boolean
                </span>


                <span class="boolean-selector-subtitle">
                    Select property
                </span>


                <span class="boolean-selector-arrow">
                    <i class="fas fa-chevron-down"></i>
                </span>

            </button>


            <!-- ==============================================
                 DROPDOWN
            =============================================== -->

            <div
                id="booleanFieldDropdown"
                class="boolean-field-dropdown"
                hidden
            >

                <div class="boolean-dropdown-title">
                    Boolean Fields
                </div>


                <% if (booleanFields.length > 0) { %>

                    <div class="boolean-field-list">

                        <% booleanFields.forEach(
                            function (field) {
                        %>

                            <button
                                type="button"
                                class="boolean-field-option"
                                data-field="<%= field %>"
                            >

                                <span>
                                    <%= field %>
                                </span>

                                <i
                                    class="fas fa-check"
                                    aria-hidden="true"
                                ></i>

                            </button>

                        <% }); %>

                    </div>

                <% } else { %>

                    <div class="boolean-no-fields">

                        No Boolean fields available.

                    </div>

                <% } %>

            </div>

        </div>



        <!-- ==================================================
             ELIGIBLE ANIMAL CARDS
        =================================================== -->

        <% eligibleAnimals.forEach(
            function (animal) {

                if (
                    !animal ||
                    !animal._id
                ) {

                    return;

                }


                const animalName =
                    String(
                        animal.name ||
                        "Unnamed Animal"
                    );


                const animalImage =
                    animal.displayImage ||
                    animal.profileImage ||
                    (
                        "https://ui-avatars.com/api/?name=" +
                        encodeURIComponent(
                            animalName
                        ) +
                        "&background=e8f0e5&color=47733f"
                    );


                const animalCode =
                    Number(
                        animal.code
                    );


                const animalGender =
                    animal.gender
                        ? String(
                            animal.gender
                        )
                        : "Female";

            %>


            <!-- ==============================================
                 ANIMAL CARD
            =============================================== -->

            <div
                class="boolean-animal-card animal-boolean-card"
                role="listitem"
                data-animal-id="<%= animal._id %>"
            >

                <div class="boolean-card-accent"></div>


                <!-- ==========================================
                     IMAGE
                =========================================== -->

                <div class="boolean-animal-image-wrap">

                    <img
                        src="<%= animalImage %>"
                        alt="<%= animalName %>"
                        class="boolean-animal-image"
                        loading="lazy"
                    >


                    <div
                        class="boolean-animal-image-overlay"
                        aria-hidden="true"
                    ></div>


                    <div class="boolean-animal-badge">

                        <i class="fas fa-venus"></i>

                        <span>
                            FEMALE
                        </span>

                    </div>

                </div>



                <!-- ==========================================
                     CONTENT
                =========================================== -->

                <div class="boolean-animal-content">


                    <div class="boolean-animal-name">

                        <%= animalName %>

                    </div>


                    <div class="boolean-animal-meta">

                        <span>
                            <i class="fas fa-hashtag"></i>
                            <%= animalCode %>
                        </span>


                        <span>
                            <i class="fas fa-venus"></i>
                            <%= animalGender %>
                        </span>

                    </div>


                    <!-- ======================================
                         BOOLEAN VALUE

                         Initially disabled until a Boolean
                         field is selected.
                    ======================================= -->

                    <button
                        type="button"
                        class="boolean-toggle"
                        disabled
                        data-animal-id="<%= animal._id %>"
                        aria-pressed="false"
                    >

                        <span class="boolean-toggle-label">
                            Select property
                        </span>


                        <span class="boolean-toggle-switch">

                            <span class="boolean-toggle-knob"></span>

                        </span>

                    </button>

                </div>


                <div
                    class="boolean-card-bottom-line"
                    aria-hidden="true"
                ></div>

            </div>


        <% }); %>


    </div>

</section>



<style>

