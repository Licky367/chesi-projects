<%
/* =========================================================.
   FEMALE ANIMAL CARDS

   FILE:
       views/update/boolean.ejs

   PURPOSE:
       Display eligible Dairy animal records as horizontal,
       left/right scrollable cards.

   ANIMAL RULE:
   ----------------------------------------------------------
       An animal must have:

           code > 0

       AND:

           code is EVEN
           OR
           gender === "female"

   FIRST CARD:
   ----------------------------------------------------------
       Filter / boolean control card.

       Tapping the first card opens a dropdown containing:

           All
           Female
           Not Female

   ANIMAL TOGGLE:
   ----------------------------------------------------------
       Every animal card contains a toggle controlling:

           female = true / false

   IMPORTANT:
   ----------------------------------------------------------
       The frontend does NOT infer female from the code.

       The `female` boolean is authoritative.
========================================================== */


/* ==========================================================
   SOURCE DATA
========================================================== */

const sourceAnimals =
    Array.isArray(dairies)
        ? dairies
        : (
            Array.isArray(animals)
                ? animals
                : []
        );


/* ==========================================================
   ELIGIBLE ANIMALS
========================================================== */

const animalRecords =
    sourceAnimals.filter(function (item) {

        if (!item) {

            return false;

        }


        if (!item._id) {

            return false;

        }


        const code =
            Number(item.code);


        if (
            !Number.isInteger(code) ||
            code <= 0
        ) {

            return false;

        }


        const gender =
            String(
                item.gender ||
                ""
            ).trim().toLowerCase();


        return (
            code % 2 === 0 ||
            gender === "female"
        );

    });

%>


<section
    class="admin-animal-strip"
    aria-label="Female animal management"
>


    <!-- ======================================================
         HEADER
    ======================================================= -->

    <div class="admin-animal-strip-header">

        <div class="admin-animal-heading">

            <span class="admin-animal-kicker">
                ANIMAL MANAGEMENT
            </span>

            <strong>
                Female Animals
            </strong>

        </div>


        <div class="admin-animal-description">

            Manage the female status of eligible dairy animals.

        </div>

    </div>



    <!-- ======================================================
         HORIZONTAL CARD SCROLL
    ======================================================= -->

    <div
        class="admin-animal-scroll"
        role="list"
        aria-label="Dairy animals"
    >


        <!-- ==================================================
             FIRST CARD — FILTER / BOOLEAN CONTROL
        =================================================== -->

        <div
            class="admin-animal-card admin-animal-filter-card"
            role="listitem"
        >


            <!-- ACCENT -->

            <div
                class="admin-animal-filter-accent"
                aria-hidden="true"
            ></div>



            <!-- FILTER HEADER -->

            <button
                type="button"
                class="admin-animal-filter-trigger"
                aria-expanded="false"
                aria-controls="female-filter-menu"
            >


                <div class="admin-animal-filter-icon">

                    <i class="fas fa-venus"></i>

                </div>


                <div class="admin-animal-filter-heading">

                    <span class="admin-animal-filter-kicker">
                        FILTER
                    </span>

                    <strong>
                        Female
                    </strong>

                </div>


                <div class="admin-animal-filter-chevron">

                    <i class="fas fa-chevron-down"></i>

                </div>

            </button>



            <!-- CURRENT FILTER -->

            <div class="admin-animal-filter-current">

                <span
                    class="admin-animal-filter-status-dot"
                    aria-hidden="true"
                ></span>

                <span
                    id="female-filter-label"
                >
                    All Animals
                </span>

            </div>



            <!-- ==================================================
                 DROPDOWN
            =================================================== -->

            <div
                id="female-filter-menu"
                class="admin-animal-filter-menu"
                hidden
            >


                <button
                    type="button"
                    class="admin-animal-filter-option active"
                    data-filter="all"
                >

                    <span class="admin-animal-option-icon">

                        <i class="fas fa-layer-group"></i>

                    </span>

                    <span class="admin-animal-option-text">

                        <strong>
                            All
                        </strong>

                        <small>
                            Show all eligible animals
                        </small>

                    </span>

                    <span class="admin-animal-option-check">

                        <i class="fas fa-check"></i>

                    </span>

                </button>



                <button
                    type="button"
                    class="admin-animal-filter-option"
                    data-filter="female"
                >

                    <span class="admin-animal-option-icon">

                        <i class="fas fa-venus"></i>

                    </span>

                    <span class="admin-animal-option-text">

                        <strong>
                            Female
                        </strong>

                        <small>
                            Show female animals
                        </small>

                    </span>

                    <span class="admin-animal-option-check">

                        <i class="fas fa-check"></i>

                    </span>

                </button>



                <button
                    type="button"
                    class="admin-animal-filter-option"
                    data-filter="not-female"
                >

                    <span class="admin-animal-option-icon">

                        <i class="fas fa-venus-mars"></i>

                    </span>

                    <span class="admin-animal-option-text">

                        <strong>
                            Not Female
                        </strong>

                        <small>
                            Show animals not marked female
                        </small>

                    </span>

                    <span class="admin-animal-option-check">

                        <i class="fas fa-check"></i>

                    </span>

                </button>


            </div>

        </div>



        <!-- ==================================================
             ANIMAL CARDS
        =================================================== -->

        <% animalRecords.forEach(function (animal) { %>

            <%

                const animalId =
                    String(
                        animal._id
                    );


                const animalName =
                    String(
                        animal.name ||
                        "Unnamed Animal"
                    );


                const animalCode =
                    Number(
                        animal.code
                    );


                const animalGender =
                    String(
                        animal.gender ||
                        ""
                    )
                    .trim()
                    .toLowerCase();


                /*
                 * FEMALE BOOLEAN
                 *
                 * The actual boolean is authoritative.
                 */

                const isFemale =
                    animal.female === true;


                /*
                 * IMAGE
                 */

                const animalImage =
                    animal.displayImage ||
                    animal.profileImage ||
                    (
                        "https://ui-avatars.com/api/?name=" +
                        encodeURIComponent(
                            animalName
                        ) +
                        "&background=e8f0e5&color=47733f"
                    );


                /*
                 * DISPLAY TYPE
                 */

                const animalType =
                    animal.type
                        ? String(
                            animal.type
                        )
                        : "Dairy Animal";

            %>


            <article
                class="
                    admin-animal-card
                    admin-animal-record-card
                "
                role="listitem"
                data-animal-id="<%= animalId %>"
                data-female="<%= isFemale ? 'true' : 'false' %>"
            >


                <!-- ==================================================
                     LEFT ACCENT
                =================================================== -->

                <div
                    class="admin-animal-card-accent"
                    aria-hidden="true"
                ></div>



                <!-- ==================================================
                     IMAGE
                =================================================== -->

                <div class="admin-animal-image-wrap">

                    <img
                        src="<%= animalImage %>"
                        alt="<%= animalName %>"
                        class="admin-animal-image"
                        loading="lazy"
                    >


                    <div
                        class="admin-animal-image-overlay"
                        aria-hidden="true"
                    ></div>



                    <!-- ANIMAL BADGE -->

                    <div class="admin-animal-badge">

                        <i class="fas fa-cow"></i>

                        <span>
                            ANIMAL
                        </span>

                    </div>



                    <!-- CODE -->

                    <div class="admin-animal-code-badge">

                        #<%= animalCode %>

                    </div>

                </div>



                <!-- ==================================================
                     CONTENT
                =================================================== -->

                <div class="admin-animal-content">


                    <!-- NAME -->

                    <div class="admin-animal-name">

                        <%= animalName %>

                    </div>



                    <!-- TYPE -->

                    <div class="admin-animal-type">

                        <span class="admin-animal-type-icon">

                            <i class="fas fa-cow"></i>

                        </span>

                        <span>
                            <%= animalType %>
                        </span>

                    </div>



                    <!-- ==================================================
                         FEMALE TOGGLE
                    =================================================== -->

                    <div class="admin-animal-female-row">


                        <div class="admin-animal-female-label">

                            <span class="admin-animal-female-icon">

                                <i class="fas fa-venus"></i>

                            </span>


                            <span>
                                Female
                            </span>

                        </div>



                        <label
                            class="admin-animal-switch"
                            title="Toggle female status"
                        >

                            <input
                                type="checkbox"
                                class="female-toggle"
                                data-animal-id="<%= animalId %>"
                                <%= isFemale ? "checked" : "" %>
                            >

                            <span
                                class="admin-animal-slider"
                            ></span>

                        </label>


                    </div>



                    <!-- STATUS -->

                    <div
                        class="admin-animal-female-status
                        <%= isFemale
                            ? 'is-female'
                            : 'is-not-female'
                        %>"
                    >

                        <span class="admin-animal-status-dot"></span>

                        <span class="female-status-text">

                            <%= isFemale
                                ? "Marked Female"
                                : "Not Female"
                            %>

                        </span>

                    </div>


                </div>



                <!-- BOTTOM LINE -->

                <div
                    class="admin-animal-bottom-line"
                    aria-hidden="true"
                ></div>

            </article>

        <% }); %>


    </div>

</section>



