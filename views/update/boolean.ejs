        height:
            187px;

        border-radius:
            16px;

    }


    .admin-animal-image-wrap {

        height:
            100px;

        flex-basis:
            100px;

    }


    .admin-animal-content {

        padding:
            7px
            8px
            6px
            10px;

    }


    .admin-animal-name {

        font-size:
            12px;

        line-height:
            15px;

    }


    .admin-animal-filter-icon {

        width:
            34px;

        height:
            34px;

        flex-basis:
            34px;

    }

}


/* ==========================================================
   VERY SMALL PHONES
========================================================== */

@media (max-width: 380px) {

    .admin-animal-card {

        flex-basis:
            110px;

        width:
            110px;

        height:
            181px;

    }


    .admin-animal-image-wrap {

        height:
            96px;

        flex-basis:
            96px;

    }


    .admin-animal-name {

        font-size:
            11.5px;

        line-height:
            14px;

    }

}

</style>



<script>

/* ==========================================================
   FEMALE ANIMAL CARD CONTROLS
========================================================== */

(function () {

    "use strict";


    /* ======================================================
       ELEMENTS
    ====================================================== */

    const filterCard =
        document.querySelector(
            ".admin-animal-filter-card"
        );


    const filterTrigger =
        document.querySelector(
            ".admin-animal-filter-trigger"
        );


    const filterMenu =
        document.querySelector(
            "#female-filter-menu"
        );


    const filterLabel =
        document.querySelector(
            "#female-filter-label"
        );


    const filterOptions =
        document.querySelectorAll(
            ".admin-animal-filter-option"
        );


    const animalCards =
        document.querySelectorAll(
            ".admin-animal-record-card"
        );


    /* ======================================================
       FILTER LABELS
    ====================================================== */

    const filterLabels = {

        "all":
            "All Animals",

        "female":
            "Female Animals",

        "not-female":
            "Not Female"

    };


    /* ======================================================
       OPEN / CLOSE FILTER
    ====================================================== */

    function openFilter() {

        filterCard.classList.add(
            "is-open"
        );

        filterTrigger.setAttribute(
            "aria-expanded",
            "true"
        );

        filterMenu.hidden = false;

    }


    function closeFilter() {

        filterCard.classList.remove(
            "is-open"
        );

        filterTrigger.setAttribute(
            "aria-expanded",
            "false"
        );

        filterMenu.hidden = true;

    }


    filterTrigger.addEventListener(
        "click",
        function (event) {

            event.stopPropagation();


            if (filterMenu.hidden) {

                openFilter();

            } else {

                closeFilter();

            }

        }
    );


    /* ======================================================
       APPLY FILTER
    ====================================================== */

    function applyFilter(filter) {

        animalCards.forEach(
            function (card) {

                const isFemale =
                    card.dataset.female === "true";


                let visible = true;


                if (filter === "female") {

                    visible =
                        isFemale;

                }


                if (filter === "not-female") {

                    visible =
                        !isFemale;

                }


                card.classList.toggle(
                    "is-filtered-out",
                    !visible
                );

            }
        );


        filterLabel.textContent =
            filterLabels[filter] ||
            "All Animals";


        filterOptions.forEach(
            function (option) {

                option.classList.toggle(
                    "active",
                    option.dataset.filter === filter
                );

            }
        );


        closeFilter();

    }


    /* ======================================================
       FILTER OPTIONS
    ====================================================== */

    filterOptions.forEach(
        function (option) {

            option.addEventListener(
                "click",
                function () {

                    applyFilter(
                        option.dataset.filter
                    );

                }
            );

        }
    );


    /* ======================================================
       CLOSE WHEN CLICKING OUTSIDE
    ====================================================== */

    document.addEventListener(
        "click",
        function (event) {

            if (
                filterCard &&
                !filterCard.contains(event.target)
            ) {

                closeFilter();

            }

        }
    );


    /* ======================================================
       FEMALE TOGGLE
    ====================================================== */

    document
        .querySelectorAll(".female-toggle")
        .forEach(
            function (toggle) {


                toggle.addEventListener(
                    "change",
                    async function () {

                        const animalId =
                            toggle.dataset.animalId;


                        const newValue =
                            toggle.checked;


                        const card =
                            toggle.closest(
                                ".admin-animal-record-card"
                            );


                        const status =
                            card.querySelector(
                                ".admin-animal-female-status"
                            );


                        const statusText =
                            card.querySelector(
                                ".female-status-text"
                            );


                        /*
                         * Prevent duplicate requests
                         */

                        toggle.disabled = true;


                        try {


                            /*
                             * ==================================================
                             * BACKEND UPDATE
                             *
                             * Change this endpoint if your actual
                             * controller uses another route.
                             * ==================================================
                             */

                            const response =
                                await fetch(
                                    "/dairy/" +
                                    encodeURIComponent(
                                        animalId
                                    ) +
                                    "/female",
                                    {

                                        method:
                                            "PATCH",

                                        headers: {

                                            "Content-Type":
                                                "application/json",

                                            "Accept":
                                                "application/json"

                                        },

                                        body:
                                            JSON.stringify({

                                                female:
                                                    newValue

                                            })

                                    }
                                );


                            if (!response.ok) {

                                throw new Error(
                                    "Failed to update female status."
                                );

                            }


                            /*
                             * Update card state
                             */

                            card.dataset.female =
                                newValue
                                    ? "true"
                                    : "false";


                            status.classList.toggle(
                                "is-female",
                                newValue
                            );


                            status.classList.toggle(
                                "is-not-female",
                                !newValue
                            );


                            statusText.textContent =
                                newValue
                                    ? "Marked Female"
                                    : "Not Female";


                            /*
                             * If current filter is active,
                             * immediately hide cards that no
                             * longer belong to it.
                             */

                            const activeFilter =
                                document.querySelector(
                                    ".admin-animal-filter-option.active"
                                );


                            if (activeFilter) {

                                applyFilter(
                                    activeFilter.dataset.filter
                                );

                            }


                        } catch (error) {

                            /*
                             * Revert toggle when backend fails.
                             */

                            toggle.checked =
                                !newValue;


                            alert(
                                "Failed to update female status. Please try again."
                            );

                        } finally {

                            toggle.disabled =
                                false;

                        }

                    }
                );

            }
        );


})();

</script>