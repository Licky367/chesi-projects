</style>



<script>

(function () {

    "use strict";


    /* ======================================================
       ELEMENTS
    ====================================================== */

    const selectorButton =
        document.getElementById(
            "booleanSelectorButton"
        );


    const dropdown =
        document.getElementById(
            "booleanFieldDropdown"
        );


    const fieldOptions =
        document.querySelectorAll(
            ".boolean-field-option"
        );


    const toggleButtons =
        document.querySelectorAll(
            ".boolean-toggle"
        );


    if (
        !selectorButton ||
        !dropdown
    ) {

        return;

    }


    let selectedField =
        null;


    /* ======================================================
       OPEN / CLOSE DROPDOWN
    ====================================================== */

    selectorButton.addEventListener(
        "click",
        function () {

            const isOpen =
                selectorButton.getAttribute(
                    "aria-expanded"
                ) === "true";


            selectorButton.setAttribute(
                "aria-expanded",
                String(!isOpen)
            );


            dropdown.hidden =
                isOpen;

        }
    );


    /* ======================================================
       FIELD SELECTION
    ====================================================== */

    fieldOptions.forEach(
        function (option) {

            option.addEventListener(
                "click",
                function () {

                    selectedField =
                        option.dataset.field;


                    fieldOptions.forEach(
                        function (item) {

                            item.classList.remove(
                                "selected"
                            );

                        }
                    );


                    option.classList.add(
                        "selected"
                    );


                    selectorButton.querySelector(
                        ".boolean-selector-subtitle"
                    ).textContent =
                        selectedField;


                    toggleButtons.forEach(
                        function (button) {

                            button.disabled =
                                false;

                            button.querySelector(
                                ".boolean-toggle-label"
                            ).textContent =
                                selectedField;

                        }
                    );


                    selectorButton.setAttribute(
                        "aria-expanded",
                        "false"
                    );


                    dropdown.hidden =
                        true;


                    /*
                     * Update the visible toggle state
                     * using the selected field.
                     */

                    toggleButtons.forEach(
                        function (button) {

                            const animalId =
                                button.dataset.animalId;


                            const animal =
                                document.querySelector(
                                    '[data-animal-id="' +
                                    animalId +
                                    '"]'
                                );


                            if (!animal) {

                                return;

                            }


                            /*
                             * The actual initial value is
                             * supplied below through the
                             * animal's data attributes.
                             */

                            const value =
                                animal.dataset[
                                    "boolean-" +
                                    selectedField
                                ];


                            const isTrue =
                                value === "true";


                            button.setAttribute(
                                "aria-pressed",
                                String(isTrue)
                            );

                        }
                    );

                }
            );

        }
    );


    /* ======================================================
       TOGGLE
    ====================================================== */

    toggleButtons.forEach(
        function (button) {

            button.addEventListener(
                "click",
                async function () {

                    if (
                        button.disabled ||
                        !selectedField
                    ) {

                        return;

                    }


                    const animalId =
                        button.dataset.animalId;


                    const currentlyOn =
                        button.getAttribute(
                            "aria-pressed"
                        ) === "true";


                    const newValue =
                        !currentlyOn;


                    button.disabled =
                        true;


                    try {

                        const response =
                            await fetch(
                                "/dairy/" +
                                encodeURIComponent(
                                    animalId
                                ) +
                                "/boolean",
                                {

                                    method:
                                        "PUT",

                                    headers: {

                                        "Content-Type":
                                            "application/json",

                                        "Accept":
                                            "application/json"

                                    },

                                    body:
                                        JSON.stringify({

                                            field:
                                                selectedField,

                                            value:
                                                newValue

                                        })

                                }
                            );


                        const result =
                            await response.json();


                        if (
                            !response.ok ||
                            !result.success
                        ) {

                            throw new Error(
                                result.message ||
                                "Failed to update boolean."
                            );

                        }


                        button.setAttribute(
                            "aria-pressed",
                            String(
                                result.value
                            )
                        );


                    } catch (error) {

                        console.error(
                            "BOOLEAN UPDATE ERROR:",
                            error
                        );


                        alert(
                            error.message ||
                            "Failed to update boolean."
                        );

                    } finally {

                        button.disabled =
                            false;

                    }

                }
            );

        }
    );


    /* ======================================================
       CLOSE WHEN CLICKING OUTSIDE
    ====================================================== */

    document.addEventListener(
        "click",
        function (event) {

            if (
                !event.target.closest(
                    ".boolean-selector-card"
                )
            ) {

                selectorButton.setAttribute(
                    "aria-expanded",
                    "false"
                );


                dropdown.hidden =
                    true;

            }

        }
    );

})();

</script>