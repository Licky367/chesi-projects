<%
/* ==========================================================
   FEMALE ANIMAL BOOLEAN CARDS

   FILE:
       views/update/boolean.ejs

   PURPOSE:
       INCLUDE ONLY.

   PARENT:
       views/update.ejs

   DATA RECEIVED:
       booleanAnimals
       booleanFields
       dairy

   FARM OWNERSHIP:
   ----------------------------------------------------------
       animal.assetCode === dairy.code

   ELIGIBILITY:
   ----------------------------------------------------------
       The animal belongs to the current Dairy Farm AND:

           gender === "female"

       OR

           code > 0 AND code is even

   CARD NAVIGATION:
   ----------------------------------------------------------
       Every eligible animal card opens:

           /dairy/:id

       where:

           :id === animal._id

   BOOLEAN TOGGLES:
   ----------------------------------------------------------
       Boolean buttons remain interactive.

       Clicking a Boolean toggle does NOT navigate to
       /dairy/:id.

========================================================== */


/* ==========================================================
   SAFE INPUTS
========================================================== */

const animals =
    Array.isArray(booleanAnimals)
        ? booleanAnimals
        : [];


const fields =
    Array.isArray(booleanFields)
        ? booleanFields
        : [];


/* ==========================================================
   CURRENT FARM CODE
========================================================== */

let currentFarmCode = null;


if (
    dairy &&
    dairy.code !== null &&
    dairy.code !== undefined
) {

    const farmCode =
        Number(dairy.code);


    if (
        Number.isInteger(farmCode) &&
        farmCode < 0
    ) {

        currentFarmCode =
            farmCode;

    }

}


/* ==========================================================
   FALLBACK FARM CODE
========================================================== */

if (
    currentFarmCode === null &&
    dairy &&
    dairy.assetCode !== null &&
    dairy.assetCode !== undefined
) {

    const farmCode =
        Number(
            dairy.assetCode
        );


    if (
        Number.isInteger(farmCode) &&
        farmCode < 0
    ) {

        currentFarmCode =
            farmCode;

    }

}


/* ==========================================================
   FILTER ELIGIBLE ANIMALS
   ----------------------------------------------------------
   REQUIREMENT:

       animal belongs to current farm

   AND:

       gender === female

   OR:

       code > 0 && code is even
========================================================== */

const eligibleAnimals =
    animals.filter(function (animal) {

        /* --------------------------------------------------
           VALID RECORD
        -------------------------------------------------- */

        if (
            !animal ||
            !animal._id
        ) {

            return false;

        }


        /* --------------------------------------------------
           ANIMAL RECORD TYPE
        -------------------------------------------------- */

        if (
            animal.recordType &&
            String(
                animal.recordType
            ).toLowerCase() !== "animal"
        ) {

            return false;

        }


        /* --------------------------------------------------
           CURRENT FARM MUST EXIST
        -------------------------------------------------- */

        if (
            currentFarmCode === null
        ) {

            return false;

        }


        /* --------------------------------------------------
           ASSET CODE REQUIRED
        -------------------------------------------------- */

        if (
            animal.assetCode === null ||
            animal.assetCode === undefined
        ) {

            return false;

        }


        /* --------------------------------------------------
           ANIMAL FARM CODE
        -------------------------------------------------- */

        const animalFarmCode =
            Number(
                animal.assetCode
            );


        if (
            !Number.isInteger(
                animalFarmCode
            )
        ) {

            return false;

        }


        /* --------------------------------------------------
           FARM OWNERSHIP
        -------------------------------------------------- */

        if (
            animalFarmCode !== currentFarmCode
        ) {

            return false;

        }


        /* --------------------------------------------------
           GENDER
        -------------------------------------------------- */

        const animalGender =
            String(
                animal.gender || ""
            )
            .trim()
            .toLowerCase();


        const isFemale =
            animalGender === "female";


        /* --------------------------------------------------
           CODE
        -------------------------------------------------- */

        const animalCode =
            Number(
                animal.code
            );


        /* --------------------------------------------------
           POSITIVE EVEN CODE
        -------------------------------------------------- */

        const positiveEvenCode =
            Number.isInteger(
                animalCode
            ) &&
            animalCode > 0 &&
            animalCode % 2 === 0;


        /* --------------------------------------------------
           FINAL MERIT

               gender === female

           OR

               code > 0 && code even
        -------------------------------------------------- */

        return (
            isFemale ||
            positiveEvenCode
        );

    });


/* ==========================================================
   BOOLEAN FIELD LABEL
========================================================== */

function booleanLabel(field) {

    return String(
        field || ""
    )
    .replace(
        /([a-z])([A-Z])/g,
        "$1 $2"
    )
    .replace(
        /[_-]+/g,
        " "
    )
    .replace(
        /\s+/g,
        " "
    )
    .trim()
    .replace(
        /\b\w/g,
        function (letter) {

            return letter.toUpperCase();

        }
    );

}

%>


<section
    class="update-boolean-section"
    aria-label="Female animal Boolean management"
>


    <!-- ======================================================
         HEADER
    ======================================================= -->

    <div class="update-boolean-header">

        <div class="update-boolean-heading">

            <span class="update-boolean-kicker">
                ANIMAL MANAGEMENT
            </span>


            <strong>
                Female Animals
            </strong>

        </div>


        <div class="update-boolean-description">

            Select a Boolean field or open an animal card
            to view and manage that animal.

        </div>

    </div>



    <!-- ======================================================
         HORIZONTAL CARD STRIP
    ======================================================= -->

    <div
        class="update-boolean-scroll"
        role="list"
        aria-label="Eligible animal Boolean controls"
    >


        <!-- ==================================================
             BOOLEAN FIELD SELECTOR CARD
        =================================================== -->

        <div
            class="
                update-boolean-card
                update-boolean-selector-card
            "
            role="listitem"
        >

            <button
                type="button"
                class="update-boolean-selector"
                id="booleanFieldSelector"
                aria-expanded="false"
                aria-controls="booleanFieldDropdown"
            >

                <div
                    class="update-boolean-selector-icon"
                >

                    <i class="fas fa-sliders"></i>

                </div>


                <div
                    class="update-boolean-selector-title"
                >

                    Boolean Fields

                </div>


                <div
                    class="update-boolean-selector-text"
                >

                    Choose what to manage

                </div>


                <div
                    class="update-boolean-selector-arrow"
                >

                    <i class="fas fa-chevron-down"></i>

                </div>

            </button>



            <!-- ==============================================
                 BOOLEAN FIELD DROPDOWN
            =============================================== -->

            <div
                id="booleanFieldDropdown"
                class="update-boolean-dropdown"
                hidden
            >

                <% if (fields.length > 0) { %>

                    <% fields.forEach(function(field) { %>

                        <button
                            type="button"
                            class="update-boolean-field-option"
                            data-boolean-field="<%= field %>"
                        >

                            <span
                                class="
                                    update-boolean-field-option-icon
                                "
                            >

                                <i
                                    class="fas fa-toggle-on"
                                ></i>

                            </span>


                            <span
                                class="
                                    update-boolean-field-option-label
                                "
                            >

                                <%= booleanLabel(field) %>

                            </span>


                            <span
                                class="
                                    update-boolean-field-option-check
                                "
                            >

                                <i class="fas fa-check"></i>

                            </span>

                        </button>

                    <% }); %>

                <% } else { %>

                    <div
                        class="update-boolean-no-fields"
                    >

                        No Boolean fields available.

                    </div>

                <% } %>

            </div>

        </div>



        <!-- ==================================================
             ELIGIBLE ANIMAL CARDS
             --------------------------------------------------
             EACH CARD NAVIGATES TO:

                 /dairy/:id

             where :id = animal._id
        =================================================== -->

        <% eligibleAnimals.forEach(function(animal) { %>

            <%

                /* ============================================
                   ANIMAL ID
                ============================================ */

                const animalId =
                    String(
                        animal._id
                    );


                /* ============================================
                   ANIMAL PROFILE URL
                ============================================ */

                const animalUrl =
                    "/dairy/" +
                    encodeURIComponent(
                        animalId
                    );


                /* ============================================
                   ANIMAL NAME
                ============================================ */

                const animalName =
                    String(
                        animal.name ||
                        "Unnamed Animal"
                    );


                /* ============================================
                   ANIMAL CODE
                ============================================ */

                const animalCode =
                    Number(
                        animal.code
                    );


                /* ============================================
                   FARM CODE
                ============================================ */

                const animalFarmCode =
                    Number(
                        animal.assetCode
                    );


                /* ============================================
                   GENDER
                ============================================ */

                const animalGender =
                    String(
                        animal.gender ||
                        "Female"
                    );


                /* ============================================
                   IMAGE
                ============================================ */

                const animalImage =
                    animal.displayImage ||
                    animal.profileImage ||
                    (
                        "https://ui-avatars.com/api/?name=" +
                        encodeURIComponent(
                            animalName
                        ) +
                        "&background=e8f0e5&color=47733f"
                    );

            %>


            <!-- ==================================================
                 CLICKABLE ANIMAL CARD
                 --------------------------------------------------
                 The entire card opens:

                     /dairy/:id
            =================================================== -->

            <article
                class="
                    update-boolean-card
                    update-boolean-animal-card
                "
                role="listitem"
                data-animal-id="<%= animalId %>"
                data-farm-code="<%= animalFarmCode %>"
                data-dairy-url="<%= animalUrl %>"
                tabindex="0"
                role="link"
                aria-label="Open <%= animalName %>"
            >


                <!-- ==========================================
                     CARD ACCENT
                =========================================== -->

                <div
                    class="update-boolean-card-accent"
                    aria-hidden="true"
                ></div>



                <!-- ==========================================
                     IMAGE
                =========================================== -->

                <div
                    class="update-boolean-image-wrap"
                >

                    <img
                        src="<%= animalImage %>"
                        alt="<%= animalName %>"
                        class="update-boolean-image"
                        loading="lazy"
                    >


                    <div
                        class="update-boolean-image-overlay"
                        aria-hidden="true"
                    ></div>


                    <!-- FEMALE BADGE -->

                    <div
                        class="update-boolean-female-badge"
                    >

                        <i class="fas fa-venus"></i>

                        <span>
                            FEMALE
                        </span>

                    </div>


                    <!-- CODE -->

                    <div
                        class="update-boolean-code"
                    >

                        #<%= animalCode %>

                    </div>

                </div>



                <!-- ==========================================
                     CONTENT
                =========================================== -->

                <div
                    class="update-boolean-content"
                >


                    <!-- NAME -->

                    <div
                        class="update-boolean-name"
                    >

                        <%= animalName %>

                    </div>



                    <!-- GENDER -->

                    <div
                        class="update-boolean-gender"
                    >

                        <i class="fas fa-venus"></i>

                        <%= animalGender %>

                    </div>



                    <!-- ======================================
                         BOOLEAN CONTROLS
                    ======================================= -->

                    <div
                        class="update-boolean-controls"
                    >

                        <% if (fields.length > 0) { %>

                            <% fields.forEach(function(field) { %>

                                <%

                                    const fieldValue =
                                        Boolean(
                                            animal[field]
                                        );

                                %>


                                <button
                                    type="button"
                                    class="
                                        update-boolean-toggle
                                        <%= fieldValue ? "is-on" : "" %>
                                    "
                                    data-animal-id="<%= animalId %>"
                                    data-boolean-field="<%= field %>"
                                    data-boolean-value="<%= fieldValue %>"
                                    aria-pressed="<%= fieldValue ? "true" : "false" %>"
                                    title="<%= booleanLabel(field) %>"
                                >

                                    <span
                                        class="
                                            update-boolean-toggle-label
                                        "
                                    >

                                        <%= booleanLabel(field) %>

                                    </span>


                                    <span
                                        class="
                                            update-boolean-toggle-switch
                                        "
                                        aria-hidden="true"
                                    >

                                        <span
                                            class="
                                                update-boolean-toggle-knob
                                            "
                                        ></span>

                                    </span>

                                </button>

                            <% }); %>

                        <% } else { %>

                            <div
                                class="update-boolean-empty"
                            >

                                No Boolean controls.

                            </div>

                        <% } %>

                    </div>

                </div>



                <!-- ==========================================
                     BOTTOM LINE
                =========================================== -->

                <div
                    class="update-boolean-bottom-line"
                    aria-hidden="true"
                ></div>

            </article>

        <% }); %>



        <!-- ==================================================
             NO ELIGIBLE ANIMALS
        =================================================== -->

        <% if (eligibleAnimals.length === 0) { %>

            <div
                class="update-boolean-empty-card"
            >

                <div
                    class="update-boolean-empty-card-icon"
                >

                    <i class="fas fa-cow"></i>

                </div>


                <strong>
                    No eligible female animals
                </strong>


                <span>

                    No female animals or positive-even-code
                    animals belonging to this Dairy Farm
                    are currently available.

                </span>

            </div>

        <% } %>


    </div>

</section>



