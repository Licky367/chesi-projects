</style>



<script>

(function () {

    "use strict";


    /* ======================================================
       ELEMENTS
    ======================================================= */

    const selector =
        document.getElementById(
            "booleanFieldSelector"
        );


    const dropdown =
        document.getElementById(
            "booleanFieldDropdown"
        );


    const fieldOptions =
        document.querySelectorAll(
            ".update-boolean-field-option"
        );


    /* ======================================================
       CURRENT FIELD
    ======================================================= */

    let selectedField =
        fieldOptions.length > 0
            ? fieldOptions[0]
                .getAttribute(
                    "data-boolean-field"
                )
            : "";


    /* ======================================================
       SELECT FIELD
    ======================================================= */

    function selectField(field) {

        selectedField =
            field || "";


        fieldOptions.forEach(
            function (option) {

                const optionField =
                    option.getAttribute(
                        "data-boolean-field"
                    );


                option.classList.toggle(
                    "selected",
                    optionField === selectedField
                );

            }
        );

    }


    /* ======================================================
       DROPDOWN TOGGLE
    ======================================================= */

    if (
        selector &&
        dropdown
    ) {

        selector.addEventListener(
            "click",
            function (event) {

                event.stopPropagation();


                const isOpen =
                    !dropdown.hasAttribute(
                        "hidden"
                    );


                if (isOpen) {

                    dropdown.setAttribute(
                        "hidden",
                        ""
                    );

                    selector.setAttribute(
                        "aria-expanded",
                        "false"
                    );

                } else {

                    dropdown.removeAttribute(
                        "hidden"
                    );

                    selector.setAttribute(
                        "aria-expanded",
                        "true"
                    );

                }

            }
        );

    }


    /* ======================================================
       FIELD OPTIONS
    ======================================================= */

    fieldOptions.forEach(
        function (option) {

            option.addEventListener(
                "click",
                function (event) {

                    event.stopPropagation();


                    selectField(
                        option.getAttribute(
                            "data-boolean-field"
                        )
                    );


                    if (dropdown) {

                        dropdown.setAttribute(
                            "hidden",
                            ""
                        );

                    }


                    if (selector) {

                        selector.setAttribute(
                            "aria-expanded",
                            "false"
                        );

                    }

                }
            );

        }
    );


    /* ======================================================
       INITIAL FIELD
    ======================================================= */

    selectField(
        selectedField
    );


    /* ======================================================
       ANIMAL CARD NAVIGATION
       ------------------------------------------------------
       Every animal card opens:

           /dairy/:id

       Boolean buttons explicitly stop propagation so
       clicking them does not navigate.
    ======================================================= */

    document
        .querySelectorAll(
            ".update-boolean-animal-card"
        )
        .forEach(
            function (card) {

                function openAnimal() {

                    const url =
                        card.getAttribute(
                            "data-dairy-url"
                        );


                    if (!url) {

                        return;

                    }


                    window.location.href =
                        url;

                }


                /* ------------------------------------------
                   MOUSE / TOUCH
                ------------------------------------------ */

                card.addEventListener(
                    "click",
                    function () {

                        openAnimal();

                    }
                );


                /* ------------------------------------------
                   KEYBOARD
                   ------------------------------------------------
                   Makes the card accessible like a link.
                ------------------------------------------ */

                card.addEventListener(
                    "keydown",
                    function (event) {

                        if (
                            event.key === "Enter" ||
                            event.key === " "
                        ) {

                            event.preventDefault();

                            openAnimal();

                        }

                    }
                );


                /* ------------------------------------------
                   BOOLEAN BUTTONS MUST NOT NAVIGATE
                ------------------------------------------ */

                card
                    .querySelectorAll(
                        ".update-boolean-toggle"
                    )
                    .forEach(
                        function (button) {

                            button.addEventListener(
                                "click",
                                function (event) {

                                    event.stopPropagation();

                                }
                            );

                        }
                    );

            }
        );


    /* ======================================================
       BOOLEAN TOGGLE
       ------------------------------------------------------
       Route:

           POST /dairy/:animalId/boolean/:field
    ======================================================= */

    document
        .querySelectorAll(
            ".update-boolean-toggle"
        )
        .forEach(
            function (button) {

                button.addEventListener(
                    "click",
                    async function (event) {

                        /*
                         * Prevent the animal card's click
                         * handler from opening /dairy/:id.
                         */

                        event.preventDefault();

                        event.stopPropagation();


                        const animalId =
                            button.getAttribute(
                                "data-animal-id"
                            );


                        const field =
                            button.getAttribute(
                                "data-boolean-field"
                            );


                        if (
                            !animalId ||
                            !field
                        ) {

                            return;

                        }


                        if (
                            button.dataset.busy ===
                            "true"
                        ) {

                            return;

                        }


                        button.dataset.busy =
                            "true";


                        try {

                            const response =
                                await fetch(
                                    "/dairy/" +
                                    encodeURIComponent(
                                        animalId
                                    ) +
                                    "/boolean/" +
                                    encodeURIComponent(
                                        field
                                    ),
                                    {

                                        method:
                                            "POST",

                                        headers: {

                                            "Content-Type":
                                                "application/json"

                                        }

                                    }
                                );


                            const result =
                                await response.json();


                            if (
                                !response.ok ||
                                !result.success
                            ) {

                                throw new Error(
                                    result.message ||
                                    "Failed to toggle Boolean."
                                );

                            }


                            const newValue =
                                Boolean(
                                    result.value
                                );


                            button.classList.toggle(
                                "is-on",
                                newValue
                            );


                            button.setAttribute(
                                "aria-pressed",
                                newValue
                                    ? "true"
                                    : "false"
                            );


                            button.setAttribute(
                                "data-boolean-value",
                                String(
                                    newValue
                                )
                            );


                        } catch (error) {

                            console.error(
                                "BOOLEAN TOGGLE ERROR:",
                                error
                            );


                            alert(
                                error.message ||
                                "Failed to toggle Boolean."
                            );

                        } finally {

                            button.dataset.busy =
                                "false";

                        }

                    }
                );

            }
        );


    /* ======================================================
       CLOSE DROPDOWN WHEN CLICKING OUTSIDE
    ======================================================= */

    document.addEventListener(
        "click",
        function (event) {

            if (
                !selector ||
                !dropdown
            ) {

                return;

            }


            if (
                selector.contains(
                    event.target
                ) ||
                dropdown.contains(
                    event.target
                )
            ) {

                return;

            }


            dropdown.setAttribute(
                "hidden",
                ""
            );


            selector.setAttribute(
                "aria-expanded",
                "false"
            );

        }
    );

})();

</script>