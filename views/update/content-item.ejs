<%
/*
==============================================================
STORAGE CONTENT ITEM CARD
==============================================================

FILE:
    views/update/content-item.ejs

PURPOSE:
    Reusable CARD for displaying one storage content item.

IMPORTANT:
    THIS IS AN INCLUDE.
    THIS FILE HANDLES ITEM INFORMATION ONLY.

STOCK UPDATES:
    Handled separately by:

        content-item-update.ejs
==============================================================
*/


/* ============================================================
   SAFE DATA
============================================================ */

const contentItem =
    item || {};

const currentStorage =
    storage || {};

const currentDairy =
    dairy || {};


/* ============================================================
   CONTENT ITEM ID
============================================================ */

const contentItemId =
    contentItem._id
        ? String(contentItem._id)
        : "";


/* ============================================================
   DWELL NUMBER
============================================================ */

const dwellNumber =
    contentItem.dwellNumber !== null &&
    contentItem.dwellNumber !== undefined
        ? String(contentItem.dwellNumber)
        : "";


/* ============================================================
   SAFE OPTIONAL MESSAGES
============================================================ */

const safeSuccessMessage =
    typeof successMessage !== "undefined"
        ? successMessage
        : null;

const safePageError =
    typeof pageError !== "undefined"
        ? pageError
        : null;


/* ============================================================
   ITEM CLASSIFICATION
============================================================ */

const itemType =
    String(
        contentItem.type || ""
    ).trim();


const itemCode =
    Number(
        contentItem.code
    );


const itemIsAnimal =
    contentItem.code !== null &&
    contentItem.code !== undefined &&
    !Number.isNaN(itemCode) &&
    itemCode > 0;


const itemIsFeed =
    itemType === "feeds";


const itemIsAgroStore =
    itemType === "agroStore";


/* ============================================================
   DISPLAY CLASSIFICATION
============================================================ */

let itemCategory =
    "Asset";

let itemIcon =
    "📦";

let itemCategoryClass =
    "asset-badge";


if (itemIsFeed) {

    itemCategory =
        "Feed";

    itemIcon =
        "🌾";

    itemCategoryClass =
        "feed-badge";

} else if (itemIsAnimal) {

    itemCategory =
        "Animal";

    itemIcon =
        "🐄";

    itemCategoryClass =
        "animal-badge";

} else if (itemIsAgroStore) {

    itemCategory =
        "AgroStore";

    itemIcon =
        "🌾";

    itemCategoryClass =
        "feed-badge";

}


/* ============================================================
   QUANTITY
============================================================ */

const hasQuantity =
    contentItem.quantity !== null &&
    contentItem.quantity !== undefined;


const quantityValue =
    hasQuantity
        ? Number(
            contentItem.quantity || 0
        )
        : null;


/* ============================================================
   CURRENT WORTH
============================================================ */

const hasCurrentWorth =
    contentItem.currentWorth !== null &&
    contentItem.currentWorth !== undefined;


const currentWorthValue =
    hasCurrentWorth
        ? Number(
            contentItem.currentWorth || 0
        )
        : null;


/* ============================================================
   UNIT
============================================================ */

const itemUnit =
    contentItem.unit
        ? String(
            contentItem.unit
        ).trim()
        : "";


/* ============================================================
   ITEM NAME
============================================================ */

const itemName =
    contentItem.name ||
    "Unnamed Item";

%>


<style>

/* ============================================================
   CARD CONTAINER
============================================================ */

.storage-content-item-page{

    width:100%;

    box-sizing:border-box;

}


/* ============================================================
   MAIN CARD
============================================================ */

.content-item-card{

    width:100%;

    overflow:hidden;

    background:#ffffff;

    border:1px solid #e1e9e3;

    border-radius:20px;

    box-shadow:
        0 10px 35px rgba(24,45,31,.07),
        0 2px 8px rgba(24,45,31,.035);

}


/* ============================================================
   HEADER
============================================================ */

.content-item-hero{

    display:flex;

    align-items:center;

    gap:18px;

    padding:25px;

    background:
        linear-gradient(
            135deg,
            #f3f9f5 0%,
            #ffffff 72%
        );

    border-bottom:1px solid #e4ebe6;

}


/* ============================================================
   ICON
============================================================ */

.content-item-icon{

    flex:none;

    width:72px;

    height:72px;

    display:flex;

    align-items:center;

    justify-content:center;

    border-radius:19px;

    background:#e7f2ea;

    box-shadow:
        inset 0 0 0 1px rgba(45,123,72,.06);

    font-size:34px;

}


/* ============================================================
   HEADER INFORMATION
============================================================ */

.content-item-hero-information{

    min-width:0;

    flex:1;

}


.content-item-eyebrow{

    margin:0 0 5px;

    color:#7b8a81;

    font-size:9px;

    line-height:1.2;

    font-weight:850;

    letter-spacing:.12em;

    text-transform:uppercase;

}


.content-item-title{

    margin:0;

    color:#203328;

    font-size:27px;

    line-height:1.2;

    font-weight:850;

    letter-spacing:-.035em;

    word-break:break-word;

}


/* ============================================================
   BADGES
============================================================ */

.content-item-badges{

    display:flex;

    align-items:center;

    flex-wrap:wrap;

    gap:7px;

    margin-top:12px;

}


.content-item-badge{

    display:inline-flex;

    align-items:center;

    justify-content:center;

    min-height:24px;

    padding:0 10px;

    border-radius:999px;

    font-size:9px;

    line-height:1;

    font-weight:850;

    letter-spacing:.06em;

    text-transform:uppercase;

}


.animal-badge{

    background:#edf7ef;

    color:#347148;

}


.feed-badge{

    background:#eaf6ed;

    color:#2d7243;

}


.asset-badge{

    background:#f1f3f3;

    color:#68746d;

}


.status-badge{

    background:#f4f7f5;

    color:#536359;

}


/* ============================================================
   BODY
============================================================ */

.content-item-body{

    padding:25px;

}


/* ============================================================
   SECTION
============================================================ */

.detail-section{

    margin:0;

}


.detail-section-heading{

    display:flex;

    align-items:center;

    gap:12px;

    margin-bottom:14px;

}


.detail-section-title{

    flex:none;

    margin:0;

    color:#263a2c;

    font-size:15px;

    line-height:1.3;

    font-weight:850;

    letter-spacing:-.015em;

}


.detail-section-line{

    flex:1;

    height:1px;

    background:#e6ece8;

}


/* ============================================================
   QUANTITY / VALUE
============================================================ */

.highlight-grid{

    display:grid;

    grid-template-columns:
        repeat(
            3,
            minmax(0,1fr)
        );

    gap:12px;

}


.highlight-box{

    position:relative;

    min-width:0;

    padding:17px;

    background:
        linear-gradient(
            145deg,
            #f8fbf9 0%,
            #f4f9f5 100%
        );

    border:1px solid #dfe9e2;

    border-radius:14px;

}


.highlight-label{

    display:block;

    margin-bottom:8px;

    color:#849188;

    font-size:9px;

    line-height:1.2;

    font-weight:800;

    text-transform:uppercase;

    letter-spacing:.06em;

}


.highlight-value{

    display:block;

    color:#294333;

    font-size:20px;

    line-height:1.25;

    font-weight:850;

    word-break:break-word;

}


.highlight-unit{

    margin-left:3px;

    color:#738078;

    font-size:10px;

    font-weight:700;

}


/* ============================================================
   DESCRIPTION
============================================================ */

.description-section{

    margin-top:27px;

}


.description-box{

    min-height:90px;

    padding:17px;

    background:#fafcfb;

    border:1px solid #e4ebe6;

    border-radius:14px;

}


.description-text{

    margin:0;

    color:#526259;

    font-size:12px;

    line-height:1.75;

    font-weight:500;

    white-space:pre-wrap;

    word-break:break-word;

}


.no-description{

    display:block;

    color:#8a958e;

    font-size:11px;

    line-height:1.6;

    font-style:italic;

}


/* ============================================================
   MESSAGES
============================================================ */

.content-item-message{

    display:flex;

    align-items:center;

    gap:9px;

    margin-bottom:15px;

    padding:11px 13px;

    border-radius:10px;

    font-size:12px;

    font-weight:650;

}


.content-item-success{

    background:#f1f8f3;

    border:1px solid #d8e9dc;

    color:#28603a;

}


.content-item-error{

    background:#fff5f4;

    border:1px solid #efd9d6;

    color:#9a443b;

}


/* ============================================================
   MOBILE
============================================================ */

@media (max-width:700px){

    .content-item-hero{

        align-items:flex-start;

        gap:13px;

        padding:18px;

    }


    .content-item-icon{

        width:57px;

        height:57px;

        border-radius:15px;

        font-size:27px;

    }


    .content-item-title{

        font-size:22px;

    }


    .content-item-body{

        padding:18px;

    }


    .highlight-grid{

        grid-template-columns:
            repeat(
                2,
                minmax(0,1fr)
            );

    }

}


@media (max-width:470px){

    .content-item-hero{

        gap:11px;

        padding:16px;

    }


    .content-item-icon{

        width:49px;

        height:49px;

        border-radius:13px;

        font-size:23px;

    }


    .content-item-eyebrow{

        font-size:8px;

    }


    .content-item-title{

        font-size:19px;

    }


    .content-item-badge{

        min-height:22px;

        padding:0 8px;

        font-size:8px;

    }


    .content-item-body{

        padding:16px;

    }


    .highlight-grid{

        grid-template-columns:1fr;

    }


    .highlight-box{

        padding:15px;

    }


    .highlight-value{

        font-size:18px;

    }

}

</style>


<!-- ============================================================
     STORAGE CONTENT ITEM CARD
============================================================= -->

<div class="storage-content-item-page">


    <!-- ========================================================
         SUCCESS MESSAGE
    ========================================================= -->

    <% if (safeSuccessMessage) { %>

        <div class="content-item-message content-item-success">

            <span>✓</span>

            <span>
                <%= safeSuccessMessage %>
            </span>

        </div>

    <% } %>


    <!-- ========================================================
         ERROR MESSAGE
    ========================================================= -->

    <% if (safePageError) { %>

        <div class="content-item-message content-item-error">

            <span>!</span>

            <span>
                <%= safePageError %>
            </span>

        </div>

    <% } %>


    <!-- ========================================================
         MAIN CARD
    ========================================================= -->

    <article class="content-item-card">


        <!-- ====================================================
             HEADER
        ==================================================== -->

        <header class="content-item-hero">

            <div class="content-item-icon">

                <%= itemIcon %>

            </div>


            <div class="content-item-hero-information">

                <p class="content-item-eyebrow">
                    Storage Content
                </p>


                <h1 class="content-item-title">
                    <%= itemName %>
                </h1>


                <div class="content-item-badges">

                    <span
                        class="content-item-badge <%= itemCategoryClass %>"
                    >
                        <%= itemCategory %>
                    </span>


                    <% if (contentItem.status) { %>

                        <span
                            class="content-item-badge status-badge"
                        >
                            <%= contentItem.status %>
                        </span>

                    <% } %>

                </div>

            </div>

        </header>


        <!-- ====================================================
             BODY
        ==================================================== -->

        <div class="content-item-body">


            <!-- ==================================================
                 QUANTITY & VALUE
            ================================================== -->

            <section class="detail-section">

                <div class="detail-section-heading">

                    <h2 class="detail-section-title">
                        Quantity & Value
                    </h2>

                    <span class="detail-section-line"></span>

                </div>


                <div class="highlight-grid">


                    <div class="highlight-box">

                        <span class="highlight-label">
                            Quantity
                        </span>


                        <span class="highlight-value">

                            <% if (hasQuantity) { %>

                                <%= quantityValue.toLocaleString() %>

                                <% if (itemUnit) { %>

                                    <span class="highlight-unit">
                                        <%= itemUnit %>
                                    </span>

                                <% } %>

                            <% } else { %>

                                —

                            <% } %>

                        </span>

                    </div>


                    <div class="highlight-box">

                        <span class="highlight-label">
                            Unit
                        </span>

                        <span class="highlight-value">
                            <%= itemUnit || "—" %>
                        </span>

                    </div>


                    <div class="highlight-box">

                        <span class="highlight-label">
                            Current Worth
                        </span>

                        <span class="highlight-value">

                            <% if (hasCurrentWorth) { %>

                                <%= currentWorthValue.toLocaleString() %>

                            <% } else { %>

                                —

                            <% } %>

                        </span>

                    </div>

                </div>

            </section>


            <!-- ==================================================
                 DESCRIPTION
            ================================================== -->

            <section
                class="detail-section description-section"
            >

                <div class="detail-section-heading">

                    <h2 class="detail-section-title">
                        Description
                    </h2>

                    <span class="detail-section-line"></span>

                </div>


                <div class="description-box">

                    <% if (
                        contentItem.description &&
                        String(
                            contentItem.description
                        ).trim() !== ""
                    ) { %>

                        <p class="description-text">
                            <%= contentItem.description %>
                        </p>

                    <% } else { %>

                        <span class="no-description">
                            No description has been provided
                            for this item.
                        </span>

                    <% } %>

                </div>

            </section>


            <!-- ==================================================
                 STOCK UPDATE SECTION
                 
                 KEPT SEPARATE FROM THE ITEM INFORMATION.
            ================================================== -->

            <%- include(
                "content-item-update",
                {
                    dairy:
                        currentDairy,

                    storage:
                        currentStorage,

                    item:
                        contentItem,

                    contentItemId:
                        contentItemId,

                    dwellNumber:
                        dwellNumber
                }
            ) %>


        </div>

    </article>


</div>