<%
/* ==========================================================
   FEED STORE
   FILE:
       views/update/storage/feedstore.ejs

   PURPOSE:
       Display feed-store inventory.

   ADMIN:
       Admin users can access:

           /dairy/:dairyId/feedstore/add

       The Add Stock link is completely hidden from
       non-admin users.
========================================================== */

const currentDairy =
    dairy || {};

const currentUser =
    user || {};

const userRole =
    String(
        currentUser.role || ""
    ).trim();


const feedStocks =
    Array.isArray(currentDairy.feedStocks)
        ? currentDairy.feedStocks
        : [];


/* ==========================================================
   ROLE HELPERS
========================================================== */

const isAdmin =
    userRole === "admin";


const isDairyWorker =
    userRole === "dairyWorker";


/* ==========================================================
   DAIRY ID
========================================================== */

const dairyId =
    currentDairy._id
        ? String(currentDairy._id)
        : "";


/* ==========================================================
   SAFE HELPERS
========================================================== */

function safeNumber(value) {

    const number =
        Number(value);

    return Number.isFinite(number)
        ? number
        : 0;

}


function formatNumber(value) {

    return safeNumber(value).toLocaleString(
        undefined,
        {
            maximumFractionDigits: 2
        }
    );

}


function formatDate(value) {

    if (!value) {

        return "";

    }


    const date =
        new Date(value);


    if (
        Number.isNaN(
            date.getTime()
        )
    ) {

        return "";

    }


    return date.toLocaleString();

}


function stockCategory(stock) {

    return stock.category === "medicine"
        ? "Medicine"
        : "Feed";

}


/* ==========================================================
   STOCK ACTION URL
========================================================== */

function getStockActionUrl(stock) {

    if (
        !stock ||
        !stock._id ||
        !dairyId
    ) {

        return "#";

    }


    if (isAdmin) {

        return (

            "/dairy/" +

            encodeURIComponent(
                dairyId
            ) +

            "/feedstore/restock/" +

            encodeURIComponent(
                stock._id
            )

        );

    }


    if (isDairyWorker) {

        return (

            "/dairy/" +

            encodeURIComponent(
                dairyId
            ) +

            "/feedstore/update/" +

            encodeURIComponent(
                stock._id
            )

        );

    }


    return "#";

}


/* ==========================================================
   STOCK ACTION TEXT
========================================================== */

function getStockActionText() {

    if (isAdmin) {

        return "Restock";

    }


    if (isDairyWorker) {

        return "Update Remainder";

    }


    return "";

}

%>


<!-- ==========================================================
     FEED STORE PAGE
========================================================== -->

<div class="feedstore-page">


    <!-- ======================================================
         PAGE HEADER
    ======================================================= -->

    <div class="feedstore-header">


        <!-- ==================================================
             HEADER CONTENT
        =================================================== -->

        <div class="feedstore-header-content">

            <div class="feedstore-eyebrow">
                FEED STORE
            </div>


            <h1>
                <%= currentDairy.name || "Feed Store" %>
            </h1>


            <p>
                Feed store inventory
            </p>

        </div>



        <!-- ==================================================
             STOCK COUNT
        =================================================== -->

        <div class="feedstore-count">

            <strong>
                <%= feedStocks.length %>
            </strong>

            <span>
                Stock Items
            </span>

        </div>



        <!-- ==================================================
             ADMIN-ONLY ADD STOCK LINK
        =================================================== -->

        <% if (isAdmin && dairyId) { %>

            <a
                href="/dairy/<%= encodeURIComponent(dairyId) %>/feedstore/add"
                class="feedstore-add-stock"
            >

                <span class="feedstore-add-icon">
                    ＋
                </span>


                <span class="feedstore-add-content">

                    <strong>
                        Add Stock
                    </strong>

                    <small>
                        Add new feed-store stock
                    </small>

                </span>


                <span class="feedstore-add-arrow">
                    →
                </span>

            </a>

        <% } %>


    </div>



    <!-- ======================================================
         EMPTY STATE
    ======================================================= -->

    <% if (feedStocks.length === 0) { %>


        <div class="feedstore-empty">


            <div class="empty-icon">
                📦
            </div>


            <h2>
                No Stock
            </h2>


            <p>
                There are currently no stock items
                in this feed store.
            </p>


            <% if (isAdmin && dairyId) { %>

                <a
                    href="/dairy/<%= encodeURIComponent(dairyId) %>/feedstore/add"
                    class="empty-add-stock"
                >
                    ＋ Add First Stock
                </a>

            <% } %>


        </div>


    <% } else { %>


        <!-- ==================================================
             STOCK LIST
        =================================================== -->

        <div class="feedstock-list">


            <% feedStocks.forEach(function(stock) { %>


                <div
                    class="feedstock-item"
                    data-stock-id="<%= stock._id || '' %>"
                >


                    <!-- ======================================
                         CARD HEADER
                    ======================================= -->

                    <div class="feedstock-card-header">


                        <!-- ==================================
                             STOCK IDENTITY
                        =================================== -->

                        <div class="feedstock-main">

                            <div class="feedstock-name-row">


                                <h2 class="feedstock-name">

                                    <%= stock.name || "Unnamed Stock" %>

                                </h2>


                                <span
                                    class="feedstock-category <%= stock.category === 'medicine'
                                        ? 'medicine'
                                        : 'feed'
                                    %>"
                                >

                                    <%= stockCategory(stock) %>

                                </span>


                            </div>

                        </div>



                        <!-- ==================================
                             ROLE ACTION
                        =================================== -->

                        <% if (
                            (isAdmin || isDairyWorker) &&
                            stock._id
                        ) { %>


                            <a
                                href="<%= getStockActionUrl(stock) %>"
                                class="stock-action-btn <%= isAdmin
                                    ? 'restock-btn'
                                    : 'update-btn'
                                %>"
                            >

                                <span class="action-icon">

                                    <%= isAdmin
                                        ? "＋"
                                        : "↻"
                                    %>

                                </span>


                                <span>

                                    <%= getStockActionText() %>

                                </span>

                            </a>


                        <% } %>


                    </div>



                    <!-- ======================================
                         CURRENT QUANTITY
                    ======================================= -->

                    <div class="feedstock-field">

                        <span class="field-label">
                            Quantity Remaining
                        </span>


                        <strong class="field-value">

                            <%= formatNumber(
                                stock.quantityRemaining
                            ) %>

                            <span class="field-unit">
                                <%= stock.unit || "" %>
                            </span>

                        </strong>

                    </div>



                    <!-- ======================================
                         INITIAL QUANTITY
                    ======================================= -->

                    <div class="feedstock-field">

                        <span class="field-label">
                            Initial Quantity
                        </span>


                        <strong class="field-value">

                            <%= formatNumber(
                                stock.initialQuantity
                            ) %>

                            <span class="field-unit">
                                <%= stock.unit || "" %>
                            </span>

                        </strong>

                    </div>



                    <!-- ======================================
                         PERCENTAGE REMAINING
                    ======================================= -->

                    <div class="feedstock-field">

                        <span class="field-label">
                            Percentage Remaining
                        </span>


                        <strong
                            class="field-value <%= safeNumber(stock.percentageRemaining) <= 20
                                ? 'low-stock'
                                : ''
                            %>"
                        >

                            <%= formatNumber(
                                stock.percentageRemaining
                            ) %>%

                        </strong>

                    </div>



                    <!-- ======================================
                         UNIT
                    ======================================= -->

                    <div class="feedstock-field">

                        <span class="field-label">
                            Unit
                        </span>


                        <strong class="field-value">
                            <%= stock.unit || "-" %>
                        </strong>

                    </div>



                    <!-- ======================================
                         UNIT PRICE
                    ======================================= -->

                    <div class="feedstock-field">

                        <span class="field-label">
                            Unit Price
                        </span>


                        <strong class="field-value">

                            KES
                            <%= formatNumber(
                                stock.unitPrice
                            ) %>

                        </strong>

                    </div>



                    <!-- ======================================
                         LATEST ADDITION
                    ======================================= -->

                    <div class="feedstock-field">

                        <span class="field-label">
                            Latest Stock Addition
                        </span>


                        <strong class="field-value">

                            <%= formatNumber(
                                stock.feedsAmount
                            ) %>

                            <span class="field-unit">
                                <%= stock.unit || "" %>
                            </span>

                        </strong>

                    </div>



                    <!-- ======================================
                         EXPECTED DURATION
                    ======================================= -->

                    <% if (stock.expectedDuration) { %>

                        <div class="feedstock-field">

                            <span class="field-label">
                                Expected Duration
                            </span>


                            <strong class="field-value">

                                <%= stock.expectedDuration %>

                            </strong>

                        </div>

                    <% } %>



                    <!-- ======================================
                         INSTRUCTIONS
                    ======================================= -->

                    <% if (stock.instructions) { %>

                        <div class="feedstock-description">

                            <span class="field-label">
                                Instructions
                            </span>


                            <p>
                                <%= stock.instructions %>
                            </p>

                        </div>

                    <% } %>



                    <!-- ======================================
                         MESSAGE
                    ======================================= -->

                    <% if (stock.message) { %>

                        <div class="feedstock-description">

                            <span class="field-label">
                                Message
                            </span>


                            <p>
                                <%= stock.message %>
                            </p>

                        </div>

                    <% } %>



                    <!-- ======================================
                         STOCK IMAGES
                    ======================================= -->

                    <% if (
                        Array.isArray(stock.images) &&
                        stock.images.length > 0
                    ) { %>


                        <div class="feedstock-images">


                            <% stock.images.forEach(function(image) { %>


                                <img
                                    src="<%= image %>"
                                    alt="<%= stock.name || 'Stock' %>"
                                    loading="lazy"
                                >


                            <% }); %>


                        </div>


                    <% } %>



                    <!-- ======================================
                         STOCK DATES
                    ======================================= -->

                    <div class="feedstock-dates">


                        <% if (stock.addedAt) { %>

                            <span>

                                Added:
                                <%= formatDate(
                                    stock.addedAt
                                ) %>

                            </span>

                        <% } %>


                        <% if (stock.updatedAt) { %>

                            <span>

                                Updated:
                                <%= formatDate(
                                    stock.updatedAt
                                ) %>

                            </span>

                        <% } %>


                    </div>


                </div>


            <% }); %>


        </div>


    <% } %>


</div>



<style>

/* ==========================================================
   FEED STORE PAGE
========================================================== */

.feedstore-page {

    max-width: 1100px;

    margin: 0 auto;

    padding: 25px 18px 55px;

    box-sizing: border-box;

}


.feedstore-page * {

    box-sizing: border-box;

}


/* ==========================================================
   PAGE HEADER
========================================================== */

.feedstore-header {

    display: flex;

    align-items: center;

    gap: 16px;

    margin-bottom: 25px;

    flex-wrap: wrap;

}


.feedstore-header-content {

    min-width: 0;

    flex: 1;

}


.feedstore-eyebrow {

    color: #0b5d1e;

    font-size: 11px;

    font-weight: 800;

    letter-spacing: 1.8px;

    margin-bottom: 6px;

}


.feedstore-header h1 {

    margin: 0;

    color: #12351c;

    font-size: 28px;

    font-weight: 800;

    line-height: 1.2;

}


.feedstore-header p {

    margin: 7px 0 0;

    color: #6b7280;

    font-size: 14px;

}


/* ==========================================================
   STOCK COUNT
========================================================== */

.feedstore-count {

    display: flex;

    flex-direction: column;

    align-items: center;

    justify-content: center;

    min-width: 90px;

    padding: 12px 16px;

    border: 1px solid #d9eadc;

    border-radius: 14px;

    background: #f2f9f3;

}


.feedstore-count strong {

    color: #0b5d1e;

    font-size: 23px;

    font-weight: 800;

    line-height: 1;

}


.feedstore-count span {

    margin-top: 5px;

    color: #66806d;

    font-size: 11px;

    font-weight: 600;

}


/* ==========================================================
   ADMIN ADD STOCK
========================================================== */

.feedstore-add-stock {

    display: flex;

    align-items: center;

    gap: 10px;

    min-width: 205px;

    padding: 10px 12px;

    border: 1px solid #cfe3d3;

    border-radius: 12px;

    background: #f3f9f4;

    color: #12351c;

    text-decoration: none;

    transition:
        background .2s ease,
        border-color .2s ease,
        box-shadow .2s ease,
        transform .15s ease;

}


.feedstore-add-stock:hover {

    background: #eaf5ec;

    border-color: #a9c9af;

    box-shadow:
        0 5px 15px
        rgba(11, 93, 30, .10);

}


.feedstore-add-stock:active {

    transform: scale(.98);

}


.feedstore-add-icon {

    width: 32px;

    height: 32px;

    flex: 0 0 32px;

    display: flex;

    align-items: center;

    justify-content: center;

    border-radius: 9px;

    background: #0b5d1e;

    color: #ffffff;

    font-size: 18px;

    font-weight: 700;

    line-height: 1;

}


.feedstore-add-content {

    flex: 1;

    min-width: 0;

    display: flex;

    flex-direction: column;

    gap: 2px;

}


.feedstore-add-content strong {

    color: #12351c;

    font-size: 11px;

    font-weight: 800;

}


.feedstore-add-content small {

    color: #718078;

    font-size: 9px;

    line-height: 1.3;

}


.feedstore-add-arrow {

    color: #0b5d1e;

    font-size: 17px;

    font-weight: 900;

}


/* ==========================================================
   STOCK LIST
========================================================== */

.feedstock-list {

    display: flex;

    flex-direction: column;

    gap: 16px;

}


/* ==========================================================
   STOCK CARD
========================================================== */

.feedstock-item {

    position: relative;

    overflow: hidden;

    padding: 20px;

    border: 1px solid #dfe9e1;

    border-radius: 18px;

    background: #ffffff;

    box-shadow:
        0 5px 18px
        rgba(11, 93, 30, .06);

    transition:
        box-shadow .2s ease,
        border-color .2s ease;

}


.feedstock-item:hover {

    border-color: #b9d7bf;

    box-shadow:
        0 8px 25px
        rgba(11, 93, 30, .10);

}


/* ==========================================================
   CARD HEADER
========================================================== */

.feedstock-card-header {

    display: flex;

    justify-content: space-between;

    align-items: flex-start;

    gap: 18px;

    margin-bottom: 15px;

}


.feedstock-main {

    min-width: 0;

    flex: 1;

}


.feedstock-name-row {

    display: flex;

    align-items: center;

    flex-wrap: wrap;

    gap: 9px;

}


.feedstock-name {

    margin: 0;

    color: #173b21;

    font-size: 20px;

    font-weight: 800;

    line-height: 1.3;

}


/* ==========================================================
   CATEGORY
========================================================== */

.feedstock-category {

    display: inline-flex;

    align-items: center;

    min-height: 24px;

    padding: 0 9px;

    border-radius: 999px;

    background: #edf7ef;

    color: #0b5d1e;

    font-size: 10px;

    font-weight: 800;

    letter-spacing: .3px;

    text-transform: uppercase;

}


.feedstock-category.medicine {

    background: #f0f7f2;

    color: #356b42;

}


/* ==========================================================
   STOCK ACTION
========================================================== */

.stock-action-btn {

    flex-shrink: 0;

    display: inline-flex;

    align-items: center;

    justify-content: center;

    gap: 7px;

    min-height: 40px;

    padding: 0 14px;

    border-radius: 10px;

    background: #0b5d1e;

    color: #ffffff;

    text-decoration: none;

    font-size: 12px;

    font-weight: 800;

    white-space: nowrap;

    box-shadow:
        0 4px 10px
        rgba(11, 93, 30, .18);

    transition:
        background .2s ease,
        transform .15s ease,
        box-shadow .2s ease;

}


.stock-action-btn:hover {

    background: #084916;

    box-shadow:
        0 6px 14px
        rgba(11, 93, 30, .24);

}


.stock-action-btn:active {

    transform: scale(.97);

}


.action-icon {

    font-size: 16px;

    line-height: 1;

}


/* ==========================================================
   STOCK FIELDS
========================================================== */

.feedstock-field {

    display: flex;

    justify-content: space-between;

    align-items: center;

    gap: 20px;

    min-height: 42px;

    padding: 8px 0;

    border-top: 1px solid #edf2ee;

}


.field-label {

    color: #718078;

    font-size: 12px;

    font-weight: 600;

}


.field-value {

    color: #193d23;

    font-size: 14px;

    font-weight: 750;

    text-align: right;

}


.field-unit {

    color: #718078;

    font-size: 12px;

    font-weight: 600;

}


.low-stock {

    color: #b45309;

}


/* ==========================================================
   DESCRIPTIONS
========================================================== */

.feedstock-description {

    margin-top: 13px;

    padding-top: 13px;

    border-top: 1px solid #edf2ee;

}


.feedstock-description p {

    margin: 6px 0 0;

    color: #425149;

    font-size: 13px;

    line-height: 1.55;

    white-space: pre-wrap;

}


/* ==========================================================
   IMAGES
========================================================== */

.feedstock-images {

    display: flex;

    flex-wrap: wrap;

    gap: 8px;

    margin-top: 16px;

}


.feedstock-images img {

    display: block;

    width: 78px;

    height: 78px;

    object-fit: cover;

    border: 1px solid #dfe9e1;

    border-radius: 10px;

}


/* ==========================================================
   DATES
========================================================== */

.feedstock-dates {

    display: flex;

    flex-wrap: wrap;

    gap: 12px;

    margin-top: 16px;

    padding-top: 13px;

    border-top: 1px solid #edf2ee;

    color: #89968e;

    font-size: 10px;

}


/* ==========================================================
   EMPTY STATE
========================================================== */

.feedstore-empty {

    padding: 65px 20px;

    border: 1px dashed #bdd4c2;

    border-radius: 18px;

    background: #f8fcf9;

    text-align: center;

}


.empty-icon {

    display: flex;

    align-items: center;

    justify-content: center;

    width: 62px;

    height: 62px;

    margin: 0 auto 15px;

    border-radius: 50%;

    background: #e7f4e9;

    font-size: 28px;

}


.feedstore-empty h2 {

    margin: 0 0 7px;

    color: #173b21;

    font-size: 20px;

}


.feedstore-empty p {

    max-width: 400px;

    margin: 0 auto;

    color: #718078;

    font-size: 13px;

    line-height: 1.5;

}


/* ==========================================================
   EMPTY STATE ADD BUTTON
========================================================== */

.empty-add-stock {

    display: inline-flex;

    align-items: center;

    justify-content: center;

    margin-top: 18px;

    min-height: 40px;

    padding: 0 16px;

    border-radius: 10px;

    background: #0b5d1e;

    color: #ffffff;

    text-decoration: none;

    font-size: 11px;

    font-weight: 800;

    transition:
        background .2s ease,
        transform .15s ease;

}


.empty-add-stock:hover {

    background: #084916;

}


.empty-add-stock:active {

    transform: scale(.97);

}


/* ==========================================================
   MOBILE
========================================================== */

@media (max-width: 600px) {

    .feedstore-page {

        padding:
            18px 13px 45px;

    }


    .feedstore-header {

        align-items: flex-start;

        gap: 12px;

        margin-bottom: 18px;

    }


    .feedstore-header-content {

        min-width: 170px;

    }


    .feedstore-header h1 {

        font-size: 22px;

    }


    .feedstore-header p {

        font-size: 12px;

    }


    .feedstore-count {

        min-width: 72px;

        padding: 10px 9px;

        border-radius: 12px;

    }


    .feedstore-count strong {

        font-size: 19px;

    }


    .feedstore-count span {

        font-size: 9px;

    }


    /* ----------------------------------------------
       ADMIN ADD STOCK
    ---------------------------------------------- */

    .feedstore-add-stock {

        width: 100%;

        min-width: 0;

        order: 3;

    }


    .feedstock-item {

        padding: 16px;

        border-radius: 15px;

    }


    .feedstock-card-header {

        align-items: flex-start;

        gap: 10px;

    }


    .feedstock-name-row {

        display: block;

    }


    .feedstock-name {

        font-size: 18px;

        margin-bottom: 7px;

    }


    .stock-action-btn {

        min-height: 38px;

        padding: 0 11px;

        font-size: 11px;

    }


    .action-icon {

        font-size: 14px;

    }


    .feedstock-field {

        min-height: 40px;

    }


    .field-label {

        font-size: 11px;

    }


    .field-value {

        font-size: 13px;

    }


    .feedstock-images img {

        width: 68px;

        height: 68px;

    }

}


/* ==========================================================
   VERY SMALL SCREENS
========================================================== */

@media (max-width: 400px) {

    .feedstock-card-header {

        display: block;

    }


    .stock-action-btn {

        margin-top: 12px;

    }

}

</style>