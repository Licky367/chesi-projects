<%
/* ==========================================================
   FEED STORE
========================================================== */

const currentDairy = dairy || {};
const currentUser = user || {};

const isAdmin =
    currentUser.role === "admin";


/* ==========================================================
   VALID STOCK ITEMS
==========================================================

   Rules:

   1. Stock MUST have an _id.
   2. Stock MUST have stock.name.
   3. No fallback to feedName or medicineName.
   4. Invalid records are not displayed.
========================================================== */

const feedStoreItems =
    Array.isArray(currentDairy.feedStocks)
        ? currentDairy.feedStocks.filter(function(stock) {

            if (!stock) {
                return false;
            }

            const id =
                String(stock._id || "").trim();

            const name =
                String(stock.name || "").trim();

            return (
                id.length > 0 &&
                name.length > 0
            );

        })
        : [];


/* ==========================================================
   SAFE NUMBER
========================================================== */

function safeNumber(value) {

    const number =
        Number(value);

    return Number.isFinite(number)
        ? number
        : 0;

}


/* ==========================================================
   STOCK NAME
==========================================================

   IMPORTANT:

   stock.name is the ONLY name used here.

   No feedName.
   No medicineName.
   No fallback.
========================================================== */

function stockName(stock) {

    return String(
        stock.name
    ).trim();

}


/* ==========================================================
   STOCK QUANTITY
========================================================== */

function stockQuantity(stock) {

    return safeNumber(
        stock.quantityRemaining
    );

}


/* ==========================================================
   STOCK UNIT
========================================================== */

function stockUnit(stock) {

    return String(
        stock.unit || ""
    ).trim();

}


/* ==========================================================
   LAST UPDATED
========================================================== */

function stockLastUpdated(stock) {

    return (
        stock.updatedAt ||
        stock.lastUpdated ||
        stock.dateUpdated ||
        stock.createdAt ||
        null
    );

}


/* ==========================================================
   FORMAT DATE
========================================================== */

function formatStockDate(value) {

    if (!value) {

        return "Date unavailable";

    }


    const date =
        new Date(value);


    if (
        Number.isNaN(
            date.getTime()
        )
    ) {

        return "Date unavailable";

    }


    return date.toLocaleDateString(
        "en-KE",
        {
            day: "2-digit",
            month: "short",
            year: "numeric"
        }
    );

}

%>


<div
    class="feedstore"
    data-dairy-id="<%= currentDairy._id || "" %>"
>


    <!-- ======================================================
         HEADER
    ======================================================= -->

    <div class="feedstore-header">

        <div>

            <span class="feedstore-eyebrow">
                DAIRY FOODSTOCK
            </span>

            <h1>
                Foodstock
            </h1>

            <p>
                Manage available animal feed and veterinary medicine.
            </p>

        </div>

    </div>



    <!-- ======================================================
         ADD STOCK
    ======================================================= -->

    <% if (isAdmin && currentDairy._id) { %>

        <button
            type="button"
            id="openAddStock"
            class="feedstore-composer"
            data-add-url="/dairy/<%= currentDairy._id %>/feedstore/add"
        >

            <div class="composer-icon">
                ➕
            </div>

            <div class="composer-content">

                <strong>
                    Add stock
                </strong>

                <span>
                    Add animal feed or AgroVets stock
                </span>

            </div>

            <div class="composer-arrow">
                →
            </div>

        </button>

    <% } %>



    <!-- ======================================================
         AVAILABLE STOCK
    ======================================================= -->

    <section class="feedstore-stock-section">

        <div class="section-heading">

            <div>

                <span>
                    CURRENT INVENTORY
                </span>

                <h2>
                    Available Stock
                </h2>

            </div>

            <strong>
                <%= feedStoreItems.length %>
            </strong>

        </div>



        <% if (feedStoreItems.length) { %>


            <div class="stock-list">


                <% feedStoreItems.forEach(
                    function(stock)
                {

                    const id =
                        String(
                            stock._id
                        ).trim();


                    const name =
                        stockName(stock);


                    const quantity =
                        stockQuantity(stock);


                    const unit =
                        stockUnit(stock);


                    const lastUpdated =
                        stockLastUpdated(stock);


                    const formattedDate =
                        formatStockDate(
                            lastUpdated
                        );

                %>


                    <!-- ==================================================
                         STOCK ITEM
                    =================================================== -->

                    <article
                        class="stock-item"
                        tabindex="0"
                        role="button"

                        data-stock-id="<%= id %>"

                        data-stock-name="<%= name %>"

                        data-stock-update-url="/dairy/<%= currentDairy._id %>/feedstore/update/<%= id %>"

                        data-stock-restock-url="/dairy/<%= currentDairy._id %>/feedstore/restock/<%= id %>"
                    >


                        <!-- ==============================================
                             STOCK INFORMATION
                        =============================================== -->

                        <div class="stock-info">


                            <strong class="stock-name">
                                <%= name %>
                            </strong>


                            <span class="stock-updated">

                                Last updated:
                                <%= formattedDate %>

                            </span>


                        </div>



                        <!-- ==============================================
                             QUANTITY
                        =============================================== -->

                        <div class="stock-item-right">


                            <div class="stock-quantity">

                                <strong>
                                    <%= quantity.toLocaleString() %>
                                </strong>


                                <% if (unit) { %>

                                    <span>
                                        <%= unit %>
                                    </span>

                                <% } %>

                            </div>


                            <span class="stock-arrow">
                                →
                            </span>


                        </div>


                    </article>


                <% }); %>


            </div>


        <% } else { %>


            <!-- ======================================================
                 EMPTY STOCK
            ======================================================= -->

            <div class="empty-stock">

                <div>
                    📦
                </div>


                <strong>
                    No stock available
                </strong>


                <span>

                    <% if (isAdmin) { %>

                        Click "Add stock" above to create the first stock item.

                    <% } else { %>

                        No stock has been added yet.

                    <% } %>

                </span>


            </div>


        <% } %>


    </section>


</div>



<!-- ==========================================================
     ADMIN STOCK ACTION MODAL
========================================================== -->

<% if (isAdmin) { %>


<div
    id="stockActionModal"
    class="stock-action-modal"
    hidden
>


    <!-- ======================================================
         BACKDROP
    ======================================================= -->

    <div
        class="stock-action-backdrop"
        data-close-stock-action
    ></div>



    <!-- ======================================================
         DIALOG
    ======================================================= -->

    <div
        class="stock-action-dialog"
        role="dialog"
        aria-modal="true"
        aria-labelledby="stockActionTitle"
    >


        <!-- ==================================================
             HEADER
        =================================================== -->

        <div class="stock-action-header">

            <div>

                <span class="stock-action-eyebrow">
                    STOCK MANAGEMENT
                </span>

                <h2 id="stockActionTitle">
                    Manage Stock
                </h2>

                <p id="stockActionDescription">
                    Choose what you want to do with this stock.
                </p>

            </div>


            <button
                type="button"
                class="stock-action-close"
                data-close-stock-action
                aria-label="Close"
            >
                ×
            </button>

        </div>



        <!-- ==================================================
             OPTIONS
        =================================================== -->

        <div class="stock-action-options">


            <!-- ==================================================
                 UPDATE
            =================================================== -->

            <button
                type="button"
                id="updateStockAction"
                class="stock-action-option"
            >

                <span class="stock-action-icon update-icon">
                    ✏️
                </span>

                <span class="stock-action-text">

                    <strong>
                        Update existing stock
                    </strong>

                    <small>
                        Change stock information or quantity.
                    </small>

                </span>

                <span class="stock-action-arrow">
                    →
                </span>

            </button>



            <!-- ==================================================
                 RESTOCK
            =================================================== -->

            <button
                type="button"
                id="restockStockAction"
                class="stock-action-option"
            >

                <span class="stock-action-icon restock-icon">
                    📦
                </span>

                <span class="stock-action-text">

                    <strong>
                        Restock
                    </strong>

                    <small>
                        Add more quantity to the existing stock.
                    </small>

                </span>

                <span class="stock-action-arrow">
                    →
                </span>

            </button>


        </div>


    </div>


</div>


<% } %>



<style>

/* ==========================================================
   PAGE
========================================================== */

.feedstore {

    width: 100%;

    max-width: 900px;

    margin: 0 auto;

    padding: 15px 12px 50px;

    color: #26352d;

}


.feedstore * {
    box-sizing: border-box;
}


/* ==========================================================
   HEADER
========================================================== */

.feedstore-header {

    margin-bottom: 15px;

}


.feedstore-eyebrow {

    color: #198754;

    font-size: 9px;

    font-weight: 900;

    letter-spacing: 1px;

}


.feedstore-header h1 {

    margin: 3px 0;

    color: #123f29;

    font-size: 25px;

}


.feedstore-header p {

    margin: 0;

    color: #7a857e;

    font-size: 11px;

}


/* ==========================================================
   ADD STOCK
========================================================== */

.feedstore-composer {

    width: 100%;

    display: flex;

    align-items: center;

    gap: 12px;

    padding: 13px;

    margin-bottom: 18px;

    border: 1px solid #cfe3d6;

    border-radius: 13px;

    background: #ffffff;

    color: inherit;

    text-align: left;

    cursor: pointer;

    box-shadow:
        0 3px 12px
        rgba(23,65,43,.05);

    transition:
        transform .15s ease,
        border-color .15s ease,
        box-shadow .15s ease;

}


.feedstore-composer:hover,
.feedstore-composer:focus {

    transform: translateY(-1px);

    border-color: #8fc5a4;

    box-shadow:
        0 6px 18px
        rgba(23,65,43,.09);

}


.feedstore-composer:focus {
    outline: none;
}


.composer-icon {

    width: 42px;
    height: 42px;

    display: flex;

    align-items: center;

    justify-content: center;

    flex-shrink: 0;

    border-radius: 11px;

    background: #e7f5ec;

    color: #198754;

    font-size: 20px;

}


.composer-content {

    min-width: 0;

    display: flex;

    flex-direction: column;

    gap: 2px;

}


.composer-content strong {

    color: #164f31;

    font-size: 13px;

}


.composer-content span {

    color: #7d8982;

    font-size: 10px;

}


.composer-arrow {

    margin-left: auto;

    color: #198754;

    font-size: 18px;

}


/* ==========================================================
   SECTION HEADING
========================================================== */

.section-heading {

    display: flex;

    align-items: center;

    justify-content: space-between;

    margin-bottom: 9px;

}


.section-heading span {

    color: #7d8982;

    font-size: 8px;

    font-weight: 900;

    letter-spacing: .8px;

}


.section-heading h2 {

    margin: 2px 0 0;

    color: #164f31;

    font-size: 18px;

}


.section-heading > strong {

    min-width: 28px;

    padding: 5px 8px;

    border-radius: 999px;

    background: #e8f5ed;

    color: #198754;

    font-size: 10px;

    text-align: center;

}


/* ==========================================================
   STOCK LIST
========================================================== */

.stock-list {

    display: flex;

    flex-direction: column;

    gap: 6px;

}


.stock-item {

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 12px;

    padding: 11px;

    border: 1px solid #dce7e0;

    border-radius: 11px;

    background: #ffffff;

    cursor: pointer;

    outline: none;

    transition:
        transform .15s ease,
        border-color .15s ease,
        box-shadow .15s ease;

}


.stock-item:hover,
.stock-item:focus {

    transform: translateY(-1px);

    border-color: #94caaa;

    box-shadow:
        0 5px 14px
        rgba(23,65,43,.07);

}


/* ==========================================================
   STOCK INFORMATION
========================================================== */

.stock-info {

    min-width: 0;

    display: flex;

    flex-direction: column;

    gap: 3px;

}


.stock-name {

    overflow: hidden;

    color: #29362f;

    font-size: 13px;

    font-weight: 700;

    white-space: nowrap;

    text-overflow: ellipsis;

}


.stock-updated {

    color: #9aa49e;

    font-size: 8px;

}


/* ==========================================================
   RIGHT SIDE / QUANTITY
========================================================== */

.stock-item-right {

    display: flex;

    align-items: center;

    gap: 10px;

    flex-shrink: 0;

}


.stock-quantity {

    display: flex;

    align-items: baseline;

    gap: 4px;

}


.stock-quantity strong {

    color: #198754;

    font-size: 16px;

}


.stock-quantity span {

    color: #7a857e;

    font-size: 9px;

}


.stock-arrow {

    color: #198754;

    font-size: 16px;

}


/* ==========================================================
   EMPTY
========================================================== */

.empty-stock {

    display: flex;

    align-items: center;

    flex-direction: column;

    gap: 5px;

    padding: 30px 15px;

    border: 1px dashed #cbdcd1;

    border-radius: 12px;

    background: #f8fbf9;

    text-align: center;

}


.empty-stock div {

    font-size: 25px;

}


.empty-stock strong {

    color: #334039;

    font-size: 14px;

}


.empty-stock span {

    color: #818c85;

    font-size: 10px;

}


/* ==========================================================
   ADMIN ACTION MODAL
========================================================== */

.stock-action-modal {

    position: fixed;

    inset: 0;

    z-index: 9999;

    display: flex;

    align-items: center;

    justify-content: center;

    padding: 15px;

}


.stock-action-modal[hidden] {

    display: none;

}


/* ==========================================================
   BACKDROP
========================================================== */

.stock-action-backdrop {

    position: absolute;

    inset: 0;

    background:
        rgba(8, 30, 18, .55);

    backdrop-filter:
        blur(3px);

}


/* ==========================================================
   DIALOG
========================================================== */

.stock-action-dialog {

    position: relative;

    width: 100%;

    max-width: 470px;

    overflow: hidden;

    border-radius: 16px;

    background: #ffffff;

    box-shadow:
        0 20px 60px
        rgba(0,0,0,.25);

}


/* ==========================================================
   ACTION HEADER
========================================================== */

.stock-action-header {

    display: flex;

    justify-content: space-between;

    gap: 15px;

    padding: 17px;

    border-bottom: 1px solid #e5ece7;

}


.stock-action-eyebrow {

    color: #198754;

    font-size: 8px;

    font-weight: 900;

    letter-spacing: .8px;

}


.stock-action-header h2 {

    margin: 3px 0;

    color: #164f31;

    font-size: 19px;

}


.stock-action-header p {

    margin: 0;

    color: #7b867f;

    font-size: 10px;

}


.stock-action-close {

    width: 32px;
    height: 32px;

    flex-shrink: 0;

    border: none;

    border-radius: 50%;

    background: #f1f5f2;

    color: #536159;

    font-size: 22px;

    cursor: pointer;

}


/* ==========================================================
   OPTIONS
========================================================== */

.stock-action-options {

    display: flex;

    flex-direction: column;

    gap: 8px;

    padding: 14px;

}


/* ==========================================================
   ACTION OPTION
========================================================== */

.stock-action-option {

    width: 100%;

    display: flex;

    align-items: center;

    gap: 11px;

    padding: 12px;

    border: 1px solid #dce7e0;

    border-radius: 11px;

    background: #ffffff;

    text-align: left;

    cursor: pointer;

    transition:
        transform .15s ease,
        border-color .15s ease,
        background .15s ease;

}


.stock-action-option:hover,
.stock-action-option:focus {

    transform: translateY(-1px);

    border-color: #91c5a3;

    background: #f8fcf9;

    outline: none;

}


/* ==========================================================
   OPTION ICON
========================================================== */

.stock-action-icon {

    width: 40px;
    height: 40px;

    display: flex;

    align-items: center;

    justify-content: center;

    flex-shrink: 0;

    border-radius: 10px;

    font-size: 17px;

}


.update-icon {

    background: #eef6ff;

}


.restock-icon {

    background: #eaf7ee;

}


/* ==========================================================
   OPTION TEXT
========================================================== */

.stock-action-text {

    min-width: 0;

    display: flex;

    flex-direction: column;

    gap: 3px;

}


.stock-action-text strong {

    color: #29362f;

    font-size: 12px;

}


.stock-action-text small {

    color: #7d8982;

    font-size: 9px;

}


.stock-action-arrow {

    margin-left: auto;

    color: #198754;

    font-size: 17px;

}


/* ==========================================================
   MOBILE
========================================================== */

@media (max-width: 600px) {

    .feedstore {

        padding:
            10px 8px 40px;

    }


    .stock-item {

        padding: 9px;

    }


    .stock-item-right {

        gap: 6px;

    }


    .stock-arrow {

        display: none;

    }


    .stock-updated {

        font-size: 7px;

    }


    .stock-action-modal {

        padding: 8px;

    }


    .stock-action-dialog {

        max-width: 100%;

        border-radius: 14px;

    }


    .stock-action-header {

        padding: 13px;

    }


    .stock-action-header h2 {

        font-size: 17px;

    }


    .stock-action-header p {

        font-size: 9px;

    }


    .stock-action-options {

        padding: 11px;

    }


    .stock-action-option {

        padding: 10px;

    }

}

</style>



<script>

document.addEventListener(
    "DOMContentLoaded",
    function () {


        /* ======================================================
           ADD STOCK
        ======================================================= */

        const addStockButton =
            document.getElementById(
                "openAddStock"
            );


        if (addStockButton) {

            addStockButton.addEventListener(
                "click",
                function () {

                    const url =
                        addStockButton.dataset.addUrl;


                    if (url) {

                        window.location.href =
                            url;

                    }

                }
            );

        }



        /* ======================================================
           ADMIN MODAL
        ======================================================= */

        const actionModal =
            document.getElementById(
                "stockActionModal"
            );


        const updateButton =
            document.getElementById(
                "updateStockAction"
            );


        const restockButton =
            document.getElementById(
                "restockStockAction"
            );


        const actionDescription =
            document.getElementById(
                "stockActionDescription"
            );


        let selectedUpdateUrl =
            "";


        let selectedRestockUrl =
            "";



        /* ======================================================
           OPEN ADMIN ACTION MODAL
        ======================================================= */

        function openActionModal(card) {

            if (!actionModal) {

                return;

            }


            selectedUpdateUrl =
                card.dataset.stockUpdateUrl || "";


            selectedRestockUrl =
                card.dataset.stockRestockUrl || "";


            const name =
                card.dataset.stockName ||
                "Stock";


            if (actionDescription) {

                actionDescription.textContent =
                    "Choose what you want to do with " +
                    name +
                    ".";

            }


            actionModal.hidden =
                false;


            document.body.style.overflow =
                "hidden";

        }



        /* ======================================================
           CLOSE ADMIN ACTION MODAL
        ======================================================= */

        function closeActionModal() {

            if (!actionModal) {

                return;

            }


            actionModal.hidden =
                true;


            document.body.style.overflow =
                "";


            selectedUpdateUrl =
                "";


            selectedRestockUrl =
                "";

        }



        /* ======================================================
           CLOSE BUTTONS
        ======================================================= */

        if (actionModal) {

            actionModal
                .querySelectorAll(
                    "[data-close-stock-action]"
                )
                .forEach(
                    function(element) {

                        element.addEventListener(
                            "click",
                            closeActionModal
                        );

                    }
                );

        }



        /* ======================================================
           ESCAPE
        ======================================================= */

        document.addEventListener(
            "keydown",
            function(event) {

                if (
                    event.key === "Escape" &&
                    actionModal &&
                    !actionModal.hidden
                ) {

                    closeActionModal();

                }

            }
        );



        /* ======================================================
           UPDATE
        ======================================================= */

        if (updateButton) {

            updateButton.addEventListener(
                "click",
                function () {

                    if (selectedUpdateUrl) {

                        window.location.href =
                            selectedUpdateUrl;

                    }

                }
            );

        }



        /* ======================================================
           RESTOCK
        ======================================================= */

        if (restockButton) {

            restockButton.addEventListener(
                "click",
                function () {

                    if (selectedRestockUrl) {

                        window.location.href =
                            selectedRestockUrl;

                    }

                }
            );

        }



        /* ======================================================
           STOCK ITEMS
        ======================================================= */

        document
            .querySelectorAll(
                ".stock-item"
            )
            .forEach(
                function(card) {


                    card.addEventListener(
                        "click",
                        function() {


                            <% if (isAdmin) { %>

                                openActionModal(
                                    card
                                );

                            <% } else { %>

                                const url =
                                    card.dataset.stockUpdateUrl;


                                if (url) {

                                    window.location.href =
                                        url;

                                }

                            <% } %>

                        }
                    );



                    /* ==================================================
                       KEYBOARD ACCESS
                    =================================================== */

                    card.addEventListener(
                        "keydown",
                        function(event) {

                            if (
                                event.key === "Enter" ||
                                event.key === " "
                            ) {

                                event.preventDefault();

                                card.click();

                            }

                        }
                    );

                }
            );


    }
);

</script>