<%
/* ==========================================================
   FEED STORE
========================================================== */

const currentDairy = dairy || {};

const feedStocks =
    Array.isArray(currentDairy.feedStocks)
        ? currentDairy.feedStocks
        : [];


/* ==========================================================
   SAFE HELPERS
========================================================== */

function safeNumber(value) {

    const number = Number(value);

    return Number.isFinite(number)
        ? number
        : 0;

}


function formatNumber(value) {

    return safeNumber(value).toLocaleString(
        undefined,
        {
            maximumFractionDigits: 2
        }
    );

}


function formatDate(value) {

    if (!value) {
        return "";
    }

    const date = new Date(value);

    if (Number.isNaN(date.getTime())) {
        return "";
    }

    return date.toLocaleString();

}


function stockCategory(stock) {

    return stock.category === "medicine"
        ? "Medicine"
        : "Feed";

}

%>


<!-- ==========================================================
     FEED STORE PAGE
========================================================== -->

<div class="feedstore-page">


    <!-- ======================================================
         HEADER
    ======================================================= -->

    <div class="feedstore-header">

        <div class="feedstore-header-content">

            <div class="feedstore-eyebrow">
                FEED STORE
            </div>

            <h1>
                <%= currentDairy.name || "Feed Store" %>
            </h1>

            <p>
                Feed store inventory
            </p>

        </div>


        <div class="feedstore-count">

            <strong>
                <%= feedStocks.length %>
            </strong>

            <span>
                Stock Items
            </span>

        </div>

    </div>


    <!-- ======================================================
         EMPTY STATE
    ======================================================= -->

    <% if (feedStocks.length === 0) { %>

        <div class="feedstore-empty">

            <div class="empty-icon">
                📦
            </div>

            <h2>
                No Stock
            </h2>

            <p>
                There are currently no stock items in this
                feed store.
            </p>

        </div>


    <% } else { %>


        <!-- ==================================================
             STOCK LIST
        =================================================== -->

        <div class="feedstock-list">


            <% feedStocks.forEach(function(stock) { %>

                <div
                    class="feedstock-item"
                    data-stock-id="<%= stock._id %>"
                >


                    <!-- ======================================
                         STOCK NAME
                    ======================================= -->

                    <div class="feedstock-main">

                        <h2 class="feedstock-name">

                            <%= stock.name || "Unnamed Stock" %>

                        </h2>


                        <div class="feedstock-category">

                            <%= stockCategory(stock) %>

                        </div>

                    </div>


                    <!-- ======================================
                         CURRENT QUANTITY
                    ======================================= -->

                    <div class="feedstock-field">

                        <span class="field-label">
                            Quantity Remaining
                        </span>

                        <strong>

                            <%= formatNumber(
                                stock.quantityRemaining
                            ) %>

                            <%= stock.unit || "" %>

                        </strong>

                    </div>


                    <!-- ======================================
                         INITIAL QUANTITY
                    ======================================= -->

                    <div class="feedstock-field">

                        <span class="field-label">
                            Initial Quantity
                        </span>

                        <strong>

                            <%= formatNumber(
                                stock.initialQuantity
                            ) %>

                            <%= stock.unit || "" %>

                        </strong>

                    </div>


                    <!-- ======================================
                         PERCENTAGE REMAINING
                    ======================================= -->

                    <div class="feedstock-field">

                        <span class="field-label">
                            Percentage Remaining
                        </span>

                        <strong>

                            <%= formatNumber(
                                stock.percentageRemaining
                            ) %>%

                        </strong>

                    </div>


                    <!-- ======================================
                         UNIT
                    ======================================= -->

                    <div class="feedstock-field">

                        <span class="field-label">
                            Unit
                        </span>

                        <strong>

                            <%= stock.unit || "-" %>

                        </strong>

                    </div>


                    <!-- ======================================
                         UNIT PRICE
                    ======================================= -->

                    <div class="feedstock-field">

                        <span class="field-label">
                            Unit Price
                        </span>

                        <strong>

                            <%= formatNumber(
                                stock.unitPrice
                            ) %>

                        </strong>

                    </div>


                    <!-- ======================================
                         LATEST STOCK ADDITION
                    ======================================= -->

                    <div class="feedstock-field">

                        <span class="field-label">
                            Latest Stock Addition
                        </span>

                        <strong>

                            <%= formatNumber(
                                stock.feedsAmount
                            ) %>

                        </strong>

                    </div>


                    <!-- ======================================
                         EXPECTED DURATION
                    ======================================= -->

                    <% if (stock.expectedDuration) { %>

                        <div class="feedstock-field">

                            <span class="field-label">
                                Expected Duration
                            </span>

                            <strong>

                                <%= stock.expectedDuration %>

                            </strong>

                        </div>

                    <% } %>


                    <!-- ======================================
                         INSTRUCTIONS
                    ======================================= -->

                    <% if (stock.instructions) { %>

                        <div class="feedstock-description">

                            <span class="field-label">
                                Instructions
                            </span>

                            <p>
                                <%= stock.instructions %>
                            </p>

                        </div>

                    <% } %>


                    <!-- ======================================
                         MESSAGE
                    ======================================= -->

                    <% if (stock.message) { %>

                        <div class="feedstock-description">

                            <span class="field-label">
                                Message
                            </span>

                            <p>
                                <%= stock.message %>
                            </p>

                        </div>

                    <% } %>


                    <!-- ======================================
                         IMAGES
                    ======================================= -->

                    <% if (
                        Array.isArray(stock.images) &&
                        stock.images.length > 0
                    ) { %>

                        <div class="feedstock-images">

                            <% stock.images.forEach(function(image) { %>

                                <img
                                    src="<%= image %>"
                                    alt="<%= stock.name || "Stock" %>"
                                    loading="lazy"
                                >

                            <% }); %>

                        </div>

                    <% } %>


                    <!-- ======================================
                         DATES
                    ======================================= -->

                    <div class="feedstock-dates">

                        <% if (stock.addedAt) { %>

                            <span>

                                Added:
                                <%= formatDate(
                                    stock.addedAt
                                ) %>

                            </span>

                        <% } %>


                        <% if (stock.updatedAt) { %>

                            <span>

                                Updated:
                                <%= formatDate(
                                    stock.updatedAt
                                ) %>

                            </span>

                        <% } %>

                    </div>


                </div>

            <% }); %>


        </div>


    <% } %>


</div>


<style>

/* ==========================================================
   FEED STORE PAGE
========================================================== */

.feedstore-page {

    max-width: 1100px;

    margin: 0 auto;

    padding: 25px 18px 55px;

    box-sizing: border-box;

}


/* ==========================================================
   HEADER
========================================================== */

.feedstore-header {

    display: flex;

    justify-content: space-between;

    align-items: flex-start;

    gap: 20px;

    margin-bottom: 25px;

}


.feedstore-header-content {

    min-width: 0;

}


.feedstore-eyebrow {

    font-size: 12px;

    font-weight: 700;

    letter-spacing: 1.5px;

    opacity: .65;

    margin-bottom: 5px;

}


.feedstore-header h1 {

    margin: 0;

    font-size: 28px;

    line-height: 1.2;

}


.feedstore-header p {

    margin: 6px 0 0;

    opacity: .65;

}


/* ==========================================================
   STOCK COUNT
========================================================== */

.feedstore-count {

    display: flex;

    flex-direction: column;

    align-items: center;

    justify-content: center;

    min-width: 90px;

    padding: 12px 16px;

    border-radius: 12px;

    background: #f3f4f6;

    box-sizing: border-box;

}


.feedstore-count strong {

    font-size: 22px;

    line-height: 1;

}


.feedstore-count span {

    margin-top: 5px;

    font-size: 12px;

    opacity: .65;

}


/* ==========================================================
   STOCK LIST
========================================================== */

.feedstock-list {

    display: flex;

    flex-direction: column;

    gap: 14px;

}


/* ==========================================================
   STOCK ITEM
========================================================== */

.feedstock-item {

    padding: 20px;

    border: 1px solid #e5e7eb;

    border-radius: 16px;

    background: #ffffff;

    box-sizing: border-box;

    box-shadow:
        0 2px 8px rgba(0, 0, 0, .04);

}


/* ==========================================================
   STOCK MAIN
========================================================== */

.feedstock-main {

    margin-bottom: 18px;

}


.feedstock-name {

    margin: 0;

    font-size: 20px;

    font-weight: 700;

    line-height: 1.3;

}


.feedstock-category {

    display: inline-block;

    margin-top: 7px;

    padding: 4px 9px;

    border-radius: 999px;

    background: #f3f4f6;

    font-size: 11px;

    font-weight: 700;

}


/* ==========================================================
   STOCK FIELDS
========================================================== */

.feedstock-field {

    display: flex;

    justify-content: space-between;

    align-items: center;

    gap: 20px;

    padding: 10px 0;

    border-top: 1px solid #f0f0f0;

}


.field-label {

    font-size: 12px;

    opacity: .6;

}


.feedstock-field strong {

    text-align: right;

    font-size: 14px;

}


/* ==========================================================
   DESCRIPTION
========================================================== */

.feedstock-description {

    margin-top: 14px;

    padding-top: 14px;

    border-top: 1px solid #f0f0f0;

}


.feedstock-description p {

    margin: 6px 0 0;

    line-height: 1.5;

    white-space: pre-wrap;

}


/* ==========================================================
   IMAGES
========================================================== */

.feedstock-images {

    display: flex;

    flex-wrap: wrap;

    gap: 8px;

    margin-top: 16px;

}


.feedstock-images img {

    width: 80px;

    height: 80px;

    object-fit: cover;

    border-radius: 10px;

    display: block;

}


/* ==========================================================
   DATES
========================================================== */

.feedstock-dates {

    display: flex;

    flex-wrap: wrap;

    gap: 12px;

    margin-top: 16px;

    padding-top: 12px;

    border-top: 1px solid #f0f0f0;

    font-size: 11px;

    opacity: .55;

}


/* ==========================================================
   EMPTY STATE
========================================================== */

.feedstore-empty {

    text-align: center;

    padding: 60px 20px;

    border: 1px dashed #d1d5db;

    border-radius: 16px;

}


.empty-icon {

    font-size: 42px;

    margin-bottom: 12px;

}


.feedstore-empty h2 {

    margin: 0 0 7px;

}


.feedstore-empty p {

    margin: 0;

    opacity: .65;

}


/* ==========================================================
   MOBILE
========================================================== */

@media (max-width: 600px) {

    .feedstore-page {

        padding-left: 14px;

        padding-right: 14px;

    }


    .feedstore-header {

        align-items: center;

    }


    .feedstore-header h1 {

        font-size: 23px;

    }


    .feedstore-count {

        min-width: 75px;

        padding: 10px 12px;

    }


    .feedstock-item {

        padding: 16px;

    }

}

</style>