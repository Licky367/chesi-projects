<style>

    /* ======================================================
       STORAGE CODE GENERATOR
       PAGE-SPECIFIC CSS
       ====================================================== */

    .storage-codegen {
        width: 100%;
        max-width: 1600px;
        margin: 0 auto;
        padding: 24px;
        color: #1f2937;
        font-family: Arial, Helvetica, sans-serif;
    }


    /* ======================================================
       PAGE HEADER
       ====================================================== */

    .storage-codegen__header {
        margin-bottom: 28px;
    }

    .storage-codegen__title {
        margin: 0 0 7px;
        font-size: 28px;
        line-height: 1.25;
        font-weight: 700;
        color: #111827;
    }

    .storage-codegen__description {
        margin: 0;
        color: #6b7280;
        font-size: 14px;
        line-height: 1.6;
    }


    /* ======================================================
       SUMMARY
       ====================================================== */

    .storage-codegen__summary {
        display: grid;
        grid-template-columns: repeat(
            auto-fit,
            minmax(180px, 1fr)
        );
        gap: 14px;
        margin-bottom: 30px;
    }

    .storage-codegen__summary-card {
        min-width: 0;
        padding: 18px;
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        box-shadow:
            0 1px 2px rgba(0, 0, 0, 0.04);
    }

    .storage-codegen__summary-label {
        display: block;
        margin-bottom: 7px;
        color: #6b7280;
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }

    .storage-codegen__summary-value {
        display: block;
        color: #111827;
        font-size: 28px;
        line-height: 1;
        font-weight: 700;
    }


    /* ======================================================
       SECTION
       ====================================================== */

    .storage-codegen__section {
        margin-bottom: 28px;
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        overflow: hidden;
        box-shadow:
            0 1px 2px rgba(0, 0, 0, 0.04);
    }

    .storage-codegen__section-header {
        padding: 17px 20px;
        background: #f9fafb;
        border-bottom: 1px solid #e5e7eb;
    }

    .storage-codegen__section-title {
        margin: 0;
        color: #111827;
        font-size: 18px;
        font-weight: 700;
    }

    .storage-codegen__section-body {
        padding: 20px;
    }


    /* ======================================================
       FARM
       ====================================================== */

    .storage-codegen__farm {
        margin-bottom: 22px;
        border: 1px solid #e5e7eb;
        border-radius: 9px;
        overflow: hidden;
    }

    .storage-codegen__farm:last-child {
        margin-bottom: 0;
    }

    .storage-codegen__farm-header {
        padding: 16px 18px;
        background: #f8fafc;
        border-bottom: 1px solid #e5e7eb;
    }

    .storage-codegen__farm-name {
        margin-bottom: 7px;
        color: #111827;
        font-size: 17px;
        font-weight: 700;
    }

    .storage-codegen__farm-meta {
        color: #6b7280;
        font-size: 12px;
        line-height: 1.6;
    }


    /* ======================================================
       AGROSTORE
       ====================================================== */

    .storage-codegen__agrostore {
        padding: 18px;
        border-bottom: 1px solid #e5e7eb;
    }

    .storage-codegen__agrostore:last-child {
        border-bottom: 0;
    }

    .storage-codegen__agrostore-name {
        margin-bottom: 7px;
        color: #111827;
        font-size: 16px;
        font-weight: 700;
    }

    .storage-codegen__agrostore-meta {
        margin-bottom: 16px;
        color: #6b7280;
        font-size: 12px;
        line-height: 1.7;
    }


    /* ======================================================
       URL DISPLAY
       ====================================================== */

    .storage-codegen__url-block {
        margin-bottom: 18px;
    }

    .storage-codegen__url-label {
        margin-bottom: 7px;
        color: #374151;
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.03em;
    }

    .storage-codegen__url-box {
        width: 100%;
        padding: 11px 13px;
        background: #f3f4f6;
        border: 1px solid #d1d5db;
        border-radius: 7px;
        overflow-x: auto;
        box-sizing: border-box;
    }

    .storage-codegen__url-box code {
        color: #1f2937;
        font-family:
            "Courier New",
            Courier,
            monospace;
        font-size: 12px;
        line-height: 1.6;
        word-break: break-all;
    }

    .storage-codegen__url-link {
        color: #2563eb;
        text-decoration: none;
    }

    .storage-codegen__url-link:hover {
        text-decoration: underline;
    }


    /* ======================================================
       BUTTON
       ====================================================== */

    .storage-codegen__button {
        display: inline-block;
        padding: 7px 12px;
        border: 1px solid #2563eb;
        border-radius: 6px;
        background: #2563eb;
        color: #ffffff;
        font-size: 12px;
        font-weight: 600;
        line-height: 1.4;
        text-decoration: none;
        cursor: pointer;
    }

    .storage-codegen__button:hover {
        background: #1d4ed8;
        border-color: #1d4ed8;
        color: #ffffff;
        text-decoration: none;
    }


    /* ======================================================
       ITEMS
       ====================================================== */

    .storage-codegen__items {
        margin-top: 20px;
        padding-top: 18px;
        border-top: 1px solid #e5e7eb;
    }

    .storage-codegen__items-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 12px;
    }

    .storage-codegen__items-title {
        margin: 0;
        color: #111827;
        font-size: 14px;
        font-weight: 700;
    }

    .storage-codegen__count {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 24px;
        height: 24px;
        padding: 0 7px;
        border-radius: 999px;
        background: #e5e7eb;
        color: #374151;
        font-size: 11px;
        font-weight: 700;
    }


    /* ======================================================
       TABLE WRAPPER
       ====================================================== */

    .storage-codegen__table-wrapper {
        width: 100%;
        overflow-x: auto;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
    }


    /* ======================================================
       TABLE
       ====================================================== */

    .storage-codegen__table {
        width: 100%;
        min-width: 900px;
        border-collapse: collapse;
        background: #ffffff;
    }

    .storage-codegen__table th {
        padding: 11px 12px;
        background: #f9fafb;
        border-bottom: 1px solid #e5e7eb;
        color: #374151;
        font-size: 11px;
        font-weight: 700;
        text-align: left;
        white-space: nowrap;
        text-transform: uppercase;
        letter-spacing: 0.03em;
    }

    .storage-codegen__table td {
        padding: 12px;
        border-bottom: 1px solid #f1f5f9;
        color: #374151;
        font-size: 12px;
        vertical-align: top;
    }

    .storage-codegen__table tbody tr:last-child td {
        border-bottom: 0;
    }

    .storage-codegen__table tbody tr:hover {
        background: #f9fafb;
    }


    /* ======================================================
       CODE
       ====================================================== */

    .storage-codegen__code {
        font-family:
            "Courier New",
            Courier,
            monospace;
        font-size: 11px;
        color: #374151;
        word-break: break-all;
    }


    /* ======================================================
       EMPTY STATE
       ====================================================== */

    .storage-codegen__empty {
        padding: 16px;
        background: #f9fafb;
        border: 1px solid #e5e7eb;
        border-radius: 7px;
        color: #6b7280;
        font-size: 13px;
    }


    /* ======================================================
       ERROR
       ====================================================== */

    .storage-codegen__error {
        padding: 12px;
        background: #fef2f2;
        border: 1px solid #fecaca;
        border-radius: 7px;
        color: #991b1b;
        font-size: 12px;
        line-height: 1.5;
    }


    /* ======================================================
       STATUS
       ====================================================== */

    .storage-codegen__status {
        display: inline-block;
        padding: 4px 8px;
        border-radius: 999px;
        background: #dcfce7;
        color: #166534;
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
    }

    .storage-codegen__status--error {
        background: #fee2e2;
        color: #991b1b;
    }


    /* ======================================================
       RESPONSIVE
       ====================================================== */

    @media (max-width: 900px) {

        .storage-codegen {
            padding: 18px;
        }

        .storage-codegen__title {
            font-size: 24px;
        }

        .storage-codegen__summary {
            grid-template-columns:
                repeat(2, minmax(0, 1fr));
        }

    }


    @media (max-width: 560px) {

        .storage-codegen {
            padding: 14px;
        }

        .storage-codegen__summary {
            grid-template-columns: 1fr;
        }

        .storage-codegen__section-body {
            padding: 14px;
        }

        .storage-codegen__agrostore {
            padding: 14px;
        }

    }

</style>


<div class="storage-codegen">


    <!-- ======================================================
         PAGE HEADER
         ====================================================== -->

    <div class="storage-codegen__header">

        <h1 class="storage-codegen__title">
            Storage URL Code Generator
        </h1>

        <p class="storage-codegen__description">
            Displays all storage URLs generated from the
            Dairy storage relationships.
        </p>

    </div>


    <!-- ======================================================
         SUMMARY
         ====================================================== -->

    <div class="storage-codegen__summary">


        <div class="storage-codegen__summary-card">

            <span class="storage-codegen__summary-label">
                Parent Farms
            </span>

            <span class="storage-codegen__summary-value">
                <%= summary.farmCount %>
            </span>

        </div>


        <div class="storage-codegen__summary-card">

            <span class="storage-codegen__summary-label">
                AgroStores
            </span>

            <span class="storage-codegen__summary-value">
                <%= summary.agroStoreCount %>
            </span>

        </div>


        <div class="storage-codegen__summary-card">

            <span class="storage-codegen__summary-label">
                Valid AgroStores
            </span>

            <span class="storage-codegen__summary-value">
                <%= summary.validAgroStoreCount %>
            </span>

        </div>


        <div class="storage-codegen__summary-card">

            <span class="storage-codegen__summary-label">
                Invalid AgroStores
            </span>

            <span class="storage-codegen__summary-value">
                <%= summary.invalidAgroStoreCount %>
            </span>

        </div>


        <div class="storage-codegen__summary-card">

            <span class="storage-codegen__summary-label">
                AgroStore Items
            </span>

            <span class="storage-codegen__summary-value">
                <%= summary.itemCount %>
            </span>

        </div>


        <div class="storage-codegen__summary-card">

            <span class="storage-codegen__summary-label">
                Contents URLs
            </span>

            <span class="storage-codegen__summary-value">
                <%= summary.contentsUrlCount %>
            </span>

        </div>


        <div class="storage-codegen__summary-card">

            <span class="storage-codegen__summary-label">
                Item Details URLs
            </span>

            <span class="storage-codegen__summary-value">
                <%= summary.itemDetailsUrlCount %>
            </span>

        </div>


        <div class="storage-codegen__summary-card">

            <span class="storage-codegen__summary-label">
                Total URLs
            </span>

            <span class="storage-codegen__summary-value">
                <%= summary.totalUrlCount %>
            </span>

        </div>


    </div>


    <!-- ======================================================
         GENERATED URLS BY FARM
         ====================================================== -->

    <section class="storage-codegen__section">


        <div class="storage-codegen__section-header">

            <h2 class="storage-codegen__section-title">
                Generated Storage URLs
            </h2>

        </div>


        <div class="storage-codegen__section-body">


            <% if (!farms || farms.length === 0) { %>

                <div class="storage-codegen__empty">
                    No parent Dairy Farms were found.
                </div>

            <% } else { %>


                <% farms.forEach(function (farm) { %>


                    <div class="storage-codegen__farm">


                        <!-- ==================================
                             FARM HEADER
                             ================================== -->

                        <div class="storage-codegen__farm-header">

                            <div class="storage-codegen__farm-name">

                                <%= farm.name ||
                                    "Unnamed Dairy Farm" %>

                            </div>


                            <div class="storage-codegen__farm-meta">

                                MongoDB ID:

                                <code class="storage-codegen__code">
                                    <%= farm._id %>
                                </code>

                                &nbsp; | &nbsp;

                                Farm code:

                                <code class="storage-codegen__code">
                                    <%= farm.code %>
                                </code>

                                &nbsp; | &nbsp;

                                AgroStores:

                                <%= farm.agroStoreCount %>

                            </div>

                        </div>


                        <!-- ==================================
                             AGROSTORES
                             ================================== -->

                        <% if (
                            !farm.agroStores ||
                            farm.agroStores.length === 0
                        ) { %>


                            <div class="storage-codegen__agrostore">

                                <div class="storage-codegen__empty">
                                    No AgroStores belong to this farm.
                                </div>

                            </div>


                        <% } else { %>


                            <% farm.agroStores.forEach(function (agroStore) { %>


                                <div class="storage-codegen__agrostore">


                                    <div class="storage-codegen__agrostore-name">

                                        <%= agroStore.name ||
                                            "AgroStore" %>

                                    </div>


                                    <div class="storage-codegen__agrostore-meta">

                                        Storage ID:

                                        <code class="storage-codegen__code">
                                            <%= agroStore._id %>
                                        </code>

                                        &nbsp; | &nbsp;

                                        Room Number:

                                        <code class="storage-codegen__code">
                                            <%= agroStore.roomNumber ??
                                                "—" %>
                                        </code>

                                        &nbsp; | &nbsp;

                                        Asset Code:

                                        <code class="storage-codegen__code">
                                            <%= agroStore.assetCode ??
                                                "—" %>
                                        </code>

                                    </div>


                                    <!-- ==========================
                                         CONTENTS URL
                                         ========================== -->

                                    <div class="storage-codegen__url-block">


                                        <div class="storage-codegen__url-label">
                                            AgroStore Contents URL
                                        </div>


                                        <% if (agroStore.contentsUrl) { %>


                                            <div class="storage-codegen__url-box">

                                                <a
                                                    class="storage-codegen__url-link"
                                                    href="<%= agroStore.contentsUrl %>"
                                                    target="_blank"
                                                    rel="noopener noreferrer"
                                                >

                                                    <code>
                                                        <%= agroStore.contentsUrl %>
                                                    </code>

                                                </a>

                                            </div>


                                            <div style="margin-top: 9px;">

                                                <a
                                                    class="storage-codegen__button"
                                                    href="<%= agroStore.contentsUrl %>"
                                                    target="_blank"
                                                    rel="noopener noreferrer"
                                                >
                                                    Open Contents
                                                </a>

                                            </div>


                                        <% } else { %>


                                            <div class="storage-codegen__error">

                                                <%= agroStore.error ||
                                                    "Contents URL could not be generated." %>

                                            </div>


                                        <% } %>


                                    </div>


                                    <!-- ==========================
                                         ITEMS
                                         ========================== -->

                                    <div class="storage-codegen__items">


                                        <div class="storage-codegen__items-header">

                                            <h3 class="storage-codegen__items-title">
                                                AgroStore Items
                                            </h3>

                                            <span class="storage-codegen__count">
                                                <%= agroStore.items
                                                    ? agroStore.items.length
                                                    : 0 %>
                                            </span>

                                        </div>


                                        <% if (
                                            !agroStore.items ||
                                            agroStore.items.length === 0
                                        ) { %>


                                            <div class="storage-codegen__empty">
                                                No items were found inside
                                                this AgroStore.
                                            </div>


                                        <% } else { %>


                                            <div class="storage-codegen__table-wrapper">


                                                <table class="storage-codegen__table">


                                                    <thead>

                                                        <tr>

                                                            <th>
                                                                Item
                                                            </th>

                                                            <th>
                                                                Item ID
                                                            </th>

                                                            <th>
                                                                Dwell Number
                                                            </th>

                                                            <th>
                                                                Asset Code
                                                            </th>

                                                            <th>
                                                                Details URL
                                                            </th>

                                                            <th>
                                                                Action
                                                            </th>

                                                        </tr>

                                                    </thead>


                                                    <tbody>


                                                        <% agroStore.items.forEach(function (item) { %>


                                                            <tr>


                                                                <td>

                                                                    <strong>
                                                                        <%= item.name ||
                                                                            "Unnamed Item" %>
                                                                    </strong>

                                                                </td>


                                                                <td>

                                                                    <code class="storage-codegen__code">
                                                                        <%= item._id %>
                                                                    </code>

                                                                </td>


                                                                <td>

                                                                    <code class="storage-codegen__code">
                                                                        <%= item.dwellNumber ??
                                                                            "—" %>
                                                                    </code>

                                                                </td>


                                                                <td>

                                                                    <code class="storage-codegen__code">
                                                                        <%= item.assetCode ??
                                                                            "—" %>
                                                                    </code>

                                                                </td>


                                                                <td>


                                                                    <% if (item.detailsUrl) { %>


                                                                        <div class="storage-codegen__url-box">

                                                                            <a
                                                                                class="storage-codegen__url-link"
                                                                                href="<%= item.detailsUrl %>"
                                                                                target="_blank"
                                                                                rel="noopener noreferrer"
                                                                            >

                                                                                <code>
                                                                                    <%= item.detailsUrl %>
                                                                                </code>

                                                                            </a>

                                                                        </div>


                                                                    <% } else { %>


                                                                        <div class="storage-codegen__error">
                                                                            Details URL could not be generated.
                                                                        </div>


                                                                    <% } %>


                                                                </td>


                                                                <td>


                                                                    <% if (item.detailsUrl) { %>


                                                                        <a
                                                                            class="storage-codegen__button"
                                                                            href="<%= item.detailsUrl %>"
                                                                            target="_blank"
                                                                            rel="noopener noreferrer"
                                                                        >
                                                                            Open
                                                                        </a>


                                                                    <% } else { %>

                                                                        —

                                                                    <% } %>


                                                                </td>


                                                            </tr>


                                                        <% }); %>


                                                    </tbody>


                                                </table>


                                            </div>


                                        <% } %>


                                    </div>


                                </div>


                            <% }); %>


                        <% } %>


                    </div>


                <% }); %>


            <% } %>


        </div>

    </section>


    <!-- ======================================================
         ALL AGROSTORE CONTENTS URLS
         ====================================================== -->

    <section class="storage-codegen__section">


        <div class="storage-codegen__section-header">

            <h2 class="storage-codegen__section-title">
                All AgroStore Contents URLs
            </h2>

        </div>


        <div class="storage-codegen__section-body">


            <% if (
                !agroStores ||
                agroStores.length === 0
            ) { %>


                <div class="storage-codegen__empty">
                    No AgroStores found.
                </div>


            <% } else { %>


                <div class="storage-codegen__table-wrapper">


                    <table class="storage-codegen__table">


                        <thead>

                            <tr>

                                <th>Farm</th>
                                <th>Farm Code</th>
                                <th>AgroStore</th>
                                <th>Room Number</th>
                                <th>Storage ID</th>
                                <th>Status</th>
                                <th>Generated URL</th>
                                <th>Action</th>

                            </tr>

                        </thead>


                        <tbody>


                            <% agroStores.forEach(function (agroStore) { %>


                                <tr>


                                    <td>

                                        <%= agroStore.parentFarm
                                            ? (
                                                agroStore.parentFarm.name ||
                                                "Unnamed Farm"
                                            )
                                            : "Missing Farm"
                                        %>

                                    </td>


                                    <td>

                                        <code class="storage-codegen__code">
                                            <%= agroStore.parentFarmCode ??
                                                "—" %>
                                        </code>

                                    </td>


                                    <td>

                                        <%= agroStore.name ||
                                            "AgroStore" %>

                                    </td>


                                    <td>

                                        <code class="storage-codegen__code">
                                            <%= agroStore.roomNumber ??
                                                "—" %>
                                        </code>

                                    </td>


                                    <td>

                                        <code class="storage-codegen__code">
                                            <%= agroStore._id %>
                                        </code>

                                    </td>


                                    <td>


                                        <% if (agroStore.contentsUrl) { %>


                                            <span class="storage-codegen__status">
                                                Valid
                                            </span>


                                        <% } else { %>


                                            <span class="storage-codegen__status storage-codegen__status--error">
                                                Invalid
                                            </span>


                                        <% } %>


                                    </td>


                                    <td>


                                        <% if (agroStore.contentsUrl) { %>


                                            <div class="storage-codegen__url-box">

                                                <a
                                                    class="storage-codegen__url-link"
                                                    href="<%= agroStore.contentsUrl %>"
                                                    target="_blank"
                                                    rel="noopener noreferrer"
                                                >

                                                    <code>
                                                        <%= agroStore.contentsUrl %>
                                                    </code>

                                                </a>

                                            </div>


                                        <% } else { %>


                                            <div class="storage-codegen__error">

                                                <%= agroStore.error ||
                                                    "URL unavailable" %>

                                            </div>


                                        <% } %>


                                    </td>


                                    <td>


                                        <% if (agroStore.contentsUrl) { %>


                                            <a
                                                class="storage-codegen__button"
                                                href="<%= agroStore.contentsUrl %>"
                                                target="_blank"
                                                rel="noopener noreferrer"
                                            >
                                                Open
                                            </a>


                                        <% } else { %>

                                            —

                                        <% } %>


                                    </td>


                                </tr>


                            <% }); %>


                        </tbody>


                    </table>


                </div>


            <% } %>


        </div>

    </section>


    <!-- ======================================================
         ALL ITEM DETAIL URLS
         ====================================================== -->

    <section class="storage-codegen__section">


        <div class="storage-codegen__section-header">

            <h2 class="storage-codegen__section-title">
                All AgroStore Item Detail URLs
            </h2>

        </div>


        <div class="storage-codegen__section-body">


            <% if (
                !items ||
                items.length === 0
            ) { %>


                <div class="storage-codegen__empty">
                    No AgroStore items found.
                </div>


            <% } else { %>


                <div class="storage-codegen__table-wrapper">


                    <table class="storage-codegen__table">


                        <thead>

                            <tr>

                                <th>Farm</th>
                                <th>Farm Code</th>
                                <th>AgroStore</th>
                                <th>Room Number</th>
                                <th>Item</th>
                                <th>Item ID</th>
                                <th>Dwell Number</th>
                                <th>Details URL</th>
                                <th>Action</th>

                            </tr>

                        </thead>


                        <tbody>


                            <% items.forEach(function (item) { %>


                                <tr>


                                    <td>

                                        <%= item.parentFarm
                                            ? (
                                                item.parentFarm.name ||
                                                "Unnamed Farm"
                                            )
                                            : "—"
                                        %>

                                    </td>


                                    <td>

                                        <code class="storage-codegen__code">
                                            <%= item.parentFarmCode ??
                                                "—" %>
                                        </code>

                                    </td>


                                    <td>

                                        <%= item.agroStore
                                            ? (
                                                item.agroStore.name ||
                                                "AgroStore"
                                            )
                                            : "—"
                                        %>

                                    </td>


                                    <td>

                                        <code class="storage-codegen__code">

                                            <%= item.agroStore
                                                ? (
                                                    item.agroStore.roomNumber ??
                                                    "—"
                                                )
                                                : "—"
                                            %>

                                        </code>

                                    </td>


                                    <td>

                                        <strong>
                                            <%= item.name ||
                                                "Unnamed Item" %>
                                        </strong>

                                    </td>


                                    <td>

                                        <code class="storage-codegen__code">
                                            <%= item._id %>
                                        </code>

                                    </td>


                                    <td>

                                        <code class="storage-codegen__code">
                                            <%= item.dwellNumber ??
                                                "—" %>
                                        </code>

                                    </td>


                                    <td>


                                        <% if (item.detailsUrl) { %>


                                            <div class="storage-codegen__url-box">

                                                <a
                                                    class="storage-codegen__url-link"
                                                    href="<%= item.detailsUrl %>"
                                                    target="_blank"
                                                    rel="noopener noreferrer"
                                                >

                                                    <code>
                                                        <%= item.detailsUrl %>
                                                    </code>

                                                </a>

                                            </div>


                                        <% } else { %>


                                            <div class="storage-codegen__error">
                                                Details URL unavailable.
                                            </div>


                                        <% } %>


                                    </td>


                                    <td>


                                        <% if (item.detailsUrl) { %>


                                            <a
                                                class="storage-codegen__button"
                                                href="<%= item.detailsUrl %>"
                                                target="_blank"
                                                rel="noopener noreferrer"
                                            >
                                                Open
                                            </a>


                                        <% } else { %>

                                            —

                                        <% } %>


                                    </td>


                                </tr>


                            <% }); %>


                        </tbody>


                    </table>


                </div>


            <% } %>


        </div>

    </section>


</div>