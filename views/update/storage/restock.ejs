<%
/* ==========================================================
   RESTOCK EXISTING STOCK
   FILE:
       views/update/storage/restock-stock.ejs

   PURPOSE:
       Add a new quantity to an existing stock item.

   STOCK IDENTITY:
       stock._id
       stock.name

   CATEGORY:
       feed     = Animal Feed
       medicine = Veterinary Medicine

   IMPORTANT:
       feedName and medicineName are NOT used here.
========================================================== */

const currentDairy = dairy || {};
const currentUser = user || {};
const currentStock = stock || {};


/* ==========================================================
   USER
========================================================== */

const isAdmin =
    currentUser.role === "admin";


/* ==========================================================
   STOCK ID
========================================================== */

const stockId =
    String(
        currentStock._id || ""
    );


const hasStockId =
    Boolean(stockId);


/* ==========================================================
   STOCK CATEGORY
========================================================== */

const stockCategory =
    String(
        currentStock.category || ""
    ).toLowerCase();


const isFeed =
    stockCategory === "feed";


const isMedicine =
    stockCategory === "medicine";


/* ==========================================================
   STOCK NAME
========================================================== */

const stockName =
    String(
        currentStock.name || ""
    ).trim();


const hasStockName =
    Boolean(stockName);


/* ==========================================================
   STOCK QUANTITY
========================================================== */

const quantity =
    Number(
        currentStock.quantityRemaining
    );


const currentQuantity =
    Number.isFinite(quantity)
        ? quantity
        : 0;


/* ==========================================================
   STOCK UNIT
========================================================== */

const stockUnit =
    String(
        currentStock.unit || ""
    ).trim();


/* ==========================================================
   STOCK PRICE
========================================================== */

const stockPrice =
    Number(
        currentStock.price
    );


const safePrice =
    Number.isFinite(stockPrice)
        ? stockPrice
        : "";


/* ==========================================================
   ADDITIONAL INFORMATION
========================================================== */

const instructions =
    currentStock.instructions ||
    "";


const expectedDuration =
    currentStock.expectedDuration ||
    "";


const message =
    currentStock.message ||
    currentStock.additionalInformation ||
    "";


/* ==========================================================
   VALID STOCK
========================================================== */

const validStock =
    hasStockId &&
    hasStockName &&
    (
        isFeed ||
        isMedicine
    );

%>


<% if (validStock) { %>

<div class="storage-page">

    <!-- ======================================================
         HEADER
    ======================================================= -->

    <header class="storage-header">

        <span class="storage-eyebrow">
            FEED STORE
        </span>

        <h1>
            Restock
        </h1>

        <p>
            Add newly received quantity to this existing
            stock item.
        </p>

    </header>


    <!-- ======================================================
         STOCK SUMMARY
    ======================================================= -->

    <div class="stock-summary">

        <div class="stock-summary-icon">

            <% if (isMedicine) { %>

                💊

            <% } else { %>

                🌾

            <% } %>

        </div>


        <div class="stock-summary-info">

            <strong>
                <%= stockName %>
            </strong>

            <span>
                <%= isMedicine
                    ? "Veterinary Medicine"
                    : "Animal Feed"
                %>
            </span>

        </div>


        <div class="stock-summary-quantity">

            <strong>
                <%= currentQuantity.toLocaleString() %>
            </strong>

            <span>
                <%= stockUnit %>
            </span>

        </div>

    </div>


    <!-- ======================================================
         FORM
    ======================================================= -->

    <form
        id="restockStockForm"
        class="storage-form"
        action="/dairy/<%= currentDairy._id %>/feedstore/restock"
        method="POST"
        enctype="multipart/form-data"
    >

        <!-- ==================================================
             ACTION
        =================================================== -->

        <input
            type="hidden"
            name="action"
            value="restock"
        >


        <!-- ==================================================
             STOCK ID
        =================================================== -->

        <input
            type="hidden"
            name="stockId"
            value="<%= stockId %>"
        >


        <!-- ==================================================
             STOCK TYPE
        =================================================== -->

        <div class="storage-field">

            <label>
                Stock type
            </label>

            <input
                type="text"
                value="<%= isMedicine
                    ? 'Veterinary Medicine'
                    : 'Animal Feed' %>"
                readonly
            >

            <input
                type="hidden"
                name="category"
                value="<%= stockCategory %>"
            >

        </div>


        <!-- ==================================================
             STOCK NAME
        =================================================== -->

        <div class="storage-field">

            <label>
                Stock name
            </label>

            <input
                type="text"
                value="<%= stockName %>"
                readonly
            >

            <input
                type="hidden"
                name="name"
                value="<%= stockName %>"
            >

        </div>


        <!-- ==================================================
             CURRENT STOCK
        =================================================== -->

        <div class="current-stock-box">

            <span>
                CURRENT STOCK
            </span>

            <strong>

                <%= currentQuantity.toLocaleString() %>

                <small>
                    <%= stockUnit %>
                </small>

            </strong>

        </div>


        <!-- ==================================================
             RESTOCK QUANTITY
        =================================================== -->

        <div class="storage-field">

            <label for="restockQuantity">
                Quantity received
            </label>

            <input
                id="restockQuantity"
                type="number"
                name="quantity"
                min="0.01"
                step="0.01"
                placeholder="Enter quantity received"
                required
            >

            <small>
                Enter only the new quantity being received.
            </small>

        </div>


        <!-- ==================================================
             UNIT
        =================================================== -->

        <div class="storage-field">

            <label>
                Unit
            </label>

            <input
                type="text"
                value="<%= stockUnit %>"
                readonly
            >

            <input
                type="hidden"
                name="unit"
                value="<%= stockUnit %>"
            >

        </div>


        <!-- ==================================================
             CALCULATED TOTAL
        =================================================== -->

        <div
            id="newStockPreview"
            class="new-stock-preview"
        >

            <div>

                <span>
                    CURRENT
                </span>

                <strong id="previewCurrent">
                    <%= currentQuantity.toLocaleString() %>
                </strong>

            </div>


            <div class="preview-plus">
                +
            </div>


            <div>

                <span>
                    RESTOCK
                </span>

                <strong id="previewRestock">
                    0
                </strong>

            </div>


            <div class="preview-equals">
                =
            </div>


            <div>

                <span>
                    NEW TOTAL
                </span>

                <strong id="previewTotal">
                    <%= currentQuantity.toLocaleString() %>
                </strong>

            </div>

        </div>


        <% if (isAdmin) { %>

            <!-- ==============================================
                 UNIT PRICE
            =============================================== -->

            <div class="storage-field">

                <label for="restockPrice">
                    Unit price
                </label>

                <div class="money-input">

                    <span>
                        KES
                    </span>

                    <input
                        id="restockPrice"
                        type="number"
                        name="price"
                        min="0"
                        step="0.01"
                        value="<%= safePrice %>"
                        placeholder="Price per unit"
                        required
                    >

                </div>

                <small>
                    Price paid for one unit in this restock.
                </small>

            </div>


            <!-- ==============================================
                 INSTRUCTIONS
            =============================================== -->

            <div class="storage-field">

                <label for="restockInstructions">
                    Instructions of use
                </label>

                <textarea
                    id="restockInstructions"
                    name="instructions"
                    rows="4"
                    maxlength="1500"
                    placeholder="Update instructions if necessary..."
                ><%= instructions %></textarea>

            </div>


            <!-- ==============================================
                 EXPECTED DURATION
            =============================================== -->

            <div class="storage-field">

                <label for="restockDuration">
                    Expected duration
                </label>

                <input
                    id="restockDuration"
                    type="text"
                    name="expectedDuration"
                    maxlength="100"
                    value="<%= expectedDuration %>"
                    placeholder="e.g. Approximately 14 days"
                >

            </div>

        <% } %>


        <!-- ==================================================
             ADDITIONAL INFORMATION
        =================================================== -->

        <div class="storage-field">

            <label for="restockMessage">
                Additional information
            </label>

            <textarea
                id="restockMessage"
                name="message"
                rows="4"
                maxlength="1500"
                placeholder="Add information about this restock..."
            ><%= message %></textarea>

        </div>


        <!-- ==================================================
             PHOTOS
        =================================================== -->

        <div class="storage-field">

            <label for="restockImages">
                Photos
            </label>

            <input
                id="restockImages"
                type="file"
                name="images"
                accept="image/*"
                multiple
            >

        </div>


        <!-- ==================================================
             SUBMIT
        =================================================== -->

        <button
            type="submit"
            id="restockSubmit"
            class="storage-submit"
            disabled
        >

            <span>
                📦
            </span>

            <span>
                Restock
            </span>

        </button>

    </form>

</div>


<% } else { %>

<!-- ==========================================================
     INVALID STOCK
========================================================== -->

<div class="storage-page">

    <div class="invalid-stock">

        <div class="invalid-stock-icon">
            ⚠️
        </div>

        <strong>
            Stock unavailable
        </strong>

        <span>
            This stock item could not be identified.
        </span>

    </div>

</div>

<% } %>


<style>

/* ==========================================================
   PAGE
========================================================== */

.storage-page {

    width: 100%;

    max-width: 650px;

    margin: 0 auto;

    padding: 18px 14px 50px;

    color: #29362f;

}


.storage-page * {

    box-sizing: border-box;

}


/* ==========================================================
   HEADER
========================================================== */

.storage-header {

    margin-bottom: 18px;

}


.storage-eyebrow {

    color: #198754;

    font-size: 9px;

    font-weight: 900;

    letter-spacing: 1px;

}


.storage-header h1 {

    margin: 4px 0;

    color: #123f29;

    font-size: 24px;

}


.storage-header p {

    margin: 0;

    color: #7b867f;

    font-size: 11px;

    line-height: 1.5;

}


/* ==========================================================
   STOCK SUMMARY
========================================================== */

.stock-summary {

    display: flex;

    align-items: center;

    gap: 11px;

    margin-bottom: 12px;

    padding: 12px;

    border: 1px solid #dce7e0;

    border-radius: 12px;

    background: #f8fbf9;

}


.stock-summary-icon {

    width: 40px;

    height: 40px;

    display: flex;

    align-items: center;

    justify-content: center;

    flex-shrink: 0;

    border-radius: 10px;

    background: #e7f5ec;

    font-size: 18px;

}


.stock-summary-info {

    min-width: 0;

    display: flex;

    flex-direction: column;

    gap: 2px;

}


.stock-summary-info strong {

    overflow: hidden;

    color: #164f31;

    font-size: 13px;

    white-space: nowrap;

    text-overflow: ellipsis;

}


.stock-summary-info span {

    color: #7d8982;

    font-size: 9px;

}


.stock-summary-quantity {

    margin-left: auto;

    display: flex;

    align-items: baseline;

    gap: 4px;

    flex-shrink: 0;

}


.stock-summary-quantity strong {

    color: #198754;

    font-size: 16px;

}


.stock-summary-quantity span {

    color: #7a857e;

    font-size: 9px;

}


/* ==========================================================
   FORM
========================================================== */

.storage-form {

    padding: 16px;

    border: 1px solid #dce7e0;

    border-radius: 14px;

    background: #ffffff;

    box-shadow:
        0 5px 20px
        rgba(23, 65, 43, .06);

}


/* ==========================================================
   FIELD
========================================================== */

.storage-field {

    display: flex;

    flex-direction: column;

    gap: 5px;

    margin-bottom: 13px;

}


.storage-field label {

    color: #344139;

    font-size: 10px;

    font-weight: 850;

}


.storage-field input,
.storage-field textarea {

    width: 100%;

    padding: 10px;

    border: 1px solid #d5e1d9;

    border-radius: 8px;

    outline: none;

    background: #ffffff;

    color: #29362f;

    font-family: inherit;

    font-size: 11px;

}


.storage-field textarea {

    resize: vertical;

}


.storage-field input:focus,
.storage-field textarea:focus {

    border-color: #198754;

    box-shadow:
        0 0 0 3px
        rgba(25, 135, 84, .08);

}


.storage-field input[readonly] {

    background: #f2f5f3;

    color: #68746d;

    cursor: not-allowed;

}


.storage-field small {

    color: #87918b;

    font-size: 8px;

}


/* ==========================================================
   CURRENT STOCK
========================================================== */

.current-stock-box {

    display: flex;

    align-items: center;

    justify-content: space-between;

    margin-bottom: 13px;

    padding: 12px;

    border-radius: 9px;

    background: #eef7f1;

}


.current-stock-box > span {

    color: #198754;

    font-size: 8px;

    font-weight: 900;

    letter-spacing: .8px;

}


.current-stock-box > strong {

    color: #164f31;

    font-size: 17px;

}


.current-stock-box small {

    color: #7a857e;

    font-size: 9px;

    font-weight: 500;

}


/* ==========================================================
   PREVIEW
========================================================== */

.new-stock-preview {

    display: grid;

    grid-template-columns:
        1fr
        auto
        1fr
        auto
        1fr;

    align-items: center;

    gap: 7px;

    margin-bottom: 14px;

    padding: 12px;

    border: 1px solid #dce7e0;

    border-radius: 10px;

    background: #fafcfb;

}


.new-stock-preview > div:not(
    .preview-plus,
    .preview-equals
) {

    display: flex;

    flex-direction: column;

    gap: 2px;

}


.new-stock-preview span {

    color: #87918b;

    font-size: 7px;

    font-weight: 900;

    letter-spacing: .5px;

}


.new-stock-preview strong {

    color: #164f31;

    font-size: 14px;

}


.preview-plus,
.preview-equals {

    color: #198754;

    font-size: 15px;

    font-weight: 900;

}


/* ==========================================================
   MONEY
========================================================== */

.money-input {

    display: flex;

    align-items: center;

    border: 1px solid #d5e1d9;

    border-radius: 8px;

    overflow: hidden;

}


.money-input span {

    padding-left: 10px;

    color: #198754;

    font-size: 9px;

    font-weight: 900;

}


.money-input input {

    border: none;

}


.money-input input:focus {

    border: none;

    box-shadow: none;

}


/* ==========================================================
   SUBMIT
========================================================== */

.storage-submit {

    width: 100%;

    min-height: 44px;

    display: flex;

    align-items: center;

    justify-content: center;

    gap: 7px;

    margin-top: 5px;

    border: none;

    border-radius: 9px;

    background: #0d5933;

    color: #ffffff;

    font-family: inherit;

    font-size: 11px;

    font-weight: 850;

    cursor: pointer;

}


.storage-submit:disabled {

    opacity: .45;

    cursor: not-allowed;

}


/* ==========================================================
   INVALID STOCK
========================================================== */

.invalid-stock {

    display: flex;

    align-items: center;

    flex-direction: column;

    gap: 6px;

    padding: 35px 18px;

    border: 1px dashed #d4dfd8;

    border-radius: 14px;

    background: #f8fbf9;

    text-align: center;

}


.invalid-stock-icon {

    font-size: 26px;

}


.invalid-stock strong {

    color: #344139;

    font-size: 14px;

}


.invalid-stock span {

    color: #7d8982;

    font-size: 10px;

}


/* ==========================================================
   MOBILE
========================================================== */

@media (max-width: 600px) {

    .storage-page {

        padding:
            12px 8px 40px;

    }


    .storage-form {

        padding: 13px;

    }


    .new-stock-preview {

        grid-template-columns:
            1fr
            auto
            1fr;

        gap: 8px;

    }


    .preview-equals {

        display: none;

    }


    .stock-summary {

        padding: 10px;

    }


    .stock-summary-info strong {

        font-size: 12px;

    }

}

</style>


<script>

document.addEventListener(
    "DOMContentLoaded",
    function () {

        const quantity =
            document.getElementById(
                "restockQuantity"
            );


        const previewRestock =
            document.getElementById(
                "previewRestock"
            );


        const previewTotal =
            document.getElementById(
                "previewTotal"
            );


        const submit =
            document.getElementById(
                "restockSubmit"
            );


        const originalQuantity =
            <%= currentQuantity %>;


        /* ======================================================
           SAFETY CHECK
        ======================================================= */

        if (
            !quantity ||
            !previewRestock ||
            !previewTotal ||
            !submit
        ) {

            return;

        }


        /* ======================================================
           UPDATE RESTOCK PREVIEW
        ======================================================= */

        function updatePreview() {

            const value =
                Number(
                    quantity.value
                );


            const restockQuantity =
                Number.isFinite(value)
                    ? value
                    : 0;


            const newTotal =
                originalQuantity +
                restockQuantity;


            previewRestock.textContent =
                restockQuantity.toLocaleString();


            previewTotal.textContent =
                newTotal.toLocaleString();


            submit.disabled =
                restockQuantity <= 0;

        }


        /* ======================================================
           EVENTS
        ======================================================= */

        quantity.addEventListener(
            "input",
            updatePreview
        );


        quantity.addEventListener(
            "change",
            updatePreview
        );


        updatePreview();

    }
);

</script>