}



/* ==========================================================
   EDIT SECTION
========================================================== */

.animal-feed-inventory-edit {

    padding:
        16px;

    border-top:
        1px solid
        #edf1ee;

    background:
        #fafcfb;

}


.animal-feed-inventory-form-group {

    margin-bottom:
        14px;

}


.animal-feed-inventory-form-group label {

    display:
        block;

    margin-bottom:
