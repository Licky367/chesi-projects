    font-family:
        inherit;

    font-size:
        14px;

    line-height:
        1.5;

}


.animal-feed-inventory-form-group input:focus,

.animal-feed-inventory-form-group textarea:focus {

    outline:
        none;

    border-color:
        #5f876b;

    box-shadow:
        0 0 0 2px
        rgba(95, 135, 107, .12);

}


.animal-feed-inventory-update-button {

    width:
        100%;

    padding:
        11px
        16px;

    border:
        0;

    border-radius:
        9px;

    background:
        #466f52;

    color:
        #ffffff;

    font-size:
        14px;

    font-weight:
        700;

    cursor:
        pointer;

}


.animal-feed-inventory-update-button:hover {

    background:
        #385d43;

}


.animal-feed-inventory-update-button:active {

    transform:
        scale(.98);

}



/* ==========================================================
   MOBILE
========================================================== */

@media (max-width: 520px) {

    .animal-feed-inventory-item {

        gap:
            12px;

    }


    .animal-feed-inventory-image-wrapper {

        width:
            82px;

        height:
