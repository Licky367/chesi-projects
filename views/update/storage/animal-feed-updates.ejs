    height:
        100%;

    display:
        block;

    object-fit:
        cover;

}


.animal-feed-inventory-information {

    min-width:
        0;

    flex:
        1;

}


.animal-feed-inventory-field {

    margin-bottom:
        12px;

}


.animal-feed-inventory-label {

