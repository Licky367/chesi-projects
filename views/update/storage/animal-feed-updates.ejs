<%
/*
==============================================================
ANIMAL FEED / AGROSTORE INVENTORY ITEM

FILE:
    views/update/storage/animal-feed-updates.ejs

PURPOSE:
    Display ONE actual inventory item stored inside an
    AgroStore.

IMPORTANT:

    storageId
        = AgroStore._id

    agroStore
        = current AgroStore record

    feed._id
        = inventory item's Dairy._id

    feed.dwellNumber
        = AgroStore.roomNumber

RELATIONSHIP:

    agroStore.roomNumber
        ===
    feed.dwellNumber

IMPORTANT:

    This is an INVENTORY ITEM.

    It is NOT:
        • a feed/news post
        • an Update document
        • the AgroStore itself

The page supplies `feed` as one actual inventory record.
==============================================================
*/


/* ==========================================================
   SAFE ITEM
========================================================== */

const item =
    feed || {};


/* ==========================================================
   AGROSTORE IDENTIFIER
========================================================== */

const storageIdentifier =
    storageId ||
    agroStore?._id ||
    "";


/* ==========================================================
   INVENTORY ITEM IDENTIFIER
========================================================== */

const feedIdentifier =
    item._id ||
    "";


/* ==========================================================
   ITEM IMAGE
========================================================== */

const itemImage =
    item.displayImage ||
    (
        Array.isArray(
            item.profileImages
        ) &&
        item.profileImages.length > 0

            ? item.profileImages[0]

            : item.profileImage
    ) ||
    "/images/h1.png";


/* ==========================================================
   ITEM NAME
========================================================== */

const itemName =
    item.name ||
    "Animal Feed";


/* ==========================================================
   ITEM DESCRIPTION
========================================================== */

const itemDescription =
    item.description ||
    "No description provided.";


/* ==========================================================
   ITEM QUANTITY
========================================================== */

const itemQuantity =
    item.quantity !== null &&
    item.quantity !== undefined

        ? item.quantity

        : 0;


/* ==========================================================
   ITEM UNIT
========================================================== */

const itemUnit =
    item.unit ||
    "";


/* ==========================================================
   LATEST STOCK UPDATE NOTE
========================================================== */

const updateNote =
    item.stockUpdateNote ||
    "";


/* ==========================================================
   LAST UPDATED TIME
========================================================== */

const updatedAt =
    item.updatedAt ||
    item.createdAt ||
    null;


/* ==========================================================
   ITEM TYPE
========================================================== */

const normalizedType =
    String(
        item.type ||
        ""
    )
    .trim()
    .toLowerCase();

%>



<article

    class="animal-feed-inventory-card"

    data-feed-id="<%= feedIdentifier %>"

    data-storage-id="<%= storageIdentifier %>"

>


    <!-- ======================================================
         INVENTORY ITEM HEADER
    ====================================================== -->

    <header class="animal-feed-inventory-header">


        <img

            class="animal-feed-inventory-system-image"

            src="/images/h1.png"

            alt="System"

        >


        <div class="animal-feed-inventory-header-content">


            <div class="animal-feed-inventory-system-name">

                System

            </div>


            <div class="animal-feed-inventory-title">

                <%= itemName %>

            </div>


            <div class="animal-feed-inventory-subtitle">

                <% if (
                    normalizedType === "feeds" ||
                    normalizedType === "feed"
                ) { %>

                    Animal Feed Inventory

                <% } else if (
                    normalizedType === "medicine" ||
                    normalizedType === "medicines" ||
                    normalizedType === "meds"
                ) { %>

                    Veterinary Medicine Inventory

                <% } else { %>

                    AgroStore Inventory

                <% } %>

            </div>


            <% if (updatedAt) { %>

                <time

                    class="animal-feed-inventory-time"

                    datetime="<%= new Date(updatedAt).toISOString() %>"

                >

                    <%= new Date(
                        updatedAt
                    ).toLocaleString(
                        "en-KE",
                        {
                            dateStyle: "medium",
                            timeStyle: "short"
                        }
                    ) %>

                </time>

            <% } %>


        </div>


    </header>



    <!-- ======================================================
         INVENTORY ITEM DETAILS
    ====================================================== -->

    <section class="animal-feed-inventory-item">


        <!-- ==================================================
             ITEM IMAGE
        ================================================== -->

        <div class="animal-feed-inventory-image-wrapper">


            <img

                class="animal-feed-inventory-item-image"

                src="<%= itemImage %>"

                alt="<%= itemName %>"

                loading="lazy"

                onerror="this.onerror=null;this.src='/images/h1.png';"

            >


        </div>



        <!-- ==================================================
             ITEM INFORMATION
        ================================================== -->

        <div class="animal-feed-inventory-information">


            <!-- NAME -->

            <div class="animal-feed-inventory-field">


                <span class="animal-feed-inventory-label">

                    Name

                </span>


                <span class="animal-feed-inventory-value">

                    <%= itemName %>

                </span>


            </div>



            <!-- DESCRIPTION -->

            <div class="animal-feed-inventory-field">


                <span class="animal-feed-inventory-label">

                    Description

                </span>


                <span class="animal-feed-inventory-description">

                    <%= itemDescription %>

                </span>


            </div>



            <!-- QUANTITY -->

            <div class="animal-feed-inventory-field">


                <span class="animal-feed-inventory-label">

                    Current quantity

                </span>


                <span
                    class="animal-feed-inventory-current-quantity"
                    data-current-quantity
                >

                    <%= itemQuantity %>

                    <% if (itemUnit) { %>

                        <%= itemUnit %>

                    <% } %>

                </span>


            </div>


        </div>


    </section>



    <!-- ======================================================
         LATEST UPDATE
    ====================================================== -->

    <% if (updateNote) { %>

        <section class="animal-feed-inventory-note">


            <div class="animal-feed-inventory-label">

                Latest update

            </div>


            <div class="animal-feed-inventory-note-text">

                <%= updateNote %>

            </div>


        </section>

    <% } %>



    <!-- ======================================================
         UPDATE STOCK
    ====================================================== -->

    <section class="animal-feed-inventory-edit">


        <form

            class="animal-feed-inventory-form"

            method="POST"

            action="/dairy/<%= storageIdentifier %>/animal-feeds/<%= feedIdentifier %>/update"

        >


            <!-- =================================================
                 QUANTITY
            ================================================= -->

            <div class="animal-feed-inventory-form-group">


                <label
                    for="animal-feed-quantity-<%= feedIdentifier %>"
                >

                    Current quantity

                </label>


                <div class="animal-feed-inventory-quantity-row">


                    <input

                        id="animal-feed-quantity-<%= feedIdentifier %>"

                        type="number"

                        name="quantity"

                        min="0"

                        step="any"

                        value="<%= itemQuantity %>"

                        required

                    >


                    <% if (itemUnit) { %>

                        <span class="animal-feed-inventory-unit">

                            <%= itemUnit %>

                        </span>

                    <% } %>


                </div>


            </div>



            <!-- =================================================
                 ADDITIONAL INFORMATION
            ================================================== -->

            <div class="animal-feed-inventory-form-group">


                <label
                    for="animal-feed-note-<%= feedIdentifier %>"
                >

                    Additional information

                </label>


                <textarea

                    id="animal-feed-note-<%= feedIdentifier %>"

                    name="stockUpdateNote"

                    rows="4"

                    maxlength="5000"

                    placeholder="Enter any additional information about this stock..."

                ><%= updateNote %></textarea>


            </div>



            <!-- =================================================
                 SUBMIT
            ================================================== -->

            <button

                type="submit"

                class="animal-feed-inventory-update-button"

            >

                Update Stock

            </button>


        </form>


    </section>


</article>



<style>

/* ==========================================================
   INVENTORY CARD
========================================================== */

.animal-feed-inventory-card {

    width: 100%;

    max-width: 680px;

    margin:
        0
        auto;

    background:
        #ffffff;

    border:
        1px solid
        #dfe7e1;

    border-radius:
        16px;

    overflow:
        hidden;

    box-shadow:
        0 4px 16px
        rgba(0, 0, 0, .06);

    color:
        #26332a;

}



/* ==========================================================
   HEADER
========================================================== */

.animal-feed-inventory-header {

    display:
        flex;

    align-items:
        flex-start;

    gap:
        12px;

    padding:
        14px
        16px;

    border-bottom:
        1px solid
        #edf1ee;

}


.animal-feed-inventory-system-image {

    width:
        44px;

    height:
        44px;

    flex:
        0 0 44px;

    border-radius:
        50%;

    object-fit:
        cover;

}


.animal-feed-inventory-header-content {

    min-width:
        0;

    flex:
        1;

}


.animal-feed-inventory-system-name {

    font-size:
        14px;

    font-weight:
        700;

}


.animal-feed-inventory-title {

    margin-top:
        3px;

    color:
        #3f654b;

    font-size:
        17px;

    font-weight:
        700;

    line-height:
        1.3;

}


.animal-feed-inventory-subtitle {

    margin-top:
        2px;

    color:
        #718077;

    font-size:
        12px;

}


.animal-feed-inventory-time {

    display:
        block;

    margin-top:
        6px;

    color:
        #8a958e;

    font-size:
        11px;

}



/* ==========================================================
   ITEM
========================================================== */

.animal-feed-inventory-item {

    display:
        flex;

    gap:
        16px;

    padding:
        16px;

}


.animal-feed-inventory-image-wrapper {

    width:
        105px;

    height:
        105px;

    flex:
        0 0 105px;

    overflow:
        hidden;

    border-radius:
        12px;

    background:
        #f0f4f1;

}


.animal-feed-inventory-item-image {

    width:
