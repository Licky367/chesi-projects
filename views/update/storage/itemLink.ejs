<% /*
==========================================================
ANIMAL FEED ITEM LINKS

FILE:
    views/update/storage/itemLink.ejs

PURPOSE:
    Display horizontally scrollable cards linking to the
    animal-feed items generated by the itemLink service.

TITLE:

    user.name, Give any updates concerning the
    dairy.name's animal feeds.

Where:

    dairy.name
        = parent Dairy Farm name

    itemLinks
        = links generated by the itemLink service

Each card displays:

    • Animal-feed item name
    • AgroStore name

Cards are horizontally scrollable.

==========================================================
*/ %>


<%
    const links = Array.isArray(itemLinks)
        ? itemLinks
        : [];
%>


<% if (links.length > 0) { %>

<section
    class="animal-feed-item-links"
    aria-label="Animal feed update links"
>


    <!-- =====================================================
         HEADER
    ====================================================== -->

    <div class="animal-feed-item-links-header">

        <strong class="animal-feed-item-links-title">

            <%= user && user.name
                ? user.name
                : "Give any updates"
            %>

            <span class="animal-feed-item-links-title-normal">
                , Give any updates concerning the
            </span>

            <span class="animal-feed-item-links-farm">

                <%= dairy && dairy.name
                    ? dairy.name
                    : "dairy farm"
                %>'s animal feeds.

            </span>

        </strong>

    </div>



    <!-- =====================================================
         HORIZONTAL CARD SCROLLER
    ====================================================== -->

    <div
        class="animal-feed-item-links-scroll"
        role="list"
        aria-label="Animal feed items"
    >


        <% links.forEach(function (itemLink) { %>


            <%
                if (
                    !itemLink ||
                    !itemLink._id
                ) {
                    return;
                }


                const itemName =
                    itemLink.name ||
                    itemLink.feedName ||
                    itemLink.itemName ||
                    itemLink.title ||
                    "Animal Feed";


                const agroStoreName =
                    itemLink.agroStoreName ||
                    itemLink.storageName ||
                    itemLink.storeName ||
                    "AgroStore";


                const itemHref =
                    itemLink.href ||
                    itemLink.url ||
                    `/dairy/${itemLink._id}`;
            %>


            <!-- =================================================
                 ITEM CARD
            ================================================== -->

            <a
                href="<%= itemHref %>"
                class="animal-feed-item-link-card"
                role="listitem"
                aria-label="Give updates about <%= itemName %>"
            >


                <!-- =============================================
                     ICON
                ============================================== -->

                <div
                    class="animal-feed-item-link-icon"
                    aria-hidden="true"
                >
                    🌾
                </div>



                <!-- =============================================
                     ITEM CONTENT
                ============================================== -->

                <div class="animal-feed-item-link-content">


                    <div class="animal-feed-item-link-name">

                        <%= itemName %>

                    </div>


                    <div class="animal-feed-item-link-store">

                        <%= agroStoreName %>

                    </div>


                </div>



                <!-- =============================================
                     ARROW
                ============================================== -->

                <div
                    class="animal-feed-item-link-arrow"
                    aria-hidden="true"
                >
                    ›
                </div>


            </a>


        <% }); %>


    </div>


</section>



<style>

/* ==========================================================
   ANIMAL FEED ITEM LINKS
========================================================== */

.animal-feed-item-links {

    width: 100%;

    box-sizing: border-box;

    margin:
        0
        0
        18px;

    padding: 0;

    overflow: hidden;

    font-family:
        Arial,
        Helvetica,
        sans-serif;

}



/* ==========================================================
   HEADER
========================================================== */

.animal-feed-item-links-header {

    width: 100%;

    box-sizing: border-box;

    margin:
        0
        0
        10px;

    padding:
        0
        4px;

}



/* ==========================================================
   TITLE
========================================================== */

.animal-feed-item-links-title {

    display: block;

    color:
        #202520;

    font-size:
        15px;

    font-weight:
        700;

    line-height:
        1.4;

}



/* ==========================================================
   NORMAL TITLE TEXT
========================================================== */

.animal-feed-item-links-title-normal {

    color:
        #59645d;

    font-weight:
        500;

}



/* ==========================================================
   FARM NAME
========================================================== */

.animal-feed-item-links-farm {

    color:
        #198754;

    font-weight:
        700;

}



/* ==========================================================
   HORIZONTAL SCROLLER
========================================================== */

.animal-feed-item-links-scroll {

    width: 100%;

    box-sizing: border-box;

    display: flex;

    flex-direction: row;

    flex-wrap: nowrap;

    align-items: stretch;

    justify-content: flex-start;

    gap: 10px;

    overflow-x: auto;

    overflow-y: hidden;

    padding:
        2px
        4px
        8px;

    scroll-behavior: smooth;

    -webkit-overflow-scrolling: touch;

    scrollbar-width: none;

}



/* ==========================================================
   HIDE SCROLLBAR
========================================================== */

.animal-feed-item-links-scroll::-webkit-scrollbar {

    display: none;

}



/* ==========================================================
   CARD
========================================================== */

.animal-feed-item-link-card {

    position: relative;

    flex:
        0 0
        150px;

    width: 150px;

    min-width: 150px;

    height: 112px;

    box-sizing: border-box;

    display: flex;

    flex-direction: column;

    justify-content: flex-start;

    overflow: hidden;

    padding: 12px;

    text-decoration: none;

    border:
        1px solid
        #e1e8e3;

    border-radius: 14px;

    background: #ffffff;

    box-shadow:
        0 2px 8px
        rgba(20, 40, 28, .06);

    transition:
        transform .15s ease,
        box-shadow .15s ease;

}



/* ==========================================================
   HOVER
========================================================== */

.animal-feed-item-link-card:hover {

    transform:
        translateY(-2px);

    box-shadow:
        0 5px 14px
        rgba(20, 40, 28, .10);

}



/* ==========================================================
   ACTIVE
========================================================== */

.animal-feed-item-link-card:active {

    transform:
        scale(.97);

}



/* ==========================================================
   ICON
========================================================== */

.animal-feed-item-link-icon {

    width: 28px;

    height: 28px;

    display: flex;

    align-items: center;

    justify-content: center;

    margin:
        0
        0
        7px;

    border-radius: 9px;

    background:
        #eef7f1;

    font-size: 16px;

}



/* ==========================================================
   CONTENT
========================================================== */

.animal-feed-item-link-content {

    min-width: 0;

    flex:
        1 1 auto;

    padding-right: 16px;

}



/* ==========================================================
   ITEM NAME
========================================================== */

.animal-feed-item-link-name {

    width: 100%;

    color:
        #1f2922;

    font-size: 13px;

    font-weight: 700;

    line-height: 16px;

    overflow: hidden;

    display:
        -webkit-box;

    -webkit-box-orient:
        vertical;

    -webkit-line-clamp: 2;

}



/* ==========================================================
   AGROSTORE NAME
========================================================== */

.animal-feed-item-link-store {

    width: 100%;

    margin-top: 4px;

    color:
        #a0aaa3;

    font-size: 9px;

    font-weight: 500;

    line-height: 12px;

    overflow: hidden;

    text-overflow: ellipsis;

    white-space: nowrap;

}



/* ==========================================================
   ARROW
========================================================== */

.animal-feed-item-link-arrow {

    position: absolute;

    right: 10px;

    bottom: 9px;

    color:
        #9aa69e;

    font-size: 20px;

    line-height: 20px;

}



/* ==========================================================
   FOCUS
========================================================== */

.animal-feed-item-link-card:focus-visible {

    outline:
        2px solid
        #198754;

    outline-offset: 2px;

}



/* ==========================================================
   MOBILE
========================================================== */

@media (max-width: 600px) {

    .animal-feed-item-links {

        margin-bottom: 15px;

    }


    .animal-feed-item-links-title {

        font-size: 13px;

        line-height: 1.4;

    }


    .animal-feed-item-link-card {

        flex-basis: 138px;

        width: 138px;

        min-width: 138px;

        height: 106px;

        padding: 10px;

        border-radius: 13px;

    }


    .animal-feed-item-link-icon {

        width: 26px;

        height: 26px;

        margin-bottom: 6px;

        font-size: 14px;

    }


    .animal-feed-item-link-name {

        font-size: 12px;

        line-height: 15px;

    }


    .animal-feed-item-link-store {

        font-size: 8px;

        line-height: 11px;

    }

}

</style>


<% } %>