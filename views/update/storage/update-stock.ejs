<%
/* ==========================================================
   UPDATE EXISTING STOCK
   FILE:
       views/update/storage/update-stock.ejs
========================================================== */

const currentDairy = dairy || {};
const currentUser = user || {};
const currentStock = stock || {};

const isAdmin =
    currentUser.role === "admin";


/* ==========================================================
   STOCK ID
========================================================== */

const stockId =
    String(
        currentStock._id || ""
    );


/* ==========================================================
   STOCK CATEGORY
========================================================== */

const stockCategory =
    String(
        currentStock.category || ""
    ).toLowerCase();


/* ==========================================================
   STOCK NAME
========================================================== */

const stockName =
    currentStock.name || "";


/* ==========================================================
   CATEGORY-SPECIFIC NAME
========================================================== */

const feedName =
    currentStock.feedName || "";

const medicineName =
    currentStock.medicineName || "";


/* ==========================================================
   QUANTITY
========================================================== */

const quantity =
    Number(
        currentStock.quantityRemaining
    );

const safeQuantity =
    Number.isFinite(quantity)
        ? quantity
        : 0;


/* ==========================================================
   UNIT
========================================================== */

const stockUnit =
    currentStock.unit || "";


/* ==========================================================
   PRICE
========================================================== */

const stockPrice =
    Number(
        currentStock.price
    );

const safePrice =
    Number.isFinite(stockPrice)
        ? stockPrice
        : "";


/* ==========================================================
   INSTRUCTIONS
========================================================== */

const instructions =
    currentStock.instructions || "";


/* ==========================================================
   EXPECTED DURATION
========================================================== */

const expectedDuration =
    currentStock.expectedDuration || "";


/* ==========================================================
   ADDITIONAL INFORMATION
========================================================== */

const message =
    currentStock.message ||
    currentStock.additionalInformation ||
    "";

%>


<div class="storage-page">


    <!-- ======================================================
         HEADER
    ======================================================= -->

    <header class="storage-header">

        <span class="storage-eyebrow">
            FEED STORE
        </span>

        <h1>
            Update Stock
        </h1>

        <p>
            Edit the information attached to this stock item.
        </p>

    </header>



    <!-- ======================================================
         CURRENT STOCK
    ======================================================= -->

    <div class="stock-summary">

        <div class="stock-summary-icon">

            <% if (stockCategory === "medicine") { %>

                💊

            <% } else { %>

                🌾

            <% } %>

        </div>


        <div class="stock-summary-info">

            <strong>
                <%= stockName %>
            </strong>

            <span>
                <%= stockCategory === "medicine"
                    ? "AgroVets"
                    : "Animal Feed"
                %>
            </span>

        </div>


        <div class="stock-summary-quantity">

            <strong>
                <%= safeQuantity.toLocaleString() %>
            </strong>

            <span>
                <%= stockUnit %>
            </span>

        </div>

    </div>



    <!-- ======================================================
         UPDATE FORM
         
         IMPORTANT:
         Browser forms only support GET and POST.

         The hidden _method field tells method-override
         middleware to process this request as PUT.
    ======================================================= -->

    <form
        id="updateStockForm"
        class="storage-form"
        action="/dairy/<%= currentDairy._id %>/feedstore/update/<%= stockId %>"
        method="POST"
        enctype="multipart/form-data"
    >

        <!-- Convert POST into PUT -->
        <input
            type="hidden"
            name="_method"
            value="PUT"
        >


        <!-- Stock ID -->
        <input
            type="hidden"
            name="stockId"
            value="<%= stockId %>"
        >



        <!-- ==================================================
             STOCK NAME
        =================================================== -->

        <div class="storage-field">

            <label for="updateStockName">
                Stock name
            </label>


            <% if (isAdmin) { %>

                <input
                    id="updateStockName"
                    type="text"
                    name="name"
                    value="<%= stockName %>"
                    maxlength="150"
                    placeholder="Enter stock name"
                    required
                >

                <small>
                    The name used to identify this stock item.
                </small>

            <% } else { %>

                <input
                    id="updateStockName"
                    type="text"
                    value="<%= stockName %>"
                    readonly
                >

            <% } %>

        </div>



        <!-- ==================================================
             STOCK TYPE
        =================================================== -->

        <div class="storage-field">

            <label>
                Stock type
            </label>

            <input
                type="text"
                value="<%= stockCategory === 'medicine'
                    ? 'AgroVets'
                    : 'Animal Feed' %>"
                readonly
            >

            <input
                type="hidden"
                name="category"
                value="<%= stockCategory %>"
            >

        </div>



        <!-- ==================================================
             CATEGORY-SPECIFIC TYPE
        =================================================== -->

        <% if (stockCategory === "feed") { %>

            <div class="storage-field">

                <label>
                    Animal feed
                </label>

                <input
                    type="text"
                    value="<%= feedName %>"
                    readonly
                >

                <input
                    type="hidden"
                    name="feedName"
                    value="<%= feedName %>"
                >

            </div>

        <% } else if (stockCategory === "medicine") { %>

            <div class="storage-field">

                <label>
                    AgroVets
                </label>

                <input
                    type="text"
                    value="<%= medicineName %>"
                    readonly
                >

                <input
                    type="hidden"
                    name="medicineName"
                    value="<%= medicineName %>"
                >

            </div>

        <% } %>



        <!-- ==================================================
             QUANTITY / UNIT
        =================================================== -->

        <div class="storage-grid">

            <div class="storage-field">

                <label for="updateQuantity">
                    Quantity
                </label>

                <input
                    id="updateQuantity"
                    type="number"
                    name="quantity"
                    min="0"
                    step="0.01"
                    value="<%= safeQuantity %>"
                    required
                >

                <small>
                    Current stored quantity.
                </small>

            </div>


            <div class="storage-field">

                <label>
                    Unit
                </label>

                <input
                    type="text"
                    value="<%= stockUnit %>"
                    readonly
                >

                <input
                    type="hidden"
                    name="unit"
                    value="<%= stockUnit %>"
                >

            </div>

        </div>



        <% if (isAdmin) { %>

            <!-- ==============================================
                 UNIT PRICE
            =============================================== -->

            <div class="storage-field">

                <label for="updatePrice">
                    Unit price
                </label>

                <div class="money-input">

                    <span>
                        KES
                    </span>

                    <input
                        id="updatePrice"
                        type="number"
                        name="price"
                        min="0"
                        step="0.01"
                        value="<%= safePrice %>"
                    >

                </div>

                <small>
                    Current price for one unit.
                </small>

            </div>



            <!-- ==============================================
                 INSTRUCTIONS
            =============================================== -->

            <div class="storage-field">

                <label for="updateInstructions">
                    Instructions of use
                </label>

                <textarea
                    id="updateInstructions"
                    name="instructions"
                    rows="4"
                    maxlength="1500"
                ><%= instructions %></textarea>

            </div>



            <!-- ==============================================
                 EXPECTED DURATION
            =============================================== -->

            <div class="storage-field">

                <label for="updateDuration">
                    Expected duration
                </label>

                <input
                    id="updateDuration"
                    type="text"
                    name="expectedDuration"
                    maxlength="100"
                    value="<%= expectedDuration %>"
                    placeholder="e.g. Approximately 14 days"
                >

            </div>

        <% } %>



        <!-- ==================================================
             ADDITIONAL INFORMATION
        =================================================== -->

        <div class="storage-field">

            <label for="updateMessage">
                Additional information
            </label>

            <textarea
                id="updateMessage"
                name="message"
                rows="4"
                maxlength="1500"
            ><%= message %></textarea>

        </div>



        <!-- ==================================================
             PHOTOS
        =================================================== -->

        <div class="storage-field">

            <label for="updateImages">
                Add photos
            </label>

            <input
                id="updateImages"
                type="file"
                name="images"
                accept="image/*"
                multiple
            >

        </div>



        <!-- ==================================================
             SUBMIT
        =================================================== -->

        <button
            type="submit"
            class="storage-submit"
        >

            <span>
                💾
            </span>

            <span>
                Save Changes
            </span>

        </button>

    </form>

</div>



<style>

/* ==========================================================
   PAGE
========================================================== */

.storage-page {

    width: 100%;

    max-width: 650px;

    margin: 0 auto;

    padding: 18px 14px 50px;

    color: #29362f;

}


.storage-page * {

    box-sizing: border-box;

}


/* ==========================================================
   HEADER
========================================================== */

.storage-header {

    margin-bottom: 18px;

}


.storage-eyebrow {

    color: #198754;

    font-size: 9px;

    font-weight: 900;

    letter-spacing: 1px;

}


.storage-header h1 {

    margin: 4px 0;

    color: #123f29;

    font-size: 24px;

}


.storage-header p {

    margin: 0;

    color: #7b867f;

    font-size: 11px;

    line-height: 1.5;

}


/* ==========================================================
   STOCK SUMMARY
========================================================== */

.stock-summary {

    display: flex;

    align-items: center;

    gap: 11px;

    margin-bottom: 12px;

    padding: 12px;

    border: 1px solid #dce7e0;

    border-radius: 12px;

    background: #f8fbf9;

}


.stock-summary-icon {

    width: 40px;

    height: 40px;

    display: flex;

    align-items: center;

    justify-content: center;

    flex-shrink: 0;

    border-radius: 10px;

    background: #e7f5ec;

    font-size: 18px;

}


.stock-summary-info {

    min-width: 0;

    display: flex;

    flex-direction: column;

    gap: 2px;

}


.stock-summary-info strong {

    overflow: hidden;

    color: #164f31;

    font-size: 13px;

    white-space: nowrap;

    text-overflow: ellipsis;

}


.stock-summary-info span {

    color: #7d8982;

    font-size: 9px;

}


.stock-summary-quantity {

    margin-left: auto;

    display: flex;

    align-items: baseline;

    gap: 4px;

    flex-shrink: 0;

}


.stock-summary-quantity strong {

    color: #198754;

    font-size: 16px;

}


.stock-summary-quantity span {

    color: #7a857e;

    font-size: 9px;

}


/* ==========================================================
   FORM
========================================================== */

.storage-form {

    padding: 16px;

    border: 1px solid #dce7e0;

    border-radius: 14px;

    background: #ffffff;

    box-shadow:
        0 5px 20px
        rgba(23,65,43,.06);

}


/* ==========================================================
   FIELD
========================================================== */

.storage-field {

    display: flex;

    flex-direction: column;

    gap: 5px;

    margin-bottom: 13px;

}


.storage-field label {

    color: #344139;

    font-size: 10px;

    font-weight: 850;

}


.storage-field input,
.storage-field textarea {

    width: 100%;

    padding: 10px;

    border: 1px solid #d5e1d9;

    border-radius: 8px;

    outline: none;

    background: #ffffff;

    color: #29362f;

    font-family: inherit;

    font-size: 11px;

}


.storage-field textarea {

    resize: vertical;

}


.storage-field input:focus,
.storage-field textarea:focus {

    border-color: #198754;

    box-shadow:
        0 0 0 3px
        rgba(25,135,84,.08);

}


.storage-field input[readonly] {

    background: #f2f5f3;

    color: #68746d;

    cursor: not-allowed;

}


.storage-field small {

    color: #87918b;

    font-size: 8px;

}


/* ==========================================================
   GRID
========================================================== */

.storage-grid {

    display: grid;

    grid-template-columns:
        1fr 1fr;

    gap: 10px;

}


/* ==========================================================
   MONEY
========================================================== */

.money-input {

    display: flex;

    align-items: center;

    border: 1px solid #d5e1d9;

    border-radius: 8px;

    overflow: hidden;

}


.money-input span {

    padding-left: 10px;

    color: #198754;

    font-size: 9px;

    font-weight: 900;

}


.money-input input {

    border: none;

}


.money-input input:focus {

    border: none;

    box-shadow: none;

}


/* ==========================================================
   SUBMIT
========================================================== */

.storage-submit {

    width: 100%;

    min-height: 44px;

    display: flex;

    align-items: center;

    justify-content: center;

    gap: 7px;

    margin-top: 5px;

    border: none;

    border-radius: 9px;

    background: #0d5933;

    color: #ffffff;

    font-family: inherit;

    font-size: 11px;

    font-weight: 850;

    cursor: pointer;

}


.storage-submit:hover {

    background: #0a4729;

}


.storage-submit:active {

    transform: translateY(1px);

}


/* ==========================================================
   MOBILE
========================================================== */

@media (max-width: 600px) {

    .storage-page {

        padding:
            12px 8px 40px;

    }


    .storage-form {

        padding: 13px;

    }


    .storage-grid {

        grid-template-columns: 1fr;

        gap: 0;

    }

}

</style>