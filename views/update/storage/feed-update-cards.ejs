<% /*
==========================================================
ANIMAL FEED UPDATE CARDS

FILE:
    views/update/storage/feed-update-cards.ejs

PURPOSE:
    Display every currently available item/feed inside the
    selected AgroStore.

CARD BEHAVIOUR:
    Each individual card links directly to the details page:

    /dairy/:parentId/contents/:storageId/details/:itemId

IMPORTANT:

    No feed names are hard-coded.

    The cards are generated dynamically from the items
    supplied by the controller.

EXPECTED VARIABLES:

    parentId
        OR
    dairyId
        OR
    dairy._id

    storageId
        OR
    storage._id

    items
        OR
    availableItems
        OR
    availableFeeds

OPTIONAL ITEM IMAGE FIELDS:

    profileImage
    displayImage
    image
    imageUrl

The template falls back to /images/h1.png when no image
is available.
==========================================================
*/ %>


<%
/* ==========================================================
   SAFE PARENT DAIRY ID
========================================================== */

const feedParentId =
    typeof parentId !== "undefined" && parentId
        ? parentId
        : (
            typeof dairyId !== "undefined" && dairyId
                ? dairyId
                : (
                    typeof dairy !== "undefined" &&
                    dairy &&
                    dairy._id
                        ? dairy._id
                        : ""
                )
        );


/* ==========================================================
   SAFE STORAGE ID
========================================================== */

const feedStorageId =
    typeof storageId !== "undefined" && storageId
        ? storageId
        : (
            typeof storage !== "undefined" &&
            storage &&
            storage._id
                ? storage._id
                : ""
        );


/* ==========================================================
   AVAILABLE AGROSTORE ITEMS
========================================================== */

let agroStoreItems = [];


/*
   Prefer the normal "items" variable.
*/

if (
    typeof items !== "undefined" &&
    Array.isArray(items)
) {

    agroStoreItems = items;


/*
   Otherwise use availableItems.
*/

} else if (
    typeof availableItems !== "undefined" &&
    Array.isArray(availableItems)
) {

    agroStoreItems = availableItems;


/*
   Otherwise use availableFeeds.
*/

} else if (
    typeof availableFeeds !== "undefined" &&
    Array.isArray(availableFeeds)
) {

    agroStoreItems = availableFeeds;

}


/* ==========================================================
   HELPER
========================================================== */

function feedDisplayValue(value) {

    return (
        value !== null &&
        value !== undefined &&
        String(value).trim() !== ""
    )
        ? String(value)
        : "";

}


/* ==========================================================
   IMAGE HELPER
========================================================== */

function getFeedImage(item) {

    if (!item) {

        return "/images/h1.png";

    }


    const image =
        item.profileImage ||
        item.displayImage ||
        item.image ||
        item.imageUrl ||
        "";


    if (!image) {

        return "/images/h1.png";

    }


    /*
       If the backend already supplies a complete URL/path,
       use it exactly as supplied.
    */

    return String(image);

}


/* ==========================================================
   CARD TYPE
========================================================== */

function getFeedType(item) {

    if (!item) {

        return "Animal Feed";

    }


    const type =
        feedDisplayValue(
            item.recordType ||
            item.type
        );


    if (!type) {

        return "Animal Feed";

    }


    return type;

}


/* ==========================================================
   CARD ICON
========================================================== */

function getFeedIcon(item) {

    if (!item) {

        return "🌾";

    }


    const type =
        String(
            item.recordType ||
            item.type ||
            ""
        ).toLowerCase();


    if (
        type.includes("feed")
    ) {

        return "🌾";

    }


    if (
        type.includes("silage")
    ) {

        return "🌱";

    }


    if (
        type.includes("hay")
    ) {

        return "🌾";

    }


    if (
        type.includes("mineral")
    ) {

        return "🧂";

    }


    return "🌾";

}


/* ==========================================================
   DETAILS URL HELPER
========================================================== */

function getFeedDetailsUrl(item) {

    if (
        !item ||
        !item._id ||
        !feedParentId ||
        !feedStorageId
    ) {

        return "#";

    }


    return (
        "/dairy/" +
        encodeURIComponent(
            String(feedParentId)
        ) +
        "/contents/" +
        encodeURIComponent(
            String(feedStorageId)
        ) +
        "/details/" +
        encodeURIComponent(
            String(item._id)
        )
    );

}

%>



<!-- ==========================================================
     ANIMAL FEED UPDATE SECTION
========================================================== -->

<section
    class="animal-feed-update-strip"
    aria-label="Available Animal Feed Updates"
>


    <!-- ======================================================
         SECTION HEADER
    ======================================================= -->

    <div class="animal-feed-update-strip-header">

        <div class="animal-feed-update-strip-title">

            <strong>
                Give Any Updates About the Available Animal Feeds
            </strong>

        </div>

    </div>



    <!-- ======================================================
         HORIZONTAL CARD SCROLLER
    ======================================================= -->

    <div
        class="animal-feed-update-scroll"
        role="list"
        aria-label="Available animal feeds"
    >


        <% if (agroStoreItems.length > 0) { %>


            <% agroStoreItems.forEach(function(feed) { %>


                <!-- ==========================================
                     DYNAMIC AGROSTORE ITEM CARD
                =========================================== -->

                <a
                    href="<%= getFeedDetailsUrl(feed) %>"
                    class="animal-feed-update-card"
                    role="listitem"
                    aria-label="Give an update about <%= feedDisplayValue(feed.name) || 'this feed' %>"
                >


                    <!-- ======================================
                         IMAGE
                    ======================================= -->

                    <div class="animal-feed-update-image-wrap">

                        <img
                            src="<%= getFeedImage(feed) %>"
                            alt="<%= feedDisplayValue(feed.name) || 'Animal Feed' %>"
                            class="animal-feed-update-image"
                            loading="lazy"
                            onerror="this.onerror=null;this.src='/images/h1.png';"
                        >

                    </div>



                    <!-- ======================================
                         ITEM NAME
                    ======================================= -->

                    <div class="animal-feed-update-name">

                        <%= feedDisplayValue(feed.name) || "Unnamed Feed" %>

                    </div>



                    <!-- ======================================
                         ITEM TYPE
                    ======================================= -->

                    <div class="animal-feed-update-type">

                        <span
                            class="animal-feed-update-type-icon"
                            aria-hidden="true"
                        >
                            <%= getFeedIcon(feed) %>
                        </span>

                        <span>
                            <%= getFeedType(feed) %>
                        </span>

                    </div>


                </a>


            <% }); %>


        <% } else { %>


            <!-- ==================================================
                 NO AVAILABLE FEEDS
            =================================================== -->

            <div class="animal-feed-update-empty">

                <div
                    class="animal-feed-update-empty-icon"
                    aria-hidden="true"
                >
                    🌾
                </div>

                <div class="animal-feed-update-empty-text">

                    <strong>
                        No available animal feeds
                    </strong>

                    <span>
                        There are currently no available items
                        in this AgroStore.
                    </span>

                </div>

            </div>


        <% } %>


    </div>

</section>



<style>

/* ==========================================================
   ANIMAL FEED UPDATE STRIP
========================================================== */

.animal-feed-update-strip {

    width: 100%;

    margin:
        0
        0
        16px;

    padding: 0;

    overflow: hidden;

    font-family:
        Arial,
        Helvetica,
        sans-serif;

}



/* ==========================================================
   HEADER
========================================================== */

.animal-feed-update-strip-header {

    width: 100%;

    padding:
        0
        2px
        10px;

}



/* ==========================================================
   TITLE
========================================================== */

.animal-feed-update-strip-title {

    width: 100%;

}


.animal-feed-update-strip-title strong {

    display: block;

    color:
        #202520;

    font-size:
        18px;

    font-weight:
        700;

    line-height:
        1.3;

}



/* ==========================================================
   HORIZONTAL SCROLL
========================================================== */

.animal-feed-update-scroll {

    width: 100%;

    display: flex;

    gap:
        10px;

    overflow-x:
        auto;

    overflow-y:
        hidden;

    padding:
        2px
        2px
        8px;

    scroll-behavior:
        smooth;

    -webkit-overflow-scrolling:
        touch;

    scrollbar-width:
        none;

}


.animal-feed-update-scroll::-webkit-scrollbar {

    display:
        none;

}



/* ==========================================================
   CARD
========================================================== */

.animal-feed-update-card {

    position:
        relative;

    flex:
        0 0
        116px;

    width:
        116px;

    height:
        178px;

    display:
        flex;

    flex-direction:
        column;

    overflow:
        hidden;

    text-decoration:
        none;

    border:
        1px solid
        #e4e9e6;

    border-radius:
        15px;

    background:
        #ffffff;

    box-shadow:
        0 2px 8px
        rgba(20, 40, 28, .06);

    transition:
        transform .16s ease,
        box-shadow .16s ease;

}



/* ==========================================================
   HOVER
========================================================== */

.animal-feed-update-card:hover {

    transform:
        translateY(-2px);

    box-shadow:
        0 5px 14px
        rgba(20, 40, 28, .10);

}



/* ==========================================================
   ACTIVE
========================================================== */

.animal-feed-update-card:active {

    transform:
        scale(.97);

}



/* ==========================================================
   IMAGE WRAPPER
========================================================== */

.animal-feed-update-image-wrap {

    position:
        relative;

    width:
        100%;

    height:
        116px;

    flex:
        0 0
        116px;

    overflow:
        hidden;

    background:
        #eef3ef;

}



/* ==========================================================
   IMAGE
========================================================== */

.animal-feed-update-image {

    width:
        100%;

    height:
        100%;

    display:
        block;

    object-fit:
        cover;

}



/* ==========================================================
   FEED NAME
========================================================== */

.animal-feed-update-name {

    width:
        100%;

    padding:
        8px
        8px
        2px;

    box-sizing:
        border-box;

    color:
        #202520;

    font-size:
        13px;

    font-weight:
        700;

    line-height:
        16px;

    overflow:
        hidden;

    display:
        -webkit-box;

    -webkit-box-orient:
        vertical;

    -webkit-line-clamp:
        2;

}



/* ==========================================================
   FEED TYPE
========================================================== */

.animal-feed-update-type {

    width:
        100%;

    display:
        flex;

    align-items:
        center;

    gap:
        4px;

    padding:
        1px
        8px
        8px;

    box-sizing:
        border-box;

    color:
        #7b847e;

    font-size:
        10px;

    line-height:
        13px;

    overflow:
        hidden;

}



/* ==========================================================
   TYPE ICON
========================================================== */

.animal-feed-update-type-icon {

    flex:
        0 0 auto;

    font-size:
        10px;

}



/* ==========================================================
   TYPE TEXT
========================================================== */

.animal-feed-update-type span:last-child {

    min-width:
        0;

    overflow:
        hidden;

    text-overflow:
        ellipsis;

    white-space:
        nowrap;

}



/* ==========================================================
   FOCUS
========================================================== */

.animal-feed-update-card:focus-visible {

    outline:
        2px solid
        #198754;

    outline-offset:
        2px;

}



/* ==========================================================
   EMPTY STATE
========================================================== */

.animal-feed-update-empty {

    flex:
        0 0
        100%;

    min-height:
        86px;

    display:
        flex;

    align-items:
        center;

    gap:
        12px;

    padding:
        14px;

    box-sizing:
        border-box;

    border:
        1px solid
        #e4e9e6;

    border-radius:
        14px;

    background:
        #fafcfb;

}


.animal-feed-update-empty-icon {

    flex:
        0 0
        42px;

    width:
        42px;

    height:
        42px;

    display:
        flex;

    align-items:
        center;

    justify-content:
        center;

    border-radius:
        11px;

    background:
        #edf5ef;

    font-size:
        20px;

}


.animal-feed-update-empty-text {

    min-width:
        0;

    display:
        flex;

    flex-direction:
        column;

    gap:
        3px;

}


.animal-feed-update-empty-text strong {

    color:
        #34483a;

    font-size:
        12px;

    font-weight:
        750;

}


.animal-feed-update-empty-text span {

    color:
        #7d8981;

    font-size:
        10px;

    line-height:
        1.45;

}



/* ==========================================================
   MOBILE
========================================================== */

@media (max-width: 600px) {


    .animal-feed-update-strip {

        margin-bottom:
            14px;

    }


    .animal-feed-update-strip-title strong {

        font-size:
            17px;

    }


    .animal-feed-update-card {

        flex-basis:
            112px;

        width:
            112px;

        height:
            174px;

        border-radius:
            14px;

    }


    .animal-feed-update-image-wrap {

        height:
            112px;

        flex-basis:
            112px;

    }


    .animal-feed-update-name {

        padding:
            7px
            7px
            2px;

        font-size:
            12px;

        line-height:
            15px;

    }


    .animal-feed-update-type {

        padding:
            1px
            7px
            7px;

        font-size:
            9px;

    }


    .animal-feed-update-type-icon {

        font-size:
            9px;

    }


    .animal-feed-update-empty {

        min-height:
            78px;

    }

}

</style>