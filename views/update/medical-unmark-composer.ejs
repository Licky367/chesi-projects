<% /*
============================================================
MEDICAL UNMARK COMPOSER

FILE:
    views/update/medical-unmark-composer.ejs

PURPOSE:
    Compact card for clearing medical attention from the
    CURRENT dairy asset.

TARGET:
    The current dairy/asset is ALWAYS the target.

FORM:
    POST /dairy/:id/medical-unmark

SIZE:
    Same as create.ejs:
        Desktop: 112px × 155px
        Mobile:  108px × 150px
============================================================
*/ %>

<% if (
    dairy &&
    user &&
    user.role === "admin" &&
    dairy.medicalAttention &&
    dairy.medicalAttention.isMarked
) { %>

<section class="medical-unmark-composer">

    <button
        type="button"
        class="medical-unmark-composer__card"
        onclick="toggleMedicalUnmarkComposer('<%= dairy._id %>')"
        aria-label="Clear medical attention for <%= dairy.name %>"
    >

        <span class="medical-unmark-composer__icon">
            ✓
        </span>

        <span class="medical-unmark-composer__label">
            Clear Medical
        </span>

        <span class="medical-unmark-composer__target">
            <%= dairy.name %>
        </span>

    </button>


    <form
        id="medicalUnmarkComposerForm-<%= dairy._id %>"
        class="medical-unmark-composer__form"
        action="/dairy/<%= dairy._id %>/medical-unmark"
        method="POST"
    >

        <div class="medical-unmark-composer__form-title">
            Clear Medical Attention
        </div>

        <input
            type="number"
            name="charges"
            min="0"
            step="0.01"
            placeholder="Charges (KES)"
            required
        >

        <textarea
            name="description"
            rows="3"
            maxlength="1000"
            placeholder="Treatment summary..."
            required
        ></textarea>

        <button type="submit">
            Confirm Clearance
        </button>

    </form>

</section>


<style>

.medical-unmark-composer,
.medical-unmark-composer * {
    box-sizing: border-box;
}


.medical-unmark-composer {

    width: 112px;

    flex: 0 0 112px;

    margin: 0 0 16px;

}


.medical-unmark-composer__card {

    position: relative;

    width: 112px;
    height: 155px;

    padding: 0;

    display: flex;

    flex-direction: column;

    align-items: center;
    justify-content: center;

    gap: 7px;

    overflow: hidden;

    border: 1px solid #dce7e0;

    border-radius: 15px;

    background:
        linear-gradient(
            145deg,
            #ffffff,
            #f3f8f5
        );

    color: #198754;

    font-family: inherit;

    cursor: pointer;

    text-align: center;

    transition:
        transform .15s ease,
        border-color .15s ease,
        box-shadow .15s ease;
}


.medical-unmark-composer__card:hover {

    border-color: #198754;

    box-shadow:
        0 5px 15px rgba(25, 135, 84, .10);
}


.medical-unmark-composer__card:active {

    transform: scale(.95);
}


.medical-unmark-composer__card:focus-visible {

    outline: 2px solid #198754;

    outline-offset: 2px;
}


.medical-unmark-composer__icon {

    width: 48px;
    height: 48px;

    display: flex;

    align-items: center;
    justify-content: center;

    border-radius: 50%;

    background: #198754;

    color: #ffffff;

    font-size: 25px;

    font-weight: 700;

    line-height: 1;

    box-shadow:
        0 4px 12px rgba(25, 135, 84, .20);
}


.medical-unmark-composer__label {

    display: block;

    color: #26322b;

    font-size: 13px;

    font-weight: 700;

    line-height: 1.2;
}


.medical-unmark-composer__target {

    display: block;

    max-width: 88px;

    overflow: hidden;

    color: #8a928d;

    font-size: 10px;

    line-height: 1.25;

    white-space: nowrap;

    text-overflow: ellipsis;
}


/* =========================================================
   FORM
========================================================= */

.medical-unmark-composer__form {

    display: none;

    width: 100%;

    margin-top: 8px;

    padding: 10px;

    flex-direction: column;

    gap: 8px;

    border: 1px solid #dce7e0;

    border-radius: 12px;

    background: #f7faf8;
}


.medical-unmark-composer__form--visible {

    display: flex;
}


.medical-unmark-composer__form-title {

    color: #14532d;

    font-size: 12px;

    font-weight: 800;
}


.medical-unmark-composer__form input,
.medical-unmark-composer__form textarea {

    width: 100%;

    padding: 9px;

    border: 1px solid #d7e2da;

    border-radius: 8px;

    outline: none;

    background: #ffffff;

    color: #26322b;

    font: inherit;

    font-size: 12px;
}


.medical-unmark-composer__form textarea {

    min-height: 70px;

    resize: vertical;
}


.medical-unmark-composer__form input:focus,
.medical-unmark-composer__form textarea:focus {

    border-color: #198754;

    box-shadow:
        0 0 0 2px rgba(25, 135, 84, .08);
}


.medical-unmark-composer__form button {

    width: 100%;

    padding: 9px;

    border: none;

    border-radius: 8px;

    background: #198754;

    color: #ffffff;

    font: inherit;

    font-size: 12px;

    font-weight: 700;

    cursor: pointer;
}


@media (max-width: 600px) {

    .medical-unmark-composer {

        width: 108px;

        flex-basis: 108px;
    }


    .medical-unmark-composer__card {

        width: 108px;

        height: 150px;
    }


    .medical-unmark-composer__icon {

        width: 46px;
        height: 46px;

        font-size: 24px;
    }

}

</style>


<script>

(function () {

    "use strict";

    window.toggleMedicalUnmarkComposer = function (id) {

        const form =
            document.getElementById(
                "medicalUnmarkComposerForm-" + id
            );

        if (!form) return;

        form.classList.toggle(
            "medical-unmark-composer__form--visible"
        );

    };

})();

</script>

<% } %>