<% /*
============================================================
MEDICAL UNMARK COMPOSER

FILE:
    views/update/medical-unmark-composer.ejs

PURPOSE:
    Compact card for clearing medical attention from the
    CURRENT dairy asset.

    Clicking the card opens a FULL-SCREEN modal.

TARGET:
    The current dairy/asset is ALWAYS the target.

AUTHORIZED USER:
    admin only.

CONDITION:
    dairy.medicalAttention.isMarked === true

FORM:
    POST /dairy/:id/medical-unmark

SIZE:
    Same as create.ejs:

        Desktop:
            112px × 155px

        Mobile:
            108px × 150px
============================================================
*/ %>


<% if (
    dairy &&
    user &&
    user.role === "admin" &&
    dairy.medicalAttention &&
    dairy.medicalAttention.isMarked
) { %>


<!-- =========================================================
     MEDICAL CLEAR CARD
========================================================= -->

<section
    class="medical-unmark-composer"
    data-medical-unmark-card
    data-dairy-id="<%= dairy._id %>"
>


    <button
        type="button"
        class="medical-unmark-composer__card"
        data-open-medical-unmark
        aria-label="Clear medical attention for <%= dairy.name %>"
    >


        <!-- =================================================
             ICON
        ================================================== -->

        <span
            class="medical-unmark-composer__icon"
            aria-hidden="true"
        >
            <i class="bi bi-check-lg"></i>
        </span>


        <!-- =================================================
             LABEL
        ================================================== -->

        <span class="medical-unmark-composer__label">
            Clear Medical
        </span>


        <!-- =================================================
             TARGET
        ================================================== -->

        <span class="medical-unmark-composer__target">

            <%= dairy.name %>

        </span>


    </button>

</section>



<!-- =========================================================
     FULL-SCREEN MEDICAL CLEAR MODAL
========================================================= -->

<div
    class="medical-unmark-modal"
    data-medical-unmark-modal
    aria-hidden="true"
>


    <div class="medical-unmark-modal__content">


        <!-- =================================================
             MODAL HEADER
        ================================================== -->

        <header class="medical-unmark-modal__header">


            <button
                type="button"
                class="medical-unmark-modal__back"
                data-close-medical-unmark
                aria-label="Go back"
            >

                <i
                    class="bi bi-arrow-left"
                    aria-hidden="true"
                ></i>

            </button>


            <div class="medical-unmark-modal__title">

                <strong>
                    Clear Medical Attention
                </strong>

                <span>
                    <%= dairy.name %>
                </span>

            </div>


            <div
                class="medical-unmark-modal__spacer"
                aria-hidden="true"
            ></div>


        </header>



        <!-- =================================================
             MODAL BODY
        ================================================== -->

        <main class="medical-unmark-modal__body">


            <div class="medical-unmark-modal__fields">


                <!-- =================================================
                     QUESTION
                ================================================== -->

                <div class="medical-unmark-question">

                    <strong>
                        <%= user.name.split(" ")[0] %>
                    </strong>,

                    has the medical treatment for this
                    facility/asset been completed?

                </div>



                <!-- =================================================
                     TARGET ASSET
                ================================================== -->

                <section
                    class="medical-unmark-target"
                    aria-label="Medical attention target"
                >


                    <% if (
                        dairy.profileImage &&
                        dairy.profileImage.trim() !== ""
                    ) { %>

                        <img
                            src="<%= dairy.profileImage %>"
                            class="medical-unmark-target__image"
                            alt="<%= dairy.name %>"
                        >

                    <% } else { %>

                        <div
                            class="medical-unmark-target__placeholder"
                            aria-hidden="true"
                        >

                            <i class="bi bi-heart-pulse"></i>

                        </div>

                    <% } %>


                    <div class="medical-unmark-target__info">

                        <span>
                            Medical attention currently required
                        </span>

                        <strong>
                            <%= dairy.name %>
                        </strong>

                    </div>


                </section>



                <!-- =================================================
                     MEDICAL STATUS
                ================================================== -->

                <div class="medical-unmark-status">


                    <span
                        class="medical-unmark-status__icon"
                        aria-hidden="true"
                    >
                        <i class="bi bi-heart-pulse"></i>
                    </span>


                    <div>

                        <strong>
                            Medical attention active
                        </strong>

                        <span>
                            Record the treatment completed below
                            to clear the medical status.
                        </span>

                    </div>


                </div>



                <!-- =================================================
                     CLEAR MEDICAL FORM
                ================================================== -->

                <form
                    class="medical-unmark-form"
                    action="/dairy/<%= dairy._id %>/medical-unmark"
                    method="POST"
                    autocomplete="off"
                >


                    <!-- =============================================
                         CHARGES
                    ============================================== -->

                    <div class="medical-unmark-field">

                        <label for="medicalUnmarkCharges">

                            Charges incurred

                        </label>


                        <div class="medical-unmark-money-input">

                            <span>
                                KES
                            </span>


                            <input
                                type="number"
                                id="medicalUnmarkCharges"
                                name="charges"
                                min="0"
                                step="0.01"
                                inputmode="decimal"
                                placeholder="0.00"
                                required
                            >

                        </div>

                    </div>



                    <!-- =============================================
                         TREATMENT SUMMARY
                    ============================================== -->

                    <div class="medical-unmark-field">

                        <label for="medicalUnmarkDescription">

                            Treatment completed

                        </label>


                        <textarea
                            id="medicalUnmarkDescription"
                            name="description"
                            maxlength="1000"
                            rows="5"
                            placeholder="Describe the treatment or medical work completed..."
                            required
                        ></textarea>


                        <span
                            class="medical-unmark-character-counter"
                            data-medical-unmark-counter
                        >
                            0/1000
                        </span>

                    </div>



                    <!-- =============================================
                         SUBMIT
                    ============================================== -->

                    <button
                        type="submit"
                        class="medical-unmark-submit-button"
                        data-medical-unmark-submit
                        disabled
                    >

                        <i
                            class="bi bi-check-circle"
                            aria-hidden="true"
                        ></i>

                        <span>
                            Clear Medical Attention
                        </span>

                    </button>


                </form>


            </div>

        </main>


    </div>

</div>



<!-- =========================================================
     CSS
========================================================= -->

<style>

/* =========================================================
   ROOT
========================================================= */

.medical-unmark-composer,
.medical-unmark-composer *,
.medical-unmark-modal,
.medical-unmark-modal * {

    box-sizing: border-box;

}



/* =========================================================
   REAL UPDATE CARD
========================================================= */

.medical-unmark-composer {

    width: 112px;

    flex: 0 0 112px;

    margin: 0 0 16px;

}


.medical-unmark-composer__card {

    position: relative;

    width: 112px;
    height: 155px;

    padding: 0;

    display: flex;

    flex-direction: column;

    align-items: center;
    justify-content: center;

    gap: 7px;

    overflow: hidden;

    border: 1px solid #dce7e0;

    border-radius: 15px;

    background:
        linear-gradient(
            145deg,
            #ffffff,
            #f3f8f5
        );

    color: #198754;

    font-family: inherit;

    cursor: pointer;

    text-align: center;

    transition:
        transform .15s ease,
        border-color .15s ease,
        box-shadow .15s ease;

}


.medical-unmark-composer__card:hover {

    border-color: #198754;

    box-shadow:
        0 5px 15px
        rgba(25, 135, 84, .10);

}


.medical-unmark-composer__card:active {

    transform: scale(.95);

}


.medical-unmark-composer__card:focus-visible {

    outline: 2px solid #198754;

    outline-offset: 2px;

}



/* =========================================================
   ICON
========================================================= */

.medical-unmark-composer__icon {

    width: 48px;
    height: 48px;

    display: flex;

    align-items: center;
    justify-content: center;

    border-radius: 50%;

    background: #198754;

    color: #ffffff;

    font-size: 22px;

    line-height: 1;

    box-shadow:
        0 4px 12px
        rgba(25, 135, 84, .20);

}


.medical-unmark-composer__icon i {

    line-height: 1;

}



/* =========================================================
   LABEL
========================================================= */

.medical-unmark-composer__label {

    display: block;

    color: #26322b;

    font-size: 13px;

    font-weight: 700;

    line-height: 1.2;

}


.medical-unmark-composer__target {

    display: block;

    max-width: 88px;

    overflow: hidden;

    color: #8a928d;

    font-size: 10px;

    line-height: 1.25;

    white-space: nowrap;

    text-overflow: ellipsis;

}



/* =========================================================
   FULL-SCREEN MODAL
========================================================= */

.medical-unmark-modal {

    position: fixed;

    inset: 0;

    width: 100vw;
    height: 100dvh;

    z-index: 99999;

    display: none;

    overflow: hidden;

    background: #ffffff;

}


.medical-unmark-modal.active {

    display: block;

}



/* =========================================================
   MODAL CONTENT
========================================================= */

.medical-unmark-modal__content {

    width: 100%;
    height: 100%;

    display: flex;

    flex-direction: column;

    background: #ffffff;

}



/* =========================================================
   MODAL HEADER
========================================================= */

.medical-unmark-modal__header {

    flex: 0 0 64px;

    width: 100%;
    height: 64px;

    display: flex;

    align-items: center;

    padding: 0 15px;

    border-bottom: 1px solid #e7ede9;

    background: #ffffff;

}


.medical-unmark-modal__back {

    width: 44px;
    height: 44px;

    flex: 0 0 44px;

    display: flex;

    align-items: center;
    justify-content: center;

    padding: 0;

    border: none;

    border-radius: 50%;

    background: transparent;

    color: #198754;

    font-size: 25px;

    line-height: 1;

    cursor: pointer;

}


.medical-unmark-modal__back:active {

    background: #edf7f1;

}


.medical-unmark-modal__back:focus-visible {

    outline: 2px solid #198754;

    outline-offset: 2px;

}



/* =========================================================
   MODAL TITLE
========================================================= */

.medical-unmark-modal__title {

    min-width: 0;

    margin-left: 8px;

    display: flex;

    flex-direction: column;

    line-height: 1.25;

}


.medical-unmark-modal__title strong {

    color: #202520;

    font-size: 17px;

}


.medical-unmark-modal__title span {

    max-width: 72vw;

    margin-top: 2px;

    overflow: hidden;

    color: #7b847e;

    font-size: 12px;

    white-space: nowrap;

    text-overflow: ellipsis;

}


.medical-unmark-modal__spacer {

    flex: 1;

}



/* =========================================================
   MODAL BODY
========================================================= */

.medical-unmark-modal__body {

    flex: 1 1 auto;

    min-height: 0;

    overflow-y: auto;

    padding: 20px;

}


.medical-unmark-modal__fields {

    width: 100%;

    max-width: 700px;

    margin: 0 auto;

}



/* =========================================================
   QUESTION
========================================================= */

.medical-unmark-question {

    margin-bottom: 20px;

    color: #202520;

    font-size: 20px;

    line-height: 1.45;

}


.medical-unmark-question strong {

    color: #198754;

}



/* =========================================================
   TARGET
========================================================= */

.medical-unmark-target {

    width: 100%;

    display: flex;

    align-items: center;

    gap: 12px;

    margin-bottom: 20px;

    padding: 12px 13px;

    border: 1px solid #dcebe2;

    border-radius: 13px;

    background: #f6faf7;

}


.medical-unmark-target__image,
.medical-unmark-target__placeholder {

    width: 52px;
    height: 52px;

    flex: 0 0 52px;

    overflow: hidden;

    border-radius: 50%;

}


.medical-unmark-target__image {

    display: block;

    object-fit: cover;

}


.medical-unmark-target__placeholder {

    display: flex;

    align-items: center;
    justify-content: center;

    background: #198754;

    color: #ffffff;

    font-size: 20px;

}


.medical-unmark-target__info {

    min-width: 0;

    display: flex;

    flex-direction: column;

}


.medical-unmark-target__info span {

    color: #78827c;

    font-size: 10px;

}


.medical-unmark-target__info strong {

    margin-top: 3px;

    overflow: hidden;

    color: #235d3e;

    font-size: 14px;

    white-space: nowrap;

    text-overflow: ellipsis;

}



/* =========================================================
   MEDICAL STATUS NOTICE
========================================================= */

.medical-unmark-status {

    display: flex;

    align-items: flex-start;

    gap: 11px;

    margin-bottom: 24px;

    padding: 13px;

    border: 1px solid #fde2e2;

    border-radius: 13px;

    background: #fff7f7;

}


.medical-unmark-status__icon {

    width: 30px;
    height: 30px;

    flex: 0 0 30px;

    display: flex;

    align-items: center;
    justify-content: center;

    border-radius: 50%;

    background: #fee2e2;

    color: #991b1b;

    font-size: 15px;

}


.medical-unmark-status > div {

    min-width: 0;

    display: flex;

    flex-direction: column;

}


.medical-unmark-status strong {

    color: #991b1b;

    font-size: 13px;

}


.medical-unmark-status span {

    margin-top: 3px;

    color: #7f1d1d;

    font-size: 12px;

    line-height: 1.4;

}



/* =========================================================
   FORM
========================================================= */

.medical-unmark-form {

    width: 100%;

    margin: 0;

}


.medical-unmark-field {

    position: relative;

    width: 100%;

    margin-bottom: 20px;

}


.medical-unmark-field label {

    display: block;

    margin-bottom: 7px;

    color: #6d7771;

    font-size: 11px;

    font-weight: 700;

    letter-spacing: .04em;

    text-transform: uppercase;

}



/* =========================================================
   MONEY INPUT
========================================================= */

.medical-unmark-money-input {

    width: 100%;
    height: 48px;

    display: flex;

    align-items: center;

    overflow: hidden;

    border: 1px solid #d6e0d9;

    border-radius: 12px;

    background: #f8faf8;

    transition:
        border-color .2s ease,
        background .2s ease,
        box-shadow .2s ease;

}


.medical-unmark-money-input:focus-within {

    border-color: #198754;

    background: #ffffff;

    box-shadow:
        0 0 0 3px
        rgba(25, 135, 84, .10);

}


.medical-unmark-money-input span {

    height: 100%;

    display: flex;

    align-items: center;

    padding: 0 13px;

    border-right: 1px solid #d6e0d9;

    background: #eef5f0;

    color: #198754;

    font-size: 12px;

    font-weight: 800;

}


.medical-unmark-money-input input {

    flex: 1;

    width: 100%;
    min-width: 0;

    height: 100%;

    padding: 0 12px;

    border: none;

    outline: none;

    background: transparent;

    color: #202520;

    font-family: inherit;

    font-size: 15px;

}



/* =========================================================
   DESCRIPTION
========================================================= */

.medical-unmark-field textarea {

    width: 100%;

    min-height: 130px;

    max-height: 300px;

    padding: 13px 14px 30px;

    resize: vertical;

    border: 1px solid #d6e0d9;

    border-radius: 12px;

    outline: none;

    background: #f8faf8;

    color: #202520;

    font-family: inherit;

    font-size: 15px;

    line-height: 1.5;

    transition:
        border-color .2s ease,
        background .2s ease,
        box-shadow .2s ease;

}


.medical-unmark-field textarea:focus {

    border-color: #198754;

    background: #ffffff;

    box-shadow:
        0 0 0 3px
        rgba(25, 135, 84, .10);

}



/* =========================================================
   CHARACTER COUNTER
========================================================= */

.medical-unmark-character-counter {

    position: absolute;

    right: 11px;

    bottom: 9px;

    padding-left: 3px;

    background: #f8faf8;

    color: #8a928d;

    font-size: 10px;

    pointer-events: none;

}


.medical-unmark-field textarea:focus
~ .medical-unmark-character-counter {

    background: #ffffff;

}



/* =========================================================
   SUBMIT
========================================================= */

.medical-unmark-submit-button {

    width: 100%;

    min-height: 50px;

    display: flex;

    align-items: center;
    justify-content: center;

    gap: 8px;

    padding: 10px 14px;

    border: none;

    border-radius: 13px;

    background: #198754;

    color: #ffffff;

    font-family: inherit;

    font-size: 14px;

    font-weight: 700;

    cursor: pointer;

    transition:
        background .2s ease,
        transform .15s ease,
        opacity .15s ease;

}


.medical-unmark-submit-button:not(:disabled):hover {

    background: #146c43;

}


.medical-unmark-submit-button:not(:disabled):active {

    transform: scale(.99);

}


.medical-unmark-submit-button:disabled {

    background: #b8c2bc;

    cursor: default;

}


.medical-unmark-submit-button i {

    font-size: 16px;

}



/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 600px) {

    .medical-unmark-composer {

        width: 108px;

        flex-basis: 108px;

    }


    .medical-unmark-composer__card {

        width: 108px;

        height: 150px;

    }


    .medical-unmark-composer__icon {

        width: 46px;
        height: 46px;

        font-size: 21px;

    }


    .medical-unmark-modal__header {

        flex-basis: 60px;

        height: 60px;

        padding: 0 10px;

    }


    .medical-unmark-modal__body {

        padding: 14px;

    }


    .medical-unmark-question {

        font-size: 19px;

    }


    .medical-unmark-target {

        margin-bottom: 20px;

    }

}



/* =========================================================
   SMALL PHONES
========================================================= */

@media (max-width: 380px) {

    .medical-unmark-modal__title span {

        display: none;

    }


    .medical-unmark-modal__body {

        padding: 10px;

    }

}

</style>



<!-- =========================================================
     JAVASCRIPT
========================================================= -->

<script>

(function () {

    "use strict";


    function initializeMedicalUnmarkComposer() {


        /* =====================================================
           ELEMENTS
        ====================================================== */

        const card =
            document.querySelector(
                "[data-medical-unmark-card]"
            );


        const modal =
            document.querySelector(
                "[data-medical-unmark-modal]"
            );


        const openButton =
            document.querySelector(
                "[data-open-medical-unmark]"
            );


        const closeButton =
            document.querySelector(
                "[data-close-medical-unmark]"
            );


        const chargesInput =
            document.querySelector(
                "#medicalUnmarkCharges"
            );


        const descriptionInput =
            document.querySelector(
                "#medicalUnmarkDescription"
            );


        const characterCounter =
            document.querySelector(
                "[data-medical-unmark-counter]"
            );


        const submitButton =
            document.querySelector(
                "[data-medical-unmark-submit]"
            );


        const form =
            document.querySelector(
                ".medical-unmark-form"
            );



        /* =====================================================
           SAFETY CHECK
        ====================================================== */

        if (
            !card ||
            !modal ||
            !openButton ||
            !closeButton ||
            !chargesInput ||
            !descriptionInput ||
            !characterCounter ||
            !submitButton ||
            !form
        ) {

            console.error(
                "MEDICAL-UNMARK-COMPOSER.EJS: Required elements are missing."
            );

            return;

        }



        /* =====================================================
           OPEN MODAL
        ====================================================== */

        function openModal() {

            modal.classList.add("active");

            modal.setAttribute(
                "aria-hidden",
                "false"
            );

            document.body.style.overflow =
                "hidden";


            window.setTimeout(
                function () {

                    chargesInput.focus();

                },
                100
            );

        }



        /* =====================================================
           CLOSE MODAL
        ====================================================== */

        function closeModal() {

            modal.classList.remove("active");

            modal.setAttribute(
                "aria-hidden",
                "true"
            );

            document.body.style.overflow =
                "";

        }



        /* =====================================================
           VALIDATE FORM
        ====================================================== */

        function updateSubmitButton() {

            const charges =
                chargesInput.value.trim();


            const description =
                descriptionInput.value.trim();


            const numericCharges =
                Number(charges);


            const validCharges =
                charges !== "" &&
                Number.isFinite(
                    numericCharges
                ) &&
                numericCharges >= 0;


            const validDescription =
                description.length > 0;


            submitButton.disabled =
                !(
                    validCharges &&
                    validDescription
                );

        }



        /* =====================================================
           CHARACTER COUNTER
        ====================================================== */

        function updateCharacterCounter() {

            characterCounter.textContent =
                descriptionInput.value.length +
                "/1000";

        }



        /* =====================================================
           OPEN CARD
        ====================================================== */

        openButton.addEventListener(
            "click",
            openModal
        );



        /* =====================================================
           CLOSE BUTTON
        ====================================================== */

        closeButton.addEventListener(
            "click",
            closeModal
        );



        /* =====================================================
           ESCAPE
        ====================================================== */

        document.addEventListener(
            "keydown",
            function (event) {

                if (
                    event.key === "Escape" &&
                    modal.classList.contains("active")
                ) {

                    closeModal();

                }

            }
        );



        /* =====================================================
           CHARGES
        ====================================================== */

        chargesInput.addEventListener(
            "input",
            updateSubmitButton
        );



        /* =====================================================
           DESCRIPTION
        ====================================================== */

        descriptionInput.addEventListener(
            "input",
            function () {

                updateCharacterCounter();

                updateSubmitButton();

            }
        );



        /* =====================================================
           FORM SUBMIT
        ====================================================== */

        form.addEventListener(
            "submit",
            function () {

                submitButton.disabled =
                    true;


                submitButton.innerHTML =
                    '<i class="bi bi-hourglass-split"></i>' +
                    '<span>Clearing...</span>';

            }
        );



        /* =====================================================
           INITIAL STATE
        ====================================================== */

        updateCharacterCounter();

        updateSubmitButton();

    }



    /* =========================================================
       DOM READY
    ========================================================= */

    if (
        document.readyState === "loading"
    ) {

        document.addEventListener(
            "DOMContentLoaded",
            initializeMedicalUnmarkComposer
        );

    } else {

        initializeMedicalUnmarkComposer();

    }

})();

</script>


<% } %>