<style>

  *{
    box-sizing:border-box;
  }

  body{
    margin:0;
    padding:0;
    background:#f4f7f5;
    font-family:Arial, Helvetica, sans-serif;
  }

  .reset-page{
    min-height:100vh;
    display:flex;
    align-items:center;
    justify-content:center;
    padding:20px;
  }

  .reset-card{
    width:100%;
    max-width:430px;
    background:#fff;
    border-radius:18px;
    overflow:hidden;
    box-shadow:0 15px 40px rgba(0,0,0,.08);
  }

  .reset-header{
    background:linear-gradient(135deg,#16a34a,#15803d);
    color:#fff;
    text-align:center;
    padding:35px 25px;
  }

  .reset-icon{
    font-size:60px;
    margin-bottom:10px;
  }

  .reset-header h2{
    margin:0;
    font-size:28px;
    font-weight:700;
  }

  .reset-header p{
    margin:10px 0 0;
    font-size:14px;
    opacity:.95;
    line-height:1.5;
  }

  .reset-body{
    padding:30px;
  }

  .error{
    margin-bottom:20px;
    padding:14px;
    background:#fee2e2;
    color:#b91c1c;
    border-radius:10px;
    border:1px solid #fecaca;
    font-size:14px;
  }

  .form-group{
    margin-bottom:20px;
  }

  .form-group label{
    display:block;
    margin-bottom:8px;
    font-size:14px;
    font-weight:600;
    color:#374151;
  }

  .form-control{
    width:100%;
    padding:14px;
    border:1px solid #d1d5db;
    border-radius:10px;
    font-size:15px;
    transition:.25s;
    outline:none;
  }

  .form-control:focus{
    border-color:#16a34a;
    box-shadow:0 0 0 4px rgba(22,163,74,.12);
  }

  .reset-btn{
    width:100%;
    padding:15px;
    border:none;
    border-radius:10px;
    background:linear-gradient(135deg,#16a34a,#15803d);
    color:#fff;
    font-size:16px;
    font-weight:700;
    cursor:pointer;
    transition:.25s;
  }

  .reset-btn:hover{
    transform:translateY(-2px);
    box-shadow:0 10px 20px rgba(22,163,74,.25);
  }

  .footer-text{
    margin-top:20px;
    text-align:center;
    color:#6b7280;
    font-size:13px;
    line-height:1.6;
  }

  @media(max-width:500px){

    .reset-header{
      padding:30px 20px;
    }

    .reset-header h2{
      font-size:24px;
    }

    .reset-body{
      padding:22px;
    }

  }

</style>

<div class="reset-page">

  <div class="reset-card">

    <div class="reset-header">

      <div class="reset-icon">
        🔒
      </div>

      <h2>Reset Password</h2>

      <p>
        Create a new secure password for your account.
      </p>

    </div>

    <div class="reset-body">

      <% if(error){ %>

        <div class="error">
          <%= error %>
        </div>

      <% } %>

      <form method="POST" action="/reset-password/<%= token %>">

        <div class="form-group">

          <label>New Password</label>

          <input
            type="password"
            name="password"
            class="form-control"
            placeholder="Enter your new password"
            required
          >

        </div>

        <button
          type="submit"
          class="reset-btn"
        >
          🔐 Reset Password
        </button>

      </form>

      <div class="footer-text">
        Choose a strong password that you haven't used before.
      </div>

    </div>

  </div>

</div>