<style>

/* =========================================================
   PAGE
========================================================= */

.profile-page{
    max-width:760px;
    margin:0 auto;
    padding:20px 0 45px;
}


/* =========================================================
   PROFILE CARD
========================================================= */

.profile-card{
    background:#fff;
    border-radius:22px;
    padding:32px;
    box-shadow:
        0 12px 32px rgba(0,0,0,.08);
    border:1px solid #edf0f2;
}


/* =========================================================
   PROFILE HEADER
========================================================= */

.profile-header{
    text-align:center;
    padding-bottom:25px;
    border-bottom:1px solid #edf0f2;
}


/* =========================================================
   PROFILE IMAGE
========================================================= */

.profile-img{
    width:120px;
    height:120px;
    object-fit:cover;
    border-radius:50%;
    border:4px solid #0b5d1e;
    margin:0 auto 18px;
    display:block;
}

.profile-avatar{
    width:120px;
    height:120px;
    border-radius:50%;
    border:4px solid #0b5d1e;
    background:#0b5d1e;
    color:#fff;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:48px;
    font-weight:700;
    text-transform:uppercase;
    margin:0 auto 18px;
}


/* =========================================================
   PROFILE DETAILS
========================================================= */

.profile-name{
    margin:0;
    font-size:28px;
    color:#222;
    font-weight:700;
}

.profile-email{
    margin:10px 0 5px;
    color:#666;
    font-size:15px;
}

.profile-phone{
    color:#777;
    font-size:15px;
}


/* =========================================================
   INFO GRID
========================================================= */

.info-grid{
    display:grid;
    grid-template-columns:
        repeat(
            auto-fit,
            minmax(210px,1fr)
        );

    gap:14px;

    margin:25px 0;
}

.info-box{
    background:#f8faf9;
    border:1px solid #e7ece9;
    border-radius:14px;
    padding:17px;
}

.info-title{
    font-size:12px;
    color:#888;
    text-transform:uppercase;
    letter-spacing:.6px;
    margin-bottom:8px;
}

.info-box strong{
    color:#222;
    font-size:14px;
    word-break:break-word;
}

.role-badge{
    display:inline-flex;
    align-items:center;
    padding:7px 13px;
    background:#e9f7ef;
    color:#0b5d1e;
    border-radius:30px;
    font-weight:700;
    text-transform:capitalize;
}


/* =========================================================
   FORM SECTION
========================================================= */

.form-section{
    margin-top:25px;
    text-align:left;
    border-top:1px solid #edf0f2;
    padding-top:25px;
}

.form-title{
    color:#0b5d1e;
    font-size:21px;
    margin:0 0 15px;
}


/* =========================================================
   COLLAPSIBLE ASSIGNMENT BOX
========================================================= */

.assignment-box{
    border:1px solid #e2e9e4;
    border-radius:15px;
    overflow:hidden;
    background:#fff;
}

.assignment-toggle{
    width:100%;
    border:0;
    background:#f5faf6;
    color:#0b5d1e;
    padding:15px 17px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:12px;
    cursor:pointer;
    font:inherit;
    text-align:left;
    transition:
        background .2s ease;
}

.assignment-toggle:hover{
    background:#eaf7ee;
}

.assignment-toggle-content{
    display:flex;
    align-items:center;
    gap:11px;
    min-width:0;
}

.assignment-toggle-icon{
    width:34px;
    height:34px;
    border-radius:9px;
    background:#0b5d1e;
    color:#fff;
    display:flex;
    align-items:center;
    justify-content:center;
    flex-shrink:0;
    font-size:18px;
}

.assignment-toggle-text{
    display:flex;
    flex-direction:column;
    gap:2px;
}

.assignment-toggle-title{
    font-size:15px;
    font-weight:700;
}

.assignment-toggle-subtitle{
    font-size:12px;
    color:#718078;
}

.assignment-arrow{
    font-size:15px;
    transition:
        transform .2s ease;
}

.assignment-toggle.open
.assignment-arrow{
    transform:rotate(90deg);
}

.assignment-content{
    display:none;
    padding:17px;
    border-top:1px solid #e5ebe7;
}

.assignment-content.open{
    display:block;
}


/* =========================================================
   ASSIGNMENT LIST
========================================================= */

.assigned-list{
    display:flex;
    flex-direction:column;
    gap:10px;
    margin-bottom:18px;
}

.assigned-item{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:12px;

    background:#f8faf9;

    border:1px solid #e4ebe6;

    border-radius:12px;

    padding:13px 14px;
}

.assigned-info{
    display:flex;
    flex-direction:column;
    gap:4px;
    min-width:0;
}

.assigned-info strong{
    color:#222;
    font-size:14px;
}

.assigned-meta{
    color:#77827c;
    font-size:12px;
}


/* =========================================================
   SELECT
========================================================= */

.form-section label{
    display:block;
    margin-bottom:8px;
    font-weight:600;
    color:#444;
}

.form-section select{
    width:100%;
    padding:14px;
    border:1px solid #d8d8d8;
    border-radius:12px;
    font-size:15px;
    background:#fff;
    transition:.2s;
    box-sizing:border-box;
}

.form-section select:focus{
    outline:none;
    border-color:#0b5d1e;
    box-shadow:
        0 0 0 3px
        rgba(11,93,30,.1);
}


/* =========================================================
   SELECT HINT
========================================================= */

.select-hint{
    margin-top:7px;
    color:#7a847e;
    font-size:12px;
}


/* =========================================================
   BUTTONS
========================================================= */

.btn-save{
    width:100%;
    margin-top:16px;
    padding:14px;
    border:none;
    border-radius:12px;
    background:#0b5d1e;
    color:#fff;
    font-size:15px;
    font-weight:700;
    cursor:pointer;
    transition:
        background .2s ease,
        transform .15s ease;
}

.btn-save:hover{
    background:#084814;
}

.btn-save:active{
    transform:scale(.98);
}

.btn-remove{
    border:none;
    border-radius:8px;
    padding:8px 11px;
    background:#ffe5e5;
    color:#c62828;
    font-weight:700;
    cursor:pointer;
    white-space:nowrap;
}

.btn-remove:hover{
    background:#ffd2d2;
}

.btn-delete{
    width:100%;
    margin-top:15px;
    padding:15px;
    border:none;
    border-radius:12px;
    background:#c62828;
    color:#fff;
    font-size:15px;
    font-weight:700;
    cursor:pointer;
}


/* =========================================================
   NOTICE
========================================================= */

.notice{
    padding:14px;
    border-radius:12px;
    background:#fff8e5;
    color:#9a6700;
    border:1px solid #f0d58c;
    font-size:14px;
    line-height:1.5;
}


/* =========================================================
   EMPTY
========================================================= */

.empty-assignment{
    text-align:center;
    padding:16px;
    margin-bottom:17px;
    border-radius:12px;
    background:#f8faf9;
    border:1px dashed #d8e1db;
    color:#78837d;
    font-size:13px;
}


/* =========================================================
   DANGER SECTION
========================================================= */

.danger-section{
    border-top:1px solid #f0dddd;
}

.danger-section .form-title{
    color:#c62828;
}


/* =========================================================
   MOBILE
========================================================= */

@media(max-width:600px){

    .profile-page{
        padding:10px 0 35px;
    }

    .profile-card{
        padding:20px;
        border-radius:18px;
    }

    .profile-img,
    .profile-avatar{
        width:100px;
        height:100px;
    }

    .profile-avatar{
        font-size:40px;
    }

    .profile-name{
        font-size:24px;
    }

    .info-grid{
        grid-template-columns:1fr;
    }

    .assigned-item{
        align-items:flex-start;
    }

    .assigned-item .btn-remove{
        flex-shrink:0;
    }

}

@media(max-width:430px){

    .assigned-item{
        flex-direction:column;
    }

    .assigned-item .btn-remove{
        width:100%;
    }

}

</style>


<div class="profile-page">

    <div class="profile-card">


        <!-- =================================================
             PROFILE HEADER
        ================================================== -->

        <div class="profile-header">


            <% if(user.profileImage){ %>

                <img
                    src="<%= user.profileImage %>"
                    class="profile-img"
                    alt="<%= user.name %>"
                >

            <% } else { %>

                <div class="profile-avatar">

                    <%= (user.name || "U")
                        .charAt(0)
                        .toUpperCase() %>

                </div>

            <% } %>


            <h2 class="profile-name">
                <%= user.name %>
            </h2>


            <div class="profile-email">
                📧 <%= user.email %>
            </div>


            <div class="profile-phone">
                📱
                <%= user.phone ||
                    "No phone number available" %>
            </div>


        </div>


        <!-- =================================================
             INFORMATION
        ================================================== -->

        <div class="info-grid">


            <div class="info-box">

                <div class="info-title">
                    Current Role
                </div>

                <span class="role-badge">
                    <%= user.role %>
                </span>

            </div>


            <div class="info-box">

                <div class="info-title">
                    User ID
                </div>

                <strong>
                    <%= user._id %>
                </strong>

            </div>


            <div class="info-box">

                <div class="info-title">
                    Last Login
                </div>

                <strong>

                    <%= user.lastLogin
                        ? new Date(
                            user.lastLogin
                          ).toLocaleString()
                        : "Never logged in" %>

                </strong>

            </div>


        </div>


        <!-- =================================================
             DAIRY FARM ASSIGNMENT
        ================================================== -->

        <% if(user.role === "dairyWorker"){ %>

            <div class="form-section">

                <h3 class="form-title">
                    Dairy Farm Assignment
                </h3>


                <div class="assignment-box">


                    <button
                        type="button"
                        class="assignment-toggle"
                        data-target="farmAssignmentContent"
                        aria-expanded="false"
                    >

                        <span class="assignment-toggle-content">

                            <span
                                class="assignment-toggle-icon"
                                aria-hidden="true"
                            >
                                🐄
                            </span>

                            <span class="assignment-toggle-text">

                                <span class="assignment-toggle-title">
                                    Assigned Dairy Farms
                                </span>

                                <span class="assignment-toggle-subtitle">

                                    <%= Array.isArray(user.assignedFarm)
                                        ? user.assignedFarm.length
                                        : 0 %>

                                    currently assigned

                                </span>

                            </span>

                        </span>

                        <span
                            class="assignment-arrow"
                            aria-hidden="true"
                        >
                            ▶
                        </span>

                    </button>


                    <div
                        id="farmAssignmentContent"
                        class="assignment-content"
                    >


                        <!-- =================================
                             CURRENT FARMS
                        ================================== -->

                        <% if(
                            Array.isArray(user.assignedFarm) &&
                            user.assignedFarm.length > 0
                        ){ %>


                            <div class="assigned-list">


                                <% user.assignedFarm.forEach(
                                    function(farm)
                                { %>


                                    <div class="assigned-item">


                                        <div class="assigned-info">

                                            <strong>
                                                <%= farm.name ||
                                                    "Dairy Farm" %>
                                            </strong>

                                            <span class="assigned-meta">

                                                Code:
                                                <%= farm.code !== undefined &&
                                                    farm.code !== null
                                                    ? farm.code
                                                    : "Unknown" %>

                                            </span>

                                        </div>


                                        <form
                                            method="POST"
                                            action="/accounts/<%= user._id %>/farms/<%= farm._id %>/unassign"
                                            onsubmit="return confirm('Unassign this Dairy Farm from this worker?');"
                                        >

                                            <button
                                                type="submit"
                                                class="btn-remove"
                                            >
                                                Unassign
                                            </button>

                                        </form>


                                    </div>


                                <% }); %>


                            </div>


                        <% } else { %>


                            <div class="empty-assignment">
                                No Dairy Farms are currently assigned.
                            </div>


                        <% } %>


                        <!-- =================================
                             ASSIGN FARM
                        ================================== -->

                        <form
                            method="POST"
                            action="/accounts/<%= user._id %>/farms"
                        >

                            <label for="assignedFarms">

                                Assign Dairy Farms

                            </label>


                            <select
                                id="assignedFarms"
                                name="assignedFarms"
                                multiple
                                size="5"
                            >

                                <% if(
                                    Array.isArray(dairies)
                                ){ %>


                                    <% dairies.forEach(
                                        function(dairy)
                                    {

                                        const alreadyAssigned =
                                            Array.isArray(
                                                user.assignedFarm
                                            ) &&
                                            user.assignedFarm.some(
                                                function(farm){

                                                    return String(
                                                        farm._id
                                                    ) ===
                                                    String(
                                                        dairy._id
                                                    );

                                                }
                                            );

                                    %>


                                        <% if(
                                            !alreadyAssigned
                                        ){ %>

                                            <option
                                                value="<%= dairy._id %>"
                                            >
                                                <%= dairy.name %>
                                                —
                                                <%= dairy.code %>
                                            </option>

                                        <% } %>


                                    <% }); %>


                                <% } %>

                            </select>


                            <div class="select-hint">
                                Hold Ctrl or Command to select multiple farms.
                            </div>


                            <button
                                type="submit"
                                class="btn-save"
                            >
                                Assign Selected Farms
                            </button>

                        </form>


                    </div>

                </div>

            </div>

        <% } %>


        <!-- =================================================
             STANDALONE ASSET ASSIGNMENT
        ================================================== -->

        <% if(
            user.role !== "admin"
        ){ %>


            <div class="form-section">

                <h3 class="form-title">
                    Standalone Asset Assignment
                </h3>


                <div class="assignment-box">


                    <button
                        type="button"
                        class="assignment-toggle"
                        data-target="assetAssignmentContent"
                        aria-expanded="false"
                    >

                        <span class="assignment-toggle-content">

                            <span
                                class="assignment-toggle-icon"
                                aria-hidden="true"
                            >
                                📦
                            </span>

                            <span class="assignment-toggle-text">

                                <span class="assignment-toggle-title">
                                    Assigned Assets
                                </span>

                                <span class="assignment-toggle-subtitle">

                                    <%= Array.isArray(user.assignedAsset)
                                        ? user.assignedAsset.length
                                        : 0 %>

                                    currently assigned

                                </span>

                            </span>

                        </span>


                        <span
                            class="assignment-arrow"
                            aria-hidden="true"
                        >
                            ▶
                        </span>

                    </button>


                    <div
                        id="assetAssignmentContent"
                        class="assignment-content"
                    >


                        <!-- =================================
                             CURRENT ASSETS
                        ================================== -->

                        <% if(
                            Array.isArray(user.assignedAsset) &&
                            user.assignedAsset.length > 0
                        ){ %>


                            <div class="assigned-list">


                                <% user.assignedAsset.forEach(
                                    function(asset)
                                { %>


                                    <div class="assigned-item">


                                        <div class="assigned-info">

                                            <strong>
                                                <%= asset.name ||
                                                    "Standalone Asset" %>
                                            </strong>


                                            <span class="assigned-meta">

                                                <%= asset.type ||
                                                    "Asset" %>

                                                <% if(
                                                    asset.condition
                                                ){ %>

                                                    ·
                                                    <%= asset.condition %>

                                                <% } %>

                                            </span>

                                        </div>


                                        <form
                                            method="POST"
                                            action="/accounts/<%= user._id %>/assets/<%= asset._id %>/unassign"
                                            onsubmit="return confirm('Remove this asset from the user?');"
                                        >

                                            <button
                                                type="submit"
                                                class="btn-remove"
                                            >
                                                Unassign
                                            </button>

                                        </form>


                                    </div>


                                <% }); %>


                            </div>


                        <% } else { %>


                            <div class="empty-assignment">
                                No standalone assets are currently assigned.
                            </div>


                        <% } %>


                        <!-- =================================
                             AVAILABLE ASSETS
                        ================================== -->

                        <form
                            method="POST"
                            action="/accounts/<%= user._id %>/assets"
                        >


                            <label for="assignedAssets">

                                Assign Standalone Assets

                            </label>


                            <select
                                id="assignedAssets"
                                name="assignedAssets"
                                multiple
                                size="5"
                            >


                                <% if(
                                    Array.isArray(assets)
                                ){ %>


                                    <% assets.forEach(
                                        function(asset)
                                    {

                                        const alreadyAssigned =
                                            Array.isArray(
                                                user.assignedAsset
                                            ) &&
                                            user.assignedAsset.some(
                                                function(
                                                    assignedAsset
                                                ){

                                                    return String(
                                                        assignedAsset._id
                                                    ) ===
                                                    String(
                                                        asset._id
                                                    );

                                                }
                                            );

                                    %>


                                        <% if(
                                            !alreadyAssigned
                                        ){ %>


                                            <option
                                                value="<%= asset._id %>"
                                            >

                                                <%= asset.name ||
                                                    "Unnamed Asset" %>

                                                <% if(
                                                    asset.type
                                                ){ %>

                                                    —
                                                    <%= asset.type %>

                                                <% } %>

                                            </option>


                                        <% } %>


                                    <% }); %>


                                <% } %>


                            </select>


                            <% if(
                                !Array.isArray(assets) ||
                                assets.length === 0
                            ){ %>


                                <div class="select-hint">

                                    No standalone/code-less Dairy assets
                                    are currently available.

                                </div>


                            <% } else { %>


                                <div class="select-hint">

                                    Select one or more standalone assets
                                    to assign to this user.

                                </div>


                            <% } %>


                            <button
                                type="submit"
                                class="btn-save"
                                <%= !Array.isArray(assets) ||
                                    assets.length === 0
                                    ? "disabled"
                                    : "" %>
                            >

                                Assign Selected Assets

                            </button>


                        </form>


                    </div>

                </div>

            </div>


        <% } %>


        <!-- =================================================
             CHANGE ROLE
        ================================================== -->

        <div class="form-section">

            <h3 class="form-title">
                Change User Role
            </h3>


            <% if(
                currentUser._id.toString() ===
                user._id.toString()
            ){ %>


                <div class="notice">
                    You cannot change your own role.
                </div>


            <% } else { %>


                <form
                    method="POST"
                    action="/accounts/<%= user._id %>/role"
                >


                    <label for="role">
                        Select New Role
                    </label>


                    <select
                        id="role"
                        name="role"
                        required
                    >

                        <option
                            value="dairyWorker"
                            <%= user.role === "dairyWorker"
                                ? "selected"
                                : "" %>
                        >
                            🐄 Dairy Worker
                        </option>


                        <option
                            value="poultryWorker"
                            <%= user.role === "poultryWorker"
                                ? "selected"
                                : "" %>
                        >
                            🐔 Poultry Worker
                        </option>


                        <option
                            value="admin"
                            <%= user.role === "admin"
                                ? "selected"
                                : "" %>
                        >
                            👑 Administrator
                        </option>

                    </select>


                    <button
                        type="submit"
                        class="btn-save"
                    >
                        Save Role Changes
                    </button>


                </form>


            <% } %>

        </div>


        <!-- =================================================
             DELETE ACCOUNT
        ================================================== -->

        <div class="form-section danger-section">

            <h3 class="form-title">
                Delete Account
            </h3>


            <% if(
                currentUser._id.toString() ===
                user._id.toString()
            ){ %>


                <div class="notice">

                    You cannot permanently delete
                    your own account.

                </div>


            <% } else { %>


                <form
                    method="POST"
                    action="/accounts/<%= user._id %>/delete"
                    onsubmit="return confirm('This account will be permanently deleted. This action cannot be undone. Continue?');"
                >

                    <button
                        type="submit"
                        class="btn-delete"
                    >

                        🚫 Permanently Delete Account

                    </button>

                </form>


            <% } %>


        </div>


    </div>

</div>


<script>

/* =========================================================
   ASSIGNMENT DROPDOWNS
========================================================= */

document
    .querySelectorAll(
        ".assignment-toggle"
    )
    .forEach(
        function(button){

            button.addEventListener(
                "click",
                function(){

                    const targetId =
                        button.getAttribute(
                            "data-target"
                        );

                    const target =
                        document.getElementById(
                            targetId
                        );


                    if(!target){

                        return;

                    }


                    const isOpen =
                        target.classList.contains(
                            "open"
                        );


                    target.classList.toggle(
                        "open",
                        !isOpen
                    );


                    button.classList.toggle(
                        "open",
                        !isOpen
                    );


                    button.setAttribute(
                        "aria-expanded",
                        String(!isOpen)
                    );

                }
            );

        }
    );

</script>