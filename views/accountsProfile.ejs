<!-- =====================.====================================
     ASSIGNED DAIRY FARMS
========================================================== -->

<% if (user.role === "dairyWorker") { %>

<div class="form-section">

  <h3 class="form-title">
    Assigned Dairy Farms
  </h3>


  <!-- =======================================================
       CURRENTLY ASSIGNED FARMS
  ======================================================== -->

  <% if (user.assignedFarm && user.assignedFarm.length > 0) { %>

    <div class="assigned-farms-list">

      <% user.assignedFarm.forEach(farm => { %>

        <div class="assigned-farm-item">

          <div class="farm-info">

            <strong>
              <%= farm.name || "Dairy Farm" %>
            </strong>

            <% if (farm.code !== undefined && farm.code !== null) { %>

              <span>
                Code: <%= farm.code %>
              </span>

            <% } %>

          </div>

        </div>

      <% }) %>

    </div>

  <% } else { %>

    <div class="notice">
      This Dairy Worker currently has no assigned Dairy Farms.
    </div>

  <% } %>


  <!-- =======================================================
       ADD MORE FARMS
  ======================================================== -->

  <form
    method="POST"
    action="/accounts/<%= user._id %>/farms"
  >

    <label for="assignedFarms">
      Assign Additional Dairy Farms
    </label>

    <select
      id="assignedFarms"
      name="assignedFarms"
      multiple
    >

      <% if (typeof dairies !== "undefined" && dairies.length > 0) { %>

        <% dairies
          .filter(dairy =>
            dairy.code !== null &&
            dairy.code !== undefined &&
            Number(dairy.code) < 0
          )
          .forEach(dairy => {

            const alreadyAssigned =
              user.assignedFarm &&
              user.assignedFarm.some(farm => {

                const farmId =
                  farm._id
                    ? farm._id.toString()
                    : farm.toString();

                return farmId === dairy._id.toString();

              });

        %>

          <% if (!alreadyAssigned) { %>

            <option value="<%= dairy._id %>">

              <%= dairy.name %>

              <% if (dairy.code !== null && dairy.code !== undefined) { %>
                — <%= dairy.code %>
              <% } %>

            </option>

          <% } %>

        <% }) %>

      <% } %>

    </select>


    <small class="farm-help">
      Hold Ctrl or Command to select multiple Dairy Farms.
    </small>


    <button
      type="submit"
      class="btn-save"
    >
      Assign Selected Farms
    </button>

  </form>

</div>

<% } %>