<style>

/* ==========================================================
   NET WORTH ASSET DETAILS / EDIT PAGE
========================================================== */

.financial-page.networth-page {

    max-width: 850px;
    margin: 0 auto;
    padding: 25px 18px 55px;
    box-sizing: border-box;

}


/* ==========================================================
   HEADER
========================================================== */

.networth-page .financial-header {

    display: flex;

    align-items: flex-start;

    justify-content: space-between;

    gap: 20px;

    margin-bottom: 25px;

}


.networth-page .financial-header > div:first-child {

    min-width: 0;

}


.networth-page .financial-header h1 {

    margin: 0 0 6px;

    color: #173b2a;

    font-size: 30px;

    font-weight: 800;

    line-height: 1.2;

    letter-spacing: -0.6px;

    overflow-wrap: anywhere;

}


.networth-page .financial-header p {

    margin: 0;

    color: #718078;

    font-size: 15px;

    line-height: 1.5;

}


/* ==========================================================
   HEADER ACTIONS
========================================================== */

.networth-header-actions {

    display: flex;

    align-items: center;

    justify-content: flex-end;

    gap: 9px;

    flex-shrink: 0;

}


/* ==========================================================
   HEADER ACTION
========================================================== */

.networth-header-action {

    display: inline-flex;

    align-items: center;

    justify-content: center;

    gap: 7px;

    min-height: 40px;

    padding: 0 12px;

    box-sizing: border-box;

    border: 1px solid #dce9e1;

    border-radius: 11px;

    background: #ffffff;

    color: #2f7048;

    text-decoration: none;

    font-size: 12px;

    font-weight: 700;

    white-space: nowrap;

    box-shadow:
        0 2px 8px rgba(25, 70, 43, 0.04);

    transition:
        color 0.2s ease,
        background 0.2s ease,
        border-color 0.2s ease,
        box-shadow 0.2s ease,
        transform 0.2s ease;

}


.networth-header-action i {

    font-size: 17px;

    line-height: 1;

}


.networth-header-action:hover {

    border-color: #b8d9c3;

    background: #f3faf5;

    color: #216b3e;

    box-shadow:
        0 5px 13px rgba(31, 111, 70, 0.09);

    transform: translateY(-1px);

}


/* ==========================================================
   MAIN CARD
========================================================== */

.networth-page > .financial-card {

    overflow: hidden;

    padding: 30px;

    box-sizing: border-box;

    background: #ffffff;

    border: 1px solid #e1e9e4;

    border-radius: 18px;

    box-shadow:
        0 8px 25px rgba(25, 70, 43, 0.055),
        0 2px 6px rgba(25, 70, 43, 0.025);

}


/* ==========================================================
   FORM
========================================================== */

.networth-form {
    width: 100%;
}


.networth-form .form-group {
    margin-bottom: 21px;
}


/* ==========================================================
   LABEL
========================================================== */

.networth-form .form-group > label {

    display: block;

    margin-bottom: 8px;

    color: #304139;

    font-size: 13px;

    font-weight: 750;

    line-height: 1.4;

}


/* ==========================================================
   INPUT / SELECT / TEXTAREA
========================================================== */

.networth-form input,
.networth-form select,
.networth-form textarea {

    display: block;

    width: 100%;

    box-sizing: border-box;

    border: 1px solid #d5dfd9;

    border-radius: 11px;

    background: #fbfdfb;

    color: #24352c;

    font-family: inherit;

    font-size: 14px;

    outline: none;

    transition:
        border-color 0.2s ease,
        box-shadow 0.2s ease,
        background 0.2s ease;

}


.networth-form input {

    height: 49px;

    padding: 0 14px;

}


.networth-form input[type="file"] {

    height: auto;

    min-height: 49px;

    padding: 12px 14px;

    cursor: pointer;

}


.networth-form select {

    height: 49px;

    padding: 0 40px 0 14px;

    cursor: pointer;

}


.networth-form textarea {

    min-height: 115px;

    padding: 13px 14px;

    resize: vertical;

    line-height: 1.55;

}


.networth-form input:focus,
.networth-form select:focus,
.networth-form textarea:focus {

    background: #ffffff;

    border-color: #3b945b;

    box-shadow:
        0 0 0 3px rgba(59, 148, 91, 0.11);

}


.networth-form input::placeholder,
.networth-form textarea::placeholder {

    color: #9aa79f;

}


/* ==========================================================
   READ ONLY
========================================================== */

.networth-form input[readonly] {

    background: #f3f6f4;

    border-color: #e0e7e2;

    color: #69766e;

    cursor: not-allowed;

}


/* ==========================================================
   CODE
========================================================== */

.networth-form #code {

    font-weight: 650;

    font-variant-numeric: tabular-nums;

}


/* ==========================================================
   MONEY / MASS
========================================================== */

.networth-form #buyingPrice,
.networth-form #currentWorth,
.networth-form #mass {

    font-weight: 650;

    font-variant-numeric: tabular-nums;

}


/* ==========================================================
   CURRENT WORTH
========================================================== */

.networth-form #currentWorth {

    border-color: #bcd8c5;

    background: #f7fcf8;

}


.networth-form #currentWorth:focus {

    background: #ffffff;

    border-color: #328650;

    box-shadow:
        0 0 0 3px rgba(50, 134, 80, 0.12);

}


/* ==========================================================
   PROFILE IMAGE
========================================================== */

.profile-image-section {

    display: flex;

    flex-direction: column;

    align-items: center;

    margin-bottom: 30px;

    padding-bottom: 25px;

    border-bottom: 1px solid #edf1ee;

}


.profile-image-preview {

    width: 125px;

    height: 125px;

    margin-bottom: 15px;

    border-radius: 50%;

    overflow: hidden;

    background: #f1f5f2;

    border: 4px solid #ffffff;

    box-shadow:
        0 4px 15px rgba(25, 70, 43, 0.12);

    display: flex;

    align-items: center;

    justify-content: center;

}


.profile-image-preview img {

    width: 100%;

    height: 100%;

    object-fit: cover;

    display: block;

}


.profile-image-placeholder {

    color: #8b9991;

    font-size: 42px;

}


.profile-image-title {

    margin-bottom: 5px;

    color: #304139;

    font-size: 14px;

    font-weight: 750;

}


.profile-image-description {

    margin: 0 0 15px;

    color: #7a8880;

    font-size: 12px;

    text-align: center;

}


.profile-image-input {

    width: 100%;

    max-width: 400px;

}


/* ==========================================================
   AGE
========================================================== */

.age-display {

    display: flex;

    align-items: center;

    min-height: 49px;

    padding: 0 14px;

    box-sizing: border-box;

    border: 1px solid #d8e4dc;

    border-radius: 11px;

    background: #f3f7f4;

    color: #405449;

    font-size: 14px;

    font-weight: 650;

}


/* ==========================================================
   BOOLEAN
========================================================== */

.boolean-display {

    display: flex;

    align-items: center;

    gap: 10px;

    min-height: 49px;

    padding: 0 14px;

    box-sizing: border-box;

    border: 1px solid #d5dfd9;

    border-radius: 11px;

    background: #fbfdfb;

}


.boolean-display input[type="checkbox"] {

    width: 18px;

    height: 18px;

    margin: 0;

    accent-color: #2f8f55;

    cursor: pointer;

}


.boolean-display label {

    margin: 0;

    color: #405449;

    font-size: 14px;

    font-weight: 600;

    cursor: pointer;

}


/* ==========================================================
   SECTION
========================================================== */

.form-section {

    margin: 30px 0 24px;

    padding-top: 24px;

    border-top: 1px solid #edf1ee;

}


.form-section-title {

    margin: 0 0 5px;

    color: #294c37;

    font-size: 17px;

    font-weight: 800;

}


.form-section-description {

    margin: 0 0 20px;

    color: #7a8880;

    font-size: 12px;

    line-height: 1.5;

}


/* ==========================================================
   ASSET LOCATION
========================================================== */

.asset-location-group {
    margin-top: 5px;
}


.asset-location-description {

    margin: 0 0 9px;

    color: #7a8880;

    font-size: 12px;

    line-height: 1.5;

}


/* ==========================================================
   STRUCTURE INFORMATION
========================================================== */

.structure-info {

    margin-bottom: 20px;

    padding: 14px 16px;

    background: #f3f8f4;

    border: 1px solid #dce9df;

    border-radius: 11px;

    color: #50665a;

    font-size: 13px;

    line-height: 1.5;

}


.structure-info strong {
    color: #294c37;
}


/* ==========================================================
   SAVE STATUS
========================================================== */

.form-save-status {

    display: none;

    margin-bottom: 18px;

    padding: 12px 14px;

    border-radius: 10px;

    font-size: 13px;

    line-height: 1.4;

}


.form-save-status.success {

    display: block;

    background: #eef8f1;

    border: 1px solid #cfe5d5;

    color: #28633b;

}


.form-save-status.error {

    display: block;

    background: #fff3f2;

    border: 1px solid #efd0cd;

    color: #a13c35;

}


/* ==========================================================
   ACTIONS
========================================================== */

.networth-form .form-actions {

    display: flex;

    align-items: center;

    justify-content: flex-end;

    gap: 11px;

    margin-top: 8px;

    padding-top: 22px;

    border-top: 1px solid #edf1ee;

}


/* ==========================================================
   BUTTON
========================================================== */

.networth-form .button {

    display: inline-flex;

    align-items: center;

    justify-content: center;

    gap: 8px;

    min-height: 46px;

    padding: 0 19px;

    box-sizing: border-box;

    border-radius: 10px;

    font-family: inherit;

    font-size: 14px;

    font-weight: 700;

    text-decoration: none;

    cursor: pointer;

    transition:
        background 0.2s ease,
        border-color 0.2s ease,
        color 0.2s ease,
        box-shadow 0.2s ease,
        transform 0.2s ease;

}


.networth-form .button-secondary {

    background: #ffffff;

    color: #536159;

    border: 1px solid #d6dfd9;

}


.networth-form .button-secondary:hover {

    background: #f7f9f7;

    border-color: #c4d0c8;

    color: #29382f;

    transform: translateY(-1px);

}


.networth-form .button-primary {

    background: #2f8f55;

    color: #ffffff;

    border: 1px solid #2f8f55;

    box-shadow:
        0 5px 12px rgba(47, 143, 85, 0.17);

}


.networth-form .button-primary::before {

    content: "✓";

    font-size: 14px;

}


.networth-form .button-primary:hover {

    background: #267747;

    border-color: #267747;

    box-shadow:
        0 7px 16px rgba(47, 143, 85, 0.22);

    transform: translateY(-1px);

}


.networth-form .button-primary:disabled {

    opacity: 0.65;

    cursor: wait;

    transform: none;

}


/* ==========================================================
   MOBILE
========================================================== */

@media (max-width: 650px) {

    .financial-page.networth-page {

        padding: 18px 14px 45px;

    }


    .networth-page .financial-header {

        gap: 12px;

    }


    .networth-page .financial-header h1 {

        font-size: 25px;

    }


    .networth-page .financial-header p {

        font-size: 14px;

    }


    .networth-header-actions {

        gap: 7px;

    }


    .networth-header-action {

        width: 40px;

        height: 40px;

        min-height: 40px;

        padding: 0;

        border-radius: 10px;

    }


    .networth-header-action span {

        display: none;

    }


    .networth-header-action i {

        font-size: 17px;

    }


    .networth-page > .financial-card {

        padding: 22px 18px;

        border-radius: 15px;

    }


    .networth-form .form-group {

        margin-bottom: 19px;

    }


    .networth-form input,
    .networth-form select {

        height: 48px;

    }


    .networth-form textarea {

        min-height: 110px;

    }


    .networth-form .form-actions {

        flex-direction: column-reverse;

        align-items: stretch;

        gap: 10px;

        padding-top: 19px;

    }


    .networth-form .button {

        width: 100%;

        min-height: 48px;

    }


    .profile-image-preview {

        width: 110px;

        height: 110px;

    }

}


/* ==========================================================
   SMALL PHONES
========================================================== */

@media (max-width: 380px) {

    .financial-page.networth-page {

        padding-left: 10px;

        padding-right: 10px;

    }


    .networth-page > .financial-card {

        padding: 19px 14px;

    }


    .networth-page .financial-header h1 {

        font-size: 23px;

    }


    .networth-header-action {

        width: 37px;

        height: 37px;

        min-height: 37px;

    }

}

</style>


<%

// ==========================================================
// RECORD CLASSIFICATION
//
// MODEL:
//
// code < 0  = Dairy Farm
// code > 0  = Animal
// code null = Structure / Facility / Equipment
// ==========================================================

const hasCode =
    dairy &&
    dairy.code !== null &&
    dairy.code !== undefined;


const numericCode =
    hasCode
        ? Number(dairy.code)
        : null;


const isAnimal =
    hasCode &&
    numericCode > 0;


const isStructure =
    !hasCode;


const isDairyFarm =
    hasCode &&
    numericCode < 0;


// ==========================================================
// GENDER
// ==========================================================

const isFemale =
    isAnimal &&
    numericCode % 2 === 0;


// ==========================================================
// DATE HELPERS
// ==========================================================

const dateOnly = (value) => {

    if (!value) {
        return "";
    }


    const date = new Date(value);


    if (Number.isNaN(date.getTime())) {
        return "";
    }


    return date
        .toISOString()
        .slice(0, 10);

};


const displayDate = (value) => {

    if (!value) {
        return "";
    }


    const date = new Date(value);


    if (Number.isNaN(date.getTime())) {
        return "";
    }


    return date.toLocaleString(
        "en-KE",
        {
            timeZone: "Africa/Nairobi",
            year: "numeric",
            month: "short",
            day: "numeric",
            hour: "2-digit",
            minute: "2-digit"
        }
    );

};


// ==========================================================
// IMAGE
// ==========================================================

const displayImage =
    dairy?.displayImage ||
    dairy?.profileImage ||
    "";


// ==========================================================
// BREEDS
// ==========================================================

const breeds =
    Array.isArray(dairyBreeds)
        ? [...dairyBreeds]
        : [];


if (
    dairy?.type &&
    isAnimal &&
    !breeds.includes(dairy.type)
) {

    breeds.unshift(dairy.type);

}


// ==========================================================
// STRUCTURE TYPES
// ==========================================================

const structuresTypesList =
    Array.isArray(structureTypes)
        ? [...structureTypes]
        : [];


if (
    dairy?.type &&
    isStructure &&
    !structuresTypesList.includes(dairy.type)
) {

    structuresTypesList.unshift(dairy.type);

}


// ==========================================================
// STATUS OPTIONS
// ==========================================================

const statusOptions = [

    "active",
    "sold",
    "disposed",
    "inactive"

];

%>


<div class="financial-page networth-page">


    <!-- ======================================================
         HEADER
    ======================================================= -->

    <div class="financial-header">


        <div>

            <h1 id="assetPageTitle">

                <%= dairy?.name || "Asset" %>

            </h1>


            <p>

                View and edit the information
                stored for this asset.

            </p>

        </div>


        <!-- ==================================================
             HEADER ACTIONS

             MILKING HISTORY:

                 Only appears when the asset's code
                 is an even number.

                 Route:
                     /milk/history/:dairyId

             NOTIFICATIONS:

                 Always appears.

                 Route:
                     /dairy/:id
        =================================================== -->

        <div class="networth-header-actions">


            <% if (
                dairy &&
                dairy.code !== null &&
                dairy.code !== undefined &&
                Number(dairy.code) % 2 === 0
            ) { %>


                <a
                    href="/milk/history/<%= dairy._id %>"
                    class="networth-header-action"
                    aria-label="Milking History"
                    title="Milking History"
                >

                    <i class="bi bi-clock-history"></i>

                    <span>
                        Milking History
                    </span>

                </a>


            <% } %>


            <a
                href="/dairy/<%= dairy._id %>"
                class="networth-header-action"
                aria-label="Notifications"
                title="Notifications"
            >

                <i class="bi bi-bell"></i>

                <span>
                    Notifications
                </span>

            </a>


        </div>


    </div>


    <!-- ======================================================
         MAIN CARD
    ======================================================= -->

    <div class="financial-card">


        <form
            id="networthAssetForm"
            action="/networth/asset/<%= dairy._id %>"
            method="POST"
            enctype="multipart/form-data"
            class="networth-form"
        >


            <input
                type="hidden"
                name="_method"
                value="PUT"
            >


            <!-- =================================================
                 SAVE STATUS
            ================================================== -->

            <div
                id="formSaveStatus"
                class="form-save-status"
                role="status"
                aria-live="polite"
            ></div>


            <!-- =================================================
                 PROFILE IMAGE
            ================================================== -->

            <div class="profile-image-section">


                <div class="profile-image-preview">


                    <% if (displayImage) { %>

                        <img
                            id="profileImagePreview"
                            src="<%= displayImage %>"
                            alt="<%= dairy.name || 'Asset profile image' %>"
                        >


                        <span
                            id="profileImagePlaceholder"
                            class="profile-image-placeholder"
                            style="display:none;"
                        >

                            <%= isAnimal ? "🐄" : "🏗️" %>

                        </span>


                    <% } else { %>


                        <img
                            id="profileImagePreview"
                            src=""
                            alt=""
                            style="display:none;"
                        >


                        <span
                            id="profileImagePlaceholder"
                            class="profile-image-placeholder"
                        >

                            <%= isAnimal ? "🐄" : "🏗️" %>

                        </span>


                    <% } %>


                </div>


                <div class="profile-image-title">

                    Profile Image

                </div>


                <p class="profile-image-description">

                    Choose a new image only if you want
                    to replace the current image.

                </p>


                <input
                    type="file"
                    id="profileImage"
                    name="profileImage"
                    class="profile-image-input"
                    accept="image/*"
                >

            </div>


            <!-- =================================================
                 NAME
            ================================================== -->

            <div class="form-group">

                <label for="name">
                    Name
                </label>


                <input
                    type="text"
                    id="name"
                    name="name"
                    value="<%= dairy.name ?? "" %>"
                    autocomplete="off"
                    required
                >

            </div>


            <!-- =================================================
                 CODE
            ================================================== -->

            <div class="form-group">

                <label for="code">

                    <%= isAnimal
                        ? "Animal Code"
                        : isDairyFarm
                            ? "Dairy Farm Code"
                            : "Record Type" %>

                </label>


                <input
                    type="text"
                    id="code"
                    value="<%= hasCode
                        ? dairy.code
                        : "Structure / Facility" %>"
                    readonly
                >

            </div>


            <!-- =================================================
                 ANIMAL INFORMATION
            ================================================== -->

            <% if (isAnimal) { %>


                <div class="form-section">


                    <h2 class="form-section-title">

                        Animal Information

                    </h2>


                    <p class="form-section-description">

                        These fields apply to identified dairy
                        animals.

                    </p>


                    <!-- =========================================
                         DATE OF BIRTH
                    ========================================== -->

                    <div class="form-group">

                        <label for="dateOfBirth">

                            Date of Birth

                        </label>


                        <input
                            type="date"
                            id="dateOfBirth"
                            name="dateOfBirth"
                            value="<%= dateOnly(dairy.dateOfBirth) %>"
                        >

                    </div>


                    <!-- =========================================
                         AGE
                    ========================================== -->

                    <div class="form-group">

                        <label for="age">

                            Age

                        </label>


                        <div
                            id="age"
                            class="age-display"
                            data-date-of-birth="<%= dateOnly(dairy.dateOfBirth) %>"
                        >

                            <%= dairy.ageText || "Not available" %>

                        </div>

                    </div>


                    <!-- =========================================
                         GENDER
                    ========================================== -->

                    <div class="form-group">

                        <label for="gender">

                            Gender

                        </label>


                        <input
                            type="text"
                            id="gender"
                            value="<%= isFemale ? "Female" : "Male" %>"
                            readonly
                        >

                    </div>


                    <!-- =========================================
                         BREED
                    ========================================== -->

                    <div class="form-group">

                        <label for="type">

                            Breed

                        </label>


                        <select
                            id="type"
                            name="type"
                            required
                        >

                            <option
                                value=""
                                <%= !dairy.type
                                    ? "selected"
                                    : "" %>
                            >

                                Select breed

                            </option>


                            <% breeds.forEach(function(breed) { %>

                                <option
                                    value="<%= breed %>"
                                    <%= dairy.type === breed
                                        ? "selected"
                                        : "" %>
                                >

                                    <%= breed %>

                                </option>

                            <% }); %>


                        </select>

                    </div>


                    <!-- =========================================
                         MASS
                    ========================================== -->

                    <div class="form-group">

                        <label for="mass">

                            Mass (kg)

                        </label>


                        <input
                            type="number"
                            id="mass"
                            name="mass"
                            value="<%= dairy.mass ?? 0 %>"
                            min="0"
                            step="0.01"
                            placeholder="Enter animal mass"
                        >

                    </div>


                    <!-- =========================================
                         MILKING
                    ========================================== -->

                    <% if (isFemale) { %>


                        <div class="form-group">

                            <label for="isMilking">

                                Milking

                            </label>


                            <div class="boolean-display">

                                <input
                                    type="checkbox"
                                    id="isMilking"
                                    name="isMilking"
                                    value="true"
                                    <%= dairy.isMilking
                                        ? "checked"
                                        : "" %>
                                >


                                <label for="isMilking">

                                    Currently being milked

                                </label>

                            </div>

                        </div>


                    <% } %>


                    <!-- =========================================
                         PARENT DAIRY FARM
                    ========================================== -->

                    <div class="form-group asset-location-group">

                        <label for="assetCode">

                            Parent Dairy Farm

                        </label>


                        <p class="asset-location-description">

                            Every animal must belong to a
                            Dairy Farm. The selected farm's
                            negative code becomes this animal's
                            <strong>assetCode</strong>.

                        </p>


                        <select
                            id="assetCode"
                            name="assetCode"
                            required
                        >


                            <option
                                value=""
                                disabled
                                <%= dairy.assetCode === null ||
                                    dairy.assetCode === undefined ||
                                    dairy.assetCode === ""
                                        ? "selected"
                                        : "" %>
                            >

                                Select Dairy Farm

                            </option>


                            <% if (
                                Array.isArray(structures) &&
                                structures.length > 0
                            ) { %>


                                <% structures.forEach(
                                    function(structure)
                                { %>


                                    <% if (
                                        structure.code !== null &&
                                        structure.code !== undefined &&
                                        Number(structure.code) < 0
                                    ) { %>


                                        <option
                                            value="<%= structure.code %>"
                                            <%= dairy.assetCode != null &&
                                                Number(dairy.assetCode) ===
                                                Number(structure.code)
                                                    ? "selected"
                                                    : "" %>
                                        >

                                            <%= structure.name ||
                                                "Dairy Farm" %>
                                            —
                                            <%= structure.code %>

                                        </option>


                                    <% } %>


                                <% }); %>


                            <% } else { %>


                                <option
                                    value=""
                                    disabled
                                >

                                    No Dairy Farms available

                                </option>


                            <% } %>


                        </select>

                    </div>


                </div>


            <% } %>


            <!-- =================================================
                 STRUCTURE / FACILITY INFORMATION
            ================================================== -->

            <% if (isStructure) { %>


                <div class="form-section">


                    <h2 class="form-section-title">

                        Structure / Facility Information

                    </h2>


                    <p class="form-section-description">

                        This record has no numeric code, which
                        means it is stored as a structure,
                        facility, equipment, or other non-animal
                        asset.

                    </p>


                    <div class="structure-info">

                        <strong>Record type:</strong>

                        Structure / Facility / Equipment

                        <br>

                        <strong>Code:</strong>

                        No numeric code

                    </div>


                    <!-- =========================================
                         STRUCTURE TYPE
                    ========================================== -->

                    <div class="form-group">

                        <label for="type">

                            Type

                        </label>


                        <select
                            id="type"
                            name="type"
                        >


                            <option
                                value=""
                                <%= !dairy.type
                                    ? "selected"
                                    : "" %>
                            >

                                Select structure type

                            </option>


                            <% structuresTypesList.forEach(
                                function(structureType)
                            { %>


                                <option
                                    value="<%= structureType %>"
                                    <%= dairy.type === structureType
                                        ? "selected"
                                        : "" %>
                                >

                                    <%= structureType %>

                                </option>


                            <% }); %>


                        </select>

                    </div>


                    <!-- =========================================
                         PARENT DAIRY FARM
                    ========================================== -->

                    <div class="form-group asset-location-group">

                        <label for="assetCode">

                            Parent Dairy Farm

                        </label>


                        <p class="asset-location-description">

                            A structure may belong to a Dairy Farm
                            or remain standalone.

                        </p>


                        <select
                            id="assetCode"
                            name="assetCode"
                        >


                            <option
                                value=""
                                <%= dairy.assetCode === null ||
                                    dairy.assetCode === undefined ||
                                    dairy.assetCode === ""
                                        ? "selected"
                                        : "" %>
                            >

                                Standalone — No Dairy Farm

                            </option>


                            <% if (
                                Array.isArray(structures) &&
                                structures.length > 0
                            ) { %>


                                <% structures.forEach(
                                    function(structure)
                                { %>


                                    <% if (
                                        structure.code !== null &&
                                        structure.code !== undefined &&
                                        Number(structure.code) < 0
                                    ) { %>


                                        <option
                                            value="<%= structure.code %>"
                                            <%= dairy.assetCode != null &&
                                                dairy.assetCode !== "" &&
                                                Number(dairy.assetCode) ===
                                                Number(structure.code)
                                                    ? "selected"
                                                    : "" %>
                                        >

                                            <%= structure.name ||
                                                "Dairy Farm" %>
                                            —
                                            <%= structure.code %>

                                        </option>


                                    <% } %>


                                <% }); %>


                            <% } %>


                        </select>

                    </div>


                </div>


            <% } %>


            <!-- =================================================
                 FINANCIAL INFORMATION
            ================================================== -->

            <div class="form-section">


                <h2 class="form-section-title">

                    Financial Information

                </h2>


                <p class="form-section-description">

                    Values used when calculating the farm's
                    current net worth.

                </p>


                <div class="form-group">

                    <label for="buyingPrice">

                        Buying Price

                    </label>


                    <input
                        type="number"
                        id="buyingPrice"
                        name="buyingPrice"
                        value="<%= dairy.buyingPrice ?? 0 %>"
                        min="0"
                        step="0.01"
                    >

                </div>


                <div class="form-group">

                    <label for="currentWorth">

                        Current Worth

                    </label>


                    <input
                        type="number"
                        id="currentWorth"
                        name="currentWorth"
                        value="<%= dairy.currentWorth ?? 0 %>"
                        min="0"
                        step="0.01"
                        required
                    >

                </div>


                <div class="form-group">

                    <label for="valuationDate">

                        Valuation Date

                    </label>


                    <input
                        type="date"
                        id="valuationDate"
                        name="valuationDate"
                        value="<%= dateOnly(dairy.valuationDate) %>"
                    >

                </div>


            </div>


            <!-- =================================================
                 GENERAL INFORMATION
            ================================================== -->

            <div class="form-section">


                <h2 class="form-section-title">

                    General Information

                </h2>


                <div class="form-group">

                    <label for="description">

                        Description

                    </label>


                    <textarea
                        id="description"
                        name="description"
                        rows="4"
                        placeholder="Describe the asset..."
                    ><%= dairy.description ?? "" %></textarea>

                </div>


                <div class="form-group">

                    <label for="condition">

                        Condition

                    </label>


                    <input
                        type="text"
                        id="condition"
                        name="condition"
                        value="<%= dairy.condition ?? "" %>"
                        placeholder="e.g. Good, New, Needs Repair"
                    >

                </div>


                <div class="form-group">

                    <label for="location">

                        Physical Location

                    </label>


                    <input
                        type="text"
                        id="location"
                        name="location"
                        value="<%= dairy.location ?? "" %>"
                        placeholder="Where is the asset physically located?"
                    >

                </div>


                <div class="form-group">

                    <label for="status">

                        Status

                    </label>


                    <select
                        id="status"
                        name="status"
                    >


                        <% statusOptions.forEach(
                            function(status)
                        { %>


                            <option
                                value="<%= status %>"
                                <%= dairy.status === status
                                    ? "selected"
                                    : "" %>
                            >

                                <%= status.charAt(0).toUpperCase() +
                                    status.slice(1) %>

                            </option>


                        <% }); %>


                    </select>

                </div>


                <div class="form-group">

                    <label for="acquisitionDate">

                        Acquisition Date

                    </label>


                    <input
                        type="text"
                        id="acquisitionDate"
                        value="<%= displayDate(dairy.acquisitionDate) %>"
                        readonly
                    >

                </div>


            </div>


            <!-- =================================================
                 ACTIONS
            ================================================== -->

            <div class="form-actions">


                <a
                    href="/networth"
                    class="button button-secondary"
                >

                    Cancel

                </a>


                <button
                    type="submit"
                    id="saveAssetButton"
                    class="button button-primary"
                >

                    Save Changes

                </button>


            </div>


        </form>


    </div>


</div>


<script src="/js/networth-asset.js"></script>