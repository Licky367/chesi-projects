/* =========================================================
   VERRAH COSMETICS
   SUBSTATION BALANCES
   DISTRIBUTION COMPONENT
========================================================= */


/* =========================================================
   MAIN DISTRIBUTION PANEL
========================================================= */

.distribution-panel{

    width:100%;

    margin-top:24px;

    background:var(--white);

    border:
        1px solid var(--border);

    border-radius:14px;

    overflow:hidden;

    box-shadow:
        0 4px 14px rgba(78,52,36,.08);

}


/* =========================================================
   SECTION HEADER
========================================================= */

.distribution-header{

    width:100%;

    padding:20px 22px;

    background:var(--primary-soft);

    border-bottom:
        1px solid var(--border);

}


.distribution-header-content{

    min-width:0;

}


.distribution-label{

    display:block;

    margin-bottom:5px;

    color:var(--primary);

    font-size:11px;

    font-weight:700;

    letter-spacing:1.2px;

    line-height:1.2;

}


.distribution-title{

    margin:0;

    color:var(--text);

    font-size:21px;

    font-weight:700;

    line-height:1.3;

}


.distribution-description{

    margin:6px 0 0;

    color:var(--muted);

    font-size:13px;

    line-height:1.5;

}


/* =========================================================
   TABLE CONTAINER
========================================================= */

.distribution-table-container{

    width:100%;

    overflow-x:auto;

    overflow-y:hidden;

    -webkit-overflow-scrolling:touch;

}


/* =========================================================
   TABLE
========================================================= */

.distribution-table{

    width:100%;

    min-width:720px;

    border-collapse:collapse;

    border-spacing:0;

    background:var(--white);

}


/* =========================================================
   TABLE HEADER
========================================================= */

.distribution-table thead{

    background:#f8f5f2;

}


.distribution-table th{

    padding:13px 15px;

    color:var(--primary-dark);

    font-size:12px;

    font-weight:700;

    text-align:left;

    white-space:nowrap;

    border-bottom:
        1px solid var(--border);

}


/* =========================================================
   TABLE BODY
========================================================= */

.distribution-table tbody{

    background:var(--white);

}


.distribution-table td{

    padding:14px 15px;

    color:var(--text);

    font-size:14px;

    vertical-align:middle;

    border-bottom:
        1px solid #eee8e4;

}


.distribution-table tbody tr:last-child td{

    border-bottom:none;

}


/* =========================================================
   DISTRIBUTION ROW
========================================================= */

.distribution-row{

    transition:
        background .18s ease;

}


.distribution-row:hover{

    background:var(--primary-soft);

}


/* =========================================================
   INDEX
========================================================= */

.distribution-index{

    width:50px;

    color:var(--muted) !important;

    font-size:13px !important;

    font-weight:600;

}


/* =========================================================
   SUBSTATION NAME
========================================================= */

.distribution-substation{

    min-width:170px;

}


.distribution-substation strong{

    display:block;

    color:var(--text);

    font-size:14px;

    font-weight:700;

    line-height:1.4;

}


/* =========================================================
   LOCATION
========================================================= */

.distribution-location{

    min-width:160px;

}


.distribution-location span{

    display:inline-flex;

    align-items:center;

    gap:7px;

    color:var(--muted);

    line-height:1.4;

}


.distribution-location i{

    color:var(--primary);

    font-size:14px;

}


/* =========================================================
   AVAILABLE QUANTITY
========================================================= */

.distribution-quantity{

    min-width:140px;

}


.distribution-quantity strong{

    color:var(--primary);

    font-size:15px;

    font-weight:700;

}


/* =========================================================
   ADMIN ACTIONS
========================================================= */

.distribution-actions{

    min-width:235px;

}


/* =========================================================
   UPDATE FORM
========================================================= */

.distribution-update-form{

    display:flex;

    align-items:flex-end;

    gap:9px;

    width:100%;

}


/* =========================================================
   INPUT WRAPPER
========================================================= */

.distribution-input-wrapper{

    display:flex;

    flex-direction:column;

    gap:4px;

    min-width:105px;

}


.distribution-input-label{

    color:var(--muted);

    font-size:10px;

    font-weight:600;

    line-height:1.2;

}


/* =========================================================
   UNITS INPUT
========================================================= */

.distribution-units-input{

    width:105px;

    height:38px;

    padding:0 10px;

    border:
        1px solid var(--border);

    border-radius:7px;

    outline:none;

    background:#fff;

    color:var(--text);

    font-size:14px;

    font-weight:600;

    transition:
        border-color .2s ease,
        box-shadow .2s ease,
        background .2s ease;

}


.distribution-units-input:hover{

    border-color:#cbbdb3;

}


.distribution-units-input:focus{

    border-color:var(--primary);

    background:#fff;

    box-shadow:
        0 0 0 3px rgba(111,78,55,.12);

}


/* =========================================================
   REMOVE NUMBER INPUT SPINNER — OPTIONAL CLEAN LOOK
========================================================= */

.distribution-units-input::-webkit-inner-spin-button,
.distribution-units-input::-webkit-outer-spin-button{

    opacity:1;

}


/* =========================================================
   SAVE BUTTON
========================================================= */

.distribution-save-button{

    height:38px;

    padding:0 13px;

    display:inline-flex;

    align-items:center;

    justify-content:center;

    gap:7px;

    border:0;

    border-radius:7px;

    background:var(--primary);

    color:#fff;

    cursor:pointer;

    font-family:Arial,sans-serif;

    font-size:13px;

    font-weight:600;

    white-space:nowrap;

    transition:
        background .2s ease,
        transform .15s ease,
        box-shadow .2s ease;

}


.distribution-save-button:hover{

    background:var(--primary-dark);

    box-shadow:
        0 3px 9px rgba(78,52,36,.18);

}


.distribution-save-button:active{

    transform:scale(.96);

}


.distribution-save-button:focus-visible{

    outline:3px solid rgba(111,78,55,.20);

    outline-offset:2px;

}


.distribution-save-button i{

    font-size:13px;

}


/* =========================================================
   EMPTY STATE
========================================================= */

.distribution-empty{

    min-height:150px;

    padding:30px 20px;

    display:flex;

    flex-direction:column;

    align-items:center;

    justify-content:center;

    gap:10px;

    text-align:center;

    background:var(--white);

}


/* =========================================================
   EMPTY ICON
========================================================= */

.distribution-empty-icon{

    width:48px;

    height:48px;

    display:flex;

    align-items:center;

    justify-content:center;

    border-radius:50%;

    background:var(--primary-light);

    color:var(--primary);

    font-size:20px;

}


/* =========================================================
   EMPTY TEXT
========================================================= */

.distribution-empty-text{

    max-width:420px;

    color:var(--muted);

    font-size:13px;

    line-height:1.5;

}


/* =========================================================
   SMALL DESKTOP / TABLET
========================================================= */

@media(max-width:900px){

    .distribution-header{

        padding:18px;

    }


    .distribution-table{

        min-width:680px;

    }


    .distribution-table th,
    .distribution-table td{

        padding:12px;

    }

}


/* =========================================================
   MOBILE
========================================================= */

@media(max-width:600px){

    .distribution-panel{

        margin-top:18px;

        border-radius:11px;

    }


    /* -----------------------------------------------
       HEADER
    ----------------------------------------------- */

    .distribution-header{

        padding:17px 15px;

    }


    .distribution-title{

        font-size:18px;

    }


    .distribution-description{

        font-size:12px;

    }


    /* -----------------------------------------------
       TABLE
    ----------------------------------------------- */

    .distribution-table{

        min-width:680px;

    }


    .distribution-table th{

        padding:11px 12px;

        font-size:11px;

    }


    .distribution-table td{

        padding:12px;

        font-size:13px;

    }


    /* -----------------------------------------------
       EMPTY STATE
    ----------------------------------------------- */

    .distribution-empty{

        min-height:135px;

        padding:25px 15px;

    }

}


/* =========================================================
   VERY SMALL SCREENS
========================================================= */

@media(max-width:380px){

    .distribution-header{

        padding:15px 13px;

    }


    .distribution-title{

        font-size:17px;

    }


    .distribution-label{

        font-size:10px;

    }


    .distribution-table{

        min-width:650px;

    }


    .distribution-table th,
    .distribution-table td{

        padding:10px;

    }


    .distribution-empty{

        padding:22px 12px;

    }

}