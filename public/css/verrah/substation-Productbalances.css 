/* =========================================================
   VERRAH COSMETICS
   SUBSTATION BALANCES
   BROWN DISTRIBUTION THEME
========================================================= */


/* =========================================================
   MAIN CONTAINER
========================================================= */

.distribution-panel {

    width: 100%;
    max-width: 100%;

    margin: 20px 0 0;

    background: var(--white);

    border: 1px solid var(--border);

    border-radius: 12px;

    overflow: hidden;

    box-shadow:
        0 3px 12px rgba(78, 52, 36, .08);

}


/* =========================================================
   HEADER
========================================================= */

.distribution-header {

    width: 100%;

    padding: 17px 18px;

    background: var(--primary);

    color: #fff;

}


.distribution-header-content {

    width: 100%;

}


.distribution-label {

    display: block;

    margin-bottom: 4px;

    color: #eadfd7;

    font-size: 10px;

    font-weight: 700;

    letter-spacing: 1.3px;

    line-height: 1.2;

}


.distribution-title {

    margin: 0;

    color: #fff;

    font-size: 20px;

    font-weight: 700;

    line-height: 1.3;

}


.distribution-description {

    margin: 5px 0 0;

    color: #eee4dc;

    font-size: 12px;

    line-height: 1.4;

}


/* =========================================================
   TABLE AREA
========================================================= */

.distribution-table-container {

    width: 100%;

    max-width: 100%;

    overflow-x: auto;

    overflow-y: hidden;

    -webkit-overflow-scrolling: touch;

}


/* =========================================================
   TABLE
========================================================= */

.distribution-table {

    width: 100%;

    border-collapse:collapse;

    border-spacing: 0;

    background: #fff;

}


/* =========================================================
   TABLE HEADER
========================================================= */

.distribution-table thead {

    background: var(--primary-soft);

}


.distribution-table th {

    padding: 12px 13px;

    color: var(--primary-dark);

    font-size: 11px;

    font-weight: 700;

    text-align: left;

    white-space: nowrap;

    border-bottom: 1px solid var(--border);

}


/* =========================================================
   TABLE CELLS
========================================================= */

.distribution-table td {

    padding: 12px 13px;

    color: var(--text);

    font-size: 13px;

    vertical-align: middle;

    border-bottom: 1px solid #eee7e2;

}


.distribution-table tbody tr:last-child td {

    border-bottom: 0;

}


/* =========================================================
   ROW
========================================================= */

.distribution-row {

    background: #fff;

    transition:
        background .18s ease;

}


.distribution-row:hover {

    background: var(--primary-soft);

}


/* =========================================================
   NUMBER
========================================================= */

.distribution-index {

    width: 42px;

    color: var(--muted) !important;

    font-size: 12px !important;

    font-weight: 600;

}


/* =========================================================
   SUBSTATION
========================================================= */

.distribution-substation {

    min-width: 130px;

}


.distribution-substation strong {

    color: var(--primary-dark);

    font-size: 13px;

    font-weight: 700;

}


/* =========================================================
   LOCATION
========================================================= */

.distribution-location {

    min-width: 120px;

}


.distribution-location span {

    display: inline-flex;

    align-items: center;

    gap: 6px;

    color: var(--muted);

    font-size: 12px;

}


.distribution-location i {

    color: var(--primary);

    font-size: 12px;

}


/* =========================================================
   AVAILABLE UNITS
========================================================= */

.distribution-quantity {

    min-width: 100px;

}


.distribution-quantity strong {

    display: inline-block;

    color: var(--primary);

    font-size: 14px;

    font-weight: 700;

}


/* =========================================================
   ADMIN ACTION
========================================================= */

.distribution-actions {

    min-width: 205px;

}


/* =========================================================
   UPDATE FORM
========================================================= */

.distribution-update-form {

    display: flex;

    align-items: flex-end;

    gap: 7px;

    margin: 0;

}


/* =========================================================
   INPUT
========================================================= */

.distribution-input-wrapper {

    display: flex;

    flex-direction: column;

    gap: 3px;

}


.distribution-input-label {

    color: var(--muted);

    font-size: 9px;

    font-weight: 600;

    line-height: 1;

}


.distribution-units-input {

    width: 85px;

    height: 34px;

    padding: 0 9px;

    border: 1px solid var(--border);

    border-radius: 6px;

    background: #fff;

    color: var(--text);

    outline: none;

    font-family: Arial, sans-serif;

    font-size: 13px;

    font-weight: 600;

    transition:
        border-color .2s ease,
        box-shadow .2s ease;

}


.distribution-units-input:hover {

    border-color: #bca99d;

}


.distribution-units-input:focus {

    border-color: var(--primary);

    box-shadow:
        0 0 0 2px rgba(111, 78, 55, .12);

}


/* =========================================================
   SAVE BUTTON
========================================================= */

.distribution-save-button {

    height: 34px;

    padding: 0 11px;

    display: inline-flex;

    align-items: center;

    justify-content: center;

    gap: 6px;

    border: 0;

    border-radius: 6px;

    background: var(--primary);

    color: #fff;

    cursor: pointer;

    font-family: Arial, sans-serif;

    font-size: 12px;

    font-weight: 700;

    white-space: nowrap;

    transition:
        background .2s ease,
        transform .15s ease;

}


.distribution-save-button:hover {

    background: var(--primary-dark);

}


.distribution-save-button:active {

    transform: scale(.96);

}


.distribution-save-button:focus-visible {

    outline: 2px solid var(--primary);

    outline-offset: 2px;

}


/* =========================================================
   EMPTY STATE
========================================================= */

.distribution-empty {

    width: 100%;

    min-height: 125px;

    padding: 25px 15px;

    display: flex;

    flex-direction: column;

    align-items: center;

    justify-content: center;

    gap: 9px;

    background: var(--primary-soft);

    text-align: center;

}


.distribution-empty-icon {

    width: 42px;

    height: 42px;

    display: flex;

    align-items: center;

    justify-content: center;

    border-radius: 50%;

    background: var(--primary-light);

    color: var(--primary);

    font-size: 18px;

}


.distribution-empty-text {

    max-width: 360px;

    color: var(--muted);

    font-size: 12px;

    line-height: 1.5;

}


/* =========================================================
   TABLET
========================================================= */

@media (max-width: 800px) {

    .distribution-table-container {

        overflow-x: auto;

    }


    .distribution-table {

        min-width: 620px;

    }

}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 600px) {

    .distribution-panel {

        margin-top: 15px;

        border-radius: 10px;

    }


    .distribution-header {

        padding: 15px;

    }


    .distribution-title {

        font-size: 18px;

    }


    .distribution-description {

        font-size: 11px;

    }


    .distribution-table th {

        padding: 10px 11px;

        font-size: 10px;

    }


    .distribution-table td {

        padding: 10px 11px;

        font-size: 12px;

    }


    .distribution-table {

        min-width: 590px;

    }


    .distribution-actions {

        min-width: 185px;

    }


    .distribution-update-form {

        gap: 6px;

    }


    .distribution-units-input {

        width: 75px;

        height: 32px;

    }


    .distribution-save-button {

        height: 32px;

        padding: 0 9px;

        font-size: 11px;

    }

}


/* =========================================================
   VERY SMALL PHONES
========================================================= */

@media (max-width: 380px) {

    .distribution-header {

        padding: 14px 12px;

    }


    .distribution-title {

        font-size: 17px;

    }


    .distribution-table th,
    .distribution-table td {

        padding-left: 9px;

        padding-right: 9px;

    }


    .distribution-table {

        min-width: 560px;

    }

}