/* =========================================================
   SUBSTATION BALANCES
   EDIT INPUT + SAVE BUTTON
   VERRAH COSMETICS
========================================================= */


/* =========================================================
   UNITS EDIT INPUT
========================================================= */

.sales-table input[type="number"]{
    width:90px;
    max-width:100%;
    height:40px;

    padding:0 10px;

    background:#ffffff;
    color:var(--text);

    border:1.5px solid var(--border);
    border-radius:8px;

    font-size:14px;
    font-weight:600;

    text-align:center;

    outline:none;

    transition:
        border-color .2s ease,
        box-shadow .2s ease,
        background .2s ease;
}

.sales-table input[type="number"]:hover{
    border-color:var(--primary);
}

.sales-table input[type="number"]:focus{
    border-color:var(--primary);

    background:var(--primary-soft);

    box-shadow:
        0 0 0 3px rgba(111,78,55,.12);
}


/* =========================================================
   REMOVE NUMBER INPUT ARROWS
========================================================= */

.sales-table input[type="number"]::-webkit-inner-spin-button,
.sales-table input[type="number"]::-webkit-outer-spin-button{
    margin:0;
    opacity:.7;
}


/* =========================================================
   SAVE BUTTON
========================================================= */

.sales-table button[type="submit"]{
    height:40px;
    min-width:82px;

    display:inline-flex;
    align-items:center;
    justify-content:center;
    gap:7px;

    padding:0 13px;

    border:1px solid var(--primary);
    border-radius:8px;

    background:var(--primary);
    color:#ffffff;

    font-size:13px;
    font-weight:600;

    cursor:pointer;

    white-space:nowrap;

    box-shadow:
        0 2px 5px rgba(78,52,36,.14);

    transition:
        background .2s ease,
        border-color .2s ease,
        transform .15s ease,
        box-shadow .2s ease;
}


/* =========================================================
   SAVE BUTTON HOVER
========================================================= */

.sales-table button[type="submit"]:hover{
    background:var(--primary-dark);
    border-color:var(--primary-dark);

    box-shadow:
        0 4px 10px rgba(78,52,36,.18);
}


/* =========================================================
   SAVE BUTTON ACTIVE
========================================================= */

.sales-table button[type="submit"]:active{
    transform:translateY(1px);

    box-shadow:
        0 2px 5px rgba(78,52,36,.12);
}


/* =========================================================
   SAVE ICON
========================================================= */

.sales-table button[type="submit"] i{
    font-size:13px;
    line-height:1;
}


/* =========================================================
   MOBILE
========================================================= */

@media(max-width:600px){

    .sales-table input[type="number"]{
        width:78px;
        height:38px;
        font-size:13px;
    }

    .sales-table button[type="submit"]{
        min-width:72px;
        height:38px;

        padding:0 10px;

        font-size:12px;
    }

    .sales-table button[type="submit"] i{
        font-size:12px;
    }

}