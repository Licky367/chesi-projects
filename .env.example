# Example environment variables for production
PORT=3000
NODE_ENV=production
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/<db-name>?retryWrites=true&w=majority
SESSION_SECRET=replace_with_secure_random_value
FRONTEND_URL=https://your-frontend.example.com
MORGAN_FORMAT=combined

# Production notes:
# - SESSION_SECRET must be a long random value
# - FRONTEND_URL must match the deployed frontend origin
# - MONGO_URI must point to a managed MongoDB instance or a secure Mongo host
